{"charon_version":"0.1.223","translated":{"crate_name":"prover_rw_owned_drop","options":{"ullbc":false,"precise_drops":true,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::destroy32","crate::destroy64"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["zeroize"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-prover-rw-20261023/native-owned-drop/ProverRwOwnedDropFocused.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"lib.rs"},"crate_name":"prover_rw_owned_drop","contents":"//! Proof-only entry points; production sources and dependencies are unchanged.\nuse zeroize::{Zeroize, Zeroizing};\npub fn destroy32(value: Zeroizing<[u8; 32]>) { drop(value); }\npub fn destroy64(value: Zeroizing<[u8; 64]>) { drop(value); }\n\n#[cfg(kani)]\nfn zeroize_array<const N: usize>(mut bytes: [u8; N]) {\n    bytes.zeroize();\n    for b in bytes { assert_eq!(b, 0); }\n}\n\n#[cfg(kani)]\nfn drop_retained<const N: usize>(bytes: [u8; N]) {\n    // Complete initialized object in storage which outlives the destructor.\n    // MaybeUninit prevents automatic second destruction; it is NOT evidence\n    // that arbitrary uninitialized memory may be read.\n    let mut storage = core::mem::MaybeUninit::new(Zeroizing::new(bytes));\n    let owner = storage.as_mut_ptr();\n    // Derive the exact inner allocation address while the owner is alive.\n    // No layout/offset/transparent-representation assumption is made.\n    let data = unsafe { (&mut **owner).as_mut_ptr() };\n    // The temporary reference above ends before this unique destructor call.\n    unsafe { core::ptr::drop_in_place(owner); }\n    // Only u8 payload bytes, not padding or a reference to a dead owner.\n    // The pinned destructor writes initialized zero u8s and frees no storage.\n    // storage remains allocated here; no second drop of the owner occurs.\n    for i in 0..N { assert_eq!(unsafe { data.add(i).read() }, 0); }\n}\n\n#[cfg(kani)]\n#[kani::proof]\n#[kani::unwind(66)]\nfn zeroize32() { zeroize_array(kani::any::<[u8; 32]>()); }\n#[cfg(kani)]\n#[kani::proof]\n#[kani::unwind(66)]\nfn zeroize64() { zeroize_array(kani::any::<[u8; 64]>()); }\n#[cfg(kani)]\n#[kani::proof]\n#[kani::unwind(66)]\nfn drop32() { drop_retained(kani::any::<[u8; 32]>()); }\n#[cfg(kani)]\n#[kani::proof]\n#[kani::unwind(66)]\nfn drop64() { drop_retained(kani::any::<[u8; 64]>()); }\n"},{"id":1,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/zeroize-1.8.1/src/lib.rs"},"crate_name":"zeroize","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/mem/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/default.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"L