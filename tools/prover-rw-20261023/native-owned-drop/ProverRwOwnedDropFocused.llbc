nt":["sync",0]},{"Ident":["atomic",0]},{"Ident":["Ordering",0]}],"span":{"data":{"file_id":17,"beg":{"line":447,"col":0},"end":{"line":447,"col":17}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Atomic memory orderings"},{"DocComment":""},{"DocComment":" Memory orderings specify the way atomic operations synchronize memory."},{"DocComment":" In its weakest [`Ordering::Relaxed`], only the memory directly touched by the"},{"DocComment":" operation is synchronized. On the other hand, a store-load pair of [`Ordering::SeqCst`]"},{"DocComment":" operations synchronize other memory while additionally preserving a total order of such"},{"DocComment":" operations across all threads."},{"DocComment":""},{"DocComment":" Rust's memory orderings are [the same as those of"},{"DocComment":" C++20](https://en.cppreference.com/w/cpp/atomic/memory_order)."},{"DocComment":""},{"DocComment":" For more information see the [nomicon]."},{"DocComment":""},{"DocComment":" [nomicon]: ../../../nomicon/atomics.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Ordering"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":17,"beg":{"line":454,"col":4},"end":{"line":454,"col":11}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" No ordering constraints, only atomic operations."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_relaxed`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_relaxed`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Relaxed_ordering"}],"inline":null,"rename":null,"public":true},"name":"Relaxed","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","0"]}}},{"id":1,"span":{"data":{"file_id":17,"beg":{"line":469,"col":4},"end":{"line":469,"col":11}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" When coupled with a store, all previous operations become ordered"},{"DocComment":" before any load of this value with [`Acquire`] (or stronger) ordering."},{"DocComment":" In particular, all previous writes become visible to all threads"},{"DocComment":" that perform an [`Acquire`] (or stronger) load of this value."},{"DocComment":""},{"DocComment":" Notice that using this ordering for an operation that combines loads"},{"DocComment":" and stores leads to a [`Relaxed`] load operation!"},{"DocComment":""},{"DocComment":" This ordering is only applicable for operations that can perform a store."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_release`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_release`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Release-Acquire_ordering"}],"inline":null,"rename":null,"public":true},"name":"Release","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","1"]}}},{"id":2,"span":{"data":{"file_id":17,"beg":{"line":484,"col":4},"end":{"line":484,"col":11}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" When coupled with a load, if the loaded value was written by a store operation with"},{"DocComment":" [`Release`] (or stronger) ordering, then all subsequent operations"},{"DocComment":" become ordered after that store. In particular, all subsequent loads will see data"},{"DocComment":" written before the store."},{"DocComment":""},{"DocComment":" Notice that using this ordering for an operation that combines loads"},{"DocComment":" and stores leads to a [`Relaxed`] store operation!"},{"DocComment":""},{"DocComment":" This ordering is only applicable for operations that can perform a load."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_acquire`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_acquire`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Release-Acquire_ordering"}],"inline":null,"rename":null,"public":true},"name":"Acquire","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","2"]}}},{"id":3,"span":{"data":{"file_id":17,"beg":{"line":498,"col":4},"end":{"line":498,"col":10}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Has the effects of both [`Acquire`] and [`Release`] together:"},{"DocComment":" For loads it uses [`Acquire`] ordering. For stores it uses the [`Release`] ordering."},{"DocComment":""},{"DocComment":" Notice that in the case of `compare_and_swap`, it is possible that the operation ends up"},{"DocComment":" not performing any store and hence it has just [`Acquire`] ordering. However,"},{"DocComment":" `AcqRel` will never perform [`Relaxed`] accesses."},{"DocComment":""},{"DocComment":" This ordering is only applicable for operations that combine both loads and stores."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_acq_rel`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_acq_rel`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Release-Acquire_ordering"}],"inline":null,"rename":null,"public":true},"name":"AcqRel","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","3"]}}},{"id":4,"span":{"data":{"file_id":17,"beg":{"line":507,"col":4},"end":{"line":507,"col":10}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Like [`Acquire`]/[`Release`]/[`AcqRel`] (for load, store, and load-with-store"},{"DocComment":" operations, respectively) with the additional guarantee that all threads see all"},{"DocComment":" sequentially consistent operations in the same order."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_seq_cst`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_seq_cst`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Sequentially-consistent_ordering"}],"inline":null,"rename":null,"public":true},"name":"SeqCst","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","4"]}}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":1,"align":1,"discriminator":{"Branch":{"offset":0,"int_ty":{"Unsigned":"U8"},"children":[[{"start":{"Unsigned":["U8","0"]},"end":{"Unsigned":["U8","0"]}},{"Known":0}],[{"start":{"Unsigned":["U8","1"]},"end":{"Unsigned":["U8","1"]}},{"Known":1}],[{"start":{"Unsigned":["U8","2"]},"end":{"Unsigned":["U8","2"]}},{"Known":2}],[{"start":{"Unsigned":["U8","3"]},"end":{"Unsigned":["U8","3"]}},{"Known":3}],[{"start":{"Unsigned":["U8","4"]},"end":{"Unsigned":["U8","4"]}},{"Known":4}]],"fallback":"Invalid"}},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U8","0"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U8","1"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U8","2"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U8","3"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U8","4"]}]]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},null,{"def_id":6,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["pin",0]},{"Ident":["Pin",0]}],"span":{"data":{"file_id":21,"beg":{"line":1092,"col":0},"end":{"line":1092,"col":19}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A pointer which pins its pointee in place."},{"DocComment":""},{"DocComment":" [`Pin`] is a wrapper around some kind of pointer `Ptr` which makes that pointer \"pin\" its"},{"DocComment":" pointee value in place, thus preventing the value referenced by that pointer from being moved"},{"DocComment":" or otherwise invalidated at that place in memory unless it implements [`Unpin`]."},{"DocComment":""},{"DocComment":" *See the [`pin` module] documentation for a more thorough exploration of pinning.*"},{"DocComment":""},{"DocComment":" ## Pinning values with [`Pin<Ptr>`]"},{"DocComment":""},{"DocComment":" In order to pin a value, we wrap a *pointer to that value* (of some type `Ptr`) in a"},{"DocComment":" [`Pin<Ptr>`]. [`Pin<Ptr>`] can wrap any pointer type, forming a promise that the **pointee**"},{"DocComment":" will not be *moved* or [otherwise invalidated][subtle-details]. If the pointee value's type"},{"DocComment":" implements [`Unpin`], we are free to disregard these requirements entirely and can wrap any"},{"DocComment":" pointer to that value in [`Pin`] directly via [`Pin::new`]. If the pointee value's type does"},{"DocComment":" not implement [`Unpin`], then Rust will not let us use the [`Pin::new`] function directly and"},{"DocComment":" we'll need to construct a [`Pin`]-wrapped pointer in one of the more specialized manners"},{"DocComment":" discussed below."},{"DocComment":""},{"DocComment":" We call such a [`Pin`]-wrapped pointer a **pinning pointer** (or pinning ref, or pinning"},{"DocComment":" [`Box`], etc.) because its existence is the thing that is pinning the underlying pointee in"},{"DocComment":" place: it is the metaphorical \"pin\" securing the data in place on the pinboard (in memory)."},{"DocComment":""},{"DocComment":" It is important to stress that the thing in the [`Pin`] is not the value which we want to pin"},{"DocComment":" itself, but rather a pointer to that value! A [`Pin<Ptr>`] does not pin the `Ptr` but rather"},{"DocComment":" the pointer's ***pointee** value*."},{"DocComment":""},{"DocComment":" The most common set of types which require pinning related guarantees for soundness are the"},{"DocComment":" compiler-generated state machines that implement [`Future`] for the return value of"},{"DocComment":" `async fn`s. These compiler-generated [`Future`]s may contain self-referential pointers, one"},{"DocComment":" of the most common use cases for [`Pin`]. More details on this point are provided in the"},{"DocComment":" [`pin` module] docs, but suffice it to say they require the guarantees provided by pinning to"},{"DocComment":" be implemented soundly."},{"DocComment":""},{"DocComment":" This requirement for the implementation of `async fn`s means that the [`Future`] trait"},{"DocComment":" requires all calls to [`poll`] to use a <code>self: [Pin]\\<&mut Self></code> parameter instead"},{"DocComment":" of the usual `&mut self`. Therefore, when manually polling a future, you will need to pin it"},{"DocComment":" first."},{"DocComment":""},{"DocComment":" You may notice that `async fn`-sourced [`Future`]s are only a small percentage of all"},{"DocComment":" [`Future`]s that exist, yet we had to modify the signature of [`poll`] for all [`Future`]s"},{"DocComment":" to accommodate them. This is unfortunate, but there is a way that the language attempts to"},{"DocComment":" alleviate the extra friction that this API choice incurs: the [`Unpin`] trait."},{"DocComment":""},{"DocComment":" The vast majority of Rust types have no reason to ever care about being pinned. These"},{"DocComment":" types implement the [`Unpin`] trait, which entirely opts all values of that type out of"},{"DocComment":" pinning-related guarantees. For values of these types, pinning a value by pointing to it with a"},{"DocComment":" [`Pin<Ptr>`] will have no actual effect."},{"DocComment":""},{"DocComment":" The reason this distinction exists is exactly to allow APIs like [`Future::poll`] to take a"},{"DocComment":" [`Pin<Ptr>`] as an argument for all types while only forcing [`Future`] types that actually"},{"DocComment":" care about pinning guarantees pay the ergonomics cost. For the majority of [`Future`] types"},{"DocComment":" that don't have a reason to care about being pinned and therefore implement [`Unpin`], the"},{"DocComment":" <code>[Pin]\\<&mut Self></code> will act exactly like a regular `&mut Self`, allowing direct"},{"DocComment":" access to the underlying value. Only types that *don't* implement [`Unpin`] will be restricted."},{"DocComment":""},{"DocComment":" ### Pinning a value of a type that implements [`Unpin`]"},{"DocComment":""},{"DocComment":" If the type of the value you need to \"pin\" implements [`Unpin`], you can trivially wrap any"},{"DocComment":" pointer to that value in a [`Pin`] by calling [`Pin::new`]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::pin::Pin;"},{"DocComment":""},{"DocComment":" // Create a value of a type that implements `Unpin`"},{"DocComment":" let mut unpin_future = std::future::ready(5);"},{"DocComment":""},{"DocComment":" // Pin it by creating a pinning mutable reference to it (ready to be `poll`ed!)"},{"DocComment":" let my_pinned_unpin_future: Pin<&mut _> = Pin::new(&mut unpin_future);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ### Pinning a value inside a [`Box`]"},{"DocComment":""},{"DocComment":" The simplest and most flexible way to pin a value that does not implement [`Unpin`] is to put"},{"DocComment":" that value inside a [`Box`] and then turn that [`Box`] into a \"pinning [`Box`]\" by wrapping it"},{"DocComment":" in a [`Pin`]. You can do both of these in a single step using [`Box::pin`]. Let's see an"},{"DocComment":" example of using this flow to pin a [`Future`] returned from calling an `async fn`, a common"},{"DocComment":" use case as described above."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::pin::Pin;"},{"DocComment":""},{"DocComment":" async fn add_one(x: u32) -> u32 {"},{"DocComment":"     x + 1"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Call the async function to get a future back"},{"DocComment":" let fut = add_one(42);"},{"DocComment":""},{"DocComment":" // Pin the future inside a pinning box"},{"DocComment":" let pinned_fut: Pin<Box<_>> = Box::pin(fut);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you have a value which is already boxed, for example a [`Box<dyn Future>`][Box], you can pin"},{"DocComment":" that value in-place at its current memory address using [`Box::into_pin`]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::pin::Pin;"},{"DocComment":" use std::future::Future;"},{"DocComment":""},{"DocComment":" async fn add_one(x: u32) -> u32 {"},{"DocComment":"     x + 1"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn boxed_add_one(x: u32) -> Box<dyn Future<Output = u32>> {"},{"DocComment":"     Box::new(add_one(x))"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let boxed_fut = boxed_add_one(42);"},{"DocComment":""},{"DocComment":" // Pin the future inside the existing box"},{"DocComment":" let pinned_fut: Pin<Box<_>> = Box::into_pin(boxed_fut);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There are similar pinning methods offered on the other standard library smart pointer types"},{"DocComment":" as well, like [`Rc`] and [`Arc`]."},{"DocComment":""},{"DocComment":" ### Pinning a value on the stack using [`pin!`]"},{"DocComment":""},{"DocComment":" There are some situations where it is desirable or even required (for example, in a `#[no_std]`"},{"DocComment":" context where you don't have access to the standard library or allocation in general) to"},{"DocComment":" pin a value which does not implement [`Unpin`] to its location on the stack. Doing so is"},{"DocComment":" possible using the [`pin!`] macro. See its documentation for more."},{"DocComment":""},{"DocComment":" ## Layout and ABI"},{"DocComment":""},{"DocComment":" [`Pin<Ptr>`] is guaranteed to have the same memory layout and ABI[^noalias] as `Ptr`."},{"DocComment":""},{"DocComment":" [^noalias]: There is a bit of nuance here that is still being decided about whether the"},{"DocComment":" aliasing semantics of `Pin<&mut T>` should be different than `&mut T`, but this is true as of"},{"DocComment":" today."},{"DocComment":""},{"DocComment":" [`pin!`]: crate::pin::pin \"pin!\""},{"DocComment":" [`Future`]: crate::future::Future \"Future\""},{"DocComment":" [`poll`]: crate::future::Future::poll \"Future::poll\""},{"DocComment":" [`Future::poll`]: crate::future::Future::poll \"Future::poll\""},{"DocComment":" [`pin` module]: self \"pin module\""},{"DocComment":" [`Rc`]: ../../std/rc/struct.Rc.html \"Rc\""},{"DocComment":" [`Arc`]: ../../std/sync/struct.Arc.html \"Arc\""},{"DocComment":" [Box]: ../../std/boxed/struct.Box.html \"Box\""},{"DocComment":" [`Box`]: ../../std/boxed/struct.Box.html \"Box\""},{"DocComment":" [`Box::pin`]: ../../std/boxed/struct.Box.html#method.pin \"Box::pin\""},{"DocComment":" [`Box::into_pin`]: ../../std/boxed/struct.Box.html#method.into_pin \"Box::into_pin\""},{"DocComment":" [subtle-details]: self#subtle-details-and-the-drop-guarantee \"pin subtle details\""},{"DocComment":" [`unsafe`]: ../../std/keyword.unsafe.html \"keyword unsafe\""}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"pin"},"generics":{"regions":[],"types":[{"index":0,"name":"Ptr"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},null,{"def_id":8,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}],"span":{"data":{"file_id":22,"beg":{"line":557,"col":0},"end":{"line":557,"col":21}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Result` is a type that represents either success ([`Ok`]) or failure ([`Err`])."},{"DocComment":""},{"DocComment":" See the [module documentation](self) for details."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Result"},"generics":{"regions":[],"types":[{"index":0,"name":"T"},{"index":1,"name":"E"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":22,"beg":{"line":561,"col":4},"end":{"line":561,"col":6}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Contains the success value"}],"inline":null,"rename":null,"public":true},"name":"Ok","fields":[{"span":{"data":{"file_id":22,"beg":{"line":561,"col":53},"end":{"line":561,"col":54}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":6108}}],"discriminant":{"Scalar":{"Signed":["Isize","0"]}}},{"id":1,"span":{"data":{"file_id":22,"beg":{"line":566,"col":4},"end":{"line":566,"col":7}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Contains the error value"}],"inline":null,"rename":null,"public":true},"name":"Err","fields":[{"span":{"data":{"file_id":22,"beg":{"line":566,"col":54},"end":{"line":566,"col":55}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"HashConsedValue":[6109,{"TypeVar":{"Free":1}}]}}],"discriminant":{"Scalar":{"Signed":["Isize","1"]}}}]},"layout":[],"ptr_metadata":"None"},{"def_id":9,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["iter",0]},{"Ident":["IntoIter",0]}],"span":{"data":{"file_id":23,"beg":{"line":20,"col":0},"end":{"line":20,"col":38}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A by-value [array] iterator."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"ArrayIntoIter"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[{"index":0,"name":"N","ty":{"HashConsedValue":[331,{"Literal":{"UInt":"Usize"}}]}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":10,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Ident":["nonzero",0]},{"Ident":["NonZero",0]}],"span":{"data":{"file_id":24,"beg":{"line":128,"col":0},"end":{"line":128,"col":40}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A value that is known not to equal zero."},{"DocComment":""},{"DocComment":" This enables some memory layout optimization."},{"DocComment":" For example, `Option<NonZero<u32>>` is the same size as `u32`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use core::{num::NonZero};"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<Option<NonZero<u32>>>(), size_of::<u32>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":""},{"DocComment":" `NonZero<T>` is guaranteed to have the same layout and bit validity as `T`"},{"DocComment":" with the exception that the all-zero bit pattern is invalid."},{"DocComment":" `Option<NonZero<T>>` is guaranteed to be compatible with `T`, including in"},{"DocComment":" FFI."},{"DocComment":""},{"DocComment":" Thanks to the [null pointer optimization], `NonZero<T>` and"},{"DocComment":" `Option<NonZero<T>>` are guaranteed to have the same size and alignment:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::num::NonZero;"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<NonZero<u32>>(), size_of::<Option<NonZero<u32>>>());"},{"DocComment":" assert_eq!(align_of::<NonZero<u32>>(), align_of::<Option<NonZero<u32>>>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [null pointer optimization]: crate::option#representation"},{"DocComment":""},{"DocComment":" # Note on generic usage"},{"DocComment":""},{"DocComment":" `NonZero<T>` can only be used with some standard library primitive types"},{"DocComment":" (such as `u8`, `i32`, and etc.). The type parameter `T` must implement the"},{"DocComment":" internal trait [`ZeroablePrimitive`], which is currently permanently unstable"},{"DocComment":" and cannot be implemented by users. Therefore, you cannot use `NonZero<T>`"},{"DocComment":" with your own types, nor can you implement traits for all `NonZero<T>`,"},{"DocComment":" only for concrete types."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"NonZero"},"generics":{"regions":[],"types":[{"index":0,"name":"T"},{"index":1,"name":"Clause0_NonZeroInner"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":11,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["step_by",0]},{"Ident":["StepBy",0]}],"span":{"data":{"file_id":26,"beg":{"line":16,"col":0},"end":{"line":16,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator for stepping iterators by a custom amount."},{"DocComment":""},{"DocComment":" This `struct` is created by the [`step_by`] method on [`Iterator`]. See"},{"DocComment":" its documentation for more."},{"DocComment":""},{"DocComment":" [`step_by`]: Iterator::step_by"},{"DocComment":" [`Iterator`]: trait.Iterator.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"I"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":12,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["chain",0]},{"Ident":["Chain",0]}],"span":{"data":{"file_id":28,"beg":{"line":23,"col":0},"end":{"line":23,"col":22}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator that links two iterators together, in a chain."},{"DocComment":""},{"DocComment":" This `struct` is created by [`chain`] or [`Iterator::chain`]. See their"},{"DocComment":" documentation for more."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::iter::Chain;"},{"DocComment":" use std::slice::Iter;"},{"DocComment":""},{"DocComment":" let a1 = [1, 2, 3];"},{"DocComment":" let a2 = [4, 5, 6];"},{"DocComment":" let iter: Chain<Iter<'_, _>, Iter<'_, _>> = a1.iter().chain(a2.iter());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"A"},{"index":1,"name":"B"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":13,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["zip",0]},{"Ident":["Zip",0]}],"span":{"data":{"file_id":29,"beg":{"line":13,"col":0},"end":{"line":13,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator that iterates two other iterators simultaneously."},{"DocComment":""},{"DocComment":" This `struct` is created by [`zip`] or [`Iterator::zip`]."},{"DocComment":" See their documentation for more."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"A"},{"index":1,"name":"B"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":14,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["intersperse",0]},{"Ident":["Intersperse",0]}],"span":{"data":{"file_id":30,"beg":{"line":9,"col":0},"end":{"line":9,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator adapter that places a separator between all elements."},{"DocComment":""},{"DocComment":" This `struct` is created by [`Iterator::intersperse`]. See its documentation"},{"DocComment":" for more information."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"I"},{"index":1,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":15,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["intersperse",0]},{"Ident":["IntersperseWith",0]}],"span":{"data":{"file_id":30,"beg":{"line":83,"col":0},"end":{"line":83,"col":32}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator adapter that places a separator between all elements."},{"DocComment":""},{"DocComment":" This `struct` is created by [`Iterator::intersperse_with`]. See its"},{"DocComment":" documentation for more information."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"I"},{"index":1,"name":"G"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":16,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["map",0]},{"Ident":["Map",0]}],"span":{"data":{"file_id":32,"beg":{"line":61,"col":0},"end":{"line":61,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator that maps the values of `iter` with `f`."},{"DocComment":""},{"DocComment":" This `struct` is created by the [`map`] method on [`Iterator`]. See its"},{"DocComment":" documentation for more."},{"DocComment":""},{"DocComment":" [`map`]: Iterator::map"},{"DocComment":" [`Iterator`]: trait.Iterator.html"},{"DocComment":""},{"DocComment":" # Notes about side effects"},{"DocComment":""},{"DocComment":" The [`map`] iterator implements [`DoubleEndedIterator`], meaning that"},{"DocComment":" you can also [`map`] backwards:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" let v: Vec<i32> = [1, 2, 3].into_iter().map(|x| x + 1).rev().collect();"},{"DocComment":""},{"DocComment":" assert_eq!(v, [4, 3, 2]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`DoubleEndedIterator`]: trait.DoubleEndedIterator.html"},{"DocComment":""},{"DocComment":" But if your closure has state, iterating backwards may act in a way you do"},{"DocComment":" not expect. Let's go through an example. First, in the forward direction:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" let mut c = 0;"},{"DocComment":""},{"DocComment":" for pair in ['a', 'b', 'c'].into_iter()"},{"DocComment":"                                .map(|letter| { c += 1; (letter, c) }) {"},{"DocComment":"     println!(\"{pair:?}\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will print `('a', 1), ('b', 2), ('c', 3)`."},{"DocComment":""},{"DocComment":" Now consider this twist where we add a call to `rev`. This version will"},{"DocComment":" print `('c', 1), ('b', 2), ('a', 3)`. Note that the letters are reversed,"},{"DocComment":" but the values of the counter still go in order. This is because `map()` is"},{"DocComment":" still being called lazily on each item, but we are popping items off the"},{"DocComment":" back of the vector now, instead of shifting them from the front."},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" let mut c = 0;"},{"DocComment":""},{"DocComment":" for pair in ['a', 'b', 'c'].into_iter()"},{"DocComment":"                                .map(|letter| { c += 1; (letter, c) })"},{"DocComment":"                                .rev() {"},{"DocComment":"     println!(\"{pair:?}\");"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"I"},{"index":1,"name":"F"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":17,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["filter",0]},{"Ident":["Filter",0]}],"span":{"data":{"file_id":33,"beg":{"line":21,"col":0},"end":{"line":21,"col":23}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator that filters the elements of `iter` with `predicate`."},{"DocComment":""},{"DocComment":" This `struct` is created by the [`filter`] method on [`Iterator`]. See its"},{"DocComment":" documentation for more."},{"DocComment":""},{"DocComment":" [`filter`]: Iterator::filter"},{"DocComment":" [`Iterator`]: trait.Iterator.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"I"},{"index":1,"name":"P"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":18,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["filter_map",0]},{"Ident":["FilterMap",0]}],"span":{"data":{"file_id":34,"beg":{"line":18,"col":0},"end":{"line":18,"col":26}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator that uses `f` to both filter and map elements from `iter`."},{"DocComment":""},{"DocComment":" This `struct` is created by the [`filter_map`] method on [`Iterator`]. See its"},{"DocComment":" documentation for more."},{"DocComment":""},{"DocComment":" [`filter_map`]: Iterator::filter_map"},{"DocComment":" [`Iterator`]: trait.Itera