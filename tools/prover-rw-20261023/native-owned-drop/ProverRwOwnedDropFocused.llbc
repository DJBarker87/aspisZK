tImpl":{"impl_ref":{"id":12,"generics":{"regions":[],"types":[{"Deduplicated":6108},{"Deduplicated":6109}],"const_generics":[],"trait_refs":[{"HashConsedValue":[6124,{"kind":{"Clause":{"Free":0}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":6108},{"Deduplicated":6109}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":6111}]}},"trait_ref":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":6108},{"Deduplicated":6109},{"Deduplicated":6108}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":0},"reuses_default":true}},"is_global_initializer":null,"body":"Opaque"},{"def_id":15,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Impl":{"Trait":13}},{"Ident":["next",0]}],"span":{"data":{"file_id":15,"beg":{"line":4240,"col":4},"end":{"line":4240,"col":41}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"I"},{"index":1,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":15,"beg":{"line":4237,"col":8},"end":{"line":4237,"col":16}},"generated_from_span":null},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":6108},{"Deduplicated":6109}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":6108}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[6202,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":6126},"Mut"]}]}],"output":{"HashConsedValue":[6139,{"Adt":{"id":{"Adt":3},"generics":{"regions":[],"types":[{"Deduplicated":6109}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitImpl":{"impl_ref":{"id":13,"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":6108},{"Deduplicated":6109}],"const_generics":[],"trait_refs":[{"Deduplicated":6124},{"Deduplicated":6111}]}},"trait_ref":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":6126},{"Deduplicated":6109}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":0},"reuses_default":true}},"is_global_initializer":null,"body":"Opaque"},{"def_id":16,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["write_volatile",0]}],"span":{"data":{"file_id":10,"beg":{"line":2213,"col":0},"end":{"line":2213,"col":52}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs a volatile write of a memory location with the given value without reading or dropping"},{"DocComment":" the old value."},{"DocComment":""},{"DocComment":" Volatile operations are intended to act on I/O memory. As such, they are considered externally"},{"DocComment":" observable events (just like syscalls), and are guaranteed to not be elided or reordered by the"},{"DocComment":" compiler across other externally observable events. With this in mind, there are two cases of"},{"DocComment":" usage that need to be distinguished:"},{"DocComment":""},{"DocComment":" - When a volatile operation is used for memory inside an [allocation], it behaves exactly like"},{"DocComment":"   [`write`][write()], except for the additional guarantee that it won't be elided or reordered"},{"DocComment":"   (see above). This implies that the operation will actually access memory and not e.g. be"},{"DocComment":"   lowered to a register access. Other than that, all the usual rules for memory accesses apply"},{"DocComment":"   (including provenance). In particular, just like in C, whether an operation is volatile has no"},{"DocComment":"   bearing whatsoever on questions involving concurrent access from multiple threads. Volatile"},{"DocComment":"   accesses behave exactly like non-atomic accesses in that regard."},{"DocComment":""},{"DocComment":" - Volatile operations, however, may also be used to access memory that is _outside_ of any Rust"},{"DocComment":"   allocation. In this use-case, the pointer does *not* have to be [valid] for writes. This is"},{"DocComment":"   typically used for CPU and peripheral registers that must be accessed via an I/O memory"},{"DocComment":"   mapping, most commonly at fixed addresses reserved by the hardware. These often have special"},{"DocComment":"   semantics associated to their manipulation, and cannot be used as general purpose memory."},{"DocComment":"   Here, any address value is possible, including 0 and [`usize::MAX`], so long as the semantics"},{"DocComment":"   of such a write are well-defined by the target hardware. The provenance of the pointer is"},{"DocComment":"   irrelevant, and it can be created with [`without_provenance`]. The access must not trap. It"},{"DocComment":"   can cause side-effects, but those must not affect Rust-allocated memory in any way. This"},{"DocComment":"   access is still not considered [atomic], and as such it cannot be used for inter-thread"},{"DocComment":"   synchronization."},{"DocComment":""},{"DocComment":" Note that volatile memory operations on zero-sized types (e.g., if a zero-sized type is passed"},{"DocComment":" to `write_volatile`) are noops and may be ignored."},{"DocComment":""},{"DocComment":" `write_volatile` does not drop the contents of `dst`. This is safe, but it could leak"},{"DocComment":" allocations or resources, so care should be taken not to overwrite an object that should be"},{"DocComment":" dropped when operating on Rust memory. Additionally, it does not drop `src`. Semantically, `src`"},{"DocComment":" is moved into the location pointed to by `dst`."},{"DocComment":""},{"DocComment":" [allocation]: crate::ptr#allocated-object"},{"DocComment":" [atomic]: crate::sync::atomic#memory-model-for-atomic-accesses"},{"DocComment":""},{"DocComment":" # Store splitting"},{"DocComment":""},{"DocComment":" Exactly which hardware stores are performed by this function is, in general, highly target-dependent."},{"DocComment":""},{"DocComment":" For a simple scalar, such as when `T` is a thin pointer, this will typically be one store assuming"},{"DocComment":" your target supports a store of exactly that size and alignment."},{"DocComment":""},{"DocComment":" For anything else, it will be split into multiple stores in some unspecified way."},{"DocComment":" This can happen even for scalars: notably, on many targets storing a `u128` will still need to be split,"},{"DocComment":" despite being \"one\" scalar.  On many targets storing anything larger than a pointer will need to be split."},{"DocComment":" On all current targets a store larger than 64 bytes will need to be split."},{"DocComment":" Any store whose size is not a power of two will also almost certainly need to be split."},{"DocComment":""},{"DocComment":" There is no stability guarantee on how that splitting happens.  It may change at any point."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Behavior is undefined if any of the following conditions are violated:"},{"DocComment":""},{"DocComment":" * `dst` must be either [valid] for writes, or `T` must be a ZST, or `dst` must point to memory"},{"DocComment":"   outside of all Rust allocations and writing to that memory must:"},{"DocComment":"   - not trap, and"},{"DocComment":"   - not cause any memory inside a Rust allocation to be modified."},{"DocComment":""},{"DocComment":" * `dst` must be properly aligned."},{"DocComment":""},{"DocComment":" Note that even if `T` has size `0`, the pointer must be properly aligned."},{"DocComment":""},{"DocComment":" [valid]: self#safety"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut x = 0;"},{"DocComment":" let y = &mut x as *mut i32;"},{"DocComment":" let z = 12;"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     std::ptr::write_volatile(y, z);"},{"DocComment":"     assert_eq!(std::ptr::read_volatile(y), 12);"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"ptr_write_volatile"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":6108}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":6200},{"Deduplicated":6108}],"output":{"Deduplicated":393}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":17,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["sync",0]},{"Ident":["atomic",0]},{"Ident":["compiler_fence",0]}],"span":{"data":{"file_id":17,"beg":{"line":4461,"col":0},"end":{"line":4461,"col":38}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A \"compiler-only\" atomic fence."},{"DocComment":""},{"DocComment":" Like [`fence`], this function establishes synchronization with other atomic operations and"},{"DocComment":" fences. However, unlike [`fence`], `compiler_fence` only establishes synchronization with"},{"DocComment":" operations *in the same thread*. This may at first sound rather useless, since code within a"},{"DocComment":" thread is typically already totally ordered and does not need any further synchronization."},{"DocComment":" However, there are cases where code can run on the same thread without being ordered:"},{"DocComment":" - The most common case is that of a *signal handler*: a signal handler runs in the same thread"},{"DocComment":"   as the code it interrupted, but it is not ordered with respect to that code. `compiler_fence`"},{"DocComment":"   can be used to establish synchronization between a thread and its signal handler, the same way"},{"DocComment":"   that `fence` can be used to establish synchronization across threads."},{"DocComment":" - Similar situations can arise in embedded programming with interrupt handlers, or in custom"},{"DocComment":"   implementations of preemptive green threads. In general, `compiler_fence` can establish"},{"DocComment":"   synchronization with code that is guaranteed to run on the same hardware CPU."},{"DocComment":""},{"DocComment":" See [`fence`] for how a fence can be used to achieve synchronization. Note that just like"},{"DocComment":" [`fence`], synchronization still requires atomic operations to be used in both threads -- it is"},{"DocComment":" not possible to perform synchronization entirely with fences and non-atomic operations."},{"DocComment":""},{"DocComment":" `compiler_fence` does not emit any machine code, but restricts the kinds of memory re-ordering"},{"DocComment":" the compiler is allowed to do. `compiler_fence` corresponds to [`atomic_signal_fence`] in C and"},{"DocComment":" C++."},{"DocComment":""},{"DocComment":" [`atomic_signal_fence`]: https://en.cppreference.com/w/cpp/atomic/atomic_signal_fence"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `order` is [`Relaxed`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Without the two `compiler_fence` calls, the read of `IMPORTANT_VARIABLE` in `signal_handler`"},{"DocComment":" is *undefined behavior* due to a data race, despite everything happening in a single thread."},{"DocComment":" This is because the signal handler is considered to run concurrently with its associated"},{"DocComment":" thread, and explicit synchronization is required to pass data between a thread and its"},{"DocComment":" signal handler. The code below uses two `compiler_fence` calls to establish the usual"},{"DocComment":" release-acquire synchronization pattern (see [`fence`] for an image)."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::atomic::AtomicBool;"},{"DocComment":" use std::sync::atomic::Ordering;"},{"DocComment":" use std::sync::atomic::compiler_fence;"},{"DocComment":""},{"DocComment":" static mut IMPORTANT_VARIABLE: usize = 0;"},{"DocComment":" static IS_READY: AtomicBool = AtomicBool::new(false);"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     unsafe { IMPORTANT_VARIABLE = 42 };"},{"DocComment":"     // Marks earlier writes as being released with future relaxed stores."},{"DocComment":"     compiler_fence(Ordering::Release);"},{"DocComment":"     IS_READY.store(true, Ordering::Relaxed);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn signal_handler() {"},{"DocComment":"     if IS_READY.load(Ordering::Relaxed) {"},{"DocComment":"         // Acquires writes that were released with relaxed stores that we read from."},{"DocComment":"         compiler_fence(Ordering::Acquire);"},{"DocComment":"         assert_eq!(unsafe { IMPORTANT_VARIABLE }, 42);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"compiler_fence"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Dedup