nt":" use std::path::PathBuf;"},{"DocComment":""},{"DocComment":" let path = PathBuf::from(r\"C:\\windows\\system32.dll\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Which method works best depends on what kind of situation you're in."},{"DocComment":""},{"DocComment":" Note that `PathBuf` does not always sanitize arguments, for example"},{"DocComment":" [`push`] allows paths built from strings which include separators:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::path::PathBuf;"},{"DocComment":""},{"DocComment":" let mut path = PathBuf::new();"},{"DocComment":""},{"DocComment":" path.push(r\"C:\\\");"},{"DocComment":" path.push(\"windows\");"},{"DocComment":" path.push(r\"..\\otherdir\");"},{"DocComment":" path.push(\"system32\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The behavior of `PathBuf` may be changed to a panic on such inputs"},{"DocComment":" in the future. [`Extend::extend`] should be used to add multi-part paths."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"PathBuf"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":15,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["option",0]},{"Ident":["Option",0]}],"span":{"data":{"file_id":21,"beg":{"line":597,"col":0},"end":{"line":597,"col":18}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The `Option` type. See [the module level documentation](self) for more."}],"inline":null,"rename":null,"public":true},"is_local