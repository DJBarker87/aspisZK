{"charon_version":"0.1.223","translated":{"crate_name":"prover_rw_native_entropy_drop","options":{"ullbc":false,"precise_drops":true,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::real_drop","crate::counter_probe"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-prover-rw-20261023/src/tools/prover-rw-20261023/native-entropy/ProverRwNativeEntropyDropV5.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"lib.rs"},"crate_name":"prover_rw_native_entropy_drop","contents":"//! Minimal baseline regression; no refined errors or external dependencies.\npub struct Guard<'a> { pub counter: Option<&'a mut u32> }\nimpl Drop for Guard<'_> {\n    fn drop(&mut self) {\n        let mut owned = None;\n        core::mem::swap(&mut self.counter, &mut owned);\n        if let Some(counter) = owned { increment(counter); }\n    }\n}\npub fn increment(counter: &mut u32) { *counter = (*counter).wrapping_add(1); }\npub fn real_drop(counter: &mut u32) {\n    let _guard = Guard { counter: Some(counter) };\n}\npub fn counter_probe() -> u32 {\n    let mut counter = 0;\n    real_drop(&mut counter);\n    counter\n}\n#[cfg(test)]\nmod tests {\n    #[test]\n    fn native_counter_zero_becomes_one() {\n        assert_eq!(super::counter_probe(), 1);\n    }\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/ptr/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/ops/drop.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/pin.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/mem/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["prover_rw_native_entropy_drop",0]},{"Ident":["real_drop",0]}]},{"key":{"Fun":1},"value":[{"Ident":["prover_rw_native_entropy_drop",0]},{"Ident":["counter_probe",0]}]},{"key":{"Type":0},"value":[{"Ident":["prover_rw_native_entropy_drop",0]},{"Ident":["Guard",0]}]},{"key":{"Type":1},"value":[{"Ident":["core",0]},{"Ident":["option",0]},{"Ident":["Option",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Destruct",0]}]},{"key":{"TraitImpl":0},"value":[{"Ident":["prover_rw_native_entropy_drop",0]},{"Ident":[