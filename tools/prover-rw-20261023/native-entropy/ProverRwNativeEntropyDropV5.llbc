nt":" their owned allocations or other resources and return normally from `drop()`, regardless of"},{"DocComment":" what state they are in."},{"DocComment":""},{"DocComment":" Note that even if this panics, the value is considered to be dropped;"},{"DocComment":" you must not cause `drop` to be called again. This is normally automatically"},{"DocComment":" handled by the compiler, but when using unsafe code, can sometimes occur"},{"DocComment":" unintentionally, particularly when using [`ptr::drop_in_place`]."},{"DocComment":""},{"DocComment":" [E0040]: ../../error_codes/E0040.html"},{"DocComment":" [`panic!`]: crate::panic!"},{"DocComment":" [`panicking()`]: ../../std/thread/fn.panicking.html"},{"DocComment":" [`mem::drop`]: drop"},{"DocComment":" [`ptr::drop_in_place`]: crate::ptr::drop_in_place"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":1116}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[1138,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":1116},"Mut"]}]}],"output":{"Deduplicated":287}},"src":{"TraitDecl":{"trait_ref":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":1116}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":0}}},"is_global_initializer":null,"body":"Opaque"},null,{"def_id":6,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["swap",0]}],"span":{"data":{"file_id":8,"beg":{"line":785,"col":0},"end":{"line":785,"col":42}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Swaps the values at two mutable locations, without deinitializing either one."},{"DocComment":""},{"DocComment":" * If you want to swap with a default or dummy value, see [`take`]."},{"DocComment":" * If you want to swap with a passed value, returning the old value, see [`replace`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem;"},{"DocComment":""},{"DocComment":" let mut x = 5;"},{"DocComment":" let mut y = 42;"},{"DocComment":""},{"DocComment":" mem::swap(&mut x, &mut y);"},{"DocComment":""},{"DocComment":" assert_eq!(42, x);"},{"DocComment":" assert_eq!(5, y);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"mem_swap"},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":1116}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":1138},{"HashConsedValue":[1139,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":1116},"Mut"]}]}],"output":{"Deduplicated":287}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":7,"item_meta":{"name":[{"Ident":["prover_rw_native_entropy_drop",0]},{"Ident":["increment",0]}],"span":{"data":{"file_id":0,"beg":{"line":10,"col":0},"end":{"line":10,"col":78}},"generated_from_span":null},"source_text":"pub fn increment(counter: &mut u32) { *counter = (*counter).wrapping_add(1); }","attr_info":