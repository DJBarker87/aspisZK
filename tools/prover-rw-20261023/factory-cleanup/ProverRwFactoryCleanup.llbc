{"charon_version":"0.1.223","translated":{"crate_name":"prover_rw_factory_cleanup","options":{"ullbc":false,"precise_drops":true,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["zeroize"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-prover-rw-20261023/factory-cleanup/ProverRwFactoryCleanup.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"lib.rs"},"crate_name":"prover_rw_factory_cleanup","contents":"//! Source-only concrete factory verification. No destructor instrumentation.\n#![allow(non_snake_case)]\nmod ProverRwFactoryCleanup {\n    include!(\"selected.rs\");\n    #[cfg(kani)]\n    mod checks {\n        use super::*;\n        static mut CALLS: usize = 0;\n        static mut LAST: [u8;64] = [0;64];\n        static mut LAST_ERROR: Option<getrandom::Error> = None;\n        static mut PRIOR_REJECTED: bool = true;\n        static mut PROVIDER_STATE: u64 = 0;\n        static mut LAST_STATE: u64 = 0;\n        fn half_nonzero(bytes: &[u8]) -> bool {\n            let mut any=false;\n            for i in 0..bytes.len() { any |= bytes[i] != 0; }\n            any\n        }\n        // The ONLY stub. No source branch or destructor is replaced.\n        fn fill_stub(dest: &mut [u8]) -> Result<(),getrandom::Error> {\n            assert_eq!(dest.len(),64);\n            unsafe {\n                assert!(CALLS < 16);\n                assert!(PRIOR_REJECTED);\n            }\n            for i in 0..64 { assert_eq!(dest[i],0); }\n            let post=kani::any::<[u8;64]>();\n            let failed=kani::any::<bool>();\n            // Safe public constructor: arbitrary custom code. OS code identity\n            // generalization remains source-inspected, not quantified here.\n            let error=getrandom::Error::new_custom(kani::any());\n            let state=kani::any::<u64>();\n            dest.copy_from_slice(&post);\n            unsafe {\n                CALLS+=1;\n                LAST=post;\n                LAST_ERROR=if failed {Some(error)} else {None};\n                PRIOR_REJECTED=!failed && !(half_nonzero(&post[..32]) && half_nonzero(&post[32..]));\n                PROVIDER_STATE=state;\n                LAST_STATE=state;\n            }\n            if failed {Err(error)} else {Ok(())}\n        }\n        #[kani::proof]\n        #[kani::unwind(66)]\n        #[kani::stub(getrandom::fill, fill_stub)]\n        fn zero_nonce() {\n            let result=StateOnlyAttemptSecrets::generate_for_mask_nonce([0;32]);\n            assert!(matches!(result,Err(StateOnlyAttemptEntropyError::RepeatedZeroBlock)));\n            unsafe {assert_eq!(CALLS,0);}\n        }\n        #[kani::proof]\n        #[kani::unwind(66)]\n        #[kani::stub(getrandom::fill, fill_stub)]\n        fn all_outcomes() {\n            let nonce=kani::any::<[u8;32]>();\n            let initial_state=kani::any::<u64>();\n            unsafe { PROVIDER_STATE=initial_state; }\n            let result=StateOnlyAttemptSecrets::generate_for_mask_nonce(nonce);\n            unsafe {\n                let calls=CALLS;\n                assert!(calls<=16);\n                if nonce==[0;32] {\n                    assert_eq!(calls,0);\n                    assert_eq!(PROVIDER_STATE,initial_state);\n                    assert!(matches!(result,Err(StateOnlyAttemptEntropyError::RepeatedZeroBlock)));\n                } else {\n                    assert!(calls>=1);\n                    assert_eq!(PROVIDER_STATE,LAST_STATE);\n                    let last=LAST;\n                    let last_error=LAST_ERROR;\n                    match result {\n                        Ok(owner) => {\n                            assert!(last_error.is_none());\n                            assert_eq!(owner.mask_nonce,nonce);\n                            assert!(half_nonzero(&last[..32]) && half_nonzero(&last[32..]));\n                            for i in 0..32 {\n                                assert_eq!(owner.field_mask_entropy[i],last[i]);\n                                assert_eq!(owner.leaf_salt_seed[i],last[i+32]);\n                            }\n                            // Actual owner drop glue executes at this scope end.\n                        }\n                        Err(StateOnlyAttemptEntropyError::Os(error)) => {\n                            assert_eq!(last_error,Some(error));\n                        }\n                        Err(StateOnlyAttemptEntropyError::RepeatedZeroBlock) => {\n                            assert_eq!(calls,16);\n                            assert!(last_error.is_none());\n                            assert!(PRIOR_REJECTED);\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n"},{"id":1,"name":{"Local":"selected.rs"},"crate_name":"prover_rw_factory_cleanup","contents":"// Immutable selected source items; see source-map.json.\nuse zeroize::Zeroizing;\nconst ENTROPY_RETRY_LIMIT: usize = 16;\n\n#[derive(Debug)]\npub enum StateOnlyAttemptEntropyError {\n    Os(getrandom::Error),\n    RepeatedZeroBlock,\n}\n\nimpl From<getrandom::Error> for StateOnlyAttemptEntropyError {\n    fn from(value: getrandom::Error) -> Self {\n        Self::Os(value)\n    }\n}\n\npub struct StateOnlyAttemptSecrets {\n    mask_nonce: [u8; 32],\n    field_mask_entropy: Zeroizing<[u8; 32]>,\n    leaf_salt_seed: Zeroizing<[u8; 32]>,\n}\n\n#[inline(always)]\nfn entropy_nonzero32(bytes:&[u8;32])->bool {\n    let mut combined=0u8;let mut i=0;\n    while i<32 {combined|=bytes[i];i+=1;}\n    combined!=0\n}\n\nimpl StateOnlyAttemptSecrets {\n    pub fn generate_for_mask_nonce(\n        mask_nonce: [u8; 32],\n    ) -> Result<Self, StateOnlyAttemptEntropyError> {\n        let limit=ENTROPY_RETRY_LIMIT;\n\n        if !entropy_nonzero32(&mask_nonce) {\n            return Err(StateOnlyAttemptEntropyError::RepeatedZeroBlock);\n        }\n        let mut retry=0;\n        while retry<limit {\n            let mut bytes = Zeroizing::new([0u8; 64]);\n            getrandom::fill(bytes.as_mut())?;\n\n            let mut field_mask_entropy = Zeroizing::new([0u8; 32]);\n            let mut leaf_salt_seed = Zeroizing::new([0u8; 32]);\n            field_mask_entropy.copy_from_slice(&bytes[..32]);\n            leaf_salt_seed.copy_from_slice(&bytes[32..]);\n            if entropy_nonzero32(&field_mask_entropy) && entropy_nonzero32(&leaf_salt_seed) {\n                return Ok(Self {\n                    mask_nonce,\n                    field_mask_entropy,\n                    leaf_salt_seed,\n                });\n            }\n            retry+=1;\n        }\n        Err(StateOnlyAttemptEntropyError::RepeatedZeroBlock)\n    }\n}\n"},{"id":2,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/getrandom-0.3.4/src/error.rs"},"crate_name":"getrandom","contents":null},{"id":3,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b55