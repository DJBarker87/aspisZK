nto a stream."},{"DocComment":""},{"DocComment":" This type does not support transmission of an error other than that an error"},{"DocComment":" occurred. This is because, despite the existence of this error,"},{"DocComment":" string formatting is considered an infallible operation."},{"DocComment":" `fmt()` implementors should not return this `Error` unless they received it from their"},{"DocComment":" [`Formatter`]. The only time your code should create a new instance of this"},{"DocComment":" error is when implementing `fmt::Write`, in order to cancel the formatting operation when"},{"DocComment":" writing to the underlying stream fails."},{"DocComment":""},{"DocComment":" Any extra information must be arranged to be transmitted through some other means,"},{"DocComment":" such as storing it in a field to be consulted after the formatting operation has been"},{"DocComment":" cancelled. (For example, this is how [`std::io::Write::write_fmt()`] propagates IO errors"},{"DocComment":" during writing.)"},{"DocComment":""},{"DocComment":" This type, `fmt::Error`, should not be"},{"DocComment":" confused with [`std::io::Error`] or [`std::error::Error`], which you may also"},{"DocComment":" have in scope."},{"DocComment":""},{"DocComment":" [`std::io::Error`]: ../../std/io/struct.Error.html"},{"DocComment":" [`std::io::Write::write_fmt()`]: ../../std/io/trait.Write.html#method.write_fmt"},{"DocComment":" [`std::error::Error`]: ../../std/error/trait.Error.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::fmt::{self, write};"},{"DocComment":""},{"DocComment":" let mut output = String::new();"},{"DocComment":" if let Err(fmt::Error) = write(&mut output, format_args!(\"Hello {}!\", \"world\")) {"},{"DocComment":"     panic!(\"An error occurred\");"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},null,{"def_id":9,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["control_flow",0]},{"Ident":["ControlFlow",0]}],"span":{"data":{"file_id":12,"beg":{"line":89,"col":0},"end":{"line":89,"col":31}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to tell an operation whether it should exit early or go on as usual."},{"DocComment":""},{"DocComment":" This is used when exposing things (like graph traversals or visitors) where"},{"DocComment":" you want the user to be able to choose whether to exit early."},{"DocComment":" Having the enum makes it clearer -- no more wondering \"wait, what did `false`"},{"DocComment":" mean again?\" -- and allows including a value."},{"DocComment":""},{"DocComment":" Similar to [`Option`] and [`Result`], this enum can be used with the `?` operator"},{"DocComment":" to return immediately if the [`Break`] variant is present or otherwise continue normally"},{"DocComment":" with the value inside the [`Continue`] variant."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Early-exiting from [`Iterator::try_for_each`]:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let r = (2..100).try_for_each(|x| {"},{"DocComment":"     if 403 % x == 0 {"},{"DocComment":"         return ControlFlow::Break(x)"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     ControlFlow::Continue(())"},{"DocComment":" });"},{"DocComment":" assert_eq!(r, ControlFlow::Break(13));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A basic tree traversal:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" pub struct TreeNode<T> {"},{"DocComment":"     value: T,"},{"DocComment":"     left: Option<Box<TreeNode<T>>>,"},{"DocComment":"     right: Option<Box<TreeNode<T>>>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> TreeNode<T> {"},{"DocComment":"     pub fn traverse_inorder<B>(&self, f: &mut impl FnMut(&T) -> ControlFlow<B>) -> ControlFlow<B> {"},{"DocComment":"         if let Some(left) = &self.left {"},{"DocComment":"             left.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         f(&self.value)?;"},{"DocComment":"         if let Some(right) = &self.right {"},{"DocComment":"             right.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         ControlFlow::Continue(())"},{"DocComment":"     }"},{"DocComment":"     fn leaf(value: T) -> Option<Box<TreeNode<T>>> {"},{"DocComment":"         Some(Box::new(Self { value, left: None, right: None }))"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let node = TreeNode {"},{"DocComment":"     value: 0,"},{"DocComment":"     left: TreeNode::leaf(1),"},{"DocComment":"     right: Some(Box::new(TreeNode {"},{"DocComment":"         value: -1,"},{"DocComment":"         left: TreeNode::leaf(5),"},{"DocComment":"         right: TreeNode::leaf(2),"},{"DocComment":"     }))"},{"DocComment":" };"},{"DocComment":" let mut sum = 0;"},{"DocComment":""},{"DocComment":" let res = node.traverse_inorder(&mut |val| {"},{"DocComment":"     if *val < 0 {"},{"DocComment":"         ControlFlow::Break(*val)"},{"DocComment":"     } else {"},{"DocComment":"         sum += *val;"},{"DocComment":"         ControlFlow::Continue(())"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(res, ControlFlow::Break(-1));"},{"DocComment":" assert_eq!(sum, 6);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Break`]: ControlFlow::Break"},{"DocComment":" [`Continue`]: ControlFlow::Continue"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"ControlFlow"},"generics":{"regions":[],"types":[{"index":0,"name":"B"},{"index":1,"name":"C"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":12,"beg":{"line":93,"col":4},"end":{"line":93,"col":12}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Move on to the next phase of the operation as normal."}],"inline":null,"rename":null,"public":true},"name":"Continue","fields":[{"span":{"data":{"file_id":12,"beg":{"line":93,"col":13},"end":{"line":93,"col":14}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":8123}}],"discriminant":{"Scalar":{"Signed":["Isize","0"]}}},{"id":1,"span":{"data":{"file_id":12,"beg":{"line":97,"col":4},"end":{"line":97,"col":9}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Exit the operation without running subsequent phases."}],"inline":null,"rename":null,"public":true},"name":"Break","fields":[{"span":{"data":{"file_id":12,"beg":{"line":97,"col":10},"end":{"line":97,"col":11}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":8122}}],"discriminant":{"Scalar":{"Signed":["Isize","1"]}}}]},"layout":[],"ptr_metadata":"None"},{"def_id":10,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["Infallible",0]}],"span":{"data":{"file_id":7,"beg":{"line":930,"col":0},"end":{"line":930,"col":19}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The error type for errors that can never happen."},{"DocComment":""},{"DocComment":" Since this enum has no variant, a value of this type can never actually exist."},{"DocComment":" This can be useful for generic APIs that use [`Result`] and parameterize the error type,"},{"DocComment":" to indicate that the result is always [`Ok`]."},{"DocComment":""},{"DocComment":" For example, the [`TryFrom`] trait (conversion that returns a [`Result`])"},{"DocComment":" has a blanket implementation for all types where a reverse [`Into`] implementation exists."},{"DocComment":""},{"DocComment":" ```ignore (illustrates std code, duplicating the impl in a doctest would be an error)"},{"DocComment":" impl<T, U> TryFrom<U> for T where U: Into<T> {"},{"DocComment":"     type Error = Infallible;"},{"DocComment":""},{"DocComment":"     fn try_from(value: U) -> Result<Self, Infallible> {"},{"DocComment":"         Ok(U::into(value))  // Never returns `Err`"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Future compatibility"},{"DocComment":""},{"DocComment":" This enum has the same role as [the `!` “never” type][never],"},{"DocComment":" which is unstable in this version of Rust."},{"DocComment":" When `!` is stabilized, we plan to make `Infallible` a type alias to it:"},{"DocComment":""},{"DocComment":" ```ignore (illustrates future std change)"},{"DocComment":" pub type Infallible = !;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" … and eventually deprecate `Infallible`."},{"DocComment":""},{"DocComment":" However there is one case where `!` syntax can be used"},{"DocComment":" before `!` is stabilized as a full-fledged type: in the position of a function’s return type."},{"DocComment":" Specifically, it is possible to have implementations for two different function pointer types:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" trait MyTrait {}"},{"DocComment":" impl MyTrait for fn() -> ! {}"},{"DocComment":" impl MyTrait for fn() -> std::convert::Infallible {}"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" With `Infallible` being an enum, this code is valid."},{"DocComment":" However when `Infallible` becomes an alias for the never type,"},{"DocComment":" the two `impl`s will start to overlap"},{"DocComment":" and therefore will be disallowed by the language’s trait coherence rules."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":null,"uninhabited":true,"variant_layouts":[],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":11,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["RangeTo",0]}],"span":{"data":{"file_id":14,"beg":{"line":281,"col":0},"end":{"line":281,"col":23}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A range only bounded exclusively above (`..end`)."},{"DocComment":""},{"DocComment":" The `RangeTo` `..end` contains all values with `x < end`."},{"DocComment":" It cannot serve as an [`Iterator`] because it doesn't have a starting point."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `..end` syntax is a `RangeTo`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((..5), std::ops::RangeTo { end: 5 });"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It does not have an [`IntoIterator`] implementation, so you can't use it in"},{"DocComment":" a `for` loop directly. This won't compile:"},{"DocComment":""},{"DocComment":" ```compile_fail,E0277"},{"DocComment":" // error[E0277]: the trait bound `std::ops::RangeTo<{integer}>:"},{"DocComment":" // std::iter::Iterator` is not satisfied"},{"DocComment":" for i in ..5 {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" When used as a [slicing index], `RangeTo` produces a slice of all array"},{"DocComment":" elements before the index indicated by `end`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]); // This is a `RangeTo`"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [slicing index]: crate::slice::SliceIndex"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"RangeTo"},"generics":{"regions":[],"types":[{"index":0,"name":"Idx"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":14,"beg":{"line":284,"col":4},"end":{"line":284,"col":16}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" The upper bound of the range (exclusive)."}],"inline":null,"rename":null,"public":true},"name":"end","ty":{"Deduplicated":8122}}]},"layout":[],"ptr_metadata":"None"},{"def_id":12,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["RangeFrom",0]}],"span":{"data":{"file_id":14,"beg":{"line":197,"col":0},"end":{"line":197,"col":25}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A range only bounded inclusively below (`start..`)."},{"DocComment":""},{"DocComment":" The `RangeFrom` `start..` contains all values with `x >= start`."},{"DocComment":""},{"DocComment":" *Note*: Overflow in the [`Iterator`] implementation (when the contained"},{"DocComment":" data type reaches its numerical limit) is allowed to panic, wrap, or"},{"DocComment":" saturate. This behavior is defined by the implementation of the [`Step`]"},{"DocComment":" trait. For primitive integers, this follows the normal rules, and respects"},{"DocComment":" the overflow checks profile (panic in debug, wrap in release). Note also"},{"DocComment":" that overflow happens earlier than you might assume: the overflow happens"},{"DocComment":" in the call to `next` that yields the maximum value, as the range must be"},{"DocComment":" set to a state to yield the next value."},{"DocComment":""},{"DocComment":" [`Step`]: crate::iter::Step"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `start..` syntax is a `RangeFrom`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((2..), std::ops::RangeFrom { start: 2 });"},{"DocComment":" assert_eq!(2 + 3 + 4, (2..).take(3).sum());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]);"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]); // This is a `RangeFrom`"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"RangeFrom"},"generics":{"regions":[],"types":[{"index":0,"name":"Idx"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":14,"beg":{"line":200,"col":4},"end":{"line":200,"col":18}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" The lower bound of the range (inclusive)."}],"inline":null,"rename":null,"public":true},"name":"start","ty":{"Deduplicated":8122}}]},"layout":[],"ptr_metadata":"None"},{"def_id":13,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["iter",0]},{"Ident":["IterMut",0]}],"span":{"data":{"file_id":19,"beg":{"line":192,"col":0},"end":{"line":192,"col":29}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Mutable slice iterator."},{"DocComment":""},{"DocComment":" This struct is created by the [`iter_mut`] method on [slices]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // First, we need a slice to call the `iter_mut` method on:"},{"DocComment":" let slice = &mut [1, 2, 3];"},{"DocComment":""},{"DocComment":" // Then we call `iter_mut` on the slice to get the `IterMut` iterator,"},{"DocComment":" // iterate over it and increment each element value:"},{"DocComment":" for element in slice.iter_mut() {"},{"DocComment":"     *element += 1;"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // We now have \"[2, 3, 4]\":"},{"DocComment":" println!(\"{slice:?}\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`iter_mut`]: slice::iter_mut"},{"DocComment":" [slices]: slice"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Mutable"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":8122},{"Var":{"Free":0}}]},{"regions":[],"skip_binder":[{"Deduplicated":8122},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":16,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,8,16],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},null,null,null,{"def_id":17,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["option",0]},{"Ident":["Option",0]}],"span":{"data":{"file_id":23,"beg":{"line":597,"col":0},"end":{"line":597,"col":18}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The `Option` type. See [the module level documentation](self) for more."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Option"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":23,"beg":{"line":601,"col":4},"end":{"line":601,"col":8}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" No value."}],"inline":null,"rename":null,"public":true},"name":"None","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","0"]}}},{"id":1,"span":{"data":{"file_id":23,"beg":{"line":605,"col":4},"end":{"line":605,"col":8}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Some value of type `T`."}],"inline":null,"rename":null,"public":true},"name":"Some","fields":[{"span":{"data":{"file_id":23,"beg":{"line":605,"col":55},"end":{"line":605,"col":56}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":8122}}],"discriminant":{"Scalar":{"Signed":["Isize","1"]}}}]},"layout":[],"ptr_metadata":"None"},{"def_id":18,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["sync",0]},{"Ident":["atomic",0]},{"Ident":["Ordering",0]}],"span":{"data":{"file_id":29,"beg":{"line":447,"col":0},"end":{"line":447,"col":17}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Atomic memory orderings"},{"DocComment":""},{"DocComment":" Memory orderings specify the way atomic operations synchronize memory."},{"DocComment":" In its weakest [`Ordering::Relaxed`], only the memory directly touched by the"},{"DocComment":" operation is synchronized. On the other hand, a store-load pair of [`Ordering::SeqCst`]"},{"DocComment":" operations synchronize other memory while additionally preserving a total order of such"},{"DocComment":" operations across all threads."},{"DocComment":""},{"DocComment":" Rust's memory orderings are [the same as those of"},{"DocComment":" C++20](https://en.cppreference.com/w/cpp/atomic/memory_order)."},{"DocComment":""},{"DocComment":" For more information see the [nomicon]."},{"DocComment":""},{"DocComment":" [nomicon]: ../../../nomicon/atomics.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Ordering"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":29,"beg":{"line":454,"col":4},"end":{"line":454,"col":11}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" No ordering constraints, only atomic operations."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_relaxed`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_relaxed`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Relaxed_ordering"}],"inline":null,"rename":null,"public":true},"name":"Relaxed","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","0"]}}},{"id":1,"span":{"data":{"file_id":29,"beg":{"line":469,"col":4},"end":{"line":469,"col":11}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" When coupled with a store, all previous operations become ordered"},{"DocComment":" before any load of this value with [`Acquire`] (or stronger) ordering."},{"DocComment":" In particular, all previous writes become visible to all threads"},{"DocComment":" that perform an [`Acquire`] (or stronger) load of this value."},{"DocComment":""},{"DocComment":" Notice that using this ordering for an operation that combines loads"},{"DocComment":" and stores leads to a [`Relaxed`] load operation!"},{"DocComment":""},{"DocComment":" This ordering is only applicable for operations that can perform a store."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_release`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_release`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Release-Acquire_ordering"}],"inline":null,"rename":null,"public":true},"name":"Release","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","1"]}}},{"id":2,"span":{"data":{"file_id":29,"beg":{"line":484,"col":4},"end":{"line":484,"col":11}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" When coupled with a load, if the loaded value was written by a store operation with"},{"DocComment":" [`Release`] (or stronger) ordering, then all subsequent operations"},{"DocComment":" become ordered after that store. In particular, all subsequent loads will see data"},{"DocComment":" written before the store."},{"DocComment":""},{"DocComment":" Notice that using this ordering for an operation that combines loads"},{"DocComment":" and stores leads to a [`Relaxed`] store operation!"},{"DocComment":""},{"DocComment":" This ordering is only applicable for operations that can perform a load."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_acquire`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_acquire`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Release-Acquire_ordering"}],"inline":null,"rename":null,"public":true},"name":"Acquire","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","2"]}}},{"id":3,"span":{"data":{"file_id":29,"beg":{"line":498,"col":4},"end":{"line":498,"col":10}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Has the effects of both [`Acquire`] and [`Release`] together:"},{"DocComment":" For loads it uses [`Acquire`] ordering. For stores it uses the [`Release`] ordering."},{"DocComment":""},{"DocComment":" Notice that in the case of `compare_and_swap`, it is possible that the operation ends up"},{"DocComment":" not performing any store and hence it has just [`Acquire`] ordering. However,"},{"DocComment":" `AcqRel` will never perform [`Relaxed`] accesses."},{"DocComment":""},{"DocComment":" This ordering is only applicable for operations that combine both loads and stores."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_acq_rel`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_acq_rel`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Release-Acquire_ordering"}],"inline":null,"rename":null,"public":true},"name":"AcqRel","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","3"]}}},{"id":4,"span":{"data":{"file_id":29,"beg":{"line":507,"col":4},"end":{"line":507,"col":10}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Like [`Acquire`]/[`Release`]/[`AcqRel`] (for load, store, and load-with-store"},{"DocComment":" operations, respectively) with the additional guarantee that all threads see all"},{"DocComment":" sequentially consistent operations in the same order."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_seq_cst`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_seq_cst`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Sequentially-consistent_ordering"}],"inline":null,"rename":null,"public":true},"name":"SeqCst","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","4"]}}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":1,"align":1,"discriminator":{"Branch":{"offset":0,"int_ty":{"Unsigned":"U8"},"children":[[{"start":{"Unsigned":["U8","0"]},"end":{"Unsigned":["U8","0"]}},{"Known":0}],[{"start":{"Unsigned":["U8","1"]},"end":{"Unsigned":["U8","1"]}},{"Known":1}],[{"start":{"Unsigned":["U8","2"]},"end":{"Unsigned":["U8","2"]}},{"Known":2}],[{"start":{"Unsigned":["U8","3"]},"end":{"Unsigned":["U8","3"]}},{"Known":3}],[{"start":{"Unsigned":["U8","4"]},"end":{"Unsigned":["U8","4"]}},{"Known":4}]],"fallback":"Invalid"}},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U8","0"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U8","1"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U8","2"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U8","3"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U8","4"]}]]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},null,null,null,null,{"def_id":23,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["iter",0]},{"Ident":["IntoIter",0]}],"span":{"data":{"file_id":31,"beg":{"line":20,"col":0},"end":{"line":20,"col":38}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A by-value [array] iterator."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"ArrayIntoIter"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":371}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":24,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Ident":["nonzero",0]},{"Ident":["NonZero",0]}],"span":{"data":{"file_id":32,"beg":{"line":128,"col":0},"end":{"line":128,"col":40}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A value that is known not to equal zero."},{"DocComment":""},{"DocComment":" This enables some memory layout optimization."},{"DocComment":" For example, `Option<NonZero<u32>>` is the same size as `u32`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use core::{num::NonZero};"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<Option<NonZero<u32>>>(), size_of::<u32>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":""},{"DocComment":" `NonZero<T>` is guaranteed to have the same layout and bit validity as `T`"},{"DocComment":" with the exception that the all-zero bit pattern is invalid."},{"DocComment":" `Option<NonZero<T>>` is guaranteed to be compatible with `T`, including in"},{"DocComment":" FFI."},{"DocComment":""},{"DocComment":" Thanks to the [null pointer optimization], `NonZero<T>` and"},{"DocComment":" `Option<NonZero<T>>` are guaranteed to have the same size and alignment:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::num::NonZero;"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<NonZero<u32>>(), size_of::<Option<NonZero<u32>>>());"},{"DocComment":" assert_eq!(align_of::<NonZero<u32>>(), align_of::<Option<NonZero<u32>>>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [null pointer optimization]: crate::option#representation"},{"DocComment":""},{"DocComment":" # Note on generic usage"},{"DocComment":""},{"DocComment":" `NonZero<T>` can only be used with some standard library primitive types"},{"DocComment":" (such as `u8`, `i32`, and etc.). The type parameter `T` must implement the"},{"DocComment":" internal trait [`ZeroablePrimitive`], which is currently permanently unstable"},{"DocComment":" and cannot be implemented by users. Therefore, you cannot use `NonZero<T>`"},{"DocComment":" with your own types, nor can you implement traits for all `NonZero<T>`,"},{"DocComment":" only for concrete types."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"NonZero"},"generics":