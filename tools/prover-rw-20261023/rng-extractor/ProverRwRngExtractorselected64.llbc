{"charon_version":"0.1.223","translated":{"crate_name":"aspis_r1_cost_probe","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::RealR1_client::prove_for_proof_accounts"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["crate::RealR1_client::prove_for_proof_accounts","crate::prover::prove_masked_retrying_with","crate::prover::RetriedProof","crate::prover::MaskedFixtureAudit","crate::transport::Variant","crate::verifier::Error","aspis_prover::state_only_entropy::_::generate_for_mask_nonce","aspis_prover::state_only_entropy::entropy_nonzero32","aspis_prover::state_only_entropy::StateOnlyAttemptSecrets","aspis_prover::state_only_entropy::StateOnlyAttemptEntropyError","aspis_prover::state_only_entropy::_::from","getrandom::error::Error","core::num::nonzero::NonZero","core::num::niche_types::NonZeroI32Inner","zeroize::Zeroizing","core::result::_::map_err"],"opaque":["crate","aspis_prover","aspis_core","aspis_statement"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-prover-rw-20261023/src/tools/prover-rw-20261023/rng-extractor/ProverRwRngExtractorselected64.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"crates/aspis-r1-cost-probe/src/RealR1_client.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! Host-side proof-account caller selected in LOG D162.\nuse aspis_core::HashFn;\nuse aspis_prover::state_only_entropy::{DurableStateOnlyMaskNonceStore, StateOnlyAttemptSecrets};\nuse aspis_statement::pool_v1::{\n    pair_forest_semantic_terminal::r0::Public,\n    pair_forest_trace::PoolV1PairForestMergedC1CompilationV1,\n};\nuse crate::{prover::{self, RetriedProof}, transport::Variant, verifier::Error};\n\n/// Request the public key of a retained proof account for each entered attempt.\n/// The client keeps the keys, including rejected attempts, and uses the key at\n/// `result.attempts - 1` for the published proof account. This function handles\n/// public keys only; it never creates, funds, deletes or uploads an account.\n///\n/// Keys may be chosen after prior attempts. The supplied durable ledger is\n/// shared across calls; duplicate keys fail closed, even after rejection.\n/// Only the two private 32-byte seeds come from the OS (E1); reservation uses\n/// the existing atomic, persistent ledger (E2). Errors and the eight-attempt\n/// cap are exactly those of `prove_masked_retrying_with`.\npub fn prove_for_proof_accounts(\n    public: Public<'_>,\n    compiled: &PoolV1PairForestMergedC1CompilationV1,\n    hash: HashFn,\n    nonce_store: &mut DurableStateOnlyMaskNonceStore,\n    mut proof_account: impl FnMut(usize) -> [u8; 32],\n) -> Result<RetriedProof, Error> {\n    prover::prove_masked_retrying_with(public, compiled, Variant::S2, hash, nonce_store, |k| {\n        StateOnlyAttemptSecrets::generate_for_mask_nonce(proof_account(k)).map_err(|_| Error::Entropy)\n    })\n}\n\n#[cfg(test)]\n#[path = \"RealR1_client_tests.rs\"]\nmod tests;\n"},{"id":1,"name":{"Local":"crates/aspis-r1-cost-probe/src/lib.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! UNPROVED R1 COST PROBE. P2 only; no production entrypoint.\n#![no_std]\nextern crate alloc;\npub mod sampler;\npub mod semantic_wire;\npub mod semantic;\npub mod fast_domain;\npub mod fast_dots;\npub mod fast_pairing;\n\n#[cfg(feature = \"prover\")]\nextern crate std;\npub mod r1_wire;\npub mod r1_semantic;\npub mod trace;\npub mod transport;\npub mod weights;\npub mod transcript;\npub mod verifier;\n#[cfg(feature = \"prover\")]\npub mod prover;\n/// Host client for the selected public proof-account nonce route (D162).\n#[cfg(feature = \"r1p-check\")]\n#[allow(non_snake_case)]\npub mod RealR1_client;\n#[cfg(feature = \"prover\")]\npub mod dense;\n/// G-sim (LOG D44.3): the explicit R1 simulator simE in the ideal game.\n#[cfg(feature = \"r1p-check\")]\npub mod sim;\n\n#[cfg(feature=\"prover\")] mod host_sumcheck;\n#[cfg(feature=\"prover\")] mod host_semantic;\n#[cfg(feature=\"prover\")] mod host_commitment;\n#[cfg(feature=\"prover\")] mod host_tree;\n#[cfg(feature=\"prover\")] mod host_transcript;\n#[cfg(feature=\"prover\")] mod host_wire;\n#[cfg(feature=\"prover\")] mod host_compact;\n\n// Adopted R1 proof format (PREREG-PROOF-SIZE-2, 2026-10-19): compact QM31\n// storage and binary multiproofs. UNPROVED: see PROOF-SIZE-OBLIGATIONS.\npub mod multiproof;\npub mod compact;\n\n#[cfg(not(feature=\"private-leaf-salts\"))]\ncompile_error!(\"the adopted R1 proof format is defined over private leaf salts; enable `private-leaf-salts` (a default feature)\");\n#[cfg(all(feature=\"audit-eight-way\",feature=\"prover\"))]\ncompile_error!(\"`audit-eight-way` is audit-only: it is never combined with the prover (PREREG-PROOF-SIZE-2 item 4)\");\n#[cfg(all(feature=\"audit-eight-way\",any(target_os=\"solana\",feature=\"program-build\")))]\ncompile_error!(\"`audit-eight-way` is audit-only: it is never built for a program (PREREG-PROOF-SIZE-2 item 4)\");\n\n#[cfg(all(feature = \"ct-host-prover\", feature = \"program-build\"))]\ncompile_error!(\"ct-host-prover is host-prover only, incompatible with program-build\");\n\n#[cfg(feature = \"ct-host-prover\")]\nmod ct_pole;\n\n// Fixed public-shape scheduling for the host CT adoption candidate.\n#[cfg(feature=\"ct-host-prover\")]\npub mod host_work;\n"},{"id":2,"name":{"Local":"/rustc/library/core/src/ops/function.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"crates/aspis-statement/src/pool_v1/pair_forest_semantic_terminal.rs"},"crate_name":"aspis_statement","contents":null},{"id":6,"name":{"Local":"crates/aspis-statement/src/pool_v1/mod.rs"},"crate_name":"aspis_statement","contents":null},{"id":7,"name":{"Local":"crates/aspis-statement/src/lib.rs"},"crate_name":"aspis_statement","contents":null},{"id":8,"name":{"Local":"crates/aspis-statement/src/pool_v1/pair_forest_trace.rs"},"crate_name":"aspis_statement","contents":null},{"id":9,"name":{"Local":"crates/aspis-prover/src/state_only_entropy.rs"},"crate_name":"aspis_prover","contents":null},{"id":10,"name":{"Local":"crates/aspis-prover/src/lib.rs"},"crate_name":"aspis_prover","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"crates/aspis-r1-cost-probe/src/prover.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! UNPROVED COST PROBE. Own native prover, including D14 content.\nuse alloc::{vec,vec::Vec};\nuse aspis_core::{digest::LegacyHashFn,HashFn,field::{WideExact as E,M31,QM31 as K,CM31},r0::{self,CodeField,domain::{Point,FibreIndex},merkle,wire::FibreOpening,Message},state_only_hiding::StateOnlyHidingContext};\nuse aspis_statement::pool_v1::{pair_forest_semantic_terminal::r0::Public,pair_forest_trace::PoolV1PairForestMergedC1CompilationV1};\nuse aspis_statement::pool_v1::pool_v1_pair_forest_copy_active_row_masks_v1;\nuse aspis_prover::{state_only_entropy::{StateOnlyAttemptSecrets,ReservedStateOnlyAttemptSecrets,DurableStateOnlyMaskNonceStore},state_only_hiding::{apply_pool_v1_pair_forest_mask_material_v1,InMemoryStateOnlyMaskNonceStore,StateOnlyMaskBuildError,StateOnlyMaskNonceStore}};\nuse crate::{transport::Variant,verifier::{Error},weights::{Weights,QUARTER,PERM},host_transcript::Transcript,host_commitment::{Commitment,CommitmentTime,EncodingDomain,PrivateSalts},host_semantic::{BuiltSemantics,Commitments},r1_wire::Error as SError};\n/// Host commitment backend. Adopted format (PREREG-PROOF-SIZE-2): salted\n/// leaves under binary trees; there is no unsalted or eight-way commitment.\npub struct Backend {pub hash:HashFn,pub variant:Variant,pub domain:EncodingDomain,pub messages:Vec<Message<E>>,pub c1:Option<Commitment>,pub c2:Option<Commitment>,c1_salts:Option<crate::host_commitment::PrivateSalts>,c2_salts:Option<crate::host_commitment::PrivateSalts>}\nimpl Commitments for Backend {\n    fn c1(&mut self,columns:&[Vec<M31>;26],d:&[K;1024])->Result<[u8;32],SError>{\n        let mut lane=0;\n        while lane<26 {\n            let mut row=0;\n            while row<1024 {self.messages[lane][row]=E::from_m31(columns[lane][row]);row+=1;}\n            lane+=1;\n        }\n        let mut row=0;\n        while row<1024 {self.messages[28][row]=E::from_qm31(d[row]);row+=1;}\n\n        let salts=self.c1_salts.take().ok_or(SError::Public)?;\n        let c=Commitment::new_salted(self.hash,&self.domain,CommitmentTime::C1,&self.messages,self.variant,salts).map_err(|_|SError::Public)?;\n        let root=c.root();self.c1=Some(c);Ok(root)\n    }\n    fn c2(&mut self,h1:&[K],g:&[K;1024])->Result<[u8;32],SError>{\n        let mut row=0;\n        while row<1024 {self.messages[26][row]=E::from_qm31(h1[row]);row+=1;}\n        row=0;\n        while row<1024 {self.messages[27][row]=E::from_qm31(g[row]);row+=1;}\n\n        let salts=self.c2_salts.take().ok_or(SError::Public)?;\n        let c=Commitment::new_salted(self.hash,&self.domain,CommitmentTime::C2,&self.messages,self.variant,salts).map_err(|_|SError::Public)?;\n        let root=c.root();self.c2=Some(c);Ok(root)\n    }\n}\npub fn round(q:&[E],w:&[E])->[E;7] {\n    assert_eq!(q.len(),w.len());\n    let mut c=[E::ZERO;7];\n    let mut d=0;\n    while d<q.len()/4 {\n        let mut s=0;\n        while s<4 {\n            let mut t=0;\n            while t<4 {\n                let at=s+PERM[t];\n                c[at]=c[at].add(q[4*d+s].mul(w[4*d+t]));\n                t+=1;\n            }\n            s+=1;\n        }\n        d+=1;\n    }\n    let mut i=0;\n    while i<7 {c[i]=c[i].mul_m31(QUARTER);i+=1;}\n    c\n}\npub fn fold(q:&[E],alpha:E,dual:bool)->Vec<E> {\n    let mut out=Vec::with_capacity(q.len()/4);\n    let mut i=0;\n    while i<q.len()/4 {\n        let h=[q[4*i],q[4*i+1],q[4*i+2],q[4*i+3]];\n        let value=fold_cell(h,alpha,dual);\n        out.push(value);i+=1;\n    }\n    out\n}\n\n#[inline(always)]\nfn fold_cell(h:[E;4],alpha:E,dual:bool)->E {\n    if dual {\n            h[0].add(alpha.mul(h[3].add(alpha.mul(h[2].add(alpha.mul(h[1])))))).mul_m31(QUARTER)\n        } else {\n            h[0].add(alpha.mul(h[1].add(alpha.mul(h[2].add(alpha.mul(h[3]))))))\n        }\n}\n\n/// Ordered byte assembly used by the real pipeline; each field encoding is a leaf.\nfn encoded_slice(values:&[E])->Vec<u8> {\n    let mut out=Vec::with_capacity(32*values.len());\n    let mut i=0;\n    while i<values.len() {out.extend_from_slice(&values[i].to_le_bytes());i+=1;}\n    out\n}\n\npub fn encoded(values:impl IntoIterator<Item=E>)->Vec<u8> {values.into_iter().flat_map(E::to_le_bytes).collect()}\n\n/// Deterministic fixture-only rejection sampling of K limbs. No distribution\n/// property is inferred from these fixed test samples.\nfn tail_samples(hash:HashFn,seed:&[u8;32])->[K;56] {\n    let mut counter=0u64;\n    let mut limb=||loop {\n        let b=hash(&[b\"UNPROVED:R1:P2:fixture-tail\",seed,&counter.to_le_bytes()]);counter+=1;\n        let x=u32::from_le_bytes(b[..4].try_into().unwrap())&0x7fffffff;\n        if x<aspis_core::field::P {break M31(x);}\n    };\n    core::array::from_fn(|_|K{c0:CM31::new(limb(),limb()),c1:CM31::new(limb(),limb())})\n}\n/// Convenience API, deliberately fixture-only: it always emits a fully masked\n/// P3 proof in the adopted compact binary-multiproof format.\npub fn prove(public:Public<'_>,compiled:&PoolV1PairForestMergedC1CompilationV1,variant:Variant,hash:HashFn,seed:&[u8;32])->Result<Vec<u8>,Error> {\n    prove_masked_fixture(public,compiled,variant,hash,seed).map(|(proof,_)|proof)\n}\n\n/// Checks describing the fixture mask constraints exercised before proving.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct MaskedFixtureAudit {\n    pub c1_columns_inactive_balanced: usize,\n    pub mask_only_columns_inactive_balanced: usize,\n    pub d_inactive_balanced: bool,\n    pub g_inactive_balanced: bool,\n    pub h1_padding_inactive_balanced: bool,\n    pub h1_total_balanced: bool,\n}\n\nfn fixture_secret(hash:HashFn,domain:&[u8],seed:&[u8;32],public:&[u8],variant:Variant)->Result<[u8;32],Error> {\n    let mut value=hash(&[domain,seed,public,&[variant.tag()]]);\n    if value==[0;32] { return Err(Error::Semantic); }\n    Ok(value)\n}\n\nfn inactive_sum_m31(values:&[M31],masks:&[u16;64])->M31 {\n    let mut sum=M31::ZERO;\n    let mut row=0;\n    while row<values.len() {\n        if masks[row>>4]&(1<<(row&15))==0 {sum=sum.add(values[row]);}\n        row+=1;\n    }\n    sum\n}\n\nfn inactive_sum_k(values:&[K],masks:&[u16;64])->K {\n    let mut sum=K::ZERO;\n    let mut row=0;\n    while row<values.len() {\n        if masks[row>>4]&(1<<(row&15))==0 {sum=sum.add(values[row]);}\n        row+=1;\n    }\n    sum\n}\n\n/// Deterministic, insecure masked fixture path. Its derivations exist only for\n/// reproducible local cost experiments and are not production entropy.\npub fn prove_masked_fixture(\n    public:Public<'_>,\n    compiled:&PoolV1PairForestMergedC1CompilationV1,\n    variant:Variant,\n    hash:HashFn,\n    fixture_seed:&[u8;32],\n)->Result<(Vec<u8>,MaskedFixtureAudit),Error> {\n    let public_bytes=public.public_bytes().map_err(|_|Error::Semantic)?;\n    let context=StateOnlyHidingContext::pool_v1_pair_forest_v1(hash(&[&public_bytes]),fixture_secret(hash,b\"UNPROVED:R1:fixture-mask-nonce\",fixture_seed,&public_bytes,variant)?);\n    let binding=hash(&[b\"UNPROVED:R1:P3:PRIVATE-ATTEMPT\",&public_bytes,&[variant.tag()],&context.encode()]);\n    let attempt=StateOnlyAttemptSecrets::deterministic_spend_fixture(\n        context.mask_nonce,\n        fixture_secret(hash,b\"UNPROVED:R1:fixture-field-entropy\",fixture_seed,&public_bytes,variant)?,\n        fixture_secret(hash,b\"UNPROVED:R1:fixture-leaf-seed\",fixture_seed,&public_bytes,variant)?,\n    );\n    let mut nonce_store=InMemoryStateOnlyMaskNonceStore::default();\n    prove_masked_with_attempt(public,compiled,variant,hash,context,binding,attempt,&mut nonce_store)\n}\n\n/// Secure-source P3 host API. Callers must supply OS-generated attempt\n/// secrets and a durable nonce ledger; successful reservations happen before\n/// mask derivation and leaf-salt derivation. This is still an UNPROVED\n/// protocol: fresh entropy alone does not establish zero knowledge.\npub fn prove_masked_attempt(\n    public:Public<'_>,\n    compiled:&PoolV1PairForestMergedC1CompilationV1,\n    variant:Variant,\n    hash:HashFn,\n    attempt:StateOnlyAttemptSecrets,\n    nonce_store:&mut DurableStateOnlyMaskNonceStore,\n)->Result<(Vec<u8>,MaskedFixtureAudit),Error> {\n    let public_bytes=public.public_bytes().map_err(|_|Error::Semantic)?;\n    let context=StateOnlyHidingContext::pool_v1_pair_forest_v1(hash(&[&public_bytes]),attempt.mask_nonce());\n    let binding=hash(&[b\"UNPROVED:R1:P3:PRIVATE-ATTEMPT\",&public_bytes,&[variant.tag()],&context.encode()]);\n    prove_masked_with_attempt(public,compiled,variant,hash,context,binding,attempt,nonce_store)\n}\n\nfn prove_masked_with_attempt(\n    public:Public<'_>,\n    compiled:&PoolV1PairForestMergedC1CompilationV1,\n    variant:Variant,\n    hash:HashFn,\n    context:StateOnlyHidingContext,\n    binding:[u8;32],\n    attempt:StateOnlyAttemptSecrets,\n    nonce_store:&mut impl StateOnlyMaskNonceStore,\n)->Result<(Vec<u8>,MaskedFixtureAudit),Error> {\n    let (reserved,material)=attempt.reserve_and_build_pool_v1_pair_forest_mask_material_v1(hash,binding,context,nonce_store).map_err(mask_error)?;\n    #[cfg(all(test,feature=\"r1p-check\"))]\n    if test_hooks::forced_exhaustion(reserved.mask_nonce()) { return Err(mask_error(StateOnlyMaskBuildError::MaskSampleExhausted)); }\n    let mut noised_c1=compiled.semantic_c1.clone();\n    let applied=apply_pool_v1_pair_forest_mask_material_v1(&mut noised_c1,material).map_err(|_|Error::Semantic)?;\n    let masks=pool_v1_pair_forest_copy_active_row_masks_v1().map_err(|_|Error::Semantic)?;\n    let d: [K;1024]=reserved.derive_pool_v1_pair_forest_zero_factor_d(hash,context).map_err(mask_error)?.try_into().map_err(|_|Error::Semantic)?;\n    if applied.g.len()!=1024 || applied.h1_padding.len()!=1024 { return Err(Error::Semantic); }\n    let g=fixed_k_column(&applied.g);\n    let h1_padding=fixed_k_column(&applied.h1_padding);\n    let audit=audit_masks(&noised_c1.c1,&applied.mask_only_c1,&d,&g,&h1_padding,&masks);\n    if audit.c1_columns_inactive_balanced!=16\n        || audit.mask_only_columns_inactive_balanced!=10\n        || !audit.d_inactive_balanced\n        || !audit.g_inactive_balanced\n        || !audit.h1_padding_inactive_balanced\n    { return Err(Error::Semantic); }\n    let (c1_salts,c2_salts)=(Some(derive_private_salts(&reserved,context,hash,merkle::C1_TAG)?),Some(derive_private_salts(&reserved,context,hash,merkle::C2_TAG)?));\n    #[cfg(all(test,feature=\"r1p-check\"))]\n    test_hooks::observe_secrets(hash,reserved.mask_nonce(),&g,c1_salts.as_ref().unwrap().get(0));\n    let mut backend=Backend{hash,variant,domain:EncodingDomain::new().map_err(|_|Error::Allocation)?,messages:vec![[E::ZERO;1024];29],c1:None,c2:None,c1_salts,c2_salts};\n    let sem=crate::host_semantic::build_with_material(public,compiled,&noised_c1,&applied.mask_only_c1,&d,&g,&h1_padding,&mut backend,LegacyHashFn(hash),variant).map_err(semantic_error)?;\n    let h1_total_balanced=aspis_statement::state_only_copy_helper_sum(&sem.columns[26])==Some(K::ZERO);\n    if !h1_total_balanced { return Err(Error::Semantic); }\n    let audit=MaskedFixtureAudit{h1_total_balanced,..audit};\n    let proof=prove_from_semantics(public,variant,hash,backend,sem,(&reserved,context))?;\n    Ok((proof,audit))\n}\n\n/// Fixed-size copy with no closure retaining a material-owner loan.\nfn fixed_k_column(values:&[K])->[K;1024] {\n    let mut out=[K::ZERO;1024];\n    let mut i=0;\n    while i<1024 {out[i]=values[i];i+=1;}\n    out\n}\nfn audit_masks(c1:&[Vec<M31>],mask_only:&[Vec<M31>;10],d:&[K;1024],g:&[K;1024],h1_padding:&[K;1024],masks:&[u16;64])->MaskedFixtureAudit {\n    let mut c1_columns_inactive_balanced=0;\n    let mut column=0;\n    while column<c1.len() {\n        if inactive_sum_m31(&c1[column],masks)==M31::ZERO {c1_columns_inactive_balanced+=1;}\n        column+=1;\n    }\n    let mut mask_only_columns_inactive_balanced=0;\n    column=0;\n    while column<10 {\n        if inactive_sum_m31(&mask_only[column],masks)==M31::ZERO {mask_only_columns_inactive_balanced+=1;}\n        column+=1;\n    }\n    MaskedFixtureAudit{\n        c1_columns_inactive_balanced,\n        mask_only_columns_inactive_balanced,\n        d_inactive_balanced:inactive_sum_k(d,masks)==K::ZERO,\n        g_inactive_balanced:inactive_sum_k(g,masks)==K::ZERO,\n        h1_padding_inactive_balanced:inactive_sum_k(h1_padding,masks)==K::ZERO,\n        h1_total_balanced:true,\n    }\n\n}\n\n/// LOG D73.4.2: Lean `realGameP` rejects an attempt whose mask decode is\n/// exhausted (`exh`, R1Z/GamesR1P.lean:164, 184) and moves to the next one.\n/// With the retry loop, `MaskSampleExhausted` from either expander is\n/// therefore a rejected attempt; every other mask error still aborts. Without\n/// the loop (`r1p-check` off) behaviour is unchanged.\nfn mask_error(e:StateOnlyMaskBuildError)->Error {\n    #[cfg(feature=\"r1p-check\")]\n    if e==StateOnlyMaskBuildError::MaskSampleExhausted { return Error::Rejected; }\n    let _=e;\n    Error::Semantic\n}\n\n/// LOG D73.4.1: a LogUp pole (Lean `¬ VR1`, R1Z/MaskImageVR1.lean:29) is a\n/// rejected attempt. The pole carries no detail; it becomes the same\n/// `Error::Rejected` as a failed P_R1 check.\nfn semantic_error(e:SError)->Error {\n    #[cfg(feature=\"r1p-check\")]\n    if e==SError::ActivePole { return Error::Rejected; }\n    let _=e;\n    Error::Semantic\n}\n\nfn derive_private_salts(reserved:&ReservedStateOnlyAttemptSecrets,context:StateOnlyHidingContext,hash:HashFn,tag:u8)->Result<PrivateSalts,Error> {\n    let count=aspis_core::r0::FIBRE_COUNT;\n\n    let mut salts=Vec::new();salts.try_reserve_exact(aspis_core::r0::FIBRE_COUNT).map_err(|_|Error::Allocation)?;\n    let mut result=Ok(salts);\n    let mut index=0usize;\n    while index<count {\n        result=match result {\n            Ok(salts)=>derive_private_salt_step(reserved,context,hash,tag,index as u32,salts),\n            Err(error)=>Err(error),\n        };\n        index+=1;\n    }\n    result.map(PrivateSalts::new)\n}\n\n/// The R1 proof (PREREG-PROOF-SIZE-2, adopted 2026-10-19): binary trees (C1/C2\n/// built by the Backend, the padded folded tree here) and the fixed-length\n/// compact stored format of `crate::compact` (57,607 bytes). Every transcript\n/// message is the logical byte string of the retired eight-way format; only\n/// the roots (binary trees) and the stored encoding differ. R1 is variant S2.\n/// Owned result of rows 27–29. No transcript loan or iterator survives a phase.\nstruct PreparedOpening {\n    backend:Backend,\n    sem:BuiltSemantics<LegacyHashFn>,\n    transcript:Transcript<LegacyHashFn>,\n    y1:Vec<u8>,\n    gamma:E,\n    inactive:E,\n    kappa:E,\n    alpha0:E,\n    c0bytes:Vec<u8>,\n    q1:Vec<E>,\n    w1:Vec<E>,\n    folded_word:Vec<E>,\n}\n\nfn prepare_opening(variant:Variant,hash:HashFn,backend:Backend,sem:BuiltSemantics<LegacyHashFn>)->Result<PreparedOpening,Error> {\n    if variant!=Variant::S2 {return Err(Error::Semantic);}\n    let coefficients=opening_coefficients(variant,&backend.messages);\n    let z1=Point{x:E::from_qm31(sem.z[1].x),y:E::from_qm31(sem.z[1].y)};\n    let y1=opening_claim_bytes(&coefficients,z1);\n    let mut transcript=Transcript::new(LegacyHashFn(hash),sem.transcript.state(),variant);\n    let gamma=transcript.scalar(27,&y1,true);\n    let q=opening_batch(&coefficients,gamma);\n    let w=Weights::new(variant,&sem.alpha,&sem.z)?;\n    let inactive=opening_inactive(&q,&w);\n    let kappa=transcript.scalar(28,&inactive.to_le_bytes(),false);\n    let weights=w.materialize(kappa)?;\n    let c0=round(&q,&weights);\n    let c0bytes=encoded_slice(&c0);\n    let alpha0=transcript.scalar(29,&c0bytes,false);\n    let q1=fold(&q,alpha0,false);\n    let w1=fold(&weights,alpha0,true);\n    let folded_word=backend.domain.evaluate(&q1,0).map_err(|_|Error::Allocation)?;\n    Ok(PreparedOpening{backend,sem,transcript,y1,gamma,inactive,kappa,alpha0,c0bytes,q1,w1,folded_word})\n}\n\n/// Coefficient permutation is a small unchanged leaf; the vector owner is here.\nfn opening_coefficients(variant:Variant,messages:&[Message<E>])->Vec<Message<E>> {\n    let mut coefficients=Vec::with_capacity(messages.len());\n    let mut lane=0;\n    while lane<messages.len() {let column=variant.coefficients(&messages[lane]);coefficients.push(column);lane+=1;}\n    coefficients\n}\nfn opening_claim_bytes(coefficients:&[Message<E>],z1:Point<E>)->Vec<u8> {\n    let mut bytes=Vec::with_capacity(32*coefficients.len());\n    let mut lane=0;\n    while lane<coefficients.len() {\n        let value=r0::encoder::eval_message(&coefficients[lane],z1);\n        bytes.extend_from_slice(&value.to_le_bytes());lane+=1;\n    }\n    bytes\n}\nfn opening_batch(coefficients:&[Message<E>],gamma:E)->Vec<E> {\n    let gp=crate::weights::powers::<29>(gamma);\n    let mut q=Vec::with_capacity(1024);let mut row=0;\n    while row<1024 {let value=opening_row(coefficients,&gp,row);q.push(value);row+=1;}\n    q\n}\n#[inline(always)]\nfn opening_row(coefficients:&[Message<E>],gp:&[E;29],row:usize)->E {\n    let mut value=E::ZERO;let mut lane=0;\n    while lane<29 {value=value.add(gp[lane].mul(coefficients[lane][row]));lane+=1;}\n    value\n}\nfn opening_inactive(q:&[E],w:&Weights)->E {\n    let mut inactive=E::ZERO;\n    let mut row=0;\n    while row<1024 {inactive=inactive.add(q[row].mul_qm31(w.raw(0,row)));row+=1;}\n    inactive\n}\n\n/// Owned input to the publication phase. Constructed only after P_R1 accepts.\nstruct Publication {\n    backend:Backend,\n    semantic_bytes:Vec<u8>,\n    y1:Vec<u8>,\n    inactive:E,\n    c0bytes:Vec<u8>,\n    root:[u8;32],\n    c1bytes:Vec<u8>,\n    fbytes:Vec<u8>,\n    queries:[u32;22],\n    folded_word:Vec<E>,\n    folded_salts:PrivateSalts,\n    tree:crate::host_tree::BinaryTree,\n}\n\nfn folded_leaves(hash:HashFn,word:&[E],salts:&PrivateSalts)->Vec<[u8;32]> {\n    let mut leaves=Vec::with_capacity(1<<18);\n    let mut u=0;\n    while u<1<<18 {\n        let mut values=[0u8;128];\n        if u<1<<16 {\n            let mut s=0;\n            while s<4 {\n                values[32*s..32*(s+1)].copy_from_slice(&word[4*u+s].to_le_bytes());\n                s+=1;\n            }\n        }\n        let leaf=aspis_core::state_only_private_merkle::private_leaf_hash(hash,0x72,&values,salts.get(u));\n        leaves.push(leaf);\n        u+=1;\n    }\n    leaves\n}\n\nfn finish_opening(variant:Variant,hash:HashFn,prepared:PreparedOpening,folded_salts:PrivateSalts)->Result<Publication,Error> {\n    let PreparedOpening{backend,sem,mut transcript,y1,gamma,inactive,kappa,alpha0,c0bytes,q1,w1,folded_word}=prepared;\n    let leaves=folded_leaves(hash,&folded_word,&folded_salts);\n    let tree=crate::host_tree::BinaryTree::new(LegacyHashFn(hash),leaves).ok_or(Error::Allocation)?;\n    let root=tree.root();\n    let c1=round(&q1,&w1);\n    let c1bytes=encoded_slice(&c1);\n    let mut payload=root.to_vec();payload.extend_from_slice(&c1bytes);\n    let alpha1=transcript.scalar(30,&payload,false);\n    let final_message=fold(&q1,alpha1,false);\n    let fbytes=encoded_slice(&final_message);\n    let queries=transcript.queries(31,&fbytes)?;\n    let _rho=transcript.scalar_k(32,&[]);\n    #[cfg(feature=\"r1p-check\")]\n    public_check(variant,&R1PublicChallenges{\n        alpha:sem.alpha,z:[[sem.z[0].x,sem.z[0].y],[sem.z[1].x,sem.z[1].y]],\n        gamma,kappa,alpha0,alpha1,queries:queries.to_vec(),\n    },sem.roots[0])?;\n    Ok(Publication{backend,semantic_bytes:sem.bytes,y1,inactive,c0bytes,root,c1bytes,fbytes,\n        queries,folded_word,folded_salts,tree})\n}\n\n/// Counted insertion and dedup on at most 22 public query indices. Sorting is\n/// explicit so publication does not depend on an opaque standard sort adapter.\nfn publication_indices(queries:&[u32;22],begin:usize,end:usize,folded:bool)->Vec<u32> {\n    let mut out=Vec::with_capacity(end-begin);\n    let mut i=begin;\n    while i<end {\n        let value=if folded {queries[i]/4} else {queries[i]};\n        let mut at=0;\n        while at<out.len() && out[at]<value {at+=1;}\n        if at==out.len() || out[at]!=value {out.insert(at,value);}\n        i+=1;\n    }\n    out\n}\n\nfn publish_compact(variant:Variant,p:Publication)->Result<Vec<u8>,Error> {\n    use crate::host_compact as compact;\n    let Publication{mut backend,semantic_bytes,y1,inactive,c0bytes,root,c1bytes,fbytes,\n        queries,folded_word,folded_salts,tree}=p;\n    let mut out=Vec::with_capacity(compact::PROOF_BYTES);\n    out.extend_from_slice(compact::MAGIC);\n    out.extend_from_slice(&[variant.tag(),0,0,0,0,0,0,0]);\n    compact::compact_semantic(&semantic_bytes,&mut out).map_err(|_|Error::Semantic)?;\n    compact::compact_values(&y1,&mut out).map_err(|_|Error::Semantic)?;\n    out.extend_from_slice(&inactive.to_le_bytes());out.extend_from_slice(&c0bytes);\n    out.extend_from_slice(&root);out.extend_from_slice(&c1bytes);out.extend_from_slice(&fbytes);\n    assert_eq!(out.len(),compact::OFF_OPENINGS);\n    let cc1=backend.c1.take().unwrap();\n    let cc2=backend.c2.take().unwrap();\n    out=append_query_openings(out,&cc1,&cc2,&queries,&folded_word,&folded_salts);\n    assert_eq!(out.len(),compact::OFF_NODES);\n    out=append_node_slots(out,&cc1,&cc2,&tree,&queries)?;\n    assert_eq!(out.len(),compact::PROOF_BYTES);\n    Ok(out)\n}\n\nfn append_node_slots(out:Vec<u8>,cc1:&Commitment,cc2:&Commitment,tree:&crate::host_tree::BinaryTree,queries:&[u32;22])->Result<Vec<u8>,Error> {\n    let out=append_node_slot(out,cc1,cc2,tree,queries,0,0)?;\n    let out=append_node_slot(out,cc1,cc2,tree,queries,0,1)?;\n    let out=append_node_slot(out,cc1,cc2,tree,queries,0,2)?;\n    let out=append_node_slot(out,cc1,cc2,tree,queries,1,0)?;\n    let out=append_node_slot(out,cc1,cc2,tree,queries,1,1)?;\n    append_node_slot(out,cc1,cc2,tree,queries,1,2)\n}\nfn append_node_slot(mut out:Vec<u8>,cc1:&Commitment,cc2:&Commitment,tree:&crate::host_tree::BinaryTree,queries:&[u32;22],batch:usize,t:usize)->Result<Vec<u8>,Error> {\n    use crate::compact;\n    let begin=if batch==0 {0} else {compact::SPLIT};\n    let end=if batch==0 {compact::SPLIT} else {22};\n    let idx=publication_indices(queries,begin,end,t==2);\n    let nodes=match t {0=>cc1.multiproof(&idx),1=>cc2.multiproof(&idx),_=>tree.multiproof(&idx)}.ok_or(Error::Allocation)?;\n    let cap=32*compact::SLOT_NODES[3*batch+t];\n    assert!(nodes.len()<=cap);\n    out.extend_from_slice(&nodes);\n    let padded=out.len()+cap-nodes.len();\n    out.resize(padded,0);\n    Ok(out)\n}\n\n/// The query loop carries only the output buffer and immutable opening data.\nfn append_query_openings(mut out:Vec<u8>,cc1:&Commitment,cc2:&Commitment,queries:&[u32;22],folded_word:&[E],folded_salts:&PrivateSalts)->Vec<u8> {\n    let mut i=0;\n    while i<22 {\n        let u=FibreIndex::new(queries[i] as usize).unwrap();\n        let mut opening=FibreOpening{values:[[E::ZERO;29];4],paths:[[[[0;32];7];6];2]};\n        cc1.fill_opening(u,&mut opening);cc2.fill_opening(u,&mut opening);\n        out=append_opening_values(out,opening);\n        out.extend_from_slice(cc1.opening_salt(u).unwrap());\n        out.extend_from_slice(cc2.opening_salt(u).unwrap());\n        let at=4*(u.get()/4);\n        let values=encoded_slice(&folded_word[at..at+4]);\n        out.extend_from_slice(&values);\n        out.extend_from_slice(folded_salts.get(u.get()/4));\n        i+=1;\n    }\n    out\n}\n\n/// No commitment or publication loan enters this nested byte-assembly loop.\nfn append_opening_values(out:Vec<u8>,opening:FibreOpening)->Vec<u8> {\n    let out=append_opening_base_row(out,&opening.values[0]);\n    let out=append_opening_base_row(out,&opening.values[1]);\n    let out=append_opening_base_row(out,&opening.values[2]);\n    let out=append_opening_base_row(out,&opening.values[3]);\n    let out=append_opening_secure_row(out,&opening.values[0]);\n    let out=append_opening_secure_row(out,&opening.values[1]);\n    let out=append_opening_secure_row(out,&opening.values[2]);\n    append_opening_secure_row(out,&opening.values[3])\n}\nfn append_opening_base_row(mut out:Vec<u8>,row:&[E;29])->Vec<u8> {\n    let mut lane=0;\n    while lane<26 {\n        let bytes=row[lane].to_le_bytes();out.extend_from_slice(&bytes[..4]);lane+=1;\n    }\n    let bytes=row[28].to_le_bytes();out.extend_from_slice(&bytes[..16]);\n    out\n}\nfn append_opening_secure_row(mut out:Vec<u8>,row:&[E;29])->Vec<u8> {\n    let mut lane=26;\n    while lane<28 {\n        let bytes=row[lane].to_le_bytes();out.extend_from_slice(&bytes[..16]);lane+=1;\n    }\n    out\n}\n\nfn prove_from_semantics(public:Public<'_>,variant:Variant,hash:HashFn,backend:Backend,sem:BuiltSemantics<LegacyHashFn>,salts:(&ReservedStateOnlyAttemptSecrets,StateOnlyHidingContext))->Result<Vec<u8>,Error> {\n    let _=public;\n    let prepared=prepare_opening(variant,hash,backend,sem)?;\n    let (reserved,context)=salts;\n    let folded_salts=derive_private_salts(reserved,context,hash,0x72)?;\n    let publication=finish_opening(variant,hash,prepared,folded_salts)?;\n    publish_compact(variant,publication)\n}\n\n// ---------------------------------------------------------------------------\n// LOG D38.3 / D41.3 / D45.5 R-retry: the prover-side P_R1 check and the capped\n// retry loop. The check is the extracted C3 checker (D57) behind z9e's\n// public-data and certificate construction; it reads public challenges only.\n\n/// The attempt cap N of the retry loop (D38.3, accepted N = 8).\npub const ATTEMPT_CAP: usize = 8;\n\n#[cfg(all(feature=\"r1p-check\", not(feature=\"private-leaf-salts\")))]\ncompile_error!(\"the P_R1 retry loop requires `private-leaf-salts` (LOG D38.3)\");\n\n#[cfg(feature=\"r1p-check\")]\npub use aspis_z4b_probe::{R1CheckTimes, R1PublicChallenges};\n\n#[cfg(feature=\"r1p-check\")]\nstd::thread_local! {\n    #[cfg(not(feature=\"ct-host-prover\"))] static CHECK_TIMES: core::cell::RefCell<Vec<R1CheckTimes>> = const { core::cell::RefCell::new(Vec::new()) };\n}\n\n/// Durations of the P_R1 checks run on this thread since the last call.\n/// Only durations are kept: never a verdict's reason, a challenge or a root.\n#[cfg(feature=\"r1p-check\")]\npub fn take_check_times() -> Vec<R1CheckTimes> {\n    #[cfg(not(feature=\"ct-host-prover\"))] { CHECK_TIMES.with(|v| core::mem::take(&mut *v.borrow_mut())) } #[cfg(feature=\"ct-host-prover\")] { Vec::new() }\n}\n\n/// P_R1 on one attempt. R1 is variant S2; P_R1 is not defined for the others.\n#[cfg(feature=\"r1p-check\")]\nfn public_check(variant:Variant,challenges:&R1PublicChallenges,c1_root:[u8;32])->Result<(),Error> {\n    if variant!=Variant::S2 { return Err(Error::Semantic); }\n    #[cfg(test)]\n    test_hooks::observe_challenges(challenges);\n    #[cfg(test)]\n    if let Some(accepted)=test_hooks::forced_verdict(c1_root) {\n        return if accepted {Ok(())} else {Err(Error::Rejected)};\n    }\n    let _=c1_root;\n    let (accepted,times)=aspis_z4b_probe::p_r1_check(challenges);\n    #[cfg(not(feature=\"ct-host-prover\"))] CHECK_TIMES.with(|v| v.borrow_mut().push(times)); #[cfg(feature=\"ct-host-prover\")] let _ = times;\n    if accepted {Ok(())} else {Err(Error::Rejected)}\n}\n\n/// One published proof from the retry loop.\n#[cfg(feature=\"r1p-check\")]\npub struct RetriedProof { pub proof:Vec<u8>, pub audit:MaskedFixtureAudit, pub attempts:usize }\n\n/// D38.3 retry loop with fresh OS attempt secrets for every attempt.\n#[cfg(feature=\"r1p-check\")]\npub fn prove_masked_retrying(\n    public:Public<'_>,\n    compiled:&PoolV1PairForestMergedC1CompilationV1,\n    variant:Variant,\n    hash:HashFn,\n    nonce_store:&mut DurableStateOnlyMaskNonceStore,\n)->Result<RetriedProof,Error> {\n    prove_masked_retrying_with(public,compiled,variant,hash,nonce_store,|_|StateOnlyAttemptSecrets::generate().map_err(|_|Error::Entropy))\n}\n\n/// D38.3 retry loop. `next_attempt(k)` must return fresh OS-generated secrets\n/// for attempt k; a client that binds the nonce to the proof-account address\n/// (D38.4) generates a fresh account keypair per attempt and calls\n/// `StateOnlyAttemptSecrets::generate_for_mask_nonce` with its public key.\n///\n/// Each attempt durably burns its nonce in `nonce_store` before any mask or\n/// salt is derived (`reserve_and_build_…`). As in Lean `realGameP`\n/// (R1Z/GamesR1P.lean:184: accept on `P ∧ VR1 ∧ ¬ exh`), an attempt is\n/// rejected when its challenges fail P_R1, when χ is a LogUp pole (`¬ VR1`,\n/// LOG D40.3, D73.4.1), or when its mask decode is exhausted (`exh`,\n/// D73.4.2). Each returns the same detail-free `Error::Rejected` before any\n/// proof byte exists; its secrets are dropped (zeroized), it consumes one of\n/// the `ATTEMPT_CAP` attempts, and nothing about it is returned or logged.\n/// After `ATTEMPT_CAP` rejections the result is `AttemptsExhausted` and\n/// nothing is published (Lean's fixed `failView`, R1Z/GamesR1P.lean:185).\n/// Any other error aborts.\n#[cfg(feature=\"r1p-check\")]\npub fn prove_masked_retrying_with(\n    public:Public<'_>,\n    compiled:&PoolV1PairForestMergedC1CompilationV1,\n    variant:Variant,\n    hash:HashFn,\n    nonce_store:&mut DurableStateOnlyMaskNonceStore,\n    next_attempt:impl FnMut(usize)->Result<StateOnlyAttemptSecrets,Error>,\n)->Result<RetriedProof,Error> {\n    if variant!=Variant::S2 { return Err(Error::Semantic); }\n    retry_attempt(public,compiled,variant,hash,nonce_store,next_attempt,0)\n}\n\nfn retry_attempt(\n    public:Public<'_>,\n    compiled:&PoolV1PairForestMergedC1CompilationV1,\n    variant:Variant,\n    hash:HashFn,\n    nonce_store:&mut DurableStateOnlyMaskNonceStore,\n    mut next_attempt:impl FnMut(usize)->Result<StateOnlyAttemptSecrets,Error>,\n    k:usize,\n)->Result<RetriedProof,Error> {\n    if k>=ATTEMPT_CAP { return Err(Error::AttemptsExhausted); }\n    let attempt=next_attempt(k)?;\n    match prove_masked_attempt(public,compiled,variant,hash,attempt,nonce_store) {\n        Ok((proof,audit))=>Ok(RetriedProof{proof,audit,attempts:k+1}),\n        Err(Error::Rejected)=>retry_attempt(public,compiled,variant,hash,nonce_store,next_attempt,k+1),\n        Err(e)=>Err(e),\n    }\n}\n\n/// Test-only injection (cfg(test)): a queue of forced P_R1 verdicts, and a\n/// per-attempt record of public/derived freshness witnesses.\n#[cfg(all(test,feature=\"r1p-check\"))]\npub(crate) mod test_hooks {\n    use alloc::{collections::VecDeque,vec::Vec};\n    use aspis_core::{HashFn,field::QM31};\n    #[derive(Clone,Debug,Default)]\n    pub struct Attempt {\n        pub mask_nonce:[u8;32],\n        /// Digest of the G mask column (a function of the field-mask entropy).\n        pub g_digest:[u8;32],\n        /// Digest of the first private C1 leaf salt (a function of the leaf-salt seed).\n        pub salt_digest:[u8;32],\n        pub c1_root:Option<[u8;32]>,\n        pub forced_verdict:Option<bool>,\n        /// The pole hook fired on this attempt (no P_R1 check ran).\n        pub pole:bool,\n        /// The mask-exhaustion hook fired on this attempt (nothing derived).\n        pub exhausted:bool,\n    }\n    std::thread_local! {\n        static VERDICTS: core::cell::RefCell<Option<VecDeque<bool>>> = const { core::cell::RefCell::new(None) };\n        static ATTEMPTS: core::cell::RefCell<Vec<Attempt>> = const { core::cell::RefCell::new(Vec::new()) };\n        /// 1-based attempt numbers on which the Lean `NoPole` test is forced false.\n        static POLES: core::cell::RefCell<Vec<usize>> = const { core::cell::RefCell::new(Vec::new()) };\n        /// 1-based attempt numbers whose mask decode is forced exhausted.\n        static EXHAUST: core::cell::RefCell<Vec<usize>> = const { core::cell::RefCell::new(Vec::new()) };\n    }\n    pub fn force_poles(attempts:&[usize]) { POLES.with(|p| *p.borrow_mut()=attempts.to_vec()); }\n    pub fn force_exhaustion(attempts:&[usize]) { EXHAUST.with(|p| *p.borrow_mut()=attempts.to_vec()); }\n    /// Called from `host_semantic::no_pole` after `observe_secrets` recorded\n    /// the current attempt.\n    pub(crate) fn forced_pole()->bool {\n        let k=ATTEMPTS.with(|a| a.borrow().len());\n        let hit=POLES.with(|p| p.borrow().contains(&k));\n        if hit { ATTEMPTS.with(|a| if let Some(last)=a.borrow_mut().last_mut() {last.pole=true;}); }\n        hit\n    }\n    /// Called right after the nonce reservation, before `observe_secrets`.\n    pub(crate) fn forced_exhaustion(mask_nonce:[u8;32])->bool {\n        let k=ATTEMPTS.with(|a| a.borrow().len())+1;\n        let hit=EXHAUST.with(|p| p.borrow().contains(&k));\n        if hit { ATTEMPTS.with(|a| a.borrow_mut().push(Attempt{mask_nonce,exhausted:true,..Attempt::default()})); }\n        hit\n    }\n    pub fn force(verdicts:&[bool]) {\n        VERDICTS.with(|v| *v.borrow_mut()=Some(verdicts.iter().copied().collect()));\n        ATTEMPTS.with(|a| a.borrow_mut().clear());\n    }\n    pub fn clear() {\n        VERDICTS.with(|v| *v.borrow_mut()=None);\n        ATTEMPTS.with(|a| a.borrow_mut().clear());\n        POLES.with(|p| p.borrow_mut().clear());\n        EXHAUST.with(|p| p.borrow_mut().clear());\n    }\n    pub fn attempts()->Vec<Attempt> { ATTEMPTS.with(|a| a.borrow().clone()) }\n    pub(crate) fn observe_secrets(hash:HashFn,mask_nonce:[u8;32],g:&[QM31;1024],salt0:&[u8;32]) {\n        let mut bytes=Vec::with_capacity(16*1024);\n        for x in g { let mut b=[0;16];x.write_le_bytes(&mut b);bytes.extend_from_slice(&b); }\n        let record=Attempt{mask_nonce,g_digest:hash(&[b\"test:g\",&bytes]),salt_digest:hash(&[b\"test:salt0\",salt0]),..Attempt::default()};\n        ATTEMPTS.with(|a| a.borrow_mut().push(record));\n    }\n    #[cfg(feature=\"r1p-check\")]\n    std::thread_local! {\n        static CHALLENGES: core::cell::RefCell<Vec<super::R1PublicChallenges>> = const { core::cell::RefCell::new(Vec::new()) };\n    }\n    /// Test builds only (LOG D72.2 column audit): the challenges of each P_R1 check on this thread.\n    #[cfg(feature=\"r1p-check\")]\n    pub(crate) fn observe_challenges(ch:&super::R1PublicChallenges) { CHALLENGES.with(|c| c.borrow_mut().push(ch.clone())); }\n    #[cfg(feature=\"r1p-check\")]\n    pub fn take_challenges()->Vec<super::R1PublicChallenges> { CHALLENGES.with(|c| core::mem::take(&mut *c.borrow_mut())) }\n    pub(crate) fn forced_verdict(c1_root:[u8;32])->Option<bool> {\n        let verdict=VERDICTS.with(|v| v.borrow_mut().as_mut().map(|q| q.pop_front().unwrap_or(true)))?;\n        ATTEMPTS.with(|a| if let Some(last)=a.borrow_mut().last_mut() {last.c1_root=Some(c1_root);last.forced_verdict=Some(verdict);});\n        Some(verdict)\n    }\n}\n\n#[cfg(all(test,feature=\"r1p-check\"))]\n#[path=\"prover_retry_tests.rs\"]\nmod retry_tests;\n\nfn derive_private_salt_step(reserved:&ReservedStateOnlyAttemptSecrets,context:StateOnlyHidingContext,hash:HashFn,tag:u8,index:u32,mut salts:Vec<[u8;32]>)->Result<Vec<[u8;32]>,Error> {\n    let salt=reserved.derive_pool_v1_leaf_salt(hash,context,tag,index).map_err(|_|Error::Semantic)?;\n    salts.push(salt);\n    Ok(salts)\n}\n"},{"id":13,"name":{"Local":"crates/aspis-r1-cost-probe/src/verifier.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! UNPROVED R1 COST PROBE. Two-transaction verifier shape; no production use.\nuse aspis_core::r0::CodeField;\nuse alloc::{boxed::Box,vec::Vec};\nuse aspis_core::{Digest32,field::{WideExact as E,QM31 as K,M31},circle::SecureCirclePoint,r0::{domain,merkle}};\nuse aspis_statement::pool_v1::pair_forest_semantic_terminal::r0::Public;\nuse crate::{transport::Variant,weights::{Weights,field,powers,QUARTER},transcript::Transcript};\n\npub const SEMANTIC_BYTES:usize=12903+29*32;\npub const HEADER:usize=16;\n#[cfg(not(feature = \"private-leaf-salts\"))]\npub const INITIAL_QUERY_BYTES:usize=480+128+2*6*7*32;\n#[cfg(feature = \"private-leaf-salts\")]\npub const INITIAL_QUERY_BYTES:usize=480+128+64+2*6*7*32;\n#[cfg(not(feature = \"private-leaf-salts\"))]\npub const SECOND_QUERY_BYTES:usize=4*32+6*7*32;\n#[cfg(feature = \"private-leaf-salts\")]\npub const SECOND_QUERY_BYTES:usize=4*32+32+6*7*32;\npub const CHECKPOINT_FIXED:usize=16+32*3+64+32*4+16+88+160+64+32*2+16+32;\n#[derive(Debug,Clone,Copy,PartialEq,Eq)]\npub enum Error { Parse,Semantic,Transcript,Relation,Merkle,Query,Checkpoint,Allocation,\n    /// Host prover only (LOG D38.3): this attempt's challenges fail the public\n    /// P_R1 check. Carries no challenge and no conjunct.\n    #[cfg(feature=\"prover\")] Rejected,\n    /// Host prover only (D38.3): all N = 8 attempts were rejected; nothing is published.\n    #[cfg(feature=\"prover\")] AttemptsExhausted,\n    /// Host prover only: the operating-system entropy source failed.\n    #[cfg(feature=\"prover\")] Entropy }\n#[derive(Debug,Clone,Copy,PartialEq,Eq)]\npub enum Phase { Parsed,Semantic,SemanticPart(u8),Prepare,CheckpointRead,Merkle(usize),Query(usize),QueryPart(usize,u8),CheckpointWrite,Relation,Final }\npub type Observer=Option<fn(Phase)>;\nfn mark(obs:Observer,p:Phase) { if let Some(f)=obs {f(p);} }\npub fn checkpoint_size(v:Variant)->usize {CHECKPOINT_FIXED+16*v.final_len()}\n\npub struct View<'a> {\n    pub variant:Variant,pub semantic:&'a[u8],pub y1:&'a[u8],pub inactive:E,\n    pub round0:&'a[u8],pub folded_root:Option<&'a[u8;32]>,pub round1:&'a[u8],\n    pub final_message:&'a[u8],pub query_bytes:&'a[u8],\n}\nfn echeck(b:&[u8],k:bool)->Result<(),Error> {\n    for c in b.chunks_exact(32) {let x=E::from_le_bytes(c).ok_or(Error::Parse)?;if k&&x.c1()!=K::ZERO {return Err(Error::Parse);}}\n    Ok(())\n}\nimpl<'a> View<'a> {\n    /// Length of the retired eight-way stored proof for `v` (124,343 bytes for\n    /// S2). A layout figure only: the adopted stored length is `PROOF_BYTES`.\n    pub fn eight_way_proof_bytes(v:Variant)->usize {HEADER+SEMANTIC_BYTES+29*32+32+7*32+if v.folds()==2 {32+7*32}else{0}+v.final_len()*32+22*(INITIAL_QUERY_BYTES+if v.folds()==2 {SECOND_QUERY_BYTES}else{0})}\n}\n\npub struct Prepared {\n    pub variant:Variant,pub roots:[[u8;32];2],pub gamma:E,pub kappa:E,pub alpha:[E;2],pub rho:K,\n    pub queries:[u32;22],pub semantic_alpha:[K;10],pub z:[SecureCirclePoint;2],pub claim:E,pub state:[u8;32],\n}\nfn prepared_claim<H:Digest32>(sem:&crate::r1_semantic::Verified<H>,y1:&[u8],inactive:E,g:&[E;29],kappa:E)->Result<E,Error> {\n        let k=powers::<7>(kappa);\n        let mut parts=[E::ZERO;7];parts[0]=inactive;\n        for point in 0..6 {\n            let mut dot=crate::fast_pairing::EbyKDot::new();\n            for l in 0..29 {\n                let scalar=match point {0..=2=>sem.claims[point][l],3=>sem.extra[l],4=>sem.before_z1[l],_=>field(y1,l).c0()};\n                dot.push(g[l],scalar).map_err(|_|Error::Parse)?;\n            }\n            parts[point+1]=dot.finish();\n        }\n        let mut claim=E::ZERO;\n        for i in 0..7 {crate::trace::value(14,i,parts[i]);claim=claim.add(k[i].mul(parts[i]));}\n        crate::trace::value(14,7,claim);\n        Ok(claim)\n}\n\nimpl Prepared {\n    #[inline(never)]\n    pub fn new<H:Digest32>(sem:&crate::r1_semantic::Verified<H>,v:&View<'_>,hash:H,g:&mut [E;29])->Result<Box<Self>,Error> {\n        let mut t=Transcript::new(hash,sem.transcript.state(),v.variant);\n        let gamma=t.scalar(27,v.y1,true);\n        let kappa=t.scalar(28,&v.inactive.to_le_bytes(),false);\n        let alpha0=t.scalar(29,v.round0,false);\n        let (alpha,row)=if v.variant.folds()==2 {\n            let mut bytes=Vec::with_capacity(32+224);bytes.extend_from_slice(v.folded_root.unwrap());bytes.extend_from_slice(v.round1);\n            ([alpha0,t.scalar(30,&bytes,false)],31)\n        } else {\n            ([alpha0,E::ZERO],30)\n        };\n        let queries=t.queries(row,v.final_message)?;\n        let rho=t.scalar_k(row+1,&[]);\n        // Reuse this caller-owned scratch array in tx1; it is never serialized.\n        *g=powers::<29>(gamma);\n        let claim=prepared_claim(sem,v.y1,v.inactive,g,kappa)?;\n        Ok(Box::new(Self{variant:v.variant,roots:sem.roots,gamma,kappa,alpha,rho,queries,semantic_alpha:sem.alpha,z:sem.z,claim,state:t.state}))\n    }\n}\npub struct Accumulator { pub weights:Vec<K>,pub rhs:E,pub power:K,pub next:usize }\nimpl Accumulator {\n    pub fn new(v:Variant)->Result<Self,Error> {Ok(Self{weights:aspis_core::r0::heap::filled(v.final_len(),K::ZERO).map_err(|_|Error::Allocation)?,rhs:E::ZERO,power:K::ONE,next:0})}\n}\n\npub fn four_dots(q:&[u8],g:&[E;29])->[E;4] {\n    core::array::from_fn(|s| {\n        let mut a=E::ZERO;\n        for l in 0..26 {a=a.add(g[l].mul_m31(M31::from_le_bytes(q[s*120+l*4..s*120+l*4+4].try_into().unwrap()).unwrap()));}\n        a=a.add(g[28].mul_qm31(K::from_le_bytes(&q[s*120+104..s*120+120]).unwrap()));\n        for l in 0..2 {a=a.add(g[l+26].mul_qm31(K::from_le_bytes(&q[480+s*32+l*16..480+s*32+l*16+16]).unwrap()));}\n        a\n    })\n}\npub fn circle_fold(alpha:E,u:usize,a:[E;4])->E {\n    let p=crate::fast_domain::fibre_point(domain::FibreIndex::new(u).unwrap());\n    let ix=p.x.inv();let iy=p.y.inv();let [a,b,c,d]=a;\n    let h0=a.add(b).add(c).add(d).mul_m31(QUARTER);\n    let h1=a.sub(b).sub(c).add(d).mul_m31(QUARTER.mul(iy));\n    let h2=a.add(b).sub(c).sub(d).mul_m31(QUARTER.mul(ix));\n    let h3=a.sub(b).add(c).sub(d).mul_m31(QUARTER.mul(ix).mul(iy));\n    h0.add(alpha.mul(h1.add(alpha.mul(h2.add(alpha.mul(h3))))))\n}\npub fn line_fold(alpha:E,v:usize,a:[E;4])->E {\n    let x=crate::fast_domain::line_node(domain::FibreIndex::new(4*v).unwrap());\n    let y=crate::fast_domain::line_node(domain::FibreIndex::new(4*v+3).unwrap());\n    let z=x.mul(x).double().sub(M31::ONE);\n    let half=M31(1073741824);\n    let [a,b,c,d]=a;\n    let h0=a.add(b).add(c).add(d).mul_m31(QUARTER);\n    let h2=a.add(b).sub(c).sub(d).mul_m31(QUARTER.mul(z.inv()));\n    let c0=a.sub(b).mul_m31(half.mul(x.inv()));\n    let c1=d.sub(c).mul_m31(half.mul(y.inv()));\n    let h1=c0.add(c1).mul_m31(half);\n    let h3=c0.sub(c1).mul_m31(half.mul(z.inv()));\n    h0.add(alpha.mul(h1.add(alpha.mul(h2.add(alpha.mul(h3))))))\n}\n/// The five base-field denominators used to fold one sampled query: circle\n/// x/y, followed by line x/y/z. Their inverses are batch-computed once per\n/// transaction so each query avoids five independent field inversions.\nstruct QueryGeometry { start:usize, inverses:Vec<[M31;5]>, line_z:Vec<M31> }\n\n#[inline(always)]\nfn batch_prefix_products(flat:&[M31])->(Vec<M31>,M31) {\n    let mut prefixes=Vec::with_capacity(flat.len());\n    let mut product=M31::ONE;\n    let mut index=0;\n    while index<flat.len() {\n        let value=flat[index];\n        prefixes.push(product);\n        product=product.mul(value);\n        index+=1;\n    }\n    (prefixes,product)\n}\n\nimpl QueryGeometry {\n    fn for_range(queries:&[u32;22],start:usize,end:usize)->Result<Self,Error> {\n        if start>end||end>queries.len(){return Err(Error::Query);}\n        let mut line_z_values=Vec::with_capacity(end-start);\n        let mut flat=Vec::with_capacity((end-start)*5);\n        for &query in &queries[start..end] {\n            let u=query as usize;\n            let fibre=domain::FibreIndex::new(u).map_err(|_|Error::Query)?;\n            let domain::Point{x:circle_x,y:circle_y}=crate::fast_domain::fibre_point(fibre);\n            let line_x=crate::fast_domain::line_node(domain::FibreIndex::new(u/4*4).map_err(|_|Error::Query)?);\n            let line_y=crate::fast_domain::line_node(domain::FibreIndex::new(u/4*4+3).map_err(|_|Error::Query)?);\n            let line_z=line_x.mul(line_x).double().sub(M31::ONE);\n            let values=[circle_x,circle_y,line_x,line_y,line_z];\n            if values.iter().any(|x|*x==M31::ZERO){return Err(Error::Query);}\n            flat.extend_from_slice(&values);\n            line_z_values.push(line_z);\n        }\n        if flat.is_empty(){return Ok(Self{start,inverses:Vec::new(),line_z:line_z_values});}\n        // Standard prefix-product/backward batch inversion. The only `inv`\n        // in this routine is applied to the product of all nonzero entries.\n        let (prefixes,product)=batch_prefix_products(&flat);\n        let mut suffix_inverse=product.inv();\n        let mut flat_inverse=Vec::with_capacity(flat.len());\n        flat_inverse.resize(flat.len(),M31::ZERO);\n        for i in (0..flat.len()).rev() {\n            flat_inverse[i]=suffix_inverse.mul(prefixes[i]);\n            suffix_inverse=suffix_inverse.mul(flat[i]);\n        }\n        let inverses=(0..line_z_values.len()).map(|i|core::array::from_fn(|j|flat_inverse[5*i+j])).collect();\n        Ok(Self{start,inverses,line_z:line_z_values})\n    }\n    #[inline(always)]\n    fn for_query(&self,index:usize)->&[M31;5] {&self.inverses[index-self.start]}\n}\n#[inline(always)]\nfn circle_fold_with_inverses(alpha:E,a:[E;4],inverse:&[M31;5])->E {\n    let [ix,iy,_,_,_]=*inverse;let [a,b,c,d]=a;\n    let h0=a.add(b).add(c).add(d).mul_m31(QUARTER);\n    let h1=a.sub(b).sub(c).add(d).mul_m31(QUARTER.mul(iy));\n    let h2=a.add(b).sub(c).sub(d).mul_m31(QUARTER.mul(ix));\n    let h3=a.sub(b).add(c).sub(d).mul_m31(QUARTER.mul(ix).mul(iy));\n    h0.add(alpha.mul(h1.add(alpha.mul(h2.add(alpha.mul(h3))))))\n}\n#[inline(always)]\nfn line_fold_with_inverses(alpha:E,a:[E;4],inverse:&[M31;5])->E {\n    let [_,_,ix,iy,iz]=*inverse;let half=M31(1073741824);let [a,b,c,d]=a;\n    let h0=a.add(b).add(c).add(d).mul_m31(QUARTER);\n    let h2=a.add(b).sub(c).sub(d).mul_m31(QUARTER.mul(iz));\n    let c0=a.sub(b).mul_m31(half.mul(ix));\n    let c1=d.sub(c).mul_m31(half.mul(iy));\n    let h1=c0.add(c1).mul_m31(half);\n    let h3=c0.sub(c1).mul_m31(half.mul(iz));\n    h0.add(alpha.mul(h1.add(alpha.mul(h2.add(alpha.mul(h3))))))\n}\n/// Transaction-local residues. At a group boundary each limb is <2^34.\n/// Four products add at most 4*(P-1)^2; adding the retained folded residue\n/// still fits u64 because 4*(P-1)^2+2^34 < 2^64. Flush after each four queries.\nstruct BatchedWeights { raw:Vec<[u64;4]>, terms:usize }\nimpl BatchedWeights {\n    fn new(weights:&[K])->Result<Self,Error> {\n        let mut raw=aspis_core::r0::heap::filled(weights.len(),[0u64;4]).map_err(|_|Error::Allocation)?;\n        let mut index=0;\n        while index<weights.len() {\n            let w=weights[index];\n            raw[index]=[w.c0.a.0 as u64,w.c0.b.0 as u64,w.c1.a.0 as u64,w.c1.b.0 as u64];\n            index+=1;\n        }\n        Ok(Self{raw,terms:0})\n    }\n    #[inline(always)]\n    fn push(&mut self,index:usize,power:K,basis:M31) {\n        let flush=self.terms&3==3;\n        update_residue_row(&mut self.raw[index],power,basis,flush);\n    }\n\n    fn value(&self,index:usize)->K {\n        let [a,b,c,d]=self.raw[index].map(M31::reduce_u64);\n        K{c0:aspis_core::field::CM31{a,b},c1:aspis_core::field::CM31{a:c,b:d}}\n    }\n    fn finish(&self,weights:&mut[K]) {for (i,w) in weights.iter_mut().enumerate(){*w=self.value(i);}}\n}\n\n\n#[inline(always)]\nfn residue_limb_at(row:&[u64;4],index:usize)->u64 {row[index]}\n#[inline(always)]\nfn power_limb_at(limbs:&[u32;4],index:usize)->u32 {limbs[index]}\n#[inline(always)]\nfn update_residue_row(row:&mut [u64;4],power:K,basis:M31,flush:bool) {\n    let limbs=[power.c0.a.0,power.c0.b.0,power.c1.a.0,power.c1.b.0];\n    for j in 0..4 {\n        let old=residue_limb_at(row,j);\n        let limb=power_limb_at(&limbs,j);\n        row[j]=old+u64::from(limb)*u64::from(basis.0);\n    }\n    if flush {\n        for limb in row {*limb=(*limb&0x7fff_ffff)+(*limb>>31);}\n    }\n}\n\n#[inline(never)]\npub fn accumulate(p:&Prepared,a:&mut Accumulator,index:usize,value:E) {\n    let mut node=crate::fast_domain::line_node(domain::FibreIndex::new(if p.variant.folds()==1 {index}else{index/4*4}).unwrap());\n    if p.variant.folds()==2 {for _ in 0..2 {node=node.mul(node).double().sub(M31::ONE);}}\n    accumulate_with_node(p,a,node,value,None)\n}\n#[inline(never)]\nfn accumulate_with_node(p:&Prepared,a:&mut Accumulator,mut node:M31,value:E,mut pending:Option<&mut BatchedWeights>) {\n    let mut basis=[M31::ZERO;256];basis[0]=M31::ONE;let mut n=1;\n    while n<a.weights.len() {for j in 0..n {basis[n+j]=basis[j].mul(node);} node=node.mul(node).double().sub(M31::ONE);n*=2;}\n    for j in 0..a.weights.len() {\n        if let Some(weights)=pending.as_deref_mut() {\n            weights.push(j,a.power,basis[j]);\n            #[cfg(feature=\"prover\")] {a.weights[j]=weights.value(j);}\n        } else {a.weights[j]=a.weights[j].add(a.power.mul_m31(basis[j]));}\n        crate::trace::value(12,a.next*a.weights.len()+j,E::from_qm31(a.weights[j]));\n        crate::trace::value(13,a.next*a.weights.len()+j,E::from_m31(basis[j]));\n    }\n    if let Some(weights)=pending {weights.terms+=1;}\n    a.rhs=a.rhs.add(value.mul_qm31(a.power));crate::trace::value(11,a.next,a.rhs);\n    a.power=a.power.mul(p.rho);a.next+=1;\n}\n\n\n#[inline(always)]\nfn basis_at(basis:&[M31;256],index:usize)->M31 {basis[index]}\n#[inline(always)]\nfn accumulated_weight_at(weights:&[K],index:usize)->K {weights[index]}\n\n#[inline(never)]\nfn accumulate_batched_with_node(p:&Prepared,a:&mut Accumulator,mut node:M31,value:E,weights:&mut BatchedWeights) {\n    let width=a.weights.len();\n    let mut basis=[M31::ZERO;256];basis[0]=M31::ONE;let mut n=1;\n    while n<width {for j in 0..n {basis[n+j]=basis[j].mul(node);} node=node.mul(node).double().sub(M31::ONE);n*=2;}\n    for j in 0..width {\n        weights.push(j,a.power,basis_at(&basis,j));\n        #[cfg(feature=\"prover\")] {a.weights[j]=weights.value(j);}\n        crate::trace::value(12,a.next*width+j,E::from_qm31(accumulated_weight_at(&a.weights,j)));\n        crate::trace::value(13,a.next*width+j,E::from_m31(basis_at(&basis,j)));\n    }\n    weights.terms+=1;\n    a.rhs=a.rhs.add(value.mul_qm31(a.power));crate::trace::value(11,a.next,a.rhs);\n    a.power=a.power.mul(p.rho);a.next+=1;\n}\n\npub fn polynomial(bytes:&[u8],x:E)->E {(0..7).rev().fold(E::ZERO,|a,i|a.mul(x).add(field(bytes,i)))}\nfn finish_relation_round(poly:&[u8],alpha:E,mut claim:E,round:usize)->Result<E,Error> {\n        let lhs=field(poly,0).add(field(poly,4));let rhs=claim.mul_m31(QUARTER);\n        crate::trace::value(15,3*round,lhs);crate::trace::value(15,3*round+1,rhs);\n        if lhs!=rhs {return Err(Error::Relation);}\n        claim=polynomial(poly,alpha);crate::trace::value(15,3*round+2,claim);\n    Ok(claim)\n}\n\nfn finish_query_dot(final_message:&[u8],weights:&[K])->Result<E,Error> {\n    let mut dot=crate::fast_pairing::EbyKDot::new();\n    let mut j=0;\n    while j<weights.len() {dot.push(field(final_message,j),weights[j]).map_err(|_|Error::Parse)?;j+=1;}\n    Ok(dot.finish())\n}\n\n#[inline(never)]\npub fn finish_relation(v:&View<'_>,p:&Prepared,a:&Accumulator,obs:Observer)->Result<(),Error> {\n    let mut claim=p.claim;\n    claim=finish_relation_round(v.round0,p.alpha[0],claim,0)?;\n    if p.variant.folds()==2 {claim=finish_relation_round(v.round1,p.alpha[1],claim,1)?;}\n    let weights=Weights::new(p.variant,&p.semantic_alpha,&p.z)?;\n    let pair=weights.pair(&p.alpha[..p.variant.folds()],v.final_message,p.kappa)?;\n    crate::trace::value(16,0,pair);crate::trace::value(16,1,claim);\n    if pair!=claim {return Err(Error::Relation);}\n    mark(obs,Phase::Relation);\n    let actual=finish_query_dot(v.final_message,&a.weights)?;\n    crate::trace::value(17,0,actual);crate::trace::value(17,1,a.rhs);\n    if a.next!=22||actual!=a.rhs {return Err(Error::Query);}\n    mark(obs,Phase::Final);Ok(())\n}\n\nfn put(out:&mut Vec<u8>,x:E) {out.extend_from_slice(&x.to_le_bytes());}\nfn put_k(out:&mut Vec<u8>,x:K) {let mut b=[0;16];x.write_le_bytes(&mut b);out.extend_from_slice(&b);}\npub fn checkpoint<H:Digest32>(p:&Prepared,a:&Accumulator,proof:&[u8],public:&[u8],hash:H)->Vec<u8> {\n    let mut out=Vec::with_capacity(checkpoint_size(p.variant));\n    out.extend_from_slice(b\"R1P2CKP2\");out.extend_from_slice(&[p.variant.tag(),a.next as u8,1,0,0,0,0,0]);\n    out.extend_from_slice(&hash.digest(&[proof]));out.extend_from_slice(&hash.digest(&[public]));out.extend_from_slice(&p.state);\n    for root in &p.roots {out.extend_from_slice(root);}\n    for x in [p.gamma,p.kappa,p.alpha[0],p.alpha[1]] {put(&mut out,x);}\n    put_k(&mut out,p.rho);\n    for q in p.queries {out.extend_from_slice(&q.to_le_bytes());}\n    for x in p.semantic_alpha {let mut b=[0;16];x.write_le_bytes(&mut b);out.extend_from_slice(&b);}\n    for z in p.z {for x in [z.x,z.y] {let mut b=[0;16];x.write_le_bytes(&mut b);out.extend_from_slice(&b);}}\n    for x in [p.claim,a.rhs] {put(&mut out,x);}\n    put_k(&mut out,a.power);\n    for &x in &a.weights {put_k(&mut out,x);}\n    let sum=hash.digest(&[b\"UNPROVED:R1:checkpoint\",&out]);out.extend_from_slice(&sum);\n    assert_eq!(out.len(),checkpoint_size(p.variant));out\n}\nstruct Reader<'a>{bytes:&'a[u8],at:usize}\nimpl<'a> Reader<'a>{\n    fn raw<const N:usize>(&mut self)->[u8;N] {let b=self.bytes[self.at..self.at+N].try_into().unwrap();self.at+=N;b}\n    fn e(&mut self)->Result<E,Error>{E::from_le_bytes(&self.raw::<32>()).ok_or(Error::Checkpoint)}\n    #[inline(always)]\n    fn k(&mut self)->Result<K,Error>{K::from_le_bytes(&self.raw::<16>()).ok_or(Error::Checkpoint)}\n}\n\n\n#[inline(always)]\nfn validate_checkpoint_queries(queries:&[u32;22])->Result<(),Error> {\n    let mut i=0;\n    while i<queries.len() {\n        let q=queries[i];\n        if q>=1<<18||queries[..i].contains(&q){return Err(Error::Checkpoint);}\n        i+=1;\n    }\n    Ok(())\n}\n\n#[inline(always)]\nfn read_checkpoint_weights(bytes:&[u8],mut at:usize,mut weights:Vec<K>)->Result<(Vec<K>,usize),Error> {\n    for out in &mut weights {\n        let mut reader=Reader{bytes,at};\n        let value=reader.k()?;\n        at=reader.at;\n        *out=value;\n    }\n    Ok((weights,at))\n}\n\n\n#[inline(always)]\nfn read_checkpoint_semantic_alpha(bytes:&[u8],at:usize)->Result<([K;10],usize),Error> {\n    let mut r=Reader{bytes,at};\n    let values=[\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n    ];\n    Ok((values,r.at))\n}\n\n#[inline(never)]\npub fn resume<H:Digest32>(bytes:&[u8],proof:&[u8],public:&[u8],v:Variant,hash:H)->Result<(Box<Prepared>,Accumulator),Error> {\n    if bytes.len()!=checkpoint_size(v)||&bytes[..8]!=b\"R1P2CKP2\"||bytes[8]!=v.tag()||bytes[9]>22||bytes[10]!=1||bytes[11..16].iter().any(|&b|b!=0) {return Err(Error::Checkpoint);}\n    let end=bytes.len()-32;\n    if bytes[16..48]!=hash.digest(&[proof])||bytes[48..80]!=hash.digest(&[public])||bytes[end..]!=hash.digest(&[b\"UNPROVED:R1:checkpoint\",&bytes[..end]]) {return Err(Error::Checkpoint);}\n    let mut r=Reader{bytes,at:80};let state=r.raw();let roots=[r.raw(),r.raw()];\n    let gamma=r.e()?;let kappa=r.e()?;let alpha=[r.e()?,r.e()?];let rho=r.k()?;\n    let queries=[\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n    ];\n    validate_checkpoint_queries(&queries)?;\n    let (semantic_alpha,at)=read_checkpoint_semantic_alpha(bytes,r.at)?;\n    r.at=at;\n    let z=[SecureCirclePoint{x:r.k()?,y:r.k()?},SecureCirclePoint{x:r.k()?,y:r.k()?}];\n    let claim=r.e()?;let rhs=r.e()?;let power=r.k()?;\n    let weights=aspis_core::r0::heap::filled(v.final_len(),K::ZERO).map_err(|_|Error::Allocation)?;\n    let (weights,at)=read_checkpoint_weights(bytes,r.at,weights)?;\n    if at!=end {return Err(Error::Checkpoint);}\n    Ok((Box::new(Prepared{variant:v,roots,gamma,kappa,alpha,rho,queries,semantic_alpha,z,claim,state}),Accumulator{weights,rhs,power,next:bytes[9] as usize}))\n}\n\n#[cfg(test)]\nmod query_geometry_tests {\n    use super::*;\n    use aspis_core::field::{CM31,QM31,P};\n\n    fn next(state:&mut u64)->u64 {\n        *state=state.wrapping_add(0x9e37_79b9_7f4a_7c15);\n        let mut value=*state;\n        value=(value^(value>>30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);\n        value=(value^(value>>27)).wrapping_mul(0x94d0_49bb_1331_11eb);\n        value^(value>>31)\n    }\n    fn random_m31(state:&mut u64)->M31 {M31((next(state)%u64::from(P)) as u32)}\n    fn random_e(state:&mut u64)->E {\n        let mut scalar=||random_m31(state);\n        let mut k=||QM31{c0:CM31{a:scalar(),b:scalar()},c1:CM31{a:scalar(),b:scalar()}};\n        E::new(k(),k())\n    }\n    fn queries()->[u32;22] {core::array::from_fn(|i|((i*7919+12345)%262144) as u32)}\n\n    #[test]\n    fn batched_geometry_inverses_match_individual_inverses_for_ranges() {\n        let queries=queries();\n        for (start,end) in [(0,0),(0,1),(0,7),(7,22),(0,22),(5,19)] {\n            let geometry=QueryGeometry::for_range(&queries,start,end).unwrap();\n            assert_eq!(geometry.start,start);\n            assert_eq!(geometry.inverses.len(),end-start);\n            for index in start..end {\n                let u=queries[index] as usize;\n                let point=crate::fast_domain::fibre_point(domain::FibreIndex::new(u).unwrap());\n                let line_x=crate::fast_domain::line_node(domain::FibreIndex::new(u/4*4).unwrap());\n                let line_y=crate::fast_domain::line_node(domain::FibreIndex::new(u/4*4+3).unwrap());\n                let line_z=line_x.mul(line_x).double().sub(M31::ONE);\n                assert_eq!(*geometry.for_query(index),[point.x.inv(),point.y.inv(),line_x.inv(),line_y.inv(),line_z.inv()]);\n            }\n        }\n    }\n\n    #[test]\n    fn batched_circle_and_line_folds_match_independent_reference() {\n        let queries=queries();\n        let geometry=QueryGeometry::for_range(&queries,0,22).unwrap();\n        let mut state=0x243f_6a88_85a3_08d3;\n        let max=E::from_limbs([P-1;8]).unwrap();\n        for index in 0..22 {\n            for case in 0..8 {\n                let alpha=match case%4 {0=>E::ZERO,1=>E::ONE,2=>max,_=>random_e(&mut state)};\n                let values=core::array::from_fn(|slot|match (case+slot)%4 {0=>E::ZERO,1=>E::ONE,2=>max,_=>random_e(&mut state)});\n                let inverse=geometry.for_query(index);\n                assert_eq!(circle_fold_with_inverses(alpha,values,inverse),circle_fold(alpha,queries[index] as usize,values),\"circle index {index}, case {case}\");\n                assert_eq!(line_fold_with_inverses(alpha,values,inverse),line_fold(alpha,queries[index] as usize/4,values),\"line index {index}, case {case}\");\n            }\n        }\n    }\n}\n\n#[cfg(test)]\nmod batched_weight_tests {\n    use super::*;\n    #[test]\n    fn bounded_rho_residues_match_all_canonical_prefixes() {\n        let hi=M31(aspis_core::field::P-1);\n        let max=K{c0:aspis_core::field::CM31{a:hi,b:hi},c1:aspis_core::field::CM31{a:hi,b:hi}};\n        for power in [K::ZERO,K::ONE,max] {\n            let mut reference=alloc::vec![max;64];let mut pending=BatchedWeights::new(&reference).unwrap();\n            for _ in 0..22 {\n                for j in 0..64 {\n                    pending.push(j,power,hi);\n                    reference[j]=reference[j].add(power.mul_m31(hi));\n                    assert_eq!(pending.value(j),reference[j]);\n                }\n                pending.terms+=1;\n            }\n            let mut actual=alloc::vec![K::ZERO;64];pending.finish(&mut actual);assert_eq!(actual,reference);\n        }\n    }\n}\n\n// The adopted R1 verifier (PREREG-PROOF-SIZE-2, 2026-10-19): the compact\n// binary-multiproof format of `crate::compact`. These are the only R1\n// verification entrypoints of a default build.\n#[path=\"candidate.rs\"]\npub mod candidate;\npub use candidate::{parse_shape,tx1,tx2,tx2_authenticated};\n/// The one stored proof length of the adopted format (57,607 bytes).\npub const PROOF_BYTES:usize=crate::compact::PROOF_BYTES;\n/// The one stage-1 split of the adopted format (queries 0..10 in stage 1).\npub const SPLIT:usize=crate::compact::SPLIT;\nconst _:()=assert!(PROOF_BYTES==57_607&&SPLIT==10);\n\n// AUDIT ONLY: the retired eight-way verifier, for differential evidence on\n// saved eight-way fixtures. Never in a prover or SBF build (lib.rs guards).\n#[cfg(feature=\"audit-eight-way\")]\n#[path=\"eight_way.rs\"]\npub mod eight_way;\n"},{"id":14,"name":{"Local":"crates/aspis-r1-cost-probe/src/transport.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! UNPROVED COST PROBE. S uses the D18 digit permutation; D uses retained D13.\n#[derive(Clone,Copy,Debug,PartialEq,Eq)]\npub enum Variant { S1, S2, D }\npub const TAU: [usize; 5] = [3, 4, 2, 0, 1];\nimpl Variant {\n    pub fn tag(self) -> u8 { match self { Self::S1=>1,Self::S2=>2,Self::D=>3 } }\n    pub fn from_tag(tag:u8) -> Option<Self> { match tag {1=>Some(Self::S1),2=>Some(Self::S2),3=>Some(Self::D),_=>None} }\n    pub fn folds(self) -> usize { if self == Self::S1 { 1 } else { 2 } }\n    pub fn final_len(self) -> usize { 1024 >> (2*self.folds()) }\n    pub fn row(self, j:usize) -> usize {\n        if self == Self::D { return aspis_core::r0::transport::COEFFICIENT_TO_ROW[j] as usize; }\n        let mut out=0;\n        for d in 0..5 { out |= ((j>>(2*d))&3) << (2*TAU[d]); }\n        out\n    }\n    pub fn coefficients<T:Copy>(self, rows: &[T;1024]) -> [T;1024] {\n        core::array::from_fn(|j|rows[self.row(j)])\n    }\n    pub fn rows<T:Copy>(self, coefficients: &[T;1024]) -> [T;1024] {\n        let mut out=*coefficients;\n        for j in 0..1024 { out[self.row(j)]=coefficients[j]; }\n        out\n    }\n}\n"},{"id":15,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":17,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":18,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":19,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/zeroize-1.8.1/src/lib.rs"},"crate_name":"zeroize","contents":null},{"id":20,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":21,"name":{"Local":"/rustc/library/core/src/default.rs"},"crate_name":"core","contents":null},{"id":22,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/getrandom-0.3.4/src/error.rs"},"crate_name":"getrandom","contents":null},{"id":23,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/getrandom-0.3.4/src/lib.rs"},"crate_name":"getrandom","contents":null},{"id":24,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":25,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":26,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":27,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":28,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":29,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":30,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":31,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":32,"name":{"Local":"/rustc/library/core/src/ptr/mod.rs"},"crate_name":"core","contents":null},{"id":33,"name":{"Local":"/rustc/library/core/src/num/nonzero.rs"},"crate_name":"core","contents":null},{"id":34,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":35,"name":{"Local":"/rustc/library/core/src/ops/try_trait.rs"},"crate_name":"core","contents":null},{"id":36,"name":{"Local":"/rustc/library/core/src/ops/deref.rs"},"crate_name":"core","contents":null},{"id":37,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":38,"name":{"Local":"/rustc