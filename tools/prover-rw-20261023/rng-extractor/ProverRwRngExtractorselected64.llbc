"Adt":{"id":{"Adt":24},"generics":{"regions":[],"types":[{"HashConsedValue":[2955,{"Literal":{"Int":"I32"}}]},{"HashConsedValue":[3335,{"Adt":{"id":{"Adt":29},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":4,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":20,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["control_flow",0]},{"Ident":["ControlFlow",0]}],"span":{"data":{"file_id":24,"beg":{"line":89,"col":0},"end":{"line":89,"col":31}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to tell an operation whether it should exit early or go on as usual."},{"DocComment":""},{"DocComment":" This is used when exposing things (like graph traversals or visitors) where"},{"DocComment":" you want the user to be able to choose whether to exit early."},{"DocComment":" Having the enum makes it clearer -- no more wondering \"wait, what did `false`"},{"DocComment":" mean again?\" -- and allows including a value."},{"DocComment":""},{"DocComment":" Similar to [`Option`] and [`Result`], this enum can be used with the `?` operator"},{"DocComment":" to return immediately if the [`Break`] variant is present or otherwise continue normally"},{"DocComment":" with the value inside the [`Continue`] variant."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Early-exiting from [`Iterator::try_for_each`]:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let r = (2..100).try_for_each(|x| {"},{"DocComment":"     if 403 % x == 0 {"},{"DocComment":"         return ControlFlow::Break(x)"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     ControlFlow::Continue(())"},{"DocComment":" });"},{"DocComment":" assert_eq!(r, ControlFlow::Break(13));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A basic tree traversal:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" pub struct TreeNode<T> {"},{"DocComment":"     value: T,"},{"DocComment":"     left: Option<Box<TreeNode<T>>>,"},{"DocComment":"     right: Option<Box<TreeNode<T>>>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> TreeNode<T> {"},{"DocComment":"     pub fn traverse_inorder<B>(&self, f: &mut impl FnMut(&T) -> ControlFlow<B>) -> ControlFlow<B> {"},{"DocComment":"         if let Some(left) = &self.left {"},{"DocComment":"             left.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         f(&self.value)?;"},{"DocComment":"         if let Some(right) = &self.right {"},{"DocComment":"             right.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         ControlFlow::Continue(())"},{"DocComment":"     }"},{"DocComment":"     fn leaf(value: T) -> Option<Box<TreeNode<T>>> {"},{"DocComment":"         Some(Box::new(Self { value, left: None, right: None }))"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let node = TreeNode {"},{"DocComment":"     value: 0,"},{"DocComment":"     left: TreeNode::leaf(1),"},{"DocComment":"     right: Some(Box::new(TreeNode {"},{"DocComment":"         value: -1,"},{"DocComment":"         left: TreeNode::leaf(5),"},{"DocComment":"         right: TreeNode::leaf(2),"},{"DocComment":"     }))"},{"DocComment":" };"},{"DocComment":" let mut sum = 0;"},{"DocComment":""},{"DocComment":" let res = node.traverse_inorder(&mut |val| {"},{"DocComment":"     if *val < 0 {"},{"DocComment":"         ControlFlow::Break(*val)"},{"DocComment":"     } else {"},{"DocComment":"         sum += *val;"},{"DocComment":"         ControlFlow::Continue(())"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(res, ControlFlow::Break(-1));"},{"DocComment":" assert_eq!(sum, 6);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Break`]: ControlFlow::Break"},{"DocComment":" [`Continue`]: ControlFlow::Continue"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"ControlFlow"},"generics":{"regions":[],"types":[{"index":0,"name":"B"},{"index":1,"name":"C"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":24,"beg":{"line":93,"col":4},"end":{"line":93,"col":12}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Move on to the next phase of the operation as normal."}],"inline":null,"rename":null,"public":true},"name":"Continue","fields":[{"span":{"data":{"file_id":24,"beg":{"line":93,"col":13},"end":{"line":93,"col":14}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":4400}}],"discriminant":{"Scalar":{"Signed":["Isize","0"]}}},{"id":1,"span":{"data":{"file_id":24,"beg":{"line":97,"col":4},"end":{"line":97,"col":9}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Exit the operation without running subsequent phases."}],"inline":null,"rename":null,"public":true},"name":"Break","fields":[{"span":{"data":{"file_id":24,"beg":{"line":97,"col":10},"end":{"line":97,"col":11}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":4399}}],"discriminant":{"Scalar":{"Signed":["Isize","1"]}}}]},"layout":[],"ptr_metadata":"None"},{"def_id":21,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["Infallible",0]}],"span":{"data":{"file_id":25,"beg":{"line":930,"col":0},"end":{"line":930,"col":19}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The error type for errors that can never happen."},{"DocComment":""},{"DocComment":" Since this enum has no variant, a value of this type can never actually exist."},{"DocComment":" This can be useful for generic APIs that use [`Result`] and parameterize the error type,"},{"DocComment":" to indicate that the result is always [`Ok`]."},{"DocComment":""},{"DocComment":" For example, the [`TryFrom`] trait (conversion that returns a [`Result`])"},{"DocComment":" has a blanket implementation for all types where a reverse [`Into`] implementation exists."},{"DocComment":""},{"DocComment":" ```ignore (illustrates std code, duplicating the impl in a doctest would be an error)"},{"DocComment":" impl<T, U> TryFrom<U> for T where U: Into<T> {"},{"DocComment":"     type Error = Infallible;"},{"DocComment":""},{"DocComment":"     fn try_from(value: U) -> Result<Self, Infallible> {"},{"DocComment":"         Ok(U::into(value))  // Never returns `Err`"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Future compatibility"},{"DocComment":""},{"DocComment":" This enum has the same role as [the `!` “never” type][never],"},{"DocComment":" which is unstable in this version of Rust."},{"DocComment":" When `!` is stabilized, we plan to make `Infallible` a type alias to it:"},{"DocComment":""},{"DocComment":" ```ignore (illustrates future std change)"},{"DocComment":" pub type Infallible = !;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" … and eventually deprecate `Infallible`."},{"DocComment":""},{"DocComment":" However there is one case where `!` syntax can be used"},{"DocComment":" before `!` is stabilized as a full-fledged type: in the position of a function’s return type."},{"DocComment":" Specifically, it is possible to have implementations for two different function pointer types:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" trait MyTrait {}"},{"DocComment":" impl MyTrait for fn() -> ! {}"},{"DocComment":" impl MyTrait for fn() -> std::convert::Infallible {}"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" With `Infallible` being an enum, this code is valid."},{"DocComment":" However when `Infallible` becomes an alias for the never type,"},{"DocComment":" the two `impl`s will start to overlap"},{"DocComment":" and therefore will be disallowed by the language’s trait coherence rules."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":null,"uninhabited":true,"variant_layouts":[],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":22,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["RangeTo",0]}],"span":{"data":{"file_id":26,"beg":{"line":281,"col":0},"end":{"line":281,"col":23}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A range only bounded exclusively above (`..end`)."},{"DocComment":""},{"DocComment":" The `RangeTo` `..end` contains all values with `x < end`."},{"DocComment":" It cannot serve as an [`Iterator`] because it doesn't have a starting point."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `..end` syntax is a `RangeTo`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((..5), std::ops::RangeTo { end: 5 });"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It does not have an [`IntoIterator`] implementation, so you can't use it in"},{"DocComment":" a `for` loop directly. This won't compile:"},{"DocComment":""},{"DocComment":" ```compile_fail,E0277"},{"DocComment":" // error[E0277]: the trait bound `std::ops::RangeTo<{integer}>:"},{"DocComment":" // std::iter::Iterator` is not satisfied"},{"DocComment":" for i in ..5 {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" When used as a [slicing index], `RangeTo` produces a slice of all array"},{"DocComment":" elements before the index indicated by `end`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]); // This is a `RangeTo`"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [slicing index]: crate::slice::SliceIndex"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"RangeTo"},"generics":{"regions":[],"types":[{"index":0,"name":"Idx"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":26,"beg":{"line":284,"col":4},"end":{"line":284,"col":16}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" The upper bound of the range (exclusive)."}],"inline":null,"rename":null,"public":true},"name":"end","ty":{"Deduplicated":4399}}]},"layout":[],"ptr_metadata":"None"},{"def_id":23,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["RangeFrom",0]}],"span":{"data":{"file_id":26,"beg":{"line":197,"col":0},"end":{"line":197,"col":25}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A range only bounded inclusively below (`start..`)."},{"DocComment":""},{"DocComment":" The `RangeFrom` `start..` contains all values with `x >= start`."},{"DocComment":""},{"DocComment":" *Note*: Overflow in the [`Iterator`] implementation (when the contained"},{"DocComment":" data type reaches its numerical limit) is allowed to panic, wrap, or"},{"DocComment":" saturate. This behavior is defined by the implementation of the [`Step`]"},{"DocComment":" trait. For primitive integers, this follows the normal rules, and respects"},{"DocComment":" the overflow checks profile (panic in debug, wrap in release). Note also"},{"DocComment":" that overflow happens earlier than you might assume: the overflow happens"},{"DocComment":" in the call to `next` that yields the maximum value, as the range must be"},{"DocComment":" set to a state to yield the next value."},{"DocComment":""},{"DocComment":" [`Step`]: crate::iter::Step"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `start..` syntax is a `RangeFrom`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((2..), std::ops::RangeFrom { start: 2 });"},{"DocComment":" assert_eq!(2 + 3 + 4, (2..).take(3).sum());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]);"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]); // This is a `RangeFrom`"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"RangeFrom"},"generics":{"regions":[],"types":[{"index":0,"name":"Idx"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":26,"beg":{"line":200,"col":4},"end":{"line":200,"col":18}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" The lower bound of the range (inclusive)."}],"inline":null,"rename":null,"public":true},"name":"start","ty":{"Deduplicated":4399}}]},"layout":[],"ptr_metadata":"None"},{"def_id":24,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Ident":["nonzero",0]},{"Ident":["NonZero",0]}],"span":{"data":{"file_id":33,"beg":{"line":128,"col":0},"end":{"line":128,"col":40}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A value that is known not to equal zero."},{"DocComment":""},{"DocComment":" This enables some memory layout optimization."},{"DocComment":" For example, `Option<NonZero<u32>>` is the same size as `u32`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use core::{num::NonZero};"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<Option<NonZero<u32>>>(), size_of::<u32>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":""},{"DocComment":" `NonZero<T>` is guaranteed to have the same layout and bit validity as `T`"},{"DocComment":" with the exception that the all-zero bit pattern is invalid."},{"DocComment":" `Option<NonZero<T>>` is guaranteed to be compatible with `T`, including in"},{"DocComment":" FFI."},{"DocComment":""},{"DocComment":" Thanks to the [null pointer optimization], `NonZero<T>` and"},{"DocComment":" `Option<NonZero<T>>` are guaranteed to have the same size and alignment:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::num::NonZero;"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<NonZero<u32>>(), size_of::<Option<NonZero<u32>>>());"},{"DocComment":" assert_eq!(align_of::<NonZero<u32>>(), align_of::<Option<NonZero<u32>>>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [null pointer optimization]: crate::option#representation"},{"DocComment":""},{"DocComment":" # Note on generic usage"},{"DocComment":""},{"DocComment":" `NonZero<T>` can only be used with some standard library primitive types"},{"DocComment":" (such as `u8`, `i32`, and etc.). The type parameter `T` must implement the"},{"DocComment":" internal trait [`ZeroablePrimitive`], which is currently permanently unstable"},{"DocComment":" and cannot be implemented by users. Therefore, you cannot use `NonZero<T>`"},{"DocComment":" with your own types, nor can you implement traits for all `NonZero<T>`,"},{"DocComment":" only for concrete types."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"NonZero"},"generics":{"regions":[],"types":[{"index":0,"name":"T"},{"index":1,"name":"Clause0_NonZeroInner"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":33,"beg":{"line":128,"col":41},"end":{"line":128,"col":56}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":null,"ty":{"Deduplicated":4400}}]},"layout":[],"ptr_metadata":"None"},null,null,null,{"def_id":28,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["option",0]},{"Ident":["Option",0]}],"span":{"data":{"file_id":37,"beg":{"line":597,"col":0},"end":{"line":597,"col":18}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The `Option` type. See [the module level documentation](self) for more."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Option"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":37,"beg":{"line":601,"col":4},"end":{"line":601,"col":8}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" No value."}],"inline":null,"rename":null,"public":true},"name":"None","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","0"]}}},{"id":1,"span":{"data":{"file_id":37,"beg":{"line":605,"col":4},"end":{"line":605,"col":8}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Some value of type `T`."}],"inline":null,"rename":null,"public":true},"name":"Some","fields":[{"span":{"data":{"file_id":37,"beg":{"line":605,"col":55},"end":{"line":605,"col":56}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":4399}}],"discriminant":{"Scalar":{"Signed":["Isize","1"]}}}]},"layout":[],"ptr_metadata":"None"},{"def_id":29,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Ident":["niche_types",0]},{"Ident":["NonZeroI32Inner",0]}],"span":{"data":{"file_id":38,"beg":{"line":20,"col":8},"end":{"line":20,"col":55}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":38,"beg":{"line":20,"col":26},"end":{"line":20,"col":53}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":null,"ty":{"HashConsedValue":[4407,{"Pattern":[{"Deduplicated":2955},{"OrPattern":[{"Range":[{"kind":{"Literal":{"Scalar":{"Signed":["I32","-2147483648"]}}},"ty":{"Deduplicated":2955}},{"kind":{"Literal":{"Scalar":{"Signed":["I32","-1"]}}},"ty":{"Deduplicated":2955}}]},{"Range":[{"kind":{"Literal":{"Scalar":{"Signed":["I32","1"]}}},"ty":{"Deduplicated":2955}},{"kind":{"Literal":{"Scalar":{"Signed":["I32","2147483647"]}}},"ty":{"Deduplicated":2955}}]}]}]}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":4,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},null,null,null,null,null,{"def_id":35,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["pin",0]},{"Ident":["Pin",0]}],"span":{"data":{"file_id":40,"beg":{"line":1092,"col":0},"end":{"line":1092,"col":19}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A pointer which pins its pointee in place."},{"DocComment":""},{"DocComment":" [`Pin`] is a wrapper around some kind of pointer `Ptr` which makes that pointer \"pin\" its"},{"DocComment":" pointee value in place, thus preventing the value referenced by that pointer from being moved"},{"DocComment":" or otherwise invalidated at that place in memory unless it implements [`Unpin`]."},{"DocComment":""},{"DocComment":" *See the [`pin` module] documentation for a more thorough exploration of pinning.*"},{"DocComment":""},{"DocComment":" ## Pinning values with [`Pin<Ptr>`]"},{"DocComment":""},{"DocComment":" In order to pin a value, we wrap a *pointer to that value* (of some type `Ptr`) in a"},{"DocComment":" [`Pin<Ptr>`]. [`Pin<Ptr>`] can wrap any pointer type, forming a promise that the **pointee**"},{"DocComment":" will not be *moved* or [otherwise invalidated][subtle-details]. If the pointee value's type"},{"DocComment":" implements [`Unpin`], we are free to disregard these requirements entirely and can wrap any"},{"DocComment":" pointer to that value in [`Pin`] directly via [`Pin::new`]. If the pointee value's type does"},{"DocComment":" not implement [`Unpin`], then Rust will not let us use the [`Pin::new`] function directly and"},{"DocComment":" we'll need to construct a [`Pin`]-wrapped pointer in one of the more specialized manners"},{"DocComment":" discussed below."},{"DocComment":""},{"DocComment":" We call such a [`Pin`]-wrapped pointer a **pinning pointer** (or pinning ref, or pinning"},{"DocComment":" [`Box`], etc.) because its existence is the thing that is pinning the underlying pointee in"},{"DocComment":" place: it is the metaphorical \"pin\" securing the data in place on the pinboard (in memory)."},{"DocComment":""},{"DocComment":" It is important to stress that the thing in the [`Pin`] is not the value which we want to pin"},{"DocComment":" itself, but rather a pointer to that value! A [`Pin<Ptr>`] does not pin the `Ptr` but rather"},{"DocComment":" the pointer's ***pointee** value*."},{"DocComment":""},{"DocComment":" The most common set of types which require pinning related guarantees for soundness are the"},{"DocComment":" compiler-generated state machines that implement [`Future`] for the return value of"},{"DocComment":" `async fn`s. These compiler-generated [`Future`]s may contain self-referential pointers, one"},{"DocComment":" of the most common use cases for [`Pin`]. More details on this point are provided in the"},{"DocComment":" [`pin` module] docs, but suffice it to say they require the guarantees provided by pinning to"},{"DocComment":" be implemented soundly."},{"DocComment":""},{"DocComment":" This requirement for the implementation of `async fn`s means that the [`Future`] trait"},{"DocComment":" requires all calls to [`poll`] to use a <code>self: [Pin]\\<&mut Self></code> parameter instead"},{"DocComment":" of the usual `&mut self`. Therefore, when manually polling a future, you will need to pin it"},{"DocComment":" first."},{"DocComment":""},{"DocComment":" You may notice that `async fn`-sourced [`Future`]s are only a small percentage of all"},{"DocComment":" [`Future`]s that exist, yet we had to modify the signature of [`poll`] for all [`Future`]s"},{"DocComment":" to accommodate them. This is unfortunate, but there is a way that the language attempts to"},{"DocComment":" alleviate the extra friction that this API choice incurs: the [`Unpin`] trait."},{"DocComment":""},{"DocComment":" The vast majority of Rust types have no reason to ever care about being pinned. These"},{"DocComment":" types implement the [`Unpin`] trait, which entirely opts all values of that type out of"},{"DocComment":" pinning-related guarantees. For values of these types, pinning a value by pointing to it with a"},{"DocComment":" [`Pin<Ptr>`] will have no actual effect."},{"DocComment":""},{"DocComment":" The reason this distinction exists is exactly to allow APIs like [`Future::poll`] to take a"},{"DocComment":" [`Pin<Ptr>`] as an argument for all types while only forcing [`Future`] types that actually"},{"DocComment":" care about pinning guarantees pay the ergonomics cost. For the majority of [`Future`] types"},{"DocComment":" that don't have a reason to care about being pinned and therefore implement [`Unpin`], the"},{"DocComment":" <code>[Pin]\\<&mut Self></code> will act exactly like a regular `&mut Self`, allowing direct"},{"DocComment":" access to the underlying value. Only types that *don't* implement [`Unpin`] will be restricted."},{"DocComment":""},{"DocComment":" ### Pinning a value of a type that implements [`Unpin`]"},{"DocComment":""},{"DocComment":" If the type of the value you need to \"pin\" implements [`Unpin`], you can trivially wrap any"},{"DocComment":" pointer to that value in a [`Pin`] by calling [`Pin::new`]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::pin::Pin;"},{"DocComment":""},{"DocComment":" // Create a value of a type that implements `Unpin`"},{"DocComment":" let mut unpin_future = std::future::ready(5);"},{"DocComment":""},{"DocComment":" // Pin it by creating a pinning mutable reference to it (ready to be `poll`ed!)"},{"DocComment":" let my_pinned_unpin_future: Pin<&mut _> = Pin::new(&mut unpin_future);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ### Pinning a value inside a [`Box`]"},{"DocComment":""},{"DocComment":" The simplest and most flexible way to pin a value that does not implement [`Unpin`] is to put"},{"DocComment":" that value inside a [`Box`] and then turn that [`Box`] into a \"pinning [`Box`]\" by wrapping it"},{"DocComment":" in a [`Pin`]. You can do both of these in a single step using [`Box::pin`]. Let's see an"},{"DocComment":" example of using this flow to pin a [`Future`] returned from calling an `async fn`, a common"},{"DocComment":" use case as described above."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::pin::Pin;"},{"DocComment":""},{"DocComment":" async fn add_one(x: u32) -> u32 {"},{"DocComment":"     x + 1"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Call the async function to get a future back"},{"DocComment":" let fut = add_one(42);"},{"DocComment":""},{"DocComment":" // Pin the future inside a pinning box"},{"DocComment":" let pinned_fut: Pin<Box<_>> = Box::pin(fut);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you have a value which is already boxed, for example a [`Box<dyn Future>`][Box], you can pin"},{"DocComment":" that value in-place at its current memory address using [`Box::into_pin`]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::pin::Pin;"},{"DocComment":" use std::future::Future;"},{"DocComment":""},{"DocComment":" async fn add_one(x: u32) -> u32 {"},{"DocComment":"     x + 1"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn boxed_add_one(x: u32) -> Box<dyn Future<Output = u32>> {"},{"DocComment":"     Box::new(add_one(x))"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let boxed_fut = boxed_add_one(42);"},{"DocComment":""},{"DocComment":" // Pin the future inside the existing box"},{"DocComment":" let pinned_fut: Pin<Box<_>> = Box::into_pin(boxed_fut);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There are similar pinning methods offered on the other standard library smart pointer types"},{"DocComment":" as well, like [`Rc`] and [`Arc`]."},{"DocComment":""},{"DocComment":" ### Pinning a value on the stack using [`pin!`]"},{"DocComment":""},{"DocComment":" There are some situations where it is desirable or even required (for example, in a `#[no_std]`"},{"DocComment":" context where you don't have access to the standard library or allocation in general) to"},{"DocComment":" pin a value which does not implement [`Unpin`] to its location on the stack. Doing so is"},{"DocComment":" possible using the [`pin!`] macro. See its documentation for more."},{"DocComment":""},{"DocComment":" ## Layout and ABI"},{"DocComment":""},{"DocComment":" [`Pin<Ptr>`] is guaranteed to have the same memory layout and ABI[^noalias] as `Ptr`."},{"DocComment":""},{"DocComment":" [^noalias]: There is a bit of nuance here that is still being decided about whether the"},{"DocComment":" aliasing semantics of `Pin<&mut T>` should be different than `&mut T`, but this is true as of"},{"DocComment":" today."},{"DocComment":""},{"DocComment":" [`pin!`]: crate::pin::pin \"pin!\""},{"DocComment":" [`Future`]: crate::future::Future \"Future\""},{"DocComment":" [`poll`]: crate::future::Future::poll \"Future::poll\""},{"DocComment":" [`Future::poll`]: crate::future::Future::poll \"Future::poll\""},{"DocComment":" [`pin` module]: self \"pin module\""},{"DocComment":" [`Rc`]: ../../std/rc/struct.Rc.html \"Rc\""},{"DocComment":" [`Arc`]: ../../std/sync/struct.Arc.html \"Arc\""},{"DocComment":" [Box]: ../../std/boxed/struct.Box.html \"Box\""},{"DocComment":" [`Box`]: ../../std/boxed/struct.Box.html \"Box\""},{"DocComment":" [`Box::pin`]: ../../std/boxed/struct.Box.html#method.pin \"Box::pin\""},{"DocComment":" [`Box::into_pin`]: ../../std/boxed/struct.Box.html#method.into_pin \"Box::into_pin\""},{"DocComment":" [subtle-details]: self#subtle-details-and-the-drop-guarantee \"pin subtle details\""},{"DocComment":" [`unsafe`]: ../../std/keyword.unsafe.html \"keyword unsafe\""}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"pin"},"generics":{"regions":[],"types":[{"index":0,"name":"Ptr"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"}],"fun_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["aspis_r1_cost_probe",0]},{"Ident":["RealR1_client",0]},{"Ident":["prove_for_proof_accounts",0]}],"span":{"data":{"file_id":0,"beg":{"line":20,"col":0},"end":{"line":30,"col":1}},"generated_from_span":null},"source_text":"pub fn prove_for_proof_accounts(\n    public: Public<'_>,\n    compiled: &PoolV1PairForestMergedC1CompilationV1,\n    hash: HashFn,\n    nonce_store: &mut DurableStateOnlyMaskNonceStore,\n    mut proof_account: impl FnMut(usize) -> [u8; 32],\n) -> Result<RetriedProof, Error> {\n    prover::prove_masked_retrying_with(public, compiled, Variant::S2, hash, nonce_store, |k| {\n        StateOnlyAttemptSecrets::generate_for_mask_nonce(proof_account(k)).map_err(|_| Error::Entropy)\n    })\n}","attr_info":{"attributes":[{"DocComment":" Request the public key of a retained proof account for each entered attempt."},{"DocComment":" The client keeps the keys, including rejected attempts, and uses the key at"},{"DocComment":" `result.attempts - 1` for the published proof account. This function handles"},{"DocComment":" public keys only; it never creates, funds, deletes or uploads an account."},{"DocComment":""},{"DocComment":" Keys may be chosen after prior attempts. The supplied durable ledger is"},{"DocComment":" shared across calls; duplicate keys fail closed, even after rejection."},{"DocComment":" Only the two private 32-byte seeds come from the OS (E1); reservation uses"},{"DocComment":" the existing atomic, persistent ledger (E2). Errors and the eight-attempt"},{"DocComment":" cap are exactly those of `prove_masked_retrying_with`."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"