theorem NLL_LoopValue.source : ∀ (H : Bytes → AspisV8R19.SourceDuplexStep.State) (proof : Slice U8),
  (↑proof).length = 57607 →
    ∀ (p : OraclePortCompactDraft.Parsed),
      p.wire = MultiproofConeCanonical.bytesOf ↑proof →
        ∀ (q : Fin 22 → Fin 262144) (batch : ℕ) (kind lo n slot : Usize) (root : Root),
          batch < 2 →
            ↑kind < 3 →
              ↑slot = 3 * batch + ↑kind →
                (↑lo = if batch = 0 then 0 else 10) →
                  ↑n ≤ 16 →
                    ∀ (positions : List ℕ) (f : Frame),
                      (∀ selected ∈ positions, selected ∈ OraclePortFrozenOrder.sortedPositions q batch ↑kind) →
                        ↑f.position + positions.length = ↑n →
                          ↑f.scratch.n + positions.length ≤ 16 →
                            Port4B_LeafLoop.KeyStream q batch (↑kind) f.keys f.position positions →
                              ∀ (events : List Event) (out : Answer),
                                Loop H proof root batch kind lo n slot f events out →
                                  NKV_FRef.verifier.candidate.batch_tree_loop (NKV_ConcreteChildren.ops H)
                                        (NKV_ConcreteChildren.digest H) proof root kind f.scratch.idx f.scratch.val ()
                                        lo n slot f.keys f.scratch.n f.position >>=
                                      NKV_ReturnBoundary.returned =
                                    ok out :=
⋯
