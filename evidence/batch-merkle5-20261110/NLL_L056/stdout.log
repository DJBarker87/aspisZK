theorem NLL_ResumeQueries.returned : ∀ (reserved : Bool) {X : Type} (D : aspis_core.digest.Digest32 X)
  (ck proof pub : Slice U8) (hash : X) (p : verifier.Prepared) (a : verifier.Accumulator),
  verifier.resumeWithOps (CheckpointBytes4Ops.ops reserved) D ck proof pub transport.Variant.S2 hash =
      ok (core.result.Result.Ok (p, a)) →
    ∀ j < 22, ↑(↑p.queries)[j]! < 262144 :=
⋯
'NLL_ResumeQueries.bounds' depends on axioms: [propext, Quot.sound]
'NLL_ResumeQueries.returned' depends on axioms: [propext, Classical.choice, Quot.sound]
