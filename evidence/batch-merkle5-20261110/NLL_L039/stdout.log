theorem NLL_TreeAdopted.returning : ∀ (H : Bytes → State) (proof : Slice U8),
  (↑proof).length = 57607 →
    ∀ (p : OraclePortCompactDraft.Parsed),
      p.wire = MultiproofConeCanonical.bytesOf ↑proof →
        ∀ (raw : Std.Array U32 22#usize) (root : Root) (batch kind : Usize),
          ↑batch < 2 →
            ↑kind < 3 →
              (∀ j < 22, ↑(↑raw)[j]! < 262144) →
                root = encodeState (OraclePortBatchDraft.committedRoot p ↑kind) →
                  ∀ (idx : Indices) (val : Values) (events : List Event) (out : Answer),
                    Invocation H proof raw root batch kind idx val events out →
                      have model :=
                        eval H
                          (MultiproofConeSlotState.slotState p (Port4B_KeyInstall.queries raw) (↑batch) (↑kind)
                            (nodeView H proof ((Usize.wrapping_mul 3#usize batch).wrapping_add kind))
                            (NJV_EntryABI.initial idx val 0#usize));
                      (leafHistory kind events, NKV_ReturnBoundary.reject (ok out)) =
                        (model.1, NKV_TailModel.model model.2) :=
⋯
'NLL_TreeAdopted.returning' depends on axioms: [propext, Classical.choice, Quot.sound]
