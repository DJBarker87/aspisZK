theorem NLL_ParentAdoptedAbort.source : ∀ (H : Bytes → State) (proof : Slice U8),
  (↑proof).length = 57607 →
    ∀ (p : OraclePortCompactDraft.Parsed),
      p.wire = MultiproofConeCanonical.bytesOf ↑proof →
        ∀ (raw : Std.Array U32 22#usize) (batch : Usize),
          ↑batch < 2 →
            (∀ j < 22, ↑(↑raw)[j]! < 262144) →
              ∀ (sites : List Call),
                (∀ c ∈ sites, ↑c.2 < 3) →
                  (∀ c ∈ sites, c.1 = encodeState (OraclePortBatchDraft.committedRoot p ↑c.2)) →
                    ∀ (idx : Indices) (val : Values) (history : History) (pending : Pending),
                      AbortCalls H proof raw batch sites idx val history pending →
                        NLL_Prefix.At (NLL_ObservedCalls.calls H proof p raw batch sites idx val).1
                          (history ++ pending.answered) pending.parts :=
⋯
'NLL_ParentAdoptedAbort.source' depends on axioms: [propext, Classical.choice, Quot.sound]
