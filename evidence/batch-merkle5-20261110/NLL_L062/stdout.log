theorem AspisR1.NFW_PreparedCalls.calls : ∀ {H : Type} (B : AspisR1PublicPreparation.PreparedScratchModel.Boundaries)
  (D : AspisR1PublicPreparation.aspis_core.Digest32 H) (sem : AspisR1PublicPreparation.r1_semantic.Verified H)
  (v : AspisR1PublicPreparation.verifier.View) (hash : H) (out : AspisR1PublicPreparation.verifier.Prepared)
  (scratch old : Aeneas.Std.Array AspisR1PublicPreparation.aspis_core.field.WideExact 29#usize),
  AspisR1PublicPreparation.PreparedScratchModel.prepare B D sem v hash old =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok out, scratch) →
    B.powers 29#usize out.gamma = Aeneas.Std.Result.ok scratch ∧
      B.claim D sem v.y1 v.inactive scratch out.kappa =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok out.claim) ∧
        ∃ row before afterQueries last,
          (row = 30#u8 ∨ row = 31#u8) ∧
            B.sampling.queries D before row v.final_message =
                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok out.queries, afterQueries) ∧
              AspisR1PublicPreparation.PreparedModel.scalar_k B.sampling D afterQueries
                    (if row = 30#u8 then 31#u8 else 32#u8)
                    AspisR1PublicPreparation.PreparedScratchReachability.emptyPayload =
                  Aeneas.Std.Result.ok (out.rho, last) ∧
                out.state = last.state :=
⋯
