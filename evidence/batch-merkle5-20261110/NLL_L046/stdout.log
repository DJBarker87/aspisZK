theorem NLL_AbortDomains.source : ∀ (H : Bytes → State) (proof : Slice U8) (raw : Std.Array U32 22#usize) (root : Root)
  (batch kind : Usize) (idx : Indices) (val : Values) (events : List Event) (pending : Pending),
  AbortInvocation H proof raw root batch kind idx val events pending →
    ↑pending.parent.scratch.n ≤ if ↑batch = 0 then 10 else 12 :=
⋯
'NLL_AbortDomains.loop' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLL_AbortDomains.source' depends on axioms: [propext, Classical.choice, Quot.sound]
