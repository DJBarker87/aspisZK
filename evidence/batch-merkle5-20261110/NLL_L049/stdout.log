theorem NLL_BatchAbort.source : ∀ (H : Bytes → State) (proof : Slice U8),
  (↑proof).length = 57607 →
    ∀ (parsed : OraclePortCompactDraft.Parsed),
      parsed.wire = MultiproofConeCanonical.bytesOf ↑proof →
        ∀ (p : verifier.Prepared) (folded : Root) (batch : Usize),
          ↑batch < 2 →
            (∀ j < 22, ↑(↑p.queries)[j]! < 262144) →
              ∀ (history : History) (pending : Pending),
                Invocation H proof p folded batch history pending →
                  NLL_Prefix.At
                    (plan H proof parsed p.queries batch (sites (NLL_BatchSource.roots p folded)) NKV_ParentSource.zeroI
                      NKV_ParentSource.zeroV)
                    (history ++ pending.answered) pending.parts :=
⋯
'NLL_BatchAbort.source' depends on axioms: [propext, Classical.choice, Quot.sound]
