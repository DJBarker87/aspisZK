theorem AspisR1.FJc_InstalledFinalPart0.value : ∀ (r : AspisR1.NP6_StdModel.Reservation)
  (semAlpha : Aeneas.Std.Array AspisR1Stage2.Stage2Finish.K 10#usize)
  (z : Aeneas.Std.Array AspisR1Stage2.aspis_core.circle.SecureCirclePoint 2#usize) (w : AspisR1.FIo_Install.W)
  (alpha : Aeneas.Std.Slice AspisR1Stage2.Stage2Finish.E) (f : Aeneas.Std.Slice Aeneas.Std.U8)
  (kappa out : AspisR1Stage2.Stage2Finish.E),
  AspisR1.FIn_WeightsInstall.newWeights AspisR1Stage2.transport.Variant.S2 semAlpha z =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok w) →
    (AspisR1.FIo_Install.toSlice alpha).len = 2#usize →
      (↑f).length = 2048 →
        (∀ x ∈ ↑(AspisR1.FIo_Install.toSlice alpha), AspisR1.FIo_WideValues.Canon x) →
          AspisR1.FIo_Install.pair r w alpha f kappa = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok out) →
            ∃ nativeOut low parts k,
              (AspisR1.FIo_Install.toWeights w).pair (AspisR1.FIo_Install.toSlice alpha) f
                    (AspisR1.FIo_Install.toE kappa) =
                  Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok nativeOut) ∧
                AspisR1.FIo_Install.fromE nativeOut = out ∧
                  AspisR1.FIo_ArrayCanon.Holds low ∧
                    FIo_Native.weights.powers 7#usize (AspisR1.FIo_Install.toE kappa) = Aeneas.Std.Result.ok k ∧
                      FIo_Native.weights.Weights.pair_loop17 { start := 0#usize, «end» := 7#usize } parts k
                            FIo_Native.aspis_core.field.wide_exact.WideExact.ZERO =
                          Aeneas.Std.Result.ok nativeOut ∧
                        AspisR1.FIp_ArrayValue.value parts 0 = AspisR1.FJc_InactiveValue.sumPrefix f low 12 :=
fun r semAlpha z w alpha f kappa out hw folds len halpha run =>
  let ⟨points, h✝⟩ := AspisR1.FJc_InstalledParts.value AspisR1Stage2.transport.Variant.S2 semAlpha z w hw
  let ⟨a8, h✝¹⟩ := h✝
  let ⟨a9, h✝²⟩ := h✝¹
  let ⟨f1, h✝³⟩ := h✝²
  let ⟨f2, h✝⁴⟩ := h✝³
  let ⟨hp, right✝⟩ := h✝⁴
  let ⟨h8, right✝¹⟩ := right✝
  let ⟨h9, right✝²⟩ := right✝¹
  let ⟨hf1, right✝³⟩ := right✝²
  let ⟨hf2, right✝⁴⟩ := right✝³
  let ⟨hvariant, rest⟩ := right✝⁴
  have variant := hvariant;
  let ⟨nativeOut, h✝⁵⟩ := AspisR1.FIo_Install.reached r w alpha f kappa out run
  let ⟨hn, he⟩ := h✝⁵
  let ⟨low, h✝⁶⟩ :=
    AspisR1.FJc_InactiveFinalValue.value (AspisR1.FIo_Install.toWeights w) (AspisR1.FIo_Install.toSlice alpha) f
      (AspisR1.FIo_Install.toE kappa) nativeOut folds variant len halpha hn
  let ⟨parts, h✝⁷⟩ := h✝⁶
  let ⟨k, h✝⁸⟩ := h✝⁷
  let ⟨hc, right✝⁵⟩ := h✝⁸
  let ⟨hk, right✝⁶⟩ := right✝⁵
  let ⟨hsum, hvalue⟩ := right✝⁶
  Exists.intro nativeOut (Exists.intro low (Exists.intro parts (Exists.intro k ⟨hn, ⟨he, ⟨hc, ⟨hk, ⟨hsum, hvalue⟩⟩⟩⟩⟩)))
