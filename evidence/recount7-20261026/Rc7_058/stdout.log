@AspisR1.Rc7_AcceptedInput.accepted_input : ∀ {W F CoreError : Type}
  (L : AspisR1.S2Trust.Library W (ℕ → AspisR1.S2W_D189Entry.Record)) (e1 e2 : AspisR1.S2W_D189Entry.Entry) (w1 w2 : W)
  (adapterOps : AdapterRw.Ops) (ops : AspisR1CurrentCaller.Ops) (reserved : Bool)
  (queryOps : AspisR1.Port3_NativeQueryBody.Ops) (geoOps : AspisR1.Port3_NativeGeometryBody.Ops CoreError)
  (stageBase : VTop_Stages.Ops) (finishOps : AspisR1Stage2.Stage2Finish.FinishOps F)
  (B : AspisR1PublicPreparation.FinishModel.Boundaries) (reservation : AspisR1.NP6_StdModel.Reservation)
  (program : AspisR1.S2W_ExtractionBoundary.Program) (data1 data2 : Aeneas.Std.Slice Aeneas.Std.U8)
  (slot : AspisR1.S2W_ExtractionBoundary.Slot) (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
  (post1 post2 : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record))
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (driver :
    AspisR1.OraclePortStoredExperimentC4.Input →
      AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State Bool)
  (prior : AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State Unit)
  (events : List AspisR1.S2X.AccountEvent)
  (hashv : AspisR1.S2Z.Oracle.Parts → Aeneas.Std.Result AspisR1.S2Z.Oracle.Digest) (bad : Prop),
  AspisR1.P2P_Result.Outcome L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps stageBase finishOps B reservation
      program data1 data2 slot saved post1 post2 H driver prior events hashv bad →
    ¬bad →
      ∃ f s,
        AspisR1.S2W_NativeConsolidation.SourceCuts
            (AspisR1.ClaimsUnrolledSdk.sdkOps
              (AspisR1.Tx2I_Install.install adapterOps
                (AspisR1.Op5T_Concrete.stage
                  (AspisR1.Tx2N_Execution.control (AspisR1.AuS1_Install.base stageBase) reserved queryOps geoOps))
                finishOps)
              (AspisR1.Uni_Install.current ops reserved queryOps geoOps) (AspisR1.F3M_CircleSource.install B)
              (AspisR1.NP6_StdModel.calls reservation))
            e1.first (e2.second AspisR1.S2W_D189Wrappers.secondSizes) saved f s ∧
          ∃ i,
            i.statement.pubBytes = AspisR1.MultiproofConeCanonical.bytesOf ↑f.pub ∧
              i.stored = AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof ∧
                i.statement.tag = 2 ∧
                  List.length i.statement.pubBytes = 1880 ∧
                    (AspisV8R19.MemoizedProgramLaw.eval H (driver i)).2 = Bool.true ∧
                      ¬∀ (j : AspisR1.OraclePortStoredExperimentC4.Input),
                          (AspisV8R19.MemoizedProgramLaw.eval H (driver j)).2 = Bool.false
@AspisR1.Rc7_Clean.exists_world : ∀ {F C : Type} (err : C) (c : AspisR1.DrvC_Installation.Configuration F C)
  (r : AspisR1.NP6_StdModel.Reservation)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (D : AspisR1.LiteralByteProtocol.Decoder) (w : AspisR1.CanonicalCutEnrichedTranscript.Words)
  (P : AspisR1.F3T_ByteCarrier.ByteProver),
  (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      (AspisV8R19.MemoizedProgramLaw.eval H P).1.length ≤ 0) →
    ∀
      (select :
        AspisR1.F3X_Projection.Output → AspisR1.R9PoolRuntimeBinding.Inputs × AspisR1.R9PoolRuntimeBinding.Inputs),
      ∃ H,
        ¬AspisR1.BinRawByteCollisionTargets.event AspisR1.SelectedTranscriptParams.params.iv (0 + 2965)
            (AspisV8R19.MemoizedProgramLaw.eval H
              (AspisR1.Hiq_RecordedJoint.program
                (AspisR1.F3X_Account.program (AspisR1.Rc5_Install.configuration err c r) hashv P)
                AspisR1.F3X_Projection.project select))
@AspisR1.Rc7_Nonvacuity.composed : ∀ {W A F CoreError Tx : Type}
  (L : AspisR1.S2Trust.Library W (ℕ → AspisR1.S2W_D189Entry.Record)),
  AspisR1.S2Trust.S2TrustedSdkBorrow L →
    ∀
      (copy :
        AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
          ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record)),
      AspisR1.S2W_TrustedStd.TrustedStd copy →
        ∀ (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (e1 e2 : AspisR1.S2W_D189Entry.Entry) (w1 w2 : W),
          AspisR1.S2W_D189Consolidation.RuntimeEntrypointAdmission L e1 w1 3 →
            AspisR1.S2W_D189Consolidation.RuntimeEntrypointAdmission L e2 w2 7 →
              ∀ (c : AspisR1.DrvC_Installation.Configuration F CoreError) (indexError : CoreError)
                (reservation : AspisR1.NP6_StdModel.Reservation) (native1 : AspisR1.S2W_ExtractionBoundary.First)
                (native2 : AspisR1.S2W_ExtractionBoundary.Second)
                (hashv : AspisR1.S2Z.Oracle.Parts → Aeneas.Std.Result AspisR1.S2Z.Oracle.Digest),
                AspisR1.S2W_DigestExtraction.AeneasExtraction
                    (AspisR1.DrvC_Installation.sdk (AspisR1.Rc5_Install.configuration indexError c reservation)) native1
                    native2 hashv →
                  ∀ (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
                    AspisR1.S2W_ExtractionBoundary.P1 sha256 H →
                      AspisR1.S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
                        ∀ (data1 data2 : Aeneas.Std.Slice Aeneas.Std.U8) (slot : AspisR1.S2W_ExtractionBoundary.Slot)
                          (state1 state2 final1 final2 : A) (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
                          (post1 post2 : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record)),
                          AspisR1.S2W_D189Wrappers.first native1 copy allocator e1 AspisR1.CPH_Program.verifier data1
                                state1 =
                              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post1, final1)) →
                            AspisR1.S2W_D189Wrappers.second native2 allocator e2 AspisR1.CPH_Program.verifier data2 slot
                                  state2 =
                                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (post2, final2)) →
                              ∀ (root : Aeneas.Std.Array Aeneas.Std.U8 32#usize) (length : Aeneas.Std.U32)
                                (prior :
                                  AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes
                                    AspisV8R19.SourceDuplexStep.State Unit)
                                (words : AspisR1.CanonicalCutEnrichedTranscript.Words)
                                (p : AspisR1.CPG_Projection.Observations Tx A) (t u : Tx)
                                (actions : List (AspisR1.CPP_BankState.Action A)),
                                AspisR1.CPH_Game.DeployedPairExecution p t u e1 e2 saved actions native1 native2 copy
                                    allocator AspisR1.CPH_Program.verifier →
                                  AspisR1.CPR_DataPersistence.TwoTransactionLaw (AspisR1.CPG_Projection.adjacent p)
                                      (AspisR1.CPG_Projection.ordinary p (AspisR1.Hist_Nonvacuity.key 0#u8))
                                      (AspisR1.CPG_Projection.before p) (AspisR1.CPG_Projection.tentative p)
                                      (AspisR1.CPG_Projection.success p) (AspisR1.CPG_Projection.loaded p) →
                                    ∀ (D : AspisR1.LiteralByteProtocol.Decoder)
                                      (submission : AspisR1.F3T_ByteCarrier.Submission),
                                      AspisR1.FGl_PreparedAt.Owners
                                          (AspisR1.Rc5_Install.configuration indexError c reservation)
                                          (AspisR1.Rc2_Install.configuration (AspisR1.Rc5_Install.seed indexError c)
                                              reservation).boundaries →
                                        (∀ (f : AspisR1.S2W_NativeConsolidation.FirstCut)
                                            (s : AspisR1.S2W_NativeConsolidation.SecondCut),
                                            AspisR1.S2W_NativeConsolidation.SourceCuts
                                                (AspisR1.DrvC_Installation.sdk
                                                  (AspisR1.Rc5_Install.configuration indexError c reservation))
                                                e1.first (e2.second AspisR1.S2W_D189Wrappers.secondSizes) saved f s →
                                              AspisR1.MultiproofConeCanonical.bytesOf ↑s.proof =
                                                  AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof ∧
                                                AspisR1.MultiproofConeCanonical.bytesOf ↑s.pub =
                                                    AspisR1.MultiproofConeCanonical.bytesOf ↑f.pub ∧
                                                  AspisR1.MultiproofConeCanonical.bytesOf ↑f.pub =
                                                      submission.publicBytes ∧
                                                    AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof =
                                                      submission.stored) →
                                          have r := AspisR1.Rc5_Install.configuration indexError c reservation;
                                          have runtime :=
                                            AspisR1.F3X_FixtureRuntime.runtime r D hashv
                                              (AspisV8R19.MemoizedProgramLaw.Program.done submission);
                                          AspisR1.F3T_Runtime.StoredCarrierBinding r D
                                              (AspisR1.F3T_Installed.source r hashv)
                                              (AspisV8R19.MemoizedProgramLaw.Program.done submission) runtime ∧
                                            (AspisV8R19.MemoizedProgramLaw.eval H
                                                    (AspisR1.F3T_Installed.source r hashv
                                                      (AspisR1.F3T_ByteCarrier.input r submission))).2 =
                                                Bool.true ∧
                                              (∃ run,
                                                  (AspisV8R19.MemoizedProgramLaw.eval H runtime).2 = Option.some run ∧
                                                    run.2.2 = Bool.true) ∧
                                                AspisR1.F3U_Numeric.margin ≤
                                                    1 / 2 ^ 100 - AspisR1.F3T_RuntimeBound.failureModel runtime ∧
                                                  AspisR1.F3T_RuntimeBound.failureModel runtime < 1 / 2 ^ 100
