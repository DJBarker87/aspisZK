                                  AspisV8R19.SourceDuplexStep.State (AspisR1.GExq_AccountExperiment.Outcome A) :=
fun {A F C} adapter ops stage finish reserved query geo B std hashv copy allocator id adversary chooseSecond =>
  AspisV8R19.OracleProgramOps.bind adversary fun input =>
    AspisV8R19.OracleProgramOps.bind
      (AspisR1.SdkC_Oracle.program
        (AspisR1.GExq_InstalledWrapper.first adapter ops stage finish reserved query geo B std hashv copy allocator
          input.entry id input.data input.state))
      fun reply =>
      match reply with
      | Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post, final)) =>
        AspisV8R19.OracleProgramOps.bind (chooseSecond input saved post final) fun next =>
          AspisV8R19.OracleProgramOps.bind
            (AspisR1.SdkC_Oracle.program
              (AspisR1.GExq_InstalledWrapper.second adapter ops stage finish reserved query geo B std hashv allocator
                next.entry id next.data next.slot next.state))
            fun out => AspisV8R19.MemoizedProgramLaw.Program.done (input, reply, Option.some (next, out))
      | x => AspisV8R19.MemoizedProgramLaw.Program.done (input, reply, Option.none)
