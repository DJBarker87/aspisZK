fun {W A F CoreError Tx} L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 c indexError reservation native1
    native2 hashv extraction sha256 H p1 syscall data1 data2 slot state1 state2 final1 final2 saved post1 post2
    accepted1 accepted2 root length prior words p t u actions game RuntimePersistence =>
  let ⟨left✝, right✝⟩ :=
    AspisR1.P2P_Source.source L sdk copy std allocator e1 e2 w1 w2 admission1 admission2
      (AspisR1.Rc5_Install.seed indexError c) reservation native1 native2 (AspisR1.SAQ_Decoder.primitives c.query) hashv
      extraction sha256 H p1 syscall AspisR1.CPH_Program.verifier data1 data2 slot state1 state2 final1 final2 saved
      post1 post2 accepted1 accepted2 root length prior words
  let ⟨left✝¹, right✝¹⟩ := right✝
  let ⟨source, right✝²⟩ := right✝¹
  let ⟨left✝², right✝³⟩ := right✝²
  AspisR1.P2P_R5Close.from_saf L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 c indexError reservation
    native1 native2 hashv extraction sha256 H p1 syscall AspisR1.CPH_Program.verifier data1 data2 slot state1 state2
    final1 final2 saved post1 post2 accepted1 accepted2 root length prior p t u actions game
    (AspisR1.Hist_Nonvacuity.key 0#u8) AspisR1.CPH_Program.not_system RuntimePersistence source
