                                            AspisR1.F3T_Runtime.StoredCarrierBinding
                                                (AspisR1.Rc5_Install.configuration indexError c reservation) D
                                                (AspisR1.F3T_Installed.source
                                                  (AspisR1.Rc5_Install.configuration indexError c reservation) hashv)
                                                P runtime →
                                              have select := fun x =>
                                                AspisR1.P2P_NativeSelection.pair
                                                  (AspisR1.DrvC_Installation.sdk
                                                    (AspisR1.Rc5_Install.configuration indexError c reservation))
                                                  AspisR1.CPH_Program.verifier e1 e2 data2 slot;
                                              AspisR1.MultiproofConeP6Frozen2Stage.P6Boundary
                                                  (AspisR1.P6C_Extension.dictionary hashv H) () H AspisR1.Op5T_P6.parent
                                                  AspisR1.Op5T_P6.parent AspisR1.Op5T_P6.parent
                                                  AspisR1.MultiproofConeP6Batch.referenceLeaf ∧
                                                AspisR1.DrvC_Implementation.driver
                                                      (AspisR1.Rc5_Install.configuration indexError c reservation) =
                                                    AspisR1.DrvC_SourceEntry.source
                                                      (AspisR1.Rc5_Install.configuration indexError c reservation)
                                                      hashv ∧
                                                  AspisR1.DrvC_Installation.sdk
                                                        (AspisR1.Rc5_Install.configuration indexError c reservation) =
                                                      AspisR1.SdkD_PairBatches.dictionary
                                                        (AspisR1.Rc5_Install.configuration indexError c
                                                            reservation).adapter
                                                        (AspisR1.Rc5_Install.configuration indexError c
                                                            reservation).currentBase
                                                        (AspisR1.Rc5_Install.configuration indexError c
                                                            reservation).stageBase
                                                        (AspisR1.Rc5_Install.configuration indexError c
                                                            reservation).finish
                                                        (AspisR1.Rc5_Install.configuration indexError c
                                                            reservation).reserved
                                                        (AspisR1.Rc5_Install.configuration indexError c
                                                            reservation).query
                                                        (AspisR1.Rc5_Install.configuration indexError c
                                                            reservation).geometry
                                                        (AspisR1.Rc5_Install.configuration indexError c
                                                            reservation).boundaries
                                                        (AspisR1.Rc5_Install.configuration indexError c
                                                            reservation).std ∧
                                                    AspisR1.P2P_Result.Outcome L e1 e2 w1 w2
                                                        (AspisR1.Rc5_Install.configuration indexError c
                                                            reservation).adapter
                                                        (AspisR1.Rc5_Install.configuration indexError c
                                                            reservation).currentBase
                                                        (AspisR1.Rc5_Install.configuration indexError c
                                                            reservation).reserved
                                                        (AspisR1.Rc5_Install.configuration indexError c
                                                            reservation).query
                                                        (AspisR1.Rc5_Install.configuration indexError c
                                                            reservation).geometry
                                                        (AspisR1.Rc5_Install.configuration indexError c
                                                            reservation).stageBase
                                                        (AspisR1.Rc5_Install.configuration indexError c
                                                            reservation).finish
