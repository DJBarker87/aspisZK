                                                              AspisR1.S2W_EntryWriteHistory.payloadBytes
                                                                    AspisR1.S2W_ReturnedCheckpoint.encode
                                                                    (post1.payload (e1.heap.accounts 2).1) 1768 =
                                                                  AspisR1.MultiproofConeCanonical.bytesOf ↑saved ∧
                                                                post1.ambient = e1.heap.ambient ∧
                                                                  post1.accounts = e1.heap.accounts ∧
                                                                    post1.counter = e1.heap.counter ∧
                                                                      ∀ (cell : ℕ),
                                                                        cell ≠ (e1.heap.accounts 2).1 →
                                                                          post1.payload cell = e1.heap.payload cell) ∧
