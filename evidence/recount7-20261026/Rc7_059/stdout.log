                                                              AspisR1.CPH_Program.verifier H saved ∧
                                                            AspisR1.CPH_Protection.Facts p t saved
                                                                AspisR1.CPH_Program.verifier ∧
                                                              AspisR1.CPH_Trace.Facts p t u saved native1 native2 copy
                                                                  allocator AspisR1.CPH_Program.verifier ∧
                                                                AspisR1.CPH_Recorder.Facts
                                                                  (AspisR1.Rc5_Install.configuration indexError c
                                                                    reservation)
                                                                  hashv native1 native2 copy allocator
                                                                  AspisR1.CPH_Program.verifier H p t u saved :=
fun {W A F CoreError Tx} L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 c indexError reservation native1
    native2 hashv extraction sha256 H p1 syscall data1 data2 slot state1 state2 final1 final2 saved post1 post2
    accepted1 accepted2 root length prior words p t u actions game RuntimePersistence D P Q0 Q1 queries runtime
    finishOwners binding =>
  id
    (let select := fun x =>
      AspisR1.P2P_NativeSelection.pair
        (AspisR1.DrvC_Installation.sdk (AspisR1.Rc5_Install.configuration indexError c reservation))
        AspisR1.CPH_Program.verifier e1 e2 data2 slot;
    have prepare := AspisR1.F3Y_InstalledLaws.prepare indexError c reservation;
    have ports := AspisR1.F3Y_InstalledLaws.primitives indexError c reservation;
    have canonical := AspisR1.F3Y_InstalledLaws.canonical indexError c reservation;
    have domain := AspisR1.F3Y_InstalledLaws.domain indexError c reservation;
    have multiply := AspisR1.F3Y_InstalledLaws.multiply indexError c reservation;
    have one := AspisR1.F3Y_InstalledLaws.one indexError c reservation;
    have inverse := AspisR1.F3Y_InstalledLaws.inverse indexError c reservation;
    have security :=
      AspisR1.FGl_Bound.bound (AspisR1.Rc2_Install.configuration (AspisR1.Rc5_Install.seed indexError c) reservation)
        hashv D words P (Q0 + Q1) queries runtime select prepare ports canonical domain multiply one inverse
        finishOwners binding;
    have sourceCost :=
      AspisR1.FGl_Cost.source_cost
        (AspisR1.Rc2_Install.configuration (AspisR1.Rc5_Install.seed indexError c) reservation) hashv D words P
        (Q0 + Q1) queries select prepare ports canonical domain multiply one inverse finishOwners;
    have accountMass :=
      AspisR1.F3Y_AccountMass.claims
        (AspisR1.Rc2_Install.configuration (AspisR1.Rc5_Install.seed indexError c) reservation) hashv D words P
        (Q0 + Q1) queries select;
    ⟨AspisR1.P6C_Extension.boundary hashv sha256 H p1 syscall,
      ⟨AspisR1.DrvC_SourceEntry.same_program
          (AspisR1.Rc3_Install.select (AspisR1.Rc5_Install.seed indexError c) reservation) hashv,
        ⟨AspisR1.DrvC_Installation.aus1_dictionary (AspisR1.Rc5_Install.configuration indexError c reservation),
          ⟨have original :=
              AspisR1.Rc7_Native.accepted L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 c indexError
                reservation native1 native2 hashv extraction sha256 H p1 syscall data1 data2 slot state1 state2 final1
                final2 saved post1 post2 accepted1 accepted2 root length prior words p t u actions game
                RuntimePersistence;
            have strengthened :=
              AspisR1.P2P_R6Result.strengthen L e1 e2 w1 w2
                (AspisR1.Rc5_Install.configuration indexError c reservation).adapter
                (AspisR1.Rc5_Install.configuration indexError c reservation).currentBase
                (AspisR1.Rc5_Install.configuration indexError c reservation).reserved
                (AspisR1.Rc5_Install.configuration indexError c reservation).query
                (AspisR1.Rc5_Install.configuration indexError c reservation).geometry
                (AspisR1.Rc5_Install.configuration indexError c reservation).stageBase
                (AspisR1.Rc5_Install.configuration indexError c reservation).finish c.boundaries reservation
                AspisR1.CPH_Program.verifier data1 data2 slot saved post1 post2 H
                (AspisR1.DrvC_Implementation.driver (AspisR1.Rc5_Install.configuration indexError c reservation)) prior
                (p.physicalEvents t) hashv native1 native2 extraction sha256 p1 syscall original;
            AspisR1.P2P_Release.remove L e1 e2 w1 w2
              (AspisR1.Rc5_Install.configuration indexError c reservation).adapter
              (AspisR1.Rc5_Install.configuration indexError c reservation).currentBase
              (AspisR1.Rc5_Install.configuration indexError c reservation).reserved
              (AspisR1.Rc5_Install.configuration indexError c reservation).query
              (AspisR1.Rc5_Install.configuration indexError c reservation).geometry
              (AspisR1.Rc5_Install.configuration indexError c reservation).stageBase
              (AspisR1.Rc5_Install.configuration indexError c reservation).finish c.boundaries reservation
              AspisR1.CPH_Program.verifier data1 data2 slot saved post1 post2 H
              (AspisR1.DrvC_Implementation.driver (AspisR1.Rc5_Install.configuration indexError c reservation)) prior
              (p.physicalEvents t) hashv
              (AspisR1.F3X_Account.program (AspisR1.Rc5_Install.configuration indexError c reservation) hashv P)
              AspisR1.F3X_Projection.project (Q0 + Q1)
              (AspisR1.F3Y_AccountMass.budget
                (AspisR1.Rc2_Install.configuration (AspisR1.Rc5_Install.seed indexError c) reservation) hashv D words P
                (Q0 + Q1) queries)
              strengthened,
            ⟨⟨AspisR1.F3X_ModelClaims.claims (AspisR1.Rc5_Install.configuration indexError c reservation) D P (Q0 + Q1)
                  queries,
                ⟨sourceCost,
                  ⟨accountMass,
                    ⟨security,
                      ⟨fun range =>
                        Eq.mp
                          (congrArg (LE.le (AspisR1.F3T_RuntimeBound.failureModel runtime))
                            (congrFun' (congrArg HMul.hMul (congrFun' (congrArg HAdd.hAdd (Nat.cast_add Q0 Q1)) 1))
                              (1 / 2 ^ 100)))
                          (LE.le.trans security (AspisR1.F3U_Range.per_attempt (Q0 + Q1) range)),
                        fun zero =>
                        AspisR1.F3U_Numeric.runtime_margin (AspisR1.F3T_RuntimeBound.failureModel runtime)
                          (Eq.mp
                            (congrArg
                              (fun _a => AspisR1.F3T_RuntimeBound.failureModel runtime ≤ AspisR1.F3T_Numeric.total _a)
                              zero)
                            security)⟩⟩⟩⟩⟩,
              ⟨AspisR1.PoolT_Write.accepted_verifier_writes_copy
                  (AspisR1.DrvC_Installation.sdk (AspisR1.Rc5_Install.configuration indexError c reservation)) native1
                  native2 hashv extraction copy std allocator e1 AspisR1.CPH_Program.verifier data1 state1 final1 saved
                  post1 accepted1,
                ⟨AspisR1.Rc2_Events.derive (AspisR1.Rc5_Install.configuration indexError c reservation) hashv native1
                    native2 extraction copy allocator AspisR1.CPH_Program.verifier sha256 H p1 syscall saved,
                  ⟨AspisR1.CPH_Protection.derive p t u e1 e2 saved actions
                      (AspisR1.Rc5_Install.configuration indexError c reservation)
                      (AspisR1.Rc5_Install.key indexError c reservation) native1 native2 hashv extraction copy std
                      allocator AspisR1.CPH_Program.verifier game data1 state1 final1 post1 accepted1,
                    ⟨AspisR1.CPH_Trace.derive game,
                      AspisR1.CPH_Recorder.physical p t u e1 e2 saved actions
                        (AspisR1.Rc5_Install.configuration indexError c reservation) native1 native2 hashv extraction
                        copy allocator AspisR1.CPH_Program.verifier game sha256 H p1 syscall⟩⟩⟩⟩⟩⟩⟩⟩⟩)
