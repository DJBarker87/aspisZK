  let kappa ← AspisR1.LiteralChallengeRead.ordinaryAt rs 28
  let alpha0 ← AspisR1.LiteralChallengeRead.ordinaryAt rs 29
  let alpha1 ← AspisR1.LiteralChallengeRead.ordinaryAt rs 30
