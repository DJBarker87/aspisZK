theorem AspisR1.NJU_GeneralFinishRoot.finish : ∀ (r : NP6_StdModel.Reservation) (loc : Locations) (proof : Slice U8)
  (v : verifier.View) (p : verifier.Prepared) (a : verifier.Accumulator),
  NJU_FinishInput.Holds proof v p a →
    have execution := NJF_FinishObserved.G r loc v p a;
    Port3_NativeFinishBody.verifier.finish_relation (NIG_Slots.installed r) v p a none = execution.1 ∧
      NIW_AlignFinishComposedLog.forget execution = NIW_AlignFinishExecution.run r v p a ∧
        NIW_AlignFinishPrefix.Prefix execution.2.1 :=
fun r loc proof v p a facts =>
  have same := NJU_WeakFinishObserved.source_log r loc proof v p a facts;
  have first := congrArg Prod.fst same;
  id
    (fun first =>
      ⟨Eq.trans (NJU_FinishObserved.source r v p a (NJU_FinishInput.intrinsic proof v p a facts)) (Eq.symm first),
        ⟨same,
          have history := NIW_AlignFinishPrefix.source r v p a;
          have events := congrArg Prod.snd same;
          id (fun events => Eq.mpr (id (congrArg (fun _a => NIW_AlignFinishPrefix.Prefix _a) events)) history) events⟩⟩)
    first
'AspisR1.NJU_GeneralFinishRoot.finish' depends on axioms: [propext, Classical.choice, Quot.sound]
