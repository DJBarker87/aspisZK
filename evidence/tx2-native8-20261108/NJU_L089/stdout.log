theorem NJU_ResumeRoot.source : ∀ (reservation : NP6_StdModel.Reservation) {H : Type}
  (d : AspisR1Stage2.aspis_core.digest.Digest32 H) (ck proof pub : Slice U8) (v : transport.Variant) (hash : H),
  (NJU_ResumeObserved.run reservation d ck proof pub v hash).result =
    NJC_RawCalls.resume (NJC_FilledClause.reserved reservation) d ck proof pub v hash :=
fun reservation {H} d ck proof pub v hash =>
  Eq.trans (NJU_ResumeErase.header reservation d ck proof pub v hash)
    (NJU_ResumeReference.source reservation d ck proof pub v hash)
theorem NJU_ResumeRoot.cohort : ∀ (reservation : NP6_StdModel.Reservation) {H : Type}
  (d : AspisR1Stage2.aspis_core.digest.Digest32 H) (ck proof pub : Slice U8) (hash : H),
  NIL_StatePort.reply (NJU_ResumeObserved.run reservation d ck proof pub transport.Variant.S2 hash).result =
    AspisR1Stage2.verifier.resumeWithOps (CheckpointBytes4Ops.ops (NJC_FilledClause.reserved reservation)) d ck proof
      pub AspisR1Stage2.transport.Variant.S2 hash :=
fun reservation {H} d ck proof pub hash =>
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          NIL_StatePort.reply _a =
            AspisR1Stage2.verifier.resumeWithOps (CheckpointBytes4Ops.ops (NJC_FilledClause.reserved reservation)) d ck
              proof pub AspisR1Stage2.transport.Variant.S2 hash)
        (source reservation d ck proof pub transport.Variant.S2 hash)))
    (NJC_RawCalls.source (NJC_FilledClause.reserved reservation) d ck proof pub hash)
'NJU_ResumeRoot.source' depends on axioms: [propext, Classical.choice, Quot.sound]
'NJU_ResumeRoot.cohort' depends on axioms: [propext, Classical.choice, Quot.sound]
