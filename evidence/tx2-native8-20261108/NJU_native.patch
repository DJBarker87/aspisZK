+#[kani::stub(core::ptr::copy_nonoverlapping,KMX_copy_nonoverlapping)]
+#[kani::stub(<[u8]>::copy_from_slice,KMX_copy_from_slice)]
+fn round0_window(){window::<224>(7);}
+#[kani::proof]#[kani::unwind(225)]
+#[kani::stub(core::ptr::copy_nonoverlapping,KMX_copy_nonoverlapping)]
+#[kani::stub(<[u8]>::copy_from_slice,KMX_copy_from_slice)]
+fn round1_window(){window::<224>(7);}
+#[kani::proof]#[kani::unwind(2049)]
+#[kani::stub(core::ptr::copy_nonoverlapping,KMX_copy_nonoverlapping)]
+#[kani::stub(<[u8]>::copy_from_slice,KMX_copy_from_slice)]
+fn final_window(){window::<2048>(64);}
+
+fn bad_window<const N:usize>(limit:usize){
+ let mut bytes:[u8;N]=kani::any();let i:usize=kani::any();let j:usize=kani::any();
+ kani::assume(i<limit&&j<8);kani::assume(raw_word(&bytes,32*i+4*j)>=0x7fffffff);
+ if cfg!(NJU_invert){for b in &mut bytes{*b=0;}}
+ let _=super::field(&bytes,i);assert!(false,"NJU_BAD_WINDOW_RETURNED");
+}
+#[kani::proof]#[kani::unwind(225)]
+#[kani::stub(core::ptr::copy_nonoverlapping,KMX_copy_nonoverlapping)]
+#[kani::stub(<[u8]>::copy_from_slice,KMX_copy_from_slice)]
+fn round0_no_return(){bad_window::<224>(7);}
+#[kani::proof]#[kani::unwind(225)]
+#[kani::stub(core::ptr::copy_nonoverlapping,KMX_copy_nonoverlapping)]
+#[kani::stub(<[u8]>::copy_from_slice,KMX_copy_from_slice)]
+fn round1_no_return(){bad_window::<224>(7);}
+#[kani::proof]#[kani::unwind(2049)]
+#[kani::stub(core::ptr::copy_nonoverlapping,KMX_copy_nonoverlapping)]
+#[kani::stub(<[u8]>::copy_from_slice,KMX_copy_from_slice)]
+fn final_no_return(){bad_window::<2048>(64);}
