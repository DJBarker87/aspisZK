theorem NJU_FinishCase.current : ∀ (reserved : Bool) (r : NP6_StdModel.Reservation) {H : Type}
  (d : aspis_core.digest.Digest32 H) (ck proof pub : Slice U8) (hash : H) (p : verifier.Prepared)
  (a after : verifier.Accumulator) (g : Std.Array aspis_core.field.wide_exact.WideExact 29#usize)
  (geometry : verifier.QueryGeometry) (pending : verifier.BatchedWeights)
  (inactive : aspis_core.field.wide_exact.WideExact),
  (↑ck).length = 1768 →
    verifier.resumeWithOps (CheckpointBytes4Ops.ops reserved) d ck proof pub transport.Variant.S2 hash =
        ok (core.result.Result.Ok (p, a)) →
      ↑a.next = 10 →
        Port3_NativeQueryBody.verifier.candidate.query_loop (NFS_QueryOps.installed NJJ_QueryOps.concrete) proof p a g
              none geometry (NFW_QueryResume.pending a) 22#usize =
            ok (core.result.Result.Ok (after, pending)) →
          (↑proof).length = 57607 →
            ∃ out,
              Port3_FlushInstall.flush pending after.weights.deref = ok out ∧
                have v := NJR_ViewFinish.view proof inactive;
                have actual := { weights := ⟨↑out, ⋯⟩, rhs := after.rhs, power := after.power, next := after.next };
                NJU_CurrentWindows.Holds v ∧ NIG_FinishInput.Domain proof v p actual ∨
                  ¬NJU_CurrentWindows.Holds v ∧
                    Port4D_FinishInstall.finish (IDa_Deployed.finish r) v p actual none ≠
                      ok (core.result.Result.Ok ()) :=
fun reserved r {H} d ck proof pub hash p a after g geometry pending inactive ckSize resume start query size =>
  have dom := NID_ResumeFields.returned reserved d ck proof pub hash p a ckSize resume;
  have qdom :=
    NFW_QueryResume.domain p a dom.width (NID_ResumeQuery.weights a dom.weights)
      (NID_ResumeCallerDomain.wide a.rhs dom.rhs) (NID_ResumeCallerDomain.power a.power dom.power)
      (NID_ResumeCallerDomain.power p.rho dom.rho) start;
  let ⟨out, h✝⟩ :=
    NGM_FinishDomain.tx2_writeback NJJ_QueryOps.concrete proof p a after g geometry (NFW_QueryResume.pending a) pending
      qdom start query
  let ⟨flush, right✝⟩ := h✝
  let ⟨acc, right✝¹⟩ := right✝
  Exists.intro out
    ⟨flush,
      id
        (Or.casesOn (NJU_CurrentWindows.split (NJR_ViewFinish.view proof inactive))
          (fun good =>
            Or.inl
              (let ⟨other, h✝¹⟩ :=
                NJU_FinishDomain.reached reserved d ck proof pub hash p a after g geometry pending
                  (NJR_ViewFinish.view proof inactive) ckSize resume start query
                  (Decidable.byContradiction fun a_1 => current._proof_1 ck proof a size a_1) rfl rfl rfl good
              let ⟨otherFlush, domain⟩ := h✝¹
              have same := Eq.symm (ok.inj (Eq.mp (congrArg (fun _a => _a = ok other) flush) otherFlush));
              Eq.ndrec (motive := fun other =>
                Port3_FlushInstall.flush pending after.weights.deref = ok other →
                  NIG_FinishInput.Domain proof (NJR_ViewFinish.view proof inactive) p
                      { weights := ⟨↑other, other.property⟩, rhs := after.rhs, power := after.power,
                        next := after.next } →
                    NJU_CurrentWindows.Holds (NJR_ViewFinish.view proof inactive) ∧
                      NIG_FinishInput.Domain proof (NJR_ViewFinish.view proof inactive) p
                        { weights := ⟨↑out, out.property⟩, rhs := after.rhs, power := after.power, next := after.next })
                (fun otherFlush domain => ⟨good, domain⟩) (Eq.symm same) otherFlush domain))
          fun bad =>
          Or.inr
            (let ⟨r0, right✝²⟩ := NJR_AcceptedFinishDomain.lengths proof inactive size
            let ⟨r1, fin⟩ := right✝²
            ⟨bad,
              NJU_CurrentWindows.rejects r (NJR_ViewFinish.view proof inactive) p
                { weights := ⟨↑out, out.property⟩, rhs := after.rhs, power := after.power, next := after.next }
                dom.variant acc.width r0 r1 fin bad⟩))⟩
'NJU_FinishCase.current' depends on axioms: [propext, Classical.choice, Quot.sound]
