def AspisR1WeightsFieldCurrent.weights.field : {T : Type} →
  (Aeneas.Std.Slice Aeneas.Std.U8 → Aeneas.Std.Result (Option T)) →
    Aeneas.Std.Slice Aeneas.Std.U8 → Aeneas.Std.Usize → Aeneas.Std.Result T :=
fun {T} decode bytes i => do
  let i1 ← i * 32#usize
  let i2 ← i + 1#usize
  let i3 ← i2 * 32#usize
  let s ←
    Aeneas.Std.core.slice.index.Slice.index (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8) bytes
        { start := i1, «end» := i3 }
  let o ← decode s
  Aeneas.Std.core.option.Option.unwrap o
