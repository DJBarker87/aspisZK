                    (NID_ResumeEmission.verifier.Prepared × NID_ResumeEmission.verifier.Accumulator)
                    NID_ResumeEmission.verifier.Error) :=
fun reserved {H} d bytes proof public1 v hash =>
  NID_ResumeEmission.verifier.resume (fun {T U} {N} => AspisR1.CheckpointBytes4Ops.ne)
    (fun {T U} {N} => AspisR1.CheckpointBytes4Ops.eq) (fun {T E F O} => NIL_FreshOps.mapError)
    (fun {T F} => NIL_FreshOps.any) (fun x => Aeneas.Std.Result.ok x)
    (Aeneas.Std.Result.ok (NIL_Carriers.unK { c0 := { a := 0#u32, b := 0#u32 }, c1 := { a := 0#u32, b := 0#u32 } }))
    (fun {T} => NIL_FreshOps.filled reserved) NIL_FreshOps.semantic NIL_FreshOps.weights
    NJC_ValidateEmission.verifier.validate_checkpoint_queries NIL_FreshOps.readK NIL_FreshOps.readE
    NJC_ConcreteUnwrap.raw (fun v => AspisR1.CheckpointBytes4Ops.checkpointSize (NIL_Carriers.variant v))
    (fun v => AspisR1.CheckpointBytes4Ops.finalLen (NIL_Carriers.variant v))
    (fun v => AspisR1.CheckpointBytes4Ops.tag (NIL_Carriers.variant v)) (NIL_FreshOps.digest d) bytes proof public1 v
    hash
theorem NJC_RawCalls.source : ∀ (reserved : Bool) {H : Type} (d : AspisR1Stage2.aspis_core.digest.Digest32 H)
  (bytes proof public1 : Aeneas.Std.Slice Aeneas.Std.U8) (hash : H),
  NIL_StatePort.reply
      (NJC_RawCalls.resume reserved d bytes proof public1 NID_ResumeEmission.transport.Variant.S2 hash) =
    AspisR1Stage2.verifier.resumeWithOps (AspisR1.CheckpointBytes4Ops.ops reserved) d bytes proof public1
      AspisR1Stage2.transport.Variant.S2 hash :=
fun reserved {H} d bytes proof public1 hash =>
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          NIL_StatePort.reply _a =
            AspisR1Stage2.verifier.resumeWithOps (AspisR1.CheckpointBytes4Ops.ops reserved) d bytes proof public1
              AspisR1Stage2.transport.Variant.S2 hash)
        (NJC_RawCalls.reference reserved d bytes proof public1 NID_ResumeEmission.transport.Variant.S2 hash)))
    (NJC_ValidateCalls.source reserved d bytes proof public1 hash)
def AspisR1.NIW_AlignFinishComposed.observe : {A B : Type} →
  Aeneas.Std.Result (AspisR1.NIT_Cuts.Reply A) →
    (Aeneas.Std.Result (AspisR1.NIT_Cuts.Reply A) → AspisR1.NIW_AlignFinishComposed.Event) →
      (A → AspisR1.NIW_AlignFinishComposed.Observed B) → AspisR1.NIW_AlignFinishComposed.Observed B :=
fun {A B} call event next =>
  match call with
  | Aeneas.Std.Result.fail err => (Aeneas.Std.Result.fail err, [event call], none)
  | Aeneas.Std.Result.div => (Aeneas.Std.Result.div, [event call], none)
  | Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err err) =>
    (Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err err), [event call], none)
  | Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok value) =>
    have tail := next value;
    (tail.1, event call :: tail.2.1, tail.2.2)
@[reducible] def AspisR1.NIW_AlignFinishComposed.Event : Type :=
AspisR1.NIW_AlignFinishExecution.Event
def NIG_FinishAlpha.alpha : AspisR1Stage2.verifier.Prepared → (i : ℕ) → i < 2 → NIG_FinishAlpha.E :=
fun p i h => NHI_ScalarDomain.pick p.alpha i h
theorem NIG_FinishAlpha.selected : ∀ (proof : Aeneas.Std.Slice Aeneas.Std.U8) (v : AspisR1Stage2.verifier.View)
  (p : AspisR1Stage2.verifier.Prepared) (a : AspisR1Stage2.verifier.Accumulator),
  NIG_FinishInput.Domain proof v p a →
    ∀ (i : Aeneas.Std.Usize) (h : ↑i < 2),
      p.alpha.index_usize i = Aeneas.Std.Result.ok (NIG_FinishAlpha.alpha p (↑i) h) ∧
        AspisR1.LPi_FieldValues.canonE (AspisR1.FIo_Install.toE (NIG_FinishAlpha.alpha p (↑i) h)) :=
fun proof v p a domain i h =>
  ⟨NHI_ScalarDomain.index p.alpha i h,
    NIG_FinishAlpha.canonical (NIG_FinishAlpha.alpha p (↑i) h)
      (domain.alpha (↑i) h (NIG_FinishAlpha.alpha p (↑i) h)
        (of_eq_true (getElem?_eq_some_getElem_iff._simp_1 (NHI_ScalarDomain.pick._proof_1 p.alpha (↑i) h))))⟩
def AspisR1RecordParser.field.wide_exact.WideExact.from_le_bytes : Aeneas.Std.Slice Aeneas.Std.U8 →
  Aeneas.Std.Result (Option AspisR1RecordParser.field.wide_exact.WideExact) :=
fun bytes =>
  have i := bytes.len;
  if (i != AspisR1RecordParser.field.wide_exact.WideExact.BYTE_LEN) = true then Aeneas.Std.Result.ok none
  else do
    let i1 ← bytes.index_usize 0#usize
    let i2 ← bytes.index_usize 1#usize
    let i3 ← bytes.index_usize 2#usize
    let i4 ← bytes.index_usize 3#usize
    let i5 ← Aeneas.Std.lift (Aeneas.Std.core.num.U32.from_le_bytes (Aeneas.Std.Array.make 4#usize [i1, i2, i3, i4] ⋯))
    let i6 ← bytes.index_usize 4#usize
    let i7 ← bytes.index_usize 5#usize
    let i8 ← bytes.index_usize 6#usize
    let i9 ← bytes.index_usize 7#usize
    let i10 ← Aeneas.Std.lift (Aeneas.Std.core.num.U32.from_le_bytes (Aeneas.Std.Array.make 4#usize [i6, i7, i8, i9] ⋯))
    let i11 ← bytes.index_usize 8#usize
    let i12 ← bytes.index_usize 9#usize
    let i13 ← bytes.index_usize 10#usize
    let i14 ← bytes.index_usize 11#usize
    let i15 ←
      Aeneas.Std.lift (Aeneas.Std.core.num.U32.from_le_bytes (Aeneas.Std.Array.make 4#usize [i11, i12, i13, i14] ⋯))
    let i16 ← bytes.index_usize 12#usize
    let i17 ← bytes.index_usize 13#usize
    let i18 ← bytes.index_usize 14#usize
    let i19 ← bytes.index_usize 15#usize
    let i20 ←
      Aeneas.Std.lift (Aeneas.Std.core.num.U32.from_le_bytes (Aeneas.Std.Array.make 4#usize [i16, i17, i18, i19] ⋯))
    let i21 ← bytes.index_usize 16#usize
    let i22 ← bytes.index_usize 17#usize
    let i23 ← bytes.index_usize 18#usize
    let i24 ← bytes.index_usize 19#usize
    let i25 ←
      Aeneas.Std.lift (Aeneas.Std.core.num.U32.from_le_bytes (Aeneas.Std.Array.make 4#usize [i21, i22, i23, i24] ⋯))
    let i26 ← bytes.index_usize 20#usize
    let i27 ← bytes.index_usize 21#usize
    let i28 ← bytes.index_usize 22#usize
    let i29 ← bytes.index_usize 23#usize
    let i30 ←
      Aeneas.Std.lift (Aeneas.Std.core.num.U32.from_le_bytes (Aeneas.Std.Array.make 4#usize [i26, i27, i28, i29] ⋯))
    let i31 ← bytes.index_usize 24#usize
    let i32 ← bytes.index_usize 25#usize
    let i33 ← bytes.index_usize 26#usize
    let i34 ← bytes.index_usize 27#usize
    let i35 ←
      Aeneas.Std.lift (Aeneas.Std.core.num.U32.from_le_bytes (Aeneas.Std.Array.make 4#usize [i31, i32, i33, i34] ⋯))
    let i36 ← bytes.index_usize 28#usize
    let i37 ← bytes.index_usize 29#usize
    let i38 ← bytes.index_usize 30#usize
    let i39 ← bytes.index_usize 31#usize
    let i40 ←
      Aeneas.Std.lift (Aeneas.Std.core.num.U32.from_le_bytes (Aeneas.Std.Array.make 4#usize [i36, i37, i38, i39] ⋯))
    AspisR1RecordParser.field.wide_exact.WideExact.from_limbs
        (Aeneas.Std.Array.make 8#usize [i5, i10, i15, i20, i25, i30, i35, i40] ⋯)
