      (NIG_FinishAlpha.alpha p (↑1#usize) (of_decide_eq_true (id (Eq.refl true)))) i0 i1 c0 c1
      (NIG_Slots.folds r p core.s2)
      (NIG_Slots.round0 r v.round0 (NIG_FinishAlpha.alpha p (↑0#usize) (of_decide_eq_true (id (Eq.refl true)))) p.claim)
      (fun claim x =>
