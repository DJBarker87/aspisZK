      core.accumulator (NIG_Slots.dot r v.final_message a.weights.deref)
      (FIn_WeightsInstall.newWeights p.variant p.semantic_alpha p.z) (NIG_Slots.NHM_new r p) (NIG_PairExport.packet r)
      (NIG_PairExport.NHM_pair r p v);
