def AspisR1.SCF_RequiredTransport.CleanAccountTransport : {A F C : Type} →
  DrvC_Installation.Configuration F C →
    LiteralByteProtocol.Decoder →
      (SdkC_Source.Parts → Result SdkC_Source.Digest) →
        (Heap (ℕ → Record) → ℕ → Payload → S2W_TrustedStd.Outcome (ℕ → Record)) →
          Allocator A →
            S2W_ExtractionBoundary.Program →
              Adversary A →
                ℕ →
                  ℕ →
                    (GExq_AccountExperiment.Outcome A → OraclePortCompactDraft.Parsed × (Fin 22 → Fin 262144)) →
                      (GExq_AccountExperiment.Outcome A → R9PoolRuntimeBinding.Inputs × R9PoolRuntimeBinding.Inputs) →
                        Prop :=
fun {A F C} c D hashv copy allocator id a Q0 Q1 project select =>
  ∀ (H : Bytes → State),
    have v := eval H (account c hashv copy allocator id a);
    have physical := view (v.1, F3T_Canon.canonInput (input c (submitted v.2.1)), accepted v.2);
    have model := eval H (F3T_Charged.projected D (F3T_Canon.canon (F3T_ByteCarrier.lift c (submission a))));
    physical.2.2 = true →
      ¬BinRawByteCollisionTargets.event SelectedTranscriptParams.params.iv (Q0 + Q1 + 2965)
            (eval H (Hiq_RecordedJoint.program (account c hashv copy allocator id a) project select)) →
        model.2.2 = true ∧ OraclePortRefineJoin.RecoveredInputAgreement physical model
