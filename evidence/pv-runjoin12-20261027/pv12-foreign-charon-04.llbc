n":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Result` is a type that represents either success ([`Ok`]) or failure ([`Err`])."},{"DocComment":""},{"DocComment":" See the [module documentation](self) for details."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"Result"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":45,"beg":{"line":561,"col":4},"end":{"line":561,"col":6}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Contains the success value"}],"inline":null,"rename":null,"public":true},"name":"Ok","fields":[{"span":{"data":{"file_id":45,"beg":{"line":561,"col":53},"end":{"line":561,"col":54}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":1586}}],"discriminant":{"Scalar":{"Signed":["Isize","0"]}}},{"id":1,"span":{"data":{"file_id":45,"beg":{"line":566,"col":4},"end":{"line":566,"col":7}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Contains the error value"}],"inline":null,"rename":null,"public":true},"name":"Err","fields":[{"span":{"data":{"file_id":45,"beg":{"line":566,"col":54},"end":{"line":566,"col":55}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":3184}}],"discriminant":{"Scalar":{"Signed":["Isize","1"]}}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":1,"align":1,"discriminator":{"Branch":{"offset":0,"int_ty":{"Unsigned":"U8"},"children":[[{"start":{"Unsigned":["U8","0"]},"end":{"Unsigned":["U8","0"]}},{"Known":0}],[{"start":{"Unsigned":["U8","1"]},"end":{"Unsigned":["U8","1"]}},{"Known":1}]],"fallback":"Invalid"}},"uninhabited":false,"variant_layouts":[{"field_offsets":[1],"uninhabited":false,"tagger":[[0,{"Unsigned":["U8","0"]}]]},{"field_offsets":[1],"uninhabited":false,"tagger":[[0,{"Unsigned":["U8","1"]}]]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":46,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Error",0]}],"span":{"data":{"file_id":36,"beg":{"line":109,"col":0},"end":{"line":109,"col":16}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The error type which is returned from formatting a message into a stream."},{"DocComment":""},{"DocComment":" This type does not support transmission of an error other than that an error"},{"DocComment":" occurred. This is because, despite the existence of this error,"},{"DocComment":" string formatting is considered an infallible operation."},{"DocComment":" `fmt()` implementors should not return this `Error` unless they received it from their"},{"DocComment":" [`Formatter`]. The only time your code should create a new instance of this"},{"DocComment":" error is when implementing `fmt::Write`, in order to cancel the formatting operation when"},{"DocComment":" writing to the underlying stream fails."},{"DocComment":""},{"DocComment":" Any extra information must be arranged to be transmitted through some other means,"},{"DocComment":" such as storing it in a field to be consulted after the formatting operation has been"},{"DocComment":" cancelled. (For example, this is how [`std::io::Write::write_fmt()`] propagates IO errors"},{"DocComment":" during writing.)"},{"DocComment":""},{"DocComment":" This type, `fmt::Error`, should not be"},{"DocComment":" confused with [`std::io::Error`] or [`std::error::Error`], which you may also"},{"DocComment":" have in scope."},{"DocComment":""},{"DocComment":" [`std::io::Error`]: ../../std/io/struct.Error.html"},{"DocComment":" [`std::io::Write::write_fmt()`]: ../../std/io/trait.Write.html#method.write_fmt"},{"DocComment":" [`std::error::Error`]: ../../std/error/trait.Error.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::fmt::{self, write};"},{"DocComment":""},{"DocComment":" let mut output = String::new();"},{"DocComment":" if let Err(fmt::Error) = write(&mut output, format_args!(\"Hello {}!\", \"world\")) {"},{"DocComment":"     panic!(\"An error occurred\");"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":47,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["PhantomData",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":3190}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":28,"beg":{"line":811,"col":0},"end":{"line":811,"col":39}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Zero-sized type used to mark things that \"act like\" they own a `T`."},{"DocComment":""},{"DocComment":" Adding a `PhantomData<T>` field to your type tells the compiler that your"},{"DocComment":" type acts as though it stores a value of type `T`, even though it doesn't"},{"DocComment":" really. This information is used when computing certain safety properties."},{"DocComment":""},{"DocComment":" For a more in-depth explanation of how to use `PhantomData<T>`, please see"},{"DocComment":" [the Nomicon](../../nomicon/phantom-data.html)."},{"DocComment":""},{"DocComment":" # A ghastly note 👻👻👻"},{"DocComment":""},{"DocComment":" Though they both have scary names, `PhantomData` and 'phantom types' are"},{"DocComment":" related, but not identical. A phantom type parameter is simply a type"},{"DocComment":" parameter which is never used. In Rust, this often causes the compiler to"},{"DocComment":" complain, and the solution is to add a \"dummy\" use by way of `PhantomData`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ## Unused lifetime parameters"},{"DocComment":""},{"DocComment":" Perhaps the most common use case for `PhantomData` is a struct that has an"},{"DocComment":" unused lifetime parameter, typically as part of some unsafe code. For"},{"DocComment":" example, here is a struct `Slice` that has two pointers of type `*const T`,"},{"DocComment":" presumably pointing into an array somewhere:"},{"DocComment":""},{"DocComment":" ```compile_fail,E0392"},{"DocComment":" struct Slice<'a, T> {"},{"DocComment":"     start: *const T,"},{"DocComment":"     end: *const T,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The intention is that the underlying data is only valid for the"},{"DocComment":" lifetime `'a`, so `Slice` should not outlive `'a`. However, this"},{"DocComment":" intent is not expressed in the code, since there are no uses of"},{"DocComment":" the lifetime `'a` and hence it is not clear what data it applies"},{"DocComment":" to. We can correct this by telling the compiler to act *as if* the"},{"DocComment":" `Slice` struct contained a reference `&'a T`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::marker::PhantomData;"},{"DocComment":""},{"DocComment":" # #[allow(dead_code)]"},{"DocComment":" struct Slice<'a, T> {"},{"DocComment":"     start: *const T,"},{"DocComment":"     end: *const T,"},{"DocComment":"     phantom: PhantomData<&'a T>,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This also in turn infers the lifetime bound `T: 'a`, indicating"},{"DocComment":" that any references in `T` are valid over the lifetime `'a`."},{"DocComment":""},{"DocComment":" When initializing a `Slice` you simply provide the value"},{"DocComment":" `PhantomData` for the field `phantom`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" # use std::marker::PhantomData;"},{"DocComment":" # struct Slice<'a, T> {"},{"DocComment":" #     start: *const T,"},{"DocComment":" #     end: *const T,"},{"DocComment":" #     phantom: PhantomData<&'a T>,"},{"DocComment":" # }"},{"DocComment":" fn borrow_vec<T>(vec: &Vec<T>) -> Slice<'_, T> {"},{"DocComment":"     let ptr = vec.as_ptr();"},{"DocComment":"     Slice {"},{"DocComment":"         start: ptr,"},{"DocComment":"         end: unsafe { ptr.add(vec.len()) },"},{"DocComment":"         phantom: PhantomData,"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Unused type parameters"},{"DocComment":""},{"DocComment":" It sometimes happens that you have unused type parameters which"},{"DocComment":" indicate what type of data a struct is \"tied\" to, even though that"},{"DocComment":" data is not actually found in the struct itself. Here is an"},{"DocComment":" example where this arises with [FFI]. The foreign interface uses"},{"DocComment":" handles of type `*mut ()` to refer to Rust values of different"},{"DocComment":" types. We track the Rust type using a phantom type parameter on"},{"DocComment":" the struct `ExternalResource` which wraps a handle."},{"DocComment":""},{"DocComment":" [FFI]: ../../book/ch19-01-unsafe-rust.html#using-extern-functions-to-call-external-code"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" # trait ResType { }"},{"DocComment":" # struct ParamType;"},{"DocComment":" # mod foreign_lib {"},{"DocComment":" #     pub fn new(_: usize) -> *mut () { 42 as *mut () }"},{"DocComment":" #     pub fn do_stuff(_: *mut (), _: usize) {}"},{"DocComment":" # }"},{"DocComment":" # fn convert_params(_: ParamType) -> usize { 42 }"},{"DocComment":" use std::marker::PhantomData;"},{"DocComment":""},{"DocComment":" struct ExternalResource<R> {"},{"DocComment":"    resource_handle: *mut (),"},{"DocComment":"    resource_type: PhantomData<R>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<R: ResType> ExternalResource<R> {"},{"DocComment":"     fn new() -> Self {"},{"DocComment":"         let size_of_res = size_of::<R>();"},{"DocComment":"         Self {"},{"DocComment":"             resource_handle: foreign_lib::new(size_of_res),"},{"DocComment":"             resource_type: PhantomData,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     fn do_stuff(&self, param: ParamType) {"},{"DocComment":"         let foreign_params = convert_params(param);"},{"DocComment":"         foreign_lib::do_stuff(self.resource_handle, foreign_params);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Ownership and the drop check"},{"DocComment":""},{"DocComment":" The exact interaction of `PhantomData` with drop check **may change in the future**."},{"DocComment":""},{"DocComment":" Currently, adding a field of type `PhantomData<T>` indicates that your type *owns* data of type"},{"DocComment":" `T` in very rare circumstances. This in turn has effects on the Rust compiler's [drop check]"},{"DocComment":" analysis. For the exact rules, see the [drop check] documentation."},{"DocComment":""},{"DocComment":" ## Layout"},{"DocComment":""},{"DocComment":" For all `T`, the following are guaranteed:"},{"DocComment":" * `size_of::<PhantomData<T>>() == 0`"},{"DocComment":" * `align_of::<PhantomData<T>>() == 1`"},{"DocComment":""},{"DocComment":" [drop check]: Drop#drop-check"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"phantom_data"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":48,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["rt",0]},{"Ident":["ArgumentType",0]}],"span":{"data":{"file_id":38,"beg":{"line":14,"col":0},"end":{"line":14,"col":21}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Shared"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":38,"beg":{"line":15,"col":4},"end":{"line":15,"col":15}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"Placeholder","fields":[{"span":{"data":{"file_id":38,"beg":{"line":18,"col":8},"end":{"line":18,"col":26}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"value","ty":{"HashConsedValue":[5378,{"Adt":{"id":{"Adt":41},"generics":{"regions":[],"types":[{"Deduplicated":1586}],"const_generics":[],"trait_refs":[]}}}]}},{"span":{"data":{"file_id":38,"beg":{"line":19,"col":8},"end":{"line":19,"col":71}},"generated_from_span