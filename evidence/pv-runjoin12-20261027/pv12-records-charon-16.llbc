{"charon_version":"0.1.223","translated":{"crate_name":"aspis_statement","options":{"ullbc":false,"precise_drops":true,"skip_borrowck":false,"mir":"Optimized","rustc_args":["--cfg=aeneas_ref","-Zinline-mir-threshold=100000","-Zmir-enable-passes=+Inline,+GVN,+CopyProp,+DataflowConstProp,+SimplifyLocals-final,+SimplifyCfg-final","-Zinline-mir=yes"],"targets":[],"sysroot":"default","monomorphize":true,"monomorphize_mut":null,"start_from":["crate::pool_v1::pair_forest_copy_builder::records_reference::pv_runjoin12_shipped::records_transfer_owned"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["aspis_core::field::*"],"opaque":["crate::pool_v1::pair_forest_copy_builder::raw","crate::pool_v1::pair_trace::pair_empty_roots"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":true,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-pv-runjoin-20261026/evidence/pv12-records-charon-16.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"crates/aspis-statement/src/pool_v1/../../../../tools/r1-builder-reference/pv_runjoin12_shipped.rs"},"crate_name":"aspis_statement","contents":"//! Owned borrow adapter only: executes the unmodified shipped records leaf.\n//! Parent and this child are available only under cfg(aeneas_ref).\nuse super::*;\n\npub(super) fn records_owned(\n    input: PoolV1PairForestInputNoteWitnessV1,\n    out: u32,\n    rec: Option<PoolV1OutputNoteWitnessV1>,\n    chg: PoolV1OutputNoteWitnessV1,\n    snapshot: PoolV1PairLiveSnapshotV1,\n    asset: M31,\n) -> (RW, RP) {\n    super::super::records(&input, out, rec.as_ref(), &chg, &snapshot, asset)\n}\n\n// Variant-specific adapters expose the shipped call with a fixed Option tag.\n// They contain no mapping algorithm or replacement helper.\npub(super) fn records_transfer_owned(\n    input: super::super::PoolV1PairForestInputNoteWitnessV1,\n    out: u32,\n    recipient: super::super::PoolV1OutputNoteWitnessV1,\n    change: super::super::PoolV1OutputNoteWitnessV1,\n    snapshot: super::super::PoolV1PairLiveSnapshotV1,\n    asset: super::super::M31,\n) -> (super::super::RW, super::super::RP) {\n    super::super::records(&input, out, Some(&recipient), &change, &snapshot, asset)\n}\n\npub(super) fn records_withdrawal_owned(\n    input: super::super::PoolV1PairForestInputNoteWitnessV1,\n    out: u32,\n    change: super::super::PoolV1OutputNoteWitnessV1,\n    snapshot: super::super::PoolV1PairLiveSnapshotV1,\n    asset: super::super::M31,\n) -> (super::super::RW, super::super::RP) {\n    super::super::records(&input, out, None, &change, &snapshot, asset)\n}\n"},{"id":1,"name":{"Local":"crates/aspis-statement/src/pool_v1/../../../../tools/r1-builder-reference/records_reference.rs"},"crate_name":"aspis_statement","contents":"//! Owned record mapper for Charon/Aeneas; proof-only, no production dependency.\nuse super::*;\n\npub(super) fn records_reference_with_roots(input: PoolV1PairForestInputNoteWitnessV1, out: u32, rec: Option<PoolV1OutputNoteWitnessV1>,\n           chg: PoolV1OutputNoteWitnessV1, snapshot: PoolV1PairLiveSnapshotV1, asset: M31, empty: [Digest; 21]) -> (RW, RP) {\n    let pair = input.pair;\n    let mut bits = [0u32; 24];\n    let mut sibs = [[0u32; 8]; 24];\n    let mut level = 0;\n    while level < 24 {\n        bits[level] = if level == 0 { u32::from(pair.selected_second) }\n            else if level <= 20 { (pair.membership.index >> ((level - 1) as u32)) & 1 }\n            else { u32::from(input.super_root_directions[level - 21]) };\n        let mut lane = 0;\n        while lane < 8 {\n            sibs[level][lane] = if level == 0 {\n                if pair.selected_second { pair.pair_leaf.first_commitment[lane].0 }\n                else { pair.pair_leaf.second_commitment[lane].0 }\n            } else if level <= 20 { pair.membership.siblings[level-1][lane].0 }\n            else { input.super_root_siblings[level-21][lane].0 };\n            lane += 1;\n        }\n        level += 1;\n    }\n    let mut recipient_owner = ZERO8;\n    let mut recipient_salt = ZERO8;\n    let mut lane = 0;\n    while lane < 8 {\n        if let Some(r) = rec {\n            recipient_owner[lane] = r.owner_key[lane].0;\n            recipient_salt[lane] = r.salt[lane].0;\n        }\n        lane += 1;\n    }\n    let mut frontier = [[0u32; 8]; 20];\n    let mut empty_raw = [[0u32; 8]; 20];\n    let mut level = 0;\n    while level < 20 {\n        let mut lane = 0;\n        while lane < 8 {\n            frontier[level][lane] = snapshot.frontier[level][lane].0;\n            empty_raw[level][lane] = empty[level][lane].0;\n            lane += 1;\n        }\n        level += 1;\n    }\n    let w = RW {\n        input_value: pair.value,\n        output_value: out,\n        change_value: chg.value,\n        sk: raw_owned(pair.nullifier_key),\n        salt: raw_owned(pair.salt),\n        bits,\n        sibs,\n        pair_first: raw_owned(pair.pair_leaf.first_commitment),\n        pair_occupied: pair.pair_leaf.second_occupied.0,\n        pair_second: raw_owned(pair.pair_leaf.second_commitment),\n        pair_inverse: pair.pair_leaf.second_occupancy_inverse.0,\n        recipient_owner,\n        recipient_salt,\n        change_owner: raw_owned(chg.owner_key),\n        change_salt: raw_owned(chg.salt),\n    };\n    let p = RP {\n        transfer: rec.is_some(),\n        asset: asset.0,\n        next_pair_index: snapshot.next_pair_index,\n        frontier,\n        empty: empty_raw,\n    };\n    (w, p)\n}\n\n\nfn raw_owned(d: Digest) -> [u32; 8] {\n    [d[0].0, d[1].0, d[2].0, d[3].0, d[4].0, d[5].0, d[6].0, d[7].0]\n}\n\n// Extraction adapter calls shipped records; it does not reimplement the mapper.\n#[cfg(aeneas_ref)]\n#[path = \"pv_runjoin12_shipped.rs\"]\npub(super) mod pv_runjoin12_shipped;\n\n// Kani compares the shipped raw helper to this already extracted implementation.\n#[cfg(kani)]\npub(super) fn pv_runjoin12_raw_owned_check(d: Digest) -> [u32;8] {\n    raw_owned(d)\n}\n"},{"id":2,"name":{"Local":"crates/aspis-statement/src/pool_v1/pair_forest_copy_builder.rs"},"crate_name":"aspis_statement","contents":"//! The shipped honest builder of the pair-forest semantic C1 trace (LOG D68.2).\n//!\n//! Every C1 cell of the forest compilation is written by the extracted copies\n//! that the Lean theorem `builder_witness_merged` (R0Z/BuilderWitnessMerged.lean)\n//! is about:\n//!   * `aspis-r0-poseidon-copy`   (refine/poseidon)     — the permutation rounds;\n//!   * `aspis-r0-block-writer-copies` (refine/blockwriters) — block, node, sponge;\n//!   * `aspis-r0-writer-copies`   (refine/writers)      — value/occupancy aux,\n//!     path aux, the bank-merge check and copy.\n//! Their `src/lib.rs` files are the pinned extraction inputs and are used\n//! unchanged.  The glue that composes them is the Lean glue `copyCellMerged`:\n//!   * the table-driven part is `include!`d from the generated\n//!     `refine/diffharness/tests/glue_gen.rs` (gen-glue.py.txt renders the same\n//!     table as the Lean text it checks verbatim);\n//!   * the structural part between the two `---------- ... ----------` markers\n//!     below is a verbatim copy of `refine/diffharness/tests/glue.rs`, one Rust\n//!     function per Lean definition (checked by\n//!     `refine/migration/check-glue-text.py.txt`);\n//!   * `merged_banks` is the loop of glue.rs `merged_trace`, returning both\n//!     banks and the merge instead of the 29 comparison columns;\n//!   * `records` is glue.rs `records` with the public asset in place of the\n//!     test asset 77.\n//! This module only computes cells and digests.  Witness and public\n//! validation, and the error order, stay in `pair_forest_trace`.\n#![allow(clippy::all)]\n\nuse alloc::{boxed::Box, vec::Vec};\n\nuse aspis_core::field::{M31, P};\nuse aspis_r0_block_writer_copies as bw;\nuse aspis_r0_writer_copies as cp;\n\nuse crate::poseidon2::Digest;\n\nuse super::{\n    pair_forest_trace::PoolV1PairForestInputNoteWitnessV1, pair_trace::pair_empty_roots,\n    pair_tree_profile::PoolV1PairLiveSnapshotV1, payment_relation::PoolV1OutputNoteWitnessV1,\n};\n\nfn raw(d: &Digest) -> [u32; 8] {\n    core::array::from_fn(|i| d[i].0)\n}\n\n// ---------- the records (Lean RustWitness / RustPublic) ----------\n\n#[derive(Clone)]\nstruct RW {\n    input_value: u32,\n    output_value: u32,\n    change_value: u32,\n    sk: [u32; 8],\n    salt: [u32; 8],\n    bits: [u32; 24],\n    sibs: [[u32; 8]; 24],\n    pair_first: [u32; 8],\n    pair_occupied: u32,\n    pair_second: [u32; 8],\n    pair_inverse: u32,\n    recipient_owner: [u32; 8],\n    recipient_salt: [u32; 8],\n    change_owner: [u32; 8],\n    change_salt: [u32; 8],\n}\n\n#[derive(Clone)]\nstruct RP {\n    transfer: bool,\n    asset: u32,\n    next_pair_index: u64,\n    frontier: [[u32; 8]; 20],\n    empty: [[u32; 8]; 20],\n}\n\nconst ZERO8: [u32; 8] = [0; 8];\n\n// ---------- structural glue: one function per Lean definition ----------\n\nfn perm(pre: &[u32; 16], ab: &[u32; 16]) -> [[u32; 16]; 11] { aspis_r0_poseidon_copy::perm_rounds(pre, ab) }\n/// spongeStep\nfn sponge_step(pre: [u32; 16], chunk: [u32; 8], clen: usize) -> [u32; 16] {\n    let ab = bw::sponge_absorb(&chunk, clen);\n    perm(&pre, &ab)[10]\n}\n/// digest8\nfn digest8(s: [u32; 16]) -> [u32; 8] { core::array::from_fn(|i| s[i]) }\n/// blockDigestR\nfn block_digest_r(pre: [u32; 16], ab: [u32; 16]) -> [u32; 8] { digest8(perm(&pre, &ab)[10]) }\n/// spongeDigestR\nfn sponge_digest_r(pre: [u32; 16], chunk: [u32; 8], clen: usize) -> [u32; 8] {\n    block_digest_r(pre, bw::sponge_absorb(&chunk, clen))\n}\n/// nodeDigestR\nfn node_digest_r(left: [u32; 8], right: [u32; 8]) -> [u32; 8] {\n    block_digest_r(bw::node_pre(&right), bw::node_absorb(&left))\n}\n/// ownerD\nfn owner_d(w: &RW) -> [u32; 8] { sponge_digest_r(init_owner(), w.sk, 8) }\n/// noteC2R\nfn note_c2r(value: u32, asset: u32, salt: &[u32; 8]) -> [u32; 8] {\n    core::array::from_fn(|j| if j == 0 { value } else if j == 1 { asset } else { salt[j - 2] })\n}\n/// noteC3R\nfn note_c3r(salt: &[u32; 8]) -> [u32; 8] {\n    core::array::from_fn(|j| if j == 0 { salt[6] } else if j == 1 { salt[7] } else { 0 })\n}\n/// noteDigestR (chunksOf)\nfn note_digest_r(w: &RW, p: &RP, h3: usize) -> [u32; 8] { sponge_digest_r(sponge_pre(w, p, h3), schunk(w, p, h3), sclen(h3)) }\nfn input_leaf_r(w: &RW, p: &RP) -> [u32; 8] { note_digest_r(w, p, 3) }\nfn recip_dr(w: &RW, p: &RP) -> [u32; 8] { note_digest_r(w, p, 29) }\nfn change_dr(w: &RW, p: &RP) -> [u32; 8] { note_digest_r(w, p, 32) }\n/// orderedR\nfn ordered_r(cur: [u32; 8], sib: [u32; 8], b: bool) -> ([u32; 8], [u32; 8]) { if b { (sib, cur) } else { (cur, sib) } }\n/// bitB\nfn bit_b(w: &RW, l: usize) -> bool { w.bits[l] != 0 }\n/// treeCurR\nfn tree_cur_r(w: &RW, p: &RP, n: usize) -> [u32; 8] {\n    if n == 0 { input_leaf_r(w, p) } else {\n        let c = tree_cur_r(w, p, n - 1);\n        let o = ordered_r(c, w.sibs[n - 1], bit_b(w, n - 1));\n        node_digest_r(o.0, o.1)\n    }\n}\n/// outPairR\nfn out_pair_r(w: &RW, p: &RP) -> [u32; 8] {\n    if p.transfer { node_digest_r(recip_dr(w, p), change_dr(w, p)) } else { node_digest_r(change_dr(w, p), ZERO8) }\n}\n/// appBitR\nfn app_bit_r(p: &RP, n: usize) -> bool { ((p.next_pair_index >> n) & 1) != 0 }\n/// appSibR\nfn app_sib_r(p: &RP, n: usize) -> [u32; 8] { if app_bit_r(p, n) { p.frontier[n] } else { p.empty[n] } }\n/// appCurR\nfn app_cur_r(w: &RW, p: &RP, n: usize) -> [u32; 8] {\n    if n == 0 { out_pair_r(w, p) } else {\n        let c = app_cur_r(w, p, n - 1);\n        let o = ordered_r(c, app_sib_r(p, n - 1), app_bit_r(p, n - 1));\n        node_digest_r(o.0, o.1)\n    }\n}\n/// NodeKind / ZeroKind\nfn node_kind(h: usize) -> bool { (4..=24).contains(&h) || (33..=56).contains(&h) }\nfn zero_kind(p: &RP, h: usize) -> bool { !p.transfer && (27..=29).contains(&h) }\n/// RustWriterChain over rustChunks\nfn rust_writer_chain(w: &RW, p: &RP, h: usize) -> [u32; 256] {\n    if node_kind(h) {\n        let (l, r) = children(w, p, h);\n        let pre = bw::node_pre(&r);\n        let ab = bw::node_absorb(&l);\n        bw::write_block(&pre, &ab, &perm(&pre, &ab))\n    } else if zero_kind(p, h) {\n        let z = [0u32; 16];\n        bw::write_block(&z, &z, &perm(&z, &z))\n    } else {\n        let pre = sponge_pre(w, p, h);\n        let ab = bw::sponge_absorb(&schunk(w, p, h), sclen(h));\n        bw::write_block(&pre, &ab, &perm(&pre, &ab))\n    }\n}\n/// invR: x^(p-2) mod p\nfn inv_r(x: u32) -> u32 {\n    let (mut b, mut e, mut acc) = (x as u64 % P as u64, (P - 2) as u64, 1u64);\n    while e > 0 {\n        if e & 1 == 1 { acc = acc * b % P as u64; }\n        b = b * b % P as u64;\n        e >>= 1;\n    }\n    acc as u32\n}\n/// curArr / leftArr / rightArr (levelPair)\nfn path_arrays(w: &RW, p: &RP) -> ([[u32; 8]; 24], [[u32; 8]; 24], [[u32; 8]; 24]) {\n    let cur: [[u32; 8]; 24] = core::array::from_fn(|l| tree_cur_r(w, p, l));\n    let lr: [([u32; 8], [u32; 8]); 24] = core::array::from_fn(|l| ordered_r(cur[l], w.sibs[l], bit_b(w, l)));\n    (cur, core::array::from_fn(|l| lr[l].0), core::array::from_fn(|l| lr[l].1))\n}\n/// inRec / outRec\nfn in_rec(w: &RW) -> cp::OccRecord {\n    cp::OccRecord { occupied: w.pair_occupied, inverse: w.pair_inverse, commitment: w.pair_second,\n        selected: w.bits[0], has_selected: true }\n}\nfn out_rec(w: &RW, p: &RP) -> cp::OccRecord {\n    if p.transfer {\n        let c = change_dr(w, p);\n        cp::OccRecord { occupied: 1, inverse: inv_r(c[7]), commitment: c, selected: 0, has_selected: false }\n    } else {\n        cp::OccRecord { occupied: 0, inverse: 0, commitment: ZERO8, selected: 0, has_selected: false }\n    }\n}\n\n/// The components of copyCell (blockR, pathR, auxR), computed once.\nstruct Parts { blocks: Vec<[u32; 256]>, path: Box<[u32; cp::PATH_BLOCK_CELLS]>, aux: [u32; 256] }\n\nfn parts(w: &RW, p: &RP) -> Parts {\n    let blocks = (0..57).map(|h| rust_writer_chain(w, p, h)).collect();\n    let (cur, l, r) = path_arrays(w, p);\n    let path = Box::new(cp::write_path_block(w.bits, cur, l, r));\n    let aux = cp::write_aux_block([w.input_value, w.output_value, w.change_value], in_rec(w), out_rec(w, p));\n    Parts { blocks, path, aux }\n}\n/// copyCell\nfn copy_cell(pt: &Parts, c: usize, r: usize) -> u32 {\n    if c < C1_COLS {\n        if r < PATH_ROW0 { pt.blocks[r / 16][(r % 16) * 16 + c] }\n        else if r < AUX_ROW0 { pt.path[(r - PATH_ROW0) * 16 + c] }\n        else { pt.aux[(r - AUX_ROW0) * 16 + c] }\n    } else { 0 }\n}\nfn late_row(k: usize) -> bool { (544..864).contains(&(k % 1024)) }\n\n/// stableBank / lateBank / mergedR: the loop of glue.rs `merged_trace`, returning\n/// the merge-check verdict, both banks and the merged trace (column-major flat).\nfn merged_banks(w: &RW, p: &RP) -> (bool, Box<[u32; cp::TRACE_CELLS]>, Box<[u32; cp::TRACE_CELLS]>, Box<[u32; cp::TRACE_CELLS]>) {\n    let pt = parts(w, p);\n    let mut stable = Box::new([0u32; cp::TRACE_CELLS]);\n    let mut late = Box::new([0u32; cp::TRACE_CELLS]);\n    for k in 0..cp::TRACE_CELLS {\n        stable[k] = if late_row(k) { 0 } else { copy_cell(&pt, k / 1024, k % 1024) };\n        late[k] = if late_row(k) { pt.blocks[k % 1024 / 16][(k % 1024 % 16) * 16 + k / 1024] } else { 0 };\n    }\n    let ok = cp::merge_check(&stable, &late);\n    let merged = Box::new(cp::merge_copy(&stable, &late));\n    (ok, stable, late, merged)\n}\n\ninclude!(\"../../../../docs/research/v8-r0-zk-20261009/refine/diffharness/tests/glue_gen.rs\");\n\n// ---------- the Wspend⁺ → record map on the Rust side ----------\n\nfn records(input: &PoolV1PairForestInputNoteWitnessV1, out: u32, rec: Option<&PoolV1OutputNoteWitnessV1>,\n           chg: &PoolV1OutputNoteWitnessV1, snapshot: &PoolV1PairLiveSnapshotV1, asset: M31) -> (RW, RP) {\n    let pair = &input.pair;\n    let other = if pair.selected_second { pair.pair_leaf.first_commitment } else { pair.pair_leaf.second_commitment };\n    let mut bits = [0u32; 24];\n    let mut sibs = [[0u32; 8]; 24];\n    for level in 0..24 {\n        let (bit, sib) = if level == 0 {\n            (u32::from(pair.selected_second), other)\n        } else if level <= 20 {\n            (((pair.membership.index >> (level - 1)) & 1) as u32, pair.membership.siblings[level - 1])\n        } else {\n            (u32::from(input.super_root_directions[level - 21]), input.super_root_siblings[level - 21])\n        };\n        bits[level] = bit;\n        sibs[level] = raw(&sib);\n    }\n    let empty = pair_empty_roots();\n    let w = RW {\n        input_value: pair.value,\n        output_value: out,\n        change_value: chg.value,\n        sk: raw(&pair.nullifier_key),\n        salt: raw(&pair.salt),\n        bits,\n        sibs,\n        pair_first: raw(&pair.pair_leaf.first_commitment),\n        pair_occupied: pair.pair_leaf.second_occupied.0,\n        pair_second: raw(&pair.pair_leaf.second_commitment),\n        pair_inverse: pair.pair_leaf.second_occupancy_inverse.0,\n        recipient_owner: rec.map(|r| raw(&r.owner_key)).unwrap_or(ZERO8),\n        recipient_salt: rec.map(|r| raw(&r.salt)).unwrap_or(ZERO8),\n        change_owner: raw(&chg.owner_key),\n        change_salt: raw(&chg.salt),\n    };\n    let p = RP {\n        transfer: rec.is_some(),\n        asset: asset.0,\n        next_pair_index: snapshot.next_pair_index,\n        frontier: core::array::from_fn(|l| raw(&snapshot.frontier[l])),\n        empty: core::array::from_fn(|l| raw(&empty[l])),\n    };\n    (w, p)\n}\n\n// ---------- interface for the forest compiler ----------\n\nfn digest(d: [u32; 8]) -> Digest {\n    d.map(M31)\n}\n\nfn columns(flat: &[u32; cp::TRACE_CELLS]) -> [Vec<M31>; 16] {\n    core::array::from_fn(|c| flat[c * 1024..(c + 1) * 1024].iter().map(|x| M31(*x)).collect())\n}\n\n/// The Lean `RustWitness` / `RustPublic` records of one compilation.\npub(super) struct CopyRecords {\n    w: RW,\n    p: RP,\n}\n\n/// The copy-built banks: `stable`, `late` and the merged semantic C1 trace.\npub(super) struct CopyBanks {\n    pub(super) stable: [Vec<M31>; 16],\n    pub(super) late: [Vec<M31>; 16],\n    pub(super) merged: [Vec<M31>; 16],\n}\n\nimpl CopyRecords {\n    /// `recipient` is `Some` exactly for a private transfer; `out_value` is the\n    /// recipient value or the withdrawal amount.\n    pub(super) fn new(\n        input: &PoolV1PairForestInputNoteWitnessV1,\n        out_value: u32,\n        recipient: Option<&PoolV1OutputNoteWitnessV1>,\n        change: &PoolV1OutputNoteWitnessV1,\n        snapshot: &PoolV1PairLiveSnapshotV1,\n        asset: M31,\n    ) -> Self {\n        let (w, p) = records(input, out_value, recipient, change, snapshot, asset);\n        Self { w, p }\n    }\n\n    /// Block 3: the input note commitment.\n    pub(super) fn input_leaf(&self) -> Digest {\n        digest(input_leaf_r(&self.w, &self.p))\n    }\n\n    /// The path digest after `levels` node blocks (`treeCurR`): 1 is the input\n    /// pair leaf, 21 the lane root, 24 the global forest anchor.  Levels above\n    /// 21 read the super-root siblings, which the caller must have checked\n    /// canonical first.\n    pub(super) fn path_digest(&self, levels: usize) -> Digest {\n        digest(tree_cur_r(&self.w, &self.p, levels))\n    }\n\n    /// Block 26: the nullifier.\n    pub(super) fn nullifier(&self) -> Digest {\n        digest(note_digest_r(&self.w, &self.p, 26))\n    }\n\n    /// Block 29: the recipient commitment (transfer only).\n    pub(super) fn recipient(&self) -> Digest {\n        digest(recip_dr(&self.w, &self.p))\n    }\n\n    /// Block 32: the change commitment.\n    pub(super) fn change(&self) -> Digest {\n        digest(change_dr(&self.w, &self.p))\n    }\n\n    /// Block 33: the output pair.\n    pub(super) fn output_pair(&self) -> Digest {\n        digest(out_pair_r(&self.w, &self.p))\n    }\n\n    /// Block 53: the append root after the twenty live levels.\n    pub(super) fn append_root(&self) -> Digest {\n        digest(app_cur_r(&self.w, &self.p, 20))\n    }\n\n    /// The merged builder: `None` when the merge shape check fails.\n    pub(super) fn banks(&self) -> Option<CopyBanks> {\n        let (ok, stable, late, merged) = merged_banks(&self.w, &self.p);\n        if !ok {\n            return None;\n        }\n        Some(CopyBanks { stable: columns(&stable), late: columns(&late), merged: columns(&merged) })\n    }\n}\n\n/// The extracted bank merge on production banks (each 16 columns of 1024\n/// rows): `None` when `merge_check` fails, otherwise `merge_copy`.\npub(super) fn merge_banks(stable: &[Vec<M31>; 16], late: &[Vec<M31>; 16]) -> Option<[Vec<M31>; 16]> {\n    let mut s = Box::new([0u32; cp::TRACE_CELLS]);\n    let mut l = Box::new([0u32; cp::TRACE_CELLS]);\n    for c in 0..16 {\n        for r in 0..1024 {\n            s[c * 1024 + r] = stable[c][r].0;\n            l[c * 1024 + r] = late[c][r].0;\n        }\n    }\n    if !cp::merge_check(&s, &l) {\n        return None;\n    }\n    Some(columns(&cp::merge_copy(&s, &l)))\n}\n\n// Extraction-only equivalence harness; absent from normal prover/program builds.\n#[cfg(kani)]\n#[path = \"../../../../tools/r1-builder-reference/records.rs\"]\nmod records_proofs;\n\n// Owned reference only for bounded proof/extraction builds.\n#[cfg(any(kani, aeneas_ref))]\n#[path = \"../../../../tools/r1-builder-reference/records_reference.rs\"]\nmod records_reference;\n"},{"id":3,"name":{"Local":"crates/aspis-statement/src/pool_v1/mod.rs"},"crate_name":"aspis_statement","contents":"//! Pure Pool V1 formats and append-only state kernels.\n//!\n//! This module is deliberately independent of the frozen same-path\n//! `AtomicPoolStateV2` program account.  It contains no Solana account access,\n//! CPI, deposit, spend, withdrawal, or verifier dispatch.  A later program\n//! integration may wrap these byte-exact components in new Pool V1 accounts;\n//! it must not reinterpret an existing atomic-v2 account as Pool V1.\n\npub mod authorization_receipt;\npub mod authorization_receipt_account;\npub mod deposit;\npub mod format;\npub mod historical_anchor;\npub mod incremental_merkle;\npub mod nullifier_marker;\n#[cfg(not(target_os = \"solana\"))]\npub mod pair_constraint_residuals;\npub mod pair_forest_accounts;\n#[cfg(not(target_os = \"solana\"))]\npub mod pair_forest_constraint_residuals;\n#[cfg(not(target_os = \"solana\"))]\nmod pair_forest_copy_builder;\npub mod pair_forest_copy_terminal;\n#[cfg(not(target_os = \"solana\"))]\npub mod pair_forest_hiding;\n#[cfg(not(target_os = \"solana\"))]\npub mod pair_forest_semantic_oracle;\npub mod pair_forest_semantic_terminal;\npub mod pair_forest_terminal;\n#[cfg(not(target_os = \"solana\"))]\npub mod pair_forest_trace;\npub mod pair_terminal;\n#[cfg(not(target_os = \"solana\"))]\npub mod pair_trace;\n#[cfg(not(target_os = \"solana\"))]\npub mod pair_tree_hiding;\npub mod pair_tree_profile;\n#[cfg(not(target_os = \"solana\"))]\npub mod payment_constraint_residuals;\n#[cfg(not(target_os = \"solana\"))]\npub mod payment_hiding;\npub mod payment_relation;\n#[cfg(not(target_os = \"solana\"))]\npub mod payment_semantic_oracle;\n#[cfg(not(target_os = \"solana\"))]\npub mod payment_semantic_registry;\npub mod payment_semantic_terminal;\n#[cfg(not(target_os = \"solana\"))]\npub mod payment_trace;\npub mod root_history;\npub mod tag73_native_profile;\npub mod tag73_pair_forest_profile;\npub mod verifier_dispatch;\npub mod verifier_registry;\n\npub use authorization_receipt::{\n    decode_pool_v1_authorization_receipt_v1, encode_pool_v1_authorization_receipt_v1,\n    validate_pool_v1_authorization_receipt_for_settlement_v1, PoolV1AuthorizationReceiptError,\n    PoolV1AuthorizationReceiptV1, POOL_V1_AUTHORIZATION_RECEIPT_BYTES,\n    POOL_V1_AUTHORIZATION_RECEIPT_DIGEST_BYTES, POOL_V1_AUTHORIZATION_RECEIPT_DIGEST_DOMAIN,\n    POOL_V1_AUTHORIZATION_RECEIPT_HASH_SHA256, POOL_V1_AUTHORIZATION_RECEIPT_MAGIC,\n    POOL_V1_AUTHORIZATION_RECEIPT_PREFIX_BYTES, POOL_V1_AUTHORIZATION_RECEIPT_SEED,\n    POOL_V1_AUTHORIZATION_RECEIPT_STATUS_VERIFIED, POOL_V1_AUTHORIZATION_RECEIPT_VERSION,\n};\npub use authorization_receipt_account::{\n    authorize_close_pool_v1_authorization_receipt_account_v1,\n    decode_pool_v1_authorization_receipt_account_v1,\n    finalize_pool_v1_authorization_receipt_account_v1,\n    initialize_pool_v1_authorization_receipt_account_v1,\n    pool_v1_authorization_receipt_binding_digest_v1,\n    pool_v1_authorization_receipt_pda_inputs_for_binding_v1,\n    pool_v1_authorization_receipt_request_digest_v1,\n    validate_pool_v1_authorization_receipt_account_pda_inputs_v1,\n    validate_pool_v1_authorization_receipt_account_request_v1,\n    PoolV1AuthorizationReceiptAccountErrorV1, PoolV1AuthorizationReceiptAccountStatusV1,\n    PoolV1AuthorizationReceiptAccountV1, PoolV1AuthorizationReceiptCloseAuthorizationV1,\n    PoolV1AuthorizationReceiptPdaInputsV1, POOL_V1_AUTHORIZATION_RECEIPT_ACCOUNT_BYTES,\n    POOL_V1_AUTHORIZATION_RECEIPT_ACCOUNT_DIGEST_BYTES,\n    POOL_V1_AUTHORIZATION_RECEIPT_ACCOUNT_DIGEST_DOMAIN,\n    POOL_V1_AUTHORIZATION_RECEIPT_ACCOUNT_HASH_SHA256,\n    POOL_V1_AUTHORIZATION_RECEIPT_ACCOUNT_HEADER_BYTES,\n    POOL_V1_AUTHORIZATION_RECEIPT_ACCOUNT_MAGIC,\n    POOL_V1_AUTHORIZATION_RECEIPT_ACCOUNT_STATUS_PENDING,\n    POOL_V1_AUTHORIZATION_RECEIPT_ACCOUNT_STATUS_VERIFIED,\n    POOL_V1_AUTHORIZATION_RECEIPT_ACCOUNT_VERSION,\n    POOL_V1_AUTHORIZATION_RECEIPT_BINDING_DIGEST_DOMAIN,\n    POOL_V1_AUTHORIZATION_RECEIPT_REQUEST_DIGEST_DOMAIN,\n};\n\npub use deposit::{\n    decode_deposit_receipt_v1, encode_deposit_receipt_v1, validate_deposit_event_v1,\n    validate_deposit_receipt_v1, DepositEventV1, DepositReceiptV1, PoolV1DepositFormatError,\n    POOL_V1_DEPOSIT_RECEIPT_BYTES, POOL_V1_DEPOSIT_RECEIPT_MAGIC, POOL_V1_DEPOSIT_RECEIPT_VERSION,\n    POOL_V1_DEPOSIT_RETURN_MAX_BYTES, POOL_V1_ENCRYPTED_NOTE_PAYLOAD_MAX_BYTES,\n};\npub use format::{\n    decode_pool_identity_v1, decode_verifier_policy_v1, encode_pool_identity_v1,\n    encode_verifier_policy_v1, pool_v1_note_commitment, pool_v1_nullifier, pool_v1_tree_parent,\n    validate_verifier_policy_v1, PoolIdentityV1, PoolV1FormatError, VerifierPolicyV1,\n    POOL_V1_DIGEST_ENCODING_VERSION, POOL_V1_FORMAT_BINDING, POOL_V1_FORMAT_VERSION,\n    POOL_V1_IDENTITY_BYTES, POOL_V1_NOTE_COMMITMENT_VERSION, POOL_V1_NULLIFIER_FORMAT_VERSION,\n    POOL_V1_TREE_DEPTH, POOL_V1_TREE_HASH_VERSION, POOL_V1_VERIFIER_POLICY_BYTES,\n    POOL_V1_VERIFIER_POLICY_FLAGS_MASK, POOL_V1_VERIFIER_POLICY_FLAG_IMMUTABLE_DEPLOYMENT,\n    POOL_V1_VERIFIER_POLICY_FLAG_IMMUTABLE_REGISTRY, POOL_V1_VERIFIER_POLICY_MAGIC,\n    POOL_V1_VERIFIER_POLICY_VERSION,\n};\npub use historical_anchor::{\n    decode_historical_anchor_envelope_v1, encode_historical_anchor_envelope_v1,\n    validate_historical_anchor_envelope_v1, HistoricalAnchorEnvelopeV1,\n    PoolV1HistoricalAnchorFormatError, PoolV1TransitionKind,\n    POOL_V1_HISTORICAL_ANCHOR_ENVELOPE_BYTES, POOL_V1_HISTORICAL_ANCHOR_MAGIC,\n    POOL_V1_HISTORICAL_ANCHOR_VERSION,\n};\npub use incremental_merkle::{\n    pool_v1_empty_roots, AppendOneV1, AppendTwoV1, IncrementalMerkleTreeV1, PoolV1TreeError,\n    ValidatedIncrementalMerkleTreeV1, POOL_V1_LEAF_CAPACITY, POOL_V1_TREE_STATE_ACCOUNT_BYTES,\n    POOL_V1_TREE_STATE_MAGIC, POOL_V1_TREE_STATE_VERSION,\n};\npub use nullifier_marker::{\n    decode_pool_v1_nullifier_marker, encode_pool_v1_nullifier_marker,\n    validate_pool_v1_nullifier_marker, PoolV1NullifierMarkerFormatError, PoolV1NullifierMarkerV1,\n    POOL_V1_NULLIFIER_MARKER_ACCOUNT_BYTES, POOL_V1_NULLIFIER_MARKER_MAGIC,\n    POOL_V1_NULLIFIER_MARKER_SEED, POOL_V1_NULLIFIER_MARKER_VERSION,\n};\n#[cfg(not(target_os = \"solana\"))]\npub use pair_constraint_residuals::{\n    evaluate_pool_v1_pair_private_transfer_constraint_residuals_v1,\n    evaluate_pool_v1_pair_withdrawal_constraint_residuals_v1, PoolV1PairConstraintResidualErrorV1,\n    PoolV1PairConstraintResidualsV1, PoolV1PairResidualClassV1,\n    POOL_V1_PAIR_AFFINE_INTRINSIC_DEGREE, POOL_V1_PAIR_APPEND_PATH_RESIDUAL_COUNT,\n    POOL_V1_PAIR_BOOLEAN_INTRINSIC_DEGREE, POOL_V1_PAIR_CANDIDATE_FRONTIER_RESIDUAL_COUNT,\n    POOL_V1_PAIR_CANDIDATE_ROOT_RESIDUAL_COUNT, POOL_V1_PAIR_COPY_ALIAS_RESIDUAL_COUNT,\n    POOL_V1_PAIR_INDEX_SEQUENCE_RESIDUAL_COUNT, POOL_V1_PAIR_MAX_INTRINSIC_DEGREE,\n    POOL_V1_PAIR_OCCUPANCY_RESIDUAL_COUNT, POOL_V1_PAIR_PATH_ORDERING_RESIDUAL_COUNT,\n    POOL_V1_PAIR_POSEIDON_RESIDUAL_COUNT, POOL_V1_PAIR_POSEIDON_SBOX_DEGREE,\n    POOL_V1_PAIR_SELECTED_ORACLE_INDIVIDUAL_DEGREE, POOL_V1_PAIR_TRANSFER_PUBLIC_RESIDUAL_COUNT,\n    POOL_V1_PAIR_TRANSFER_SCHEDULE_RESIDUAL_COUNT, POOL_V1_PAIR_TRANSFER_TOTAL_RESIDUAL_COUNT,\n    POOL_V1_PAIR_TWO_ROUND_INTRINSIC_DEGREE, POOL_V1_PAIR_VALUE_BOOLEAN_RESIDUAL_COUNT,\n    POOL_V1_PAIR_WITHDRAWAL_PUBLIC_RESIDUAL_COUNT, POOL_V1_PAIR_WITHDRAWAL_SCHEDULE_RESIDUAL_COUNT,\n    POOL_V1_PAIR_WITHDRAWAL_TOTAL_RESIDUAL_COUNT, POOL_V1_PAIR_ZEROCHECK_INDIVIDUAL_DEGREE,\n    POOL_V1_PAIR_ZERO_PADDING_RESIDUAL_COUNT,\n};\npub use pair_forest_accounts::{\n    decode_pool_v1_pair_forest_checkpoint_v1, decode_pool_v1_pair_forest_lane_state_v1,\n    decode_pool_v1_pair_forest_master_v1, encode_pool_v1_pair_forest_checkpoint_v1,\n    encode_pool_v1_pair_forest_lane_state_v1, encode_pool_v1_pair_forest_master_v1,\n    plan_pool_v1_pair_forest_checkpoint_v1, pool_v1_pair_forest_deposit_lane_v1,\n    pool_v1_pair_forest_output_lane_v1, PoolV1PairForestAccountErrorV1,\n    PoolV1PairForestCheckpointPlanV1, PoolV1PairForestCheckpointV1, PoolV1PairForestLaneStateV1,\n    PoolV1PairForestMasterV1, POOL_V1_PAIR_FOREST_ACCOUNT_FORMAT_BINDING,\n    POOL_V1_PAIR_FOREST_ALL_LANES_MASK, POOL_V1_PAIR_FOREST_CHECKPOINT_ACCOUNT_BYTES,\n    POOL_V1_PAIR_FOREST_CHECKPOINT_MAGIC, POOL_V1_PAIR_FOREST_CHECKPOINT_VERSION,\n    POOL_V1_PAIR_FOREST_LANE_ACCOUNT_BYTES, POOL_V1_PAIR_FOREST_LANE_COUNT,\n    POOL_V1_PAIR_FOREST_LANE_HEADER_BYTES, POOL_V1_PAIR_FOREST_LANE_MAGIC,\n    POOL_V1_PAIR_FOREST_LANE_VERSION, POOL_V1_PAIR_FOREST_MASTER_ACCOUNT_BYTES,\n    POOL_V1_PAIR_FOREST_MASTER_MAGIC, POOL_V1_PAIR_FOREST_MASTER_VERSION,\n};\npub use pair_forest_copy_terminal::{\n    evaluate_pool_v1_pair_forest_copy_terminal_compiled_v1,\n    pool_v1_pair_forest_copy_active_at_point_compiled_v1,\n    pool_v1_pair_forest_copy_active_row_masks_compiled_v1,\n    pool_v1_pair_forest_copy_inactive_group_masks_compiled_v1,\n    pool_v1_pair_forest_copy_inactive_row_groups_compiled_v1,\n    pool_v1_pair_forest_copy_lane_boolean_extraction_v1, PoolV1PairForestCompiledCopyTerminalV1,\n    PoolV1PairForestCompiledVariantV1,\n    PINNED_POOL_V1_PAIR_FOREST_COPY_TERMINAL_ACTIVE_ROWS_FINGERPRINT_V1,\n    POOL_V1_PAIR_FOREST_COPY_TERMINAL_COLUMNS_V1,\n    POOL_V1_PAIR_FOREST_COPY_TERMINAL_FIXED_HEAP_ALLOCATIONS_V1,\n    POOL_V1_PAIR_FOREST_COPY_TERMINAL_FIXED_HEAP_BYTES_V1,\n    POOL_V1_PAIR_FOREST_COPY_TERMINAL_LINKS_V1, POOL_V1_PAIR_FOREST_COPY_TERMINAL_PATTERNS_V1,\n    POOL_V1_PAIR_FOREST_COPY_TERMINAL_ROWS_V1,\n    POOL_V1_PAIR_FOREST_COPY_TERMINAL_SELECTOR_HEAP_BYTES_V1,\n    POOL_V1_PAIR_FOREST_COPY_TERMINAL_TENSOR_HEAP_BYTES_V1,\n};\n#[cfg(not(target_os = \"solana\"))]\npub use pair_forest_hiding::{\n    build