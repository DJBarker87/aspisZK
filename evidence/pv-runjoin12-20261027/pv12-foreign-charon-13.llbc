"file_id":22,"beg":{"line":20,"col":0},"end":{"line":20,"col":38}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A by-value [array] iterator."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"ArrayIntoIter"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":22,"beg":{"line":21,"col":4},"end":{"line":21,"col":41}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"inner","ty":{"HashConsedValue":[2097,{"Adt":{"id":{"Adt":24},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":72,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":10,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_uninit",0]},{"Ident":["MaybeUninit",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":1590}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":24,"beg":{"line":355,"col":0},"end":{"line":355,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper type to construct uninitialized instances of `T`."},{"DocComment":""},{"DocComment":" # Initialization invariant"},{"DocComment":""},{"DocComment":" The compiler, in general, assumes that a variable is [properly initialized or \"valid\"][validity]"},{"DocComment":" according to the requirements of the variable's type. For example, a variable of"},{"DocComment":" reference type must be aligned and non-null. This is an invariant that must"},{"DocComment":" *always* be upheld, even in unsafe code. As a consequence, zero-initializing a"},{"DocComment":" variable of reference type causes instantaneous undefined behavior,"},{"DocComment":" no matter whether that reference ever gets used to access memory:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let x: &i32 = unsafe { mem::zeroed() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<&i32>`:"},{"DocComment":" let x: &i32 = unsafe { MaybeUninit::zeroed().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This is exploited by the compiler for various optimizations, such as eliding"},{"DocComment":" run-time checks and optimizing `enum` layout."},{"DocComment":""},{"DocComment":" Similarly, entirely uninitialized memory may have any content, while a `bool` must"},{"DocComment":" always be `true` or `false`. Hence, creating an uninitialized `bool` is undefined behavior:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let b: bool = unsafe { mem::uninitialized() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<bool>`:"},{"DocComment":" let b: bool = unsafe { MaybeUninit::uninit().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Moreover, uninitialized memory is special in that it does not have a fixed value (\"fixed\""},{"DocComment":" meaning \"it won't change without being written to\"). Reading the same uninitialized byte"},{"DocComment":" multiple times can give different results. This makes it undefined behavior to have"},{"DocComment":" uninitialized data in a variable even if that variable has an integer type, which otherwise can"},{"DocComment":" hold any *fixed* bit pattern:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let x: i32 = unsafe { mem::uninitialized() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<i32>`:"},{"DocComment":" let x: i32 = unsafe { MaybeUninit::uninit().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Conversely, sometimes it is okay to not initialize *all* bytes of a `MaybeUninit`"},{"DocComment":" before calling `assume_init`. For instance, padding bytes do not have to be initialized."},{"DocComment":" See the field-by-field struct initialization example below for a case of that."},{"DocComment":""},{"DocComment":" On top of that, remember that most types have additional invariants beyond merely"},{"DocComment":" being considered initialized at the type level. For example, a `1`-initialized [`Vec<T>`]"},{"DocComment":" is considered initialized (under the current implementation; this does not constitute"},{"DocComment":" a stable guarantee) because the only requirement the compiler knows about it"},{"DocComment":" is that the data pointer must be non-null. Creating such a `Vec<T>` does not cause"},{"DocComment":" *immediate* undefined behavior, but will cause undefined behavior with most"},{"DocComment":" safe operations (including dropping it)."},{"DocComment":""},{"DocComment":" [`Vec<T>`]: ../../std/vec/struct.Vec.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` serves to enable unsafe code to deal with uninitialized data."},{"DocComment":" It is a signal to the compiler indicating that the data here might *not*"},{"DocComment":" be initialized:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" // Create an explicitly uninitialized reference. The compiler knows that data inside"},{"DocComment":" // a `MaybeUninit<T>` may be invalid, and hence this is not UB:"},{"DocComment":" let mut x = MaybeUninit::<&i32>::uninit();"},{"DocComment":" // Set it to a valid value."},{"DocComment":" x.write(&0);"},{"DocComment":" // Extract the initialized data -- this is only allowed *after* properly"},{"DocComment":" // initializing `x`!"},{"DocComment":" let x = unsafe { x.assume_init() };"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The compiler then knows to not make any incorrect assumptions or optimizations on this code."},{"DocComment":""},{"DocComment":" You can think of `MaybeUninit<T>` as being a bit like `Option<T>` but without"},{"DocComment":" any of the run-time tracking and without any of the safety checks."},{"DocComment":""},{"DocComment":" ## out-pointers"},{"DocComment":""},{"DocComment":" You can use `MaybeUninit<T>` to implement \"out-pointers\": instead of returning data"},{"DocComment":" from a function, pass it a pointer to some (uninitialized) memory to put the"},{"DocComment":" result into. This can be useful when it is important for the caller to control"},{"DocComment":" how the memory the result is stored in gets allocated, and you want to avoid"},{"DocComment":" unnecessary moves."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" unsafe fn make_vec(out: *mut Vec<i32>) {"},{"DocComment":"     // `write` does not drop the old contents, which is important."},{"DocComment":"     unsafe { out.write(vec![1, 2, 3]); }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut v = MaybeUninit::uninit();"},{"DocComment":" unsafe { make_vec(v.as_mut_ptr()); }"},{"DocComment":" // Now we know `v` is initialized! This also makes sure the vector gets"},{"DocComment":" // properly dropped."},{"DocComment":" let v = unsafe { v.assume_init() };"},{"DocComment":" assert_eq!(&v, &[1, 2, 3]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Initializing an array element-by-element"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` can be used to initialize a large array element-by-element:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let data = {"},{"DocComment":"     // Create an uninitialized array of `MaybeUninit`."},{"DocComment":"     let mut data: [MaybeUninit<Vec<u32>>; 1000] = [const { MaybeUninit::uninit() }; 1000];"},{"DocComment":""},{"DocComment":"     // Dropping a `MaybeUninit` does nothing, so if there is a panic during this loop,"},{"DocComment":"     // we have a memory leak, but there is no memory safety issue."},{"DocComment":"     for elem in &mut data[..] {"},{"DocComment":"         elem.write(vec![42]);"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     // Everything is initialized. Transmute the array to the"},{"DocComment":"     // initialized type."},{"DocComment":"     unsafe { mem::transmute::<_, [Vec<u32>; 1000]>(data) }"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" assert_eq!(&data[0], &[42]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also work with partially initialized arrays, which could"},{"DocComment":" be found in low-level datastructures."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" // Create an uninitialized array of `MaybeUninit`."},{"DocComment":" let mut data: [MaybeUninit<String>; 1000] = [const { MaybeUninit::uninit() }; 1000];"},{"DocComment":" // Count the number of elements we have assigned."},{"DocComment":" let mut data_len: usize = 0;"},{"DocComment":""},{"DocComment":" for elem in &mut data[0..500] {"},{"DocComment":"     elem.write(String::from(\"hello\"));"},{"DocComment":"     data_len += 1;"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // For each item in the array, drop if we allocated it."},{"DocComment":" for elem in &mut data[0..data_len] {"},{"DocComment":"     unsafe { elem.assume_init_drop(); }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Initializing a struct field-by-field"},{"DocComment":""},{"DocComment":" You can use `MaybeUninit<T>` and the [`&raw mut`] syntax to initialize structs field by field:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" pub struct Foo {"},{"DocComment":"     name: String,"},{"DocComment":"     list: Vec<u8>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let foo = {"},{"DocComment":"     let mut uninit: MaybeUninit<Foo> = MaybeUninit::uninit();"},{"DocComment":"     let ptr = uninit.as_mut_ptr();"},{"DocComment":""},{"DocComment":"     // Initializing the `name` field"},{"DocComment":"     // Using `write` instead of assignment via `=` to not call `drop` on the"},{"DocComment":"     // old, uninitialized value."},{"DocComment":"     unsafe { (&raw mut (*ptr).name).write(\"Bob\".to_string()); }"},{"DocComment":""},{"DocComment":"     // Initializing the `list` field"},{"DocComment":"     // If there is a panic here, then the `String` in the `name` field leaks."},{"DocComment":"     unsafe { (&raw mut (*ptr).list).write(vec![0, 1, 2]); }"},{"DocComment":""},{"DocComment":"     // All the fields are initialized, so we call `assume_init` to get an initialized Foo."},{"DocComment":"     unsafe { uninit.assume_init() }"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     foo,"},{"DocComment":"     Foo {"},{"DocComment":"         name: \"Bob\".to_string(),"},{"DocComment":"         list: vec![0, 1, 2]"},{"DocComment":"     }"},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":" [`&raw mut`]: https://doc.rust-lang.org/reference/types/pointer.html#r-type.pointer.raw.constructor"},{"DocComment":" [validity]: ../../reference/behavior-considered-undefined.html#r-undefined.validity"},{"DocComment":""},{"DocComment":" Note that we have not initialized the padding, but that's fine -- it does not have to be"},{"DocComment":" initialized. In fact, even if we had initialized the padding in `uninit`, those bytes would be"},{"DocComment":" lost when copying the result: no matter the contents of the padding bytes in `uninit`, they will"},{"DocComment":" always be uninitialized in `foo`."},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` is guaranteed to have the same size, alignment, and ABI as `T`:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":" assert_eq!(size_of::<MaybeUninit<u64>>(), size_of::<u64>());"},{"DocComment":" assert_eq!(align_of::<MaybeUninit<u64>>(), align_of::<u64>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However remember that a type *containing* a `MaybeUninit<T>` is not necessarily the same"},{"DocComment":" layout; Rust does not in general guarantee that the fields of a `Foo<T>` have the same order as"},{"DocComment":" a `Foo<U>` even if `T` and `U` have the same size and alignment. Furthermore because any bit"},{"DocComment":" value is valid for a `MaybeUninit<T>` the compiler can't apply non-zero/niche-filling"},{"DocComment":" optimizations, potentially resulting in a larger size:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" # use std::mem::MaybeUninit;"},{"DocComment":" assert_eq!(size_of::<Option<bool>>(), 1);"},{"DocComment":" assert_eq!(size_of::<Option<MaybeUninit<bool>>>(), 2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If `T` is FFI-safe, then so is `MaybeUninit<T>`."},{"DocComment":""},{"DocComment":" While `MaybeUninit` is `#[repr(transparent)]` (indicating it guarantees the same size,"},{"DocComment":" alignment, and ABI as `T`), this does *not* change any of the previous caveats. `Option<T>` and"},{"DocComment":" `Option<MaybeUninit<T>>` may still have different sizes, and types containing a field of type"},{"DocComment":" `T` may be laid out (and sized) differently than if that field were `MaybeUninit<T>`."},{"DocComment":" `MaybeUninit` is a union type, and `#[repr(transparent)]` on unions is unstable (see [the"},{"DocComment":" tracking issue](https://github.com/rust-lang/rust/issues/60405)). Over time, the exact"},{"DocComment":" guarantees of `#[repr(transparent)]` on unions may evolve, and `MaybeUninit` may or may not"},{"DocComment":" remain `#[repr(transparent)]`. That said, `MaybeUninit<T>` will *always* guarantee that it has"},{"DocComment":" the same size, alignment, and ABI as `T`; it's just that the way `MaybeUninit` implements that"},{"DocComment":" guarantee may evolve."},{"DocComment":""},{"DocComment":" Note that even though `T` and `MaybeUninit<T>` are ABI compatible it is still unsound to"},{"DocComment":" transmute `&mut T` to `&mut MaybeUninit<T>` and expose that to safe code because it would allow"},{"DocComment":" safe code to access uninitialized memory:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use core::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" fn unsound_transmute<T>(val: &mut T) -> &mut MaybeUninit<T> {"},{"DocComment":"     unsafe { core::mem::transmute(val) }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let mut code = 0;"},{"DocComment":"     let code = &mut code;"},{"DocComment":"     let code2 = unsound_transmute(code);"},{"DocComment":"     *code2 = MaybeUninit::uninit();"},{"DocComment":"     std::process::exit(*code); // UB! Accessing uninitialized memory."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Validity"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` has no validity requirements – any sequence of [bytes] of"},{"DocComment":" the appropriate length, initialized or uninitialized, are a valid"},{"DocComment":" representation."},{"DocComment":""},{"DocComment":" Moving or copying a value of type `MaybeUninit<T>` (i.e., performing a"},{"DocComment":" \"typed copy\") will exactly preserve the contents, including the"},{"DocComment":" [provenance], of all non-padding bytes of type `T` in the value's"},{"DocComment":" representation."},{"DocComment":""},{"DocComment":" Therefore `MaybeUninit` can be used to perform a round trip of a value from"},{"DocComment":" type `T` to type `MaybeUninit<U>` then back to type `T`, while preserving"},{"DocComment":" the original value, if two conditions are met. One, type `U` must have the"},{"DocComment":" same size as type `T`. Two, for all byte offsets where type `U` has padding,"},{"DocComment":" the corresponding bytes in the representation of the value must be"},{"DocComment":" uninitialized."},{"DocComment":""},{"DocComment":" For example, due to the fact that the type `[u8; size_of::<T>]` has no"},{"DocComment":" padding, the following is sound for any type `T` and will return the"},{"DocComment":" original value:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" # struct T;"},{"DocComment":" fn identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         let u: MaybeUninit<[u8; size_of::<T>()]> = transmute(t);"},{"DocComment":"         transmute(u) // OK."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note: Copying a value that contains references may implicitly reborrow them"},{"DocComment":" causing the provenance of the returned value to differ from that of the"},{"DocComment":" original. This applies equally to the trivial identity function:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" fn trivial_identity<T>(t: T) -> T { t }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note: Moving or copying a value whose representation has initialized bytes"},{"DocComment":" at byte offsets where the type has padding may lose the value of those"},{"DocComment":" bytes, so while the original value will be preserved, the original"},{"DocComment":" *representation* of that value as bytes may not be. Again, this applies"},{"DocComment":" equally to `trivial_identity`."},{"DocComment":""},{"DocComment":" Note: Performing this round trip when type `U` has padding at byte offsets"},{"DocComment":" where the representation of the original value has initialized bytes may"},{"DocComment":" produce undefined behavior or a different value. For example, the following"},{"DocComment":" is unsound since `T` requires all bytes to be initialized:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" #[repr(C)] struct T([u8; 4]);"},{"DocComment":" #[repr(C)] struct U(u8, u16);"},{"DocComment":" fn unsound_identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         let u: MaybeUninit<U> = transmute(t);"},{"DocComment":"         transmute(u) // UB."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Conversely, the following is sound since `T` allows uninitialized bytes in"},{"DocComment":" the representation of a value, but the round trip may alter the value:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" #[repr(C)] struct T(MaybeUninit<[u8; 4]>);"},{"DocComment":" #[repr(C)] struct U(u8, u16);"},{"DocComment":" fn non_identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         // May lose an initialized byte."},{"DocComment":"         let u: MaybeUninit<U> = transmute(t);"},{"DocComment":"         transmute(u)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [bytes]: ../../reference/memory-model.html#bytes"},{"DocComment":" [provenance]: crate::ptr#provenance"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"maybe_uninit"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Union":[{"span":{"data":{"file_id":24,"beg":{"line":356,"col":4},"end":{"line":356,"col":14}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"uninit","ty":{"Deduplicated":1930}},{"span":{"data":{"file_id":24,"beg":{"line":357,"col":4},"end":{"line":357,"col":26}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"value","ty":{"HashConsedValue":[1962,{"Adt":{"id":{"Adt":14},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":8,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":11,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["control_flow",0]},{"Ident":["ControlFlow",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":1929},{"Deduplicated":1930}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":26,"beg":{"line":89,"col":0},"end":{"line":89,"col":31}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to tell an operation whether it should exit early or go on as usual."},{"DocComment":""},{"DocComment":" This is used when exposing things (like graph traversals or visitors) where"},{"DocComment":" you want the user to be able to choose whether to exit early."},{"DocComment":" Having the enum makes it clearer -- no more wondering \"wait, what did `false`"},{"DocComment":" mean again?\" -- and allows including a value."},{"DocComment":""},{"DocComment":" Similar to [`Option`] and [`Result`], this enum can be used with the `?` operator"},{"DocComment":" to return immediately if the [`Break`] variant is present or otherwise continue normally"},{"DocComment":" with the value inside the [`Continue`] variant."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Early-exiting from [`Iterator::try_for_each`]:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let r = (2..100).try_for_each(|x| {"},{"DocComment":"     if 403 % x == 0 {"},{"DocComment":"         return ControlFlow::Break(x)"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     ControlFlow::Continue(())"},{"DocComment":" });"},{"DocComment":" assert_eq!(r, ControlFlow::Break(13));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A basic tree traversal:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" pub struct TreeNode<T> {"},{"DocComment":"     value: T,"},{"DocComment":"     left: Option<Box<TreeNode<T>>>,"},{"DocComment":"     right: Option<Box<TreeNode<T>>>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> TreeNode<T> {"},{"DocComment":"     pub fn traverse_inorder<B>(&self, f: &mut impl FnMut(&T) -> ControlFlow<B>) -> ControlFlow<B> {"},{"DocComment":"         if let Some(left) = &self.left {"},{"DocComment":"             left.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         f(&self.value)?;"},{"DocComment":"         if let Some(right) = &self.right {"},{"DocComment":"             right.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         ControlFlow::Continue(())"},{"DocComment":"     }"},{"DocComment":"     fn leaf(value: T) -> Option<Box<TreeNode<T>>> {"},{"DocComment":"         Some(Box::new(Self { value, left: None, right: None }))"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let node = TreeNode {"},{"DocComment":"     value: 0,"},{"DocComment":"     left: TreeNode::leaf(1),"},{"DocComment":"     right: Some(Box::new(TreeNode {"},{"DocComment":"         value: -1,"},{"DocComment":"         left: TreeNode::leaf(5),"},{"DocComment":"         right: TreeNode::leaf(2),"},{"DocComment":"     }))"},{"DocComment":" };"},{"DocComment":" let mut sum = 0;"},{"DocComment":""},{"DocComment":" let res = node.traverse_inorder(&mut |val| {"},{"DocComment":"     if *val < 0 {"},{"DocComment":"         ControlFlow::Break(*val)"},{"DocComment":"     } else {"},{"DocComment":"         sum += *val;"},{"DocComment":"         ControlFlow::Continue(())"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(res, ControlFlow::Break(-1));"},{"DocComment":" assert_eq!(sum, 6);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Break`]: ControlFlow::Break"},{"DocComment":" [`Continue`]: ControlFlow::Continue"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"ControlFlow"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":26,"beg":{"line":93,"col":4},"end":{"line":93,"col":12}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Move on to the next phase of the operation as normal."}],"inline":null,"rename":null,"public":true},"name":"Continue","fields":[{"span":{"data":{"file_id":26,"beg":{"line":93,"col":13},"end":{"line":93,"col":14}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":1930}}],"discriminant":{"Scalar":{"Signed":["Isize","0"]}}},{"id":1,"span":{"data":{"file_id":26,"beg":{"line":97,"col":4},"end":{"line":97,"col":9}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Exit the operation without running subsequent phases."}],"inline":null,"rename":null,"public":true},"name":"Break","fields":[{"span":{"data":{"file_id":26,"beg":{"line":97,"col":10},"end":{"line":97,"col":11}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":1929}}],"discriminant":{"Scalar":{"Signed":["Isize","1"]}}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]},null],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":12,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["try_trait",0]},{"Ident":["NeverShortCircuitResidual",0]}],"span":{"data":{"file_id":28,"beg":{"line":430,"col":0},"end":{"line":430,"col":41}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":null,"uninhabited":true,"variant_layouts":[],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":13,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["Guard",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":["Erased"],"types":[{"Deduplicated":1590}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":16,"beg":{"line":934,"col":0},"end":{"line":934,"col":19}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":16,"beg":{"line":936,"col":4},"end":{"line":936,"col":43}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"array_mut","ty":{"HashConsedValue":[4175,{"Ref":["Erased",{"HashConsedValue":[1935,{"Slice":{"HashConsedValue":[1842,{"Adt":{"id":{"Adt":10},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"Mut"]}]}},{"span":{"data":{"file_id":16,"beg":{"line":938,"col":4},"end":{"line":938,"col":26}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"initialized","ty":{"Deduplicated":1581}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,16],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":14,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["manually_drop",0]},{"Ident":["ManuallyDrop",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":1590}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":29,"beg":{"line":161,"col":0},"end":{"line":161,"col":34}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper to inhibit the compiler from automatically calling `T`’s"},{"DocComment":" destructor. This wrapper is 0-cost."},{"DocComment":""},{"DocComment":" `ManuallyDrop<T>` is guaranteed to have the same layout and bit validity as"},{"DocComment":" `T`, and is subject to the same layout optimizations as `T`. As a"},{"DocComment":" consequence, it has *no effect* on the assumptions that the compiler makes"},{"DocComment":" about its contents. For example, initializing a `ManuallyDrop<&mut T>` with"},{"DocComment":" [`mem::zeroed`] is undefined behavior. If you need to handle uninitialized"},{"DocComment":" data, use [`MaybeUninit<T>`] instead."},{"DocComment":""},{"DocComment":" Note that accessing the value inside a `ManuallyDrop<T>` is safe. This means"},{"DocComment":" that a `ManuallyDrop<T>` whose content has been dropped must not be exposed"},{"DocComment":" through a public safe API. Correspondingly, `ManuallyDrop::drop` is unsafe."},{"DocComment":""},{"DocComment":" # `ManuallyDrop` and drop order"},{"DocComment":""},{"DocComment":" Rust has a well-defined [drop order] of values. To make sure that fields or"},{"DocComment":" locals are dropped in a specific order, reorder the declarations such that"},{"DocComment":" the implicit drop order is the correct one."},{"DocComment":""},{"DocComment":" It is possible to use `ManuallyDrop` to control the drop order, but this"},{"DocComment":" requires unsafe code and is hard to do correctly in the presence of"},{"DocComment":" unwinding."},{"DocComment":""},{"DocComment":" For example, if you want to make sure that a specific field is dropped after"},{"DocComment":" the others, make it the last field of a struct:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct Context;"},{"DocComment":""},{"DocComment":" struct Widget {"},{"DocComment":"     children: Vec<Widget>,"},{"DocComment":"     // `context` will be dropped after `children`."},{"DocComment":"     // Rust guarantees that fields are dropped in the order of declaration."},{"DocComment":"     context: Context,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Interaction with `Box`"},{"DocComment":""},{"DocComment":" Currently, if you have a `ManuallyDrop<T>`, where the type `T` is a `Box` or"},{"DocComment":" contains a `Box` inside, then dropping the `T` followed by moving the"},{"DocComment":" `ManuallyDrop<T>` is [considered to be undefined"},{"DocComment":" behavior](https://github.com/rust-lang/unsafe-code-guidelines/issues/245)."},{"DocComment":" That is, the following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" let mut x = ManuallyDrop::new(Box::new(42));"},{"DocComment":" unsafe {"},{"DocComment":"     ManuallyDrop::drop(&mut x);"},{"DocComment":" }"},{"DocComment":" let y = x; // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This is [likely to change in the"},{"DocComment":" future](https://rust-lang.github.io/rfcs/3336-maybe-dangling.html). In the"},{"DocComment":" meantime, consider using [`MaybeUninit`] instead."},{"DocComment":""},{"DocComment":" # Safety hazards when storing `ManuallyDrop` in a struct or an enum."},{"DocComment":""},{"DocComment":" Special care is needed when all of the conditions below are met:"},{"DocComment":" * A struct or enum contains a `ManuallyDrop`."},{"DocComment":" * The `ManuallyDrop` is not inside a `union`."},{"DocComment":" * The struct or enum is part of public API, or is stored in a struct or an"},{"DocComment":"   enum that is part of public API."},{"DocComment":" * There is code that drops the contents of the `ManuallyDrop` field, and"},{"DocComment":"   this code is outside the struct or enum's `Drop` implementation."},{"DocComment":""},{"DocComment":" In particular, the following hazards may occur:"},{"DocComment":""},{"DocComment":" #### Storing generic types"},{"DocComment":""},{"DocComment":" If the `ManuallyDrop` contains a client-supplied generic type, the client"},{"DocComment":" might provide a `Box` as that type. This would cause undefined behavior when"},{"DocComment":" the struct or enum is later moved, as mentioned in the previous section. For"},{"DocComment":" example, the following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" pub struct BadOption<T> {"},{"DocComment":"     // Invariant: Has been dropped if `is_some` is false."},{"DocComment":"     value: ManuallyDrop<T>,"},{"DocComment":"     is_some: bool,"},{"DocComment":" }"},{"DocComment":" impl<T> BadOption<T> {"},{"DocComment":"     pub fn new(value: T) -> Self {"},{"DocComment":"         Self { value: ManuallyDrop::new(value), is_some: true }"},{"DocComment":"     }"},{"DocComment":"     pub fn change_to_none(&mut self) {"},{"DocComment":"         if self.is_some {"},{"DocComment":"             self.is_some = false;"},{"DocComment":"             unsafe {"},{"DocComment":"                 // SAFETY: `value` hasn't been dropped yet, as per the invariant"},{"DocComment":"                 // (This is actually unsound!)"},{"DocComment":"                 ManuallyDrop::drop(&mut self.value);"},{"DocComment":"             }"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let mut option = BadOption::new(Box::new(42));"},{"DocComment":" option.change_to_none();"},{"DocComment":" let option2 = option; // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" #### Deriving traits"},{"DocComment":""},{"DocComment":" Deriving `Debug`, `Clone`, `PartialEq`, `PartialOrd`, `Ord`, or `Hash` on"},{"DocComment":" the struct or enum could be unsound, since the derived implementations of"},{"DocComment":" these traits would access the `ManuallyDrop` field. For example, the"},{"DocComment":" following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" // This derive is unsound in combination with the `ManuallyDrop::drop` call."},{"DocComment":" #[derive(Debug)]"},{"DocComment":" pub struct Foo {"},{"DocComment":"     value: ManuallyDrop<String>,"},{"DocComment":" }"},{"DocComment":" impl Foo {"},{"DocComment":"     pub fn new() -> Self {"},{"DocComment":"         let mut temp = Self {"},{"DocComment":"             value: ManuallyDrop::new(String::from(\"Unsafe rust is hard.\"))"},{"DocComment":"         };"},{"DocComment":"         unsafe {"},{"DocComment":"             // SAFETY: `value` hasn't been dropped yet."},{"DocComment":"             ManuallyDrop::drop(&mut temp.value);"},{"DocComment":"         }"},{"DocComment":"         temp"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let foo = Foo::new();"},{"DocComment":" println!(\"{:?}\", foo); // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [drop order]: https://doc.rust-lang.org/reference/destructors.html"},{"DocComment":" [`mem::zeroed`]: crate::mem::zeroed"},{"DocComment":" [`MaybeUninit<T>`]: crate::mem::MaybeUninit"},{"DocComment":" [`MaybeUninit`]: crate::mem::MaybeUninit"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"manually_drop"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":29,"beg":{"line":162,"col":4},"end":{"line":162,"col":27}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"value","ty":{"HashConsedValue":[1968,{"Adt":{"id":{"Adt":15},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":8,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":15,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_dangling",0]},{"Ident":["MaybeDangling",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":1590}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":30,"beg":{"line":74,"col":0},"end":{"line":74,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Allows wrapped [references] and [boxes] to dangle."},{"DocComment":""},{"DocComment":" That is, if a reference (or a `Box`) is wrapped in `MaybeDangling` (including when in a"},{"DocComment":" (nested) field of a compound type wrapped in `MaybeDangling`), it does not have to follow"},{"DocComment":" pointer aliasing rules or be dereferenceable."},{"DocComment":""},{"DocComment":" This can be useful when the value can become dangling while the function holding it is still"},{"DocComment":" executing (particularly in concurrent code). As a somewhat absurd example, consider this code:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" #![feature(box_as_ptr)]"},{"DocComment":" # use std::alloc::{dealloc, Layout};"},{"DocComment":" # use std::mem;"},{"DocComment":""},{"DocComment":" let mut boxed = Box::new(0_u32);"},{"DocComment":" let ptr = Box::as_mut_ptr(&mut boxed);"},{"DocComment":""},{"DocComment":" // Safety: the pointer comes from a box and thus was allocated before; `box` is not used afterwards"},{"DocComment":" unsafe { dealloc(ptr.cast(), Layout::new::<u32>()) };"},{"DocComment":""},{"DocComment":" mem::forget(boxed); // <-- this is UB!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Even though the `Box`'s destructor is not run (and thus we don't have a double free bug), this"},{"DocComment":" code is still UB. This is because when moving `boxed` into `forget`, its validity invariants"},{"DocComment":" are asserted, causing UB since the `Box` is dangling. The safety comment is as such wrong, as"},{"DocComment":" moving the `boxed` variable as part of the `forget` call *is* a use."},{"DocComment":""},{"DocComment":" To fix this we could use `MaybeDangling`:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" #![feature(maybe_dangling, box_as_ptr)]"},{"DocComment":" # use std::alloc::{dealloc, Layout};"},{"DocComment":" # use std::mem::{self, MaybeDangling};"},{"DocComment":""},{"DocComment":" let mut boxed = MaybeDangling::new(Box::new(0_u32));"},{"DocComment":" let ptr = Box::as_mut_ptr(boxed.as_mut());"},{"DocComment":""},{"DocComment":" // Safety: the pointer comes from a box and thus was allocated before; `box` is not used afterwards"},{"DocComment":" unsafe { dealloc(ptr.cast(), Layout::new::<u32>()) };"},{"DocComment":""},{"DocComment":" mem::forget(boxed); // <-- this is OK!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that the bit pattern must still be valid for the wrapped type. That is, [references]"},{"DocComment":" (and [boxes]) still must be aligned and non-null."},{"DocComment":""},{"DocComment":" Additionally note that safe code can still assume that the inner value in a `MaybeDangling` is"},{"DocComment":" **not** dangling -- functions like [`as_ref`] and [`into_inner`] are safe. It is not sound to"},{"DocComment":" return a dangling reference in a `MaybeDangling` to safe code. However, it *is* sound"},{"DocComment":" to hold such values internally inside your code -- and there's no way to do that without"},{"DocComment":" this type. Note that other types can use this type and thus get the same effect; in particular,"},{"DocComment":" [`ManuallyDrop`] will use `MaybeDangling`."},{"DocComment":""},{"DocComment":" Note that `MaybeDangling` doesn't prevent drops from being run, which can lead to UB if the"},{"DocComment":" drop observes a dangling value. If you need to prevent drops from being run use [`ManuallyDrop`]"},{"DocComment":" instead."},{"DocComment":""},{"DocComment":" [references]: prim@reference"},{"DocComment":" [boxes]: ../../std/boxed/struct.Box.html"},{"DocComment":" [`into_inner`]: MaybeDangling::into_inner"},{"DocComment":" [`as_ref`]: MaybeDangling::as_ref"},{"DocComment":" [`ManuallyDrop`]: crate::mem::ManuallyDrop"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"maybe_dangling"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":30,"beg":{"line":74,"col":36},"end":{"line":74,"col":37}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":null,"ty":{"Deduplicated":1590}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":8,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":16,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["non_null",0]},{"Ident":["NonNull",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":1607}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":34,"beg":{"line":74,"col":0},"end":{"line":74,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `*mut T` but non-zero and [covariant]."},{"DocComment":""},{"DocComment":" This is often the correct thing to use when building data structures using"},{"DocComment":" raw pointers, but is ultimately more dangerous to use because of its additional"},{"DocComment":" properties. If you're not sure if you should use `NonNull<T>`, just use `*mut T`!"},{"DocComment":""},{"DocComment":" Unlike `*mut T`, the pointer must always be non-null, even if the pointer"},{"DocComment":" is never dereferenced. This is so that enums may use this forbidden value"},{"DocComment":" as a discriminant -- `Option<NonNull<T>>` has the same size as `*mut T`."},{"DocComment":" However the pointer may still dangle if it isn't dereferenced."},{"DocComment":""},{"DocComment":" Unlike `*mut T`, `NonNull<T>` is covariant over `T`. This is usually the correct"},{"DocComment":" choice for most data structures and safe abstractions, such as `Box`, `Rc`, `Arc`, `Vec`,"},{"DocComment":" and `LinkedList`."},{"DocComment":""},{"DocComment":" In rare cases, if your type exposes a way to mutate the value of `T` through a `NonNull<T>`,"},{"DocComment":" and you need to prevent unsoundness from variance (for example, if `T` could be a reference"},{"DocComment":" with a shorter lifetime), you should add a field to make your type invariant, such as"},{"DocComment":" `PhantomData<Cell<T>>` or `PhantomData<&'a mut T>`."},{"DocComment":""},{"DocComment":" Example of a type that must be invariant:"},{"DocComment":" ```rust"},{"DocComment":" use std::cell::Cell;"},{"DocComment":" use std::marker::PhantomData;"},{"DocComment":" struct Invariant<T> {"},{"DocComment":"     ptr: std::ptr::NonNull<T>,"},{"DocComment":"     _invariant: PhantomData<Cell<T>>,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Notice that `NonNull<T>` has a `From` instance for `&T`. However, this does"},{"DocComment":" not change the fact that mutating through a (pointer derived from a) shared"},{"DocComment":" reference is undefined behavior unless the mutation happens inside an"},{"DocComment":" [`UnsafeCell<T>`]. The same goes for creating a mutable reference from a shared"},{"DocComment":" reference. When using this `From` instance without an `UnsafeCell<T>`,"},{"DocComment":" it is your responsibility to ensure that `as_mut` is never called, and `as_ptr`"},{"DocComment":" is never used for mutation."},{"DocComment":""},{"DocComment":" # Representation"},{"DocComment":""},{"DocComment":" Thanks to the [null pointer optimization],"},{"DocComment":" `NonNull<T>` and `Option<NonNull<T>>`"},{"DocComment":" are guaranteed to have the same size and alignment:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ptr::NonNull;"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<NonNull<i16>>(), size_of::<Option<NonNull<i16>>>());"},{"DocComment":" assert_eq!(align_of::<NonNull<i16>>(), align_of::<Option<NonNull<i16>>>());"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<NonNull<str>>(), size_of::<Option<NonNull<str>>>());"},{"DocComment":" assert_eq!(align_of::<NonNull<str>>(), align_of::<Option<NonNull<str>>>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [covariant]: https://doc.rust-lang.org/reference/subtyping.html"},{"DocComment":" [`PhantomData`]: crate::marker::PhantomData"},{"DocComment":" [`UnsafeCell<T>`]: crate::cell::UnsafeCell"},{"DocComment":" [null pointer optimization]: crate::option#representation"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"NonNull"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":34,"beg":{"line":75,"col":4},"end":{"line":75,"col":52}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"pointer","ty":{"HashConsedValue":[4927,{"Pattern":[{"HashConsedValue":[1623,{"RawPtr":[{"Deduplicated":1607},"Shared"]}]},"NotNull"]}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":16,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":17,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["option",0]},{"Ident":["Option",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":2050}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":6,"beg":{"line":597,"col":0},"end":{"line":597,"col":18}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The `Option` type. See [the module level documentation](self) for more."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"Option"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":6,"beg":{"line":601,"col":4},"end":{"line":601,"col":8}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" No value."}],"inline":null,"rename":null,"public":true},"name":"None","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","0"]}}},{"id":1,"span":{"data":{"file_id":6,"beg":{"line":605,"col":4},"end":{"line":605,"col":8}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Some value of type `T`."}],"inline":null,"rename":null,"public":true},"name":"Some","fields":[{"span":{"data":{"file_id":6,"beg":{"line":605,"col":55},"end":{"line":605,"col":56}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":2050}}],"discriminant":{"Scalar":{"Signed":["Isize","1"]}}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]},null],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":18,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["Infallible",0]}],"span":{"data":{"file_id":36,"beg":{"line":930,"col":0},"end":{"line":930,"col":19}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The error type for errors that can never happen."},{"DocComment":""},{"DocComment":" Since this enum has no variant, a value of this type can never actually exist."},{"DocComment":" This can be useful for generic APIs that use [`Result`] and parameterize the error type,"},{"DocComment":" to indicate that the result is always [`Ok`]."},{"DocComment":""},{"DocComment":" For example, the [`TryFrom`] trait (conversion that returns a [`Result`])"},{"DocComment":" has a blanket implementation for all types where a reverse [`Into`] implementation exists."},{"DocComment":""},{"DocComment":" ```ignore (illustrates std code, duplicating the impl in a doctest would be an error)"},{"DocComment":" impl<T, U> TryFrom<U> for T where U: Into<T> {"},{"DocComment":"     type Error = Infallible;"},{"DocComment":""},{"DocComment":"     fn try_from(value: U) -> Result<Self, Infallible> {"},{"DocComment":"         Ok(U::into(value))  // Never returns `Err`"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Future compatibility"},{"DocComment":""},{"DocComment":" This enum has the same role as [the `!` “never” type][never],"},{"DocComment":" which is unstable in this version of Rust."},{"DocComment":" When `!` is stabilized, we plan to make `Infallible` a type alias to it:"},{"DocComment":""},{"DocComment":" ```ignore (illustrates future std change)"},{"DocComment":" pub type Infallible = !;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" … and eventually deprecate `Infallible`."},{"DocComment":""},{"DocComment":" However there is one case where `!` syntax can be used"},{"DocComment":" before `!` is stabilized as a full-fledged type: in the position of a function’s return type."},{"DocComment":" Specifically, it is possible to have implementations for two different function pointer types:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" trait MyTrait {}"},{"DocComment":" impl MyTrait for fn() -> ! {}"},{"DocComment":" impl MyTrait for fn() -> std::convert::Infallible {}"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" With `Infallible` being an enum, this code is valid."},{"DocComment":" However when `Infallible` becomes an alias for the never type,"},{"DocComment":" the two `impl`s will start to overlap"},{"DocComment":" and therefore will be disallowed by the language’s trait coherence rules."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":null,"uninhabited":true,"variant_layouts":[],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":19,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["non_null",0]},{"Ident":["NonNull",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":1534}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":34,"beg":{"line":74,"col":0},"end":{"line":74,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `*mut T` but non-zero and [covariant]."},{"DocComment":""},{"DocComment":" This is often the correct thing to use when building data structures using"},{"DocComment":" raw pointers, but is ultimately more dangerous to use because of its additional"},{"DocComment":" properties. If you're not sure if you should use `NonNull<T>`, just use `*mut T`!"},{"DocComment":""},{"DocComment":" Unlike `*mut T`, the pointer must always be non-null, even if the pointer"},{"DocComment":" is never dereferenced. This is so that enums may use this forbidden value"},{"DocComment":" as a discriminant -- `Option<NonNull<T>>` has the same size as `*mut T`."},{"DocComment":" However the pointer may still dangle if it isn't dereferenced."},{"DocComment":""},{"DocComment":" Unlike `*mut T`, `NonNull<T>` is covariant over `T`. This is usually the correct"},{"DocComment":" choice for most data structures and safe abstractions, such as `Box`, `Rc`, `Arc`, `Vec`,"},{"DocComment":" and `LinkedList`."},{"DocComment":""},{"DocComment":" In rare cases, if your type exposes a way to mutate the value of `T` through a `NonNull<T>`,"},{"DocComment":" and you need to prevent unsoundness from variance (for example, if `T` could be a reference"},{"DocComment":" with a shorter lifetime), you should add a field to make your type invariant, such as"},{"DocComment":" `PhantomData<Cell<T>>` or `PhantomData<&'a mut T>`."},{"DocComment":""},{"DocComment":" Example of a type that must be invariant:"},{"DocComment":" ```rust"},{"DocComment":" use std::cell::Cell;"},{"DocComment":" use std::marker::PhantomData;"},{"DocComment":" struct Invariant<T> {"},{"DocComment":"     ptr: std::ptr::NonNull<T>,"},{"DocComment":"     _invariant: PhantomData<Cell<T>>,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Notice that `NonNull<T>` has a `From` instance for `&T`. However, this does"},{"DocComment":" not change the fact that mutating through a (pointer derived from a) shared"},{"DocComment":" reference is undefined behavior unless the mutation happens inside an"},{"DocComment":" [`UnsafeCell<T>`]. The same goes for creating a mutable reference from a shared"},{"DocComment":" reference. When using this `From` instance without an `UnsafeCell<T>`,"},{"DocComment":" it is your responsibility to ensure that `as_mut` is never called, and `as_ptr`"},{"DocComment":" is never used for mutation."},{"DocComment":""},{"DocComment":" # Representation"},{"DocComment":""},{"DocComment":" Thanks to the [null pointer optimization],"},{"DocComment":" `NonNull<T>` and `Option<NonNull<T>>`"},{"DocComment":" are guaranteed to have the same size and alignment:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ptr::NonNull;"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<NonNull<i16>>(), size_of::<Option<NonNull<i16>>>());"},{"DocComment":" assert_eq!(align_of::<NonNull<i16>>(), align_of::<Option<NonNull<i16>>>());"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<NonNull<str>>(), size_of::<Option<NonNull<str>>>());"},{"DocComment":" assert_eq!(align_of::<NonNull<str>>(), align_of::<Option<NonNull<str>>>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [covariant]: https://doc.rust-lang.org/reference/subtyping.html"},{"DocComment":" [`PhantomData`]: crate::marker::PhantomData"},{"DocComment":" [`UnsafeCell<T>`]: crate::cell::UnsafeCell"},{"DocComment":" [null pointer optimization]: crate::option#representation"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"NonNull"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":34,"beg":{"line":75,"col":4},"end":{"line":75,"col":52}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"pointer","ty":{"HashConsedValue":[4928,{"Pattern":[{"HashConsedValue":[1621,{"RawPtr":[{"Deduplicated":1534},"Shared"]}]},"NotNull"]}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":8,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":20,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["non_null",0]},{"Ident":["NonNull",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":1633}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":34,"beg":{"line":74,"col":0},"end":{"line":74,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `*mut T` but non-zero and [covariant]."},{"DocComment":""},{"DocComment":" This is often the correct thing to use when building data structures using"},{"DocComment":" raw pointers, but is ultimately more dangerous to use because of its additional"},{"DocComment":" properties. If you're not sure if you should use `NonNull<T>`, just use `*mut T`!"},{"DocComment":""},{"DocComment":" Unlike `*mut T`, the pointer must always be non-null, even if the pointer"},{"DocComment":" is never dereferenced. This is so that enums may use this forbidden value"},{"DocComment":" as a discriminant -- `Option<NonNull<T>>` has the same size as `*mut T`."},{"DocComment":" However the pointer may still dangle if it isn't dereferenced."},{"DocComment":""},{"DocComment":" Unlike `*mut T`, `NonNull<T>` is covariant over `T`. This is usually the correct"},{"DocComment":" choice for most data structures and safe abstractions, such as `Box`, `Rc`, `Arc`, `Vec`,"},{"DocComment":" and `LinkedList`."},{"DocComment":""},{"DocComment":" In rare cases, if your type exposes a way to mutate the value of `T` through a `NonNull<T>`,"},{"DocComment":" and you need to prevent unsoundness from variance (for example, if `T` could be a reference"},{"DocComment":" with a shorter lifetime), you should add a field to make your type invariant, such as"},{"DocComment":" `PhantomData<Cell<T>>` or `PhantomData<&'a mut T>`."},{"DocComment":""},{"DocComment":" Example of a type that must be invariant:"},{"DocComment":" ```rust"},{"DocComment":" use std::cell::Cell;"},{"DocComment":" use std::marker::PhantomData;"},{"DocComment":" struct Invariant<T> {"},{"DocComment":"     ptr: std::ptr::NonNull<T>,"},{"DocComment":"     _invariant: PhantomData<Cell<T>>,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Notice that `NonNull<T>` has a `From` instance for `&T`. However, this does"},{"DocComment":" not change the fact that mutating through a (pointer derived from a) shared"},{"DocComment":" reference is undefined behavior unless the mutation happens inside an"},{"DocComment":" [`UnsafeCell<T>`]. The same goes for creating a mutable reference from a shared"},{"DocComment":" reference. When using this `From` instance without an `UnsafeCell<T>`,"},{"DocComment":" it is your responsibility to ensure that `as_mut` is never called, and `as_ptr`"},{"DocComment":" is never used for mutation."},{"DocComment":""},{"DocComment":" # Representation"},{"DocComment":""},{"DocComment":" Thanks to the [null pointer optimization],"},{"DocComment":" `NonNull<T>` and `Option<NonNull<T>>`"},{"DocComment":" are guaranteed to have the same size and alignment:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ptr::NonNull;"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<NonNull<i16>>(), size_of::<Option<NonNull<i16>>>());"},{"DocComment":" assert_eq!(align_of::<NonNull<i16>>(), align_of::<Option<NonNull<i16>>>());"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<NonNull<str>>(), size_of::<Option<NonNull<str>>>());"},{"DocComment":" assert_eq!(align_of::<NonNull<str>>(), align_of::<Option<NonNull<str>>>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [covariant]: https://doc.rust-lang.org/reference/subtyping.html"},{"DocComment":" [`PhantomData`]: crate::marker::PhantomData"},{"DocComment":" [`UnsafeCell<T>`]: crate::cell::UnsafeCell"},{"DocComment":" [null pointer optimization]: crate::option#representation"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"NonNull"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":34,"beg":{"line":75,"col":4},"end":{"line":75,"col":52}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"pointer","ty":{"HashConsedValue":[4929,{"Pattern":[{"HashConsedValue":[2072,{"RawPtr":[{"Deduplicated":1633},"Shared"]}]},"NotNull"]}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":16,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":21,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["non_null",0]},{"Ident":["NonNull",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":1632}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":34,"beg":{"line":74,"col":0},"end":{"line":74,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `*mut T` but non-zero and [covariant]."},{"DocComment":""},{"DocComment":" This is often the correct thing to use when building data structures using"},{"DocComment":" raw pointers, but is ultimately more dangerous to use because of its additional"},{"DocComment":" properties. If you're not sure if you should use `NonNull<T>`, just use `*mut T`!"},{"DocComment":""},{"DocComment":" Unlike `*mut T`, the pointer must always be non-null, even if the pointer"},{"DocComment":" is never dereferenced. This is so that enums may use this forbidden value"},{"DocComment":" as a discriminant -- `Option<NonNull<T>>` has the same size as `*mut T`."},{"DocComment":" However the pointer may still dangle if it isn't dereferenced."},{"DocComment":""},{"DocComment":" Unlike `*mut T`, `NonNull<T>` is covariant over `T`. This is usually the correct"},{"DocComment":" choice for most data structures and safe abstractions, such as `Box`, `Rc`, `Arc`, `Vec`,"},{"DocComment":" and `LinkedList`."},{"DocComment":""},{"DocComment":" In rare cases, if your type exposes a way to mutate the value of `T` through a `NonNull<T>`,"},{"DocComment":" and you need to prevent unsoundness from variance (for example, if `T` could be a reference"},{"DocComment":" with a shorter lifetime), you should add a field to make your type invariant, such as"},{"DocComment":" `PhantomData<Cell<T>>` or `PhantomData<&'a mut T>`."},{"DocComment":""},{"DocComment":" Example of a type that must be invariant:"},{"DocComment":" ```rust"},{"DocComment":" use std::cell::Cell;"},{"DocComment":" use std::marker::PhantomData;"},{"DocComment":" struct Invariant<T> {"},{"DocComment":"     ptr: std::ptr::NonNull<T>,"},{"DocComment":"     _invariant: PhantomData<Cell<T>>,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Notice that `NonNull<T>` has a `From` instance for `&T`. However, this does"},{"DocComment":" not change the fact that mutating through a (pointer derived from a) shared"},{"DocComment":" reference is undefined behavior unless the mutation happens inside an"},{"DocComment":" [`UnsafeCell<T>`]. The same goes for creating a mutable reference from a shared"},{"DocComment":" reference. When using this `From` instance without an `UnsafeCell<T>`,"},{"DocComment":" it is your responsibility to ensure that `as_mut` is never called, and `as_ptr`"},{"DocComment":" is never used for mutation."},{"DocComment":""},{"DocComment":" # Representation"},{"DocComment":""},{"DocComment":" Thanks to the [null pointer optimization],"},{"DocComment":" `NonNull<T>` and `Option<NonNull<T>>`"},{"DocComment":" are guaranteed to have the same size and alignment:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ptr::NonNull;"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<NonNull<i16>>(), size_of::<Option<NonNull<i16>>>());"},{"DocComment":" assert_eq!(align_of::<NonNull<i16>>(), align_of::<Option<NonNull<i16>>>());"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<NonNull<str>>(), size_of::<Option<NonNull<str>>>());"},{"DocComment":" assert_eq!(align_of::<NonNull<str>>(), align_of::<Option<NonNull<str>>>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [covariant]: https://doc.rust-lang.org/reference/subtyping.html"},{"DocComment":" [`PhantomData`]: crate::marker::PhantomData"},{"DocComment":" [`UnsafeCell<T>`]: crate::cell::UnsafeCell"},{"DocComment":" [null pointer optimization]: crate::option#representation"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"NonNull"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":34,"beg":{"line":75,"col":4},"end":{"line":75,"col":52}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"pointer","ty":{"HashConsedValue":[4930,{"Pattern":[{"HashConsedValue":[2081,{"RawPtr":[{"Deduplicated":1632},"Shared"]}]},"NotNull"]}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":8,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":22,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_uninit",0]},{"Ident":["MaybeUninit",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":1382}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":24,"beg":{"line":355,"col":0},"end":{"line":355,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper type to construct uninitialized instances of `T`."},{"DocComment":""},{"DocComment":" # Initialization invariant"},{"DocComment":""},{"DocComment":" The compiler, in general, assumes that a variable is [properly initialized or \"valid\"][validity]"},{"DocComment":" according to the requirements of the variable's type. For example, a variable of"},{"DocComment":" reference type must be aligned and non-null. This is an invariant that must"},{"DocComment":" *always* be upheld, even in unsafe code. As a consequence, zero-initializing a"},{"DocComment":" variable of reference type causes instantaneous undefined behavior,"},{"DocComment":" no matter whether that reference ever gets used to access memory:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let x: &i32 = unsafe { mem::zeroed() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<&i32>`:"},{"DocComment":" let x: &i32 = unsafe { MaybeUninit::zeroed().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This is exploited by the compiler for various optimizations, such as eliding"},{"DocComment":" run-time checks and optimizing `enum` layout."},{"DocComment":""},{"DocComment":" Similarly, entirely uninitialized memory may have any content, while a `bool` must"},{"DocComment":" always be `true` or `false`. Hence, creating an uninitialized `bool` is undefined behavior:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let b: bool = unsafe { mem::uninitialized() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<bool>`:"},{"DocComment":" let b: bool = unsafe { MaybeUninit::uninit().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Moreover, uninitialized memory is special in that it does not have a fixed value (\"fixed\""},{"DocComment":" meaning \"it won't change without being written to\"). Reading the same uninitialized byte"},{"DocComment":" multiple times can give different results. This makes it undefined behavior to have"},{"DocComment":" uninitialized data in a variable even if that variable has an integer type, which otherwise can"},{"DocComment":" hold any *fixed* bit pattern:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let x: i32 = unsafe { mem::uninitialized() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<i32>`:"},{"DocComment":" let x: i32 = unsafe { MaybeUninit::uninit().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Conversely, sometimes it is okay to not initialize *all* bytes of a `MaybeUninit`"},{"DocComment":" before calling `assume_init`. For instance, padding bytes do not have to be initialized."},{"DocComment":" See the field-by-field struct initialization example below for a case of that."},{"DocComment":""},{"DocComment":" On top of that, remember that most types have additional invariants beyond merely"},{"DocComment":" being considered initialized at the type level. For example, a `1`-initialized [`Vec<T>`]"},{"DocComment":" is considered initialized (under the current implementation; this does not constitute"},{"DocComment":" a stable guarantee) because the only requirement the compiler knows about it"},{"DocComment":" is that the data pointer must be non-null. Creating such a `Vec<T>` does not cause"},{"DocComment":" *immediate* undefined behavior, but will cause undefined behavior with most"},{"DocComment":" safe operations (including dropping it)."},{"DocComment":""},{"DocComment":" [`Vec<T>`]: ../../std/vec/struct.Vec.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` serves to enable unsafe code to deal with uninitialized data."},{"DocComment":" It is a signal to the compiler indicating that the data here might *not*"},{"DocComment":" be initialized:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" // Create an explicitly uninitialized reference. The compiler knows that data inside"},{"DocComment":" // a `MaybeUninit<T>` may be invalid, and hence this is not UB:"},{"DocComment":" let mut x = MaybeUninit::<&i32>::uninit();"},{"DocComment":" // Set it to a valid value."},{"DocComment":" x.write(&0);"},{"DocComment":" // Extract the initialized data -- this is only allowed *after* properly"},{"DocComment":" // initializing `x`!"},{"DocComment":" let x = unsafe { x.assume_init() };"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The compiler then knows to not make any incorrect assumptions or optimizations on this code."},{"DocComment":""},{"DocComment":" You can think of `MaybeUninit<T>` as being a bit like `Option<T>` but without"},{"DocComment":" any of the run-time tracking and without any of the safety checks."},{"DocComment":""},{"DocComment":" ## out-pointers"},{"DocComment":""},{"DocComment":" You can use `MaybeUninit<T>` to implement \"out-pointers\": instead of returning data"},{"DocComment":" from a function, pass it a pointer to some (uninitialized) memory to put the"},{"DocComment":" result into. This can be useful when it is important for the caller to control"},{"DocComment":" how the memory the result is stored in gets allocated, and you want to avoid"},{"DocComment":" unnecessary moves."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" unsafe fn make_vec(out: *mut Vec<i32>) {"},{"DocComment":"     // `write` does not drop the old contents, which is important."},{"DocComment":"     unsafe { out.write(vec![1, 2, 3]); }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut v = MaybeUninit::uninit();"},{"DocComment":" unsafe { make_vec(v.as_mut_ptr()); }"},{"DocComment":" // Now we know `v` is initialized! This also makes sure the vector gets"},{"DocComment":" // properly dropped."},{"DocComment":" let v = unsafe { v.assume_init() };"},{"DocComment":" assert_eq!(&v, &[1, 2, 3]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Initializing an array element-by-element"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` can be used to initialize a large array element-by-element:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let data = {"},{"DocComment":"     // Create an uninitialized array of `MaybeUninit`."},{"DocComment":"     let mut data: [MaybeUninit<Vec<u32>>; 1000] = [const { MaybeUninit::uninit() }; 1000];"},{"DocComment":""},{"DocComment":"     // Dropping a `MaybeUninit` does nothing, so if there is a panic during this loop,"},{"DocComment":"     // we have a memory leak, but there is no memory safety issue."},{"DocComment":"     for elem in &mut data[..] {"},{"DocComment":"         elem.write(vec![42]);"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     // Everything is initialized. Transmute the array to the"},{"DocComment":"     // initialized type."},{"DocComment":"     unsafe { mem::transmute::<_, [Vec<u32>; 1000]>(data) }"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" assert_eq!(&data[0], &[42]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also work with partially initialized arrays, which could"},{"DocComment":" be found in low-level datastructures."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" // Create an uninitialized array of `MaybeUninit`."},{"DocComment":" let mut data: [MaybeUninit<String>; 1000] = [const { MaybeUninit::uninit() }; 1000];"},{"DocComment":" // Count the number of elements we have assigned."},{"DocComment":" let mut data_len: usize = 0;"},{"DocComment":""},{"DocComment":" for elem in &mut data[0..500] {"},{"DocComment":"     elem.write(String::from(\"hello\"));"},{"DocComment":"     data_len += 1;"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // For each item in the array, drop if we allocated it."},{"DocComment":" for elem in &mut data[0..data_len] {"},{"DocComment":"     unsafe { elem.assume_init_drop(); }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Initializing a struct field-by-field"},{"DocComment":""},{"DocComment":" You can use `MaybeUninit<T>` and the [`&raw mut`] syntax to initialize structs field by field:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" pub struct Foo {"},{"DocComment":"     name: String,"},{"DocComment":"     list: Vec<u8>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let foo = {"},{"DocComment":"     let mut uninit: MaybeUninit<Foo> = MaybeUninit::uninit();"},{"DocComment":"     let ptr = uninit.as_mut_ptr();"},{"DocComment":""},{"DocComment":"     // Initializing the `name` field"},{"DocComment":"     // Using `write` instead of assignment via `=` to not call `drop` on the"},{"DocComment":"     // old, uninitialized value."},{"DocComment":"     unsafe { (&raw mut (*ptr).name).write(\"Bob\".to_string()); }"},{"DocComment":""},{"DocComment":"     // Initializing the `list` field"},{"DocComment":"     // If there is a panic here, then the `String` in the `name` field leaks."},{"DocComment":"     unsafe { (&raw mut (*ptr).list).write(vec![0, 1, 2]); }"},{"DocComment":""},{"DocComment":"     // All the fields are initialized, so we call `assume_init` to get an initialized Foo."},{"DocComment":"     unsafe { uninit.assume_init() }"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     foo,"},{"DocComment":"     Foo {"},{"DocComment":"         name: \"Bob\".to_string(),"},{"DocComment":"         list: vec![0, 1, 2]"},{"DocComment":"     }"},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":" [`&raw mut`]: https://doc.rust-lang.org/reference/types/pointer.html#r-type.pointer.raw.constructor"},{"DocComment":" [validity]: ../../reference/behavior-considered-undefined.html#r-undefined.validity"},{"DocComment":""},{"DocComment":" Note that we have not initialized the padding, but that's fine -- it does not have to be"},{"DocComment":" initialized. In fact, even if we had initialized the padding in `uninit`, those bytes would be"},{"DocComment":" lost when copying the result: no matter the contents of the padding bytes in `uninit`, they will"},{"DocComment":" always be uninitialized in `foo`."},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` is guaranteed to have the same size, alignment, and ABI as `T`:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":" assert_eq!(size_of::<MaybeUninit<u64>>(), size_of::<u64>());"},{"DocComment":" assert_eq!(align_of::<MaybeUninit<u64>>(), align_of::<u64>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However remember that a type *containing* a `MaybeUninit<T>` is not necessarily the same"},{"DocComment":" layout; Rust does not in general guarantee that the fields of a `Foo<T>` have the same order as"},{"DocComment":" a `Foo<U>` even if `T` and `U` have the same size and alignment. Furthermore because any bit"},{"DocComment":" value is valid for a `MaybeUninit<T>` the compiler can't apply non-zero/niche-filling"},{"DocComment":" optimizations, potentially resulting in a larger size:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" # use std::mem::MaybeUninit;"},{"DocComment":" assert_eq!(size_of::<Option<bool>>(), 1);"},{"DocComment":" assert_eq!(size_of::<Option<MaybeUninit<bool>>>(), 2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If `T` is FFI-safe, then so is `MaybeUninit<T>`."},{"DocComment":""},{"DocComment":" While `MaybeUninit` is `#[repr(transparent)]` (indicating it guarantees the same size,"},{"DocComment":" alignment, and ABI as `T`), this does *not* change any of the previous caveats. `Option<T>` and"},{"DocComment":" `Option<MaybeUninit<T>>` may still have different sizes, and types containing a field of type"},{"DocComment":" `T` may be laid out (and sized) differently than if that field were `MaybeUninit<T>`."},{"DocComment":" `MaybeUninit` is a union type, and `#[repr(transparent)]` on unions is unstable (see [the"},{"DocComment":" tracking issue](https://github.com/rust-lang/rust/issues/60405)). Over time, the exact"},{"DocComment":" guarantees of `#[repr(transparent)]` on unions may evolve, and `MaybeUninit` may or may not"},{"DocComment":" remain `#[repr(transparent)]`. That said, `MaybeUninit<T>` will *always* guarantee that it has"},{"DocComment":" the same size, alignment, and ABI as `T`; it's just that the way `MaybeUninit` implements that"},{"DocComment":" guarantee may evolve."},{"DocComment":""},{"DocComment":" Note that even though `T` and `MaybeUninit<T>` are ABI compatible it is still unsound to"},{"DocComment":" transmute `&mut T` to `&mut MaybeUninit<T>` and expose that to safe code because it would allow"},{"DocComment":" safe code to access uninitialized memory:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use core::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" fn unsound_transmute<T>(val: &mut T) -> &mut MaybeUninit<T> {"},{"DocComment":"     unsafe { core::mem::transmute(val) }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let mut code = 0;"},{"DocComment":"     let code = &mut code;"},{"DocComment":"     let code2 = unsound_transmute(code);"},{"DocComment":"     *code2 = MaybeUninit::uninit();"},{"DocComment":"     std::process::exit(*code); // UB! Accessing uninitialized memory."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Validity"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` has no validity requirements – any sequence of [bytes] of"},{"DocComment":" the appropriate length, initialized or uninitialized, are a valid"},{"DocComment":" representation."},{"DocComment":""},{"DocComment":" Moving or copying a value of type `MaybeUninit<T>` (i.e., performing a"},{"DocComment":" \"typed copy\") will exactly preserve the contents, including the"},{"DocComment":" [provenance], of all non-padding bytes of type `T` in the value's"},{"DocComment":" representation."},{"DocComment":""},{"DocComment":" Therefore `MaybeUninit` can be used to perform a round trip of a value from"},{"DocComment":" type `T` to type `MaybeUninit<U>` then back to type `T`, while preserving"},{"DocComment":" the original value, if two conditions are met. One, type `U` must have the"},{"DocComment":" same size as type `T`. Two, for all byte offsets where type `U` has padding,"},{"DocComment":" the corresponding bytes in the representation of the value must be"},{"DocComment":" uninitialized."},{"DocComment":""},{"DocComment":" For example, due to the fact that the type `[u8; size_of::<T>]` has no"},{"DocComment":" padding, the following is sound for any type `T` and will return the"},{"DocComment":" original value:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" # struct T;"},{"DocComment":" fn identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         let u: MaybeUninit<[u8; size_of::<T>()]> = transmute(t);"},{"DocComment":"         transmute(u) // OK."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note: Copying a value that contains references may implicitly reborrow them"},{"DocComment":" causing the provenance of the returned value to differ from that of the"},{"DocComment":" original. This applies equally to the trivial identity function:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" fn trivial_identity<T>(t: T) -> T { t }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note: Moving or copying a value whose representation has initialized bytes"},{"DocComment":" at byte offsets where the type has padding may lose the value of those"},{"DocComment":" bytes, so while the original value will be preserved, the original"},{"DocComment":" *representation* of that value as bytes may not be. Again, this applies"},{"DocComment":" equally to `trivial_identity`."},{"DocComment":""},{"DocComment":" Note: Performing this round trip when type `U` has padding at byte offsets"},{"DocComment":" where the representation of the original value has initialized bytes may"},{"DocComment":" produce undefined behavior or a different value. For example, the following"},{"DocComment":" is unsound since `T` requires all bytes to be initialized:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" #[repr(C)] struct T([u8; 4]);"},{"DocComment":" #[repr(C)] struct U(u8, u16);"},{"DocComment":" fn unsound_identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         let u: MaybeUninit<U> = transmute(t);"},{"DocComment":"         transmute(u) // UB."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Conversely, the following is sound since `T` allows uninitialized bytes in"},{"DocComment":" the representation of a value, but the round trip may alter the value:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" #[repr(C)] struct T(MaybeUninit<[u8; 4]>);"},{"DocComment":" #[repr(C)] struct U(u8, u16);"},{"DocComment":" fn non_identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         // May lose an initialized byte."},{"DocComment":"         let u: MaybeUninit<U> = transmute(t);"},{"DocComment":"         transmute(u)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [bytes]: ../../reference/memory-model.html#bytes"},{"DocComment":" [provenance]: crate::ptr#provenance"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"maybe_uninit"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Union":[{"span":{"data":{"file_id":24,"beg":{"line":356,"col":4},"end":{"line":356,"col":14}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"uninit","ty":{"Deduplicated":1930}},{"span":{"data":{"file_id":24,"beg":{"line":357,"col":4},"end":{"line":357,"col":26}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"value","ty":{"HashConsedValue":[2226,{"Adt":{"id":{"Adt":32},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":4,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":23,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["iter",0]},{"Ident":["iter_inner",0]},{"Ident":["PolymorphicIter",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":2085}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":38,"beg":{"line":35,"col":0},"end":{"line":35,"col":47}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":38,"beg":{"line":45,"col":4},"end":{"line":45,"col":21}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"alive","ty":{"HashConsedValue":[2487,{"Adt":{"id":{"Adt":43},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}},{"span":{"data":{"file_id":38,"beg":{"line":59,"col":4},"end":{"line":59,"col":14}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"data","ty":{"Deduplicated":2085}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":72,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,16],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":24,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["manually_drop",0]},{"Ident":["ManuallyDrop",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":2093}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":29,"beg":{"line":161,"col":0},"end":{"line":161,"col":34}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper to inhibit the compiler from automatically calling `T`’s"},{"DocComment":" destructor. This wrapper is 0-cost."},{"DocComment":""},{"DocComment":" `ManuallyDrop<T>` is guaranteed to have the same layout and bit validity as"},{"DocComment":" `T`, and is subject to the same layout optimizations as `T`. As a"},{"DocComment":" consequence, it has *no effect* on the assumptions that the compiler makes"},{"DocComment":" about its contents. For example, initializing a `ManuallyDrop<&mut T>` with"},{"DocComment":" [`mem::zeroed`] is undefined behavior. If you need to handle uninitialized"},{"DocComment":" data, use [`MaybeUninit<T>`] instead."},{"DocComment":""},{"DocComment":" Note that accessing the value inside a `ManuallyDrop<T>` is safe. This means"},{"DocComment":" that a `ManuallyDrop<T>` whose content has been dropped must not be exposed"},{"DocComment":" through a public safe API. Correspondingly, `ManuallyDrop::drop` is unsafe."},{"DocComment":""},{"DocComment":" # `ManuallyDrop` and drop order"},{"DocComment":""},{"DocComment":" Rust has a well-defined [drop order] of values. To make sure that fields or"},{"DocComment":" locals are dropped in a specific order, reorder the declarations such that"},{"DocComment":" the implicit drop order is the correct one."},{"DocComment":""},{"DocComment":" It is possible to use `ManuallyDrop` to control the drop order, but this"},{"DocComment":" requires unsafe code and is hard to do correctly in the presence of"},{"DocComment":" unwinding."},{"DocComment":""},{"DocComment":" For example, if you want to make sure that a specific field is dropped after"},{"DocComment":" the others, make it the last field of a struct:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct Context;"},{"DocComment":""},{"DocComment":" struct Widget {"},{"DocComment":"     children: Vec<Widget>,"},{"DocComment":"     // `context` will be dropped after `children`."},{"DocComment":"     // Rust guarantees that fields are dropped in the order of declaration."},{"DocComment":"     context: Context,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Interaction with `Box`"},{"DocComment":""},{"DocComment":" Currently, if you have a `ManuallyDrop<T>`, where the type `T` is a `Box` or"},{"DocComment":" contains a `Box` inside, then dropping the `T` followed by moving the"},{"DocComment":" `ManuallyDrop<T>` is [considered to be undefined"},{"DocComment":" behavior](https://github.com/rust-lang/unsafe-code-guidelines/issues/245)."},{"DocComment":" That is, the following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" let mut x = ManuallyDrop::new(Box::new(42));"},{"DocComment":" unsafe {"},{"DocComment":"     ManuallyDrop::drop(&mut x);"},{"DocComment":" }"},{"DocComment":" let y = x; // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This is [likely to change in the"},{"DocComment":" future](https://rust-lang.github.io/rfcs/3336-maybe-dangling.html). In the"},{"DocComment":" meantime, consider using [`MaybeUninit`] instead."},{"DocComment":""},{"DocComment":" # Safety hazards when storing `ManuallyDrop` in a struct or an enum."},{"DocComment":""},{"DocComment":" Special care is needed when all of the conditions below are met:"},{"DocComment":" * A struct or enum contains a `ManuallyDrop`."},{"DocComment":" * The `ManuallyDrop` is not inside a `union`."},{"DocComment":" * The struct or enum is part of public API, or is stored in a struct or an"},{"DocComment":"   enum that is part of public API."},{"DocComment":" * There is code that drops the contents of the `ManuallyDrop` field, and"},{"DocComment":"   this code is outside the struct or enum's `Drop` implementation."},{"DocComment":""},{"DocComment":" In particular, the following hazards may occur:"},{"DocComment":""},{"DocComment":" #### Storing generic types"},{"DocComment":""},{"DocComment":" If the `ManuallyDrop` contains a client-supplied generic type, the client"},{"DocComment":" might provide a `Box` as that type. This would cause undefined behavior when"},{"DocComment":" the struct or enum is later moved, as mentioned in the previous section. For"},{"DocComment":" example, the following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" pub struct BadOption<T> {"},{"DocComment":"     // Invariant: Has been dropped if `is_some` is false."},{"DocComment":"     value: ManuallyDrop<T>,"},{"DocComment":"     is_some: bool,"},{"DocComment":" }"},{"DocComment":" impl<T> BadOption<T> {"},{"DocComment":"     pub fn new(value: T) -> Self {"},{"DocComment":"         Self { value: ManuallyDrop::new(value), is_some: true }"},{"DocComment":"     }"},{"DocComment":"     pub fn change_to_none(&mut self) {"},{"DocComment":"         if self.is_some {"},{"DocComment":"             self.is_some = false;"},{"DocComment":"             unsafe {"},{"DocComment":"                 // SAFETY: `value` hasn't been dropped yet, as per the invariant"},{"DocComment":"                 // (This is actually unsound!)"},{"DocComment":"                 ManuallyDrop::drop(&mut self.value);"},{"DocComment":"             }"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let mut option = BadOption::new(Box::new(42));"},{"DocComment":" option.change_to_none();"},{"DocComment":" let option2 = option; // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" #### Deriving traits"},{"DocComment":""},{"DocComment":" Deriving `Debug`, `Clone`, `PartialEq`, `PartialOrd`, `Ord`, or `Hash` on"},{"DocComment":" the struct or enum could be unsound, since the derived implementations of"},{"DocComment":" these traits would access the `ManuallyDrop` field. For example, the"},{"DocComment":" following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" // This derive is unsound in combination with the `ManuallyDrop::drop` call."},{"DocComment":" #[derive(Debug)]"},{"DocComment":" pub struct Foo {"},{"DocComment":"     value: ManuallyDrop<String>,"},{"DocComment":" }"},{"DocComment":" impl Foo {"},{"DocComment":"     pub fn new() -> Self {"},{"DocComment":"         let mut temp = Self {"},{"DocComment":"             value: ManuallyDrop::new(String::from(\"Unsafe rust is hard.\"))"},{"DocComment":"         };"},{"DocComment":"         unsafe {"},{"DocComment":"             // SAFETY: `value` hasn't been dropped yet."},{"DocComment":"             ManuallyDrop::drop(&mut temp.value);"},{"DocComment":"         }"},{"DocComment":"         temp"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let foo = Foo::new();"},{"DocComment":" println!(\"{:?}\", foo); // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [drop order]: https://doc.rust-lang.org/reference/destructors.html"},{"DocComment":" [`mem::zeroed`]: crate::mem::zeroed"},{"DocComment":" [`MaybeUninit<T>`]: crate::mem::MaybeUninit"},{"DocComment":" [`MaybeUninit`]: crate::mem::MaybeUninit"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"manually_drop"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":29,"beg":{"line":162,"col":4},"end":{"line":162,"col":27}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"value","ty":{"HashConsedValue":[2099,{"Adt":{"id":{"Adt":25},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":72,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":25,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_dangling",0]},{"Ident":["MaybeDangling",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":2093}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":30,"beg":{"line":74,"col":0},"end":{"line":74,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Allows wrapped [references] and [boxes] to dangle."},{"DocComment":""},{"DocComment":" That is, if a reference (or a `Box`) is wrapped in `MaybeDangling` (including when in a"},{"DocComment":" (nested) field of a compound type wrapped in `MaybeDangling`), it does not have to follow"},{"DocComment":" pointer aliasing rules or be dereferenceable."},{"DocComment":""},{"DocComment":" This can be useful when the value can become dangling while the function holding it is still"},{"DocComment":" executing (particularly in concurrent code). As a somewhat absurd example, consider this code:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" #![feature(box_as_ptr)]"},{"DocComment":" # use std::alloc::{dealloc, Layout};"},{"DocComment":" # use std::mem;"},{"DocComment":""},{"DocComment":" let mut boxed = Box::new(0_u32);"},{"DocComment":" let ptr = Box::as_mut_ptr(&mut boxed);"},{"DocComment":""},{"DocComment":" // Safety: the pointer comes from a box and thus was allocated before; `box` is not used afterwards"},{"DocComment":" unsafe { dealloc(ptr.cast(), Layout::new::<u32>()) };"},{"DocComment":""},{"DocComment":" mem::forget(boxed); // <-- this is UB!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Even though the `Box`'s destructor is not run (and thus we don't have a double free bug), this"},{"DocComment":" code is still UB. This is because when moving `boxed` into `forget`, its validity invariants"},{"DocComment":" are asserted, causing UB since the `Box` is dangling. The safety comment is as such wrong, as"},{"DocComment":" moving the `boxed` variable as part of the `forget` call *is* a use."},{"DocComment":""},{"DocComment":" To fix this we could use `MaybeDangling`:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" #![feature(maybe_dangling, box_as_ptr)]"},{"DocComment":" # use std::alloc::{dealloc, Layout};"},{"DocComment":" # use std::mem::{self, MaybeDangling};"},{"DocComment":""},{"DocComment":" let mut boxed = MaybeDangling::new(Box::new(0_u32));"},{"DocComment":" let ptr = Box::as_mut_ptr(boxed.as_mut());"},{"DocComment":""},{"DocComment":" // Safety: the pointer comes from a box and thus was allocated before; `box` is not used afterwards"},{"DocComment":" unsafe { dealloc(ptr.cast(), Layout::new::<u32>()) };"},{"DocComment":""},{"DocComment":" mem::forget(boxed); // <-- this is OK!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that the bit pattern must still be valid for the wrapped type. That is, [references]"},{"DocComment":" (and [boxes]) still must be aligned and non-null."},{"DocComment":""},{"DocComment":" Additionally note that safe code can still assume that the inner value in a `MaybeDangling` is"},{"DocComment":" **not** dangling -- functions like [`as_ref`] and [`into_inner`] are safe. It is not sound to"},{"DocComment":" return a dangling reference in a `MaybeDangling` to safe code. However, it *is* sound"},{"DocComment":" to hold such values internally inside your code -- and there's no way to do that without"},{"DocComment":" this type. Note that other types can use this type and thus get the same effect; in particular,"},{"DocComment":" [`ManuallyDrop`] will use `MaybeDangling`."},{"DocComment":""},{"DocComment":" Note that `MaybeDangling` doesn't prevent drops from being run, which can lead to UB if the"},{"DocComment":" drop observes a dangling value. If you need to prevent drops from being run use [`ManuallyDrop`]"},{"DocComment":" instead."},{"DocComment":""},{"DocComment":" [references]: prim@reference"},{"DocComment":" [boxes]: ../../std/boxed/struct.Box.html"},{"DocComment":" [`into_inner`]: MaybeDangling::into_inner"},{"DocComment":" [`as_ref`]: MaybeDangling::as_ref"},{"DocComment":" [`ManuallyDrop`]: crate::mem::ManuallyDrop"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"maybe_dangling"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":30,"beg":{"line":74,"col":36},"end":{"line":74,"col":37}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":null,"ty":{"Deduplicated":2093}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":72,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":26,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["iter",0]},{"Ident":["iter_inner",0]},{"Ident":["PolymorphicIter",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":2116}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":38,"beg":{"line":35,"col":0},"end":{"line":35,"col":47}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":38,"beg":{"line":45,"col":4},"end":{"line":45,"col":21}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"alive","ty":{"Deduplicated":2487}},{"span":{"data":{"file_id":38,"beg":{"line":59,"col":4},"end":{"line":59,"col":14}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"data","ty":{"Deduplicated":2116}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":null,"align":null,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,16],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":27,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_uninit",0]},{"Ident":["MaybeUninit",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":1534}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":24,"beg":{"line":355,"col":0},"end":{"line":355,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper type to construct uninitialized instances of `T`."},{"DocComment":""},{"DocComment":" # Initialization invariant"},{"DocComment":""},{"DocComment":" The compiler, in general, assumes that a variable is [properly initialized or \"valid\"][validity]"},{"DocComment":" according to the requirements of the variable's type. For example, a variable of"},{"DocComment":" reference type must be aligned and non-null. This is an invariant that must"},{"DocComment":" *always* be upheld, even in unsafe code. As a consequence, zero-initializing a"},{"DocComment":" variable of reference type causes instantaneous undefined behavior,"},{"DocComment":" no matter whether that reference ever gets used to access memory:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let x: &i32 = unsafe { mem::zeroed() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<&i32>`:"},{"DocComment":" let x: &i32 = unsafe { MaybeUninit::zeroed().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This is exploited by the compiler for various optimizations, such as eliding"},{"DocComment":" run-time checks and optimizing `enum` layout."},{"DocComment":""},{"DocComment":" Similarly, entirely uninitialized memory may have any content, while a `bool` must"},{"DocComment":" always be `true` or `false`. Hence, creating an uninitialized `bool` is undefined behavior:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let b: bool = unsafe { mem::uninitialized() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<bool>`:"},{"DocComment":" let b: bool = unsafe { MaybeUninit::uninit().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Moreover, uninitialized memory is special in that it does not have a fixed value (\"fixed\""},{"DocComment":" meaning \"it won't change without being written to\"). Reading the same uninitialized byte"},{"DocComment":" multiple times can give different results. This makes it undefined behavior to have"},{"DocComment":" uninitialized data in a variable even if that variable has an integer type, which otherwise can"},{"DocComment":" hold any *fixed* bit pattern:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let x: i32 = unsafe { mem::uninitialized() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<i32>`:"},{"DocComment":" let x: i32 = unsafe { MaybeUninit::uninit().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Conversely, sometimes it is okay to not initialize *all* bytes of a `MaybeUninit`"},{"DocComment":" before calling `assume_init`. For instance, padding bytes do not have to be initialized."},{"DocComment":" See the field-by-field struct initialization example below for a case of that."},{"DocComment":""},{"DocComment":" On top of that, remember that most types have additional invariants beyond merely"},{"DocComment":" being considered initialized at the type level. For example, a `1`-initialized [`Vec<T>`]"},{"DocComment":" is considered initialized (under the current implementation; this does not constitute"},{"DocComment":" a stable guarantee) because the only requirement the compiler knows about it"},{"DocComment":" is that the data pointer must be non-null. Creating such a `Vec<T>` does not cause"},{"DocComment":" *immediate* undefined behavior, but will cause undefined behavior with most"},{"DocComment":" safe operations (including dropping it)."},{"DocComment":""},{"DocComment":" [`Vec<T>`]: ../../std/vec/struct.Vec.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` serves to enable unsafe code to deal with uninitialized data."},{"DocComment":" It is a signal to the compiler indicating that the data here might *not*"},{"DocComment":" be initialized:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" // Create an explicitly uninitialized reference. The compiler knows that data inside"},{"DocComment":" // a `MaybeUninit<T>` may be invalid, and hence this is not UB:"},{"DocComment":" let mut x = MaybeUninit::<&i32>::uninit();"},{"DocComment":" // Set it to a valid value."},{"DocComment":" x.write(&0);"},{"DocComment":" // Extract the initialized data -- this is only allowed *after* properly"},{"DocComment":" // initializing `x`!"},{"DocComment":" let x = unsafe { x.assume_init() };"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The compiler then knows to not make any incorrect assumptions or optimizations on this code."},{"DocComment":""},{"DocComment":" You can think of `MaybeUninit<T>` as being a bit like `Option<T>` but without"},{"DocComment":" any of the run-time tracking and without any of the safety checks."},{"DocComment":""},{"DocComment":" ## out-pointers"},{"DocComment":""},{"DocComment":" You can use `MaybeUninit<T>` to implement \"out-pointers\": instead of returning data"},{"DocComment":" from a function, pass it a pointer to some (uninitialized) memory to put the"},{"DocComment":" result into. This can be useful when it is important for the caller to control"},{"DocComment":" how the memory the result is stored in gets allocated, and you want to avoid"},{"DocComment":" unnecessary moves."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" unsafe fn make_vec(out: *mut Vec<i32>) {"},{"DocComment":"     // `write` does not drop the old contents, which is important."},{"DocComment":"     unsafe { out.write(vec![1, 2, 3]); }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut v = MaybeUninit::uninit();"},{"DocComment":" unsafe { make_vec(v.as_mut_ptr()); }"},{"DocComment":" // Now we know `v` is initialized! This also makes sure the vector gets"},{"DocComment":" // properly dropped."},{"DocComment":" let v = unsafe { v.assume_init() };"},{"DocComment":" assert_eq!(&v, &[1, 2, 3]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Initializing an array element-by-element"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` can be used to initialize a large array element-by-element:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let data = {"},{"DocComment":"     // Create an uninitialized array of `MaybeUninit`."},{"DocComment":"     let mut data: [MaybeUninit<Vec<u32>>; 1000] = [const { MaybeUninit::uninit() }; 1000];"},{"DocComment":""},{"DocComment":"     // Dropping a `MaybeUninit` does nothing, so if there is a panic during this loop,"},{"DocComment":"     // we have a memory leak, but there is no memory safety issue."},{"DocComment":"     for elem in &mut data[..] {"},{"DocComment":"         elem.write(vec![42]);"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     // Everything is initialized. Transmute the array to the"},{"DocComment":"     // initialized type."},{"DocComment":"     unsafe { mem::transmute::<_, [Vec<u32>; 1000]>(data) }"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" assert_eq!(&data[0], &[42]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also work with partially initialized arrays, which could"},{"DocComment":" be found in low-level datastructures."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" // Create an uninitialized array of `MaybeUninit`."},{"DocComment":" let mut data: [MaybeUninit<String>; 1000] = [const { MaybeUninit::uninit() }; 1000];"},{"DocComment":" // Count the number of elements we have assigned."},{"DocComment":" let mut data_len: usize = 0;"},{"DocComment":""},{"DocComment":" for elem in &mut data[0..500] {"},{"DocComment":"     elem.write(String::from(\"hello\"));"},{"DocComment":"     data_len += 1;"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // For each item in the array, drop if we allocated it."},{"DocComment":" for elem in &mut data[0..data_len] {"},{"DocComment":"     unsafe { elem.assume_init_drop(); }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Initializing a struct field-by-field"},{"DocComment":""},{"DocComment":" You can use `MaybeUninit<T>` and the [`&raw mut`] syntax to initialize structs field by field:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" pub struct Foo {"},{"DocComment":"     name: String,"},{"DocComment":"     list: Vec<u8>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let foo = {"},{"DocComment":"     let mut uninit: MaybeUninit<Foo> = MaybeUninit::uninit();"},{"DocComment":"     let ptr = uninit.as_mut_ptr();"},{"DocComment":""},{"DocComment":"     // Initializing the `name` field"},{"DocComment":"     // Using `write` instead of assignment via `=` to not call `drop` on the"},{"DocComment":"     // old, uninitialized value."},{"DocComment":"     unsafe { (&raw mut (*ptr).name).write(\"Bob\".to_string()); }"},{"DocComment":""},{"DocComment":"     // Initializing the `list` field"},{"DocComment":"     // If there is a panic here, then the `String` in the `name` field leaks."},{"DocComment":"     unsafe { (&raw mut (*ptr).list).write(vec![0, 1, 2]); }"},{"DocComment":""},{"DocComment":"     // All the fields are initialized, so we call `assume_init` to get an initialized Foo."},{"DocComment":"     unsafe { uninit.assume_init() }"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     foo,"},{"DocComment":"     Foo {"},{"DocComment":"         name: \"Bob\".to_string(),"},{"DocComment":"         list: vec![0, 1, 2]"},{"DocComment":"     }"},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":" [`&raw mut`]: https://doc.rust-lang.org/reference/types/pointer.html#r-type.pointer.raw.constructor"},{"DocComment":" [validity]: ../../reference/behavior-considered-undefined.html#r-undefined.validity"},{"DocComment":""},{"DocComment":" Note that we have not initialized the padding, but that's fine -- it does not have to be"},{"DocComment":" initialized. In fact, even if we had initialized the padding in `uninit`, those bytes would be"},{"DocComment":" lost when copying the result: no matter the contents of the padding bytes in `uninit`, they will"},{"DocComment":" always be uninitialized in `foo`."},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` is guaranteed to have the same size, alignment, and ABI as `T`:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":" assert_eq!(size_of::<MaybeUninit<u64>>(), size_of::<u64>());"},{"DocComment":" assert_eq!(align_of::<MaybeUninit<u64>>(), align_of::<u64>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However remember that a type *containing* a `MaybeUninit<T>` is not necessarily the same"},{"DocComment":" layout; Rust does not in general guarantee that the fields of a `Foo<T>` have the same order as"},{"DocComment":" a `Foo<U>` even if `T` and `U` have the same size and alignment. Furthermore because any bit"},{"DocComment":" value is valid for a `MaybeUninit<T>` the compiler can't apply non-zero/niche-filling"},{"DocComment":" optimizations, potentially resulting in a larger size:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" # use std::mem::MaybeUninit;"},{"DocComment":" assert_eq!(size_of::<Option<bool>>(), 1);"},{"DocComment":" assert_eq!(size_of::<Option<MaybeUninit<bool>>>(), 2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If `T` is FFI-safe, then so is `MaybeUninit<T>`."},{"DocComment":""},{"DocComment":" While `MaybeUninit` is `#[repr(transparent)]` (indicating it guarantees the same size,"},{"DocComment":" alignment, and ABI as `T`), this does *not* change any of the previous caveats. `Option<T>` and"},{"DocComment":" `Option<MaybeUninit<T>>` may still have different sizes, and types containing a field of type"},{"DocComment":" `T` may be laid out (and sized) differently than if that field were `MaybeUninit<T>`."},{"DocComment":" `MaybeUninit` is a union type, and `#[repr(transparent)]` on unions is unstable (see [the"},{"DocComment":" tracking issue](https://github.com/rust-lang/rust/issues/60405)). Over time, the exact"},{"DocComment":" guarantees of `#[repr(transparent)]` on unions may evolve, and `MaybeUninit` may or may not"},{"DocComment":" remain `#[repr(transparent)]`. That said, `MaybeUninit<T>` will *always* guarantee that it has"},{"DocComment":" the same size, alignment, and ABI as `T`; it's just that the way `MaybeUninit` implements that"},{"DocComment":" guarantee may evolve."},{"DocComment":""},{"DocComment":" Note that even though `T` and `MaybeUninit<T>` are ABI compatible it is still unsound to"},{"DocComment":" transmute `&mut T` to `&mut MaybeUninit<T>` and expose that to safe code because it would allow"},{"DocComment":" safe code to access uninitialized memory:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use core::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" fn unsound_transmute<T>(val: &mut T) -> &mut MaybeUninit<T> {"},{"DocComment":"     unsafe { core::mem::transmute(val) }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let mut code = 0;"},{"DocComment":"     let code = &mut code;"},{"DocComment":"     let code2 = unsound_transmute(code);"},{"DocComment":"     *code2 = MaybeUninit::uninit();"},{"DocComment":"     std::process::exit(*code); // UB! Accessing uninitialized memory."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Validity"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` has no validity requirements – any sequence of [bytes] of"},{"DocComment":" the appropriate length, initialized or uninitialized, are a valid"},{"DocComment":" representation."},{"DocComment":""},{"DocComment":" Moving or copying a value of type `MaybeUninit<T>` (i.e., performing a"},{"DocComment":" \"typed copy\") will exactly preserve the contents, including the"},{"DocComment":" [provenance], of all non-padding bytes of type `T` in the value's"},{"DocComment":" representation."},{"DocComment":""},{"DocComment":" Therefore `MaybeUninit` can be used to perform a round trip of a value from"},{"DocComment":" type `T` to type `MaybeUninit<U>` then back to type `T`, while preserving"},{"DocComment":" the original value, if two conditions are met. One, type `U` must have the"},{"DocComment":" same size as type `T`. Two, for all byte offsets where type `U` has padding,"},{"DocComment":" the corresponding bytes in the representation of the value must be"},{"DocComment":" uninitialized."},{"DocComment":""},{"DocComment":" For example, due to the fact that the type `[u8; size_of::<T>]` has no"},{"DocComment":" padding, the following is sound for any type `T` and will return the"},{"DocComment":" original value:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" # struct T;"},{"DocComment":" fn identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         let u: MaybeUninit<[u8; size_of::<T>()]> = transmute(t);"},{"DocComment":"         transmute(u) // OK."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note: Copying a value that contains references may implicitly reborrow them"},{"DocComment":" causing the provenance of the returned value to differ from that of the"},{"DocComment":" original. This applies equally to the trivial identity function:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" fn trivial_identity<T>(t: T) -> T { t }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note: Moving or copying a value whose representation has initialized bytes"},{"DocComment":" at byte offsets where the type has padding may lose the value of those"},{"DocComment":" bytes, so while the original value will be preserved, the original"},{"DocComment":" *representation* of that value as bytes may not be. Again, this applies"},{"DocComment":" equally to `trivial_identity`."},{"DocComment":""},{"DocComment":" Note: Performing this round trip when type `U` has padding at byte offsets"},{"DocComment":" where the representation of the original value has initialized bytes may"},{"DocComment":" produce undefined behavior or a different value. For example, the following"},{"DocComment":" is unsound since `T` requires all bytes to be initialized:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" #[repr(C)] struct T([u8; 4]);"},{"DocComment":" #[repr(C)] struct U(u8, u16);"},{"DocComment":" fn unsound_identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         let u: MaybeUninit<U> = transmute(t);"},{"DocComment":"         transmute(u) // UB."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Conversely, the following is sound since `T` allows uninitialized bytes in"},{"DocComment":" the representation of a value, but the round trip may alter the value:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" #[repr(C)] struct T(MaybeUninit<[u8; 4]>);"},{"DocComment":" #[repr(C)] struct U(u8, u16);"},{"DocComment":" fn non_identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         // May lose an initialized byte."},{"DocComment":"         let u: MaybeUninit<U> = transmute(t);"},{"DocComment":"         transmute(u)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [bytes]: ../../reference/memory-model.html#bytes"},{"DocComment":" [provenance]: crate::ptr#provenance"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"maybe_uninit"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Union":[{"span":{"data":{"file_id":24,"beg":{"line":356,"col":4},"end":{"line":356,"col":14}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"uninit","ty":{"Deduplicated":1930}},{"span":{"data":{"file_id":24,"beg":{"line":357,"col":4},"end":{"line":357,"col":26}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"value","ty":{"HashConsedValue":[2172,{"Adt":{"id":{"Adt":29},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":4,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":28,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["Guard",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":["Erased"],"types":[{"Deduplicated":1534}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":16,"beg":{"line":934,"col":0},"end":{"line":934,"col":19}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":16,"beg":{"line":936,"col":4},"end":{"line":936,"col":43}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"array_mut","ty":{"HashConsedValue":[4180,{"Ref":["Erased",{"HashConsedValue":[2155,{"Slice":{"HashConsedValue":[2150,{"Adt":{"id":{"Adt":27},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"Mut"]}]}},{"span":{"data":{"file_id":16,"beg":{"line":938,"col":4},"end":{"line":938,"col":26}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"initialized","ty":{"Deduplicated":1581}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,16],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":29,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["manually_drop",0]},{"Ident":["ManuallyDrop",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":1534}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":29,"beg":{"line":161,"col":0},"end":{"line":161,"col":34}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper to inhibit the compiler from automatically calling `T`’s"},{"DocComment":" destructor. This wrapper is 0-cost."},{"DocComment":""},{"DocComment":" `ManuallyDrop<T>` is guaranteed to have the same layout and bit validity as"},{"DocComment":" `T`, and is subject to the same layout optimizations as `T`. As a"},{"DocComment":" consequence, it has *no effect* on the assumptions that the compiler makes"},{"DocComment":" about its contents. For example, initializing a `ManuallyDrop<&mut T>` with"},{"DocComment":" [`mem::zeroed`] is undefined behavior. If you need to handle uninitialized"},{"DocComment":" data, use [`MaybeUninit<T>`] instead."},{"DocComment":""},{"DocComment":" Note that accessing the value inside a `ManuallyDrop<T>` is safe. This means"},{"DocComment":" that a `ManuallyDrop<T>` whose content has been dropped must not be exposed"},{"DocComment":" through a public safe API. Correspondingly, `ManuallyDrop::drop` is unsafe."},{"DocComment":""},{"DocComment":" # `ManuallyDrop` and drop order"},{"DocComment":""},{"DocComment":" Rust has a well-defined [drop order] of values. To make sure that fields or"},{"DocComment":" locals are dropped in a specific order, reorder the declarations such that"},{"DocComment":" the implicit drop order is the correct one."},{"DocComment":""},{"DocComment":" It is possible to use `ManuallyDrop` to control the drop order, but this"},{"DocComment":" requires unsafe code and is hard to do correctly in the presence of"},{"DocComment":" unwinding."},{"DocComment":""},{"DocComment":" For example, if you want to make sure that a specific field is dropped after"},{"DocComment":" the others, make it the last field of a struct:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct Context;"},{"DocComment":""},{"DocComment":" struct Widget {"},{"DocComment":"     children: Vec<Widget>,"},{"DocComment":"     // `context` will be dropped after `children`."},{"DocComment":"     // Rust guarantees that fields are dropped in the order of declaration."},{"DocComment":"     context: Context,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Interaction with `Box`"},{"DocComment":""},{"DocComment":" Currently, if you have a `ManuallyDrop<T>`, where the type `T` is a `Box` or"},{"DocComment":" contains a `Box` inside, then dropping the `T` followed by moving the"},{"DocComment":" `ManuallyDrop<T>` is [considered to be undefined"},{"DocComment":" behavior](https://github.com/rust-lang/unsafe-code-guidelines/issues/245)."},{"DocComment":" That is, the following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" let mut x = ManuallyDrop::new(Box::new(42));"},{"DocComment":" unsafe {"},{"DocComment":"     ManuallyDrop::drop(&mut x);"},{"DocComment":" }"},{"DocComment":" let y = x; // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This is [likely to change in the"},{"DocComment":" future](https://rust-lang.github.io/rfcs/3336-maybe-dangling.html). In the"},{"DocComment":" meantime, consider using [`MaybeUninit`] instead."},{"DocComment":""},{"DocComment":" # Safety hazards when storing `ManuallyDrop` in a struct or an enum."},{"DocComment":""},{"DocComment":" Special care is needed when all of the conditions below are met:"},{"DocComment":" * A struct or enum contains a `ManuallyDrop`."},{"DocComment":" * The `ManuallyDrop` is not inside a `union`."},{"DocComment":" * The struct or enum is part of public API, or is stored in a struct or an"},{"DocComment":"   enum that is part of public API."},{"DocComment":" * There is code that drops the contents of the `ManuallyDrop` field, and"},{"DocComment":"   this code is outside the struct or enum's `Drop` implementation."},{"DocComment":""},{"DocComment":" In particular, the following hazards may occur:"},{"DocComment":""},{"DocComment":" #### Storing generic types"},{"DocComment":""},{"DocComment":" If the `ManuallyDrop` contains a client-supplied generic type, the client"},{"DocComment":" might provide a `Box` as that type. This would cause undefined behavior when"},{"DocComment":" the struct or enum is later moved, as mentioned in the previous section. For"},{"DocComment":" example, the following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" pub struct BadOption<T> {"},{"DocComment":"     // Invariant: Has been dropped if `is_some` is false."},{"DocComment":"     value: ManuallyDrop<T>,"},{"DocComment":"     is_some: bool,"},{"DocComment":" }"},{"DocComment":" impl<T> BadOption<T> {"},{"DocComment":"     pub fn new(value: T) -> Self {"},{"DocComment":"         Self { value: ManuallyDrop::new(value), is_some: true }"},{"DocComment":"     }"},{"DocComment":"     pub fn change_to_none(&mut self) {"},{"DocComment":"         if self.is_some {"},{"DocComment":"             self.is_some = false;"},{"DocComment":"             unsafe {"},{"DocComment":"                 // SAFETY: `value` hasn't been dropped yet, as per the invariant"},{"DocComment":"                 // (This is actually unsound!)"},{"DocComment":"                 ManuallyDrop::drop(&mut self.value);"},{"DocComment":"             }"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let mut option = BadOption::new(Box::new(42));"},{"DocComment":" option.change_to_none();"},{"DocComment":" let option2 = option; // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" #### Deriving traits"},{"DocComment":""},{"DocComment":" Deriving `Debug`, `Clone`, `PartialEq`, `PartialOrd`, `Ord`, or `Hash` on"},{"DocComment":" the struct or enum could be unsound, since the derived implementations of"},{"DocComment":" these traits would access the `ManuallyDrop` field. For example, the"},{"DocComment":" following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" // This derive is unsound in combination with the `ManuallyDrop::drop` call."},{"DocComment":" #[derive(Debug)]"},{"DocComment":" pub struct Foo {"},{"DocComment":"     value: ManuallyDrop<String>,"},{"DocComment":" }"},{"DocComment":" impl Foo {"},{"DocComment":"     pub fn new() -> Self {"},{"DocComment":"         let mut temp = Self {"},{"DocComment":"             value: ManuallyDrop::new(String::from(\"Unsafe rust is hard.\"))"},{"DocComment":"         };"},{"DocComment":"         unsafe {"},{"DocComment":"             // SAFETY: `value` hasn't been dropped yet."},{"DocComment":"             ManuallyDrop::drop(&mut temp.value);"},{"DocComment":"         }"},{"DocComment":"         temp"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let foo = Foo::new();"},{"DocComment":" println!(\"{:?}\", foo); // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [drop order]: https://doc.rust-lang.org/reference/destructors.html"},{"DocComment":" [`mem::zeroed`]: crate::mem::zeroed"},{"DocComment":" [`MaybeUninit<T>`]: crate::mem::MaybeUninit"},{"DocComment":" [`MaybeUninit`]: crate::mem::MaybeUninit"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"manually_drop"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":29,"beg":{"line":162,"col":4},"end":{"line":162,"col":27}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"value","ty":{"HashConsedValue":[2174,{"Adt":{"id":{"Adt":30},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":4,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":30,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_dangling",0]},{"Ident":["MaybeDangling",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":1534}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":30,"beg":{"line":74,"col":0},"end":{"line":74,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Allows wrapped [references] and [boxes] to dangle."},{"DocComment":""},{"DocComment":" That is, if a reference (or a `Box`) is wrapped in `MaybeDangling` (including when in a"},{"DocComment":" (nested) field of a compound type wrapped in `MaybeDangling`), it does not have to follow"},{"DocComment":" pointer aliasing rules or be dereferenceable."},{"DocComment":""},{"DocComment":" This can be useful when the value can become dangling while the function holding it is still"},{"DocComment":" executing (particularly in concurrent code). As a somewhat absurd example, consider this code:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" #![feature(box_as_ptr)]"},{"DocComment":" # use std::alloc::{dealloc, Layout};"},{"DocComment":" # use std::mem;"},{"DocComment":""},{"DocComment":" let mut boxed = Box::new(0_u32);"},{"DocComment":" let ptr = Box::as_mut_ptr(&mut boxed);"},{"DocComment":""},{"DocComment":" // Safety: the pointer comes from a box and thus was allocated before; `box` is not used afterwards"},{"DocComment":" unsafe { dealloc(ptr.cast(), Layout::new::<u32>()) };"},{"DocComment":""},{"DocComment":" mem::forget(boxed); // <-- this is UB!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Even though the `Box`'s destructor is not run (and thus we don't have a double free bug), this"},{"DocComment":" code is still UB. This is because when moving `boxed` into `forget`, its validity invariants"},{"DocComment":" are asserted, causing UB since the `Box` is dangling. The safety comment is as such wrong, as"},{"DocComment":" moving the `boxed` variable as part of the `forget` call *is* a use."},{"DocComment":""},{"DocComment":" To fix this we could use `MaybeDangling`:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" #![feature(maybe_dangling, box_as_ptr)]"},{"DocComment":" # use std::alloc::{dealloc, Layout};"},{"DocComment":" # use std::mem::{self, MaybeDangling};"},{"DocComment":""},{"DocComment":" let mut boxed = MaybeDangling::new(Box::new(0_u32));"},{"DocComment":" let ptr = Box::as_mut_ptr(boxed.as_mut());"},{"DocComment":""},{"DocComment":" // Safety: the pointer comes from a box and thus was allocated before; `box` is not used afterwards"},{"DocComment":" unsafe { dealloc(ptr.cast(), Layout::new::<u32>()) };"},{"DocComment":""},{"DocComment":" mem::forget(boxed); // <-- this is OK!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that the bit pattern must still be valid for the wrapped type. That is, [references]"},{"DocComment":" (and [boxes]) still must be aligned and non-null."},{"DocComment":""},{"DocComment":" Additionally note that safe code can still assume that the inner value in a `MaybeDangling` is"},{"DocComment":" **not** dangling -- functions like [`as_ref`] and [`into_inner`] are safe. It is not sound to"},{"DocComment":" return a dangling reference in a `MaybeDangling` to safe code. However, it *is* sound"},{"DocComment":" to hold such values internally inside your code -- and there's no way to do that without"},{"DocComment":" this type. Note that other types can use this type and thus get the same effect; in particular,"},{"DocComment":" [`ManuallyDrop`] will use `MaybeDangling`."},{"DocComment":""},{"DocComment":" Note that `MaybeDangling` doesn't prevent drops from being run, which can lead to UB if the"},{"DocComment":" drop observes a dangling value. If you need to prevent drops from being run use [`ManuallyDrop`]"},{"DocComment":" instead."},{"DocComment":""},{"DocComment":" [references]: prim@reference"},{"DocComment":" [boxes]: ../../std/boxed/struct.Box.html"},{"DocComment":" [`into_inner`]: MaybeDangling::into_inner"},{"DocComment":" [`as_ref`]: MaybeDangling::as_ref"},{"DocComment":" [`ManuallyDrop`]: crate::mem::ManuallyDrop"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"maybe_dangling"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":30,"beg":{"line":74,"col":36},"end":{"line":74,"col":37}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":null,"ty":{"Deduplicated":1534}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":4,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":31,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["Guard",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":["Erased"],"types":[{"Deduplicated":1382}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":16,"beg":{"line":934,"col":0},"end":{"line":934,"col":19}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":16,"beg":{"line":936,"col":4},"end":{"line":936,"col":43}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"array_mut","ty":{"HashConsedValue":[4181,{"Ref":["Erased",{"Deduplicated":2116},"Mut"]}]}},{"span":{"data":{"file_id":16,"beg":{"line":938,"col":4},"end":{"line":938,"col":26}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"initialized","ty":{"Deduplicated":1581}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,16],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":32,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["manually_drop",0]},{"Ident":["ManuallyDrop",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":1382}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":29,"beg":{"line":161,"col":0},"end":{"line":161,"col":34}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper to inhibit the compiler from automatically calling `T`’s"},{"DocComment":" destructor. This wrapper is 0-cost."},{"DocComment":""},{"DocComment":" `ManuallyDrop<T>` is guaranteed to have the same layout and bit validity as"},{"DocComment":" `T`, and is subject to the same layout optimizations as `T`. As a"},{"DocComment":" consequence, it has *no effect* on the assumptions that the compiler makes"},{"DocComment":" about its contents. For example, initializing a `ManuallyDrop<&mut T>` with"},{"DocComment":" [`mem::zeroed`] is undefined behavior. If you need to handle uninitialized"},{"DocComment":" data, use [`MaybeUninit<T>`] instead."},{"DocComment":""},{"DocComment":" Note that accessing the value inside a `ManuallyDrop<T>` is safe. This means"},{"DocComment":" that a `ManuallyDrop<T>` whose content has been dropped must not be exposed"},{"DocComment":" through a public safe API. Correspondingly, `ManuallyDrop::drop` is unsafe."},{"DocComment":""},{"DocComment":" # `ManuallyDrop` and drop order"},{"DocComment":""},{"DocComment":" Rust has a well-defined [drop order] of values. To make sure that fields or"},{"DocComment":" locals are dropped in a specific order, reorder the declarations such that"},{"DocComment":" the implicit drop order is the correct one."},{"DocComment":""},{"DocComment":" It is possible to use `ManuallyDrop` to control the drop order, but this"},{"DocComment":" requires unsafe code and is hard to do correctly in the presence of"},{"DocComment":" unwinding."},{"DocComment":""},{"DocComment":" For example, if you want to make sure that a specific field is dropped after"},{"DocComment":" the others, make it the last field of a struct:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct Context;"},{"DocComment":""},{"DocComment":" struct Widget {"},{"DocComment":"     children: Vec<Widget>,"},{"DocComment":"     // `context` will be dropped after `children`."},{"DocComment":"     // Rust guarantees that fields are dropped in the order of declaration."},{"DocComment":"     context: Context,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Interaction with `Box`"},{"DocComment":""},{"DocComment":" Currently, if you have a `ManuallyDrop<T>`, where the type `T` is a `Box` or"},{"DocComment":" contains a `Box` inside, then dropping the `T` followed by moving the"},{"DocComment":" `ManuallyDrop<T>` is [considered to be undefined"},{"DocComment":" behavior](https://github.com/rust-lang/unsafe-code-guidelines/issues/245)."},{"DocComment":" That is, the following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" let mut x = ManuallyDrop::new(Box::new(42));"},{"DocComment":" unsafe {"},{"DocComment":"     ManuallyDrop::drop(&mut x);"},{"DocComment":" }"},{"DocComment":" let y = x; // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This is [likely to change in the"},{"DocComment":" future](https://rust-lang.github.io/rfcs/3336-maybe-dangling.html). In the"},{"DocComment":" meantime, consider using [`MaybeUninit`] instead."},{"DocComment":""},{"DocComment":" # Safety hazards when storing `ManuallyDrop` in a struct or an enum."},{"DocComment":""},{"DocComment":" Special care is needed when all of the conditions below are met:"},{"DocComment":" * A struct or enum contains a `ManuallyDrop`."},{"DocComment":" * The `ManuallyDrop` is not inside a `union`."},{"DocComment":" * The struct or enum is part of public API, or is stored in a struct or an"},{"DocComment":"   enum that is part of public API."},{"DocComment":" * There is code that drops the contents of the `ManuallyDrop` field, and"},{"DocComment":"   this code is outside the struct or enum's `Drop` implementation."},{"DocComment":""},{"DocComment":" In particular, the following hazards may occur:"},{"DocComment":""},{"DocComment":" #### Storing generic types"},{"DocComment":""},{"DocComment":" If the `ManuallyDrop` contains a client-supplied generic type, the client"},{"DocComment":" might provide a `Box` as that type. This would cause undefined behavior when"},{"DocComment":" the struct or enum is later moved, as mentioned in the previous section. For"},{"DocComment":" example, the following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" pub struct BadOption<T> {"},{"DocComment":"     // Invariant: Has been dropped if `is_some` is false."},{"DocComment":"     value: ManuallyDrop<T>,"},{"DocComment":"     is_some: bool,"},{"DocComment":" }"},{"DocComment":" impl<T> BadOption<T> {"},{"DocComment":"     pub fn new(value: T) -> Self {"},{"DocComment":"         Self { value: ManuallyDrop::new(value), is_some: true }"},{"DocComment":"     }"},{"DocComment":"     pub fn change_to_none(&mut self) {"},{"DocComment":"         if self.is_some {"},{"DocComment":"             self.is_some = false;"},{"DocComment":"             unsafe {"},{"DocComment":"                 // SAFETY: `value` hasn't been dropped yet, as per the invariant"},{"DocComment":"                 // (This is actually unsound!)"},{"DocComment":"                 ManuallyDrop::drop(&mut self.value);"},{"DocComment":"             }"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let mut option = BadOption::new(Box::new(42));"},{"DocComment":" option.change_to_none();"},{"DocComment":" let option2 = option; // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" #### Deriving traits"},{"DocComment":""},{"DocComment":" Deriving `Debug`, `Clone`, `PartialEq`, `PartialOrd`, `Ord`, or `Hash` on"},{"DocComment":" the struct or enum could be unsound, since the derived implementations of"},{"DocComment":" these traits would access the `ManuallyDrop` field. For example, the"},{"DocComment":" following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" // This derive is unsound in combination with the `ManuallyDrop::drop` call."},{"DocComment":" #[derive(Debug)]"},{"DocComment":" pub struct Foo {"},{"DocComment":"     value: ManuallyDrop<String>,"},{"DocComment":" }"},{"DocComment":" impl Foo {"},{"DocComment":"     pub fn new() -> Self {"},{"DocComment":"         let mut temp = Self {"},{"DocComment":"             value: ManuallyDrop::new(String::from(\"Unsafe rust is hard.\"))"},{"DocComment":"         };"},{"DocComment":"         unsafe {"},{"DocComment":"             // SAFETY: `value` hasn't been dropped yet."},{"DocComment":"             ManuallyDrop::drop(&mut temp.value);"},{"DocComment":"         }"},{"DocComment":"         temp"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let foo = Foo::new();"},{"DocComment":" println!(\"{:?}\", foo); // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [drop order]: https://doc.rust-lang.org/reference/destructors.html"},{"DocComment":" [`mem::zeroed`]: crate::mem::zeroed"},{"DocComment":" [`MaybeUninit<T>`]: crate::mem::MaybeUninit"},{"DocComment":" [`MaybeUninit`]: crate::mem::MaybeUninit"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"manually_drop"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":29,"beg":{"line":162,"col":4},"end":{"line":162,"col":27}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"value","ty":{"HashConsedValue":[2228,{"Adt":{"id":{"Adt":33},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":4,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":33,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_dangling",0]},{"Ident":["MaybeDangling",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":1382}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":30,"beg":{"line":74,"col":0},"end":{"line":74,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Allows wrapped [references] and [boxes] to dangle."},{"DocComment":""},{"DocComment":" That is, if a reference (or a `Box`) is wrapped in `MaybeDangling` (including when in a"},{"DocComment":" (nested) field of a compound type wrapped in `MaybeDangling`), it does not have to follow"},{"DocComment":" pointer aliasing rules or be dereferenceable."},{"DocComment":""},{"DocComment":" This can be useful when the value can become dangling while the function holding it is still"},{"DocComment":" executing (particularly in concurrent code). As a somewhat absurd example, consider this code:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" #![feature(box_as_ptr)]"},{"DocComment":" # use std::alloc::{dealloc, Layout};"},{"DocComment":" # use std::mem;"},{"DocComment":""},{"DocComment":" let mut boxed = Box::new(0_u32);"},{"DocComment":" let ptr = Box::as_mut_ptr(&mut boxed);"},{"DocComment":""},{"DocComment":" // Safety: the pointer comes from a box and thus was allocated before; `box` is not used afterwards"},{"DocComment":" unsafe { dealloc(ptr.cast(), Layout::new::<u32>()) };"},{"DocComment":""},{"DocComment":" mem::forget(boxed); // <-- this is UB!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Even though the `Box`'s destructor is not run (and thus we don't have a double free bug), this"},{"DocComment":" code is still UB. This is because when moving `boxed` into `forget`, its validity invariants"},{"DocComment":" are asserted, causing UB since the `Box` is dangling. The safety comment is as such wrong, as"},{"DocComment":" moving the `boxed` variable as part of the `forget` call *is* a use."},{"DocComment":""},{"DocComment":" To fix this we could use `MaybeDangling`:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" #![feature(maybe_dangling, box_as_ptr)]"},{"DocComment":" # use std::alloc::{dealloc, Layout};"},{"DocComment":" # use std::mem::{self, MaybeDangling};"},{"DocComment":""},{"DocComment":" let mut boxed = MaybeDangling::new(Box::new(0_u32));"},{"DocComment":" let ptr = Box::as_mut_ptr(boxed.as_mut());"},{"DocComment":""},{"DocComment":" // Safety: the pointer comes from a box and thus was allocated before; `box` is not used afterwards"},{"DocComment":" unsafe { dealloc(ptr.cast(), Layout::new::<u32>()) };"},{"DocComment":""},{"DocComment":" mem::forget(boxed); // <-- this is OK!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that the bit pattern must still be valid for the wrapped type. That is, [references]"},{"DocComment":" (and [boxes]) still must be aligned and non-null."},{"DocComment":""},{"DocComment":" Additionally note that safe code can still assume that the inner value in a `MaybeDangling` is"},{"DocComment":" **not** dangling -- functions like [`as_ref`] and [`into_inner`] are safe. It is not sound to"},{"DocComment":" return a dangling reference in a `MaybeDangling` to safe code. However, it *is* sound"},{"DocComment":" to hold such values internally inside your code -- and there's no way to do that without"},{"DocComment":" this type. Note that other types can use this type and thus get the same effect; in particular,"},{"DocComment":" [`ManuallyDrop`] will use `MaybeDangling`."},{"DocComment":""},{"DocComment":" Note that `MaybeDangling` doesn't prevent drops from being run, which can lead to UB if the"},{"DocComment":" drop observes a dangling value. If you need to prevent drops from being run use [`ManuallyDrop`]"},{"DocComment":" instead."},{"DocComment":""},{"DocComment":" [references]: prim@reference"},{"DocComment":" [boxes]: ../../std/boxed/struct.Box.html"},{"DocComment":" [`into_inner`]: MaybeDangling::into_inner"},{"DocComment":" [`as_ref`]: MaybeDangling::as_ref"},{"DocComment":" [`ManuallyDrop`]: crate::mem::ManuallyDrop"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"maybe_dangling"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":30,"beg":{"line":74,"col":36},"end":{"line":74,"col":37}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":null,"ty":{"Deduplicated":1382}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":4,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":34,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_uninit",0]},{"Ident":["MaybeUninit",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":1585}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":24,"beg":{"line":355,"col":0},"end":{"line":355,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper type to construct uninitialized instances of `T`."},{"DocComment":""},{"DocComment":" # Initialization invariant"},{"DocComment":""},{"DocComment":" The compiler, in general, assumes that a variable is [properly initialized or \"valid\"][validity]"},{"DocComment":" according to the requirements of the variable's type. For example, a variable of"},{"DocComment":" reference type must be aligned and non-null. This is an invariant that must"},{"DocComment":" *always* be upheld, even in unsafe code. As a consequence, zero-initializing a"},{"DocComment":" variable of reference type causes instantaneous undefined behavior,"},{"DocComment":" no matter whether that reference ever gets used to access memory:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let x: &i32 = unsafe { mem::zeroed() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<&i32>`:"},{"DocComment":" let x: &i32 = unsafe { MaybeUninit::zeroed().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This is exploited by the compiler for various optimizations, such as eliding"},{"DocComment":" run-time checks and optimizing `enum` layout."},{"DocComment":""},{"DocComment":" Similarly, entirely uninitialized memory may have any content, while a `bool` must"},{"DocComment":" always be `true` or `false`. Hence, creating an uninitialized `bool` is undefined behavior:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let b: bool = unsafe { mem::uninitialized() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<bool>`:"},{"DocComment":" let b: bool = unsafe { MaybeUninit::uninit().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Moreover, uninitialized memory is special in that it does not have a fixed value (\"fixed\""},{"DocComment":" meaning \"it won't change without being written to\"). Reading the same uninitialized byte"},{"DocComment":" multiple times can give different results. This makes it undefined behavior to have"},{"DocComment":" uninitialized data in a variable even if that variable has an integer type, which otherwise can"},{"DocComment":" hold any *fixed* bit pattern:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let x: i32 = unsafe { mem::uninitialized() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<i32>`:"},{"DocComment":" let x: i32 = unsafe { MaybeUninit::uninit().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Conversely, sometimes it is okay to not initialize *all* bytes of a `MaybeUninit`"},{"DocComment":" before calling `assume_init`. For instance, padding bytes do not have to be initialized."},{"DocComment":" See the field-by-field struct initialization example below for a case of that."},{"DocComment":""},{"DocComment":" On top of that, remember that most types have additional invariants beyond merely"},{"DocComment":" being considered initialized at the type level. For example, a `1`-initialized [`Vec<T>`]"},{"DocComment":" is considered initialized (under the current implementation; this does not constitute"},{"DocComment":" a stable guarantee) because the only requirement the compiler knows about it"},{"DocComment":" is that the data pointer must be non-null. Creating such a `Vec<T>` does not cause"},{"DocComment":" *immediate* undefined behavior, but will cause undefined behavior with most"},{"DocComment":" safe operations (including dropping it)."},{"DocComment":""},{"DocComment":" [`Vec<T>`]: ../../std/vec/struct.Vec.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` serves to enable unsafe code to deal with uninitialized data."},{"DocComment":" It is a signal to the compiler indicating that the data here might *not*"},{"DocComment":" be initialized:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" // Create an explicitly uninitialized reference. The compiler knows that data inside"},{"DocComment":" // a `MaybeUninit<T>` may be invalid, and hence this is not UB:"},{"DocComment":" let mut x = MaybeUninit::<&i32>::uninit();"},{"DocComment":" // Set it to a valid value."},{"DocComment":" x.write(&0);"},{"DocComment":" // Extract the initialized data -- this is only allowed *after* properly"},{"DocComment":" // initializing `x`!"},{"DocComment":" let x = unsafe { x.assume_init() };"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The compiler then knows to not make any incorrect assumptions or optimizations on this code."},{"DocComment":""},{"DocComment":" You can think of `MaybeUninit<T>` as being a bit like `Option<T>` but without"},{"DocComment":" any of the run-time tracking and without any of the safety checks."},{"DocComment":""},{"DocComment":" ## out-pointers"},{"DocComment":""},{"DocComment":" You can use `MaybeUninit<T>` to implement \"out-pointers\": instead of returning data"},{"DocComment":" from a function, pass it a pointer to some (uninitialized) memory to put the"},{"DocComment":" result into. This can be useful when it is important for the caller to control"},{"DocComment":" how the memory the result is stored in gets allocated, and you want to avoid"},{"DocComment":" unnecessary moves."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" unsafe fn make_vec(out: *mut Vec<i32>) {"},{"DocComment":"     // `write` does not drop the old contents, which is important."},{"DocComment":"     unsafe { out.write(vec![1, 2, 3]); }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut v = MaybeUninit::uninit();"},{"DocComment":" unsafe { make_vec(v.as_mut_ptr()); }"},{"DocComment":" // Now we know `v` is initialized! This also makes sure the vector gets"},{"DocComment":" // properly dropped."},{"DocComment":" let v = unsafe { v.assume_init() };"},{"DocComment":" assert_eq!(&v, &[1, 2, 3]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Initializing an array element-by-element"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` can be used to initialize a large array element-by-element:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let data = {"},{"DocComment":"     // Create an uninitialized array of `MaybeUninit`."},{"DocComment":"     let mut data: [MaybeUninit<Vec<u32>>; 1000] = [const { MaybeUninit::uninit() }; 1000];"},{"DocComment":""},{"DocComment":"     // Dropping a `MaybeUninit` does nothing, so if there is a panic during this loop,"},{"DocComment":"     // we have a memory leak, but there is no memory safety issue."},{"DocComment":"     for elem in &mut data[..] {"},{"DocComment":"         elem.write(vec![42]);"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     // Everything is initialized. Transmute the array to the"},{"DocComment":"     // initialized type."},{"DocComment":"     unsafe { mem::transmute::<_, [Vec<u32>; 1000]>(data) }"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" assert_eq!(&data[0], &[42]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also work with partially initialized arrays, which could"},{"DocComment":" be found in low-level datastructures."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" // Create an uninitialized array of `MaybeUninit`."},{"DocComment":" let mut data: [MaybeUninit<String>; 1000] = [const { MaybeUninit::uninit() }; 1000];"},{"DocComment":" // Count the number of elements we have assigned."},{"DocComment":" let mut data_len: usize = 0;"},{"DocComment":""},{"DocComment":" for elem in &mut data[0..500] {"},{"DocComment":"     elem.write(String::from(\"hello\"));"},{"DocComment":"     data_len += 1;"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // For each item in the array, drop if we allocated it."},{"DocComment":" for elem in &mut data[0..data_len] {"},{"DocComment":"     unsafe { elem.assume_init_drop(); }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Initializing a struct field-by-field"},{"DocComment":""},{"DocComment":" You can use `MaybeUninit<T>` and the [`&raw mut`] syntax to initialize structs field by field:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" pub struct Foo {"},{"DocComment":"     name: String,"},{"DocComment":"     list: Vec<u8>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let foo = {"},{"DocComment":"     let mut uninit: MaybeUninit<Foo> = MaybeUninit::uninit();"},{"DocComment":"     let ptr = uninit.as_mut_ptr();"},{"DocComment":""},{"DocComment":"     // Initializing the `name` field"},{"DocComment":"     // Using `write` instead of assignment via `=` to not call `drop` on the"},{"DocComment":"     // old, uninitialized value."},{"DocComment":"     unsafe { (&raw mut (*ptr).name).write(\"Bob\".to_string()); }"},{"DocComment":""},{"DocComment":"     // Initializing the `list` field"},{"DocComment":"     // If there is a panic here, then the `String` in the `name` field leaks."},{"DocComment":"     unsafe { (&raw mut (*ptr).list).write(vec![0, 1, 2]); }"},{"DocComment":""},{"DocComment":"     // All the fields are initialized, so we call `assume_init` to get an initialized Foo."},{"DocComment":"     unsafe { uninit.assume_init() }"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     foo,"},{"DocComment":"     Foo {"},{"DocComment":"         name: \"Bob\".to_string(),"},{"DocComment":"         list: vec![0, 1, 2]"},{"DocComment":"     }"},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":" [`&raw mut`]: https://doc.rust-lang.org/reference/types/pointer.html#r-type.pointer.raw.constructor"},{"DocComment":" [validity]: ../../reference/behavior-considered-undefined.html#r-undefined.validity"},{"DocComment":""},{"DocComment":" Note that we have not initialized the padding, but that's fine -- it does not have to be"},{"DocComment":" initialized. In fact, even if we had initialized the padding in `uninit`, those bytes would be"},{"DocComment":" lost when copying the result: no matter the contents of the padding bytes in `uninit`, they will"},{"DocComment":" always be uninitialized in `foo`."},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` is guaranteed to have the same size, alignment, and ABI as `T`:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":" assert_eq!(size_of::<MaybeUninit<u64>>(), size_of::<u64>());"},{"DocComment":" assert_eq!(align_of::<MaybeUninit<u64>>(), align_of::<u64>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However remember that a type *containing* a `MaybeUninit<T>` is not necessarily the same"},{"DocComment":" layout; Rust does not in general guarantee that the fields of a `Foo<T>` have the same order as"},{"DocComment":" a `Foo<U>` even if `T` and `U` have the same size and alignment. Furthermore because any bit"},{"DocComment":" value is valid for a `MaybeUninit<T>` the compiler can't apply non-zero/niche-filling"},{"DocComment":" optimizations, potentially resulting in a larger size:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" # use std::mem::MaybeUninit;"},{"DocComment":" assert_eq!(size_of::<Option<bool>>(), 1);"},{"DocComment":" assert_eq!(size_of::<Option<MaybeUninit<bool>>>(), 2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If `T` is FFI-safe, then so is `MaybeUninit<T>`."},{"DocComment":""},{"DocComment":" While `MaybeUninit` is `#[repr(transparent)]` (indicating it guarantees the same size,"},{"DocComment":" alignment, and ABI as `T`), this does *not* change any of the previous caveats. `Option<T>` and"},{"DocComment":" `Option<MaybeUninit<T>>` may still have different sizes, and types containing a field of type"},{"DocComment":" `T` may be laid out (and sized) differently than if that field were `MaybeUninit<T>`."},{"DocComment":" `MaybeUninit` is a union type, and `#[repr(transparent)]` on unions is unstable (see [the"},{"DocComment":" tracking issue](https://github.com/rust-lang/rust/issues/60405)). Over time, the exact"},{"DocComment":" guarantees of `#[repr(transparent)]` on unions may evolve, and `MaybeUninit` may or may not"},{"DocComment":" remain `#[repr(transparent)]`. That said, `MaybeUninit<T>` will *always* guarantee that it has"},{"DocComment":" the same size, alignment, and ABI as `T`; it's just that the way `MaybeUninit` implements that"},{"DocComment":" guarantee may evolve."},{"DocComment":""},{"DocComment":" Note that even though `T` and `MaybeUninit<T>` are ABI compatible it is still unsound to"},{"DocComment":" transmute `&mut T` to `&mut MaybeUninit<T>` and expose that to safe code because it would allow"},{"DocComment":" safe code to access uninitialized memory:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use core::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" fn unsound_transmute<T>(val: &mut T) -> &mut MaybeUninit<T> {"},{"DocComment":"     unsafe { core::mem::transmute(val) }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let mut code = 0;"},{"DocComment":"     let code = &mut code;"},{"DocComment":"     let code2 = unsound_transmute(code);"},{"DocComment":"     *code2 = MaybeUninit::uninit();"},{"DocComment":"     std::process::exit(*code); // UB! Accessing uninitialized memory."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Validity"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` has no validity requirements – any sequence of [bytes] of"},{"DocComment":" the appropriate length, initialized or uninitialized, are a valid"},{"DocComment":" representation."},{"DocComment":""},{"DocComment":" Moving or copying a value of type `MaybeUninit<T>` (i.e., performing a"},{"DocComment":" \"typed copy\") will exactly preserve the contents, including the"},{"DocComment":" [provenance], of all non-padding bytes of type `T` in the value's"},{"DocComment":" representation."},{"DocComment":""},{"DocComment":" Therefore `MaybeUninit` can be used to perform a round trip of a value from"},{"DocComment":" type `T` to type `MaybeUninit<U>` then back to type `T`, while preserving"},{"DocComment":" the original value, if two conditions are met. One, type `U` must have the"},{"DocComment":" same size as type `T`. Two, for all byte offsets where type `U` has padding,"},{"DocComment":" the corresponding bytes in the representation of the value must be"},{"DocComment":" uninitialized."},{"DocComment":""},{"DocComment":" For example, due to the fact that the type `[u8; size_of::<T>]` has no"},{"DocComment":" padding, the following is sound for any type `T` and will return the"},{"DocComment":" original value:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" # struct T;"},{"DocComment":" fn identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         let u: MaybeUninit<[u8; size_of::<T>()]> = transmute(t);"},{"DocComment":"         transmute(u) // OK."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note: Copying a value that contains references may implicitly reborrow them"},{"DocComment":" causing the provenance of the returned value to differ from that of the"},{"DocComment":" original. This applies equally to the trivial identity function:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" fn trivial_identity<T>(t: T) -> T { t }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note: Moving or copying a value whose representation has initialized bytes"},{"DocComment":" at byte offsets where the type has padding may lose the value of those"},{"DocComment":" bytes, so while the original value will be preserved, the original"},{"DocComment":" *representation* of that value as bytes may not be. Again, this applies"},{"DocComment":" equally to `trivial_identity`."},{"DocComment":""},{"DocComment":" Note: Performing this round trip when type `U` has padding at byte offsets"},{"DocComment":" where the representation of the original value has initialized bytes may"},{"DocComment":" produce undefined behavior or a different value. For example, the following"},{"DocComment":" is unsound since `T` requires all bytes to be initialized:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" #[repr(C)] struct T([u8; 4]);"},{"DocComment":" #[repr(C)] struct U(u8, u16);"},{"DocComment":" fn unsound_identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         let u: MaybeUninit<U> = transmute(t);"},{"DocComment":"         transmute(u) // UB."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Conversely, the following is sound since `T` allows uninitialized bytes in"},{"DocComment":" the representation of a value, but the round trip may alter the value:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" #[repr(C)] struct T(MaybeUninit<[u8; 4]>);"},{"DocComment":" #[repr(C)] struct U(u8, u16);"},{"DocComment":" fn non_identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         // May lose an initialized byte."},{"DocComment":"         let u: MaybeUninit<U> = transmute(t);"},{"DocComment":"         transmute(u)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [bytes]: ../../reference/memory-model.html#bytes"},{"DocComment":" [provenance]: crate::ptr#provenance"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"maybe_uninit"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Union":[{"span":{"data":{"file_id":24,"beg":{"line":356,"col":4},"end":{"line":356,"col":14}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"uninit","ty":{"Deduplicated":1930}},{"span":{"data":{"file_id":24,"beg":{"line":357,"col":4},"end":{"line":357,"col":26}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"value","ty":{"HashConsedValue":[2294,{"Adt":{"id":{"Adt":36},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":32,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":35,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["Guard",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":["Erased"],"types":[{"Deduplicated":1585}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":16,"beg":{"line":934,"col":0},"end":{"line":934,"col":19}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":16,"beg":{"line":936,"col":4},"end":{"line":936,"col":43}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"array_mut","ty":{"HashConsedValue":[4182,{"Ref":["Erased",{"HashConsedValue":[2276,{"Slice":{"Deduplicated":2271}}]},"Mut"]}]}},{"span":{"data":{"file_id":16,"beg":{"line":938,"col":4},"end":{"line":938,"col":26}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"initialized","ty":{"Deduplicated":1581}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,16],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":36,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["manually_drop",0]},{"Ident":["ManuallyDrop",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":1585}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":29,"beg":{"line":161,"col":0},"end":{"line":161,"col":34}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper to inhibit the compiler from automatically calling `T`’s"},{"DocComment":" destructor. This wrapper is 0-cost."},{"DocComment":""},{"DocComment":" `ManuallyDrop<T>` is guaranteed to have the same layout and bit validity as"},{"DocComment":" `T`, and is subject to the same layout optimizations as `T`. As a"},{"DocComment":" consequence, it has *no effect* on the assumptions that the compiler makes"},{"DocComment":" about its contents. For example, initializing a `ManuallyDrop<&mut T>` with"},{"DocComment":" [`mem::zeroed`] is undefined behavior. If you need to handle uninitialized"},{"DocComment":" data, use [`MaybeUninit<T>`] instead."},{"DocComment":""},{"DocComment":" Note that accessing the value inside a `ManuallyDrop<T>` is safe. This means"},{"DocComment":" that a `ManuallyDrop<T>` whose content has been dropped must not be exposed"},{"DocComment":" through a public safe API. Correspondingly, `ManuallyDrop::drop` is unsafe."},{"DocComment":""},{"DocComment":" # `ManuallyDrop` and drop order"},{"DocComment":""},{"DocComment":" Rust has a well-defined [drop order] of values. To make sure that fields or"},{"DocComment":" locals are dropped in a specific order, reorder the declarations such that"},{"DocComment":" the implicit drop order is the correct one."},{"DocComment":""},{"DocComment":" It is possible to use `ManuallyDrop` to control the drop order, but this"},{"DocComment":" requires unsafe code and is hard to do correctly in the presence of"},{"DocComment":" unwinding."},{"DocComment":""},{"DocComment":" For example, if you want to make sure that a specific field is dropped after"},{"DocComment":" the others, make it the last field of a struct:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct Context;"},{"DocComment":""},{"DocComment":" struct Widget {"},{"DocComment":"     children: Vec<Widget>,"},{"DocComment":"     // `context` will be dropped after `children`."},{"DocComment":"     // Rust guarantees that fields are dropped in the order of declaration."},{"DocComment":"     context: Context,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Interaction with `Box`"},{"DocComment":""},{"DocComment":" Currently, if you have a `ManuallyDrop<T>`, where the type `T` is a `Box` or"},{"DocComment":" contains a `Box` inside, then dropping the `T` followed by moving the"},{"DocComment":" `ManuallyDrop<T>` is [considered to be undefined"},{"DocComment":" behavior](https://github.com/rust-lang/unsafe-code-guidelines/issues/245)."},{"DocComment":" That is, the following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" let mut x = ManuallyDrop::new(Box::new(42));"},{"DocComment":" unsafe {"},{"DocComment":"     ManuallyDrop::drop(&mut x);"},{"DocComment":" }"},{"DocComment":" let y = x; // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This is [likely to change in the"},{"DocComment":" future](https://rust-lang.github.io/rfcs/3336-maybe-dangling.html). In the"},{"DocComment":" meantime, consider using [`MaybeUninit`] instead."},{"DocComment":""},{"DocComment":" # Safety hazards when storing `ManuallyDrop` in a struct or an enum."},{"DocComment":""},{"DocComment":" Special care is needed when all of the conditions below are met:"},{"DocComment":" * A struct or enum contains a `ManuallyDrop`."},{"DocComment":" * The `ManuallyDrop` is not inside a `union`."},{"DocComment":" * The struct or enum is part of public API, or is stored in a struct or an"},{"DocComment":"   enum that is part of public API."},{"DocComment":" * There is code that drops the contents of the `ManuallyDrop` field, and"},{"DocComment":"   this code is outside the struct or enum's `Drop` implementation."},{"DocComment":""},{"DocComment":" In particular, the following hazards may occur:"},{"DocComment":""},{"DocComment":" #### Storing generic types"},{"DocComment":""},{"DocComment":" If the `ManuallyDrop` contains a client-supplied generic type, the client"},{"DocComment":" might provide a `Box` as that type. This would cause undefined behavior when"},{"DocComment":" the struct or enum is later moved, as mentioned in the previous section. For"},{"DocComment":" example, the following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" pub struct BadOption<T> {"},{"DocComment":"     // Invariant: Has been dropped if `is_some` is false."},{"DocComment":"     value: ManuallyDrop<T>,"},{"DocComment":"     is_some: bool,"},{"DocComment":" }"},{"DocComment":" impl<T> BadOption<T> {"},{"DocComment":"     pub fn new(value: T) -> Self {"},{"DocComment":"         Self { value: ManuallyDrop::new(value), is_some: true }"},{"DocComment":"     }"},{"DocComment":"     pub fn change_to_none(&mut self) {"},{"DocComment":"         if self.is_some {"},{"DocComment":"             self.is_some = false;"},{"DocComment":"             unsafe {"},{"DocComment":"                 // SAFETY: `value` hasn't been dropped yet, as per the invariant"},{"DocComment":"                 // (This is actually unsound!)"},{"DocComment":"                 ManuallyDrop::drop(&mut self.value);"},{"DocComment":"             }"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let mut option = BadOption::new(Box::new(42));"},{"DocComment":" option.change_to_none();"},{"DocComment":" let option2 = option; // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" #### Deriving traits"},{"DocComment":""},{"DocComment":" Deriving `Debug`, `Clone`, `PartialEq`, `PartialOrd`, `Ord`, or `Hash` on"},{"DocComment":" the struct or enum could be unsound, since the derived implementations of"},{"DocComment":" these traits would access the `ManuallyDrop` field. For example, the"},{"DocComment":" following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" // This derive is unsound in combination with the `ManuallyDrop::drop` call."},{"DocComment":" #[derive(Debug)]"},{"DocComment":" pub struct Foo {"},{"DocComment":"     value: ManuallyDrop<String>,"},{"DocComment":" }"},{"DocComment":" impl Foo {"},{"DocComment":"     pub fn new() -> Self {"},{"DocComment":"         let mut temp = Self {"},{"DocComment":"             value: ManuallyDrop::new(String::from(\"Unsafe rust is hard.\"))"},{"DocComment":"         };"},{"DocComment":"         unsafe {"},{"DocComment":"             // SAFETY: `value` hasn't been dropped yet."},{"DocComment":"             ManuallyDrop::drop(&mut temp.value);"},{"DocComment":"         }"},{"DocComment":"         temp"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let foo = Foo::new();"},{"DocComment":" println!(\"{:?}\", foo); // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [drop order]: https://doc.rust-lang.org/reference/destructors.html"},{"DocComment":" [`mem::zeroed`]: crate::mem::zeroed"},{"DocComment":" [`MaybeUninit<T>`]: crate::mem::MaybeUninit"},{"DocComment":" [`MaybeUninit`]: crate::mem::MaybeUninit"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"manually_drop"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":29,"beg":{"line":162,"col":4},"end":{"line":162,"col":27}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"value","ty":{"HashConsedValue":[2296,{"Adt":{"id":{"Adt":37},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":32,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":37,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_dangling",0]},{"Ident":["MaybeDangling",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":1585}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":30,"beg":{"line":74,"col":0},"end":{"line":74,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Allows wrapped [references] and [boxes] to dangle."},{"DocComment":""},{"DocComment":" That is, if a reference (or a `Box`) is wrapped in `MaybeDangling` (including when in a"},{"DocComment":" (nested) field of a compound type wrapped in `MaybeDangling`), it does not have to follow"},{"DocComment":" pointer aliasing rules or be dereferenceable."},{"DocComment":""},{"DocComment":" This can be useful when the value can become dangling while the function holding it is still"},{"DocComment":" executing (particularly in concurrent code). As a somewhat absurd example, consider this code:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" #![feature(box_as_ptr)]"},{"DocComment":" # use std::alloc::{dealloc, Layout};"},{"DocComment":" # use std::mem;"},{"DocComment":""},{"DocComment":" let mut boxed = Box::new(0_u32);"},{"DocComment":" let ptr = Box::as_mut_ptr(&mut boxed);"},{"DocComment":""},{"DocComment":" // Safety: the pointer comes from a box and thus was allocated before; `box` is not used afterwards"},{"DocComment":" unsafe { dealloc(ptr.cast(), Layout::new::<u32>()) };"},{"DocComment":""},{"DocComment":" mem::forget(boxed); // <-- this is UB!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Even though the `Box`'s destructor is not run (and thus we don't have a double free bug), this"},{"DocComment":" code is still UB. This is because when moving `boxed` into `forget`, its validity invariants"},{"DocComment":" are asserted, causing UB since the `Box` is dangling. The safety comment is as such wrong, as"},{"DocComment":" moving the `boxed` variable as part of the `forget` call *is* a use."},{"DocComment":""},{"DocComment":" To fix this we could use `MaybeDangling`:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" #![feature(maybe_dangling, box_as_ptr)]"},{"DocComment":" # use std::alloc::{dealloc, Layout};"},{"DocComment":" # use std::mem::{self, MaybeDangling};"},{"DocComment":""},{"DocComment":" let mut boxed = MaybeDangling::new(Box::new(0_u32));"},{"DocComment":" let ptr = Box::as_mut_ptr(boxed.as_mut());"},{"DocComment":""},{"DocComment":" // Safety: the pointer comes from a box and thus was allocated before; `box` is not used afterwards"},{"DocComment":" unsafe { dealloc(ptr.cast(), Layout::new::<u32>()) };"},{"DocComment":""},{"DocComment":" mem::forget(boxed); // <-- this is OK!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that the bit pattern must still be valid for the wrapped type. That is, [references]"},{"DocComment":" (and [boxes]) still must be aligned and non-null."},{"DocComment":""},{"DocComment":" Additionally note that safe code can still assume that the inner value in a `MaybeDangling` is"},{"DocComment":" **not** dangling -- functions like [`as_ref`] and [`into_inner`] are safe. It is not sound to"},{"DocComment":" return a dangling reference in a `MaybeDangling` to safe code. However, it *is* sound"},{"DocComment":" to hold such values internally inside your code -- and there's no way to do that without"},{"DocComment":" this type. Note that other types can use this type and thus get the same effect; in particular,"},{"DocComment":" [`ManuallyDrop`] will use `MaybeDangling`."},{"DocComment":""},{"DocComment":" Note that `MaybeDangling` doesn't prevent drops from being run, which can lead to UB if the"},{"DocComment":" drop observes a dangling value. If you need to prevent drops from being run use [`ManuallyDrop`]"},{"DocComment":" instead."},{"DocComment":""},{"DocComment":" [references]: prim@reference"},{"DocComment":" [boxes]: ../../std/boxed/struct.Box.html"},{"DocComment":" [`into_inner`]: MaybeDangling::into_inner"},{"DocComment":" [`as_ref`]: MaybeDangling::as_ref"},{"DocComment":" [`ManuallyDrop`]: crate::mem::ManuallyDrop"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"maybe_dangling"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":30,"beg":{"line":74,"col":36},"end":{"line":74,"col":37}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":null,"ty":{"Deduplicated":1585}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":32,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":38,"item_meta":{"name":[{"Ident":["aspis_statement",0]},{"Ident":["pool_v1",0]},{"Ident":["pair_trace",0]},{"Ident":["PoolV1PairInputNoteWitnessV1",0]}],"span":{"data":{"file_id":14,"beg":{"line":72,"col":0},"end":{"line":72,"col":39}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Input-note witness for a depth-21 pair tree. `membership` is the twenty"},{"DocComment":" upper pair-tree levels; `selected_second` is the private bottom direction."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"region