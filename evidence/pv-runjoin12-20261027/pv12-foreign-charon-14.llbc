DocComment":""},{"DocComment":" let v_cloned: Vec<_> = a.iter().cloned().collect();"},{"DocComment":""},{"DocComment":" // cloned is the same as .map(|&x| x), for integers"},{"DocComment":" let v_map: Vec<_> = a.iter().map(|&x| x).collect();"},{"DocComment":""},{"DocComment":" assert_eq!(v_cloned, [1, 2, 3]);"},{"DocComment":" assert_eq!(v_map, [1, 2, 3]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" To get the best performance, try to clone late:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [vec![0_u8, 1, 2], vec![3, 4], vec![23]];"},{"DocComment":" // don't do this:"},{"DocComment":" let slower: Vec<_> = a.iter().cloned().filter(|s| s.len() == 1).collect();"},{"DocComment":" assert_eq!(&[vec![23]], &slower[..]);"},{"DocComment":" // instead call `cloned` late"},{"DocComment":" let faster: Vec<_> = a.iter().filter(|s| s.len() == 1).cloned().collect();"},{"DocComment":" assert_eq!(&[vec![23]], &faster[..]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"iter_cloned"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034}],"output":{"Deduplicated":31796}},"default":{"id":71,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":3141}],"const_generics":[],"trait_refs":[{"Deduplicated":31768},{"HashConsedValue":[4707,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":1723}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":31795},{"Deduplicated":3614}]}}},"kind":{"TraitMethod":[1,57]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":20,"beg":{"line":3592,"col":22},"end":{"line":3592,"col":35}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":8,"generics"