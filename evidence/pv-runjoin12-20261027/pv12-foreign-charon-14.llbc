"},{"DocComment":""},{"DocComment":" Note that the [`Fuse`] wrapper is a no-op on iterators that implement"},{"DocComment":" the [`FusedIterator`] trait. `fuse()` may therefore behave incorrectly"},{"DocComment":" if the [`FusedIterator`] trait is improperly implemented."},{"DocComment":""},{"DocComment":" [`Some(T)`]: Some"},{"DocComment":" [`FusedIterator`]: crate::iter::FusedIterator"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // an iterator which alternates between Some and None"},{"DocComment":" struct Alternate {"},{"DocComment":"     state: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Iterator for Alternate {"},{"DocComment":"     type Item = i32;"},{"DocComment":""},{"DocComment":"     fn next(&mut self) -> Option<i32> {"},{"DocComment":"         let val = self.state;"},{"DocComment":"         self.state = self.state + 1;"},{"DocComment":""},{"DocComment":"         // if it's even, Some(i32), else None"},{"DocComment":"         (val % 2 == 0).then_some(val)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut iter = Alternate { state: 0 };"},{"DocComment":""},{"DocComment":" // we can see our iterator going back and forth"},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":""},{"DocComment":" // however, once we fuse it..."},{"DocComment":" let mut iter = iter.fuse();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":""},{"DocComment":" // it will always return `None` after the first time."},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":