omment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3, 4];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().scan(1, |state, x| {"},{"DocComment":"     // each iteration, we'll multiply the state by the element ..."},{"DocComment":"     *state = *state * x;"},{"DocComment":""},{"DocComment":"     // ... and terminate if the state exceeds 6"},{"DocComment":"     if *state > 6 {"},{"DocComment":"         return None;"},{"DocComment":"     }"},{"DocComment":"     // ... else yield the negation of the state"},{"DocComment":"     Some(-*state)"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(-1));"},{"DocComment":" assert_eq!(iter.next(), Some(-2));"},{"DocComment":" assert_eq!(iter.next(), Some(-6));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"St"},{"index":2,"name":"B"},{"index":3,"name":"F"},{"index":4,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":31048}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":20,"beg":{"line":1497,"col":11},"end":{"line":1497,"col":50}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":31050},{"HashConsedValue":[31905,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"HashConsedValue":[31904,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":31037},"Mut"]}]},{"Deduplicate