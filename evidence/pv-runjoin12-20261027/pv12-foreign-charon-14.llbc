ent":" ```"},{"DocComment":""},{"DocComment":" This also supports other types which implement [`Try`], not just [`Result`]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(try_find)]"},{"DocComment":""},{"DocComment":" use std::num::NonZero;"},{"DocComment":""},{"DocComment":" let a = [3, 5, 7, 4, 9, 0, 11u32];"},{"DocComment":" let result = a.into_iter().try_find(|&x| NonZero::new(x).map(|y| y.is_power_of_two()));"},{"DocComment":" assert_eq!(result, Some(Some(4)));"},{"DocComment":" let result = a.into_iter().take(3).try_find(|&x| NonZero::new(x).map(|y| y.is_power_of_two()));"},{"DocComment":" assert_eq!(result, Some(None));"},{"DocComment":" let result = a.into_iter().rev().try_find(|&x| NonZero::new(x).map(|y| y.is_power_of_two()));"},{"DocComment":" assert_eq!(result, None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31764},{"Deduplicated":3141}],"output":{"Deduplicated":3527}},"default":{"id":59,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":3141},{"Deduplicated":31037},{"Deduplicated":3527}],"const_generics":[],"trait_refs":[{"Deduplicated":31768},{"Deduplicated":4175},{"Deduplicated":31373},{"HashConsedValue":[31375,{"kind":{"Clause":{"Bound":[0,2]}},"trait_decl_ref":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":3131},{"Deduplicated":31343},{"Deduplicated":1723}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":3858},{"Deduplicated":3927}]}}},"kind":{"TraitMethod":[1,45]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"P"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":20,"beg":{"line":3137,"col":11},"end":{"line":3137,