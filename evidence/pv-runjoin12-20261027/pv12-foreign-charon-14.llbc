":[{"DocComment":" Searches for an element of an iterator that satisfies a predicate."},{"DocComment":""},{"DocComment":" `find()` takes a closure that returns `true` or `false`. It applies"},{"DocComment":" this closure to each element of the iterator, and if any of them return"},{"DocComment":" `true`, then `find()` returns [`Some(element)`]. If they all return"},{"DocComment":" `false`, it returns [`None`]."},{"DocComment":""},{"DocComment":" `find()` is short-circuiting; in other words, it will stop processing"},{"DocComment":" as soon as the closure returns `true`."},{"DocComment":""},{"DocComment":" Because `find()` takes a reference, and many iterators iterate over"},{"DocComment":" references, this leads to a possibly confusing situation where the"},{"DocComment":" argument is a double reference. You can see this effect in the"},{"DocComment":" examples below, with `&&x`."},{"DocComment":""},{"DocComment":" If you need the index of the element, see [`position()`]."},{"DocComment":""},{"DocComment":" [`Some(element)`]: Some"},{"DocComment":" [`position()`]: Iterator::position"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert_eq!(a.into_iter().find(|&x| x == 2), Some(2));"},{"DocComment":" assert_eq!(a.into_iter().find(|&x| x == 5), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Iterating over references:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" // `iter()` yields references i.e. `&i32` and `find()` takes a"},{"DocComment":" // reference to each element."},{"DocComment":" assert_eq!(a.iter().find(|&&x| x == 2), Some(&2));"},{"DocComment":" assert_eq!(a.iter().find(|&&x| x == 5), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `true`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.find(|&x| x == 2), Some(2));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that `iter.find(f)` is equivalent to `iter.filter(f).next()`."}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"P"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":31044}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":20,"beg":{"line":2962,"col":11},"end":{"line":2962,"col":37}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":31037},{"Deduplicated":31898},{"Deduplicated":1681}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":31037}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31073},{"Deduplicated":31037}],"output":{"Deduplicated":31045}},"src":{"TraitDecl