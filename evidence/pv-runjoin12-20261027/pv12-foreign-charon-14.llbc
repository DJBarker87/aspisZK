t":" Creates an iterator which copies all of its elements."},{"DocComment":""},{"DocComment":" This is useful when you have an iterator over `&T`, but you need an"},{"DocComment":" iterator over `T`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let v_copied: Vec<_> = a.iter().copied().collect();"},{"DocComment":""},{"DocComment":" // copied is the same as .map(|&x| x)"},{"DocComment":" let v_map: Vec<_> = a.iter().map(|&x| x).collect();"},{"DocComment":""},{"DocComment":" assert_eq!(v_copied, [1, 2, 3]);"},{"DocComment":" assert_eq!(v_map, [1, 2, 3]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"iter_copied"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034}],"output":{"Deduplicated":31794}},"default":{"id":70,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":3141}],"const_generics":[],"trait_refs":[{"Deduplicated":31768},{"HashConsedValue":[4682,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":1723}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[31795,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":3131}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":3614}]}}},"kind":{"TraitMethod":[1,56]}},{"params":{"regions":[{"index":0,"name":"'a","mutability":"Unknown"}],"types":[{"index":0,"name":"T"},{"index":1,"name":"Clause1_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":20,"beg":{"line":3561,"col":11},"end":{"line":3561,"col":16}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[