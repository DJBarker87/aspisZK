{"Ident":["partition",0]}],"span":{"data":{"file_id":20,"beg":{"line":2271,"col":4},"end":{"line":2275,"col":38}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Consumes an iterator, creating two collections from it."},{"DocComment":""},{"DocComment":" The predicate passed to `partition()` can return `true`, or `false`."},{"DocComment":" `partition()` returns a pair, all of the elements for which it returned"},{"DocComment":" `true`, and all of the elements for which it returned `false`."},{"DocComment":""},{"DocComment":" See also [`is_partitioned()`] and [`partition_in_place()`]."},{"DocComment":""},{"DocComment":" [`is_partitioned()`]: Iterator::is_partitioned"},{"DocComment":" [`partition_in_place()`]: Iterator::partition_in_place"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let (even, odd): (Vec<_>, Vec<_>) = a"},{"DocComment":"     .into_iter()"},{"DocComment":"     .partition(|n| n % 2 == 0);"},{"DocComment":""},{"DocComment":" assert_eq!(even, [2]);"},{"DocComment":" assert_eq!(odd, [1, 3]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034},{"Deduplicated":3141}],"output":{"HashConsedValue":[3923,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":1725},{"Deduplicated":1725}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":47,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":3141},{"Deduplicated":31037}],"const_generics":[],"trait_refs":[{"Deduplicated":31768},{"HashConsedValue":[3924,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":1723}],"const_generics":[],"trait_refs"