ght panic if the iterator has more than `usize::MAX`"},{"DocComment":" non-matching elements."},{"DocComment":""},{"DocComment":" [`Some(index)`]: Some"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert_eq!(a.into_iter().position(|x| x == 2), Some(1));"},{"DocComment":""},{"DocComment":" assert_eq!(a.into_iter().position(|x| x == 5), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `true`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3, 4];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.position(|x| x >= 2), Some(1));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":""},{"DocComment":" // The returned index depends on iterator state"},{"DocComment":" assert_eq!(iter.position(|x| x == 4), Some(0));"},{"DocComment":""},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31764},{"Deduplicated":1725}],"output":{"Deduplicated":28355}},"default":{"id":60,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":31037}],"const_generics":[],"trait_refs":[{"Deduplicated":31768},{"Deduplicated":31366},{"Deduplicated":2645}]}}},"kind":{"TraitMethod":[1,46]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"P"},{"index":1,"name":"Clause1_Clause0_Item"},{"index":2,"name":"Clause2_Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":20,"beg":{"line":3202,"col":11},"