ome(4));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping after an initial [`None`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [0, 1, 2, -3, 4, 5, -6];"},{"DocComment":""},{"DocComment":" let iter = a.into_iter().map_while(|x| u32::try_from(x).ok());"},{"DocComment":" let vec: Vec<_> = iter.collect();"},{"DocComment":""},{"DocComment":" // We have more elements that could fit in u32 (such as 4, 5), but `map_while` returned `None` for `-3`"},{"DocComment":" // (as the `predicate` returned `None`) and `collect` stops at the first `None` encountered."},{"DocComment":" assert_eq!(vec, [0, 1, 2]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because `map_while()` needs to look at the value in order to see if it"},{"DocComment":" should be included or not, consuming iterators will see that it is"},{"DocComment":" removed:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, -3, 4];"},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" let result: Vec<u32> = iter.by_ref()"},{"DocComment":"                            .map_while(|n| u32::try_from(n).ok())"},{"DocComment":"                            .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(result, [1, 2]);"},{"DocComment":""},{"DocComment":" let result: Vec<i32> = iter.collect();"},{"DocComment":""},{"DocComment":" assert_eq!(result, [4]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The `-3` is no longer there, because it was consumed in order to see if"},{"DocComment":" the iteration should stop, but wasn't placed back into the iterator."},{"DocComment":""},{"DocComment":" Note that unlike [`take_while`] this iterator is **not** fused."},{"DocComment":" It is also not specified what this iterator returns after the first [`None`] is returned."},{"DocComment":" If you need a fused iterator, use [`fuse`]."},{"DocComment":""},{"DocComment":" [`fuse`]: Iterator::fuse"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"B"},{"index":2,"name":"P"},{"index":3,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":31050}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":20,"beg":{"line":1349,"col":11},"end":{"line":1349,"col":41}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":31044},{"Deduplicated":31476},{"Deduplicated":31043}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":31037}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":31044}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034},{"Deduplicated":31044}],"output":{"HashConsedValue":[31903,{"Adt":{"id":{"Adt":31},"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":31044}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitDecl":{"trait_ref":{"id":1,"generics":{"regions":[],"types":[{"D