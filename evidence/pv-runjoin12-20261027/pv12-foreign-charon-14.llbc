":" iterators iterate over references, this leads to a possibly confusing"},{"DocComment":" situation, where the type of the closure is a double reference:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s = &[-1, 0, 1];"},{"DocComment":""},{"DocComment":" let mut iter = s.iter().take_while(|x| **x < 0); // need two *s!"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(&-1));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping after an initial `false`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1, 0, 1, -2];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().take_while(|&x| x < 0);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(-1));"},{"DocComment":""},{"DocComment":" // We have more elements that are less than zero, but since we already"},{"DocComment":" // got a false, take_while() ignores the remaining elements."},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because `take_while()` needs to look at the value in order to see if it"},{"DocComment":" should be included or not, consuming iterators will see that it is"},{"DocComment":" removed:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3, 4];"},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" let result: Vec<i32> = iter.by_ref().take_while(|&n| n != 3).collect();"},{"DocComment":""},{"DocComment":" assert_eq!(result, [1, 2]);"},{"DocComment":""},{"DocComment":" let result: Vec<i32> = iter.collect();"},{"DocComment":""},{"DocComment":" assert_eq!(result, [4]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The `3` is no longer there, because it was consumed in order to see if"},{"DocComment":" the iteration should stop, but wasn't placed back into the iterator."}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034},{"Deduplicated":1725}],"output":{"HashConsedValue":[31781,{"Adt":{"id":{"Adt":30},"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":1725}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":33,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":31037}],"const_generics":[],"trait_refs":[{"Deduplicated":31768},{"Deduplicated":31344},{"Deduplicated":2645}]}}},"kind":{"TraitMethod":[1,19]}},{"params":{"regions":[],"types":[{"index":0,"name":"B"},{"index":1,"name":"P"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":20,"beg":{"line":1349,"col":11},"end":{"line":1349,"col":41}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":3131},{"Deduplicated":31057},{"Deduplicated":28194}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":1723}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":3131}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"map_while","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["map_while",0]}],"span":{"data":{"file_id":20,"beg":{"line":1346,"col":4},"end":{"line":1349,"col":42}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that both yields elements based on a predicate and maps."},{"DocComment":""},{"DocComment":" `map_while()` takes a closure as an argument. It will call this"},{"DocComment":" closure on each element of the iterator, and yield elements"},{"DocComment":" while it returns [`Some(_)`][`Some`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1i32, 4, 0, 1];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().map_while(|x| 16i32.checked_div(x));"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(-16));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Here's the same example, but with [`take_while`] and [`map`]:"},{"DocComment":""},{"DocComment":" [`take_while`]: Iterator::take_while"},{"DocComment":" [`map`]: Iterator::map"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1i32, 4, 0, 1];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter()"},{"DocComment":"                 .map(|x| 16i32.checked_div(x))"},{"DocComment":"                 .take_while(|x| x.is_some())"},{"DocComment":"                 .map(|x| x.unwrap());"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(-16));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping after an initial [`None`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [0, 1, 2, -3, 4, 5, -6];"},{"DocComment":""},{"DocComment":" let iter = a.into_iter().map_while(|x| u32::try_from(x).ok());"},{"DocComment":" let vec: Vec<_> = iter.collect();"},{"DocComment":""},{"DocComment":" // We have more elements that could fit in u32 (such as 4, 5), but `map_while` returned `None` for `-3`"},{"DocComment":" // (as the `predicate` returned `None`) and `collect` stops at the first `None` encountered."},{"DocComment":" assert_eq!(vec, [0, 1, 2]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because `map_while()` needs to look at the value in order to see if it"},{"DocComment":" should be included or not, consuming iterators will see that it is"},{"DocComment":" removed:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, -3, 4];"},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" let result: Vec<u32> = iter.by_ref()"},{"DocComment":"                            .map_while(|n| u32::try_from(n).ok())"},{"DocComment":"                            .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(result, [1, 2]);"},{"DocComment":""},{"DocComment":" let result: Vec<i32> = iter.collect();"},{"DocComment":""},{"DocComment":" assert_eq!(result, [4]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The `-3` is no longer there, because it was consumed in order to see if"},{"DocComment":" the iteration should stop, but wasn't placed back into the iterator."},{"DocComment":""},{"DocComment":" Note that unlike [`take_while`] this iterator is **not** fused."},{"DocComment":" It is also not specified what this iterator returns after the first [`None`] is returned."},{"DocComment":" If you need a fused iterator, use [`fuse`]."},{"DocComment":""},{"DocComment":" [`fuse`]: Iterator::fuse"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034},{"Deduplicated":3141}],"output":{"HashConsedValue":[31782,{"Adt":{"id":{"Adt":31},"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":3141}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":34,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":3141},{"Deduplicated":31037}],"const_generics":[],"trait_refs":[{"Deduplicated":31768},{"Deduplicated":31345},{"Deduplicated":2645},{"Deduplicated":3166}]}}},"kind":{"TraitMethod":[1,20]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"skip","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["skip",0]}],"span":{"data":{"file_id":20,"beg":{"line":1375,"col":4},"end":{"line":1377,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that skips the first `n` elements."},{"DocComment":""},{"DocComment":" `skip(n)` skips elements until `n` elements are skipped or the end of the"},{"DocComment":" iterator is reached (whichever happens first). After that, all the remaining"},{"DocComment":" elements are yielded. In particular, if the original iterator is too short,"},{"DocComment":" then the returned iterator is empty."},{"DocComment":""},{"DocComment":" Rather than overriding this method directly, instead override the `nth` method."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().skip(2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034},{"Deduplicated":1677}],"output":{"Deduplicated":31783}},"default":{"id":35,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":31037}],"const_generics":[],"trait_refs":[{"Deduplicated":31768}]}}},"kind":{"TraitMethod":[1,21]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"take","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["take",0]}],"span":{"data":{"file_id":20,"beg":{"line":1447,"col":4},"end":{"line":1449,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that yields the first `n` elements, or fewer"},{"DocComment":" if the underlying iterator ends sooner."},{"DocComment":""},{"DocComment":" `take(n)` yields elements until `n` elements are yielded or the end of"},{"DocComment":" the iterator is reached (whichever happens first)."},{"DocComment":" The returned iterator is a prefix of length `n` if the original iterator"},{"DocComment":" contains at least `n` elements, otherwise it contains all of the"},{"DocComment":" (fewer than `n`) elements of the original iterator."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().take(2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `take()` is often used with an infinite iterator, to make it finite:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut iter = (0..).take(3);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If less than `n` elements are available,"},{"DocComment":" `take` will limit itself to the size of the underlying iterator:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = [1, 2];"},{"DocComment":" let mut iter = v.into_iter().take(5);"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Use [`by_ref`] to take from the iterator without consuming it, and then"},{"DocComment":" continue using the original iterator:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut words = [\"hello\", \"world\", \"of\", \"Rust\"].into_iter();"},{"DocComment":""},{"DocComment":" // Take the first two words."},{"DocComment":" let hello_world: Vec<_> = words.by_ref().take(2).collect();"},{"DocComment":" assert_eq!(hello_world, vec![\"hello\", \"world\"]);"},{"DocComment":""},{"DocComment":" // Collect the rest of the words."},{"DocComment":" // We can only do this because we used `by_ref` earlier."},{"DocComment":" let of_rust: Vec<_> = words.collect();"},{"DocComment":" assert_eq!(of_rust, vec![\"of\", \"Rust\"]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`by_ref`]: Iterator::by_ref"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034},{"Deduplicated":1677}],"output":{"Deduplicated":31784}},"default":{"id":36,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":31037}],"const_generics":[],"trait_refs":[{"Deduplicated":31768}]}}},"kind":{"TraitMethod":[1,22]}},{"params":{"regions":[],"types":[{"index":0,"name":"St"},{"index":1,"name":"B"},{"index":2,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":20,"beg":{"line":1497,"col":11},"end":{"line":1497,"col":50}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":3514},{"HashConsedValue":[31346,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"HashConsedValue":[1730,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":1723},"Mut"]}]},{"Deduplicated":31037}],"const_generics":[],"trait_refs":[]}}}]},{"HashConsedValue":[28351,{"Adt":{"id":{"Adt":6},"generics":{"regions":[],"types":[{"Deduplicated":3131}],"const_generics":[],"trait_refs":[]}}}]}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":1723}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":3131}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":3514}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"scan","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["scan",0]}],"span":{"data":{"file_id":20,"beg":{"line":1494,"col":4},"end":{"line":1497,"col":51}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator adapter which, like [`fold`], holds internal state, but"},{"DocComment":" unlike [`fold`], produces a new iterator."},{"DocComment":""},{"DocComment":" [`fold`]: Iterator::fold"},{"DocComment":""},{"DocComment":" `scan()` takes two arguments: an initial value which seeds the internal"},{"DocComment":" state, and a closure with two arguments, the first being a mutable"},{"DocComment":" reference to the internal state and the second an iterator element."},{"DocComment":" The closure can assign to the internal state to share state between"},{"DocComment":" iterations."},{"DocComment":""},{"DocComment":" On iteration, the closure will be applied to each element of the"},{"DocComment":" iterator and the return value from the closure, an [`Option`], is"},{"DocComment":" returned by the `next` method. Thus the closure can return"},{"DocComment":" `Some(value)` to yield `value`, or `None` to end the iteration."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3, 4];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().scan(1, |state, x| {"},{"DocComment":"     // each iteration, we'll multiply the state by the element ..."},{"DocComment":"     *state = *state * x;"},{"DocComment":""},{"DocComment":"     // ... and terminate if the state exceeds 6"},{"DocComment":"     if *state > 6 {"},{"DocComment":"         return None;"},{"DocComment":"     }"},{"DocComment":"     // ... else yield the negation of the state"},{"DocComment":"     Some(-*state)"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(-1));"},{"DocComment":" assert_eq!(iter.next(), Some(-2));"},{"DocComment":" assert_eq!(iter.next(), Some(-6));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":3527}],"output":{"HashConsedValue":[31785,{"Adt":{"id":{"Adt":34},"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":3527}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":37,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":3141},{"Deduplicated":3527},{"Deduplicated":31037}],"const_generics":[],"trait_refs":[{"Deduplicated":31768},{"HashConsedValue":[31347,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":3514},{"Deduplicated":31346},{"Deduplicated":28351}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":2645},{"Deduplicated":3166},{"HashConsedValue":[3554,{"kind":{"Clause":{"Bound":[0,3]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":3514}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[1,23]}},{"params":{"regions":[],"types":[{"index":0,"name":"U"},{"index":1,"name":"F"},{"index":2,"name":"Clause0_Item"},{"index":3,"name":"Clause0_IntoIter"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":20,"beg":{"line":1536,"col":11},"end":{"line":1536,"col":23}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":1723},{"Deduplicated":3514},{"Deduplicated":4628}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":20,"beg":{"line":1537,"col":11},"end":{"line":1537,"col":33}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":3131},{"Deduplicated":31057},{"Deduplicated":1723}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":1723}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":3131}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"flat_map","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["flat_map",0]}],"span":{"data":{"file_id":20,"beg":{"line":1533,"col":4},"end":{"line":1537,"col":34}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that works like map, but flattens nested structure."},{"DocComment":""},{"DocComment":" The [`map`] adapter is very useful, but only when the closure"},{"DocComment":" argument produces values. If it produces an iterator instead, there's"},{"DocComment":" an extra layer of indirection. `flat_map()` will remove this extra layer"},{"DocComment":" on its own."},{"DocComment":""},{"DocComment":" You can think of `flat_map(f)` as the semantic equivalent"},{"DocComment":" of [`map`]ping, and then [`flatten`]ing as in `map(f).flatten()`."},{"DocComment":""},{"DocComment":" Another way of thinking about `flat_map()`: [`map`]'s closure returns"},{"DocComment":" one item for each element, and `flat_map()`'s closure returns an"},{"DocComment":" iterator for each element."},{"DocComment":""},{"DocComment":" [`map`]: Iterator::map"},{"DocComment":" [`flatten`]: Iterator::flatten"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let words = [\"alpha\", \"beta\", \"gamma\"];"},{"DocComment":""},{"DocComment":" // chars() returns an iterator"},{"DocComment":" let merged: String = words.iter()"},{"DocComment":"                           .flat_map(|s| s.chars())"},{"DocComment":"                           .collect();"},{"DocComment":" assert_eq!(merged, \"alphabetagamma\");"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034},{"Deduplicated":3141}],"output":{"HashConsedValue":[31786,{"Adt":{"id":{"Adt":35},"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":3141},{"Deduplicated":3527},{"HashConsedValue":[4631,{"TypeVar":{"Bound":[0,3]}}]}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":38,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":3141},{"Deduplicated":31037},{"Deduplicated":3527},{"Deduplicated":4631}],"const_generics":[],"trait_refs":[{"Deduplicated":31768},{"HashConsedValue":[24327,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":1723},{"Deduplicated":3514},{"Deduplicated":4628}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[31348,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":3131},{"Deduplicated":31057},{"Deduplicated":1723}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":3614},{"Deduplicated":3615}]}}},"kind":{"TraitMethod":[1,24]}},{"params":{"regions":[],"types":[{"index":0,"name":"Clause0_Item"},{"index":1,"name":"Clause0_IntoIter"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":20,"beg":{"line":1620,"col":20},"end":{"line":1620,"col":32}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":31037},{"Deduplicated":1723},{"Deduplicated":3131}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"flatten","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["flatten",0]}],"span":{"data":{"file_id":20,"beg":{"line":1617,"col":4},"end":{"line":1620,"col":33}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that flattens nested structure."},{"DocComment":""},{"DocComment":" This is useful when you have an iterator of iterators or an iterator of"},{"DocComment":" things that can be turned into iterators and you want to remove one"},{"DocComment":" level of indirection."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let data = vec![vec![1, 2, 3, 4], vec![5, 6]];"},{"DocComment":" let flattened: Vec<_> = data.into_iter().flatten().collect();"},{"DocComment":" assert_eq!(flattened, [1, 2, 3, 4, 5, 6]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Mapping and then flattening:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let words = [\"alpha\", \"beta\", \"gamma\"];"},{"DocComment":""},{"DocComment":" // chars() returns an iterator"},{"DocComment":" let merged: String = words.iter()"},{"DocComment":"                           .map(|s| s.chars())"},{"DocComment":"                           .flatten()"},{"DocComment":"                           .collect();"},{"DocComment":" assert_eq!(merged, \"alphabetagamma\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also rewrite this in terms of [`flat_map()`], which is preferable"},{"DocComment":" in this case since it conveys intent more clearly:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let words = [\"alpha\", \"beta\", \"gamma\"];"},{"DocComment":""},{"DocComment":" // chars() returns an iterator"},{"DocComment":" let merged: String = words.iter()"},{"DocComment":"                           .flat_map(|s| s.chars())"},{"DocComment":"                           .collect();"},{"DocComment":" assert_eq!(merged, \"alphabetagamma\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Flattening works on any `IntoIterator` type, including `Option` and `Result`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let options = vec![Some(123), Some(321), None, Some(231)];"},{"DocComment":" let flattened_options: Vec<_> = options.into_iter().flatten().collect();"},{"DocComment":" assert_eq!(flattened_options, [123, 321, 231]);"},{"DocComment":""},{"DocComment":" let results = vec![Ok(123), Ok(321), Err(456), Ok(231)];"},{"DocComment":" let flattened_results: Vec<_> = results.into_iter().flatten().collect();"},{"DocComment":" assert_eq!(flattened_results, [123, 321, 231]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Flattening only removes one level of nesting at a time:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let d3 = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]];"},{"DocComment":""},{"DocComment":" let d2: Vec<_> = d3.into_iter().flatten().collect();"},{"DocComment":" assert_eq!(d2, [[1, 2], [3, 4], [5, 6], [7, 8]]);"},{"DocComment":""},{"DocComment":" let d1: Vec<_> = d3.into_iter().flatten().flatten().collect();"},{"DocComment":" assert_eq!(d1, [1, 2, 3, 4, 5, 6, 7, 8]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Here we see that `flatten()` does not perform a \"deep\" flatten."},{"DocComment":" Instead, only one level of nesting is removed. That is, if you"},{"DocComment":" `flatten()` a three-dimensional array, the result will be"},{"DocComment":" two-dimensional and not one-dimensional. To get a one-dimensional"},{"DocComment":" structure, you have to `flatten()` again."},{"DocComment":""},{"DocComment":" [`flat_map()`]: Iterator::flat_map"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034}],"output":{"HashConsedValue":[31787,{"Adt":{"id":{"Adt":36},"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":31037},{"Deduplicated":1725},{"Deduplicated":3141}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":39,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":31037},{"Deduplicated":1725},{"Deduplicated":3141}],"const_generics":[],"trait_refs":[{"Deduplicated":31768},{"HashConsedValue":[31349,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":31037},{"Deduplicated":1723},{"Deduplicated":3131}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[1,25]}},{"params":{"regions":[],"types":[{"index":0,"name":"F"},{"index":1,"name":"R"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":1677}}],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":20,"beg":{"line":1774,"col":11},"end":{"line":1774,"col":39}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":1723},{"HashConsedValue":[31352,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"HashConsedValue":[31351,{"Ref":[{"Var":{"Bound":[0,0]}},{"HashConsedValue":[31350,{"Array":[{"Deduplicated":31037},{"kind":{"Var":{"Bound":[1,0]}},"ty":{"Deduplicated":1677}}]}]},"Shared"]}]}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":3131}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":1723}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":3131}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"map_windows","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["map_windows",0]}],"span":{"data":{"file_id":20,"beg":{"line":1771,"col":4},"end":{"line":1774,"col":40}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Calls the given function `f` for each contiguous window of size `N` over"},{"DocComment":" `self` and returns an iterator over the outputs of `f`. Like [`slice::windows()`],"},{"DocComment":" the windows during mapping overlap as well."},{"DocComment":""},{"DocComment":" In the following example, the closure is called three times with the"},{"DocComment":" arguments `&['a', 'b']`, `&['b', 'c']` and `&['c', 'd']` respectively."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" let strings = \"abcd\".chars()"},{"DocComment":"     .map_windows(|[x, y]| format!(\"{}+{}\", x, y))"},{"DocComment":"     .collect::<Vec<String>>();"},{"DocComment":""},{"DocComment":" assert_eq!(strings, vec![\"a+b\", \"b+c\", \"c+d\"]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that the const parameter `N` is usually inferred by the"},{"DocComment":" destructured argument in the closure."},{"DocComment":""},{"DocComment":" The returned iterator yields 𝑘 − `N` + 1 items (where 𝑘 is the number of"},{"DocComment":" items yielded by `self`). If 𝑘 is less than `N`, this method yields an"},{"DocComment":" empty iterator."},{"DocComment":""},{"DocComment":" [`slice::windows()`]: slice::windows"},{"DocComment":" [`FusedIterator`]: crate::iter::FusedIterator"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `N` is zero. This check will most probably get changed to a"},{"DocComment":" compile time error before this method gets stabilized."},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" let iter = std::iter::repeat(0).map_windows(|&[]| ());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Building the sums of neighboring numbers."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" let mut it = [1, 3, 8, 1].iter().map_windows(|&[a, b]| a + b);"},{"DocComment":" assert_eq!(it.next(), Some(4));  // 1 + 3"},{"DocComment":" assert_eq!(it.next(), Some(11)); // 3 + 8"},{"DocComment":" assert_eq!(it.next(), Some(9));  // 8 + 1"},{"DocComment":" assert_eq!(it.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since the elements in the following example implement `Copy`, we can"},{"DocComment":" just copy the array and get an iterator over the windows."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" let mut it = \"ferris\".chars().map_windows(|w: &[_; 3]| *w);"},{"DocComment":" assert_eq!(it.next(), Some(['f', 'e', 'r']));"},{"DocComment":" assert_eq!(it.next(), Some(['e', 'r', 'r']));"},{"DocComment":" assert_eq!(it.next(), Some(['r', 'r', 'i']));"},{"DocComment":" assert_eq!(it.next(), Some(['r', 'i', 's']));"},{"DocComment":" assert_eq!(it.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also use this function to check the sortedness of an iterator."},{"DocComment":" For the simple case, rather use [`Iterator::is_sorted`]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" let mut it = [0.5, 1.0, 3.5, 3.0, 8.5, 8.5, f32::NAN].iter()"},{"DocComment":"     .map_windows(|[a, b]| a <= b);"},{"DocComment":""},{"DocComment":" assert_eq!(it.next(), Some(true));  // 0.5 <= 1.0"},{"DocComment":" assert_eq!(it.next(), Some(true));  // 1.0 <= 3.5"},{"DocComment":" assert_eq!(it.next(), Some(false)); // 3.5 <= 3.0"},{"DocComment":" assert_eq!(it.next(), Some(true));  // 3.0 <= 8.5"},{"DocComment":" assert_eq!(it.next(), Some(true));  // 8.5 <= 8.5"},{"DocComment":" assert_eq!(it.next(), Some(false)); // 8.5 <= NAN"},{"DocComment":" assert_eq!(it.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" For non-fused iterators, the window is reset after `None` is yielded."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" #[derive(Default)]"},{"DocComment":" struct NonFusedIterator {"},{"DocComment":"     state: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Iterator for NonFusedIterator {"},{"DocComment":"     type Item = i32;"},{"DocComment":""},{"DocComment":"     fn next(&mut self) -> Option<i32> {"},{"DocComment":"         let val = self.state;"},{"DocComment":"         self.state = self.state + 1;"},{"DocComment":""},{"DocComment":"         // Skip every 5th number"},{"DocComment":"         if (val + 1) % 5 == 0 {"},{"DocComment":"             None"},{"DocComment":"         } else {"},{"DocComment":"             Some(val)"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":""},{"DocComment":" let mut iter = NonFusedIterator::default();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), Some(5));"},{"DocComment":" assert_eq!(iter.next(), Some(6));"},{"DocComment":" assert_eq!(iter.next(), Some(7));"},{"DocComment":" assert_eq!(iter.next(), Some(8));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), Some(10));"},{"DocComment":" assert_eq!(iter.next(), Some(11));"},{"DocComment":""},{"DocComment":" let mut iter = NonFusedIterator::default()"},{"DocComment":"     .map_windows(|arr: &[_; 2]| *arr);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some([0, 1]));"},{"DocComment":" assert_eq!(iter.next(), Some([1, 2]));"},{"DocComment":" assert_eq!(iter.next(), Some([2, 3]));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some([5, 6]));"},{"DocComment":" assert_eq!(iter.next(), Some([6, 7]));"},{"DocComment":" assert_eq!(iter.next(), Some([7, 8]));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some([10, 11]));"},{"DocComment":" assert_eq!(iter.next(), Some([11, 12]));"},{"DocComment":" assert_eq!(iter.next(), Some([12, 13]));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034},{"Deduplicated":1725}],"output":{"HashConsedValue":[31788,{"Adt":{"id":{"Adt":37},"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":31037}],"const_generics":[{"kind":{"Var":{"Bound":[0,0]}},"ty":{"Deduplicated":1677}}],"trait_refs":[]}}}]}},"default":{"id":40,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":3141},{"Deduplicated":31037}],"const_generics":[{"kind":{"Var":{"Bound":[0,0]}},"ty":{"Deduplicated":1677}}],"trait_refs":[{"Deduplicated":31768},{"HashConsedValue":[31353,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":1723},{"Deduplicated":31352},{"Deduplicated":3131}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":2645},{"Deduplicated":3166}]}}},"kind":{"TraitMethod":[1,26]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"fuse","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["fuse",0]}],"span":{"data":{"file_id":20,"beg":{"line":1833,"col":4},"end":{"line":1835,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator which ends after the first [`None`]."},{"DocComment":""},{"DocComment":" After an iterator returns [`None`], future calls may or may not yield"},{"DocComment":" [`Some(T)`] again. `fuse()` adapts an iterator, ensuring that after a"},{"DocComment":" [`None`] is given, it will always return [`None`] forever."},{"DocComment":""},{"DocComment":" Note that the [`Fuse`] wrapper is a no-op on iterators that implement"},{"DocComment":" the [`FusedIterator`] trait. `fuse()` may therefore behave incorrectly"},{"DocComment":" if the [`FusedIterator`] trait is improperly implemented."},{"DocComment":""},{"DocComment":" [`Some(T)`]: Some"},{"DocComment":" [`FusedIterator`]: crate::iter::FusedIterator"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // an iterator which alternates between Some and None"},{"DocComment":" struct Alternate {"},{"DocComment":"     state: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Iterator for Alternate {"},{"DocComment":"     type Item = i32;"},{"DocComment":""},{"DocComment":"     fn next(&mut self) -> Option<i32> {"},{"DocComment":"         let val = self.state;"},{"DocComment":"         self.state = self.state + 1;"},{"DocComment":""},{"DocComment":"         // if it's even, Some(i32), else None"},{"DocComment":"         (val % 2 == 0).then_some(val)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut iter = Alternate { state: 0 };"},{"DocComment":""},{"DocComment":" // we can see our iterator going back and forth"},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":""},{"DocComment":" // however, once we fuse it..."},{"DocComment":" let mut iter = iter.fuse();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":""},{"DocComment":" // it will always return `None` after the first time."},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034}],"output":{"Deduplicated":31070}},"default":{"id":41,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":31037}],"const_generics":[],"trait_refs":[{"Deduplicated":31768}]}}},"kind":{"TraitMethod":[1,27]}},{"params":{"regions":[],"types":[{"index":0,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":20,"beg":{"line":1920,"col":11},"end":{"line":1920,"col":29}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":1723},{"Deduplicated":31343},{"Deduplicated":1596}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":1723}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"inspect","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["inspect",0]}],"span":{"data":{"file_id":20,"beg":{"line":1917,"col":4},"end":{"line":1920,"col":30}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Does something with each element of an iterator, passing the value on."},{"DocComment":""},{"DocComment":" When using iterators, you'll often chain several of them together."},{"DocComment":" While working on such code, you might want to check out what's"},{"DocComment":" happening at various parts in the pipeline. To do that, insert"},{"DocComment":" a call to `inspect()`."},{"DocComment":""},{"DocComment":" It's more common for `inspect()` to be used as a debugging tool than to"},{"DocComment":" exist in your final code, but applications may find it useful in certain"},{"DocComment":" situations when errors need to be logged before being discarded."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 4, 2, 3];"},{"DocComment":""},{"DocComment":" // this iterator sequence is complex."},{"DocComment":" let sum = a.iter()"},{"DocComment":"     .cloned()"},{"DocComment":"     .filter(|x| x % 2 == 0)"},{"DocComment":"     .fold(0, |sum, i| sum + i);"},{"DocComment":""},{"DocComment":" println!(\"{sum}\");"},{"DocComment":""},{"DocComment":" // let's add some inspect() calls to investigate what's happening"},{"DocComment":" let sum = a.iter()"},{"DocComment":"     .cloned()"},{"DocComment":"     .inspect(|x| println!(\"about to filter: {x}\"))"},{"DocComment":"     .filter(|x| x % 2 == 0)"},{"DocComment":"     .inspect(|x| println!(\"made it through filter: {x}\"))"},{"DocComment":"     .fold(0, |sum, i| sum + i);"},{"DocComment":""},{"DocComment":" println!(\"{sum}\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will print:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" 6"},{"DocComment":" about to filter: 1"},{"DocComment":" about to filter: 4"},{"DocComment":" made it through filter: 4"},{"DocComment":" about to filter: 2"},{"DocComment":" made it through filter: 2"},{"DocComment":" about to filter: 3"},{"DocComment":" 6"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Logging errors before discarding them:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let lines = [\"1\", \"2\", \"a\"];"},{"DocComment":""},{"DocComment":" let sum: i32 = lines"},{"DocComment":"     .iter()"},{"DocComment":"     .map(|line| line.parse::<i32>())"},{"DocComment":"     .inspect(|num| {"},{"DocComment":"         if let Err(ref e) = *num {"},{"DocComment":"             println!(\"Parsing error: {e}\");"},{"DocComment":"         }"},{"DocComment":"     })"},{"DocComment":"     .filter_map(Result::ok)"},{"DocComment":"     .sum();"},{"DocComment":""},{"DocComment":" println!(\"Sum: {sum}\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will print:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" Parsing error: invalid digit found in string"},{"DocComment":" Sum: 3"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034},{"Deduplicated":1725}],"output":{"HashConsedValue":[31789,{"Adt":{"id":{"Adt":39},"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":1725}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":42,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":31037}],"const_generics":[],"trait_refs":[{"Deduplicated":31768},{"HashConsedValue":[31354,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":1723},{"Deduplicated":31343},{"Deduplicated":1596}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":2645}]}}},"kind":{"TraitMethod":[1,28]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"by_ref","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["by_ref",0]}],"span":{"data":{"file_id":20,"beg":{"line":1954,"col":4},"end":{"line":1956,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates a \"by reference\" adapter for this instance of `Iterator`."},{"DocComment":""},{"DocComment":" Consuming method calls (direct or indirect calls to `next`)"},{"DocComment":" on the \"by reference\" adapter will consume the original iterator,"},{"DocComment":" but ownership-taking methods (those with a `self` parameter)"},{"DocComment":" only take ownership of the \"by reference\" iterator."},{"DocComment":""},{"DocComment":" This is useful for applying ownership-taking methods"},{"DocComment":" (such as `take` in the example below)"},{"DocComment":" without giving up ownership of the original iterator,"},{"DocComment":" so you can use the original iterator afterwards."},{"DocComment":""},{"DocComment":" Uses [`impl<I: Iterator + ?Sized> Iterator for &mut I { type Item = I::Item; ...}`](Iterator#impl-Iterator-for-%26mut+I)."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut words = [\"hello\", \"world\", \"of\", \"Rust\"].into_iter();"},{"DocComment":""},{"DocComment":" // Take the first two words."},{"DocComment":" let hello_world: Vec<_> = words.by_ref().take(2).collect();"},{"DocComment":" assert_eq!(hello_world, vec![\"hello\", \"world\"]);"},{"DocComment":""},{"DocComment":" // Collect the rest of the words."},{"DocComment":" // We can only do this because we used `by_ref` earlier."},{"DocComment":" let of_rust: Vec<_> = words.collect();"},{"DocComment":" assert_eq!(of_rust, vec![\"of\", \"Rust\"]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31764}],"output":{"Deduplicated":31764}},"default":{"id":43,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31034},{"Deduplicated":31037}],"const_generics":[],"trait_refs":[]}}},"kind":{"TraitMethod":[1,29]}},{"params":{"regions":[],"types":[{"index":0,"name":"B"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":20,"beg":{"line":2077,"col":18},"end":{"line":2077,"col":42}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":1723},{"Deduplicated":31037}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":1723}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"collect","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["collect",0]}],"span":{"data":{"file_id":20,"beg":{"line":2077,"col":4},"end":{"line":2079,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Transforms an iterator into a collection."},{"DocComment":""},{"DocComment":" `collect()` takes ownership of an iterator and produces whichever"},{"DocComment":" collection type you request. The iterator itself carries no knowledge of"},{"DocComment":" the eventual container; the target collection is chosen entirely by the"},{"DocComment":" type you ask `collect()` to return. This makes `collect()` one of the"},{"DocComment":" more powerful methods in the standard library, and it shows up in a wide"},{"DocComment":" variety of contexts."},{"DocComment":""},{"DocComment":" The most basic pattern in which `collect()` is used is to turn one"},{"DocComment":" collection into another. You take a collection, call [`iter`] on it,"},{"DocComment":" do a bunch of transformations, and then `collect()` at the end."},{"DocComment":""},{"DocComment":" `collect()` can also create instances of types that are not typical"},{"DocComment":" collections. For example, a [`String`] can be built from [`char`]s,"},{"DocComment":" and an iterator of [`Result<T, E>`][`Result`] items can be collected"},{"DocComment":" into `Result<Collection<T>, E>`. See the examples below for more."},{"DocComment":""},{"DocComment":" Because `collect()` is so general, it can cause problems with type"},{"DocComment":" inference. As such, `collect()` is one of the few times you'll see"},{"DocComment":" the syntax affectionately known as the 'turbofish': `::<>`. This"},{"DocComment":" helps the inference algorithm understand specifically which collection"},{"DocComment":" you're trying to collect into."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled: Vec<i32> = a.iter()"},{"DocComment":"                          .map(|x| x * 2)"},{"DocComment":"                          .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that we needed the `: Vec<i32>` on the left-hand side. This is because"},{"DocComment":" we could collect into, for example, a [`VecDeque<T>`] instead:"},{"DocComment":""},{"DocComment":" [`VecDeque<T>`]: ../../std/collections/struct.VecDeque.html"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::VecDeque;"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled: VecDeque<i32> = a.iter().map(|x| x * 2).collect();"},{"DocComment":""},{"DocComment":" assert_eq!(2, doubled[0]);"},{"DocComment":" assert_eq!(4, doubled[1]);"},{"DocComment":" assert_eq!(6, doubled[2]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using the 'turbofish' instead of annotating `doubled`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled = a.iter().map(|x| x * 2).collect::<Vec<i32>>();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because `collect()` only cares about what you're collecting into, you can"},{"DocComment":" still use a partial type hint, `_`, with the turbofish:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled = a.iter().map(|x| x * 2).collect::<Vec<_>>();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using `collect()` to make a [`String`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let chars = ['g', 'd', 'k', 'k', 'n'];"},{"DocComment":""},{"DocComment":" let hello: String = chars.into_iter()"},{"DocComment":"     .map(|x| x as u8)"},{"DocComment":"     .map(|x| (x + 1) as char)"},{"DocComment":"     .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(\"hello\", hello);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you have a list of [`Result<T, E>`][`Result`]s, you can use `collect()` to"},{"DocComment":" see if any of them failed:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let results = [Ok(1), Err(\"nope\"), Ok(3), Err(\"bad\")];"},{"DocComment":""},{"DocComment":" let result: Result<Vec<_>, &str> = results.into_iter().collect();"},{"DocComment":""},{"DocComment":" // gives us the first error"},{"DocComment":" assert_eq!(Err(\"nope\"), result);"},{"DocComment":""},{"DocComment":" let results = [Ok(1), Ok(3)];"},{"DocComment":""},{"DocComment":" let result: Result<Vec<_>, &str> = results.into_iter().collect();"},{"DocComment":""},{"DocComment":" // gives us the list of answers"},{"DocComment":" assert_eq!(Ok(vec![1, 3]), result);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`iter`]: Iterator::next"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":" [`char`]: type@char"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"iterator_collect_fn"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034}],"output":{"Deduplicated":1725}},"default":{"id":44,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":31037}],"const_generics":[],"trait_refs":[{"Deduplicated":31768},{"HashConsedValue":[31355,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":1723},{"Deduplicated":31037}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":2645}]}}},"kind":{"TraitMethod":[1,30]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"B"},{"index":1,"name":"Clause1_TryType"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":20,"beg":{"line":2168,"col":20},"end":{"line":2168,"col":46}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":31037}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":20,"beg":{"line":2168,"col":34},"end":{"line":2168,"col":45}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":11,"generics":{"regions":[],"types":[{"HashConsedValue":[31357,{"TraitType":[{"HashConsedValue":[31356,{"kind":{"Clause":{"Bound":[1,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":31037}],"const_generics":[],"trait_refs":[]}}}}]},1,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}]},{"Deduplicated":1723},{"Deduplicated":3131}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":20,"beg":{"line":2169,"col":11},"end":{"line":2169,"col":52}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":1723},{"HashConsedValue":[31358,{"TraitType":[{"Deduplicated":31356},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}]}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":1723}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"try_collect","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["try_collect",0]}],"span":{"data":{"file_id":20,"beg":{"line":2165,"col":4},"end":{"line":2169,"col":53}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Fallibly transforms an iterator into a collection, short circuiting if"},{"DocComment":" a failure is encountered."},{"DocComment":""},{"DocComment":" `try_collect()` is a variation of [`collect()`][`collect`] that allows fallible"},{"DocComment":" conversions during collection. Its main use case is simplifying conversions from"},{"DocComment":" iterators yielding [`Option<T>`][`Option`] into `Option<Collection<T>>`, or similarly for other [`Try`]"},{"DocComment":" types (e.g. [`Result`])."},{"DocComment":""},{"DocComment":" Importantly, `try_collect()` doesn't require that the outer [`Try`] type also implements [`FromIterator`];"},{"DocComment":" only the inner type produced on `Try::Output` must implement it. Concretely,"},{"DocComment":" this means that collecting into `ControlFlow<_, Vec<i32>>` is valid because `Vec<i32>` implements"},{"DocComment":" [`FromIterator`], even though [`ControlFlow`] doesn't."},{"DocComment":""},{"DocComment":" Also, if a failure is encountered during `try_collect()`, the iterator is still valid and"},{"DocComment":" may continue to be used, in which case it will continue iterating starting after the element that"},{"DocComment":" triggered the failure. See the last example below for an example of how this works."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":" Successfully collecting an iterator of `Option<i32>` into `Option<Vec<i32>>`:"},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_collect)]"},{"DocComment":""},{"DocComment":" let u = vec![Some(1), Some(2), Some(3)];"},{"DocComment":" let v = u.into_iter().try_collect::<Vec<i32>>();"},{"DocComment":" assert_eq!(v, Some(vec![1, 2, 3]));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Failing to collect in the same way:"},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_collect)]"},{"DocComment":""},{"DocComment":" let u = vec![Some(1), Some(2), None, Some(3)];"},{"DocComment":" let v = u.into_iter().try_collect::<Vec<i32>>();"},{"DocComment":" assert_eq!(v, None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A similar example, but with `Result`:"},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_collect)]"},{"DocComment":""},{"DocComment":" let u: Vec<Result<i32, ()>> = vec![Ok(1), Ok(2), Ok(3)];"},{"DocComment":" let v = u.into_iter().try_collect::<Vec<i32>>();"},{"DocComment":" assert_eq!(v, Ok(vec![1, 2, 3]));"},{"DocComment":""},{"DocComment":" let u = vec![Ok(1), Ok(2), Err(()), Ok(3)];"},{"DocComment":" let v = u.into_iter().try_collect::<Vec<i32>>();"},{"DocComment":" assert_eq!(v, Err(()));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Finally, even [`ControlFlow`] works, despite the fact that it"},{"DocComment":" doesn't implement [`FromIterator`]. Note also that the iterator can"},{"DocComment":" continue to be used, even if a failure is encountered:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_collect)]"},{"DocComment":""},{"DocComment":" use core::ops::ControlFlow::{Break, Continue};"},{"DocComment":""},{"DocComment":" let u = [Continue(1), Continue(2), Break(3), Continue(4), Continue(5)];"},{"DocComment":" let mut it = u.into_iter();"},{"DocComment":""},{"DocComment":" let v = it.try_collect::<Vec<_>>();"},{"DocComment":" assert_eq!(v, Break(3));"},{"DocComment":""},{"DocComment":" let v = it.try_collect::<Vec<_>>();"},{"DocComment":" assert_eq!(v, Continue(vec![4, 5]));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`collect`]: Iterator::collect"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31764}],"output":{"Deduplicated":3141}},"default":{"id":45,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":31037},{"Deduplicated":3141}],"const_generics":[],"trait_refs":[{"Deduplicated":31768},{"HashConsedValue":[31359,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":31037}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[31360,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":11,"generics":{"regions":[],"types":[{"Deduplicated":31357},{"Deduplicated":1723},{"Deduplicated":3131}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[31361,{"kind":{"Clause":{"Bound":[0,2]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":1723},{"Deduplicated":31358}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[3858,{"kind":{"Clause":{"Bound":[0,3]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":1723}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[1,31]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"E"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":20,"beg":{"line":2238,"col":23},"end":{"line":2238,"col":41}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Deduplicated":1723},{"Deduplicated":31037}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":1723}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"collect_into","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["collect_into",0]}],"span":{"data":{"file_id":20,"beg":{"line":2238,"col":4},"end":{"line":2240,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Collects all the items from an iterator into a collection."},{"DocComment":""},{"DocComment":" This method consumes the iterator and adds all its items to the"},{"DocComment":" passed collection. The collection is then returned, so the call chain"},{"DocComment":" can be continued."},{"DocComment":""},{"DocComment":" This is useful when you already have a collection and want to add"},{"DocComment":" the iterator items to it."},{"DocComment":""},{"DocComment":" This method is a convenience method to call [Extend::extend](trait.Extend.html),"},{"DocComment":" but instead of being called on a collection, it's called on an iterator."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_collect_into)]"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let mut vec: Vec::<i32> = vec![0, 1];"},{"DocComment":""},{"DocComment":" a.iter().map(|x| x * 2).collect_into(&mut vec);"},{"DocComment":" a.iter().map(|x| x * 10).collect_into(&mut vec);"},{"DocComment":""},{"DocComment":" assert_eq!(vec, vec![0, 1, 2, 4, 6, 10, 20, 30]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `Vec` can have a manual set capacity to avoid reallocating it:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_collect_into)]"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let mut vec: Vec::<i32> = Vec::with_capacity(6);"},{"DocComment":""},{"DocComment":" a.iter().map(|x| x * 2).collect_into(&mut vec);"},{"DocComment":" a.iter().map(|x| x * 10).collect_into(&mut vec);"},{"DocComment":""},{"DocComment":" assert_eq!(6, vec.capacity());"},{"DocComment":" assert_eq!(vec, vec![2, 4, 6, 10, 20, 30]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The returned mutable reference can be used to continue the call chain:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_collect_into)]"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let mut vec: Vec::<i32> = Vec::with_capacity(6);"},{"DocComment":""},{"DocComment":" let count = a.iter().collect_into(&mut vec).iter().count();"},{"DocComment":""},{"DocComment":" assert_eq!(count, vec.len());"},{"DocComment":" assert_eq!(vec, vec![1, 2, 3]);"},{"DocComment":""},{"DocComment":" let count = a.iter().collect_into(&mut vec).iter().count();"},{"DocComment":""},{"DocComment":" assert_eq!(count, vec.len());"},{"DocComment":" assert_eq!(vec, vec![1, 2, 3, 1, 2, 3]);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034},{"HashConsedValue":[3876,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":1725},"Mut"]}]}],"output":{"Deduplicated":3876}},"default":{"id":46,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":31037}],"const_generics":[],"trait_refs":[{"Deduplicated":31768},{"HashConsedValue":[31362,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Deduplicated":1723},{"Deduplicated":31037}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated