en `rposition()` returns"},{"DocComment":" [`Some(index)`]. If all of them return `false`, it returns [`None`]."},{"DocComment":""},{"DocComment":" `rposition()` is short-circuiting; in other words, it will stop"},{"DocComment":" processing as soon as it finds a `true`."},{"DocComment":""},{"DocComment":" [`Some(index)`]: Some"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert_eq!(a.into_iter().rposition(|x| x == 3), Some(2));"},{"DocComment":""},{"DocComment":" assert_eq!(a.into_iter().rposition(|x| x == 5), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `true`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1, 2, 3, 4];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.rposition(|x| x >= 2), Some(3));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(-1));"},{"DocComment":" assert_eq!(iter.next_back(), Some(3));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31764},{"Deduplicated":1725}],"output":{"Deduplicated":28355}},"default":{"id":61,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":31037},{"Deduplicated":3141},{"Deduplicated":3527}],"const_generics":[],"trait_refs":[{"Deduplicated":31768},{"Deduplicated":31366},{"HashConsedValue":[31309,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":15,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":3131}],"const_generics":[],"trait_refs":[]}}}}]},{"H