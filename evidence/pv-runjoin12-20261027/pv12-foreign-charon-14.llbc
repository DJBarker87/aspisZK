rator which [`clone`]s all of its elements."},{"DocComment":""},{"DocComment":" This is useful when you have an iterator over `&T`, but you need an"},{"DocComment":" iterator over `T`."},{"DocComment":""},{"DocComment":" There is no guarantee whatsoever about the `clone` method actually"},{"DocComment":" being called *or* optimized away. So code should not depend on"},{"DocComment":" either."},{"DocComment":""},{"DocComment":" [`clone`]: Clone::clone"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let v_cloned: Vec<_> = a.iter().cloned().collect();"},{"DocComment":""},{"DocComment":" // cloned is the same as .map(|&x| x), for integers"},{"DocComment":" let v_map: Vec<_> = a.iter().map(|&x| x).collect();"},{"DocComment":""},{"DocComment":" assert_eq!(v_cloned, [1, 2, 3]);"},{"DocComment":" assert_eq!(v_map, [1, 2, 3]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" To get the best performance, try to clone late:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [vec![0_u8, 1, 2], vec![3, 4], vec![23]];"},{"DocComment":" // don't do this:"},{"DocComment":" let slower: Vec<_> = a.iter().cloned().filter(|s| s.len() == 1).collect();"},{"DocComment":" assert_eq!(&[vec![23]], &slower[..]);"},{"DocComment":" // instead call `cloned` late"},{"DocComment":" let faster: Vec<_> = a.iter().filter(|s| s.len() == 1).cloned().collect();"},{"DocComment":" assert_eq!(&[vec![23]], &faster[..]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"iter_cloned"},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"T"},{"index":2,"name":"Clause2_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{