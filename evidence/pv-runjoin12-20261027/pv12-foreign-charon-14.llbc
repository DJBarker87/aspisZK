y the reversed version of [`Iterator::nth()`]."},{"DocComment":" Although like most indexing operations, the count starts from zero, so"},{"DocComment":" `nth_back(0)` returns the first value from the end, `nth_back(1)` the"},{"DocComment":" second, and so on."},{"DocComment":""},{"DocComment":" Note that all elements between the end and the returned element will be"},{"DocComment":" consumed, including the returned element. This also means that calling"},{"DocComment":" `nth_back(0)` multiple times on the same iterator will return different"},{"DocComment":" elements."},{"DocComment":""},{"DocComment":" `nth_back()` will return [`None`] if `n` is greater than or equal to the"},{"DocComment":" length of the iterator."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" assert_eq!(a.iter().nth_back(2), Some(&1));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Calling `nth_back()` multiple times doesn't rewind the iterator:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.nth_back(1), Some(&2));"},{"DocComment":" assert_eq!(iter.nth_back(1), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Returning `None` if there are less than `n + 1` elements:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" assert_eq!(a.iter().nth_back(10), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"lin