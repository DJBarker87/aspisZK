iterator, this function will return either `Some(None)` or"},{"DocComment":" `Ok(None)` depending on the type of the provided closure."},{"DocComment":""},{"DocComment":" For iterators with at least one element, this is essentially the same as calling"},{"DocComment":" [`try_fold()`] with the first element of the iterator as the initial accumulator value."},{"DocComment":""},{"DocComment":" [`try_fold()`]: Iterator::try_fold"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Safely calculate the sum of a series of numbers:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_reduce)]"},{"DocComment":""},{"DocComment":" let numbers: Vec<usize> = vec![10, 20, 5, 23, 0];"},{"DocComment":" let sum = numbers.into_iter().try_reduce(|x, y| x.checked_add(y));"},{"DocComment":" assert_eq!(sum, Some(Some(58)));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Determine when a reduction short circuited:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_reduce)]"},{"DocComment":""},{"DocComment":" let numbers = vec![1, 2, 3, usize::MAX, 4, 5];"},{"DocComment":" let sum = numbers.into_iter().try_reduce(|x, y| x.checked_add(y));"},{"DocComment":" assert_eq!(sum, None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Determine when a reduction was not performed because there are no elements:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_reduce)]"},{"DocComment":""},{"DocComment":" let numbers: Vec<usize> = Vec::new();"},{"DocComment":" let sum = numbers.into_iter().try_reduce(|x, y| x.checked_add(y));"},{"DocComment":" assert_eq!(sum, Some(None));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Use a [`Result`] instead of an [`Option`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_reduce)]"},{"DocComment":""},{"DocComment":" let numbers = vec![\"1\", \"2\", \"3\", \"4\", \"5\"];"},{"DocComment":" let max: Result<Option<_>, <usize as std::str::FromStr>::Err> ="},{"DocComment":"     numbers.into_iter().try_reduce(|x, y| {"},{"DocComment":"         if x.parse::<usize>()? > y.parse::<usize>()? { Ok(x) } else { Ok(y) }"},{"DocComment":"     });"},{"DocComment":" assert_eq!(max, Ok(Some(\"5\")));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"R"},{"index":2,"name":"T2"},{"index":3,"name":"Clause0_Item"},{"index":4,"name":"Clause2_TryType"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":31050}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":20,"beg":{"line":2778,"col":11},"end":{"line":2778,"col":91}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":31037}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":20,"beg":{"line":2778,"col":54},"end":{"line":2778,"col":90}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":11,"generics":{"regions":[],"types":[{"HashConsedValue":[31999,{"TraitType":[{"HashConsedValue":[31998,{"kind":{"Clause":{"Free":1}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":31037}],"const_generics":[],"trait_refs":[]}}}}]},1,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}]},{"Deduplicated":31818},{"Deduplicated":31048}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"data":{"file_id":20,"b