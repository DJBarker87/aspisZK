]."},{"DocComment":""},{"DocComment":" [`is_partitioned()`]: Iterator::is_partitioned"},{"DocComment":" [`partition()`]: Iterator::partition"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_partition_in_place)]"},{"DocComment":""},{"DocComment":" let mut a = [1, 2, 3, 4, 5, 6, 7];"},{"DocComment":""},{"DocComment":" // Partition in-place between evens and odds"},{"DocComment":" let i = a.iter_mut().partition_in_place(|n| n % 2 == 0);"},{"DocComment":""},{"DocComment":" assert_eq!(i, 3);"},{"DocComment":" assert!(a[..i].iter().all(|n| n % 2 == 0)); // evens"},{"DocComment":" assert!(a[i..].iter().all(|n| n % 2 == 1)); // odds"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034},{"Deduplicated":3141}],"output":{"Deduplicated":1677}},"default":{"id":48,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31034},{"Deduplicated":1725},{"Deduplicated":3141},{"Deduplicated":3527}],"const_generics":[],"trait_refs":[{"Deduplicated":31768},{"HashConsedValue":[31790,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":14,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":3514}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[24363,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":3131},{"Deduplicated":3970},{"Deduplicated":1681}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":3614},{"Deduplicated":3615}]}}},"kind":{"TraitMethod":[1,34]}},{"params":{"regions":[],"types":[{"index":0,"name":"P"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":20,"beg":{"line":2395,"col":11},"end":{