Comment":" less than two items and after the last item is yielded."},{"DocComment":""},{"DocComment":" If the iterator's item implements [`Clone`], it may be easier to use"},{"DocComment":" [`intersperse`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_intersperse)]"},{"DocComment":""},{"DocComment":" #[derive(PartialEq, Debug)]"},{"DocComment":" struct NotClone(usize);"},{"DocComment":""},{"DocComment":" let v = [NotClone(0), NotClone(1), NotClone(2)];"},{"DocComment":" let mut it = v.into_iter().intersperse_with(|| NotClone(99));"},{"DocComment":""},{"DocComment":" assert_eq!(it.next(), Some(NotClone(0)));  // The first element from `v`."},{"DocComment":" assert_eq!(it.next(), Some(NotClone(99))); // The separator."},{"DocComment":" assert_eq!(it.next(), Some(NotClone(1)));  // The next element from `v`."},{"DocComment":" assert_eq!(it.next(), Some(NotClone(99))); // The separator."},{"DocComment":" assert_eq!(it.next(), Some(NotClone(2)));  // The last element from `v`."},{"DocComment":" assert_eq!(it.next(), None);               // The iterator is finished."},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `intersperse_with` can be used in situations where the separator needs"},{"DocComment":" to be computed:"},{"DocComment":" ```"},{"DocComment":" #![feature(iter_intersperse)]"},{"DocComment":""},{"DocComment":" let src = [\"Hello\", \"to\", \"all\", \"people\", \"!!\"].iter().copied();"},{"DocComment":""},{"DocComment":" // The closure mutably borrows its context to generate an item."},{"DocComment":" let mut happy_emojis = [\" ❤️ \", \" 😀 \"].into_iter();"},{"DocComment":" let separator = || happy_emojis.next().unwrap_or(\" 🦀 \");"},{"DocComment":""},{"DocComment":" let result = src.intersperse_with(separator).collect::<String>();"},{"DocComment":" assert_eq!(result, \"Hello ❤️ to 😀 all 🦀 people 🦀 !!\");"},{"DocComment":" ```"},{"DocComment":" [`Clone`]: crate::clone::Clone"},{"DocComment":" [`intersperse`]: Iterator::intersperse"},{"DocComment":" [`intersperse_with`]: Iterator::intersperse_with"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"G"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":31044}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":20,"beg":{"line":775,"col":11},"end":{"line":775,"col":32}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":31037},{"Deduplicated":1596},{"Deduplicated":31044}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":31037}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31034},{"Deduplicated":31037}],"output":{"HashConsedValue":[31890,{"Adt":{"id":{"Adt":23},"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":31037},{"Deduplicated":31044}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitDecl":{"trait_ref":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":31044}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":11}}},"is_global_initializer":null,"body":{"St