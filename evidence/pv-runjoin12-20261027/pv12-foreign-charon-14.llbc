ture(iter_collect_into)]"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let mut vec: Vec::<i32> = Vec::with_capacity(6);"},{"DocComment":""},{"DocComment":" a.iter().map(|x| x * 2).collect_into(&mut vec);"},{"DocComment":" a.iter().map(|x| x * 10).collect_into(&mut vec);"},{"DocComment":""},{"DocComment":" assert_eq!(6, vec.capacity());"},{"DocComment":" assert_eq!(vec, vec![2, 4, 6, 10, 20, 30]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The returned mutable reference can be used to continue the call chain:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_collect_into)]"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let mut vec: Vec::<i32> = Vec::with_capacity(6);"},{"DocComment":""},{"DocComment":" let count = a.iter().collect_into(&mut vec).iter().count();"},{"DocComment":""},{"DocComment":" assert_eq!(count, vec.len());"},{"DocComment":" assert_eq!(vec, vec![1, 2, 3]);"},{"DocComment":""},{"DocComment":" let count = a.iter().collect_into(&mut vec).iter().count();"},{"DocComment":""},{"DocComment":" assert_eq!(count, vec.len());"},{"DocComment":" assert_eq!(vec, vec![1, 2, 3, 1, 2, 3]);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"E"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":31044}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":20,"beg":{"line":2238,"col":23},"end":{"line":2238,"col":41}},"generated_from_span":null},"origin":"WhereClauseOnFn","t