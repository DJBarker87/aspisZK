ssert_eq!(result, Ok(Some(\"2\")));"},{"DocComment":""},{"DocComment":" let result = a.into_iter().try_find(|&s| is_my_num(s, 5));"},{"DocComment":" assert!(result.is_err());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This also supports other types which implement [`Try`], not just [`Result`]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(try_find)]"},{"DocComment":""},{"DocComment":" use std::num::NonZero;"},{"DocComment":""},{"DocComment":" let a = [3, 5, 7, 4, 9, 0, 11u32];"},{"DocComment":" let result = a.into_iter().try_find(|&x| NonZero::new(x).map(|y| y.is_power_of_two()));"},{"DocComment":" assert_eq!(result, Some(Some(4)));"},{"DocComment":" let result = a.into_iter().take(3).try_find(|&x| NonZero::new(x).map(|y| y.is_power_of_two()));"},{"DocComment":" assert_eq!(result, Some(None));"},{"DocComment":" let result = a.into_iter().rev().try_find(|&x| NonZero::new(x).map(|y| y.is_power_of_two()));"},{"DocComment":" assert_eq!(result, None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"R"},{"index":2,"name":"T2"},{"index":3,"name":"Clause0_Item"},{"index":4,"name":"Clause2_TryType"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":14,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31034},{"Deduplicated":31050}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":20,"beg":{"line":3056,"col":11},"end":{"line":3056,"col":69}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":31037}],"const_generics":[],"trait_refs":[]}}}