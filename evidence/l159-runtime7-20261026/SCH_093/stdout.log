structure AspisR1.S2W_TraceSplice.SecondMarks {E : Type} {ops : AdapterRw.Ops}
  (port : AspisR1.S2W_ExpandedChildren.ChildConeJoin E ops) : Prop
number of parameters: 3
fields:
  AspisR1.S2W_TraceSplice.SecondMarks.source : ∀ (event : AspisR1.S2W_Trace.Event),
      AspisR1.S2W_OuterOccurrences.mark event = some true →
        ∃ ss,
          List.map AspisR1.S2W_TraceSplice.project (AspisR1.S2W_ExpandedChildren.events port event) =
            AspisR1.S2W_SiteSchedule.secondTrace ss
