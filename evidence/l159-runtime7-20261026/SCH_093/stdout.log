      ∀ (event : AspisR1.S2W_Trace.Event),
        AspisR1.S2W_OuterOccurrences.mark event = some true →
          ∃ ss,
            List.map AspisR1.S2W_TraceSplice.project (AspisR1.S2W_ExpandedChildren.events port event) =
              AspisR1.S2W_SiteSchedule.secondTrace ss) :
    AspisR1.S2W_TraceSplice.SecondMarks port
structure AspisR1.CPH_Game.DeployedPairExecution {Tx A : Type} (p : AspisR1.CPG_Projection.Observations Tx A) (t u : Tx)
  (e1 e2 : AspisR1.S2W_D189Entry.Entry) (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
  (sourceActions : List (AspisR1.CPP_BankState.Action A)) (n1 : AspisR1.S2W_ExtractionBoundary.First)
  (n2 : AspisR1.S2W_ExtractionBoundary.Second)
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (id : AspisR1.S2W_ExtractionBoundary.Program) : Prop
number of parameters: 14
fields:
  AspisR1.CPH_Game.DeployedPairExecution.consecutive : p.next t u ∧
      e1 = AspisR1.CPG_Projection.entry p t ∧ e2 = AspisR1.CPG_Projection.entry p u
  AspisR1.CPH_Game.DeployedPairExecution.checkpoint : ((p.layout t).handles 2).1 = ((p.layout u).handles 6).1 ∧
      AspisR1.CPS_PhysicalKey.key e1 2 = AspisR1.CPS_PhysicalKey.key e2 6 ∧
        ((p.layout t).handles 2).1 ∉ p.intervening t u
  AspisR1.CPH_Game.DeployedPairExecution.parent : AspisR1.CPG_Projection.success p t = true
  AspisR1.CPH_Game.DeployedPairExecution.recorded : (p.copied t = saved ∧
        p.actions t = sourceActions ∧
          AspisR1.CPG_RuntimeTrace.Executes n1 n2 copy allocator id
            (AspisR1.CPR_SourceBank.afterCopy (AspisR1.CPG_Projection.cached (p.bank t)) ((p.layout t).handles 2).1
              saved)
            sourceActions (p.parentTentative t) (p.physicalEvents t)) ∧
      AspisR1.CPG_RuntimeTrace.Executes n1 n2 copy allocator id (AspisR1.CPG_Projection.cached (p.bank u)) (p.actions u)
        (p.parentTentative u) (p.physicalEvents u)
constructor:
  AspisR1.CPH_Game.DeployedPairExecution.mk {Tx A : Type} {p : AspisR1.CPG_Projection.Observations Tx A} {t u : Tx}
    {e1 e2 : AspisR1.S2W_D189Entry.Entry} {saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8}
    {sourceActions : List (AspisR1.CPP_BankState.Action A)} {n1 : AspisR1.S2W_ExtractionBoundary.First}
    {n2 : AspisR1.S2W_ExtractionBoundary.Second}
    {copy :
      AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
        ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record)}
    {allocator : AspisR1.S2W_D189Wrappers.Allocator A} {id : AspisR1.S2W_ExtractionBoundary.Program}
    (consecutive : p.next t u ∧ e1 = AspisR1.CPG_Projection.entry p t ∧ e2 = AspisR1.CPG_Projection.entry p u)
    (checkpoint :
      ((p.layout t).handles 2).1 = ((p.layout u).handles 6).1 ∧
        AspisR1.CPS_PhysicalKey.key e1 2 = AspisR1.CPS_PhysicalKey.key e2 6 ∧
          ((p.layout t).handles 2).1 ∉ p.intervening t u)
    (parent : AspisR1.CPG_Projection.success p t = true)
    (recorded :
      (p.copied t = saved ∧
          p.actions t = sourceActions ∧
            AspisR1.CPG_RuntimeTrace.Executes n1 n2 copy allocator id
              (AspisR1.CPR_SourceBank.afterCopy (AspisR1.CPG_Projection.cached (p.bank t)) ((p.layout t).handles 2).1
                saved)
              sourceActions (p.parentTentative t) (p.physicalEvents t)) ∧
        AspisR1.CPG_RuntimeTrace.Executes n1 n2 copy allocator id (AspisR1.CPG_Projection.cached (p.bank u))
          (p.actions u) (p.parentTentative u) (p.physicalEvents u)) :
    AspisR1.CPH_Game.DeployedPairExecution p t u e1 e2 saved sourceActions n1 n2 copy allocator id
