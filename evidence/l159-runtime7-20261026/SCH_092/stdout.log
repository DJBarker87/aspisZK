fields:
  AspisR1.Port4D_Pairing.RoundLaws.boundary : ∀ (c0 c4 lhs : AspisR1Stage2.Stage2Finish.E),
      ops.field bytes 0#usize = Aeneas.Std.Result.ok c0 →
        ops.field bytes 4#usize = Aeneas.Std.Result.ok c4 →
          ops.add c0 c4 = Aeneas.Std.Result.ok lhs → decode lhs = AspisR1.TwoRoundComparison.boundary poly
  AspisR1.Port4D_Pairing.RoundLaws.quarter : ∀ (m : AspisR1Stage2.Stage2Finish.M)
      (claim rhs : AspisR1Stage2.Stage2Finish.E),
      ops.quarter = Aeneas.Std.Result.ok m →
        ops.mulM claim m = Aeneas.Std.Result.ok rhs → decode rhs = AspisR1.RoundPairing.quarter * decode claim
  AspisR1.Port4D_Pairing.RoundLaws.eval : ∀ (alpha value : AspisR1Stage2.Stage2Finish.E),
      ops.polynomial bytes alpha = Aeneas.Std.Result.ok value → decode value = Polynomial.eval (decode alpha) poly
constructor:
  AspisR1.Port4D_Pairing.RoundLaws.mk {F W : Type} [Field F] {ops : AspisR1Stage2.Stage2Finish.FinishOps W}
    {decode : AspisR1Stage2.Stage2Finish.E → F} {bytes : Aeneas.Std.Slice Aeneas.Std.U8} {poly : Polynomial F}
    (boundary :
      ∀ (c0 c4 lhs : AspisR1Stage2.Stage2Finish.E),
        ops.field bytes 0#usize = Aeneas.Std.Result.ok c0 →
          ops.field bytes 4#usize = Aeneas.Std.Result.ok c4 →
            ops.add c0 c4 = Aeneas.Std.Result.ok lhs → decode lhs = AspisR1.TwoRoundComparison.boundary poly)
    (quarter :
      ∀ (m : AspisR1Stage2.Stage2Finish.M) (claim rhs : AspisR1Stage2.Stage2Finish.E),
        ops.quarter = Aeneas.Std.Result.ok m →
          ops.mulM claim m = Aeneas.Std.Result.ok rhs → decode rhs = AspisR1.RoundPairing.quarter * decode claim)
    (eval :
      ∀ (alpha value : AspisR1Stage2.Stage2Finish.E),
        ops.polynomial bytes alpha = Aeneas.Std.Result.ok value → decode value = Polynomial.eval (decode alpha) poly) :
    AspisR1.Port4D_Pairing.RoundLaws ops decode bytes poly
