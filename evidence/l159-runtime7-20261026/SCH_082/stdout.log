'AspisR1.SCH_Nonvacuity.interpretation' depends on axioms: [propext, Classical.choice, Quot.sound]
AspisR1.SCG_Nonvacuity.joint {F C : Type} (c : DrvC_Installation.Configuration F C)
  (hashv : SdkC_Source.Parts → Result SdkC_Source.Digest) (data1 data2 : Slice U8) (slot : S2W_ExtractionBoundary.Slot)
  (H : Bytes → State)
  (project : GExq_AccountExperiment.Outcome Unit → OraclePortCompactDraft.Parsed × (Fin 22 → Fin 262144))
  (select : GExq_AccountExperiment.Outcome Unit → R9PoolRuntimeBinding.Inputs × R9PoolRuntimeBinding.Inputs) :
  ((S2Trust.S2TrustedSdkBorrow (S2Trust.model (ℕ → S2W_D189Entry.Record)) ∧
        S2W_TrustedStd.TrustedStd SCE_FixtureData.copy ∧
          Nonempty
              (S2W_D189Consolidation.RuntimeEntrypointAdmission (S2Trust.model (ℕ → S2W_D189Entry.Record))
                SCE_FixtureData.e1 SCE_FixtureData.e1.heap 3) ∧
            Nonempty
                (S2W_D189Consolidation.RuntimeEntrypointAdmission (S2Trust.model (ℕ → S2W_D189Entry.Record))
                  SCE_FixtureData.e2 SCE_FixtureData.e2.heap 7) ∧
              CPH_Game.DeployedPairExecution SCE_FixtureData.observations false true SCE_FixtureData.e1
                  SCE_FixtureData.e2 SCE_FixtureData.saved SCE_FixtureData.suffix SCE_FixtureData.n1 SCE_FixtureData.n2
                  SCE_FixtureData.copy SCE_FixtureData.allocator SCE_FixtureData.id ∧
                CPR_DataPersistence.TwoTransactionLaw (CPG_Projection.adjacent SCE_FixtureData.observations)
                    (CPG_Projection.ordinary SCE_FixtureData.observations (Hist_Nonvacuity.key 0#u8))
                    (CPG_Projection.before SCE_FixtureData.observations)
                    (CPG_Projection.tentative SCE_FixtureData.observations)
                    (CPG_Projection.success SCE_FixtureData.observations)
                    (CPG_Projection.loaded SCE_FixtureData.observations) ∧
                  S2W_D189Wrappers.first SCE_FixtureData.n1 SCE_FixtureData.copy SCE_FixtureData.allocator
                        SCE_FixtureData.e1 SCE_FixtureData.id data1 () =
                      ok (core.result.Result.Ok (SCE_FixtureData.saved, SCE_FixtureWrappers.post1, ())) ∧
                    S2W_D189Wrappers.second SCE_FixtureData.n2 SCE_FixtureData.allocator SCE_FixtureData.e2
                          SCE_FixtureData.id data2 slot () =
                        ok (core.result.Result.Ok (SCE_FixtureData.e2.heap, ())) ∧
                      Nonempty
                          (S2X.CheckpointVersionBinding
                            (S2W_EntryWriteHistory.payloadBytes S2W_ReturnedCheckpoint.encode
                              (SCE_FixtureWrappers.post1.payload (SCE_FixtureData.e1.heap.accounts 2).1) 1768)
                            (MultiproofConeCanonical.bytesOf
                              ↑(SCE_FixtureData.e2.buffers (SCE_FixtureData.e2.handles 6).1))) ∧
                        SCE_FixtureData.observations.physicalEvents false ≠ [] ∧
                          (eval H (SCE_Experiment.submission (SCE_FixtureSubmission.adversary data1 data2 slot))).2 =
                            { publicBytes := MultiproofConeCanonical.bytesOf JFx_NativeBytes.publicBytes,
                              stored := MultiproofConeCanonical.bytesOf JFx_NativeBytes.proofBytes }) ∧
      ∃ run,
        (eval H
                (SCE_Experiment.runtime c hashv SCE_FixtureData.copy SCE_FixtureData.allocator SCE_FixtureData.id
                  (SCE_FixtureSubmission.adversary data1 data2 slot))).2 =
            some run ∧
          run.2.1.stored = MultiproofConeCanonical.bytesOf JFx_NativeBytes.proofBytes ∧
            run.2.1.physical.bytes = MultiproofConeCanonical.bytesOf JFx_NativeBytes.publicBytes) ∧
    (∀ (world : Bytes → State),
        (eval world
                (SCE_Experiment.account c hashv SCE_FixtureData.copy SCE_FixtureData.allocator SCE_FixtureData.id
                  (SCE_FixtureSubmission.adversary data1 data2 slot))).1.length ≤
          1921) ∧
      F3T_AccountCharge.mass
          (SCE_Experiment.account c hashv SCE_FixtureData.copy SCE_FixtureData.allocator SCE_FixtureData.id
