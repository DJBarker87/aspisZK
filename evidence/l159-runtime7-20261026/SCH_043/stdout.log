  [DecidableEq I] →
    (I → AspisV8PairedCommitment.Table I A → A → Prop) → AspisV8PairedCommitment.Table I A → List (I × A) → Prop :=
fun {I A} [DecidableEq I] bad x x_1 =>
  List.brecOn (motive := fun x => AspisV8PairedCommitment.Table I A → Prop) x_1 (FS.hitsBad._f bad) x
