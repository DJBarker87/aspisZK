def NFU_Retarget.LPl_Kit_Bytes.validChunk : ℕ → Bool → List U8 → Bool :=
fun width highZero bs =>
  (List.range width).all fun j =>
    have n := NFU_Retarget.LPl_Kit_Bytes.le32 (List.take 4 (List.drop (4 * j) bs));
    decide (n < 2147483647) && (!highZero || decide (j < 4 ∨ n = 0))
