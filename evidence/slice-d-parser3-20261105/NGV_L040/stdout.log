AspisS1ValuesOwnedExact.installed_exact (input output : Slice U8) (aligned : input.length % 16 = 0)
  (shape : output.length = 2 * input.length) (doubling : 2 * input.length ≤ Usize.max) :
  ∃ updated,
    AspisS1ValuesOwnedInstallation.expandValues input output = ok (core.result.Result.Ok (), updated) ∧
      updated.length = output.length ∧
        ∀ j < updated.length, (↑updated)[j]? = if j % 32 < 16 then (↑input)[j / 32 * 16 + j % 32]? else some 0#u8
AspisS1ValuesOwnedInstallation.nativeValues : AspisS1NativeCompact.Ops
def NFU_Retarget.LPl_A.Expand.byte : List U8 → ℕ → U8 :=
fun bs i => if i % 32 < 16 then bs[i / 32 * 16 + i % 32]?.getD 0#u8 else 0#u8
