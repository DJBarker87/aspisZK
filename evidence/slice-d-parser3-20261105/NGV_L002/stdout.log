def AspisR1PrefixAggregateParser.r1_wire.parse_record : U8 →
  Slice U8 → Result (core.result.Result (Slice U8) AspisR1PrefixAggregateParser.r1_wire.Error) :=
fun row record1 => do
  let o ← AspisR1PrefixAggregateParser.r1_wire.row_shape row
  let r ← AspisR1PrefixAggregateParser.core.option.Option.ok_or o AspisR1PrefixAggregateParser.r1_wire.Error.InvalidRow
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
    | core.ops.control_flow.ControlFlow.Continue val =>
      let (tag, size) := val
      have i := record1.len;
      do
      let i1 ← 5#usize + size
      if (i != i1) = true then ok (core.result.Result.Err (AspisR1PrefixAggregateParser.r1_wire.Error.Length row))
        else do
          let i2 ← record1.index_usize 0#usize
          if (i2 != tag) = true then ok (core.result.Result.Err (AspisR1PrefixAggregateParser.r1_wire.Error.Tag row))
            else do
              let i3 ← record1.index_usize 1#usize
              let i4 ← record1.index_usize 2#usize
              let i5 ← record1.index_usize 3#usize
              let i6 ← record1.index_usize 4#usize
              let i7 ← lift (core.num.U32.from_le_bytes (Array.make 4#usize [i3, i4, i5, i6] ⋯))
              let i8 ← lift (UScalar.cast UScalarTy.Usize i7)
              if (i8 != size) = true then
                  ok (core.result.Result.Err (AspisR1PrefixAggregateParser.r1_wire.Error.Length row))
                else do
                  let payload ←
                    core.slice.index.Slice.index (core.slice.index.SliceIndexRangeFromUsizeSlice U8) record1
                        { start := 5#usize }
                  if row ≥ 14#u8 then do
                      let r1 ← AspisR1PrefixAggregateParser.r1_wire.validate_record_fields row payload
                      let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
                      match cf1 with
                        | core.ops.control_flow.ControlFlow.Continue a => ok (core.result.Result.Ok payload)
                        | core.ops.control_flow.ControlFlow.Break residual =>
                          core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual (Slice U8)
                            (core.convert.FromSame AspisR1PrefixAggregateParser.r1_wire.Error) residual
                    else ok (core.result.Result.Ok payload)
    | core.ops.control_flow.ControlFlow.Break residual =>
      core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual (Slice U8)
        (core.convert.FromSame AspisR1PrefixAggregateParser.r1_wire.Error) residual
