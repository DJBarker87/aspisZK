def Aeneas.Std.core.slice.Slice.chunks_exact : {T : Type} → Slice T → Usize → Result (core.slice.iter.ChunksExact T) :=
fun {T} s chunk_size =>
  if hcs : ↑chunk_size > 0 then
    let result := List.toChunksExact (↑chunk_size) hcs ↑s;
    have sliceChunks :=
      List.map
        (fun x =>
          match x with
          | ⟨c, hc⟩ => ⟨c, ⋯⟩)
        result.1.attach;
    ok { chunks := sliceChunks, remainder := ⟨result.2, ⋯⟩ }
  else fail Error.panic
