def Aeneas.Std.core.iter.traits.iterator.Iterator.collect.default : {Self B Item : Type} →
  core.iter.traits.iterator.Iterator Self Item → core.iter.traits.collect.FromIterator B Item → Self → Result B :=
fun {Self B Item} IteratorInst collectFromIteratorInst self =>
  collectFromIteratorInst.from_iter (core.iter.traits.collect.IntoIterator.Blanket IteratorInst) self
def Aeneas.Std.core.iter.traits.iterator.Iterator.rev.default : {Self : Type} →
  Self → Result (core.iter.adapters.rev.Rev Self) :=
fun {Self} self => Result.ok { iter := self }
def Aeneas.Std.core.iter.traits.iterator.Iterator.enumerate.default : {Self : Type} →
  Self → Result (core.iter.adapters.enumerate.Enumerate Self) :=
fun {Self} self => Result.ok { iter := self, count := 0#usize }
def Aeneas.Std.core.iter.traits.iterator.Iterator.step_by.default : {Self : Type} →
  Self → Usize → Result (core.iter.adapters.step_by.StepBy Self) :=
fun {Self} self step_by =>
  if ↑step_by = 0 then Result.fail Error.panic else Result.ok { iter := self, step_by := step_by }
def Aeneas.Std.core.slice.iter.IteratorSliceIter.next : {T : Type} →
  core.slice.iter.Iter T → Result (Option T × core.slice.iter.Iter T) :=
fun {T} it =>
  if h : it.i < ↑it.slice.len then
    have x := it.slice[it.i];
    have it := { slice := it.slice, i := it.i + 1 };
    Result.ok (some x, it)
  else Result.ok (none, it)
def Aeneas.Std.core.slice.iter.IteratorIterMut.next : {T : Type} →
  core.slice.iter.IterMut T →
    Result
      (Option T × core.slice.iter.IterMut T × (core.slice.iter.IterMut T → Option T → core.slice.iter.IterMut T)) :=
fun {T} it =>
  if h : it.i < ↑it.slice.len then
    have x := it.slice[it.i];
    have i := it.i;
    have it := { slice := it.slice, i := i + 1 };
    have back := fun it' x =>
      match x with
      | none => it'
      | some x => { slice := it'.slice.setAtNat i x, i := it'.i };
    Result.ok (some x, it, back)
  else Result.ok (none, it, fun it x => it)
