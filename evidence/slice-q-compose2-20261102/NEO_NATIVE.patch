+mod NEO_reference {include!("NEO_parser_reference.rs");}
+check!(m_stdref,b,[u8;4],M31::from_le_bytes(b).map(|x|x.0),NEO_reference::m_ref(b),false);
+check!(m_stdref_wrong,b,[u8;4],M31::from_le_bytes(b).map(|x|x.0),NEO_reference::m_ref(b),true);
