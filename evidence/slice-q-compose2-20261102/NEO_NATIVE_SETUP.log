{"frozen_revision": "4bb3b3f51e16b4525f1d10336e2b0bcbbd775387", "frozen_source_files": 477, "root_manifest": "[workspace]\nmembers = [\n    \"crates/aspis-core\",\n    \"crates/aspis-r1-cost-probe\",\n    \"crates/aspis-prover\",\n    \"crates/aspis-statement\",\n    \"programs/aspis-pool\",\n    \"programs/aspis-registry\",\n    \"programs/aspis-verifier\",\n    \"programs/r1-cost-probe\",\n    \"audit/poseidon-pair-probe/program\",\n    \"xtask\",\n    # Extracted builder copies (D68.2): the shipped pair-forest trace writers.\n    # Their src/lib.rs files are the pinned extraction inputs; keep them byte-identical.\n    \"docs/research/v8-r0-zk-20261009/refine/writers\",\n    \"docs/research/v8-r0-zk-20261009/refine/blockwriters\",\n    \"docs/research/v8-r0-zk-20261009/refine/poseidon\",\n]\n# The research probes under docs/ are standalone crates with their own\n# [workspace]; the R1 cost probe uses the z4 probe library only behind its\n# `r1p-check` feature (LOG D38.3).\nexclude = [\"docs\"]\nresolver = \"2\"\n\n[workspace.package]\nedition = \"2021\"\nlicense = \"MIT OR Apache-2.0\"\nversion = \"0.1.0\"\n\n[workspace.dependencies]\nhkdf = \"0.12.4\"\nhpke = { version = \"=0.14.0\", default-features = false, features = [\"alloc\", \"chacha\", \"x25519\"] }\naspis-core = { path = \"crates/aspis-core\" }\naspis-prover = { path = \"crates/aspis-prover\" }\naspis-statement = { path = \"crates/aspis-statement\" }\naspis-verifier = { path = \"programs/aspis-verifier\", default-features = false, features = [\"no-entrypoint\"] }\nanyhow = \"1.0.100\"\nbase64 = \"0.22.1\"\nbincode = \"1.3.3\"\nborsh = { version = \"=1.5.7\", features = [\"derive\"] }\nchrono = { version = \"0.4.42\", default-features = false, features = [\"clock\", \"serde\", \"std\"] }\nchacha20poly1305 = { version = \"=0.11.0\", default-features = false, features = [\"zeroize\"] }\ngetrandom = \"0.3.4\"\nreqwest = { version = \"0.12.28\", default-features = false, features = [\"blocking\", \"json\", \"rustls-tls\"] }\nserde = { version = \"1.0.228\", features = [\"derive\"] }\nserde_json = \"1.0.145\"\nsha2 = \"0.10.8\"\nsolana-program = \"2.3.0\"\nsolana-loader-v3-interface = { version = \"5.0.0\", features = [\"bincode\"] }\nsolana-sdk = \"2.3.0\"\nsolana-system-interface = { version = \"1.0.0\", features = [\"bincode\"] }\nzeroize = \"1.8.1\"\nx25519-dalek = { version = \"=3.0.0\", default-features = false, features = [\"zeroize\"] }\n\n# The extracted P_R1 checker and builders are modelled with checked arithmetic\n# (an overflow is a failure, D57.1): keep overflow checks in optimized builds.\n[profile.release.package.aspis-r1-cert-check]\noverflow-checks = true\n\n[profile.release.package.aspis-r1-cert-build]\noverflow-checks = true\n", "lock_sha256": "5782e6a32026fdd95d252d0db7ea20b16716e6deb4f5a397e744886bb6ba22ef", "copy_patch_sha256": "bcdf749b78eb6143789500d98d64ec3d407b8a17a6d1290c70c822473e8e9a67"}
