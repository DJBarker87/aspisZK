{"Deduplicated":440}},{"span":{"data":{"file_id":1,"beg":{"line":165,"col":4},"end":{"line":165,"col":29}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"message","ty":{"HashConsedValue":[2058,{"Ref":["Static",{"HashConsedValue":[1009,{"Adt":{"id":{"Builtin":"Str"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]},"Shared"]}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[16,0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":{"Align":4},"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":6,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["non_null",0]},{"Ident":["NonNull",0]}],"span":{"data":{"file_id":8,"beg":{"line":74,"col":0},"end":{"line":74,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `*mut T` but non-zero and [covariant]."},{"DocComment":""},{"DocComment":" This is often the correct thing to use when building data structures using"},{"DocComment":" raw pointers, but is ultimately more dangerous to use because of its additional"},{"DocComment":" properties. If you're not sure if you should use `NonNull<T>`, just use `*mut T`!"},{"DocComment":""},{"DocComment":" Unlike `*mut T`, the pointer must always be non-null, even if the pointer"},{"DocComment":" is never dereferenced. This is so that enums may use this forbidden value"},{"DocComment":" as a discriminant -- `Option<NonNull<T>>` has the same size as `*mut T`."},{"DocComment":" However the pointer may still dangle if it isn't dereferenced."},{"DocComment":""},{"DocComment":" Unlike `*mut T`, `NonNull<T>` is covariant over `T`. This is usually the correct"},{"DocComment":" choice for most data structures and safe abstractions, such as `Box`, `Rc`, `Arc`, `Vec`,"},{"DocComment":" and `LinkedList`."},{"DocComment":""},{"DocComment":" In rare cases, if your type exposes a way to mutate the value of `T` through a `NonNull<T>`,"},{"DocComment":" and you need to prevent unsoundness from variance (for example, if `T` could be a reference"},{"DocComment":" with a shorter lifetime), you should add a field to make your type invariant, such as"},{"DocComment":" `PhantomData<Cell<T>>` or `PhantomData<&'a mut T>`."},{"DocComment":""},{"DocComment":" Example of a type that must be invariant:"},{"DocComment":" ```rust"},{"DocComment":" use std::cell::Cell;"},{"DocComment":" use std::marker::PhantomData;"},{"DocComment":" struct Invariant<T> {"},{"DocComment":"     ptr: std::ptr::NonNull<T>,"},{"DocComment":"     _invariant: PhantomData<Cell<T>>,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Notice that `NonNull<T>` has a `From` instance for `&T`. However, this does"},{"DocComment":" not change the fact that mutating through a (pointer derived from a) shared"},{"DocComment":" reference is undefined behavior unless the mutation happens inside an"},{"DocComment":" [`UnsafeCell<T>`]. The same goes for creating a mutable reference from a shared"},{"DocComment":" reference. When using this `From` instance without an `UnsafeCell<T>`,"},{"DocComment":" it is your responsibility to ensure that `as_mut` is never called, and `as_ptr`"},{"DocComment":" is never used for mutation."},{"DocComment":""},{"DocComment":" # Representation"},{"DocComment":""},{"DocComment":" Thanks to the [null pointer optimization],"},{"DocComment":" `NonNull<T>` and `Option<NonNull<T>>`"},{"DocComment":" are guaranteed to have the same size and alignment:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ptr::NonNull;"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<NonNull<i16>>(), size_of::<Option<NonNull<i16>>>());"},{"DocComment":" assert_eq!(align_of::<NonNull<i16>>(), align_of::<Option<NonNull<i16>>>());"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<NonNull<str>>(), size_of::<Option<NonNull<str>>>());"},{"DocComment":" assert_eq!(align_of::<NonNull<str>>(), align_of::<Option<NonNull<str>>>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [covariant]: https://doc.rust-lang.org/reference/subtyping.html"},{"DocComment":" [`PhantomData`]: crate::marker::PhantomData"},{"DocComment":" [`UnsafeCell<T>`]: crate::cell::UnsafeCell"},{"DocComment":" [null pointer optimization]: crate::option#representation"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"NonNull"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":7,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["io",0]},{"Ident":["error",0]},{"Ident":["repr_bitpacked",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":553},"kind":"InherentImplBlock"}}},{"Ident":["data",0]},{"Ident":["closure",0]}],"span":{"data":{"file_id":7,"beg":{"line":210,"col":37},"end":{"line":210,"col":40}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":{"Closure":{"info":{"kind":"FnOnce","fn_once_impl":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":0,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[],"const_generics":[],"trait_refs":[]}}},"fn_mut_impl":null,"fn_impl":null,"signature":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[760,{"RawPtr":[{"Deduplicated":633},"Mut"]}]}],"output":{"HashConsedValue":[761,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":633},"Shared"]}]}}}}}},"kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":8,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["PhantomData",0]}],"span":{"data":{"file_id":16,"beg":{"line":811,"col":0},"end":{"line":811,"col":39}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Zero-sized type used to mark things that \"act like\" they own a `T`."},{"DocComment":""},{"DocComment":" Adding a `PhantomData<T>` field to your type tells the compiler that your"},{"DocComment":" type acts as though it stores a value of type `T`, even though it doesn't"},{"DocComment":" really. This information is used when computing certain safety properties."},{"DocComment":""},{"DocComment":" For a more in-depth explanation of how to use `PhantomData<T>`, please see"},{"DocComment":" [the Nomicon](../../nomicon/phantom-data.html)."},{"DocComment":""},{"DocComment":" # A ghastly note 👻👻👻"},{"DocComment":""},{"DocComment":" Though they both have scary names, `PhantomData` and 'phantom types' are"},{"DocComment":" related, but not identical. A phantom type parameter is simply a type"},{"DocComment":" parameter which is never used. In Rust, this often causes the compiler to"},{"DocComment":" complain, and the solution is to add a \"dummy\" use by way of `PhantomData`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ## Unused lifetime parameters"},{"DocComment":""},{"DocComment":" Perhaps the most common use case for `PhantomData` is a struct that has an"},{"DocComment":" unused lifetime parameter, typically as part of some unsafe code. For"},{"DocComment":" example, here is a struct `Slice` that has two pointers of type `*const T`,"},{"DocComment":" presumably pointing into an array somewhere:"},{"DocComment":""},{"DocComment":" ```compile_fail,E0392"},{"DocComment":" struct Slice<'a, T> {"},{"DocComment":"     start: *const T,"},{"DocComment":"     end: *const T,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The intention is that the underlying data is only valid for the"},{"DocComment":" lifetime `'a`, so `Slice` should not outlive `'a`. However, this"},{"DocComment":" intent is not expressed in the code, since there are no uses of"},{"DocComment":" the lifetime `'a` and hence it is not clear what data it applies"},{"DocComment":" to. We can correct this by telling the compiler to act *as if* the"},{"DocComment":" `Slice` struct contained a reference `&'a T`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::marker::PhantomData;"},{"DocComment":""},{"DocComment":" # #[allow(dead_code)]"},{"DocComment":" struct Slice<'a, T> {"},{"DocComment":"     start: *const T,"},{"DocComment":"     end: *const T,"},{"DocComment":"     phantom: PhantomData<&'a T>,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This also in turn infers the lifetime bound `T: 'a`, indicating"},{"DocComment":" that any references in `T` are valid over the lifetime `'a`."},{"DocComment":""},{"DocComment":" When initializing a `Slice` you simply provide the value"},{"DocComment":" `PhantomData` for the field `phantom`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" # use std::marker::PhantomData;"},{"DocComment":" # struct Slice<'a, T> {"},{"DocComment":" #     start: *const T,"},{"DocComment":" #     end: *const T,"},{"DocComment":" #     phantom: PhantomData<&'a T>,"},{"DocComment":" # }"},{"DocComment":" fn borrow_vec<T>(vec: &Vec<T>) -> Slice<'_, T> {"},{"DocComment":"     let ptr = vec.as_ptr();"},{"DocComment":"     Slice {"},{"DocComment":"         start: ptr,"},{"DocComment":"         end: unsafe { ptr.add(vec.len()) },"},{"DocComment":"         phantom: PhantomData,"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Unused type parameters"},{"DocComment":""},{"DocComment":" It sometimes happens that you have unused type parameters which"},{"DocComment":" indicate what type of data a struct is \"tied\" to, even though that"},{"DocComment":" data is not actually found in the struct itself. Here is an"},{"DocComment":" example where this arises with [FFI]. The foreign interface uses"},{"DocComment":" handles of type `*mut ()` to refer to Rust values of different"},{"DocComment":" types. We track the Rust type using a phantom type parameter on"},{"DocComment":" the struct `ExternalResource` which wraps a handle."},{"DocComment":""},{"DocComment":" [FFI]: ../../book/ch19-01-unsafe-rust.html#using-extern-functions-to-call-external-code"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" # trait ResType { }"},{"DocComment":" # struct ParamType;"},{"DocComment":" # mod foreign_lib {"},{"DocComment":" #     pub fn new(_: usize) -> *mut () { 42 as *mut () }"},{"DocComment":" #     pub fn do_stuff(_: *mut (), _: usize) {}"},{"DocComment":" # }"},{"DocComment":" # fn convert_params(_: ParamType) -> usize { 42 }"},{"DocComment":" use std::marker::PhantomData;"},{"DocComment":""},{"DocComment":" struct ExternalResource<R> {"},{"DocComment":"    resource_handle: *mut (),"},{"DocComment":"    resource_type: PhantomData<R>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<R: ResType> ExternalResource<R> {"},{"DocComment":"     fn new() -> Self {"},{"DocComment":"         let size_of_res = size_of::<R>();"},{"DocComment":"         Self {"},{"DocComment":"             resource_handle: foreign_lib::new(size_of_res),"},{"DocComment":"             resource_type: PhantomData,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     fn do_stuff(&self, param: ParamType) {"},{"DocComment":"         let foreign_params = convert_params(param);"},{"DocComment":"         foreign_lib::do_stuff(self.resource_handle, foreign_params);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Ownership and the drop check"},{"DocComment":""},{"DocComment":" The exact interaction of `PhantomData` with drop check **may change in the future**."},{"DocComment":""},{"DocComment":" Currently, adding a field of type `PhantomData<T>` indicates that your type *owns* data of type"},{"DocComment":" `T` in very rare circumstances. This in turn has effects on the Rust compiler's [drop check]"},{"DocComment":" analysis. For the exact rules, see the [drop check] documentation."},{"DocComment":""},{"DocComment":" ## Layout"},{"DocComment":""},{"DocComment":" For all `T`, the following are guaranteed:"},{"DocComment":" * `size_of::<PhantomData<T>>() == 0`"},{"DocComment":" * `align_of::<PhantomData<T>>() == 1`"},{"DocComment":""},{"DocComment":" [drop check]: Drop#drop-check"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"phantom_data"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":9,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Ident":["Global",0]}],"span":{"data":{"file_id":18,"beg":{"line":58,"col":0},"end":{"line":58,"col":17}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The global memory allocator."},{"DocComment":""},{"DocComment":" This type implements the [`Allocator`] trait by forwarding calls"},{"DocComment":" to the allocator registered with the `#[global_allocator]` attribute"},{"DocComment":" if there is one, or the `std` crate’s default."},{"DocComment":""},{"DocComment":" Note: while this type is unstable, the functionality it provides can be"},{"DocComment":" accessed through the [free functions in `alloc`](self#functions)."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"global_alloc_ty"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":10,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["error",0]},{"Ident":["Error",0]},{"Ident":["{vtable}",0]}],"span":{"data":{"file_id":20,"beg":{"line":59,"col":0},"end":{"line":59,"col":32}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":{"VTableTy":{"dyn_predicate":{"binder":{"params":{"regions":[],"types":[{"index":0,"name":"_dyn"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"Dyn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":1004}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":1004},"Erased"]}],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":968},"kind":"Dyn"}},"field_map":[],"supertrait_map":[null,null]}},"kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":11,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["option",0]},{"Ident":["Option",0]}],"span":{"data":{"file_id":21,"beg":{"line":597,"col":0},"end":{"line":597,"col":18}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The `Option` type. See [the module level documentation](self) for more."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Option"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":21,"beg":{"line":601,"col":4},"end":{"line":601,"col":8}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" No value."}],"inline":null,"rename":null,"public":true},"name":"None","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","0"]}}},{"id":1,"span":{"data":{"file_id":21,"beg":{"line":605,"col":4},"end":{"line":605,"col":8}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Some value of type `T`."}],"inline":null,"rename":null,"public":true},"name":"Some","fields":[{"span":{"data":{"file_id":21,"beg":{"line":605,"col":55},"end":{"line":605,"col":56}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":2055}}],"discriminant":{"Scalar":{"Signed":["Isize","1"]}}}]},"layout":[],"ptr_metadata":"None"},{"def_id":12,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["rt",0]},{"Ident":["Argument",0]}],"span":{"data":{"file_id":23,"beg":{"line":38,"col":0},"end":{"line":38,"col":23}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"format_argument"},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Shared"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":16,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":{"Align":2},"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},null,{"def_id":14,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["error",0]},{"Ident":["private",0]},{"Ident":["Internal",0]}],"span":{"data":{"file_id":20,"beg":{"line":268,"col":4},"end":{"line":268,"col":23}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":15,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["any",0]},{"Ident":["TypeId",0]}],"span":{"data":{"file_id":30,"beg":{"line":724,"col":0},"end":{"line":724,"col":17}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A `TypeId` represents a globally unique identifier for a type."},{"DocComment":""},{"DocComment":" Each `TypeId` is an opaque object which does not allow inspection of what's"},{"DocComment":" inside but does allow basic operations such as cloning, comparison,"},{"DocComment":" printing, and showing."},{"DocComment":""},{"DocComment":" A `TypeId` is currently only available for types which ascribe to `'static`,"},{"DocComment":" but this limitation may be removed in the future."},{"DocComment":""},{"DocComment":" While `TypeId` implements `Hash`, `PartialOrd`, and `Ord`, it is worth"},{"DocComment":" noting that the hashes and ordering will vary between Rust releases. Beware"},{"DocComment":" of relying on them inside of your code!"},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":""},{"DocComment":" Like other [`Rust`-representation][repr-rust] types, `TypeId`'s size and layout are unstable."},{"DocComment":" In particular, this means that you cannot rely on the size and layout of `TypeId` remaining the"},{"DocComment":" same between Rust releases; they are subject to change without prior notice between Rust"},{"DocComment":" releases."},{"DocComment":""},{"DocComment":" [repr-rust]: https://doc.rust-lang.org/reference/type-layout.html#r-layout.repr.rust.unspecified"},{"DocComment":""},{"DocComment":" # Danger of Improper Variance"},{"DocComment":""},{"DocComment":" You might think that subtyping is impossible between two static types,"},{"DocComment":" but this is false; there exists a static type with a static subtype."},{"DocComment":" To wit, `fn(&str)`, which is short for `for<'any> fn(&'any str)`, and"},{"DocComment":" `fn(&'static str)`, are two distinct, static types, and yet,"},{"DocComment":" `fn(&str)` is a subtype of `fn(&'static str)`, since any value of type"},{"DocComment":" `fn(&str)` can be used where a value of type `fn(&'static str)` is needed."},{"DocComment":""},{"DocComment":" This means that abstractions around `TypeId`, despite its"},{"DocComment":" `'static` bound on arguments, still need to worry about unnecessary"},{"DocComment":" and improper variance: it is advisable to strive for invariance"},{"DocComment":" first. The usability impact will be negligible, while the reduction"},{"DocComment":" in the risk of unsoundness will be most welcome."},{"DocComment":""},{"DocComment":" ## Examples"},{"DocComment":""},{"DocComment":" Suppose `SubType` is a subtype of `SuperType`, that is,"},{"DocComment":" a value of type `SubType` can be used wherever"},{"DocComment":" a value of type `SuperType` is expected."},{"DocComment":" Suppose also that `CoVar<T>` is a generic type, which is covariant over `T`"},{"DocComment":" (like many other types, including `PhantomData<T>` and `Vec<T>`)."},{"DocComment":""},{"DocComment":" Then, by covariance, `CoVar<SubType>` is a subtype of `CoVar<SuperType>`,"},{"DocComment":" that is, a value of type `CoVar<SubType>` can be used wherever"},{"DocComment":" a value of type `CoVar<SuperType>` is expected."},{"DocComment":""},{"DocComment":" Then if `CoVar<SuperType>` relies on `TypeId::of::<SuperType>()` to uphold any invariants,"},{"DocComment":" those invariants may be broken because a value of type `CoVar<SuperType>` can be created"},{"DocComment":" without going through any of its methods, like so:"},{"DocComment":" ```"},{"DocComment":" type SubType = fn(&());"},{"DocComment":" type SuperType = fn(&'static ());"},{"DocComment":" type CoVar<T> = Vec<T>; // imagine something more complicated"},{"DocComment":""},{"DocComment":" let sub: CoVar<SubType> = CoVar::new();"},{"DocComment":" // we have a `CoVar<SuperType>` instance without"},{"DocComment":" // *ever* having called `CoVar::<SuperType>::new()`!"},{"DocComment":" let fake_super: CoVar<SuperType> = sub;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The following is an example program that tries to use `TypeId::of` to"},{"DocComment":" implement a generic type `Unique<T>` that guarantees unique instances for each `Unique<T>`,"},{"DocComment":" that is, for each type `T` there can be at most one value of type `Unique<T>` at any time."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" mod unique {"},{"DocComment":"     use std::any::TypeId;"},{"DocComment":"     use std::collections::BTreeSet;"},{"DocComment":"     use std::marker::PhantomData;"},{"DocComment":"     use std::sync::Mutex;"},{"DocComment":""},{"DocComment":"     static ID_SET: Mutex<BTreeSet<TypeId>> = Mutex::new(BTreeSet::new());"},{"DocComment":""},{"DocComment":"     // TypeId has only covariant uses, which makes Unique covariant over TypeAsId 🚨"},{"DocComment":"     #[derive(Debug, PartialEq)]"},{"DocComment":"     pub struct Unique<TypeAsId: 'static>("},{"DocComment":"         // private field prevents creation without `new` outside this module"},{"DocComment":"         PhantomData<TypeAsId>,"},{"DocComment":"     );"},{"DocComment":""},{"DocComment":"     impl<TypeAsId: 'static> Unique<TypeAsId> {"},{"DocComment":"         pub fn new() -> Option<Self> {"},{"DocComment":"             let mut set = ID_SET.lock().unwrap();"},{"DocComment":"             (set.insert(TypeId::of::<TypeAsId>())).then(|| Self(PhantomData))"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     impl<TypeAsId: 'static> Drop for Unique<TypeAsId> {"},{"DocComment":"         fn drop(&mut self) {"},{"DocComment":"             let mut set = ID_SET.lock().unwrap();"},{"DocComment":"             (!set.remove(&TypeId::of::<TypeAsId>())).then(|| panic!(\"duplicity detected\"));"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" use unique::Unique;"},{"DocComment":""},{"DocComment":" // `OtherRing` is a subtype of `TheOneRing`. Both are 'static, and thus have a TypeId."},{"DocComment":" type TheOneRing = fn(&'static ());"},{"DocComment":" type OtherRing = fn(&());"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let the_one_ring: Unique<TheOneRing> = Unique::new().unwrap();"},{"DocComment":"     assert_eq!(Unique::<TheOneRing>::new(), None);"},{"DocComment":""},{"DocComment":"     let other_ring: Unique<OtherRing> = Unique::new().unwrap();"},{"DocComment":"     // Use that `Unique<OtherRing>` is a subtype of `Unique<TheOneRing>` 🚨"},{"DocComment":"     let fake_one_ring: Unique<TheOneRing> = other_ring;"},{"DocComment":"     assert_eq!(fake_one_ring, the_one_ring);"},{"DocComment":""},{"DocComment":"     std::mem::forget(fake_one_ring);"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"type_id"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":16,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":16,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["error",0]},{"Ident":["Request",0]}],"span":{"data":{"file_id":20,"beg":{"line":588,"col":0},"end":{"line":588,"col":22}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Request` supports generic, type-driven access to data. Its use is currently restricted to the"},{"DocComment":" standard library in cases where trait authors wish to allow trait implementors to share generic"},{"DocComment":" information across trait boundaries. The motivating and prototypical use case is"},{"DocComment":" `core::error::Error` which would otherwise require a method per concrete type (e.g."},{"DocComment":" `std::backtrace::Backtrace` instance that implementors want to expose to users)."},{"DocComment":""},{"DocComment":" # Data flow"},{"DocComment":""},{"DocComment":" To describe the intended data flow for Request objects, let's consider two conceptual users"},{"DocComment":" separated by API boundaries:"},{"DocComment":""},{"DocComment":" * Consumer - the consumer requests objects using a Request instance; e.g. a crate that offers"},{"DocComment":"   fancy `Error`/`Result` reporting to users wants to request a Backtrace from a given `dyn Error`."},{"DocComment":""},{"DocComment":" * Producer - the producer provides objects when requested via Request; e.g. a library with an"},{"DocComment":"   an `Error` implementation that automatically captures backtraces at the time instances are"},{"DocComment":"   created."},{"DocComment":""},{"DocComment":" The consumer only needs to know where to submit their request and is expected to handle the"},{"DocComment":" request not being fulfilled by the use of `Option<T>` in the responses offered by the producer."},{"DocComment":""},{"DocComment":" * A Producer initializes the value of one of its fields of a specific type. (or is otherwise"},{"DocComment":"   prepared to generate a value requested). e.g., `backtrace::Backtrace` or"},{"DocComment":"   `std::backtrace::Backtrace`."},{"DocComment":" * A Consumer requests an object of a specific type (say `std::backtrace::Backtrace`). In the"},{"DocComment":"   case of a `dyn Error` trait object (the Producer), there are functions called `request_ref` and"},{"DocComment":"   `request_value` to simplify obtaining an `Option<T>` for a given type."},{"DocComment":" * The Producer, when requested, populates the given Request object which is given as a mutable"},{"DocComment":"   reference."},{"DocComment":" * The Consumer extracts a value or reference to the requested type from the `Request` object"},{"DocComment":"   wrapped in an `Option<T>`; in the case of `dyn Error` the aforementioned `request_ref` and"},{"DocComment":"   `request_value` methods mean that `dyn Error` users don't have to deal with the `Request` type at"},{"DocComment":"   all (but `Error` implementors do). The `None` case of the `Option` suggests only that the"},{"DocComment":"   Producer cannot currently offer an instance of the requested type, not that it can't or never will."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The best way to demonstrate this is using an example implementation of `Error`'s `provide` trait"},{"DocComment":" method:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(error_generic_member_access)]"},{"DocComment":" use core::fmt;"},{"DocComment":" use core::error::Request;"},{"DocComment":" use core::error::request_ref;"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" enum MyLittleTeaPot {"},{"DocComment":"     Empty,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct MyBacktrace {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl MyBacktrace {"},{"DocComment":"     fn new() -> MyBacktrace {"},{"DocComment":"         // ..."},{"DocComment":"         # MyBacktrace {}"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Error {"},{"DocComment":"     backtrace: MyBacktrace,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Display for Error {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"Example Error\")"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl std::error::Error for Error {"},{"DocComment":"     fn provide<'a>(&'a self, request: &mut Request<'a>) {"},{"DocComment":"         request"},{"DocComment":"             .provide_ref::<MyBacktrace>(&self.backtrace);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let backtrace = MyBacktrace::new();"},{"DocComment":"     let error = Error { backtrace };"},{"DocComment":"     let dyn_error = &error as &dyn std::error::Error;"},{"DocComment":"     let backtrace_ref = request_ref::<MyBacktrace>(dyn_error).unwrap();"},{"DocComment":""},{"DocComment":"     assert!(core::ptr::eq(&error.backtrace, backtrace_ref));"},{"DocComment":"     assert!(request_ref::<MyLittleTeaPot>(dyn_error).is_none());"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Shared"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":null,"align":null,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},null,null,null,{"def_id":20,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Formatter",0]}],"span":{"data":{"file_id":24,"beg":{"line":561,"col":0},"end":{"line":561,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Configuration for formatting."},{"DocComment":""},{"DocComment":" A `Formatter` represents various options related to formatting. Users do not"},{"DocComment":" construct `Formatter`s directly; a mutable reference to one is passed to"},{"DocComment":" the `fmt` method of all formatting traits, like [`Debug`] and [`Display`]."},{"DocComment":""},{"DocComment":" To interact with a `Formatter`, you'll call various methods to change the"},{"DocComm