NHV_ReleaseOps.source (base : VTop_Stages.Ops) (qbase : AspisR1.Port3_NativeQueryBody.Ops) (qPlace gPlace : ℕ)
  (reserved : Bool) {H : Type} (D : VTop_Stages.aspis_core.digest.Digest32 H)
  (pub proof checkpoint : Aeneas.Std.Slice Aeneas.Std.U8) (hash : H) :
  NHT_EmittedCommon.tx2_common (NHV_ReleaseOps.installed base qbase qPlace gPlace reserved) D pub proof checkpoint hash
      none =
    VTop_Stages.verifier.candidate.tx2_common (NHV_ReleaseOps.installed base qbase qPlace gPlace reserved) D pub proof
      checkpoint hash none
NHV_ReleaseOps.open_fields (base : VTop_Stages.Ops) (qbase : AspisR1.Port3_NativeQueryBody.Ops) (qPlace gPlace : ℕ)
  (reserved : Bool) :
  @VTop_Stages.Ops.op18 (NHV_ReleaseOps.installed base qbase qPlace gPlace reserved) = @VTop_Stages.Ops.op18 base ∧
    @VTop_Stages.Ops.op5 (NHV_ReleaseOps.installed base qbase qPlace gPlace reserved) = @VTop_Stages.Ops.op5 base ∧
      (NHV_ReleaseOps.installed base qbase qPlace gPlace reserved).op19 = base.op19
NHV_ReleaseOps.release_mark (base : VTop_Stages.Ops) (qbase : AspisR1.Port3_NativeQueryBody.Ops) (qPlace gPlace : ℕ)
  (reserved : Bool) (phase : NHV_ReleaseOps.Phase) :
  (NHV_ReleaseOps.installed base qbase qPlace gPlace reserved).op13 none phase = Aeneas.Std.Result.ok ()
NHV_NativeOps.pending_reply (base : NHV_NativeOps.TopOps) (qbase : AspisR1.Port3_NativeQueryBody.Ops)
  (qPlace gPlace : ℕ) (reserved : Bool) (a : AspisR1Stage2.verifier.Accumulator) (width : (↑a.weights).length = 64) :
  (NHV_NativeOps.installed base qbase qPlace gPlace reserved).op10 a.weights.deref =
    if reserved = true then Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (AspisR1.NFW_QueryResume.pending a))
    else
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err AdapterRw.aspis_r1_cost_probe.verifier.Error.Allocation)
NHV_NativeOps.geometry_result (queries : Aeneas.Std.Array Aeneas.Std.U32 22#usize) (start finish : Aeneas.Std.Usize) :
  AspisR1.Port3_QueryInstall.result
      (AspisR1PublicPreparation.RawExtractedSemanticCallOpsV20.resultMap NFN_NEW_GeometryRawInterface.answer
        (NEW_GeometryActual.verifier.QueryGeometry.for_range queries start finish)) =
    AspisR1.Port3_GeometryStage.geometry NFN_NEW_GeometryDictionary.adopted queries start finish
NHV_InactivePacket.source (bytes : Aeneas.Std.Slice Aeneas.Std.U8) :
  NHV_InactivePacket.packet bytes = NHV_InactivePacket.emitted bytes
NHT_CommonCuts.resume (ops : VTop_Stages.Ops) {H : Type} (D : VTop_Stages.aspis_core.digest.Digest32 H)
  (pub proof checkpoint : Aeneas.Std.Slice Aeneas.Std.U8) (hash : H)
  (obs : Option (VTop_Stages.verifier.Phase → Aeneas.Std.Result Unit))
  (packet : Aeneas.Std.Result (NHT_CommonCuts.R (VTop_Stages.verifier.Prepared × VTop_Stages.verifier.Accumulator)))
  (NFU_resume : ops.op18 D checkpoint proof pub AspisR1Stage2.transport.Variant.S2 hash = packet) :
  NHT_EmittedCommon.tx2_common (NHT_Tx2CommonModel.constants ops) D pub proof checkpoint hash obs = do
    let reply ← packet
    NHQ_Tx2CommonModel.afterResume (NHT_Tx2CommonModel.constants ops) D proof hash obs reply
NHT_PacketOps.query_source (base : NHT_PacketOps.QueryOps) (proof : Aeneas.Std.Slice Aeneas.Std.U8)
  (p : AspisR1Stage2.verifier.Prepared) (a : AspisR1Stage2.verifier.Accumulator) (width : (↑a.weights).length = 64)
  (weights : NFS_NEV_WeightDomains.Canonical (NEV_AccumulateCarriers.fromAccumulator a).weights)
  (rhs : NBO_TailDomain.WideCanonical a.rhs) (power : NBF_PowerStep.Canonical a.power)
  (rho : NBF_PowerStep.Canonical p.rho) (start : ↑a.next = 10) (gamma : AspisR1.NFN_LPi_FieldValues.NE)
  (canonicalGamma : AspisR1.NFN_LPi_FieldValues.canonE gamma)
  (g : Aeneas.Std.Array AspisR1.NFN_LPi_FieldValues.NE 29#usize)
  (powers : FIo_Native.weights.powers 29#usize gamma = Aeneas.Std.Result.ok g)
  (geometry : AspisR1Stage2.verifier.QueryGeometry) (qPlace gPlace : ℕ) :
  NHT_PacketOps.query base qPlace gPlace proof p a (AspisR1.FIp_DotsAdapter.fromArray g) none geometry
      (AspisR1.NFW_QueryResume.pending a) 22#usize =
    NHT_ResultPort.action
      (AspisR1.Port3_NativeQueryBody.verifier.candidate.query_loop (AspisR1.NFS_QueryOps.installed base) proof p a
        (AspisR1.FIp_DotsAdapter.fromArray g) none geometry (AspisR1.NFW_QueryResume.pending a) 22#usize)
NHT_QueryTail.source (top : NHT_QueryTail.TopOps) (base : AspisR1.Port3_NativeQueryBody.Ops)
  (proof : Aeneas.Std.Slice Aeneas.Std.U8) (p : AspisR1Stage2.verifier.Prepared)
  (a after : AspisR1Stage2.verifier.Accumulator) (width : (↑a.weights).length = 64)
  (weights : NFS_NEV_WeightDomains.Canonical (NEV_AccumulateCarriers.fromAccumulator a).weights)
  (rhs : NBO_TailDomain.WideCanonical a.rhs) (power : NBF_PowerStep.Canonical a.power)
  (rho : NBF_PowerStep.Canonical p.rho) (start : ↑a.next = 10) (gamma : AspisR1.NFN_LPi_FieldValues.NE)
  (canonicalGamma : AspisR1.NFN_LPi_FieldValues.canonE gamma)
  (g : Aeneas.Std.Array AspisR1.NFN_LPi_FieldValues.NE 29#usize)
  (powers : FIo_Native.weights.powers 29#usize gamma = Aeneas.Std.Result.ok g)
  (geometry : AspisR1Stage2.verifier.QueryGeometry) (qPlace gPlace : ℕ)
  (pending : AspisR1Stage2.verifier.BatchedWeights)
  (returned :
    NHT_PacketOps.query base qPlace gPlace proof p a (AspisR1.FIp_DotsAdapter.fromArray g) none geometry
        (AspisR1.NFW_QueryResume.pending a) 22#usize =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (after, pending)))
  (inactive : AspisR1Stage2.aspis_core.field.wide_exact.WideExact) (round0 folded round1 : Aeneas.Std.Usize)
  (packet : NHT_QueryTail.Packet)
  (NHM_finish :
    ∀ (out : Aeneas.Std.Slice AspisR1Stage2.aspis_core.field.QM31),
      AspisR1.Port3_FlushInstall.flush pending after.weights.deref = Aeneas.Std.Result.ok out →
        AspisR1.NGM_FinishDomain.AccumulatorDomain
            { weights := ⟨↑out, ⋯⟩, rhs := after.rhs, power := after.power, next := after.next } →
          ∀ (v : VTop_Stages.verifier.View),
            NHT_TailView.view (NHT_PacketOps.installed top base qPlace gPlace) proof p none inactive round0 folded
                  round1 =
                Aeneas.Std.Result.ok v →
              top.op19 v p { weights := ⟨↑out, ⋯⟩, rhs := after.rhs, power := after.power, next := after.next } none =
                packet v p { weights := ⟨↑out, ⋯⟩, rhs := after.rhs, power := after.power, next := after.next } none) :
  ∃ out,
    AspisR1.Port3_FlushInstall.flush pending after.weights.deref = Aeneas.Std.Result.ok out ∧
      AspisR1.NGM_FinishDomain.AccumulatorDomain
          { weights := ⟨↑out, ⋯⟩, rhs := after.rhs, power := after.power, next := after.next } ∧
        NHQ_Tx2CommonModel.afterQuery (NHT_PacketOps.installed top base qPlace gPlace) proof p none inactive round0
            folded round1 (Aeneas.Std.core.result.Result.Ok (after, pending)) =
          do
          let v ←
            NHT_TailView.view (NHT_PacketOps.installed top base qPlace gPlace) proof p none inactive round0 folded
                round1
          packet v p { weights := ⟨↑out, ⋯⟩, rhs := after.rhs, power := after.power, next := after.next } none
NHT_FinishPacket.source {W : Type} (ops : AspisR1.Port3_NativeFinishBody.Ops W) (r : AspisR1.NP6_StdModel.Reservation)
  (v : AspisR1Stage2.verifier.View) (p : AspisR1Stage2.verifier.Prepared) (a : AspisR1Stage2.verifier.Accumulator)
  (obs : Option (AspisR1Stage2.verifier.Phase → Aeneas.Std.Result Unit)) (alpha0 alpha1 : AspisR1.NGM_FinishControl.E)
  (index0 : p.alpha.index_usize 0#usize = Aeneas.Std.Result.ok alpha0)
  (index1 : p.alpha.index_usize 1#usize = Aeneas.Std.Result.ok alpha1)
  (ca0 : AspisR1.LPi_FieldValues.canonE (AspisR1.FIo_Install.toE alpha0))
  (ca1 : AspisR1.LPi_FieldValues.canonE (AspisR1.FIo_Install.toE alpha1))
  (folds : ops.op6 p.variant = Aeneas.Std.Result.ok 2#usize)
  (native_round0 :
    ops.op5 v.round0 alpha0 p.claim 0#usize =
      AspisR1Stage2.Stage2Finish.verifier.finishRelationRoundWithOps (AspisR1.IDa_Deployed.finish r) v.round0 alpha0
        p.claim 0#usize)
  (native_round1 :
    ∀ (claim : AspisR1Stage2.Stage2Finish.E),
      AspisR1.LPi_FieldValues.canonE (AspisR1.FIo_Install.toE claim) →
        ops.op5 v.round1 alpha1 claim 1#usize =
          AspisR1Stage2.Stage2Finish.verifier.finishRelationRoundWithOps (AspisR1.IDa_Deployed.finish r) v.round1 alpha1
            claim 1#usize)
  (accumulator : AspisR1.NGM_FinishDomain.AccumulatorDomain a)
  (native_dot : ops.op4 v.final_message a.weights.deref = AspisR1.SAG_DotClosed.source v.final_message a.weights.deref)
  (newPacket : Aeneas.Std.Result (AspisR1.NGM_FinishControl.R W))
  (NHM_new : ops.op3 p.variant p.semantic_alpha p.z = newPacket) (pair : NHT_FinishChain.PairPacket W)
  (NHM_pair :
    ∀ (weights : W),
      ops.op3 p.variant p.semantic_alpha p.z = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok weights) →
        ∀ (alpha : Aeneas.Std.Slice AspisR1.NGM_FinishControl.E),
          Aeneas.Std.core.array.Array.index
                (Aeneas.Std.core.ops.index.IndexSlice
                  (Aeneas.Std.core.slice.index.SliceIndexRangeToUsizeSlice AspisR1.NGM_FinishControl.E))
                p.alpha { «end» := 2#usize } =
              Aeneas.Std.Result.ok alpha →
            NHT_FinishRelationModel.PairLaw ops v p weights alpha (pair weights alpha v.final_message p.kappa)) :
  NHT_ResultPort.action (AspisR1.Port3_NativeFinishBody.verifier.finish_relation ops v p a obs) =
    NHT_ResultPort.action
      (NHT_FinishRun.run (NHT_FinishNewPacket.installed ops newPacket) v p a obs
        (NHQ_WeightPort.weights a.weights.deref) pair alpha0 alpha1)
