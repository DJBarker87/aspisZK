    "NET_WideModel": {
      "path": "evidence/slice-q-compose3-20261102/NET_WideModel.lean",
      "source": "import NEO_WideTotal\nimport NEO_FieldView\nimport NET_ParserComposed\nset_option autoImplicit false\nnamespace NET_WideModel\nopen Aeneas Aeneas.Std Result AspisR1\nopen S8OwnedP6FieldParserTransport\nabbrev E := FIo_Native.aspis_core.field.wide_exact.WideExact\n\ndef recover (w : Array U32 8#usize) : E :=\n LPf_WideConstruction.value (w.val[0]?.getD 0#u32) (w.val[1]?.getD 0#u32)\n  (w.val[2]?.getD 0#u32) (w.val[3]?.getD 0#u32)\n  (w.val[4]?.getD 0#u32) (w.val[5]?.getD 0#u32)\n  (w.val[6]?.getD 0#u32) (w.val[7]?.getD 0#u32)\n\ntheorem roundtrip (x : E) : recover (NEB_ArrayRefs.wordsE x)=x := by\n rcases x with \u27e8\u27e8\u27e8a,b\u27e9,\u27e8c,d\u27e9\u27e9,\u27e8\u27e8e,f\u27e9,\u27e8g,h\u27e9\u27e9\u27e9\n rfl\n\ndef wide (bytes : Slice U8) : Result (Option E) :=\n mapResult (Option.map recover) (NEO_WindowV2.wide bytes)\n\n/-- All lengths and all rejection prefixes, with the complete nominal carrier. -/\ntheorem result (bytes : Slice U8) :\n wide bytes=FIo_Native.aspis_core.field.wide_exact.WideExact.from_le_bytes bytes := by\n unfold wide\n rw [NEO_WideTotal.result]\n unfold NEO_WideTotal.cohort\n cases h:FIo_Native.aspis_core.field.wide_exact.WideExact.from_le_bytes bytes with\n | ok o =>\n  cases o with\n  | none => rfl\n  | some x =>\n   simp only [bind_tc_ok,NBG_WideCarriers.to_limbs_result,mapResult,Option.map]\n   change ok (some (recover (NEB_ArrayRefs.wordsE x)))=ok (some x)\n   rw [roundtrip]\n | fail e => rfl\n | div => rfl\n\ntheorem result_state_effects {S Event : Type} (state : S) (bytes : Slice U8) :\n NEB_PureFrame.run (Event:=Event) state (wide bytes)=\n NEB_PureFrame.run state (FIo_Native.aspis_core.field.wide_exact.WideExact.from_le_bytes bytes) := by\n rw [result]\n\n#print axioms roundtrip\n#print axioms result\n#print axioms result_state_effects\nend NET_WideModel\n",
      "sha256": "7db1cfc376a3bff0e089ef782780cc00e0ad6d09e921eb19604984d5a26d134a"
    },
    "NEO_WideTotal": {
      "path": "evidence/slice-q-compose2-20261102/NEO_WideTotal.lean",
      "source": "import NEO_WideReference\nset_option autoImplicit false\nnamespace NEO_WideTotal\nopen Aeneas Aeneas.Std Result AspisR1\nabbrev E := FIo_Native.aspis_core.field.wide_exact.WideExact\n\ndef cohort (bytes : Slice U8) : Result (Option (Array U32 8#usize)) := do\n let o \u2190 FIo_Native.aspis_core.field.wide_exact.WideExact.from_le_bytes bytes\n match o with\n | none => ok none\n | some x => do let w \u2190 FIo_Native.aspis_core.field.wide_exact.WideExact.to_limbs x; ok (some w)\n\ntheorem wrong_length (bytes : Slice U8) (wrong : bytes.val.length\u226032) :\n NEO_WindowV2.wide bytes=ok none := by\n have ne : Slice.len bytes != 32#usize := by\n  simp only [bne_iff_ne]\n  intro h\n  have val := congrArg UScalar.val h\n  apply wrong\n  change bytes.val.length=32 at val\n  exact val\n simp only [NEO_WindowV2.wide,ne,if_true]\n\ntheorem result (bytes : Slice U8) : NEO_WindowV2.wide bytes=cohort bytes := by\n by_cases len : bytes.val.length=32\n \u00b7 let a : Array U8 32#usize := \u27e8bytes.val,len\u27e9\n   have same : a.to_slice=bytes := by cases bytes; rfl\n   rw [\u2190same]\n   exact NEO_WideReference.result a\n \u00b7 rw [wrong_length bytes len]\n   unfold cohort\n   rw [NBG_WideCarriers.wrong_byte_length bytes len]\n   rfl\n\ntheorem option_lossless (x y : Option E)\n (same : x.map NEB_ArrayRefs.wordsE=y.map NEB_ArrayRefs.wordsE) : x=y :=\n NEO_ParserTotal.option_lossless x y same\n\ntheorem frame {S Event : Type} (state : S) (bytes : Slice U8) :\n NEB_PureFrame.run (Event:=Event) state (NEO_WindowV2.wide bytes)=\n NEB_PureFrame.run state (cohort bytes) := NEB_PureFrame.equality state _ _ (result bytes)\n\n#print axioms wrong_length\n#print axioms result\n#print axioms option_lossless\n#print axioms frame\nend NEO_WideTotal\n",
      "sha256": "358ca0d55026cee681366feca66ef13860dac91b64af85a564b9f28fb2aff89c"
    },
    "NEO_WideReference": {
      "path": "evidence/slice-q-compose2-20261102/NEO_WideReference.lean",
      "source": "import NEO_WideWord\nimport NEO_ParserTotal\nset_option autoImplicit false\nnamespace NEO_WideReference\nopen Aeneas Aeneas.Std Result AspisR1\nattribute [local irreducible] core.num.U32.from_le_bytes\n\ntheorem fixed (bytes : Array U8 32#usize) :\n NEO_WindowV2.wide bytes.to_slice = NEO_ParserRef.limbs_ref (NBG_WideBytes.limbs bytes) := by\n have w0 := NEO_WideWord.fixed bytes 0#usize 0 (by decide) (by decide)\n have w1 := NEO_WideWord.fixed bytes 4#usize 1 (by decide) (by decide)\n have w2 := NEO_WideWord.fixed bytes 8#usize 2 (by decide) (by decide)\n have w3 := NEO_WideWord.fixed bytes 12#usize 3 (by decide) (by decide)\n have w4 := NEO_WideWord.fixed bytes 16#usize 4 (by decide) (by decide)\n have w5 := NEO_WideWord.fixed bytes 20#usize 5 (by decide) (by decide)\n have w6 := NEO_WideWord.fixed bytes 24#usize 6 (by decide) (by decide)\n have w7 := NEO_WideWord.fixed bytes 28#usize 7 (by decide) (by decide)\n have len : Slice.len bytes.to_slice=32#usize := by\n  apply UScalar.eq_of_val_eq\n  change bytes.val.length=32\n  exact bytes.property\n simp only [NEO_WindowV2.wide,len,(show (32#usize != 32#usize)=false from by decide),Bool.false_eq_true,if_false,\n  w0,w1,w2,w3,w4,w5,w6,w7,bind_tc_ok]\n simp [NEO_WindowV2.P,NEO_ParserRef.limbs_ref,NEO_ParserRef.MODULUS,\n  NBG_WideBytes.limbs,Array.index_usize,Array.make,bind_tc_ok]\n\ntheorem result (bytes : Array U8 32#usize) :\n NEO_WindowV2.wide bytes.to_slice =\n (do let parsed \u2190 FIo_Native.aspis_core.field.wide_exact.WideExact.from_le_bytes bytes.to_slice\n     match parsed with\n     | none => ok none\n     | some value => do\n       let words \u2190 FIo_Native.aspis_core.field.wide_exact.WideExact.to_limbs value\n       ok (some words)) := by\n rw [fixed,NEO_ParserTotal.result,\u2190NBG_WideBytes.bytes_result]\n rfl\n\n#print axioms fixed\n#print axioms result\nend NEO_WideReference\n",
      "sha256": "e40a3768f6c1737cfc4a53ba30e13794265bbf599df38587fef242a9320fd2ad"
    },
    "NEO_WideWord": {
      "path": "evidence/slice-q-compose2-20261102/NEO_WideWord.lean",
      "source": "import NEO_QuadraticTotal\nimport NBG_WideBytes\nset_option autoImplicit false\nnamespace NEO_WideWord\nopen Aeneas Aeneas.Std Result\nattribute [local irreducible] core.num.U32.from_le_bytes\n\ntheorem small (k : Nat) (h : k<32) : k%Usize.size=k := by\n have cap : 32<Usize.size := by simp only [Usize.size_def,Usize.numBits_def]; scalar_tac\n exact Nat.mod_eq_of_lt (by omega)\n\ntheorem fixed (bytes : Array U8 32#usize) (i : Usize) (k : Nat)\n (same : i.val=4*k) (bound : k<8) :\n NEO_WindowV2.word bytes.to_slice i=ok (NBG_WideBytes.word bytes k) := by\n have a : 4*k<32 := by omega\n have b : 4*k+1<32 := by omega\n have c : 4*k+2<32 := by omega\n have d : 4*k+3<32 := by omega\n simp [NEO_WindowV2.word,Slice.index_usize,Array.to_slice,bytes.property,\n  Usize.wrapping_add_val_eq,same,NBG_WideBytes.word,lift,bind_tc_ok,\n  small _ a,small _ b,small _ c,small _ d,a,b,c,d]\n\n#print axioms small\n#print axioms fixed\nend NEO_WideWord\n",
      "sha256": "57a19420b6756085b7b4fd2f08f6ccc4b620938a0c4d82ba232930cad8d907ee"
    },
    "NEO_QuadraticTotal": {
      "path": "evidence/slice-q-compose2-20261102/NEO_QuadraticTotal.lean",
      "source": "import NEO_FixedWindow\nimport NEB_PureFrame\nset_option autoImplicit false\nnamespace NEO_QuadraticTotal\nopen Aeneas Aeneas.Std Result\n\ntheorem result (bytes : Slice U8) (bound : 16\u2264bytes.val.length) :\n NEO_WindowV2.quadratic bytes=NEO_QuadraticCuts.cohort bytes := by\n have first := NEO_FixedWindow.range bytes 0#usize 8#usize 8#usize\n  (by decide) (by change 8\u2264bytes.val.length; omega) (by decide)\n have second := NEO_FixedWindow.range bytes 8#usize 16#usize 8#usize\n  (by decide) (by change 16\u2264bytes.val.length; exact bound) (by decide)\n exact NEO_QuadraticCuts.result bytes _ _ first second\n\ntheorem observe_injective (x y : AspisR1CandidateParser.field.QM31)\n (h : NEO_QuadraticCuts.observe x=NEO_QuadraticCuts.observe y) : x=y := by\n rcases x with \u27e8\u27e8a,b\u27e9,\u27e8c,d\u27e9\u27e9\n rcases y with \u27e8\u27e8e,f\u27e9,\u27e8g,k\u27e9\u27e9\n simp [NEO_QuadraticCuts.observe,Array.make] at h\n rcases h with \u27e8rfl,rfl,rfl,rfl\u27e9\n rfl\n\ntheorem complex_frame {S Event : Type} (state : S) (bytes : Slice U8)\n (bound : 8\u2264bytes.val.length) :\n NEB_PureFrame.run (Event:=Event) state (NEO_WindowV2.complex bytes)=\n NEB_PureFrame.run state (NEO_ComplexReference.cohort bytes) :=\n NEB_PureFrame.equality state _ _ (NEO_ComplexTotal.result bytes bound)\n\ntheorem quadratic_frame {S Event : Type} (state : S) (bytes : Slice U8)\n (bound : 16\u2264bytes.val.length) :\n NEB_PureFrame.run (Event:=Event) state (NEO_WindowV2.quadratic bytes)=\n NEB_PureFrame.run state (NEO_QuadraticCuts.cohort bytes) :=\n NEB_PureFrame.equality state _ _ (result bytes bound)\n\n#print axioms result\n#print axioms observe_injective\n#print axioms complex_frame\n#print axioms quadratic_frame\nend NEO_QuadraticTotal\n",
      "sha256": "fc712a6504ec718831ffef8ec3361c31b4f097dfe75a0db5394014b6b442d787"
    },
    "NEO_FixedWindow": {
      "path": "evidence/slice-q-compose2-20261102/NEO_FixedWindow.lean",
      "source": "import NEO_QuadraticCuts\nset_option autoImplicit false\nnamespace NEO_FixedWindow\nopen Aeneas Aeneas.Std Result\n\ndef window (bytes : Slice U8) (offset : Nat) (n : Usize)\n (bound : offset+n.val\u2264bytes.val.length) : Array U8 n :=\n \u27e8(bytes.val.drop offset).take n.val,by simp only [List.length_take,List.length_drop]; omega\u27e9\n\ntheorem range (bytes : Slice U8) (start finish n : Usize)\n (order : start.val\u2264finish.val) (fit : finish.val\u2264bytes.val.length)\n (width : finish.val-start.val=n.val) :\n core.slice.index.Slice.index (core.slice.index.SliceIndexRangeUsizeSlice U8)\n bytes {start:=start,\u00abend\u00bb:=finish}=\n ok (window bytes start.val n (by omega)).to_slice := by\n simp [core.slice.index.Slice.index,core.slice.index.SliceIndexRangeUsizeSlice.index,\n  Slice.length,order,fit,window,Array.to_slice,List.slice,width]\n\n#print axioms range\nend NEO_FixedWindow\n",
      "sha256": "ecbd9b5d8584fe26cbdf17d158dbd05d16543686bf538f1b4e5a7ff2002e1885"
    },
    "NEO_QuadraticCuts": {
      "path": "evidence/slice-q-compose2-20261102/NEO_QuadraticCuts.lean",
      "source": "import NEO_ComplexTotal\nset_option autoImplicit false\nnamespace NEO_QuadraticCuts\nopen Aeneas Aeneas.Std Result\nattribute [local irreducible] AspisR1CandidateParser.field.CM31.from_le_bytes\n\ndef observe (q : AspisR1CandidateParser.field.QM31) : Array U32 4#usize :=\n Array.make 4#usize [q.c0.a,q.c0.b,q.c1.a,q.c1.b]\ndef cohort (bytes : Slice U8) : Result (Option (Array U32 4#usize)) := do\n let q \u2190 AspisR1CandidateParser.field.QM31.from_le_bytes bytes\n ok (q.map observe)\n\ntheorem result (bytes : Slice U8) (lo hi : Array U8 8#usize)\n (first : core.slice.index.Slice.index (core.slice.index.SliceIndexRangeUsizeSlice U8)\n bytes {start:=0#usize,\u00abend\u00bb:=8#usize}=ok lo.to_slice)\n (second : core.slice.index.Slice.index (core.slice.index.SliceIndexRangeUsizeSlice U8)\n bytes {start:=8#usize,\u00abend\u00bb:=16#usize}=ok hi.to_slice) :\n NEO_WindowV2.quadratic bytes=cohort bytes := by\n simp only [NEO_WindowV2.quadratic,first,second,bind_tc_ok,NEO_ComplexTotal.fixed,\n  NEO_ComplexReference.cohort,cohort,AspisR1CandidateParser.field.QM31.from_le_bytes]\n cases h0 : AspisR1CandidateParser.field.CM31.from_le_bytes lo.to_slice <;>\n  try simp only [bind_tc_ok]\n all_goals try rfl\n all_goals rename_i o\n all_goals cases o <;> simp only [Option.map,bind_tc_ok,\n  AspisR1CandidateParser.core.option.Option.Insts.CoreOpsTry_traitTry.branch,\n  NEO_ByteCuts.residual]\n all_goals try rfl\n all_goals cases h1 : AspisR1CandidateParser.field.CM31.from_le_bytes hi.to_slice <;>\n  try simp only [bind_tc_ok]\n all_goals try rfl\n all_goals rename_i o\n all_goals cases o <;> simp [Option.map,bind_tc_ok,\n  AspisR1CandidateParser.core.option.Option.Insts.CoreOpsTry_traitTry.branch,\n  NEO_ByteCuts.residual,NEO_ComplexReference.observe,observe,Array.index_usize,Array.make]\n\n#print axioms result\nend NEO_QuadraticCuts\n",
      "sha256": "738b63166384151971f5a60c9c01e92bb63a666437169c6a192a3619ebde0eea"
    },
    "NEO_ComplexTotal": {
      "path": "evidence/slice-q-compose2-20261102/NEO_ComplexTotal.lean",
      "source": "import NEO_WindowPrefix\nset_option autoImplicit false\nnamespace NEO_ComplexTotal\nopen Aeneas Aeneas.Std Result\ntheorem eight (xs : Array U8 8#usize) :\n    \u2203 a b c d e f g h : U8, xs = Array.make 8#usize [a,b,c,d,e,f,g,h] := by\n  rcases xs with \u27e8xs,size\u27e9\n  change xs.length=8 at size\n  cases xs with\n  | nil => simp at size\n  | cons a xs =>\n    cases xs with\n    | nil => simp at size\n    | cons b xs =>\n      cases xs with\n      | nil => simp at size\n      | cons c xs =>\n        cases xs with\n        | nil => simp at size\n        | cons d xs =>\n          cases xs with\n          | nil => simp at size\n          | cons e xs =>\n            cases xs with\n            | nil => simp at size\n            | cons f xs =>\n              cases xs with\n              | nil => simp at size\n              | cons g xs =>\n                cases xs with\n                | nil => simp at size\n                | cons h xs =>\n                  have empty : xs=[] := by\n                    apply List.eq_nil_of_length_eq_zero\n                    simp only [List.length_cons] at size\n                    omega\n                  subst xs\n                  exact \u27e8a,b,c,d,e,f,g,h,rfl\u27e9\n\n\ntheorem fixed (xs : Array U8 8#usize) :\n NEO_WindowV2.complex xs.to_slice = NEO_ComplexReference.cohort xs.to_slice := by\n obtain \u27e8a,b,c,d,e,f,g,h,rfl\u27e9 := eight xs\n exact NEO_ComplexReference.eight a b c d e f g h\n\ntheorem result (bytes : Slice U8) (bound : 8\u2264bytes.val.length) :\n NEO_WindowV2.complex bytes = NEO_ComplexReference.cohort bytes := by\n rw [NEO_WindowPrefix.complex bytes bound]\n apply (fixed _).trans\n unfold NEO_ComplexReference.cohort\n rw [NEO_PrefixSlices.complex bytes bound]\n\ntheorem observe_injective (x y : AspisR1CandidateParser.field.CM31)\n (h : NEO_ComplexReference.observe x=NEO_ComplexReference.observe y) : x=y := by\n cases x; cases y\n simp [NEO_ComplexReference.observe,Array.make] at h\n rcases h with \u27e8rfl,rfl\u27e9\n rfl\n\n#print axioms eight\n#print axioms fixed\n#print axioms result\n#print axioms observe_injective\nend NEO_ComplexTotal\n",
      "sha256": "4f3837e6878c00a2d928cc66c967d1b8b72dbd4ab82386e70831c33fbc29d9c4"
    },
    "NEO_WindowPrefix": {
      "path": "evidence/slice-q-compose2-20261102/NEO_WindowPrefix.lean",
      "source": "import NEO_ComplexReference\nset_option autoImplicit false\nnamespace NEO_WindowPrefix\nopen Aeneas Aeneas.Std Result\n\ntheorem index (bytes : Slice U8) (n k : Usize) (bound : n.val \u2264 bytes.val.length)\n (inside : k.val<n.val) :\n Slice.index_usize bytes k =\n Slice.index_usize (NEO_PrefixSlices.headArray bytes n bound).to_slice k := by\n have total : k.val<bytes.val.length := by omega\n simp [Slice.index_usize,NEO_PrefixSlices.headArray,Array.to_slice,total,inside,\n  List.length_take,Nat.min_eq_left bound]\n\ntheorem word (bytes : Slice U8) (n i : Usize) (bound : n.val \u2264 bytes.val.length)\n (h0 : i.val<n.val)\n (h1 : (Usize.wrapping_add i 1#usize).val<n.val)\n (h2 : (Usize.wrapping_add i 2#usize).val<n.val)\n (h3 : (Usize.wrapping_add i 3#usize).val<n.val) :\n NEO_WindowV2.word bytes i =\n NEO_WindowV2.word (NEO_PrefixSlices.headArray bytes n bound).to_slice i := by\n simp only [NEO_WindowV2.word,lift,bind_tc_ok,index bytes n i bound h0,\n  index bytes n (Usize.wrapping_add i 1#usize) bound h1,\n  index bytes n (Usize.wrapping_add i 2#usize) bound h2,\n  index bytes n (Usize.wrapping_add i 3#usize) bound h3]\n\ntheorem wrap_small (i j : Usize) (h : i.val+j.val<8) :\n (Usize.wrapping_add i j).val<8 := by\n rw [Usize.wrapping_add_val_eq]\n change (i.val+j.val)%UScalar.size .Usize<8\n have cap : 8<UScalar.size .Usize := by rw [UScalar.size_def]; scalar_tac\n rw [Nat.mod_eq_of_lt (by omega)]\n exact h\n\ntheorem complex (bytes : Slice U8) (bound : 8\u2264bytes.val.length) :\n NEO_WindowV2.complex bytes =\n NEO_WindowV2.complex (NEO_PrefixSlices.headArray bytes 8#usize bound).to_slice := by\n have a := word bytes 8#usize 0#usize bound (by decide) (wrap_small _ _ (by decide)) (wrap_small _ _ (by decide)) (wrap_small _ _ (by decide))\n have b := word bytes 8#usize 4#usize bound (by decide) (wrap_small _ _ (by decide)) (wrap_small _ _ (by decide)) (wrap_small _ _ (by decide))\n simp only [NEO_WindowV2.complex,a,b]\n\n#print axioms index\n#print