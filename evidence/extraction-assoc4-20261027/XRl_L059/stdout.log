@[irreducible] def Aeneas.Std.alloc.vec.FromIteratorVec.iterToList : {T IntoIter : Type} →
  core.iter.traits.iterator.Iterator IntoIter T → IntoIter → List T → Result (List T) :=
fun {T IntoIter} iterInst =>
  Lean.Order.fix
    (fun f iter acc => do
      let __x ← iterInst.next iter
      match __x with
        | (opt, iter) =>
          match opt with
          | none => ok acc.reverse
          | some item => f iter (item :: acc))
    ⋯
def Aeneas.Std.core.iter.range.UScalarStep.forward_checked : {ty : UScalarTy} →
  UScalar ty → Usize → Result (Option (UScalar ty)) :=
fun {ty} start n => if h : ↑start + ↑n ≤ UScalar.max ty then ok (some (UScalar.ofNatCore (↑start + ↑n) ⋯)) else ok none
'XRk_VectorLength.push' depends on axioms: [propext, Classical.choice, Quot.sound]
