theorem Aeneas.Std.UScalar.rem_spec : ∀ {ty : UScalarTy} (x : UScalar ty) {y : UScalar ty},
  ↑y ≠ 0 → x % y ⦃ z => ↑z = ↑x % ↑y ⦄ :=
fun {ty} x {y} hzero => WP.spec_mono (UScalar.rem_bv_spec x hzero) fun x' h => h.left
'XRl_CanonicalConstructors.remainder' depends on axioms: [propext, Classical.choice, Quot.sound]
