theorem NJZ_TreeParent.source : ∀ (left right seenLeft seenRight out : Digest) (calls : ℕ),
  Canonical left →
    Canonical right →
      Cut left right seenLeft seenRight (reply seenLeft seenRight) out calls →
        out = parent left right ∧ calls = 1 ∧ Canonical out :=
fun left right seenLeft seenRight out calls hl hr cut =>
  have child :=
    NJP_CompressionPacket.TX1_305 left right hl hr (NJE_CompressSeed.seed left right) (reply left right) 1
      { seed := rfl, call_count := rfl, output := fun x => rfl };
  have value :=
    Eq.mpr (id (congrArg (fun _a => _a = parent left right) cut.output))
      (Eq.mpr (id (congrArg (fun _a => reply _a seenRight = parent left right) cut.left))
        (Eq.mpr (id (congrArg (fun _a => reply left _a = parent left right) cut.right)) child.left));
  ⟨value, ⟨cut.count, Eq.mpr (id (congrArg (fun _a => Canonical _a) value)) (parent_canonical left right)⟩⟩
'NJZ_TreeParent.source' depends on axioms: [propext, Classical.choice, Quot.sound]
