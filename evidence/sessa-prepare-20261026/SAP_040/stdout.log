  let ⟨before2, right✝¹²⟩ := right✝¹¹
  let ⟨claims, caller⟩ := right✝¹²
  let ⟨run, h✝⁷⟩ := tx1
  let ⟨r, right✝¹³⟩ := h✝⁷
  let ⟨sp, right✝¹⁴⟩ := right✝¹³
  let ⟨n, right✝¹⁵⟩ := right✝¹⁴
  let ⟨w, right✝¹⁶⟩ := right✝¹⁵
  let ⟨can, right✝¹⁷⟩ := right✝¹⁶
  let ⟨writer, bound⟩ := right✝¹⁷
  have proofLength :=
    Eq.mp (congrFun' (congrArg Eq (List.length_map AspisV8R19.SqueezeOracleBridge.decodeByte)) 57607) cuts.proofLength;
  have publicLength :=
    (WAdm_Public.reached
        (Tx2I_Install.install adapterOps
          (Op5T_Concrete.stage (Tx2N_Execution.control stageBase reserved queryOps geoOps)) finishOps)
        (Uni_Install.current ops reserved queryOps geoOps) B claimsStd e1 (e2.second secondSizes) saved f s cuts).right;
  have domain :=
    WAdm_Domain.on_run (Tx1Q_Execution.actual (Op5T_Concrete.current ops) reserved queryOps geoOps B claimsStd) reserved
      queryOps geoOps
      (Tx1Q_SameCut.callerDigest
        (Tx2I_Install.install adapterOps
          (Op5T_Concrete.stage (Tx2N_Execution.control stageBase reserved queryOps geoOps)) finishOps)
        (Op5T_Concrete.current ops) reserved queryOps geoOps B claimsStd)
      () (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.pub f.proof f.split saved run prepareOwner primitiveOwner
      proofLength publicLength;
  let ⟨fields, h✝⁸⟩ :=
    WAdm_Inventory.on_run (Tx1Q_Execution.actual (Op5T_Concrete.current ops) reserved queryOps geoOps B claimsStd)
