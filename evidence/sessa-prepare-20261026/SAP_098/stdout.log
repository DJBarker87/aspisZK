                                                                    f.proof ()
                                                                    (Aeneas.Std.Array.repeat 29#usize run.zero);
                                                              AspisR1.AuS1_Finish.Collision H trace p q ∨
                                                                (AspisV8R19.MemoizedProgramLaw.eval H
                                                                        (AspisR1.GExq_CallerRecord.program a ops
                                                                          (AspisR1.AuS1_Install.base stage) finish
                                                                          reserved query geo
                                                                          (AspisR1.F3M_CircleSource.install B0) std
