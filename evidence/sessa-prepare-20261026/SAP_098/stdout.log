                                        ∃ run i p q input tx2,
                                          i.physical.bytes = AspisR1.MultiproofConeCanonical.bytesOf ↑f.pub ∧
                                            i.stored = AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof ∧
                                              AspisR1.Cons_Native.Calls (AspisR1.AuS1_Install.base stage) finish
                                                  reserved query geo
                                                  (AdapterRw.SolanaDigest.Insts.Aspis_coreDigestDigest32
                                                    (AspisR1.SdkD_PairBatches.dictionary a ops stage finish reserved
                                                      query geo (AspisR1.F3M_CircleSource.install B0) std))
                                                  () s.pub s.proof s.checkpoint tx2 ∧
                                                ∀ (decode : AspisR1.S2W_AuthenticatedInputs.HeaderDecode),
                                                  AspisR1.S2W_AuthenticatedInputs.CheckpointWriterConeJoin
                                                      (AspisR1.SdkD_PairBatches.dictionary a ops stage finish reserved
                                                        query geo (AspisR1.F3M_CircleSource.install B0) std)
