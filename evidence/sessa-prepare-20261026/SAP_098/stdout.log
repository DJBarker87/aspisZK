                                                                          slot)).1 =
                                                                    (AspisV8R19.MemoizedProgramLaw.eval H
                                                                        (AspisR1.F3_Model.verifier decoder i)).1 ∧
                                                                  (AspisV8R19.MemoizedProgramLaw.eval H
                                                                        (AspisR1.F3_Model.verifier decoder i)).2 =
                                                                    Bool.true
