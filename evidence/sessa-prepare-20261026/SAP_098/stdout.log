def AspisR1.F3T_Leaves.Holds : {W : Type} →
  (finish : AspisR1Stage2.Stage2Finish.FinishOps W) →
    (v : AspisR1Stage2.verifier.View) →
      (p : AspisR1Stage2.verifier.Prepared) →
        (a : AspisR1Stage2.verifier.Accumulator) →
          AspisR1.F3S_FinishWitness.Primitives finish v p a →
            (Fin 22 → Fin 262144) →
              AspisR1.OraclePortCompactDraft.Parsed →
                AspisR1.RawCutTranscriptRun.ErasedPrefix → AspisR1.RecordedBinaryExperimentBin.SourceInputs → Prop :=
fun {W} finish v p a x q parsed tr input =>
  AspisR1.Port4D_Pairing.PairingLaws (AspisR1.Port3_FinishStage.release finish) AspisR1.CheckpointBytes5Output.ofE v p
