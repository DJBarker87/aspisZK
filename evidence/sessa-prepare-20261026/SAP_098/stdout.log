                                                                AspisV8R19.DuplexFrames.Bytes
                                                                AspisV8R19.SourceDuplexStep.State Unit)
                                                            (x :
                                                              AspisR1.F3S_FinishWitness.Primitives finish tx2.v2 tx2.p2
                                                                (have __src := tx2.returned2;
                                                                { weights := tx2.back2 tx2.flushed2, rhs := __src.rhs,
                                                                  power := __src.power, next := __src.next })),
                                                            AspisR1.F3T_Leaves.Holds finish tx2.v2 tx2.p2
                                                                (have __src := tx2.returned2;
                                                                { weights := tx2.back2 tx2.flushed2, rhs := __src.rhs,
                                                                  power := __src.power, next := __src.next })
