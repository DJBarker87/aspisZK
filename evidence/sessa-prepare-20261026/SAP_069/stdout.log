                              (AspisR1.OraclePortCheckpointResumeC5.model data rho q)).accumulator ∧
                        AspisR1.Port3_CheckpointInstall.writer (AspisR1.Tx1Q_Install.digest D)
                              (AspisR1.Tx1Q_Carriers.prepared run.p) state proof pub hash =
