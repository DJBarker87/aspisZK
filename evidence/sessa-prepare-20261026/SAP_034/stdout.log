'AspisR1.SAP_Tx2.accepted_pair_claims_tx2' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.SAP_Tx2.accepted_pair_claims_tx2 : ∀ {W A E M Cv F : Type} {N : ℕ} (L : Library W (ℕ → Record)),
  S2TrustedSdkBorrow L →
    ∀ (copy : Heap (ℕ → Record) → ℕ → Payload → Outcome (ℕ → Record)),
      TrustedStd copy →
        ∀ (allocator : Allocator A) (e1 e2 : Entry) (w1 w2 : W),
          RuntimeEntrypointAdmission L e1 w1 3 →
            RuntimeEntrypointAdmission L e2 w2 7 →
              ∀ (adapterOps : AdapterRw.Ops) (ops : Ops) (stageBase : VTop_Stages.Ops)
                (finishOps : AspisR1Stage2.Stage2Finish.FinishOps F)
                (B : AspisR1PublicPreparation.FinishModel.Boundaries) (claimsStd : ClaimsUnrolledFinish.StdCalls)
                (native1 : S2W_ExtractionBoundary.First) (native2 : S2W_ExtractionBoundary.Second)
                (hashv : S2Z.Oracle.Parts → Result S2Z.Oracle.Digest),
                S2W_DigestExtraction.AeneasExtraction
                    (sdkOps (Tx2I_Install.install adapterOps stageBase finishOps) (Op3I_Install.install ops) B
                      claimsStd)
                    native1 native2 hashv →
                  ∀ (sha256 H : Bytes → State),
                    S2W_ExtractionBoundary.P1 sha256 H →
                      S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
                        ∀ (program : S2W_ExtractionBoundary.Program) (data1 data2 : Slice U8)
                          (slot : S2W_ExtractionBoundary.Slot) (state1 state2 final1 final2 : A)
                          (saved : alloc.vec.Vec U8) (post1 post2 : Heap (ℕ → Record)),
                          first native1 copy allocator e1 program data1 state1 =
                              ok (core.result.Result.Ok (saved, post1, final1)) →
                            second native2 allocator e2 program data2 slot state2 =
                                ok (core.result.Result.Ok (post2, final2)) →
                              ∀ (p : FS2.Duplex.Params M Cv N) (root : Std.Array U8 32#usize) (length : U32)
                                (port :
                                  ChildConeJoin E
                                    (sdkOps (Tx2I_Install.install adapterOps stageBase finishOps)
                                      (Op3I_Install.install ops) B claimsStd)),
                                Op5T_Marks.FirstMarks port →
                                  Op5T_Marks.SecondMarks port →
                                    ∃ f s outer pre middle fs ss,
                                      SourceCuts
                                          (sdkOps (Tx2I_Install.install adapterOps stageBase finishOps)
                                            (Op3I_Install.install ops) B claimsStd)
                                          e1.first (e2.second secondSizes) saved f s ∧
                                        AdapterRw.aspis_statement.pool_v1.pair_forest_terminal.PoolV1PairForestTerminalStatementV1.semantic_public
                                              f.statement =
                                            ok f.semantic ∧
                                          (Tx2I_Install.shape s.proof =
                                                ok (core.result.Result.Ok AspisR1Stage2.transport.Variant.S2) ∧
                                              Op3I_Install.sourceBody s.proof =
                                                  ok (core.result.Result.Ok transport.Variant.S2) ∧
                                                OraclePortHeader.accepts (bytesOf ↑s.proof) = true ∧ ⋯) ∧
                                            ((RowShape_InstalledSlots.verifierOps (Op3I_Install.install ops) B
                                                        claimsStd).op3
                                                    f.proof =
                                                  ok (core.result.Result.Ok transport.Variant.S2) ∧
                                                Op3I_Install.sourceBody f.proof =
                                                    ok (core.result.Result.Ok transport.Variant.S2) ∧
                                                  ⋯) ∧
                                              ⋯ = ⋯ ∧ ⋯ ∧ ⋯ :=
fun {W A E M Cv F} {N} L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 adapterOps ops stageBase finishOps B
    claimsStd native1 native2 hashv extraction sha256 H p1 syscall program data1 data2 slot state1 state2 final1 final2
    saved post1 post2 accepted1 accepted2 p root length port firstMarks secondMarks =>
  let ⟨f, h✝⟩ :=
    SAP_Op3.accepted_pair_claims_op3 L sdk copy std allocator e1 e2 w1 w2 admission1 admission2
      (Tx2I_Install.install adapterOps stageBase finishOps) ops B claimsStd native1 native2 hashv extraction sha256 H p1
      syscall program data1 data2 slot state1 state2 final1 final2 saved post1 post2 accepted1 accepted2 p root length
      port firstMarks secondMarks
  let ⟨s, h✝¹⟩ := h✝
  let ⟨outer, h✝²⟩ := h✝¹
  let ⟨pre, h✝³⟩ := h✝²
  let ⟨middle, h✝⁴⟩ := h✝³
  let ⟨fs, h✝⁵⟩ := h✝⁴
  let ⟨ss, h✝⁶⟩ := h✝⁵
  let ⟨cuts, right✝⟩ := h✝⁶
  let ⟨selected, remaining⟩ := right✝
  Exists.intro f
    (Exists.intro s
      (Exists.intro outer
        (Exists.intro pre
          (Exists.intro middle
            (Exists.intro fs
              (Exists.intro ss
                ⟨cuts,
                  ⟨selected,
                    ⟨Tx2I_Finish.accepted_finish stageBase finishOps
                        (AdapterRw.SolanaDigest.Insts.Aspis_coreDigestDigest32
                          (sdkOps (Tx2I_Install.install adapterOps stageBase finishOps) (Op3I_Install.install ops) B
                            claimsStd))
                        () s.pub s.proof s.checkpoint cuts.second,
                      remaining⟩⟩⟩))))))
