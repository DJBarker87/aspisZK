+use super::*;
+use aspis_core::field::CM31;
+static mut NBF_EVENTS:u8=0;
+static mut NBF_I:usize=0;
+static mut NBF_OPEN_PTR:*const u8=core::ptr::null();
+static mut NBF_FOLDED:E=E::ZERO;
+static mut NBF_VALUES:[E;4]=[E::ZERO;4];
+static mut NBF_ALPHA:E=E::ZERO;
+static mut NBF_INV:[M31;5]=[M31::ZERO;5];
+static mut NBF_NODE:M31=M31::ZERO;
+fn NBF_open(proof:&[u8],i:usize)->&[u8] {
+ unsafe {assert_eq!(NBF_EVENTS,0);NBF_EVENTS=1;NBF_I=i;NBF_OPEN_PTR=proof.as_ptr();} proof
+}
+fn NBF_dots(q:&[u8],_g:&[E;29])->[E;4] {
+ unsafe {assert_eq!(NBF_EVENTS,1);NBF_EVENTS=2;assert_eq!(q.as_ptr(),NBF_OPEN_PTR);} [E::ZERO;4]
+}
+fn NBF_inverse(_geometry:&QueryGeometry,i:usize)->&[M31;5] {
+ unsafe {assert_eq!(NBF_EVENTS,2);NBF_EVENTS=3;assert_eq!(i,NBF_I);&NBF_INV}
+}
+fn NBF_circle(alpha:E,_dots:[E;4],inverse:&[M31;5])->E {
+ unsafe {assert_eq!(NBF_EVENTS,3);NBF_EVENTS=4;assert_eq!(alpha,NBF_ALPHA);assert_eq!(*inverse,NBF_INV);NBF_FOLDED}
+}
+fn NBF_field(q:&[u8],s:usize)->E {
+ unsafe {assert_eq!(NBF_EVENTS,4+s as u8);NBF_EVENTS+=1;assert_eq!(q.as_ptr(),NBF_OPEN_PTR.add(672));assert_eq!(q.len(),128);NBF_VALUES[s]}
+}
+fn NBF_line(_alpha:E,values:[E;4],inverse:&[M31;5])->E {
+ unsafe {assert_eq!(NBF_EVENTS,8);NBF_EVENTS=9;assert_eq!(values,NBF_VALUES);assert_eq!(*inverse,NBF_INV);} E::ZERO
+}
+fn NBF_m31(x:M31,y:M31)->M31 {
+ assert!(x.0<2147483647);assert!(y.0<2147483647);
+ let out:u32=kani::any();kani::assume(out as u64==((x.0 as u64*y.0 as u64)%2147483647));M31(out)
+}
+// Query caller association only: records the exact reached child arguments.
+// NBF_AccumulateDomain is an explicit remaining callee bridge, not a pass.
+fn NBF_accumulate(_p:&Prepared,a:&mut Accumulator,node:M31,value:E,pending:&mut BatchedWeights) {
+ unsafe {assert_eq!(NBF_EVENTS,9);NBF_EVENTS=10;NBF_NODE=node;assert_eq!(value,E::ZERO);assert_eq!(a.next,NBF_I);}
+ assert_eq!(pending.terms,a.next);
+}
+fn NBF_any_e()->E {
+ let words:[u32;8]=kani::any();
+ for x in words {kani::assume(x<2147483647);}
+ E::from_limbs(words).unwrap()
+}
+#[kani::proof]
+#[kani::unwind(30)]
+#[kani::stub(super::opening,NBF_open)]
+#[kani::stub(crate::fast_dots::four_dots,NBF_dots)]
+#[kani::stub(crate::verifier::QueryGeometry::for_query,NBF_inverse)]
+#[kani::stub(crate::verifier::circle_fold_with_inverses,NBF_circle)]
+#[kani::stub(crate::weights::field,NBF_field)]
+#[kani::stub(crate::verifier::line_fold_with_inverses,NBF_line)]
+#[kani::stub(aspis_core::field::M31::mul,NBF_m31)]
+#[kani::stub(crate::verifier::accumulate_batched_with_node,NBF_accumulate)]
+fn NBF_query_gate() {
+ let next:usize=kani::any();kani::assume(next<10);
+ let u:u32=kani::any();kani::assume(u<262144);
+ let mut queries=[0u32;22];queries[next]=u;
+ let alpha=NBF_any_e();let fold=NBF_any_e();let vals=[NBF_any_e(),NBF_any_e(),NBF_any_e(),NBF_any_e()];
+ let z:u32=kani::any();kani::assume(z<2147483647);
+ let p=Prepared{variant:Variant::S2,roots:[[0;32];2],gamma:E::ZERO,kappa:E::ZERO,alpha:[alpha,E::ZERO],rho:K::ZERO,queries,semantic_alpha:[K::ZERO;10],z:[SecureCirclePoint{x:K::ZERO,y:K::ZERO};2],claim:E::ZERO,state:[0;32]};
+ let a=Accumulator{weights:Vec::new(),rhs:E::ZERO,power:K::ZERO,next};
+ let mut zs=alloc::vec![M31::ZERO;10];zs[next]=M31(z);
+ let geometry=QueryGeometry{start:0,inverses:Vec::new(),line_z:zs};
+ let pending=BatchedWeights{raw:Vec::new(),terms:next};
+ let proof:[u8;832]=[0;832];
+ unsafe {NBF_ALPHA=alpha;NBF_FOLDED=fold;NBF_VALUES=vals;}
+ let result=query_values(&proof,&p,a,&[E::ZERO;29],None,&geometry,pending);
+ let rejected=matches!(result,Err(Error::Query));
+ if fold!=vals[(u%4)as usize] {assert!(matches!(result,Err(Error::Query)));unsafe{assert_eq!(NBF_EVENTS,8);}}
+ else {let(a,b)=result.unwrap();assert_eq!(a.next,next);assert_eq!(b.terms,next);unsafe{assert_eq!(NBF_EVENTS,10);} }
+ kani::cover!(rejected);kani::cover!(!rejected);
+}
