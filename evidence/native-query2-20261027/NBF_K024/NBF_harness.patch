+ assert_eq!(words[0],m);assert_eq!(words[1],0);assert_eq!(words[2],0);assert_eq!(words[3],0);assert_eq!(words[4],0);assert_eq!(words[5],0);assert_eq!(words[6],0);assert_eq!(words[7],0);
+ kani::cover!(m==2147483646);kani::cover!(p[3]==2147483646);
