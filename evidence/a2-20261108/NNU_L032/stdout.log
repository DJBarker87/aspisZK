AspisR1.MultiproofConeP6Callbacks.checked_eval: ∀ {α β : Type}
  (H : AspisR1.MultiproofConePhysicalProgram.Address → AspisR1.MultiproofConePhysicalProgram.Digest)
  (r : Aeneas.Std.Result α) (f : α → AspisR1.MultiproofConePhysicalProgram.Run β),
  AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.MultiproofConePhysicalProgram.checked r f) =
    match r with
    | Aeneas.Std.Result.ok x => AspisV8R19.MemoizedProgramLaw.eval H (f x)
