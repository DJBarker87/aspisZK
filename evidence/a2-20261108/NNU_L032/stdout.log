def LIBB_PartitionEnv.digest : RSL.Env → VTop_Stages.aspis_core.digest.Digest32 Unit :=
fun env =>
  { coremarkerCopyInst := (LIBB_HashModel.digest env).coremarkerCopyInst,
    digest := fun x parts => LIB_Env.hashv env parts }
def LIBB_PartitionEnv.H : RSL.Env → AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State :=
fun env message => LIBB_HashModel.state (env.sha256 (LIBB_C04Partition.partition (LIBB_ProtocolBytes.host message)))
LIBB_PartitionEnv.partition_value (env : RSL.Env) (parts : Aeneas.Std.Slice (Aeneas.Std.Slice Aeneas.Std.U8))
  (partition :
    LIBB_C04Partition.partition (LIBB_ProtocolBytes.host (AspisV8R19.SqueezeOracleBridge.flatten parts)) =
      NNC_ResumeEvents.parts parts) :
  AspisV8R19.SqueezeOracleBridge.encodeState (LIBB_PartitionEnv.H env (AspisV8R19.SqueezeOracleBridge.flatten parts)) =
    LIB_Env.nativeKey (env.sha256 (NNC_ResumeEvents.parts parts))
LIBB_FlattenBytes.node (left right : Aeneas.Std.Array Aeneas.Std.U8 32#usize) :
  LIBB_C04Partition.partition
      (LIBB_ProtocolBytes.host
        (AspisV8R19.SqueezeOracleBridge.flatten (AspisR1.MultiproofConePhysicalDigest.parts left right))) =
    NNC_ResumeEvents.parts (AspisR1.MultiproofConePhysicalDigest.parts left right)
LIBB_C04InputPartition.input (kind : Aeneas.Std.Usize) (o : Aeneas.Std.Slice Aeneas.Std.U8) :
  LIBB_C04Partition.partition
      (LIBB_ProtocolBytes.host (AspisV8R19.SqueezeOracleBridge.flatten (AspisR1.Port4B_LeafCode.input kind o))) =
    NNC_ResumeEvents.parts (AspisR1.Port4B_LeafCode.input kind o)
def NJS_RuntimeDigest.backend : (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
  NJS_Extract.aspis_core.digest.Digest32 Unit :=
fun H =>
  { coremarkerCopyInst := { cloneInst := { clone := fun x => Aeneas.Std.Result.ok x } },
    digest := fun x parts => Aeneas.Std.Result.ok (AspisR1.MultiproofConePhysicalTransport.rawOracle H parts) }
def NJS_BatchLeaf.modelDigest : {H : Type} →
  NJS_Extract.aspis_core.digest.Digest32 H → AspisR1Stage2.aspis_core.digest.Digest32 H :=
fun {H} d => { coremarkerCopyInst := d.coremarkerCopyInst, digest := d.digest }
