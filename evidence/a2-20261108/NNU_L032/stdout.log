  (physical : Aeneas.Std.Slice Aeneas.Std.U8) (s : MultiproofConeRef.reference.Scratch),
  AspisR1.MultiproofConeVerifyState.verifyState root physical s =
    if
        AspisR1.OraclePortFrozenOrder.wellFormed
            (List.map Prod.fst (AspisR1.MultiproofConePhysicalViews.live s 0 ↑s.n)) ∧
          (↑physical).length % 32 = 0 then
      AspisV8R19.OracleProgramOps.bind
        (AspisR1.MultiproofConePhysicalTransport.transport (AspisR1.MultiproofConePhysicalLevels.levels 18 s physical))
        fun result =>
        AspisV8R19.MemoizedProgramLaw.Program.done
          (AspisR1.MultiproofConeVerifyState.finishState root physical s result)
    else AspisV8R19.MemoizedProgramLaw.Program.done (false, s)
