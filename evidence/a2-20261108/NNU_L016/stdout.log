    AspisR1CurrentWide.Proof.CanonicalWide y →
      ∃ z,
        AspisR1CurrentWide.field.wide_exact.WideExact.mul x y = Aeneas.Std.Result.ok z ∧
          AspisR1CurrentWide.Proof.CanonicalWide z ∧
            AspisR1CurrentWide.Proof.decodeWide z =
              AspisR1CurrentWide.Proof.decodeWide x * AspisR1CurrentWide.Proof.decodeWide y
AspisR1CurrentWide.Proof.wide_add_total_exact: ∀ (x y : AspisR1CurrentWide.Proof.E),
  AspisR1CurrentWide.Proof.CanonicalWide x →
    AspisR1CurrentWide.Proof.CanonicalWide y →
      ∃ z,
        AspisR1CurrentWide.field.wide_exact.WideExact.add x y = Aeneas.Std.Result.ok z ∧
