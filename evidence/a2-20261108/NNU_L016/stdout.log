AspisR1CurrentWide.Proof.wide_sub_total_exact: ∀ (x y : AspisR1CurrentWide.Proof.E),
  AspisR1CurrentWide.Proof.CanonicalWide x →
    AspisR1CurrentWide.Proof.CanonicalWide y →
      ∃ z,
        AspisR1CurrentWide.field.wide_exact.WideExact.sub x y = Aeneas.Std.Result.ok z ∧
          AspisR1CurrentWide.Proof.CanonicalWide z ∧
            AspisR1CurrentWide.Proof.decodeWide z =
              AspisR1CurrentWide.Proof.decodeWide x - AspisR1CurrentWide.Proof.decodeWide y
AspisR1CurrentWide.Proof.qm_add_total_canonical: ∀ (x y : AspisR1CurrentWide.field.QM31),
  AspisR1CurrentWide.Proof.CanonicalQM x →
    AspisR1CurrentWide.Proof.CanonicalQM y →
      ∃ z, x.add y = Aeneas.Std.Result.ok z ∧ AspisR1CurrentWide.Proof.CanonicalQM z
AspisR1CurrentWide.Proof.qm_sub_total_canonical: ∀ (x y : AspisR1CurrentWide.field.QM31),
  AspisR1CurrentWide.Proof.CanonicalQM x →
    AspisR1CurrentWide.Proof.CanonicalQM y →
      ∃ z, x.sub y = Aeneas.Std.Result.ok z ∧ AspisR1CurrentWide.Proof.CanonicalQM z
AspisR1CurrentWide.Proof.wide_mul_total_exact: ∀ (x y : AspisR1CurrentWide.Proof.E),
