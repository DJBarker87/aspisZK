  AspisR1.BEm_PaddingModel.valid AspisR1.BEm_PaddingNonvacuity.oneWord ∧
    AspisR1.BEm_PaddingModel.nativeWord AspisR1.BEm_PaddingNonvacuity.zeroWord = Bool.false ∧
      AspisR1.BEm_PaddingModel.referenceWord AspisR1.BEm_PaddingNonvacuity.zeroWord = Bool.false ∧
        AspisR1.BEm_PaddingModel.nativeWord AspisR1.BEm_PaddingNonvacuity.oneWord = Bool.true ∧
          AspisR1.BEm_PaddingModel.referenceWord AspisR1.BEm_PaddingNonvacuity.oneWord = Bool.true
