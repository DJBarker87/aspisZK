AspisR1.BEm_PaddingModel.traversal : ∀ (words : List AspisR1.BEm_PaddingModel.Word),
  (∀ w ∈ words, AspisR1.BEm_PaddingModel.valid w) →
    words.any AspisR1.BEm_PaddingModel.nativeWord =
      (List.flatMap AspisR1.BEm_PaddingModel.bytes words).any fun b => Decidable.decide (b ≠ 0)
AspisR1.BEm_ByteWord.agreement : ∀ (b : AspisR1.BEm_ByteWord.Bytes),
  AspisR1.BEm_PaddingModel.nativeWord (AspisR1.BEm_ByteWord.word b) =
    AspisR1.BEm_PaddingModel.referenceWord (AspisR1.BEm_ByteWord.word b)
AspisR1.BEm_PaddingCut.cut : ∀ (words : List AspisR1.BEm_PaddingModel.Word),
  (∀ w ∈ words, AspisR1.BEm_PaddingModel.valid w) →
    ∀ (count : ℕ),
      (List.drop (4 * count) words).any AspisR1.BEm_PaddingModel.nativeWord =
        (List.flatMap AspisR1.BEm_PaddingModel.bytes (List.drop (4 * count) words)).any fun b =>
          Decidable.decide (b ≠ 0)
AspisR1.BEm_PaddingCut.domain : ∀ (words : List AspisR1.BEm_PaddingModel.Word) (capacity count : ℕ),
  words.length = 4 * capacity →
    count ≤ capacity →
      capacity ≤ 172 →
        (List.drop (4 * count) words).length ≤ 688 ∧
          32 * count ≤ 32 * capacity ∧ 32 * capacity ≤ 5504 ∧ (32 * capacity - 32 * count) % 8 = 0
