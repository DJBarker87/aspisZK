{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-6-20261027/LPf_src/crates/aspis-core/src/field/LPf_contracts.rs", "exists": true, "sha256": "890f1b9c508dc00951858dbeb9bac8bbefdb51ea213fc1e9c11919ae35ee2be9", "text": "use super::*;\npub(super) fn LPf_reduce_ref(n:u64)->u32 {\n let b=2147483648u64;\n let n=n%b+n/b; let n=n%b+n/b;\n if n>=u64::from(P){(n-u64::from(P)) as u32}else{n as u32}\n}\n#[kani::proof_for_contract(reduce_u64)]\nfn LPf_reduce_contract(){let n:u64=kani::any();let _=reduce_u64(n);}\n#[kani::proof_for_contract(M31::mul)]\nfn LPf_mul_inline_contract(){let a=M31(kani::any());let b=M31(kani::any());let _=a.mul(b);}\n\n#[kani::proof_for_contract(QM31::write_le_bytes)] #[kani::unwind(18)]\nfn LPf_kbytes_contract(){let x:[u32;4]=kani::any();let k=QM31{c0:CM31{a:M31(x[0]),b:M31(x[1])},c1:CM31{a:M31(x[2]),b:M31(x[3])}};let mut out:[u8;16]=kani::any();k.write_le_bytes(&mut out);}\n\n#[kani::proof_for_contract(WideExact::to_le_bytes)] #[kani::unwind(34)]\nfn LPf_ebytes_contract(){let xs:[u32;8]=kani::any();for x in xs{kani::assume(x<P);}let e=WideExact::from_limbs(xs).unwrap();let _=e.to_le_bytes();}\n\n#[kani::proof_for_contract(CM31::write_le_bytes)] #[kani::unwind(10)]\nfn LPf_cbytes_contract(){let x:[u32;2]=kani::any();let c=CM31{a:M31(x[0]),b:M31(x[1])};let mut out:[u8;8]=kani::any();c.write_le_bytes(&mut out);}\n#[kani::proof_for_contract(QM31::write_le_bytes)] #[kani::stub_verified(CM31::write_le_bytes)] #[kani::unwind(18)]\nfn LPf_kbytes_composed_contract(){let x:[u32;4]=kani::any();let k=QM31{c0:CM31{a:M31(x[0]),b:M31(x[1])},c1:CM31{a:M31(x[2]),b:M31(x[3])}};let mut out:[u8;16]=kani::any();k.write_le_bytes(&mut out);}\n\n#[kani::proof_for_contract(M31::to_le_bytes)]\nfn LPf_mbytes_contract(){let x=M31(kani::any());let _=x.to_le_bytes();}\n#[kani::proof_for_contract(CM31::write_le_bytes)] #[kani::stub_verified(M31::to_le_bytes)] #[kani::unwind(10)]\nfn LPf_cbytes_composed_contract(){let x:[u32;2]=kani::any();let c=CM31{a:M31(x[0]),b:M31(x[1])};let mut out:[u8;8]=kani::any();c.write_le_bytes(&mut out);}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-6-20261027/LPf_src/crates/aspis-r1-cost-probe/src/LPf_replay.rs", "exists": true, "sha256": "9d92963e916d837522ac456531aa2e9fbe1bdf818adb048d854519ce300635ee", "text": "use aspis_core::field::{WideExact as E,QM31 as K,M31,CM31};\npub(crate) const P:u32=2147483647;\npub(crate) fn reduce_ref(n:u64)->u32 {let n=n%2147483648+n/2147483648;let n=n%2147483648+n/2147483648;if n>=u64::from(P){(n-u64::from(P))as u32}else{n as u32}}\npub(crate) fn raw_ref(x:[u32;4],y:[u32;4])->[u64;4]{\n let [a,b,c,d]=[u64::from(x[0]),u64::from(x[1]),u64::from(x[2]),u64::from(x[3])];\n let [e,f,g,h]=[u64::from(y[0]),u64::from(y[1]),u64::from(y[2]),u64::from(y[3])];\n const PP:u64=2147483647*2147483647;\n let partial=|x:u64|(x&2147483647).wrapping_add(x>>31u32);\n let u=partial((c*g).wrapping_add(PP).wrapping_sub(d*h));let v=partial((c*h).wrapping_add(d*g));\n [(a*e).wrapping_add(PP).wrapping_sub(b*f).wrapping_add(2*u).wrapping_add(3*u64::from(P)).wrapping_sub(v),\n (a*f).wrapping_add(b*e).wrapping_add(u).wrapping_add(2*v),\n (a*g).wrapping_add(c*e).wrapping_add(2*PP).wrapping_sub(b*h).wrapping_sub(d*f),\n (a*h).wrapping_add(b*g).wrapping_add(c*f).wrapping_add(d*e)]\n}\npub(crate) fn any_e()->E{let xs:[u32;8]=kani::any();for x in xs{kani::assume(x<P);}E::from_limbs(xs).unwrap()}\npub(crate) fn any_k()->K{let xs:[u32;4]=kani::any();K{c0:CM31{a:M31(xs[0]),b:M31(xs[1])},c1:CM31{a:M31(xs[2]),b:M31(xs[3])}}}\npub(crate) fn limbs(k:K)->[u32;4]{[k.c0.a.0,k.c0.b.0,k.c1.a.0,k.c1.b.0]}\n\n// Kani0.67 requires the callee proof harness in the caller crate's registry.\n#[kani::proof_for_contract(CM31::write_le_bytes)] #[kani::unwind(10)]\nfn LPf_cbytes_contract(){let x:[u32;2]=kani::any();let c=CM31{a:M31(x[0]),b:M31(x[1])};let mut out:[u8;8]=kani::any();c.write_le_bytes(&mut out);}\n// Exact QM31 caller allocation: either8-byte half of one16-byte buffer.\n#[kani::proof_for_contract(CM31::write_le_bytes)] #[kani::unwind(18)]\nfn LPf_cbytes_subslice_contract(){let x:[u32;2]=kani::any();let c=CM31{a:M31(x[0]),b:M31(x[1])};let mut out:[u8;16]=kani::any();let before=out;let half:bool=kani::any();let start=if half{8}else{0};c.write_le_bytes(&mut out[start..start+8]);let at:usize=kani::any();kani::assume(at<16);if at<start||at>=start+8{assert_eq!(out[at],before[at]);}kani::cover!(half);kani::cover!(!half);}\n#[kani::proof_for_contract(CM31::write_le_bytes)] #[kani::unwind(18)]\nfn LPf_cbytes_low16_contract(){let x:[u32;2]=kani::any();let c=CM31{a:M31(x[0]),b:M31(x[1])};let mut out:[u8;16]=kani::any();let before=out;c.write_le_bytes(&mut out[0..8]);let at:usize=kani::any();kani::assume(at<16);if at>=8{assert_eq!(out[at],before[at]);}kani::cover!(at==15);}\n#[kani::proof_for_contract(CM31::write_le_bytes)] #[kani::unwind(18)]\nfn LPf_cbytes_high16_contract(){let x:[u32;2]=kani::any();let c=CM31{a:M31(x[0]),b:M31(x[1])};let mut out:[u8;16]=kani::any();let before=out;c.write_le_bytes(&mut out[8..16]);let at:usize=kani::any();kani::assume(at<16);if at<8{assert_eq!(out[at],before[at]);}kani::cover!(at==0);}\n\n// Independent weaker safety property; never an exact multiplication bridge.\n#[kani::proof_for_contract(M31::mul)]\nfn LPf_mul_canonical_local_contract(){let a=M31(kani::any());let b=M31(kani::any());let _=a.mul(b);}\n// This stage checks canonicality/safety only, never the powers value law.\n#[kani::proof] #[kani::stub_verified(M31::mul)] #[kani::unwind(10)]\nfn LPf_powers7_canonical(){let x=any_e();let out=crate::weights::powers::<7>(x);for e in out{for w in e.to_limbs(){assert!(w<P);}}kani::cover!(x.to_limbs()[7]!=0);}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-6-20261027/LPf_src/crates/aspis-r1-cost-probe/src/LPf_verifier.rs", "exists": true, "sha256": "b87200772ec28de0e8cede2b0da60ad04789cfc5e016feefb25f10df7f62c4ad", "text": "// LPf checkpoint stages.\nuse super::*;\nuse crate::LPf_replay::{any_k,limbs};\n#[derive(Clone,Copy)]struct Checksum<'a>{count:&'a core::cell::Cell<usize>,prefix:&'a[u8],index:usize,answer:[u8;32]}\nimpl Digest32 for Checksum<'_>{fn digest(&self,parts:&[&[u8]])->[u8;32]{assert_eq!(self.count.get(),2);assert_eq!(parts.len(),2);assert_eq!(parts[0].len(),22);assert_eq!(parts[0],b\"UNPROVED:R1:checkpoint\");assert_eq!(parts[1].len(),1736);assert_eq!(parts[1][self.index],self.prefix[self.index]);self.count.set(3);self.answer}}\n// Universal byte projection replaces the previous all-prefix memcmp.\n#[kani::proof] #[kani::unwind(1738)] fn LPf_checksum_projection(){let prefix:[u8;1736]=kani::any();let mut out=Vec::from(prefix);let answer:[u8;32]=kani::any();let at:usize=kani::any();kani::assume(at<1768);let index:usize=kani::any();kani::assume(index<1736);let count=core::cell::Cell::new(2);let hash=Checksum{count:&count,prefix:&prefix,index,answer};let sum=hash.digest(&[b\"UNPROVED:R1:checkpoint\",&out]);out.extend_from_slice(&sum);assert_eq!(count.get(),3);assert_eq!(out.len(),1768);assert_eq!(out[at],if at<1736{prefix[at]}else{answer[at-1736]});kani::cover!(at==1767);}\n#[kani::proof] #[kani::stub_verified(aspis_core::field::CM31::write_le_bytes)] #[kani::unwind(66)]\nfn LPf_weights64_verified(){let xs:[K;64]=core::array::from_fn(|_|any_k());let mut out=Vec::new();for &x in &xs{put_k(&mut out,x);}let at:usize=kani::any();kani::assume(at<1024);assert_eq!(out.len(),1024);assert_eq!(out[at],limbs(xs[at/16])[(at%16)/4].to_le_bytes()[at%4]);kani::cover!(at==1023);}\nuse crate::LPf_replay::any_e;\nuse aspis_core::circle::SecureCirclePoint;\nfn inputs()->(Prepared,Accumulator){let p=Prepared{variant:Variant::S2,roots:kani::any(),gamma:any_e(),kappa:any_e(),alpha:[any_e(),any_e()],rho:any_k(),queries:kani::any(),semantic_alpha:core::array::from_fn(|_|any_k()),z:core::array::from_fn(|_|SecureCirclePoint{x:any_k(),y:any_k()}),claim:any_e(),state:kani::any()};let mut weights=Vec::with_capacity(64);for _ in 0..64{weights.push(any_k());}let a=Accumulator{weights,rhs:any_e(),power:any_k(),next:kani::any()};(p,a)}\nfn kbyte(k:K,j:usize)->u8{limbs(k)[j/4].to_le_bytes()[j%4]}\nfn ebyte(e:E,j:usize)->u8{e.to_limbs()[j/4].to_le_bytes()[j%4]}\nfn payload_byte(p:&Prepared,a:&Accumulator,answers:&[[u8;32];3],j:usize)->u8{\n if j<8{b\"R1P2CKP2\"[j]}else if j<16{[p.variant.tag(),a.next as u8,1,0,0,0,0,0][j-8]}\n else if j<48{answers[0][j-16]}else if j<80{answers[1][j-48]}else if j<112{p.state[j-80]}\n else if j<176{p.roots[(j-112)/32][(j-112)%32]}\n else if j<304{let k=j-176;ebyte([p.gamma,p.kappa,p.alpha[0],p.alpha[1]][k/32],k%32)}\n else if j<320{kbyte(p.rho,j-304)}\n else if j<408{let k=j-320;p.queries[k/4].to_le_bytes()[k%4]}\n else if j<568{let k=j-408;kbyte(p.semantic_alpha[k/16],k%16)}\n else if j<632{let k=j-568;let z=p.z[k/32];kbyte(if k%32<16{z.x}else{z.y},k%16)}\n else if j<696{let k=j-632;ebyte([p.claim,a.rhs][k/32],k%32)}\n else if j<712{kbyte(a.power,j-696)}else{kbyte(a.weights[(j-712)/16],(j-712)%16)}\n}\n#[derive(Clone,Copy)]struct Chronology<'a>{count:&'a core::cell::Cell<usize>,proof:&'a[u8],public:&'a[u8],p:&'a Prepared,a:&'a Accumulator,answers:[[u8;32];3],selected:usize}\nimpl Digest32 for Chronology<'_>{fn digest(&self,parts:&[&[u8]])->[u8;32]{let n=self.count.get();assert!(n<3);match n{\n0=>{assert_eq!(parts.len(),1);assert_eq!(parts[0].len(),self.proof.len());assert_eq!(parts[0].as_ptr(),self.proof.as_ptr());},\n1=>{assert_eq!(parts.len(),1);assert_eq!(parts[0].len(),self.public.len());assert_eq!(parts[0].as_ptr(),self.public.as_ptr());},\n2=>{assert_eq!(parts.len(),2);assert_eq!(parts[0],b\"UNPROVED:R1:checkpoint\");assert_eq!(parts[1].len(),1736);assert_eq!(parts[1][self.selected],payload_byte(self.p,self.a,&self.answers,self.selected));},_=>unreachable!()};self.count.set(n+1);self.answers[n]}}\n#[kani::proof] #[kani::stub_verified(aspis_core::field::CM31::write_le_bytes)] #[kani::unwind(70)]\nfn LPf_checkpoint_chronology(){let(p,a)=inputs();let proof:[u8;3]=kani::any();let public:[u8;5]=kani::any();let answers:[[u8;32];3]=kani::any();let selected:usize=kani::any();kani::assume(selected<1736);let at:usize=kani::any();kani::assume(at<1768);let count=core::cell::Cell::new(0);let hash=Chronology{count:&count,proof:&proof,public:&public,p:&p,a:&a,answers,selected};let out=checkpoint(&p,&a,&proof,&public,hash);assert_eq!(count.get(),3);assert_eq!(out.len(),1768);let expected=if at<1736{payload_byte(&p,&a,&answers,at)}else{answers[2][at-1736]};assert_eq!(out[at],expected);kani::cover!(at==1767);kani::cover!(selected==1735);}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-8-20261027/LPh_src/Cargo.toml", "exists": true, "sha256": "3de458ef315222e2ac6facb0ca39f24286ab3bb6ed103eebc2c87a02761bd23e", "text": "[workspace]\nmembers = [\n    \"crates/aspis-core\",\n    \"crates/aspis-r1-cost-probe\",\n    \"crates/aspis-prover\",\n    \"crates/aspis-statement\",\n    \"programs/aspis-pool\",\n    \"programs/aspis-registry\",\n    \"programs/aspis-verifier\",\n    \"programs/r1-cost-probe\",\n    \"audit/poseidon-pair-probe/program\",\n    \"xtask\",\n    # Extracted builder copies (D68.2): the shipped pair-forest trace writers.\n    # Their src/lib.rs files are the pinned extraction inputs; keep them byte-identical.\n    \"docs/research/v8-r0-zk-20261009/refine/writers\",\n    \"docs/research/v8-r0-zk-20261009/refine/blockwriters\",\n    \"docs/research/v8-r0-zk-20261009/refine/poseidon\",\n]\n# The research probes under docs/ are standalone crates with their own\n# [workspace]; the R1 cost probe uses the z4 probe library only behind its\n# `r1p-check` feature (LOG D38.3).\nexclude = [\"docs\"]\nresolver = \"2\"\n\n[workspace.package]\nedition = \"2021\"\nlicense = \"MIT OR Apache-2.0\"\nversion = \"0.1.0\"\n\n[workspace.dependencies]\nhkdf = \"0.12.4\"\nhpke = { version = \"=0.14.0\", default-features = false, features = [\"alloc\", \"chacha\", \"x25519\"] }\naspis-core = { path = \"crates/aspis-core\" }\naspis-prover = { path = \"crates/aspis-prover\" }\naspis-statement = { path = \"crates/aspis-statement\" }\naspis-verifier = { path = \"programs/aspis-verifier\", default-features = false, features = [\"no-entrypoint\"] }\nanyhow = \"1.0.100\"\nbase64 = \"0.22.1\"\nbincode = \"1.3.3\"\nborsh = { version = \"=1.5.7\", features = [\"derive\"] }\nchrono = { version = \"0.4.42\", default-features = false, features = [\"clock\", \"serde\", \"std\"] }\nchacha20poly1305 = { version = \"=0.11.0\", default-features = false, features = [\"zeroize\"] }\ngetrandom = \"0.3.4\"\nreqwest = { version = \"0.12.28\", default-features = false, features = [\"blocking\", \"json\", \"rustls-tls\"] }\nserde = { version = \"1.0.228\", features = [\"derive\"] }\nserde_json = \"1.0.145\"\nsha2 = \"0.10.8\"\nsolana-program = \"2.3.0\"\nsolana-loader-v3-interface = { version = \"5.0.0\", features = [\"bincode\"] }\nsolana-sdk = \"2.3.0\"\nsolana-system-interface = { version = \"1.0.0\", features = [\"bincode\"] }\nzeroize = \"1.8.1\"\nx25519-dalek = { version = \"=3.0.0\", default-features = false, features = [\"zeroize\"] }\n\n# The extracted P_R1 checker and builders are modelled with checked arithmetic\n# (an overflow is a failure, D57.1): keep overflow checks in optimized builds.\n[profile.release.package.aspis-r1-cert-check]\noverflow-checks = true\n\n[profile.release.package.aspis-r1-cert-build]\noverflow-checks = true\n"}
