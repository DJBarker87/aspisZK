ersion = \"0.12.28\", default-features = false, features = [\"blocking\", \"json\", \"rustls-tls\"] }\nserde = { version = \"1.0.228\", features = [\"derive\"] }\nserde_json = \"1.0.145\"\nsha2 = \"0.10.8\"\nsolana-program = \"2.3.0\"\nsolana-loader-v3-interface = { version = \"5.0.0\", features = [\"bincode\"] }\nsolana-sdk = \"2.3.0\"\nsolana-system-interface = { version = \"1.0.0\", features = [\"bincode\"] }\nzeroize = \"1.8.1\"\nx25519-dalek = { version = \"=3.0.0\", default-features = false, features = [\"zeroize\"] }\n\n# The extracted P_R1 checker and builders are modelled with checked arithmetic\n# (an overflow is a failure, D57.1): keep overflow checks in optimized builds.\n[profile.release.package.aspis-r1-cert-check]\noverflow-checks = true\n\n[profile.release.package.aspis-r1-cert-build]\noverflow-checks = true\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-native-tx2a-20261027/NBC_src/crates/aspis-core/src/field/wide_exact/NBC_runtime.rs", "exists": true, "sha256": "4818b062df22356fb97f73a7e8b24cae82f946ea53c0cb300ed726a23562b788", "text": "use super::*;\nimpl kani::Arbitrary for WideExact {\n    fn any() -> Self {\n        let q = || QM31 { c0: CM31 { a: M31(kani::any()), b: M31(kani::any()) },\n                           c1: CM31 { a: M31(kani::any()), b: M31(kani::any()) } };\n        Self { c0: q(), c1: q() }\n    }\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-native-tx2a-20261027/NBC_src/crates/aspis-r1-cost-probe/src/verifier/NBC_runtime.rs", "exists": true, "sha256": "3ce11abdb395f8a100d9ca3c525d4b2e760163e8c993d168c5fcd154ab3e2c3f", "text": "use super::*;\nfn phase() -> Phase {\n    match kani::any::<u8>() % 11 {\n        0 => Phase::Parsed, 1 => Phase::Semantic,\n        2 => Phase::SemanticPart(kani::any()), 3 => Phase::Prepare,\n        4 => Phase::CheckpointRead, 5 => Phase::Merkle(kani::any()),\n        6 => Phase::Query(kani::any()),\n        7 => Phase::QueryPart(kani::any(),kani::any()),\n        8 => Phase::CheckpointWrite, 9 => Phase::Relation, _ => Phase::Final,\n    }\n}\n#[kani::proof]\nfn NBC_mark_none() {\n    let p=phase();\n    super::mark(None,p);\n    kani::cover!(true);\n}\n#[kani::proof]\nfn NBC_trace_value() {\n    let tag: u16=kani::any();\n    let index: usize=kani::any();\n    let x: aspis_core::field::WideExact=kani::any();\n    crate::trace::value(tag,index,x);\n    kani::cover!(true);\n}\n"}
