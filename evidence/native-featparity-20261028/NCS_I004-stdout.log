{"path": "/home/dombarker/project-offloads/codex-cx-native-tx2g-20261028/NBP_src/crates/aspis-statement/src/pool_v1/payment_relation/NBP_codecs.rs", "exists": true, "sha256": "71bfc2df74f091492f77ffc15dab2fc7a7082a4728a7b0388933667138347077", "text": "use super::*;\nfn NBP_digest_bytes(d:&Digest)->[u8;32] {\n let b0=d[0].0.to_le_bytes();\n let b1=d[1].0.to_le_bytes();\n let b2=d[2].0.to_le_bytes();\n let b3=d[3].0.to_le_bytes();\n let b4=d[4].0.to_le_bytes();\n let b5=d[5].0.to_le_bytes();\n let b6=d[6].0.to_le_bytes();\n let b7=d[7].0.to_le_bytes();\n [b0[0],b0[1],b0[2],b0[3],b1[0],b1[1],b1[2],b1[3],b2[0],b2[1],b2[2],b2[3],b3[0],b3[1],b3[2],b3[3],b4[0],b4[1],b4[2],b4[3],b5[0],b5[1],b5[2],b5[3],b6[0],b6[1],b6[2],b6[3],b7[0],b7[1],b7[2],b7[3]]\n}\n#[kani::proof]\n#[kani::unwind(256)]\n#[kani::stub(crate::atomic_statement::encode_digest_canonical, NBP_digest_bytes)]\nfn NBP_common_encoder() {\n let mut out:[u8;216]=kani::any();let before=out;\n let magic:[u8;4]=kani::any();let withdrawal:bool=kani::any();\n let kind=if withdrawal{PoolV1TransitionKind::Withdrawal}else{PoolV1TransitionKind::PrivateTransfer};\n let c=CommonPublicV1{pool:kani::any(),deployment_domain:kani::any(),anchor_sequence:kani::any(),anchor_root:NBP_digest(),nullifier:NBP_digest(),asset_id:M31(kani::any())};\n let j:usize=kani::any();kani::assume(j<216);\n super::encode_common(&mut out,magic,kind,c);\n let expected=match j {\n 0..=3=>magic[j],4=>1,5=>if withdrawal{2}else{1},6=>1,7=>before[j],\n 8..=39=>c.pool[j-8],40..=71=>c.deployment_domain[j-40],\n 72..=79=>c.anchor_sequence.to_le_bytes()[j-72],\n 80..=111=>NBP_digest_bytes(&c.anchor_root)[j-80],\n 112..=143=>NBP_digest_bytes(&c.nullifier)[j-112],\n 144..=147=>c.asset_id.0.to_le_bytes()[j-144],_=>before[j]};\n assert!(out[j]==expected);kani::cover!(j==215);\n}\nfn NBP_digest()->Digest { [M31(kani::any()),M31(kani::any()),M31(kani::any()),M31(kani::any()),M31(kani::any()),M31(kani::any()),M31(kani::any()),M31(kani::any())] }\n#[kani::proof]\n#[kani::unwind(256)]\nfn NBP_store_magic() {\n let mut out:[u8;216]=kani::any();let before=out;let src:[u8;4]=kani::any();\n let j:usize=kani::any();kani::assume(j<216);\n out[0..4].copy_from_slice(&src);\n assert!(out[j]==if j>=0&&j<4{src[j-0]}else{before[j]});\n kani::cover!(j==3);\n}\n#[kani::proof]\n#[kani::unwind(256)]\nfn NBP_store_pool() {\n let mut out:[u8;216]=kani::any();let before=out;let src:[u8;32]=kani::any();\n let j:usize=kani::any();kani::assume(j<216);\n out[8..40].copy_from_slice(&src);\n assert!(out[j]==if j>=8&&j<40{src[j-8]}else{before[j]});\n kani::cover!(j==39);\n}\n#[kani::proof]\n#[kani::unwind(256)]\nfn NBP_store_deployment() {\n let mut out:[u8;216]=kani::any();let before=out;let src:[u8;32]=kani::any();\n let j:usize=kani::any();kani::assume(j<216);\n out[40..72].copy_from_slice(&src);\n assert!(out[j]==if j>=40&&j<72{src[j-40]}else{before[j]});\n kani::cover!(j==71);\n}\n#[kani::proof]\n#[kani::unwind(256)]\nfn NBP_store_sequence() {\n let mut out:[u8;216]=kani::any();let before=out;let src:[u8;8]=kani::any();\n let j:usize=kani::any();kani::assume(j<216);\n out[72..80].copy_from_slice(&src);\n assert!(out[j]==if j>=72&&j<80{src[j-72]}else{before[j]});\n kani::cover!(j==79);\n}\n#[kani::proof]\n#[kani::unwind(256)]\nfn NBP_store_anchor() {\n let mut out:[u8;216]=kani::any();let before=out;let src:[u8;32]=kani::any();\n let j:usize=kani::any();kani::assume(j<216);\n out[80..112].copy_from_slice(&src);\n assert!(out[j]==if j>=80&&j<112{src[j-80]}else{before[j]});\n kani::cover!(j==111);\n}\n#[kani::proof]\n#[kani::unwind(256)]\nfn NBP_store_nullifier() {\n let mut out:[u8;216]=kani::any();let before=out;let src:[u8;32]=kani::any();\n let j:usize=kani::any();kani::assume(j<216);\n out[112..144].copy_from_slice(&src);\n assert!(out[j]==if j>=112&&j<144{src[j-112]}else{before[j]});\n kani::cover!(j==143);\n}\n#[kani::proof]\n#[kani::unwind(256)]\nfn NBP_store_asset() {\n let mut out:[u8;216]=kani::any();let before=out;let src:[u8;4]=kani::any();\n let j:usize=kani::any();kani::assume(j<216);\n out[144..148].copy_from_slice(&src);\n assert!(out[j]==if j>=144&&j<148{src[j-144]}else{before[j]});\n kani::cover!(j==147);\n}\n#[kani::proof]\n#[kani::unwind(256)]\nfn NBP_store_recipient() {\n let mut out:[u8;216]=kani::any();let before=out;let src:[u8;32]=kani::any();\n let j:usize=kani::any();kani::assume(j<216);\n out[152..184].copy_from_slice(&src);\n assert!(out[j]==if j>=152&&j<184{src[j-152]}else{before[j]});\n kani::cover!(j==183);\n}\n#[kani::proof]\n#[kani::unwind(256)]\nfn NBP_store_change() {\n let mut out:[u8;216]=kani::any();let before=out;let src:[u8;32]=kani::any();\n let j:usize=kani::any();kani::assume(j<216);\n out[184..216].copy_from_slice(&src);\n assert!(out[j]==if j>=184&&j<216{src[j-184]}else{before[j]});\n kani::cover!(j==215);\n}\n#[kani::proof]\n#[kani::unwind(256)]\nfn NBP_store_amount() {\n let mut out:[u8;216]=kani::any();let before=out;let src:[u8;4]=kani::any();\n let j:usize=kani::any();kani::assume(j<216);\n out[148..152].copy_from_slice(&src);\n assert!(out[j]==if j>=148&&j<152{src[j-148]}else{before[j]});\n kani::cover!(j==151);\n}\n#[kani::proof]\n#[kani::unwind(256)]\nfn NBP_store_destination() {\n let mut out:[u8;216]=kani::any();let before=out;let src:[u8;32]=kani::any();\n let j:usize=kani::any();kani::assume(j<216);\n out[152..184].copy_from_slice(&src);\n assert!(out[j]==if j>=152&&j<184{src[j-152]}else{before[j]});\n kani::cover!(j==183);\n}\nfn NBP_raw32(b:&[u8;216],off:usize)->[u8;32] {\n [b[off+0],b[off+1],b[off+2],b[off+3],b[off+4],b[off+5],b[off+6],b[off+7],b[off+8],b[off+9],b[off+10],b[off+11],b[off+12],b[off+13],b[off+14],b[off+15],b[off+16],b[off+17],b[off+18],b[off+19],b[off+20],b[off+21],b[off+22],b[off+23],b[off+24],b[off+25],b[off+26],b[off+27],b[off+28],b[off+29],b[off+30],b[off+31]]\n}\nfn NBP_common_spec(b:&[u8;216])->Result<CommonPublicV1,PoolV1PaymentStatementFormatError> {\n let asset=u32::from_le_bytes([b[144],b[145],b[146],b[147]]);\n if asset>=P {return Err(PoolV1PaymentStatementFormatError::NonCanonicalAssetId);}\n let root=crate::atomic_statement::decode_digest_canonical(&NBP_raw32(b,80)).map_err(|_|PoolV1PaymentStatementFormatError::NonCanonicalDigest)?;\n let nullifier=crate::atomic_statement::decode_digest_canonical(&NBP_raw32(b,112)).map_err(|_|PoolV1PaymentStatementFormatError::NonCanonicalDigest)?;\n let c=CommonPublicV1{pool:NBP_raw32(b,8),deployment_domain:NBP_raw32(b,40),anchor_sequence:u64::from_le_bytes([b[72],b[73],b[74],b[75],b[76],b[77],b[78],b[79]]),anchor_root:root,nullifier,asset_id:M31(asset)};\n super::validate_common(c)?;Ok(c)\n}\n#[kani::proof]\n#[kani::unwind(256)]\nfn NBP_common_decoder() {\n let b:[u8;216]=kani::any();let j:usize=kani::any();kani::assume(j<32);\n match (super::decode_common(&b),NBP_common_spec(&b)) {\n (Err(a),Err(e))=>assert!(a==e),\n (Ok(a),Ok(c))=>{assert!(a.pool[j]==c.pool[j]);assert!(a.deployment_domain[j]==c.deployment_domain[j]);assert!(a.anchor_sequence==c.anchor_sequence);assert!(a.anchor_root[j%8]==c.anchor_root[j%8]);assert!(a.nullifier[j%8]==c.nullifier[j%8]);assert!(a.asset_id==c.asset_id);},\n _=>assert!(false),\n }\n kani::cover!(b[144]==255);\n}\nfn NBP_t()->PoolV1PrivateTransferPublicV1 { PoolV1PrivateTransferPublicV1{pool:kani::any(),deployment_domain:kani::any(),anchor_sequence:kani::any(),anchor_root:NBP_digest(),nullifier:NBP_digest(),asset_id:M31(kani::any()),recipient_commitment:NBP_digest(),change_commitment:NBP_digest()} }\nfn NBP_w()->PoolV1WithdrawalPublicV1 { PoolV1WithdrawalPublicV1{pool:kani::any(),deployment_domain:kani::any(),anchor_sequence:kani::any(),anchor_root:NBP_digest(),nullifier:NBP_digest(),asset_id:M31(kani::any()),amount:kani::any(),destination_token_account:kani::any(),change_commitment:NBP_digest()} }\nfn NBP_encoded_common_byte(c:CommonPublicV1,withdrawal:bool,j:usize)->u8 {\n match j {0=>65,1=>83,2=>if withdrawal{87}else{67},3=>80,4=>1,5=>if withdrawal{2}else{1},6=>1,7=>0,\n 8..=39=>c.pool[j-8],40..=71=>c.deployment_domain[j-40],72..=79=>c.anchor_sequence.to_le_bytes()[j-72],80..=111=>NBP_digest_bytes(&c.anchor_root)[j-80],112..=143=>NBP_digest_bytes(&c.nullifier)[j-112],144..=147=>c.asset_id.0.to_le_bytes()[j-144],_=>0}\n}\n#[kani::proof]\n#[kani::unwind(256)]\n#[kani::stub(crate::atomic_statement::encode_digest_canonical,NBP_digest_bytes)]\nfn NBP_transfer_encoder() {\n let p=NBP_t();let j:usize=kani::any();kani::assume(j<216);\n match (super::encode_pool_v1_private_transfer_public_v1(&p),super::validate_pool_v1_private_transfer_public_v1(&p)) {\n (Err(a),Err(e))=>assert!(a==e),(Ok(b),Ok(()))=>{\n let v=if j<152{NBP_encoded_common_byte(super::transfer_common(&p),false,j)}else if j<184{NBP_digest_bytes(&p.recipient_commitment)[j-152]}else{NBP_digest_bytes(&p.change_commitment)[j-184]};assert!(b[j]==v);\n },_=>assert!(false)}\n kani::cover!(p.pool[0]==0);\n}\n#[kani::proof]\n#[kani::unwind(256)]\n#[kani::stub(crate::atomic_statement::encode_digest_canonical,NBP_digest_bytes)]\nfn NBP_withdrawal_encoder() {\n let p=NBP_w();let j:usize=kani::any();kani::assume(j<216);\n match (super::encode_pool_v1_withdrawal_public_v1(&p),super::validate_pool_v1_withdrawal_public_v1(&p)) {\n (Err(a),Err(e))=>assert!(a==e),(Ok(b),Ok(()))=>{\n let v=if j<148{NBP_encoded_common_byte(super::withdrawal_common(&p),true,j)}else if j<152{p.amount.to_le_bytes()[j-148]}else if j<184{p.destination_token_account[j-152]}else{NBP_digest_bytes(&p.change_commitment)[j-184]};assert!(b[j]==v);\n },_=>assert!(false)}\n kani::cover!(p.amount==0);\n}\nfn NBP_transfer_spec(b:&[u8;216])->Result<PoolV1PrivateTransferPublicV1,PoolV1PaymentStatementFormatError> {\n super::require_header(b,*b\"ASCP\",PoolV1TransitionKind::PrivateTransfer)?;\n if b[148]!=0||b[149]!=0||b[150]!=0||b[151]!=0{return Err(PoolV1PaymentStatementFormatError::NonZeroReserved)}\n let c=NBP_common_spec(b)?;\n let r=crate::atomic_statement::decode_digest_canonical(&NBP_raw32(b,152)).map_err(|_|PoolV1PaymentStatementFormatError::NonCanonicalDigest)?;\n let z=crate::atomic_statement::decode_digest_canonical(&NBP_raw32(b,184)).map_err(|_|PoolV1PaymentStatementFormatError::NonCanonicalDigest)?;\n let p=PoolV1PrivateTransferPublicV1{pool:c.pool,deployment_domain:c.deployment_domain,anchor_sequence:c.anchor_sequence,anchor_root:c.anchor_root,nullifier:c.nullifier,asset_id:c.asset_id,recipient_commitment:r,change_commitment:z};\n super::validate_pool_v1_private_transfer_public_v1(&p)?;Ok(p)\n}\nfn NBP_withdrawal_spec(b:&[u8;216])->Result<PoolV1WithdrawalPublicV1,PoolV1PaymentStatementFormatError> {\n super::require_header(b,*b\"ASWP\",PoolV1TransitionKind::Withdrawal)?;\n let c=NBP_common_spec(b)?;\n let z=crate::atomic_statement::decode_digest_canonical(&NBP_raw32(b,184)).map_err(|_|PoolV1PaymentStatementFormatError::NonCanonicalDigest)?;\n let p=PoolV1WithdrawalPublicV1{pool:c.pool,deployment_domain:c.deployment_domain,anchor_sequence:c.anchor_sequence,anchor_root:c.anchor_root,nullifier:c.nullifier,asset_id:c.asset_id,amount:u32::from_le_bytes([b[148],b[149],b[150],b[151]]),destination_token_account:NBP_raw32(b,152),change_commitment:z};\n super::validate_pool_v1_withdrawal_public_v1(&p)?;Ok(p)\n}\n#[kani::proof]\n#[kani::unwind(256)]\nfn NBP_transfer_decoder() {\n let b:[u8;216]=kani::any();assert!(super::decode_pool_v1_private_transfer_public_v1(&b)==NBP_transfer_spec(&b));kani::cover!(b[0]==0);\n}\n#[kani::proof]\n#[kani::unwind(256)]\nfn NBP_withdrawal_decoder() {\n let b:[u8;216]=kani::any();assert!(super::decode_pool_v1_withdrawal_public_v1(&b)==NBP_withdrawal_spec(&b));kani::cover!(b[0]==0);\n}\n"}
