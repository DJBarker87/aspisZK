{"path": "/home/dombarker/project-offloads/codex-cx-native-tx2b-20261027/NBD_src/Cargo.toml", "exists": true, "sha256": "3de458ef315222e2ac6facb0ca39f24286ab3bb6ed103eebc2c87a02761bd23e", "text": "[workspace]\nmembers = [\n    \"crates/aspis-core\",\n    \"crates/aspis-r1-cost-probe\",\n    \"crates/aspis-prover\",\n    \"crates/aspis-statement\",\n    \"programs/aspis-pool\",\n    \"programs/aspis-registry\",\n    \"programs/aspis-verifier\",\n    \"programs/r1-cost-probe\",\n    \"audit/poseidon-pair-probe/program\",\n    \"xtask\",\n    # Extracted builder copies (D68.2): the shipped pair-forest trace writers.\n    # Their src/lib.rs files are the pinned extraction inputs; keep them byte-identical.\n    \"docs/research/v8-r0-zk-20261009/refine/writers\",\n    \"docs/research/v8-r0-zk-20261009/refine/blockwriters\",\n    \"docs/research/v8-r0-zk-20261009/refine/poseidon\",\n]\n# The research probes under docs/ are standalone crates with their own\n# [workspace]; the R1 cost probe uses the z4 probe library only behind its\n# `r1p-check` feature (LOG D38.3).\nexclude = [\"docs\"]\nresolver = \"2\"\n\n[workspace.package]\nedition = \"2021\"\nlicense = \"MIT OR Apache-2.0\"\nversion = \"0.1.0\"\n\n[workspace.dependencies]\nhkdf = \"0.12.4\"\nhpke = { version = \"=0.14.0\", default-features = false, features = [\"alloc\", \"chacha\", \"x25519\"] }\naspis-core = { path = \"crates/aspis-core\" }\naspis-prover = { path = \"crates/aspis-prover\" }\naspis-statement = { path = \"crates/aspis-statement\" }\naspis-verifier = { path = \"programs/aspis-verifier\", default-features = false, features = [\"no-entrypoint\"] }\nanyhow = \"1.0.100\"\nbase64 = \"0.22.1\"\nbincode = \"1.3.3\"\nborsh = { version = \"=1.5.7\", features = [\"derive\"] }\nchrono = { version = \"0.4.42\", default-features = false, features = [\"clock\", \"serde\", \"std\"] }\nchacha20poly1305 = { version = \"=0.11.0\", default-features = false, features = [\"zeroize\"] }\ngetrandom = \"0.3.4\"\nreqwest = { version = \"0.12.28\", default-features = false, features = [\"blocking\", \"json\", \"rustls-tls\"] }\nserde = { version = \"1.0.228\", features = [\"derive\"] }\nserde_json = \"1.0.145\"\nsha2 = \"0.10.8\"\nsolana-program = \"2.3.0\"\nsolana-loader-v3-interface = { version = \"5.0.0\", features = [\"bincode\"] }\nsolana-sdk = \"2.3.0\"\nsolana-system-interface = { version = \"1.0.0\", features = [\"bincode\"] }\nzeroize = \"1.8.1\"\nx25519-dalek = { version = \"=3.0.0\", default-features = false, features = [\"zeroize\"] }\n\n# The extracted P_R1 checker and builders are modelled with checked arithmetic\n# (an overflow is a failure, D57.1): keep overflow checks in optimized builds.\n[profile.release.package.aspis-r1-cert-check]\noverflow-checks = true\n\n[profile.release.package.aspis-r1-cert-build]\noverflow-checks = true\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-native-tx2b-20261027/NBD_src/crates/aspis-statement/src/pool_v1/NBD_digest.rs", "exists": true, "sha256": "cac9f1f7c36ab0872fe9cd5f0de37942ee0f1459fa10c4bad497972afd15d825", "text": "// Frozen loop body, with while replaced by one if and explicit exit state.\nuse super::*;\nfn NBD_native_iteration(value: &Digest, mut i: usize) -> (bool, usize, bool) {\n    if i < value.len() {\n        if value[i].0 >= P {\n            return (false, i, true);\n        }\n        i += 1;\n    }\n    (true, i, i == value.len())\n}\n#[kani::proof]\nfn NBD_digest_iteration() {\n    let words: [u32;8] = kani::any();\n    let value = words.map(M31);\n    let i: usize = kani::any();\n    kani::assume(i <= 8);\n    let result = NBD_native_iteration(&value, i);\n    let expected = if i == 8 { (true, i, true) }\n        else if words[i] >= 2147483647 { (false, i, true) }\n        else { (true, i + 1, i + 1 == 8) };\n    assert_eq!(result, expected);\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-native-tx2b-20261027/NBD_src/crates/aspis-statement/src/pool_v1/NBD_registry.rs", "exists": true, "sha256": "a46c2c4e0ca73aef99b11337e76f9e79dc965e8d496363e451ae6ec14efbd10d", "text": "// Scratch-only native getter gate. All control fields and slots arbitrary.\nuse super::*;\n#[kani::proof]\nfn NBD_registry_getters() {\n    let flags: u8 = kani::any();\n    let status_byte: u8 = kani::any();\n    let activation: u64 = kani::any();\n    let retirement: u64 = kani::any();\n    let slot: u64 = kani::any();\n    let parsed = VerifierEntryStatusV1::try_from(status_byte);\n    assert_eq!(parsed, match status_byte {\n        0 => Ok(VerifierEntryStatusV1::Pending),\n        1 => Ok(VerifierEntryStatusV1::Active),\n        2 => Ok(VerifierEntryStatusV1::Paused),\n        3 => Ok(VerifierEntryStatusV1::Retired),\n        _ => Err(PoolV1VerifierRegistryFormatError::InvalidStatus),\n    });\n    let status = match parsed { Ok(s) => s, Err(_) => return };\n    let v1 = VerifierRegistryV1 { flags, bump:kani::any(),pool:kani::any(),authority:kani::any(),policy_binding:kani::any(),generation:kani::any(),minimum_activation_delay_slots:kani::any() };\n    let v2 = VerifierRegistryV2 { flags,bump:kani::any(),pool:kani::any(),authority:kani::any(),policy_binding:kani::any(),generation:kani::any(),minimum_activation_delay_slots:kani::any(),registry_program:kani::any(),loader_program:kani::any(),programdata_address:kani::any(),programdata_bump:kani::any(),executable_hash:kani::any() };\n    assert_eq!(v1.is_paused(), flags % 2 == 1);\n    assert_eq!(v2.is_paused(), flags % 2 == 1);\n    assert_eq!(v1.is_immutable(), (flags / 2) % 2 == 1);\n    assert_eq!(v2.is_immutable(), (flags / 2) % 2 == 1);\n    let e1 = VerifierRegistryEntryV1 {status,statement_version:kani::any(),bump:kani::any(),pool:kani::any(),verifier_program:kani::any(),profile_binding:kani::any(),release_binding:kani::any(),activation_slot:activation,retirement_slot:retirement,policy_binding:kani::any()};\n    let e2 = VerifierRegistryEntryV2 {status,statement_version:kani::any(),bump:kani::any(),pool:kani::any(),verifier_program:kani::any(),profile_binding:kani::any(),release_binding:kani::any(),activation_slot:activation,retirement_slot:retirement,policy_binding:kani::any(),loader_program:kani::any(),programdata_address:kani::any(),programdata_bump:kani::any(),executable_hash:kani::any(),expected_upgrade_authority:kani::any()};\n    let no_retire = retirement == u64::MAX;\n    let active = status_byte == 1 && activation <= slot && (no_retire || slot < retirement);\n    assert_eq!(e1.has_no_retirement_slot(), no_retire);\n    assert_eq!(e2.has_no_retirement_slot(), no_retire);\n    assert_eq!(e1.is_active_at(slot), active);\n    assert_eq!(e2.is_active_at(slot), active);\n}\n"}
