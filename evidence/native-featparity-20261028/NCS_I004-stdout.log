{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPl_validate.rs", "exists": true, "sha256": "d7008de18055376c6dd554f63681210e4c400267dbd0e0f71da04ceb798841b6", "text": "use super::*;\n#[kani::proof] #[kani::unwind(10)]\nfn LPl_iterator(){\n let b:[u8;3712]=kani::any();let n:usize=kani::any();kani::assume(n<=3712);\n let i:usize=kani::any();kani::assume(i<=n/32);\n let mut it=b[..n].chunks_exact(32).enumerate();\n // nth on the raw byte iterator establishes the arbitrary reached enumeration\n // pre-state without running any field-decoding loop.\n if i>0 {let (j,_)=it.nth(i-1).unwrap();assert_eq!(j,i-1);}\n assert_eq!(it.len(),n/32-i);\n match it.next(){None=>{assert_eq!(i,n/32);assert_eq!(it.len(),0);},Some((index,c))=>{\n  assert!(i<n/32);assert_eq!(index,i);assert_eq!(c.len(),32);assert!(core::ptr::eq(c.as_ptr(),b[32*i..].as_ptr()));\n  assert_eq!(it.len(),n/32-(i+1));\n  match it.next(){None=>assert_eq!(i+1,n/32),Some((next_index,next))=>{\n   assert!(i+1<n/32);assert_eq!(next_index,i+1);assert!(core::ptr::eq(next.as_ptr(),b[32*(i+1)..].as_ptr()));}}\n }}\n}\n#[kani::proof] #[kani::unwind(10)]\nfn LPl_nonvacuity(){\n let row:u8=kani::any();if let Some((_,size))=row_shape(row){assert!(size<=3712&&size%32==0);}\n let zero=[0u8;32];assert_eq!(validate_record_fields(row,&zero),Ok(()));assert_eq!(validate_record_fields(row,&[]),Ok(()));\n let mut high=zero;high[16]=1;assert_eq!(validate_record_fields(row,&high),Err(Error::NonCanonical{row,value:0}));\n let mut bad=zero;bad[0]=255;bad[1]=255;bad[2]=255;bad[3]=127;assert_eq!(validate_record_fields(row,&bad),Err(Error::NonCanonical{row,value:0}));\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPn_claims.rs", "exists": true, "sha256": "1e993db2845e45392a8e7d3eae164413eea9c279e77545c45c46ff182bbede1f", "text": "use super::*;\nfn eq_q(a:QM31,b:QM31){assert_eq!(a.c0.a.0,b.c0.a.0);assert_eq!(a.c0.b.0,b.c0.b.0);assert_eq!(a.c1.a.0,b.c1.a.0);assert_eq!(a.c1.b.0,b.c1.b.0);}\n#[kani::proof] #[kani::unwind(6)]\nfn LPn_owned_step(){\n // All bits are valid: only nested u32 products, no padding interpretation,\n // pointers, references or enum discriminants are fabricated.\n let raw:[u8;928]=kani::any();\n let prior:[[QM31;29];2]=unsafe{core::mem::transmute(raw)};\n let raw:[u8;464]=kani::any();let next:[QM31;29]=unsafe{core::mem::transmute(raw)};\n let p:usize=kani::any();kani::assume(p<3);\n let j:usize=kani::any();kani::assume(j<=p);\n let lane:usize=kani::any();kani::assume(lane<29);\n match aspis_core::r0::heap::uninit::<[[QM31;29];3]>(){\n  Err(e)=>assert_eq!(e,aspis_core::r0::Error::Allocation),\n  Ok(mut out)=>unsafe{\n   let base=out.as_mut_ptr();let dst=base.cast::<[QM31;29]>();\n   // Reachable prefix invariant. No uninitialized future slot is read.\n   if p>0{dst.write(prior[0]);}if p>1{dst.add(1).write(prior[1]);}\n   // Exactly one verbatim source iteration after the CLOSED decoder returns.\n   dst.add(p).write(next);\n   assert_eq!(out.as_mut_ptr(),base);\n   let got=(*dst.add(j))[lane];eq_q(got,if j==p{next[lane]}else{prior[j][lane]});\n   if p==2{\n    let initialized=out.assume_init();\n    assert_eq!(initialized.as_ptr(),dst);\n    eq_q(initialized[j][lane],if j==p{next[lane]}else{prior[j][lane]});\n    drop(initialized);\n   }else{drop(out);}\n  }\n }\n}\nfn abort_after_prefix(p:usize,prior:[[QM31;29];2],row:u8,value:usize)->Result<(),Error>{\n let mut out=aspis_core::r0::heap::uninit::<[[QM31;29];3]>().map_err(|_|Error::Allocation)?;\n unsafe{\n  let dst=out.as_mut_ptr().cast::<[QM31;29]>();\n  if p>0{dst.write(prior[0]);}if p>1{dst.add(1).write(prior[1]);}\n  let child:Result<[QM31;29],Error>=Err(Error::NonCanonical{row,value});\n  dst.add(p).write(child?);\n }\n // Unreachable after the failing child; owned MaybeUninit drops on the ? arm.\n panic!(\"rejecting child reached a later write\")\n}\n#[kani::proof] #[kani::unwind(6)]\nfn LPn_abort(){\n let raw:[u8;928]=kani::any();let prior:[[QM31;29];2]=unsafe{core::mem::transmute(raw)};\n let p:usize=kani::any();kani::assume(p<3);let row:u8=kani::any();let value:usize=kani::any();kani::assume(value<116);\n match abort_after_prefix(p,prior,row,value){\n  Err(Error::NonCanonical{row:r,value:v})=>{assert_eq!(r,row);assert_eq!(v,value);},\n  Err(Error::Allocation)=>(),_=>panic!(\"wrong error suffix\")\n }\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPn_decode.rs", "exists": true, "sha256": "fbc4b39bbd46bb8418a22ee39a864d3c9bf472625fd9cc9fecdb08a97c6eb737", "text": "use super::*;\n#[kani::proof] #[kani::unwind(10)]\nfn LPn_iterator(){\n let b:[u8;3717]=kani::any();\n let len:usize=kani::any();kani::assume(5<=len&&len<=3717);\n let record=ValidatedRecord{row:25,framed:&b[..len]};\n let n:usize=kani::any();kani::assume(n==1||n==28||n==29);\n let off:usize=kani::any();kani::assume(off<=116&&32*(off+n)<=len-5);\n let i:usize=kani::any();kani::assume(i<=n);\n let payload=record.payload();assert!(core::ptr::eq(payload.as_ptr(),b[5..].as_ptr()));\n let selected=&payload[32*off..32*(off+n)];\n let mut it=selected.chunks_exact(32).enumerate();\n if i>0 {let (j,_)=it.nth(i-1).unwrap();assert_eq!(j,i-1);}\n assert_eq!(it.len(),n-i);\n match it.next(){None=>assert_eq!(i,n),Some((value,part))=>{\n  assert!(i<n);assert_eq!(value,i);assert_eq!(part.len(),32);\n  assert!(core::ptr::eq(part.as_ptr(),b[5+32*(off+i)..].as_ptr()));\n  assert_eq!(it.len(),n-i-1);assert!(off+value<116);\n }}\n}\nfn le(b:&[u8])->u64{u64::from(b[0])+256*(u64::from(b[1])+256*(u64::from(b[2])+256*u64::from(b[3])))}\n#[kani::proof] #[kani::unwind(10)]\nfn LPn_decoder(){\n let b:[u8;32]=kani::any();let row:u8=kani::any();\n let off:usize=kani::any();let i:usize=kani::any();kani::assume(off<=116&&i<29);kani::assume(off+i<116);\n let actual=QM31::from_le_bytes(&b[..16]).ok_or(Error::NonCanonical{row,value:off+i});\n let words=[le(&b[0..4]),le(&b[4..8]),le(&b[8..12]),le(&b[12..16])];\n let good=words.iter().all(|w|*w<2147483647);\n match actual { Ok(q)=>{assert!(good);assert_eq!(q.c0.a.0 as u64,words[0]);assert_eq!(q.c0.b.0 as u64,words[1]);assert_eq!(q.c1.a.0 as u64,words[2]);assert_eq!(q.c1.b.0 as u64,words[3]);},\n Err(e)=>{assert!(!good);assert_eq!(e,Error::NonCanonical{row,value:off+i});}}\n}\n#[kani::proof] #[kani::unwind(10)]\nfn LPn_guard(){\n let row:u8=kani::any();let off:usize=kani::any();\n let b:[u8;37]=kani::any();\n // This actual N29 call can only reject on this small carrier. It checks\n // all offset overflow cases and row precedence without any source iteration.\n let got=ValidatedRecord{row,framed:&b}.decode_k::<29>(off);\n assert_eq!(got,Err(if row<14{Error::InvalidRow}else{Error::Length{row}}));\n}\n#[kani::proof] #[kani::unwind(10)]\nfn LPn_scalar(){\n let b:[u8;3717]=kani::any();let len:usize=kani::any();kani::assume(5<=len&&len<=3717);\n let row:u8=kani::any();let off:usize=kani::any();let n:usize=kani::any();kani::assume(n==1||n==28||n==29);\n let native=(||->Result<(),Error>{\n  if row<14{return Err(Error::InvalidRow);}\n  let byte_offset=off.checked_mul(32).ok_or(Error::Length{row})?;\n  let byte_len=n.checked_mul(32).ok_or(Error::Length{row})?;\n  let end=byte_offset.checked_add(byte_len).ok_or(Error::Length{row})?;\n  let _bytes=ValidatedRecord{row,framed:&b[..len]}.payload().get(byte_offset..end).ok_or(Error::Length{row})?;\n  Ok(())\n })();\n let fit=(off as u128)*32+(n as u128)*32<=(len-5) as u128;\n assert_eq!(native,if row<14{Err(Error::InvalidRow)}else if fit{Ok(())}else{Err(Error::Length{row})});\n}\nfn arbitrary_q()->QM31{\n use aspis_core::field::{CM31,M31};\n let a:u32=kani::any();let b:u32=kani::any();let c:u32=kani::any();let d:u32=kani::any();\n // No canonicality restriction: only copying/storing the valid u32 representation.\n QM31{c0:CM31{a:M31(a),b:M31(b)},c1:CM31{a:M31(c),b:M31(d)}}\n}\n#[kani::proof] #[kani::unwind(10)]\nfn LPn_typed_write(){\n let b:[u8;37]=kani::any();let row:u8=kani::any();kani::assume(row>=14);\n let mut out=[arbitrary_q(),arbitrary_q(),arbitrary_q()];\n let j:usize=kani::any();kani::assume(j<3);let old=out[j];\n let got=ValidatedRecord{row,framed:&b}.decode_k::<1>(0);\n let expected=QM31::from_le_bytes(&b[5..21]);\n match(got,expected){\n  (Ok([q]),Some(v))=>{out[1]=q;eq_q(q,v);eq_q(out[j],if j==1{v}else{old});},\n  (Err(e),None)=>{assert_eq!(e,Error::NonCanonical{row,value:0});eq_q(out[j],old);},\n  _=>panic!(\"typed write source decoder disagreement\")\n }\n}\n\nfn eq_q(a:QM31,b:QM31){assert_eq!(a.c0.a.0,b.c0.a.0);assert_eq!(a.c0.b.0,b.c0.b.0);assert_eq!(a.c1.a.0,b.c1.a.0);assert_eq!(a.c1.b.0,b.c1.b.0);}\n\n#[kani::proof] #[kani::unwind(10)]\nfn LPn_token(){\n let b:[u8;32]=kani::any();let row:u8=kani::any();\n let records:[&[u8];27]=[&b[0..], &b[1..], &b[2..], &b[3..], &b[4..], &b[5..], &b[6..], &b[7..], &b[8..], &b[9..], &b[10..], &b[11..], &b[12..], &b[13..], &b[14..], &b[15..], &b[16..], &b[17..], &b[18..], &b[19..], &b[20..], &b[21..], &b[22..], &b[23..], &b[24..], &b[25..], &b[26..]];\n let p=Prefix{c1_root:&[0u8;32],records};\n match p.validated_record(row){\n  Err(e)=>{assert!(row>=27);assert_eq!(e,Error::InvalidRow);},\n  Ok(t)=>{assert!(row<27);assert_eq!(t.row(),row);assert_eq!(t.framed().len(),records[row as usize].len());assert!(core::ptr::eq(t.framed().as_ptr(),records[row as usize].as_ptr()));}\n }\n}\n#[kani::proof] #[kani::unwind(10)]\nfn LPn_nonvacuity(){\n let mut b=[0u8;37];let high:[u8;16]=kani::any();b[21..].copy_from_slice(&high);\n let got=ValidatedRecord{row:25,framed:&b}.decode_k::<1>(0).unwrap();eq_q(got[0],QM31::ZERO);\n b[5]=255;b[6]=255;b[7]=255;b[8]=127;\n assert_eq!(ValidatedRecord{row:25,framed:&b}.decode_k::<1>(0),Err(Error::NonCanonical{row:25,value:0}));\n assert_eq!(ValidatedRecord{row:0,framed:&b}.decode_k::<1>(usize::MAX),Err(Error::InvalidRow));\n assert_eq!(ValidatedRecord{row:25,framed:&b}.decode_k::<1>(usize::MAX),Err(Error::Length{row:25}));\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPn_dot.rs", "exists": true, "sha256": "e63e49b95c868606c20626fd100ed935e47d0087d39d27c51aec1df25cf9d1f2", "text": "use super::*;\n#[kani::proof] #[kani::unwind(10)]\nfn LPn_producers(){\n let words:[u32;4]=kani::any();\n let good=words[0]<canonical::P&&words[1]<canonical::P&&words[2]<canonical::P&&words[3]<canonical::P;\n match canonical::Q::from_limbs(words){None=>assert!(!good),Some(q)=>{\n  assert!(good);let got=q.limbs();for i in 0..4{assert_eq!(got[i],words[i]);assert!(got[i]<canonical::P);}\n }}\n let x=QM31{c0:CM31{a:aspis_core::field::M31(words[0]),b:aspis_core::field::M31(words[1])},c1:CM31{a:aspis_core::field::M31(words[2]),b:aspis_core::field::M31(words[3])}};\n match checked_q(x){Err(())=>assert!(!good),Ok(q)=>{assert!(good);let got=q.limbs();for i in 0..4{assert_eq!(got[i],words[i]);}}}\n let wide:[u32;8]=kani::any();\n if let Some(e)=E::from_limbs(wide){\n  let pair=canonical::Q::from_wide(e);\n  for i in 0..4{assert_eq!(pair[0].limbs()[i],wide[i]);assert_eq!(pair[1].limbs()[i],wide[4+i]);assert!(pair[0].limbs()[i]<canonical::P);assert!(pair[1].limbs()[i]<canonical::P);}\n }\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPn_expand.rs", "exists": true, "sha256": "e8440664d5920c3beeca12af82418a10f81c1946838a9ca2650cdd240668ad9d", "text": "use super::*;\n// One reached iteration. Prefix: 0/32/64; suffix: any length that fits96.\n// Initial bytes, source bytes and the observed frame byte are unconstrained.\n#[kani::proof]\n#[kani::unwind(18)]\nfn LPn_step_frame() {\n    let source: [u8;16] = kani::any();\n    let mut backing: [u8;96] = kani::any();\n    let slot: usize = kani::any(); kani::assume(slot < 3);\n    let at = 32 * slot;\n    let end: usize = kani::any(); kani::assume(at+32 <= end && end <= 96);\n    let j: usize = kani::any(); kani::assume(j < end);\n    let old = backing[j];\n    let base = backing.as_mut_ptr();\n    let window = &mut backing[..end][at..at+32];\n    assert!(core::ptr::eq(window.as_ptr(),base.wrapping_add(at)));\n    assert_eq!(window.len(),32);\n    assert_eq!(expand_values(&source,window),Ok(()));\n    assert_eq!(backing[j],if at<=j && j<at+16 { source[j-at] }\n        else if at+16<=j && j<at+32 { 0 } else { old });\n    assert!(core::ptr::eq(backing.as_ptr(),base));\n}\n// Scalar source guard only; no buffer loop, matching compact.rs:128.\n#[kani::proof]\nfn LPn_guard() {\n    let n: usize = kani::any(); let m: usize = kani::any();\n    kani::assume(n<=1856 && m<=3712);\n    let reject = n%16 != 0 || m != 2*n;\n    assert_eq!(reject, !(n%16==0 && m==2*n));\n    if !reject { assert_eq!(m/32,n/16); assert_eq!(m%32,0); assert!(n/16<=116); }\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPo_candidate.rs", "exists": true, "sha256": "355df66f9f8f0ef6e4d4ceb34b76b70eb5d5bf612e5d0672c0bd13a81617b41b", "text": "use super::*;\n// One selected observation of the actual native call, not a whole-buffer comparison.\nfn range<const PART: usize>() {\n    let p: [u8; compact::PROOF_BYTES] = kani::any();\n    let semantic: [u8; compact::LOGICAL_SEMANTIC] = kani::any();\n    let y1: [u8; compact::LOGICAL_Y1] = kani::any();\n    let sem_len: usize = kani::any(); let y_len: usize = kani::any();\n    kani::assume(sem_len <= semantic.len() && y_len <= y1.len());\n    let s = &semantic[..sem_len]; let y = &y1[..y_len];\n    let sp = s.as_ptr(); let yp = y.as_ptr();\n    let inactive = E::from_le_bytes(&p[compact::OFF_INACTIVE..compact::OFF_ROUND0]);\n    let got = wide_view(&p, s, y);\n    match (got, inactive) {\n        (Err(e), None) => assert_eq!(e, Error::Parse),\n        (Ok(v), Some(e)) => {\n            if PART == 0 { assert_eq!(v.inactive, e); assert!(matches!(v.variant, Variant::S2)); assert_eq!(v.query_bytes.len(), 0); }\n            if PART == 1 { assert_eq!(v.round0.len(), 224); assert!(core::ptr::eq(v.round0.as_ptr(), p[7527..7751].as_ptr())); }\n            if PART == 2 { let r = v.folded_root.unwrap(); let i: usize = kani::any(); kani::assume(i < 32); assert_eq!(r[i], p[7751+i]); }\n            if PART == 3 { assert_eq!(v.round1.len(), 224); assert!(core::ptr::eq(v.round1.as_ptr(), p[7783..8007].as_ptr())); }\n            if PART == 4 { assert_eq!(v.final_message.len(), 2048); assert!(core::ptr::eq(v.final_message.as_ptr(), p[8007..10055].as_ptr())); }\n            if PART == 5 { assert_eq!(v.semantic.len(), sem_len); assert_eq!(v.y1.len(), y_len); assert!(core::ptr::eq(v.semantic.as_ptr(), sp)); assert!(core::ptr::eq(v.y1.as_ptr(), yp)); }\n        }\n        _ => panic!(\"native inactive/result mismatch\"),\n    }\n}\n#[kani::proof] #[kani::unwind(10)] fn LPo_inactive() { range::<0>(); }\n#[kani::proof] #[kani::unwind(10)] fn LPo_round0() { range::<1>(); }\n#[kani::proof] #[kani::unwind(10)] fn LPo_root() { range::<2>(); }\n#[kani::proof] #[kani::unwind(10)] fn LPo_round1() { range::<3>(); }\n#[kani::proof] #[kani::unwind(10)] fn LPo_final() { range::<4>(); }\n#[kani::proof] #[kani::unwind(10)] fn LPo_passthrough() { range::<5>(); }\n\n// Unconstrained return abstraction, not an arithmetic contract: every bit-pattern\n// of the returned value is covered. No assumed equality or canonicality.\nfn LPo_any_inactive(_: &[u8]) -> Option<E> {\n    if kani::any() { None } else {\n        let words: [u32; 8] = kani::any();\n        Some(unsafe { core::mem::transmute::<[u32; 8], E>(words) })\n    }\n}\nfn readset<const PART: usize>() {\n    let p: [u8; compact::PROOF_BYTES] = kani::any();\n    let semantic: [u8; compact::LOGICAL_SEMANTIC] = kani::any();\n    let y1: [u8; compact::LOGICAL_Y1] = kani::any();\n    let sn: usize = kani::any(); let yn: usize = kani::any();\n    kani::assume(sn <= semantic.len() && yn <= y1.len());\n    let s = &semantic[..sn]; let y = &y1[..yn]; let sp=s.as_ptr();let yp=y.as_ptr();\n    match wide_view(&p,s,y) {\n        Err(e) => assert_eq!(e,Error::Parse),\n        Ok(v) => {\n            if PART==0 {assert!(matches!(v.variant,Variant::S2));assert_eq!(v.query_bytes.len(),0);}\n            if PART==1 {assert_eq!(v.round0.len(),224);assert!(core::ptr::eq(v.round0.as_ptr(),p[7527..7751].as_ptr()));}\n            if PART==2 {let i:usize=kani::any();kani::assume(i<32);assert_eq!(v.folded_root.unwrap()[i],p[7751+i]);}\n            if PART==3 {assert_eq!(v.round1.len(),224);assert!(core::ptr::eq(v.round1.as_ptr(),p[7783..8007].as_ptr()));}\n            if PART==4 {assert_eq!(v.final_message.len(),2048);assert!(core::ptr::eq(v.final_message.as_ptr(),p[8007..10055].as_ptr()));}\n            if PART==5 {assert_eq!(v.semantic.len(),sn);assert_eq!(v.y1.len(),yn);assert!(core::ptr::eq(v.semantic.as_ptr(),sp));assert!(core::ptr::eq(v.y1.as_ptr(),yp));}\n        }\n    }\n}\n#[kani::proof] #[kani::unwind(2)] #[kani::stub(E::from_le_bytes, LPo_any_inactive)] fn LPo_read_header(){readset::<0>()}\n#[kani::proof] #[kani::unwind(2)] #[kani::stub(E::from_le_bytes, LPo_any_inactive)] fn LPo_read_round0(){readset::<1>()}\n#[kani::proof] #[kani::unwind(2)] #[kani::stub(E::from_le_bytes, LPo_any_inactive)] fn LPo_read_root(){readset::<2>()}\n#[kani::proof] #[kani::unwind(2)] #[kani::stub(E::from_le_bytes, LPo_any_inactive)] fn LPo_read_round1(){readset::<3>()}\n#[kani::proof] #[kani::unwind(2)] #[kani::stub(E::from_le_bytes, LPo_any_inactive)] fn LPo_read_final(){readset::<4>()}\n#[kani::proof] #[kani::unwind(2)] #[kani::stub(E::from_le_bytes, LPo_any_inactive)] fn LPo_read_passthrough(){readset::<5>()}\n\n#[kani::proof] #[kani::unwind(10)]\nfn LPo_decode_words() {\n    let b:[u8;32]=kani::any();\n    let w:[u32;8]=core::array::from_fn(|i| u32::from_le_bytes(b[4*i..4*i+4].try_into().unwrap()));\n    let actual=E::from_le_bytes(&b);\n    let valid=w.iter().all(|&x| x<2147483647);\n    match actual {\n        None=>assert!(!valid),\n        Some(e)=>{assert!(valid);let out=e.to_limbs();let i:usize=kani::any();kani::assume(i<8);assert_eq!(out[i],w[i]);}\n    }\n}\nfn LPo_raw_inactive(b:&[u8])->Option<E> {\n    Some(unsafe{core::mem::transmute::<[u8;32],E>(b.try_into().unwrap())})\n}\n#[kani::proof] #[kani::unwind(2)] #[kani::stub(E::from_le_bytes, LPo_raw_inactive)]\nfn LPo_inactive_copy() {\n    let p:[u8;compact::PROOF_BYTES]=kani::any();let s:[u8;1]=kani::any();let y:[u8;1]=kani::any();\n    let expected=LPo_raw_inactive(&p[7495..7527]).unwrap();\n    let v=wide_view(&p,&s,&y).unwrap();assert_eq!(v.inactive,expected);\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPo_semantic.rs", "exists": true, "sha256": "eee2dc94a34d6f3d3ce3eaa3b07a2ff34e4fda429f7580f34b9702ebfb02dae9", "text": "use super::*;\n#[kani::proof] #[kani::unwind(2)]\nfn LPo_boundary_iteration() {\n    let words:[u32;112]=kani::any();\n    let polynomial:[QM31;28]=unsafe{core::mem::transmute(words)};\n    let i:usize=kani::any();kani::assume(i<28);\n    let aw:[u32;4]=kani::any();\n    let a:QM31=unsafe{core::mem::transmute(aw)};\n    let q=polynomial[i];\n    let qw=[q.c0.a.0,q.c0.b.0,q.c1.a.0,q.c1.b.0];\n    kani::assume(aw[0]<2147483647&&aw[1]<2147483647&&aw[2]<2147483647&&aw[3]<2147483647);\n    kani::assume(qw[0]<2147483647&&qw[1]<2147483647&&qw[2]<2147483647&&qw[3]<2147483647);\n    let mut iterator=polynomial[i..].iter().copied();let n=iterator.len();\n    let c=iterator.next().unwrap();assert_eq!(iterator.len()+1,n);assert_eq!(c,q);\n    let result=a.add(c);let folded=polynomial[i..i+1].iter().copied().fold(a,QM31::add);assert_eq!(folded,result);let out=[result.c0.a.0,result.c0.b.0,result.c1.a.0,result.c1.b.0];\n    let j:usize=kani::any();kani::assume(j<4);\n    let sum=u64::from(aw[j])+u64::from(qw[j]);\n    let expected=if sum>=2147483647{sum-2147483647}else{sum};\n    assert_eq!(u64::from(out[j]),expected);assert!(out[j]<2147483647);\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-14-20261027/LPp_src/Cargo.toml", "exists": true, "sha256": "3de458ef315222e2ac6facb0ca39f24286ab3bb6ed103eebc2c87a02761bd23e", "text": "[workspace]\nmembers = [\n    \"crates/aspis-core\",\n    \"crates/aspis-r1-cost-probe\",\n    \"crates/aspis-prover\",\n    \"crates/aspis-statement\",\n    \"programs/aspis-pool\",\n    \"programs/aspis-registry\",\n    \"programs/aspis-verifier\",\n    \"programs/r1-cost-probe\",\n    \"audit/poseidon-pair-probe/program\",\n    \"xtask\",\n    # Extracted builder copies (D68.2): the shipped pair-forest trace writers.\n    # Their src/lib.rs files are the pinned extraction inputs; keep them byte-identical.\n    \"docs/research/v8-r0-zk-20261009/refine/writers\",\n    \"docs/research/v8-r0-zk-20261009/refine/blockwriters\",\n    \"docs/research/v8-r0-zk-20261009/refine/poseidon\",\n]\n# The research probes under docs/ are standalone crates with their own\n# [workspace]; the R1 cost probe uses the z4 probe library only behind its\n# `r1p-check` feature (LOG D38.3).\nexclude = [\"docs\"]\nresolver = \"2\"\n\n[workspace.package]\nedition = \"2021\"\nlicense = \"MIT OR Apache-2.0\"\nversion = \"0.1.0\"\n\n[workspace.dependencies]\nhkdf = \"0.12.4\"\nhpke = { version = \"=0.14.0\", default-features = false, features = [\"alloc\", \"chacha\", \"x25519\"] }\naspis-core = { path = \"crates/aspis-core\" }\naspis-prover = { path = \"crates/aspis-prover\" }\naspis-statement = { path = \"crates/aspis-statement\" }\naspis-verifier = { path = \"programs/aspis-verifier\", default-features = false, features = [\"no-entrypoint\"] }\nanyhow = \"1.0.100\"\nbase64 = \"0.22.1\"\nbincode = \"1.3.3\"\nborsh = { version = \"=1.5.7\", features = [\"derive\"] }\nchrono = { version = \"0.4.42\", default-features = false, features = [\"clock\", \"serde\", \"std\"] }\nchacha20poly1305 = { version = \"=0.11.0\", default-features = false, features = [\"zeroize\"] }\ngetrandom = \"0.3.4\"\nreqwest = { version = \"0.12.28\", default-features = false, features = [\"blocking\", \"json\", \"rustls-tls\"] }\nserde = { version = \"1.0.228\", features = [\"derive\"] }\nserde_json = \"1.0.145\"\nsha2 = \"0.10.8\"\nsolana-program = \"2.3.0\"\nsolana-loader-v3-interface = { version = \"5.0.0\", features = [\"bincode\"] }\nsolana-sdk = \"2.3.0\"\nsolana-system-interface = { version = \"1.0.0\", features = [\"bincode\"] }\nzeroize = \"1.8.1\"\nx25519-dalek = { version = \"=3.0.0\", default-features = false, features = [\"zeroize\"] }\n\n# The extracted P_R1 checker and builders are modelled with checked arithmetic\n# (an overflow is a failure, D57.1): keep overflow checks in optimized builds.\n[profile.release.package.aspis-r1-cert-check]\noverflow-checks = true\n\n[profile.release.package.aspis-r1-cert-build]\noverflow-checks = true\n"}
