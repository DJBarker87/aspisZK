q!(statement_public_common(&s),(pool,deployment,seq,anchor,n,asset));\n    let byte: u8 = kani::any();\n    assert_eq!(transition_kind(byte),match byte { 1=>Ok(PoolV1TransitionKind::PrivateTransfer),2=>Ok(PoolV1TransitionKind::Withdrawal),_=>Err(PoolV1PairForestTerminalFormatErrorV1::InvalidTransitionKind) });\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-native-tx2c-20261027/NBG_src/Cargo.toml", "exists": true, "sha256": "3de458ef315222e2ac6facb0ca39f24286ab3bb6ed103eebc2c87a02761bd23e", "text": "[workspace]\nmembers = [\n    \"crates/aspis-core\",\n    \"crates/aspis-r1-cost-probe\",\n    \"crates/aspis-prover\",\n    \"crates/aspis-statement\",\n    \"programs/aspis-pool\",\n    \"programs/aspis-registry\",\n    \"programs/aspis-verifier\",\n    \"programs/r1-cost-probe\",\n    \"audit/poseidon-pair-probe/program\",\n    \"xtask\",\n    # Extracted builder copies (D68.2): the shipped pair-forest trace writers.\n    # Their src/lib.rs files are the pinned extraction inputs; keep them byte-identical.\n    \"docs/research/v8-r0-zk-20261009/refine/writers\",\n    \"docs/research/v8-r0-zk-20261009/refine/blockwriters\",\n    \"docs/research/v8-r0-zk-20261009/refine/poseidon\",\n]\n# The research probes under docs/ are standalone crates with their own\n# [workspace]; the R1 cost probe uses the z4 probe library only behind its\n# `r1p-check` feature (LOG D38.3).\nexclude = [\"docs\"]\nresolver = \"2\"\n\n[workspace.package]\nedition = \"2021\"\nlicense = \"MIT OR Apache-2.0\"\nversion = \"0.1.0\"\n\n[workspace.dependencies]\nhkdf = \"0.12.4\"\nhpke = { version = \"=0.14.0\", default-features = false, features = [\"alloc\", \"chacha\", \"x25519\"] }\naspis-core = { path = \"crates/aspis-core\" }\naspis-prover = { path = \"crates/aspis-prover\" }\naspis-statement = { path = \"crates/aspis-statement\" }\naspis-verifier = { path = \"programs/aspis-verifier\", default-features = false, features = [\"no-entrypoint\"] }\nanyhow = \"1.0.100\"\nbase64 = \"0.22.1\"\nbincode = \"1.3.3\"\nborsh = { version = \"=1.5.7\", features = [\"derive\"] }\nchrono = { version = \"0.4.42\", default-features = false, features = [\"clock\", \"serde\", \"std\"] }\nchacha20poly1305 = { version = \"=0.11.0\", default-features = false, features = [\"zeroize\"] }\ngetrandom = \"0.3.4\"\nreqwest = { version = \"0.12.28\", default-features = false, features = [\"blocking\", \"json\", \"rustls-tls\"] }\nserde = { version = \"1.0.228\", features = [\"derive\"] }\nserde_json = \"1.0.145\"\nsha2 = \"0.10.8\"\nsolana-program = \"2.3.0\"\nsolana-loader-v3-interface = { version = \"5.0.0\", features = [\"bincode\"] }\nsolana-sdk = \"2.3.0\"\nsolana-system-interface = { version = \"1.0.0\", features = [\"bincode\"] }\nzeroize = \"1.8.1\"\nx25519-dalek = { version = \"=3.0.0\", default-features = false, features = [\"zeroize\"] }\n\n# The extracted P_R1 checker and builders are modelled with checked arithmetic\n# (an overflow is a failure, D57.1): keep overflow checks in optimized builds.\n[profile.release.package.aspis-r1-cert-check]\noverflow-checks = true\n\n[profile.release.package.aspis-r1-cert-build]\noverflow-checks = true\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-native-tx2c-20261027/NBG_src/crates/aspis-core/src/field/NBG_runtime.rs", "exists": true, "sha256": "321bdf67cea1810f9c7e4b199656a0ec4306e9f8e22ae7251d91a7f24632f939", "text": "use super::*;\nfn any_m() -> M31 { let x:u32=kani::any(); kani::assume(x<P); M31(x) }\nfn any_c() -> CM31 { CM31::new(any_m(),any_m()) }\nfn any_q() -> QM31 { QM31{c0:any_c(),c1:any_c()} }\nfn add(a:u32,b:u32)->u32 {let s=a as u64+b as u64; (if s>=P as u64{s-P as u64}else{s}) as u32}\nfn sub(a:u32,b:u32)->u32 {let s=a as u64+P as u64-b as u64; (if s>=P as u64{s-P as u64}else{s}) as u32}\n#[kani::proof]\nfn NBG_m31_add_sub_double() {\n let x=any_m();let y=any_m();\n assert!(x.add(y).0==add(x.0,y.0));\n assert!(x.sub(y).0==sub(x.0,y.0));\n assert!(x.double().0==add(x.0,x.0));\n assert!(x.add(y).0<P && x.sub(y).0<P && x.double().0<P);\n kani::cover!(x.0==P-1 && y.0==0);\n}\n#[kani::proof]\nfn NBG_cm_add_sub_double_r() {\n let x=any_c();let y=any_c();\n let a=x.add(y);let b=x.sub(y);let d=x.double();let r=super::mul_by_r(x);\n assert!(a.a.0==add(x.a.0,y.a.0) && a.b.0==add(x.b.0,y.b.0));\n assert!(b.a.0==sub(x.a.0,y.a.0) && b.b.0==sub(x.b.0,y.b.0));\n assert!(d.a.0==add(x.a.0,x.a.0) && d.b.0==add(x.b.0,x.b.0));\n assert!(r.a.0==sub(add(x.a.0,x.a.0),x.b.0));\n assert!(r.b.0==add(x.a.0,add(x.b.0,x.b.0)));\n kani::cover!(x.a.0==P-1);\n}\n#[kani::proof]\nfn NBG_qm_add_sub() {\n let x=any_q();let y=any_q();let a=x.add(y);let b=x.sub(y);\n assert!(a.c0.a.0==add(x.c0.a.0,y.c0.a.0) && a.c0.b.0==add(x.c0.b.0,y.c0.b.0));\n assert!(a.c1.a.0==add(x.c1.a.0,y.c1.a.0) && a.c1.b.0==add(x.c1.b.0,y.c1.b.0));\n assert!(b.c0.a.0==sub(x.c0.a.0,y.c0.a.0) && b.c0.b.0==sub(x.c0.b.0,y.c0.b.0));\n assert!(b.c1.a.0==sub(x.c1.a.0,y.c1.a.0) && b.c1.b.0==sub(x.c1.b.0,y.c1.b.0));\n kani::cover!(x.c1.b.0==P-1);\n}\n#[kani::proof]\nfn NBG_m31_bytes() {\n let b:[u8;4]=kani::any();let w=u32::from_le_bytes(b);\n let out=M31::from_le_bytes(b);\n match out {None=>assert!(w>=P),Some(x)=>{assert!(w<P);assert!(x.0==w);}}\n let x:u32=kani::any(); let bytes=M31(x).to_le_bytes();\n let i:usize=kani::any();kani::assume(i<4);\n assert!(bytes[i]==((x>>(8*i))&255) as u8);\n kani::cover!(w==P);\n}\n#[kani::proof]\nfn NBG_cm_bytes() {\n let b:[u8;8]=kani::any();let a=u32::from_le_bytes([b[0],b[1],b[2],b[3]]);let c=u32::from_le_bytes([b[4],b[5],b[6],b[7]]);\n match CM31::from_le_bytes(&b) { None=>assert!(a>=P || c>=P),Some(x)=>{assert!(a<P && c<P);assert!(x.a.0==a && x.b.0==c);}}\n let x=CM31{a:M31(kani::any()),b:M31(kani::any())};let mut out:[u8;8]=kani::any();x.write_le_bytes(&mut out);\n let i:usize=kani::any();kani::assume(i<8);let word=if i<4{x.a.0}else{x.b.0};assert!(out[i]==((word>>(8*(i%4)))&255) as u8);\n kani::cover!(a==P && c==0);\n}\n#[kani::proof]\nfn NBG_qm_bytes() {\n let b:[u8;16]=kani::any();let a=u32::from_le_bytes([b[0],b[1],b[2],b[3]]);let c=u32::from_le_bytes([b[4],b[5],b[6],b[7]]);let d=u32::from_le_bytes([b[8],b[9],b[10],b[11]]);let e=u32::from_le_bytes([b[12],b[13],b[14],b[15]]);\n match QM31::from_le_bytes(&b) { None=>assert!(a>=P || c>=P || d>=P || e>=P),Some(x)=>{assert!(a<P && c<P && d<P && e<P);assert!(x.c0.a.0==a && x.c0.b.0==c && x.c1.a.0==d && x.c1.b.0==e);}}\n let x=QM31{c0:CM31{a:M31(kani::any()),b:M31(kani::any())},c1:CM31{a:M31(kani::any()),b:M31(kani::any())}};let mut out:[u8;16]=kani::any();x.write_le_bytes(&mut out);\n let words=[x.c0.a.0,x.c0.b.0,x.c1.a.0,x.c1.b.0];let i:usize=kani::any();kani::assume(i<16);assert!(out[i]==((words[i/4]>>(8*(i%4)))&255) as u8);\n kani::cover!(a==P);\n}\n#[kani::proof]\nfn NBG_constructors() {\n let a=M31(kani::any());let b=M31(kani::any());let c=CM31::new(a,b);\n assert!(c.a.0==a.0 && c.b.0==b.0);\n let q=QM31::from_cm31(c);assert!(q.c0.a.0==a.0 && q.c0.b.0==b.0);assert!(q.c1.a.0==0 && q.c1.b.0==0);\n kani::cover!(a.0==u32::MAX);\n}\n\n#[kani::proof]\nfn NBG_reduce_all_u64(){\n let x:u64=kani::any();let p=super::P as u64;\n let first=((x as u128)&(p as u128))+((x as u128)>>31);\n let second=(first&(p as u128))+(first>>31);\n assert!(first<=u64::MAX as u128 && second<=p as u128+3);\n let expected=if second>=p as u128{second-p as u128}else{second};\n assert!(super::reduce_u64(x)as u128==expected);\n assert!(super::M31::reduce_u64(x).0 as u128==expected);\n assert!(expected<p as u128);\n kani::cover!(x==u64::MAX);\n}\n\nstatic mut NBG_PRODUCT:u32=0;\nstatic mut NBG_MUL_CALLS:usize=0;\nfn NBG_product(x:super::M31,y:super::M31)->super::M31{\n let r:u32=kani::any();\n kani::assume(r<super::P);\n kani::assume((r as u64)==((x.0 as u64)*(y.0 as u64))%(super::P as u64));\n unsafe{NBG_PRODUCT=r;NBG_MUL_CALLS+=1;}\n super::M31(r)\n}\n#[kani::proof]\n#[kani::stub(super::M31::mul,NBG_product)]\nfn NBG_square_iteration(){\n let start:usize=kani::any();let end:usize=kani::any();let mut iter=start..end;\n let mut value=super::M31(kani::any());\n unsafe{NBG_MUL_CALLS=0;}\n let next=iter.next();\n if start<end{\n  assert!(next==Some(start));assert!(iter.start==start+1&&iter.end==end);\n  value=value.mul(value);\n  unsafe{assert!(value.0==NBG_PRODUCT);assert!(NBG_MUL_CALLS==1);}\n  assert!(value.0<super::P);\n }else{assert!(next.is_none());assert!(iter.start==start&&iter.end==end);unsafe{assert!(NBG_MUL_CALLS==0);}}\n kani::cover!(start==0&&end==1&&value.0==0);\n}\n\n#[kani::proof]\nfn NBG_scalar_embedding(){\n use crate::r0::scalar::CodeField;\n let raw:u32=kani::any();let out=<super::WideExact as CodeField>::from_m31(super::M31(raw));\n assert!(out.c0().c0.a.0==raw%super::P);\n assert!(out.c0().c0.b.0==0&&out.c0().c1.a.0==0&&out.c0().c1.b.0==0);\n assert!(out.c1().c0.a.0==0&&out.c1().c0.b.0==0&&out.c1().c1.a.0==0&&out.c1().c1.b.0==0);\n kani::cover!(raw==u32::MAX);\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-native-tx2c-20261027/NBG_src/crates/aspis-core/src/field/wide_exact/NBG_runtime.rs", "exists": true, "sha256": "b0e8cdd8a33a940c03171387353d62121f176558215f770ca2d092f677fac0db", "text": "use super::*;\nfn q(w:[u32;4])->QM31{QM31{c0:CM31{a:M31(w[0]),b:M31(w[1])},c1:CM31{a:M31(w[2]),b:M31(w[3])}}}\nfn words(x:WideExact)->[u32;8]{[x.c0.c0.a.0,x.c0.c0.b.0,x.c0.c1.a.0,x.c0.c1.b.0,x.c1.c0.a.0,x.c1.c0.b.0,x.c1.c1.a.0,x.c1.c1.b.0]}\nfn canon(w:[u32;8])->bool{w[0]<P&&w[1]<P&&w[2]<P&&w[3]<P&&w[4]<P&&w[5]<P&&w[6]<P&&w[7]<P}\n#[kani::proof]\nfn NBG_limbs(){\n let w:[u32;8]=kani::any();let i:usize=kani::any();kani::assume(i<8);\n match WideExact::from_limbs(w){None=>assert!(!canon(w)),Some(x)=>{assert!(canon(w));assert!(words(x)[i]==w[i]);assert!(x.to_limbs()[i]==w[i]);}}\n kani::cover!(w[7]==P);\n}\n#[kani::proof]\nfn NBG_wide_constructors(){\n let w:[u32;8]=kani::any();let i:usize=kani::any();kani::assume(i<8);\n let a=q([w[0],w[1],w[2],w[3]]);let b=q([w[4],w[5],w[6],w[7]]);\n let x=WideExact::new(a,b);assert!(words(x)[i]==w[i]%P);\n let y=WideExact::from_qm31(a);assert!(words(y)[i]==if i<4{w[i]%P}else{0});\n let c=super::canonical_qm31(a);let z=WideExact{c0:c,c1:b};\n assert!(z.c0().c0.a.0==c.c0.a.0&&z.c0().c0.b.0==c.c0.b.0&&z.c0().c1.a.0==c.c1.a.0&&z.c0().c1.b.0==c.c1.b.0);\n assert!(z.c1().c0.a.0==b.c0.a.0&&z.c1().c0.b.0==b.c0.b.0&&z.c1().c1.a.0==b.c1.a.0&&z.c1().c1.b.0==b.c1.b.0);\n kani::cover!(w[0]==u32::MAX);\n}\n#[kani::proof]\nfn NBG_wide_add_sub(){\n let a:[u32;8]=kani::any();let b:[u32;8]=kani::any();kani::assume(canon(a)&&canon(b));\n let x=WideExact{c0:q([a[0],a[1],a[2],a[3]]),c1:q([a[4],a[5],a[6],a[7]])};let y=WideExact{c0:q([b[0],b[1],b[2],b[3]]),c1:q([b[4],b[5],b[6],b[7]])};\n let i:usize=kani::any();kani::assume(i<8);let sum=a[i]as u64+b[i]as u64;let diff=a[i]as u64+P as u64-b[i]as u64;\n assert!(words(x.add(y))[i]==(if sum>=P as u64{sum-P as u64}else{sum})as u32);\n assert!(words(x.sub(y))[i]==(if diff>=P as u64{diff-P as u64}else{diff})as u32);\n kani::cover!(i==7&&a[7]==P-1);\n}\n#[kani::proof]\nfn NBG_wide_decode(){\n let b:[u8;33]=kani::any();let n:usize=kani::any();kani::assume(n<=33);\n let out=WideExact::from_le_bytes(&b[..n]);\n if n!=32 {assert!(out.is_none());} else {\n let w=[u32::from_le_bytes([b[0],b[1],b[2],b[3]]),u32::from_le_bytes([b[4],b[5],b[6],b[7]]),u32::from_le_bytes([b[8],b[9],b[10],b[11]]),u32::from_le_bytes([b[12],b[13],b[14],b[15]]),u32::from_le_bytes([b[16],b[17],b[18],b[19]]),u32::from_le_bytes([b[20],b[21],b[22],b[23]]),u32::from_le_bytes([b[24],b[25],b[26],b[27]]),u32::from_le_bytes([b[28],b[29],b[30],b[31]])];\n match out{None=>assert!(!canon(w)),Some(x)=>{assert!(canon(w));let i:usize=kani::any();kani::assume(i<8);assert!(words(x)[i]==w[i]);}}\n }\n kani::cover!(n==33);\n}\n\n#[kani::proof]\nfn NBG_wide_writer_iteration(){\n let mut bytes:[u8;32]=kani::any();let before=bytes;let i:usize=kani::any();kani::assume(i<8);let limb:u32=kani::any();\n // One frozen chunks_exact_mut(4).zip(to_limbs()) iteration, arbitrary frame.\n let chunk=&mut bytes[4*i..4*i+4];chunk.copy_from_slice(&limb.to_le_bytes());\n let j:usize=kani::any();kani::assume(j<32);\n if j>=4*i&&j<4*i+4{assert!(bytes[j]==((limb>>(8*(j-4*i)))&255)as u8)}else{assert!(bytes[j]==before[j]);}\n kani::cover!(i==0&&j==31);\n}\n\n#[kani::proof]\nfn NBG_raw_getters(){\n let w:[u32;8]=kani::any();let i:usize=kani::any();kani::assume(i<8);\n let x=super::WideExact{c0:q([w[0],w[1],w[2],w[3]]),c1:q([w[4],w[5],w[6],w[7]])};\n let a=x.c0();let b=x.c1();let observed=[a.c0.a.0,a.c0.b.0,a.c1.a.0,a.c1.b.0,b.c0.a.0,b.c0.b.0,b.c1.a.0,b.c1.b.0];\n assert!(observed[i]==w[i]);assert!(x.to_limbs()[i]==w[i]);kani::cover!(w[0]==u32::MAX);\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-native-tx2c-20261027/NBG_src/programs/r1-cost-probe/src/NBG_runtime.rs", "exists": true, "sha256": "1c3093bbfae9812df3354feaf47941c946dd6fc5476d77dbff97895e6373ce9f", "text": "use aspis_core::Digest32;\nstatic mut EXPECT_PARTS: *const () = core::ptr::null();\nstatic mut EXPECT_LEN: usize = 0;\nstatic mut REPLY: [u8;32] = [0;32];\nstatic mut CALLS: usize = 0;\nfn runtime_hashv(parts: &[&[u8]]) -> solana_program::hash::Hash {\n    unsafe {\n        assert!(parts.as_ptr().cast::<()>() == EXPECT_PARTS);\n        assert!(parts.len() == EXPECT_LEN);\n        CALLS += 1;\n        solana_program::hash::Hash::new_from_array(REPLY)\n    }\n}\n#[kani::proof]\n#[kani::stub(solana_program::hash::hashv, runtime_hashv)]\nfn NBG_digest_reply() {\n    let a: [u8;32] = kani::any();\n    let b: [u8;32] = kani::any();\n    let n:usize=kani::any(); let m:usize=kani::any();\n    kani::assume(n<=32 && m<=32);\n    let parts: [&[u8];2]=[&a[..n],&b[..m]];\n    let reply: [u8;32]=kani::any();\n    unsafe { EXPECT_PARTS=parts.as_ptr().cast::<()>(); EXPECT_LEN=2; REPLY=reply; CALLS=0; }\n    let out=super::SolanaDigest.digest(&parts);\n    let i:usize=kani::any(); kani::assume(i<32);\n    assert!(out[i]==reply[i]);\n    unsafe {assert!(CALLS==1);}\n    kani::cover!(n==0 && m==32);\n}\n\nstatic mut NBG_EXPECTED_LOG:&str=\"\";\nstatic mut NBG_LOG_INDEX:usize=0;\nstatic mut NBG_LOG_CALLS:usize=0;\nfn NBG_log(message:&str){unsafe{\n assert!(message.len()==NBG_EXPECTED_LOG.len());\n assert!(message.as_bytes()[NBG_LOG_INDEX]==NBG_EXPECTED_LOG.as_bytes()[NBG_LOG_INDEX]);\n NBG_LOG_CALLS+=1;\n}}\n#[kani::proof]\n#[kani::stub(solana_program::log::sol_log,NBG_log)]\nfn NBG_error_log(){\n use aspis_r1_cost_probe::verifier::Error;\n let tag:u8=kani::any();kani::assume(tag<8);\n let (e,s)=match tag{\n 0=>(Error::Parse,\"r1:error:Parse\"),1=>(Error::Semantic,\"r1:error:Semantic\"),\n 2=>(Error::Transcript,\"r1:error:Transcript\"),3=>(Error::Relation,\"r1:error:Relation\"),\n 4=>(Error::Merkle,\"r1:error:Merkle\"),5=>(Error::Query,\"r1:error:Query\"),\n 6=>(Error::Checkpoint,\"r1:error:Checkpoint\"),_=>(Error::Allocation,\"r1:error:Allocation\")};\n let i:usize=kani::any();kani::assume(i<s.len());\n unsafe{NBG_EXPECTED_LOG=s;NBG_LOG_INDEX=i;NBG_LOG_CALLS=0;}\n assert!(super::error(e)==solana_program::program_error::ProgramError::InvalidInstructionData);\n unsafe{assert!(NBG_LOG_CALLS==1);}\n kani::cover!(tag==7);\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-native-tx2d-20261027/NBH_src/Cargo.toml", "exists": true, "sha256": "3de458ef315222e2ac6facb0ca39f24286ab3bb6ed103eebc2c87a02761bd23e", "text": "[workspace]\nmembers = [\n    \"crates/aspis-core\",\n    \"crates/aspis-r1-cost-probe\",\n    \"crates/aspis-prover\",\n    \"crates/aspis-statement\",\n    \"programs/aspis-pool\",\n    \"programs/aspis-registry\",\n    \"programs/aspis-verifier\",\n    \"programs/r1-cost-probe\",\n    \"audit/poseidon-pair-probe/program\",\n    \"xtask\",\n    # Extracted builder copies (D68.2): the shipped pair-forest trace writers.\n    # Their src/lib.rs files are the pinned extraction inputs; keep them byte-identical.\n    \"docs/research/v8-r0-zk-20261009/refine/writers\",\n    \"docs/research/v8-r0-zk-20261009/refine/blockwriters\",\n    \"docs/research/v8-r0-zk-20261009/refine/poseidon\",\n]\n# The research probes under docs/ are standalone crates with their own\n# [workspace]; the R1 cost probe uses the z4 probe library only behind its\n# `r1p-check` feature (LOG D38.3).\nexclude = [\"docs\"]\nresolver = \"2\"\n\n[workspace.package]\nedition = \"2021\"\nlicense = \"MIT OR Apache-2.0\"\nversion = \"0.1.0\"\n\n[workspace.dependencies]\nhkdf = \"0.12.4\"\nhpke = { version = \"=0.14.0\", default-features = false, features = [\"alloc\", \"chacha\", \"x25519\"] }\naspis-core = { path = \"crates/aspis-core\" }\naspis-prover = { path = \"crates/aspis-prover\" }\naspis-statement = { path = \"crates/aspis-statement\" }\naspis-verifier = { path = \"programs/aspis-verifier\", default-features = false, features = [\"no-entrypoint\"] }\nanyhow = \"1.0.100\"\nbase64 = \"0.22.1\"\nbincode = \"1.3.3\"\nborsh = { version = \"=1.5.7\", features = [\"derive\"] }\nchrono = { version = \"0.4.42\", default-features = false, features = [\"clock\", \"serde\", \"std\"] }\nchacha20poly1305 = { version = \"=0.11.0\", default-features = false, features = [\"zeroize\"] }\ngetrandom = \"0.3.4\"\nreqwest = { version = \"0.12.28\", default-features = false, features = [\"blocking\", \"json\", \"rustls-tls\"] }\nserde = { version = \"1.0.228\", features = [\"derive\"] }\nserde_json = \"1.0.145\"\nsha2 = \"0.10.8\"\nsolana-program = \"2.3.0\"\nsolana-loader-v3-interface = { version = \"5.0.0\", features = [\"bincode\"] }\nsolana-sdk = \"2.3.0\"\nsolana-system-interface = { version = \"1.0.0\", features = [\"bincode\"] }\nzeroize = \"1.8.1\"\nx25519-dalek = { version = \"=3.0.0\", default-features = false, features = [\"zeroize\"] }\n\n# The extracted P_R1 checker and builders are modelled with checked arithmetic\n# (an overflow is a failure, D57.1): keep overflow checks in optimized builds.\n[profile.release.package.aspis-r1-cert-check]\noverflow-checks = true\n\n[profile.release.package.aspis-r1-cert-build]\noverflow-checks = true\n"}
