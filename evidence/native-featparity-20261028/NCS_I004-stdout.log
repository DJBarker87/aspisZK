sion = \"0.12.28\", default-features = false, features = [\"blocking\", \"json\", \"rustls-tls\"] }\nserde = { version = \"1.0.228\", features = [\"derive\"] }\nserde_json = \"1.0.145\"\nsha2 = \"0.10.8\"\nsolana-program = \"2.3.0\"\nsolana-loader-v3-interface = { version = \"5.0.0\", features = [\"bincode\"] }\nsolana-sdk = \"2.3.0\"\nsolana-system-interface = { version = \"1.0.0\", features = [\"bincode\"] }\nzeroize = \"1.8.1\"\nx25519-dalek = { version = \"=3.0.0\", default-features = false, features = [\"zeroize\"] }\n\n# The extracted P_R1 checker and builders are modelled with checked arithmetic\n# (an overflow is a failure, D57.1): keep overflow checks in optimized builds.\n[profile.release.package.aspis-r1-cert-check]\noverflow-checks = true\n\n[profile.release.package.aspis-r1-cert-build]\noverflow-checks = true\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-9-20261027/LPi_src/crates/aspis-r1-cost-probe/src/LPi_contracts.rs", "exists": true, "sha256": "bc925acbe2398efd44d5e9873dd5465a971da87075be33bc55d394ab1f06b7f8", "text": "//! Lean-discharged byte stubs. Pairing: LPi_WriterValues.\nuse aspis_core::field::{CM31,QM31,M31};\nfn word(x:M31)->[u8;4] { [x.0 as u8,(x.0>>8) as u8,(x.0>>16) as u8,(x.0>>24) as u8] }\npub fn mbytes(x:M31)->[u8;4] {\n let b:[u8;4]=kani::any();kani::assume(b==word(x));b\n}\npub fn cbytes(x:CM31,out:&mut[u8]) {\n assert!(out.len()==8);\n let a=word(x.a);let b=word(x.b);let v:[u8;8]=kani::any();\n kani::assume(v==[a[0],a[1],a[2],a[3],b[0],b[1],b[2],b[3]]);\n out.copy_from_slice(&v);\n}\npub fn qbytes(x:QM31,out:&mut[u8]) {\n assert!(out.len()==16);\n let a=word(x.c0.a);let b=word(x.c0.b);let c=word(x.c1.a);let d=word(x.c1.b);\n let v:[u8;16]=kani::any();\n kani::assume(v==[a[0],a[1],a[2],a[3],b[0],b[1],b[2],b[3],c[0],c[1],c[2],c[3],d[0],d[1],d[2],d[3]]);\n out.copy_from_slice(&v);\n}\nfn q(x:[u32;4])->QM31 {QM31{c0:CM31{a:M31(x[0]),b:M31(x[1])},c1:CM31{a:M31(x[2]),b:M31(x[3])}}}\nfn check_q<const N:usize,const AT:usize>() {\n let x:[u32;4]=kani::any();let mut buf:[u8;N]=kani::any();let before=buf;\n q(x).write_le_bytes(&mut buf[AT..AT+16]);\n let j:usize=kani::any();kani::assume(j<N);\n if j>=AT&&j<AT+16 {let k=j-AT;assert_eq!(buf[j],(x[k/4]>>((k%4)*8)) as u8);}\n else {assert_eq!(buf[j],before[j]);}\n kani::cover!(j==AT+15);kani::cover!(x[0]==u32::MAX);\n}\nmacro_rules! qcase {($name:ident,$n:expr,$at:expr)=>{\n #[kani::proof] #[kani::stub(CM31::write_le_bytes,cbytes)] #[kani::unwind(18)]\n fn $name(){check_q::<$n,$at>();}\n}}\nqcase!(q_owned16,16,0);\nqcase!(q_parent32_left,32,0);\nqcase!(q_parent32_right,32,16);\nqcase!(q_parent32_middle,32,8);\nqcase!(q_parent48_middle,48,16);\nqcase!(q_parent48_right,48,32);\nfn check_c<const N:usize,const AT:usize>() {\n let x:[u32;2]=kani::any();let mut buf:[u8;N]=kani::any();let before=buf;\n CM31{a:M31(x[0]),b:M31(x[1])}.write_le_bytes(&mut buf[AT..AT+8]);\n let j:usize=kani::any();kani::assume(j<N);\n if j>=AT&&j<AT+8 {let k=j-AT;assert_eq!(buf[j],(x[k/4]>>((k%4)*8)) as u8);}\n else {assert_eq!(buf[j],before[j]);}\n kani::cover!(j==AT+7);kani::cover!(x[1]==u32::MAX);\n}\nmacro_rules! ccase {($name:ident,$n:expr,$at:expr)=>{\n #[kani::proof] #[kani::stub(M31::to_le_bytes,mbytes)] #[kani::unwind(10)]\n fn $name(){check_c::<$n,$at>();}\n}}\nccase!(c_parent16_left,16,0);\nccase!(c_parent16_right,16,8);\nccase!(c_parent32_middle,32,16);\npub fn ebytes(x:aspis_core::field::WideExact)->[u8;32] {\n let words=x.to_limbs();let bytes:[u8;32]=kani::any();\n for i in 0..32 {kani::assume(bytes[i]==(words[i/4]>>((i%4)*8)) as u8);}\n bytes\n}\n// Natural-coordinate specifications paired with LPi_FieldValues/TowerValues/MixedValues.\nconst P:u64=2147483647;\nfn add(a:u32,b:u32)->u32 {((u64::from(a)+u64::from(b))%P) as u32}\nfn sub(a:u32,b:u32)->u32 {((u64::from(a)+P-u64::from(b))%P) as u32}\nfn cmul(a:[u32;2],b:[u32;2])->[u32;2] {\n let m0=((u64::from(a[0])*u64::from(b[0]))%P) as u32;\n let m1=((u64::from(a[1])*u64::from(b[1]))%P) as u32;\n let m2=(((u64::from(a[0])+u64::from(a[1]))*(u64::from(b[0])+u64::from(b[1])))%P) as u32;\n [sub(m0,m1),sub(sub(m2,m0),m1)]\n}\nfn ca(a:[u32;2],b:[u32;2])->[u32;2]{[add(a[0],b[0]),add(a[1],b[1])]}\nfn cs(a:[u32;2],b:[u32;2])->[u32;2]{[sub(a[0],b[0]),sub(a[1],b[1])]}\nfn cr(a:[u32;2])->[u32;2]{[sub(add(a[0],a[0]),a[1]),add(a[0],add(a[1],a[1]))]}\nfn qmul(a:[u32;4],b:[u32;4])->[u32;4] {\n let ac=cmul([a[0],a[1]],[b[0],b[1]]);let bd=cmul([a[2],a[3]],[b[2],b[3]]);\n let cross=cmul(ca([a[0],a[1]],[a[2],a[3]]),ca([b[0],b[1]],[b[2],b[3]]));\n let lo=ca(ac,cr(bd));let hi=cs(cs(cross,ac),bd);[lo[0],lo[1],hi[0],hi[1]]\n}\nfn qa(a:[u32;4],b:[u32;4])->[u32;4]{[add(a[0],b[0]),add(a[1],b[1]),add(a[2],b[2]),add(a[3],b[3])]}\nfn qs(a:[u32;4],b:[u32;4])->[u32;4]{[sub(a[0],b[0]),sub(a[1],b[1]),sub(a[2],b[2]),sub(a[3],b[3])]}\nfn qu(a:[u32;4])->[u32;4]{let r=cr([a[2],a[3]]);[r[0],r[1],a[0],a[1]]}\nfn emul_spec(a:[u32;8],b:[u32;8])->[u32;8] {\n let a0=[a[0],a[1],a[2],a[3]];let a1=[a[4],a[5],a[6],a[7]];\n let b0=[b[0],b[1],b[2],b[3]];let b1=[b[4],b[5],b[6],b[7]];\n let ac=qmul(a0,b0);let bd=qmul(a1,b1);let cross=qmul(qa(a0,a1),qa(b0,b1));\n let lo=qa(ac,qu(bd));let hi=qs(qs(cross,ac),bd);[lo[0],lo[1],lo[2],lo[3],hi[0],hi[1],hi[2],hi[3]]\n}\npub fn emul(a:aspis_core::field::WideExact,b:aspis_core::field::WideExact)->aspis_core::field::WideExact {\n let w:[u32;8]=kani::any();for x in w{kani::assume(u64::from(x)<P);}\n kani::assume(w==emul_spec(a.to_limbs(),b.to_limbs()));aspis_core::field::WideExact::from_limbs(w).unwrap()\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-9-20261027/LPi_src/crates/aspis-r1-cost-probe/src/LPi_verifier.rs", "exists": true, "sha256": "061e7a7631a9a5c931de8d822d5bdd202f9bc5ed11c0ec265e3d8b2abd013f99", "text": "//! Native private writer callers, one source iteration from arbitrary pre-state.\nuse super::*;\nuse aspis_core::field::CM31;\nfn any_k()->K {let w:[u32;4]=kani::any();K{c0:CM31{a:M31(w[0]),b:M31(w[1])},c1:CM31{a:M31(w[2]),b:M31(w[3])}}}\nfn any_e()->E {let w:[u32;8]=kani::any();for x in w {kani::assume(x<0x7fff_ffff);}E::from_limbs(w).unwrap()}\nfn kwords(x:K)->[u32;4] {[x.c0.a.0,x.c0.b.0,x.c1.a.0,x.c1.b.0]}\nfn check_k(len:usize) {\n assert!(len<=1720);let x=any_k();let words=kwords(x);\n let initial:[u8;1736]=kani::any();let mut out=initial[..len].to_vec();\n put_k(&mut out,x);\n assert_eq!(out.len(),len+16);\n let at:usize=kani::any();kani::assume(at<out.len());\n assert_eq!(out[at],if at<len{initial[at]}else{let j=at-len;(words[j/4]>>((j%4)*8)) as u8});\n kani::cover!(at==len+15);\n}\nfn check_e(len:usize) {\n assert!(len<=1704);let x=any_e();let words=x.to_limbs();\n let initial:[u8;1736]=kani::any();let mut out=initial[..len].to_vec();\n put(&mut out,x);\n assert_eq!(out.len(),len+32);\n let at:usize=kani::any();kani::assume(at<out.len());\n assert_eq!(out[at],if at<len{initial[at]}else{let j=at-len;(words[j/4]>>((j%4)*8)) as u8});\n kani::cover!(at==len+31);\n}\nmacro_rules! kproof {($name:ident,$body:block)=>{\n #[kani::proof] #[kani::stub(K::write_le_bytes,crate::LPi_contracts::qbytes)] #[kani::unwind(1740)]\n fn $name() $body\n}}\nmacro_rules! eproof {($name:ident,$body:block)=>{\n #[kani::proof] #[kani::stub(E::to_le_bytes,crate::LPi_contracts::ebytes)] #[kani::unwind(1740)]\n fn $name() $body\n}}\nkproof!(put_k_arbitrary_prefix,{let n:usize=kani::any();kani::assume(n<=1720);check_k(n);});\neproof!(put_e_arbitrary_prefix,{let n:usize=kani::any();kani::assume(n<=1704);check_e(n);});\nkproof!(weight_iteration,{let i:usize=kani::any();kani::assume(i<64);check_k(712+16*i);});\nkproof!(semantic_iteration,{let i:usize=kani::any();kani::assume(i<10);check_k(408+16*i);});\nkproof!(z_iteration,{let i:usize=kani::any();kani::assume(i<4);check_k(568+16*i);});\neproof!(prepared_fields_iteration,{let i:usize=kani::any();kani::assume(i<4);check_e(176+32*i);});\neproof!(claim_rhs_iteration,{let i:usize=kani::any();kani::assume(i<2);check_e(632+32*i);});\nkproof!(rho_context,{check_k(304);});\nkproof!(power_context,{check_k(696);});\n// Verbatim powers while-body, ONE arbitrary iteration; entire powers loop is Lean-inducted.\n#[kani::proof] #[kani::stub(E::mul,crate::LPi_contracts::emul)] #[kani::unwind(65)]\nfn powers_one_iteration() {\n let x=any_e();let p=any_e();let mut out:[E;7]=core::array::from_fn(|_|any_e());let before=out;\n let at:usize=kani::any();kani::assume(at<7);let mut i=at;\n out[i]=p;i+=1;\n let next=if i==7{None}else{Some(p.mul(x))};\n let j:usize=kani::any();kani::assume(j<7);\n assert_eq!(out[j].to_limbs(),if j==at{p.to_limbs()}else{before[j].to_limbs()});\n assert_eq!(i,at+1);assert_eq!(next.is_none(),at==6);\n kani::cover!(at==6);kani::cover!(at==0);\n}\n#[kani::proof] #[kani::unwind(65)]\nfn powers_final_iteration() {\n let p=any_e();let mut out:[E;7]=core::array::from_fn(|_|any_e());let before=out;\n let mut i=6usize;out[i]=p;i+=1;\n assert_eq!(i,7);let j:usize=kani::any();kani::assume(j<7);\n assert_eq!(out[j].to_limbs(),if j==6{p.to_limbs()}else{before[j].to_limbs()});\n kani::cover!(j==6);\n}\n#[kani::proof] #[kani::unwind(65)]\nfn powers_continue_prefix() {\n let x=any_e();let p=any_e();let mut out:[E;7]=core::array::from_fn(|_|any_e());let before=out;\n let at:usize=kani::any();kani::assume(at<6);let mut i=at;out[i]=p;i+=1;\n assert!(i!=7);let j:usize=kani::any();kani::assume(j<7);\n assert_eq!(out[j].to_limbs(),if j==at{p.to_limbs()}else{before[j].to_limbs()});\n // Exact next native call operands. The product-call continuation is OPEN after K014.\n let operands=(p,x);assert_eq!(operands.0.to_limbs(),p.to_limbs());\n kani::cover!(at==0);kani::cover!(at==5);\n}\n// Joined source cuts: the serializer's whole-body association stays explicit/open.\n#[derive(Clone,Copy)]\nstruct JoinedOracle<'a>{count:&'a core::cell::Cell<usize>,proof:&'a[u8],public:&'a[u8],body:&'a[u8;1736],selected:usize,answers:[[u8;32];3]}\nimpl Digest32 for JoinedOracle<'_>{\n fn digest(&self,parts:&[&[u8]])->[u8;32]{\n  let n=self.count.get();assert!(n<3);\n  match n {\n   0=>{assert_eq!(parts.len(),1);assert_eq!(parts[0].len(),self.proof.len());assert_eq!(parts[0].as_ptr(),self.proof.as_ptr());}\n   1=>{assert_eq!(parts.len(),1);assert_eq!(parts[0].len(),self.public.len());assert_eq!(parts[0].as_ptr(),self.public.as_ptr());}\n   _=>{assert_eq!(parts.len(),2);assert_eq!(parts[0],b\"UNPROVED:R1:checkpoint\");assert_eq!(parts[1].len(),1736);assert_eq!(parts[1][self.selected],joined_byte(self.body,&self.answers,self.selected));}\n  }\n  self.count.set(n+1);self.answers[n]\n }\n}\nfn joined_byte(body:&[u8;1736],answers:&[[u8;32];3],at:usize)->u8 {\n if (16..48).contains(&at){answers[0][at-16]}\n else if (48..80).contains(&at){answers[1][at-48]}\n else if at<1736{body[at]}else{answers[2][at-1736]}\n}\nfn joined_digest_cut<const PROOF:usize,const PUBLIC:usize>() {\n let proof:[u8;PROOF]=kani::any();let public:[u8;PUBLIC]=kani::any();\n let body:[u8;1736]=kani::any();let answers:[[u8;32];3]=kani::any();\n let selected:usize=kani::any();kani::assume(selected<1736);\n let at:usize=kani::any();kani::assume(at<1768);\n let count=core::cell::Cell::new(0);let hash=JoinedOracle{count:&count,proof:&proof,public:&public,body:&body,selected,answers};\n let hp=hash.digest(&[&proof]);let hu=hash.digest(&[&public]);\n let mut out=Vec::from(body);out[16..48].copy_from_slice(&hp);out[48..80].copy_from_slice(&hu);\n let sum=hash.digest(&[b\"UNPROVED:R1:checkpoint\",&out]);out.extend_from_slice(&sum);\n assert_eq!(count.get(),3);assert_eq!(out.len(),1768);assert_eq!(out[at],joined_byte(&body,&answers,at));\n kani::cover!(at==1767);kani::cover!(selected==1735);\n}\n#[kani::proof] #[kani::unwind(1740)]\nfn joined_digest_cut_small(){joined_digest_cut::<3,5>();}\n#[kani::proof] #[kani::unwind(57609)]\nfn joined_digest_cut_physical(){joined_digest_cut::<57607,1880>();}\n"}
