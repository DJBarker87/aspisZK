{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-core/src/LPh_stubs.rs", "exists": true, "sha256": "ac6cb98fa6a8822973242c6427817890acf5469ff27347cae02a5e6aacd55141", "text": "use super::*;\nconst MOD:u64=2147483647;\nfn m(a:u32,b:u32)->u32{((u64::from(a)*u64::from(b))%MOD)as u32}\nfn a(x:u32,y:u32)->u32{((u64::from(x)+u64::from(y))%MOD)as u32}\nfn d(x:u32,y:u32)->u32{((u64::from(x)+MOD-u64::from(y))%MOD)as u32}\nfn cw(x:CM31)->[u32;2]{[x.a.0,x.b.0]}\nfn qw(x:QM31)->[u32;4]{[x.c0.a.0,x.c0.b.0,x.c1.a.0,x.c1.b.0]}\nfn c(x:[u32;2])->CM31{CM31{a:M31(x[0]),b:M31(x[1])}}\nfn q(x:[u32;4])->QM31{QM31{c0:c([x[0],x[1]]),c1:c([x[2],x[3]])}}\nfn ca(x:[u32;2],y:[u32;2])->[u32;2]{[a(x[0],y[0]),a(x[1],y[1])]}\nfn cd(x:[u32;2],y:[u32;2])->[u32;2]{[d(x[0],y[0]),d(x[1],y[1])]}\nfn cm(x:[u32;2],y:[u32;2])->[u32;2]{let t=m(x[0],y[0]);let u=m(x[1],y[1]);\n let cross=(((u64::from(x[0])+u64::from(x[1]))*(u64::from(y[0])+u64::from(y[1])))%MOD)as u32;\n [d(t,u),d(d(cross,t),u)]}\nfn cr(x:[u32;2])->[u32;2]{[d(a(x[0],x[0]),x[1]),a(x[0],a(x[1],x[1]))]}\nfn qa(x:[u32;4],y:[u32;4])->[u32;4]{core::array::from_fn(|i|a(x[i],y[i]))}\nfn qd(x:[u32;4],y:[u32;4])->[u32;4]{core::array::from_fn(|i|d(x[i],y[i]))}\nfn qm(x:[u32;4],y:[u32;4])->[u32;4]{let x0=[x[0],x[1]];let x1=[x[2],x[3]];let y0=[y[0],y[1]];let y1=[y[2],y[3]];\n let t=cm(x0,y0);let u=cm(x1,y1);let v=cm(ca(x0,x1),ca(y0,y1));let lo=ca(t,cr(u));let hi=cd(cd(v,t),u);[lo[0],lo[1],hi[0],hi[1]]}\nfn domain<const N:usize>(x:[u32;N]){for i in 0..N{assert!(u64::from(x[i])<MOD,\"LPh field stub domain\");}}\nfn chosen<const N:usize>(value:[u32;N])->[u32;N]{let out:[u32;N]=kani::any();for i in 0..N{kani::assume(out[i]==value[i]);}out}\npub fn m31(x:M31,y:M31)->M31{domain([x.0,y.0]);M31(chosen([m(x.0,y.0)])[0])}\npub fn cm31(x:CM31,y:CM31)->CM31{domain(cw(x));domain(cw(y));c(chosen(cm(cw(x),cw(y))))}\npub fn qm31(x:QM31,y:QM31)->QM31{domain(qw(x));domain(qw(y));q(chosen(qm(qw(x),qw(y))))}\npub fn scalar(x:QM31,y:M31)->QM31{domain(qw(x));domain([y.0]);q(chosen(qw(x).map(|v|m(v,y.0))))}\npub fn by_r(x:CM31)->CM31{domain(cw(x));c(chosen(cr(cw(x))))}\npub fn wide(x:WideExact,y:WideExact)->WideExact{domain(x.to_limbs());domain(y.to_limbs());\n let x0=qw(x.c0());let x1=qw(x.c1());let y0=qw(y.c0());let y1=qw(y.c1());\n let t=qm(x0,y0);let u=qm(x1,y1);let cross=qm(qa(x0,x1),qa(y0,y1));let r=cr([u[2],u[3]]);\n let lo=qa(t,[r[0],r[1],u[0],u[1]]);let hi=qd(qd(cross,t),u);\n WideExact::from_limbs(chosen([lo[0],lo[1],lo[2],lo[3],hi[0],hi[1],hi[2],hi[3]])).unwrap()}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPa_candidate.rs", "exists": true, "sha256": "2368c3f6d1a1fafa1eade35c5db9fc8a3155c9d905bf62974319739a18a3905b", "text": "//! Direct wide_view at actual frozen bounds, arbitrary inactive32-byte stage.\nuse super::*;\n#[kani::proof] #[kani::unwind(35)] fn LPa_view_inactive(){\n let mut proof=[0u8;compact::PROOF_BYTES];let b:[u8;32]=kani::any();\n proof[compact::OFF_INACTIVE..compact::OFF_ROUND0].copy_from_slice(&b);\n let semantic=[0u8;super::SEMANTIC_BYTES];let y1=[0u8;29*32];\n let actual=wide_view(&proof,&semantic,&y1);let inactive=E::from_le_bytes(&b);\n match (actual,inactive){\n  (Err(e),None)=>assert_eq!(e,Error::Parse),\n  (Ok(v),Some(x))=>{\n   assert_eq!(v.inactive,x);assert_eq!(v.variant,Variant::S2);\n   assert!(core::ptr::eq(v.semantic.as_ptr(),semantic.as_ptr()));assert_eq!(v.semantic.len(),semantic.len());\n   assert!(core::ptr::eq(v.y1.as_ptr(),y1.as_ptr()));assert_eq!(v.y1.len(),y1.len());\n   assert!(core::ptr::eq(v.round0.as_ptr(),proof[compact::OFF_ROUND0..].as_ptr()));assert_eq!(v.round0.len(),224);\n   assert!(core::ptr::eq(v.folded_root.unwrap().as_ptr(),proof[compact::OFF_FOLDED_ROOT..].as_ptr()));\n   assert!(core::ptr::eq(v.round1.as_ptr(),proof[compact::OFF_ROUND1..].as_ptr()));assert_eq!(v.round1.len(),224);\n   assert!(core::ptr::eq(v.final_message.as_ptr(),proof[compact::OFF_FINAL..].as_ptr()));assert_eq!(v.final_message.len(),2048);\n   assert_eq!(v.query_bytes.len(),0);\n  },_=>assert!(false)\n }\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPa_compact.rs", "exists": true, "sha256": "2de5082e08715d79f5502c62aac74ad3a34718ec9d2367e201c8addd35637749", "text": "//! Direct calls to the shipped library. Owned references: XRf_reference.rs:28-47.\nuse super::*;\nfn reference_check(b:&[u8])->Result<(),CodecError>{\n let mut i=0;while i<b.len()/16 {for j in 0..4 {\n  let n=u32::from_le_bytes(b[16*i+4*j..16*i+4*j+4].try_into().unwrap());\n  if n>=0x7fff_ffff{return Err(CodecError::NonCanonical)}\n }i+=1;}Ok(())\n}\nfn reference_expand(b:&[u8],o:&mut[u8])->Result<(),CodecError>{\n if b.len()%16!=0||o.len()!=2*b.len(){return Err(CodecError::Length)}\n for i in 0..b.len()/16 {for j in 0..32{o[32*i+j]=if j<16{b[16*i+j]}else{0};}}Ok(())\n}\n#[kani::proof] #[kani::unwind(6)] fn LPa_check_stage(){\n let b:[u8;16]=kani::any();assert_eq!(check_values(&b),reference_check(&b));\n}\n#[kani::proof] #[kani::unwind(6)] fn LPa_check_composition(){\n let b:[u8;32]=kani::any();let left=check_values(&b[..16]);\n let staged=left.and_then(|()|check_values(&b[16..]));assert_eq!(check_values(&b),staged);\n}\n#[kani::proof] #[kani::unwind(6)] fn LPa_check_tail(){\n let b:[u8;31]=kani::any();let n:usize=kani::any();kani::assume(n<=31);\n assert_eq!(check_values(&b[..n]),reference_check(&b[..n]));\n}\n#[kani::proof] #[kani::unwind(35)] fn LPa_expand_stage(){\n let b:[u8;16]=kani::any();let mut o:[u8;48]=kani::any();let mut r=o;\n assert_eq!(expand_values(&b,&mut o[8..40]),reference_expand(&b,&mut r[8..40]));\n let j:usize=kani::any();kani::assume(j<48);assert_eq!(o[j],r[j]);\n}\n#[kani::proof] #[kani::unwind(6)] fn LPa_expand_alignment(){\n let b:[u8;464]=kani::any();let mut o:[u8;928]=kani::any();let before=o;\n let n:usize=kani::any();kani::assume(n<=464&&n%16!=0);\n assert_eq!(expand_values(&b[..n],&mut o),Err(CodecError::Length));\n let j:usize=kani::any();kani::assume(j<928);assert_eq!(o[j],before[j]);\n}\n#[kani::proof] #[kani::unwind(35)] fn LPa_expand_indexed_stage(){\n let b:[u8;464]=kani::any();let mut o:[u8;928]=kani::any();let before=o;\n let i:usize=kani::any();kani::assume(i<29);\n assert_eq!(expand_values(&b[16*i..16*i+16],&mut o[32*i..32*i+32]),Ok(()));\n let j:usize=kani::any();kani::assume(j<928);\n assert_eq!(o[j],if j<32*i||j>=32*i+32{before[j]}else if j<32*i+16{b[16*i+j-32*i]}else{0});\n}\n#[kani::proof] #[kani::unwind(6)] fn LPa_expand_length(){\n let b:[u8;464]=kani::any();let mut o:[u8;928]=kani::any();let before=o;\n let n:usize=kani::any();kani::assume(n<=464&&n%16==0);\n let m:usize=kani::any();kani::assume(m<=928&&m!=2*n);\n assert_eq!(expand_values(&b[..n],&mut o[..m]),Err(CodecError::Length));\n let j:usize=kani::any();kani::assume(j<928);assert_eq!(o[j],before[j]);\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPa_dot.rs", "exists": true, "sha256": "f00144d9a3a80283c71e4890cda80f9c5e06fd64b06ed0f3c5180441c09e87f8", "text": "use super::*;\n#[kani::proof] #[kani::unwind(6)]\nfn LPa_dot_stage() {\n    let x:[u32;4]=kani::any(); let y:[u32;4]=kani::any();\n    kani::assume(x.iter().all(|v|*v<P)); kani::assume(y.iter().all(|v|*v<P));\n    let a=Q::from_limbs(x).unwrap(); let b=Q::from_limbs(y).unwrap();\n    let sums:[u64;4]=kani::any(); let mut actual=Dot{sums};\n    let raw=a.raw(b); actual.push(a,b);\n    let j:usize=kani::any();kani::assume(j<4);\n    let expected=sums[j].wrapping_add((raw[j]%(1u64<<31)).wrapping_add(raw[j]/(1u64<<31)));\n    assert_eq!(actual.sums[j],expected);\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPa_sampler.rs", "exists": true, "sha256": "9c815fc8321bf6d3893d508c6375bcbd81588465c0619ed01485c261fa29335a", "text": "//! Direct circle_sample on the reached rejected-parameter stage, no stubs.\nuse super::*;\n#[kani::proof] #[kani::unwind(260)] fn LPa_circle_fallback(){\n let second:bool=kani::any();let row=if second{CircleRow::Second}else{CircleRow::First};\n assert_eq!(circle_sample(&[0u8;32],row),aspis_core::transcript::circle_fallback_point(usize::from(second)));\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPa_semantic.rs", "exists": true, "sha256": "f748986c8318be57f9161336c72e25be411e608b0de487d88aae689f44e8d40d", "text": "//! Library calls, no child stubs. Owned boundary reference is XRg_boundary_reference.\nuse super::*;\nfn canonical()->QM31{\n let x:[u32;4]=kani::any();kani::assume(x.iter().all(|x|*x<2147483647));\n QM31{c0:aspis_core::field::CM31::new(aspis_core::field::M31(x[0]),aspis_core::field::M31(x[1])),c1:aspis_core::field::CM31::new(aspis_core::field::M31(x[2]),aspis_core::field::M31(x[3]))}\n}\n#[kani::proof] #[kani::unwind(30)] fn LPa_boundary(){\n let p:[QM31;28]=core::array::from_fn(|_|canonical());\n let mut r=p[0].add(p[0]);for i in 1..28{r=r.add(p[i]);}assert_eq!(semantic_boundary(&p),r);\n}\n// Reached decoder/storage stages with one arbitrary lane; remaining lanes zero.\n// Full arbitrary87-lane/allocation association remains open.\nfn claim_stage(point:usize){\n let mut bytes=[0u8;5+116*32];let q=canonical();let lane:usize=kani::any();kani::assume(lane<29);\n let at=5+(29*point+lane)*32;q.write_le_bytes(&mut bytes[at..at+16]);\n let p=crate::r1_wire::LPa_wire::prefix(&bytes);let actual=claims(&p).unwrap();\n let j:usize=kani::any();kani::assume(j<87);\n assert_eq!(actual[j/29][j%29],if j==29*point+lane{q}else{QM31::ZERO});\n}\n#[kani::proof] #[kani::unwind(32)] fn LPa_claim_point0(){claim_stage(0)}\n#[kani::proof] #[kani::unwind(32)] fn LPa_claim_point2(){claim_stage(2)}\n// Replacement for timed-out whole28 fold: one unrestricted canonical addition\n// stage, as actually called by semantic_boundary. No copied shipped body.\n#[kani::proof] #[kani::unwind(6)] fn LPa_boundary_step(){\n let a=canonical();let b=canonical();let result=a.add(b);\n let x=[a.c0.a.0,a.c0.b.0,a.c1.a.0,a.c1.b.0];\n let y=[b.c0.a.0,b.c0.b.0,b.c1.a.0,b.c1.b.0];\n let actual=[result.c0.a.0,result.c0.b.0,result.c1.a.0,result.c1.b.0];\n let j:usize=kani::any();kani::assume(j<4);\n let sum=u64::from(x[j])+u64::from(y[j]);\n let expected=if sum>=2147483647{sum-2147483647}else{sum};\n assert_eq!(u64::from(actual[j]),expected);\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPa_verifier.rs", "exists": true, "sha256": "1e1afa04d0b8c9563196cc2bc997d6247c46a871a73584638652ece368be617e", "text": "//! Owned reference: XRf_reference_echeck. Shipped echeck is called directly.\nuse super::*;\nfn reference(b:&[u8],k:bool)->Result<(),Error>{\n for i in 0..b.len()/32 {for j in 0..8 {\n  let x=u32::from_le_bytes(b[32*i+4*j..32*i+4*j+4].try_into().unwrap());\n  if x>=0x7fff_ffff||(k&&j>=4&&x!=0){return Err(Error::Parse)}\n }}Ok(())\n}\n#[kani::proof] #[kani::unwind(10)] fn LPa_echeck_stage(){\n let b:[u8;32]=kani::any();let k:bool=kani::any();assert_eq!(echeck(&b,k),reference(&b,k));\n}\n#[kani::proof] #[kani::unwind(10)] fn LPa_echeck_tail(){\n let b:[u8;63]=kani::any();let n:usize=kani::any();kani::assume(n<=63);let k:bool=kani::any();\n assert_eq!(echeck(&b[..n],k),reference(&b[..n],k));\n}\n#[kani::proof] #[kani::unwind(10)] fn LPa_echeck_composition(){\n let b:[u8;64]=kani::any();let k:bool=kani::any();\n assert_eq!(echeck(&b,k),echeck(&b[..32],k).and_then(|()|echeck(&b[32..],k)));\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPa_wire.rs", "exists": true, "sha256": "8044d6a87ad2bcf2723e7199aa623f49ceea5c3369a7cd927e5adac3ee154f1b", "text": "//! Direct private-library calls; safe references correspond to XRg_reference.rs.\nuse super::*;\npub(crate) fn prefix<'a>(framed:&'a[u8])->Prefix<'a>{Prefix{c1_root:&[0;32],records:[framed;27]}}\nfn reference_validate(row:u8,b:&[u8])->Result<(),Error>{\n for i in 0..b.len()/32 {for j in 0..8 {\n  let x=u32::from_le_bytes(b[32*i+4*j..32*i+4*j+4].try_into().unwrap());\n  if x>=0x7fff_ffff||(j>=4&&x!=0){return Err(Error::NonCanonical{row,value:i})}\n }}Ok(())\n}\nfn reference_decode<const N:usize>(row:u8,b:&[u8],offset:usize)->Result<[QM31;N],Error>{\n if row<14{return Err(Error::InvalidRow)}\n let start=offset.checked_mul(32).ok_or(Error::Length{row})?;\n let end=start.checked_add(N.checked_mul(32).ok_or(Error::Length{row})?).ok_or(Error::Length{row})?;\n let payload=&b[5..];if end>payload.len(){return Err(Error::Length{row})}\n let mut out=[QM31::ZERO;N];for i in 0..N {\n  for j in 0..4 {let x=u32::from_le_bytes(payload[start+32*i+4*j..start+32*i+4*j+4].try_into().unwrap());\n   if x>=0x7fff_ffff{return Err(Error::NonCanonical{row,value:offset+i})}\n  }out[i]=QM31::from_le_bytes(&payload[start+32*i..start+32*i+16]).unwrap();\n }Ok(out)\n}\n#[kani::proof] #[kani::unwind(10)] fn LPa_decode_stage(){\n let b:[u8;37]=kani::any();let row:u8=kani::any();let offset:usize=kani::any();\n assert_eq!(ValidatedRecord{row,framed:&b}.decode_k::<1>(offset),reference_decode::<1>(row,&b,offset));\n}\n#[kani::proof] #[kani::unwind(10)] fn LPa_decode_guard29(){\n let b:[u8;37]=kani::any();let row:u8=kani::any();let offset:usize=kani::any();\n assert_eq!(ValidatedRecord{row,framed:&b}.decode_k::<29>(offset),reference_decode::<29>(row,&b,offset));\n}\n#[kani::proof] #[kani::unwind(10)] fn LPa_validate_stage(){\n let b:[u8;32]=kani::any();let row:u8=kani::any();assert_eq!(validate_record_fields(row,&b),reference_validate(row,&b));\n}\n#[kani::proof] #[kani::unwind(10)] fn LPa_validate_composition(){\n let b:[u8;64]=kani::any();let row:u8=kani::any();\n let staged=validate_record_fields(row,&b[..32]).and_then(|()|validate_record_fields(row,&b[32..]).map_err(|e|match e{Error::NonCanonical{row,value}=>Error::NonCanonical{row,value:value+1},e=>e}));\n assert_eq!(validate_record_fields(row,&b),staged);\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPc_candidate.rs", "exists": true, "sha256": "fd9ae7dc4f8ca0e3d7bad63ebdb8dbc28bcb9efb3a41a61a2d2228b97bf0a1aa", "text": "// Direct wide_view at actual frozen bounds, arbitrary inactive32-byte stage.\nuse super::*;\n#[kani::proof] #[kani::unwind(35)] fn LPc_view_frame(){\n let mut proof:[u8;compact::PROOF_BYTES]=kani::any();let b=[0u8;32];\n proof[compact::OFF_INACTIVE..compact::OFF_ROUND0].copy_from_slice(&b);\n let semantic:[u8;super::SEMANTIC_BYTES]=kani::any();let y1:[u8;29*32]=kani::any();\n let actual=wide_view(&proof,&semantic,&y1);let inactive=E::from_le_bytes(&b);\n match (actual,inactive){\n  (Err(e),None)=>assert_eq!(e,Error::Parse),\n  (Ok(v),Some(x))=>{\n   assert_eq!(v.inactive,x);assert_eq!(v.variant,Variant::S2);\n   assert!(core::ptr::eq(v.semantic.as_ptr(),semantic.as_ptr()));assert_eq!(v.semantic.len(),semantic.len());\n   assert!(core::ptr::eq(v.y1.as_ptr(),y1.as_ptr()));assert_eq!(v.y1.len(),y1.len());\n   assert!(core::ptr::eq(v.round0.as_ptr(),proof[compact::OFF_ROUND0..].as_ptr()));assert_eq!(v.round0.len(),224);\n   assert!(core::ptr::eq(v.folded_root.unwrap().as_ptr(),proof[compact::OFF_FOLDED_ROOT..].as_ptr()));\n   assert!(core::ptr::eq(v.round1.as_ptr(),proof[compact::OFF_ROUND1..].as_ptr()));assert_eq!(v.round1.len(),224);\n   assert!(core::ptr::eq(v.final_message.as_ptr(),proof[compact::OFF_FINAL..].as_ptr()));assert_eq!(v.final_message.len(),2048);\n   assert_eq!(v.query_bytes.len(),0);\n  },_=>assert!(false)\n }\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPc_compact.rs", "exists": true, "sha256": "cecf34ed1b988c8e462098ae2c4695c2f9217b41a941d30b01dad1825ad6595b", "text": "use super::*;\nfn expansion<const CASE:usize>() {\n let b:[u8;464]=kani::any();let mut o:[u8;928]=kani::any();let before=o;\n let i:usize=kani::any();kani::assume(i<29);\n assert_eq!(expand_values(&b[16*i..16*i+16],&mut o[32*i..32*i+32]),Ok(()));\n let j:usize=kani::any();kani::assume(j<928);\n match CASE {\n  0=>{kani::assume(j>=32*i&&j<32*i+16);assert_eq!(o[j],b[16*i+j-32*i]);}\n  1=>{kani::assume(j>=32*i+16&&j<32*i+32);assert_eq!(o[j],0);}\n  2=>{kani::assume(j<32*i);assert_eq!(o[j],before[j]);}\n  _=>{kani::assume(j>=32*i+32);assert_eq!(o[j],before[j]);}\n }\n}\n#[kani::proof] #[kani::unwind(35)] fn LPc_expand0(){expansion::<0>()}\n#[kani::proof] #[kani::unwind(35)] fn LPc_expand1(){expansion::<1>()}\n#[kani::proof] #[kani::unwind(35)] fn LPc_expand2(){expansion::<2>()}\n#[kani::proof] #[kani::unwind(35)] fn LPc_expand3(){expansion::<3>()}\n\n#[kani::proof] #[kani::unwind(32)] fn LPc_check464(){\n let b:[u8;464]=kani::any();let mut expected=Ok(());\n for i in 0..29{for j in 0..4{\n  let n=u32::from_le_bytes(b[16*i+4*j..16*i+4*j+4].try_into().unwrap());\n  if n>=0x7fff_ffff{expected=Err(CodecError::NonCanonical);}\n }}assert_eq!(check_values(&b),expected);\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPc_dot.rs", "exists": true, "sha256": "9cdbd92e95096e3d23c56f2ad2da0cec47d3a5686422aa5ccf38cc76d5c035e2", "text": "use super::*;\nfn cell<const J:usize>() {\n let x:[u32;4]=kani::any(); let y:[u32;4]=kani::any();\n kani::assume(x.iter().all(|v|*v<P));kani::assume(y.iter().all(|v|*v<P));\n let a=Q::from_limbs(x).unwrap();let b=Q::from_limbs(y).unwrap();\n let sums:[u64;4]=kani::any();let mut actual=Dot{sums};\n let raw=a.raw(b);actual.push(a,b);\n assert_eq!(actual.sums[J],sums[J].wrapping_add((raw[J]%(1u64<<31)).wrapping_add(raw[J]/(1u64<<31))));\n}\n#[kani::proof] #[kani::unwind(6)] fn LPc_dot_cell0(){cell::<0>()}\n#[kani::proof] #[kani::unwind(6)] fn LPc_dot_cell1(){cell::<1>()}\n#[kani::proof] #[kani::unwind(6)] fn LPc_dot_cell2(){cell::<2>()}\n#[kani::proof] #[kani::unwind(6)] fn LPc_dot_cell3(){cell::<3>()}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPc_verifier.rs", "exists": true, "sha256": "18facc4a0f4b4a52187153c90ff8113f99958c61a403edb9e3793b64e1c705b6", "text": "use super::*;\nfn tail<const LO:usize,const HI:usize>() {\n let b:[u8;63]=kani::any();let n:usize=kani::any();kani::assume(n>=LO&&n<=HI);\n let k:bool=kani::any();\n assert_eq!(echeck(&b[..n],k),if n<32{Ok(())}else{echeck(&b[..32],k)});\n}\n#[kani::proof] #[kani::unwind(10)] fn LPc_tail0(){tail::<0,15>()}\n#[kani::proof] #[kani::unwind(10)] fn LPc_tail1(){tail::<16,31>()}\n#[kani::proof] #[kani::unwind(10)] fn LPc_tail2(){tail::<32,47>()}\n#[kani::proof] #[kani::unwind(10)] fn LPc_tail3(){tail::<48,63>()}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPc_wire.rs", "exists": true, "sha256": "a9f9b3364f403aebd8b17d605fc7871bdfc58f7258d544e98d6e518fbc91c498", "text": "use super::*;\n// Each claim call is checked separately; no allocator/child stub is installed.\nfn decode_class<const POINT:usize,const CLASS:usize>() {\n let b:[u8;5+116*32]=kani::any();\n // The offset0 timeout is split by whether the first15 values are canonical.\n if CLASS!=0 {\n  let mut first15=true;\n  for i in 0..15 {first15 &= QM31::from_le_bytes(&b[5+32*(POINT*29+i)..5+32*(POINT*29+i)+16]).is_some();}\n  kani::assume(first15 == (CLASS==2));\n }\n let record=ValidatedRecord{row:25,framed:&b};\n let actual=record.decode_k::<29>(POINT*29);\n let mut expected=Ok([QM31::ZERO;29]);\n let mut out=[QM31::ZERO;29];\n for i in 0..29 {\n  let at=5+32*(POINT*29+i);\n  match QM31::from_le_bytes(&b[at..at+16]) {\n   Some(q)=>out[i]=q,\n   None=>{expected=Err(Error::NonCanonical{row:25,value:POINT*29+i});break;}\n  }\n }\n if expected.is_ok(){expected=Ok(out);}\n assert_eq!(actual,expected);\n}\n#[kani::proof] #[kani::unwind(32)] fn LPc_claim_decode0(){decode_class::<0,0>()}\n#[kani::proof] #[kani::unwind(32)] fn LPc_claim_decode1(){decode_class::<1,0>()}\n#[kani::proof] #[kani::unwind(32)] fn LPc_claim_decode2(){decode_class::<2,0>()}\n\n#[kani::proof] #[kani::unwind(120)] fn LPc_validate116(){\n let b:[u8;3712]=kani::any();let row:u8=kani::any();let mut expected=Ok(());\n 'outer:for i in 0..116{for j in 0..8{\n  let x=u32::from_le_bytes(b[32*i+4*j..32*i+4*j+4].try_into().unwrap());\n  if x>=0x7fff_ffff||(j>=4&&x!=0){expected=Err(Error::NonCanonical{row,value:i});break 'outer;}\n }}assert_eq!(validate_record_fields(row,&b),expected);\n}\n#[kani::proof] #[kani::unwind(10)] fn LPc_decode_reached1(){\n let b:[u8;5+116*32]=kani::any();let point:usize=kani::any();kani::assume(point<3);\n let offset=point*29;let at=5+offset*32;\n let expected=QM31::from_le_bytes(&b[at..at+16]).map(|x|[x]).ok_or(Error::NonCanonical{row:25,value:offset});\n assert_eq!(ValidatedRecord{row:25,framed:&b}.decode_k::<1>(offset),expected);\n}\n// Canonical producer at the actual semantic_round input shape (rows15..24).\n#[kani::proof] #[kani::unwind(32)] fn LPc_boundary_producer(){\n let b:[u8;5+28*32]=kani::any();let row:u8=kani::any();kani::assume(row>=15&&row<=24);\n if let Ok(out)= (ValidatedRecord{row,framed:&b}).decode_k::<28>(0){\n  let i:usize=kani::any();kani::assume(i<28);let q=out[i];\n  assert!(q.c0.a.0<2147483647&&q.c0.b.0<2147483647&&q.c1.a.0<2147483647&&q.c1.b.0<2147483647);\n }\n}\n\n#[kani::proof] #[kani::unwind(32)] fn LPc_claim0_early(){decode_class::<0,1>()}\n#[kani::proof] #[kani::unwind(32)] fn LPc_claim0_late(){decode_class::<0,2>()}\n#[kani::proof] #[kani::unwind(32)] fn LPc_claim2_early(){decode_class::<2,1>()}\n#[kani::proof] #[kani::unwind(32)] fn LPc_claim2_late(){decode_class::<2,2>()}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPg_candidate.rs", "exists": true, "sha256": "49ee93c39a02480f47132bd381be9a73f5a67bc83e38abaf280d49c044b8f5d8", "text": "use super::*;\nfn view<const PART:usize>(){\n let p:[u8;compact::OFF_OPENINGS]=kani::any();let semantic:[u8;0]=kani::any();let y1:[u8;0]=kani::any();\n let expected=E::from_le_bytes(&p[compact::OFF_INACTIVE..compact::OFF_ROUND0]);\n let got=wide_view(&p,&semantic,&y1);\n match (got,expected){\n  (Err(Error::Parse),None)=>{},\n  (Ok(v),Some(x))=>{\n   let a=v.inactive.to_limbs();let b=x.to_limbs();for j in 0..8{assert_eq!(a[j],b[j]);}\n   assert!(core::ptr::eq(v.semantic.as_ptr(),semantic.as_ptr()));assert_eq!(v.semantic.len(),semantic.len());\n   assert!(core::ptr::eq(v.y1.as_ptr(),y1.as_ptr()));assert_eq!(v.y1.len(),y1.len());\n   let (bytes,lo,hi)=match PART{\n    0=>(v.round0,compact::OFF_ROUND0,compact::OFF_FOLDED_ROOT),\n    1=>(v.folded_root.unwrap().as_slice(),compact::OFF_FOLDED_ROOT,compact::OFF_ROUND1),\n    2=>(v.round1,compact::OFF_ROUND1,compact::OFF_FINAL),\n    _=>(v.final_message,compact::OFF_FINAL,compact::OFF_OPENINGS)};\n   assert!(core::ptr::eq(bytes.as_ptr(),p[lo..hi].as_ptr()));assert_eq!(bytes.len(),hi-lo);\n   assert!(v.query_bytes.is_empty());\n  },_=>panic!(\"native range/decoder disagreement\")\n }\n}\n#[kani::proof] #[kani::unwind(10)] fn LPg_view0(){view::<0>()}\n#[kani::proof] #[kani::unwind(10)] fn LPg_view1(){view::<1>()}\n#[kani::proof] #[kani::unwind(10)] fn LPg_view2(){view::<2>()}\n#[kani::proof] #[kani::unwind(10)] fn LPg_view3(){view::<3>()}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPg_compact.rs", "exists": true, "sha256": "dbc014628c8c68473e67fc034b9d7488e8f4a22774ea6d120346570aff01d7bf", "text": "use super::*;\n#[kani::proof] #[kani::unwind(8)] fn LPg_check_step(){\n let b:[u8;16]=kani::any();let prior:bool=kani::any();\n let actual=if prior{check_values(&b)}else{Err(CodecError::NonCanonical)};\n let expect=if prior&&QM31::from_le_bytes(&b).is_some(){Ok(())}else{Err(CodecError::NonCanonical)};\n assert_eq!(actual,expect);\n}\nfn expansion<const LO:usize,const HI:usize>(){\n let b:[u8;16]=kani::any();let mut out:[u8;32]=kani::any();let old=out;\n let lane:usize=kani::any();kani::assume(lane>=LO&&lane<HI);\n assert_eq!(expand_values(&b,&mut out),Ok(()));\n assert_eq!(out[lane],if lane<16{b[lane]}else{0});let _=old;\n}\n#[kani::proof] #[kani::unwind(18)] fn LPg_expand_low(){expansion::<0,16>()}\n#[kani::proof] #[kani::unwind(18)] fn LPg_expand_high(){expansion::<16,32>()}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPg_dot.rs", "exists": true, "sha256": "4ed4855903f758494f2bcfc26cb440ca53b5d7d033e35dc7602955efc9c81be0", "text": "use super::*;\npub(super) fn reference(x:Q,y:Q)->[u64;4] {\n let [a,b,c,d]=x.0.map(u64::from); let [e,f,g,h]=y.0.map(u64::from);\n let pp=(P as u64)*(P as u64);\n let u=(c*g).wrapping_add(pp).wrapping_sub(d*h);\n let v=(c*h).wrapping_add(d*g);\n let u=(u & P as u64).wrapping_add(u>>31);\n let v=(v & P as u64).wrapping_add(v>>31);\n [(a*e).wrapping_add(pp).wrapping_sub(b*f).wrapping_add(2*u).wrapping_add(3*P as u64).wrapping_sub(v),\n (a*f).wrapping_add(b*e).wrapping_add(u).wrapping_add(2*v),\n (a*g).wrapping_add(c*e).wrapping_add(2*pp).wrapping_sub(b*h).wrapping_sub(d*f),\n (a*h).wrapping_add(b*g).wrapping_add(c*f).wrapping_add(d*e)]\n}\nfn operands()->(Q,Q) {let x:[u32;4]=kani::any();let y:[u32;4]=kani::any();\n kani::assume(x.iter().all(|v|*v<P)&&y.iter().all(|v|*v<P));\n (Q::from_limbs(x).unwrap(),Q::from_limbs(y).unwrap())}\n#[kani::proof_for_contract(Q::raw)] #[kani::unwind(6)]\nfn LPg_raw_contract(){let (a,b)=operands();a.raw(b);}\nfn cell<const J:usize>() {let (a,b)=operands();let sums:[u64;4]=kani::any();let mut actual=Dot{sums};\n let raw=reference(a,b); actual.push(a,b);\n assert_eq!(actual.sums[J],sums[J].wrapping_add((raw[J] & P as u64).wrapping_add(raw[J]>>31)));}\n#[kani::proof] #[kani::stub_verified(Q::raw)] #[kani::unwind(6)] fn LPg_cell0(){cell::<0>()}\n#[kani::proof] #[kani::stub_verified(Q::raw)] #[kani::unwind(6)] fn LPg_cell1(){cell::<1>()}\n#[kani::proof] #[kani::stub_verified(Q::raw)] #[kani::unwind(6)] fn LPg_cell2(){cell::<2>()}\n#[kani::proof] #[kani::stub_verified(Q::raw)] #[kani::unwind(6)] fn LPg_cell3(){cell::<3>()}\n\npub(super) fn ref_add(x:Q,y:Q)->[u32;4]{core::array::from_fn(|i|{let s=u64::from(x.0[i])+u64::from(y.0[i]);(if s>=P as u64{s-P as u64}else{s})as u32})}\npub(super) fn ref_sub(x:Q,y:Q)->[u32;4]{core::array::from_fn(|i|{let s=u64::from(x.0[i])+P as u64-u64::from(y.0[i]);(if s>=P as u64{s-P as u64}else{s})as u32})}\npub(super) fn ref_half(x:Q)->[u32;4]{x.0.map(|a|a/2+(a%2)*1073741824)}\n#[kani::proof_for_contract(reduce)] #[kani::unwind(6)] fn LPg_reduce_contract(){reduce(kani::any());}\n#[kani::proof_for_contract(add)] #[kani::unwind(6)] fn LPg_add_contract(){add(kani::any(),kani::any());}\n#[kani::proof_for_contract(Q::add)] #[kani::unwind(6)] fn LPg_qadd_contract(){let(a,b)=operands();a.add(b);}\n#[kani::proof_for_contract(Q::sub)] #[kani::unwind(6)] fn LPg_qsub_contract(){let(a,b)=operands();a.sub(b);}\n#[kani::proof_for_contract(Q::half)] #[kani::unwind(6)] fn LPg_qhalf_contract(){let(a,b)=operands();a.half();}\n\npub(super) fn equal(a:[u32;4],b:[u32;4])->bool{a[0]==b[0]&&a[1]==b[1]&&a[2]==b[2]&&a[3]==b[3]}\n\n// Isolated primitive product excerpt; does not replace the actual raw method.\n#[kani::requires(a<P && b<P)]\n#[kani::ensures(|out:&u64| (*out as u128)==(a as u128)*(b as u128))]\nfn LPg_product(a:u32,b:u32)->u64{u64::from(a)*u64::from(b)}\n#[kani::proof_for_contract(LPg_product)] fn LPg_product_contract(){LPg_product(kani::any(),kani::any());}\n#[kani::proof] #[kani::stub_verified(reduce)] #[kani::unwind(6)]\nfn LPg_finish_canonical(){let sums:[u64;4]=kani::any();let q=Dot{sums}.finish();for j in 0..4{assert!(q.0[j]<P);}}\n#[kani::proof] #[kani::unwind(6)] fn LPg_dot_witness(){\n let nonzero:bool=kani::any();let a=if nonzero{Q::ONE}else{Q::ZERO};let mut d=Dot::new();d.push(a,Q::ONE);let out=d.finish();\n for j in 0..4{assert_eq!(out.0[j],a.0[j]);}\n kani::cover!(nonzero);kani::cover!(!nonzero);\n}\n#[kani::proof] #[kani::unwind(6)] fn LPg_half_reject(){let(a,_)=operands();let n:u8=kani::any();kani::assume(n>30);assert!(a.half_pow(n).is_none());}\n#[kani::proof] #[kani::unwind(6)] fn LPg_scalar_reject(){let(a,_)=operands();let n:u32=kani::any();kani::assume(n>=P);assert!(a.mul_m31(n).is_none());}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPg_r1_wire.rs", "exists": true, "sha256": "a045c1a6efba2aea3e7cf88743f2a4aa476a3ba9276e8b6f3fbcc989cabcc5a2", "text": "use super::*;\n#[kani::proof] #[kani::unwind(10)] fn LPg_validate_step(){\n let b:[u8;32]=kani::any();let row:u8=kani::any();\n let expected=match WideExact::from_le_bytes(&b){Some(x) if x.c1()==QM31::ZERO=>Ok(()),_=>Err(Error::NonCanonical{row,value:0})};\n assert_eq!(validate_record_fields(row,&b),expected);\n}\nfn decode_step<const POINT:usize,const LO:usize,const HI:usize>() {\n let i:usize=kani::any();kani::assume(i>=LO&&i<HI);\n // A one-value record at an arbitrary absolute offset; original decoder takes N=1.\n let b:[u8;5+116*32]=kani::any();let row:u8=kani::any();kani::assume(row>=14);\n let off=POINT+i;let at=5+32*off;\n let expected=QM31::from_le_bytes(&b[at..at+16]).map(|q|[q]).ok_or(Error::NonCanonical{row,value:off});\n let got=ValidatedRecord{row,framed:&b}.decode_k::<1>(off);\n match (got,expected){\n  (Ok([a]),Ok([b]))=>{assert_eq!(a.c0.a.0,b.c0.a.0);assert_eq!(a.c0.b.0,b.c0.b.0);assert_eq!(a.c1.a.0,b.c1.a.0);assert_eq!(a.c1.b.0,b.c1.b.0);},\n  (Err(a),Err(b))=>assert_eq!(a,b),_=>panic!(\"step disagreement\")\n }\n}\n#[kani::proof] #[kani::unwind(10)] fn LPg_decode0_0(){decode_step::<0,0,15>()}\n#[kani::proof] #[kani::unwind(10)] fn LPg_decode0_1(){decode_step::<0,15,29>()}\n#[kani::proof] #[kani::unwind(10)] fn LPg_decode29_0(){decode_step::<29,0,15>()}\n#[kani::proof] #[kani::unwind(10)] fn LPg_decode29_1(){decode_step::<29,15,29>()}\n#[kani::proof] #[kani::unwind(10)] fn LPg_decode58_0(){decode_step::<58,0,15>()}\n#[kani::proof] #[kani::unwind(10)] fn LPg_decode58_1(){decode_step::<58,15,29>()}\n\n#[kani::proof] #[kani::unwind(10)] fn LPg_decode_invalid_row(){\n let b:[u8;37]=kani::any();let row:u8=kani::any();kani::assume(row<14);\n assert_eq!(ValidatedRecord{row,framed:&b}.decode_k::<1>(0),Err(Error::InvalidRow));\n}\n#[kani::proof] #[kani::unwind(10)] fn LPg_decode_offset_overflow(){\n let b:[u8;37]=kani::any();let row:u8=kani::any();kani::assume(row>=14);let off:usize=kani::any();kani::assume(off>usize::MAX/32);\n assert_eq!(ValidatedRecord{row,framed:&b}.decode_k::<1>(off),Err(Error::Length{row}));\n}\n#[kani::proof] #[kani::unwind(10)] fn LPg_decode_range_error(){\n let b:[u8;37]=kani::any();let row:u8=kani::any();kani::assume(row>=14);let off:usize=kani::any();kani::assume(off>=1&&off<=usize::MAX/32);\n assert_eq!(ValidatedRecord{row,framed:&b}.decode_k::<1>(off),Err(Error::Length{row}));\n}\n\nfn fixed_decode<const OFF:usize>(){\n let b:[u8;5+116*32]=kani::any();let row:u8=kani::any();kani::assume(row>=14);\n let expected=QM31::from_le_bytes(&b[5+OFF*32..5+OFF*32+16]);\n let got=ValidatedRecord{row,framed:&b}.decode_k::<1>(OFF);\n match (got,expected){\n (Ok([a]),Some(b))=>{assert_eq!(a.c0.a.0,b.c0.a.0);assert_eq!(a.c0.b.0,b.c0.b.0);assert_eq!(a.c1.a.0,b.c1.a.0);assert_eq!(a.c1.b.0,b.c1.b.0);},\n (Err(a),None)=>assert_eq!(a,Error::NonCanonical{row,value:OFF}),_=>panic!(\"fixed-index disagreement\")}\n}\n#[kani::proof] #[kani::unwind(10)] fn LPg_fixed15(){fixed_decode::<15>()}\n#[kani::proof] #[kani::unwind(10)] fn LPg_fixed28(){fixed_decode::<28>()}\n#[kani::proof] #[kani::unwind(10)] fn LPg_fixed73(){fixed_decode::<73>()}\n#[kani::proof] #[kani::unwind(10)] fn LPg_fixed86(){fixed_decode::<86>()}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPg_verifier.rs", "exists": true, "sha256": "09855a939c423d58615332010261adcbc6ec39ddc9718ea6c1f664b5dab19ecd", "text": "use super::*;\nfn step<const K:bool,const J:usize>() {\n let b:[u8;32]=kani::any();let prior:bool=kani::any();\n let x=E::from_le_bytes(&b);let expected=match x {None=>Err(Error::Parse),Some(x)=>if K&&x.c1()!=K::ZERO{Err(Error::Parse)}else{Ok(())}};\n let native=if prior {echeck(&b,K)}else{Err(Error::Parse)};\n assert_eq!(native,if prior{expected}else{Err(Error::Parse)});\n let _=J;\n}\n#[kani::proof] #[kani::unwind(10)] fn LPg_echeck0(){step::<false,0>()}\n#[kani::proof] #[kani::unwind(10)] fn LPg_echeck1(){step::<true,0>()}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPh_candidate.rs", "exists": true, "sha256": "12a35fab6fece7c3395f04a8ab931b4d6edd4444e151af78916dd87bfc434d53", "text": "use super::*;\nfn view<const EMPTY:bool>(){\n let mut p:[u8;compact::OFF_OPENINGS]=kani::any();for j in compact::OFF_INACTIVE..compact::OFF_ROUND0{p[j]=0;}\n let sem:[u8;1]=kani::any();let y:[u8;1]=kani::any();\n let a=if EMPTY{&sem[..0]}else{&sem[..]};let b=if EMPTY{&y[..0]}else{&y[..]};let ap=a.as_ptr();let bp=b.as_ptr();\n let got=wide_view(&p,a,b).unwrap();assert!(core::ptr::eq(got.semantic.as_ptr(),ap));assert!(core::ptr::eq(got.y1.as_ptr(),bp));\n assert_eq!(got.semantic.len(),a.len());assert_eq!(got.y1.len(),b.len());\n assert!(core::ptr::eq(got.folded_root.unwrap().as_ptr(),p[compact::OFF_FOLDED_ROOT..compact::OFF_ROUND1].as_ptr()));\n}\n#[kani::proof] #[kani::unwind(35)] fn LPh_nonempty(){view::<false>()}\n#[kani::proof] #[kani::unwind(35)] fn LPh_empty_backed(){view::<true>()}\nfn identity<'a>(a:&'a[u8],b:&'a[u8])->(&'a[u8],&'a[u8]){(a,b)}\n#[kani::proof] fn LPh_zst_identity(){\n let a:[u8;0]=kani::any();let b:[u8;0]=kani::any();let sa:&[u8]=&a;let sb:&[u8]=&b;let ap=sa.as_ptr();let bp=sb.as_ptr();\n let (x,y)=identity(sa,sb);\n assert!(core::ptr::eq(x.as_ptr(),ap),\"captured semantic pointer\");assert!(core::ptr::eq(y.as_ptr(),bp),\"captured y1 pointer\");\n assert!(core::ptr::eq(x.as_ptr(),a.as_ptr()),\"fresh ZST semantic pointer\");assert!(core::ptr::eq(y.as_ptr(),b.as_ptr()),\"fresh ZST y1 pointer\");\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPh_compact.rs", "exists": true, "sha256": "f29d83c9490db63885627bee2266820f024bca55926893c4a27900bd01459e84", "text": "use super::*;\n#[kani::proof] #[kani::unwind(8)] fn LPh_check_window(){\n let b:[u8;464]=kani::any();let i:usize=kani::any();kani::assume(i<29);let prior:bool=kani::any();\n let mut it=b[16*i..].chunks_exact(16);let n=it.len();let c=it.next().unwrap();assert_eq!(it.len()+1,n);\n assert!(core::ptr::eq(c.as_ptr(),b[16*i..].as_ptr()));\n assert_eq!(if prior{check_values(c)}else{Err(CodecError::NonCanonical)},if prior&&QM31::from_le_bytes(c).is_some(){Ok(())}else{Err(CodecError::NonCanonical)});\n}\nfn expand<const PART:usize>(){\n let input:[u8;464]=kani::any();let mut output:[u8;928]=kani::any();let i:usize=kani::any();kani::assume(i<29);\n let j:usize=kani::any();kani::assume(j<928);kani::assume(if PART==0{j<32*i}else if PART==1{j>=32*i&&j<32*i+16}else if PART==2{j>=32*i+16&&j<32*i+32}else{j>=32*i+32});\n let old=output[j];\n {let mut src=input[16*i..].chunks_exact(16);let mut dst=output[32*i..].chunks_exact_mut(32);\n  let c=src.next().unwrap();let o=dst.next().unwrap();assert_eq!(expand_values(c,o),Ok(()));}\n let expected=if j>=32*i&&j<32*i+16{input[16*i+j-32*i]}else if j>=32*i+16&&j<32*i+32{0}else{old};\n assert_eq!(output[j],expected);\n}\n#[kani::proof] #[kani::unwind(18)] fn LPh_expand_before(){expand::<0>()}\n#[kani::proof] #[kani::unwind(18)] fn LPh_expand_low(){expand::<1>()}\n#[kani::proof] #[kani::unwind(18)] fn LPh_expand_high(){expand::<2>()}\n#[kani::proof] #[kani::unwind(18)] fn LPh_expand_after(){expand::<3>()}\n\nfn live_window<const PART:usize>(){\n let input:[u8;16]=kani::any();let mut out:[u8;96]=kani::any();let j:usize=kani::any();kani::assume(j<96);\n kani::assume(if PART==0{j<32}else if PART==1{j>=32&&j<48}else if PART==2{j>=48&&j<64}else{j>=64});\n let old=out[j];assert_eq!(expand_values(&input,&mut out[32..64]),Ok(()));\n assert_eq!(out[j],if j>=32&&j<48{input[j-32]}else if j>=48&&j<64{0}else{old});\n}\n#[kani::proof] #[kani::unwind(18)] fn LPh_live_before(){live_window::<0>()}\n#[kani::proof] #[kani::unwind(18)] fn LPh_live_low(){live_window::<1>()}\n#[kani::proof] #[kani::unwind(18)] fn LPh_live_high(){live_window::<2>()}\n#[kani::proof] #[kani::unwind(18)] fn LPh_live_after(){live_window::<3>()}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPh_dot.rs", "exists": true, "sha256": "1699d092fc3dae248f7085c61ab0cf05152ad47006c8764ae8ea9102c82cb283", "text": "use super::*;\nfn raw_spec(x:Q,y:Q)->[u64;4] {\n let [a,b,c,d]=x.0.map(u64::from); let [e,f,g,h]=y.0.map(u64::from);\n let pp=(P as u64)*(P as u64);\n let u=(c*g).wrapping_add(pp).wrapping_sub(d*h);\n let v=(c*h).wrapping_add(d*g);\n let u=(u & P as u64).wrapping_add(u>>31);\n let v=(v & P as u64).wrapping_add(v>>31);\n [(a*e).wrapping_add(pp).wrapping_sub(b*f).wrapping_add(2*u).wrapping_add(3*P as u64).wrapping_sub(v),\n (a*f).wrapping_add(b*e).wrapping_add(u).wrapping_add(2*v),\n (a*g).wrapping_add(c*e).wrapping_add(2*pp).wrapping_sub(b*h).wrapping_sub(d*f),\n (a*h).wrapping_add(b*g).wrapping_add(c*f).wrapping_add(d*e)]\n}\n\nstatic mut LPh_RAW:[u64;4]=[0;4];\nfn raw_stub(a:Q,b:Q)->[u64;4]{\n for j in 0..4{assert!(a.0[j]<P && b.0[j]<P,\"LPh raw canonical input\");}\n let spec=raw_spec(a,b);let out:[u64;4]=kani::any();\n for j in 0..4{kani::assume(out[j]==spec[j]);} unsafe{LPh_RAW=out;} out\n}\nfn cell<const J:usize>(){\n let a:[u32;4]=kani::any();let b:[u32;4]=kani::any();\n for j in 0..4{kani::assume(a[j]<P && b[j]<P);}\n let a=Q::from_limbs(a).unwrap();let b=Q::from_limbs(b).unwrap();\n let old:[u64;4]=kani::any();let mut dot=Dot{sums:old};\n dot.push(a,b); let raw=unsafe{LPh_RAW};\n assert_eq!(dot.sums[J],old[J].wrapping_add((raw[J]&u64::from(P)).wrapping_add(raw[J]>>31)));\n}\n#[kani::proof] #[kani::stub(Q::raw,raw_stub)] #[kani::unwind(6)] fn LPh_cell0(){cell::<0>()}\n#[kani::proof] #[kani::stub(Q::raw,raw_stub)] #[kani::unwind(6)] fn LPh_cell1(){cell::<1>()}\n#[kani::proof] #[kani::stub(Q::raw,raw_stub)] #[kani::unwind(6)] fn LPh_cell2(){cell::<2>()}\n#[kani::proof] #[kani::stub(Q::raw,raw_stub)] #[kani::unwind(6)] fn LPh_cell3(){cell::<3>()}\n#[kani::proof] #[kani::stub_verified(reduce)] #[kani::unwind(6)]\nfn LPh_finish_canonical(){let sums:[u64;4]=kani::any();let q=Dot{sums}.finish();for j in 0..4{assert!(q.0[j]<P);}}\n\n#[kani::proof_for_contract(reduce)] #[kani::unwind(6)] fn LPh_reduce_contract(){reduce(kani::any());}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPh_verifier.rs", "exists": true, "sha256": "a2083af7462db9999f00dfde4d0afcf8838ba538074514780368ac77f7d135f2", "text": "use super::*;\nfn step<const K:bool>(){\n let b:[u8;928]=kani::any();let i:usize=kani::any();kani::assume(i<29);\n let prior:bool=kani::any();let suffix=&b[32*i..];let mut it=suffix.chunks_exact(32);\n let before=it.len();let c=it.next().unwrap();assert_eq!(it.len()+1,before);\n assert_eq!(c.len(),32);assert!(core::ptr::eq(c.as_ptr(),b[32*i..].as_ptr()));\n let expected=match E::from_le_bytes(c){None=>Err(Error::Parse),Some(x)=>if K&&x.c1()!=K::ZERO{Err(Error::Parse)}else{Ok(())}};\n let native=if prior{echeck(c,K)}else{Err(Error::Parse)};\n assert_eq!(native,if prior{expected}else{Err(Error::Parse)});\n}\n#[kani::proof] #[kani::unwind(10)] fn LPh_echeck0(){step::<false>()}\n#[kani::proof] #[kani::unwind(10)] fn LPh_echeck1(){step::<true>()}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPh_wire.rs", "exists": true, "sha256": "2a46fae63598ebe7eed7ec550bab1b2e387088a28b6950f94894e544a6df2e8e", "text": "use super::*;\n#[kani::proof] #[kani::unwind(10)] fn LPh_validate_window(){\n let b:[u8;3712]=kani::any();let i:usize=kani::any();kani::assume(i<116);let row:u8=kani::any();\n let prior:Result<(),Error>=if kani::any(){Ok(())}else{let earlier:usize=kani::any();kani::assume(earlier<=i);Err(Error::NonCanonical{row,value:earlier})};\n let mut chunks=b[32*i..].chunks_exact(32);let n=chunks.len();let c=chunks.next().unwrap();assert_eq!(chunks.len()+1,n);assert!(core::ptr::eq(c.as_ptr(),b[32*i..].as_ptr()));\n // Exact one iteration from validate_record_fields, on the arbitrary enumeration pre-state i.\n let actual=prior.and_then(|()|{let x=WideExact::from_le_bytes(c).ok_or(Error::NonCanonical{row,value:i})?;if x.c1()!=QM31::ZERO{return Err(Error::NonCanonical{row,value:i});}Ok(())});\n let step=validate_record_fields(row,c).map_err(|_|Error::NonCanonical{row,value:i});\n assert_eq!(actual,prior.and(step));\n}\nfn decode_fixed<const OFF:usize>(){\n let b:[u8;5+32*116]=kani::any();let row:u8=kani::any();kani::assume(row>=14);\n let got=ValidatedRecord{row,framed:&b}.decode_k::<1>(OFF);let expected=QM31::from_le_bytes(&b[5+32*OFF..21+32*OFF]);\n match(got,expected){(Ok([a]),Some(b))=>{assert_eq!(a.c0.a.0,b.c0.a.0);assert_eq!(a.c0.b.0,b.c0.b.0);assert_eq!(a.c1.a.0,b.c1.a.0);assert_eq!(a.c1.b.0,b.c1.b.0);},(Err(e),None)=>assert_eq!(e,Error::NonCanonical{row,value:OFF}),_=>panic!(\"LPh fixed decode disagreement\")}\n}\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode0(){decode_fixed::<0>()}\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode1(){decode_fixed::<1>()}\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode14(){decode_fixed::<14>()}\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode16(){decode_fixed::<16>()}\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode27(){decode_fixed::<27>()}\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode30(){decode_fixed::<30>()}\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode43(){decode_fixed::<43>()}\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode44(){decode_fixed::<44>()}\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode57(){decode_fixed::<57>()}\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode58(){decode_fixed::<58>()}\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode59(){decode_fixed::<59>()}\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode72(){decode_fixed::<72>()}\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode74(){decode_fixed::<74>()}\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode85(){decode_fixed::<85>()}\n\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode_class16(){let k:u8=kani::any();kani::assume(k<6);match k{0=>decode_fixed::<16>(),1=>decode_fixed::<17>(),2=>decode_fixed::<18>(),3=>decode_fixed::<19>(),4=>decode_fixed::<20>(),5=>decode_fixed::<21>(),_=>unreachable!()}}\n\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode_class22(){let k:u8=kani::any();kani::assume(k<6);match k{0=>decode_fixed::<22>(),1=>decode_fixed::<23>(),2=>decode_fixed::<24>(),3=>decode_fixed::<25>(),4=>decode_fixed::<26>(),5=>decode_fixed::<27>(),_=>unreachable!()}}\n\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode_class74(){let k:u8=kani::any();kani::assume(k<6);match k{0=>decode_fixed::<74>(),1=>decode_fixed::<75>(),2=>decode_fixed::<76>(),3=>decode_fixed::<77>(),4=>decode_fixed::<78>(),5=>decode_fixed::<79>(),_=>unreachable!()}}\n\n#[kani::proof] #[kani::unwind(10)] fn LPh_decode_class80(){let k:u8=kani::any();kani::assume(k<6);match k{0=>decode_fixed::<80>(),1=>decode_fixed::<81>(),2=>decode_fixed::<82>(),3=>decode_fixed::<83>(),4=>decode_fixed::<84>(),5=>decode_fixed::<85>(),_=>unreachable!()}}\n\n#[kani::proof] #[kani::unwind(10)] fn LPh_validate_index(){\n let c:[u8;32]=kani::any();let i:usize=kani::any();kani::assume(i<116);let row:u8=kani::any();\n let prior:Result<(),Error>=if kani::any(){Ok(())}else{let earlier:usize=kani::any();kani::assume(earlier<=i);Err(Error::NonCanonical{row,value:earlier})};\n let actual=prior.and_then(|()|{let x=WideExact::from_le_bytes(&c).ok_or(Error::NonCanonical{row,value:i})?;if x.c1()!=QM31::ZERO{return Err(Error::NonCanonical{row,value:i});}Ok(())});\n let expected=prior.and(validate_record_fields(row,&c).map_err(|_|Error::NonCanonical{row,value:i}));assert_eq!(actual,expected);\n}\nfn decode_write<const PART:usize>(){\n let b:[u8;37]=kani::any();let i:usize=kani::any();let j:usize=kani::any();kani::assume(i<29&&j<29);\n kani::assume(if PART==0{j<i}else if PART==1{j==i}else{j>i});\n let raw:[u8;464]=kani::any();let old:[[u32;4];29]=unsafe{core::mem::transmute(raw)};let mut out=old;\n let decoded=ValidatedRecord{row:25,framed:&b}.decode_k::<1>(0);\n let value=QM31::from_le_bytes(&b[5..21]);\n let status=match decoded{Ok([q])=>{out[i]=[q.c0.a.0,q.c0.b.0,q.c1.a.0,q.c1.b.0];Ok(())},Err(e)=>Err(e)};\n match value{\n Some(q)=>{assert_eq!(status,Ok(()));let expected=if i==j{[q.c0.a.0,q.c0.b.0,q.c1.a.0,q.c1.b.0]}else{old[j]};for k in 0..4{assert_eq!(out[j][k],expected[k]);}},\n None=>{assert_eq!(status,Err(Error::NonCanonical{row:25,value:0}));for k in 0..4{assert_eq!(out[j][k],old[j][k]);}}\n }\n}\n#[kani::proof] #[kani::unwind(10)] fn LPh_write_before(){decode_write::<0>()}\n#[kani::proof] #[kani::unwind(10)] fn LPh_write_cell(){decode_write::<1>()}\n#[kani::proof] #[kani::unwind(10)] fn LPh_write_after(){decode_write::<2>()}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPl_check.rs", "exists": true, "sha256": "88cb1ef60223fb5817025865668006715207457f9224cd61709d0af90bb0359b", "text": "use super::*;\nfn le(b:&[u8])->u64{u64::from(b[0])+256*(u64::from(b[1])+256*(u64::from(b[2])+256*u64::from(b[3])))}\nfn predicate(b:&[u8])->bool{let mut good=true;for j in 0..4{good=good&&le(&b[4*j..4*j+4])<2147483647;}good}\n#[kani::proof] #[kani::unwind(8)] fn LPl_decoder(){\n let b:[u8;16]=kani::any();let prior:bool=kani::any();\n assert_eq!(QM31::from_le_bytes(&b).is_some(),predicate(&b));\n assert_eq!(if prior{check_values(&b)}else{Err(CodecError::NonCanonical)},if prior&&predicate(&b){Ok(())}else{Err(CodecError::NonCanonical)});\n}\n#[kani::proof] #[kani::unwind(8)] fn LPl_iterator(){\n let b:[u8;464]=kani::any();let i:usize=kani::any();kani::assume(i<=29);\n let mut it=b[16*i..].chunks_exact(16);assert_eq!(it.len(),29-i);assert_eq!(it.remainder().len(),0);\n match it.next(){None=>{assert_eq!(i,29);assert_eq!(it.len(),0);},Some(c)=>{\n  assert!(i<29);assert_eq!(c.len(),16);assert!(core::ptr::eq(c.as_ptr(),b[16*i..].as_ptr()));assert_eq!(it.len(),29-(i+1));\n  match it.next(){None=>assert_eq!(i+1,29),Some(next)=>{assert!(i+1<29);assert!(core::ptr::eq(next.as_ptr(),b[16*(i+1)..].as_ptr()));}}\n }}\n}\n#[kani::proof] #[kani::unwind(8)] fn LPl_nonvacuity(){\n assert_eq!(check_values(&[0u8;16]),Ok(()));assert_eq!(check_values(&[]),Ok(()));\n let mut bad=[0u8;16];bad[0]=255;bad[1]=255;bad[2]=255;bad[3]=127;assert_eq!(check_values(&bad),Err(CodecError::NonCanonical));\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPl_echeck.rs", "exists": true, "sha256": "53ecddf79c1acbdb58af4fcae5df50d186a3de08691683a9f055443a5b8ed17a", "text": "use super::*;\n// Same base-256 polynomial as LPl_Kit_Bytes.le32, in a nonwrapping u64 carrier.\nfn le(b:&[u8])->u64{u64::from(b[0])+256*(u64::from(b[1])+256*(u64::from(b[2])+256*u64::from(b[3])))}\nfn predicate(b:&[u8],k:bool)->bool{\n let mut good=true;\n for j in 0..8 {let n=le(&b[4*j..4*j+4]);good=good&&(n<2147483647)&&(!k||j<4||n==0);}\n good\n}\n#[kani::proof] #[kani::unwind(10)]\nfn LPl_decoder(){\n let b:[u8;32]=kani::any();let k:bool=kani::any();\n let native=match E::from_le_bytes(&b){None=>false,Some(x)=>!k||x.c1()==K::ZERO};\n assert_eq!(native,predicate(&b,k));\n}\n#[kani::proof] #[kani::unwind(10)]\nfn LPl_iterator(){\n let b:[u8;928]=kani::any();let i:usize=kani::any();kani::assume(i<=29);\n let tail=&b[32*i..];let mut it=tail.chunks_exact(32);\n assert_eq!(it.len(),29-i);assert_eq!(it.remainder().len(),0);\n match it.next(){\n  None=>{assert_eq!(i,29);assert_eq!(it.len(),0);},\n  Some(c)=>{assert!(i<29);assert_eq!(c.len(),32);assert!(core::ptr::eq(c.as_ptr(),b[32*i..].as_ptr()));\n   assert_eq!(it.len(),29-(i+1));\n   if let Some(next)=it.next(){assert!(i+1<29);assert!(core::ptr::eq(next.as_ptr(),b[32*(i+1)..].as_ptr()));}\n   else {assert_eq!(i+1,29);}\n  }\n }\n}\n#[kani::proof] #[kani::unwind(10)]\nfn LPl_step(){\n let b:[u8;32]=kani::any();let k:bool=kani::any();let prior:bool=kani::any();\n let native=if prior {echeck(&b,k)}else{Err(Error::Parse)};\n assert_eq!(native,if prior&&predicate(&b,k){Ok(())}else{Err(Error::Parse)});\n}\n#[kani::proof] #[kani::unwind(10)]\nfn LPl_nonvacuity(){\n let zero=[0u8;32];assert_eq!(echeck(&zero,false),Ok(()));assert_eq!(echeck(&zero,true),Ok(()));\n let mut high=zero;high[16]=1;assert_eq!(echeck(&high,false),Ok(()));assert_eq!(echeck(&high,true),Err(Error::Parse));\n let mut bad=zero;bad[0]=255;bad[1]=255;bad[2]=255;bad[3]=127;assert_eq!(echeck(&bad,false),Err(Error::Parse));\n assert_eq!(echeck(&[],true),Ok(()));\n}\n// Replaces the overly narrow whole-release domain claim, not a timed-out run.\n// Only iterator metadata is inspected; no whole-buffer field loop is executed.\n#[kani::proof] #[kani::unwind(10)]\nfn LPl_release_iterator(){\n let b:[u8;2272]=kani::any();let n:usize=kani::any();kani::assume(n<=2272);\n let i:usize=kani::any();kani::assume(i<=n/32);\n let mut it=b[32*i..n].chunks_exact(32);\n assert_eq!(it.len(),n/32-i);assert_eq!(it.remainder().len(),n%32);\n assert!(core::ptr::eq(it.remainder().as_ptr(),b[n-n%32..n].as_ptr()));\n match it.next(){None=>{assert_eq!(i,n/32);assert_eq!(it.len(),0);},Some(c)=>{\n  assert!(i<n/32);assert_eq!(c.len(),32);assert!(core::ptr::eq(c.as_ptr(),b[32*i..].as_ptr()));assert_eq!(it.len(),n/32-(i+1));\n  match it.next(){None=>assert_eq!(i+1,n/32),Some(next)=>{assert!(i+1<n/32);assert!(core::ptr::eq(next.as_ptr(),b[32*(i+1)..].as_ptr()));}}\n }}\n}\n#[kani::proof]\nfn LPl_release_domains(){\n use crate::compact as c;\n assert_eq!(c::OFF_INACTIVE-c::OFF_Y1,464);\n assert_eq!(c::OFF_FOLDED_ROOT-c::OFF_ROUND0,224);\n assert_eq!(c::OFF_OPENINGS-c::OFF_ROUND1,2272);\n assert!(32<=2272&&224<=2272&&800-672<=2272);\n assert_eq!(c::FINAL_LEN,64);\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-leaf-p6-13-20261027/LPo_src/crates/aspis-r1-cost-probe/src/LPl_expand.rs", "exists": true, "sha256": "4bb30b66feedeaae3e199b7781047a84c8ea522b2d49a26340ff4ea40e72d002", "text": "use super::*;\n#[kani::proof] #[kani::unwind(10)]\nfn LPl_iterator(){\n let input:[u8;1856]=kani::any();let mut out:[u8;3712]=kani::any();\n let n:usize=kani::any();kani::assume(n<=1856&&n%16==0);\n let i:usize=kani::any();kani::assume(i<=n/16);\n let source=input.as_ptr();let dest=out.as_mut_ptr();\n let mut src=input[..n].chunks_exact(16);let mut dst=out[..2*n].chunks_exact_mut(32);\n if i>0{assert!(src.nth(i-1).is_some());assert!(dst.nth(i-1).is_some());}\n let mut it=src.zip(dst);assert_eq!(it.len(),n/16-i);\n match it.next(){None=>{assert_eq!(i,n/16);assert_eq!(it.len(),0);},Some((c,o))=>{\n  assert!(i<n/16);assert_eq!(c.len(),16);assert_eq!(o.len(),32);\n  assert!(core::ptr::eq(c.as_ptr(),source.wrapping_add(16*i)));assert!(core::ptr::eq(o.as_ptr(),dest.wrapping_add(32*i)));\n  assert_eq!(it.len(),n/16-(i+1));\n  match it.next(){None=>assert_eq!(i+1,n/16),Some((c,o))=>{\n   assert!(i+1<n/16);assert!(core::ptr::eq(c.as_ptr(),source.wrapping_add(16*(i+1))));assert!(core::ptr::eq(o.as_ptr(),dest.wrapping_add(32*(i+1))));}}\n }}\n}\n#[kani::proof] #[kani::unwind(18)]\nfn LPl_length_error(){\n let input:[u8;1856]=kani::any();let mut out:[u8;3712]=kani::any();\n let n:usize=kani::any();let m:usize=kani::any();kani::assume(n<=1856&&m<=3712);kani::assume(n%16!=0||m!=2*n);\n let j:usize=kani::any();kani::assume(j<3712);let old=out[j];\n assert_eq!(expand_values(&input[..n],&mut out[..m]),Err(CodecError::Length));assert_eq!(out[j],old);\n}\n#[kani::proof] #[kani::unwind(18)]\nfn LPl_nonvacuity(){\n let input:[u8;16]=kani::any();let mut out=[99u8;32];let j:usize=kani::any();kani::assume(j<32);\n assert_eq!(expand_values(&input,&mut out),Ok(()));assert_eq!(out[j],if j<16{input[j]}else{0});\n assert_eq!(expand_values(&[],&mut []),Ok(()));\n let row:u8=kani::any();if row>=14&&row<=26{let size=row_shape(row).unwrap().1;assert!(size/2<=1856);assert!(size<=3712);assert_eq!(size%32,0);}\n}\n// Separate arbitrary16-byte source from its global pointer carrier (K012).\n// Split each destination-frame class; no full464/1856-byte source mux.\nfn frame<const PART:usize>(){\n let input:[u8;16]=kani::any();let mut out:[u8;3712]=kani::any();\n let row:usize=kani::any();let j:usize=kani::any();kani::assume(row<116&&j<3712);\n let at=32*row;kani::assume(if PART==0{j<at}else if PART==1{j>=at&&j<at+16}else if PART==2{j>=at+16&&j<at+32}else{j>=at+32});\n let old=out[j];assert_eq!(expand_values(&input,&mut out[at..at+32]),Ok(()));\n assert_eq!(out[j],if PART==1{input[j-at]}else if PART==2{0}else{old});\n}\n#[kani::proof] #[kani::unwind(18)] fn LPl_frame_before(){frame::<0>()}\n#[kani::proof] #[kani::unwind(18)] fn LPl_frame_low(){frame::<1>()}\n#[kani::proof] #[kani::unwind(18)] fn LPl_frame_high(){frame::<2>()}\n#[kani::proof] #[kani::unwind(18)] fn LPl_frame_after(){frame::<3>()}\n// Constant-offset replacement for K014's timed-out symbolic destination mux.\nfn fixed<const ROW:usize>(){\n let input:[u8;16]=kani::any();let mut out:[u8;3712]=kani::any();let j:usize=kani::any();kani::assume(j<3712);\n let old=out[j];let at=32*ROW;assert_eq!(expand_values(&input,&mut out[at..at+32]),Ok(()));\n assert_eq!(out[j],if j>=at&&j<at+16{input[j-at]}else if j>=at+16&&j<at+32{0}else{old});\n}\n#[kani::proof] #[kani::unwind(18)] fn LPl_fixed_probe(){fixed::<1>()}\n// No global symbolic store offset: all116 rows are an exhaustive disjoint set\n// of constant-offset classes, with shared arbitrary input/output/j per class.\n#[inline(always)]\nfn constant<const ROW:usize>(input:&[u8;16],out:&mut[u8;3712],j:usize,old:u8){\n let at=32*ROW;assert_eq!(expand_values(input,&mut out[at..at+32]),Ok(()));\n assert_eq!(out[j],if j>=at&&j<at+16{input[j-at]}else if j>=at+16&&j<at+32{0}else{old});\n}\nfn guard(){\n let n:usize=kani::any();let m:usize=kani::any();kani::assume(n<=1856&&m<=3712);\n let native=n%16!=0||m!=2*n;\n let natural=(n as u128)%16!=0||(m as u128)!=2*(n as u128);\n assert_eq!(native,natural);assert_eq!((2*n)as u128,2*(n as u128));\n}\n\n#[kani::proof] #[kani::unwind(18)] fn LPl_class0(){\n guard();\n let input:[u8;16]=kani::any();let mut out:[u8;3712]=kani::any();let j:usize=kani::any();kani::assume(j<3712);let old=out[j];\n let c:u8=kani::any();kani::assume(c<8);match c{\n 0=>constant::<0>(&input,&mut out,j,old),\n 1=>constant::<1>(&input,&mut out,j,old),\n 2=>constant::<2>(&input,&mut out,j,old),\n 3=>constant::<3>(&input,&mut out,j,old),\n 4=>constant::<4>(&input,&mut out,j,old),\n 5=>constant::<5>(&input,&mut out,j,old),\n 6=>constant::<6>(&input,&mut out,j,old),\n 7=>constant::<7>(&input,&mut out,j,old),\n _=>unreachable!()}\n}\n\n#[kani::proof] #[kani::unwind(18)] fn LPl_class8(){\n let input:[u8;16]=kani::any();let mut out:[u8;3712]=kani::any();let j:usize=kani::any();kani::assume(j<3712);let old=out[j];\n let c:u8=kani::any();kani::assume(c<8);match c{\n 0=>constant::<8>(&input,&mut out,j,old),\n 1=>constant::<9>(&input,&mut out,j,old),\n 2=>constant::<10>(&input,&mut out,j,old),\n 3=>constant::<11>(&input,&mut out,j,old),\n 4=>constant::<12>(&input,&mut out,j,old),\n 5=>constant::<13>(&input,&mut out,j,old),\n 6=>constant::<14>(&input,&mut out,j,old),\n 7=>constant::<15>(&input,&mut out,j,old),\n _=>unreachable!()}\n}\n\n#[kani::proof] #[kani::unwind(18)] fn LPl_class16(){\n let input:[u8;16]=kani::any();let mut out:[u8;3712]=kani::any();let j:usize=kani::any();kani::assume(j<3712);let old=out[j];\n let c:u8=kani::any();kani::assume(c<8);match c{\n 0=>constant::<16>(&input,&mut out,j,old),\n 1=>constant::<17>(&input,&mut out,j,old),\n 2=>constant::<18>(&input,&mut out,j,old),\n 3=>constant::<19>(&input,&mut out,j,old),\n 4=>constant::<20>(&input,&mut out,j,old),\n 5=>constant::<21>(&input,&mut out,j,old),\n 6=>constant::<22>(&input,&mut out,j,old),\n 7=>constant::<23>(&input,&mut out,j,old