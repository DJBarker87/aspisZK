{"path": "/home/dombarker/project-offloads/codex-cx-native-tx2d-20261027/NBH_src/crates/aspis-statement/src/pool_v1/NBH_terminal.rs", "exists": true, "sha256": "f7355287bd9876f09e2db6bed4bd70106eb3509a8f8ba84e339a40115e66cd84", "text": "use super::*;\nfn NBH_asq8_header(bytes: &[u8])->Result<(),PoolV1PairForestTerminalFormatErrorV1> {\n    if bytes.len() != POOL_V1_PAIR_FOREST_TERMINAL_REQUEST_BYTES {\n        return Err(PoolV1PairForestTerminalFormatErrorV1::WrongLength);\n    }\n    if bytes[..4] != POOL_V1_PAIR_FOREST_TERMINAL_REQUEST_MAGIC {\n        return Err(PoolV1PairForestTerminalFormatErrorV1::WrongMagic);\n    }\n    if bytes[4] != POOL_V1_PAIR_FOREST_TERMINAL_VERSION {\n        return Err(PoolV1PairForestTerminalFormatErrorV1::WrongVersion);\n    }\n    let kind = transition_kind(bytes[5])?;\n    if bytes[6] != POOL_V1_DIGEST_ENCODING_VERSION {\n        return Err(PoolV1PairForestTerminalFormatErrorV1::WrongDigestEncoding);\n    }\n    if bytes[7] != 0 {\n        return Err(PoolV1PairForestTerminalFormatErrorV1::NonZeroBinding);\n    }\n Ok(())}\n#[kani::proof]\nfn NBH_asq8_header_gate() {let raw:[u8;321]=kani::any();let n:usize=kani::any();kani::assume(n<=321);let bytes=&raw[..n];assert_eq!(NBH_asq8_header(bytes),if bytes.len()!=320 {Err(PoolV1PairForestTerminalFormatErrorV1::WrongLength)} else if &bytes[..4]!=b\"ASQ8\" {Err(PoolV1PairForestTerminalFormatErrorV1::WrongMagic)} else if bytes[4]!=1 {Err(PoolV1PairForestTerminalFormatErrorV1::WrongVersion)} else if bytes[5]!=1 && bytes[5]!=2 {Err(PoolV1PairForestTerminalFormatErrorV1::InvalidTransitionKind)} else if bytes[6]!=1 {Err(PoolV1PairForestTerminalFormatErrorV1::WrongDigestEncoding)} else if bytes[7]!=0 {Err(PoolV1PairForestTerminalFormatErrorV1::NonZeroBinding)} else {Ok(())});}\nfn NBH_asf8_stores(kind:u8,lane:u8,master:[u8;32],checkpoint:[u8;32],selected:[u8;32],seq:u64,anchor:[u8;32])->[u8;1880]{    let mut output = [0u8; POOL_V1_PAIR_FOREST_TERMINAL_STATEMENT_BYTES];\n    output[..4].copy_from_slice(&POOL_V1_PAIR_FOREST_TERMINAL_STATEMENT_MAGIC);\n    output[4] = POOL_V1_PAIR_FOREST_TERMINAL_VERSION;\n    output[5] = kind;\n    output[6] = POOL_V1_DIGEST_ENCODING_VERSION;\n    output[7] = lane;\n    output[MASTER_OFFSET..CHECKPOINT_ACCOUNT_OFFSET].copy_from_slice(&master);\n    output[CHECKPOINT_ACCOUNT_OFFSET..SELECTED_LANE_ACCOUNT_OFFSET]\n        .copy_from_slice(&checkpoint);\n    output[SELECTED_LANE_ACCOUNT_OFFSET..CHECKPOINT_SEQUENCE_OFFSET]\n        .copy_from_slice(&selected);\n    output[CHECKPOINT_SEQUENCE_OFFSET..HISTORICAL_ANCHOR_OFFSET]\n        .copy_from_slice(&seq.to_le_bytes());\n    output[HISTORICAL_ANCHOR_OFFSET..LATE_STATEMENT_OFFSET]\n        .copy_from_slice(&anchor);\noutput}\n#[kani::proof]\nfn NBH_asf8_stores_gate(){let kind:u8=kani::any();let lane:u8=kani::any();let master:[u8;32]=kani::any();let checkpoint:[u8;32]=kani::any();let selected:[u8;32]=kani::any();let seq:u64=kani::any();let anchor:[u8;32]=kani::any();let out=NBH_asf8_stores(kind,lane,master,checkpoint,selected,seq,anchor);let j:usize=kani::any();kani::assume(j<1880);let expected=if j<4{b\"ASF8\"[j]}else if j==4{1}else if j==5{kind}else if j==6{1}else if j==7{lane}else if j<40{master[j-8]}else if j<72{checkpoint[j-40]}else if j<104{selected[j-72]}else if j<112{seq.to_le_bytes()[j-104]}else if j<144{anchor[j-112]}else{0};assert_eq!(out[j],expected);}\n"}
