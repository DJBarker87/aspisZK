 [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Native differential evidence only (D68.2): retains the pre-migration\n# pair-forest compiler (legacy writers plus relocation) as\n# `pair_forest_trace::reference`, so the shipped copy-built compiler can be\n# compared with it. Never selected by a prover or program build.\npool-v1-pair-forest-writer-reference = []\n\n[dependencies]\naspis-core.workspace = true\n\n# The shipped pair-forest trace writers are the extracted copies (D68.2). They\n# are host-only, like the trace compiler that calls them; SBF builds never\n# compile them.\n[target.'cfg(not(target_os = \"solana\"))'.dependencies]\naspis-r0-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/writers\" }\naspis-r0-block-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/blockwriters\" }\naspis-r0-poseidon-copy = { path = \"../../docs/research/v8-r0-zk-20261009/refine/poseidon\" }\n\n[dev-dependencies]\np3-field = \"=0.6.1\"\np3-mersenne-31 = \"=0.6.1\"\np3-symmetric = \"=0.6.1\"\nsha2.workspace = true\n\n[[test]]\nname = \"pair_forest_writer_migration\"\nrequired-features = [\"pool-v1-pair-forest-writer-reference\"]\n", "root_manifest_sha256": "ba08c65cafc60a7a747457163e72a1d184068a239466516f3a3e8bdb4ab8c9f2", "manifest": "/home/dombarker/project-offloads/codex-cx-native-tx2e-20261027/NBK_src/crates/aspis-statement/Cargo.toml", "features": "", "no_default": false, "receipts": ["NBK_K039", "NBK_K006", "NBK_K001", "NBK_K008", "NBK_K037", "NBK_K030", "NBK_K055", "NBK_K052", "NBK_K031", "NBK_K009", "NBK_K036", "NBK_K038", "NBK_K007", "NBK_K053", "NBK_K054", "NBK_K047", "NBK_K040", "NBK_K049", "NBK_K025", "NBK_K022", "NBK_K014", "NBK_K013", "NBK_K048", "NBK_K041", "NBK_K046", "NBK_K012", "NBK_K015", "NBK_K023", "NBK_K024", "NBK_K060", "NBK_K058", "NBK_K051", "NBK_K056", "NBK_K002", "NBK_K005", "NBK_K033", "NBK_K034", "NBK_K057", "NBK_K050", "NBK_K059", "NBK_K035", "NBK_K032", "NBK_K004", "NBK_K003", "NBK_K021", "NBK_K026", "NBK_K019", "NBK_K010", "NBK_K017", "NBK_K028", "NBK_K043", "NBK_K044", "NBK_K016", "NBK_K029", "NBK_K011", "NBK_K027", "NBK_K018", "NBK_K020", "NBK_K045", "NBK_K042"], "nodes": [{"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2e-20261027/NBK_src/crates/aspis-core#0.1.0", "name": "aspis-core", "version": "0.1.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2e-20261027/NBK_src/docs/research/v8-r0-zk-20261009/refine/blockwriters#aspis-r0-block-writer-copies@0.0.0", "name": "aspis-r0-block-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2e-20261027/NBK_src/docs/research/v8-r0-zk-20261009/refine/poseidon#aspis-r0-poseidon-copy@0.0.0", "name": "aspis-r0-poseidon-copy", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2e-20261027/NBK_src/docs/research/v8-r0-zk-20261009/refine/writers#aspis-r0-writer-copies@0.0.0", "name": "aspis-r0-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2e-20261027/NBK_src/crates/aspis-statement#0.1.0", "name": "aspis-statement", "version": "0.1.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_1#ncs-historical-root@0.0.0", "name": "ncs-historical-root", "version": "0.0.0", "features": []}], "local_manifests": {"/home/dombarker/project-offloads/codex-cx-native-tx2e-20261027/NBK_src/crates/aspis-core/Cargo.toml": "[package]\nname = \"aspis-core\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"Aspis native WHIR-style M31 PCS substrate: shared no_std verifier core (host + SBF byte-exact)\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = []\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = []\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = []\n# R0 semantic rows use their own wire, transcript and entrypoints.\nr0 = []\n# Native single-thread operation accounting only; never part of SBF measurements.\nr0-op-count = []\n# Exposes deliberately weakened Fiat-Shamir schedules solely so adversarial\n# tests can demonstrate their teeth. Never enable in a deployed verifier.\ninsecure-test-ordering = []\n# Exposes a verifier mode that deliberately misclassifies the diagnostic M31\n# basis as the legacy CM31 wire shape. Teeth tests only; never deploy.\ninsecure-test-framing = []\n# Exposes private decoder entry points to the isolated universal-equivalence\n# harness. This feature is never enabled by the verifier build.\nformal-verification = []\n# Default-off byte-for-CU experiment. This changes only the fixed-field wire\n# representation and is never enabled by a selected production build.\nv7-fixed-canonical-audit = []\n# Follow-up to the canonical fixed-field experiment.  The fixed records are\n# still checked by their one-pass transcript reader, while packed query limbs\n# are checked only by the gamma/opening consumer that already decodes all of\n# them.  This removes the audit parser's duplicate query-wide canonical scan.\nv7-fixed-canonical-exact-once-audit = [\"v7-fixed-canonical-audit\"]\n# Audit-only loop interchange for the fixed four-slot C1 gamma dot product.\n# The packed bytes, canonical decoder, powers, and resulting four QM31 values\n# are unchanged; only the order in which the same scalar products are summed\n# is specialized to reuse each 26-column power row across all four slots.\nv7-gamma-four-slot-block-audit = []\n\n[dependencies]\n\n[dev-dependencies]\nnum-bigint = \"0.4\"\nserde_json = \"1\"\nsha2 = \"0.10.8\"\n# Property/fuzz-style harnesses run on the pinned stable toolchain via\n# `cargo test`; cargo-fuzz's nightly+libFuzzer requirement would break the\n# stable pin, so the attack-surface fuzzing is expressed as proptest.\nproptest = \"1\"\n", "/home/dombarker/project-offloads/codex-cx-native-tx2e-20261027/NBK_src/docs/research/v8-r0-zk-20261009/refine/blockwriters/Cargo.toml": "[package]\nname = \"aspis-r0-block-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-native-tx2e-20261027/NBK_src/docs/research/v8-r0-zk-20261009/refine/poseidon/Cargo.toml": "[package]\nname = \"aspis-r0-poseidon-copy\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-native-tx2e-20261027/NBK_src/docs/research/v8-r0-zk-20261009/refine/writers/Cargo.toml": "[package]\nname = \"aspis-r0-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-native-tx2e-20261027/NBK_src/crates/aspis-statement/Cargo.toml": "[package]\nname = \"aspis-statement\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"No-proof SpendV0 evaluator and constraint-composition kernels for Aspis\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = [\"aspis-core/r0-r91-audit\"]\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = [\"aspis-core/r0-e4-reference\"]\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = [\"aspis-core/r0-hoist-reference\"]\nr0 = [\"aspis-core/r0\"]\n# Exposes the deliberately broken lambda^0 tagged-tuple compression solely\n# for adversarial teeth/evaluation builds. The verifier program does not\n# forward this feature; enabling it requires an explicit dependency feature.\ninsecure-test-logup-compression = []\n# Derive only the public RATE512 circle/line coordinates touched by Spend\n# queries. This preserves the proof and verifier equations while allowing a\n# deployment build to dead-strip the six complete RATE512 lookup tables.\nspend-dynamic-rate512 = []\n# Host by default; the separate Pool V1 program enables this explicitly for\n# SBF. Frozen verifier builds do not enable it.\npool-v1-kernel = []\n# Audit-only algebraic rewrite for the pair-forest public-digest constraints.\n# It packs each four-lane residual before applying its common selector; the\n# default and released terminal retain the literal lane-by-lane evaluator.\npool-v1-pair-forest-packed-digest-audit = []\n# Audit-only selector-tensor continuation of packed digest binding. Each\n# binding keeps its two packed residuals, while `high[block] * low[local]` is\n# contracted as three exact local-coordinate sums.\npool-v1-pair-forest-packed-digest-selector-tensor-audit = [\n    \"pool-v1-pair-forest-packed-digest-audit\",\n]\n# Audit-only exact `{0,1}` specialization for generated pair-forest Copy\n# weights. The literal QM31-by-M31 multiplication remains the default.\npool-v1-pair-forest-binary-copy-weights-audit = []\n# Audit-only memoization of generated Copy endpoint row selectors. The cache\n# never supplies a value unless its stored row tag matches exactly.\npool-v1-pair-forest-endpoint-selector-cache-audit = []\n# Audit-only exact common-factor extraction in the selected semantic lanes.\n# It preserves all 94 source residuals and their 24 packed theta lanes.\npool-v1-pair-forest-semantic-factor-audit = []\n# Audit-only exact CSE for the fourteen generated Copy tuple patterns.\npool-v1-pair-forest-pattern-window-audit = []\n# Audit-only exact change of basis for the compiled Copy values.  Endpoint\n# selectors are accumulated by their fixed tuple-pattern coordinate before\n# the dynamic pattern values are multiplied, replacing 272 repeated QM31\n# products by the 26 nonzero coordinates of the frozen four-by-fourteen\n# support matrix.  Tags remain included through exact M31 multiplication.\npool-v1-pair-forest-copy-pattern-basis-audit = []\npool-v1-pair-forest-packed-range-audit = []\npool-v1-pair-forest-active-mask-basis-audit = []\npool-v1-pair-forest-copy-selector-tensor-basis-audit = [\n    \"pool-v1-pair-forest-copy-pattern-basis-audit\",\n]\n# Audit-only lazy-reduction dot kernel for the generated Copy tags. Endpoint\n# products are regrouped by the exact `(side, slot, local)` tensor coordinate\n# and reduced in batches of at most four M31 products.\npool-v1-pair-forest-copy-tag-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Audit-only four-product contraction of the tag/low and weight/low tensor\n# coordinates after exact endpoint collection.\npool-v1-pair-forest-copy-finish-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Native differential evidence only (D68.2): retains the pre-migration\n# pair-forest compiler (legacy writers plus relocation) as\n# `pair_forest_trace::reference`, so the shipped copy-built compiler can be\n# compared with it. Never selected by a prover or program build.\npool-v1-pair-forest-writer-reference = []\n\n[dependencies]\naspis-core.workspace = true\n\n# The shipped pair-forest trace writers are the extracted copies (D68.2). They\n# are host-only, like the trace compiler that calls them; SBF builds never\n# compile them.\n[target.'cfg(not(target_os = \"solana\"))'.dependencies]\naspis-r0-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/writers\" }\naspis-r0-block-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/blockwriters\" }\naspis-r0-poseidon-copy = { path = \"../../docs/research/v8-r0-zk-20261009/refine/poseidon\" }\n\n[dev-dependencies]\np3-field = \"=0.6.1\"\np3-mersenne-31 = \"=0.6.1\"\np3-symmetric = \"=0.6.1\"\nsha2.workspace = true\n\n[[test]]\nname = \"pair_forest_writer_migration\"\nrequired-features = [\"pool-v1-pair-forest-writer-reference\"]\n"}}
{"case": 2, "exists": true, "command": ["cargo", "metadata", "--offline", "--format-version", "1", "--manifest-path", "/home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_2/Cargo.toml"], "exit": 0, "stderr": "", "root_manifest": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "root_manifest_sha256": "6eca3f52806da138e93e8dcce079c59ee47bc954015cefa13eb10031520b8f90", "manifest": "/home/dombarker/project-offloads/codex-cx-leaf-p6-8-20261027/LPh_src/crates/aspis-r1-cost-probe/Cargo.toml", "features": "", "no_default": false, "receipts": ["LPh_K023", "LPh_K024", "LPh_K012", "LPh_K015", "LPh_K014", "LPh_K013", "LPh_K025", "LPh_K022", "LPh_K007", "LPh_K009", "LPh_K008", "LPh_K030", "LPh_K006", "LPh_K001", "LPh_K027", "LPh_K018", "LPh_K020", "LPh_K016", "LPh_K029", "LPh_K011", "LPh_K010", "LPh_K017", "LPh_K028", "LPh_K021", "LPh_K026", "LPh_K019", "LPh_K004", "LPh_K003", "LPh_K002", "LPh_K005"], "nodes": [{"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-8-20261027/LPh_src/crates/aspis-core#0.1.0", "name": "aspis-core", "version": "0.1.0", "features": ["r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-8-20261027/LPh_src/docs/research/v8-r0-zk-20261009/refine/blockwriters#aspis-r0-block-writer-copies@0.0.0", "name": "aspis-r0-block-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-8-20261027/LPh_src/docs/research/v8-r0-zk-20261009/refine/poseidon#aspis-r0-poseidon-copy@0.0.0", "name": "aspis-r0-poseidon-copy", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-8-20261027/LPh_src/docs/research/v8-r0-zk-20261009/refine/writers#aspis-r0-writer-copies@0.0.0", "name": "aspis-r0-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-8-20261027/LPh_src/crates/aspis-r1-cost-probe#0.1.0", "name": "aspis-r1-cost-probe", "version": "0.1.0", "features": ["default", "private-leaf-salts"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-8-20261027/LPh_src/crates/aspis-statement#0.1.0", "name": "aspis-statement", "version": "0.1.0", "features": ["pool-v1-kernel", "r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_2#ncs-historical-root@0.0.0", "name": "ncs-historical-root", "version": "0.0.0", "features": []}], "local_manifests": {"/home/dombarker/project-offloads/codex-cx-leaf-p6-8-20261027/LPh_src/crates/aspis-core/Cargo.toml": "[package]\nname = \"aspis-core\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"Aspis native WHIR-style M31 PCS substrate: shared no_std verifier core (host + SBF byte-exact)\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = []\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = []\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = []\n# R0 semantic rows use their own wire, transcript and entrypoints.\nr0 = []\n# Native single-thread operation accounting only; never part of SBF measurements.\nr0-op-count = []\n# Exposes deliberately weakened Fiat-Shamir schedules solely so adversarial\n# tests can demonstrate their teeth. Never enable in a deployed verifier.\ninsecure-test-ordering = []\n# Exposes a verifier mode that deliberately misclassifies the diagnostic M31\n# basis as the legacy CM31 wire shape. Teeth tests only; never deploy.\ninsecure-test-framing = []\n# Exposes private decoder entry points to the isolated universal-equivalence\n# harness. This feature is never enabled by the verifier build.\nformal-verification = []\n# Default-off byte-for-CU experiment. This changes only the fixed-field wire\n# representation and is never enabled by a selected production build.\nv7-fixed-canonical-audit = []\n# Follow-up to the canonical fixed-field experiment.  The fixed records are\n# still checked by their one-pass transcript reader, while packed query limbs\n# are checked only by the gamma/opening consumer that already decodes all of\n# them.  This removes the audit parser's duplicate query-wide canonical scan.\nv7-fixed-canonical-exact-once-audit = [\"v7-fixed-canonical-audit\"]\n# Audit-only loop interchange for the fixed four-slot C1 gamma dot product.\n# The packed bytes, canonical decoder, powers, and resulting four QM31 values\n# are unchanged; only the order in which the same scalar products are summed\n# is specialized to reuse each 26-column power row across all four slots.\nv7-gamma-four-slot-block-audit = []\n\n[dependencies]\n\n[dev-dependencies]\nnum-bigint = \"0.4\"\nserde_json = \"1\"\nsha2 = \"0.10.8\"\n# Property/fuzz-style harnesses run on the pinned stable toolchain via\n# `cargo test`; cargo-fuzz's nightly+libFuzzer requirement would break the\n# stable pin, so the attack-surface fuzzing is expressed as proptest.\nproptest = \"1\"\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-8-20261027/LPh_src/docs/research/v8-r0-zk-20261009/refine/blockwriters/Cargo.toml": "[package]\nname = \"aspis-r0-block-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-8-20261027/LPh_src/docs/research/v8-r0-zk-20261009/refine/poseidon/Cargo.toml": "[package]\nname = \"aspis-r0-poseidon-copy\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-8-20261027/LPh_src/docs/research/v8-r0-zk-20261009/refine/writers/Cargo.toml": "[package]\nname = \"aspis-r0-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-8-20261027/LPh_src/crates/aspis-r1-cost-probe/Cargo.toml": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-8-20261027/LPh_src/crates/aspis-statement/Cargo.toml": "[package]\nname = \"aspis-statement\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"No-proof SpendV0 evaluator and constraint-composition kernels for Aspis\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = [\"aspis-core/r0-r91-audit\"]\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = [\"aspis-core/r0-e4-reference\"]\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = [\"aspis-core/r0-hoist-reference\"]\nr0 = [\"aspis-core/r0\"]\n# Exposes the deliberately broken lambda^0 tagged-tuple compression solely\n# for adversarial teeth/evaluation builds. The verifier program does not\n# forward this feature; enabling it requires an explicit dependency feature.\ninsecure-test-logup-compression = []\n# Derive only the public RATE512 circle/line coordinates touched by Spend\n# queries. This preserves the proof and verifier equations while allowing a\n# deployment build to dead-strip the six complete RATE512 lookup tables.\nspend-dynamic-rate512 = []\n# Host by default; the separate Pool V1 program enables this explicitly for\n# SBF. Frozen verifier builds do not enable it.\npool-v1-kernel = []\n# Audit-only algebraic rewrite for the pair-forest public-digest constraints.\n# It packs each four-lane residual before applying its common selector; the\n# default and released terminal retain the literal lane-by-lane evaluator.\npool-v1-pair-forest-packed-digest-audit = []\n# Audit-only selector-tensor continuation of packed digest binding. Each\n# binding keeps its two packed residuals, while `high[block] * low[local]` is\n# contracted as three exact local-coordinate sums.\npool-v1-pair-forest-packed-digest-selector-tensor-audit = [\n    \"pool-v1-pair-forest-packed-digest-audit\",\n]\n# Audit-only exact `{0,1}` specialization for generated pair-forest Copy\n# weights. The literal QM31-by-M31 multiplication remains the default.\npool-v1-pair-forest-binary-copy-weights-audit = []\n# Audit-only memoization of generated Copy endpoint row selectors. The cache\n# never supplies a value unless its stored row tag matches exactly.\npool-v1-pair-forest-endpoint-selector-cache-audit = []\n# Audit-only exact common-factor extraction in the selected semantic lanes.\n# It preserves all 94 source residuals and their 24 packed theta lanes.\npool-v1-pair-forest-semantic-factor-audit = []\n# Audit-only exact CSE for the fourteen generated Copy tuple patterns.\npool-v1-pair-forest-pattern-window-audit = []\n# Audit-only exact change of basis for the compiled Copy values.  Endpoint\n# selectors are accumulated by their fixed tuple-pattern coordinate before\n# the dynamic pattern values are multiplied, replacing 272 repeated QM31\n# products by the 26 nonzero coordinates of the frozen four-by-fourteen\n# support matrix.  Tags remain included through exact M31 multiplication.\npool-v1-pair-forest-copy-pattern-basis-audit = []\npool-v1-pair-forest-packed-range-audit = []\npool-v1-pair-forest-active-mask-basis-audit = []\npool-v1-pair-forest-copy-selector-tensor-basis-audit = [\n    \"pool-v1-pair-forest-copy-pattern-basis-audit\",\n]\n# Audit-only lazy-reduction dot kernel for the generated Copy tags. Endpoint\n# products are regrouped by the exact `(side, slot, local)` tensor coordinate\n# and reduced in batches of at most four M31 products.\npool-v1-pair-forest-copy-tag-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Audit-only four-product contraction of the tag/low and weight/low tensor\n# coordinates after exact endpoint collection.\npool-v1-pair-forest-copy-finish-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Native differential evidence only (D68.2): retains the pre-migration\n# pair-forest compiler (legacy writers plus relocation) as\n# `pair_forest_trace::reference`, so the shipped copy-built compiler can be\n# compared with it. Never selected by a prover or program build.\npool-v1-pair-forest-writer-reference = []\n\n[dependencies]\naspis-core.workspace = true\n\n# The shipped pair-forest trace writers are the extracted copies (D68.2). They\n# are host-only, like the trace compiler that calls them; SBF builds never\n# compile them.\n[target.'cfg(not(target_os = \"solana\"))'.dependencies]\naspis-r0-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/writers\" }\naspis-r0-block-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/blockwriters\" }\naspis-r0-poseidon-copy = { path = \"../../docs/research/v8-r0-zk-20261009/refine/poseidon\" }\n\n[dev-dependencies]\np3-field = \"=0.6.1\"\np3-mersenne-31 = \"=0.6.1\"\np3-symmetric = \"=0.6.1\"\nsha2.workspace = true\n\n[[test]]\nname = \"pair_forest_writer_migration\"\nrequired-features = [\"pool-v1-pair-forest-writer-reference\"]\n"}}
{"case": 3, "exists": true, "command": ["cargo", "metadata", "--offline", "--format-version", "1", "--manifest-path", "/home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_3/Cargo.toml"], "exit": 0, "stderr": "", "root_manifest": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "root_manifest_sha256": "6eca3f52806da138e93e8dcce079c59ee47bc954015cefa13eb10031520b8f90", "manifest": "/home/dombarker/project-offloads/codex-cx-leaf-p6-9-20261027/LPi_src/crates/aspis-r1-cost-probe/Cargo.toml", "features": "", "no_default": false, "receipts": ["LPi_K013", "LPi_K014", "LPi_K015", "LPi_K012", "LPi_K001", "LPi_K006", "LPi_K008", "LPi_K009", "LPi_K007", "LPi_K017", "LPi_K010", "LPi_K011", "LPi_K016", "LPi_K018", "LPi_K005", "LPi_K002", "LPi_K003", "LPi_K004"], "nodes": [{"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-9-20261027/LPi_src/crates/aspis-core#0.1.0", "name": "aspis-core", "version": "0.1.0", "features": ["r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-9-20261027/LPi_src/docs/research/v8-r0-zk-20261009/refine/blockwriters#aspis-r0-block-writer-copies@0.0.0", "name": "aspis-r0-block-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-9-20261027/LPi_src/docs/research/v8-r0-zk-20261009/refine/poseidon#aspis-r0-poseidon-copy@0.0.0", "name": "aspis-r0-poseidon-copy", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-9-20261027/LPi_src/docs/research/v8-r0-zk-20261009/refine/writers#aspis-r0-writer-copies@0.0.0", "name": "aspis-r0-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-9-20261027/LPi_src/crates/aspis-r1-cost-probe#0.1.0", "name": "aspis-r1-cost-probe", "version": "0.1.0", "features": ["default", "private-leaf-salts"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-9-20261027/LPi_src/crates/aspis-statement#0.1.0", "name": "aspis-statement", "version": "0.1.0", "features": ["pool-v1-kernel", "r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_3#ncs-historical-root@0.0.0", "name": "ncs-historical-root", "version": "0.0.0", "features": []}], "local_manifests": {"/home/dombarker/project-offloads/codex-cx-leaf-p6-9-20261027/LPi_src/crates/aspis-core/Cargo.toml": "[package]\nname = \"aspis-core\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"Aspis native WHIR-style M31 PCS substrate: shared no_std verifier core (host + SBF byte-exact)\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = []\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = []\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = []\n# R0 semantic rows use their own wire, transcript and entrypoints.\nr0 = []\n# Native single-thread operation accounting only; never part of SBF measurements.\nr0-op-count = []\n# Exposes deliberately weakened Fiat-Shamir schedules solely so adversarial\n# tests can demonstrate their teeth. Never enable in a deployed verifier.\ninsecure-test-ordering = []\n# Exposes a verifier mode that deliberately misclassifies the diagnostic M31\n# basis as the legacy CM31 wire shape. Teeth tests only; never deploy.\ninsecure-test-framing = []\n# Exposes private decoder entry points to the isolated universal-equivalence\n# harness. This feature is never enabled by the verifier build.\nformal-verification = []\n# Default-off byte-for-CU experiment. This changes only the fixed-field wire\n# representation and is never enabled by a selected production build.\nv7-fixed-canonical-audit = []\n# Follow-up to the canonical fixed-field experiment.  The fixed records are\n# still checked by their one-pass transcript reader, while packed query limbs\n# are checked only by the gamma/opening consumer that already decodes all of\n# them.  This removes the audit parser's duplicate query-wide canonical scan.\nv7-fixed-canonical-exact-once-audit = [\"v7-fixed-canonical-audit\"]\n# Audit-only loop interchange for the fixed four-slot C1 gamma dot product.\n# The packed bytes, canonical decoder, powers, and resulting four QM31 values\n# are unchanged; only the order in which the same scalar products are summed\n# is specialized to reuse each 26-column power row across all four slots.\nv7-gamma-four-slot-block-audit = []\n\n[dependencies]\n\n[dev-dependencies]\nnum-bigint = \"0.4\"\nserde_json = \"1\"\nsha2 = \"0.10.8\"\n# Property/fuzz-style harnesses run on the pinned stable toolchain via\n# `cargo test`; cargo-fuzz's nightly+libFuzzer requirement would break the\n# stable pin, so the attack-surface fuzzing is expressed as proptest.\nproptest = \"1\"\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-9-20261027/LPi_src/docs/research/v8-r0-zk-20261009/refine/blockwriters/Cargo.toml": "[package]\nname = \"aspis-r0-block-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-9-20261027/LPi_src/docs/research/v8-r0-zk-20261009/refine/poseidon/Cargo.toml": "[package]\nname = \"aspis-r0-poseidon-copy\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-9-20261027/LPi_src/docs/research/v8-r0-zk-20261009/refine/writers/Cargo.toml": "[package]\nname = \"aspis-r0-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-9-20261027/LPi_src/crates/aspis-r1-cost-probe/Cargo.toml": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-9-20261027/LPi_src/crates/aspis-statement/Cargo.toml": "[package]\nname = \"aspis-statement\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"No-proof SpendV0 evaluator and constraint-composition kernels for Aspis\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = [\"aspis-core/r0-r91-audit\"]\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = [\"aspis-core/r0-e4-reference\"]\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = [\"aspis-core/r0-hoist-reference\"]\nr0 = [\"aspis-core/r0\"]\n# Exposes the deliberately broken lambda^0 tagged-tuple compression solely\n# for adversarial teeth/evaluation builds. The verifier program does not\n# forward this feature; enabling it requires an explicit dependency feature.\ninsecure-test-logup-compression = []\n# Derive only the public RATE512 circle/line coordinates touched by Spend\n# queries. This preserves the proof and verifier equations while allowing a\n# deployment build to dead-strip the six complete RATE512 lookup tables.\nspend-dynamic-rate512 = []\n# Host by default; the separate Pool V1 program enables this explicitly for\n# SBF. Frozen verifier builds do not enable it.\npool-v1-kernel = []\n# Audit-only algebraic rewrite for the pair-forest public-digest constraints.\n# It packs each four-lane residual before applying its common selector; the\n# default and released terminal retain the literal lane-by-lane evaluator.\npool-v1-pair-forest-packed-digest-audit = []\n# Audit-only selector-tensor continuation of packed digest binding. Each\n# binding keeps its two packed residuals, while `high[block] * low[local]` is\n# contracted as three exact local-coordinate sums.\npool-v1-pair-forest-packed-digest-selector-tensor-audit = [\n    \"pool-v1-pair-forest-packed-digest-audit\",\n]\n# Audit-only exact `{0,1}` specialization for generated pair-forest Copy\n# weights. The literal QM31-by-M31 multiplication remains the default.\npool-v1-pair-forest-binary-copy-weights-audit = []\n# Audit-only memoization of generated Copy endpoint row selectors. The cache\n# never supplies a value unless its stored row tag matches exactly.\npool-v1-pair-forest-endpoint-selector-cache-audit = []\n# Audit-only exact common-factor extraction in the selected semantic lanes.\n# It preserves all 94 source residuals and their 24 packed theta lanes.\npool-v1-pair-forest-semantic-factor-audit = []\n# Audit-only exact CSE for the fourteen generated Copy tuple patterns.\npool-v1-pair-forest-pattern-window-audit = []\n# Audit-only exact change of basis for the compiled Copy values.  Endpoint\n# selectors are accumulated by their fixed tuple-pattern coordinate before\n# the dynamic pattern values are multiplied, replacing 272 repeated QM31\n# products by the 26 nonzero coordinates of the frozen four-by-fourteen\n# support matrix.  Tags remain included through exact M31 multiplication.\npool-v1-pair-forest-copy-pattern-basis-audit = []\npool-v1-pair-forest-packed-range-audit = []\npool-v1-pair-forest-active-mask-basis-audit = []\npool-v1-pair-forest-copy-selector-tensor-basis-audit = [\n    \"pool-v1-pair-forest-copy-pattern-basis-audit\",\n]\n# Audit-only lazy-reduction dot kernel for the generated Copy tags. Endpoint\n# products are regrouped by the exact `(side, slot, local)` tensor coordinate\n# and reduced in batches of at most four M31 products.\npool-v1-pair-forest-copy-tag-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Audit-only four-product contraction of the tag/low and weight/low tensor\n# coordinates after exact endpoint collection.\npool-v1-pair-forest-copy-finish-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Native differential evidence only (D68.2): retains the pre-migration\n# pair-forest compiler (legacy writers plus relocation) as\n# `pair_forest_trace::reference`, so the shipped copy-built compiler can be\n# compared with it. Never selected by a prover or program build.\npool-v1-pair-forest-writer-reference = []\n\n[dependencies]\naspis-core.workspace = true\n\n# The shipped pair-forest trace writers are the extracted copies (D68.2). They\n# are host-only, like the trace compiler that calls them; SBF builds never\n# compile them.\n[target.'cfg(not(target_os = \"solana\"))'.dependencies]\naspis-r0-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/writers\" }\naspis-r0-block-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/blockwriters\" }\naspis-r0-poseidon-copy = { path = \"../../docs/research/v8-r0-zk-20261009/refine/poseidon\" }\n\n[dev-dependencies]\np3-field = \"=0.6.1\"\np3-mersenne-31 = \"=0.6.1\"\np3-symmetric = \"=0.6.1\"\nsha2.workspace = true\n\n[[test]]\nname = \"pair_forest_writer_migration\"\nrequired-features = [\"pool-v1-pair-forest-writer-reference\"]\n"}}
{"case": 4, "exists": true, "command": ["cargo", "metadata", "--offline", "--format-version", "1", "--manifest-path", "/home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_4/Cargo.toml"], "exit": 0, "stderr": "", "root_manifest": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "root_manifest_sha256": "6eca3f52806da138e93e8dcce079c59ee47bc954015cefa13eb10031520b8f90", "manifest": "/home/dombarker/project-offloads/codex-cx-leaf-sampler1-20261027/LPk_src/crates/aspis-r1-cost-probe/Cargo.toml", "features": "", "no_default": false, "receipts": ["LPk_K002", "LPk_K005", "LPk_K004", "LPk_K003", "LPk_K010", "LPk_K017", "LPk_K019", "LPk_K018", "LPk_K020", "LPk_K016", "LPk_K011", "LPk_K008", "LPk_K006", "LPk_K007", "LPk_K009", "LPk_K014", "LPk_K013", "LPk_K012", "LPk_K015"], "nodes": [{"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-sampler1-20261027/LPk_src/crates/aspis-core#0.1.0", "name": "aspis-core", "version": "0.1.0", "features": ["r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-sampler1-20261027/LPk_src/docs/research/v8-r0-zk-20261009/refine/blockwriters#aspis-r0-block-writer-copies@0.0.0", "name": "aspis-r0-block-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-sampler1-20261027/LPk_src/docs/research/v8-r0-zk-20261009/refine/poseidon#aspis-r0-poseidon-copy@0.0.0", "name": "aspis-r0-poseidon-copy", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-sampler1-20261027/LPk_src/docs/research/v8-r0-zk-20261009/refine/writers#aspis-r0-writer-copies@0.0.0", "name": "aspis-r0-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-sampler1-20261027/LPk_src/crates/aspis-r1-cost-probe#0.1.0", "name": "aspis-r1-cost-probe", "version": "0.1.0", "features": ["default", "private-leaf-salts"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-sampler1-20261027/LPk_src/crates/aspis-statement#0.1.0", "name": "aspis-statement", "version": "0.1.0", "features": ["pool-v1-kernel", "r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_4#ncs-historical-root@0.0.0", "name": "ncs-historical-root", "version": "0.0.0", "features": []}], "local_manifests": {"/home/dombarker/project-offloads/codex-cx-leaf-sampler1-20261027/LPk_src/crates/aspis-core/Cargo.toml": "[package]\nname = \"aspis-core\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"Aspis native WHIR-style M31 PCS substrate: shared no_std verifier core (host + SBF byte-exact)\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = []\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = []\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = []\n# R0 semantic rows use their own wire, transcript and entrypoints.\nr0 = []\n# Native single-thread operation accounting only; never part of SBF measurements.\nr0-op-count = []\n# Exposes deliberately weakened Fiat-Shamir schedules solely so adversarial\n# tests can demonstrate their teeth. Never enable in a deployed verifier.\ninsecure-test-ordering = []\n# Exposes a verifier mode that deliberately misclassifies the diagnostic M31\n# basis as the legacy CM31 wire shape. Teeth tests only; never deploy.\ninsecure-test-framing = []\n# Exposes private decoder entry points to the isolated universal-equivalence\n# harness. This feature is never enabled by the verifier build.\nformal-verification = []\n# Default-off byte-for-CU experiment. This changes only the fixed-field wire\n# representation and is never enabled by a selected production build.\nv7-fixed-canonical-audit = []\n# Follow-up to the canonical fixed-field experiment.  The fixed records are\n# still checked by their one-pass transcript reader, while packed query limbs\n# are checked only by the gamma/opening consumer that already decodes all of\n# them.  This removes the audit parser's duplicate query-wide canonical scan.\nv7-fixed-canonical-exact-once-audit = [\"v7-fixed-canonical-audit\"]\n# Audit-only loop interchange for the fixed four-slot C1 gamma dot product.\n# The packed bytes, canonical decoder, powers, and resulting four QM31 values\n# are unchanged; only the order in which the same scalar products are summed\n# is specialized to reuse each 26-column power row across all four slots.\nv7-gamma-four-slot-block-audit = []\n\n[dependencies]\n\n[dev-dependencies]\nnum-bigint = \"0.4\"\nserde_json = \"1\"\nsha2 = \"0.10.8\"\n# Property/fuzz-style harnesses run on the pinned stable toolchain via\n# `cargo test`; cargo-fuzz's nightly+libFuzzer requirement would break the\n# stable pin, so the attack-surface fuzzing is expressed as proptest.\nproptest = \"1\"\n", "/home/dombarker/project-offloads/codex-cx-leaf-sampler1-20261027/LPk_src/docs/research/v8-r0-zk-20261009/refine/blockwriters/Cargo.toml": "[package]\nname = \"aspis-r0-block-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-sampler1-20261027/LPk_src/docs/research/v8-r0-zk-20261009/refine/poseidon/Cargo.toml": "[package]\nname = \"aspis-r0-poseidon-copy\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-sampler1-20261027/LPk_src/docs/research/v8-r0-zk-20261009/refine/writers/Cargo.toml": "[package]\nname = \"aspis-r0-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-sampler1-20261027/LPk_src/crates/aspis-r1-cost-probe/Cargo.toml": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "/home/dombarker/project-offloads/codex-cx-leaf-sampler1-20261027/LPk_src/crates/aspis-statement/Cargo.toml": "[package]\nname = \"aspis-statement\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"No-proof SpendV0 evaluator and constraint-composition kernels for Aspis\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = [\"aspis-core/r0-r91-audit\"]\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = [\"aspis-core/r0-e4-reference\"]\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = [\"aspis-core/r0-hoist-reference\"]\nr0 = [\"aspis-core/r0\"]\n# Exposes the deliberately broken lambda^0 tagged-tuple compression solely\n# for adversarial teeth/evaluation builds. The verifier program does not\n# forward this feature; enabling it requires an explicit dependency feature.\ninsecure-test-logup-compression = []\n# Derive only the public RATE512 circle/line coordinates touched by Spend\n# queries. This preserves the proof and verifier equations while allowing a\n# deployment build to dead-strip the six complete RATE512 lookup tables.\nspend-dynamic-rate512 = []\n# Host by default; the separate Pool V1 program enables this explicitly for\n# SBF. Frozen verifier builds do not enable it.\npool-v1-kernel = []\n# Audit-only algebraic rewrite for the pair-forest public-digest constraints.\n# It packs each four-lane residual before applying its common selector; the\n# default and released terminal retain the literal lane-by-lane evaluator.\npool-v1-pair-forest-packed-digest-audit = []\n# Audit-only selector-tensor continuation of packed digest binding. Each\n# binding keeps its two packed residuals, while `high[block] * low[local]` is\n# contracted as three exact local-coordinate sums.\npool-v1-pair-forest-packed-digest-selector-tensor-audit = [\n    \"pool-v1-pair-forest-packed-digest-audit\",\n]\n# Audit-only exact `{0,1}` specialization for generated pair-forest Copy\n# weights. The literal QM31-by-M31 multiplication remains the default.\npool-v1-pair-forest-binary-copy-weights-audit = []\n# Audit-only memoization of generated Copy endpoint row selectors. The cache\n# never supplies a value unless its stored row tag matches exactly.\npool-v1-pair-forest-endpoint-selector-cache-audit = []\n# Audit-only exact common-factor extraction in the selected semantic lanes.\n# It preserves all 94 source residuals and their 24 packed theta lanes.\npool-v1-pair-forest-semantic-factor-audit = []\n# Audit-only exact CSE for the fourteen generated Copy tuple patterns.\npool-v1-pair-forest-pattern-window-audit = []\n# Audit-only exact change of basis for the compiled Copy values.  Endpoint\n# selectors are accumulated by their fixed tuple-pattern coordinate before\n# the dynamic pattern values are multiplied, replacing 272 repeated QM31\n# products by the 26 nonzero coordinates of the frozen four-by-fourteen\n# support matrix.  Tags remain included through exact M31 multiplication.\npool-v1-pair-forest-copy-pattern-basis-audit = []\npool-v1-pair-forest-packed-range-audit = []\npool-v1-pair-forest-active-mask-basis-audit = []\npool-v1-pair-forest-copy-selector-tensor-basis-audit = [\n    \"pool-v1-pair-forest-copy-pattern-basis-audit\",\n]\n# Audit-only lazy-reduction dot kernel for the generated Copy tags. Endpoint\n# products are regrouped by the exact `(side, slot, local)` tensor coordinate\n# and reduced in batches of at most four M31 products.\npool-v1-pair-forest-copy-tag-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Audit-only four-product contraction of the tag/low and weight/low tensor\n# coordinates after exact endpoint collection.\npool-v1-pair-forest-copy-finish-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Native differential evidence only (D68.2): retains the pre-migration\n# pair-forest compiler (legacy writers plus relocation) as\n# `pair_forest_trace::reference`, so the shipped copy-built compiler can be\n# compared with it. Never selected by a prover or program build.\npool-v1-pair-forest-writer-reference = []\n\n[dependencies]\naspis-core.workspace = true\n\n# The shipped pair-forest trace writers are the extracted copies (D68.2). They\n# are host-only, like the trace compiler that calls them; SBF builds never\n# compile them.\n[target.'cfg(not(target_os = \"solana\"))'.dependencies]\naspis-r0-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/writers\" }\naspis-r0-block-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/blockwriters\" }\naspis-r0-poseidon-copy = { path = \"../../docs/research/v8-r0-zk-20261009/refine/poseidon\" }\n\n[dev-dependencies]\np3-field = \"=0.6.1\"\np3-mersenne-31 = \"=0.6.1\"\np3-symmetric = \"=0.6.1\"\nsha2.workspace = true\n\n[[test]]\nname = \"pair_forest_writer_migration\"\nrequired-features = [\"pool-v1-pair-forest-writer-reference\"]\n"}}
{"case": 5, "exists": true, "command": ["cargo", "metadata", "--offline", "--format-version", "1", "--manifest-path", "/home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_5/Cargo.toml"], "exit": 0, "stderr": "", "root_manifest": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "root_manifest_sha256": "6eca3f52806da138e93e8dcce079c59ee47bc954015cefa13eb10031520b8f90", "manifest": "/home/dombarker/project-offloads/codex-cx-leaf-p6-10-20261027/LPl_src/crates/aspis-r1-cost-probe/Cargo.toml", "features": "", "no_default": false, "receipts": ["LPl_K010", "LPl_K011", "LPl_K016", "LPl_K005", "LPl_K002", "LPl_K003", "LPl_K004", "LPl_K013", "LPl_K014", "LPl_K015", "LPl_K012", "LPl_K001", "LPl_K006", "LPl_K008", "LPl_K009", "LPl_K007"], "nodes": [{"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-10-20261027/LPl_src/crates/aspis-core#0.1.0", "name": "aspis-core", "version": "0.1.0", "features": ["r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-10-20261027/LPl_src/docs/research/v8-r0-zk-20261009/refine/blockwriters#aspis-r0-block-writer-copies@0.0.0", "name": "aspis-r0-block-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-10-20261027/LPl_src/docs/research/v8-r0-zk-20261009/refine/poseidon#aspis-r0-poseidon-copy@0.0.0", "name": "aspis-r0-poseidon-copy", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-10-20261027/LPl_src/docs/research/v8-r0-zk-20261009/refine/writers#aspis-r0-writer-copies@0.0.0", "name": "aspis-r0-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-10-20261027/LPl_src/crates/aspis-r1-cost-probe#0.1.0", "name": "aspis-r1-cost-probe", "version": "0.1.0", "features": ["default", "private-leaf-salts"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-10-20261027/LPl_src/crates/aspis-statement#0.1.0", "name": "aspis-statement", "version": "0.1.0", "features": ["pool-v1-kernel", "r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_5#ncs-historical-root@0.0.0", "name": "ncs-historical-root", "version": "0.0.0", "features": []}], "local_manifests": {"/home/dombarker/project-offloads/codex-cx-leaf-p6-10-20261027/LPl_src/crates/aspis-core/Cargo.toml": "[package]\nname = \"aspis-core\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"Aspis native WHIR-style M31 PCS substrate: shared no_std verifier core (host + SBF byte-exact)\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = []\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = []\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = []\n# R0 semantic rows use their own wire, transcript and entrypoints.\nr0 = []\n# Native single-thread operation accounting only; never part of SBF measurements.\nr0-op-count = []\n# Exposes deliberately weakened Fiat-Shamir schedules solely so adversarial\n# tests can demonstrate their teeth. Never enable in a deployed verifier.\ninsecure-test-ordering = []\n# Exposes a verifier mode that deliberately misclassifies the diagnostic M31\n# basis as the legacy CM31 wire shape. Teeth tests only; never deploy.\ninsecure-test-framing = []\n# Exposes private decoder entry points to the isolated universal-equivalence\n# harness. This feature is never enabled by the verifier build.\nformal-verification = []\n# Default-off byte-for-CU experiment. This changes only the fixed-field wire\n# representation and is never enabled by a selected production build.\nv7-fixed-canonical-audit = []\n# Follow-up to the canonical fixed-field experiment.  The fixed records are\n# still checked by their one-pass transcript reader, while packed query limbs\n# are checked only by the gamma/opening consumer that already decodes all of\n# them.  This removes the audit parser's duplicate query-wide canonical scan.\nv7-fixed-canonical-exact-once-audit = [\"v7-fixed-canonical-audit\"]\n# Audit-only loop interchange for the fixed four-slot C1 gamma dot product.\n# The packed bytes, canonical decoder, powers, and resulting four QM31 values\n# are unchanged; only the order in which the same scalar products are summed\n# is specialized to reuse each 26-column power row across all four slots.\nv7-gamma-four-slot-block-audit = []\n\n[dependencies]\n\n[dev-dependencies]\nnum-bigint = \"0.4\"\nserde_json = \"1\"\nsha2 = \"0.10.8\"\n# Property/fuzz-style harnesses run on the pinned stable toolchain via\n# `cargo test`; cargo-fuzz's nightly+libFuzzer requirement would break the\n# stable pin, so the attack-surface fuzzing is expressed as proptest.\nproptest = \"1\"\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-10-20261027/LPl_src/docs/research/v8-r0-zk-20261009/refine/blockwriters/Cargo.toml": "[package]\nname = \"aspis-r0-block-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-10-20261027/LPl_src/docs/research/v8-r0-zk-20261009/refine/poseidon/Cargo.toml": "[package]\nname = \"aspis-r0-poseidon-copy\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-10-20261027/LPl_src/docs/research/v8-r0-zk-20261009/refine/writers/Cargo.toml": "[package]\nname = \"aspis-r0-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-10-20261027/LPl_src/crates/aspis-r1-cost-probe/Cargo.toml": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-10-20261027/LPl_src/crates/aspis-statement/Cargo.toml": "[package]\nname = \"aspis-statement\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"No-proof SpendV0 evaluator and constraint-composition kernels for Aspis\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = [\"aspis-core/r0-r91-audit\"]\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = [\"aspis-core/r0-e4-reference\"]\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = [\"aspis-core/r0-hoist-reference\"]\nr0 = [\"aspis-core/r0\"]\n# Exposes the deliberately broken lambda^0 tagged-tuple compression solely\n# for adversarial teeth/evaluation builds. The verifier program does not\n# forward this feature; enabling it requires an explicit dependency feature.\ninsecure-test-logup-compression = []\n# Derive only the public RATE512 circle/line coordinates touched by Spend\n# queries. This preserves the proof and verifier equations while allowing a\n# deployment build to dead-strip the six complete RATE512 lookup tables.\nspend-dynamic-rate512 = []\n# Host by default; the separate Pool V1 program enables this explicitly for\n# SBF. Frozen verifier builds do not enable it.\npool-v1-kernel = []\n# Audit-only algebraic rewrite for the pair-forest public-digest constraints.\n# It packs each four-lane residual before applying its common selector; the\n# default and released terminal retain the literal lane-by-lane evaluator.\npool-v1-pair-forest-packed-digest-audit = []\n# Audit-only selector-tensor continuation of packed digest binding. Each\n# binding keeps its two packed residuals, while `high[block] * low[local]` is\n# contracted as three exact local-coordinate sums.\npool-v1-pair-forest-packed-digest-selector-tensor-audit = [\n    \"pool-v1-pair-forest-packed-digest-audit\",\n]\n# Audit-only exact `{0,1}` specialization for generated pair-forest Copy\n# weights. The literal QM31-by-M31 multiplication remains the default.\npool-v1-pair-forest-binary-copy-weights-audit = []\n# Audit-only memoization of generated Copy endpoint row selectors. The cache\n# never supplies a value unless its stored row tag matches exactly.\npool-v1-pair-forest-endpoint-selector-cache-audit = []\n# Audit-only exact common-factor extraction in the selected semantic lanes.\n# It preserves all 94 source residuals and their 24 packed theta lanes.\npool-v1-pair-forest-semantic-factor-audit = []\n# Audit-only exact CSE for the fourteen generated Copy tuple patterns.\npool-v1-pair-forest-pattern-window-audit = []\n# Audit-only exact change of basis for the compiled Copy values.  Endpoint\n# selectors are accumulated by their fixed tuple-pattern coordinate before\n# the dynamic pattern values are multiplied, replacing 272 repeated QM31\n# products by the 26 nonzero coordinates of the frozen four-by-fourteen\n# support matrix.  Tags remain included through exact M31 multiplication.\npool-v1-pair-forest-copy-pattern-basis-audit = []\npool-v1-pair-forest-packed-range-audit = []\npool-v1-pair-forest-active-mask-basis-audit = []\npool-v1-pair-forest-copy-selector-tensor-basis-audit = [\n    \"pool-v1-pair-forest-copy-pattern-basis-audit\",\n]\n# Audit-only lazy-reduction dot kernel for the generated Copy tags. Endpoint\n# products are regrouped by the exact `(side, slot, local)` tensor coordinate\n# and reduced in batches of at most four M31 products.\npool-v1-pair-forest-copy-tag-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Audit-only four-product contraction of the tag/low and weight/low tensor\n# coordinates after exact endpoint collection.\npool-v1-pair-forest-copy-finish-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Native differential evidence only (D68.2): retains the pre-migration\n# pair-forest compiler (legacy writers plus relocation) as\n# `pair_forest_trace::reference`, so the shipped copy-built compiler can be\n# compared with it. Never selected by a prover or program build.\npool-v1-pair-forest-writer-reference = []\n\n[dependencies]\naspis-core.workspace = true\n\n# The shipped pair-forest trace writers are the extracted copies (D68.2). They\n# are host-only, like the trace compiler that calls them; SBF builds never\n# compile them.\n[target.'cfg(not(target_os = \"solana\"))'.dependencies]\naspis-r0-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/writers\" }\naspis-r0-block-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/blockwriters\" }\naspis-r0-poseidon-copy = { path = \"../../docs/research/v8-r0-zk-20261009/refine/poseidon\" }\n\n[dev-dependencies]\np3-field = \"=0.6.1\"\np3-mersenne-31 = \"=0.6.1\"\np3-symmetric = \"=0.6.1\"\nsha2.workspace = true\n\n[[test]]\nname = \"pair_forest_writer_migration\"\nrequired-features = [\"pool-v1-pair-forest-writer-reference\"]\n"}}
{"case": 6, "exists": true, "command": ["cargo", "metadata", "--offline", "--format-version", "1", "--manifest-path", "/home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_6/Cargo.toml"], "exit": 0, "stderr": "", "root_manifest": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "root_manifest_sha256": "6eca3f52806da138e93e8dcce079c59ee47bc954015cefa13eb10031520b8f90", "manifest": "/home/dombarker/project-offloads/codex-cx-leaf-p6-11-20261027/LPm_src/crates/aspis-r1-cost-probe/Cargo.toml", "features": "", "no_default": false, "receipts": ["LPm_K018", "LPm_K016", "LPm_K011", "LPm_K010", "LPm_K017", "LPm_K004", "LPm_K003", "LPm_K002", "LPm_K005", "LPm_K012", "LPm_K015", "LPm_K014", "LPm_K013", "LPm_K007", "LPm_K009", "LPm_K008", "LPm_K006", "LPm_K001"], "nodes": [{"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-11-20261027/LPm_src/crates/aspis-core#0.1.0", "name": "aspis-core", "version": "0.1.0", "features": ["r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-11-20261027/LPm_src/docs/research/v8-r0-zk-20261009/refine/blockwriters#aspis-r0-block-writer-copies@0.0.0", "name": "aspis-r0-block-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-11-20261027/LPm_src/docs/research/v8-r0-zk-20261009/refine/poseidon#aspis-r0-poseidon-copy@0.0.0", "name": "aspis-r0-poseidon-copy", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-11-20261027/LPm_src/docs/research/v8-r0-zk-20261009/refine/writers#aspis-r0-writer-copies@0.0.0", "name": "aspis-r0-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-11-20261027/LPm_src/crates/aspis-r1-cost-probe#0.1.0", "name": "aspis-r1-cost-probe", "version": "0.1.0", "features": ["default", "private-leaf-salts"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-11-20261027/LPm_src/crates/aspis-statement#0.1.0", "name": "aspis-statement", "version": "0.1.0", "features": ["pool-v1-kernel", "r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_6#ncs-historical-root@0.0.0", "name": "ncs-historical-root", "version": "0.0.0", "features": []}], "local_manifests": {"/home/dombarker/project-offloads/codex-cx-leaf-p6-11-20261027/LPm_src/crates/aspis-core/Cargo.toml": "[package]\nname = \"aspis-core\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"Aspis native WHIR-style M31 PCS substrate: shared no_std verifier core (host + SBF byte-exact)\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = []\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = []\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = []\n# R0 semantic rows use their own wire, transcript and entrypoints.\nr0 = []\n# Native single-thread operation accounting only; never part of SBF measurements.\nr0-op-count = []\n# Exposes deliberately weakened Fiat-Shamir schedules solely so adversarial\n# tests can demonstrate their teeth. Never enable in a deployed verifier.\ninsecure-test-ordering = []\n# Exposes a verifier mode that deliberately misclassifies the diagnostic M31\n# basis as the legacy CM31 wire shape. Teeth tests only; never deploy.\ninsecure-test-framing = []\n# Exposes private decoder entry points to the isolated universal-equivalence\n# harness. This feature is never enabled by the verifier build.\nformal-verification = []\n# Default-off byte-for-CU experiment. This changes only the fixed-field wire\n# representation and is never enabled by a selected production build.\nv7-fixed-canonical-audit = []\n# Follow-up to the canonical fixed-field experiment.  The fixed records are\n# still checked by their one-pass transcript reader, while packed query limbs\n# are checked only by the gamma/opening consumer that already decodes all of\n# them.  This removes the audit parser's duplicate query-wide canonical scan.\nv7-fixed-canonical-exact-once-audit = [\"v7-fixed-canonical-audit\"]\n# Audit-only loop interchange for the fixed four-slot C1 gamma dot product.\n# The packed bytes, canonical decoder, powers, and resulting four QM31 values\n# are unchanged; only the order in which the same scalar products are summed\n# is specialized to reuse each 26-column power row across all four slots.\nv7-gamma-four-slot-block-audit = []\n\n[dependencies]\n\n[dev-dependencies]\nnum-bigint = \"0.4\"\nserde_json = \"1\"\nsha2 = \"0.10.8\"\n# Property/fuzz-style harnesses run on the pinned stable toolchain via\n# `cargo test`; cargo-fuzz's nightly+libFuzzer requirement would break the\n# stable pin, so the attack-surface fuzzing is expressed as proptest.\nproptest = \"1\"\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-11-20261027/LPm_src/docs/research/v8-r0-zk-20261009/refine/blockwriters/Cargo.toml": "[package]\nname = \"aspis-r0-block-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-11-20261027/LPm_src/docs/research/v8-r0-zk-20261009/refine/poseidon/Cargo.toml": "[package]\nname = \"aspis-r0-poseidon-copy\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-11-20261027/LPm_src/docs/research/v8-r0-zk-20261009/refine/writers/Cargo.toml": "[package]\nname = \"aspis-r0-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-11-20261027/LPm_src/crates/aspis-r1-cost-probe/Cargo.toml": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-11-20261027/LPm_src/crates/aspis-statement/Cargo.toml": "[package]\nname = \"aspis-statement\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"No-proof SpendV0 evaluator and constraint-composition kernels for Aspis\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = [\"aspis-core/r0-r91-audit\"]\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = [\"aspis-core/r0-e4-reference\"]\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = [\"aspis-core/r0-hoist-reference\"]\nr0 = [\"aspis-core/r0\"]\n# Exposes the deliberately broken lambda^0 tagged-tuple compression solely\n# for adversarial teeth/evaluation builds. The verifier program does not\n# forward this feature; enabling it requires an explicit dependency feature.\ninsecure-test-logup-compression = []\n# Derive only the public RATE512 circle/line coordinates touched by Spend\n# queries. This preserves the proof and verifier equations while allowing a\n# deployment build to dead-strip the six complete RATE512 lookup tables.\nspend-dynamic-rate512 = []\n# Host by default; the separate Pool V1 program enables this explicitly for\n# SBF. Frozen verifier builds do not enable it.\npool-v1-kernel = []\n# Audit-only algebraic rewrite for the pair-forest public-digest constraints.\n# It packs each four-lane residual before applying its common selector; the\n# default and released terminal retain the literal lane-by-lane evaluator.\npool-v1-pair-forest-packed-digest-audit = []\n# Audit-only selector-tensor continuation of packed digest binding. Each\n# binding keeps its two packed residuals, while `high[block] * low[local]` is\n# contracted as three exact local-coordinate sums.\npool-v1-pair-forest-packed-digest-selector-tensor-audit = [\n    \"pool-v1-pair-forest-packed-digest-audit\",\n]\n# Audit-only exact `{0,1}` specialization for generated pair-forest Copy\n# weights. The literal QM31-by-M31 multiplication remains the default.\npool-v1-pair-forest-binary-copy-weights-audit = []\n# Audit-only memoization of generated Copy endpoint row selectors. The cache\n# never supplies a value unless its stored row tag matches exactly.\npool-v1-pair-forest-endpoint-selector-cache-audit = []\n# Audit-only exact common-factor extraction in the selected semantic lanes.\n# It preserves all 94 source residuals and their 24 packed theta lanes.\npool-v1-pair-forest-semantic-factor-audit = []\n# Audit-only exact CSE for the fourteen generated Copy tuple patterns.\npool-v1-pair-forest-pattern-window-audit = []\n# Audit-only exact change of basis for the compiled Copy values.  Endpoint\n# selectors are accumulated by their fixed tuple-pattern coordinate before\n# the dynamic pattern values are multiplied, replacing 272 repeated QM31\n# products by the 26 nonzero coordinates of the frozen four-by-fourteen\n# support matrix.  Tags remain included through exact M31 multiplication.\npool-v1-pair-forest-copy-pattern-basis-audit = []\npool-v1-pair-forest-packed-range-audit = []\npool-v1-pair-forest-active-mask-basis-audit = []\npool-v1-pair-forest-copy-selector-tensor-basis-audit = [\n    \"pool-v1-pair-forest-copy-pattern-basis-audit\",\n]\n# Audit-only lazy-reduction dot kernel for the generated Copy tags. Endpoint\n# products are regrouped by the exact `(side, slot, local)` tensor coordinate\n# and reduced in batches of at most four M31 products.\npool-v1-pair-forest-copy-tag-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Audit-only four-product contraction of the tag/low and weight/low tensor\n# coordinates after exact endpoint collection.\npool-v1-pair-forest-copy-finish-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Native differential evidence only (D68.2): retains the pre-migration\n# pair-forest compiler (legacy writers plus relocation) as\n# `pair_forest_trace::reference`, so the shipped copy-built compiler can be\n# compared with it. Never selected by a prover or program build.\npool-v1-pair-forest-writer-reference = []\n\n[dependencies]\naspis-core.workspace = true\n\n# The shipped pair-forest trace writers are the extracted copies (D68.2). They\n# are host-only, like the trace compiler that calls them; SBF builds never\n# compile them.\n[target.'cfg(not(target_os = \"solana\"))'.dependencies]\naspis-r0-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/writers\" }\naspis-r0-block-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/blockwriters\" }\naspis-r0-poseidon-copy = { path = \"../../docs/research/v8-r0-zk-20261009/refine/poseidon\" }\n\n[dev-dependencies]\np3-field = \"=0.6.1\"\np3-mersenne-31 = \"=0.6.1\"\np3-symmetric = \"=0.6.1\"\nsha2.workspace = true\n\n[[test]]\nname = \"pair_forest_writer_migration\"\nrequired-features = [\"pool-v1-pair-forest-writer-reference\"]\n"}}
{"case": 7, "exists": true, "command": ["cargo", "metadata", "--offline", "--format-version", "1", "--manifest-path", "/home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_7/Cargo.toml"], "exit": 0, "stderr": "", "root_manifest": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "root_manifest_sha256": "6eca3f52806da138e93e8dcce079c59ee47bc954015cefa13eb10031520b8f90", "manifest": "/home/dombarker/project-offloads/codex-cx-native-tx2h-20261028/NBQ_src/crates/aspis-r1-cost-probe/Cargo.toml", "features": "", "no_default": false, "receipts": ["NBQ_K010", "NBQ_K028", "NBQ_K017", "NBQ_K021", "NBQ_K019", "NBQ_K026", "NBQ_K018", "NBQ_K027", "NBQ_K020", "NBQ_K029", "NBQ_K011", "NBQ_K033", "NBQ_K034", "NBQ_K002", "NBQ_K005", "NBQ_K004", "NBQ_K003", "NBQ_K035", "NBQ_K032", "NBQ_K014", "NBQ_K013", "NBQ_K025", "NBQ_K022", "NBQ_K040", "NBQ_K023", "NBQ_K024", "NBQ_K012", "NBQ_K015", "NBQ_K037", "NBQ_K008", "NBQ_K030", "NBQ_K006", "NBQ_K039", "NBQ_K001", "NBQ_K007", "NBQ_K038", "NBQ_K031", "NBQ_K036", "NBQ_K009"], "nodes": [{"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2h-20261028/NBQ_src/crates/aspis-core#0.1.0", "name": "aspis-core", "version": "0.1.0", "features": ["r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2h-20261028/NBQ_src/docs/research/v8-r0-zk-20261009/refine/blockwriters#aspis-r0-block-writer-copies@0.0.0", "name": "aspis-r0-block-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2h-20261028/NBQ_src/docs/research/v8-r0-zk-20261009/refine/poseidon#aspis-r0-poseidon-copy@0.0.0", "name": "aspis-r0-poseidon-copy", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2h-20261028/NBQ_src/docs/research/v8-r0-zk-20261009/refine/writers#aspis-r0-writer-copies@0.0.0", "name": "aspis-r0-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2h-20261028/NBQ_src/crates/aspis-r1-cost-probe#0.1.0", "name": "aspis-r1-cost-probe", "version": "0.1.0", "features": ["default", "private-leaf-salts"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2h-20261028/NBQ_src/crates/aspis-statement#0.1.0", "name": "aspis-statement", "version": "0.1.0", "features": ["pool-v1-kernel", "r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_7#ncs-historical-root@0.0.0", "name": "ncs-historical-root", "version": "0.0.0", "features": []}], "local_manifests": {"/home/dombarker/project-offloads/codex-cx-native-tx2h-20261028/NBQ_src/crates/aspis-core/Cargo.toml": "[package]\nname = \"aspis-core\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"Aspis native WHIR-style M31 PCS substrate: shared no_std verifier core (host + SBF byte-exact)\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = []\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = []\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = []\n# R0 semantic rows use their own wire, transcript and entrypoints.\nr0 = []\n# Native single-thread operation accounting only; never part of SBF measurements.\nr0-op-count = []\n# Exposes deliberately weakened Fiat-Shamir schedules solely so adversarial\n# tests can demonstrate their teeth. Never enable in a deployed verifier.\ninsecure-test-ordering = []\n# Exposes a verifier mode that deliberately misclassifies the diagnostic M31\n# basis as the legacy CM31 wire shape. Teeth tests only; never deploy.\ninsecure-test-framing = []\n# Exposes private decoder entry points to the isolated universal-equivalence\n# harness. This feature is never enabled by the verifier build.\nformal-verification = []\n# Default-off byte-for-CU experiment. This changes only the fixed-field wire\n# representation and is never enabled by a selected production build.\nv7-fixed-canonical-audit = []\n# Follow-up to the canonical fixed-field experiment.  The fixed records are\n# still checked by their one-pass transcript reader, while packed query limbs\n# are checked only by the gamma/opening consumer that already decodes all of\n# them.  This removes the audit parser's duplicate query-wide canonical scan.\nv7-fixed-canonical-exact-once-audit = [\"v7-fixed-canonical-audit\"]\n# Audit-only loop interchange for the fixed four-slot C1 gamma dot product.\n# The packed bytes, canonical decoder, powers, and resulting four QM31 values\n# are unchanged; only the order in which the same scalar products are summed\n# is specialized to reuse each 26-column power row across all four slots.\nv7-gamma-four-slot-block-audit = []\n\n[dependencies]\n\n[dev-dependencies]\nnum-bigint = \"0.4\"\nserde_json = \"1\"\nsha2 = \"0.10.8\"\n# Property/fuzz-style harnesses run on the pinned stable toolchain via\n# `cargo test`; cargo-fuzz's nightly+libFuzzer requirement would break the\n# stable pin, so the attack-surface fuzzing is expressed as proptest.\nproptest = \"1\"\n", "/home/dombarker/project-offloads/codex-cx-native-tx2h-20261028/NBQ_src/docs/research/v8-r0-zk-20261009/refine/blockwriters/Cargo.toml": "[package]\nname = \"aspis-r0-block-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-native-tx2h-20261028/NBQ_src/docs/research/v8-r0-zk-20261009/refine/poseidon/Cargo.toml": "[package]\nname = \"aspis-r0-poseidon-copy\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-native-tx2h-20261028/NBQ_src/docs/research/v8-r0-zk-20261009/refine/writers/Cargo.toml": "[package]\nname = \"aspis-r0-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-native-tx2h-20261028/NBQ_src/crates/aspis-r1-cost-probe/Cargo.toml": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "/home/dombarker/project-offloads/codex-cx-native-tx2h-20261028/NBQ_src/crates/aspis-statement/Cargo.toml": "[package]\nname = \"aspis-statement\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"No-proof SpendV0 evaluator and constraint-composition kernels for Aspis\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = [\"aspis-core/r0-r91-audit\"]\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = [\"aspis-core/r0-e4-reference\"]\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = [\"aspis-core/r0-hoist-reference\"]\nr0 = [\"aspis-core/r0\"]\n# Exposes the deliberately broken lambda^0 tagged-tuple compression solely\n# for adversarial teeth/evaluation builds. The verifier program does not\n# forward this feature; enabling it requires an explicit dependency feature.\ninsecure-test-logup-compression = []\n# Derive only the public RATE512 circle/line coordinates touched by Spend\n# queries. This preserves the proof and verifier equations while allowing a\n# deployment build to dead-strip the six complete RATE512 lookup tables.\nspend-dynamic-rate512 = []\n# Host by default; the separate Pool V1 program enables this explicitly for\n# SBF. Frozen verifier builds do not enable it.\npool-v1-kernel = []\n# Audit-only algebraic rewrite for the pair-forest public-digest constraints.\n# It packs each four-lane residual before applying its common selector; the\n# default and released terminal retain the literal lane-by-lane evaluator.\npool-v1-pair-forest-packed-digest-audit = []\n# Audit-only selector-tensor continuation of packed digest binding. Each\n# binding keeps its two packed residuals, while `high[block] * low[local]` is\n# contracted as three exact local-coordinate sums.\npool-v1-pair-forest-packed-digest-selector-tensor-audit = [\n    \"pool-v1-pair-forest-packed-digest-audit\",\n]\n# Audit-only exact `{0,1}` specialization for generated pair-forest Copy\n# weights. The literal QM31-by-M31 multiplication remains the default.\npool-v1-pair-forest-binary-copy-weights-audit = []\n# Audit-only memoization of generated Copy endpoint row selectors. The cache\n# never supplies a value unless its stored row tag matches exactly.\npool-v1-pair-forest-endpoint-selector-cache-audit = []\n# Audit-only exact common-factor extraction in the selected semantic lanes.\n# It preserves all 94 source residuals and their 24 packed theta lanes.\npool-v1-pair-forest-semantic-factor-audit = []\n# Audit-only exact CSE for the fourteen generated Copy tuple patterns.\npool-v1-pair-forest-pattern-window-audit = []\n# Audit-only exact change of basis for the compiled Copy values.  Endpoint\n# selectors are accumulated by their fixed tuple-pattern coordinate before\n# the dynamic pattern values are multiplied, replacing 272 repeated QM31\n# products by the 26 nonzero coordinates of the frozen four-by-fourteen\n# support matrix.  Tags remain included through exact M31 multiplication.\npool-v1-pair-forest-copy-pattern-basis-audit = []\npool-v1-pair-forest-packed-range-audit = []\npool-v1-pair-forest-active-mask-basis-audit = []\npool-v1-pair-forest-copy-selector-tensor-basis-audit = [\n    \"pool-v1-pair-forest-copy-pattern-basis-audit\",\n]\n# Audit-only lazy-reduction dot kernel for the generated Copy tags. Endpoint\n# products are regrouped by the exact `(side, slot, local)` tensor coordinate\n# and reduced in batches of at most four M31 products.\npool-v1-pair-forest-copy-tag-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Audit-only four-product contraction of the tag/low and weight/low tensor\n# coordinates after exact endpoint collection.\npool-v1-pair-forest-copy-finish-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Native differential evidence only (D68.2): retains the pre-migration\n# pair-forest compiler (legacy writers plus relocation) as\n# `pair_forest_trace::reference`, so the shipped copy-built compiler can be\n# compared with it. Never selected by a prover or program build.\npool-v1-pair-forest-writer-reference = []\n\n[dependencies]\naspis-core.workspace = true\n\n# The shipped pair-forest trace writers are the extracted copies (D68.2). They\n# are host-only, like the trace compiler that calls them; SBF builds never\n# compile them.\n[target.'cfg(not(target_os = \"solana\"))'.dependencies]\naspis-r0-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/writers\" }\naspis-r0-block-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/blockwriters\" }\naspis-r0-poseidon-copy = { path = \"../../docs/research/v8-r0-zk-20261009/refine/poseidon\" }\n\n[dev-dependencies]\np3-field = \"=0.6.1\"\np3-mersenne-31 = \"=0.6.1\"\np3-symmetric = \"=0.6.1\"\nsha2.workspace = true\n\n[[test]]\nname = \"pair_forest_writer_migration\"\nrequired-features = [\"pool-v1-pair-forest-writer-reference\"]\n"}}
{"case": 8, "exists": true, "command": ["cargo", "metadata", "--offline", "--format-version", "1", "--manifest-path", "/home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_8/Cargo.toml"], "exit": 0, "stderr": "", "root_manifest": "[package]\nname = \"aspis-r1-cost-probe-program\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE SBF entrypoint\"\n[lib]\ncrate-type = [\"cdylib\", \"lib\"]\n[features]\ndefault = [\"custom-heap\"]\ncustom-heap = []\ncustom-panic = []\n# Internal phase/CU diagnostics are opt-in; release verification has no observer.\ncu-profiling = []\nno-entrypoint = []\npool-adapter = []\n# Kept for the pinned build command lines; the adopted compact binary-multiproof\n# format (PREREG-PROOF-SIZE-2) is defined over private leaf salts, which the\n# verifier crate now enables by default.\nprivate-leaf-salts = [\"aspis-r1-cost-probe/private-leaf-salts\"]\n[dependencies]\naspis-r1-cost-probe = { path = \"../../crates/aspis-r1-cost-probe\", features = [\"optimized-terminal\", \"program-build\"] }\naspis-statement = { path = \"../../crates/aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\nsolana-program.workspace = true\naspis-core = { path = \"../../crates/aspis-core\" }\n", "root_manifest_sha256": "6aa7d08708762ddadf3a6173b14256d7c5a3f1eba12e8631e9abb0c154eebe7b", "manifest": "/home/dombarker/project-offloads/codex-cx-native-tx2h-20261028/NBQ_src/programs/r1-cost-probe/Cargo.toml", "features": "pool-adapter,private-leaf-salts", "no_default": false, "receipts": ["NBQ_K016"], "nodes": [{"id": "registry+https://github.com/rust-lang/crates.io-index#ahash@0.8.12", "name": "ahash", "version": "0.8.12", "features": []}, {"id": "registry+https://github.com/rust-lang/crates.io-index#arrayref@0.3.9", "name": "arrayref", "version": "0.3.9", "features": []}, {"id": "registry+https://github.com/rust-lang/crates.io-index#arrayvec@0.7.8", "name": "arrayvec", "v