{"case": 17, "exists": true, "command": ["cargo", "metadata", "--offline", "--format-version", "1", "--manifest-path", "/home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_17/Cargo.toml"], "exit": 0, "stderr": "", "root_manifest": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "root_manifest_sha256": "6eca3f52806da138e93e8dcce079c59ee47bc954015cefa13eb10031520b8f90", "manifest": "/home/dombarker/project-offloads/codex-cx-leaf-p6-14-20261027/LPp_src/crates/aspis-r1-cost-probe/Cargo.toml", "features": "", "no_default": false, "receipts": ["LPp_K006", "LPp_K003", "LPp_K002"], "nodes": [{"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-14-20261027/LPp_src/crates/aspis-core#0.1.0", "name": "aspis-core", "version": "0.1.0", "features": ["r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-14-20261027/LPp_src/docs/research/v8-r0-zk-20261009/refine/blockwriters#aspis-r0-block-writer-copies@0.0.0", "name": "aspis-r0-block-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-14-20261027/LPp_src/docs/research/v8-r0-zk-20261009/refine/poseidon#aspis-r0-poseidon-copy@0.0.0", "name": "aspis-r0-poseidon-copy", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-14-20261027/LPp_src/docs/research/v8-r0-zk-20261009/refine/writers#aspis-r0-writer-copies@0.0.0", "name": "aspis-r0-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-14-20261027/LPp_src/crates/aspis-r1-cost-probe#0.1.0", "name": "aspis-r1-cost-probe", "version": "0.1.0", "features": ["default", "private-leaf-salts"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-14-20261027/LPp_src/crates/aspis-statement#0.1.0", "name": "aspis-statement", "version": "0.1.0", "features": ["pool-v1-kernel", "r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_17#ncs-historical-root@0.0.0", "name": "ncs-historical-root", "version": "0.0.0", "features": []}], "local_manifests": {"/home/dombarker/project-offloads/codex-cx-leaf-p6-14-20261027/LPp_src/crates/aspis-core/Cargo.toml": "[package]\nname = \"aspis-core\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"Aspis native WHIR-style M31 PCS substrate: shared no_std verifier core (host + SBF byte-exact)\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = []\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = []\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = []\n# R0 semantic rows use their own wire, transcript and entrypoints.\nr0 = []\n# Native single-thread operation accounting only; never part of SBF measurements.\nr0-op-count = []\n# Exposes deliberately weakened Fiat-Shamir schedules solely so adversarial\n# tests can demonstrate their teeth. Never enable in a deployed verifier.\ninsecure-test-ordering = []\n# Exposes a verifier mode that deliberately misclassifies the diagnostic M31\n# basis as the legacy CM31 wire shape. Teeth tests only; never deploy.\ninsecure-test-framing = []\n# Exposes private decoder entry points to the isolated universal-equivalence\n# harness. This feature is never enabled by the verifier build.\nformal-verification = []\n# Default-off byte-for-CU experiment. This changes only the fixed-field wire\n# representation and is never enabled by a selected production build.\nv7-fixed-canonical-audit = []\n# Follow-up to the canonical fixed-field experiment.  The fixed records are\n# still checked by their one-pass transcript reader, while packed query limbs\n# are checked only by the gamma/opening consumer that already decodes all of\n# them.  This removes the audit parser's duplicate query-wide canonical scan.\nv7-fixed-canonical-exact-once-audit = [\"v7-fixed-canonical-audit\"]\n# Audit-only loop interchange for the fixed four-slot C1 gamma dot product.\n# The packed bytes, canonical decoder, powers, and resulting four QM31 values\n# are unchanged; only the order in which the same scalar products are summed\n# is specialized to reuse each 26-column power row across all four slots.\nv7-gamma-four-slot-block-audit = []\n\n[dependencies]\n\n[dev-dependencies]\nnum-bigint = \"0.4\"\nserde_json = \"1\"\nsha2 = \"0.10.8\"\n# Property/fuzz-style harnesses run on the pinned stable toolchain via\n# `cargo test`; cargo-fuzz's nightly+libFuzzer requirement would break the\n# stable pin, so the attack-surface fuzzing is expressed as proptest.\nproptest = \"1\"\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-14-20261027/LPp_src/docs/research/v8-r0-zk-20261009/refine/blockwriters/Cargo.toml": "[package]\nname = \"aspis-r0-block-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-14-20261027/LPp_src/docs/research/v8-r0-zk-20261009/refine/poseidon/Cargo.toml": "[package]\nname = \"aspis-r0-poseidon-copy\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-14-20261027/LPp_src/docs/research/v8-r0-zk-20261009/refine/writers/Cargo.toml": "[package]\nname = \"aspis-r0-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-14-20261027/LPp_src/crates/aspis-r1-cost-probe/Cargo.toml": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-14-20261027/LPp_src/crates/aspis-statement/Cargo.toml": "[package]\nname = \"aspis-statement\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"No-proof SpendV0 evaluator and constraint-composition kernels for Aspis\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = [\"aspis-core/r0-r91-audit\"]\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = [\"aspis-core/r0-e4-reference\"]\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = [\"aspis-core/r0-hoist-reference\"]\nr0 = [\"aspis-core/r0\"]\n# Exposes the deliberately broken lambda^0 tagged-tuple compression solely\n# for adversarial teeth/evaluation builds. The verifier program does not\n# forward this feature; enabling it requires an explicit dependency feature.\ninsecure-test-logup-compression = []\n# Derive only the public RATE512 circle/line coordinates touched by Spend\n# queries. This preserves the proof and verifier equations while allowing a\n# deployment build to dead-strip the six complete RATE512 lookup tables.\nspend-dynamic-rate512 = []\n# Host by default; the separate Pool V1 program enables this explicitly for\n# SBF. Frozen verifier builds do not enable it.\npool-v1-kernel = []\n# Audit-only algebraic rewrite for the pair-forest public-digest constraints.\n# It packs each four-lane residual before applying its common selector; the\n# default and released terminal retain the literal lane-by-lane evaluator.\npool-v1-pair-forest-packed-digest-audit = []\n# Audit-only selector-tensor continuation of packed digest binding. Each\n# binding keeps its two packed residuals, while `high[block] * low[local]` is\n# contracted as three exact local-coordinate sums.\npool-v1-pair-forest-packed-digest-selector-tensor-audit = [\n    \"pool-v1-pair-forest-packed-digest-audit\",\n]\n# Audit-only exact `{0,1}` specialization for generated pair-forest Copy\n# weights. The literal QM31-by-M31 multiplication remains the default.\npool-v1-pair-forest-binary-copy-weights-audit = []\n# Audit-only memoization of generated Copy endpoint row selectors. The cache\n# never supplies a value unless its stored row tag matches exactly.\npool-v1-pair-forest-endpoint-selector-cache-audit = []\n# Audit-only exact common-factor extraction in the selected semantic lanes.\n# It preserves all 94 source residuals and their 24 packed theta lanes.\npool-v1-pair-forest-semantic-factor-audit = []\n# Audit-only exact CSE for the fourteen generated Copy tuple patterns.\npool-v1-pair-forest-pattern-window-audit = []\n# Audit-only exact change of basis for the compiled Copy values.  Endpoint\n# selectors are accumulated by their fixed tuple-pattern coordinate before\n# the dynamic pattern values are multiplied, replacing 272 repeated QM31\n# products by the 26 nonzero coordinates of the frozen four-by-fourteen\n# support matrix.  Tags remain included through exact M31 multiplication.\npool-v1-pair-forest-copy-pattern-basis-audit = []\npool-v1-pair-forest-packed-range-audit = []\npool-v1-pair-forest-active-mask-basis-audit = []\npool-v1-pair-forest-copy-selector-tensor-basis-audit = [\n    \"pool-v1-pair-forest-copy-pattern-basis-audit\",\n]\n# Audit-only lazy-reduction dot kernel for the generated Copy tags. Endpoint\n# products are regrouped by the exact `(side, slot, local)` tensor coordinate\n# and reduced in batches of at most four M31 products.\npool-v1-pair-forest-copy-tag-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Audit-only four-product contraction of the tag/low and weight/low tensor\n# coordinates after exact endpoint collection.\npool-v1-pair-forest-copy-finish-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Native differential evidence only (D68.2): retains the pre-migration\n# pair-forest compiler (legacy writers plus relocation) as\n# `pair_forest_trace::reference`, so the shipped copy-built compiler can be\n# compared with it. Never selected by a prover or program build.\npool-v1-pair-forest-writer-reference = []\n\n[dependencies]\naspis-core.workspace = true\n\n# The shipped pair-forest trace writers are the extracted copies (D68.2). They\n# are host-only, like the trace compiler that calls them; SBF builds never\n# compile them.\n[target.'cfg(not(target_os = \"solana\"))'.dependencies]\naspis-r0-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/writers\" }\naspis-r0-block-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/blockwriters\" }\naspis-r0-poseidon-copy = { path = \"../../docs/research/v8-r0-zk-20261009/refine/poseidon\" }\n\n[dev-dependencies]\np3-field = \"=0.6.1\"\np3-mersenne-31 = \"=0.6.1\"\np3-symmetric = \"=0.6.1\"\nsha2.workspace = true\n\n[[test]]\nname = \"pair_forest_writer_migration\"\nrequired-features = [\"pool-v1-pair-forest-writer-reference\"]\n"}}
{"case": 18, "exists": true, "command": ["cargo", "metadata", "--offline", "--format-version", "1", "--manifest-path", "/home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_18/Cargo.toml"], "exit": 0, "stderr": "", "root_manifest": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "root_manifest_sha256": "6eca3f52806da138e93e8dcce079c59ee47bc954015cefa13eb10031520b8f90", "manifest": "/home/dombarker/project-offloads/codex-cx-leaf-p6-15-20261027/LPq_src/crates/aspis-r1-cost-probe/Cargo.toml", "features": "", "no_default": false, "receipts": ["LPq_K001"], "nodes": [{"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-15-20261027/LPq_src/crates/aspis-core#0.1.0", "name": "aspis-core", "version": "0.1.0", "features": ["r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-15-20261027/LPq_src/docs/research/v8-r0-zk-20261009/refine/blockwriters#aspis-r0-block-writer-copies@0.0.0", "name": "aspis-r0-block-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-15-20261027/LPq_src/docs/research/v8-r0-zk-20261009/refine/poseidon#aspis-r0-poseidon-copy@0.0.0", "name": "aspis-r0-poseidon-copy", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-15-20261027/LPq_src/docs/research/v8-r0-zk-20261009/refine/writers#aspis-r0-writer-copies@0.0.0", "name": "aspis-r0-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-15-20261027/LPq_src/crates/aspis-r1-cost-probe#0.1.0", "name": "aspis-r1-cost-probe", "version": "0.1.0", "features": ["default", "private-leaf-salts"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-leaf-p6-15-20261027/LPq_src/crates/aspis-statement#0.1.0", "name": "aspis-statement", "version": "0.1.0", "features": ["pool-v1-kernel", "r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_18#ncs-historical-root@0.0.0", "name": "ncs-historical-root", "version": "0.0.0", "features": []}], "local_manifests": {"/home/dombarker/project-offloads/codex-cx-leaf-p6-15-20261027/LPq_src/crates/aspis-core/Cargo.toml": "[package]\nname = \"aspis-core\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"Aspis native WHIR-style M31 PCS substrate: shared no_std verifier core (host + SBF byte-exact)\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = []\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = []\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = []\n# R0 semantic rows use their own wire, transcript and entrypoints.\nr0 = []\n# Native single-thread operation accounting only; never part of SBF measurements.\nr0-op-count = []\n# Exposes deliberately weakened Fiat-Shamir schedules solely so adversarial\n# tests can demonstrate their teeth. Never enable in a deployed verifier.\ninsecure-test-ordering = []\n# Exposes a verifier mode that deliberately misclassifies the diagnostic M31\n# basis as the legacy CM31 wire shape. Teeth tests only; never deploy.\ninsecure-test-framing = []\n# Exposes private decoder entry points to the isolated universal-equivalence\n# harness. This feature is never enabled by the verifier build.\nformal-verification = []\n# Default-off byte-for-CU experiment. This changes only the fixed-field wire\n# representation and is never enabled by a selected production build.\nv7-fixed-canonical-audit = []\n# Follow-up to the canonical fixed-field experiment.  The fixed records are\n# still checked by their one-pass transcript reader, while packed query limbs\n# are checked only by the gamma/opening consumer that already decodes all of\n# them.  This removes the audit parser's duplicate query-wide canonical scan.\nv7-fixed-canonical-exact-once-audit = [\"v7-fixed-canonical-audit\"]\n# Audit-only loop interchange for the fixed four-slot C1 gamma dot product.\n# The packed bytes, canonical decoder, powers, and resulting four QM31 values\n# are unchanged; only the order in which the same scalar products are summed\n# is specialized to reuse each 26-column power row across all four slots.\nv7-gamma-four-slot-block-audit = []\n\n[dependencies]\n\n[dev-dependencies]\nnum-bigint = \"0.4\"\nserde_json = \"1\"\nsha2 = \"0.10.8\"\n# Property/fuzz-style harnesses run on the pinned stable toolchain via\n# `cargo test`; cargo-fuzz's nightly+libFuzzer requirement would break the\n# stable pin, so the attack-surface fuzzing is expressed as proptest.\nproptest = \"1\"\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-15-20261027/LPq_src/docs/research/v8-r0-zk-20261009/refine/blockwriters/Cargo.toml": "[package]\nname = \"aspis-r0-block-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-15-20261027/LPq_src/docs/research/v8-r0-zk-20261009/refine/poseidon/Cargo.toml": "[package]\nname = \"aspis-r0-poseidon-copy\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-15-20261027/LPq_src/docs/research/v8-r0-zk-20261009/refine/writers/Cargo.toml": "[package]\nname = \"aspis-r0-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-15-20261027/LPq_src/crates/aspis-r1-cost-probe/Cargo.toml": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "/home/dombarker/project-offloads/codex-cx-leaf-p6-15-20261027/LPq_src/crates/aspis-statement/Cargo.toml": "[package]\nname = \"aspis-statement\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"No-proof SpendV0 evaluator and constraint-composition kernels for Aspis\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = [\"aspis-core/r0-r91-audit\"]\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = [\"aspis-core/r0-e4-reference\"]\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = [\"aspis-core/r0-hoist-reference\"]\nr0 = [\"aspis-core/r0\"]\n# Exposes the deliberately broken lambda^0 tagged-tuple compression solely\n# for adversarial teeth/evaluation builds. The verifier program does not\n# forward this feature; enabling it requires an explicit dependency feature.\ninsecure-test-logup-compression = []\n# Derive only the public RATE512 circle/line coordinates touched by Spend\n# queries. This preserves the proof and verifier equations while allowing a\n# deployment build to dead-strip the six complete RATE512 lookup tables.\nspend-dynamic-rate512 = []\n# Host by default; the separate Pool V1 program enables this explicitly for\n# SBF. Frozen verifier builds do not enable it.\npool-v1-kernel = []\n# Audit-only algebraic rewrite for the pair-forest public-digest constraints.\n# It packs each four-lane residual before applying its common selector; the\n# default and released terminal retain the literal lane-by-lane evaluator.\npool-v1-pair-forest-packed-digest-audit = []\n# Audit-only selector-tensor continuation of packed digest binding. Each\n# binding keeps its two packed residuals, while `high[block] * low[local]` is\n# contracted as three exact local-coordinate sums.\npool-v1-pair-forest-packed-digest-selector-tensor-audit = [\n    \"pool-v1-pair-forest-packed-digest-audit\",\n]\n# Audit-only exact `{0,1}` specialization for generated pair-forest Copy\n# weights. The literal QM31-by-M31 multiplication remains the default.\npool-v1-pair-forest-binary-copy-weights-audit = []\n# Audit-only memoization of generated Copy endpoint row selectors. The cache\n# never supplies a value unless its stored row tag matches exactly.\npool-v1-pair-forest-endpoint-selector-cache-audit = []\n# Audit-only exact common-factor extraction in the selected semantic lanes.\n# It preserves all 94 source residuals and their 24 packed theta lanes.\npool-v1-pair-forest-semantic-factor-audit = []\n# Audit-only exact CSE for the fourteen generated Copy tuple patterns.\npool-v1-pair-forest-pattern-window-audit = []\n# Audit-only exact change of basis for the compiled Copy values.  Endpoint\n# selectors are accumulated by their fixed tuple-pattern coordinate before\n# the dynamic pattern values are multiplied, replacing 272 repeated QM31\n# products by the 26 nonzero coordinates of the frozen four-by-fourteen\n# support matrix.  Tags remain included through exact M31 multiplication.\npool-v1-pair-forest-copy-pattern-basis-audit = []\npool-v1-pair-forest-packed-range-audit = []\npool-v1-pair-forest-active-mask-basis-audit = []\npool-v1-pair-forest-copy-selector-tensor-basis-audit = [\n    \"pool-v1-pair-forest-copy-pattern-basis-audit\",\n]\n# Audit-only lazy-reduction dot kernel for the generated Copy tags. Endpoint\n# products are regrouped by the exact `(side, slot, local)` tensor coordinate\n# and reduced in batches of at most four M31 products.\npool-v1-pair-forest-copy-tag-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Audit-only four-product contraction of the tag/low and weight/low tensor\n# coordinates after exact endpoint collection.\npool-v1-pair-forest-copy-finish-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Native differential evidence only (D68.2): retains the pre-migration\n# pair-forest compiler (legacy writers plus relocation) as\n# `pair_forest_trace::reference`, so the shipped copy-built compiler can be\n# compared with it. Never selected by a prover or program build.\npool-v1-pair-forest-writer-reference = []\n\n[dependencies]\naspis-core.workspace = true\n\n# The shipped pair-forest trace writers are the extracted copies (D68.2). They\n# are host-only, like the trace compiler that calls them; SBF builds never\n# compile them.\n[target.'cfg(not(target_os = \"solana\"))'.dependencies]\naspis-r0-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/writers\" }\naspis-r0-block-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/blockwriters\" }\naspis-r0-poseidon-copy = { path = \"../../docs/research/v8-r0-zk-20261009/refine/poseidon\" }\n\n[dev-dependencies]\np3-field = \"=0.6.1\"\np3-mersenne-31 = \"=0.6.1\"\np3-symmetric = \"=0.6.1\"\nsha2.workspace = true\n\n[[test]]\nname = \"pair_forest_writer_migration\"\nrequired-features = [\"pool-v1-pair-forest-writer-reference\"]\n"}}
{"case": 19, "exists": true, "command": ["cargo", "metadata", "--offline", "--format-version", "1", "--manifest-path", "/home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_19/Cargo.toml"], "exit": 0, "stderr": "", "root_manifest": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "root_manifest_sha256": "6eca3f52806da138e93e8dcce079c59ee47bc954015cefa13eb10031520b8f90", "manifest": "/home/dombarker/project-offloads/codex-cx-native-tx2r-20261028/NCI_src/crates/aspis-r1-cost-probe/Cargo.toml", "features": "", "no_default": false, "receipts": ["NCI_K035", "NCI_K032", "NCI_K004", "NCI_K003", "NCI_K068", "NCI_K057", "NCI_K050", "NCI_K059", "NCI_K066", "NCI_K061", "NCI_K002", "NCI_K005", "NCI_K033", "NCI_K034", "NCI_K060", "NCI_K058", "NCI_K067", "NCI_K051", "NCI_K069", "NCI_K056", "NCI_K045", "NCI_K042", "NCI_K029", "NCI_K016", "NCI_K011", "NCI_K018", "NCI_K027", "NCI_K020", "NCI_K043", "NCI_K044", "NCI_K021", "NCI_K019", "NCI_K026", "NCI_K010", "NCI_K028", "NCI_K017", "NCI_K053", "NCI_K054", "NCI_K062", "NCI_K065", "NCI_K031", "NCI_K036", "NCI_K009", "NCI_K007", "NCI_K038", "NCI_K064", "NCI_K063", "NCI_K055", "NCI_K052", "NCI_K006", "NCI_K039", "NCI_K001", "NCI_K037", "NCI_K008", "NCI_K030", "NCI_K012", "NCI_K015", "NCI_K023", "NCI_K024", "NCI_K070", "NCI_K048", "NCI_K041", "NCI_K046", "NCI_K025", "NCI_K022", "NCI_K014", "NCI_K013", "NCI_K047", "NCI_K040", "NCI_K049"], "nodes": [{"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2r-20261028/NCI_src/crates/aspis-core#0.1.0", "name": "aspis-core", "version": "0.1.0", "features": ["r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2r-20261028/NCI_src/docs/research/v8-r0-zk-20261009/refine/blockwriters#aspis-r0-block-writer-copies@0.0.0", "name": "aspis-r0-block-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2r-20261028/NCI_src/docs/research/v8-r0-zk-20261009/refine/poseidon#aspis-r0-poseidon-copy@0.0.0", "name": "aspis-r0-poseidon-copy", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2r-20261028/NCI_src/docs/research/v8-r0-zk-20261009/refine/writers#aspis-r0-writer-copies@0.0.0", "name": "aspis-r0-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2r-20261028/NCI_src/crates/aspis-r1-cost-probe#0.1.0", "name": "aspis-r1-cost-probe", "version": "0.1.0", "features": ["default", "private-leaf-salts"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2r-20261028/NCI_src/crates/aspis-statement#0.1.0", "name": "aspis-statement", "version": "0.1.0", "features": ["pool-v1-kernel", "r0"]}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_19#ncs-historical-root@0.0.0", "name": "ncs-historical-root", "version": "0.0.0", "features": []}], "local_manifests": {"/home/dombarker/project-offloads/codex-cx-native-tx2r-20261028/NCI_src/crates/aspis-core/Cargo.toml": "[package]\nname = \"aspis-core\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"Aspis native WHIR-style M31 PCS substrate: shared no_std verifier core (host + SBF byte-exact)\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = []\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = []\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = []\n# R0 semantic rows use their own wire, transcript and entrypoints.\nr0 = []\n# Native single-thread operation accounting only; never part of SBF measurements.\nr0-op-count = []\n# Exposes deliberately weakened Fiat-Shamir schedules solely so adversarial\n# tests can demonstrate their teeth. Never enable in a deployed verifier.\ninsecure-test-ordering = []\n# Exposes a verifier mode that deliberately misclassifies the diagnostic M31\n# basis as the legacy CM31 wire shape. Teeth tests only; never deploy.\ninsecure-test-framing = []\n# Exposes private decoder entry points to the isolated universal-equivalence\n# harness. This feature is never enabled by the verifier build.\nformal-verification = []\n# Default-off byte-for-CU experiment. This changes only the fixed-field wire\n# representation and is never enabled by a selected production build.\nv7-fixed-canonical-audit = []\n# Follow-up to the canonical fixed-field experiment.  The fixed records are\n# still checked by their one-pass transcript reader, while packed query limbs\n# are checked only by the gamma/opening consumer that already decodes all of\n# them.  This removes the audit parser's duplicate query-wide canonical scan.\nv7-fixed-canonical-exact-once-audit = [\"v7-fixed-canonical-audit\"]\n# Audit-only loop interchange for the fixed four-slot C1 gamma dot product.\n# The packed bytes, canonical decoder, powers, and resulting four QM31 values\n# are unchanged; only the order in which the same scalar products are summed\n# is specialized to reuse each 26-column power row across all four slots.\nv7-gamma-four-slot-block-audit = []\n\n[dependencies]\n\n[dev-dependencies]\nnum-bigint = \"0.4\"\nserde_json = \"1\"\nsha2 = \"0.10.8\"\n# Property/fuzz-style harnesses run on the pinned stable toolchain via\n# `cargo test`; cargo-fuzz's nightly+libFuzzer requirement would break the\n# stable pin, so the attack-surface fuzzing is expressed as proptest.\nproptest = \"1\"\n", "/home/dombarker/project-offloads/codex-cx-native-tx2r-20261028/NCI_src/docs/research/v8-r0-zk-20261009/refine/blockwriters/Cargo.toml": "[package]\nname = \"aspis-r0-block-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-native-tx2r-20261028/NCI_src/docs/research/v8-r0-zk-20261009/refine/poseidon/Cargo.toml": "[package]\nname = \"aspis-r0-poseidon-copy\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-native-tx2r-20261028/NCI_src/docs/research/v8-r0-zk-20261009/refine/writers/Cargo.toml": "[package]\nname = \"aspis-r0-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-native-tx2r-20261028/NCI_src/crates/aspis-r1-cost-probe/Cargo.toml": "[package]\nname = \"aspis-r1-cost-probe\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE, isolated P2 experiments\"\n\n[features]\n# PREREG-PROOF-SIZE-2 (2026-10-19): the adopted R1 proof format is the compact\n# binary-multiproof format (fixed length 57,607 bytes), which is defined only\n# over private leaf salts; the default build therefore carries them.\ndefault = [\"private-leaf-salts\"]\ndetail-phases = []\n# Existing exact terminal kernels from the selected V7/R117 bundle.\n# This changes arithmetic evaluation only; the isolated R1 protocol is unproved.\noptimized-terminal = [\n    \"aspis-statement/pool-v1-pair-forest-packed-digest-selector-tensor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-binary-copy-weights-audit\",\n    \"aspis-statement/pool-v1-pair-forest-endpoint-selector-cache-audit\",\n    \"aspis-statement/pool-v1-pair-forest-semantic-factor-audit\",\n    \"aspis-statement/pool-v1-pair-forest-pattern-window-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-tag-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-copy-finish-dot-basis-audit\",\n    \"aspis-statement/pool-v1-pair-forest-packed-range-audit\",\n    \"aspis-statement/pool-v1-pair-forest-active-mask-basis-audit\",\n]\nprover = [\"private-leaf-salts\", \"dep:aspis-prover\", \"dep:serde_json\", \"dep:sha2\"]\nprivate-leaf-salts = []\n# LOG D38.3: the prover-side P_R1 check (extracted C3 checker via the z4 probe\n# library) and the capped retry loop; requires private leaf salts.\nr1p-check = [\"prover\", \"private-leaf-salts\", \"dep:aspis-z4b-probe\", \"dep:getrandom\"]\nr0-op-count = [\"aspis-core/r0-op-count\"]\n# AUDIT ONLY (PREREG-PROOF-SIZE-2 item 4): the retired eight-way verifier\n# (124,343-byte proof) under `verifier::eight_way`, for differential evidence\n# against saved eight-way fixtures. It never changes the default entrypoints,\n# and it is a compile error together with `prover` or on an SBF target.\naudit-eight-way = []\n# Internal marker set by program dependencies, including native program tests.\nprogram-build = []\n\n[dependencies]\naspis-core = { path = \"../aspis-core\", features = [\"r0\"] }\naspis-statement = { path = \"../aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\naspis-prover = { path = \"../aspis-prover\", features = [\"r0\", \"insecure-spend-fixture\"], optional = true }\nserde_json = { workspace = true, optional = true }\nsha2 = { workspace = true, optional = true }\naspis-z4b-probe = { path = \"../../docs/research/v8-r0-zk-20261009/z4\", optional = true }\ngetrandom = { workspace = true, optional = true }\n\n# Historical S1 tool: reads saved eight-way fixtures with the eight-way\n# verifier and the host prover, a combination the adopted tree forbids\n# (`audit-eight-way` + `prover`). Kept for the record; not buildable.\n[[example]]\nname = \"proof_size_s1\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"proof_size_s2\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"readbudget_count\"\nrequired-features = [\"prover\", \"compact-binary\"]\n\n[[example]]\nname = \"semantic_gate\"\nrequired-features = [\"prover\"]\n\n# Eight-way mutation offsets (pre-adoption gate); not buildable on the\n# adopted tree for the same reason as proof_size_s1.\n[[example]]\nname = \"native_gate\"\nrequired-features = [\"prover\", \"audit-eight-way\"]\n\n[[example]]\nname = \"masked_fixture_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"authenticated_tx2_gate\"\nrequired-features = [\"prover\"]\n\n[[example]]\nname = \"secure_attempt_gate\"\nrequired-features = [\"prover\", \"private-leaf-salts\"]\n\n[[example]]\nname = \"r1p_retry_gate\"\nrequired-features = [\"r1p-check\"]\n\n[[example]]\nname = \"r1p_sim_gate\"\nrequired-features = [\"r1p-check\"]\n", "/home/dombarker/project-offloads/codex-cx-native-tx2r-20261028/NCI_src/crates/aspis-statement/Cargo.toml": "[package]\nname = \"aspis-statement\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"No-proof SpendV0 evaluator and constraint-composition kernels for Aspis\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = [\"aspis-core/r0-r91-audit\"]\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = [\"aspis-core/r0-e4-reference\"]\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = [\"aspis-core/r0-hoist-reference\"]\nr0 = [\"aspis-core/r0\"]\n# Exposes the deliberately broken lambda^0 tagged-tuple compression solely\n# for adversarial teeth/evaluation builds. The verifier program does not\n# forward this feature; enabling it requires an explicit dependency feature.\ninsecure-test-logup-compression = []\n# Derive only the public RATE512 circle/line coordinates touched by Spend\n# queries. This preserves the proof and verifier equations while allowing a\n# deployment build to dead-strip the six complete RATE512 lookup tables.\nspend-dynamic-rate512 = []\n# Host by default; the separate Pool V1 program enables this explicitly for\n# SBF. Frozen verifier builds do not enable it.\npool-v1-kernel = []\n# Audit-only algebraic rewrite for the pair-forest public-digest constraints.\n# It packs each four-lane residual before applying its common selector; the\n# default and released terminal retain the literal lane-by-lane evaluator.\npool-v1-pair-forest-packed-digest-audit = []\n# Audit-only selector-tensor continuation of packed digest binding. Each\n# binding keeps its two packed residuals, while `high[block] * low[local]` is\n# contracted as three exact local-coordinate sums.\npool-v1-pair-forest-packed-digest-selector-tensor-audit = [\n    \"pool-v1-pair-forest-packed-digest-audit\",\n]\n# Audit-only exact `{0,1}` specialization for generated pair-forest Copy\n# weights. The literal QM31-by-M31 multiplication remains the default.\npool-v1-pair-forest-binary-copy-weights-audit = []\n# Audit-only memoization of generated Copy endpoint row selectors. The cache\n# never supplies a value unless its stored row tag matches exactly.\npool-v1-pair-forest-endpoint-selector-cache-audit = []\n# Audit-only exact common-factor extraction in the selected semantic lanes.\n# It preserves all 94 source residuals and their 24 packed theta lanes.\npool-v1-pair-forest-semantic-factor-audit = []\n# Audit-only exact CSE for the fourteen generated Copy tuple patterns.\npool-v1-pair-forest-pattern-window-audit = []\n# Audit-only exact change of basis for the compiled Copy values.  Endpoint\n# selectors are accumulated by their fixed tuple-pattern coordinate before\n# the dynamic pattern values are multiplied, replacing 272 repeated QM31\n# products by the 26 nonzero coordinates of the frozen four-by-fourteen\n# support matrix.  Tags remain included through exact M31 multiplication.\npool-v1-pair-forest-copy-pattern-basis-audit = []\npool-v1-pair-forest-packed-range-audit = []\npool-v1-pair-forest-active-mask-basis-audit = []\npool-v1-pair-forest-copy-selector-tensor-basis-audit = [\n    \"pool-v1-pair-forest-copy-pattern-basis-audit\",\n]\n# Audit-only lazy-reduction dot kernel for the generated Copy tags. Endpoint\n# products are regrouped by the exact `(side, slot, local)` tensor coordinate\n# and reduced in batches of at most four M31 products.\npool-v1-pair-forest-copy-tag-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Audit-only four-product contraction of the tag/low and weight/low tensor\n# coordinates after exact endpoint collection.\npool-v1-pair-forest-copy-finish-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Native differential evidence only (D68.2): retains the pre-migration\n# pair-forest compiler (legacy writers plus relocation) as\n# `pair_forest_trace::reference`, so the shipped copy-built compiler can be\n# compared with it. Never selected by a prover or program build.\npool-v1-pair-forest-writer-reference = []\n\n[dependencies]\naspis-core.workspace = true\n\n# The shipped pair-forest trace writers are the extracted copies (D68.2). They\n# are host-only, like the trace compiler that calls them; SBF builds never\n# compile them.\n[target.'cfg(not(target_os = \"solana\"))'.dependencies]\naspis-r0-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/writers\" }\naspis-r0-block-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/blockwriters\" }\naspis-r0-poseidon-copy = { path = \"../../docs/research/v8-r0-zk-20261009/refine/poseidon\" }\n\n[dev-dependencies]\np3-field = \"=0.6.1\"\np3-mersenne-31 = \"=0.6.1\"\np3-symmetric = \"=0.6.1\"\nsha2.workspace = true\n\n[[test]]\nname = \"pair_forest_writer_migration\"\nrequired-features = [\"pool-v1-pair-forest-writer-reference\"]\n"}}
{"case": 20, "exists": true, "command": ["cargo", "metadata", "--offline", "--format-version", "1", "--manifest-path", "/home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_20/Cargo.toml"], "exit": 0, "stderr": "", "root_manifest": "[package]\nname = \"aspis-statement\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"No-proof SpendV0 evaluator and constraint-composition kernels for Aspis\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = [\"aspis-core/r0-r91-audit\"]\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = [\"aspis-core/r0-e4-reference\"]\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = [\"aspis-core/r0-hoist-reference\"]\nr0 = [\"aspis-core/r0\"]\n# Exposes the deliberately broken lambda^0 tagged-tuple compression solely\n# for adversarial teeth/evaluation builds. The verifier program does not\n# forward this feature; enabling it requires an explicit dependency feature.\ninsecure-test-logup-compression = []\n# Derive only the public RATE512 circle/line coordinates touched by Spend\n# queries. This preserves the proof and verifier equations while allowing a\n# deployment build to dead-strip the six complete RATE512 lookup tables.\nspend-dynamic-rate512 = []\n# Host by default; the separate Pool V1 program enables this explicitly for\n# SBF. Frozen verifier builds do not enable it.\npool-v1-kernel = []\n# Audit-only algebraic rewrite for the pair-forest public-digest constraints.\n# It packs each four-lane residual before applying its common selector; the\n# default and released terminal retain the literal lane-by-lane evaluator.\npool-v1-pair-forest-packed-digest-audit = []\n# Audit-only selector-tensor continuation of packed digest binding. Each\n# binding keeps its two packed residuals, while `high[block] * low[local]` is\n# contracted as three exact local-coordinate sums.\npool-v1-pair-forest-packed-digest-selector-tensor-audit = [\n    \"pool-v1-pair-forest-packed-digest-audit\",\n]\n# Audit-only exact `{0,1}` specialization for generated pair-forest Copy\n# weights. The literal QM31-by-M31 multiplication remains the default.\npool-v1-pair-forest-binary-copy-weights-audit = []\n# Audit-only memoization of generated Copy endpoint row selectors. The cache\n# never supplies a value unless its stored row tag matches exactly.\npool-v1-pair-forest-endpoint-selector-cache-audit = []\n# Audit-only exact common-factor extraction in the selected semantic lanes.\n# It preserves all 94 source residuals and their 24 packed theta lanes.\npool-v1-pair-forest-semantic-factor-audit = []\n# Audit-only exact CSE for the fourteen generated Copy tuple patterns.\npool-v1-pair-forest-pattern-window-audit = []\n# Audit-only exact change of basis for the compiled Copy values.  Endpoint\n# selectors are accumulated by their fixed tuple-pattern coordinate before\n# the dynamic pattern values are multiplied, replacing 272 repeated QM31\n# products by the 26 nonzero coordinates of the frozen four-by-fourteen\n# support matrix.  Tags remain included through exact M31 multiplication.\npool-v1-pair-forest-copy-pattern-basis-audit = []\npool-v1-pair-forest-packed-range-audit = []\npool-v1-pair-forest-active-mask-basis-audit = []\npool-v1-pair-forest-copy-selector-tensor-basis-audit = [\n    \"pool-v1-pair-forest-copy-pattern-basis-audit\",\n]\n# Audit-only lazy-reduction dot kernel for the generated Copy tags. Endpoint\n# products are regrouped by the exact `(side, slot, local)` tensor coordinate\n# and reduced in batches of at most four M31 products.\npool-v1-pair-forest-copy-tag-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Audit-only four-product contraction of the tag/low and weight/low tensor\n# coordinates after exact endpoint collection.\npool-v1-pair-forest-copy-finish-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Native differential evidence only (D68.2): retains the pre-migration\n# pair-forest compiler (legacy writers plus relocation) as\n# `pair_forest_trace::reference`, so the shipped copy-built compiler can be\n# compared with it. Never selected by a prover or program build.\npool-v1-pair-forest-writer-reference = []\n\n[dependencies]\naspis-core.workspace = true\n\n# The shipped pair-forest trace writers are the extracted copies (D68.2). They\n# are host-only, like the trace compiler that calls them; SBF builds never\n# compile them.\n[target.'cfg(not(target_os = \"solana\"))'.dependencies]\naspis-r0-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/writers\" }\naspis-r0-block-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/blockwriters\" }\naspis-r0-poseidon-copy = { path = \"../../docs/research/v8-r0-zk-20261009/refine/poseidon\" }\n\n[dev-dependencies]\np3-field = \"=0.6.1\"\np3-mersenne-31 = \"=0.6.1\"\np3-symmetric = \"=0.6.1\"\nsha2.workspace = true\n\n[[test]]\nname = \"pair_forest_writer_migration\"\nrequired-features = [\"pool-v1-pair-forest-writer-reference\"]\n", "root_manifest_sha256": "ba08c65cafc60a7a747457163e72a1d184068a239466516f3a3e8bdb4ab8c9f2", "manifest": "/home/dombarker/project-offloads/codex-cx-native-tx2f-20261027/NBN_src/crates/aspis-statement/Cargo.toml", "features": "", "no_default": false, "receipts": ["NBN_K005", "NBN_K004", "NBN_K003", "NBN_K010", "NBN_K017", "NBN_K016", "NBN_K011", "NBN_K018", "NBN_K006", "NBN_K001", "NBN_K008", "NBN_K009", "NBN_K007", "NBN_K014", "NBN_K013", "NBN_K012", "NBN_K015"], "nodes": [{"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2f-20261027/NBN_src/crates/aspis-core#0.1.0", "name": "aspis-core", "version": "0.1.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2f-20261027/NBN_src/docs/research/v8-r0-zk-20261009/refine/blockwriters#aspis-r0-block-writer-copies@0.0.0", "name": "aspis-r0-block-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2f-20261027/NBN_src/docs/research/v8-r0-zk-20261009/refine/poseidon#aspis-r0-poseidon-copy@0.0.0", "name": "aspis-r0-poseidon-copy", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2f-20261027/NBN_src/docs/research/v8-r0-zk-20261009/refine/writers#aspis-r0-writer-copies@0.0.0", "name": "aspis-r0-writer-copies", "version": "0.0.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-tx2f-20261027/NBN_src/crates/aspis-statement#0.1.0", "name": "aspis-statement", "version": "0.1.0", "features": []}, {"id": "path+file:///home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_20#ncs-historical-root@0.0.0", "name": "ncs-historical-root", "version": "0.0.0", "features": []}], "local_manifests": {"/home/dombarker/project-offloads/codex-cx-native-tx2f-20261027/NBN_src/crates/aspis-core/Cargo.toml": "[package]\nname = \"aspis-core\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"Aspis native WHIR-style M31 PCS substrate: shared no_std verifier core (host + SBF byte-exact)\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = []\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = []\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = []\n# R0 semantic rows use their own wire, transcript and entrypoints.\nr0 = []\n# Native single-thread operation accounting only; never part of SBF measurements.\nr0-op-count = []\n# Exposes deliberately weakened Fiat-Shamir schedules solely so adversarial\n# tests can demonstrate their teeth. Never enable in a deployed verifier.\ninsecure-test-ordering = []\n# Exposes a verifier mode that deliberately misclassifies the diagnostic M31\n# basis as the legacy CM31 wire shape. Teeth tests only; never deploy.\ninsecure-test-framing = []\n# Exposes private decoder entry points to the isolated universal-equivalence\n# harness. This feature is never enabled by the verifier build.\nformal-verification = []\n# Default-off byte-for-CU experiment. This changes only the fixed-field wire\n# representation and is never enabled by a selected production build.\nv7-fixed-canonical-audit = []\n# Follow-up to the canonical fixed-field experiment.  The fixed records are\n# still checked by their one-pass transcript reader, while packed query limbs\n# are checked only by the gamma/opening consumer that already decodes all of\n# them.  This removes the audit parser's duplicate query-wide canonical scan.\nv7-fixed-canonical-exact-once-audit = [\"v7-fixed-canonical-audit\"]\n# Audit-only loop interchange for the fixed four-slot C1 gamma dot product.\n# The packed bytes, canonical decoder, powers, and resulting four QM31 values\n# are unchanged; only the order in which the same scalar products are summed\n# is specialized to reuse each 26-column power row across all four slots.\nv7-gamma-four-slot-block-audit = []\n\n[dependencies]\n\n[dev-dependencies]\nnum-bigint = \"0.4\"\nserde_json = \"1\"\nsha2 = \"0.10.8\"\n# Property/fuzz-style harnesses run on the pinned stable toolchain via\n# `cargo test`; cargo-fuzz's nightly+libFuzzer requirement would break the\n# stable pin, so the attack-surface fuzzing is expressed as proptest.\nproptest = \"1\"\n", "/home/dombarker/project-offloads/codex-cx-native-tx2f-20261027/NBN_src/docs/research/v8-r0-zk-20261009/refine/blockwriters/Cargo.toml": "[package]\nname = \"aspis-r0-block-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-native-tx2f-20261027/NBN_src/docs/research/v8-r0-zk-20261009/refine/poseidon/Cargo.toml": "[package]\nname = \"aspis-r0-poseidon-copy\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-native-tx2f-20261027/NBN_src/docs/research/v8-r0-zk-20261009/refine/writers/Cargo.toml": "[package]\nname = \"aspis-r0-writer-copies\"\nversion = \"0.0.0\"\nedition = \"2021\"\npublish = false\n\n[lib]\npath = \"src/lib.rs\"\n\n", "/home/dombarker/project-offloads/codex-cx-native-tx2f-20261027/NBN_src/crates/aspis-statement/Cargo.toml": "[package]\nname = \"aspis-statement\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"No-proof SpendV0 evaluator and constraint-composition kernels for Aspis\"\n\n[features]\n# R-E4 measured regression: retained for audit, never selected by default.\nr0-r91-audit = [\"aspis-core/r0-r91-audit\"]\n# Frozen R-E3 differential and passive field-byte tracing; native only.\nr0-e4-reference = [\"aspis-core/r0-e4-reference\"]\n# Native differential evidence only; absent from the SBF probe.\nr0-hoist-reference = [\"aspis-core/r0-hoist-reference\"]\nr0 = [\"aspis-core/r0\"]\n# Exposes the deliberately broken lambda^0 tagged-tuple compression solely\n# for adversarial teeth/evaluation builds. The verifier program does not\n# forward this feature; enabling it requires an explicit dependency feature.\ninsecure-test-logup-compression = []\n# Derive only the public RATE512 circle/line coordinates touched by Spend\n# queries. This preserves the proof and verifier equations while allowing a\n# deployment build to dead-strip the six complete RATE512 lookup tables.\nspend-dynamic-rate512 = []\n# Host by default; the separate Pool V1 program enables this explicitly for\n# SBF. Frozen verifier builds do not enable it.\npool-v1-kernel = []\n# Audit-only algebraic rewrite for the pair-forest public-digest constraints.\n# It packs each four-lane residual before applying its common selector; the\n# default and released terminal retain the literal lane-by-lane evaluator.\npool-v1-pair-forest-packed-digest-audit = []\n# Audit-only selector-tensor continuation of packed digest binding. Each\n# binding keeps its two packed residuals, while `high[block] * low[local]` is\n# contracted as three exact local-coordinate sums.\npool-v1-pair-forest-packed-digest-selector-tensor-audit = [\n    \"pool-v1-pair-forest-packed-digest-audit\",\n]\n# Audit-only exact `{0,1}` specialization for generated pair-forest Copy\n# weights. The literal QM31-by-M31 multiplication remains the default.\npool-v1-pair-forest-binary-copy-weights-audit = []\n# Audit-only memoization of generated Copy endpoint row selectors. The cache\n# never supplies a value unless its stored row tag matches exactly.\npool-v1-pair-forest-endpoint-selector-cache-audit = []\n# Audit-only exact common-factor extraction in the selected semantic lanes.\n# It preserves all 94 source residuals and their 24 packed theta lanes.\npool-v1-pair-forest-semantic-factor-audit = []\n# Audit-only exact CSE for the fourteen generated Copy tuple patterns.\npool-v1-pair-forest-pattern-window-audit = []\n# Audit-only exact change of basis for the compiled Copy values.  Endpoint\n# selectors are accumulated by their fixed tuple-pattern coordinate before\n# the dynamic pattern values are multiplied, replacing 272 repeated QM31\n# products by the 26 nonzero coordinates of the frozen four-by-fourteen\n# support matrix.  Tags remain included through exact M31 multiplication.\npool-v1-pair-forest-copy-pattern-basis-audit = []\npool-v1-pair-forest-packed-range-audit = []\npool-v1-pair-forest-active-mask-basis-audit = []\npool-v1-pair-forest-copy-selector-tensor-basis-audit = [\n    \"pool-v1-pair-forest-copy-pattern-basis-audit\",\n]\n# Audit-only lazy-reduction dot kernel for the generated Copy tags. Endpoint\n# products are regrouped by the exact `(side, slot, local)` tensor coordinate\n# and reduced in batches of at most four M31 products.\npool-v1-pair-forest-copy-tag-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Audit-only four-product contraction of the tag/low and weight/low tensor\n# coordinates after exact endpoint collection.\npool-v1-pair-forest-copy-finish-dot-basis-audit = [\n    \"pool-v1-pair-forest-copy-selector-tensor-basis-audit\",\n]\n# Native differential evidence only (D68.2): retains the pre-migration\n# pair-forest compiler (legacy writers plus relocation) as\n# `pair_forest_trace::reference`, so the shipped copy-built compiler can be\n# compared with it. Never selected by a prover or program build.\npool-v1-pair-forest-writer-reference = []\n\n[dependencies]\naspis-core.workspace = true\n\n# The shipped pair-forest trace writers are the extracted copies (D68.2). They\n# are host-only, like the trace compiler that calls them; SBF builds never\n# compile them.\n[target.'cfg(not(target_os = \"solana\"))'.dependencies]\naspis-r0-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/writers\" }\naspis-r0-block-writer-copies = { path = \"../../docs/research/v8-r0-zk-20261009/refine/blockwriters\" }\naspis-r0-poseidon-copy = { path = \"../../docs/research/v8-r0-zk-20261009/refine/poseidon\" }\n\n[dev-dependencies]\np3-field = \"=0.6.1\"\np3-mersenne-31 = \"=0.6.1\"\np3-symmetric = \"=0.6.1\"\nsha2.workspace = true\n\n[[test]]\nname = \"pair_forest_writer_migration\"\nrequired-features = [\"pool-v1-pair-forest-writer-reference\"]\n"}}
{"case": 21, "exists": true, "command": ["cargo", "metadata", "--offline", "--format-version", "1", "--manifest-path", "/home/dombarker/project-offloads/codex-cx-native-featparity-20261028/NCS_historical_21/Cargo.toml"], "exit": 0, "stderr": "", "root_manifest": "[package]\nname = \"aspis-r1-cost-probe-program\"\nedition.workspace = true\nlicense.workspace = true\nversion.workspace = true\ndescription = \"UNPROVED R1 COST PROBE SBF entrypoint\"\n[lib]\ncrate-type = [\"cdylib\", \"lib\"]\n[features]\ndefault = [\"custom-heap\"]\ncustom-heap = []\ncustom-panic = []\n# Internal phase/CU diagnostics are opt-in; release verification has no observer.\ncu-profiling = []\nno-entrypoint = []\npool-adapter = []\n# Kept for the pinned build command lines; the adopted compact binary-multiproof\n# format (PREREG-PROOF-SIZE-2) is defined over private leaf salts, which the\n# verifier crate now enables by default.\nprivate-leaf-salts = [\"aspis-r1-cost-probe/private-leaf-salts\"]\n[dependencies]\naspis-r1-cost-probe = { path = \"../../crates/aspis-r1-cost-probe\", features = [\"optimized-terminal\", \"program-build\"] }\naspis-statement = { path = \"../../crates/aspis-statement\", features = [\"r0\", \"pool-v1-kernel\"] }\nsolana-program.workspace = true\naspis-core = { path = \"../../crates/aspis-core\" }\n", "root_manifest_sha256": "6aa7d08708762ddadf3a6173b14256d7c5a3f1eba12e8631e9abb0c154eebe7b", "manifest": "/home/dombarker/project-offloads/codex-cx-native-tx2g-20261028/NBP_src/programs/r1-cost-probe/Cargo.toml", "features": "pool-adapter,private-leaf-salts", "no_default": false, "receipts": ["NBP_K011", "NBP_K016", "NBP_K017", "NBP_K010", "NBP_K003", "NBP_K004", "NBP_K005", "NBP_K002", "NBP_K015", "NBP_K012", "NBP_K040", "NBP_K013", "NBP_K014", "NBP_K009", "NBP_K007", "NBP_K001", "NBP_K006", "NBP_K008"], "nodes": [{"id": "registry+https://github.com/rust-lang/crates.io-index#ahash@0.8.12", "name": "ahash", "version": "0.8.12", "features": []}, {"id": "registry+https://github