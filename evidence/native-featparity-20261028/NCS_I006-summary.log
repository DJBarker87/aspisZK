\n}\n#[kani::proof] #[kani::unwind(32)]\n#[kani::stub(<[u8]>::copy_from_slice,crate::NBS_copy::KMX_copy_from_slice)]\n#[kani::stub(core::ptr::copy_nonoverlapping,crate::NBS_copy::KMX_copy_nonoverlapping)]\n#[kani::stub(<[u8]>::clone_from_slice,crate::NBS_copy::KMX_clone_from_slice)]\n#[kani::stub(alloc::vec::Vec::<u8>::extend_from_slice,crate::NBS_copy::KMX_extend_from_slice)]\n#[kani::stub(<[u8]>::to_vec,crate::NBS_copy::KMX_to_vec)]\n#[kani::stub(alloc::alloc::realloc,crate::NBS_copy::KMX_realloc)]\nfn byte_fill_cell(){\nlet mut storage=core::mem::MaybeUninit::<[u8;14759]>::uninit();let ptr=storage.as_mut_ptr() as *mut u8;\n let i:usize=kani::any();let j:usize=kani::any();kani::assume(i<14759&&j<14759);let old:u8=kani::any();let value:u8=kani::any();\n unsafe{ptr.add(j).write(old);core::ptr::write_bytes(ptr.add(i),value,1);assert!(*ptr.add(i)==value);}\n}\n#[kani::proof] #[kani::unwind(32)]\n#[kani::stub(<[u8]>::copy_from_slice,crate::NBS_copy::KMX_copy_from_slice)]\n#[kani::stub(core::ptr::copy_nonoverlapping,crate::NBS_copy::KMX_copy_nonoverlapping)]\n#[kani::stub(<[u8]>::clone_from_slice,crate::NBS_copy::KMX_clone_from_slice)]\n#[kani::stub(alloc::vec::Vec::<u8>::extend_from_slice,crate::NBS_copy::KMX_extend_from_slice)]\n#[kani::stub(<[u8]>::to_vec,crate::NBS_copy::KMX_to_vec)]\n#[kani::stub(alloc::alloc::realloc,crate::NBS_copy::KMX_realloc)]\nfn byte_fill_frame(){\nlet mut storage=core::mem::MaybeUninit::<[u8;14759]>::uninit();let ptr=storage.as_mut_ptr() as *mut u8;\n let i:usize=kani::any();let j:usize=kani::any();kani::assume(i<14759&&j<14759);let old:u8=kani::any();let value:u8=kani::any();\n unsafe{ptr.add(j).write(old);core::ptr::write_bytes(ptr.add(i),value,1);if j!=i{assert!(*ptr.add(j)==old);}}\n}\n}\n\n#[cfg(kani)] mod NCD_prestate {\nuse super::*;\n#[kani::proof] #[kani::unwind(512)]\n#[kani::stub(<[u8]>::copy_from_slice,crate::NBS_copy::KMX_copy_from_slice)]\n#[kani::stub(core::ptr::copy_nonoverlapping,crate::NBS_copy::KMX_copy_nonoverlapping)]\n