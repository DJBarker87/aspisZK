value(TABLE_A[index & 511]);\n    let right = table_value(TABLE_B[index >> 9]);\n    let point = left.mul(right);\n    Point {\n        x: point.a,\n        y: point.b,\n    }\n}\n\n/// Return the R0 line node `2*x^2 - 1` for this checked fibre index.\n#[inline]\npub fn line_node(u: FibreIndex) -> M31 {\n    let x = fibre_point(u).x;\n    let square = x.mul(x);\n    square.double().sub(M31::ONE)\n}\n\n#[cfg(kani)]\nmod NBS_tables {\n use super::*;\n #[kani::proof] #[kani::unwind(4)]\n fn table_total() {\n  let a:u32=kani::any();let b:u32=kani::any();let x=table_value((a,b));\n  assert!(x.a.0==a);assert!(x.b.0==b);\n }\n #[kani::proof] #[kani::unwind(4)]\n fn table_canonical() {\n  let i:usize=kani::any();kani::assume(i<512);\n  assert!(TABLE_A[i].0<0x7fff_ffff);assert!(TABLE_A[i].1<0x7fff_ffff);\n  assert!(TABLE_B[i].0<0x7fff_ffff);assert!(TABLE_B[i].1<0x7fff_ffff);\n }\n}\n\n#[cfg(kani)]\nmod NBS_route {\n use super::*;\n static mut EXPECT:usize=0;static mut CALLS:u8=0;static mut A:u32=0;static mut B:u32=0;\n fn cm_mul(x:CM31,y:CM31)->CM31 {\n  unsafe {\n   assert!(CALLS==0);CALLS=1;\n   assert!(x.a.0==TABLE_A[EXPECT&511].0);assert!(x.b.0==TABLE_A[EXPECT&511].1);\n   assert!(y.a.0==TABLE_B[EXPECT>>9].0);assert!(y.b.0==TABLE_B[EXPECT>>9].1);\n  }\n  assert!(x.a.0<0x7fff_ffff&&x.b.0<0x7fff_ffff&&y.a.0<0x7fff_ffff&&y.b.0<0x7fff_ffff);\n  let p=2147483647u64;\n  let a=u64::from(x.a.0);let b=u64::from(x.b.0);let c=u64::from(y.a.0);let d=u64::from(y.b.0);\n  let ac=a.wrapping_mul(c)%p;let bd=b.wrapping_mul(d)%p;\n  let cross=a.wrapping_add(b).wrapping_mul(c.wrapping_add(d))%p;\n  let real=(ac+p-bd)%p;let imag=((cross+p-ac)%p+p-bd)%p;\n  let ra:u32=kani::any();let rb:u32=kani::any();\n  kani::assume(u64::from(ra)==real&&u64::from(rb)==imag);\n  unsafe{A=ra;B=rb;}\n  CM31::new(M31(ra),M31(rb))\n }\n #[kani::proof] #[kani::unwind(4)]\n #[kani::stub(CM31::mul,cm_mul)]\n fn fibre() {\n  let u:usize=kani::any();kani::assume(u<262144);\n  unsafe{EXPECT=u;CALLS=0;}\n  let p=fibre_point(FibreIndex::new(u).unwrap());\n  unsafe{assert!(CALLS==1);assert!(p.x.0==A);assert!(p.y.0==B);}\n }\n\n#[kani::proof] #[kani::unwind(8192)]\n #[kani::stub(CM31::mul,cm_mul)]\n #[kani::stub(<[u8]>::copy_from_slice,crate::NBS_copy::KMX_copy_from_slice)]\n#[kani::stub(core::ptr::copy_nonoverlapping,crate::NBS_copy::KMX_copy_nonoverlapping)]\n#[kani::stub(<[u8]>::clone_from_slice,crate::NBS_copy::KMX_clone_from_slice)]\n#[kani::stub(alloc::vec::Vec::<u8>::extend_from_slice,crate::NBS_copy::KMX_extend_from_slice)]\n#[kani::stub(<[u8]>::to_vec,crate::NBS_copy::KMX_to_vec)]\n#[kani::stub(alloc::alloc::realloc,crate::NBS_copy::KMX_realloc)]\nfn NBS_recheck_30() {\n  let u:usize=kani::any();kani::assume(u<262144);\n  unsafe{EXPECT=u;CALLS=0;}\n  let p=fibre_point(FibreIndex::new(u).unwrap());\n  unsafe{assert!(CALLS==1);assert!(p.x.0==A);assert!(p.y.0==B);}\n }\n\n static mut SQUARE:u32=0;static mut MCALLS:u8=0;\n fn base_mul(x:M31,y:M31)->M31 {\n  unsafe{assert!(MCALLS==0);MCALLS=1;assert!(x.0==A);assert!(y.0==A);}\n  assert!(x.0<2147483647&&y.0<2147483647);\n  let reply:u32=kani::any();\n  kani::assume(u64::from(reply)==u64::from(x.0).wrapping_mul(u64::from(y.0))%2147483647);\n  unsafe{SQUARE=reply;}\n  M31(reply)\n }\n #[kani::proof] #[kani::unwind(4)]\n #[kani::stub(CM31::mul,cm_mul)] #[kani::stub(M31::mul,base_mul)]\n fn line() {\n  let u:usize=kani::any();kani::assume(u<262144);\n  unsafe{EXPECT=u;CALLS=0;MCALLS=0;}\n  let result=line_node(FibreIndex::new(u).unwrap());\n  unsafe{\n   assert!(CALLS==1&&MCALLS==1);\n   assert!(u64::from(result.0)==(2*u64::from(SQUARE)+2147483647-1)%2147483647);\n  }\n }\n\n#[kani::proof] #[kani::unwind(8192)]\n #[kani::stub(CM31::mul,cm_mul)] #[kani::stub(M31::mul,base_mul)]\n #[kani::stub(<[u8]>::copy_from_slice,crate::NBS_copy::KMX_copy_from_slice)]\n#[kani::stub(core::ptr::copy_nonoverlapping,crate::NBS_copy::KMX_copy_nonoverlapping)]\n#[kani::stub(<[u8]>::clone_from_slice,crate::NBS_copy::KMX_clone_from_slice)]\n#[kani::stub(alloc::vec::Vec::<u8>::extend_from_slice,crate::NBS_copy::KMX_extend_from_slice)]\n#[kani::stub(<[u8]>::to_vec,crate::NBS_copy::KMX_to_vec)]\n#[kani::stub(alloc::alloc::realloc,crate::NBS_copy::KMX_realloc)]\nfn NBS_recheck_31() {\n  let u:usize=kani::any();kani::assume(u<262144);\n  unsafe{EXPECT=u;CALLS=0;MCALLS=0;}\n  let result=line_node(FibreIndex::new(u).unwrap());\n  unsafe{\n   assert!(CALLS==1&&MCALLS==1);\n   assert!(u64::from(result.0)==(2*u64::from(SQUARE)+2147483647-1)%2147483647);\n  }\n }\n\n\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-native-tx2i-20261028/NBS_src/crates/aspis-r1-cost-probe/src/fast_dots.rs", "exists": true, "sha256": "bd115202fd182307ab381a3579f5bc5c88e3730974b7fcedabd9f6936f546b1b", "text": "//! Exact four-slot dot products with a partially reduced base-field prefix.\nuse aspis_core::field::{M31, QM31, WideExact};\nuse crate::fast_pairing::EbyKDot;\n\n/// Compute the verifier's four dot products while postponing canonical M31\n/// reductions across groups of at most four base-field products.\n///\n/// Each limb product is at most `(P - 1)^2`; four products therefore sum to\n/// less than `2^64`, since `4 * (P - 1)^2 < 2^64`. One Mersenne fold\n/// `(sum & P) + (sum >> 31)` preserves its residue and is below `2^34`.\n/// Seven folded batches sum to less than `2^37`; canonicalize each limb once\n/// after all 26 products. Every byte decoder and its order are unchanged.\n// Candidate entry delegates to the pinned fixed-call implementation.\n// Candidate-only extracted single-slot helper.\nfn four_dots_one(q: &[u8; 608], g: &[WideExact; 29], slot: usize) -> WideExact {\n        let mut limbs = [0u64; WideExact::LIMB_COUNT];\n        for start in (0..26).step_by(4) {\n            let mut sums = [0u64; WideExact::LIMB_COUNT];\n            for term in start..core::cmp::min(start + 4, 26) {\n                let scalar = M31::from_le_bytes(\n                    q[slot * 120 + term * 4..slot * 120 + term * 4 + 4]\n                        .try_into()\n                        .unwrap(),\n                )\n                .unwrap();\n                let coefficient = g[term].to_limbs();\n                sums[0] += u64::from(coefficient[0]) * u64::from(scalar.0);\n                sums[1] += u64::from(coefficient[1]) * u64::from(scalar.0);\n                sums[2] += u64::from(coefficient[2]) * u64::from(scalar.0);\n                sums[3] += u64::from(coefficient[3]) * u64::from(scalar.0);\n                sums[4] += u64::from(coefficient[4]) * u64::from(scalar.0);\n                sums[5] += u64::from(coefficient[5]) * u64::from(scalar.0);\n                sums[6] += u64::from(coefficient[6]) * u64::from(scalar.0);\n                sums[7] += u64::from(coefficient[7]) * u64::from(scalar.0);\n            }\n            limbs[0] += (sums[0] & 0x7fff_ffff) + (sums[0] >> 31);\n            limbs[1] += (sums[1] & 0x7fff_ffff) + (sums[1] >> 31);\n            limbs[2] += (sums[2] & 0x7fff_ffff) + (sums[2] >> 31);\n            limbs[3] += (sums[3] & 0x7fff_ffff) + (sums[3] >> 31);\n            limbs[4] += (sums[4] & 0x7fff_ffff) + (sums[4] >> 31);\n            limbs[5] += (sums[5] & 0x7fff_ffff) + (sums[5] >> 31);\n            limbs[6] += (sums[6] & 0x7fff_ffff) + (sums[6] >> 31);\n            limbs[7] += (sums[7] & 0x7fff_ffff) + (sums[7] >> 31);\n        }\n\n        let mut value = WideExact::from_limbs([\n            M31::reduce_u64(limbs[0]).0,\n            M31::reduce_u64(limbs[1]).0,\n            M31::reduce_u64(limbs[2]).0,\n            M31::reduce_u64(limbs[3]).0,\n            M31::reduce_u64(limbs[4]).0,\n            M31::reduce_u64(limbs[5]).0,\n            M31::reduce_u64(limbs[6]).0,\n            M31::reduce_u64(limbs[7]).0\n        ]).unwrap();\n        let mut tail=EbyKDot::new();\n        tail.push(g[28],QM31::from_le_bytes(&q[slot*120+104..slot*120+120]).unwrap()).unwrap();\n        let offset0 = 480 + slot * 32 + 0 * 16;\n                tail.push(g[0 + 26], QM31::from_le_bytes(&q[offset0..offset0 + 16]).unwrap()).unwrap();\n                let offset1 = 480 + slot * 32 + 1 * 16;\n                tail.push(g[1 + 26], QM31::from_le_bytes(&q[offset1..offset1 + 16]).unwrap()).unwrap();\n        value.add(tail.finish())\n    \n}\n\n// Candidate-only explicit four-call version, preserving the callback order.\npub fn four_dots(q: &[u8], g: &[WideExact; 29]) -> [WideExact; 4] {\n    let q: &[u8; 608] = q[..608].try_into().unwrap();\n    [\n        four_dots_one(q, g, 0),\n        four_dots_one(q, g, 1),\n        four_dots_one(q, g, 2),\n        four_dots_one(q, g, 3),\n    ]\n}\n\n#[cfg(kani)]\nmod NBQ_dots {\n use super::*;\n static mut CALLS:usize=0;static mut QPTR:*const u8=core::ptr::null();static mut GPTR:*const WideExact=core::ptr::null();\n fn child(q:&[u8;608],g:&[WideExact;29],slot:usize)->WideExact{unsafe{\n  assert!(core::ptr::eq(q.as_ptr(),QPTR));assert!(core::ptr::eq(g.as_ptr(),GPTR));assert!(slot==CALLS);CALLS+=1;\n }g[slot]}\n #[kani::proof] #[kani::unwind(928)]\n #[kani::stub(super::four_dots_one,child)]\n fn routing(){\n  let q:[u8;609]=kani::any();let g=[WideExact::ZERO;29];let len:usize=kani::any();kani::assume(len>=608&&len<=609);\n  unsafe{CALLS=0;QPTR=q.as_ptr();GPTR=g.as_ptr();}\n  let out=super::four_dots(&q[..len],&g);\n  unsafe{assert!(CALLS==4);}let j:usize=kani::any();kani::assume(j<4);assert!(out[j]==g[j]);\n }\n #[kani::proof] #[kani::unwind(8)]\n fn indices(){let slot:usize=kani::any();kani::assume(slot<4);let term:usize=kani::any();kani::assume(term<26);let at=slot*120+term*4;assert!(at+4<=608);assert!(slot*120+104+16<=608);assert!(480+slot*32+16<=608);assert!(480+slot*32+16+16<=608);}\n}\n\n#[cfg(kani)]\nmod NBQ_cells {\nuse super::*;\n// Exact after-product cut at source sums[0] += coefficient[0]*scalar.\n #[kani::proof] #[kani::unwind(64)]\n fn add0() {\n  let mut sums:[u64;8]=kani::any();let before=sums;\n  let k:u64=kani::any();kani::assume(k<4);\n  kani::assume(sums[0]<=k*4611686009837453316);\n  let product:u64=kani::any();kani::assume(product<=4611686009837453316);\n  sums[0]+=product;\n  let at:usize=kani::any();kani::assume(at<8);\n  assert!(sums[at]==if at==0{before[at]+product}else{before[at]});\n  assert!(sums[0]<18446744073709551615);\n }\n// Exact after-product cut at source sums[1] += coefficient[1]*scalar.\n #[kani::proof] #[kani::unwind(64)]\n fn add1() {\n  let mut sums:[u64;8]=kani::any();let before=sums;\n  let k:u64=kani::any();kani::assume(k<4);\n  kani::assume(sums[1]<=k*4611686009837453316);\n  let product:u64=kani::any();kani::assume(product<=4611686009837453316);\n  sums[1]+=product;\n  let at:usize=kani::any();kani::assume(at<8);\n  assert!(sums[at]==if at==1{before[at]+product}else{before[at]});\n  assert!(sums[1]<18446744073709551615);\n }\n// Exact after-product cut at source sums[2] += coefficient[2]*scalar.\n #[kani::proof] #[kani::unwind(64)]\n fn add2() {\n  let mut sums:[u64;8]=kani::any();let before=sums;\n  let k:u64=kani::any();kani::assume(k<4);\n  kani::assume(sums[2]<=k*4611686009837453316);\n  let product:u64=kani::any();kani::assume(product<=4611686009837453316);\n  sums[2]+=product;\n  let at:usize=kani::any();kani::assume(at<8);\n  assert!(sums[at]==if at==2{before[at]+product}else{before[at]});\n  assert!(sums[2]<18446744073709551615);\n }\n// Exact after-product cut at source sums[3] += coefficient[3]*scalar.\n #[kani::proof] #[kani::unwind(64)]\n fn add3() {\n  let mut sums:[u64;8]=kani::any();let before=sums;\n  let k:u64=kani::any();kani::assume(k<4);\n  kani::assume(sums[3]<=k*4611686009837453316);\n  let product:u64=kani::any();kani::assume(product<=4611686009837453316);\n  sums[3]+=product;\n  let at:usize=kani::any();kani::assume(at<8);\n  assert!(sums[at]==if at==3{before[at]+product}else{before[at]});\n  assert!(sums[3]<18446744073709551615);\n }\n// Exact after-product cut at source sums[4] += coefficient[4]*scalar.\n #[kani::proof] #[kani::unwind(64)]\n fn add4() {\n  let mut sums:[u64;8]=kani::any();let before=sums;\n  let k:u64=kani::any();kani::assume(k<4);\n  kani::assume(sums[4]<=k*4611686009837453316);\n  let product:u64=kani::any();kani::assume(product<=4611686009837453316);\n  sums[4]+=product;\n  let at:usize=kani::any();kani::assume(at<8);\n  assert!(sums[at]==if at==4{before[at]+product}else{before[at]});\n  assert!(sums[4]<18446744073709551615);\n }\n// Exact after-product cut at source sums[5] += coefficient[5]*scalar.\n #[kani::proof] #[kani::unwind(64)]\n fn add5() {\n  let mut sums:[u64;8]=kani::any();let before=su