gistryFormatError::InvalidAuthorityMode)} else if r.retirement_slot!=u64::MAX && r.retirement_slot<=r.activation_slot {Err(PoolV1VerifierRegistryFormatError::InvalidRetirementSlot)} else {Ok(())}}\n#[kani::proof]\nfn NBH_validate_verifier_registry_entry_v2_gate() {let r=VerifierRegistryEntryV2{status:match kani::any::<u8>() % 4 {0=>VerifierEntryStatusV1::Pending,1=>VerifierEntryStatusV1::Active,2=>VerifierEntryStatusV1::Paused,_=>VerifierEntryStatusV1::Retired},statement_version:kani::any(),bump:kani::any(),pool:kani::any(),verifier_program:kani::any(),profile_binding:kani::any(),release_binding:kani::any(),loader_program:kani::any(),programdata_address:kani::any(),programdata_bump:kani::any(),executable_hash:kani::any(),expected_upgrade_authority:kani::any(),activation_slot:kani::any(),retirement_slot:kani::any(),policy_binding:kani::any()}; assert_eq!(validate_verifier_registry_entry_v2(&r),NBH_validate_verifier_registry_entry_v2(&r));}\n#[kani::proof]\nfn NBH_zero_gate() { let b:[u8;32]=kani::any(); let z=required_binding_is_zero(&b); let j:usize=kani::any(); kani::assume(j<32); if z {assert_eq!(b[j],0);} if b==[0;32] {assert!(z);} }\nfn NBH_decode_verifier_registry_v1(b: &[u8])->Result<VerifierRegistryV1,PoolV1VerifierRegistryFormatError> {if b.len()!=128 {return Err(PoolV1VerifierRegistryFormatError::WrongLength);}\nif &b[..4]!=b\"ASRG\" {return Err(PoolV1VerifierRegistryFormatError::WrongMagic);}\nif b[4]!=2 {return Err(PoolV1VerifierRegistryFormatError::WrongVersion);}\nif b[7]!=0 || b[120..128]!=[0;8] {return Err(PoolV1VerifierRegistryFormatError::NonZeroReserved);}\nlet r=VerifierRegistryV1{flags:b[5],bump:b[6],pool:b[8..40].try_into().unwrap(),authority:b[40..72].try_into().unwrap(),policy_binding:b[72..104].try_into().unwrap(),generation:u64::from_le_bytes(b[104..112].try_into().unwrap()),minimum_activation_delay_slots:u64::from_le_bytes(b[112..120].try_into().unwrap())};\nNBH_validate_verifier_registry_v1(&r)?; Ok(r)}\n#[kani::proof]\nfn NBH_decode_verif