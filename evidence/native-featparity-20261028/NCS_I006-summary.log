:ptr::copy_nonoverlapping,crate::NBS_copy::KMX_copy_nonoverlapping)]\n#[kani::stub(<[u8]>::clone_from_slice,crate::NBS_copy::KMX_clone_from_slice)]\n#[kani::stub(alloc::vec::Vec::<u8>::extend_from_slice,crate::NBS_copy::KMX_extend_from_slice)]\n#[kani::stub(<[u8]>::to_vec,crate::NBS_copy::KMX_to_vec)]\n#[kani::stub(alloc::alloc::realloc,crate::NBS_copy::KMX_realloc)]\nfn fold_eight_bound(){\nlet sums:[u64;8]=kani::any();let mut limbs:[u64;8]=kani::any();let n:u64=kani::any();kani::assume(n<7);for i in 0..8{kani::assume(limbs[i]<=n*10737418238);}\n let j:usize=kani::any();kani::assume(j<8);let before=limbs[j];let sum=sums[j];let lp=limbs.as_ptr();let sp=sums.as_ptr();\nlimbs[0] += (sums[0] & 0x7fff_ffff) + (sums[0] >> 31);\nlimbs[1] += (sums[1] & 0x7fff_ffff) + (sums[1] >> 31);\nlimbs[2] += (sums[2] & 0x7fff_ffff) + (sums[2] >> 31);\nlimbs[3] += (sums[3] & 0x7fff_ffff) + (sums[3] >> 31);\nlimbs[4] += (sums[4] & 0x7fff_ffff) + (sums[4] >> 31);\nlimbs[5] += (sums[5] & 0x7fff_ffff) + (sums[5] >> 31);\nlimbs[6] += (sums[6] & 0x7fff_ffff) + (sums[6] >> 31);\nlimbs[7] += (sums[7] & 0x7fff_ffff) + (sums[7] >> 31);\nassert!(limbs[j]<=(n+1)*10737418238&&limbs[j]>=before);\n}\n#[kani::proof] #[kani::unwind(512)]\n#[kani::stub(<[u8]>::copy_from_slice,crate::NBS_copy::KMX_copy_from_slice)]\n#[kani::stub(core::ptr::copy_nonoverlapping,crate::NBS_copy::KMX_copy_nonoverlapping)]\n#[kani::stub(<[u8]>::clone_from_slice,crate::NBS_copy::KMX_clone_from_slice)]\n#[kani::stub(alloc::vec::Vec::<u8>::extend_from_slice,crate::NBS_copy::KMX_extend_from_slice)]\n#[kani::stub(<[u8]>::to_vec,crate::NBS_copy::KMX_to_vec)]\n#[kani::stub(alloc::alloc::realloc,crate::NBS_copy::KMX_realloc)]\nfn fold_sum_readonly(){\nlet sums:[u64;8]=kani::any();let mut limbs:[u64;8]=kani::any();let n:u64=kani::any();kani::assume(n<7);for i in 0..8{kani::assume(limbs[i]<=n*10737418238);}\n let j:usize=kani::any();kani::assume(j<8);let before=limbs[j];let sum=sums[j];let lp=limbs.as_ptr();let sp=sums.as_ptr();\nlimbs[0] += (sums[0] & 0x7fff_ffff) + (sums[0] >> 31);\nlimbs[1] += (sums[1] & 0x7fff_ffff) + (sums[1] >> 31);\nlimbs[2] += (sums[2] & 0x7fff_ffff) + (sums[2] >> 31);\nlimbs[3] += (sums[3] & 0x7fff_ffff) + (sums[3] >> 31);\nlimbs[4] += (sums[4] & 0x7fff_ffff) + (sums[4] >> 31);\nlimbs[5] += (sums[5] & 0x7fff_ffff) + (sums[5] >> 31);\nlimbs[6] += (sums[6] & 0x7fff_ffff) + (sums[6] >> 31);\nlimbs[7] += (sums[7] & 0x7fff_ffff) + (sums[7] >> 31);\nassert!(sums[j]==sum&&sums.as_ptr()==sp);\n}\n#[kani::proof] #[kani::unwind(512)]\n#[kani::stub(<[u8]>::copy_from_slice,crate::NBS_copy::KMX_copy_from_slice)]\n#[kani::stub(core::ptr::copy_nonoverlapping,crate::NBS_copy::KMX_copy_nonoverlapping)]\n#[kani::stub(<[u8]>::clone_from_slice,crate::NBS_copy::KMX_clone_from_slice)]\n#[kani::stub(alloc::vec::Vec::<u8>::extend_from_slice,crate::NBS_copy::KMX_extend_from_slice)]\n#[kani::stub(<[u8]>::to_vec,crate::NBS_copy::KMX_to_vec)]\n#[kani::stub(alloc::alloc::realloc,crate::NBS_copy::KMX_realloc)]\nfn fold_metadata(){\nlet sums:[u64;8]=kani::any();let mut limbs:[u64;8]=kani::any();let n:u64=kani::any();kani::assume(n<7);for i in 0..8{kani::assume(limbs[i]<=n*10737418238);}\n let j:usize=kani::any();kani::assume(j<8);let before=limbs[j];let sum=sums[j];let lp=limbs.as_ptr();let sp=sums.as_ptr();\nlimbs[0] += (sums[0] & 0x7fff_ffff) + (sums[0] >> 31);\nlimbs[1] += (sums[1] & 0x7fff_ffff) + (sums[1] >> 31);\nlimbs[2] += (sums[2] & 0x7fff_ffff) + (sums[2] >> 31);\nlimbs[3] += (sums[3] & 0x7fff_ffff) + (sums[3] >> 31);\nlimbs[4] += (sums[4] & 0x7fff_ffff) + (sums[4] >> 31);\nlimbs[5] += (sums[5] & 0x7fff_ffff) + (sums[5] >> 31);\nlimbs[6] += (sums[6] & 0x7fff_ffff) + (sums[6] >> 31);\nlimbs[7] += (sums[7] & 0x7fff_ffff) + (sums[7] >> 31);\nassert!(limbs.len()==8&&sums.len()==8&&limbs.as_ptr()==lp&&sums.as_ptr()==sp);\n}\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-native-tx2i-20261028/NBS_src/crates/aspis-r1-cost-probe/src/fast_pairing.rs", "exists": true, "sha256": "02f7548093aafecd9961ab724419624bb70370131cc24be131ad45f0644f68b7", "text": "//! Exact-field dot accumulator candidates; arithmetic-only equivalence code.\nmod canonical {\n    //! Private canonical representation: validate at the boundary, preserve internally.\n    //! No public unchecked constructor. This does NOT change aspis_core::M31.\n    pub const P:u32=0x7fff_ffff;\n    const MASK:u64=0x7fff_ffff_7fff_ffff;\n    const ONES:u64=0x0000_0001_0000_0001;\n    #[derive(Clone,Copy,Debug,PartialEq,Eq,Default)]\n    pub struct Q([u32;4]);\n    #[inline(always)] pub(crate) fn reduce(mut x:u64)->u32 {\n        x=(x & u64::from(P))+(x>>31u32);\n        x=(x & u64::from(P))+(x>>31u32);\n        if x>=u64::from(P) {(x-u64::from(P)) as u32}else{x as u32}\n    }\n    #[inline(always)] pub(crate) fn add(a:u32,b:u32)->u32 {\n        let s=a.wrapping_add(b);if s>=P{s-P}else{s}\n    }\n    #[inline(always)] fn pair(a:u32,b:u32)->u64 {u64::from(a)|(u64::from(b)<<32)}\n    #[inline(always)] fn reduce_pair(s:u64)->u64 {\n        (s.wrapping_add(((s.wrapping_add(ONES))>>31u32)&ONES))&MASK\n    }\n    impl Q {\n        pub const ZERO:Self=Self([0;4]);pub const ONE:Self=Self([1,0,0,0]);\n        pub fn from_limbs(x:[u32;4])->Option<Self>{\n            let [a,b,c,d]=x;\n            if a<P && b<P && c<P && d<P {Some(Self([a,b,c,d]))}else{None}\n        }\n        pub fn from_m31(x:u32)->Option<Self>{if x<P{Some(Self([x,0,0,0]))}else{None}}\n        pub const fn limbs(self)->[u32;4]{self.0}\n        /// WideExact owns private, canonical coordinates; this constructor\n        /// accepts only that validated type, never raw QM31 limbs or bytes.\n        #[inline(always)]\n        pub(super) fn from_wide(value:super::E)->[Self;2] {\n            let [a,b,c,d,e,f,g,h]=value.to_limbs();\n            [Self([a,b,c,d]),Self([e,f,g,h])]\n        }\n        #[inline(always)] pub fn add(self,rhs:Self)->Self {\n            let a=reduce_pair(pair(self.0[0],self.0[1]).wrapping_add(pair(rhs.0[0],rhs.0[1])));\n            let b=reduce_pair(pair(self.0[2],self.0[3]).wrapping_add(pair(rhs.0[2],rhs.0[3])));\n            Self([a as u32,(a>>32) as u32,b as u32,(b>>32) as u32])\n        }\n        #[inline(always)] pub fn sub(self,rhs:Self)->Self {\n            let a=reduce_pair(pair(self.0[0],self.0[1]).wrapping_add(MASK).wrapping_sub(pair(rhs.0[0],rhs.0[1])));\n            let b=reduce_pair(pair(self.0[2],self.0[3]).wrapping_add(MASK).wrapping_sub(pair(rhs.0[2],rhs.0[3])));\n            Self([a as u32,(a>>32) as u32,b as u32,(b>>32) as u32])\n        }\n        #[inline(always)] pub fn half(self)->Self {\n            let h=|x:u32|(x>>1)|((x&1)<<30);\n            let mut out=[0u32;4]; for i in 0..4 {out[i]=h(self.0[i]);} Self(out)\n        }\n        pub fn half_pow(self,n:u8)->Option<Self>{\n            if n>30{return None}if n==0{return Some(self)}\n            let mut out=[0u32;4];\n            for i in 0..4 {let x=self.0[i];out[i]=(x>>n)|((x&((1u32<<n)-1))<<(31-n));}\n            Some(Self(out))\n        }\n        #[inline(always)] pub fn mul_m31(self,rhs:u32)->Option<Self>{\n            if rhs>=P{return None}\n            let mut out=[0u32;4]; for i in 0..4 {out[i]=reduce(u64::from(self.0[i])*u64::from(rhs));}\n            Some(Self(out))\n        }\n        /// Benchmark candidate, not an assertion of superiority over staged R19.\n        /// All intermediates are nonnegative and strictly below 2^64.\n        #[inline(always)] pub fn mul(self,rhs:Self)->Self {\n            let [a,b,c,d]=[u64::from(self.0[0]),u64::from(self.0[1]),u64::from(self.0[2]),u64::from(self.0[3])];\n            let [e,f,g,h]=[u64::from(rhs.0[0]),u64::from(rhs.0[1]),u64::from(rhs.0[2]),u64::from(rhs.0[3])];\n            const PP:u64=(P as u64)*(P as u64);\n            let partial=|x:u64|(x&u64::from(P)).wrapping_add(x>>31u32);\n            let u=partial((c*g).wrapping_add(PP).wrapping_sub(d*h));\n            let v=partial((c*h).wrapping_add(d*g));\n            Self([reduce((a*e).wrapping_add(PP).wrapping_sub(b*f).wrapping_add(2*u).wrapping_add(3*u64::from(P)).wrapping_sub(v)),\n                reduce((a*f).wrapping_add(b*e).wrapping_add(u).wrapping_add(2*v)),\n                reduce((a*g).wrapping_add(c*e).wrapping_add(2*PP).wrapping_sub(b*h).wrapping_sub(d*f)),\n                reduce((a*h).wrapping_add(b*g).wrapping_add(c*f).wrapping_add(d*e))])\n        }\n    }\n\n    // Appended to the retained private Q module. Only Q can reach the raw path:\n    // its limbs are private, constructors validate, and operations preserve <P.\n    impl Q {\n        #[inline(always)]\n        fn raw(self,rhs:Self)->[u64;4] {\n            let [a,b,c,d]=[u64::from(self.0[0]),u64::from(self.0[1]),u64::from(self.0[2]),u64::from(self.0[3])];\n            let [e,f,g,h]=[u64::from(rhs.0[0]),u64::from(rhs.0[1]),u64::from(rhs.0[2]),u64::from(rhs.0[3])];\n            const PP:u64=(P as u64)*(P as u64);\n            let partial=|x:u64|(x&u64::from(P)).wrapping_add(x>>31u32);\n            let u=partial((c*g).wrapping_add(PP).wrapping_sub(d*h));\n            let v=partial((c*h).wrapping_add(d*g));\n            [(a*e).wrapping_add(PP).wrapping_sub(b*f).wrapping_add(2*u).wrapping_add(3*u64::from(P)).wrapping_sub(v),\n             (a*f).wrapping_add(b*e).wrapping_add(u).wrapping_add(2*v),\n             (a*g).wrapping_add(c*e).wrapping_add(2*PP).wrapping_sub(b*h).wrapping_sub(d*f),\n             (a*h).wrapping_add(b*g).wrapping_add(c*f).wrapping_add(d*e)]\n        }\n        #[inline(always)]\n        pub fn dot<const N:usize>(left:[Self;N],right:[Self;N])->Self {\n            assert!(N<=4);let mut sums=[0u64;4];\n            for i in 0..N {\n                let raw=left[i].raw(right[i]);\n                for j in 0..4 {sums[j]=sums[j].wrapping_add((raw[j]&u64::from(P)).wrapping_add(raw[j]>>31u32));}\n            }\n            // Retained R59 bounds: each folded raw value <2^34, N<=4.\n            Self([reduce(sums[0]),reduce(sums[1]),reduce(sums[2]),reduce(sums[3])])\n        }\n        #[inline(always)] pub fn neg(self)->Self {Self::ZERO.sub(self)}\n        #[inline(always)] pub fn square(self)->Self {self.mul(self)}\n    }\n\n    // Private canonical operands; bounded raw representatives, canonical result.\n    // At most 4096 partial folds, each <2^34, sum <2^46. No u64 wrap.\n    pub struct Dot { sums:[u64;4] }\n    impl Dot {\n        pub fn new()->Self {Self{sums:[0;4]}}\n        #[inline(always)]\n        pub fn push(&mut self,a:Q,b:Q) {\n            // Both enclosing public accumulators check the 4096-term bound.\n            // This private accumulator cannot be reached by raw callers.\n            let raw=a.raw(b);\n            for j in 0..4 {\n                self.sums[j]=self.sums[j].wrapping_add(\n                    (raw[j]&u64::from(P)).wrapping_add(raw[j]>>31u32));\n            }\n        }\n        pub fn finish(self)->Q {Q([reduce(self.sums[0]),reduce(self.sums[1]),reduce(self.sums[2]),reduce(self.sums[3])])}\n    }\n    #[cfg(kani)] pub(super) fn NBQ_sums(d:&Dot)->[u64;4]{d.sums}\n    #[cfg(kani)] pub(super) fn NBQ_any_dot()->Dot {Dot{sums:kani::any()}}\n    #[cfg(kani)]\n    mod NBQ_private {\n        use super::*;\n fn same4<T:PartialEq>(a:[T;4],b:[T;4])->bool {a[0]==b[0]&&a[1]==b[1]&&a[2]==b[2]&&a[3]==b[3]}\n        #[kani::proof] #[kani::unwind(8)]\n        fn reduce_all() {\n            let x:u64=kani::any();\n            let r=reduce(x);\n            assert!(u64::from(r)==x%u64::from(P));\n            assert!(r<P);\n        }\n        #[kani::proof] #[kani::unwind(8)]\n        fn new() {let d=Dot::new();assert!(same4(d.sums,[0;4]));}\n        #[kani::proof] #[kani::unwind(8)]\n        fn finish() {\n            let s:[u64;4]=kani::any();let q=Dot{sums:s}.finish().limbs();\n            assert!(u64::from(q[0])==s[0]%u64::from(P));\n            assert!(u64::from(q[1])==s[1]%u64::from(P));\n            assert!(u64::from(q[2])==s[2]%u64::from(P));\n            assert!(u64::from(q[3])==s[3]%u64::from(P));\n        }\n        #[kani::proof] #[kani::unwind(8)]\n        fn from_limbs() {\n            let w:[u32;4]=kani::any();let q=Q::from_limbs(w);\n            let c=w[0]<P&&w[1]<P&&w[2]<P&&w[3]<P;\n            assert!(q.is_some()==c);\n            if let Some(q)=q {assert!(same4(q.limbs(),w));}\n        }\n        #[kani::proof] #[kani::unwind(8)]\n        fn limbs() {let w:[u32;4]=kani::any();assert!(same4(Q(w).limbs(),w));}\n    }\n\n}\n\n\nuse aspis_core::field::{CM31, QM31, WideExact as E};\n\nconst MAX_TERMS: usize = 4096;\n\n#[inline(always)]\nfn limbs_of(k: QM31) -> [u32; 4] {\n    [k.c0.a.0, k.c0.b.0, k.c1.a.0, k.c1.b.0]\n}\n\n#[inline(always)]\nfn checked_q(k: QM31) -> Result<canonical::Q, ()> {\n    match canonical::Q::from_limbs(limbs_of(k)) { Some(q) => Ok(q), None => Err(()) }\n}\n\n#[inline(always)]\nfn qm31_of(q: canonical::Q) -> QM31 {\n    let [a, b, c, d] = q.limbs();\n    QM31 {\n        c0: CM31 { a: aspis_core::field::M31(a), b: aspis_core::field::M31(b) },\n        c1: CM31 { a: aspis_core::field::M31(c), b: aspis_core::field::M31(d) },\n    }\n}\n\n/// Candidate exact accumulator for sums of `WideExact * QM31`.\n/// Canonical QM31 coordinates and the 4096-term limit are checked at push.\npub struct EbyKDot {\n    c0: canonical::Dot,\n    c1: canonical::Dot,\n    count: usize,\n}\n\nimpl EbyKDot {\n    pub fn new() -> Self {\n        Self { c0: canonical::Dot::new(), c1: canonical::Dot::new(), count: 0 }\n    }\n\n    #[inline(always)]\n    pub fn push(&mut self, value: E, scalar: QM31) -> Result<(), ()> {\n        if self.count >= MAX_TERMS { return Err(()); }\n        let [value_c0,value_c1] = canonical::Q::from_wide(value);\n        let scalar = checked_q(scalar)?;\n        self.c0.push(value_c0, scalar);\n        self.c1.push(value_c1, scalar);\n        self.count += 1;\n        Ok(())\n    }\n\n    #[inline(always)]\n    pub fn finish(self) -> E {\n        let [a,b,c,d]=self.c0.finish().limbs();\n        let [e,f,g,h]=self.c1.finish().limbs();\n        // The private accumulator produces canonical coordinates already.\n        E::from_limbs([a,b,c,d,e,f,g,h]).unwrap()\n    }\n}\n\n/// Candidate exact accumulator for sums of `WideExact * WideExact`.\n/// Four canonical QM31 dot accumulators implement the outer quadratic tower.\npub struct EbyEDot {\n    ac: canonical::Dot,\n    bd: canonical::Dot,\n    ad: canonical::Dot,\n    bc: canonical::Dot,\n    count: usize,\n}\n\nimpl EbyEDot {\n    pub fn new() -> Self {\n        Self {\n            ac: canonical::Dot::new(), bd: canonical::Dot::new(),\n            ad: canonical::Dot::new(), bc: canonical::Dot::new(), count: 0,\n        }\n    }\n\n    #[inline(always)]\n    pub fn push(&mut self, left: E, right: E) -> Result<(), ()> {\n        if self.count >= MAX_TERMS { return Err(()); }\n        let [a,b] = canonical::Q::from_wide(left);\n        let [c,d] = canonical::Q::from_wide(right);\n        self.ac.push(a, c);\n        self.bd.push(b, d);\n        self.ad.push(a, d);\n        self.bc.push(b, c);\n        self.count += 1;\n        Ok(())\n    }\n\n    #[inline(always)]\n    pub fn finish(self) -> E {\n        let ac = qm31_of(self.ac.finish());\n        let bd = qm31_of(self.bd.finish());\n        let ad = qm31_of(self.ad.finish());\n        let bc = qm31_of(self.bc.finish());\n        // v^2 = u, where WideExact::U embeds the QM31 generator in the base.\n        E::new(ac.add(bd.mul(E::U)), ad.add(bc))\n    }\n}\n\n#[cfg(kani)]\nmod NBQ_public {\n use super::*;\n fn same4<T:PartialEq>(a:[T;4],b:[T;4])->bool {a[0]==b[0]&&a[1]==b[1]&&a[2]==b[2]&&a[3]==b[3]}\n fn k(w:[u32;4])->QM31 {QM31{c0:CM31{a:aspis_core::field::M31(w[0]),b:aspis_core::field::M31(w[1])},c1:CM31{a:aspis_core::field::M31(w[2]),b:aspis_core::field::M31(w[3])}}}\n fn any_e()->E {let w:[u32;8]=kani::any();kani::assume(w[0]<canonical::P&&w[1]<canonical::P&&w[2]<canonical::P&&w[3]<canonical::P&&w[4]<canonical::P&&w[5]<canonical::P&&w[6]<canonical::P&&w[7]<canonical::P);E::from_limbs(w).unwrap()}\n #[kani::proof] #[kani::unwind(12)]\n fn from_wide(){let e=any_e();let w=e.to_limbs();let [a,b]=canonical::Q::from_wide(e);assert!(same4(a.limbs(),[w[0],w[1],w[2],w[3]]));assert!(same4(b.limbs(),[w[4],w[5],w[6],w[7]]));}\n #[kani::proof] #[kani::unwind(12)]\n fn checked(){let w:[u32;4]=kani::any();let scalar=k(w);assert!(same4(limbs_of(scalar),w));let c=w[0]<canonical::P&&w[1]<canonical::P&&w[2]<canonical::P&&w[3]<canonical::P;let r=checked_q(scalar);assert!(r.is_ok()==c);if let Ok(q)=r{assert!(same4(q.limbs(),w));}}\n #[kani::proof] #[kani::unwind(12)]\n fn new(){let d=EbyKDot::new();assert!(d.count==0);assert!(same4(d.c0.finish().limbs(),[0;4]));assert!(same4(d.c1.finish().limbs(),[0;4]));}\n static mut CALLS:usize=0;\n static mut PTR0:*mut canonical::Dot=core::ptr::null_mut(); static mut PTR1:*mut canonical::Dot=core::ptr::null_mut();\n static mut WANT0:[u32;4]=[0;4]; static mut WANT1:[u32;4]=[0;4]; static mut WANTK:[u32;4]=[0;4];\n fn push_route(d:&mut canonical::Dot,a:canonical::Q,b:canonical::Q){unsafe{\n   assert!(CALLS<2);assert!(core::ptr::eq(d,if CALLS==0{PTR0}else{PTR1}));assert!(same4(a.limbs(),if CALLS==0{WANT0}else{WANT1}));assert!(same4(b.limbs(),WANTK));\n   *d=canonical::NBQ_any_dot(); CALLS+=1;\n }}\n #[kani::proof] #[kani::unwind(12)]\n #[kani::stub(canonical::Dot::push,push_route)]\n fn push_success(){\n  let v=any_e();let w=v.to_limbs();let kw:[u32;4]=kani::any();kani::assume(kw[0]<canonical::P&&kw[1]<canonical::P&&kw[2]<canonical::P&&kw[3]<canonical::P);\n  let n:usize=kani::any();kani::assume(n<4096);\n  let mut d=EbyKDot{c0:canonical::NBQ_any_dot(),c1:canonical::NBQ_any_dot(),count:n};\n  unsafe{PTR0=&mut d.c0;PTR1=&mut d.c1;CALLS=0;WANT0=[w[0],w[1],w[2],w[3]];WANT1=[w[4],w[5],w[6],w[7]];WANTK=kw;}\n  assert!(d.push(v,k(kw)).is_ok());assert!(d.count==n+1);unsafe{assert!(CALLS==2);}\n }\n fn no_push(_d:&mut canonical::Dot,_a:canonical::Q,_b:canonical::Q){assert!(false,\"rejection calls no private push\");}\n #[kani::proof] #[kani::unwind(12)]\n #[kani::stub(canonical::Dot::push,no_push)]\n fn push_limit(){let n:usize=kani::any();kani::assume(n>=4096);let mut d=EbyKDot{c0:canonical::NBQ_any_dot(),c1:canonical::NBQ_any_dot(),count:n};assert!(d.push(any_e(),k(kani::any())).is_err());assert!(d.count==n);}\n #[kani::proof] #[kani::unwind(12)]\n #[kani::stub(canonical::Dot::push,no_push)]\n fn push_bad_scalar(){let w:[u32;4]=kani::any();kani::assume(w[0]>=canonical::P||w[1]>=canonical::P||w[2]>=canonical::P||w[3]>=canonical::P);let n:usize=kani::any();kani::assume(n<4096);let mut d=EbyKDot{c0:canonical::NBQ_any_dot(),c1:canonical::NBQ_any_dot(),count:n};assert!(d.push(any_e(),k(w)).is_err());assert!(d.count==n);}\n #[kani::proof] #[kani::unwind(12)]\n fn finish(){let mut d=EbyKDot::new();let n:usize=kani::any();d.count=n;assert!(d.finish()==E::ZERO);}\n}\n\n#[cfg(kani)]\nmod NBQ_more {\n use super::*;\n #[kani::proof] #[kani::unwind(12)]\n fn finish_all(){\n  let a=canonical::NBQ_any_dot();let b=canonical::NBQ_any_dot();\n  let av=canonical::NBQ_sums(&a);let bv=canonical::NBQ_sums(&b);\n  let count:usize=kani::any();let out=EbyKDot{c0:a,c1:b,count}.finish().to_limbs();\n  let j:usize=kani::any();kani::assume(j<8);\n  assert!(u64::from(out[j])==(if j<4{av[j]}else{bv[j-4]})%u64::from(canonical::P));\n }\n}\n\n#[cfg(kani)] pub(crate) fn NBQ_state(count:usize)->EbyKDot{EbyKDot{c0:canonical::NBQ_any_dot(),c1:canonical::NBQ_any_dot(),count}}\n#[cfg(kani)] pub(crate) fn NBQ_count(s:&EbyKDot)->usize{s.count}\n#[cfg(kani)] pub(crate) fn NBQ_advance(s:&mut EbyKDot){*s=NBQ_state(s.count+1);}\n#[cfg(kani)] mod NBQ_reject_frame{\n use super::*;\n #[kani::proof] #[kani::unwind(64)]\n fn source(){let n:usize=kani::any();kani::assume(n>=4096);let mut s=NBQ_state(n);let a=canonical::NBQ_sums(&s.c0);let b=canonical::NBQ_sums(&s.c1);\n assert!(s.push(E::ZERO,QM31::ZERO).is_err());let j:usize=kani::any();kani::assume(j<4);assert!(canonical::NBQ_sums(&s.c0)[j]==a[j]);assert!(canonical::NBQ_sums(&s.c1)[j]==b[j]);assert!(s.count==n);}\n}\n\n#[cfg(kani)] pub(crate) fn NCB_invariant(s:&EbyKDot)->bool {\n let a=canonical::NBQ_sums(&s.c0);let b=canonical::NBQ_sums(&s.c1);\n let limit=(s.count as u64)*10737418238;\n s.count<=4096&&a[0]<=limit&&a[1]<=limit&&a[2]<=limit&&a[3]<=limit&&b[0]<=limit&&b[1]<=limit&&b[2]<=limit&&b[3]<=limit\n}\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-native-tx2i-20261028/NBS_src/crates/aspis-r1-cost-probe/src/lib.rs", "exists": true, "sha256": "21fd5c9e9dceefbdc6b9c552175ebe96a8a00d10a418e2a7b18685bb8b714122", "text": "//! UNPROVED R1 COST PROBE. P2 only; no production entrypoint.\n#![no_std]\n#![cfg_attr(kani, feature(allocator_api))]\nextern crate alloc;\n#[cfg(kani)] mod NBS_copy;\npub mod sampler;\npub mod semantic_wire;\npub mod semantic;\npub mod fast_domain;\npub mod fast_dots;\npub mod fast_pairing;\n\n#[cfg(feature = \"prover\")]\nextern crate std;\npub mod r1_wire;\npub mod r1_semantic;\npub mod trace;\npub mod transport;\npub mod weights;\npub mod transcript;\npub mod verifier;\n#[cfg(feature = \"prover\")]\npub mod prover;\n/// Host client for the selected public proof-account nonce route (D162).\n#[cfg(feature = \"r1p-check\")]\n#[allow(non_snake_case)]\npub mod RealR1_client;\n#[cfg(feature = \"prover\")]\npub mod dense;\n/// G-sim (LOG D44.3): the explicit R1 simulator simE in the ideal game.\n#[cfg(feature = \"r1p-check\")]\npub mod sim;\n\n#[cfg(feature=\"prover\")] mod host_sumcheck;\n#[cfg(feature=\"prover\")] mod host_semantic;\n#[cfg(feature=\"prover\")] mod host_commitment;\n\n// Adopted R1 proof format (PREREG-PROOF-SIZE-2, 2026-10-19): compact QM31\n// storage and binary multiproofs. UNPROVED: see PROOF-SIZE-OBLIGATIONS.\npub mod multiproof;\npub mod compact;\n\n#[cfg(not(feature=\"private-leaf-salts\"))]\ncompile_error!(\"the adopted R1 proof format is defined over private leaf salts; enable `private-leaf-salts` (a default feature)\");\n#[cfg(all(feature=\"audit-eight-way\",feature=\"prover\"))]\ncompile_error!(\"`audit-eight-way` is audit-only: it is never combined with the prover (PREREG-PROOF-SIZE-2 item 4)\");\n#[cfg(all(feature=\"audit-eight-way\",any(target_os=\"solana\",feature=\"program-build\")))]\ncompile_error!(\"`audit-eight-way` is audit-only: it is never built for a program (PREREG-PROOF-SIZE-2 item 4)\");\n"}
{"path": "/home/dombarker/project-offloads/codex-cx-native-tx2i-20261028/NBS_src/crates/aspis-r1-cost-probe/src/verifier.rs", "exists": true, "sha256": "c521668de2417b9ad7473018442f8f0a7abaee0f05b6c986e5f149f44f58a8eb", "text": "//! UNPROVED R1 COST PROBE. Two-transaction verifier shape; no production use.\nuse aspis_core::r0::CodeField;\nuse alloc::{boxed::Box,vec::Vec};\nuse aspis_core::{Digest32,field::{WideExact as E,QM31 as K,M31},circle::SecureCirclePoint,r0::{domain,merkle}};\nuse aspis_statement::pool_v1::pair_forest_semantic_terminal::r0::Public;\nuse crate::{transport::Variant,weights::{Weights,field,powers,QUARTER},transcript::Transcript};\n\npub const SEMANTIC_BYTES:usize=12903+29*32;\npub const HEADER:usize=16;\n#[cfg(not(feature = \"private-leaf-salts\"))]\npub const INITIAL_QUERY_BYTES:usize=480+128+2*6*7*32;\n#[cfg(feature = \"private-leaf-salts\")]\npub const INITIAL_QUERY_BYTES:usize=480+128+64+2*6*7*32;\n#[cfg(not(feature = \"private-leaf-salts\"))]\npub const SECOND_QUERY_BYTES:usize=4*32+6*7*32;\n#[cfg(feature = \"private-leaf-salts\")]\npub const SECOND_QUERY_BYTES:usize=4*32+32+6*7*32;\npub const CHECKPOINT_FIXED:usize=16+32*3+64+32*4+16+88+160+64+32*2+16+32;\n#[derive(Debug,Clone,Copy,PartialEq,Eq)]\npub enum Error { Parse,Semantic,Transcript,Relation,Merkle,Query,Checkpoint,Allocation,\n    /// Host prover only (LOG D38.3): this attempt's challenges fail the public\n    /// P_R1 check. Carries no challenge and no conjunct.\n    #[cfg(feature=\"prover\")] Rejected,\n    /// Host prover only (D38.3): all N = 8 attempts were rejected; nothing is published.\n    #[cfg(feature=\"prover\")] AttemptsExhausted,\n    /// Host prover only: the operating-system entropy source failed.\n    #[cfg(feature=\"prover\")] Entropy }\n#[derive(Debug,Clone,Copy,PartialEq,Eq)]\npub enum Phase { Parsed,Semantic,SemanticPart(u8),Prepare,CheckpointRead,Merkle(usize),Query(usize),QueryPart(usize,u8),CheckpointWrite,Relation,Final }\npub type Observer=Option<fn(Phase)>;\nfn mark(obs:Observer,p:Phase) { if let Some(f)=obs {f(p);} }\npub fn checkpoint_size(v:Variant)->usize {CHECKPOINT_FIXED+16*v.final_len()}\n\npub struct View<'a> {\n    pub variant:Variant,pub semantic:&'a[u8],pub y1:&'a[u8],pub inactive:E,\n    pub round0:&'a[u8],pub folded_root:Option<&'a[u8;32]>,pub round1:&'a[u8],\n    pub final_message:&'a[u8],pub query_bytes:&'a[u8],\n}\nfn echeck(b:&[u8],k:bool)->Result<(),Error> {\n    for c in b.chunks_exact(32) {let x=E::from_le_bytes(c).ok_or(Error::Parse)?;if k&&x.c1()!=K::ZERO {return Err(Error::Parse);}}\n    Ok(())\n}\nimpl<'a> View<'a> {\n    /// Length of the retired eight-way stored proof for `v` (124,343 bytes for\n    /// S2). A layout figure only: the adopted stored length is `PROOF_BYTES`.\n    pub fn eight_way_proof_bytes(v:Variant)->usize {HEADER+SEMANTIC_BYTES+29*32+32+7*32+if v.folds()==2 {32+7*32}else{0}+v.final_len()*32+22*(INITIAL_QUERY_BYTES+if v.folds()==2 {SECOND_QUERY_BYTES}else{0})}\n}\n\npub struct Prepared {\n    pub variant:Variant,pub roots:[[u8;32];2],pub gamma:E,pub kappa:E,pub alpha:[E;2],pub rho:K,\n    pub queries:[u32;22],pub semantic_alpha:[K;10],pub z:[SecureCirclePoint;2],pub claim:E,pub state:[u8;32],\n}\nfn prepared_claim<H:Digest32>(sem:&crate::r1_semantic::Verified<H>,y1:&[u8],inactive:E,g:&[E;29],kappa:E)->Result<E,Error> {\n        let k=powers::<7>(kappa);\n        let mut parts=[E::ZERO;7];parts[0]=inactive;\n        for point in 0..6 {\n            let mut dot=crate::fast_pairing::EbyKDot::new();\n            for l in 0..29 {\n                let scalar=match point {0..=2=>sem.claims[point][l],3=>sem.extra[l],4=>sem.before_z1[l],_=>field(y1,l).c0()};\n                dot.push(g[l],scalar).map_err(|_|Error::Parse)?;\n            }\n            parts[point+1]=dot.finish();\n        }\n        let mut claim=E::ZERO;\n        for i in 0..7 {crate::trace::value(14,i,parts[i]);claim=claim.add(k[i].mul(parts[i]));}\n        crate::trace::value(14,7,claim);\n        Ok(claim)\n}\n\nimpl Prepared {\n    #[inline(never)]\n    pub fn new<H:Digest32>(sem:&crate::r1_semantic::Verified<H>,v:&View<'_>,hash:H,g:&mut [E;29])->Result<Box<Self>,Error> {\n        let mut t=Transcript::new(hash,sem.transcript.state(),v.variant);\n        let gamma=t.scalar(27,v.y1,true);\n        let kappa=t.scalar(28,&v.inactive.to_le_bytes(),false);\n        let alpha0=t.scalar(29,v.round0,false);\n        let (alpha,row)=if v.variant.folds()==2 {\n            let mut bytes=Vec::with_capacity(32+224);bytes.extend_from_slice(v.folded_root.unwrap());bytes.extend_from_slice(v.round1);\n            ([alpha0,t.scalar(30,&bytes,false)],31)\n        } else {\n            ([alpha0,E::ZERO],30)\n        };\n        let queries=t.queries(row,v.final_message)?;\n        let rho=t.scalar_k(row+1,&[]);\n        // Reuse this caller-owned scratch array in tx1; it is never serialized.\n        *g=powers::<29>(gamma);\n        let claim=prepared_claim(sem,v.y1,v.inactive,g,kappa)?;\n        Ok(Box::new(Self{variant:v.variant,roots:sem.roots,gamma,kappa,alpha,rho,queries,semantic_alpha:sem.alpha,z:sem.z,claim,state:t.state}))\n    }\n}\npub struct Accumulator { pub weights:Vec<K>,pub rhs:E,pub power:K,pub next:usize }\nimpl Accumulator {\n    pub fn new(v:Variant)->Result<Self,Error> {Ok(Self{weights:aspis_core::r0::heap::filled(v.final_len(),K::ZERO).map_err(|_|Error::Allocation)?,rhs:E::ZERO,power:K::ONE,next:0})}\n}\n\npub fn four_dots(q:&[u8],g:&[E;29])->[E;4] {\n    core::array::from_fn(|s| {\n        let mut a=E::ZERO;\n        for l in 0..26 {a=a.add(g[l].mul_m31(M31::from_le_bytes(q[s*120+l*4..s*120+l*4+4].try_into().unwrap()).unwrap()));}\n        a=a.add(g[28].mul_qm31(K::from_le_bytes(&q[s*120+104..s*120+120]).unwrap()));\n        for l in 0..2 {a=a.add(g[l+26].mul_qm31(K::from_le_bytes(&q[480+s*32+l*16..480+s*32+l*16+16]).unwrap()));}\n        a\n    })\n}\npub fn circle_fold(alpha:E,u:usize,a:[E;4])->E {\n    let p=crate::fast_domain::fibre_point(domain::FibreIndex::new(u).unwrap());\n    let ix=p.x.inv();let iy=p.y.inv();let [a,b,c,d]=a;\n    let h0=a.add(b).add(c).add(d).mul_m31(QUARTER);\n    let h1=a.sub(b).sub(c).add(d).mul_m31(QUARTER.mul(iy));\n    let h2=a.add(b).sub(c).sub(d).mul_m31(QUARTER.mul(ix));\n    let h3=a.sub(b).add(c).sub(d).mul_m31(QUARTER.mul(ix).mul(iy));\n    h0.add(alpha.mul(h1.add(alpha.mul(h2.add(alpha.mul(h3))))))\n}\npub fn line_fold(alpha:E,v:usize,a:[E;4])->E {\n    let x=crate::fast_domain::line_node(domain::FibreIndex::new(4*v).unwrap());\n    let y=crate::fast_domain::line_node(domain::FibreIndex::new(4*v+3).unwrap());\n    let z=x.mul(x).double().sub(M31::ONE);\n    let half=M31(1073741824);\n    let [a,b,c,d]=a;\n    let h0=a.add(b).add(c).add(d).mul_m31(QUARTER);\n    let h2=a.add(b).sub(c).sub(d).mul_m31(QUARTER.mul(z.inv()));\n    let c0=a.sub(b).mul_m31(half.mul(x.inv()));\n    let c1=d.sub(c).mul_m31(half.mul(y.inv()));\n    let h1=c0.add(c1).mul_m31(half);\n    let h3=c0.sub(c1).mul_m31(half.mul(z.inv()));\n    h0.add(alpha.mul(h1.add(alpha.mul(h2.add(alpha.mul(h3))))))\n}\n/// The five base-field denominators used to fold one sampled query: circle\n/// x/y, followed by line x/y/z. Their inverses are batch-computed once per\n/// transaction so each query avoids five independent field inversions.\nstruct QueryGeometry { start:usize, inverses:Vec<[M31;5]>, line_z:Vec<M31> }\n\n#[inline(always)]\nfn batch_prefix_products(flat:&[M31])->(Vec<M31>,M31) {\n    let mut prefixes=Vec::with_capacity(flat.len());\n    let mut product=M31::ONE;\n    let mut index=0;\n    while index<flat.len() {\n        let value=flat[index];\n        prefixes.push(product);\n        product=product.mul(value);\n        index+=1;\n    }\n    (prefixes,product)\n}\n\nimpl QueryGeometry {\n    fn for_range(queries:&[u32;22],start:usize,end:usize)->Result<Self,Error> {\n        if start>end||end>queries.len(){return Err(Error::Query);}\n        let mut line_z_values=Vec::with_capacity(end-start);\n        let mut flat=Vec::with_capacity((end-start)*5);\n        for &query in &queries[start..end] {\n            let u=query as usize;\n            let fibre=domain::FibreIndex::new(u).map_err(|_|Error::Query)?;\n            let domain::Point{x:circle_x,y:circle_y}=crate::fast_domain::fibre_point(fibre);\n            let line_x=crate::fast_domain::line_node(domain::FibreIndex::new(u/4*4).map_err(|_|Error::Query)?);\n            let line_y=crate::fast_domain::line_node(domain::FibreIndex::new(u/4*4+3).map_err(|_|Error::Query)?);\n            let line_z=line_x.mul(line_x).double().sub(M31::ONE);\n            let values=[circle_x,circle_y,line_x,line_y,line_z];\n            if values.iter().any(|x|*x==M31::ZERO){return Err(Error::Query);}\n            flat.extend_from_slice(&values);\n            line_z_values.push(line_z);\n        }\n        if flat.is_empty(){return Ok(Self{start,inverses:Vec::new(),line_z:line_z_values});}\n        // Standard prefix-product/backward batch inversion. The only `inv`\n        // in this routine is applied to the product of all nonzero entries.\n        let (prefixes,product)=batch_prefix_products(&flat);\n        let mut suffix_inverse=product.inv();\n        let mut flat_inverse=Vec::with_capacity(flat.len());\n        flat_inverse.resize(flat.len(),M31::ZERO);\n        for i in (0..flat.len()).rev() {\n            flat_inverse[i]=suffix_inverse.mul(prefixes[i]);\n            suffix_inverse=suffix_inverse.mul(flat[i]);\n        }\n        let inverses=(0..line_z_values.len()).map(|i|core::array::from_fn(|j|flat_inverse[5*i+j])).collect();\n        Ok(Self{start,inverses,line_z:line_z_values})\n    }\n    #[inline(always)]\n    fn for_query(&self,index:usize)->&[M31;5] {&self.inverses[index-self.start]}\n}\n#[inline(always)]\nfn circle_fold_with_inverses(alpha:E,a:[E;4],inverse:&[M31;5])->E {\n    let [ix,iy,_,_,_]=*inverse;let [a,b,c,d]=a;\n    let h0=a.add(b).add(c).add(d).mul_m31(QUARTER);\n    let h1=a.sub(b).sub(c).add(d).mul_m31(QUARTER.mul(iy));\n    let h2=a.add(b).sub(c).sub(d).mul_m31(QUARTER.mul(ix));\n    let h3=a.sub(b).add(c).sub(d).mul_m31(QUARTER.mul(ix).mul(iy));\n    h0.add(alpha.mul(h1.add(alpha.mul(h2.add(alpha.mul(h3))))))\n}\n#[inline(always)]\nfn line_fold_with_inverses(alpha:E,a:[E;4],inverse:&[M31;5])->E {\n    let [_,_,ix,iy,iz]=*inverse;let half=M31(1073741824);let [a,b,c,d]=a;\n    let h0=a.add(b).add(c).add(d).mul_m31(QUARTER);\n    let h2=a.add(b).sub(c).sub(d).mul_m31(QUARTER.mul(iz));\n    let c0=a.sub(b).mul_m31(half.mul(ix));\n    let c1=d.sub(c).mul_m31(half.mul(iy));\n    let h1=c0.add(c1).mul_m31(half);\n    let h3=c0.sub(c1).mul_m31(half.mul(iz));\n    h0.add(alpha.mul(h1.add(alpha.mul(h2.add(alpha.mul(h3))))))\n}\n/// Transaction-local residues. At a group boundary each limb is <2^34.\n/// Four products add at most 4*(P-1)^2; adding the retained folded residue\n/// still fits u64 because 4*(P-1)^2+2^34 < 2^64. Flush after each four queries.\nstruct BatchedWeights { raw:Vec<[u64;4]>, terms:usize }\nimpl BatchedWeights {\n    fn new(weights:&[K])->Result<Self,Error> {\n        let mut raw=aspis_core::r0::heap::filled(weights.len(),[0u64;4]).map_err(|_|Error::Allocation)?;\n        let mut index=0;\n        while index<weights.len() {\n            let w=weights[index];\n            raw[index]=[w.c0.a.0 as u64,w.c0.b.0 as u64,w.c1.a.0 as u64,w.c1.b.0 as u64];\n            index+=1;\n        }\n        Ok(Self{raw,terms:0})\n    }\n    #[inline(always)]\n    fn push(&mut self,index:usize,power:K,basis:M31) {\n        let flush=self.terms&3==3;\n        update_residue_row(&mut self.raw[index],power,basis,flush);\n    }\n\n    fn value(&self,index:usize)->K {\n        let [a,b,c,d]=self.raw[index].map(M31::reduce_u64);\n        K{c0:aspis_core::field::CM31{a,b},c1:aspis_core::field::CM31{a:c,b:d}}\n    }\n    fn finish(&self,weights:&mut[K]) {for (i,w) in weights.iter_mut().enumerate(){*w=self.value(i);}}\n}\n\n\n#[inline(always)]\nfn residue_limb_at(row:&[u64;4],index:usize)->u64 {row[index]}\n#[inline(always)]\nfn power_limb_at(limbs:&[u32;4],index:usize)->u32 {limbs[index]}\n#[inline(always)]\nfn update_residue_row(row:&mut [u64;4],power:K,basis:M31,flush:bool) {\n    let limbs=[power.c0.a.0,power.c0.b.0,power.c1.a.0,power.c1.b.0];\n    for j in 0..4 {\n        let old=residue_limb_at(row,j);\n        let limb=power_limb_at(&limbs,j);\n        row[j]=old+u64::from(limb)*u64::from(basis.0);\n    }\n    if flush {\n        for limb in row {*limb=(*limb&0x7fff_ffff)+(*limb>>31);}\n    }\n}\n\n#[inline(never)]\npub fn accumulate(p:&Prepared,a:&mut Accumulator,index:usize,value:E) {\n    let mut node=crate::fast_domain::line_node(domain::FibreIndex::new(if p.variant.folds()==1 {index}else{index/4*4}).unwrap());\n    if p.variant.folds()==2 {for _ in 0..2 {node=node.mul(node).double().sub(M31::ONE);}}\n    accumulate_with_node(p,a,node,value,None)\n}\n#[inline(never)]\nfn accumulate_with_node(p:&Prepared,a:&mut Accumulator,mut node:M31,value:E,mut pending:Option<&mut BatchedWeights>) {\n    let mut basis=[M31::ZERO;256];basis[0]=M31::ONE;let mut n=1;\n    while n<a.weights.len() {for j in 0..n {basis[n+j]=basis[j].mul(node);} node=node.mul(node).double().sub(M31::ONE);n*=2;}\n    for j in 0..a.weights.len() {\n        if let Some(weights)=pending.as_deref_mut() {\n            weights.push(j,a.power,basis[j]);\n            #[cfg(feature=\"prover\")] {a.weights[j]=weights.value(j);}\n        } else {a.weights[j]=a.weights[j].add(a.power.mul_m31(basis[j]));}\n        crate::trace::value(12,a.next*a.weights.len()+j,E::from_qm31(a.weights[j]));\n        crate::trace::value(13,a.next*a.weights.len()+j,E::from_m31(basis[j]));\n    }\n    if let Some(weights)=pending {weights.terms+=1;}\n    a.rhs=a.rhs.add(value.mul_qm31(a.power));crate::trace::value(11,a.next,a.rhs);\n    a.power=a.power.mul(p.rho);a.next+=1;\n}\n\n\n#[inline(always)]\nfn basis_at(basis:&[M31;256],index:usize)->M31 {basis[index]}\n#[inline(always)]\nfn accumulated_weight_at(weights:&[K],index:usize)->K {weights[index]}\n\n#[inline(never)]\nfn accumulate_batched_with_node(p:&Prepared,a:&mut Accumulator,mut node:M31,value:E,weights:&mut BatchedWeights) {\n    let width=a.weights.len();\n    let mut basis=[M31::ZERO;256];basis[0]=M31::ONE;let mut n=1;\n    while n<width {for j in 0..n {basis[n+j]=basis[j].mul(node);} node=node.mul(node).double().sub(M31::ONE);n*=2;}\n    for j in 0..width {\n        weights.push(j,a.power,basis_at(&basis,j));\n        #[cfg(feature=\"prover\")] {a.weights[j]=weights.value(j);}\n        crate::trace::value(12,a.next*width+j,E::from_qm31(accumulated_weight_at(&a.weights,j)));\n        crate::trace::value(13,a.next*width+j,E::from_m31(basis_at(&basis,j)));\n    }\n    weights.terms+=1;\n    a.rhs=a.rhs.add(value.mul_qm31(a.power));crate::trace::value(11,a.next,a.rhs);\n    a.power=a.power.mul(p.rho);a.next+=1;\n}\n\npub fn polynomial(bytes:&[u8],x:E)->E {(0..7).rev().fold(E::ZERO,|a,i|a.mul(x).add(field(bytes,i)))}\nfn finish_relation_round(poly:&[u8],alpha:E,mut claim:E,round:usize)->Result<E,Error> {\n        let lhs=field(poly,0).add(field(poly,4));let rhs=claim.mul_m31(QUARTER);\n        crate::trace::value(15,3*round,lhs);crate::trace::value(15,3*round+1,rhs);\n        if lhs!=rhs {return Err(Error::Relation);}\n        claim=polynomial(poly,alpha);crate::trace::value(15,3*round+2,claim);\n    Ok(claim)\n}\n\nfn finish_query_dot(final_message:&[u8],weights:&[K])->Result<E,Error> {\n    let mut dot=crate::fast_pairing::EbyKDot::new();\n    let mut j=0;\n    while j<weights.len() {dot.push(field(final_message,j),weights[j]).map_err(|_|Error::Parse)?;j+=1;}\n    Ok(dot.finish())\n}\n\n#[inline(never)]\npub fn finish_relation(v:&View<'_>,p:&Prepared,a:&Accumulator,obs:Observer)->Result<(),Error> {\n    let mut claim=p.claim;\n    claim=finish_relation_round(v.round0,p.alpha[0],claim,0)?;\n    if p.variant.folds()==2 {claim=finish_relation_round(v.round1,p.alpha[1],claim,1)?;}\n    let weights=Weights::new(p.variant,&p.semantic_alpha,&p.z)?;\n    let pair=weights.pair(&p.alpha[..p.variant.folds()],v.final_message,p.kappa)?;\n    crate::trace::value(16,0,pair);crate::trace::value(16,1,claim);\n    if pair!=claim {return Err(Error::Relation);}\n    mark(obs,Phase::Relation);\n    let actual=finish_query_dot(v.final_message,&a.weights)?;\n    crate::trace::value(17,0,actual);crate::trace::value(17,1,a.rhs);\n    if a.next!=22||actual!=a.rhs {return Err(Error::Query);}\n    mark(obs,Phase::Final);Ok(())\n}\n\nfn put(out:&mut Vec<u8>,x:E) {out.extend_from_slice(&x.to_le_bytes());}\nfn put_k(out:&mut Vec<u8>,x:K) {let mut b=[0;16];x.write_le_bytes(&mut b);out.extend_from_slice(&b);}\npub fn checkpoint<H:Digest32>(p:&Prepared,a:&Accumulator,proof:&[u8],public:&[u8],hash:H)->Vec<u8> {\n    let mut out=Vec::with_capacity(checkpoint_size(p.variant));\n    out.extend_from_slice(b\"R1P2CKP2\");out.extend_from_slice(&[p.variant.tag(),a.next as u8,1,0,0,0,0,0]);\n    out.extend_from_slice(&hash.digest(&[proof]));out.extend_from_slice(&hash.digest(&[public]));out.extend_from_slice(&p.state);\n    for root in &p.roots {out.extend_from_slice(root);}\n    for x in [p.gamma,p.kappa,p.alpha[0],p.alpha[1]] {put(&mut out,x);}\n    put_k(&mut out,p.rho);\n    for q in p.queries {out.extend_from_slice(&q.to_le_bytes());}\n    for x in p.semantic_alpha {let mut b=[0;16];x.write_le_bytes(&mut b);out.extend_from_slice(&b);}\n    for z in p.z {for x in [z.x,z.y] {let mut b=[0;16];x.write_le_bytes(&mut b);out.extend_from_slice(&b);}}\n    for x in [p.claim,a.rhs] {put(&mut out,x);}\n    put_k(&mut out,a.power);\n    for &x in &a.weights {put_k(&mut out,x);}\n    let sum=hash.digest(&[b\"UNPROVED:R1:checkpoint\",&out]);out.extend_from_slice(&sum);\n    assert_eq!(out.len(),checkpoint_size(p.variant));out\n}\nstruct Reader<'a>{bytes:&'a[u8],at:usize}\nimpl<'a> Reader<'a>{\n    fn raw<const N:usize>(&mut self)->[u8;N] {let b=self.bytes[self.at..self.at+N].try_into().unwrap();self.at+=N;b}\n    fn e(&mut self)->Result<E,Error>{E::from_le_bytes(&self.raw::<32>()).ok_or(Error::Checkpoint)}\n    #[inline(always)]\n    fn k(&mut self)->Result<K,Error>{K::from_le_bytes(&self.raw::<16>()).ok_or(Error::Checkpoint)}\n}\n\n\n#[inline(always)]\nfn validate_checkpoint_queries(queries:&[u32;22])->Result<(),Error> {\n    let mut i=0;\n    while i<queries.len() {\n        let q=queries[i];\n        if q>=1<<18||queries[..i].contains(&q){return Err(Error::Checkpoint);}\n        i+=1;\n    }\n    Ok(())\n}\n\n#[inline(always)]\nfn read_checkpoint_weights(bytes:&[u8],mut at:usize,mut weights:Vec<K>)->Result<(Vec<K>,usize),Error> {\n    for out in &mut weights {\n        let mut reader=Reader{bytes,at};\n        let value=reader.k()?;\n        at=reader.at;\n        *out=value;\n    }\n    Ok((weights,at))\n}\n\n\n#[inline(always)]\nfn read_checkpoint_semantic_alpha(bytes:&[u8],at:usize)->Result<([K;10],usize),Error> {\n    let mut r=Reader{bytes,at};\n    let values=[\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n    ];\n    Ok((values,r.at))\n}\n\n#[inline(never)]\npub fn resume<H:Digest32>(bytes:&[u8],proof:&[u8],public:&[u8],v:Variant,hash:H)->Result<(Box<Prepared>,Accumulator),Error> {\n    if bytes.len()!=checkpoint_size(v)||&bytes[..8]!=b\"R1P2CKP2\"||bytes[8]!=v.tag()||bytes[9]>22||bytes[10]!=1||bytes[11..16].iter().any(|&b|b!=0) {return Err(Error::Checkpoint);}\n    let end=bytes.len()-32;\n    if bytes[16..48]!=hash.digest(&[proof])||bytes[48..80]!=hash.digest(&[public])||bytes[end..]!=hash.digest(&[b\"UNPROVED:R1:checkpoint\",&bytes[..end]]) {return Err(Error::Checkpoint);}\n    let mut r=Reader{bytes,at:80};let state=r.raw();let roots=[r.raw(),r.raw()];\n    let gamma=r.e()?;let kappa=r.e()?;let alpha=[r.e()?,r.e()?];let rho=r.k()?;\n    let queries=[\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n    ];\n    validate_checkpoint_queries(&queries)?;\n    let (semantic_alpha,at)=read_checkpoint_semantic_alpha(bytes,r.at)?;\n    r.at=at;\n    let z=[SecureCirclePoint{x:r.k()?,y:r.k()?},SecureCirclePoint{x:r.k()?,y:r.k()?}];\n    let claim=r.e()?;let rhs=r.e()?;let power=r.k()?;\n    let weights=aspis_core::r0::heap::filled(v.final_len(),K::ZERO).map_err(|_|Error::Allocation)?;\n    let (weights,at)=read_checkpoint_weights(bytes,r.at,weights)?;\n    if at!=end {return Err(Error::Checkpoint);}\n    Ok((Box::new(Prepared{variant:v,roots,gamma,kappa,alpha,rho,queries,semantic_alpha,z,claim,state}),Accumulator{weights,rhs,power,next:bytes[9] as usize}))\n}\n\n#[cfg(test)]\nmod query_geometry_tests {\n    use super::*;\n    use aspis_core::field::{CM31,QM31,P};\n\n    fn next(state:&mut u64)->u64 {\n        *state=state.wrapping_add(0x9e37_79b9_7f4a_7c15);\n        let mut value=*state;\n        value=(value^(value>>30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);\n        value=(value^(value>>27)).wrapping_mul(0x94d0_49bb_1331_11eb);\n        value^(value>>31)\n    }\n    fn random_m31(state:&mut u64)->M31 {M31((next(state)%u64::from(P)) as u32)}\n    fn random_e(state:&mut u64)->E {\n        let mut scalar=||random_m31(state);\n        let mut k=||QM31{c0:CM31{a:scalar(),b:scalar()},c1:CM31{a:scalar(),b:scalar()}};\n        E::new(k(),k())\n    }\n    fn queries()->[u32;22] {core::array::from_fn(|i|((i*7919+12345)%262144) as u32)}\n\n    #[test]\n    fn batched_geometry_inverses_match_individual_inverses_for_ranges() {\n        let queries=queries();\n        for (start,end) in [(0,0),(0,1),(0,7),(7,22),(0,22),(5,19)] {\n            let geometry=QueryGeometry::for_range(&queries,start,end).unwrap();\n            assert_eq!(geometry.start,start);\n            assert_eq!(geometry.inverses.len(),end-start);\n            for index in start..end {\n                let u=queries[index] as usize;\n                let point=crate::fast_domain::fibre_point(domain::FibreIndex::new(u).unwrap());\n                let line_x=crate::fast_domain::line_node(domain::FibreIndex::new(u/4*4).unwrap());\n                let line_y=crate::fast_domain::line_node(domain::FibreIndex::new(u/4*4+3).unwrap());\n                let line_z=line_x.mul(line_x).double().sub(M31::ONE);\n                assert_eq!(*geometry.for_query(index),[point.x.inv(),point.y.inv(),line_x.inv(),line_y.inv(),line_z.inv()]);\n            }\n        }\n    }\n\n    #[test]\n    fn batched_circle_and_line_folds_match_independent_reference() {\n        let queries=queries();\n        let geometry=QueryGeometry::for_range(&queries,0,22).unwrap();\n        let mut state=0x243f_6a88_85a3_08d3;\n        let max=E::from_limbs([P-1;8]).unwrap();\n        for index in 0..22 {\n            for case in 0..8 {\n                let alpha=match case%4 {0=>E::ZERO,1=>E::ONE,2=>max,_=>random_e(&mut state)};\n                let values=core::array::from_fn(|slot|match (case+slot)%4 {0=>E::ZERO,1=>E::ONE,2=>max,_=>random_e(&mut state)});\n                let inverse=geometry.for_query(index);\n                assert_eq!(circle_fold_with_inverses(alpha,values,inverse),circle_fold(alpha,queries[index] as usize,values),\"circle index {index}, case {case}\");\n                assert_eq!(line_fold_with_inverses(alpha,values,inverse),line_fold(alpha,queries[index] as usize/4,values),\"line index {index}, case {case}\");\n            }\n        }\n    }\n}\n\n#[cfg(test)]\nmod batched_weight_tests {\n    use super::*;\n    #[test]\n    fn bounded_rho_residues_match_all_canonical_prefixes() {\n        let hi=M31(aspis_core::field::P-1);\n        let max=K{c0:aspis_core::field::CM31{a:hi,b:hi},c1:aspis_core::field::CM31{a:hi,b:hi}};\n        for power in [K::ZERO,K::ONE,max] {\n            let mut reference=alloc::vec![max;64];let mut pending=BatchedWeights::new(&reference).unwrap();\n            for _ in 0..22 {\n                for j in 0..64 {\n                    pending.push(j,power,hi);\n                    reference[j]=reference[j].add(power.mul_m31(hi));\n                    assert_eq!(pending.value(j),reference[j]);\n                }\n                pending.terms+=1;\n            }\n            let mut actual=alloc::vec![K::ZERO;64];pending.finish(&mut actual);assert_eq!(actual,reference);\n        }\n    }\n}\n\n// The adopted R1 verifier (PREREG-PROOF-SIZE-2, 2026-10-19): the compact\n// binary-multiproof format of `crate::compact`. These are the only R1\n// verification entrypoints of a default build.\n#[path=\"candidate.rs\"]\npub mod candidate;\npub use candidate::{parse_shape,tx1,tx2,tx2_authenticated};\n/// The one stored proof length of the adopted format (57,607 bytes).\npub const PROOF_BYTES:usize=crate::compact::PROOF_BYTES;\n/// The one stage-1 split of the adopted format (queries 0..10 in stage 1).\npub const SPLIT:usize=crate::compact::SPLIT;\nconst _:()=assert!(PROOF_BYTES==57_607&&SPLIT==10);\n\n// AUDIT ONLY: the retired eight-way verifier, for differential evidence on\n// saved eight-way fixtures. Never in a prover or SBF build (lib.rs guards).\n#[cfg(feature=\"audit-eight-way\")]\n#[path=\"eight_way.rs\"]\npub mod eight_way;\n\n#[cfg(kani)]\nmod NBS_geometry {\n use super::*;\n const P:u32=2147483647;\n static mut CALLS:u8=0;static mut LEFT:[u32;2]=[0;2];static mut RIGHT:[u32;2]=[0;2];static mut REPLY:[u32;2]=[0;2];\n fn base_mul(x:M31,y:M31)->M31 {\n  assert!(x.0<P&&y.0<P);\n  let z:u32=kani::any();kani::assume(u64::from(z)==u64::from(x.0).wrapping_mul(u64::from(y.0))%u64::from(P));\n  unsafe{let at=usize::from(CALLS);assert!(at<2);LEFT[at]=x.0;RIGHT[at]=y.0;REPLY[at]=z;CALLS+=1;}\n  M31(z)\n }\n fn no_mul(_:M31,_:M31)->M31 {assert!(false);M31::ZERO}\n fn no_fibre(_:usize)->Result<domain::FibreIndex,aspis_core::r0::Error>{assert!(false);Err(aspis_core::r0::Error::IndexOutOfRange)}\n #[kani::proof] #[kani::unwind(4)] #[kani::stub(M31::mul,no_mul)]\n fn prefix_empty(){let (p,x)=batch_prefix_products(&[]);assert!(p.len()==0);assert!(x==M31::ONE);}\n #[kani::proof] #[kani::unwind(112)] #[kani::stub(M31::mul,base_mul)]\n fn prefix_step(){\n  let raw:[u32;110]=kani::any();let old:[u32;110]=kani::any();\n  let flat=raw.map(M31);let mut prefixes:Vec<M31>=old.map(M31).into();\n  let mut index:usize=kani::any();kani::assume(index<110);let before=index;\n  prefixes.truncate(index);let ptr=prefixes.as_ptr();\n  let mut product=M31(kani::any());kani::assume(product.0<P&&flat[index].0<P);let previous=product.0;\n  unsafe{CALLS=0;}\n  if index<flat.len(){let value=flat[index];prefixes.push(product);product=product.mul(value);index+=1;}\n  assert!(index==before+1&&prefixes.len()==before+1);assert!(prefixes.as_ptr()==ptr);\n  let j:usize=kani::any();kani::assume(j<index);\n  assert!(prefixes[j].0==if j==before{previous}else{old[j]});\n  unsafe{assert!(CALLS==1);assert!(LEFT[0]==previous&&RIGHT[0]==raw[before]);assert!(product.0==REPLY[0]);}\n }\n #[kani::proof] #[kani::unwind(112)] #[kani::stub(M31::mul,base_mul)]\n fn backward_step(){\n  let flat:[u32;110]=kani::any();let prefixes:[u32;110]=kani::any();let old:[u32;110]=kani::any();\n  let mut flat_inverse:Vec<M31>=old.map(M31).into();let i:usize=kani::any();kani::assume(i<110);\n  let flat=flat.map(M31);let prefixes=prefixes.map(M31);\n  let mut suffix_i