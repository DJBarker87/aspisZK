egistryFormatError::InvalidDeploymentMode);}\nif b[249..256]!=[0;7] {return Err(PoolV1VerifierRegistryFormatError::NonZeroReserved);}\nlet r=VerifierRegistryV2{flags:b[5],bump:b[7],pool:b[8..40].try_into().unwrap(),authority:b[40..72].try_into().unwrap(),policy_binding:b[72..104].try_into().unwrap(),generation:u64::from_le_bytes(b[104..112].try_into().unwrap()),minimum_activation_delay_slots:u64::from_le_bytes(b[112..120].try_into().unwrap()),registry_program:b[120..152].try_into().unwrap(),loader_program:b[152..184].try_into().unwrap(),programdata_address:b[184..216].try_into().unwrap(),executable_hash:b[216..248].try_into().unwrap(),programdata_bump:b[248]};\nNBH_validate_verifier_registry_v2(&r)?; Ok(r)}\n#[kani::proof]\nfn NBH_decode_verifier_registry_v2_gate() {let b:[u8;257]=kani::any(); let len:usize=kani::any(); kani::assume(len<=257); assert_eq!(decode_verifier_registry_v2(&b[..len]),NBH_decode_verifier_registry_v2(&b[..len]));}\nfn NBH_decode_verifier_registry_entry_v2(b: &[u8])->Result<VerifierRegistryEntryV2,PoolV1VerifierRegistryFormatError> {if b.len()!=320 {return Err(PoolV1VerifierRegistryFormatError::WrongLength);}\nif &b[..4]!=b\"ASE2\" {return Err(PoolV1VerifierRegistryFormatError::WrongMagic);}\nif b[4]!=3 {return Err(PoolV1VerifierRegistryFormatError::WrongVersion);}\nif b[7]!=1 {return Err(PoolV1VerifierRegistryFormatError::InvalidDeploymentMode);}\nif b[314..320]!=[0;6] {return Err(PoolV1VerifierRegistryFormatError::NonZeroReserved);}\nlet status=match b[5] {0=>VerifierEntryStatusV1::Pending,1=>VerifierEntryStatusV1::Active,2=>VerifierEntryStatusV1::Paused,3=>VerifierEntryStatusV1::Retired,_=>return Err(PoolV1VerifierRegistryFormatError::InvalidStatus)};\nlet r=VerifierRegistryEntryV2{status:status,statement_version:b[6],bump:b[312],pool:b[8..40].try_into().unwrap(),verifier_program:b[40..72].try_into().unwrap(),profile_binding:b[72..104].try_into().unwrap(),release_binding:b[104..136].try_into().unwrap(),activation_slot:u64::from_le_bytes(b[2