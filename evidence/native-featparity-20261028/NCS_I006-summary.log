*rows;\n let mut flat=carrier::<60>(n);let mut line_z_values=carrier::<12>(rows);\n let raw:[u32;5]=kani::any();let values=raw.map(M31);let line_z=values[4];\n let j:usize=kani::any();kani::assume(j<5);let k:usize=kani::any();let z:usize=kani::any();kani::assume(rows==0||(k<n&&z<rows));\n let old=if rows>0{flat[k].0}else{0};let old_z=if rows>0{line_z_values[z].0}else{0};let fp=flat.as_ptr();let zp=line_z_values.as_ptr();\n flat.extend_from_slice(&values);\n line_z_values.push(line_z);\nif rows>0{assert!(flat[k].0==old);}\n}\n#[kani::proof] #[kani::unwind(512)]\n#[kani::stub(<[u8]>::copy_from_slice,crate::NBS_copy::KMX_copy_from_slice)]\n#[kani::stub(core::ptr::copy_nonoverlapping,crate::NBS_copy::KMX_copy_nonoverlapping)]\n#[kani::stub(<[u8]>::clone_from_slice,crate::NBS_copy::KMX_clone_from_slice)]\n#[kani::stub(alloc::vec::Vec::<u8>::extend_from_slice,crate::NBS_copy::KMX_extend_from_slice)]\n#[kani::stub(<[u8]>::to_vec,crate::NBS_copy::KMX_to_vec)]\n#[kani::stub(alloc::alloc::realloc,crate::NBS_copy::KMX_realloc)]\nfn z_new(){\nlet rows:usize=kani::any();kani::assume(rows<12);let n=5*rows;\n let mut flat=carrier::<60>(n);let mut line_z_values=carrier::<12>(rows);\n let raw:[u32;5]=kani::any();let values=raw.map(M31);let line_z=values[4];\n let j:usize=kani::any();kani::assume(j<5);let k:usize=kani::any();let z:usize=kani::any();kani::assume(rows==0||(k<n&&z<rows));\n let old=if rows>0{flat[k].0}else{0};let old_z=if rows>0{line_z_values[z].0}else{0};let fp=flat.as_ptr();let zp=line_z_values.as_ptr();\n flat.extend_from_slice(&values);\n line_z_values.push(line_z);\nassert!(line_z_values[rows].0==raw[4]);\n}\n#[kani::proof] #[kani::unwind(512)]\n#[kani::stub(<[u8]>::copy_from_slice,crate::NBS_copy::KMX_copy_from_slice)]\n#[kani::stub(core::ptr::copy_nonoverlapping,crate::NBS_copy::KMX_copy_nonoverlapping)]\n#[kani::stub(<[u8]>::clone_from_slice,crate::NBS_copy::KMX_clone_from_slice)]\n#[kani::stub(alloc::vec::Vec::<u8>::extend_from_slice,crate::NBS_copy::KMX_extend