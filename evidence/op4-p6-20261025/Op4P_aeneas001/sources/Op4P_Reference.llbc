{"charon_version":"0.1.223","translated":{"crate_name":"op4p_scan","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::Op4P_reference::canonical_scan"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["crate::Op4P_reference","core::result::Result"],"opaque":["crate","aspis_core"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-op4-p6-20261025/Op4P_Reference.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"src/Op4P_reference.rs"},"crate_name":"op4p_scan","contents":"// Owned whole-scan reference. Recursive bodies reused byte-for-byte from the\n// existing MultiproofParserRef extraction; no shipped source is changed.\npub mod reference {\npub fn canonical_word(b:[u8;4])->bool {u32::from_le_bytes(b)<0x7fffffff}\npub fn canonical_qm(b:[u8;16])->bool {\n    canonical_word([b[0],b[1],b[2],b[3]]) &&\n    canonical_word([b[4],b[5],b[6],b[7]]) &&\n    canonical_word([b[8],b[9],b[10],b[11]]) &&\n    canonical_word([b[12],b[13],b[14],b[15]])\n}\npub fn check_values(bytes:&[u8])->bool {\n    if bytes.len()<16 {return true;}\n    let chunk=read16(bytes);\n    canonical_qm(chunk) && check_values(&bytes[16..])\n}\npub fn read16(bytes:&[u8])->[u8;16] {[bytes[0],bytes[1],bytes[2],bytes[3],bytes[4],bytes[5],bytes[6],bytes[7],bytes[8],bytes[9],bytes[10],bytes[11],bytes[12],bytes[13],bytes[14],bytes[15]]}\n}\npub mod parser_reference {\nuse super::reference::{canonical_word,check_values};\npub fn canonical_words(bytes:&[u8])->bool {\n    if bytes.is_empty() {return true;}\n    if bytes.len()<4 {return false;}\n    canonical_word([bytes[0],bytes[1],bytes[2],bytes[3]]) && canonical_words(&bytes[4..])\n}\npub fn opening_scan(bytes:&[u8])->bool {\n    bytes.len()==832 && canonical_words(&bytes[..608]) && canonical_words(&bytes[672..800])\n}\npub fn opening_rows(bytes:&[u8],remaining:u8)->bool {\n    if remaining==0 {return bytes.is_empty();}\n    if bytes.len()<832 {return false;}\n    opening_scan(&bytes[..832]) && opening_rows(&bytes[832..],remaining-1)\n}\npub fn scan(bytes:&[u8])->bool {\n    if bytes.len()!=57607 {return false;}\n    check_values(&bytes[7031..7495]) && canonical_words(&bytes[7495..7751]) &&\n    canonical_words(&bytes[7783..10055]) && opening_rows(&bytes[10055..28359],22)\n}\n}\n#[derive(Clone,Copy,Debug,PartialEq,Eq)]\npub enum Error { Parse }\npub fn canonical_scan(bytes:&[u8])->Result<(),Error> {\n    if parser_reference::scan(bytes) {Ok(())} else {Err(Error::Parse)}\n}\n"},{"id":1,"name":{"Local":"src/lib.rs"},"crate_name":"op4p_scan","contents":"#![allow(non_snake_case,dead_code,unexpected_cfgs)]\npub mod Op4P_reference;\n#[cfg(kani)] mod Op4P_shipped;\n#[cfg(kani)] mod Op4P_harness;\n"},{"id":2,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/