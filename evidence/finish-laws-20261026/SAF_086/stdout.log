def AspisR1.SAP_FinishSaved.Outcome : {W : Type} →
  AspisR1Stage2.Stage2Finish.FinishOps W →
    AspisR1Stage2.verifier.View →
      AspisR1Stage2.verifier.Prepared →
        AspisR1Stage2.verifier.Accumulator →
          Aeneas.Std.Slice Aeneas.Std.U8 →
            Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8 →
              (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
                AspisV8R19.DuplexFrames.Bytes →
                  AspisV8R19.DuplexFrames.Bytes →
                    AspisR1CurrentCaller.verifier.Prepared →
                      AspisR1.OraclePortCompactDraft.Parsed →
                        List (AspisV8R19.DuplexFrames.Bytes × AspisV8R19.SourceDuplexStep.State) →
                          List AspisV8R19.DuplexFrames.Bytes →
                            (Fin 22 → Fin 262144) →
                              AspisR1.RawCutTranscriptRun.ErasedPrefix →
                                AspisR1.RecordedBinaryExperimentBin.SourceInputs →
                                  AspisR1.OraclePortCheckpointResumeC5.Context → Prop :=
fun {W} finish v p a proof savedVec H stored publicBytes tx1p parsed trace semantic q tr i c =>
  p.variant = AspisR1Stage2.transport.Variant.S2 ∧
    ∃ alpha0 alpha1 alphas,
      p.alpha.index_usize 0#usize = Aeneas.Std.Result.ok alpha0 ∧
        p.alpha.index_usize 1#usize = Aeneas.Std.Result.ok alpha1 ∧
          Aeneas.Std.core.array.Array.index
                (Aeneas.Std.core.ops.index.IndexSlice
                  (Aeneas.Std.core.slice.index.SliceIndexRangeToUsizeSlice AspisR1Stage2.Stage2Finish.E))
                p.alpha { «end» := 2#usize } =
              Aeneas.Std.Result.ok alphas ∧
            ∀ (r0 : AspisR1.RowFinish_Control.RoundValues finish v.round0 alpha0 p.claim)
              (r1 : AspisR1.RowFinish_Control.RoundValues finish v.round1 alpha1 r0.value) (weights : W)
              (pair dot : AspisR1Stage2.Stage2Finish.E),
              finish.newWeights p.variant p.semantic_alpha p.z =
                  Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok weights) →
                finish.pair weights alphas v.final_message p.kappa =
                    Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok pair) →
                  finish.dot v.final_message a.weights.deref =
                      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok dot) →
                    AspisR1.Port4D_Pairing.PairingLaws (AspisR1.Port3_FinishStage.release finish)
                        AspisR1.CheckpointBytes5Output.ofE v p i.data →
                      (∀ (j : Fin 22), AspisR1.MatchingSupport.match0 i.data (q j)) →
                        AspisR1.R3SemanticRemainingJoins.EquationEndpoint i.decoded
                            (AspisR1.OraclePortStoredDecisionDraftC4.typedRows
                              { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof, semantic := semantic } q tr)
                            i.data →
                          AspisR1.CheckpointBytes5Output.ofE dot =
                              ∑ l,
                                i.data.f l *
                                  AspisR1.LiteralOpeningView.eK
                                    ((AspisR1.CheckpointBytes5Output.accumulator a).weights l) →
                            (∀ x ∈ [r0.lhs, r0.rhs, r1.lhs, r1.rhs, pair, r1.value, dot, a.rhs],
                                AspisR1.CheckpointBytes4ReaderFields.sourceE (AspisR1.CheckpointBytes5Output.ofE x) =
                                  x) →
                              AspisR1.AuS1_Finish.Collision H trace parsed q ∨
                                Decidable.decide
                                      (AspisR1.Port3_NativeFinishBody.verifier.finish_relation
                                          (AspisR1.Port4D_Round.native finish) v p a Option.none =
                                        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ())) =
                                    AspisR1.OraclePortFrozen2.finish
                                      { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof, semantic := semantic } q
                                      tr i (AspisR1.CheckpointBytes5Output.accumulator a) ∧
                                  Decidable.decide
                                        (AspisR1.Port4D_FinishInstall.finish finish v p a Option.none =
                                          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ())) =
                                      AspisR1.D0TypedChecks.verify
                                        (AspisR1.OraclePortStoredDecisionDraftC4.typedRows
                                          { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof,
                                            semantic := semantic }
                                          q tr)
                                        i ∧
                                    AspisR1.D0TypedChecks.verify
                                        (AspisR1.OraclePortStoredDecisionDraftC4.typedRows
                                          { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof,
                                            semantic := semantic }
                                          q tr)
                                        i =
                                      Bool.true
def AspisR1.SAF_C_SAF_FinishPrepared.Outcome : {W : Type} →
  AspisR1Stage2.Stage2Finish.FinishOps W →
    AspisR1Stage2.verifier.View →
      AspisR1Stage2.verifier.Prepared →
        AspisR1Stage2.verifier.Accumulator →
          Aeneas.Std.Slice Aeneas.Std.U8 →
            Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8 →
              (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
                AspisV8R19.DuplexFrames.Bytes →
                  AspisV8R19.DuplexFrames.Bytes →
                    AspisR1CurrentCaller.verifier.Prepared →
                      AspisR1.OraclePortCompactDraft.Parsed →
                        List (AspisV8R19.DuplexFrames.Bytes × AspisV8R19.SourceDuplexStep.State) →
                          List AspisV8R19.DuplexFrames.Bytes →
                            (Fin 22 → Fin 262144) →
                              AspisR1.RawCutTranscriptRun.ErasedPrefix →
                                AspisR1.RecordedBinaryExperimentBin.SourceInputs →
                                  AspisR1.OraclePortCheckpointResumeC5.Context → Prop :=
fun {W} finish v p a proof savedVec H stored publicBytes tx1p parsed trace semantic q tr i c =>
  p.variant = AspisR1Stage2.transport.Variant.S2 ∧
    ∃ alpha0 alpha1 alphas,
      p.alpha.index_usize 0#usize = Aeneas.Std.Result.ok alpha0 ∧
        p.alpha.index_usize 1#usize = Aeneas.Std.Result.ok alpha1 ∧
          Aeneas.Std.core.array.Array.index
                (Aeneas.Std.core.ops.index.IndexSlice
                  (Aeneas.Std.core.slice.index.SliceIndexRangeToUsizeSlice AspisR1Stage2.Stage2Finish.E))
                p.alpha { «end» := 2#usize } =
              Aeneas.Std.Result.ok alphas ∧
            ∃ r0 r1 weights pair dot,
              finish.newWeights p.variant p.semantic_alpha p.z =
                  Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok weights) ∧
                finish.pair weights alphas v.final_message p.kappa =
                    Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok pair) ∧
                  finish.dot v.final_message a.weights.deref =
                      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok dot) ∧
                    r0.lhs = r0.rhs ∧
                      r1.lhs = r1.rhs ∧
                        pair = r1.value ∧
                          dot = a.rhs ∧
                            (AspisR1.SAF_ReducedLaws.Arithmetic (AspisR1.Port3_FinishStage.release finish) v p i.data →
                              (∀ (j : Fin 22), AspisR1.MatchingSupport.match0 i.data (q j)) →
                                AspisR1.R3SemanticRemainingJoins.EquationEndpoint i.decoded
                                    (AspisR1.OraclePortStoredDecisionDraftC4.typedRows
                                      { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof, semantic := semantic } q
                                      tr)
                                    i.data →
                                  AspisR1.CheckpointBytes5Output.ofE dot =
                                      ∑ l,
                                        i.data.f l *
                                          AspisR1.LiteralOpeningView.eK
                                            ((AspisR1.CheckpointBytes5Output.accumulator a).weights l) →
                                    AspisR1.AuS1_Finish.Collision H trace parsed q ∨
                                      Decidable.decide
                                            (AspisR1.Port3_NativeFinishBody.verifier.finish_relation
                                                (AspisR1.Port4D_Round.native finish) v p a Option.none =
                                              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ())) =
                                          AspisR1.OraclePortFrozen2.finish
                                            { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof,
                                              semantic := semantic }
                                            q tr i (AspisR1.CheckpointBytes5Output.accumulator a) ∧
                                        Decidable.decide
                                              (AspisR1.Port4D_FinishInstall.finish finish v p a Option.none =
                                                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ())) =
                                            AspisR1.D0TypedChecks.verify
                                              (AspisR1.OraclePortStoredDecisionDraftC4.typedRows
                                                { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof,
                                                  semantic := semantic }
                                                q tr)
                                              i ∧
                                          AspisR1.D0TypedChecks.verify
                                              (AspisR1.OraclePortStoredDecisionDraftC4.typedRows
                                                { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof,
                                                  semantic := semantic }
                                                q tr)
                                              i =
                                            Bool.true)
@AspisR1.SAF_ForgetFinish.forget : ∀ {W : Type} (finish : AspisR1Stage2.Stage2Finish.FinishOps W)
  (v : AspisR1Stage2.verifier.View) (p : AspisR1Stage2.verifier.Prepared) (a : AspisR1Stage2.verifier.Accumulator)
  (proof : Aeneas.Std.Slice Aeneas.Std.U8) (savedVec : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (stored publicBytes : AspisV8R19.DuplexFrames.Bytes) (tx1p : AspisR1CurrentCaller.verifier.Prepared)
  (parsed : AspisR1.OraclePortCompactDraft.Parsed)
  (trace : List (AspisV8R19.DuplexFrames.Bytes × AspisV8R19.SourceDuplexStep.State))
  (semantic : List AspisV8R19.DuplexFrames.Bytes) (q : Fin 22 → Fin 262144)
  (tr : AspisR1.RawCutTranscriptRun.ErasedPrefix) (i : AspisR1.RecordedBinaryExperimentBin.SourceInputs)
  (c : AspisR1.OraclePortCheckpointResumeC5.Context),
  AspisR1.SAF_C_SAF_FinishPrepared.Outcome finish v p a proof savedVec H stored publicBytes tx1p parsed trace semantic q
      tr i c →
    AspisR1.SAP_FinishSaved.Outcome finish v p a proof savedVec H stored publicBytes tx1p parsed trace semantic q tr i c
