def AspisR1.Rc3_Nonvacuity.Facts : (AspisR1.OraclePortStoredExperimentC4.Input →
    AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State Bool) →
  (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
    Aeneas.Std.Slice Aeneas.Std.U8 →
      Aeneas.Std.Slice Aeneas.Std.U8 →
        Aeneas.Std.Slice Aeneas.Std.U8 →
          Aeneas.Std.Slice Aeneas.Std.U8 → Aeneas.Std.Slice Aeneas.Std.U8 → AspisV8R19.DuplexFrames.Bytes → Prop :=
fun driver H pub proof pub2 proof2 checkpoint written =>
  ∀ (a : AspisR1.S2X.CheckpointVersionBinding written (AspisR1.MultiproofConeCanonical.bytesOf ↑checkpoint)),
    AspisR1.S2W_AuthenticatedInputs.P2Prime H proof pub proof2 pub2 →
      ∃ i,
        i.statement.pubBytes = AspisR1.MultiproofConeCanonical.bytesOf ↑pub ∧
          i.stored = AspisR1.MultiproofConeCanonical.bytesOf ↑proof ∧
            i.statement.tag = 2 ∧
              List.length i.statement.pubBytes = 1880 ∧
                (AspisV8R19.MemoizedProgramLaw.eval H (driver i)).2 = Bool.true ∧
                  ¬∀ (j : AspisR1.OraclePortStoredExperimentC4.Input),
                      (AspisV8R19.MemoizedProgramLaw.eval H (driver j)).2 = Bool.false
AspisR1.Rc3_Nonvacuity.derive : ∀
  (driver :
    AspisR1.OraclePortStoredExperimentC4.Input →
      AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State Bool)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (pub proof pub2 proof2 checkpoint : Aeneas.Std.Slice Aeneas.Std.U8) (written : AspisV8R19.DuplexFrames.Bytes),
  AspisR1.T2R_Acceptance.Facts driver H pub proof pub2 proof2 checkpoint written →
    AspisR1.Rc3_Nonvacuity.Facts driver H pub proof pub2 proof2 checkpoint written
@AspisR1.SAF_Returns.finish : ∀ {W : Type} (ops : AspisR1Stage2.Stage2Finish.FinishOps W)
  (v : AspisR1Stage2.verifier.View) (p : AspisR1Stage2.verifier.Prepared) (a : AspisR1Stage2.verifier.Accumulator),
  p.variant = AspisR1Stage2.transport.Variant.S2 →
    AspisR1.Port4D_FinishInstall.finish ops v p a Option.none =
        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) →
      ∃ alpha0 alpha1 r0 r1 weights alphas pair dot,
        p.alpha.index_usize 0#usize = Aeneas.Std.Result.ok alpha0 ∧
          p.alpha.index_usize 1#usize = Aeneas.Std.Result.ok alpha1 ∧
            ops.newWeights p.variant p.semantic_alpha p.z =
                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok weights) ∧
              Aeneas.Std.core.array.Array.index
                    (Aeneas.Std.core.ops.index.IndexSlice
                      (Aeneas.Std.core.slice.index.SliceIndexRangeToUsizeSlice AspisR1Stage2.Stage2Finish.E))
                    p.alpha { «end» := 2#usize } =
                  Aeneas.Std.Result.ok alphas ∧
                ops.pair weights alphas v.final_message p.kappa =
                    Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok pair) ∧
                  ops.dot v.final_message a.weights.deref =
                      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok dot) ∧
                    r0.lhs = r0.rhs ∧ r1.lhs = r1.rhs ∧ pair = r1.value ∧ dot = a.rhs
