    (core.result.Result verifier.QueryGeometry verifier.Error))  (a0 : (Array Std.U32 22#usize)) (a1 : Std.Usize) (a2 : Std.Usize) : Code (core.result.Result verifier.QueryGeometry verifier.Error) :=
