                          (AspisR1.OraclePortCkptAbi5Stage.strictStage stored tr.statement.pubBytes
                            (AspisR1.OraclePortAcceptedContextC6.context parsed i v) i.data
                            (AspisR1.SelectedChallengeMap.rhoOf i.rho) q)).2 with
                    | none => AspisV8R19.MemoizedProgramLaw.Program.done false
                    | some state => AspisR1.OraclePortFrozen2.stage2 parsed q tr i state)).2))))))
theorem AspisR1.CheckpointBytes5Join.success_conditioned_checkpoint_stage_join : ∀ {Hash : Type}
  (D : AspisR1Stage2.aspis_core.digest.Digest32 Hash) (hash : Hash)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) (reserved : Bool)
  (wp : AspisR1.CheckpointBytes5Writer.Prepared) (wa : AspisR1.CheckpointBytes5Writer.Accumulator)
  (proof public1 : Aeneas.Std.Slice Aeneas.Std.U8) (stored : AspisV8R19.DuplexFrames.Bytes)
  (parsed : AspisR1.OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144)
  (tr : AspisR1.RawCutTranscriptRun.ErasedPrefix) (i : AspisR1.RecordedBinaryExperimentBin.SourceInputs)
  (v : AspisR1.LiteralOpeningView.View),
  AspisR1.OraclePortStoredDecisionDraftC4.input parsed q tr = some i →
    AspisR1.OraclePortSelectedDraft.queries tr = some q →
      AspisR1.CheckpointBytes5Join.S2S10CallerBinding D hash H proof public1 stored tr.statement.pubBytes →
        AspisR1.CheckpointBytes5Join.S1S7S8StateProvenance wp wa
            (AspisR1.OraclePortCheckpointResumeC5.prepared (AspisR1.OraclePortAcceptedContextC6.context parsed i v)
              i.data (AspisR1.SelectedChallengeMap.rhoOf i.rho) q)
            (AspisR1.OraclePortCheckpointStateC3.write
                (AspisR1.OraclePortCheckpointResumeC5.model i.data (AspisR1.SelectedChallengeMap.rhoOf i.rho)
                  q)).accumulator →
          ∀ (p : AspisR1Stage2.verifier.Prepared) (a : AspisR1Stage2.verifier.Accumulator)
            (after : AspisR1.CheckpointBytes5Effect.Log),
            AspisR1.CheckpointBytes5Effect.run D hash (AspisR1.CheckpointBytes5Join.stage reserved wp wa proof public1)
                  [] =
                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (p, a), after) →
              (AspisR1.CheckpointBytes5Inputs.observe after,
                  some (AspisR1.CheckpointBytes5Join.resumedSource i.data p a)) =
                AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.OraclePortFrozen2.checkpoint stored parsed q tr i v) :=
fun {Hash} D hash H reserved wp wa proof public1 stored parsed q tr i v input query caller provenance p a after
    success =>
  have fields := (AspisR1.OraclePortStoredDecisionDraftC4.input_fields parsed q tr i input).left;
  have decoded :=
    Eq.mp
      (congrFun'
        (congrArg Eq
          (congrFun' (congrArg bind fields.right.left) fun __x =>
            match __x.2.1 with
            | AspisR1.TranscriptView.Value.queries (Except.ok bs) => AspisR1.LiteralQueryRead.decode bs
            | x => none))
        (some q))
      query;
  have unique := (AspisR1.LiteralQueryRead.decode_success i.queryBytes q decoded).right;
  Eq.trans
    (AspisR1.CheckpointBytes5Join.successful_stage D hash H reserved wp wa proof public1 stored tr.statement.pubBytes
      (AspisR1.OraclePortAcceptedContextC6.context parsed i v) i.data (AspisR1.SelectedChallengeMap.rhoOf i.rho) q
      caller provenance unique p a after success)
    (AspisR1.OraclePortCkptAbi5Stage.reached_stage H stored parsed q tr i v input query)
theorem AspisR1.MultiproofConeFrozen2Stage.both_batches : ∀ {X : Type}
  (D : MultiproofConeRef.aspis_core.digest.Digest32 X) (hash : X)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  (∀ (input : Aeneas.Std.Slice (Aeneas.Std.Slice Aeneas.Std.U8)),
      D.digest hash input = Aeneas.Std.Result.ok (AspisR1.MultiproofConePhysicalTransport.rawOracle H input)) →
    ∀ (p : AspisR1.OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144)
      (nodes : ℕ → ℕ → Aeneas.Std.Slice Aeneas.Std.U8),
      (∀ (b k : ℕ),
          b < 2 →
            k < 3 →
              AspisR1.MultiproofConeCanonical.bytesOf ↑(nodes b k) =
                AspisR1.OraclePortCompactDraft.slice p.wire (AspisR1.OraclePortSelectedDraft.slotStart (3 * b + k))
                  (32 * AspisR1.OraclePortSelectedDraft.capacity (3 * b + k))) →
        (∀ (s : MultiproofConeRef.reference.Scratch),
            (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.MultiproofConeFrozen2Stage.sourceBatch p q nodes 0 s)).2 =
                true →
              AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.MultiproofConeFrozen2Stage.sourceBatch p q nodes 0 s) =
                AspisV8R19.MemoizedProgramLaw.eval H
                  (AspisR1.OraclePortFrozen2.batch p q AspisR1.OraclePortFrozen2.batch0)) ∧
          ∀ (s : MultiproofConeRef.reference.Scratch),
            (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.MultiproofConeFrozen2Stage.sourceBatch p q nodes 1 s)).2 =
                true →
              AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.MultiproofConeFrozen2Stage.sourceBatch p q nodes 1 s) =
                AspisV8R19.MemoizedProgramLaw.eval H
                  (AspisR1.OraclePortFrozen2.batch p q AspisR1.OraclePortFrozen2.batch1) :=
fun {X} D hash H law p q nodes views =>
  ⟨fun s accepted =>
    AspisR1.MultiproofConeFrozen2Stage.accepted_batch D hash H law p q nodes 0 s
      (fun k hk => views 0 k (of_decide_eq_true (id (Eq.refl true))) hk) accepted,
    fun s accepted =>
    AspisR1.MultiproofConeFrozen2Stage.accepted_batch D hash H law p q nodes 1 s
      (fun k hk => views 1 k (of_decide_eq_true (id (Eq.refl true))) hk) accepted⟩
