+ let norm=ops.add(aa,bb);
+ let inv_norm=ops.inv(norm);
+ let a=ops.mul(x.a,inv_norm);
+ let nb=ops.neg(x.b);
+ let b=ops.mul(nb,inv_norm);
+ NEF_CM{a,b}
