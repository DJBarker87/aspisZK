+ fn add(&mut self,a:u32,b:u32)->u32 {self.call(1,a,b)}
+ fn inv(&mut self,a:u32)->u32 {self.call(2,a,0)}
+ fn neg(&mut self,a:u32)->u32 {self.call(3,a,0)}
