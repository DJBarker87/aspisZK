+  core::ptr::addr_of_mut!((*v.as_mut_ptr().add(i)).c0.b.0).write(kani::any());
+  core::ptr::addr_of_mut!((*v.as_mut_ptr().add(i)).c1.a.0).write(kani::any());
+  core::ptr::addr_of_mut!((*v.as_mut_ptr().add(i)).c1.b.0).write(kani::any());
