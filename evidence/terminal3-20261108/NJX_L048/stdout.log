theorem AspisR1.NJX_DigestCohort.source : ∀ (high : NQ) (o : O) (d : D),
  Canon high →
    FIw_ArrayValue.canonical o →
      dc d →
        ∃ out,
          FIq_Native.pool_v1.pair_forest_semantic_terminal.add_digest_binding
                (Array.repeat 8#usize FIq_Native.field.QM31.ZERO) high o 0#usize d false =
              ok out ∧
            FIw_ArrayValue.canonical out ∧
              ∀ (i : Fin 8),
                FIw_ArrayValue.decoded out ⟨↑i, ⋯⟩ = decode high * (decode (ocells o i) - ↑↑(dcells d i)) :=
fun high o d hh ho hd =>
  have zero := JFy_ZeroArrays.source 8#usize;
  let ⟨out, h✝⟩ :=
    WP.spec_imp_exists
      (JGa_DigestLoop.full (Array.repeat 8#usize FIq_Native.field.QM31.ZERO) high o 0#usize d false
        (of_decide_eq_true (id (Eq.refl true))) zero hh ho hd)
  let ⟨run, hout⟩ := h✝
  have v :=
    FIy_DigestBinding.value (Array.repeat 8#usize FIq_Native.field.QM31.ZERO) out high o 0#usize d false
      (of_decide_eq_true (id (Eq.refl true))) zero hh ho hd run;
  Exists.intro out
    ⟨run,
      ⟨hout, fun i =>
        Eq.mpr
          (id
            (congrArg (fun _a => _a = decode high * (decode (ocells o i) - ↑↑(dcells d i)))
              (v.right
                ⟨↑i,
                  have h := i.isLt;
                  source._proof_1 i h⟩)))
          (Eq.mpr
            (id
              (congrFun'
                (congrArg Eq
                  (Eq.trans
                    (congr
                      (congrArg HAdd.hAdd
                        (Eq.trans
                          (congrArg decode
                            (List.getElem_replicate
                              (id (Eq.refl (List.replicate (↑8#usize) FIq_Native.field.QM31.ZERO)) ▸
                                Eq.refl ↑i ▸
                                  FIw_ArrayValue.cells._proof_1 (Array.repeat 8#usize FIq_Native.field.QM31.ZERO)
                                    ⟨↑i,
                                      have h := i.isLt;
                                      source._proof_1 i h⟩)))
                          FIv_NativeValue.zero.right))
                      (congrArg (HMul.hMul (decode high))
                        (congr
                          (congrArg HSub.hSub
                            (congrArg (FIv_NativeArray.value o)
                              (Eq.trans
                                (congrFun'
                                  (congrArg HAdd.hAdd
                                    (have this := rfl;
                                    this))
                                  ↑i)
                                (zero_add ↑i))))
                          (congrArg Nat.cast
                            (ite_congr (congrFun' (congrArg And Bool.false_eq_true) (↑i = 7))
                              (fun a => Eq.refl ((↑((↑d)[↑i]?.getD 0#u32) + 1095962629) % FIw_ScalarArithmetic.P))
                              fun a => Eq.refl ↑((↑d)[↑i]?.getD 0#u32))))))
                    (zero_add
                      (decode high *
                        (FIv_NativeArray.value o ↑i -
                          ↑(if False ∧ ↑i = 7 then (↑((↑d)[↑i]?.getD 0#u32) + 1095962629) % FIw_ScalarArithmetic.P
                            else ↑((↑d)[↑i]?.getD 0#u32)))))))
                (decode high * (decode (ocells o i) - ↑↑(dcells d i)))))
            (id
              (id
                (id
                  (id
                    (have bo :=
                      Eq.mpr (id (congrArg (fun _a => ↑i < _a) o.property))
                        (have h := i.isLt;
                        ocells._proof_1 i h);
                    have bd := Eq.mpr (id (congrArg (fun _a => ↑i < _a) d.property)) i.isLt;
                    Eq.mpr
                      (id
                        (congrArg
                          (fun _a =>
                            decode high *
                                ((match _a with
                                  | some x => decode x
                                  | none => 0) -
                                  ↑(if False ∧ ↑i = 7 then
                                      (↑((↑d)[↑i]?.getD 0#u32) + 1095962629) % FIw_ScalarArithmetic.P
                                    else ↑((↑d)[↑i]?.getD 0#u32))) =
                              decode high * (decode (↑o)[↑⟨↑i, ocells._proof_2 i⟩] - ↑↑(↑d)[↑⟨↑i, dcells._proof_2 i⟩]))
                          (List.getElem?_eq_getElem bo)))
                      (Eq.mpr
                        (id
                          (congrArg
                            (fun _a =>
                              decode high *
                                  ((match some (↑o)[↑i] with
                                    | some x => decode x
                                    | none => 0) -
                                    ↑(if False ∧ ↑i = 7 then (↑(_a.getD 0#u32) + 1095962629) % FIw_ScalarArithmetic.P
                                      else ↑(_a.getD 0#u32))) =
                                decode high *
                                  (decode (↑o)[↑⟨↑i, ocells._proof_2 i⟩] - ↑↑(↑d)[↑⟨↑i, dcells._proof_2 i⟩]))
                            (List.getElem?_eq_getElem bd)))
                        (Eq.refl
                          (decode high *
                            ((match some (↑o)[↑i] with
                              | some x => decode x
                              | none => 0) -
                              ↑(if False ∧ ↑i = 7 then
                                  (↑((some (↑d)[↑i]).getD 0#u32) + 1095962629) % FIw_ScalarArithmetic.P
                                else ↑((some (↑d)[↑i]).getD 0#u32))))))))))))⟩⟩
