AspisR1.NJX_CarryRoot.source (carry : ℕ) (high : AspisR1.FIv_NativeArithmetic.NQ) (o : AspisR1.NJX_DigestCohort.O)
  (d : AspisR1.NJX_DigestCohort.D) (hh : AspisR1.FIv_NativeValue.Canon high) (ho : AspisR1.FIw_ArrayValue.canonical o)
  (hd : AspisR1.NJX_DigestCohort.dc d) :
  ∃ out,
    AspisR1.NJX_CarryRoot.reference carry high o d = Aeneas.Std.Result.ok out ∧
      AspisR1.NJX_CarryRoot.cohort carry high o d = Aeneas.Std.Result.ok out ∧
        (∀ (g : Fin 2), AspisR1.FIv_NativeValue.Canon (out g)) ∧
          if carry < 20 then
            ∃ p,
              out = p.out ∧
                AspisR1.NJX_DigestCut.Cut high (AspisR1.NJX_DigestCohort.ocells o) (AspisR1.NJX_DigestCohort.dcells d)
                  p.prepared (fun i => AspisR1.FIw_ScalarArithmetic.lifted (AspisR1.NJX_DigestCohort.dcells d i))
                  p.residual p.packed p.out out (AspisR1.NJX_DigestCut.log p) 21
          else out = AspisR1.NJX_CarryRoot.zero
