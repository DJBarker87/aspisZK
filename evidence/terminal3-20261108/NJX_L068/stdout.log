AspisR1.NJX_LeftCutRoot.source (high : AspisR1.FIv_NativeArithmetic.NQ) (o : AspisR1.NJX_DigestCohort.O)
  (d : AspisR1.NJX_DigestCohort.D) (hh : AspisR1.FIv_NativeValue.Canon high) (ho : AspisR1.FIw_ArrayValue.canonical o)
