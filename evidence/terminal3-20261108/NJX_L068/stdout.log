    AspisR1.NJX_DigestResiduals.Digest →
      AspisR1.FIv_PreparedNew.NP →
        AspisR1.NJX_DigestResiduals.Residuals →
          AspisR1.NJX_DigestResiduals.Residuals →
            (Fin 2 → AspisR1.FIv_NativeArithmetic.NQ) →
              (Fin 2 → AspisR1.FIv_NativeArithmetic.NQ) →
                (Fin 2 → AspisR1.FIv_NativeArithmetic.NQ) → AspisR1.NJX_DigestCut.Log → ℕ → Prop :=
fun high o d p lifted residual packed reply out l calls =>
  calls = 21 ∧
    l.kind 0 = 3 ∧
      l.left 0 = high ∧
        (∀ (i : Fin 8),
            l.kind (1 + 2 * ↑i) = 5 ∧
              l.left (1 + 2 * ↑i) = AspisR1.FIw_ScalarArithmetic.lifted (d i) ∧
                l.kind (2 + 2 * ↑i) = 2 ∧ l.left (2 + 2 * ↑i) = o i ∧ l.right (2 + 2 * ↑i) = lifted i) ∧
          ∀ (g : Fin 2),
            l.kind (17 + 2 * ↑g) = 6 ∧
              l.packs (17 + 2 * ↑g) = AspisR1.NJX_DigestGroups.group residual g ∧
                l.kind (18 + 2 * ↑g) = 4 ∧
                  l.caches (18 + 2 * ↑g) = AspisR1.NJB_PreparedCarrier.words p ∧
                    l.right (18 + 2 * ↑g) = packed g ∧ out g = reply g
def AspisR1.NJX_RecipientRoot.Cut : Option AspisR1.NJX_DigestCohort.D →
