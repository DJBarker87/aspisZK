  (hd : ∀ (d : AspisR1.NJX_DigestCohort.D), recipient = some d → AspisR1.NJX_DigestCohort.dc d) :
  ∃ out cache,
    AspisR1.NJX_RecipientRoot.reference recipient o high = Aeneas.Std.Result.ok out ∧
      AspisR1.NJX_RecipientRoot.cohort recipient o high = Aeneas.Std.Result.ok out ∧
        (∀ (g : Fin 2), AspisR1.FIv_NativeValue.Canon (out g)) ∧
          AspisR1.NJX_RecipientRoot.Cut recipient o high (if recipient.isSome = true then 1 else 0)
              (if recipient.isSome = true then 2 else 0) high o recipient cache (fun x => cache) out out ∧
            ∀ (d : AspisR1.NJX_DigestCohort.D),
              recipient = some d →
                ∃ p,
                  out = p.out ∧
                    FIq_Native.field.PreparedQm31Multiplier.new high = Aeneas.Std.Result.ok p.prepared ∧
                      ∀ (g : Fin 2),
                        AspisR1.NJX_RecipientBody.group p.prepared (AspisR1.NJX_DigestCohort.ocells o)
                            (AspisR1.NJX_DigestCohort.dcells d) g =
                          Aeneas.Std.Result.ok (out g)
