            AspisR1.NJX_DigestCohort.O →
              Option AspisR1.NJX_DigestCohort.D →
                Option AspisR1.FIv_PreparedNew.NP →
                  (Fin 2 → Option AspisR1.FIv_PreparedNew.NP) →
                    (Fin 2 → AspisR1.FIv_NativeArithmetic.NQ) → (Fin 2 → AspisR1.FIv_NativeArithmetic.NQ) → Prop :=
fun recipient o high news groups seenHigh seenO seenD cache seenCache child out =>
  match recipient with
  | none => news = 0 ∧ groups = 0 ∧ out = AspisR1.NJX_RecipientRoot.zero
  | some d =>
    news = 1 ∧
      groups = 2 ∧
        seenHigh = high ∧
          seenO = o ∧ seenD = some d ∧ out = child ∧ ∃ p, cache = some p ∧ ∀ (g : Fin 2), seenCache g = some p
