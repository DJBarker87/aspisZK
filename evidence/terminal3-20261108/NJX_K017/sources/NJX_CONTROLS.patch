+struct NJX_WLog{calls:usize,left:[QM31;4],right:[QM31;4],reply:[QM31;4]}
+fn NJX_w_op(a:QM31,b:QM31,l:&mut NJX_WLog)->QM31{let i=l.calls;assert!(i<4);l.calls+=1;l.left[i]=a;l.right[i]=b;l.reply[i]}
+fn NJX_initial_writes(mut initial:[QM31;16],low:QM31,domain:QM31,length:QM31,l:&mut NJX_WLog)->[QM31;16]{
