+struct NJX_ControlLog{seek:usize,calls:usize,seen:usize}
+fn NJX_enter(l:&mut NJX_ControlLog,k:usize){if l.calls==l.seek{l.seen=k;}l.calls+=1;}
+#[kani::proof] #[kani::unwind(35)]
+#[kani::stub(core::ptr::copy_nonoverlapping,KMX_copy_nonoverlapping)]
+fn NJX_range_control_cut(){
+ let seek:usize=kani::any();let cell:usize=kani::any();let limb:usize=kani::any();kani::assume(seek<30&&cell<33&&limb<4);
+ let range=[QM31::ZERO;33];let mut l=NJX_ControlLog{seek,calls:0,seen:999};let mut index=0usize;
+ while index<10{NJX_enter(&mut l,index);index+=1;}index=0;
+ while index<10{NJX_enter(&mut l,10+index);index+=1;}index=0;
+ while index<10{NJX_enter(&mut l,20+index);index+=1;}
+ assert_eq!(l.calls,30);assert_eq!(l.seen,seek);assert_eq!(index,10);assert_eq!(NJX_words(range[cell])[limb],if cfg!(NJX_invert){1}else{0});
+}
