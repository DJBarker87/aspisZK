theorem AspisR1.NJX_RecipientBody.source : ∀ {high : NQ} {o : Residuals} {d : Digest}
  (p : NJX_DigestPacket.Packet high o d), reference high o d = ok p.out :=
fun {high} {o} {d} p =>
  have vector :=
    funext fun i =>
      List.Mem.casesOn (motive := fun a x =>
        List.finRange ({ len := 1 }.len + 1) = a → Fintype.complete i ≍ x → ![p.out 0, p.out 1] i = p.out i)
        (Fintype.complete i)
        (fun «as» h =>
          List.cons.noConfusion h fun head_eq =>
            Eq.ndrec (motive := fun i =>
              ∀ (this : i ∈ Fintype.elems),
                (fun x1 x2 => (fun i => i) x1 :: x2) ⟨1, Nat.le_refl ({ len := 1 }.len + 1)⟩ [] ≍ «as» →
                  this ≍ List.Mem.head «as» → ![p.out 0, p.out 1] i = p.out i)
              (fun this tail_eq =>
                Eq.ndrec (motive := fun «as» =>
                  this ≍ List.Mem.head «as» →
                    ![p.out 0, p.out 1] ((fun i => i) ⟨0, Nat.le_of_lt (Nat.le_refl ({ len := 1 }.len + 1))⟩) =
                      p.out ((fun i => i) ⟨0, Nat.le_of_lt (Nat.le_refl ({ len := 1 }.len + 1))⟩))
                  (fun h =>
                    Eq.refl (![p.out 0, p.out 1] ((fun i => i) ⟨0, Nat.le_of_lt (Nat.le_refl ({ len := 1 }.len + 1))⟩)))
                  (eq_of_heq tail_eq))
              (eq_of_heq head_eq) (Fintype.complete i))
        (fun b {«as»} a h =>
          List.cons.noConfusion h fun head_eq =>
            Eq.ndrec (motive := fun b =>
              (fun x1 x2 => (fun i => i) x1 :: x2) ⟨1, Nat.le_refl ({ len := 1 }.len + 1)⟩ [] ≍ «as» →
                Fintype.complete i ≍ List.Mem.tail b a → ![p.out 0, p.out 1] i = p.out i)
              (fun tail_eq =>
                Eq.ndrec (motive := fun {«as»} =>
                  ∀ (a : List.Mem i «as»),
                    Fintype.complete i ≍
                        List.Mem.tail ((fun i => i) ⟨0, Nat.le_of_lt (Nat.le_refl ({ len := 1 }.len + 1))⟩) a →
                      ![p.out 0, p.out 1] i = p.out i)
                  (fun a h =>
                    List.Mem.casesOn (motive := fun a_1 x =>
                      (fun x1 x2 => (fun i => i) x1 :: x2) ⟨1, Nat.le_refl ({ len := 1 }.len + 1)⟩ [] = a_1 →
                        a ≍ x → ![p.out 0, p.out 1] i = p.out i)
                      a
                      (fun «as» h =>
                        List.cons.noConfusion h fun head_eq =>
                          Eq.ndrec (motive := fun i =>
                            ∀
                              (a :
                                List.Mem i
                                  ((fun x1 x2 => (fun i => i) x1 :: x2) ⟨1, Nat.le_refl ({ len := 1 }.len + 1)⟩ [])),
                              [] ≍ «as» → a ≍ List.Mem.head «as» → ![p.out 0, p.out 1] i = p.out i)
                            (fun a tail_eq =>
                              Eq.ndrec (motive := fun «as» =>
                                a ≍ List.Mem.head «as» →
                                  ![p.out 0, p.out 1] ((fun i => i) ⟨1, Nat.le_refl ({ len := 1 }.len + 1)⟩) =
                                    p.out ((fun i => i) ⟨1, Nat.le_refl ({ len := 1 }.len + 1)⟩))
                                (fun h =>
                                  Eq.refl (![p.out 0, p.out 1] ((fun i => i) ⟨1, Nat.le_refl ({ len := 1 }.len + 1)⟩)))
                                (eq_of_heq tail_eq))
                            (eq_of_heq head_eq) a)
                      (fun b {«as»} a_1 h =>
                        List.cons.noConfusion h fun head_eq =>
                          Eq.ndrec (motive := fun b =>
                            [] ≍ «as» → a ≍ List.Mem.tail b a_1 → ![p.out 0, p.out 1] i = p.out i)
                            (fun tail_eq =>
                              Eq.ndrec (motive := fun {«as»} =>
                                ∀ (a_2 : List.Mem i «as»),
                                  a ≍ List.Mem.tail ((fun i => i) ⟨1, Nat.le_refl ({ len := 1 }.len + 1)⟩) a_2 →
                                    ![p.out 0, p.out 1] i = p.out i)
                                (fun a_2 h =>
                                  List.Mem.casesOn (motive := fun a x =>
                                    [] = a → a_2 ≍ x → ![p.out 0, p.out 1] i = p.out i) a_2
                                    (fun «as» h => False.elim (noConfusion_of_Nat List.ctorIdx h))
                                    (fun b {«as»} a h => False.elim (noConfusion_of_Nat List.ctorIdx h)) (Eq.refl [])
                                    (HEq.refl a_2))
                                (eq_of_heq tail_eq) a_1)
                            (eq_of_heq head_eq))
                      (Eq.refl ((fun x1 x2 => (fun i => i) x1 :: x2) ⟨1, Nat.le_refl ({ len := 1 }.len + 1)⟩ []))
                      (HEq.refl a))
                  (eq_of_heq tail_eq) a)
              (eq_of_heq head_eq))
        (Eq.refl (List.finRange ({ len := 1 }.len + 1))) (HEq.refl (Fintype.complete i));
  of_eq_true
    (Eq.trans
      (congrFun'
        (congrArg Eq
          (Eq.trans
            (Eq.trans
              (congrFun' (congrArg Bind.bind p.constructor) fun cache => do
                let x ← group cache o d 0
                let y ← group cache o d 1
                ok ![x, y])
              (bind_tc_ok p.prepared fun y => do
                let x ← group y o d 0
                let y ← group y o d 1
                ok ![x, y]))
            (Eq.trans
              (Eq.trans
                (congr (congrArg Bind.bind (group_source p 0))
                  (funext fun x =>
                    Eq.trans (congrFun' (congrArg Bind.bind (group_source p 1)) fun y => ok ![x, y])
                      (bind_tc_ok (p.out 1) fun y => ok ![x, y])))
                (bind_tc_ok (p.out 0) fun y => ok ![y, p.out 1]))
              (congrArg ok vector))))
        (ok p.out))
      (eq_self (ok p.out)))
'AspisR1.NJX_RecipientBody.group_source' depends on axioms: [propext, Classical.choice, Quot.sound]
'AspisR1.NJX_RecipientBody.source' depends on axioms: [propext, Classical.choice, Quot.sound]
