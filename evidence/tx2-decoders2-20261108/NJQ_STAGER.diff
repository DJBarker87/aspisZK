+def njq_options(args, workspace, out):
+    # Additive selector: use the actual frozen statement crate so root locality is retained.
+    from types import SimpleNamespace
+    old = SimpleNamespace(function='nji_tx2_decoders',opacity=args.opacity)
+    pin = options(old,workspace,out)
+    cmd = pin['charon_command']
+    root = 'aspis_statement::pool_v1::format::decode_pool_identity_v1'
+    cmd[cmd.index('--dest-file'):cmd.index('--dest-file')] = ['--start-from',root]
+    idx = cmd.index('--manifest-path')+1
+    cmd[idx] = str(workspace/'crates/aspis-statement/Cargo.toml')
+    graph = json.loads((out/'NHR_GRAPH_CHECK.json').read_text())
+    features = next(x['features'] for x in graph['features'] if x['name']=='aspis-statement')
+    cmd[cmd.index('--features')+1] = ','.join(features)
+    # Identity is in scope and must be emitted; other CLOSED children remain opaque.
+    i = cmd.index('aspis_statement::pool_v1::format::decode_pool_identity_v1',cmd.index('--opaque'))
+    del cmd[i-1:i+1]
+    pin['opacity'] = [x for x in pin['opacity'] if not x['path'].endswith('decode_pool_identity_v1')]
+    for selector in ['core::iter::traits::iterator::Iterator::any','core::slice::iter::_::any','core::slice::iter::_::next']:
+        cmd[cmd.index('--dest-file'):cmd.index('--dest-file')] = ['--opaque',selector]
+        pin['opacity'].append(dict(path=selector,selector=selector,why='NJQ rule-3 library boundary under (au)(3)'))
+    for token in ['-namespace','-subdir']:
+        pin['aeneas_command'][pin['aeneas_command'].index(token)+1] = 'NJQ_Extracted'
+    cmd[cmd.index('--dest-file')+1] = str(out/'njq_tx2_decoders.llbc')
+    pin['aeneas_command'][-1] = str(out/'njq_tx2_decoders.llbc')
+    pin['statement_features'] = features
+    return pin
