+fn view(p:&VerifierRegistryEntryV1,f:usize,i:usize)->u64{match f{0=>p.status as u8 as u64,1=>p.statement_version as u64,2=>p.bump as u64,3=>p.pool[i] as u64,4=>p.verifier_program[i] as u64,5=>p.profile_binding[i] as u64,6=>p.release_binding[i] as u64,7=>p.activation_slot,8=>p.retirement_slot,_=>p.policy_binding[i] as u64}}
+pub(super) fn matches_reference(b:&[u8],out:&Result<VerifierRegistryEntryV1,PoolV1VerifierRegistryFormatError>)->bool {
+ let f:usize=kani::any();kani::assume(f<10);let i:usize=kani::any();kani::assume(i<32);
+ match (out,decode_ref(b)){(Ok(p),Ok(q))=>view(p,f,i)==view(&q,f,i),(Err(e),Err(f))=>e==&f,_=>false}
+}
