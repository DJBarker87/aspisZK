+pub(super) fn check_head(b:&[u8],out:&Result<VerifierRegistryEntryV1,PoolV1VerifierRegistryFormatError>)->bool{
+ type F=PoolV1VerifierRegistryFormatError;
+ if b[..4]!=POOL_V1_VERIFIER_ENTRY_MAGIC {matches!(out,Err(F::WrongMagic))}
+ else if b[4]!=POOL_V1_VERIFIER_ENTRY_VERSION {matches!(out,Err(F::WrongVersion))}
+ else if b[184..192]!=[0;8] {matches!(out,Err(F::NonZeroReserved))}
+ else {!matches!(out,Err(F::WrongLength|F::WrongMagic|F::WrongVersion|F::NonZeroReserved))}
