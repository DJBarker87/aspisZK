theorem NJQ_EntryCut.native_source : ∀ (b : Slice U8) (len : (↑b).length = 192) (log : Option E)
  (out : core.result.Result E F), Cut b len (closedReply b len) log out → ok out = NJQ_Entry.reference b :=
fun b len log out cut =>
  Eq.mpr (id (congrArg (fun _a => ok out = _a) (NJQ_Entry.source b)))
    (Eq.mpr (id (congrArg (fun _a => ok out = _a) (body_closed b len)))
      (congrArg ok (cut_result b len (closedReply b len) log out cut)))
