+pub(super) fn header_ok(b:&[u8])->bool {b.len()==128 && b[..4]==POOL_V1_VERIFIER_REGISTRY_MAGIC && b[4]==POOL_V1_VERIFIER_REGISTRY_VERSION && b[7]==0 && b[120..128]==[0;8]}
+fn header_error(b:&[u8])->Option<PoolV1VerifierRegistryFormatError>{
