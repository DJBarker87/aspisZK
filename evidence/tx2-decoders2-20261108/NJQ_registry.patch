+fn view(p:&VerifierRegistryV1,f:usize,i:usize)->u64{match f{0=>p.flags as u64,1=>p.bump as u64,2=>p.pool[i] as u64,3=>p.authority[i] as u64,4=>p.policy_binding[i] as u64,5=>p.generation,_=>p.minimum_activation_delay_slots}}
+pub(super) fn matches_reference(b:&[u8],out:&Result<VerifierRegistryV1,PoolV1VerifierRegistryFormatError>)->bool {
+ let f:usize=kani::any();kani::assume(f<7);let i:usize=kani::any();kani::assume(i<32);
+ match (out,decode_ref(b)){(Ok(p),Ok(q))=>view(p,f,i)==view(&q,f,i),(Err(e),Err(f))=>e==&f,_=>false}
+}
