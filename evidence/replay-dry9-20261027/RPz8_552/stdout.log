def AspisR1.ARQ_WorldSupport.Supported : {W A C : Type} →
  {Tx : Type} →
    Library W (ℕ → Record) →
      (Heap (ℕ → Record) → ℕ → Payload → S2W_TrustedStd.Outcome (ℕ → Record)) →
        Allocator A →
          DrvC_Installation.Configuration FIo_Install.W C →
            C →
              NP6_StdModel.Reservation →
                S2W_ExtractionBoundary.First →
                  S2W_ExtractionBoundary.Second →
                    (SdkC_Source.Parts → Result SdkC_Source.Digest) → Adversary A → Prop :=
fun {W A C Tx} L copy allocator c err r native1 native2 hashv a =>
  ∀ (H : Bytes → State),
    accepted (eval H (account (FIp_Install.configuration err c r) hashv copy allocator CPH_Program.verifier a)).2 =
        true →
      Nonempty (NativeAt L copy allocator c err r native1 native2 hashv a H)
