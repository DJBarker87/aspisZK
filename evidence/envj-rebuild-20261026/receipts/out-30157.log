@R0P.SemBadSets.univariate_bad_card : ∀ {K : Type} [inst : Field K] [inst_1 : Fintype K] (p : Polynomial K),
  p ≠ 0 → ∀ (d : ℕ), p.natDegree ≤ d → {x | Polynomial.eval x p = 0}.card ≤ d
@R0P.SemBadSets.round_bad_union_card : ∀ {K : Type} [inst : Fintype K] {n d : ℕ} (bad : Fin n → Finset K),
  (∀ (i : Fin n), (bad i).card ≤ d) → Fintype.card { α // ∃ i, α i ∈ bad i } ≤ n * d * Fintype.card K ^ (n - 1)
@R0P.SemBadSets.sumcheck_rounds_bad : ∀ {K : Type} [inst : Field K] [inst_1 : Fintype K] {n d : ℕ}
  (p : Fin n → Polynomial K),
  (∀ (i : Fin n), p i ≠ 0) →
    (∀ (i : Fin n), (p i).natDegree ≤ d) →
      Fintype.card { α // ∃ i, Polynomial.eval (α i) (p i) = 0 } ≤ n * d * Fintype.card K ^ (n - 1)
@R0P.SemBadSets.zerocheck_bad : ∀ {K : Type} [inst : Field K] [inst_1 : Fintype K] {n : ℕ} (p : MvPolynomial (Fin n) K),
  p ≠ 0 →
    (∀ (i : Fin n), MvPolynomial.degreeOf i p ≤ 1) →
      Fintype.card { z // (MvPolynomial.eval z) p = 0 } ≤ n * Fintype.card K ^ (n - 1)
@R0P.SemBadSets.product_difference_coeff : ∀ {K : Type} [inst : Field K] (S T : Multiset (Polynomial K)),
  S ≠ T →
    (∀ q ∈ S, q.natDegree ≤ 16) →
      (∀ q ∈ T, q.natDegree ≤ 16) →
        (Multiset.map (fun q => Polynomial.X - Polynomial.C q) S).prod ≠
            (Multiset.map (fun q => Polynomial.X - Polynomial.C q) T).prod ∧
          ∃ j,
            ((Multiset.map (fun q => Polynomial.X - Polynomial.C q) S).prod -
                      (Multiset.map (fun q => Polynomial.X - Polynomial.C q) T).prod).coeff
                  j ≠
                0 ∧
              (((Multiset.map (fun q => Polynomial.X - Polynomial.C q) S).prod -
                        (Multiset.map (fun q => Polynomial.X - Polynomial.C q) T).prod).coeff
                    j).natDegree ≤
                16 * max S.card T.card
