  R0P.SemBadSets.MLDeg d n G → R0P.SemBadSets.MLDeg e n H → R0P.SemBadSets.MLDeg (max d e) n fun v => G v + H v
@R0P.SemBadSets.mlDeg_mul : ∀ {K : Type} [inst : Field K] {d e n : ℕ} {G H : (Fin n → K) → K},
  R0P.SemBadSets.MLDeg d n G → R0P.SemBadSets.MLDeg e n H → R0P.SemBadSets.MLDeg (d + e) n fun v => G v * H v
@R0P.SemBadSets.mlDeg_smul : ∀ {K : Type} [inst : Field K] {d n : ℕ} {G : (Fin n → K) → K} (c : K),
