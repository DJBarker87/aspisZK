@R0P.SemBadSets.badMu_card : ∀ {K : Type} [inst : Field K] [inst_1 : Fintype K] [DecidableEq K] (a s1 s2 : K),
  {μ | R0P.Sumcheck.BadMu a s1 s2 μ}.card ≤ 2
@R0P.SemBadSets.badTheta_card : ∀ {K : Type} [inst : Field K] [inst_1 : Fintype K] [DecidableEq K]
  (lanes : Fin 29 → (Fin 10 → Bool) → K), {θ | R0P.Sumcheck.BadTheta lanes θ}.card ≤ 28
@R0P.SemBadSets.mle_bad_card : ∀ {K : Type} [inst : Field K] [inst_1 : Fintype K] [inst_2 : DecidableEq K] (n : ℕ)
  (f : (Fin n → Bool) → K), f ≠ 0 → {z | R0P.Sumcheck.mle n f z = 0}.card ≤ n * Fintype.card K ^ (n - 1)
@R0P.SemBadSets.badZc_card : ∀ {K : Type} [inst : Field K] [inst_1 : Fintype K] [DecidableEq K]
  (f : (Fin 10 → Bool) → K), {z | R0P.Sumcheck.BadZc f z}.card ≤ 10 * Fintype.card K ^ 9
@R0P.SemBadSets.badAlpha_strategy : ∀ {K : Type} [inst : Field K] [inst_1 : Fintype K] (G : (Fin 10 → K) → K)
  (strat : (i : Fin 10) → (Fin ↑i → K) → Polynomial K),
  R0P.Sumcheck.IndDeg 27 10 G →
    {α |
          R0P.Sumcheck.accept 27 10 G 0 (fun i => strat i fun j => α (Fin.castLE ⋯ j)) α ∧
            R0P.Sumcheck.bsum 10 G ≠ 0}.card ≤
      10 * 27 * Fintype.card K ^ 9
