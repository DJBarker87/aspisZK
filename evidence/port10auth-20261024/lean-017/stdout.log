                (↑lo = if batch = 0 then 0 else 10) →
                  pos < n →
                    ∀ (room : ↑s.n < 16),
                      keys.index_usize pos =
                          Aeneas.Std.Result.ok (AspisR1.MultiproofConeSortOrder.packed q batch (↑kind) selected) →
                        ∀ (out : Aeneas.Std.ControlFlow AspisR1.Port9OR_BatchStep.Next AspisR1.Port9OR_BatchStep.Out),
                          AspisR1.CheckpointBytes5Effect.erase D hash
