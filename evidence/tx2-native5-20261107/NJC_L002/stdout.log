NHT_EmittedCommon.tx2_common (ops : VTop_Stages.Ops) {H : Type}
  (aspis_coredigestDigest32Inst : VTop_Stages.aspis_core.digest.Digest32 H)
  (public_bytes proof checkpoint : Aeneas.Std.Slice Aeneas.Std.U8) (hash : H)
  (obs : Option (VTop_Stages.verifier.Phase → Aeneas.Std.Result Unit)) :
  Aeneas.Std.Result (Aeneas.Std.core.result.Result Unit VTop_Stages.verifier.Error)
NFQ_Transport.final_len_reference (v : NFQ_Transport.V) :
  NFQ_Reference.final_len_ref (NFQ_Transport.code v) = AspisR1.CheckpointBytes4Ops.finalLen (NFQ_Transport.port v)
NFQ_Transport.checkpoint_size_reference (v : NFQ_Transport.V) :
  NFQ_Reference.checkpoint_size_ref (NFQ_Transport.code v) =
    AspisR1.CheckpointBytes4Ops.checkpointSize (NFQ_Transport.port v)
NET_WideModel.result (bytes : Aeneas.Std.Slice Aeneas.Std.U8) :
  NET_WideModel.wide bytes = FIo_Native.aspis_core.field.wide_exact.WideExact.from_le_bytes bytes
AspisR1.NFS_QueryLoopRoot.root (base : AspisR1.Port3_NativeQueryBody.Ops) (proof : Aeneas.Std.Slice Aeneas.Std.U8)
  (p : AspisR1Stage2.verifier.Prepared) (g : Aeneas.Std.Array AspisR1.NFP_QueryCuts.E 29#usize)
  (geometry : AspisR1Stage2.verifier.QueryGeometry) (qPlace gPlace start : ℕ) (finish : Aeneas.Std.Usize)
  (limit : ↑finish ≤ 22) (canonical : NEV_DotInputs.Canonical (AspisR1.FIp_DotsAdapter.toArray g)) (fuel : ℕ)
  (state : AspisR1.NFG_QueryLoopDefs.State) (valid : AspisR1.NFS_QueryLoopRoot.Valid p start (↑finish) state)
  (budget : AspisR1.NFG_QueryLoopDefs.Budget finish fuel state) :
  AspisR1.NFG_QueryLoopDefs.run (AspisR1.NFS_QueryLoopRoot.child base proof p g geometry qPlace gPlace) finish fuel
      state =
    AspisR1.Port3_NativeQueryBody.verifier.candidate.query_loop_loop (AspisR1.NFS_QueryOps.installed base) state proof p
      g none geometry finish
NFN_NFB_GeometryComposed.result_state_effects {State Event : Type} (queries : Aeneas.Std.Array Aeneas.Std.U32 22#usize)
  (start finish : Aeneas.Std.Usize) (state : State) :
  NEB_PureFrame.run state
      (AspisR1.Port3_QueryInstall.result
        (AspisR1PublicPreparation.RawExtractedSemanticCallOpsV20.resultMap NFN_NEW_GeometryRawInterface.answer
          (NEW_GeometryActual.verifier.QueryGeometry.for_range queries start finish))) =
    NEB_PureFrame.run state
      (AspisR1.Port3_GeometryStage.geometry NFN_NEW_GeometryDictionary.adopted queries start finish)
NIG_FilledCoverage.source (reservation : AspisR1.NP6_StdModel.Reservation) :
  AspisR1.FIo_FieldBridge.map NHM_Filled64.reply
      (FIo_Native.aspis_core.r0.heap.filled FIo_Native.aspis_core.field.QM31.Insts.CoreMarkerCopy 64#usize
        NHX_FilledZero.zeroQ) =
    NHI_FilledRef.filled_ref 64#usize (NHI_WordEncoding.words NHX_FilledZero.zeroQ)
NFN_NEO_TailReference.checked {C : Type} (error : C) (u : Aeneas.Std.Usize) :
  NFN_NEB_GeometryIndices.indexPort error u = do
    let r ← NEO_TailRef.checked u
    Aeneas.Std.Result.ok
        (match r with
        | Aeneas.Std.core.result.Result.Ok x => Aeneas.Std.core.result.Result.Ok x
        | Aeneas.Std.core.result.Result.Err a => Aeneas.Std.core.result.Result.Err error)
NFN_NEO_TailReference.opening (proof : Aeneas.Std.Slice Aeneas.Std.U8) (i : Aeneas.Std.Usize) :
  NEO_TailRef.opening proof i = AspisR1.Port4B_Opening.opening proof i
