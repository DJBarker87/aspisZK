def AspisR1.NLZ_Interface.RowSpec_137 : (NLJ_Observed.Input Unit → Heap → Observation137) → Prop :=
fun native =>
  ∀ (i : NLJ_Observed.Input Unit) (h : Heap),
    have o := native i h;
    o.initialHeap = h ∧
      View h o.inputWindow ↑i.bytes ∧
        NLJ_Observed.Invocation 6 (NLJ_Observed.initial i) o.reply o.log o.events ∧
          PreparedHashCode.run
              (S1SemanticCode.verify
                (fun {H} => S1SemanticCode.finish NJM_RoundJoin.R (IDa_Deployed.boundaries i.reservation)) i.digest
                i.publicValue i.bytes i.hash none) =
            (o.log, o.reply)
