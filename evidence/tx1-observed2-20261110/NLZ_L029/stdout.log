'AspisR1.NLZ_AdmissionCorrection.no_view_empty' does not depend on any axioms
theorem AspisR1.NLZ_AdmissionCorrection.no_view_empty : ∀ (window : Window) (bytes : List U8),
  ¬View empty window bytes :=
fun window bytes view =>
  let ⟨o, h✝⟩ := view
  let ⟨found, right✝⟩ := h✝
  id
    (fun found =>
      let ⟨⟩ := some o
      found)
    found
