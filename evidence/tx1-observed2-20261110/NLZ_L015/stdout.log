theorem AspisR1.NHS_PreparedPacket.source : ∀ (B : FinishModel.Boundaries)
  (hashv : AspisR1.SdkC_Source.Parts → Result AspisR1.SdkC_Source.Digest)
  (pub : pool_v1.pair_forest_semantic_terminal.r0.Public) (pre : r1_wire.Prefix)
  (beforeSemantic : r1_wire.SemanticTranscript Unit) (challenges : r1_wire.Challenges)
  (obs : Option (RPz7_PhaseIso.Phase → Result Unit)) (sem : r1_semantic.Verified Unit),
  FinishModel.finish AspisS1ExtractedRoundChildren.children
        { fromFn := @FinishModel.Boundaries.fromFn B, mask := B.mask, add := B.add, mul := B.mul,
          terminal := B.terminal, circle := B.circle, unwrapRoot := B.unwrapRoot,
          claims := AspisR1.ClaimsUnrolledFinish.claims (AspisR1.NP6_StdModel.calls (core.result.Result.Ok ())) }
        (AspisR1.NGQ_Effects.dictionary hashv) pub pre beforeSemantic challenges obs =
      ok (core.result.Result.Ok sem) →
    ∀ (compact before y1 : Slice U8),
      (↑compact).length = 464 →
        (↑before).length = 928 →
          NFU_Retarget.compact.check_values compact = ok (core.result.Result.Ok ()) →
            NFU_Retarget.LPn.Expand.NativeTrace (↑compact) (↑before) 29 ↑y1 →
              ∀ (v : verifier.View) (hash : Unit) (old : AspisR1.NFW_PreparedControl.Scratch)
                (packet : AspisR1.NHL_OpeningPacket.Packet (AspisR1.NGQ_Effects.dictionary hashv) sem v hash),
                v.y1 = y1 →
                  AspisR1.NFN_LPi_FieldValues.canonE (AspisR1.NFW_SampledDomains.toNative v.inactive) →
                    ∀ (qs : Std.Array U32 22#usize) (afterQueries : transcript.Transcript Unit)
                      (observed : AspisR1.NGP_L181.Observation AspisR1.NGQ_Effects.Reply),
                      AspisR1.NHK_Invocation.Cuts hashv packet.opening.transcript packet.opening.row v.final_message
                          observed →
                        observed.result = ok (core.result.Result.Ok qs, afterQueries) →
                          ∀
                            (rhoBlock :
                              AspisR1.NGT_NBL_BlockTrace.Block (AspisR1.NGQ_Effects.dictionary hashv) afterQueries
                                (AspisR1.NHL_OpeningPacket.nextRow packet.opening)
                                PreparedScratchReachability.emptyPayload)
                            (rho : aspis_core.field.QM31) (rhoReduction : AspisR1.NGT_Reduction.K rhoBlock.value rho),
                            ∃ g out,
                              FIo_Native.weights.powers 29#usize
                                    (AspisR1.NFW_SampledDomains.toNative packet.opening.gamma) =
                                  ok g ∧
                                AspisR1.NFN_LPi_FieldValues.canonE out ∧
                                  AspisR1.NGN_Emitted.prepared AspisR1.NHL_PreparedScalars.actual
                                      (AspisR1.NGQ_Effects.dictionary hashv) sem v hash old =
                                    ok
                                      (core.result.Result.Ok
                                          (PreparedScratchReachability.output sem v packet.opening.gamma
                                            packet.opening.kappa packet.opening.alpha rho qs
                                            (AspisR1.NFW_PowersCohort.toPublic out)
                                            { state := rhoBlock.final, hash := afterQueries.hash }),
                                        AspisR1.NFW_PowersCohort.mapArray AspisR1.NFW_PowersCohort.toPublic g) :=
⋯
