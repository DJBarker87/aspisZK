def AspisR1.NLZ_Interface.RowSpec_087 : NLJ_Prepare.Configuration →
  (NLJ_Prepare.Input Unit → Heap → Window → Observation087) → Prop :=
fun cfg native =>
  ∀ (i : NLJ_Prepare.Input Unit) (h : Heap) (window : Window),
    (↑i.proof).length = 57607 →
      View h window ↑i.proof →
        have o := native i h window;
        o.initialHeap = h ∧
          o.proofWindow = window ∧
            NLJ_Prepare.Invocation cfg 12 (NLJ_Prepare.initial i) o.reply o.log o.events ∧
              PreparedHashCode.run
                  (SdkD_PrepareSource.code cfg.base cfg.boundaries cfg.std i.digest i.publicValue i.proof i.hash
                    i.scratch) =
                (o.log, o.reply)
