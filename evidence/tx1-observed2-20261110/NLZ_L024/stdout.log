'AspisR1.NLZ_PrepareDomainTransport.compact' depends on axioms: [propext, Classical.choice, Quot.sound]
'AspisR1.NLZ_PrepareDomainTransport.transport' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLZ_PrepareDomainTransport.compact : ∀ (i : NLJ_Prepare.Input Unit),
  NLZ_PrepareOwnDomain.Domain i →
    (↑(NLZ_PrepareOwnDomain.compact i)).length = 464 ∧
      NFU_Retarget.compact.check_values (NLZ_PrepareOwnDomain.compact i) = ok (core.result.Result.Ok ()) :=
fun i own => ⟨NLZ_PrepareOwnDomain.compact_width i own.proofLength, own.compactCanonical⟩
