{"charon_version":"0.1.223","translated":{"crate_name":"pv_cbm_source","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":["--cfg=kani","--cfg=pv_cb_extract"],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["pv_cbm_source::r0::encoder::eval_message"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["pv_cbm_source::r0::encoder::*"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-pv-cbmid-20261027/PV_CBM_Op79Raw.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"/home/dombarker/project-offloads/codex-pv-cb3-20261026/source/crates/aspis-core/src/r0/encoder.rs"},"crate_name":"pv_cbm_source","contents":"//! SPEC §§3–4: direct evaluators of natural-coefficient messages.\n\nuse super::{\n    basis,\n    domain::{self, FibreIndex, InitialIndex, Point},\n    CodeField, FinalMessage, Message,\n};\n\n/// SPEC §3: evaluations of (p0_q,p1_q) at x in O(512) field operations.\npub fn eval_pair<E: CodeField>(q: &Message<E>, x: E) -> (E, E) {\n    let basis = basis::values::<E, 512>(x);\n    let mut p0 = E::ZERO;\n    let mut p1 = E::ZERO;\n    for (pair, n) in q.chunks_exact(2).zip(basis) {\n        p0 = p0.add(pair[0].mul(n));\n        p1 = p1.add(pair[1].mul(n));\n    }\n    (p0, p1)\n}\npub fn p0_q<E: CodeField>(q: &Message<E>, x: E) -> E {\n    eval_pair(q, x).0\n}\npub fn p1_q<E: CodeField>(q: &Message<E>, x: E) -> E {\n    eval_pair(q, x).1\n}\n\n/// SPEC §3: evalMessage(q,(x,y))=p0_q(x)+y*p1_q(x), including OOD.\npub fn eval_message<E: CodeField>(q: &Message<E>, z: Point<E>) -> E {\n    let (p0, p1) = eval_pair(q, z.x);\n    p0.add(z.y.mul(p1))\n}\n/// SPEC §3: Enc(q)[i]; a word is represented by its pointwise evaluator.\npub fn exact_initial_encoder<E: CodeField>(q: &Message<E>, i: InitialIndex) -> E {\n    eval_message(q, domain::stored_point(i))\n}\n/// SPEC §4: Σ_d F[d]*N_d(line_node(u)), with 256 natural coefficients.\npub fn exact_final_encoder<E: CodeField>(q: &FinalMessage<E>, u: FibreIndex) -> E {\n    q.iter()\n        .zip(basis::values::<E, 256>(domain::line_node(u)))\n        .fold(E::ZERO, |sum, (&coefficient, n)| {\n            sum.add(coefficient.mul(n))\n        })\n}\n"},{"id":1,"name":{"Local":"lib.rs"},"crate_name":"pv_cbm_source","contents":"//! cfg(kani) extraction context; all source modules are unedited and hash-pinned.\nextern crate alloc;\n#[cfg(kani)]\npub use aspis_core::field;\n#[cfg(kani)]\npub use aspis_statement::trace_v4;\n#[cfg(kani)]\npub mod pool_v1 {\n    pub use aspis_statement::pool_v1::*;\n    #[path = \"/home/dombarker/project-offloads/codex-pv-cb3-20261026/source/crates/aspis-statement/src/pool_v1/pair_forest_hiding.rs\"]\n    pub mod hiding;\n}\n#[cfg(kani)]\npub mod r0 {\n    pub use aspis_core::r0::*;\n    #[path = \"/home/dombarker/project-offloads/codex-pv-cb3-20261026/source/crates/aspis-core/src/r0/encoder.rs\"]\n    pub mod encoder;\n    #[path = \"/home/dombarker/project-offloads/codex-pv-cb3-20261026/source/crates/aspis-core/src/r0/basis.rs\"]\n    pub mod basis;\n}\n"},{"id":2,"name":{"Local":"/home/dombarker/project-offloads/codex-pv-cb3-20261026/source/crates/aspis-core/src/r0/scalar.rs"},"crate_name":"aspis_core","contents":null},{"id":3,"name":{"Local":"/home/dombarker/project-offloads/codex-pv-cb3-20261026/source/crates/aspis-core/src/r0/mod.rs"},"crate_name":"aspis_core","contents":null},{"id":4,"name":{"Local":"/home/dombarker/project-offloads/codex-pv-cb3-20261026/source/crates/aspis-core/src/lib.rs"},"crate_name":"aspis_core","contents":null},{"id":5,"name":{"Local":"/home/dombarker/project-offloads/codex-pv-cb3-20261026/source/crates/aspis-core/src/r0/domain.rs"},"crate_name":"aspis_core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/home/dombarker/project-offloads/codex-pv-cb3-20261026/source/crates/aspis-core/src/field.rs"},"crate_name":"aspis_core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/iter/adapters/zip.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/iter/adapters/mod.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/iter/mod.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/slice/iter.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/array/iter.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"/home/dombarker/project-offloads/codex-pv-cb3-20261026/source/crates/aspis-core/src/r0/basis.rs"},"crate_name":"pv_cbm_source","contents":"//! SPEC §3: Chebyshev-product natural basis and coefficient conversions.\n\nuse super::{CodeField, Error};\nuse crate::field::M31;\nuse alloc::vec::Vec;\n\n/// SPEC §3: evaluate D_b, with D_0=X, D_(b+1)=2 D_b²−1.\npub fn doubled_factor<E: CodeField>(b: usize, x: E) -> E {\n    let mut d = x;\n    for _ in 0..b {\n        d = double(d);\n    }\n    d\n}\n\npub(crate) fn double<E: CodeField>(x: E) -> E {\n    let square = x.mul(x);\n    square.add(square).sub(E::ONE)\n}\n\n/// SPEC §3: evaluate N_j=∏_{b in bits(j)} D_b (including N_0=1).\npub fn natural<E: CodeField>(mut j: usize, x: E) -> E {\n    let mut factor = x;\n    let mut out = E::ONE;\n    while j != 0 {\n        if j & 1 != 0 {\n            out = out.mul(factor);\n        }\n        j >>= 1;\n        if j != 0 {\n            factor = double(factor);\n        }\n    }\n    out\n}\n\npub(crate) fn values<E: CodeField, const N: usize>(x: E) -> [E; N] {\n    let mut out = [E::ONE; N];\n    let mut width = 1;\n    let mut factor = x;\n    while width < N {\n        for j in 0..width.min(N - width) {\n            out[width + j] = out[j].mul(factor);\n        }\n        width *= 2;\n        factor = double(factor);\n    }\n    out\n}\n\n/// The only two conversion sizes in SPEC §3.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum BasisSize {\n    Initial,\n    Final,\n}\n\nimpl BasisSize {\n    pub const fn len(self) -> usize {\n        match self {\n            Self::Initial => 512,\n            Self::Final => 256,\n        }\n    }\n    pub const fn is_empty(self) -> bool {\n        false\n    }\n}\n\n/// SPEC §3: M_n[d,j]=[X^d]N_j and M_n⁻¹, in row-major order.\n///\n/// Entries lie in F; application embeds them into any CodeField. Generation\n/// uses D's polynomial recurrence, then triangular back-substitution. No\n/// elimination in E or huge stack-resident matrix is needed. Retain/reuse this\n/// object across chord operations (M_512 and its inverse take 2 MiB total).\npub struct NaturalBasis {\n    size: BasisSize,\n    matrix: Vec<M31>,\n    inverse: Vec<M31>,\n}\n\nfn zero_vec(len: usize) -> Result<Vec<M31>, Error> {\n    let mut result = Vec::new();\n    result\n        .try_reserve_exact(len)\n        .map_err(|_| Error::Allocation)?;\n    result.resize(len, M31::ZERO);\n    Ok(result)\n}\n\nimpl NaturalBasis {\n    /// SPEC §3: generate M_512/M_256 and their inverses from the recurrence.\n    pub fn new(size: BasisSize) -> Result<Self, Error> {\n        let n = size.len();\n        let mut matrix = zero_vec(n * n)?;\n        let mut inverse = zero_vec(n * n)?;\n        let mut d = zero_vec(n)?;\n        let mut next = zero_vec(n)?;\n        matrix[0] = M31::ONE;\n        d[1] = M31::ONE;\n        let mut width = 1;\n        while width < n {\n            // N_(width+j)=D_log2(width)*N_j, for j<width.\n            for j in 0..width {\n                for k in 0..=width {\n                    if d[k] == M31::ZERO {\n                        continue;\n                    }\n                    for t in 0..=j {\n                        let old = matrix[t * n + j];\n                        if old != M31::ZERO {\n                            let index = (k + t) * n + width + j;\n                            matrix[index] = matrix[index].add(d[k].mul(old));\n                        }\n                    }\n                }\n            }\n            width *= 2;\n            if width < n {\n                next.fill(M31::ZERO);\n                for k in 0..=width / 2 {\n                    if d[k] == M31::ZERO {\n                        continue;\n                    }\n                    for t in 0..=width / 2 {\n                        next[k + t] = next[k + t].add(d[k].mul(d[t]).double());\n                    }\n                }\n                next[0] = next[0].sub(M31::ONE);\n                core::mem::swap(&mut d, &mut next);\n            }\n        }\n        for j in 0..n {\n            let diagonal =\n                <M31 as CodeField>::try_inv(matrix[j * n + j]).ok_or(Error::ZeroDenominator)?;\n            inverse[j * n + j] = diagonal;\n            for i in (0..j).rev() {\n                let mut sum = M31::ZERO;\n                for k in i + 1..=j {\n                    let a = matrix[i * n + k];\n                    let b = inverse[k * n + j];\n                    if a != M31::ZERO && b != M31::ZERO {\n                        sum = sum.add(a.mul(b));\n                    }\n                }\n                // Previously computed diagonal inverse of row i.\n                inverse[i * n + j] = sum.neg().mul(inverse[i * n + i]);\n            }\n        }\n        Ok(Self {\n            size,\n            matrix,\n            inverse,\n        })\n    }\n\n    pub const fn size(&self) -> BasisSize {\n        self.size\n    }\n    pub fn matrix(&self) -> &[M31] {\n        &self.matrix\n    }\n    pub fn inverse_matrix(&self) -> &[M31] {\n        &self.inverse\n    }\n\n    /// SPEC §3: M * natural coefficients; both slices must have size n.\n    pub fn natural_to_monomial<E: CodeField>(\n        &self,\n        input: &[E],\n        output: &mut [E],\n    ) -> Result<(), Error> {\n        self.apply(&self.matrix, false, input, output)\n    }\n    /// SPEC §3: M⁻¹ * monomial coefficients; both slices must have size n.\n    pub fn monomial_to_natural<E: CodeField>(\n        &self,\n        input: &[E],\n        output: &mut [E],\n    ) -> Result<(), Error> {\n        self.apply(&self.inverse, false, input, output)\n    }\n    pub(crate) fn transpose<E: CodeField>(\n        &self,\n        inverse: bool,\n        input: &[E],\n        output: &mut [E],\n    ) -> Result<(), Error> {\n        self.apply(\n            if inverse { &self.inverse } else { &self.matrix },\n            true,\n            input,\n            output,\n        )\n    }\n    fn apply<E: CodeField>(\n        &self,\n        matrix: &[M31],\n        transpose: bool,\n        input: &[E],\n        output: &mut [E],\n    ) -> Result<(), Error> {\n        let n = self.size.len();\n        if input.len() != n || output.len() != n {\n            return Err(Error::WrongLength);\n        }\n        output.fill(E::ZERO);\n        for row in 0..n {\n            for col in row..n {\n                let scalar = matrix[row * n + col];\n                if scalar == M31::ZERO {\n                    continue;\n                }\n                let (dst, src) = if transpose { (col, row) } else { (row, col) };\n                output[dst] = output[dst].add(E::from_m31(scalar).mul(input[src]));\n            }\n        }\n        Ok(())\n    }\n}\n"},{"id":19,"name":{"Local":"/rustc/library/core/src/iter/traits/iterator.rs"},"crate_name":"core","contents":null},{"id":20,"name":{"Local":"/rustc/library/core/src/iter/traits/mod.rs"},"crate_name":"core","contents":null},{"id":21,"name":{"Local":"/rustc/library/core/src/iter/traits/collect.rs"},"crate_name":"core","contents":null},{"id":22,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":23,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":24,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":25,"name":{"Local":"/rustc/library/core/src/iter/range.rs"},"crate_name":"core","contents":null},{"id":26,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":27,"name":{"Local":"/rustc/library/core/src/num/nonzero.rs"},"crate_name":"core","contents":null},{"id":28,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":29,"name":{"Local":"/rustc/library/core/src/iter/adapters/step_by.rs"},"crate_name":"core","contents":null},{"id":30,"name":{"Local":"/rustc/library/core/src/iter/adapters/chain.rs"},"c