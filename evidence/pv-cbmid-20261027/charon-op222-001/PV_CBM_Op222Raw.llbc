{"charon_version":"0.1.223","translated":{"crate_name":"pv_cbm_source","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":["--cfg=kani","--cfg=pv_cb_extract"],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["pv_cbm_source::constraints_v4::multilinear_evaluate_qm31"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["pv_cbm_source::constraints_v4::*"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-pv-cbmid-20261027/PV_CBM_Op222Raw.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"constraints-fragments.rs"},"crate_name":"pv_cbm_source","contents":"use alloc::vec::Vec;\nuse aspis_core::field::QM31;\nuse aspis_statement::trace_v4::TRACE_ROWS;\nfn eq_row(point: &[QM31; 10], row: usize) -> QM31 {\n    let mut weight = QM31::ONE;\n    for (coordinate, value) in point.iter().enumerate() {\n        let bit = (row >> (point.len() - 1 - coordinate)) & 1;\n        weight = weight.mul(if bit == 0 {\n            QM31::ONE.sub(*value)\n        } else {\n            *value\n        });\n    }\n    weight\n}\nfn sparse_eq_weights(point: &[QM31; 10]) -> Vec<(usize, QM31)> {\n    let trailing_boolean = point\n        .iter()\n        .rev()\n        .take_while(|value| **value == QM31::ZERO || **value == QM31::ONE)\n        .count();\n    let prefix_len = point.len() - trailing_boolean;\n    let mut suffix = 0usize;\n    for coordinate in &point[prefix_len..] {\n        suffix = (suffix << 1) | usize::from(*coordinate == QM31::ONE);\n    }\n    let mut weights = Vec::with_capacity(1usize << prefix_len);\n    for prefix in 0..(1usize << prefix_len) {\n        let row = (prefix << trailing_boolean) | suffix;\n        let mut weight = QM31::ONE;\n        for (coordinate, value) in point[..prefix_len].iter().enumerate() {\n            let bit = (prefix >> (prefix_len - 1 - coordinate)) & 1;\n            weight = weight.mul(if bit == 0 {\n                QM31::ONE.sub(*value)\n            } else {\n                *value\n            });\n        }\n        weights.push((row, weight));\n    }\n    weights\n}\npub fn multilinear_evaluate_qm31(column: &[QM31], point: &[QM31; 10]) -> Option<QM31> {\n    if column.len() != TRACE_ROWS {\n        return None;\n    }\n    Some(\n        sparse_eq_weights(point)\n            .into_iter()\n            .fold(QM31::ZERO, |sum, (row, weight)| {\n                sum.add(weight.mul(column[row]))\n            }),\n    )\n}\n"},{"id":1,"name":{"Local":"lib.rs"},"crate_name":"pv_cbm_source","contents":"//! cfg(kani) extraction context; all source modules are unedited and hash-pinned.\nextern crate alloc;\n#[cfg(kani)]\npub use aspis_core::field;\n#[cfg(kani)]\npub use aspis_statement::*;\n#[cfg(kani)]\n#[path = \"/home/dombarker/project-offloads/codex-pv-cbmid-20261027/source-proof/constraints-fragments.rs\"]\npub mod constraints_v4;\n#[cfg(kani)]\npub mod pool_v1 {\n    pub use aspis_statement::pool_v1::*;\n    #[path = \"/home/dombarker/project-offloads/codex-pv-cbmid-20261027/source-proof/hiding-with-harness.rs\"]\n    pub mod hiding;\n    #[path = \"/home/dombarker/project-offloads/codex-pv-cbmid-20261027/source-proof/oracle-fragments.rs\"]\n    pub mod oracle;\n}\n#[cfg(kani)]\npub mod r0 {\n    pub use aspis_core::r0::*;\n    #[path = \"/home/dombarker/project-offloads/codex-pv-cb3-20261026/source/crates/aspis-core/src/r0/encoder.rs\"]\n    pub mod encoder;\n    #[path = \"/home/dombarker/project-offloads/codex-pv-cb3-20261026/source/crates/aspis-core/src/r0/basis.rs\"]\n    pub mod basis;\n}\n#[cfg(kani)]\npub mod reference;\n#[cfg(all(kani,not(pv_cb_extract)))]\nmod checks {\n    use aspis_statement::pool_v1::pair_forest_hiding::*;\n    #[kani::proof]\n    #[kani::unwind(1025)]\n    fn masks_complete() {\n        assert_eq!(pool_v1_pair_forest_copy_active_row_masks_v1(),crate::reference::masks());\n    }\n    #[kani::proof]\n    #[kani::unwind(257)]\n    fn rows_complete() {\n        assert_eq!(pool_v1_pair_forest_copy_active_rows_v1(),crate::reference::rows());\n    }\n}\n\n#[cfg(kani)]\npub mod reference_encoder;\n#[cfg(all(kani,not(pv_cb_extract)))]\nmod schedule_checks {\n    #[kani::proof]\n    #[kani::unwind(137)]\n    fn schedule_success() {\n        let result=aspis_statement::pool_v1::pair_forest_hiding::build_pool_v1_pair_forest_copy_row_schedule_v1();\n        assert!(matches!(result,Ok(ref links) if links.len()==136));\n    }\n}\n#[cfg(kani)]\npub mod reference_multilinear;\n#[cfg(all(kani,not(pv_cb_extract)))]\nmod cell_checks {\n    #[kani::proof]\n    #[kani::unwind(1025)]\n    fn cells_complete() {\n        assert_eq!(aspis_statement::pool_v1::pair_forest_hiding::pool_v1_pair_forest_relation_free_mask_cells_v1(),crate::reference::cells());\n    }\n}\n\n// Control-flow prerequisites only. No shipped/reference field equality is claimed.\n#[cfg(all(kani,not(pv_cb_extract)))]\nmod index_checks {\n    #[kani::proof]\n    #[kani::unwind(513)]\n    fn encoder_pair_order() {\n        let q:[u16;1024]=kani::any();\n        let mut i=0usize;\n        for (pair,n) in q.chunks_exact(2).zip(0..512) {\n            assert_eq!(i,n);\n            assert_eq!(pair[0],q[2*i]);\n            assert_eq!(pair[1],q[2*i+1]);\n            i+=1;\n        }\n        assert_eq!(i,512);\n    }\n    #[kani::proof]\n    #[kani::unwind(12)]\n    fn suffix_scan_order() {\n        // 0/1 are Boolean coordinates; 2 is any non-Boolean coordinate class.\n        let point:[u8;10]=kani::any();\n        for value in point {kani::assume(value<=2);}\n        let trailing=point.iter().rev().take_while(|x|**x<=1).count();\n        let mut suffix=0usize;\n        for value in &point[10-trailing..] {suffix=(suffix<<1)|usize::from(*value==1);}\n        let mut indexed_trailing=0usize;\n        while indexed_trailing<10 {\n            if point[9-indexed_trailing]>1 {break;}\n            indexed_trailing+=1;\n        }\n        let mut indexed_suffix=0usize;\n        let mut coordinate=10-indexed_trailing;\n        while coordinate<10 {\n            indexed_suffix=(indexed_suffix<<1)|usize::from(point[coordinate]==1);\n            coordinate+=1;\n        }\n        assert_eq!(trailing,indexed_trailing);\n        assert_eq!(suffix,indexed_suffix);\n    }\n    #[kani::proof]\n    #[kani::unwind(2)]\n    fn sparse_row_bounds() {\n        let prefix_len:usize=kani::any();kani::assume(prefix_len<=10);\n        let trailing=10-prefix_len;\n        let prefix:usize=kani::any();kani::assume(prefix<(1usize<<prefix_len));\n        let suffix:usize=kani::any();kani::assume(suffix<(1usize<<trailing));\n        let row=(prefix<<trailing)|suffix;\n        assert!(row<1024);\n        assert_eq!(row>>trailing,prefix);\n        assert_eq!(row&((1usize<<trailing)-1),suffix);\n    }\n}\n"},{"id":2,"name":{"Local":"/home/dombarker/project-offloads/codex-pv-cb3-20261026/source/crates/aspis-core/src/field.rs"},"crate_name":"aspis_core","contents":null},{"id":3,"name":{"Local":"/home/dombarker/project-offloads/code