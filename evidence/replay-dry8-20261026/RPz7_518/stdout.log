'AspisR1.Tx2I_Finish.accepted_finish' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.Tx2I_Finish.accepted_finish : ∀ {W : Type} (base : VTop_Stages.Ops) (ops : FinishOps W) {Hash : Type}
  (D : VTop_Stages.aspis_core.digest.Digest32 Hash) (hash : Hash) (pub proof checkpoint : Slice U8),
  VTop_Stages.verifier.candidate.tx2_authenticated (Tx2I_Install.stage base ops) D pub proof checkpoint hash none =
      ok (core.result.Result.Ok ()) →
    Tx2I_Install.shape proof = ok (core.result.Result.Ok transport.Variant.S2) ∧
      Op3I_Install.sourceBody proof = ok (core.result.Result.Ok AspisR1CurrentCaller.transport.Variant.S2) ∧
        OraclePortHeader.accepts (MultiproofConeCanonical.bytesOf ↑proof) = true ∧
          ∃ p saved g geometry pending returned after flushed back v,
            base.op18 D checkpoint proof pub transport.Variant.S2 hash = ok (core.result.Result.Ok (p, saved)) ∧
              base.op6 proof p saved g none geometry pending 22#usize = ok (core.result.Result.Ok (returned, after)) ∧
                returned.weights.deref_mut = (returned.weights.deref, back) ∧
                  base.op9 after returned.weights.deref = ok flushed ∧
                    have a :=
                      { weights := back flushed, rhs := returned.rhs, power := returned.power, next := returned.next };
                    (Tx2I_Install.stage base ops).op19 v p a none = ok (core.result.Result.Ok ()) ∧
                      Port4D_FinishInstall.finish ops v p a none = ok (core.result.Result.Ok ()) ∧
                        ∀ (alpha0 alpha1 : E) (r0 : RoundValues ops v.round0 alpha0 p.claim)
                          (r1 : RoundValues ops v.round1 alpha1 r0.value) (weights : W) (alphas : Slice E)
                          (pair dot : E),
                          p.variant = transport.Variant.S2 →
                            p.alpha.index_usize 0#usize = ok alpha0 →
                              p.alpha.index_usize 1#usize = ok alpha1 →
                                ops.newWeights p.variant p.semantic_alpha p.z = ok (core.result.Result.Ok weights) →
                                  core.array.Array.index
                                        (core.ops.index.IndexSlice (core.slice.index.SliceIndexRangeToUsizeSlice E))
                                        p.alpha { «end» := 2#usize } =
                                      ok alphas →
                                    ops.pair weights alphas v.final_message p.kappa = ok (core.result.Result.Ok pair) →
                                      ops.dot v.final_message a.weights.deref = ok (core.result.Result.Ok dot) →
                                        ∀ (parsed : Parsed) (q : Fin 22 → Fin 262144)
                                          (tr : RawCutTranscriptRun.ErasedPrefix) (i : SourceInputs),
                                          OraclePortStoredDecisionDraftC4.input parsed q tr = some i →
                                            queries tr = some q →
                                              LiteralMatchingData.read (typedRows parsed q tr) = some i.data →
                                                LiteralQueryRead.decode i.queryBytes = some q →
                                                  Port4D_Pairing.PairingLaws (Port3_FinishStage.release ops)
                                                      CheckpointBytes5Output.ofE v p i.data →
                                                    ⋯ → ⋯ :=
fun {W} base ops {Hash} D hash pub proof checkpoint accepted =>
  let ⟨variant, h✝⟩ :=
    Tx2I_Cuts.authenticated_reached (Tx2I_Install.stage base ops) D hash pub proof checkpoint none accepted
  let ⟨shape, common⟩ := h✝
  let ⟨left✝, right✝⟩ := Tx2I_Install.shape_header proof variant shape
  Eq.ndrec (motive := fun variant =>
    (Tx2I_Install.stage base ops).op3 proof = ok (core.result.Result.Ok variant) →
      Tx2I_Install.shape proof = ok (core.result.Result.Ok transport.Variant.S2) ∧
        Op3I_Install.sourceBody proof = ok (core.result.Result.Ok AspisR1CurrentCaller.transport.Variant.S2) ∧
          OraclePortHeader.accepts (MultiproofConeCanonical.bytesOf ↑proof) = true ∧
            ∃ p saved g geometry pending returned after flushed back v,
              base.op18 D checkpoint proof pub transport.Variant.S2 hash = ok (core.result.Result.Ok (p, saved)) ∧
                base.op6 proof p saved g none geometry pending 22#usize = ok (core.result.Result.Ok (returned, after)) ∧
                  returned.weights.deref_mut = (returned.weights.deref, back) ∧
                    base.op9 after returned.weights.deref = ok flushed ∧
                      let a :=
                        { weights := back flushed, rhs := returned.rhs, power := returned.power,
                          next := returned.next };
                      (Tx2I_Install.stage base ops).op19 v p a none = ok (core.result.Result.Ok ()) ∧
                        Port4D_FinishInstall.finish ops v p a none = ok (core.result.Result.Ok ()) ∧
                          ∀ (alpha0 alpha1 : E) (r0 : RoundValues ops v.round0 alpha0 p.claim)
                            (r1 : RoundValues ops v.round1 alpha1 r0.value) (weights : W) (alphas : Slice E)
                            (pair dot : E),
                            p.variant = transport.Variant.S2 →
                              p.alpha.index_usize 0#usize = ok alpha0 →
                                p.alpha.index_usize 1#usize = ok alpha1 →
                                  ops.newWeights p.variant p.semantic_alpha p.z = ok (core.result.Result.Ok weights) →
                                    core.array.Array.index
                                          (core.ops.index.IndexSlice (core.slice.index.SliceIndexRangeToUsizeSlice E))
                                          p.alpha { «end» := 2#usize } =
                                        ok alphas →
                                      ops.pair weights alphas v.final_message p.kappa =
                                          ok (core.result.Result.Ok pair) →
                                        ops.dot v.final_message a.weights.deref = ok (core.result.Result.Ok dot) →
                                          ∀ (parsed : Parsed) (q : Fin 22 → Fin 262144)
                                            (tr : RawCutTranscriptRun.ErasedPrefix) (i : SourceInputs),
                                            OraclePortStoredDecisionDraftC4.input parsed q tr = some i →
                                              queries tr = some q →
                                                LiteralMatchingData.read (typedRows parsed q tr) = some i.data →
                                                  LiteralQueryRead.decode i.queryBytes = some q →
                                                    Port4D_Pairing.PairingLaws (Port3_FinishStage.release ops)
                                                        CheckpointBytes5Output.ofE v p i.data →
                                                      (∀ (j : Fin 22), ⋯) →
                                                        R3SemanticRemainingJoins.EquationEndpoint i.decoded
                                                            (typedRows parsed q tr) i.data →
                                                          ⋯)
    (fun shape =>
      let ⟨source, header⟩ := right✝
      let ⟨p, h✝¹⟩ := Tx2I_Cuts.common_reached (Tx2I_Install.stage base ops) D hash pub proof checkpoint none common
      let ⟨saved, h✝²⟩ := h✝¹
      let ⟨g, h✝³⟩ := h✝²
      let ⟨geometry, h✝⁴⟩ := h✝³
      let ⟨pending, h✝⁵⟩ := h✝⁴
      let ⟨returned, h✝⁶⟩ := h✝⁵
      let ⟨after, h✝⁷⟩ := h✝⁶
      let ⟨flushed, h✝⁸⟩ := h✝⁷
      let ⟨back, h✝⁹⟩ := h✝⁸
      let ⟨v, h✝¹⁰⟩ := h✝⁹
      let ⟨hr, right✝¹⟩ := h✝¹⁰
      let ⟨hq, right✝²⟩ := right✝¹
      let ⟨hb, right✝³⟩ := right✝²
      let ⟨hf, hfinish⟩ := right✝³
      ⟨shape,
        ⟨source,
          ⟨header,
            Exists.intro p
              (Exists.intro saved
                (Exists.intro g
                  (Exists.intro geometry
                    (Exists.intro pending
                      (Exists.intro returned
                        (Exists.intro after
                          (Exists.intro flushed
                            (Exists.intro back
                              (Exists.intro v
                                ⟨hr,
                                  ⟨hq,
                                    ⟨hb,
                                      ⟨hf,
                                        ⟨hfinish,
                                          ⟨hfinish,
                                            fun alpha0 alpha1 r0 r1 weights alphas pair dot s2 ha0 ha1 hw has hp hd
                                              parsed q tr i hi hqueries read decoded pairing_S3_S5_S9 matches_S4_S7
                                              semantic_S3_S9 dot_S5 canonical_S3_S4_S5_S9 saved_ten twelve =>
                                            FinT_Model.finish_value ops v p
                                              { weights := back flushed, rhs := returned.rhs, power := returned.power,
                                                next := returned.next }
                                              saved alpha0 alpha1 r0 r1 weights alphas pair dot s2 ha0 ha1 hw has hp hd
                                              parsed q tr i hi hqueries read decoded pairing_S3_S5_S9 matches_S4_S7
                                              semantic_S3_S9 dot_S5 canonical_S3_S4_S5_S9 saved_ten
                                              twelve⟩⟩⟩⟩⟩⟩)))))))))⟩⟩⟩)
    (Eq.symm left✝) shape
