'AspisR1.Op5T_Op3.accepted_pair_claims_op3' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.Op5T_Op3.accepted_pair_claims_op3 : ∀ {W A E M Cv : Type} {N : ℕ} (L : Library W (ℕ → Record)),
  S2TrustedSdkBorrow L →
    ∀ (copy : Heap (ℕ → Record) → ℕ → Payload → Outcome (ℕ → Record)),
      TrustedStd copy →
        ∀ (allocator : Allocator A) (e1 e2 : Entry) (w1 w2 : W),
          RuntimeEntrypointAdmission L e1 w1 3 →
            RuntimeEntrypointAdmission L e2 w2 7 →
              ∀ (adapterOps : AdapterRw.Ops) (ops : Ops) (B : AspisR1PublicPreparation.FinishModel.Boundaries)
                (claimsStd : ClaimsUnrolledFinish.StdCalls) (native1 : S2W_ExtractionBoundary.First)
                (native2 : S2W_ExtractionBoundary.Second) (hashv : S2Z.Oracle.Parts → Result S2Z.Oracle.Digest),
                S2W_DigestExtraction.AeneasExtraction (sdkOps adapterOps (Op3I_Install.install ops) B claimsStd) native1
                    native2 hashv →
                  ∀ (sha256 H : Bytes → State),
                    S2W_ExtractionBoundary.P1 sha256 H →
                      S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
                        ∀ (program : S2W_ExtractionBoundary.Program) (data1 data2 : Slice U8)
                          (slot : S2W_ExtractionBoundary.Slot) (state1 state2 final1 final2 : A)
                          (saved : alloc.vec.Vec U8) (post1 post2 : Heap (ℕ → Record)),
                          first native1 copy allocator e1 program data1 state1 =
                              ok (core.result.Result.Ok (saved, post1, final1)) →
                            second native2 allocator e2 program data2 slot state2 =
                                ok (core.result.Result.Ok (post2, final2)) →
                              ∀ (p : FS2.Duplex.Params M Cv N) (root : Std.Array U8 32#usize) (length : U32)
                                (port : ChildConeJoin E (sdkOps adapterOps (Op3I_Install.install ops) B claimsStd)),
                                Op5T_Marks.FirstMarks port →
                                  Op5T_Marks.SecondMarks port →
                                    ∃ f s outer pre middle fs ss,
                                      SourceCuts (sdkOps adapterOps (Op3I_Install.install ops) B claimsStd) e1.first
                                          (e2.second secondSizes) saved f s ∧
                                        ((RowShape_InstalledSlots.verifierOps (Op3I_Install.install ops) B
                                                    claimsStd).op3
                                                f.proof =
                                              ok (core.result.Result.Ok transport.Variant.S2) ∧
                                            Op3I_Install.sourceBody f.proof =
                                                ok (core.result.Result.Ok transport.Variant.S2) ∧
                                              OraclePortHeader.accepts (bytesOf ↑f.proof) = true ∧
                                                Op3I_Cuts.frozenHeader (bytesOf ↑f.proof) = some transport.Variant.S2) ∧
                                          S2W_ExpandedTrace.runExpanded
                                                (sdkOps adapterOps (Op3I_Install.install ops) B claimsStd)
                                                (children port)
                                                (S2W_Observation.two
                                                  (sdkOps adapterOps (Op3I_Install.install ops) B claimsStd) program
                                                  e1.first data1 (e2.second secondSizes) data2 slot)
                                                [] =
                                              ok
                                                (core.result.Result.Ok saved,
                                                  S2W_ExpandedTrace.full (children port) outer) ∧
                                            S2W_D189Interpretation.runOwned
                                                  (sdkOps adapterOps (Op3I_Install.install ops) B claimsStd)
                                                  (S2W_Observation.two
                                                    (sdkOps adapterOps (Op3I_Install.install ops) B claimsStd) program
                                                    e1.first data1 (e2.second secondSizes) data2 slot)
                                                  [] e1.heap =
                                                ok (core.result.Result.Ok saved, outer, e1.heap) ∧
                                              projected port outer = S2W_SiteSchedule.timeline pre middle fs ss ∧
                                                post2 = e2.heap ∧
                                                  before e1 e2 Site.tx1 =
                                                      S2W_D189Interpretation.nativeObserve L encode e1.metadata 3 w1
                                                        e1.heap.ambient ∧
                                                    before e1 e2 Site.tx2 =
                                                        S2W_D189Interpretation.nativeObserve L encode e2.metadata 7 w2
                                                          e2.heap.ambient ∧
                                                      ⋯ :=
fun {W A E M Cv} {N} L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 adapterOps ops B claimsStd native1
    native2 hashv extraction sha256 H p1 syscall program data1 data2 slot state1 state2 final1 final2 saved post1 post2
    accepted1 accepted2 p root length port firstMarks secondMarks =>
  let ⟨f, h✝⟩ :=
    Op5T_Claims.accepted_pair_claims L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 adapterOps
      (Op3I_Install.install ops) B claimsStd native1 native2 hashv extraction sha256 H p1 syscall program data1 data2
      slot state1 state2 final1 final2 saved post1 post2 accepted1 accepted2 p root length port firstMarks secondMarks
  let ⟨s, h✝¹⟩ := h✝
  let ⟨outer, h✝²⟩ := h✝¹
  let ⟨pre, h✝³⟩ := h✝²
  let ⟨middle, h✝⁴⟩ := h✝³
  let ⟨fs, h✝⁵⟩ := h✝⁴
  let ⟨ss, h✝⁶⟩ := h✝⁵
  let ⟨cuts, remaining⟩ := h✝⁶
  Exists.intro f
    (Exists.intro s
      (Exists.intro outer
        (Exists.intro pre
          (Exists.intro middle
            (Exists.intro fs
              (Exists.intro ss
                ⟨cuts,
                  ⟨Op3I_Cuts.same_cut_header adapterOps ops B claimsStd e1.first (e2.second secondSizes) saved f s cuts,
                    remaining⟩⟩))))))
