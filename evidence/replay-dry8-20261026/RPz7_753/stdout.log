'AspisR1.Tx2N_Accepted.accepted_pair_reader' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.Tx2N_Accepted.accepted_pair_reader : ∀ {W A E M Cv F CoreError : Type} {N : ℕ}
  (L : Library W (ℕ → Record)),
  S2TrustedSdkBorrow L →
    ∀ (copy : Heap (ℕ → Record) → ℕ → Payload → Outcome (ℕ → Record)),
      TrustedStd copy →
        ∀ (allocator : Allocator A) (e1 e2 : Entry) (w1 w2 : W),
          RuntimeEntrypointAdmission L e1 w1 3 →
            RuntimeEntrypointAdmission L e2 w2 7 →
              ∀ (adapterOps : AdapterRw.Ops) (ops : Ops) (stageBase : VTop_Stages.Ops)
                (finishOps : AspisR1Stage2.Stage2Finish.FinishOps F) (reserved : Bool)
                (query : Port3_NativeQueryBody.Ops) (geo : Port3_NativeGeometryBody.Ops CoreError)
                (B : AspisR1PublicPreparation.FinishModel.Boundaries) (claimsStd : ClaimsUnrolledFinish.StdCalls)
                (native1 : S2W_ExtractionBoundary.First) (native2 : S2W_ExtractionBoundary.Second)
                (hashv : S2Z.Oracle.Parts → Result S2Z.Oracle.Digest),
                S2W_DigestExtraction.AeneasExtraction
                    (sdkOps
                      (Tx2I_Install.install adapterOps (Tx2N_Execution.control stageBase reserved query geo) finishOps)
                      (Op3I_Install.install ops) B claimsStd)
                    native1 native2 hashv →
                  ∀ (sha256 H : Bytes → State),
                    S2W_ExtractionBoundary.P1 sha256 H →
                      S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
                        ∀ (program : S2W_ExtractionBoundary.Program) (data1 data2 : Slice U8)
                          (slot : S2W_ExtractionBoundary.Slot) (state1 state2 final1 final2 : A)
                          (saved : alloc.vec.Vec U8) (post1 post2 : Heap (ℕ → Record)),
                          first native1 copy allocator e1 program data1 state1 =
                              ok (core.result.Result.Ok (saved, post1, final1)) →
                            second native2 allocator e2 program data2 slot state2 =
                                ok (core.result.Result.Ok (post2, final2)) →
                              ∀ (p : FS2.Duplex.Params M Cv N) (root : Std.Array U8 32#usize) (length : U32)
                                (port :
                                  ChildConeJoin E
                                    (sdkOps
                                      (Tx2I_Install.install adapterOps
                                        (Tx2N_Execution.control stageBase reserved query geo) finishOps)
                                      (Op3I_Install.install ops) B claimsStd)),
                                FirstMarks port →
                                  SecondMarks port →
                                    ∃ f s outer pre middle fs ss,
                                      SourceCuts
                                          (sdkOps
                                            (Tx2I_Install.install adapterOps
                                              (Tx2N_Execution.control stageBase reserved query geo) finishOps)
                                            (Op3I_Install.install ops) B claimsStd)
                                          e1.first (e2.second secondSizes) saved f s ∧
                                        (Tx2I_Install.shape s.proof =
                                              ok (core.result.Result.Ok AspisR1Stage2.transport.Variant.S2) ∧
                                            ⋯) ∧
                                          ⋯ ∧ ⋯ :=
fun {W A E M Cv F CoreError} {N} L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 adapterOps ops stageBase
    finishOps reserved query geo B claimsStd native1 native2 hashv extraction sha256 H p1 syscall program data1 data2
    slot state1 state2 final1 final2 saved post1 post2 accepted1 accepted2 p root length port firstMarks secondMarks =>
  let ⟨f, h✝⟩ :=
    Tx2I_Accepted.accepted_pair_claims_tx2 L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 adapterOps ops
      (Tx2N_Execution.control stageBase reserved query geo) finishOps B claimsStd native1 native2 hashv extraction
      sha256 H p1 syscall program data1 data2 slot state1 state2 final1 final2 saved post1 post2 accepted1 accepted2 p
      root length port firstMarks secondMarks
  let ⟨s, h✝¹⟩ := h✝
  let ⟨outer, h✝²⟩ := h✝¹
  let ⟨pre, h✝³⟩ := h✝²
  let ⟨middle, h✝⁴⟩ := h✝³
  let ⟨fs, h✝⁵⟩ := h✝⁴
  let ⟨ss, h✝⁶⟩ := h✝⁵
  let ⟨cuts, right✝⟩ := h✝⁶
  let ⟨tx2, right✝¹⟩ := right✝
