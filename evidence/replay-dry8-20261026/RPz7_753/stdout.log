  let ⟨expanded, right✝³⟩ := right✝²
  let ⟨owned, right✝⁴⟩ := right✝³
  let ⟨layout, right✝⁵⟩ := right✝⁴
  let ⟨unchanged, right✝⁶⟩ := right✝⁵
  let ⟨before1, right✝⁷⟩ := right✝⁶
  let ⟨before2, right✝⁸⟩ := right✝⁷
  let ⟨claims, caller⟩ := right✝⁸
  Exists.intro f
    (Exists.intro s
      (Exists.intro outer
        (Exists.intro pre
          (Exists.intro middle
            (Exists.intro fs
              (Exists.intro ss
                ⟨cuts,
                  ⟨tx2,
                    ⟨first,
                      ⟨expanded,
                        ⟨owned,
                          ⟨layout,
                            ⟨unchanged,
                              ⟨before1,
                                ⟨before2,
                                  ⟨claims, fun decode nodes y1 writer reader runtime p2prime entry multiproof scan =>
                                    let ⟨parsed, h✝⁷⟩ :=
                                      caller decode nodes y1 writer reader runtime p2prime entry multiproof scan
                                    let ⟨facts, sites⟩ := h✝⁷
                                    let ⟨version, h✝⁸⟩ :=
                                      RowOrder_History.on_d189_cuts copy std allocator e1 e2
                                        (sdkOps
                                          (Tx2I_Install.install adapterOps
                                            (Tx2N_Execution.control stageBase reserved query geo) finishOps)
                                          (Op3I_Install.install ops) B claimsStd)
                                        native1 native2 hashv extraction program data1 state1 final1 saved post1
                                        accepted1 f s cuts decode H writer reader runtime p2prime
                                    let ⟨key, right✝⁹⟩ := h✝⁸
                                    let ⟨ledger, right✝¹⁰⟩ := right✝⁹
                                    let ⟨events, right✝¹¹⟩ := right✝¹⁰
                                    let ⟨checkpoint, right✝¹²⟩ := right✝¹¹
                                    let ⟨proof, right✝¹³⟩ := right✝¹²
                                    let ⟨pub, size⟩ := right✝¹³
                                    let ⟨variant, h✝⁹⟩ :=
                                      Tx2I_Cuts.authenticated_reached
                                        (Tx2I_Install.stage (Tx2N_Execution.control stageBase reserved query geo)
                                          finishOps)
                                        (AdapterRw.SolanaDigest.Insts.Aspis_coreDigestDigest32
                                          (sdkOps
                                            (Tx2I_Install.install adapterOps
                                              (Tx2N_Execution.control stageBase reserved query geo) finishOps)
                                            (Op3I_Install.install ops) B claimsStd))
                                        () s.pub s.proof s.checkpoint none cuts.second
                                    let ⟨shape, common⟩ := h✝⁹
                                    have commonRun := common;
                                    let ⟨rp, h✝¹⁰⟩ :=
                                      Tx2N_Execution.common (Tx2I_Install.stage stageBase finishOps) reserved query geo
                                        (AdapterRw.SolanaDigest.Insts.Aspis_coreDigestDigest32
                                          (sdkOps
                                            (Tx2I_Install.install adapterOps
                                              (Tx2N_Execution.control stageBase reserved query geo) finishOps)
                                            (Op3I_Install.install ops) B claimsStd))
                                        () s.pub s.proof s.checkpoint commonRun
                                    let ⟨ra, h✝¹¹⟩ := h✝¹⁰
                                    let ⟨g, h✝¹²⟩ := h✝¹¹
                                    ⋯⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩))))))
