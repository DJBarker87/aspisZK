def List.slice.{u_1} : {α : Type u_1} → ℕ → ℕ → List α → List α :=
fun {α} start end_ ls => List.take (end_ - start) (List.drop start ls)
'AspisR1.SdkD_ModelRoots.rawSlice' depends on axioms: [propext]
'AspisR1.SdkD_ModelRoots.decode_native' depends on axioms: [propext, Classical.choice, Quot.sound]
