'AspisR1.WAdm_NativeEndpoint.reached' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.WAdm_NativeEndpoint.reached : ∀ {CoreError : Type} (adapterOps : AdapterRw.Ops)
  (ops : AspisR1CurrentCaller.Ops) (reserved : Bool) (query : Port3_NativeQueryBody.Ops)
  (geo : Port3_NativeGeometryBody.Ops CoreError) (B : AspisR1PublicPreparation.FinishModel.Boundaries)
  (std : ClaimsUnrolledFinish.StdCalls) (e1 : S2W_D189Entry.Entry) (accounts2 : S2W_ExtractionBoundary.Accounts)
  (saved : alloc.vec.Vec U8) (f : FirstCut) (s : SecondCut),
  SourceCuts (ClaimsUnrolledSdk.sdkOps adapterOps (Tx1Q_SameCut.dictionary ops reserved query geo) B std) e1.first
      accounts2 saved f s →
    WAdm_Domain.SessionAPrepare (Tx1Q_Execution.actual ops reserved query geo B std) →
      Port5Q1_QueryPorts.SessionAPrimitives query →
        ∃ run,
          reserved = true ∧
            f.split = 10#usize ∧
              ↑run.out.next = 10 ∧
                (↑run.flushed).length = 64 ∧
                  (∀ x ∈ ↑(slice k run.flushed), Port3_FlushInstall.Canonical x) ∧
                    Port3_CheckpointInstall.writer
                          (Tx1Q_Install.digest (Tx1Q_SameCut.callerDigest adapterOps ops reserved query geo B std))
                          (prepared run.p)
                          (accumulator
                            (have __src := run.out;
                            { weights := ⟨↑run.flushed, ⋯⟩, rhs := __src.rhs, power := __src.power,
                              next := __src.next }))
                          f.proof f.pub () =
                        ok saved ∧
                      WAdm_Domain.Admitted (prepared run.p)
                          (accumulator
                            (have __src := run.out;
                            { weights := ⟨↑run.flushed, ⋯⟩, rhs := __src.rhs, power := __src.power,
                              next := __src.next }))
                          f.proof f.pub ∧
                        WAdm_Carrier.WideInputs (prepared run.p)
                            (accumulator
                              (have __src := run.out;
                              { weights := ⟨↑run.flushed, ⋯⟩, rhs := __src.rhs, power := __src.power,
                                next := __src.next })) ∧
                          WAdm_SourceWriter.writer
                                (Tx1Q_Install.digest
                                  (Tx1Q_SameCut.callerDigest adapterOps ops reserved query geo B std))
                                (prepared run.p)
                                (accumulator
                                  (have __src := run.out;
                                  { weights := ⟨↑run.flushed, ⋯⟩, rhs := __src.rhs, power := __src.power,
                                    next := __src.next }))
                                f.proof f.pub () =
                              ok saved ∧
                            (WAdm_NativeInstall.install (Tx1Q_Execution.actual ops reserved query geo B std)).op16
                                  (Tx1Q_SameCut.callerDigest adapterOps ops reserved query geo B std) run.p
                                  (have __src := run.out;
                                  { weights := ⟨↑run.flushed, ⋯⟩, rhs := __src.rhs, power := __src.power,
                                    next := __src.next })
                                  f.proof f.pub () =
                                ok saved ∧
                              Tx1Q_Endpoint.WhenBound run :=
fun {CoreError} adapterOps ops reserved query geo B std e1 accounts2 saved f s cuts owner ports =>
  let ⟨run, h✝⟩ :=
    WAdm_OriginalEndpoint.reached adapterOps ops reserved query geo B std e1 accounts2 saved f s cuts owner ports
  let ⟨r, right✝⟩ := h✝
  let ⟨sp, right✝¹⟩ := right✝
  let ⟨n, right✝²⟩ := right✝¹
  let ⟨w, right✝³⟩ := right✝²
  let ⟨can, right✝⁴⟩ := right✝³
  let ⟨writer, right✝⁵⟩ := right✝⁴
  let ⟨domain, right✝⁶⟩ := right✝⁵
  let ⟨wide, right✝⁷⟩ := right✝⁶
  let ⟨content, bound⟩ := right✝⁷
  Exists.intro run
    ⟨r,
      ⟨sp,
        ⟨n,
          ⟨w,
            ⟨can,
              ⟨writer,
                ⟨domain,
                  ⟨wide,
                    ⟨content,
                      ⟨WAdm_NativeInstall.on_run (Tx1Q_Execution.actual ops reserved query geo B std) reserved query geo
                          (Tx1Q_SameCut.callerDigest adapterOps ops reserved query geo B std) ()
                          (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.pub f.proof f.split saved run owner
                          ports,
                        bound⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩
