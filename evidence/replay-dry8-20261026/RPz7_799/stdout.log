'AspisR1.WAdm_Endpoint.reached' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.WAdm_Endpoint.reached : ∀ {CoreError : Type} (adapterOps : AdapterRw.Ops)
  (ops : AspisR1CurrentCaller.Ops) (reserved : Bool) (query : Port3_NativeQueryBody.Ops)
  (geo : Port3_NativeGeometryBody.Ops CoreError) (B : AspisR1PublicPreparation.FinishModel.Boundaries)
  (std : ClaimsUnrolledFinish.StdCalls) (e1 : S2W_D189Entry.Entry) (accounts2 : S2W_ExtractionBoundary.Accounts)
  (saved : alloc.vec.Vec U8) (f : FirstCut) (s : SecondCut),
  SourceCuts (ClaimsUnrolledSdk.sdkOps adapterOps (WAdm_SameCut.dictionary ops reserved query geo) B std) e1.first
      accounts2 saved f s →
    ∀ (owner : WAdm_Domain.SessionAPrepare (WAdm_Execution.actual ops reserved query geo B std))
      (ports : Port5Q1_QueryPorts.SessionAPrimitives query),
      ∃ run,
        reserved = true ∧
          f.split = 10#usize ∧
            ↑run.out.next = 10 ∧
              (↑run.flushed).length = 64 ∧
                (∀ x ∈ ↑(slice k run.flushed), Port3_FlushInstall.Canonical x) ∧
                  WAdm_Domain.Admitted (prepared run.p)
                      (accumulator
                        (have __src := run.out;
                        { weights := ⟨↑run.flushed, ⋯⟩, rhs := __src.rhs, power := __src.power, next := __src.next }))
                      f.proof f.pub ∧
                    WAdm_Carrier.WideInputs (prepared run.p)
                        (accumulator
                          (have __src := run.out;
                          { weights := ⟨↑run.flushed, ⋯⟩, rhs := __src.rhs, power := __src.power,
                            next := __src.next })) ∧
                      WAdm_SourceWriter.writer
                            (Tx1Q_Install.digest (WAdm_SameCut.callerDigest adapterOps ops reserved query geo B std))
                            (prepared run.p)
                            (accumulator
                              (have __src := run.out;
                              { weights := ⟨↑run.flushed, ⋯⟩, rhs := __src.rhs, power := __src.power,
                                next := __src.next }))
                            f.proof f.pub () =
                          ok saved ∧
                        Tx1Q_Endpoint.WhenBound
                          (WAdm_ReferenceRun.reference (WAdm_Execution.actual ops reserved query geo B std) reserved
                            query geo (WAdm_SameCut.callerDigest adapterOps ops reserved query geo B std) ()
                            (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.pub f.proof f.split saved run owner
                            ports) :=
fun {CoreError} adapterOps ops reserved query geo B std e1 accounts2 saved f s cuts owner ports =>
  let ⟨run⟩ := WAdm_SameCut.reached adapterOps ops reserved query geo B std e1.first accounts2 saved f s cuts
  have control :=
    WAdm_RunControl.fields (WAdm_Execution.actual ops reserved query geo B std) reserved query geo
      (WAdm_SameCut.callerDigest adapterOps ops reserved query geo B std) ()
      (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.pub f.proof f.split saved run;
  have proofLength :=
    Eq.mp (congrFun' (congrArg Eq (List.length_map AspisV8R19.SqueezeOracleBridge.decodeByte)) 57607) cuts.proofLength;
  have publicLength :=
    (WAdm_Public.reached adapterOps (WAdm_SameCut.dictionary ops reserved query geo) B std e1 accounts2 saved f s
        cuts).right;
  have domain :=
    WAdm_RunDomain.on_run (WAdm_Execution.actual ops reserved query geo B std) reserved query geo
      (WAdm_SameCut.callerDigest adapterOps ops reserved query geo B std) ()
      (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.pub f.proof f.split saved run owner ports proofLength
      publicLength;
  Exists.intro run
    ⟨control.left,
      ⟨control.right.left,
        ⟨control.right.right.left,
          ⟨control.right.right.right.left,
            ⟨control.right.right.right.right,
              ⟨domain,
                ⟨WAdm_Carrier.wide (prepared run.p)
                    (accumulator
                      (let __src := run.out;
                      { weights := ⟨↑run.flushed, run.flushed.property⟩, rhs := __src.rhs, power := __src.power,
                        next := __src.next }))
                    f.proof f.pub domain,
                  ⟨run.writer_call,
                    Tx1Q_Endpoint.on_run (WAdm_Execution.actual ops reserved query geo B std) reserved query geo
                      (WAdm_SameCut.callerDigest adapterOps ops reserved query geo B std) ()
                      (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.pub f.proof f.split saved
                      (WAdm_ReferenceRun.reference (WAdm_Execution.actual ops reserved query geo B std) reserved query
                        geo (WAdm_SameCut.callerDigest adapterOps ops reserved query geo B std) ()
                        (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.pub f.proof f.split saved run owner ports)
                      proofLength⟩⟩⟩⟩⟩⟩⟩⟩
