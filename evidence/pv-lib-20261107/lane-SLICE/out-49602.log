def PV_FN_SLICE_f32.Post : Carrier OWNER Data →
  Control →
    (Data → Option PV_STX2_SliceSyntax.Program) →
      PV_W5_UbCheckPrimitives.Handler →
        Store Data → Frame → List Frame → ℕ → OWNER → List PV_RJ4IDB.NativeEvent → Prop :=
fun D K programs H s parent parents a w prior =>
  ∃ fuel out,
    fuel ≤ 128 ∧
      PV_STX2_SliceMachine.advance D K programs H fuel (start s parent parents a w prior) = out ∧
        Boundary D K programs H s parent parents a w prior fuel out ∧
          PV_W5_F59Frame.Post s a w out ∧ ∃ suffix, out.events = prior ++ suffix
def PV_FN_SLICE_f32.Contract : Prop :=
∀ (D : Carrier OWNER Data) (K : Control) (programs : Data → Option PV_STX2_SliceSyntax.Program)
  (H : PV_W5_UbCheckPrimitives.Handler) (base : Carrier OWNER Data) (ctrl : Control) (word : Data → ℕ)
  (staticAddress : Address) (backend : PV_W5_NativeFrame.Backend) (s : Store Data) (parent : Frame)
  (parents : List Frame) (a : ℕ) (source destination : Data) (size alignment count : ℕ) (w : OWNER)
  (prior : List PV_RJ4IDB.NativeEvent),
  Pre s a source destination size alignment count w →
    MachineSpec D K programs H base ctrl word staticAddress backend → Post D K programs H s parent parents a w prior
