def AspisR1.ART_AdversaryWork.work : {A F C : Type} →
  AspisR1.DrvC_Installation.Configuration F C →
    (AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest) →
      (AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
          ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record)) →
        AspisR1.S2W_D189Wrappers.Allocator A →
          AspisR1.S2W_ExtractionBoundary.Program →
            AspisR1.SCE_Experiment.Adversary A →
              (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) → ℕ :=
fun {A F C} c hashv copy allocator id a H =>
  (AspisV8R19.MemoizedProgramLaw.eval H a.first).1.length +
    match
      (AspisV8R19.MemoizedProgramLaw.eval H
          (AspisR1.ART_PartialAccount.wrapper hashv
            (AspisR1.ARS_NativeAccount.firstSyntax c hashv copy allocator id
              (AspisV8R19.MemoizedProgramLaw.eval H a.first).2))).2 with
    | Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post, final)) =>
      (AspisV8R19.MemoizedProgramLaw.eval H
            (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post final)).1.length
    | x => 0
def AspisR1.ART_AdversaryWork.Bound : {A F C : Type} →
  AspisR1.DrvC_Installation.Configuration F C →
    (AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest) →
      (AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
          ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record)) →
        AspisR1.S2W_D189Wrappers.Allocator A →
          AspisR1.S2W_ExtractionBoundary.Program → AspisR1.SCE_Experiment.Adversary A → ℕ → Prop :=
fun {A F C} c hashv copy allocator id a Q =>
  ∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
    AspisR1.ART_AdversaryWork.work c hashv copy allocator id a H ≤ Q
@AspisR1.ARU_Charges.charged : ∀ {A F C : Type} (c : AspisR1.DrvC_Installation.Configuration F C)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (id : AspisR1.S2W_ExtractionBoundary.Program)
  (a : AspisR1.SCE_Experiment.Adversary A) (D : AspisR1.LiteralByteProtocol.Decoder) (Q : ℕ),
  AspisR1.ART_AdversaryWork.Bound c hashv copy allocator id a Q →
    (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
        FS.firstReads FS.emptyTable
            (AspisV8R19.MemoizedProgramLaw.eval H
                (AspisR1.Hiq_RecordedJoint.program (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)
                  AspisR1.ARQ_Observer.project (AspisR1.ARQ_Observer.select c id))).1 ≤
          Q + 2965) ∧
      AspisR1.F3T_AccountCharge.mass (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)
            AspisR1.ARQ_Observer.project (AspisR1.ARQ_Observer.select c id) Q ≤
          AspisR1.F3T_Numeric.accountLoss Q ∧
        ∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
          AspisR1.DecodedFirstReadUnionBound.decoderFirstReads AspisR1.RecordedBinaryExperimentBin.dec FS.emptyTable
              (AspisV8R19.MemoizedProgramLaw.eval H
                  (AspisR1.F3T_Charged.charged D
                    (AspisR1.F3T_Canon.canon
                      (AspisR1.F3T_ByteCarrier.lift c (AspisR1.SCE_Experiment.submission a))))).1 ≤
            Q + 34
'AspisR1.ARU_Charges.charged' depends on axioms: [propext, Classical.choice, Quot.sound]
