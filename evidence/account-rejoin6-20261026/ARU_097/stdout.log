@AspisR1.ART_RuntimeDomination.averaged : ∀ {A F C : Type} (c : AspisR1.DrvC_Installation.Configuration F C)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (id : AspisR1.S2W_ExtractionBoundary.Program)
  (a : AspisR1.SCE_Experiment.Adversary A),
  AspisR1.F3T_Runtime.deployedFailure (AspisR1.ART_Runtime.runtime c hashv copy allocator id a) ≤
    AspisR1.F3T_Runtime.deployedFailure (AspisR1.SCE_Experiment.runtime c hashv copy allocator id a)
@AspisR1.ART_QueriedPieces.chronology : ∀ {A F C : Type} (c : AspisR1.DrvC_Installation.Configuration F C)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (id : AspisR1.S2W_ExtractionBoundary.Program)
  (a : AspisR1.SCE_Experiment.Adversary A)
  (native H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8) (post : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record))
  (final : A),
  (AspisV8R19.MemoizedProgramLaw.eval native
          (AspisR1.ART_PartialAccount.wrapper hashv
            (AspisR1.ARS_NativeAccount.firstSyntax c hashv copy allocator id
              (AspisV8R19.MemoizedProgramLaw.eval native a.first).2))).2 =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post, final)) →
    AspisR1.ARS_AccountReplay.Consistent (AspisR1.ART_PartialAccount.account c hashv copy allocator id a) native H →
      AspisV8R19.MemoizedProgramLaw.eval H a.first = AspisV8R19.MemoizedProgramLaw.eval native a.first ∧
        AspisV8R19.MemoizedProgramLaw.eval H
              (AspisR1.ART_PartialAccount.wrapper hashv
                (AspisR1.ARS_NativeAccount.firstSyntax c hashv copy allocator id
                  (AspisV8R19.MemoizedProgramLaw.eval native a.first).2)) =
            AspisV8R19.MemoizedProgramLaw.eval native
              (AspisR1.ART_PartialAccount.wrapper hashv
                (AspisR1.ARS_NativeAccount.firstSyntax c hashv copy allocator id
                  (AspisV8R19.MemoizedProgramLaw.eval native a.first).2)) ∧
          AspisV8R19.MemoizedProgramLaw.eval H
                (a.second (AspisV8R19.MemoizedProgramLaw.eval native a.first).2 saved post final) =
              AspisV8R19.MemoizedProgramLaw.eval native
                (a.second (AspisV8R19.MemoizedProgramLaw.eval native a.first).2 saved post final) ∧
            AspisV8R19.MemoizedProgramLaw.eval H
                (AspisR1.ART_PartialAccount.wrapper hashv
                  (AspisR1.ARS_NativeAccount.secondSyntax c hashv allocator id
                    (AspisV8R19.MemoizedProgramLaw.eval native
                        (a.second (AspisV8R19.MemoizedProgramLaw.eval native a.first).2 saved post final)).2)) =
              AspisV8R19.MemoizedProgramLaw.eval native
                (AspisR1.ART_PartialAccount.wrapper hashv
                  (AspisR1.ARS_NativeAccount.secondSyntax c hashv allocator id
                    (AspisV8R19.MemoizedProgramLaw.eval native
                        (a.second (AspisV8R19.MemoizedProgramLaw.eval native a.first).2 saved post final)).2))
@AspisR1.ART_RejectedNative.mass : ∀ {A F C : Type} (c : AspisR1.DrvC_Installation.Configuration F C)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (id : AspisR1.S2W_ExtractionBoundary.Program)
  (a : AspisR1.SCE_Experiment.Adversary A)
  (native H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  AspisR1.ART_PartialAccount.Certificate c hashv copy allocator id a native H →
    AspisR1.SCE_Experiment.accepted (AspisR1.ARS_NativeAccount.run c hashv copy allocator id a native).2 = Bool.false →
      AspisR1.F3T_Runtime.runtimeMass
            (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.ART_Runtime.runtime c hashv copy allocator id a)) =
          0 ∧
        (AspisV8R19.MemoizedProgramLaw.eval H
                (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)).1.length =
          AspisR1.ARS_NativeAccount.attempts c hashv copy allocator id a native
'AspisR1.ART_RuntimeDomination.averaged' depends on axioms: [propext, Classical.choice, Quot.sound]
