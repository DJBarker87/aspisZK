def AspisR1.F3T_Numeric.total : ℕ → ℚ :=
fun Q =>
  ↑(Q + 34) * AspisR1.PerAttemptEnvelope.B + AspisR1.F3T_Numeric.collisionLoss Q + AspisR1.F3T_Numeric.accountLoss Q +
      1 / 2 ^ 126 +
    1 / 2 ^ 454
def AspisR1.F3T_Numeric.accountLoss : ℕ → ℚ :=
fun Q => 6 * ↑(Q + 2965) ^ 2 / 2 ^ 256
AspisR1.ART_ZeroArithmetic.margin :
  1 / 2 ^ 100 - AspisR1.F3T_Numeric.total 0 =
    1 / 2 ^ 108 - 6 * (1161 ^ 2 + 2965 ^ 2) / 2 ^ 256 - 1 / 2 ^ 126 - 1 / 2 ^ 454
'AspisR1.ART_ZeroArithmetic.margin' depends on axioms: [propext, Classical.choice, Quot.sound]
'AspisR1.ART_ZeroArithmetic.positive' depends on axioms: [propext, Classical.choice, Quot.sound]
