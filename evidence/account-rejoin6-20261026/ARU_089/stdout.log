@AspisR1.ARU_Charge.cached_preparation : ∀ {A F C : Type} (c : AspisR1.DrvC_Installation.Configuration F C)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (id : AspisR1.S2W_ExtractionBoundary.Program)
  (a : AspisR1.SCE_Experiment.Adversary A) (Q : ℕ),
  AspisR1.ART_AdversaryWork.Bound c hashv copy allocator id a Q →
    ∀
      (preparation :
        AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State Unit)
      (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
      (p : AspisR1.OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144),
      AspisR1.ARQ_Observer.project
            (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)).2 =
          (p, q) →
        (∀ (addr : AspisV8R19.DuplexFrames.Bytes),
            FS2.Duplex.Read (AspisV8R19.MemoizedProgramLaw.eval H preparation).1 addr →
              FS2.Duplex.Read
                (AspisV8R19.MemoizedProgramLaw.eval H
                    (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)).1
                addr) →
          AspisR1.AuS1_Finish.Collision H
              ((AspisV8R19.MemoizedProgramLaw.eval H
                    (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)).1 ++
                (AspisV8R19.MemoizedProgramLaw.eval H preparation).1)
              p q →
            AspisR1.BinRawByteCollisionTargets.event AspisR1.SelectedTranscriptParams.params.iv (Q + 2965)
              (AspisV8R19.MemoizedProgramLaw.eval H
                (AspisR1.Hiq_RecordedJoint.program (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)
                  AspisR1.ARQ_Observer.project (AspisR1.ARQ_Observer.select c id)))
@AspisR1.ART_FullCharge.charged : ∀ {A F C : Type} (c : AspisR1.DrvC_Installation.Configuration F C)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (id : AspisR1.S2W_ExtractionBoundary.Program)
  (a : AspisR1.SCE_Experiment.Adversary A) (Q : ℕ),
  AspisR1.ART_AdversaryWork.Bound c hashv copy allocator id a Q →
    (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
        FS.firstReads FS.emptyTable
            (AspisV8R19.MemoizedProgramLaw.eval H
                (AspisR1.Hiq_RecordedJoint.program (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)
                  AspisR1.ARQ_Observer.project (AspisR1.ARQ_Observer.select c id))).1 ≤
          Q + 2965) ∧
      AspisR1.F3T_AccountCharge.mass (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)
          AspisR1.ARQ_Observer.project (AspisR1.ARQ_Observer.select c id) Q ≤
        AspisR1.F3T_Numeric.accountLoss Q
'AspisR1.ARU_Charge.cached_preparation' depends on axioms: [propext, Classical.choice, Quot.sound]
