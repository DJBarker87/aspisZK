@AspisR1.ARU_Carrier.exact : ∀ {W A C Tx : Type} (L : AspisR1.S2Trust.Library W (ℕ → AspisR1.S2W_D189Entry.Record))
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A)
  (c : AspisR1.DrvC_Installation.Configuration AspisR1.FIo_Install.W C) (err : C) (r : AspisR1.NP6_StdModel.Reservation)
  (native1 : AspisR1.S2W_ExtractionBoundary.First) (native2 : AspisR1.S2W_ExtractionBoundary.Second)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest),
  AspisR1.S2W_DigestExtraction.AeneasExtraction
      (AspisR1.DrvC_Installation.sdk (AspisR1.FIp_Install.configuration err c r)) native1 native2 hashv →
    ∀ (a : AspisR1.SCE_Experiment.Adversary A) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
      (n : AspisR1.ARU_Support.At L copy allocator c err r native1 native2 hashv a H),
      AspisR1.S2W_TrustedStd.TrustedStd copy →
        ∀ (run : AspisR1.F3T_Experiment.RunView),
          (AspisV8R19.MemoizedProgramLaw.eval H
                  (AspisR1.SCE_Experiment.runtime (AspisR1.FIp_Install.configuration err c r) hashv copy allocator
                    AspisR1.CPH_Program.verifier a)).2 =
              Option.some run →
            run.2.1.stored = (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.SCE_Experiment.submission a)).2.stored ∧
              run.2.1.physical.bytes =
                  (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.SCE_Experiment.submission a)).2.publicBytes ∧
                ∃ saved post final f s,
                  (AspisV8R19.MemoizedProgramLaw.eval H
                          (AspisR1.SCE_Execution.firstCode (AspisR1.FIp_Install.configuration err c r) hashv copy
                            allocator AspisR1.CPH_Program.verifier
                            (AspisV8R19.MemoizedProgramLaw.eval H a.first).2)).2 =
                      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post, final)) ∧
                    AspisR1.S2W_NativeConsolidation.SourceCuts
                        (AspisR1.SCH_IdealSdk.dictionary (AspisR1.FIp_Install.configuration err c r) hashv H)
                        (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.entry.first
                        ((AspisV8R19.MemoizedProgramLaw.eval H
                                  (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post
                                    final)).2.entry.second
                          AspisR1.S2W_D189Wrappers.secondSizes)
                        saved f s ∧
                      AspisR1.MultiproofConeCanonical.bytesOf ↑s.checkpoint =
                        AspisR1.MultiproofConeCanonical.bytesOf ↑saved
@AspisR1.ART_Carrier.projection : ∀ {A F C : Type} (c : AspisR1.DrvC_Installation.Configuration F C)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (id : AspisR1.S2W_ExtractionBoundary.Program)
  (a : AspisR1.SCE_Experiment.Adversary A) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (run : AspisR1.F3T_Experiment.RunView),
  (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.ART_Runtime.runtime c hashv copy allocator id a)).2 = Option.some run →
    run.2.1.stored = (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.SCE_Experiment.submission a)).2.stored ∧
      run.2.1.physical.bytes =
        (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.SCE_Experiment.submission a)).2.publicBytes
@AspisR1.ART_Carrier.checkpoint : ∀ {A C Tx : Type}
  (base : AspisR1.DrvC_Installation.Configuration AspisR1.FIo_Install.W C) (err : C)
  (reservation : AspisR1.NP6_StdModel.Reservation)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record)),
  AspisR1.S2W_TrustedStd.TrustedStd copy →
    ∀ (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (native1 : AspisR1.S2W_ExtractionBoundary.First)
      (native2 : AspisR1.S2W_ExtractionBoundary.Second),
      AspisR1.S2W_DigestExtraction.AeneasExtraction
          (AspisR1.DrvC_Installation.sdk (AspisR1.FIp_Install.configuration err base reservation)) native1 native2
          hashv →
        ∀ (a : AspisR1.SCE_Experiment.Adversary A)
          (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
          (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
          (post1 post2 : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record)) (final1 final2 : A),
          AspisR1.S2W_D189Wrappers.first native1 copy allocator (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.entry
                AspisR1.CPH_Program.verifier (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.data
                (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.state =
              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post1, final1)) →
            (have j :=
                (AspisV8R19.MemoizedProgramLaw.eval H
                    (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1 final1)).2;
              AspisR1.S2W_D189Wrappers.second native2 allocator j.entry AspisR1.CPH_Program.verifier j.data j.slot
                  j.state =
                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (post2, final2))) →
              ∀ (p : AspisR1.CPG_Projection.Observations Tx A) (t u : Tx)
                (actions : List (AspisR1.CPP_BankState.Action A)),
                AspisR1.CPH_Game.DeployedPairExecution p t u (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.entry
                    (AspisV8R19.MemoizedProgramLaw.eval H
                          (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1 final1)).2.entry
                    saved actions native1 native2 copy allocator AspisR1.CPH_Program.verifier →
                  AspisR1.CPR_DataPersistence.TwoTransactionLaw (AspisR1.CPG_Projection.adjacent p)
                      (AspisR1.CPG_Projection.ordinary p (AspisR1.Hist_Nonvacuity.key 0#u8))
                      (AspisR1.CPG_Projection.before p) (AspisR1.CPG_Projection.tentative p)
                      (AspisR1.CPG_Projection.success p) (AspisR1.CPG_Projection.loaded p) →
                    AspisR1.MultiproofConeCanonical.bytesOf
                        ↑((AspisV8R19.MemoizedProgramLaw.eval H
                                    (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1
                                      final1)).2.entry.buffers
                            ((AspisV8R19.MemoizedProgramLaw.eval H
                                        (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1
                                          final1)).2.entry.handles
                                6).1) =
                      AspisR1.MultiproofConeCanonical.bytesOf ↑saved
'AspisR1.ARU_Carrier.exact' depends on axioms: [propext, Classical.choice, Quot.sound]
