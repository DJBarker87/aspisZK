@AspisR1.ARQ_SourceAlternative.accepted : ∀ {W A CoreError Tx : Type}
  (L : AspisR1.S2Trust.Library W (ℕ → AspisR1.S2W_D189Entry.Record)),
  AspisR1.S2Trust.S2TrustedSdkBorrow L →
    ∀
      (copy :
        AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
          ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record)),
      AspisR1.S2W_TrustedStd.TrustedStd copy →
        ∀ (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (a : AspisR1.SCE_Experiment.Adversary A) (w1 w2 : W)
          (c : AspisR1.DrvC_Installation.Configuration AspisR1.FIo_Install.W CoreError) (indexError : CoreError)
          (reservation : AspisR1.NP6_StdModel.Reservation) (native1 : AspisR1.S2W_ExtractionBoundary.First)
          (native2 : AspisR1.S2W_ExtractionBoundary.Second)
          (hashv : AspisR1.S2Z.Oracle.Parts → Aeneas.Std.Result AspisR1.S2Z.Oracle.Digest),
          AspisR1.S2W_DigestExtraction.AeneasExtraction
              (AspisR1.DrvC_Installation.sdk (AspisR1.FIp_Install.configuration indexError c reservation)) native1
              native2 hashv →
            ∀ (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
              AspisR1.S2W_ExtractionBoundary.P1 sha256 H →
                AspisR1.S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
                  ∀ (final1 final2 : A) (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
                    (post1 post2 : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record)),
                    AspisR1.S2W_D189Consolidation.RuntimeEntrypointAdmission L
                        (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.entry w1 3 →
                      AspisR1.S2W_D189Consolidation.RuntimeEntrypointAdmission L
                          (AspisV8R19.MemoizedProgramLaw.eval H
                                (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1 final1)).2.entry
                          w2 7 →
                        AspisR1.S2W_D189Wrappers.first native1 copy allocator
                              (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.entry AspisR1.CPH_Program.verifier
                              (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.data
                              (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.state =
                            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post1, final1)) →
                          AspisR1.S2W_D189Wrappers.second native2 allocator
                                (AspisV8R19.MemoizedProgramLaw.eval H
                                      (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1
                                        final1)).2.entry
                                AspisR1.CPH_Program.verifier
                                (AspisV8R19.MemoizedProgramLaw.eval H
                                      (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1
                                        final1)).2.data
                                (AspisV8R19.MemoizedProgramLaw.eval H
                                      (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1
                                        final1)).2.slot
                                (AspisV8R19.MemoizedProgramLaw.eval H
                                      (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1
                                        final1)).2.state =
                              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (post2, final2)) →
                            ∀ (root : Aeneas.Std.Array Aeneas.Std.U8 32#usize) (length : Aeneas.Std.U32)
                              (prior :
                                AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes
                                  AspisV8R19.SourceDuplexStep.State Unit)
                              (words : AspisR1.CanonicalCutEnrichedTranscript.Words)
                              (p : AspisR1.CPG_Projection.Observations Tx A) (t u : Tx)
                              (actions : List (AspisR1.CPP_BankState.Action A)),
                              AspisR1.CPH_Game.DeployedPairExecution p t u
                                  (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.entry
                                  (AspisV8R19.MemoizedProgramLaw.eval H
                                        (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1
                                          final1)).2.entry
                                  saved actions native1 native2 copy allocator AspisR1.CPH_Program.verifier →
                                AspisR1.CPR_DataPersistence.TwoTransactionLaw (AspisR1.CPG_Projection.adjacent p)
                                    (AspisR1.CPG_Projection.ordinary p (AspisR1.Hist_Nonvacuity.key 0#u8))
                                    (AspisR1.CPG_Projection.before p) (AspisR1.CPG_Projection.tentative p)
                                    (AspisR1.CPG_Projection.success p) (AspisR1.CPG_Projection.loaded p) →
                                  ∀ (Q0 Q1 : ℕ),
                                    (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
                                        (AspisV8R19.MemoizedProgramLaw.eval H a.first).1.length ≤ Q0) →
                                      (∀ (i : AspisR1.GExq_AccountExperiment.FirstInputs A)
                                          (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
                                          (post : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record)) (final : A)
                                          (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
                                          (AspisV8R19.MemoizedProgramLaw.eval H
                                                  (a.second i saved post final)).1.length ≤
                                            Q1) →
                                        have r := AspisR1.FIp_Install.configuration indexError c reservation;
                                        (AspisV8R19.MemoizedProgramLaw.eval H
                                                (AspisR1.F3T_Installed.source r hashv
                                                  (AspisR1.F3T_ByteCarrier.input r
                                                    (AspisV8R19.MemoizedProgramLaw.eval H
                                                        (AspisR1.SCE_Experiment.submission a)).2))).2 =
                                            Bool.true ∨
                                          AspisR1.BinRawByteCollisionTargets.event
                                            AspisR1.SelectedTranscriptParams.params.iv (Q0 + Q1 + 2965)
                                            (AspisV8R19.MemoizedProgramLaw.eval H
                                              (AspisR1.Hiq_RecordedJoint.program
                                                (AspisR1.SCE_Experiment.account r hashv copy allocator
                                                  AspisR1.CPH_Program.verifier a)
                                                AspisR1.ARQ_Observer.project
                                                (AspisR1.ARQ_Observer.select r AspisR1.CPH_Program.verifier)))
@AspisR1.ARU_FullSourceAlternative.accepted : ∀ {W A C Tx : Type}
  (L : AspisR1.S2Trust.Library W (ℕ → AspisR1.S2W_D189Entry.Record))
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A)
  (c : AspisR1.DrvC_Installation.Configuration AspisR1.FIo_Install.W C) (err : C) (r : AspisR1.NP6_StdModel.Reservation)
  (native1 : AspisR1.S2W_ExtractionBoundary.First) (native2 : AspisR1.S2W_ExtractionBoundary.Second)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest),
  AspisR1.S2W_DigestExtraction.AeneasExtraction
      (AspisR1.DrvC_Installation.sdk (AspisR1.FIp_Install.configuration err c r)) native1 native2 hashv →
    ∀ (a : AspisR1.SCE_Experiment.Adversary A) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
      (n : AspisR1.ARU_Support.At L copy allocator c err r native1 native2 hashv a H),
      AspisR1.S2W_TrustedStd.TrustedStd copy →
        ∀ (Q : ℕ),
          AspisR1.ART_AdversaryWork.Bound (AspisR1.FIp_Install.configuration err c r) hashv copy allocator
              AspisR1.CPH_Program.verifier a Q →
            (AspisV8R19.MemoizedProgramLaw.eval H
                    (AspisR1.F3T_Installed.source (AspisR1.FIp_Install.configuration err c r) hashv
                      (AspisR1.F3T_ByteCarrier.input (AspisR1.FIp_Install.configuration err c r)
                        (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.SCE_Experiment.submission a)).2))).2 =
                Bool.true ∨
              AspisR1.BinRawByteCollisionTargets.event AspisR1.SelectedTranscriptParams.params.iv (Q + 2965)
                (AspisV8R19.MemoizedProgramLaw.eval H
                  (AspisR1.Hiq_RecordedJoint.program
                    (AspisR1.ART_PartialAccount.account (AspisR1.FIp_Install.configuration err c r) hashv copy allocator
                      AspisR1.CPH_Program.verifier a)
                    AspisR1.ARQ_Observer.project
                    (AspisR1.ARQ_Observer.select (AspisR1.FIp_Install.configuration err c r)
                      AspisR1.CPH_Program.verifier)))
'AspisR1.ARU_FullSourceAlternative.accepted' depends on axioms: [propext, Classical.choice, Quot.sound]
