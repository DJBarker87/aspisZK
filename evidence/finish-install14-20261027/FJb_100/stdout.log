    native2 hashv extraction sha256 H p1 syscall data1 data2 slot state1 state2 final1 final2 saved post1 post2
    accepted1 accepted2 root length prior words p t u actions game RuntimePersistence D P Q0 Q1 queries runtime
    (AspisR1.FIr_GlobalOwners.complete (AspisR1.FIq_Install.configuration indexError c reservation)
      (AspisR1.Rc2_Install.configuration
          (AspisR1.Rc5_Install.seed indexError (AspisR1.FIq_Install.select reservation c)) reservation).boundaries
