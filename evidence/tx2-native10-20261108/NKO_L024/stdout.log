theorem NKO_C09.child_at_actual : ∀ (wr rr : NP6_StdModel.Reservation) (merkle : Merkle) (finish : Finish) {H : Type}
  (d : aspis_core.digest.Digest32 H) (pub proof ck : Slice U8) (hash : H) (v : verifier.View) (p : verifier.Prepared)
  (a : verifier.Accumulator) (reply : R Unit),
  Event.finish v p a reply ∈ (run wr rr (fun {H} => merkle) finish d pub proof ck hash none).events →
    ∀ (r : NP6_StdModel.Reservation) (loc : NIW_AlignFinishComposed.Locations),
      have execution := NJF_FinishObserved.G r loc v p a;
      Port3_NativeFinishBody.verifier.finish_relation (NIG_Slots.installed r) v p a none = execution.1 ∧
        NIW_AlignFinishComposedLog.forget execution = NIW_AlignFinishExecution.run r v p a ∧
          NIW_AlignFinishPrefix.Prefix execution.2.1 :=
fun wr rr merkle finish {H} d pub proof ck hash v p a reply entered r loc =>
  NKE_FinishSupplement.finish r loc proof v p a
    (source wr rr (fun {H} => merkle) finish d pub proof ck hash (Event.finish v p a reply) entered)
'NKO_C09.bounds_at_actual' depends on axioms: [propext, Classical.choice, Quot.sound]
'NKO_C09.child_at_actual' depends on axioms: [propext, Classical.choice, Quot.sound]
