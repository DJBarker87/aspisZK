theorem Port31DATA.eq_true_of_not_eq_false : ∀ {b : Bool} (h : @Ne.{1} Bool b Bool.false), @Eq.{1} Bool b Bool.true :=
fun {b : Bool} (h : @Ne.{1} Bool b Bool.false) =>
  @Bool.casesOn.{0} (fun (t : Bool) => ∀ (h : @Eq.{1} Bool b t), @Eq.{1} Bool b Bool.true) b
    (fun (h_1 : @Eq.{1} Bool b Bool.false) =>
