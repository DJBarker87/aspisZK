          @False.elim.{0} (@Eq.{1} Bool Bool.false Bool.true) (h (@rfl.{1} Bool Bool.false)))
        b (@Eq.symm.{1} Bool b Bool.false h_1) h)
    (fun (h_1 : @Eq.{1} Bool b Bool.true) =>
      @Eq.ndrec.{0, 1} Bool Bool.true (fun {b : Bool} => ∀ (h : @Ne.{1} Bool b Bool.false), @Eq.{1} Bool b Bool.true)
