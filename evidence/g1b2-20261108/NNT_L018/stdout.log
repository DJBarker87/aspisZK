NNT_TopL.top_splitB_counts : ∀ (S : RSL.TAS.Sig) (L : RSL.PoolLib) (D : RSL.DeployedIds) (V0 : RSL.TX2_241.V2Lib)
  (VL : RSL.VLib) (P : RSL.PreparedNew VL) (C : RSL.TX1_345.S1Lib VL) (I : RSL.TAS.Impl L V0 VL) (sp : RSL.TFM.Split S),
  RSL.TAS.Headline S →
    RSL.TAS.A0_Digest S →
      RSL.TAS.NMM_Roots L D V0 VL I →
        RSL.TAS.NMX_Root L D V0 VL I →
