                                                      (∃ s',
                                                          Eq.{1} (I.entry (S.args1 c) (S.state1 c) (S.env1 c)).exit
                                                            (RSL.Exit.ret (Prod.mk.{0, 0} (Except.ok.{0, 0} ()) s'))) →
