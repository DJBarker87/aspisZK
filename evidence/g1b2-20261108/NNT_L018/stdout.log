            RSL.TAS.NMV_Roots L D V0 VL P C I →
              RSL.TAS.NMW_Roots L D V0 VL P C I →
                RSL.TAS.NMT_Roots L V0 VL P C I →
                  RSL.TAS.NMP_Roots L V0 VL P I →
                    RSL.TAS.NMO_Root L V0 VL I →
                      ∀ (g1a : RSL.NNT.NNC_G1aL S L V0 VL I) (R : RSL.EVB.RecSig S),
                        RSL.EVB.RecSelect S R →
                          ∀ (hb : RSL.EVB.HeadlineB S R),
                            NNT_TopL.NNC_NMFPrimeB S L D V0 VL P C I g1a R →
                              RSL.TAS.NNC_R0Rep S V0 →
                                RSL.TAS.NND_A1 S VL P C →
