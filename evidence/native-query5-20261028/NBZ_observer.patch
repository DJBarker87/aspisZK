+//! Diagnostic isolation of the observer failure. Restricted fixtures are not
+//! caller coverage and are never used for native bridge credit.
+extern crate alloc;
+include!("KMX_stubs.rs");
+use super::*;
+static mut NBZ_CALLS:usize=0;
+fn NBZ_check(obs:Observer,_p:Phase){assert!(obs.is_none());unsafe{NBZ_CALLS+=1;}}
+fn NBZ_wrong(obs:Observer,_p:Phase){assert!(obs.is_some());unsafe{NBZ_CALLS+=1;}}
+fn NBZ_after(a:Accumulator,b:BatchedWeights,i:usize,obs:Observer)->Result<(Accumulator,BatchedWeights),Error>{mark(obs,Phase::Query(i));Ok((a,b))}
+fn NBZ_empty_case(){
+ let i:usize=kani::any();kani::assume(i<10);
+ let a=Accumulator{weights:Vec::new(),rhs:E::ZERO,power:K::ZERO,next:i};let b=BatchedWeights{raw:Vec::new(),terms:i};
+ let(a,b)=NBZ_after(a,b,i,None).unwrap();assert_eq!(a.next,i);assert_eq!(b.terms,i);unsafe{assert_eq!(NBZ_CALLS,1);}
+}
+fn NBZ_full_case(){
+ let i:usize=kani::any();kani::assume(i<10);
+ let a=Accumulator{weights:Vec::from([K::ZERO;64]),rhs:E::ZERO,power:K::ZERO,next:i};let b=BatchedWeights{raw:Vec::from([[0;4];64]),terms:i};
+ let(a,b)=NBZ_after(a,b,i,None).unwrap();assert_eq!(a.next,i);assert_eq!(b.terms,i);assert_eq!(a.weights.len(),64);assert_eq!(b.raw.len(),64);unsafe{assert_eq!(NBZ_CALLS,1);}
+}
