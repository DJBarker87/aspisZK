inductive NBZ_Carrier.Fill : {α : Type} →
  (ℕ → α) → ℕ → ℕ → Aeneas.Std.alloc.vec.Vec α → Aeneas.Std.alloc.vec.Vec α → Prop
number of parameters: 3
constructors:
NBZ_Carrier.Fill.nil : ∀ {α : Type} {source : ℕ → α} (start : ℕ) (raw : Aeneas.Std.alloc.vec.Vec α),
  NBZ_Carrier.Fill source start 0 raw raw
NBZ_Carrier.Fill.step : ∀ {α : Type} {source : ℕ → α} {start count : ℕ} {before mid : Aeneas.Std.alloc.vec.Vec α},
  NBZ_Carrier.Fill source start count before mid →
    ∀ (index : Aeneas.Std.Usize),
      ↑index = start + count →
        ↑index < (↑mid).length → NBZ_Carrier.Fill source start (count + 1) before (mid.set index (source ↑index))
def NBZ_Wide.product : AspisR1Stage2.Stage2E → AspisR1Stage2.Stage2E → Aeneas.Std.Result AspisR1Stage2.Stage2E :=
fun x y => do
  let ac ← AspisR1SelectedMaskProbe.field.QM31.mul (NBO_FieldPorts.toQ x.c0) (NBO_FieldPorts.toQ y.c0)
  let bd ← AspisR1SelectedMaskProbe.field.QM31.mul (NBO_FieldPorts.toQ x.c1) (NBO_FieldPorts.toQ y.c1)
  let xs ← AspisR1SelectedMaskProbe.field.QM31.add (NBO_FieldPorts.toQ x.c0) (NBO_FieldPorts.toQ x.c1)
  let ys ← AspisR1SelectedMaskProbe.field.QM31.add (NBO_FieldPorts.toQ y.c0) (NBO_FieldPorts.toQ y.c1)
  let cross ← xs.mul ys
  let ub ← NBZ_Wide.u bd
  let lo ← ac.add ub
  let hi0 ← NBO_FoldLinear.qsub cross ac
  let hi ← NBO_FoldLinear.qsub hi0 bd
  Aeneas.Std.Result.ok (NBO_FieldPorts.fromE (lo, hi))
def NBZ_Folds.circle : AspisR1Stage2.Stage2E →
  AspisR1Stage2.Stage2E →
    AspisR1Stage2.Stage2E →
      AspisR1Stage2.Stage2E →
        AspisR1Stage2.Stage2E →
          Aeneas.Std.U32 → Aeneas.Std.U32 → Aeneas.Std.U32 → Aeneas.Std.U32 → Aeneas.Std.Result AspisR1Stage2.Stage2E :=
fun alpha a b c d quarter qiy qix qixiy => do
  let h0 ← NBW_Coefficients.coefficient a b c d true true true quarter
  let h1 ← NBW_Coefficients.coefficient a b c d false false true qiy
  let h2 ← NBW_Coefficients.coefficient a b c d true false false qix
  let h3 ← NBW_Coefficients.coefficient a b c d false true false qixiy
  NBW_Horner.eval NBZ_Wide.product alpha [h0, h1, h2] h3
def NBZ_Folds.line : AspisR1Stage2.Stage2E →
  AspisR1Stage2.Stage2E →
    AspisR1Stage2.Stage2E →
      AspisR1Stage2.Stage2E →
        AspisR1Stage2.Stage2E →
          Aeneas.Std.U32 →
            Aeneas.Std.U32 →
              Aeneas.Std.U32 →
                Aeneas.Std.U32 → Aeneas.Std.U32 → Aeneas.Std.U32 → Aeneas.Std.Result AspisR1Stage2.Stage2E :=
fun alpha a b c d quarter qiz hix hiy half hiz => do
  let h0 ← NBW_Coefficients.coefficient a b c d true true true quarter
  let h2 ← NBW_Coefficients.coefficient a b c d true false false qiz
  let ab ← NBO_FoldLinear.sub a b
  let c0 ← NBO_FoldLinear.scale ab hix
  let dc ← NBO_FoldLinear.sub d c
  let c1 ← NBO_FoldLinear.scale dc hiy
  let sum ← NBO_FieldSemantics.add c0 c1
  let h1 ← NBO_FoldLinear.scale sum half
  let diff ← NBO_FoldLinear.sub c0 c1
  let h3 ← NBO_FoldLinear.scale diff hiz
  NBW_Horner.eval NBZ_Wide.product alpha [h0, h1, h2] h3
