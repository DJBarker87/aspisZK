theorem NBO_WriterEntry.same_writer : ∀ (base : VTop_Stages.Ops) (reserved : Bool)
  (ops : AspisR1.Port3_NativeQueryBody.Ops),
  NBO_ProducerDomains.NBA_NBC base ops →
    NBO_Entry.NBC_Bounds base →
      NBO_QueryDomains.Lower ops →
        NBO_FieldSemantics.NBC_Bindings ops →
          ∀ {Hash : Type} (D : VTop_Stages.aspis_core.digest.Digest32 Hash) (hash : Hash)
            (semantic : VTop_Stages.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public)
            (proof : Aeneas.Std.Slice Aeneas.Std.U8) (split : Aeneas.Std.Usize) (p : AspisR1Stage2.verifier.Prepared)
            (a : AspisR1Stage2.verifier.Accumulator),
            AspisR1.VTop_Provenance.WriterPrefix (NBO_TopInstall.install base reserved ops) D hash semantic proof split
                none p a →
              ∃ g initial pending geometry after,
                NBO_Entry.Prelude base reserved D hash semantic proof split p g initial pending geometry ∧
                  NBO_Composite.source ops proof p initial g geometry pending =
                      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (a, after)) ∧
                    NBO_Composite.reference ops proof p initial g geometry pending =
                      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (a, after)) :=
fun base reserved ops producers bounds lower bindings {Hash} D hash semantic proof split p a reached =>
  let ⟨zero, h✝⟩ := reached
  let ⟨g, h✝¹⟩ := h✝
  let ⟨prep, h✝²⟩ := h✝¹
  let ⟨initial, h✝³⟩ := h✝²
  let ⟨root, h✝⁴⟩ := h✝³
  let ⟨geometry, h✝⁵⟩ := h✝⁴
  let ⟨pending, h✝⁶⟩ := h✝⁵
  let ⟨returned, h✝⁷⟩ := h✝⁶
  let ⟨flushed, h✝⁸⟩ := h✝⁷
  let ⟨parsed, h✝⁹⟩ := h✝⁸
  let ⟨sv, h✝¹⁰⟩ := h✝⁹
  let ⟨hs, right✝⟩ := h✝¹⁰
  let ⟨hsv, right✝¹⟩ := right✝
  let ⟨hparse, right✝²⟩ := right✝¹
  let ⟨hscan, right✝³⟩ := right✝²
  let ⟨hzero, right✝⁴⟩ := right✝³
  let ⟨hprep, right✝⁵⟩ := right✝⁴
  let ⟨hbranch, right✝⁶⟩ := right✝⁵
  let ⟨hinit, right✝⁷⟩ := right✝⁶
  let ⟨hbatch, right✝⁸⟩ := right✝⁷
  let ⟨hgeom, right✝⁹⟩ := right✝⁸
  let ⟨hpending, right✝¹⁰⟩ := right✝⁹
  let ⟨hquery, right✝¹¹⟩ := right✝¹⁰
  let ⟨hflush, right✝¹²⟩ := right✝¹¹
  let ⟨hw, right✝¹³⟩ := right✝¹²
  let ⟨hr, right✝¹⁴⟩ := right✝¹³
  let ⟨hp, hn⟩ := right✝¹⁴
  have split10 :=
    have same := Aeneas.Std.Result.ok.inj hs;
    Eq.ndrec (motive := fun sv =>
      (NBO_TopInstall.install base reserved ops).op16 = Aeneas.Std.Result.ok sv → ↑split = ↑sv → ↑split = 10)
      (fun hs hsv => hsv) same hs hsv;
  have splitEq := Aeneas.Std.UScalar.eq_of_val_eq split10;
  have entry :=
    Exists.intro zero
      (Exists.intro prep
        (Exists.intro root
          (Exists.intro parsed
            ⟨split10, ⟨hparse, ⟨hscan, ⟨hzero, ⟨hprep, ⟨hbranch, ⟨hinit, ⟨hbatch, ⟨hgeom, hpending⟩⟩⟩⟩⟩⟩⟩⟩⟩)));
  have query :=
    id
      (fun hquery =>
        have h :=
          (AspisR1.Port3_QueryInstall.success_iff
                (AspisR1.Port3_NativeQueryBody.verifier.candidate.query_loop (NBF_Accumulate.install ops) proof p
                  initial g (AspisR1.Port3_QueryInstall.observer none) geometry pending split)
                returned).mp
            hquery;
        Eq.mp
          (congrFun'
            (congrArg Eq
              (congrArg
                (AspisR1.Port3_NativeQueryBody.verifier.candidate.query_loop (NBF_Accumulate.install ops) proof p
                  initial g none geometry pending)
                splitEq))
            (Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok returned)))
          h)
      hquery;
  have weightsEq := Subtype.ext (Eq.symm hw);
  have same :=
    id
      (Eq.mpr
        (id
          (congrArg
            (fun _a => { weights := _a, rhs := returned.1.rhs, power := returned.1.power, next := returned.1.next } = a)
            weightsEq))
        (Eq.mpr
          (id
            (congrArg
              (fun _a => { weights := a.weights, rhs := _a, power := returned.1.power, next := returned.1.next } = a)
              (Eq.symm hr)))
          (Eq.mpr
            (id
              (congrArg (fun _a => { weights := a.weights, rhs := a.rhs, power := _a, next := returned.1.next } = a)
                (Eq.symm hp)))
            (Eq.mpr
              (id
                (congrArg (fun _a => { weights := a.weights, rhs := a.rhs, power := a.power, next := _a } = a)
                  (Eq.symm hn)))
              (Eq.refl { weights := a.weights, rhs := a.rhs, power := a.power, next := a.next })))));
  id
    (fun hflush =>
      have source :=
        of_eq_true
          (Eq.trans
            (congrFun'
              (congrArg Eq
                (Eq.trans
                  (Eq.trans
                    (congrFun' (congrArg bind query) fun result =>
                      match result with
                      | Aeneas.Std.core.result.Result.Err error =>
                        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err error)
                      | Aeneas.Std.core.result.Result.Ok (a, b) => do
                        let finished ← AspisR1.Port3_FlushInstall.flush b a.weights.deref
                        Aeneas.Std.Result.ok
                            (Aeneas.Std.core.result.Result.Ok
                              ({ weights := ⟨↑finished, NBO_Composite.finishResult._proof_1 finished⟩, rhs := a.rhs,
                                  power := a.power, next := a.next },
                                b)))
                    (Aeneas.Std.bind_tc_ok (Aeneas.Std.core.result.Result.Ok returned) fun y =>
                      match y with
                      | Aeneas.Std.core.result.Result.Err error =>
                        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err error)
                      | Aeneas.Std.core.result.Result.Ok (a, b) => do
                        let finished ← AspisR1.Port3_FlushInstall.flush b a.weights.deref
                        Aeneas.Std.Result.ok
                            (Aeneas.Std.core.result.Result.Ok
                              ({ weights := ⟨↑finished, NBO_Composite.finishResult._proof_1 finished⟩, rhs := a.rhs,
                                  power := a.power, next := a.next },
                                b))))
                  (Eq.trans
                    (Eq.trans
                      (congrFun' (congrArg bind hflush) fun finished =>
                        Aeneas.Std.Result.ok
                          (Aeneas.Std.core.result.Result.Ok
                            ({ weights := ⟨↑finished, NBO_Composite.finishResult._proof_1 finished⟩,
                                rhs := returned.1.rhs, power := returned.1.power, next := returned.1.next },
                              returned.2)))
                      (Aeneas.Std.bind_tc_ok flushed fun y =>
                        Aeneas.Std.Result.ok
                          (Aeneas.Std.core.result.Result.Ok
                            ({ weights := ⟨↑y, NBO_Composite.finishResult._proof_1 y⟩, rhs := returned.1.rhs,
                                power := returned.1.power, next := returned.1.next },
                              returned.2))))
                    (congrArg Aeneas.Std.Result.ok
                      (congrArg Aeneas.Std.core.result.Result.Ok (congrFun' (congrArg Prod.mk same) returned.2))))))
              (Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (a, returned.2))))
            (eq_self (Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (a, returned.2)))));
      have assoc :=
        NBO_Entry.association base reserved ops producers bounds lower bindings D hash semantic proof split p g initial
          pending geometry entry;
      Exists.intro g
        (Exists.intro initial
          (Exists.intro pending
            (Exists.intro geometry (Exists.intro returned.2 ⟨entry, ⟨source, Eq.trans (Eq.symm assoc) source⟩⟩)))))
    hflush
