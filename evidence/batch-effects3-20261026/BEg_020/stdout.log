AspisR1.Port4B_BatchJoin.compose : ∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (occupied sibling : AspisR1.MultiproofConeP6Callbacks.Parent) (leaf : AspisR1.MultiproofConeP6Batch.Leaf)
  (parsed : AspisR1.OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144)
  (nodes : ℕ → ℕ → Aeneas.Std.Slice Aeneas.Std.U8) (batch : ℕ) (s0 s1 s2 : MultiproofConeRef.reference.Scratch)
  (l0 l1 l2 : List (AspisV8R19.DuplexFrames.Bytes × AspisV8R19.SourceDuplexStep.State)),
  AspisV8R19.MemoizedProgramLaw.eval H
        (AspisR1.MultiproofConeP6Batch.batch_tree (AspisR1.MultiproofConeP6Callbacks.nodeWith occupied sibling) leaf
          parsed q batch 0 (nodes batch 0) AspisR1.Port4B_BatchJoin.initial) =
      (l0, true, s0) →
