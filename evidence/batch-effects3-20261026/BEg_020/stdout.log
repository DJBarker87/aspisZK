          (AspisR1.MultiproofConeP6Batch.batch_tree (AspisR1.MultiproofConeP6Callbacks.nodeWith occupied sibling) leaf
            parsed q batch 1 (nodes batch 1) s0) =
        (l1, true, s1) →
      AspisV8R19.MemoizedProgramLaw.eval H
            (AspisR1.MultiproofConeP6Batch.batch_tree (AspisR1.MultiproofConeP6Callbacks.nodeWith occupied sibling) leaf
              parsed q batch 2 (nodes batch 2) s1) =
          (l2, true, s2) →
        AspisV8R19.MemoizedProgramLaw.eval H
            (AspisR1.MultiproofConeP6Frozen2Stage.sourceBatch occupied sibling leaf parsed q nodes batch
              AspisR1.Port4B_BatchJoin.initial) =
