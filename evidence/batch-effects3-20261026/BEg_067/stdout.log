def AspisR1.SdkC_BatchSource.code : {Hash : Type} →
  AspisR1Stage2.aspis_core.digest.Digest32 Hash →
    Hash →
      Aeneas.Std.Slice Aeneas.Std.U8 →
        Aeneas.Std.Array Aeneas.Std.U32 22#usize →
          Aeneas.Std.Array (Aeneas.Std.Array Aeneas.Std.U8 32#usize) 2#usize →
            Aeneas.Std.Array Aeneas.Std.U8 32#usize →
              Aeneas.Std.Usize →
                AspisR1.SdkC_Source.Code (Aeneas.Std.core.result.Result Unit AspisR1Stage2.verifier.Error) :=
fun {Hash} D hash proof queries roots folded which => do
  let root0 ← AspisR1.CheckpointBytes5Effect.liftResult (roots.index_usize 0#usize)
  let root1 ← AspisR1.CheckpointBytes5Effect.liftResult (roots.index_usize 1#usize)
  AspisR1.Port9OR_Batch.values AspisR1.Port4B_Install.leaves D hash proof queries
      (Aeneas.Std.Array.make 3#usize [root0, root1, folded] ⋯) which
def AspisR1.SdkC_BatchSource.mapCode : {Err : Type} →
  (AspisR1Stage2.verifier.Error → Err) →
    AspisR1.SdkC_Source.Code (Aeneas.Std.core.result.Result Unit AspisR1Stage2.verifier.Error) →
      AspisR1.SdkC_Source.Code (Aeneas.Std.core.result.Result Unit Err) :=
fun {Err} map body => do
  let value ← body
  pure
      (match value with
      | Aeneas.Std.core.result.Result.Ok x => Aeneas.Std.core.result.Result.Ok x
      | Aeneas.Std.core.result.Result.Err e => Aeneas.Std.core.result.Result.Err (map e))
