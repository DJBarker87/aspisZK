AspisR1.SdkC_GlobalRecovery.indexed_recovery_or_collision : ∀
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) (stored : AspisV8R19.DuplexFrames.Bytes)
  (parsed : AspisR1.OraclePortCompactDraft.Parsed),
  AspisR1.OraclePortCompactDraft.parse stored = some parsed →
    ∀ (q : Fin 22 → Fin 262144) (kind pos : ℕ),
      kind < 3 →
        pos < 22 →
          ∀
            (path :
              AspisR1.BinMerkle32Path.Path
                (AspisR1.BinMultiproof.slots 18 (AspisR1.OraclePortSelectedDraft.index q kind pos))),
            AspisR1.BinMerkle32Path.foldPath H path (H (AspisR1.OraclePortSelectedDraft.leaf parsed kind pos)) =
                AspisR1.OraclePortBatchDraft.committedRoot parsed kind →
              ∀ (log : List (AspisV8R19.DuplexFrames.Bytes × AspisV8R19.SourceDuplexStep.State)) (Q : ℕ),
                (∀ a ∈ log, a.2 = H a.1) →
                  (∀
                      a ∈
                        AspisR1.BinMerkle32Leaf.fullTrace H path (AspisR1.OraclePortSelectedDraft.leaf parsed kind pos),
                      FS2.Duplex.Read log a) →
                    FS.firstReads FS.emptyTable log ≤ Q →
                      ∀ (frame : AspisV8R19.DuplexFrames.Bytes) (j : Fin 5),
                        FS2.Duplex.Read log frame →
                          AspisR1.BinRawByteCollisionTargets.pred j frame =
                              some (AspisR1.OraclePortBatchDraft.committedRoot parsed kind) →
                            FS.hitsBad
                                (AspisR1.AllAddressCollision.bad AspisR1.SelectedTranscriptParams.params.iv
                                  AspisR1.BinRawByteCollisionTargets.pred Q)
                                FS.emptyTable log ∨
                              AspisR1.OraclePortAllSelectedRecoveryC6.recovered log frame parsed kind
                                  (AspisR1.OraclePortSelectedDraft.index q kind pos) =
                                some (AspisR1.OraclePortPackedChoiceC4.payload parsed kind pos)
