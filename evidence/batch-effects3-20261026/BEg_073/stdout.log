@AspisR1.SdkC_GlobalRecovery.collision_bound : ∀ {A : Type} (code : AspisR1.SdkC_Source.Code A) (Q : ℕ),
  (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      FS.firstReads FS.emptyTable (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.SdkC_Oracle.program code)).1 ≤ Q) →
    (AspisV8R19.MemoizedProgramLaw.lazyMean (AspisR1.SdkC_Oracle.program code) FS.emptyTable fun view =>
        AspisV8R19.CausalFirstHitUnionBound.indicator
          (AspisR1.BinRawByteCollisionTargets.event AspisR1.SelectedTranscriptParams.params.iv Q view)) ≤
      6 * ↑Q ^ 2 / 256 ^ 32
