  (obs : Option (VTop_Stages.verifier.Phase → Aeneas.Std.Result Unit)) (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8),
  VTop_Stages.verifier.candidate.tx1 ops D semantic pub proof split hash obs =
