@AspisR1.Port4B_PhysicalCalls.tx2_slots : ∀ {CoreError W : Type} (base : VTop_Stages.Ops) (reserved : Bool)
  (leaves : AspisR1.Port3_NativeBatchBody.Ops) (geometry : AspisR1.Port3_NativeGeometryBody.Ops CoreError)
  (query : AspisR1.Port3_NativeQueryBody.Ops) (finish : AspisR1Stage2.Stage2Finish.FinishOps W) {Hash : Type}
  (D : VTop_Stages.aspis_core.digest.Digest32 Hash) (hash : Hash)
  (pub proof checkpoint : Aeneas.Std.Slice Aeneas.Std.U8),
  VTop_Stages.verifier.candidate.tx2_authenticated
        (AspisR1.Port3_Parents.installed base reserved leaves geometry query finish) D pub proof checkpoint hash none =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) →
    ∃ p a root,
      (AspisR1.Port3_Parents.installed base reserved leaves geometry query finish).op18 D checkpoint proof pub
