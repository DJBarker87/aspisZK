@AspisR1.Port4B_PhysicalCalls.tx1_slots : ∀ {CoreError W : Type} (base : VTop_Stages.Ops) (reserved : Bool)
  (leaves : AspisR1.Port3_NativeBatchBody.Ops) (geometry : AspisR1.Port3_NativeGeometryBody.Ops CoreError)
  (query : AspisR1.Port3_NativeQueryBody.Ops) (finish : AspisR1Stage2.Stage2Finish.FinishOps W) {Hash : Type}
  (D : VTop_Stages.aspis_core.digest.Digest32 Hash) (hash : Hash)
  (semantic : VTop_Stages.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public)
  (pub proof : Aeneas.Std.Slice Aeneas.Std.U8) (split : Aeneas.Std.Usize)
  (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8),
  VTop_Stages.verifier.candidate.tx1 (AspisR1.Port3_Parents.installed base reserved leaves geometry query finish) D
        semantic pub proof split hash none =
