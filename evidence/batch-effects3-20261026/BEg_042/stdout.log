def AspisR1.Port4B_PhysicalCalls.Slots : AspisR1.Port3_NativeBatchBody.Ops →
  {Hash : Type} →
    VTop_Stages.aspis_core.digest.Digest32 Hash →
      Hash →
        Aeneas.Std.Slice Aeneas.Std.U8 →
          VTop_Stages.verifier.Prepared → Aeneas.Std.Array Aeneas.Std.U8 32#usize → Aeneas.Std.Usize → Prop :=
fun leaves {Hash} D hash proof p folded batch =>
  ∃ idx1 idx2 idx3 val1 val2 val3,
    AspisR1.Port3_NativeBatchBody.verifier.candidate.batch_tree (AspisR1.Port3_BatchStd.install leaves)
          (AspisR1.VTop_Checkpoint.digest D) proof p.queries (AspisR1.Port3_BatchStage.root0 p) batch 0#usize
          (Aeneas.Std.Array.repeat 16#usize 0#u32)
          (Aeneas.Std.Array.repeat 16#usize (Aeneas.Std.Array.repeat 32#usize 0#u8)) hash =
        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (), idx1, val1) ∧
      AspisR1.Port3_NativeBatchBody.verifier.candidate.batch_tree (AspisR1.Port3_BatchStd.install leaves)
            (AspisR1.VTop_Checkpoint.digest D) proof p.queries (AspisR1.Port3_BatchStage.root1 p) batch 1#usize idx1
            val1 hash =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (), idx2, val2) ∧
        AspisR1.Port3_NativeBatchBody.verifier.candidate.batch_tree (AspisR1.Port3_BatchStd.install leaves)
            (AspisR1.VTop_Checkpoint.digest D) proof p.queries folded batch 2#usize idx2 val2 hash =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (), idx3, val3)
