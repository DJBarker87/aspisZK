AspisR1.Port3_NativeBatchCalls.root_read : ∀
  (roots : Aeneas.Std.Array (Aeneas.Std.Array Aeneas.Std.U8 32#usize) 3#usize) (i : Fin 3),
  roots.index_usize (↑i)#usize = Aeneas.Std.Result.ok (AspisR1.Port3_NativeBatchCalls.rootAt roots i)
'AspisR1.Port3_NativeBatchCalls.root_read' depends on axioms: [propext, Classical.choice, Quot.sound]
AspisR1.Port3_NativeBatchCalls.values_calls : ∀ (ops : AspisR1.Port3_NativeBatchBody.Ops) {Hash : Type}
  (D : AspisR1Stage2.aspis_core.digest.Digest32 Hash) (hash : Hash) (proof : Aeneas.Std.Slice Aeneas.Std.U8)
  (queries : Aeneas.Std.Array Aeneas.Std.U32 22#usize)
  (roots : Aeneas.Std.Array (Aeneas.Std.Array Aeneas.Std.U8 32#usize) 3#usize) (batch : Aeneas.Std.Usize),
  AspisR1.Port3_NativeBatchBody.verifier.candidate.batch_merkle_values ops D proof queries roots batch hash =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) →
    ∃ idx1 idx2 idx3 val1 val2 val3,
      AspisR1.Port3_NativeBatchBody.verifier.candidate.batch_tree ops D proof queries
            (AspisR1.Port3_NativeBatchCalls.rootAt roots 0) batch 0#usize (Aeneas.Std.Array.repeat 16#usize 0#u32)
            (Aeneas.Std.Array.repeat 16#usize (Aeneas.Std.Array.repeat 32#usize 0#u8)) hash =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (), idx1, val1) ∧
        AspisR1.Port3_NativeBatchBody.verifier.candidate.batch_tree ops D proof queries
              (AspisR1.Port3_NativeBatchCalls.rootAt roots 1) batch 1#usize idx1 val1 hash =
            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (), idx2, val2) ∧
          AspisR1.Port3_NativeBatchBody.verifier.candidate.batch_tree ops D proof queries
              (AspisR1.Port3_NativeBatchCalls.rootAt roots 2) batch 2#usize idx2 val2 hash =
            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (), idx3, val3)
'AspisR1.Port3_NativeBatchCalls.values_calls' depends on axioms: [propext, Classical.choice, Quot.sound]
def AspisR1.Port3_NativeBatchCalls.rootAt : Aeneas.Std.Array (Aeneas.Std.Array Aeneas.Std.U8 32#usize) 3#usize →
  Fin 3 → Aeneas.Std.Array Aeneas.Std.U8 32#usize :=
fun roots i => (↑roots)[↑i]
