@AspisR1.SdkC_Authentication.ideal_value : ∀ {A Hash : Type} (D : AspisR1Stage2.aspis_core.digest.Digest32 Hash)
  (hash : Hash) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  (∀ (parts : Aeneas.Std.Slice (Aeneas.Std.Slice Aeneas.Std.U8)),
      D.digest hash parts =
        Aeneas.Std.Result.ok
          (AspisV8R19.SqueezeOracleBridge.encodeState (H (AspisV8R19.SqueezeOracleBridge.flatten parts)))) →
    ∀ (code : AspisR1.SdkC_Source.Code A),
      (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.SdkC_Oracle.program code)).2 =
        AspisR1.CheckpointBytes5Effect.erase D hash code
'AspisR1.SdkC_Authentication.ideal_value' depends on axioms: [propext, Classical.choice, Quot.sound]
