AspisR1.Port4B_LeafInstall.selected_call : ∀ (base : AspisR1.Port3_NativeBatchBody.Ops) {X : Type}
  (D : AspisR1Stage2.aspis_core.digest.Digest32 X) (hash : X)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  (∀ (input : Aeneas.Std.Slice (Aeneas.Std.Slice Aeneas.Std.U8)),
      D.digest hash input = Aeneas.Std.Result.ok (AspisR1.MultiproofConePhysicalTransport.rawOracle H input)) →
    ∀ (proof : Aeneas.Std.Slice Aeneas.Std.U8),
      (↑proof).length = 57607 →
        ∀ (parsed : AspisR1.OraclePortCompactDraft.Parsed),
          parsed.wire = AspisR1.MultiproofConeCanonical.bytesOf ↑proof →
            ∀ (q : Fin 22 → Fin 262144) (batch pos : ℕ) (kind i : Aeneas.Std.Usize),
              pos ∈ AspisR1.OraclePortFrozenOrder.sortedPositions q batch ↑kind →
                ↑i =
                    (if batch = 0 then 0 else 10) +
                      ↑(AspisR1.MultiproofConeSortOrder.packed q batch (↑kind) pos) % 256 →
                  ∀ (before : AspisR1.CheckpointBytes5Effect.Log),
                    ∃ view,
                      (AspisR1.Port4B_LeafInstall.install base).op2 proof i = Aeneas.Std.Result.ok view ∧
                        (AspisR1.Port4B_LeafInstall.install base).op6 D hash kind view =
                            Aeneas.Std.Result.ok
                              (AspisV8R19.SqueezeOracleBridge.encodeState
                                (H (AspisR1.OraclePortSelectedDraft.leaf parsed (↑kind) pos))) ∧
                          AspisR1.CheckpointBytes5Effect.run D hash (AspisR1.Port4B_LeafCode.code kind view) before =
                              Aeneas.Std.Result.ok
                                (AspisV8R19.SqueezeOracleBridge.encodeState
                                    (H (AspisR1.OraclePortSelectedDraft.leaf parsed (↑kind) pos)),
                                  before ++
                                    [(AspisR1.Port4B_LeafCode.input kind view,
                                        AspisV8R19.SqueezeOracleBridge.encodeState
                                          (H (AspisR1.OraclePortSelectedDraft.leaf parsed (↑kind) pos)))]) ∧
                            AspisV8R19.SqueezeOracleBridge.flatten (AspisR1.Port4B_LeafCode.input kind view) =
                              AspisR1.OraclePortSelectedDraft.leaf parsed (↑kind) pos
'AspisR1.Port4B_LeafInstall.selected_call' depends on axioms: [propext, Classical.choice, Quot.sound]
def AspisR1.Port4B_LeafInstall.install : AspisR1.Port3_NativeBatchBody.Ops → AspisR1.Port3_NativeBatchBody.Ops :=
fun base =>
  { op0 := @AspisR1.Port3_NativeBatchBody.Ops.op0 base, op1 := @AspisR1.Port3_NativeBatchBody.Ops.op1 base,
    op2 := AspisR1.Port4B_Opening.opening, op3 := base.op3, op4 := base.op4, op5 := base.op5,
    op6 := fun {H} => AspisR1.Port4B_LeafCode.native, op7 := base.op7, op8 := base.op8, op9 := base.op9,
    op10 := @AspisR1.Port3_NativeBatchBody.Ops.op10 base, op11 := base.op11, op12 := base.op12, op13 := base.op13,
    unwrap8 := base.unwrap8 }
