            (Aeneas.Std.core.ops.index.IndexSlice
              (Aeneas.Std.core.slice.index.SliceIndexRangeToUsizeSlice Aeneas.Std.U32))
            idx { «end» := d } =
          Aeneas.Std.Result.ok front ∧
        base.op11 AspisR1.Port3_NativeBatchBody.multiproof.Arity.Two front = Aeneas.Std.Result.ok (some count) ∧
          base.op3 proof slot = Aeneas.Std.Result.ok nodes ∧
            (Aeneas.Std.Array.make 6#usize [146#usize, 146#usize, 128#usize, 172#usize, 172#usize, 150#usize]
                      ⋯).index_usize
                  slot =
                Aeneas.Std.Result.ok cap ∧
              ¬count > cap ∧
                Aeneas.Std.core.slice.index.Slice.index
                      (Aeneas.Std.core.slice.index.SliceIndexRangeFromUsizeSlice Aeneas.Std.U8) nodes
                      { start := Aeneas.Std.Usize.wrapping_mul 32#usize count } =
                    Aeneas.Std.Result.ok padding ∧
                  Aeneas.Std.core.slice.Slice.chunks_exact padding 8#usize = Aeneas.Std.Result.ok ce ∧
                    (AspisR1.Port3_BatchStd.install base).op0
                          (Aeneas.Std.core.iter.traits.iterator.IteratorChunksExact Aeneas.Std.U8)
                          (AspisR1.Port3_NativeBatchBody.verifier.candidate.batch_tree.closure.Insts.CoreOpsFunctionFnMutTupleSharedSliceU8Bool
                            (AspisR1.Port3_BatchStd.install base) D)
                          ce () =
                        Aeneas.Std.Result.ok (false, after) ∧
                      Aeneas.Std.core.slice.index.Slice.index
                            (Aeneas.Std.core.slice.index.SliceIndexRangeToUsizeSlice Aeneas.Std.U8) nodes
                            { «end» := Aeneas.Std.Usize.wrapping_mul 32#usize count } =
                          Aeneas.Std.Result.ok supplied ∧
                        base.op10 D hash AspisR1.Port3_NativeBatchBody.multiproof.Arity.Two root idx val d supplied =
