  (root : Aeneas.Std.Array Aeneas.Std.U8 32#usize) (kind lo n slot d : Aeneas.Std.Usize)
  (keys : Aeneas.Std.Array Aeneas.Std.U64 16#usize) (idx outIdx : AspisR1.Port3_NativeBatchCalls.Indices)
  (val outVal : AspisR1.Port3_NativeBatchCalls.Values),
  AspisR1.Port3_NativeBatchBody.verifier.candidate.batch_tree_loop.body (AspisR1.Port3_BatchStd.install base) D proof
        root kind hash lo n slot keys idx val d n =
      Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.done (outIdx, outVal, some (Aeneas.Std.core.result.Result.Ok ()))) →
    ∃ front count cap nodes padding supplied ce after,
