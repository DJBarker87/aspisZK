    if kind = 1#usize then AspisR1.Port4B_LeafCode.codeFor o 241#u8 480#usize 608#usize 640#usize 672#usize
    else AspisR1.Port4B_LeafCode.codeFor o 114#u8 672#usize 800#usize 800#usize 832#usize
