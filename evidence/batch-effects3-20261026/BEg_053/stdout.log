AspisR1.Port4B_TreeJoin.accepted : ∀ (base : AspisR1.Port3_NativeBatchBody.Ops) {X : Type}
  (D : AspisR1Stage2.aspis_core.digest.Digest32 X) (hash : X)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (binary occupied sibling : AspisR1.MultiproofConeP6Callbacks.Parent) (leaf : AspisR1.MultiproofConeP6Batch.Leaf),
  AspisR1.MultiproofConeP6Frozen2Stage.P6Boundary (AspisR1.Port4B_VerifyInstall.digest D) hash H binary occupied sibling
      leaf →
    ∀ (proof : Aeneas.Std.Slice Aeneas.Std.U8),
      (↑proof).length = 57607 →
        ∀ (parsed : AspisR1.OraclePortCompactDraft.Parsed),
          parsed.wire = AspisR1.MultiproofConeCanonical.bytesOf ↑proof →
            ∀ (queries : Aeneas.Std.Array Aeneas.Std.U32 22#usize) (q : Fin 22 → Fin 262144)
              (batch kind : Aeneas.Std.Usize),
              ↑batch < 2 →
                ↑kind < 3 →
                  AspisR1.Port4B_TreeJoin.PackedKeys base queries q batch kind →
                    ∀ (root : Aeneas.Std.Array Aeneas.Std.U8 32#usize),
                      root =
                          AspisV8R19.SqueezeOracleBridge.encodeState
                            (AspisR1.OraclePortBatchDraft.committedRoot parsed ↑kind) →
                        ∀ (physical : Aeneas.Std.Slice Aeneas.Std.U8),
                          AspisR1.MultiproofConeCanonical.bytesOf ↑physical =
                              AspisR1.OraclePortCompactDraft.slice parsed.wire
                                (AspisR1.OraclePortSelectedDraft.slotStart (3 * ↑batch + ↑kind))
                                (32 * AspisR1.OraclePortSelectedDraft.capacity (3 * ↑batch + ↑kind)) →
                            ∀ (initial : MultiproofConeRef.reference.Scratch)
                              (outIdx : AspisR1.Port3_NativeBatchCalls.Indices)
                              (outVal : AspisR1.Port3_NativeBatchCalls.Values),
                              AspisR1.Port3_NativeBatchBody.verifier.candidate.batch_tree
                                    (AspisR1.Port3_BatchStd.install (AspisR1.Port4B_VerifyInstall.install base)) D proof
                                    queries root batch kind initial.idx initial.val hash =
                                  Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (), outIdx, outVal) →
                                ∃ afterLeaf final,
                                  AspisV8R19.MemoizedProgramLaw.eval H
                                        (AspisR1.MultiproofConeP6Batch.batch_tree
                                          (AspisR1.MultiproofConeP6Callbacks.nodeWith occupied sibling) leaf parsed q
                                          (↑batch) (↑kind) physical initial) =
                                      (List.map
                                            (fun p =>
                                              (AspisR1.OraclePortSelectedDraft.leaf parsed (↑kind) p,
                                                H (AspisR1.OraclePortSelectedDraft.leaf parsed (↑kind) p)))
                                            (AspisR1.OraclePortFrozenOrder.sortedPositions q ↑batch ↑kind) ++
                                          (AspisV8R19.MemoizedProgramLaw.eval H
                                              (AspisR1.MultiproofConeP6Batch.tailState
                                                (AspisR1.MultiproofConeP6Callbacks.nodeWith occupied sibling) parsed
                                                (↑batch) (↑kind) physical afterLeaf)).1,
                                        true, final) ∧
                                    final.idx = outIdx ∧ final.val = outVal
'AspisR1.Port4B_TreeJoin.accepted' depends on axioms: [propext, Classical.choice, Quot.sound]
def AspisR1.Port4B_TreeJoin.PackedKeys : AspisR1.Port3_NativeBatchBody.Ops →
  Aeneas.Std.Array Aeneas.Std.U32 22#usize → (Fin 22 → Fin 262144) → Aeneas.Std.Usize → Aeneas.Std.Usize → Prop :=
fun base queries q batch kind =>
  ∀ (raw : Aeneas.Std.Array Aeneas.Std.U64 16#usize),
    base.op4 queries (AspisR1.Port4B_TreeCuts.lo batch) (AspisR1.Port4B_TreeCuts.count batch) kind =
        Aeneas.Std.Result.ok raw →
      List.take ↑(AspisR1.Port4B_TreeCuts.count batch) ↑raw =
        List.map (AspisR1.MultiproofConeSortOrder.packed q ↑batch ↑kind)
          (AspisR1.OraclePortSelectedDraft.batchPositions ↑batch)
