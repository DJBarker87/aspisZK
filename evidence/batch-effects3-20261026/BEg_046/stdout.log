AspisR1.Port4B_SliceReads.indices : ∀ (idx : Aeneas.Std.Array Aeneas.Std.U32 16#usize) (n : Aeneas.Std.Usize)
  (front : Aeneas.Std.Slice Aeneas.Std.U32),
  Aeneas.Std.core.array.Array.index
        (Aeneas.Std.core.ops.index.IndexSlice (Aeneas.Std.core.slice.index.SliceIndexRangeToUsizeSlice Aeneas.Std.U32))
        idx { «end» := n } =
      Aeneas.Std.Result.ok front →
    ↑front = List.take ↑n ↑idx ∧ ↑n ≤ 16
