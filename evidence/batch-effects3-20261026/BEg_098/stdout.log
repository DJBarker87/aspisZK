                    (AspisR1.SdkC_Source.digestCode (AspisR1.MultiproofConePhysicalDigest.parts left right)) [] =
                  (Aeneas.Std.Result.ok
                      (AspisR1.MultiproofConePhysicalTransport.rawOracle H
                        (AspisR1.MultiproofConePhysicalDigest.parts left right)),
                    [{ parts := AspisR1.MultiproofConePhysicalDigest.parts left right,
                        returned :=
                          Aeneas.Std.Result.ok
                            (AspisR1.MultiproofConePhysicalTransport.rawOracle H
                              (AspisR1.MultiproofConePhysicalDigest.parts left right)) }])
'AspisR1.P6C_Issued.parent' depends on axioms: [propext, Classical.choice, Quot.sound]
def AspisR1.P6C_Issued.Boundary : (AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest) →
  (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) → AspisR1.SdkC_Source.Log → Prop :=
fun hashv H log =>
  ∀ q ∈ log,
    q.returned = Aeneas.Std.Result.ok (AspisR1.MultiproofConePhysicalTransport.rawOracle H q.parts) ∧
      hashv q.parts = Aeneas.Std.Result.ok (AspisR1.MultiproofConePhysicalTransport.rawOracle H q.parts) ∧
        AspisR1.S2W_DigestExtraction.digest hashv () q.parts =
            Aeneas.Std.Result.ok (AspisR1.MultiproofConePhysicalTransport.rawOracle H q.parts) ∧
          AspisR1.SdkC_Source.run hashv (AspisR1.SdkC_Source.digestCode q.parts) [] =
            (Aeneas.Std.Result.ok (AspisR1.MultiproofConePhysicalTransport.rawOracle H q.parts),
              [{ parts := q.parts,
                  returned := Aeneas.Std.Result.ok (AspisR1.MultiproofConePhysicalTransport.rawOracle H q.parts) }])
