AspisR1.P6C_Issued.installed : ∀ (ops : AdapterRw.Ops) (native1 : AspisR1.S2W_ExtractionBoundary.First)
  (native2 : AspisR1.S2W_ExtractionBoundary.Second)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest),
  AspisR1.S2W_DigestExtraction.AeneasExtraction ops native1 native2 hashv →
    ∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) (log : AspisR1.SdkC_Source.Log),
      AspisR1.P6C_Issued.Boundary hashv H log →
