@AspisR1.P6C_Issued.parent : ∀ {A : Type}
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  AspisR1.S2W_ExtractionBoundary.P1 sha256 H →
    AspisR1.S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
      ∀ (code : AspisR1.SdkC_Source.Code A) (value : A),
        (AspisR1.SdkC_Source.run hashv code []).1 = Aeneas.Std.Result.ok value →
          ∀ (left right : AspisR1.SdkC_Source.Digest),
            ∀ query ∈ (AspisR1.SdkC_Source.run hashv code []).2,
              query.parts = AspisR1.MultiproofConePhysicalDigest.parts left right →
