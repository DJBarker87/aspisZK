AspisR1.RPx_RuntimePrefix.acceptance : ∀
  (prelude : AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State Unit)
  (runtime : AspisR1.F3T_Runtime.Runtime) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (run : AspisR1.F3T_Experiment.RunView),
