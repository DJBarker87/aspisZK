AspisR1.RPx_RuntimePrefix.evaluation : ∀
  (prelude : AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State Unit)
  (runtime : AspisR1.F3T_Runtime.Runtime) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.RPx_RuntimePrefix.prepend prelude runtime) =
    ((AspisV8R19.MemoizedProgramLaw.eval H prelude).1 ++ (AspisV8R19.MemoizedProgramLaw.eval H runtime).1,
      (AspisV8R19.MemoizedProgramLaw.eval H runtime).2)
