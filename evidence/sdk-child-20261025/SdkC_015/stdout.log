'AspisR1.SdkC_BatchPair.returning' depends on axioms: [propext, Classical.choice, Quot.sound]
'AspisR1.SdkC_BatchPair.same_pair' depends on axioms: [propext, Classical.choice, Quot.sound]
'AspisR1.SdkC_BatchPair.accepted_pair' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.SdkC_BatchPair.accepted_pair : ∀ {A F : Type}
  (copy : Heap (ℕ → Record) → ℕ → Payload → Outcome (ℕ → Record)),
  TrustedStd copy →
    ∀ (allocator : Allocator A) (e1 e2 : Entry) (adapter : AdapterRw.Ops) (ops : AspisR1CurrentCaller.Ops)
      (stage : VTop_Stages.Ops) (finish : AspisR1Stage2.Stage2Finish.FinishOps F)
      (B : AspisR1PublicPreparation.FinishModel.Boundaries) (std : ClaimsUnrolledFinish.StdCalls)
      (native1 : S2W_ExtractionBoundary.First) (native2 : S2W_ExtractionBoundary.Second)
      (hashv : SdkC_Source.Parts → Result SdkC_Source.Digest),
      S2W_DigestExtraction.AeneasExtraction (Op5T_SamePair.dictionary adapter ops stage finish B std) native1 native2
          hashv →
        ∀ (sha256 H : Bytes → State),
          S2W_ExtractionBoundary.P1 sha256 H →
            S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
              ∀ (program : S2W_ExtractionBoundary.Program) (data1 data2 : Slice U8) (slot : S2W_ExtractionBoundary.Slot)
                (state1 state2 final1 final2 : A) (saved : alloc.vec.Vec U8) (post1 post2 : Heap (ℕ → Record)),
                first native1 copy allocator e1 program data1 state1 =
                    ok (core.result.Result.Ok (saved, post1, final1)) →
                  second native2 allocator e2 program data2 slot state2 = ok (core.result.Result.Ok (post2, final2)) →
                    ∃ f s,
                      SourceCuts (Op5T_SamePair.dictionary adapter ops stage finish B std) e1.first
                          (e2.second secondSizes) saved f s ∧
                        post2 = e2.heap ∧
                          ∃ p0 root0 p2 root2,
                            Returning hashv H (SdkC_BatchSource.currentCode hashv f.proof p0 root0)
                                (core.result.Result.Ok ()) ∧
                              Returning hashv H (SdkC_BatchSource.stageCode hashv s.proof p2 root2)
                                (core.result.Result.Ok ()) :=
fun {A F} copy stdCopy allocator e1 e2 adapter ops stage finish B std native1 native2 hashv extraction sha256 H p1
    syscall program data1 data2 slot state1 state2 final1 final2 saved post1 post2 accepted1 accepted2 =>
  let ⟨owned1, right✝⟩ :=
    first_accepted native1 copy stdCopy allocator e1 program data1 state1 final1 saved post1 accepted1
  let ⟨owned2, unchanged⟩ := second_accepted native2 allocator e2 program data2 slot state2 final2 post2 accepted2
  let ⟨f, h✝⟩ :=
    cuts_of_acceptance (Op5T_SamePair.dictionary adapter ops stage finish B std) native1 native2 hashv
      (S2W_DigestExtraction.sourceBoundary (Op5T_SamePair.dictionary adapter ops stage finish B std) native1 native2
        hashv extraction)
      program e1.first (e2.second secondSizes) data1 data2 slot saved owned1 owned2
  let ⟨s, cuts⟩ := h✝
  Exists.intro f
    (Exists.intro s
      ⟨cuts,
        ⟨unchanged,
          same_pair adapter ops stage finish B std native1 native2 hashv extraction sha256 H p1 syscall e1.first
            (e2.second secondSizes) saved f s cuts⟩⟩)
