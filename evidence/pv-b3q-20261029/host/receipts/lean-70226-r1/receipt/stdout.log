def Aeneas.Std.Array.index_usize.{u} : {α : Type u} →
  {n : Aeneas.Std.Usize} → Aeneas.Std.Array α n → Aeneas.Std.Usize → Aeneas.Std.Result α :=
fun {α} {n} v i =>
  match v[i]? with
  | none => Aeneas.Std.Result.fail Aeneas.Std.Error.arrayOutOfBounds
  | some x => Aeneas.Std.Result.ok x
def Aeneas.Std.Array.index_mut_usize.{u} : {α : Type u} →
  {n : Aeneas.Std.Usize} →
    Aeneas.Std.Array α n → Aeneas.Std.Usize → Aeneas.Std.Result (α × (α → Aeneas.Std.Array α n)) :=
fun {α} {n} v i => do
  let x ← v.index_usize i
  Aeneas.Std.Result.ok (x, v.set i)
def Aeneas.Std.Array.to_slice.{u} : {α : Type u} → {n : Aeneas.Std.Usize} → Aeneas.Std.Array α n → Aeneas.Std.Slice α :=
fun {α} {n} v => ⟨↑v, ⋯⟩
def Aeneas.Std.Slice.index_usize.{u} : {α : Type u} → Aeneas.Std.Slice α → Aeneas.Std.Usize → Aeneas.Std.Result α :=
fun {α} v i =>
  match v[i]? with
  | none => Aeneas.Std.Result.fail Aeneas.Std.Error.arrayOutOfBounds
  | some x => Aeneas.Std.Result.ok x
def Aeneas.Std.Slice.index_mut_usize.{u} : {α : Type u} →
  Aeneas.Std.Slice α → Aeneas.Std.Usize → Aeneas.Std.Result (α × (α → Aeneas.Std.Slice α)) :=
fun {α} v i => do
  let x ← v.index_usize i
  Aeneas.Std.Result.ok (x, v.set i)
def Aeneas.Std.Slice.set.{u} : {α : Type u} → Aeneas.Std.Slice α → Aeneas.Std.Usize → α → Aeneas.Std.Slice α :=
fun {α} v i x => v.setAtNat (↑i) x
def Aeneas.Std.Array.set.{u} : {α : Type u} →
  {n : Aeneas.Std.Usize} → Aeneas.Std.Array α n → Aeneas.Std.Usize → α → Aeneas.Std.Array α n :=
fun {α} {n} v i x => ⟨(↑v).set (↑i) x, ⋯⟩
