@[reducible] def Aeneas.Std.core.cmp.impls.PartialEqU32.eq : U32 → U32 → Bool :=
fun x y => decide (x = y)
@[reducible] def Aeneas.Std.core.cmp.impls.PartialEqU32.ne : U32 → U32 → Bool :=
fun x y => decide ¬x = y
@[reducible] def Aeneas.Std.core.cmp.impls.PartialEqU64.eq : U64 → U64 → Bool :=
fun x y => decide (x = y)
@[reducible] def Aeneas.Std.core.cmp.impls.PartialEqUsize.eq : Usize → Usize → Bool :=
