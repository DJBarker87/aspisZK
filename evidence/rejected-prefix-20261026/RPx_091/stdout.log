theorem AspisR1.PFin_Gates.decoded : ∀ (p : AspisR1.OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144)
  (tr : AspisR1.RawCutTranscriptRun.ErasedPrefix) (i : AspisR1.RecordedBinaryExperimentBin.SourceInputs),
  AspisR1.OraclePortStoredDecisionDraftC4.input p q tr = Option.some i →
    AspisR1.OraclePortSelectedDraft.queries tr = Option.some q →
      AspisR1.LiteralQueryRead.decode i.queryBytes = Option.some q :=
fun p q tr i found queries =>
  have fields := (AspisR1.OraclePortStoredDecisionDraftC4.input_fields p q tr i found).left;
  Eq.mp
    (congrArg
      (fun _a =>
        (do
            let __x ← _a
            match __x with
              | (fst, c) =>
                match c.1 with
                | AspisR1.TranscriptView.Value.queries (Except.ok bs) => AspisR1.LiteralQueryRead.decode bs
                | x => Option.none) =
          Option.some q)
      fields.right.left)
    queries
