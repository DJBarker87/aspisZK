fun {Observer X} c D hash H stored pub saved parsed facts wireStored binary occupied sibling leaf p6 p a pm am fields
    modelRoots folded foldedInput batch hb reached native =>
  have original := facts.proofBytes (AspisR1.Port4B_CallerJoin.site batch) reached;
  have size := congrArg List.length original;
  have length :=
    Eq.trans
      (Eq.mp (congrFun' (congrArg Eq (List.length_map AspisV8R19.SqueezeOracleBridge.decodeByte)) (List.length stored))
        size)
      facts.proofLength;
  have wire := Eq.trans wireStored (Eq.symm original);
  let localP6 :=
    { oracle := facts.oracle, binary_parent := p6.binary_parent, occupied_parent := p6.occupied_parent,
      sibling_parent := p6.sibling_parent, leaf := p6.leaf };
  have queryBinding := AspisR1.Port4B_KeyInstall.queries_bound p a pm am fields;
  have roots := AspisR1.Port4B_Prepared.roots p a pm am fields;
  have installed :=
    Eq.trans
      (AspisR1.Port4B_Install.parent AspisR1.Port4B_Install.leaves D (c.proof (AspisR1.Port4B_CallerJoin.site batch)) p
        folded batch hash)
      native;
  have keys := fun k =>
    AspisR1.Port4B_KeyInstall.packed AspisR1.Port4B_Install.leaves p.queries pm.queries queryBinding batch (↑k)#usize hb
      (have this := k.isLt;
      AspisR1.Port4B_CallerJoin.accepted._proof_2 c stored folded batch k this);
  let ⟨log, source⟩ :=
    AspisR1.Port4B_BatchJoin.accepted (AspisR1.Port4B_KeyInstall.install AspisR1.Port4B_Install.leaves) D hash H binary
      occupied sibling leaf localP6 (c.proof (AspisR1.Port4B_CallerJoin.site batch)) length parsed wire p folded
      pm.queries batch hb c.nodes facts.nodeViews keys
      (Eq.trans roots.left (congrArg AspisV8R19.SqueezeOracleBridge.encodeState (modelRoots 0)))
      (Eq.trans roots.right (congrArg AspisV8R19.SqueezeOracleBridge.encodeState (modelRoots 1)))
      (AspisR1.Port4B_Prepared.digest_of_bytes folded (AspisR1.OraclePortBatchDraft.committedRoot parsed 2) foldedInput)
      installed
  have complete :=
    AspisR1.MultiproofConeP6Frozen2Stage.both_batches
      (AspisR1.Port4B_VerifyInstall.digest (AspisR1.VTop_Checkpoint.digest D)) hash H binary occupied sibling leaf
      localP6 parsed pm.queries c.nodes facts.nodeViews;
  have success := Eq.mpr (id (congrArg (fun _a => _a.2 = true) source)) (Eq.refl (log, true).2);
  Exists.intro log
    ⟨source,
      if zero : ↑batch = 0 then
        Eq.mpr
          (id
            (congr
              (congrArg Eq
                (congrArg (AspisV8R19.MemoizedProgramLaw.eval H)
                  (congrFun'
                    (congrArg
                      (AspisR1.MultiproofConeP6Frozen2Stage.sourceBatch occupied sibling leaf parsed pm.queries c.nodes)
                      zero)
                    AspisR1.Port4B_BatchJoin.initial)))
              (congrArg (AspisV8R19.MemoizedProgramLaw.eval H)
                (congrArg (AspisR1.OraclePortFrozen2.batch parsed pm.queries)
                  (ite_congr (Eq.trans (congrFun' (congrArg Eq zero) 0) (eq_self 0))
                    (fun a => Eq.refl AspisR1.OraclePortFrozen2.batch0) fun a =>
                    Eq.refl AspisR1.OraclePortFrozen2.batch1)))))
          (complete.left AspisR1.Port4B_BatchJoin.initial
            (Eq.mp
              (congrFun'
                (congrArg Eq
                  (congrArg Prod.snd
                    (congrArg (AspisV8R19.MemoizedProgramLaw.eval H)
                      (congrFun'
                        (congrArg
                          (AspisR1.MultiproofConeP6Frozen2Stage.sourceBatch occupied sibling leaf parsed pm.queries
                            c.nodes)
                          zero)
                        AspisR1.Port4B_BatchJoin.initial))))
                true)
              success))
      else
        have one :=
          Decidable.byContradiction fun a => AspisR1.Port4B_CallerJoin.accepted._proof_3 c stored batch hb zero a;
        Eq.mpr
          (id
            (congr
              (congrArg Eq
                (congrArg (AspisV8R19.MemoizedProgramLaw.eval H)
                  (congrFun'
                    (congrArg
                      (AspisR1.MultiproofConeP6Frozen2Stage.sourceBatch occupied sibling leaf parsed pm.queries c.nodes)
                      one)
                    AspisR1.Port4B_BatchJoin.initial)))
              (congrArg (AspisV8R19.MemoizedProgramLaw.eval H)
                (congrArg (AspisR1.OraclePortFrozen2.batch parsed pm.queries)
                  (Eq.trans
                    (ite_congr
                      (Eq.trans (congrFun' (congrArg Eq one) 0)
                        (eq_false
                          (have this := of_decide_eq_true (id (Eq.refl true));
                          this)))
                      (fun a => Eq.refl AspisR1.OraclePortFrozen2.batch0) fun a =>
                      Eq.refl AspisR1.OraclePortFrozen2.batch1)
                    (if_false AspisR1.OraclePortFrozen2.batch0 AspisR1.OraclePortFrozen2.batch1))))))
          (complete.right AspisR1.Port4B_BatchJoin.initial
            (Eq.mp
              (congrFun'
                (congrArg Eq
                  (congrArg Prod.snd
                    (congrArg (AspisV8R19.MemoizedProgramLaw.eval H)
                      (congrFun'
                        (congrArg
                          (AspisR1.MultiproofConeP6Frozen2Stage.sourceBatch occupied sibling leaf parsed pm.queries
                            c.nodes)
                          one)
                        AspisR1.Port4B_BatchJoin.initial))))
                true)
              success))⟩
