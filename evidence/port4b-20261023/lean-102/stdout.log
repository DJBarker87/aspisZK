            AspisR1.CheckpointBytes4SavedFields.BodyMatches p a pm am →
              (∀ (j : Fin 2), pm.roots j = AspisR1.OraclePortBatchDraft.committedRoot parsed ↑j) →
                ∀ (folded : Aeneas.Std.Array Aeneas.Std.U8 32#usize),
