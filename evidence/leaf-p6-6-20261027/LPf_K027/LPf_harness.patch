+fn LPf_checkpoint_chronology(){let(p,a)=inputs();let proof:[u8;3]=kani::any();let public:[u8;5]=kani::any();let answers:[[u8;32];3]=kani::any();let selected:usize=kani::any();kani::assume(selected<1736);let at:usize=kani::any();kani::assume(at<1768);let count=core::cell::Cell::new(0);let hash=Chronology{count:&count,proof:&proof,public:&public,p:&p,a:&a,answers,selected};let out=checkpoint(&p,&a,&proof,&public,hash);assert_eq!(count.get(),3);assert_eq!(out.len(),1768);let expected=if at<1736{payload_byte(&p,&a,&answers,at)}else{answers[2][at-1736]};assert_eq!(out[at],expected);kani::cover!(at==1767);kani::cover!(selected==1735);}
