+use aspis_core::field::{WideExact as E,QM31 as K,M31,CM31};
+pub(crate) const P:u32=2147483647;
+pub(crate) fn reduce_ref(n:u64)->u32 {let n=n%2147483648+n/2147483648;let n=n%2147483648+n/2147483648;if n>=u64::from(P){(n-u64::from(P))as u32}else{n as u32}}
+pub(crate) fn raw_ref(x:[u32;4],y:[u32;4])->[u64;4]{
+ let [a,b,c,d]=[u64::from(x[0]),u64::from(x[1]),u64::from(x[2]),u64::from(x[3])];
+ let [e,f,g,h]=[u64::from(y[0]),u64::from(y[1]),u64::from(y[2]),u64::from(y[3])];
+ const PP:u64=2147483647*2147483647;
+ let partial=|x:u64|(x&2147483647).wrapping_add(x>>31u32);
+ let u=partial((c*g).wrapping_add(PP).wrapping_sub(d*h));let v=partial((c*h).wrapping_add(d*g));
+ [(a*e).wrapping_add(PP).wrapping_sub(b*f).wrapping_add(2*u).wrapping_add(3*u64::from(P)).wrapping_sub(v),
+ (a*f).wrapping_add(b*e).wrapping_add(u).wrapping_add(2*v),
+ (a*g).wrapping_add(c*e).wrapping_add(2*PP).wrapping_sub(b*h).wrapping_sub(d*f),
+ (a*h).wrapping_add(b*g).wrapping_add(c*f).wrapping_add(d*e)]
+}
+pub(crate) fn any_e()->E{let xs:[u32;8]=kani::any();for x in xs{kani::assume(x<P);}E::from_limbs(xs).unwrap()}
+pub(crate) fn any_k()->K{let xs:[u32;4]=kani::any();K{c0:CM31{a:M31(xs[0]),b:M31(xs[1])},c1:CM31{a:M31(xs[2]),b:M31(xs[3])}}}
+pub(crate) fn limbs(k:K)->[u32;4]{[k.c0.a.0,k.c0.b.0,k.c1.a.0,k.c1.b.0]}
