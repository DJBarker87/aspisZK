{"charon_version":"0.1.223","translated":{"crate_name":"ngl_reference","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::map_ref"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["core::option::Option","core::result::Result","core::option::_::ok_or"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-slice-d-entry-20261105/NGL_E003.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"ngl_reference","contents":"pub enum ProgramError{Custom(u32),InvalidArgument,InvalidInstructionData,InvalidAccountData,AccountDataTooSmall,InsufficientFunds,IncorrectProgramId,MissingRequiredSignature,AccountAlreadyInitialized,UninitializedAccount,NotEnoughAccountKeys,AccountBorrowFailed,MaxSeedLengthExceeded,InvalidSeeds,BorshIoError(String),AccountNotRentExempt,UnsupportedSysvar,IllegalOwner,MaxAccountsDataAllocationsExceeded,InvalidRealloc,MaxInstructionTraceLengthExceeded,BuiltinProgramsMustConsumeComputeUnits,InvalidAccountOwner,ArithmeticOverflow,Immutable,IncorrectAuthority}\npub enum VerifierError{Parse,Semantic,Transcript,Relation,Merkle,Query,Checkpoint,Allocation}\npub fn route_ref(data:&[u8])->u8{if data==[3,10]||data==[3,11]{1}else if data.starts_with(b\"ASQ8\"){2}else{0}}\npub fn readonly_ref(owner:&[u8;32],expected:&[u8;32],s:bool,w:bool,e:bool)->Result<(),ProgramError>{if owner!=expected||s||w||e{Err(ProgramError::InvalidAccountData)}else{Ok(())}}\npub fn map_ref(result:Result<Vec<u8>,VerifierError>)->Result<Vec<u8>,ProgramError>{match result{Ok(v)=>Ok(v),Err(_)=>Err(ProgramError::InvalidInstructionData)}}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":4,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":5,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/alloc/src/string.rs"},"crate_name":"alloc","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ptr/mod.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["ngl_reference",0]},{"Ident":["map_ref",0]}]},{"key":{"Type":0},"value":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}]},{"key":{"Type":1},"value":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Ident":["Vec",0]}]},{"key":{"Type":2},"value":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Ident":["Global",0]}]},{"key":{"Type":3},"value":[{"Ident":["ngl_reference",0]},{"Ident":["VerifierError",0]}]},{"key":{"Type":4},"value":[{"Ident"