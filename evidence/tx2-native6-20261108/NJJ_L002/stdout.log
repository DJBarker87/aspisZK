  Aeneas.Std.core.slice.iter.Iter T → Aeneas.Std.Result (Option T × Aeneas.Std.core.slice.iter.Iter T) :=
fun {T} it =>
  if h : it.i < ↑it.slice.len then
    have x := it.slice[it.i];
    have it := { slice := it.slice, i := it.i + 1 };
    Aeneas.Std.Result.ok (some x, it)
  else Aeneas.Std.Result.ok (none, it)
