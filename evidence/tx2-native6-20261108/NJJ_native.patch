+ assert_eq!(calls,1);assert_eq!(weights.len(),64);assert_eq!(weights.capacity(),cap);assert_eq!(weights.as_ptr(),ptr);
+ let mut expected=if i==j{kw(value)}else{before[j]};if cfg!(NJJ_invert){expected[0]^=1;}assert_eq!(kw(weights[j]),expected);
