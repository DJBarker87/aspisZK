+ let mut raw=alloc::vec::Vec::with_capacity(64);for row in before{raw.push(row);}
+ let mut weights=alloc::vec::Vec::with_capacity(64);for row in words{weights.push(k(row));}
+ let p=raw.as_ptr();let cap=raw.capacity();let wp=weights.as_ptr();let wc=weights.capacity();let mut index=i;
+ let w=weights[index];raw[index]=[w.c0.a.0 as u64,w.c0.b.0 as u64,w.c1.a.0 as u64,w.c1.b.0 as u64];index+=1;
+ assert_eq!(index,i+1);assert_eq!(raw.len(),64);assert_eq!(raw.capacity(),cap);assert_eq!(raw.as_ptr(),p);
+ assert_eq!(weights.len(),64);assert_eq!(weights.capacity(),wc);assert_eq!(weights.as_ptr(),wp);assert_eq!(kw(weights[j]),words[j]);
+ let mut expected=if i==j{[words[i][0] as u64,words[i][1] as u64,words[i][2] as u64,words[i][3] as u64]}else{before[j]};if cfg!(NJJ_invert){expected[0]^=1;}assert_eq!(raw[j],expected);
+}
