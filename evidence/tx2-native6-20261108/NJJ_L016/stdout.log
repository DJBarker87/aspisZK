'NJJ_Common.source' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem NJJ_Common.source : ∀ (unused : Ops) (weightReservation rawReservation : NP6_StdModel.Reservation)
  (merkle : Merkle) (finish : Finish) {H : Type} (d : aspis_core.digest.Digest32 H) (pub proof ck : Slice U8)
  (hash : H),
  NHT_EmittedCommon.tx2_common (install unused weightReservation rawReservation (fun {H} => merkle) finish) d pub proof
      ck hash none =
    run weightReservation rawReservation (fun {H} => merkle) finish d pub proof ck hash none :=
fun unused weightReservation rawReservation merkle finish {H} d pub proof ck hash =>
  Eq.refl
    (NHT_EmittedCommon.tx2_common (install unused weightReservation rawReservation (fun {H} => merkle) finish) d pub
      proof ck hash none)
def NJJ_Common.run : NP6_StdModel.Reservation →
  NP6_StdModel.Reservation →
    Merkle →
      Finish →
        {H : Type} →
          aspis_core.digest.Digest32 H →
            Slice U8 →
              Slice U8 →
                Slice U8 →
                  H → Option (verifier.Phase → Result Unit) → Result (core.result.Result Unit verifier.Error) :=
fun weightReservation rawReservation merkle finish {H} aspis_coredigestDigest32Inst public_bytes proof checkpoint hash
    obs =>
  do
  let r ←
    resume weightReservation aspis_coredigestDigest32Inst checkpoint proof public_bytes
        AspisR1Stage2.transport.Variant.S2 hash
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
    | core.ops.control_flow.ControlFlow.Continue val =>
      let (p, a) := val
      if (a.next != NHT_Constants.compact.SPLIT) = true then
        ok (core.result.Result.Err AdapterRw.aspis_r1_cost_probe.verifier.Error.Checkpoint)
      else do
        let g ← NHT_PacketOps.powers 29#usize p.gamma
        NHV_ReleaseOps.mark obs AdapterRw.aspis_r1_cost_probe.verifier.Phase.CheckpointRead
        let i ← NHT_Constants.compact.OFF_INACTIVE
        let i1 ← NHT_Constants.compact.OFF_ROUND0
        let s ←
          core.slice.index.Slice.index (core.slice.index.SliceIndexRangeUsizeSlice U8) proof { start := i, «end» := i1 }
        let o ← NJC_ClosedCalls.inactive s
        let r1 ← NHT_Constants.core.option.Option.ok_or o AdapterRw.aspis_r1_cost_probe.verifier.Error.Parse
        let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
        match cf1 with
          | core.ops.control_flow.ControlFlow.Continue val1 => do
            let i2 ← NHT_Constants.compact.OFF_FOLDED_ROOT
            let i3 ← NHT_Constants.compact.OFF_ROUND1
            let s1 ←
              core.slice.index.Slice.index (core.slice.index.SliceIndexRangeUsizeSlice U8) proof
                  { start := i2, «end» := i3 }
            let r2 ← core.array.TryFromArrayCopySlice.try_from 32#usize core.marker.CopyU8 s1
            let folded_root ← core.result.Result.unwrap core.fmt.DebugTryFromSliceError r2
            let r3 ← merkle aspis_coredigestDigest32Inst proof p folded_root 1#usize hash
            let cf2 ← core.result.Result.Insts.CoreOpsTry.branch r3
            match cf2 with
              | core.ops.control_flow.ControlFlow.Continue a_1 => do
                NHV_ReleaseOps.mark obs
                    (AdapterRw.aspis_r1_cost_probe.verifier.Phase.Merkle NHT_Constants.compact.SPLIT)
                let r4 ← NJC_ClosedCalls.geometry p.queries a.next 22#usize
                let cf3 ← core.result.Result.Insts.CoreOpsTry.branch r4
                match cf3 with
                  | core.ops.control_flow.ControlFlow.Continue val2 =>
                    have s2 := a.weights.deref;
                    do
                    let r5 ← pending rawReservation s2
                    let cf4 ← core.result.Result.Insts.CoreOpsTry.branch r5
                    match cf4 with
                      | core.ops.control_flow.ControlFlow.Continue val3 => do
                        let r6 ← query proof p a g obs val2 val3 22#usize
                        let cf5 ← core.result.Result.Insts.CoreOpsTry.branch r6
                        match cf5 with
                          | core.ops.control_flow.ControlFlow.Continue val4 =>
                            let (a1, pending) := val4
                            do
                            let (s3, deref_mut_back) ← lift a1.weights.deref_mut
                            let s4 ← Port3_FlushInstall.flush pending s3
                            have weights : alloc.vec.Vec AspisR1Stage2.aspis_core.field.QM31 := deref_mut_back s4
                            let s5 ← lift (Std.Array.empty U8).to_slice
                            let s6 ← lift (Std.Array.empty U8).to_slice
                            let s7 ←
                              core.slice.index.Slice.index (core.slice.index.SliceIndexRangeUsizeSlice U8) proof
                                  { start := i1, «end» := i2 }
                            let i4 ← NHT_Constants.compact.OFF_FINAL
                            let s8 ←
                              core.slice.index.Slice.index (core.slice.index.SliceIndexRangeUsizeSlice U8) proof
                                  { start := i3, «end» := i4 }
                            let i5 ← NHT_Constants.compact.OFF_OPENINGS
                            let s9 ←
                              core.slice.index.Slice.index (core.slice.index.SliceIndexRangeUsizeSlice U8) proof
                                  { start := i4, «end» := i5 }
                            let s10 ← lift (Std.Array.empty U8).to_slice
                            finish
                                { variant := AspisR1Stage2.transport.Variant.S2, semantic := s5, y1 := s6,
                                  inactive := val1, round0 := s7, folded_root := none, round1 := s8,
                                  final_message := s9, query_bytes := s10 }
                                p { weights := weights, rhs := a1.rhs, power := a1.power, next := a1.next } obs
                          | core.ops.control_flow.ControlFlow.Break residual =>
                            core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual Unit
                              (core.convert.FromSame verifier.Error) residual
                      | core.ops.control_flow.ControlFlow.Break residual =>
                        core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual Unit
                          (core.convert.FromSame verifier.Error) residual
                  | core.ops.control_flow.ControlFlow.Break residual =>
                    core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual Unit
                      (core.convert.FromSame verifier.Error) residual
              | core.ops.control_flow.ControlFlow.Break residual =>
                core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual Unit
                  (core.convert.FromSame verifier.Error) residual
          | core.ops.control_flow.ControlFlow.Break residual =>
            core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual Unit
              (core.convert.FromSame verifier.Error) residual
    | core.ops.control_flow.ControlFlow.Break residual =>
      core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual Unit
        (core.convert.FromSame verifier.Error) residual
