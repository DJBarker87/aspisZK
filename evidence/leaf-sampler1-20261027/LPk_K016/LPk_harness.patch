+// Scratch-only stage harnesses; inline fragments audited against frozen sampler.rs.
+use aspis_core::field::P;
+
+fn LPk_step(remainder: u64, limb: u32) -> (u32,u64) {
+    let dividend = (remainder << 32) | u64::from(limb);
+    let q = (dividend / u64::from(P)) as u32;
+    let r = dividend % u64::from(P);
+    (q,r)
+}
+fn LPk_step_relation(remainder: u64, limb: u32) -> (u32,u64) {
+    assert!(remainder < u64::from(P));
+    let (q,r):(u32,u64) = kani::any();
+    kani::assume(r < u64::from(P));
+    kani::assume(u128::from(q) * u128::from(P) + u128::from(r) == u128::from((remainder << 32) | u64::from(limb)));
+    (q,r)
+}
+#[kani::proof]
+fn LPk_inner_step() {
+    let remainder:u64 = kani::any();
+    let limb:u32 = kani::any();
+    kani::assume(remainder < u64::from(P));
+    let (q,r) = LPk_step(remainder,limb);
+    let dividend = (remainder << 32) | u64::from(limb);
+    assert!(r < u64::from(P));
+    assert_eq!(u64::from(q)*u64::from(P)+r, dividend);
+    kani::cover!(remainder==u64::from(P)-1 && limb==u32::MAX);
+}
+
+// Library traversal/writeback only; arithmetic body factored to the paired stub.
+#[kani::proof]
+#[kani::unwind(10)]
+#[kani::stub(LPk_step, LPk_step_relation)]
+fn LPk_reverse_writeback() {
+    let mut quotient:[u32;8] = kani::any();
+    let original = quotient;
+    let mut remainder=0u64;
+    let mut count=0usize;
+    let mut qs=[0u32;8];
+    let mut rs=[0u64;8];
+    for limb in quotient.iter_mut().rev() {
+        assert_eq!(*limb,original[7-count]);
+        let before=remainder;
+        let (q,r)=LPk_step(remainder,*limb);
+        *limb=q;
+        remainder=r;
+        assert!(r < u64::from(P));
+        assert_eq!(u64::from(q)*u64::from(P)+r,(before<<32)|u64::from(original[7-count]));
+        qs[count]=q; rs[count]=r;
+        count+=1;
+    }
+    assert_eq!(count,8);
+    let at:usize=kani::any();kani::assume(at<8);
+    assert_eq!(quotient[7-at],qs[at]);
+    assert_eq!(remainder,rs[7]);
+}
+
+// Abstract closure body: arbitrary state transitions, preserving the shared borrow.
+#[kani::proof]
+#[kani::unwind(10)]
+fn LPk_from_fn_order_word() {
+    let mut quotient:[u32;8]=kani::any();
+    let initial=quotient;
+    let mut count=0usize;
+    let mut inputs=[[0u32;8];8];
+    let mut outputs=[[0u32;8];8];
+    let mut digits=[0u32;8];
+    let result:[u32;8]=core::array::from_fn(|i| {
+        assert_eq!(i,count);
+        inputs[i]=quotient;
+        let next:[u32;8]=kani::any();
+        let digit:u32=kani::any();
+        quotient=next;
+        outputs[i]=next;digits[i]=digit;
+        count+=1;
+        digit
+    });
+    assert_eq!(count,8);
+    let at:usize=kani::any();kani::assume(at<8);
+    assert_eq!(result[at],digits[at]);
+    let word:usize=kani::any();kani::assume(word<8);
+    assert_eq!(inputs[0][word],initial[word]);
+    if at>0 {assert_eq!(inputs[at][word],outputs[at-1][word]);}
+    assert_eq!(quotient[word],outputs[7][word]);
+}
+
+// Split K005: isolate the quotient cast bound, remainder bound, and
+// reconstruction before narrowing. No division-equivalence goal.
+#[kani::proof]
+fn LPk_quotient_bound() {
+ let rem:u64=kani::any();let limb:u32=kani::any();kani::assume(rem<u64::from(P));
+ let n=(rem<<32)|u64::from(limb);
+ let q=n/u64::from(P);
+ assert!(q<=u64::from(u32::MAX));
+}
+#[kani::proof]
+fn LPk_remainder_bound() {
+ let rem:u64=kani::any();let limb:u32=kani::any();kani::assume(rem<u64::from(P));
+ let n=(rem<<32)|u64::from(limb);
+ let r=n%u64::from(P);
+ assert!(r<u64::from(P));
+}
+#[kani::proof]
+fn LPk_reconstruction() {
+ let rem:u64=kani::any();let limb:u32=kani::any();kani::assume(rem<u64::from(P));
+ let n=(rem<<32)|u64::from(limb);
+ let q=n/u64::from(P);let r=n%u64::from(P);
+ assert_eq!(u128::from(q)*u128::from(P)+u128::from(r),u128::from(n));
+}
+// Split K006: order and final store, without reasserting the arithmetic
+// relation supplied by the paired stub. Wide relation avoids irrelevant
+// checked-u64 arithmetic in the specification itself.
+#[kani::proof] #[kani::unwind(10)]
+#[kani::stub(LPk_step, LPk_step_relation)]
+fn LPk_reverse_order() {
+ let mut quotient:[u32;8]=kani::any();let original=quotient;
+ let mut remainder=0u64;let mut count=0usize;
+ for limb in quotient.iter_mut().rev() {
+  assert_eq!(*limb,original[7-count]);
+  let(q,r)=LPk_step(remainder,*limb);*limb=q;remainder=r;count+=1;
+ }
+ assert_eq!(count,8);
+}
+#[kani::proof] #[kani::unwind(10)]
+#[kani::stub(LPk_step, LPk_step_relation)]
+fn LPk_reverse_store() {
+ let mut quotient:[u32;8]=kani::any();let mut qs=[0u32;8];
+ let mut remainder=0u64;let mut count=0usize;
+ for limb in quotient.iter_mut().rev() {
+  let(q,r)=LPk_step(remainder,*limb);*limb=q;remainder=r;qs[count]=q;count+=1;
+ }
+ let at:usize=kani::any();kani::assume(at<8);
+ assert_eq!(quotient[7-at],qs[at]);
+ assert!(remainder<u64::from(P));
+}
+
+#[kani::proof] #[kani::unwind(10)]
+fn LPk_byte_decode() {
+ let block:[u8;32]=kani::any();
+ let quotient:[u32;8]=core::array::from_fn(|i|u32::from_le_bytes(block[4*i..4*i+4].try_into().unwrap()));
+ let i:usize=kani::any();kani::assume(i<8);
+ let word=u32::from(block[4*i])|(u32::from(block[4*i+1])<<8)|
+  (u32::from(block[4*i+2])<<16)|(u32::from(block[4*i+3])<<24);
+ assert_eq!(quotient[i],word);
+}
+
+// Split K010: only the low-word identity. The independent passed gates
+// K008/K009 supply these two assumptions; Lean supplies the no-wrap lift.
+#[kani::proof]
+fn LPk_wrapping_reconstruction() {
+ let rem:u64=kani::any();let limb:u32=kani::any();kani::assume(rem<u64::from(P));
+ let n=(rem<<32)|u64::from(limb);
+ let q=n/u64::from(P);let r=n%u64::from(P);
+ kani::assume(q<=u64::from(u32::MAX));
+ kani::assume(r<u64::from(P));
+ assert_eq!(q.wrapping_mul(u64::from(P)).wrapping_add(r),n);
+}
+
+fn LPk_reconstruction_words()->(u64,u64) {
+ let rem:u64=kani::any();let limb:u32=kani::any();kani::assume(rem<u64::from(P));
+ let n=(rem<<32)|u64::from(limb);
+ let q=n/u64::from(P);let r=n%u64::from(P);
+ kani::assume(q<=u64::from(u32::MAX)); // K008
+ kani::assume(r<u64::from(P)); // K009
+ (q.wrapping_mul(u64::from(P)).wrapping_add(r),n)
+}
+#[kani::proof]
+fn LPk_reconstruction_chunk0() {
+ let(w,n)=LPk_reconstruction_words();
+ assert_eq!((w>>0) as u16,(n>>0) as u16);
+}
+#[kani::proof]
+fn LPk_reconstruction_chunk1() {
+ let(w,n)=LPk_reconstruction_words();
+ assert_eq!((w>>16) as u16,(n>>16) as u16);
+}
+#[kani::proof]
+fn LPk_reconstruction_chunk2() {
+ let(w,n)=LPk_reconstruction_words();
+ assert_eq!((w>>32) as u16,(n>>32) as u16);
+}
+#[kani::proof]
+fn LPk_reconstruction_chunk3() {
+ let(w,n)=LPk_reconstruction_words();
+ assert_eq!((w>>48) as u16,(n>>48) as u16);
+}
