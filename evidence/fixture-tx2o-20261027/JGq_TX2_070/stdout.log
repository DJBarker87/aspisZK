def AspisR1.JGo_TX2_FinishPrefixTools.remaining : {W : Type} →
  AspisR1.Port3_NativeFinishBody.Ops W →
    AspisR1Stage2.verifier.View →
      AspisR1Stage2.verifier.Prepared →
        AspisR1Stage2.verifier.Accumulator →
          W →
            Aeneas.Std.Slice AspisR1Stage2.Stage2Finish.E →
              AspisR1Stage2.Stage2Finish.E →
                Aeneas.Std.Result (Aeneas.Std.core.result.Result Unit AspisR1Stage2.verifier.Error) :=
fun {W} ops v p a weights alphas lastClaim => do
  let r3 ← ops.op2 weights alphas v.final_message p.kappa
  let cf3 ← Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r3
  match cf3 with
    | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue pair => do
      ops.op0 16#u16 0#usize pair
      ops.op0 16#u16 1#usize lastClaim
      let different ← ops.ne pair lastClaim
      if different = true then
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err AspisR1Stage2.verifier.Error.Relation)
        else do
          ops.op1 none AspisR1Stage2.verifier.Phase.Relation
          let r4 ← ops.op4 v.final_message a.weights.deref
          let cf4 ← Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r4
          match cf4 with
            | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue dot => do
              ops.op0 17#u16 0#usize dot
              ops.op0 17#u16 1#usize a.rhs
              if (a.next != 22#usize) = true then
                  Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err AspisR1Stage2.verifier.Error.Query)
                else do
                  let different ← ops.ne dot a.rhs
                  if different = true then
                      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err AspisR1Stage2.verifier.Error.Query)
                    else do
                      ops.op1 none AspisR1Stage2.verifier.Phase.Final
                      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ())
            | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual =>
              Aeneas.Std.core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual Unit
                (Aeneas.Std.core.convert.FromSame AspisR1Stage2.verifier.Error) residual
    | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual =>
      Aeneas.Std.core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual Unit
        (Aeneas.Std.core.convert.FromSame AspisR1Stage2.verifier.Error) residual
