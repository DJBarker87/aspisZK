                          (state1 state2 final1 final2 : A) (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
                          (post1 post2 : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record)),
                          AspisR1.S2W_D189Wrappers.first native1 copy allocator e1 AspisR1.CPH_Program.verifier data1
                                state1 =
                              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post1, final1)) →
                            AspisR1.S2W_D189Wrappers.second native2 allocator e2 AspisR1.CPH_Program.verifier data2 slot
                                  state2 =
                                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (post2, final2)) →
                              ∀ (root : Aeneas.Std.Array Aeneas.Std.U8 32#usize) (length : Aeneas.Std.U32)
                                (prior :
                                  AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes
                                    AspisV8R19.SourceDuplexStep.State Unit)
                                (words : AspisR1.CanonicalCutEnrichedTranscript.Words)
                                (p : AspisR1.CPG_Projection.Observations Tx A) (t u : Tx)
                                (actions : List (AspisR1.CPP_BankState.Action A)),
                                AspisR1.CPH_Game.DeployedPairExecution p t u e1 e2 saved actions native1 native2 copy
                                    allocator AspisR1.CPH_Program.verifier →
                                  AspisR1.CPR_DataPersistence.TwoTransactionLaw (AspisR1.CPG_Projection.adjacent p)
                                      (AspisR1.CPG_Projection.ordinary p (AspisR1.Hist_Nonvacuity.key 0#u8))
                                      (AspisR1.CPG_Projection.before p) (AspisR1.CPG_Projection.tentative p)
                                      (AspisR1.CPG_Projection.success p) (AspisR1.CPG_Projection.loaded p) →
                                    ∀ (D : AspisR1.LiteralByteProtocol.Decoder) (a : AspisR1.SCE_Experiment.Adversary A)
                                      (Q0 Q1 : ℕ),
                                      (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
                                          (AspisR1.ARW_Induced.issued native1 copy allocator
                                                AspisR1.CPH_Program.verifier a H).length ≤
                                            Q0 + Q1) →
                                        AspisR1.FIp_GlobalOwners.Owners
                                            (AspisR1.FIp_Install.configuration indexError c reservation)
                                            (AspisR1.Rc2_Install.configuration
                                                (AspisR1.Rc5_Install.seed indexError
                                                  (AspisR1.FIp_Install.select reservation c))
                                                reservation).boundaries →
                                          have P :=
                                            AspisR1.ARW_Induced.program native1 copy allocator
                                              AspisR1.CPH_Program.verifier a;
                                          have runtime :=
                                            AspisR1.ARX_AdmittedRuntime.runtime L copy allocator c indexError
                                              reservation native1 native2 hashv a;
                                          have select := fun x =>
                                            AspisR1.P2P_NativeSelection.pair
                                              (AspisR1.DrvC_Installation.sdk
                                                (AspisR1.FIp_Install.configuration indexError c reservation))
                                              AspisR1.CPH_Program.verifier e1 e2 data2 slot;
                                          AspisR1.MultiproofConeP6Frozen2Stage.P6Boundary
                                              (AspisR1.P6C_Extension.dictionary hashv H) () H AspisR1.Op5T_P6.parent
                                              AspisR1.Op5T_P6.parent AspisR1.Op5T_P6.parent
                                              AspisR1.MultiproofConeP6Batch.referenceLeaf ∧
                                            AspisR1.DrvC_Implementation.driver
                                                  (AspisR1.FIp_Install.configuration indexError c reservation) =
                                                AspisR1.DrvC_SourceEntry.source
                                                  (AspisR1.FIp_Install.configuration indexError c reservation) hashv ∧
                                              AspisR1.DrvC_Installation.sdk
                                                    (AspisR1.FIp_Install.configuration indexError c reservation) =
                                                  AspisR1.SdkD_PairBatches.dictionary
                                                    (AspisR1.FIp_Install.configuration indexError c reservation).adapter
                                                    (AspisR1.FIp_Install.configuration indexError c
                                                        reservation).currentBase
                                                    (AspisR1.FIp_Install.configuration indexError c
                                                        reservation).stageBase
                                                    (AspisR1.FIp_Install.configuration indexError c reservation).finish
                                                    (AspisR1.FIp_Install.configuration indexError c
                                                        reservation).reserved
                                                    (AspisR1.FIp_Install.configuration indexError c reservation).query
                                                    (AspisR1.FIp_Install.configuration indexError c
                                                        reservation).geometry
                                                    (AspisR1.FIp_Install.configuration indexError c
                                                        reservation).boundaries
                                                    (AspisR1.FIp_Install.configuration indexError c reservation).std ∧
                                                AspisR1.FIs_Result.Outcome L e1 e2 w1 w2
                                                    (AspisR1.FIp_Install.configuration indexError c reservation).adapter
                                                    (AspisR1.FIp_Install.configuration indexError c
                                                        reservation).currentBase
                                                    (AspisR1.FIp_Install.configuration indexError c
                                                        reservation).reserved
                                                    (AspisR1.FIp_Install.configuration indexError c reservation).query
                                                    (AspisR1.FIp_Install.configuration indexError c
                                                        reservation).geometry
                                                    (AspisR1.FIp_Install.configuration indexError c
                                                        reservation).stageBase
                                                    (AspisR1.FIp_Install.configuration indexError c reservation).finish
                                                    (AspisR1.FIp_Install.boundaries c.boundaries) reservation
                                                    AspisR1.CPH_Program.verifier data1 data2 slot saved post1 post2 H
                                                    (AspisR1.DrvC_Implementation.driver
                                                      (AspisR1.FIp_Install.configuration indexError c reservation))
                                                    prior (p.physicalEvents t) hashv
                                                    (AspisR1.BinRawByteCollisionTargets.event
                                                      AspisR1.SelectedTranscriptParams.params.iv (Q0 + Q1 + 2965)
                                                      (AspisV8R19.MemoizedProgramLaw.eval H
                                                        (AspisR1.Hiq_RecordedJoint.program
                                                          (AspisR1.F3X_Account.program
                                                            (AspisR1.FIp_Install.configuration indexError c reservation)
                                                            hashv P)
                                                          AspisR1.F3X_Projection.project select))) ∧
                                                  (AspisR1.F3X_ModelClaims.Claims
                                                        (AspisR1.FIp_Install.configuration indexError c reservation) D P
                                                        (Q0 + Q1) ∧
                                                      AspisR1.F3Y_SourceClaims.Claims
                                                          (AspisR1.FIp_Install.configuration indexError c reservation) D
                                                          hashv P (Q0 + Q1) select ∧
                                                        ⋯) ∧
                                                    (native1 AspisR1.CPH_Program.verifier e1.first data1 =
                                                          Aeneas.Std.Result.ok
                                                            (Aeneas.Std.core.result.Result.Ok saved) ∧
                                                        ⋯) ∧
                                                      ⋯ ∧ ⋯ :=
fun {W A CoreError Tx} L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 c indexError reservation native1
    native2 hashv extraction sha256 H p1 syscall data1 data2 slot state1 state2 final1 final2 saved post1 post2
    accepted1 accepted2 root length prior words p t u actions game RuntimePersistence D a Q0 Q1 queries finishOwners =>
  have security :=
    AspisR1.ARX_Residual.numeric L copy allocator c indexError reservation native1 native2 hashv extraction a std D
      words finishOwners Q0 Q1 queries;
  let ⟨p6, right✝⟩ :=
    AspisR1.ARW_Observations.observations L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 c indexError
      reservation native1 native2 hashv extraction sha256 H p1 syscall data1 data2 slot state1 state2 final1 final2
      saved post1 post2 accepted1 accepted2 root length prior words p t u actions game RuntimePersistence D a Q0 Q1
      queries finishOwners
  let ⟨driver, right✝¹⟩ := right✝
  let ⟨sdkEq, right✝²⟩ := right✝¹
  let ⟨result, right✝³⟩ := right✝²
  let ⟨claims, right✝⁴⟩ := right✝³
  let ⟨copyFacts, right✝⁵⟩ := right✝⁴
  let ⟨events, right✝⁶⟩ := right✝⁵
  let ⟨protection, right✝⁷⟩ := right✝⁶
  let ⟨trace, right✝⁸⟩ := right✝⁷
  let ⟨recorder, s6⟩ := right✝⁸
  ⟨p6,
    ⟨driver,
      ⟨sdkEq,
        ⟨result,
          ⟨⟨claims.left,
              ⟨claims.right.left,
                ⟨claims.right.right,
                  ⟨security,
                    ⟨fun range =>
                      Eq.mp
                        (congrArg
                          (LE.le
                            (AspisR1.F3T_RuntimeBound.failureModel
                              (AspisR1.ARX_AdmittedRuntime.runtime L copy allocator c indexError reservation native1
                                native2 hashv a)))
                          (congrFun' (congrArg HMul.hMul (congrFun' (congrArg HAdd.hAdd (Nat.cast_add Q0 Q1)) 1))
                            (1 / 2 ^ 100)))
                        (LE.le.trans security (AspisR1.F3U_Range.per_attempt (Q0 + Q1) range)),
                      fun zero =>
                      AspisR1.F3U_Numeric.runtime_margin
                        (AspisR1.F3T_RuntimeBound.failureModel
                          (AspisR1.ARX_AdmittedRuntime.runtime L copy allocator c indexError reservation native1 native2
                            hashv a))
                        (Eq.mp
                          (congrArg
                            (fun _a =>
                              AspisR1.F3T_RuntimeBound.failureModel
                                  (AspisR1.ARX_AdmittedRuntime.runtime L copy allocator c indexError reservation native1
                                    native2 hashv a) ≤
                                AspisR1.F3T_Numeric.total _a)
                            zero)
                          security)⟩⟩⟩⟩⟩,
            ⟨copyFacts, ⟨events, ⟨protection, ⟨trace, ⟨recorder, s6⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩
