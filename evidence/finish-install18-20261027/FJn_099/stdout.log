    binding
def AspisR1.FIp_GlobalOwners.Owners : {F C : Type} →
  AspisR1.DrvC_Installation.Configuration F C → AspisR1PublicPreparation.FinishModel.Boundaries → Prop :=
fun {F C} c B =>
  ∀ (s : AspisR1.F3T_ByteCarrier.Submission) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
    (e : AspisR1.F3V_RunEvidence.Evidence c B s H) (i : AspisR1.F3_Model.Input)
    (p : AspisR1.OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144)
    (data : AspisR1.RecordedBinaryExperimentBin.SourceInputs) (t : AspisR1.Cons_Native.Witness),
    AspisR1.FGl_PreparedAt.At c B s H e i p q data →
      AspisR1.Cons_Native.Calls (AspisR1.Op5T_Concrete.stage (AspisR1.AuS1_Install.base c.stageBase)) c.finish
          c.reserved c.query c.geometry (AspisR1.F3V_RunEvidence.D2 c H) () e.pub e.proof e.saved.deref t →
        AspisR1.SAG_NativeFull.Shape
            (AspisR1.Tx2N_Execution.control
              (AspisR1.Tx2I_Install.stage (AspisR1.Op5T_Concrete.stage (AspisR1.AuS1_Install.base c.stageBase))
                c.finish)
              c.reserved c.query c.geometry)
            e.proof t →
          ∀
            (x :
              AspisR1.F3S_FinishWitness.Primitives c.finish t.v2 t.p2
                (have __src := t.returned2;
                { weights := t.back2 t.flushed2, rhs := __src.rhs, power := __src.power, next := __src.next })),
            AspisR1.FIp_Remaining.Holds c.finish t.v2 t.p2
              (have __src := t.returned2;
              { weights := t.back2 t.flushed2, rhs := __src.rhs, power := __src.power, next := __src.next })
              x q p
              (AspisR1.LiteralTranscript.erasePrefix
                (AspisV8R19.MemoizedProgramLaw.eval H
                    (AspisR1.F3J_SamplerRun.program i.proof 0 33 (FS.emptyPrefix i.semantic.value))).2)
              data
