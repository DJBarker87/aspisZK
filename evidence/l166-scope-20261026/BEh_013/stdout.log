    (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) → AspisR1.SdkC_Source.Code A → A → Prop :=
fun {A} hashv H code value =>
  (AspisR1.SdkC_Source.run hashv code []).1 = Aeneas.Std.Result.ok value ∧
    AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.SdkC_Oracle.program code) =
        (AspisR1.SdkC_Source.readLog (AspisR1.SdkC_Source.run hashv code []).2, Aeneas.Std.Result.ok value) ∧
      ∀ (a : AspisV8R19.DuplexFrames.Bytes) (d : AspisV8R19.SourceDuplexStep.State),
        d ≠ H a → (a, d) ∉ AspisR1.SdkC_Source.readLog (AspisR1.SdkC_Source.run hashv code []).2
