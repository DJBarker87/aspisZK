fun {A F C} c hashv D account project select budget join =>
  let s := { publicBytes := List.replicate (Aeneas.Std.Usize.max + 1) 0, stored := [] };
  have large :=
    Eq.mpr (id (congrArg (LT.lt Aeneas.Std.Usize.max) List.length_replicate))
      (Decidable.byContradiction fun a => AspisR1.F3W_Obstruction.no_unconditional_raw_join._proof_1 a);
  let ⟨H, h✝⟩ :=
    AspisR1.F3W_Obstruction.oversized_counterexample c hashv D s large (account s) (project s) (select s) (budget s)
  let ⟨rejected, right✝⟩ := h✝
  let ⟨clean, different⟩ := right✝
  Or.casesOn (join s H) (fun equal => different equal) fun collision => clean collision
