  (select :
    AspisR1.F3T_ByteCarrier.Submission → A → AspisR1.R9PoolRuntimeBinding.Inputs × AspisR1.R9PoolRuntimeBinding.Inputs),
  (∀ (s : AspisR1.F3T_ByteCarrier.Submission) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      FS.firstReads FS.emptyTable (AspisV8R19.MemoizedProgramLaw.eval H (account s)).1 ≤ 0 + 1921) →
