+#[kani::proof] #[kani::unwind(10)]
+fn LPn_producers(){
+ let words:[u32;4]=kani::any();
+ let good=words[0]<canonical::P&&words[1]<canonical::P&&words[2]<canonical::P&&words[3]<canonical::P;
+ match canonical::Q::from_limbs(words){None=>assert!(!good),Some(q)=>{
+  assert!(good);let got=q.limbs();for i in 0..4{assert_eq!(got[i],words[i]);assert!(got[i]<canonical::P);}
+ }}
+ let x=QM31{c0:CM31{a:aspis_core::field::M31(words[0]),b:aspis_core::field::M31(words[1])},c1:CM31{a:aspis_core::field::M31(words[2]),b:aspis_core::field::M31(words[3])}};
+ match checked_q(x){Err(())=>assert!(!good),Ok(q)=>{assert!(good);let got=q.limbs();for i in 0..4{assert_eq!(got[i],words[i]);}}}
+ let wide:[u32;8]=kani::any();
+ if let Some(e)=E::from_limbs(wide){
+  let pair=canonical::Q::from_wide(e);
+  for i in 0..4{assert_eq!(pair[0].limbs()[i],wide[i]);assert_eq!(pair[1].limbs()[i],wide[4+i]);assert!(pair[0].limbs()[i]<canonical::P);assert!(pair[1].limbs()[i]<canonical::P);}
+ }
