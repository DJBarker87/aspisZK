  ↑i + fuel = ↑N → R1Z.PV_RJ4ID_PowersControl.run x out p i = R1Z.PV_RJ4ID_PowersControl.finite x fuel out p i
@R1Z.PV_RJ4ID_PowersControl.source : ∀ [inst : ProverRwFull.ExternalTypes] [inst_1 : ProverRwFull.ExternalFuns]
  (N : Aeneas.Std.Usize) (x : R1Z.PV_RJ4ID_PowersControl.W),
