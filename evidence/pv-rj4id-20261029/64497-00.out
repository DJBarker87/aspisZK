  {N : Aeneas.Std.Usize} (x : R1Z.PV_RJ4ID_PowersControl.W) (out : Aeneas.Std.Array R1Z.PV_RJ4ID_PowersControl.W N)
  (p : R1Z.PV_RJ4ID_PowersControl.W) (i : Aeneas.Std.Usize),
  R1Z.PV_RJ4ID_PowersControl.run x out p i =
    R1Z.PV_RJ4ID_PowersControl.dispatch (R1Z.PV_RJ4ID_PowersControl.run x) x out p i
