      left a b (i.wrapping_add 1#usize) = right a b (i.wrapping_add 1#usize)) →
    R1Z.PV_RJ4ID_PowersControl.dispatch left x out p i = R1Z.PV_RJ4ID_PowersControl.dispatch right x out p i
@R1Z.PV_RJ4ID_PowersControl.loop_finite : ∀ [inst : ProverRwFull.ExternalTypes] [inst_1 : ProverRwFull.ExternalFuns]
  {N : Aeneas.Std.Usize} (x : R1Z.PV_RJ4ID_PowersControl.W) (fuel : ℕ)
