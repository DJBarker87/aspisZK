  (q : Aeneas.Std.Array E 1024#usize) (p : ProverRwFull.aspis_core.r0.domain.Point E),
  R1Z.PV_DL_EncoderNative.value inst q p = R1Z.PV_DL_EncoderControl.value inst q p
