def Aeneas.Std.core.iter.adapters.rev.Rev.Insts.CoreIterTraitsIteratorIterator.next : {I Item : Type} →
  core.iter.traits.double_ended.DoubleEndedIterator I Item →
    core.iter.adapters.rev.Rev I → Result (Option Item × core.iter.adapters.rev.Rev I) :=
fun {I Item} DEInst self => do
  let __x ← DEInst.next_back self.iter
  match __x with
    | (o, it) => ok (o, { iter := it })
def Aeneas.Std.core.ops.range.Range.Insts.CoreIterTraitsDoubleEndedIterator.next_back : {A : Type} →
  core.iter.range.Step A → core.ops.range.Range A → Result (Option A × core.ops.range.Range A) :=
fun {A} StepInst r => do
  let lt ← StepInst.partialOrdInst.lt r.start r.end
  if lt = true then do
      let b ← StepInst.backward_checked r.end 1#usize
      match b with
        | none => fail Error.panic
        | some e' => ok (some e', { start := r.start, «end» := e' })
    else ok (none, r)
@[reducible] def Aeneas.Std.core.iter.range.StepUsize : core.iter.range.Step (UScalar UScalarTy.Usize) :=
core.iter.range.UScalarStep UScalarTy.Usize core.clone.CloneUsize core.cmp.PartialOrdUsize
def Aeneas.Std.core.iter.range.UScalarStep.backward_checked : {ty : UScalarTy} →
  UScalar ty → Usize → Result (Option (UScalar ty)) :=
fun {ty} start n => if h : ↑n ≤ ↑start then ok (some (UScalar.ofNatCore (↑start - ↑n) ⋯)) else ok none
