def AspisR1.CPR_DataPersistence.TwoTransactionLaw : {Tx Key : Type} →
  (Tx → Tx → Prop) →
    (Tx → Key → Prop) →
      (Tx → Key → AspisR1.CPR_DataPersistence.Image) →
        (Tx → Key → AspisR1.CPR_DataPersistence.Image) →
          (Tx → Bool) → (Tx → Key → Option AspisV8R19.DuplexFrames.Bytes) → Prop :=
fun {Tx Key} next ordinary before tentative success loaded =>
  ∀ (t u : Tx),
    next t u →
      ∀ (key : Key),
        ordinary t key →
          loaded u key =
            AspisR1.CPR_DataPersistence.visible (if success t = Bool.true then tentative t key else before t key)
@AspisR1.F3S_PrimitiveNonvacuity.accepted : ∀ {W : Type} (ops : AspisR1Stage2.Stage2Finish.FinishOps W)
  (v : AspisR1Stage2.verifier.View) (p : AspisR1Stage2.verifier.Prepared) (a : AspisR1Stage2.verifier.Accumulator),
  p.variant = AspisR1Stage2.transport.Variant.S2 →
    AspisR1.Port4D_FinishInstall.finish ops v p a Option.none =
        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) →
      ∃! x, True
AspisR1.F3U_Numeric.exact : 1 / 2 ^ 100 - AspisR1.F3T_Numeric.total 0 = AspisR1.F3U_Numeric.margin
AspisR1.F3U_Numeric.positive : 0 < AspisR1.F3U_Numeric.margin
def AspisR1.F3U_Numeric.margin : ℚ :=
1 / 2 ^ 108 - 6 * (1161 ^ 2 + 2965 ^ 2) / 2 ^ 256 - 1 / 2 ^ 126 - 1 / 2 ^ 454
def AspisR1.F3U_RangeEdges.maxQueries : ℕ :=
7388980242446479800895501321004157112314840375
AspisR1.F3U_RangeMaximal.exact_range : ∀ (Q : ℕ),
  AspisR1.F3T_Numeric.total Q ≤ (↑Q + 1) * (1 / 2 ^ 100) ↔ Q ≤ AspisR1.F3U_RangeEdges.maxQueries
'AspisR1.F3U_Numeric.positive' depends on axioms: [propext, Classical.choice, Quot.sound]
'AspisR1.F3U_RangeMaximal.exact_range' depends on axioms: [propext, Classical.choice, Quot.sound]
