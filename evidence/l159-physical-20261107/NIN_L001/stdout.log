@NIB_ReadToSettlement.read_to_settlement : ∀ {Invocation Context Key RuntimeState Accounts Other LaneImage : Type}
  [inst : DecidableEq Key] (runtime : NGK_NFO_PoolReturnData.Runtime Context Key RuntimeState),
  NGK_NFR_PoolReturnData.RuntimeReturnData runtime →
    ∀ (emitInvocation poolInvocation : Invocation) (context : Invocation → Context) (program : Invocation → Key)
      (selected : Key) (readState : RuntimeState) (state after : AspisR1.S2I.ReturnData.State Accounts Other)
      (s : NFY_NEU_EmitModel.Statement),
      poolInvocation = emitInvocation →
        program emitInvocation = selected →
          readState =
              runtime.write (context emitInvocation) (program emitInvocation) ↑(AspisR1.S2K.ResultPayload.bytes s) →
            AspisR1.NFY_JHb_Emit.source (fun st bytes => Aeneas.Std.Result.ok (AspisR1.S2I.ReturnData.set st bytes))
                  state s =
                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok after) →
              ∀ (authenticated : NGK_NFO_ReadModel.Accepted) (events : List NGK_NFO_ReadModel.Event),
                NGK_NFO_ReadModel.run selected (Aeneas.Std.core.result.Result.Ok ())
                      (runtime.read (context poolInvocation) readState) NGK_NFO_PacketDecoder.run =
                    Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok authenticated, events) →
                  ∀
                    (validate :
                      NGK_NFR_CSettlement.Output →
                        Aeneas.Std.Result (Aeneas.Std.core.result.Result Unit NGK_NFR_CSettlement.Error))
                    (lane :
                      NGK_NFR_CSettlement.Output →
                        Aeneas.Std.Result (Aeneas.Std.core.result.Result LaneImage NGK_NFR_CSettlement.Error))
                    (image : LaneImage),
                    validate authenticated.value = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) →
                      lane authenticated.value = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok image) →
                        AspisR1TerminalDecoder.pool_v1.pair_forest_terminal.validate_pool_v1_pair_forest_terminal_statement_v1
                              s =
                            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) ∧
                          validate (AspisR1.S2K.ResultAdmission.value s) =
                              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) ∧
                            lane (AspisR1.S2K.ResultAdmission.value s) =
                                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok image) ∧
                              authenticated.value = AspisR1.S2K.ResultAdmission.value s ∧
                                authenticated.bytes = ↑(AspisR1.S2K.ResultPayload.bytes s) ∧
                                  events =
                                      [NGK_NFO_ReadModel.Event.clear, NGK_NFO_ReadModel.Event.invoke,
                                        NGK_NFO_ReadModel.Event.read, NGK_NFO_ReadModel.Event.decode] ∧
                                    1 ≤ List.length authenticated.bytes ∧
                                      List.length authenticated.bytes ≤ 1024 ∧
                                        after = AspisR1.S2I.ReturnData.set state ↑(AspisR1.S2K.ResultPayload.bytes s) ∧
                                          NGK_NFR_CSettlement.run validate lane NFY_NEY_EmitComposed.encode
                                                authenticated =
                                              Aeneas.Std.Result.ok
                                                (Aeneas.Std.core.result.Result.Ok
                                                    (image, AspisR1.S2K.ResultPayload.bytes s),
                                                  [NGK_NFR_CSettlement.Call.validate authenticated.value,
                                                    NGK_NFR_CSettlement.Call.lane authenticated.value,
                                                    NGK_NFR_CSettlement.Call.encode authenticated.value]) ∧
                                            NGK_NFV_HelperModel.run NFY_NEY_EmitComposed.encode authenticated.value =
                                              Aeneas.Std.Result.ok
                                                (Aeneas.Std.core.result.Result.Ok (AspisR1.S2K.ResultPayload.bytes s),
                                                  [NGK_NFV_HelperModel.Call.encode authenticated.value,
                                                    NGK_NFV_HelperModel.Call.allocate
                                                      (AspisR1.S2K.ResultPayload.bytes s)])
theorem AspisR1.ART_Runtime.eval_runtime : ∀ {A F C : Type} (c : AspisR1.DrvC_Installation.Configuration F C)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (id : AspisR1.S2W_ExtractionBoundary.Program)
  (a : AspisR1.SCE_Experiment.Adversary A) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.ART_Runtime.runtime c hashv copy allocator id a) =
    have v := AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.ART_PartialAccount.account c hashv copy allocator id a);
    (v.1,
      some
        (v.1, AspisR1.F3T_Canon.canonInput (AspisR1.F3T_ByteCarrier.input c (AspisR1.SCE_Experiment.submitted v.2.1)),
          AspisR1.SCE_Experiment.accepted v.2)) :=
fun {A F C} c hashv copy allocator id a H =>
  of_eq_true
    (Eq.trans
      (congrFun'
        (congrArg Eq
          (Eq.trans
            (AspisV8R19.OracleProgramOps.eval_bind
              (AspisR1.OracleProgramRecording.record (AspisR1.ART_PartialAccount.account c hashv copy allocator id a))
              (fun v =>
                AspisV8R19.MemoizedProgramLaw.Program.done
                  (some
                    (v.1,
                      AspisR1.F3T_Canon.canonInput
                        (AspisR1.F3T_ByteCarrier.input c (AspisR1.SCE_Experiment.submitted v.2.1)),
                      AspisR1.SCE_Experiment.accepted v.2)))
              H)
            (congr
              (congrArg Prod.mk
                (Eq.trans
                  (congr
                    (congrArg HAppend.hAppend
                      (congrArg Prod.fst
                        (AspisR1.OracleProgramRecording.eval_record H
                          (AspisR1.ART_PartialAccount.account c hashv copy allocator id a))))
                    (congrArg Prod.fst
                      (congrArg (Prod.mk [])
                        (congrArg some
                          (congr
                            (congrArg Prod.mk
                              (congrArg Prod.fst
                                (congrArg Prod.snd
                                  (AspisR1.OracleProgramRecording.eval_record H
                                    (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)))))
                            (congr
                              (congrArg Prod.mk
                                (congrArg AspisR1.F3T_Canon.canonInput
                                  (congrArg (AspisR1.F3T_ByteCarrier.input c)
                                    (congrArg AspisR1.SCE_Experiment.submitted
                                      (congrArg Prod.fst
                                        (congrArg Prod.snd
                                          (congrArg Prod.snd
                                            (AspisR1.OracleProgramRecording.eval_record H
                                              (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)))))))))
                              (congrArg AspisR1.SCE_Experiment.accepted
                                (congrArg Prod.snd
                                  (congrArg Prod.snd
                                    (AspisR1.OracleProgramRecording.eval_record H
                                      (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)))))))))))
                  (List.append_nil
                    (AspisV8R19.MemoizedProgramLaw.eval H
                        (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)).1)))
              (congrArg Prod.snd
                (congrArg (Prod.mk [])
                  (congrArg some
                    (congr
                      (congrArg Prod.mk
                        (congrArg Prod.fst
                          (congrArg Prod.snd
                            (AspisR1.OracleProgramRecording.eval_record H
                              (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)))))
                      (congr
                        (congrArg Prod.mk
                          (congrArg AspisR1.F3T_Canon.canonInput
                            (congrArg (AspisR1.F3T_ByteCarrier.input c)
                              (congrArg AspisR1.SCE_Experiment.submitted
                                (congrArg Prod.fst
                                  (congrArg Prod.snd
                                    (congrArg Prod.snd
                                      (AspisR1.OracleProgramRecording.eval_record H
                                        (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)))))))))
                        (congrArg AspisR1.SCE_Experiment.accepted
                          (congrArg Prod.snd
                            (congrArg Prod.snd
                              (AspisR1.OracleProgramRecording.eval_record H
                                (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)))))))))))))
        ((AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)).1,
          some
            ((AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)).1,
              AspisR1.F3T_Canon.canonInput
                (AspisR1.F3T_ByteCarrier.input c
                  (AspisR1.SCE_Experiment.submitted
                    (AspisV8R19.MemoizedProgramLaw.eval H
                          (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)).2.1)),
              AspisR1.SCE_Experiment.accepted
                (AspisV8R19.MemoizedProgramLaw.eval H
                    (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)).2)))
      (eq_self
        ((AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)).1,
          some
            ((AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)).1,
              AspisR1.F3T_Canon.canonInput
                (AspisR1.F3T_ByteCarrier.input c
                  (AspisR1.SCE_Experiment.submitted
                    (AspisV8R19.MemoizedProgramLaw.eval H
                          (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)).2.1)),
              AspisR1.SCE_Experiment.accepted
                (AspisV8R19.MemoizedProgramLaw.eval H
                    (AspisR1.ART_PartialAccount.account c hashv copy allocator id a)).2))))
def AspisR1.SCE_Experiment.accepted : {A : Type} → AspisR1.GExq_AccountExperiment.Outcome A → Bool :=
fun {A} o =>
  match o.2.1, o.2.2 with
  | Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok a),
    some (fst, Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok a_1)) => true
  | x, x_1 => false
'AspisR1.RPx_Deployed.deployed' depends on axioms: [propext, Classical.choice, Quot.sound]
