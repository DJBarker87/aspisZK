theorem AspisR1.NKI_ScheduleSource.source : ∀ (packed : Std.Array NQ 24#usize) (p : Public) (o : Openings)
  (s : Selectors),
  canonical packed →
    canonical o.z →
      canonical s.high →
        canonical s.low →
          ∃ l absorption middle out,
            NKI_InitialInvocation.Clauses p o s l ∧
              NKI_InitialCuts.Cut p o s l absorption (NKI_InitialCuts.observations p o s l absorption)
                  ![12, 2, 12, 9, 16, 4, 1] ∧
                pool_v1.pair_forest_semantic_terminal.semantic_initial_and_absorption p o s =
                    ok (l.initial2, absorption) ∧
                  pool_v1.pair_forest_semantic_terminal.add_preweighted packed 0#usize l.initial2 = ok middle ∧
                    pool_v1.pair_forest_semantic_terminal.add_preweighted middle 16#usize absorption = ok out ∧
                      pool_v1.pair_forest_semantic_terminal.add_schedule_lanes packed p o s = ok out ∧
                        canonical out ∧
                          ∀ (j : Fin ↑24#usize),
                            decoded out j =
                              decoded packed j + FIx_SelectedMeaning.contribution (decoded l.initial2) 0 ↑j +
                                FIx_SelectedMeaning.contribution (decoded absorption) 16 ↑j :=
fun packed p o s hp hz hh hl =>
  let ⟨l, h✝⟩ := NKI_InitialRoot.source p o s hz hh hl
  let ⟨absorption, h✝¹⟩ := h✝
  let ⟨calls, right✝⟩ := h✝¹
  let ⟨hc, right✝¹⟩ := right✝
  let ⟨reads, right✝²⟩ := right✝¹
  let ⟨wreads, right✝³⟩ := right✝²
  let ⟨df, right✝⁴⟩ := right✝³
  let ⟨dr, right✝⁵⟩ := right✝⁴
  let ⟨lanes, right✝⁶⟩ := right✝⁵
  let ⟨cut, right✝⁷⟩ := right✝⁶
  let ⟨ca, right✝⁸⟩ := right✝⁷
  let ⟨cr, right✝⁹⟩ := right✝⁸
  let ⟨cs, right✝¹⁰⟩ := right✝⁹
  let ⟨hi, ha⟩ := right✝¹⁰
  let ⟨middle, h✝²⟩ :=
    NHU_Preweighted.result packed 0#usize l.initial2 (of_decide_eq_true (id (Eq.refl true)))
      (of_decide_eq_true (id (Eq.refl true))) hp hi
  let ⟨cm, right✝¹¹⟩ := h✝²
  let ⟨hm, vm⟩ := right✝¹¹
  let ⟨out, h✝³⟩ :=
    NHU_Preweighted.result middle 16#usize absorption (of_decide_eq_true (id (Eq.refl true)))
      (of_decide_eq_true (id (Eq.refl true))) hm ha
  let ⟨co, right✝¹²⟩ := h✝³
  let ⟨ho, vo⟩ := right✝¹²
  Exists.intro l
    (Exists.intro absorption
      (Exists.intro middle
        (Exists.intro out
          ⟨calls,
            ⟨cut,
              ⟨cs,
                ⟨cm,
                  ⟨co,
                    ⟨id
                        (Eq.mpr
                          (id
                            (congrArg
                              (fun _a =>
                                (do
                                    let (initial, absorption) ← _a
                                    let packed1 ←
                                      pool_v1.pair_forest_semantic_terminal.add_preweighted packed 0#usize initial
                                    pool_v1.pair_forest_semantic_terminal.add_preweighted packed1 16#usize absorption) =
                                  ok out)
                              cs))
                          (Eq.mpr
                            (id
                              (congrArg (fun _a => _a = ok out)
                                (bind_tc_ok (l.initial2, absorption)
                                  (uncurry fun initial absorption => do
                                    let packed1 ←
                                      pool_v1.pair_forest_semantic_terminal.add_preweighted packed 0#usize initial
                                    pool_v1.pair_forest_semantic_terminal.add_preweighted packed1 16#usize
                                        absorption))))
                            (id
                              (Eq.mpr
                                (id
                                  (congrArg
                                    (fun _a =>
                                      (do
                                          let next ← _a
                                          pool_v1.pair_forest_semantic_terminal.add_preweighted next 16#usize
                                              absorption) =
                                        ok out)
                                    cm))
                                (Eq.mpr
                                  (id
                                    (congrArg (fun _a => _a = ok out)
                                      (bind_tc_ok middle fun next =>
                                        pool_v1.pair_forest_semantic_terminal.add_preweighted next 16#usize
                                          absorption)))
                                  (Eq.mpr (id (congrArg (fun _a => _a = ok out) co)) (Eq.refl (ok out)))))))),
                      ⟨ho, fun j =>
                        Eq.mpr
                          (id
                            (congrArg
                              (fun _a =>
                                _a =
                                  decoded packed j + FIx_SelectedMeaning.contribution (decoded l.initial2) 0 ↑j +
                                    FIx_SelectedMeaning.contribution (decoded absorption) 16 ↑j)
                              (vo j)))
                          (Eq.mpr
                            (id
                              (congrArg
                                (fun _a =>
                                  _a + FIx_SelectedMeaning.contribution (decoded absorption) ↑16#usize ↑j =
                                    decoded packed j + FIx_SelectedMeaning.contribution (decoded l.initial2) 0 ↑j +
                                      FIx_SelectedMeaning.contribution (decoded absorption) 16 ↑j)
                                (vm j)))
                            (Eq.refl
                              (decoded packed j + FIx_SelectedMeaning.contribution (decoded l.initial2) ↑0#usize ↑j +
                                FIx_SelectedMeaning.contribution (decoded absorption) ↑16#usize ↑j)))⟩⟩⟩⟩⟩⟩⟩)))
'AspisR1.NKI_ScheduleSource.source' depends on axioms: [propext, Classical.choice, Quot.sound]
