fun {W A F CoreError} L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps stageBase finishOps B reservation program
    data1 data2 slot saved post1 post2 H driver prior configuration hashv native1 native2 copy allocator events =>
  have port :=
    AspisR1.SdkD_Child.port adapterOps (AspisR1.Uni_Install.current ops reserved queryOps geoOps)
      (AspisR1.Op5T_Concrete.stage
        (AspisR1.Tx2N_Execution.control (AspisR1.AuS1_Install.base stageBase) reserved queryOps geoOps))
      finishOps B (AspisR1.NP6_StdModel.calls reservation);
  ∃ f s outer pre middle fs ss run tx2,
    AspisR1.Cons_Native.Calls (AspisR1.AuS1_Install.base stageBase) finishOps reserved queryOps geoOps
        (AdapterRw.SolanaDigest.Insts.Aspis_coreDigestDigest32
          (AspisR1.ClaimsUnrolledSdk.sdkOps
            (AspisR1.Tx2I_Install.install adapterOps
              (AspisR1.Op5T_Concrete.stage
                (AspisR1.Tx2N_Execution.control (AspisR1.AuS1_Install.base stageBase) reserved queryOps geoOps))
              finishOps)
            (AspisR1.Uni_Install.current ops reserved queryOps geoOps) B (AspisR1.NP6_StdModel.calls reservation)))
        () s.pub s.proof s.checkpoint tx2 ∧
      AspisR1.Rc2_Base.Outcome L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps stageBase finishOps B reservation
          program data1 data2 slot saved post1 post2 H f s outer pre middle fs ss run ∧
        AspisR1.NP6_Constructors.Contents run.initial run.pending ∧
          AspisR1.T2R_Public.Facts f.pub f.proof ∧
            AspisR1.T2R_Parser.Facts f.proof ∧
              ∃ version,
                version.key = (e1.handles 2).1 ∧
                  version.key = (e2.handles 6).1 ∧
                    version.events = events ∧
                      AspisR1.MultiproofConeCanonical.bytesOf ↑s.checkpoint =
                          AspisR1.S2W_EntryWriteHistory.payloadBytes AspisR1.S2W_ReturnedCheckpoint.encode
                            (post1.payload (e1.heap.accounts 2).1) 1768 ∧
                        AspisR1.CPP_Acceptance.Facts driver H f.pub f.proof s.pub s.proof s.checkpoint
                            (AspisR1.S2W_EntryWriteHistory.payloadBytes AspisR1.S2W_ReturnedCheckpoint.encode
                              (post1.payload (e1.heap.accounts 2).1) 1768) ∧
                          AspisR1.CPP_CallerSource.Outcome L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps
                            stageBase finishOps B (AspisR1.NP6_StdModel.calls reservation) program data1 data2 slot
                            saved post1 post2 H f s outer pre middle fs ss run prior tx2
def AspisR1.CPH_Protection.Facts : {Tx A : Type} →
  AspisR1.CPG_Projection.Observations Tx A →
    Tx → Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8 → AspisR1.S2W_ExtractionBoundary.Program → Prop :=
fun {Tx A} p t saved id =>
  have bank :=
    AspisR1.CPR_SourceBank.afterCopy (AspisR1.CPG_Projection.cached (p.bank t)) ((p.layout t).handles 2).1 saved;
  have key := ((p.layout t).handles 2).1;
  (bank.cells key).owner = id ∧
    AspisR1.Hist_Store.Initialized (bank.cells key).data ∧
      0 < bank.lamports key ∧
        (∀ event ∈ p.physicalEvents t, AspisR1.S2X.Preserves key event) ∧
          (p.parentTentative t).cells key = bank.cells key ∧ bank.lamports key ≤ (p.parentTentative t).lamports key
def AspisR1.CPH_Trace.Facts : {Tx A : Type} →
  AspisR1.CPG_Projection.Observations Tx A →
    Tx →
      Tx →
        Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8 →
          AspisR1.S2W_ExtractionBoundary.First →
            AspisR1.S2W_ExtractionBoundary.Second →
              (AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
                  ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record)) →
                AspisR1.S2W_D189Wrappers.Allocator A → AspisR1.S2W_ExtractionBoundary.Program → Prop :=
fun {Tx A} p t u saved n1 n2 copy allocator id =>
  AspisR1.CPP_BankHistory.run n1 n2 copy allocator id
        (AspisR1.CPR_SourceBank.afterCopy (AspisR1.CPG_Projection.cached (p.bank t)) ((p.layout t).handles 2).1 saved)
        (p.actions t) =
      (p.parentTentative t, p.physicalEvents t) ∧
    AspisR1.CPP_BankHistory.run n1 n2 copy allocator id (AspisR1.CPG_Projection.cached (p.bank u)) (p.actions u) =
      (p.parentTentative u, p.physicalEvents u)
def AspisR1.CPH_Recorder.Facts : {Tx A F C : Type} →
  AspisR1.DrvC_Installation.Configuration F C →
    (AspisR1.S2Z.Oracle.Parts → Aeneas.Std.Result AspisR1.S2Z.Oracle.Digest) →
      AspisR1.S2W_ExtractionBoundary.First →
        AspisR1.S2W_ExtractionBoundary.Second →
          (AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
              ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record)) →
            AspisR1.S2W_D189Wrappers.Allocator A →
              AspisR1.S2W_ExtractionBoundary.Program →
                (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
                  AspisR1.CPG_Projection.Observations Tx A → Tx → Tx → Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8 → Prop :=
fun {Tx A F C} c hashv n1 n2 copy allocator id H p t u saved =>
  (AspisV8R19.MemoizedProgramLaw.eval H
          (AspisR1.CPS_BankRecorder.program c hashv n1 n2 copy allocator id
            (AspisR1.CPR_SourceBank.afterCopy (AspisR1.CPG_Projection.cached (p.bank t)) ((p.layout t).handles 2).1
              saved)
            (p.actions t))).2 =
      (p.parentTentative t, p.physicalEvents t) ∧
    (AspisV8R19.MemoizedProgramLaw.eval H
          (AspisR1.CPS_BankRecorder.program c hashv n1 n2 copy allocator id (AspisR1.CPG_Projection.cached (p.bank u))
            (p.actions u))).2 =
      (p.parentTentative u, p.physicalEvents u)
def AspisR1.CPR_DataPersistence.TwoTransactionLaw : {Tx Key : Type} →
  (Tx → Tx → Prop) →
    (Tx → Key → Prop) →
      (Tx → Key → AspisR1.CPR_DataPersistence.Image) →
        (Tx → Key → AspisR1.CPR_DataPersistence.Image) →
          (Tx → Bool) → (Tx → Key → Option AspisV8R19.DuplexFrames.Bytes) → Prop :=
fun {Tx Key} next ordinary before tentative success loaded =>
  ∀ (t u : Tx),
    next t u →
      ∀ (key : Key),
        ordinary t key →
          loaded u key =
            AspisR1.CPR_DataPersistence.visible (if success t = Bool.true then tentative t key else before t key)
