theorem accepted_input {W A F CoreError : Type}
    (L : Library W (Nat → Record)) (e1 e2 : Entry) (w1 w2 : W)
    (adapterOps : AdapterRw.Ops) (ops : Ops) (reserved : Bool)
    (queryOps : Port3_NativeQueryBody.Ops) (geoOps : Port3_NativeGeometryBody.Ops CoreError)
    (stageBase : VTop_Stages.Ops) (finishOps : AspisR1Stage2.Stage2Finish.FinishOps F)
    (B : AspisR1PublicPreparation.FinishModel.Boundaries) (reservation : NP6_StdModel.Reservation)
    (program : S2W_ExtractionBoundary.Program) (data1 data2 : Slice U8) (slot : S2W_ExtractionBoundary.Slot)
    (saved : alloc.vec.Vec U8) (post1 post2 : Heap (Nat → Record))
    (H : Bytes → State)
    (driver : OraclePortStoredExperimentC4.Input → Program Bytes State Bool)
    (prior : Program Bytes State Unit)
    (configuration : DrvC_Installation.Configuration F CoreError)
    (hashv : S2Z.Oracle.Parts → Result S2Z.Oracle.Digest)
    (native1 : S2W_ExtractionBoundary.First) (native2 : S2W_ExtractionBoundary.Second)
    (copy : Heap (Nat → Record) → Nat → Payload → S2W_TrustedStd.Outcome (Nat → Record))
    (allocator : Allocator A) (events : List S2X.AccountEvent)
    (result : CPH_Result.Outcome L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps stageBase finishOps B reservation program data1 data2 slot saved post1 post2 H driver prior configuration hashv native1 native2 copy allocator events) :
    ∃ (f : FirstCut) (s : SecondCut) (i : OraclePortStoredExperimentC4.Input),
      i.statement.pubBytes = bytesOf f.pub.val ∧ i.stored = bytesOf f.proof.val ∧
      i.statement.tag = 2 ∧ i.statement.pubBytes.length = 1880 ∧
      (P2Prime H f.proof f.pub s.proof s.pub →
        (eval H (driver i)).2 = true ∧ ¬ (∀ j, (eval H (driver j)).2 = false)) := by
  obtain ⟨f,s,outer,pre,middle,fs,ss,run,tx2,calls,base,initial,publicFacts,parser,
    version,key1,key2,eventMatch,persisted,accepted,caller⟩ := result
  obtain ⟨i,pub,proof,tag,size,fit,yes⟩ := accepted
  exact ⟨f,s,i,pub,proof,tag,size,yes⟩

#print axioms accepted_input
end AspisR1.CPH_Nonrejecting
