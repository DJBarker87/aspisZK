def AspisR1CurrentCaller.InstalledPreparation.selectedView : AspisR1SelectedWideViewV1.verifier.View →
  AspisR1CurrentCaller.verifier.View :=
fun x =>
  {
    variant :=
      match x.variant with
      | AspisR1SelectedWideViewV1.transport.Variant.S1 => AspisR1CurrentCaller.transport.Variant.S1
      | AspisR1SelectedWideViewV1.transport.Variant.S2 => AspisR1CurrentCaller.transport.Variant.S2
      | AspisR1SelectedWideViewV1.transport.Variant.D => AspisR1CurrentCaller.transport.Variant.D,
    semantic := x.semantic, y1 := x.y1, inactive := AspisR1CurrentCaller.InstalledPreparation.selectedE x.inactive,
    round0 := x.round0, folded_root := x.folded_root, round1 := x.round1, final_message := x.final_message,
    query_bytes := x.query_bytes }
def AspisR1.NHF_ViewResult.model : (proof : Aeneas.Std.Slice Aeneas.Std.U8) →
  Aeneas.Std.Slice Aeneas.Std.U8 →
    Aeneas.Std.Slice Aeneas.Std.U8 →
      10055 ≤ (↑proof).length →
        Aeneas.Std.core.result.Result AspisR1SelectedWideViewV1.verifier.View
          AspisR1SelectedWideViewV1.verifier.Error :=
fun proof semantic y1 size =>
  match
    AspisR1.StrictWideByteCodec.decodeWideLE
      (AspisR1.WideParserArrayHalves.arrayBytes32 (AspisR1.NHF_ViewResult.input proof size)) with
  | none => Aeneas.Std.core.result.Result.Err AspisR1SelectedWideViewV1.verifier.Error.Parse
  | some wide =>
    Aeneas.Std.core.result.Result.Ok
      (AspisR1.NHF_ViewFinish.value proof semantic y1
        (AspisR1SelectedWideViewV1.parserCarrier (AspisR1.CandidateWideParserRefinement.limbsToCandidate wide)) size)
def LIB_Carriers.graph : {A : Type} → (RSL.Env → A) → (RSL.Env → List RSL.Event) → RSL.Spec A :=
fun {A} value events env o => o = { exit := RSL.Exit.ret (value env), events := events env }
