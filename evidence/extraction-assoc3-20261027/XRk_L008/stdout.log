structure Aeneas.Std.core.slice.iter.IterMut (T : Type) : Type
number of parameters: 1
fields:
  Aeneas.Std.core.slice.iter.IterMut.slice : Slice T
  Aeneas.Std.core.slice.iter.IterMut.i : ℕ :=
    0
constructor:
  Aeneas.Std.core.slice.iter.IterMut.mk {T : Type} (slice : Slice T) (i : ℕ) : core.slice.iter.IterMut T
def Aeneas.Std.core.slice.iter.IteratorIterMut.next : {T : Type} →
  core.slice.iter.IterMut T →
    Result
      (Option T × core.slice.iter.IterMut T × (core.slice.iter.IterMut T → Option T → core.slice.iter.IterMut T)) :=
fun {T} it =>
  if h : it.i < ↑it.slice.len then
    have x := it.slice[it.i];
    have i := it.i;
    have it := { slice := it.slice, i := i + 1 };
    have back := fun it' x =>
      match x with
      | none => it'
      | some x => { slice := it'.slice.setAtNat i x, i := it'.i };
    Result.ok (some x, it, back)
  else Result.ok (none, it, fun it x => it)
def Aeneas.Std.core.iter.adapters.enumerate.IteratorEnumerate.next : {I Item : Type} →
  core.iter.traits.iterator.Iterator I Item →
    core.iter.adapters.enumerate.Enumerate I →
      Result (Option (Usize × Item) × core.iter.adapters.enumerate.Enumerate I) :=
fun {I Item} IteratorInst self => do
  let __x ← IteratorInst.next self.iter
  match __x with
    | (opt, iter') =>
      match opt with
      | none => Result.ok (none, { iter := iter', count := self.count })
      | some a => do
        let count' ← self.count + 1#usize
        Result.ok (some (self.count, a), { iter := iter', count := count' })
def Aeneas.Std.core.iter.adapters.rev.Rev.Insts.CoreIterTraitsIteratorIterator.next : {I Item : Type} →
  core.iter.traits.double_ended.DoubleEndedIterator I Item →
    core.iter.adapters.rev.Rev I → Result (Option Item × core.iter.adapters.rev.Rev I) :=
fun {I Item} DEInst self => do
  let __x ← DEInst.next_back self.iter
  match __x with
    | (o, it) => Result.ok (o, { iter := it })
