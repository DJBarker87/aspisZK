+#[cfg(kani)]
+mod NJG_row_parts {
+ use super::*;use crate::field::{QM31,CM31,M31};
+ type Claims=[[QM31;29];3];
+ fn word(q:QM31,limb:u8)->u32{match limb{0=>q.c0.a.0,1=>q.c0.b.0,2=>q.c1.a.0,_=>q.c1.b.0}}
+ #[kani::proof] #[kani::unwind(32)]
+ #[kani::stub(core::ptr::copy_nonoverlapping,crate::NJG_kmx::KMX_copy_nonoverlapping)]
+ fn remaining_value(){
+  let p:usize=kani::any();kani::assume(p<3);
+  let k:usize=kani::any();kani::assume(k<29);
+  let limb:u8=kani::any();kani::assume(limb>=1 && limb<4);
+  let row:[QM31;29]=core::array::from_fn(|_|QM31{c0:CM31{a:M31(kani::any()),b:M31(kani::any())},c1:CM31{a:M31(kani::any()),b:M31(kani::any())}});
+  let mut out=MaybeUninit::<Claims>::uninit();unsafe{
+   let dst=out.as_mut_ptr().cast::<[QM31;29]>().add(p);dst.write(row);
+   #[cfg(not(NJG_negative))] assert_eq!(word((*dst)[k],limb),word(row[k],limb));
+   #[cfg(NJG_negative)] assert_eq!(word((*dst)[k],limb),word(row[k],limb)^1);
+  }
+ }
+ #[kani::proof] #[kani::unwind(32)]
+ #[kani::stub(core::ptr::copy_nonoverlapping,crate::NJG_kmx::KMX_copy_nonoverlapping)]
+ fn disjoint_frame(){
+  let p:usize=kani::any();kani::assume(p<3);
+  let q:usize=kani::any();kani::assume(q<3 && q!=p);
+  let k:usize=kani::any();kani::assume(k<29);
+  let before:u32=kani::any();let limb:usize=kani::any();kani::assume(limb<4);
+  let row:[QM31;29]=core::array::from_fn(|_|QM31{c0:CM31{a:M31(kani::any()),b:M31(kani::any())},c1:CM31{a:M31(kani::any()),b:M31(kani::any())}});
+  let mut out=MaybeUninit::<Claims>::uninit();unsafe{
+   assert_eq!(core::mem::size_of::<Claims>(),1392);assert_eq!(core::mem::size_of::<QM31>(),16);assert_eq!(core::mem::align_of::<QM31>(),4);
+   let base=out.as_mut_ptr();let observed=base.cast::<u32>().add(4*(29*q+k)+limb);observed.write(before);
+   base.cast::<[QM31;29]>().add(p).write(row);
+   #[cfg(not(NJG_negative))] assert_eq!(observed.read(),before);
+   #[cfg(NJG_negative)] assert_eq!(observed.read(),before^1);
+  }
+ }
