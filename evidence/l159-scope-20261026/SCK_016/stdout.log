                            AspisR1.OraclePortSelectedDraft.queries tr = some q ∧
                              AspisR1.OraclePortStoredDecisionDraftC4.input p q tr = some data ∧
                                AspisR1.Cons_Native.Calls
                                    (AspisR1.Op5T_Concrete.stage (AspisR1.AuS1_Install.base c.stageBase)) c.finish
                                    c.reserved c.query c.geometry (AspisR1.F3V_RunEvidence.D2 c H) () e.pub e.proof
                                    e.saved.deref t ∧
