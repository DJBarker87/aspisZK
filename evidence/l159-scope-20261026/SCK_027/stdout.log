      f s)
  (recorded : AspisR1.RawJ_RecordCuts.Recorded f s saved log)
  (ran :
    AspisR1.S2W_Trace.run (AspisR1.SdkD_PairBatches.dictionary adapter ops stage finish reserved query geo B std)
        (AspisR1.S2W_Observation.two
          (AspisR1.SdkD_PairBatches.dictionary adapter ops stage finish reserved query geo B std) id accounts1 data1
          accounts2 data2 slot)
        [] =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok saved, log))
  (run :
    AspisR1.Tx1Q_Execution.Run
      (AspisR1.Tx1Q_Execution.actual (AspisR1.Op5T_Concrete.current ops) reserved query geo B std) reserved query geo
      (AspisR1.SdkD_PairBatches.current adapter ops stage finish reserved query geo B std) ()
      (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.pub f.proof f.split saved)
  (zero :
    AspisR1CurrentCaller.aspis_core.field.wide_exact.WideExact.ZERO
        (AspisR1.Tx1Q_Execution.actual (AspisR1.Op5T_Concrete.current ops) reserved query geo B std) =
      Aeneas.Std.Result.ok run.zero)
  (view : Aeneas.Std.Slice Aeneas.Std.U8)
  (range :
    Aeneas.Std.core.slice.index.Slice.index (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8)
        f.proof { start := 7751#usize, «end» := 7783#usize } =
      Aeneas.Std.Result.ok view)
  (copy :
    Aeneas.Std.core.array.TryFromArrayCopySlice.try_from 32#usize Aeneas.Std.core.marker.CopyU8 view =
