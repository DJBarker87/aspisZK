  (p2 : AspisR1Stage2.verifier.Prepared) (a2 : AspisR1Stage2.verifier.Accumulator)
  (root2 : Aeneas.Std.Array Aeneas.Std.U8 32#usize) (view2 : Aeneas.Std.Slice Aeneas.Std.U8)
  (reader :
