def AspisR1.SCK_Residuals.R1 : {A F C : Type} →
  AspisR1.DrvC_Installation.Configuration F C →
    (AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest) →
      (AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
          ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record)) →
        AspisR1.S2W_D189Wrappers.Allocator A →
          AspisR1.S2W_ExtractionBoundary.Program → AspisR1.SCE_Experiment.Adversary A → Prop :=
fun {A F C} c hashv copy allocator id a =>
  ∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
    AspisR1.SCE_Experiment.accepted
          (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.SCE_Experiment.account c hashv copy allocator id a)).2 =
        true →
      ∃ saved post final f s,
        (AspisV8R19.MemoizedProgramLaw.eval H
                (AspisR1.SCE_Execution.firstCode c hashv copy allocator id
                  (AspisV8R19.MemoizedProgramLaw.eval H a.first).2)).2 =
            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post, final)) ∧
          AspisR1.S2W_NativeConsolidation.SourceCuts (AspisR1.SCH_IdealSdk.dictionary c hashv H)
              (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.entry.first
              ((AspisV8R19.MemoizedProgramLaw.eval H
                        (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post final)).2.entry.second
                AspisR1.S2W_D189Wrappers.secondSizes)
              saved f s ∧
            AspisR1.MultiproofConeCanonical.bytesOf ↑s.checkpoint = AspisR1.MultiproofConeCanonical.bytesOf ↑saved
def AspisR1.SCK_Residuals.R2 : {A F C : Type} →
  AspisR1.DrvC_Installation.Configuration F C →
    (AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest) →
      (AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
          ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record)) →
        AspisR1.S2W_D189Wrappers.Allocator A →
          AspisR1.S2W_ExtractionBoundary.Program →
            AspisR1.SCE_Experiment.Adversary A →
              ℕ →
                ℕ →
                  (AspisR1.GExq_AccountExperiment.Outcome A →
                      AspisR1.OraclePortCompactDraft.Parsed × (Fin 22 → Fin 262144)) →
                    (AspisR1.GExq_AccountExperiment.Outcome A →
                        AspisR1.R9PoolRuntimeBinding.Inputs × AspisR1.R9PoolRuntimeBinding.Inputs) →
                      (AspisR1.F3X_Projection.Output →
                          AspisR1.R9PoolRuntimeBinding.Inputs × AspisR1.R9PoolRuntimeBinding.Inputs) →
                        Prop :=
fun {A F C} c hashv copy allocator id a Q0 Q1 project select sourceSelect =>
  ∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
    AspisR1.SCE_Experiment.accepted
          (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.SCE_Experiment.account c hashv copy allocator id a)).2 =
        true →
      AspisR1.BinRawByteCollisionTargets.event AspisR1.SelectedTranscriptParams.params.iv (Q0 + Q1 + 2965)
          (AspisV8R19.MemoizedProgramLaw.eval H
            (AspisR1.Hiq_RecordedJoint.program
              (AspisR1.F3X_Account.program c hashv (AspisR1.SCE_Experiment.submission a)) AspisR1.F3X_Projection.project
              sourceSelect)) →
        AspisR1.BinRawByteCollisionTargets.event AspisR1.SelectedTranscriptParams.params.iv (Q0 + Q1 + 2965)
          (AspisV8R19.MemoizedProgramLaw.eval H
            (AspisR1.Hiq_RecordedJoint.program (AspisR1.SCE_Experiment.account c hashv copy allocator id a) project
              select))
def AspisR1.F3T_Runtime.StoredCarrierBinding : {F C : Type} →
  AspisR1.DrvC_Installation.Configuration F C →
    AspisR1.LiteralByteProtocol.Decoder →
      AspisR1.F3T_TwoPass.Verifier → AspisR1.F3T_ByteCarrier.ByteProver → AspisR1.F3T_Runtime.Runtime → Prop :=
fun {F C} c D rust P runtime =>
  ∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) (run : AspisR1.F3T_Experiment.RunView),
    (AspisV8R19.MemoizedProgramLaw.eval H runtime).2 = some run →
      run.2.2 = true →
        run =
          AspisV8R19.MemoizedProgramLaw.eval H
            (AspisR1.F3T_TwoPass.annotatedWith D rust (AspisR1.F3T_Canon.canon (AspisR1.F3T_ByteCarrier.lift c P)))
def AspisR1.SCF_RequiredTransport.CleanAccountTransport : {A F C : Type} →
  AspisR1.DrvC_Installation.Configuration F C →
    AspisR1.LiteralByteProtocol.Decoder →
      (AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest) →
        (AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
            ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record)) →
          AspisR1.S2W_D189Wrappers.Allocator A →
            AspisR1.S2W_ExtractionBoundary.Program →
              AspisR1.SCE_Experiment.Adversary A →
                ℕ →
                  ℕ →
                    (AspisR1.GExq_AccountExperiment.Outcome A →
                        AspisR1.OraclePortCompactDraft.Parsed × (Fin 22 → Fin 262144)) →
                      (AspisR1.GExq_AccountExperiment.Outcome A →
                          AspisR1.R9PoolRuntimeBinding.Inputs × AspisR1.R9PoolRuntimeBinding.Inputs) →
                        Prop :=
fun {A F C} c D hashv copy allocator id a Q0 Q1 project select =>
  ∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
    have v := AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.SCE_Experiment.account c hashv copy allocator id a);
    have physical :=
      AspisR1.F3T_Experiment.view
        (v.1, AspisR1.F3T_Canon.canonInput (AspisR1.F3T_ByteCarrier.input c (AspisR1.SCE_Experiment.submitted v.2.1)),
          AspisR1.SCE_Experiment.accepted v.2);
    have model :=
      AspisV8R19.MemoizedProgramLaw.eval H
        (AspisR1.F3T_Charged.projected D
          (AspisR1.F3T_Canon.canon (AspisR1.F3T_ByteCarrier.lift c (AspisR1.SCE_Experiment.submission a))));
    physical.2.2 = true →
      ¬AspisR1.BinRawByteCollisionTargets.event AspisR1.SelectedTranscriptParams.params.iv (Q0 + Q1 + 2965)
            (AspisV8R19.MemoizedProgramLaw.eval H
              (AspisR1.Hiq_RecordedJoint.program (AspisR1.SCE_Experiment.account c hashv copy allocator id a) project
                select)) →
        model.2.2 = true ∧ AspisR1.OraclePortRefineJoin.RecoveredInputAgreement physical model
