AspisR1.F3S_ModelLog.schedule (D : AspisR1.LiteralByteProtocol.Decoder)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) (i : AspisR1.F3_Model.Input)
  (p : AspisR1.OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144)
  (input : AspisR1.RecordedBinaryExperimentBin.SourceInputs) (v : AspisR1.LiteralOpeningView.View)
  (guard :
    AspisR1.OraclePortAdmission.Guard
      (AspisR1.LiteralTranscript.erasePrefix
        (AspisV8R19.MemoizedProgramLaw.eval H
            (AspisR1.F3J_SamplerRun.program i.proof 0 33 (FS.emptyPrefix i.semantic.value))).2))
  (parser :
    AspisR1.OraclePortStoredParserC4.parseReached i.stored
        (AspisR1.LiteralTranscript.erasePrefix
          (AspisV8R19.MemoizedProgramLaw.eval H
              (AspisR1.F3J_SamplerRun.program i.proof 0 33 (FS.emptyPrefix i.semantic.value))).2) =
      some p)
  (queries :
    AspisR1.OraclePortSelectedDraft.queries
        (AspisR1.LiteralTranscript.erasePrefix
