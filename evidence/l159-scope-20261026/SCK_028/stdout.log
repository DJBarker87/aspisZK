              (AspisR1.F3J_SamplerRun.program i.proof 0 33 (FS.emptyPrefix i.semantic.value))).2) =
      some q)
  (found :
    AspisR1.OraclePortStoredDecisionDraftC4.input p q
        (AspisR1.LiteralTranscript.erasePrefix
          (AspisV8R19.MemoizedProgramLaw.eval H
              (AspisR1.F3J_SamplerRun.program i.proof 0 33 (FS.emptyPrefix i.semantic.value))).2) =
      some input)
  (opening :
    AspisR1.LiteralOpeningView.read
        (AspisR1.OraclePortStoredDecisionDraftC4.typedRows p q
          (AspisR1.LiteralTranscript.erasePrefix
            (AspisV8R19.MemoizedProgramLaw.eval H
                (AspisR1.F3J_SamplerRun.program i.proof 0 33 (FS.emptyPrefix i.semantic.value))).2)) =
      some v)
  (batch0 :
    (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.OraclePortFrozen2.batch p q AspisR1.OraclePortFrozen2.batch0)).2 =
      true) :
  (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3_Model.verifier D i)).1 =
    (AspisV8R19.MemoizedProgramLaw.eval H
          (AspisR1.F3J_SamplerRun.program i.proof 0 33 (FS.emptyPrefix i.semantic.value))).1 ++
      ((AspisV8R19.MemoizedProgramLaw.eval H
            (AspisR1.OraclePortFrozen2.batch p q AspisR1.OraclePortFrozen2.batch0)).1 ++
        ((AspisV8R19.MemoizedProgramLaw.eval H
