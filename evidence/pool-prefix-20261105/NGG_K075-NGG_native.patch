+use super::*;
+use aspis_statement::pool_v1::*;
+fn digest()->aspis_statement::Digest{core::array::from_fn(|_|aspis_core::field::M31(kani::any()))}
+fn any_PoolV1PrivateTransferPublicV1()->PoolV1PrivateTransferPublicV1{PoolV1PrivateTransferPublicV1{pool:kani::any(),deployment_domain:kani::any(),anchor_sequence:kani::any(),anchor_root:digest(),nullifier:digest(),asset_id:aspis_core::field::M31(kani::any()),recipient_commitment:digest(),change_commitment:digest()}}
+fn any_PoolV1WithdrawalPublicV1()->PoolV1WithdrawalPublicV1{PoolV1WithdrawalPublicV1{pool:kani::any(),deployment_domain:kani::any(),anchor_sequence:kani::any(),anchor_root:digest(),nullifier:digest(),asset_id:aspis_core::field::M31(kani::any()),amount:kani::any(),destination_token_account:kani::any(),change_commitment:digest()}}
+fn prefix<'a,'b,F>(accounts:&'a [AccountInfo<'b>],instruction_data:&[u8],decode:F)->Result<(Box<PoolV1PairForestTerminalRequestV1>,&'a AccountInfo<'b>,&'a AccountInfo<'b>,&'a AccountInfo<'b>,PoolV1PairForestTerminalBumpHintsV1),ProgramError>
+where F:FnOnce(&[u8])->Result<Box<PoolV1PairForestTerminalRequestV1>,ProgramError>{
+    let (request_bytes, hints) = split_pair_forest_terminal_bump_hints_v1(instruction_data)?;
+    let request = decode(request_bytes)?;
+    let master_account = accounts.first().ok_or(ProgramError::NotEnoughAccountKeys)?;
+    let checkpoint_account = accounts.get(1).ok_or(ProgramError::NotEnoughAccountKeys)?;
+    let lane_account = accounts.get(2).ok_or(ProgramError::NotEnoughAccountKeys)?;
+Ok((request,master_account,checkpoint_account,lane_account,hints))
+}
