 flat.extend_from_slice(&values);\n            line_z_values.push(line_z);\n        }\n        if flat.is_empty(){return Ok(Self{start,inverses:Vec::new(),line_z:line_z_values});}\n        // Standard prefix-product/backward batch inversion. The only `inv`\n        // in this routine is applied to the product of all nonzero entries.\n        let (prefixes,product)=batch_prefix_products(&flat);\n        let mut suffix_inverse=product.inv();\n        let mut flat_inverse=Vec::with_capacity(flat.len());\n        flat_inverse.resize(flat.len(),M31::ZERO);\n        for i in (0..flat.len()).rev() {\n            flat_inverse[i]=suffix_inverse.mul(prefixes[i]);\n            suffix_inverse=suffix_inverse.mul(flat[i]);\n        }\n        let inverses=(0..line_z_values.len()).map(|i|core::array::from_fn(|j|flat_inverse[5*i+j])).collect();\n        Ok(Self{start,inverses,line_z:line_z_values})\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Opaque","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[8437,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":1675},"Shared"]}]},{"Deduplicated":1160},{"Deduplicated":1160}],"output":{"Deduplicated":1672}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":13,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Impl":{"Trait":14}},{"Ident":["deref",0]}],"span":{"data":{"file_id":11,"beg":{"line":3793,"col":4},"end":{"line":3793,"col":27}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"nam