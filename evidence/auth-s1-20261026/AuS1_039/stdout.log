theorem AspisR1CurrentCaller.BorrowedClaimPrepared.NativeBuffers.prepare_physical_roots : ∀
  (ops : AspisR1CurrentCaller.Ops) (native : AspisS1NativeCompact.Ops)
  (R : AspisR1PublicPreparation.RoundModel.Boundaries) (B : AspisR1PublicPreparation.FinishModel.Boundaries),
  (∀ (input output : Slice U8) (status : core.result.Result Unit AspisR1CurrentCaller.compact.CodecError)
      (updated : Slice U8), ops.op11 input output = ok (status, updated) → updated.length = output.length) →
    ∀ {H : Type} (D : AspisR1CurrentCaller.aspis_core.digest.Digest32 H)
      (pub : AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public) (proof : Slice U8)
      (hash : H) (prepared : AspisR1CurrentCaller.verifier.Prepared)
      (input scratch : Std.Array AspisR1CurrentCaller.aspis_core.field.wide_exact.WideExact 29#usize),
      AspisR1CurrentCaller.verifier.candidate.prepare
            (AspisR1CurrentCaller.BorrowedClaimPrepared.NativeBuffers.install ops native R B) D pub proof hash none
            input =
          ok (core.result.Result.Ok prepared, scratch) →
        ∃ root0 root1,
          prepared.roots = Array.make 2#usize [root0, root1] ⋯ ∧
            ↑root0 = List.slice 16 48 ↑proof ∧ ↑root1 = List.slice 63 95 ↑proof :=
fun ops native R B valueLength {H} D pub proof hash prepared input scratch success =>
  let ⟨root0, h✝⟩ :=
    AspisR1CurrentCaller.BorrowedClaimPrepared.NativeBuffers.prepare_physical_root0 ops native R B valueLength D pub
      proof hash prepared input scratch success
  let ⟨root1, h✝¹⟩ := h✝
  let ⟨oldRoots, physical0⟩ := h✝¹
  let ⟨stored, h✝²⟩ :=
    AspisR1CurrentCaller.BorrowedClaimPrepared.NativeBuffers.prepare_buffers ops native R B valueLength D pub proof hash
      prepared input scratch success
  let ⟨initial, h✝³⟩ := h✝²
  let ⟨expanded, h✝⁴⟩ := h✝³
  let ⟨y1, h✝⁵⟩ := h✝⁴
  let ⟨view, h✝⁶⟩ := h✝⁵
  let ⟨sem, h✝⁷⟩ := h✝⁶
  let ⟨hstored, right✝⟩ := h✝⁷
  let ⟨hexpanded, right✝¹⟩ := right✝
  let ⟨hview, right✝²⟩ := right✝¹
  let ⟨hviewSemantic, right✝³⟩ := right✝²
  let ⟨hsem, hnew⟩ := right✝³
  have fields :=
    AspisR1CurrentCaller.BorrowedClaimPrepared.originalNew_static
      (AspisR1CurrentCaller.OriginalSerializerInstallation.withOriginalSerializer
        AspisR1CurrentCaller.BorrowedClaimPrepared.closedSampling)
      AspisS1M31Embedding.Total.embed D sem view hash prepared scratch input hnew;
  let ⟨pre, h✝⁸⟩ := AspisR1CurrentCaller.S1SemanticInstallation.verify_roots R B D pub expanded hash sem hsem
  let ⟨initialTranscript, h✝⁹⟩ := h✝⁸
  let ⟨after, h✝¹⁰⟩ := h✝⁹
  let ⟨challenges, h✝¹¹⟩ := h✝¹⁰
  let ⟨payload, h✝¹²⟩ := h✝¹¹
  let ⟨second, h✝¹³⟩ := h✝¹²
  let ⟨parsed, right✝⁴⟩ := h✝¹³
  let ⟨publicInit, right✝⁵⟩ := right✝⁴
  let ⟨begin, right✝⁶⟩ := right✝⁵
  let ⟨finish, right✝⁷⟩ := right✝⁶
  let ⟨hpayload, right✝⁸⟩ := right✝⁷
  let ⟨hcopy, right✝⁹⟩ := right✝⁸
  let ⟨hpayloadBytes, hroots⟩ := right✝⁹
  have payloadBytes := AspisS1ParsedSecondRootBytes.row2_bytes expanded pre payload parsed hpayload;
  have nativePrefix := AspisS1NativeCompactPrefix79.semantic_prefix79 native stored initial expanded hexpanded;
  have physical1 :=
    Eq.trans hpayloadBytes
      (Eq.trans payloadBytes
        (AspisR1CurrentCaller.BorrowedClaimPrepared.NativeBuffers.physical_second_segment✝ proof stored expanded hstored
          nativePrefix));
  have newRoots := Eq.trans fields.right.left hroots;
  have identities := congrArg (fun a => ↑a) (Eq.trans (Eq.symm newRoots) oldRoots);
  id
    (fun identities =>
      have sameSecond := (List.cons.inj (List.cons.inj identities).right).left;
      Exists.intro root0
        (Exists.intro root1
          ⟨oldRoots,
            ⟨physical0,
              Eq.mpr (id (congrArg (fun _a => ↑_a = List.slice 63 95 ↑proof) (Eq.symm sameSecond))) physical1⟩⟩))
    identities
