def Aeneas.Std.alloc.vec.Vec.extend_from_slice : {T : Type} →
  core.clone.Clone T → alloc.vec.Vec T → Slice T → Result (alloc.vec.Vec T) :=
fun {T} cloneInst v s =>
  if h : v.length + s.length ≤ Usize.max then
    match h' : Slice.clone cloneInst.clone s with
    | ok s' => ok ⟨↑v ++ ↑s', ⋯⟩
    | fail e => fail e
    | div => div
  else fail Error.panic
def Aeneas.Std.alloc.vec.Vec.with_capacity : (T : Type) → Usize → alloc.vec.Vec T :=
fun T x => alloc.vec.Vec.new T
def Aeneas.Std.alloc.vec.Vec.deref : {T : Type} → alloc.vec.Vec T → Slice T :=
fun {T} v => ⟨↑v, ⋯⟩
@[reducible] def Aeneas.Std.core.clone.CloneU8 : core.clone.Clone U8 :=
{ clone := liftFun1 core.clone.impls.CloneU8.clone }
def AspisR1CurrentCaller.InstalledPreparation.sourceView : Slice U8 →
  Slice U8 →
    Slice U8 → Result (core.result.Result AspisR1CurrentCaller.verifier.View AspisR1CurrentCaller.verifier.Error) :=
fun proof semantic y1 => do
  let r ← AspisR1SelectedWideViewV1.verifier.candidate.wide_view proof semantic y1
  ok
      (match r with
      | core.result.Result.Ok v => core.result.Result.Ok (AspisR1CurrentCaller.InstalledPreparation.selectedView v)
      | core.result.Result.Err e => core.result.Result.Err (AspisR1CurrentCaller.InstalledPreparation.selectedError e))
def AspisR1CurrentCaller.InstalledPreparation.selectedView : AspisR1SelectedWideViewV1.verifier.View →
  AspisR1CurrentCaller.verifier.View :=
fun x =>
  {
    variant :=
      match x.variant with
      | AspisR1SelectedWideViewV1.transport.Variant.S1 => AspisR1CurrentCaller.transport.Variant.S1
      | AspisR1SelectedWideViewV1.transport.Variant.S2 => AspisR1CurrentCaller.transport.Variant.S2
      | AspisR1SelectedWideViewV1.transport.Variant.D => AspisR1CurrentCaller.transport.Variant.D,
    semantic := x.semantic, y1 := x.y1, inactive := AspisR1CurrentCaller.InstalledPreparation.selectedE x.inactive,
    round0 := x.round0, folded_root := x.folded_root, round1 := x.round1, final_message := x.final_message,
    query_bytes := x.query_bytes }
def AspisR1SelectedWideViewV1.verifier.candidate.wide_view : Slice U8 →
  Slice U8 →
    Slice U8 →
      Result (core.result.Result AspisR1SelectedWideViewV1.verifier.View AspisR1SelectedWideViewV1.verifier.Error) :=
fun proof semantic y1 => do
  let i ← AspisR1SelectedWideViewV1.compact.OFF_INACTIVE
  let i1 ← AspisR1SelectedWideViewV1.compact.OFF_ROUND0
  let s ← core.slice.index.Slice.index (core.slice.index.SliceIndexRangeUsizeSlice U8) proof { start := i, «end» := i1 }
  let o ← AspisR1SelectedWideViewV1.viewFromBytes s
  let r ← AspisR1SelectedWideViewV1.viewOptionOkOr o AspisR1SelectedWideViewV1.verifier.Error.Parse
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
    | core.ops.control_flow.ControlFlow.Continue val => do
      let i2 ← AspisR1SelectedWideViewV1.compact.OFF_FOLDED_ROOT
      let s1 ←
        core.slice.index.Slice.index (core.slice.index.SliceIndexRangeUsizeSlice U8) proof { start := i1, «end» := i2 }
      let i3 ← AspisR1SelectedWideViewV1.compact.OFF_ROUND1
      let s2 ←
        core.slice.index.Slice.index (core.slice.index.SliceIndexRangeUsizeSlice U8) proof { start := i2, «end» := i3 }
      let r1 ← core.array.TryFromSharedArraySlice.try_from 32#usize s2
      let a ← core.result.Result.unwrap core.fmt.DebugTryFromSliceError r1
      let i4 ← AspisR1SelectedWideViewV1.compact.OFF_FINAL
      let s3 ←
        core.slice.index.Slice.index (core.slice.index.SliceIndexRangeUsizeSlice U8) proof { start := i3, «end» := i4 }
      let i5 ← AspisR1SelectedWideViewV1.compact.OFF_OPENINGS
      let s4 ←
        core.slice.index.Slice.index (core.slice.index.SliceIndexRangeUsizeSlice U8) proof { start := i4, «end» := i5 }
      let s5 ← core.slice.index.Slice.index (core.slice.index.SliceIndexRangeToUsizeSlice U8) proof { «end» := 0#usize }
      ok
          (core.result.Result.Ok
            { variant := AspisR1SelectedWideViewV1.transport.Variant.S2, semantic := semantic, y1 := y1,
              inactive := val, round0 := s1, folded_root := some a, round1 := s3, final_message := s4,
              query_bytes := s5 })
    | core.ops.control_flow.ControlFlow.Break residual =>
      core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
        AspisR1SelectedWideViewV1.verifier.View (core.convert.FromSame AspisR1SelectedWideViewV1.verifier.Error)
        residual
def AspisR1PublicPreparation.transport.Variant.folds : AspisR1PublicPreparation.transport.Variant → Result Usize :=
fun self => do
  let b ←
    AspisR1PublicPreparation.transport.Variant.Insts.CoreCmpPartialEqVariant.eq self
        AspisR1PublicPreparation.transport.Variant.S1
  if b = true then ok 1#usize else ok 2#usize
def AspisR1PublicPreparation.transport.Variant.Insts.CoreCmpPartialEqVariant.eq : AspisR1PublicPreparation.transport.Variant →
  AspisR1PublicPreparation.transport.Variant → Result Bool :=
fun self other =>
  have self1 := self.read_discriminant;
  have other1 := other.read_discriminant;
  ok (decide (self1 = other1))
