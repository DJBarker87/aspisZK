ead":1},"comments_before":[]},{"span":{"data":{"file_id":3,"beg":{"line":265,"col":4},"end":{"line":268,"col":6}},"generated_from_span":null},"id":408,"kind":"Return","comments_before":[]}]},"comments":[]}}}],"global_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["aspis_core",0]},{"Ident":["transcript",0]},{"Ident":["CIRCLE_FALLBACK_PARAMETERS",0]}],"span":{"data":{"file_id":0,"beg":{"line":271,"col":0},"end":{"line":280,"col":2}},"generated_from_span":null},"source_text":"pub const CIRCLE_FALLBACK_PARAMETERS: [QM31; 2] = [\n    QM31 {\n        c0: crate::field::CM31::ZERO,\n        c1: crate::field::CM31::ONE,\n    },\n    QM31 {\n        c0: crate::field::CM31::ONE,\n        c1: crate::field::CM31::ONE,\n    },\n];","attr_info":{"attributes":[{"DocComment":" Fixed rational-map parameters used by the R0 reference schedule when a"},{"DocComment":" sampled circle parameter is rejected: `t₀ = (0 + 1·u)`, `t₁ = (1 + 1·u)`"},{"DocComment":" in `(c0, c1)` tower order, i.e. `R0P.CircleSampler.circleFallbackParameter0/1`."},{"DocComment":" Both have `c1 ≠ 0`, so neither is a pole nor in CM31, and they differ."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"ty":{"Deduplicated":543},"src":"TopLevel","global_kind":"NamedConst","value":{"kind":{"Call":[{"kind":{"Fun":{"Regular":12}},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}},[]]},"ty":{"Deduplicated":543}}},{"def_id":1,"item_meta":{"name":[{"Ident":["aspis_core",0]},{"Ident":["field",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":497},"kind":"InherentImplBlock"}}},{"Ident":["ONE",0]}],"span":{"data":{"file_id":3,"beg":{"line":879,"col":4},"end":{"line":8