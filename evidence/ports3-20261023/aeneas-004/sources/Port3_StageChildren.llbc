col":1}},"generated_from_span":null},"source_text":"pub fn tx1<H: Digest32>(public: Public<'_>, public_bytes: &[u8], proof: &[u8], k: usize, hash: H, obs: Observer) -> Result<Vec<u8>, Error> {\n    if k != SPLIT {\n        return Err(Error::Parse);\n    }\n    parse_shape(proof)?;\n    canonical_scan(proof)?;\n    mark(obs, Phase::Parsed);\n    let mut g = [E::ZERO; 29];\n    let p = prepare(public, proof, hash, obs, &mut g)?;\n    let a = Accumulator::new(Variant::S2)?;\n    mark(obs, Phase::Prepare);\n    let folded_root: [u8; 32] = proof[compact::OFF_FOLDED_ROOT..compact::OFF_ROUND1].try_into().unwrap();\n    batch_merkle(proof, &p, &folded_root, 0, hash)?;\n    mark(obs, Phase::Merkle(0));\n    let geometry = QueryGeometry::for_range(&p.queries, 0, k)?;\n    let pending = BatchedWeights::new(&a.weights)?;\n    let (mut a, pending) = query_loop(proof, &p, a, &g, obs, &geometry, pending, k)?;\n    pending.finish(&mut a.weights);\n    let bytes = checkpoint(&p, &a, proof, public_bytes, hash);\n    mark(obs, Phase::CheckpointWrite);\n    Ok(bytes)\n}","attr_info":{"attributes":[{"DocComment":" Stage 1: strict parse of the whole stored proof, semantic layer,"},{"DocComment":" challenges, batch-A multiproofs and queries 0..SPLIT; returns the"},{"DocComment":" checkpoint over the compact stored bytes."}],"inline":"Never","rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"H"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{"line":270,"col":14},"end":{"line":270,"col":22}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":14618}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[]