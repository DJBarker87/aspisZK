e flexibility (or want to rely on [`Default`] instead of"},{"DocComment":" [`Clone`]), use [`Vec::resize_with`]."},{"DocComment":" If you only need to resize to a smaller size, use [`Vec::truncate`]."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if the new capacity exceeds `isize::MAX` _bytes_."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut vec = vec![\"hello\"];"},{"DocComment":" vec.resize(3, \"world\");"},{"DocComment":" assert_eq!(vec, [\"hello\", \"world\", \"world\"]);"},{"DocComment":""},{"DocComment":" let mut vec = vec!['a', 'b', 'c', 'd'];"},{"DocComment":" vec.resize(2, '_');"},{"DocComment":" assert_eq!(vec, ['a', 'b']);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"},{"index":1,"name":"A"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":11,"beg":{"line":3499,"col":8},"end":{"line":3499,"col":13}},"generated_from_span":null},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":18,"generics":{"regions":[],"types":[{"Deduplicated":14618}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":14854},{"Deduplicated":1288},{"Deduplicated":14618}],"output":{"Deduplicated":1343}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":115,"item_meta":{"name":[{"Ident":["aspis_r1_cost_probe",0]},{"Ident":["fast_domain",0]},{"Ident":["line_node",0]}],"span":{"data":{"file_id":57,"beg":{"line":295,"col":0},"end":{"line":299,"col":1}},"generated_from_span":null},"source_text":"pub fn line_node(u: FibreIndex) -> M31 {\n    let x = fibre_point(u).x;\n    let square = x.mul(x);\