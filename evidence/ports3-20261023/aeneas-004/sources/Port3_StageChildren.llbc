;crate::trace::value(15,3*round+1,rhs);\n        if lhs!=rhs {return Err(Error::Relation);}\n        claim=polynomial(poly,alpha);crate::trace::value(15,3*round+2,claim);\n    Ok(claim)\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Opaque","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":14620},{"Deduplicated":1653},{"Deduplicated":1653},{"Deduplicated":1288}],"output":{"Deduplicated":2547}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":72,"item_meta":{"name":[{"Ident":["aspis_r1_cost_probe",0]},{"Ident":["transport",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1488},"kind":"InherentImplBlock"}}},{"Ident":["folds",0]}],"span":{"data":{"file_id":14,"beg":{"line":8,"col":4},"end":{"line":8,"col":72}},"generated_from_span":null},"source_text":"pub fn folds(self) -> usize { if self == Self::S1 { 1 } else { 2 } }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Opaque","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":1488}],"output":{"Deduplicated":1288}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":73,"item_meta":{"name":[{"Ident":["aspis_r1_cost_probe",0]},{"Ident":["weights",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":4868},"kind":"InherentImplBlock"}}},{"Ident":["new",0]}],"span":{"data":{"file_id":28,"beg":{"line":206,"col":4},"end":{"line":222,"col":5}},"generated_from_span":null},"source_text":"pub fn new(variant:Variant,alpha:&[K;10],z:&[SecureCirclePoint;2])->Result<Box<Self>,Error> {\n        let points=aspis_core::state_only_prefix::r0::statement_points(alpha);\n        let extra=[alpha[8],alpha[9]];\n        let mut factors=[[[K::ZERO;4];5];5];\n        for k in 0..3 { for d in 0..5 {\n            let a=points[k][9-2*TAU[d]]; let b=points[k][8-2*TAU[d]];\n            factors[k][d]=[K::ONE.sub(a).mul(K::ONE.sub(b)),a.mul(K::ONE.sub(b)),K::ONE.sub(a).mul(b),a.mul(b)];\n        }}\n        for k in 0..2 {\n            factors[3+k][0]=[K::ONE,z[k].y,z[k].x,z[k].x.mul(z[k].y)];\n            let mut x=double(z[k].x);\n            for d in 1..5 {\n                let y=double(x); factors[3+k][d]=[K::ONE,x,y,x.mul(y)]; x=double(y);\n            }\n        }\n        Ok(Self::box_from_parts(variant, factors, points, extra))\n    }","attr_info":{"attributes":[],"inline":"Never","rename":null,"public":true},"is_local":true,"opacity":"Opaque","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":1488},{"HashConsedValue":[14891,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":4033},"Shared"]}]},{"HashConsedValue":[14892,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":4054},"Shared"]}]}],"output":{"Deduplicated":14098}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":74,"item_meta":{"name":[{"Ident":["aspis_r1_cost_probe",0]},{"Ident":["weights",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":4868},"kind":"InherentImplBlock"}}},{"Ident":["pair",0]}],"span":{"data":{"file_id":28,"beg":{"line":268,"col":4},"end":{"line":327,"col":5}},"generated_from_span":null},"source_text":"pub fn pair(&self,alpha:&[E],f:&[u8],kappa:E)->Result<E,Error> {\n        let n=f.len()/32; let folds=alpha.len();\n        let mut expected_n=1024usize; for _ in 0..folds { expected_n=expected_n>>2u32; } if n!=expected_n {return Err(Error::Parse);}\n        let ap0=powers::<4>(alpha[0]);\n        let ap1=if folds==2 {powers::<4>(alpha[1])}else{[E::ONE;4]};\n        let mut scratch=match aspis_core::r0::heap::filled(n,K::ZERO) { Ok(v) => v, Err(_) => return Err(Error::Allocation) };\n        let mut parts=[E::ZERO;7];\n        // On S2's two-fold path the high tensor factors for point rows 0 and\n        // 2 are identical. Keep the equality guard so arbitrary constructed\n        // `Weights` values retain the original per-row fallback.\n        let shared_two_point=shared_two_point_guard(self,folds);\n        process_regular_kinds(self,shared_two_point,alpha,f,folds,n,&ap0,&ap1,&mut scratch,&mut parts)?;\n        if shared_two_point {\n            // The two point rows share the d2/d3 coefficients. Preserve the\n            // tensor's least-significant-first order: d2 is j mod 4 and d3\n            // is j / 4. Each d4 slice then contracts one 16-term EbyKDot.\n            let mut common=[K::ZERO;16];\n            for j in 0..16 { common[j]=self.factors[0][2][j&3].mul(self.factors[0][3][j>>2u32]); }\n            let partials=shared_partials(f,&common)?;\n            shared_high(&partials,self,&ap0,&ap1,&mut parts)?;\n        }\n        if folds==1 {\n            let mut dual=[E::ZERO;16];\n            for mask in 0..16 {\n                let mut weight=E::ZERO;\n                for s in 0..4 { if mask&(1usize<<(s as u32))!=0 { weight=weight.add(ap0[PERM[s]]); } }\n                dual[mask]=weight.mul_m31(QUARTER);\n            }\n            let mut groups=[E::ZERO;16];\n            for j in 0..n {\n                let mut mask=0;\n                for s in 0..4 {if self.raw(0,4*j+s)==K::ONE {mask|=1usize<<(s as u32);}}\n                groups[mask]=groups[mask].add(field(f,j));\n            }\n            for m in 1..16 {parts[0]=parts[0].add(groups[m].mul(dual[m]));}\n            for side in 0..2 {\n                let p=kpowers::<5>(self.extra[side]);\n                let scale=Self::scalar_factor(&[p[0],p[1],p[2],p[3]],&ap0);\n                let mut power=K::ONE; let mut pair=E::ZERO;\n                for j in 0..7 {pair=pair.add(field(f,j+7*side).mul_qm31(power));power=power.mul(p[4]);}\n                parts[4]=parts[4].add(pair.mul(scale));\n            }\n        } else {\n            // Two-fold 0/1 row: compute the sixteen challenge products once.\n            // Coefficients with the same inactive mask share one subset sum.\n            let mut low=[E::ZERO;16];\n            for s in 0..16 { low[s]=ap0[PERM[s%4]].mul(ap1[PERM[s/4]]).mul_m31(QUARTER.mul(QUARTER)); }\n            parts[0]=grouped_inactive_pair(self,f,&low);\n            let libra=if self.variant==Variant::S2 {factored_s2_libra_weights(&ap0,&ap1,self.extra)}else{twofold_libra_weights(&low,self.extra)};\n            for j in 0..4 {parts[4]=parts[4].add(field(f,j).mul(libra[j]));}\n        }\n        #[cfg(feature=\"prover\")]\n        for kind in 0..7 {\n            for j in 0..1024 {crate::trace::value(6,kind*1024+j,E::from_qm31(self.raw(kind,j)));}\n            for j in 0..n {crate::trace::value(7,kind*n+j,self.dual_raw(kind,j,alpha));}\n        }\n        let k=powers::<7>(kappa);let mut sum=E::ZERO;\n        for kind in 0..7 {crate::trace::value(8,kind,parts[kind]);sum=sum.add(k[kind].mul(parts[kind]));}\n        Ok(sum)\n    }","attr_info":{"attributes":[{"DocComment":" Product rows keep a K tensor after their low digits have been folded."},{"DocComment":" Only the contracted scalar is in E. Sparse rows are handled separately."}],"inline":"Never","rename":null,"public":true},"is_local":true,"opacity":"Opaque","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[14893,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":4868},"Shared"]}]},{"HashConsedValue":[14894,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":4890},"Shared"]}]},{"Deduplicated":14781},{"Deduplicated":1653}],"output":{"Deduplicated":2547}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":75,"item_meta":{"name":[{"Ident":["aspis_r1_cost_probe",0]},{"Ident":["verifier",0]},{"Ident":["finish_query_dot",0]}],"span":{"data":{"file_id":1,"beg":{"line":301,"col":0},"end":{"line":306,"col":1}},"generated_from_span":null},"source_text":"fn finish_query_dot(final_message:&[u8],weights:&[K])->Result<E,Error> {\n    let mut dot=crate::fast_pairing::EbyKDot::new();\n    let mut j=0;\n    while j<weights.len() {dot.push(field(final_message,j),weights[j]).map_err(|_|Error::Parse)?;j+=1;}\n    Ok(dot.finish())\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Opaque","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":14620},{"HashConsedValue":[14895,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":1805},"Shared"]}]}],"output":{"Deduplicated":2547}},"src":"TopLevel","is_global_initializer":null,"body":"O