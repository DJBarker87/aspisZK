AspisR1.NCU_DriverDomain.prefix_of_reached (ops : AspisR1CurrentCaller.Ops) {H : Type}
  (D : AspisR1CurrentCaller.aspis_core.digest.Digest32 H)
  (semantic : AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public)
  (pub proof : Aeneas.Std.Slice Aeneas.Std.U8) (split : Aeneas.Std.Usize) (hash : H)
  (p : AspisR1CurrentCaller.verifier.Prepared) (a : AspisR1CurrentCaller.verifier.Accumulator)
  (start : AspisR1CurrentCaller.compact.OFF_FOLDED_ROOT ops = Aeneas.Std.Result.ok 7751#usize)
  (finish : AspisR1CurrentCaller.compact.OFF_ROUND1 ops = Aeneas.Std.Result.ok 7783#usize)
  (reached : AspisR1.NCU_WriterPrefix.Reached ops D semantic pub proof split hash p a) :
  split = 10#usize ∧
    ∃ cut,
      p = cut.prepared ∧
        a =
          have __src := cut.out;
          { weights := ⟨↑cut.flushed, ⋯⟩, rhs := __src.rhs, power := __src.power, next := __src.next }
