def Aeneas.Std.core.slice.cmp.PartialEqSlice.eq : {T U : Type} →
  Aeneas.Std.core.cmp.PartialEq T U → Aeneas.Std.Slice T → Aeneas.Std.Slice U → Aeneas.Std.Result Bool :=
fun {T U} partialEqInst s0 s1 =>
  if s0.length = s1.length then
    List.allM
      (fun x =>
        match x with
        | (x, y) => do
          let b ← partialEqInst.ne x y
          Aeneas.Std.Result.ok (decide ¬b = true))
      ((↑s0).zip ↑s1)
  else Aeneas.Std.Result.ok false

