"r1_pool_adapter",0]},{"Ident":["owned",0]},{"Ident":["stage1",0]}]},{"key":{"Fun":10},"value":[{"Ident":["aspis_r1_cost_probe_program",0]},{"Ident":["r1_pool_adapter",0]},{"Ident":["owned",0]},{"Ident":["stage2",0]}]},{"key":{"Fun":11},"value":[{"Ident":["solana_program_error",0]},{"Ident":["ProgramError",0]},{"Impl":{"Trait":0}},{"Ident":["drop_glue",0]}]},{"key":{"TraitDecl":3},"value":[{"Ident":["core",0]},{"Ident":["clone",0]},{"Ident":["Clone",0]}]},{"key":{"TraitImpl":5},"value":[{"Ident":["core",0]},{"Ident":["clone",0]},{"Ident":["impls",0]},{"Impl":{"Trait":5}}]},{"key":{"Global":0},"value":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["impls",0]},{"Impl":{"Trait":2}},{"Ident":["{vtable}",0]}]},{"key":{"Fun":12},"value":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["impls",0]},{"Impl":{"Trait":2}},{"Ident":["ne",0]}]},{"key":{"Type":6},"value":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["PartialEq",0]},{"Ident":["{vtable}",0]}]},{"key":{"Fun":13},"value":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["PartialEq",0]},{"Ident":["ne",0]}]},{"key":{"Global":1},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["equality",0]},{"Impl":{"Trait":3}},{"Ident":["{vtable}",0]}]},{"key":{"Fun":14},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["equality",0]},{"Impl":{"Trait":3}},{"Ident":["eq",0]}]},{"key":{"Fun":15},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["equality",0]},{"Impl":{"Trait":3}},{"Ident":["ne",0]}]},{"key":{"Global":2},"value":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["impls",0]},{"Impl":{"Trait":4}},{"Ident":["{vtable}",0]}]},{"key":{"Fun":16},"value":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["impls",0]},{"Impl":{"Trait":4}},{"Ident":["eq",0]}]},{"key":{"Fun":17},"value":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["impls",0]},{"Impl":{"Trait":4}},{"Ident":["ne",0]}]},{"key":{"Fun":18},"value":[{"Ident":["core",0]},{"Ident":["clone",0]},{"Ident":["Clone",0