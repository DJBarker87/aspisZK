FOUND Aeneas.Std.UScalar.cast
TYPE {src_ty : Aeneas.Std.UScalarTy} →
  (tgt_ty : Aeneas.Std.UScalarTy) → Aeneas.Std.UScalar src_ty → Aeneas.Std.UScalar tgt_ty
VALUE fun {src_ty} tgt_ty x => BitVec.zeroExtend tgt_ty.numBits x.bv#uscalar
FOUND Aeneas.Std.UScalar.and
TYPE {ty : Aeneas.Std.UScalarTy} → Aeneas.Std.UScalar ty → Aeneas.Std.UScalar ty → Aeneas.Std.UScalar ty
VALUE fun {ty} x y => (x.bv &&& y.bv)#uscalar
FOUND Aeneas.Std.UScalar.cast_val_eq
TYPE ∀ {src_ty : Aeneas.Std.UScalarTy} (tgt_ty : Aeneas.Std.UScalarTy) (x : Aeneas.Std.UScalar src_ty),
  ↑(Aeneas.Std.UScalar.cast tgt_ty x) = ↑x % 2 ^ tgt_ty.numBits
VALUE fun {src_ty} tgt_ty x =>
  id
    (of_eq_true
      (Eq.trans
        (congr
          (congrArg Eq
            (Eq.trans (BitVec.toNat_setWidth tgt_ty.numBits x.bv)
              (congrFun' (congrArg HMod.hMod (Aeneas.Std.UScalar.bv_toNat x)) (2 ^ tgt_ty.numBits))))
          (congrFun' (congrArg HMod.hMod (Aeneas.Std.UScalar.bv_toNat x)) (2 ^ tgt_ty.numBits)))
        (eq_self (↑x % 2 ^ tgt_ty.numBits))))
MISSING Aeneas.Std.UScalar.val_cast
MISSING Aeneas.Std.UScalar.land_val
MISSING Aeneas.Std.UScalar.and_val
MISSING Aeneas.Std.Scalar.eq_iff
FOUND Nat.and_two_pow_sub_one_eq_mod
TYPE ∀ (x n : ℕ), x &&& 2 ^ n - 1 = x % 2 ^ n
VALUE fun x n =>
  Nat.eq_of_testBit_eq fun i =>
    Eq.mpr (id (congr (congrArg Eq (Nat.testBit_and x (2 ^ n - 1) i)) (Nat.testBit_mod_two_pow x n i)))
      (Bool.casesOn (motive := fun t =>
        x.testBit i = t → (x.testBit i && (2 ^ n - 1).testBit i) = (decide (i < n) && x.testBit i)) (x.testBit i)
        (fun h =>
          Eq.symm h ▸
            of_eq_true
              (Eq.trans
                (congr
                  (congrArg Eq
                    (Eq.trans (congrArg false.and (Nat.testBit_two_pow_sub_one n i)) (Bool.false_and (decide (i < n)))))
                  (Bool.and_false (decide (i < n))))
                (eq_self false)))
        (fun h =>
          Eq.symm h ▸
            of_eq_true
              (Eq.trans
                (congr
                  (congrArg Eq
                    (Eq.trans (congrArg true.and (Nat.testBit_two_pow_sub_one n i)) (Bool.true_and (decide (i < n)))))
                  (Bool.and_true (decide (i < n))))
                (eq_self (decide (i < n)))))
        (Eq.refl (x.testBit i)))
FOUND Aeneas.Std.core.iter.adapters.enumerate.IteratorEnumerate.next
TYPE {I Item : Type} →
  Aeneas.Std.core.iter.traits.iterator.Iterator I Item →
    Aeneas.Std.core.iter.adapters.enumerate.Enumerate I →
      Aeneas.Std.Result (Option (Aeneas.Std.Usize × Item) × Aeneas.Std.core.iter.adapters.enumerate.Enumerate I)
VALUE fun {I Item} IteratorInst self => do
  let __x ← IteratorInst.next self.iter
  match __x with
    | (opt, iter') =>
      match opt with
      | none => Aeneas.Std.Result.ok (none, { iter := iter', count := self.count })
      | some a => do
        let count' ← self.count + 1#usize
        Aeneas.Std.Result.ok (some (self.count, a), { iter := iter', count := count' })
