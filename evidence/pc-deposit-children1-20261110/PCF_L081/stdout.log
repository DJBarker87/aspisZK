  (∀ (hi : i + [].length = ↑n) (hl : ∀ (j : ℕ), [][j]! = a[i + j]!) (h : Aeneas.Std.Array.allIdx p [] i = true),
      motive [] hi hl h) →
    (∀ (hd : α) (l : List α) (hi : i + (hd :: l).length = ↑n) (hl : ∀ (j : ℕ), (hd :: l)[j]! = a[i + j]!)
        (h : Aeneas.Std.Array.allIdx p (hd :: l) i = true), motive (hd :: l) hi hl h) →
      motive l hi hl h
VALUE fun {n} {α} [Inhabited α] p a i motive l hi hl h h_1 h_2 =>
  List.casesOn (motive := fun x =>
    ∀ (hi : i + x.length = ↑n) (hl : ∀ (j : ℕ), x[j]! = a[i + j]!) (h : Aeneas.Std.Array.allIdx p x i = true),
      motive x hi hl h)
    l (fun hi hl h => h_1 hi hl h) (fun head tail hi hl h => h_2 head tail hi hl h) hi hl h
