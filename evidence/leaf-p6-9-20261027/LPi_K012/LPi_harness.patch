+//! Native private writer callers, one source iteration from arbitrary pre-state.
+use super::*;
+use aspis_core::field::CM31;
+fn any_k()->K {let w:[u32;4]=kani::any();K{c0:CM31{a:M31(w[0]),b:M31(w[1])},c1:CM31{a:M31(w[2]),b:M31(w[3])}}}
+fn any_e()->E {let w:[u32;8]=kani::any();for x in w {kani::assume(x<0x7fff_ffff);}E::from_limbs(w).unwrap()}
+fn kwords(x:K)->[u32;4] {[x.c0.a.0,x.c0.b.0,x.c1.a.0,x.c1.b.0]}
+fn check_k(len:usize) {
+ assert!(len<=1720);let x=any_k();let words=kwords(x);
+ let initial:[u8;1736]=kani::any();let mut out=initial[..len].to_vec();
+ put_k(&mut out,x);
+ assert_eq!(out.len(),len+16);
+ let at:usize=kani::any();kani::assume(at<out.len());
+ assert_eq!(out[at],if at<len{initial[at]}else{let j=at-len;(words[j/4]>>((j%4)*8)) as u8});
+ kani::cover!(at==len+15);
+}
+fn check_e(len:usize) {
+ assert!(len<=1704);let x=any_e();let words=x.to_limbs();
+ let initial:[u8;1736]=kani::any();let mut out=initial[..len].to_vec();
+ put(&mut out,x);
+ assert_eq!(out.len(),len+32);
+ let at:usize=kani::any();kani::assume(at<out.len());
+ assert_eq!(out[at],if at<len{initial[at]}else{let j=at-len;(words[j/4]>>((j%4)*8)) as u8});
+ kani::cover!(at==len+31);
+}
+macro_rules! kproof {($name:ident,$body:block)=>{
+ #[kani::proof] #[kani::stub(K::write_le_bytes,crate::LPi_contracts::qbytes)] #[kani::unwind(1740)]
+ fn $name() $body
+}}
+macro_rules! eproof {($name:ident,$body:block)=>{
+ #[kani::proof] #[kani::stub(E::to_le_bytes,crate::LPi_contracts::ebytes)] #[kani::unwind(1740)]
+ fn $name() $body
+}}
+kproof!(put_k_arbitrary_prefix,{let n:usize=kani::any();kani::assume(n<=1720);check_k(n);});
+eproof!(put_e_arbitrary_prefix,{let n:usize=kani::any();kani::assume(n<=1704);check_e(n);});
+kproof!(weight_iteration,{let i:usize=kani::any();kani::assume(i<64);check_k(712+16*i);});
+kproof!(semantic_iteration,{let i:usize=kani::any();kani::assume(i<10);check_k(408+16*i);});
+kproof!(z_iteration,{let i:usize=kani::any();kani::assume(i<4);check_k(568+16*i);});
+eproof!(prepared_fields_iteration,{let i:usize=kani::any();kani::assume(i<4);check_e(176+32*i);});
+eproof!(claim_rhs_iteration,{let i:usize=kani::any();kani::assume(i<2);check_e(632+32*i);});
+kproof!(rho_context,{check_k(304);});
+kproof!(power_context,{check_k(696);});
