theorem Aeneas.Std.UScalar.eq_equiv_bv_eq : ∀ {ty : UScalarTy} (x y : UScalar ty), x = y ↔ x.bv = y.bv :=
fun {ty} x y =>
  let ⟨bv✝, h✝⟩ := x
  Eq.symm h✝ ▸
    let ⟨bv✝¹, h✝¹⟩ := y
    Eq.symm h✝¹ ▸
      of_eq_true (Eq.trans (congrFun' (congrArg Iff (UScalar.mk.injEq bv✝ bv✝¹)) (bv✝ = bv✝¹)) (iff_self (bv✝ = bv✝¹)))
theorem Aeneas.Std.UScalar.eq_equiv : ∀ {ty : UScalarTy} (x y : UScalar ty), x = y ↔ ↑x = ↑y :=
fun {ty} x y =>
  let ⟨bv✝, h✝⟩ := x
  Eq.symm h✝ ▸
    let ⟨bv✝¹, h✝¹⟩ := y
    Eq.symm h✝¹ ▸
      of_eq_true
        (Eq.trans
          (congrFun' (congrArg Iff (Eq.trans (UScalar.mk.injEq bv✝ bv✝¹) UScalar.eq_equiv._simp_1_1))
            (bv✝.toNat = bv✝¹.toNat))
          (iff_self (bv✝.toNat = bv✝¹.toNat)))
