def AdapterRw.r1_pool_adapter.readonly_meta_ok : AdapterRw.Ops →
  AdapterRw.solana_pubkey.Pubkey →
    AdapterRw.solana_pubkey.Pubkey →
      Bool → Bool → Bool → Result (core.result.Result Unit AdapterRw.solana_program_error.ProgramError) :=
fun ops owner expected is_signer is_writable executable => do
  let b ←
    core.cmp.impls.PartialEqShared.ne (AdapterRw.solana_pubkey.Pubkey.Insts.CoreCmpPartialEqPubkey ops) owner expected
  if b = true then ok (core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidAccountData)
    else
      if is_signer = true then
        ok (core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidAccountData)
      else
        if is_writable = true then
          ok (core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidAccountData)
        else
          if executable = true then
            ok (core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidAccountData)
          else ok (core.result.Result.Ok ())
def AdapterRw.r1_pool_adapter.readonly_buffer_meta_ok : Bool →
  Bool → Bool → Result (core.result.Result Unit AdapterRw.solana_program_error.ProgramError) :=
fun is_signer is_writable executable =>
  if is_signer = true then ok (core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidAccountData)
  else
    if is_writable = true then
      ok (core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidAccountData)
    else
      if executable = true then
        ok (core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidAccountData)
      else ok (core.result.Result.Ok ())
def AdapterRw.r1_pool_adapter.owned.OwnedAccount.data : AdapterRw.Ops →
  AdapterRw.r1_pool_adapter.owned.OwnedAccount →
    Result (core.result.Result (Slice U8) AdapterRw.solana_program_error.ProgramError) :=
fun ops self =>
  match self.bytes with
  | core.result.Result.Ok bytes =>
    have s := bytes.deref;
    ok (core.result.Result.Ok s)
  | core.result.Result.Err error1 => do
    let pe ← ops.op35 error1
    ok (core.result.Result.Err pe)
def AdapterRw.r1_pool_adapter.owned.OwnedAccount.data_len : AdapterRw.Ops →
  AdapterRw.r1_pool_adapter.owned.OwnedAccount →
    Result (core.result.Result Usize AdapterRw.solana_program_error.ProgramError) :=
fun ops self =>
  AdapterRw.core.result.Result.Insts.CoreCloneClone.clone core.clone.CloneUsize
    (AdapterRw.solana_program_error.ProgramError.Insts.CoreCloneClone ops) self.length
