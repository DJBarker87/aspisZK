fun {W A CoreError Tx} L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 c indexError reservation native1
    native2 hashv extraction sha256 H p1 syscall data1 data2 slot state1 state2 final1 final2 saved post1 post2
    accepted1 accepted2 root length prior words p t u actions game RuntimePersistence D a Q0 Q1 queries finishOwners =>
  have security :=
    AspisR1.ARX_Residual.numeric L copy allocator c indexError reservation native1 native2 hashv extraction a std D
      words finishOwners Q0 Q1 queries;
  let ⟨p6, right✝⟩ :=
    AspisR1.ARW_Observations.observations L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 c indexError
      reservation native1 native2 hashv extraction sha256 H p1 syscall data1 data2 slot state1 state2 final1 final2
      saved post1 post2 accepted1 accepted2 root length prior words p t u actions game RuntimePersistence D a Q0 Q1
      queries finishOwners
  let ⟨driver, right✝¹⟩ := right✝
  let ⟨sdkEq, right✝²⟩ := right✝¹
  let ⟨result, right✝³⟩ := right✝²
  let ⟨claims, right✝⁴⟩ := right✝³
  let ⟨copyFacts, right✝⁵⟩ := right✝⁴
  let ⟨events, right✝⁶⟩ := right✝⁵
  let ⟨protection, right✝⁷⟩ := right✝⁶
  let ⟨trace, right✝⁸⟩ := right✝⁷
  let ⟨recorder, s6⟩ := right✝⁸
