    ⟨driver,
      ⟨sdkEq,
        ⟨result,
          ⟨⟨claims.left,
              ⟨claims.right.left,
                ⟨claims.right.right,
                  ⟨security,
                    ⟨fun range =>
                      Eq.mp
                        (congrArg
                          (LE.le
                            (AspisR1.F3T_RuntimeBound.failureModel
                              (AspisR1.ARX_AdmittedRuntime.runtime L copy allocator c indexError reservation native1
                                native2 hashv a)))
                          (congrFun' (congrArg HMul.hMul (congrFun' (congrArg HAdd.hAdd (Nat.cast_add Q0 Q1)) 1))
                            (1 / 2 ^ 100)))
                        (LE.le.trans security (AspisR1.F3U_Range.per_attempt (Q0 + Q1) range)),
                      fun zero =>
