def AspisR1.S2W_TrustedStd.specification : {F : Type} →
  AspisR1.S2Trust.Heap F → ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome F :=
fun {F} s dst src =>
  if (s.payload dst).descriptor.length = src.descriptor.length then
    AspisR1.S2W_TrustedStd.Outcome.returned (AspisR1.S2W_TrustedStd.copyHeap s dst src)
  else AspisR1.S2W_TrustedStd.Outcome.panic
