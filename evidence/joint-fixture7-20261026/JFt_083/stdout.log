bytes : Slice U8
i : Usize
bound : ↑i < bytes.length
byte : U8
selected : (↑bytes)[↑i]? = some byte
out : U8
_ : [> let out ← bytes.index_usize i <]
out_post : out = (↑bytes)[↑i]
⊢ out = byte
