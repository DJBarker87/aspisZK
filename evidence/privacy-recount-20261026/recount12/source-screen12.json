    "line": 24,
    "text": "fn sum_high() { let h=qs();let l=qs();let a:usize=kani::any();let b:usize=kani::any();let c:usize=kani::any();let d:usize=kani::any();kani::assume(a<=64&&b<=64&&c<=64&&d<=64);let r=[a..b,c..d];assert_eq!(dep::sum(h,l,&r),reference::sum(h,l,&r)); }"
   },
   {
    "line": 25,
    "text": "fn pre<const N:usize>(start:usize) {let mut a=qs();let mut b=a;let v=canonical::<N>();dep::pre(&mut a,start,&v);reference::pre(&mut b,start,&v);let k:usize=kani::any();kani::assume(k<24);assert_eq!(a[k],b[k]);}"
   },
   {
    "line": 41,
    "text": "fn add_digest_binding() { let mut a=qs();let mut b=a;let v=qs();let q=q();let start:usize=kani::any();kani::assume(start<=8);let t:bool=kani::any();let x:[u32;8]=kani::any();let mut d=[M31(0);8];let mut i=0;while i<8 {d[i]=M31(x[i]);i+=1;}dep::digest(&mut a,q,&v,start,&d,t);reference::digest(&mut b,q,&v,start,&d,t);assert_eq!(a,b); }"
   }
