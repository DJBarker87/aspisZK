theorem NLQ_FirstWrongSplit.fold : ∀ (base : Ops) (B : AspisR1PublicPreparation.FinishModel.Boundaries)
  (std : ClaimsUnrolledFinish.StdCalls) (hashv : SdkC_Source.Parts → Result SdkC_Source.Digest)
  (D : aspis_core.digest.Digest32 Unit) (semantic : aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public)
  (pub proof : Slice U8) (k : Usize),
  k ≠ compact.SPLIT →
    ∀ (handler : verifier.Error → Result AdapterRw.solana_program_error.ProgramError),
      NGP_L181.NativeAssociation hashv
        (CheckpointBytes5Effect.bind
          (NGQ_Normalize.normalize (GExp_FirstCode.code base B std hashv D semantic pub proof k))
          (NLQ_FirstMap.continuation handler))
        (NLQ_FirstMap.observed handler
          { result := ok (core.result.Result.Err verifier.Error.Parse), attempted := [] }) :=
fun base B std hashv D semantic pub proof k bad handler =>
  NLQ_FirstMap.fold hashv (NGQ_Normalize.normalize (GExp_FirstCode.code base B std hashv D semantic pub proof k))
    handler { result := ok (core.result.Result.Err verifier.Error.Parse), attempted := [] }
    (NLQ_WrongSplit.child base B std hashv D semantic pub proof k bad)
'NLQ_FirstWrongSplit.fold' depends on axioms: [propext, Classical.choice, Quot.sound]
