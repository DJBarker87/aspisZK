at_site : ∀ (e : Entry) (ops : AdapterRw.Ops) (bytes : Slice U8),
  AdapterRw.r1_pool_adapter.owned.OwnedAccount.data ops (e.snapshot 1 1880 1880) = ok (core.result.Result.Ok bytes) →
    bytes = e.buffers (e.handles 1).1 ∧ (↑bytes).length = 1880
'NLQ_PublicRead.at_site' depends on axioms: [propext, Classical.choice, Quot.sound]
