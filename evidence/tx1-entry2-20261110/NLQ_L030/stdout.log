first_abort : ∀ (e : Entry) (err : Error) (a1 a2 : Result Unit),
  (S2W_ReturnedCheckpoint.nativeBytes (e.buffers (e.handles 0).1)).length = 58295 →
    NLQ_SnapshotFold.G e (fail err) a1 a2 =
      { result := fail err, events := allocationPrefix (ready e 0 []) 0 (fail err) }
first_diverge : ∀ (e : Entry) (a1 a2 : Result Unit),
  (S2W_ReturnedCheckpoint.nativeBytes (e.buffers (e.handles 0).1)).length = 58295 →
    NLQ_SnapshotFold.G e div a1 a2 = { result := div, events := allocationPrefix (ready e 0 []) 0 div }
'NLQ_SnapshotPrefixes.first_abort' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLQ_SnapshotPrefixes.first_diverge' depends on axioms: [propext, Classical.choice, Quot.sound]
