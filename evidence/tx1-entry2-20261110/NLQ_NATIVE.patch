+//! Native fidelity witnesses against the ACTUAL frozen entry/process/stage1.
+//! Payload extent two is a malformed-length partition; no valid-length credit.
+use super::*;
+extern crate alloc;
+include!(concat!(env!("CARGO_MANIFEST_DIR"),"/../../KMX_stubs.rs"));
+use std::rc::Rc;
+fn counter(a:&AccountInfo)->isize {unsafe{*Rc::as_ptr(&a.data).cast::<isize>()}}
+fn check(mode:u8,bad:bool){
+ let program=Pubkey::new_from_array(kani::any());
+ let key=Pubkey::new_from_array(kani::any());let owner=Pubkey::new_from_array(kani::any());
+ let mut money:u64=kani::any();let saved_money=money;
+ let mut data:[u8;2]=kani::any();let byte0=data[0];let byte1=data[1];
+ let a=AccountInfo::new(&key,kani::any(),kani::any(),&mut money,&mut data,&owner,kani::any(),kani::any());
+ let accounts=[a.clone(),a.clone(),a];
+ let instruction=[3,11];
+ let result=match mode {
+  0=>process_r1_cost_probe_instruction(&program,&accounts,&instruction),
+  1=>r1_pool_adapter::process(&program,&accounts,&instruction),
+  _=>r1_pool_adapter::NLQ_adapter::invoke_stage1(&program,&accounts,&instruction),
+ };
+ if bad {assert_eq!(result,Err(ProgramError::InvalidInstructionData));}
+ else {assert_eq!(result,Err(ProgramError::InvalidArgument));}
+ assert_eq!(counter(&accounts[0]),0);assert_eq!(counter(&accounts[1]),0);assert_eq!(counter(&accounts[2]),0);
+ let guard=accounts[0].try_borrow_mut_data().unwrap();
+ assert_eq!(guard.len(),2);assert_eq!(guard[0],byte0);assert_eq!(guard[1],byte1);drop(guard);
+ assert_eq!(accounts[0].lamports(),saved_money);
+ assert!(core::ptr::eq(accounts[0].key,&key));assert!(core::ptr::eq(accounts[0].owner,&owner));
+}
+#[kani::proof] #[kani::unwind(40)]
+#[kani::stub(core::ptr::copy_nonoverlapping,KMX_copy_nonoverlapping)]
+fn entry_eleven_duplicate(){check(0,false)}
+#[kani::proof] #[kani::unwind(40)]
+#[kani::stub(core::ptr::copy_nonoverlapping,KMX_copy_nonoverlapping)]
+fn entry_eleven_model_control(){check(0,true)}
+#[kani::proof] #[kani::unwind(40)]
