+use super::{Pubkey,AccountInfo,ProgramError,ProgramResult};
+fn scalar_reply(program:&Pubkey)->ProgramResult {
+ let key=program.to_bytes();
+ match key[0]&7 {
+  0=>Ok(()),1=>Err(ProgramError::InvalidInstructionData),
+  2=>Err(ProgramError::InvalidAccountData),3=>Err(ProgramError::InvalidArgument),
+  4=>Err(ProgramError::AccountAlreadyInitialized),5=>Err(ProgramError::AccountBorrowFailed),
+  _=>Err(ProgramError::Custom(u32::from_le_bytes([key[1],key[2],key[3],key[4]]))),
+ }
+}
+// Local record carried by the oracle's declared writable account region.
+// It logs ALL parent arguments and a returning scalar reply; no static state.
+fn dispatch_oracle(program:&Pubkey,accounts:&[AccountInfo<'_>],data:&[u8])->ProgramResult {
+ let fields=[program as *const Pubkey as usize as u64,accounts.as_ptr() as usize as u64,
+  accounts.len() as u64,data.as_ptr() as usize as u64,data.len() as u64,
+  data[1] as u64,1u64];
+ let mut cp=accounts[2].try_borrow_mut_data().unwrap();
+ for i in 0..7 {let bytes=fields[i].to_le_bytes();for j in 0..8 {cp[i*8+j]=bytes[j];}}
+ drop(cp);scalar_reply(program)
+}
+fn word(data:&[u8],i:usize)->u64 {
+ u64::from_le_bytes([data[i*8],data[i*8+1],data[i*8+2],data[i*8+3],
+  data[i*8+4],data[i*8+5],data[i*8+6],data[i*8+7]])
+}
