def NLQ_ClosedSnapshotStep.Step : {W : Type} → Entry → Library W (ℕ → Record) → W → W → ℕ → Usize → Usize → Prop :=
fun {W} e L before after a l1 l2 =>
  ∃ token owner w1 w2,
    L.run before (Op.shared a token owner) = (w1, Reply.guard token) ∧
      L.run w1 (Op.deref token) = (w2, Reply.payload (e.heap.payload (e.heap.accounts a).1)) ∧
        L.run w2 (Op.drop token) = (after, Reply.unit) ∧
          L.related after e.heap ∧
            have old := (e.records (e.handles a).1).owned;
            (do
                let returned ←
                  NHJ_SnapshotReference.snapshot_ref old.key old.owner old.is_signer old.is_writable old.executable l1
                      l2 (core.result.Result.Ok (e.buffers (e.handles a).1))
                ok (NHJ_SnapshotAssociation.port returned)) =
              ok (e.snapshot a ↑l1 ↑l2)
'NLQ_ClosedSnapshotStep.at_site' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLQ_ClosedSnapshotStep.related_after' depends on axioms: [propext, Classical.choice, Quot.sound]
