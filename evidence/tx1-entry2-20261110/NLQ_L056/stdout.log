abort : ∀ (e : Entry) (err : Error),
  (S2W_ReturnedCheckpoint.nativeBytes (e.buffers (e.handles 2).1)).length = 1768 →
    NLQ_SnapshotFold.G e (ok ()) (ok ()) (fail err) =
      { result := fail err,
        events :=
          (G (ready e 0 []) 0 58295 58295 (ok ())).events ++
            ((G (ready e 1 [e.snapshot 0 58295 58295]) 1 1880 1880 (ok ())).events ++
              allocationPrefix (ready e 2 [e.snapshot 0 58295 58295, e.snapshot 1 1880 1880]) 2 (fail err)) }
'NLQ_SnapshotThirdPrefix.abort' depends on axioms: [propext, Classical.choice, Quot.sound]
