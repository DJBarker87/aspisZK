ten_wrong_count : ∀ (ops : AdapterRw.Ops) (p : AdapterRw.solana_pubkey.Pubkey)
  (accounts : Slice AdapterRw.r1_pool_adapter.owned.OwnedAccount),
  accounts.len ≠ 3#usize →
    NLD_Stage1Source.stage1Owned (NLQ_EmissionGuard.installed ops) p accounts NJD_Prefixes.ten =
      ([2863], ok (core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidInstructionData))
'NLQ_OwnedGuard.ten_wrong_count' depends on axioms: [propext, Classical.choice, Quot.sound]
