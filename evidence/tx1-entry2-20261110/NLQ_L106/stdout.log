theorem NLQ_RuntimeCells.aliases : ∀ (e : Entry),
  AdapterRw.RuntimeEntrypointAdmission e.heap (fun a => (NLM_RuntimeInput.records e a).key) 3 →
    ∀ (a b : ℕ),
      a < 3 →
        b < 3 →
          (((NLQ_SnapshotFold.final e).sdk.accounts a).data = ((NLQ_SnapshotFold.final e).sdk.accounts b).data ↔
            (NLM_RuntimeInput.records e a).key = (NLM_RuntimeInput.records e b).key) :=
fun e runtime a b ha hb =>
  NLF_Admission.aliases_exactly e.heap (fun a => (NLM_RuntimeInput.records e a).key) 3 a b runtime ha hb
'NLQ_RuntimeCells.aliases' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLQ_RuntimeCells.counters' depends on axioms: [propext, Classical.choice, Quot.sound]
