'NLQ_Route.process_ten' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLQ_Route.process_eleven' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLQ_Route.process' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem NLQ_Route.process : ∀ {A : Type} (first : Key → Slice A → Slice U8 → Result Reply) (p : Key) (a : Slice A)
  (d : Slice U8), Tx1 d → NIV_RawBoundary.process (NIV_RawBoundary.profile (children first)) p a d = first p a d :=
fun {A} first p a d domain =>
  Or.casesOn domain
    (fun h =>
      have eq := Subtype.ext h;
      Eq.ndrec (motive := fun d =>
        ↑d = [3#u8, 10#u8] → NIV_RawBoundary.process (NIV_RawBoundary.profile (children first)) p a d = first p a d)
        (fun h => process_ten first p a) (Eq.symm eq) h)
    fun h =>
    have eq := Subtype.ext h;
    Eq.ndrec (motive := fun d =>
      ↑d = [3#u8, 11#u8] → NIV_RawBoundary.process (NIV_RawBoundary.profile (children first)) p a d = first p a d)
      (fun h => process_eleven first p a) (Eq.symm eq) h
