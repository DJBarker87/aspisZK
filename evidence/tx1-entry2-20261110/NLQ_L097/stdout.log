theorem NLQ_Stage1Abort.first_fail : ∀ (e : Entry) (ops : AdapterRw.Ops) (p : Key) (d : Slice U8) (err : Error)
  (a1 a2 : Result Unit),
  (S2W_ReturnedCheckpoint.nativeBytes (e.buffers (e.handles 0).1)).length = 58295 →
    NLQ_Stage1Fold.G e ops p d (fail err) a1 a2 =
      have s := ready e 0 [];
      { result := fail err,
        post := { snapshots := { input := s.input, sdk := acquired s 0, next := s.next + 1, owned := s.owned } },
        events := List.map Event.snapshot (allocationPrefix s 0 (fail err)) } :=
fun e ops p d err a1 a2 extent =>
  id
    (Eq.mpr
      (id
        (congrArg
          (fun _a =>
            (have snapshots := _a;
              have priorEvents := List.map Event.snapshot snapshots.events;
              match snapshots.result with
              | fail err =>
                { result := fail err,
                  post := { snapshots := NLQ_SnapshotReplay.replay (ready e 0 []) snapshots.events },
                  events := priorEvents }
              | div =>
                { result := div, post := { snapshots := NLQ_SnapshotReplay.replay (ready e 0 []) snapshots.events },
                  events := priorEvents }
              | ok (fst, post) =>
                have tail := continuation ops p d { snapshots := post };
                { result := tail.result, post := tail.post, events := priorEvents ++ tail.events }) =
              let s := ready e 0 [];
              { result := fail err,
                post :=
                  { snapshots := { input := s.input, sdk := acquired s 0, next := s.next + 1, owned := s.owned } },
                events := List.map Event.snapshot (allocationPrefix s 0 (fail err)) })
          (NLQ_SnapshotPrefixes.first_abort e err a1 a2 extent)))
      (id
        (Eq.mpr
          (id
            (congrArg
              (fun _a =>
                { result := fail err, post := { snapshots := _a },
                    events := List.map Event.snapshot (allocationPrefix (ready e 0 []) 0 (fail err)) } =
                  { result := fail err,
                    post :=
                      {
                        snapshots :=
                          { input := (ready e 0 []).input, sdk := acquired (ready e 0 []) 0,
                            next := (ready e 0 []).next + 1, owned := (ready e 0 []).owned } },
                    events := List.map Event.snapshot (allocationPrefix (ready e 0 []) 0 (fail err)) })
              (NLQ_ReplayAbort.allocation (ready e 0 []) 0 (fail err))))
          (Eq.refl
            { result := fail err,
              post :=
                {
                  snapshots :=
                    { input := (ready e 0 []).input, sdk := acquired (ready e 0 []) 0, next := (ready e 0 []).next + 1,
                      owned := (ready e 0 []).owned } },
              events := List.map Event.snapshot (allocationPrefix (ready e 0 []) 0 (fail err)) }))))
theorem NLQ_Stage1Abort.first_div : ∀ (e : Entry) (ops : AdapterRw.Ops) (p : Key) (d : Slice U8) (a1 a2 : Result Unit),
  (S2W_ReturnedCheckpoint.nativeBytes (e.buffers (e.handles 0).1)).length = 58295 →
