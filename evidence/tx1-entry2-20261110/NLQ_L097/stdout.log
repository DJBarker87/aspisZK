                          { input := (ready e 0 []).input, sdk := acquired (ready e 0 []) 0,
                            next := (ready e 0 []).next + 1, owned := (ready e 0 []).owned } },
                    events := List.map Event.snapshot (allocationPrefix (ready e 0 []) 0 div) })
              (NLQ_ReplayAbort.allocation (ready e 0 []) 0 div)))
          (Eq.refl
            { result := div,
              post :=
                {
                  snapshots :=
                    { input := (ready e 0 []).input, sdk := acquired (ready e 0 []) 0, next := (ready e 0 []).next + 1,
                      owned := (ready e 0 []).owned } },
              events := List.map Event.snapshot (allocationPrefix (ready e 0 []) 0 div) }))))
'NLQ_Stage1Abort.first_fail' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLQ_Stage1Abort.first_div' depends on axioms: [propext, Classical.choice, Quot.sound]
