          (NLQ_SnapshotPrefixes.first_diverge e a1 a2 extent)))
      (id
        (Eq.mpr
          (id
            (congrArg
              (fun _a =>
                { result := div, post := { snapshots := _a },
                    events := List.map Event.snapshot (allocationPrefix (ready e 0 []) 0 div) } =
