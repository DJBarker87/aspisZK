NLQ_Stage1Fold.result : ∀ (e : AspisR1.S2W_D189Entry.Entry) (ops : AdapterRw.Ops) (p : NLQ_Stage1State.Key)
  (d : Aeneas.Std.Slice Aeneas.Std.U8),
  (NLQ_Stage1Fold.G e ops p d (Aeneas.Std.Result.ok ()) (Aeneas.Std.Result.ok ()) (Aeneas.Std.Result.ok ())).result = do
    let child ← AdapterRw.r1_pool_adapter.owned.stage1_owned ops p e.first d
    match child with
      | Aeneas.Std.core.result.Result.Ok a => Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ())
      | Aeneas.Std.core.result.Result.Err error => Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err error)
NLQ_Stage1Body.ten : ∀ (e : AspisR1.S2W_D189Entry.Entry) (ops : AdapterRw.Ops) (p : NLQ_Stage1State.Key)
  (a0 a1 a2 : Aeneas.Std.Result Unit),
  NLQ_Stage1Parent.G e ops p AspisR1.NJD_Prefixes.ten 3 a0 a1 a2 =
    have body := NLQ_Stage1Fold.G e ops p AspisR1.NJD_Prefixes.ten a0 a1 a2;
    { result := body.result, post := body.post,
      events :=
        [NLQ_Stage1Parent.Event.instruction (NLQ_Stage1Parent.initial e) AspisR1.NJD_Prefixes.ten 10#u8 true,
            NLQ_Stage1Parent.Event.count (NLQ_Stage1Parent.initial e) 3] ++
          List.map NLQ_Stage1Parent.Event.body body.events }
NLQ_Stage1Body.eleven : ∀ (e : AspisR1.S2W_D189Entry.Entry) (ops : AdapterRw.Ops) (p : NLQ_Stage1State.Key)
