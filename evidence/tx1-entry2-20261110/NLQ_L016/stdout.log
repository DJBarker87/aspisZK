@NLQ_InstalledStage1.owned : ∀ {CoreError : Type} (missing : AspisR1.IDa_Deployed.Uninstalled CoreError)
  (indexError : CoreError) (reservation : AspisR1.NP6_StdModel.Reservation) (p : AdapterRw.solana_pubkey.Pubkey)
  (a : Aeneas.Std.Slice AdapterRw.r1_pool_adapter.owned.OwnedAccount) (d : Aeneas.Std.Slice Aeneas.Std.U8),
  (AspisR1.NLD_Stage1Source.stage1Owned (NLM_DeployedOps.ops missing indexError reservation) p a d).2 =
    AdapterRw.r1_pool_adapter.owned.stage1_owned (NLM_DeployedOps.ops missing indexError reservation) p a d
@NLQ_InstalledStage1.stage1 : ∀ {CoreError : Type} (missing : AspisR1.IDa_Deployed.Uninstalled CoreError)
  (indexError : CoreError) (reservation : AspisR1.NP6_StdModel.Reservation) (e : AspisR1.S2W_D189Entry.Entry)
  (p : AdapterRw.solana_pubkey.Pubkey) (d : Aeneas.Std.Slice Aeneas.Std.U8),
  NLQ_Route.Tx1 d →
    (NLQ_Stage1Parent.G e (NLM_DeployedOps.ops missing indexError reservation) p d 3 (Aeneas.Std.Result.ok ())
          (Aeneas.Std.Result.ok ()) (Aeneas.Std.Result.ok ())).result =
      do
      let child ←
        AdapterRw.r1_pool_adapter.owned.stage1_owned (NLM_DeployedOps.ops missing indexError reservation) p e.first d
      match child with
        | Aeneas.Std.core.result.Result.Ok a => Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ())
        | Aeneas.Std.core.result.Result.Err error => Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err error)
NLQ_OwnedGuard.ten_wrong_count : ∀ (ops : AdapterRw.Ops) (p : AdapterRw.solana_pubkey.Pubkey)
  (accounts : Aeneas.Std.Slice AdapterRw.r1_pool_adapter.owned.OwnedAccount),
  accounts.len ≠ 3#usize →
    AspisR1.NLD_Stage1Source.stage1Owned (NLQ_EmissionGuard.installed ops) p accounts AspisR1.NJD_Prefixes.ten =
      ([2863],
        Aeneas.Std.Result.ok
          (Aeneas.Std.core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidInstructionData))
