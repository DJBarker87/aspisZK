            NLQ_Stage1Parent.Event.instruction (NLQ_Stage1Parent.initial e) AspisR1.NJD_Prefixes.eleven 11#u8 true,
            NLQ_Stage1Parent.Event.count (NLQ_Stage1Parent.initial e) 3] ++
          List.map NLQ_Stage1Parent.Event.body body.events }
NLQ_Stage1Body.result : ∀ (e : AspisR1.S2W_D189Entry.Entry) (ops : AdapterRw.Ops) (p : NLQ_Stage1State.Key)
  (d : Aeneas.Std.Slice Aeneas.Std.U8) (a0 a1 a2 : Aeneas.Std.Result Unit),
  NLQ_Route.Tx1 d → (NLQ_Stage1Parent.G e ops p d 3 a0 a1 a2).result = (NLQ_Stage1Fold.G e ops p d a0 a1 a2).result
NLQ_Stage1Guard.rejected : ∀ (e : AspisR1.S2W_D189Entry.Entry) (ops : AdapterRw.Ops) (p : NLQ_Stage1State.Key)
  (d : Aeneas.Std.Slice Aeneas.Std.U8) (n : ℕ) (a0 a1 a2 : Aeneas.Std.Result Unit),
  ¬NLQ_Route.Tx1 d →
    NLQ_Stage1Parent.G e ops p d n a0 a1 a2 =
      {
        result :=
          Aeneas.Std.Result.ok
            (Aeneas.Std.core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidInstructionData),
        post := NLQ_Stage1Parent.initial e,
        events :=
          [NLQ_Stage1Parent.Event.instruction (NLQ_Stage1Parent.initial e) d 10#u8 false,
            NLQ_Stage1Parent.Event.instruction (NLQ_Stage1Parent.initial e) d 11#u8 false] }
NLQ_Stage1Guard.wrong_count : ∀ (e : AspisR1.S2W_D189Entry.Entry) (ops : AdapterRw.Ops) (p : NLQ_Stage1State.Key)
  (d : Aeneas.Std.Slice Aeneas.Std.U8) (n : ℕ) (a0 a1 a2 : Aeneas.Std.Result Unit),
  n ≠ 3 →
    (NLQ_Stage1Parent.G e ops p d n a0 a1 a2).result =
        Aeneas.Std.Result.ok
          (Aeneas.Std.core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidInstructionData) ∧
      (NLQ_Stage1Parent.G e ops p d n a0 a1 a2).post = NLQ_Stage1Parent.initial e
NLQ_WritebackFrame.source : ∀ (e : AspisR1.S2W_D189Entry.Entry) (ops : AdapterRw.Ops) (p : NLQ_Stage1State.Key)
  (d : Aeneas.Std.Slice Aeneas.Std.U8) (saved : NLQ_Stage1State.Bytes),
  AdapterRw.r1_pool_adapter.owned.stage1_owned ops p e.first d =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok saved) →
    have initial := NLQ_Stage1Ready.initial e;
    have sdk := initial.snapshots.sdk;
    have post :=
      NLF_SdkModel.put sdk (sdk.accounts 2).data
        (have __src := sdk.cells (sdk.accounts 2).data;
        {
          payload :=
            have __src := (sdk.cells (sdk.accounts 2).data).payload;
            { bytes := AspisR1.S2W_ReturnedCheckpoint.nativeBytes saved, money := __src.money },
          readers := __src.readers, writer := __src.writer });
    (NLQ_Stage1State.copyResult initial saved).post.snapshots.sdk = post ∧
      (NLQ_Stage1State.copyResult initial saved).post.snapshots.owned = [] ∧
        (NLQ_Stage1State.copyResult initial saved).post.checkpoint = none ∧
          (NLQ_Stage1State.copyResult initial saved).result = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ())
