NLM_SnapshotBridge.owned : ∀ (e : AspisR1.S2W_D189Entry.Entry) (prior : List ℕ) (a lo hi : ℕ),
  (NLM_SnapshotBridge.step e prior a lo hi).2.bytes =
    if (↑(e.buffers (e.handles a).1)).length = lo ∨ (↑(e.buffers (e.handles a).1)).length = hi then
      Aeneas.Std.core.result.Result.Ok (e.buffers (e.handles a).1)
    else Aeneas.Std.core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidAccountData
