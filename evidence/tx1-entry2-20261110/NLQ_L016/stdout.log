        NLQ_DispatchState.Event.eq world AspisR1.NJD_Prefixes.ten (Aeneas.Std.Array.make 2#usize [3#u8, 10#u8] ⋯)
          (Aeneas.Std.Result.ok true)]
      (NLQ_DispatchState.invoke children.first p a AspisR1.NJD_Prefixes.ten world)
@NLQ_DispatchTx1.eleven : ∀ {A F C : Type} (children : NLQ_DispatchState.Children A F C)
