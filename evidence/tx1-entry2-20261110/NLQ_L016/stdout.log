@NLQ_DispatchSource.fallback : ∀ {A F C : Type} (children : NLQ_DispatchState.Children A F C)
  (p : AspisR1.Hiq_DispatchSource.Key) (a : Aeneas.Std.Slice A) (d : Aeneas.Std.Slice Aeneas.Std.U8) (world : F),
  (NLQ_DispatchState.fallback children p a d world).result = do
    let ten ← AspisR1.Hiq_DispatchSource.eqU8 d (Aeneas.Std.Array.make 2#usize [3#u8, 10#u8] ⋯)
    if ten = true then (children.first p a d world).result
      else do
        let eleven ← AspisR1.Hiq_DispatchSource.eqU8 d (Aeneas.Std.Array.make 2#usize [3#u8, 11#u8] ⋯)
