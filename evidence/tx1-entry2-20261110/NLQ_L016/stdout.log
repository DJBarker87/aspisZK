        NLQ_DispatchState.Event.eq world AspisR1.NJD_Prefixes.eleven (Aeneas.Std.Array.make 2#usize [3#u8, 10#u8] ⋯)
          (Aeneas.Std.Result.ok false),
        NLQ_DispatchState.Event.eq world AspisR1.NJD_Prefixes.eleven (Aeneas.Std.Array.make 2#usize [3#u8, 11#u8] ⋯)
          (Aeneas.Std.Result.ok true)]
      (NLQ_DispatchState.invoke children.first p a AspisR1.NJD_Prefixes.eleven world)
