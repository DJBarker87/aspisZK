  (pub proof : Aeneas.Std.Slice Aeneas.Std.U8) (k : Aeneas.Std.Usize),
  k ≠ AspisR1CurrentCaller.compact.SPLIT →
    AspisR1.GExp_FirstCode.code base B std hashv D semantic pub proof k =
      AspisR1.CheckpointBytes5Effect.Code.done
        (Aeneas.Std.core.result.Result.Err AspisR1CurrentCaller.verifier.Error.Parse)
NLQ_WrongSplit.child : ∀ (base : AspisR1CurrentCaller.Ops) (B : AspisR1PublicPreparation.FinishModel.Boundaries)
  (std : AspisR1.ClaimsUnrolledFinish.StdCalls)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (D : AspisR1CurrentCaller.aspis_core.digest.Digest32 Unit)
  (semantic : AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public)
  (pub proof : Aeneas.Std.Slice Aeneas.Std.U8) (k : Aeneas.Std.Usize),
  k ≠ AspisR1CurrentCaller.compact.SPLIT →
    AspisR1.NGP_L181.NativeAssociation hashv
      (AspisR1.NGQ_Normalize.normalize (AspisR1.GExp_FirstCode.code base B std hashv D semantic pub proof k))
      { result := Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err AspisR1CurrentCaller.verifier.Error.Parse),
        attempted := [] }
NLQ_FirstWrongSplit.fold : ∀ (base : AspisR1CurrentCaller.Ops) (B : AspisR1PublicPreparation.FinishModel.Boundaries)
  (std : AspisR1.ClaimsUnrolledFinish.StdCalls)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (D : AspisR1CurrentCaller.aspis_core.digest.Digest32 Unit)
  (semantic : AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public)
  (pub proof : Aeneas.Std.Slice Aeneas.Std.U8) (k : Aeneas.Std.Usize),
  k ≠ AspisR1CurrentCaller.compact.SPLIT →
    ∀ (handler : AspisR1CurrentCaller.verifier.Error → Aeneas.Std.Result AdapterRw.solana_program_error.ProgramError),
      AspisR1.NGP_L181.NativeAssociation hashv
        (AspisR1.CheckpointBytes5Effect.bind
          (AspisR1.NGQ_Normalize.normalize (AspisR1.GExp_FirstCode.code base B std hashv D semantic pub proof k))
          (NLQ_FirstMap.continuation handler))
        (NLQ_FirstMap.observed handler
          {
            result :=
              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err AspisR1CurrentCaller.verifier.Error.Parse),
            attempted := [] })
NLQ_RuntimeCells.aliases : ∀ (e : AspisR1.S2W_D189Entry.Entry),
