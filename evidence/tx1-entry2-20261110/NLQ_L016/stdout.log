@NLQ_MetadataAdmission.admission : ∀ {F : Type} (h : AspisR1.S2Trust.Heap F) (records : ℕ → NLF_SdkModel.Account)
  (n : ℕ),
  AspisR1.AdapterRw.RuntimeEntrypointAdmission h (fun a => (records a).key) n →
    ∀ (flags : ℕ → Bool),
      AspisR1.AdapterRw.RuntimeEntrypointAdmission h (fun a => (NLQ_MetadataAdmission.withFlags records flags a).key) n
@NLQ_MetadataAdmission.different_flags : ∀ {F : Type} (h : AspisR1.S2Trust.Heap F) (records : ℕ → NLF_SdkModel.Account)
  (money : ℕ → ℕ) (n a b : ℕ),
  a ≠ b →
    AspisR1.AdapterRw.RuntimeEntrypointAdmission h (fun i => (records i).key) n →
      (h.accounts a).1 = (h.accounts b).1 →
        have changed := NLQ_MetadataAdmission.withFlags records fun i => decide (i = b);
        have state := (NLF_RuntimeInterpretation.install h changed money).state;
        AspisR1.AdapterRw.RuntimeEntrypointAdmission h (fun i => (changed i).key) n ∧
          (state.accounts a).data = (state.accounts b).data ∧
            (state.accounts a).writable = false ∧ (state.accounts b).writable = true
