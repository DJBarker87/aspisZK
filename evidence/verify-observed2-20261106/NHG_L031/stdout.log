def AspisR1PublicPreparation.r1_wire.Prefix.record : r1_wire.Prefix →
  U8 → Result (core.result.Result (Slice U8) r1_wire.Error) :=
fun self row =>
  if row ≥ 27#u8 then ok (core.result.Result.Err r1_wire.Error.InvalidRow)
  else do
    let i ← lift (UScalar.cast UScalarTy.Usize row)
    let s ← self.records.index_usize i
    ok (core.result.Result.Ok s)
def AspisR1PublicPreparation.r1_wire.Prefix.validated_record : r1_wire.Prefix →
  U8 → Result (core.result.Result r1_wire.ValidatedRecord r1_wire.Error) :=
fun self row => do
  let r ← self.record row
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
    | core.ops.control_flow.ControlFlow.Continue val => ok (core.result.Result.Ok { row := row, framed := val })
    | core.ops.control_flow.ControlFlow.Break residual =>
      core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual r1_wire.ValidatedRecord
        (core.convert.FromSame r1_wire.Error) residual
