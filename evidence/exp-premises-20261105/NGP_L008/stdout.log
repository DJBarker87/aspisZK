def AspisR1.CPR_DataPersistence.TwoTransactionLaw : {Tx Key : Type} →
  (next : Tx → Tx → Prop) →
    (ordinary : Tx → Key → Prop) →
      (before tentative : Tx → Key → AspisR1.CPR_DataPersistence.Image) →
        (success : Tx → Bool) → (loaded : Tx → Key → Option.{0} AspisV8R19.DuplexFrames.Bytes) → Prop :=
fun {Tx Key : Type} (next : Tx → Tx → Prop) (ordinary : Tx → Key → Prop)
    (before tentative : Tx → Key → AspisR1.CPR_DataPersistence.Image) (success : Tx → Bool)
    (loaded : Tx → Key → Option.{0} AspisV8R19.DuplexFrames.Bytes) =>
  ∀ (t u : Tx),
    next t u →
      ∀ (key : Key),
        ordinary t key →
          @Eq.{1} (Option.{0} AspisV8R19.DuplexFrames.Bytes) (loaded u key)
            (AspisR1.CPR_DataPersistence.visible
              (@ite.{1} AspisR1.CPR_DataPersistence.Image (@Eq.{1} Bool (success t) Bool.true)
                (instDecidableEqBool (success t) Bool.true) (tentative t key) (before t key)))
