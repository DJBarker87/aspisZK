'AspisR1.NLU_Decode.source' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLU_Decode.source : ∀ {H : Type} (i : NLU.Input H),
  NLU.InputDomain i →
    ∃ record25 record26,
      i.prefix1.validated_record 25#u8 = ok (core.result.Result.Ok record25) ∧
        i.prefix1.validated_record 26#u8 = ok (core.result.Result.Ok record26) ∧
          record25.row = 25#u8 ∧
            record26.row = 26#u8 ∧
              NKQ_RecordDomains.Ready record25 29#usize 87#usize ∧ NKQ_RecordDomains.Ready record26 29#usize 0#usize :=
⋯
