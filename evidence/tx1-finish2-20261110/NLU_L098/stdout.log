'AspisR1.NLU_Circle.source' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLU_Circle.source : ∀ {Pointer H : Type} (i : NLU.Input H),
  NLU.InputDomain i →
    ∀ (template : NIX_DispatchCut.Pre Pointer) (beforeFirst beforeSecond : r1_wire.SemanticTranscript H),
      ∃ first second,
        i.prefix1.validated_record 25#u8 = ok (core.result.Result.Ok first) ∧
          i.prefix1.validated_record 26#u8 = ok (core.result.Result.Ok second) ∧
            first.row = 25#u8 ∧
              second.row = 26#u8 ∧
                NJM_InvocationRoots.Circle i.digest template beforeFirst first ∧
                  NJM_InvocationRoots.Circle i.digest template beforeSecond second :=
⋯
