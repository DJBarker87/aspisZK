'AspisR1.NLU_Terminal.first_calls' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLU_Terminal.first_calls : ∀ {H : Type} (native : NJM_RoundsCut.Observations),
  NJM_RoundsCut.Cut native →
    ∀ (token frame : ℕ) (i : NLU.Input H),
      NLU.InputDomain i →
        match (PreparedHashCode.run (S1SemanticCode.rounds NJM_RoundJoin.R i.digest i.prefix1 i.transcript)).2 with
        | ok (core.result.Result.Ok rounds) =>
          match ClaimsUnrolledFinish.claims (NP6_StdModel.calls i.reservation) i.prefix1 with
          | ok (core.result.Result.Ok claims) =>
            Packet i.publicValue claims rounds.2.1 i.challenges ∧
              nativeTerminal i.publicValue claims rounds.2.1 i.challenges =
                (IDa_Deployed.boundaries i.reservation).terminal i.publicValue claims rounds.2.1 i.challenges
          | x => True
        | x => True :=
⋯
