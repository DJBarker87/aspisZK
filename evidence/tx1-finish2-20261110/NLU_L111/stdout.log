'AspisR1.NLU_High.complete' depends on axioms: [propext, Classical.choice, Quot.sound]
AspisR1.NLU_High.complete : ∀ (native : AspisR1.NLU_High.Native),
  AspisR1.NLU_High.Cut native →
    ∀ (claims : AspisR1.NLU_High.Claims) (i : Fin 10),
      native claims i = { value := AspisR1.NLU_High.high claims i, claims := claims }
'AspisR1.NLU_High.frame' depends on axioms: [propext, Classical.choice, Quot.sound]
AspisR1.NLU_High.frame : ∀ (native : AspisR1.NLU_High.Native),
  AspisR1.NLU_High.Cut native → ∀ (claims : AspisR1.NLU_High.Claims) (i : Fin 10), (native claims i).claims = claims
'AspisR1.NLU_High.induction' depends on axioms: [propext, Classical.choice, Quot.sound]
AspisR1.NLU_High.induction : ∀ (native : AspisR1.NLU_High.Native),
  AspisR1.NLU_High.Cut native →
    ∀ (count start : ℕ),
      start + count ≤ 10 →
        ∀ (claims : AspisR1.NLU_High.Claims) (memory : AspisR1.NLU_High.Memory),
          AspisR1.NLU_High.loop native count start claims memory =
            (claims, AspisR1.NLI_FromFn.fill (AspisR1.NLU_High.values claims) count start memory)
'AspisR1.NLU_High.initialized' depends on axioms: [propext, Classical.choice, Quot.sound]
AspisR1.NLU_High.initialized : ∀ (native : AspisR1.NLU_High.Native),
  AspisR1.NLU_High.Cut native →
    ∀ (claims : AspisR1.NLU_High.Claims) (memory : AspisR1.NLU_High.Memory),
      (AspisR1.NLU_High.loop native 10 0 claims memory).1 = claims ∧
        AspisR1.NLI_FromFn.Initialized (AspisR1.NLU_High.values claims) 10
          (AspisR1.NLU_High.loop native 10 0 claims memory).2
'AspisR1.NLU_High.value' depends on axioms: [propext, Classical.choice, Quot.sound]
AspisR1.NLU_High.value : ∀ (native : AspisR1.NLU_High.Native),
  AspisR1.NLU_High.Cut native →
    ∀ (claims : AspisR1.NLU_High.Claims) (i : Fin 10), (native claims i).value = AspisR1.NLU_High.high claims i
