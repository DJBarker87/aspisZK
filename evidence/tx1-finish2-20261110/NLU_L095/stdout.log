'AspisR1.NLU_Generated.emitted_mul' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLU_Generated.emitted_mul : ∀ (x y : GenQ),
  CurrentCanonicalQM (genQToProbe x) →
    CurrentCanonicalQM (genQToProbe y) →
      ∃ z,
        AspisR1SemanticCallExtraction.aspis_core.field.QM31.mul x y = ok z ∧
          CurrentCanonicalQM (genQToProbe z) ∧
            decode (genQToProbe z) = decode (genQToProbe x) * decode (genQToProbe y) :=
⋯
