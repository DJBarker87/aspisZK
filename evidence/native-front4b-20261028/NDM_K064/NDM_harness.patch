+ let signer=kani::any();let writable=kani::any();let executable=kani::any();
+ let data=&mut bytes[..n];unsafe{NDM_PTR=data.as_ptr();NDM_LEN=n;}
+ let a=AccountInfo::new(&key,signer,writable,&mut lamports,data,&owner,executable,0);
+ let l1:usize=kani::any();let l2:usize=kani::any();kani::assume(n==l1 || n==l2);
