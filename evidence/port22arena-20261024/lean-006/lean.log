def Port22ARENA.initial : Nat → Nat → Nat → Nat :=
fun start len cursor => if cursor = 0 then start + len else cursor
def Port22ARENA.candidate : Nat → Nat → Nat → Nat → Nat → Nat :=
fun start len cursor size align => Port22ARENA.initial start len cursor - size &&& 2 ^ 64 - align
def Port22ARENA.storeCursor : Port22ARENA.Memory → Nat → Nat → Port22ARENA.Memory :=
fun mem s value x => if s ≤ x ∧ x < s + 8 then value / 256 ^ (x - s) % 256 else mem x
def Port22ARENA.alloc : Port22ARENA.Memory → Nat → Nat → Nat → Nat → Nat → Nat × Port22ARENA.Memory :=
fun mem s l c n a =>
  have p := Port22ARENA.candidate s l c n a;
  if p < s + 8 then (0, mem) else (p, Port22ARENA.storeCursor mem s p)
def Port22ARENA.events : Nat → Nat → Nat → Nat → Nat → List Port22ARENA.Event :=
fun s l c n a =>
  have p := Port22ARENA.candidate s l c n a;
  if p < s + 8 then [Port22ARENA.Event.readCursor s, Port22ARENA.Event.returned 0]
  else [Port22ARENA.Event.readCursor s, Port22ARENA.Event.writeCursor s p, Port22ARENA.Event.returned p]
def Port22ARENA.cut : List Port22ARENA.Event → Nat → Nat → Nat → Nat → Nat → Nat → List Port22ARENA.Event :=
fun history s l c n a count => history ++ List.take count (Port22ARENA.events s l c n a)
def Port22ARENA.readLE : Port22ARENA.Memory → Nat → Nat → Nat :=
fun mem base x => Nat.brecOn (motive := fun x => Nat → Nat) x (Port22ARENA.readLE._f mem) base
def Port22ARENA.Separated : Nat → Nat → Prop :=
fun x y => x + 8 ≤ y ∨ y + 8 ≤ x
def Port22ARENA.stores : Port22ARENA.Memory → List (Nat × Nat) → Port22ARENA.Memory :=
fun mem x => List.brecOn (motive := fun x => Port22ARENA.Memory → Port22ARENA.Memory) x Port22ARENA.stores._f mem
def Port22ARENA.wordInitial : BitVec 64 → BitVec 64 → BitVec 64 → BitVec 64 :=
fun s l c => if c = 0 then s + l else c
def Port22ARENA.wordSaturatingSub : BitVec 64 → BitVec 64 → BitVec 64 :=
fun x n => if x < n then 0 else x - n
def Port22ARENA.wordCandidate : BitVec 64 → BitVec 64 → BitVec 64 → BitVec 64 → BitVec 64 → BitVec 64 :=
fun s l c n a => Port22ARENA.wordSaturatingSub (Port22ARENA.wordInitial s l c) n &&& ~~~(a - 1)
