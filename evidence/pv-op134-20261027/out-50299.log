R1Z.PV_Op134_ReferenceBundle.op134_reference (base : ProverRwFull.ExternalTypes) (ops : ProverRwFull.ExternalFuns) :
  ProverRwFull.ExternalFuns.op134 = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok R1Z.PV_Op134_Masks.masks)
R1Z.PV_Op134_ReferenceBundle.rows_reference (base : ProverRwFull.ExternalTypes) (ops : ProverRwFull.ExternalFuns) :
  ∃ result,
    ProverRwFull.ExternalFuns.op133 = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok result) ∧
      ↑result = R1Z.PV_Op134_RowSpec.rows ∧
        (↑result).length = 214 ∧
          (↑result).Nodup ∧
            List.Pairwise (fun a b => ↑a < ↑b) ↑result ∧
              ∀ (block : Fin 64) (bit : Fin 16),
                (↑(↑R1Z.PV_Op134_Masks.masks)[↑block]).testBit ↑bit = true ↔
                  16 * ↑block + ↑bit ∈ List.map (fun r => ↑r) ↑result
R1Z.PV_Op134_ReferenceBundle.cells_reference (base : ProverRwFull.ExternalTypes) (ops : ProverRwFull.ExternalFuns) :
  ∃ result,
    ProverRwFull.ExternalFuns.op132 = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok result) ∧
      ↑result = R1Z.PV_CBM_CellsSpec.literals ∧
        (↑result).length = 3803 ∧
          (↑result).Nodup ∧
            ∀ (row column : ℕ),
              row < 1024 →
