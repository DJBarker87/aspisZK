def AspisR1.FGl_PreparedAt.Owners : {F C : Type} →
  AspisR1.DrvC_Installation.Configuration F C → AspisR1PublicPreparation.FinishModel.Boundaries → Prop :=
fun {F C} c B =>
  ∀ (s : AspisR1.F3T_ByteCarrier.Submission) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
    (e : AspisR1.F3V_RunEvidence.Evidence c B s H) (i : AspisR1.F3_Model.Input)
    (p : AspisR1.OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144)
    (data : AspisR1.RecordedBinaryExperimentBin.SourceInputs) (t : AspisR1.Cons_Native.Witness),
    AspisR1.FGl_PreparedAt.At c B s H e i p q data →
      AspisR1.Cons_Native.Calls (AspisR1.Op5T_Concrete.stage (AspisR1.AuS1_Install.base c.stageBase)) c.finish
          c.reserved c.query c.geometry (AspisR1.F3V_RunEvidence.D2 c H) () e.pub e.proof e.saved.deref t →
        ∀
          (x :
            AspisR1.F3S_FinishWitness.Primitives c.finish t.v2 t.p2
              (have __src := t.returned2;
              { weights := t.back2 t.flushed2, rhs := __src.rhs, power := __src.power, next := __src.next })),
          AspisR1.FGl_FinishLeaves.Holds c.finish t.v2 t.p2
            (have __src := t.returned2;
            { weights := t.back2 t.flushed2, rhs := __src.rhs, power := __src.power, next := __src.next })
            x q p
            (AspisR1.LiteralTranscript.erasePrefix
              (AspisV8R19.MemoizedProgramLaw.eval H
                  (AspisR1.F3J_SamplerRun.program i.proof 0 33 (FS.emptyPrefix i.semantic.value))).2)
            data
def AspisR1.FGl_PreparedAt.At : {F C : Type} →
  (c : AspisR1.DrvC_Installation.Configuration F C) →
    (B : AspisR1PublicPreparation.FinishModel.Boundaries) →
      (s : AspisR1.F3T_ByteCarrier.Submission) →
        (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
          AspisR1.F3V_RunEvidence.Evidence c B s H →
            AspisR1.F3_Model.Input →
              AspisR1.OraclePortCompactDraft.Parsed →
                (Fin 22 → Fin 262144) → AspisR1.RecordedBinaryExperimentBin.SourceInputs → Prop :=
fun {F C} c B s H e i p q data =>
  have tr :=
    AspisR1.LiteralTranscript.erasePrefix
      (AspisV8R19.MemoizedProgramLaw.eval H
          (AspisR1.F3J_SamplerRun.program i.proof 0 33 (FS.emptyPrefix i.semantic.value))).2;
  i.physical.bytes = AspisR1.MultiproofConeCanonical.bytesOf ↑e.pub ∧
    i.stored = AspisR1.MultiproofConeCanonical.bytesOf ↑e.proof ∧
      AspisR1.OraclePortStoredParserC4.parseReached i.stored tr = Option.some p ∧
        AspisR1.OraclePortSelectedDraft.queries tr = Option.some q ∧
          AspisR1.OraclePortStoredDecisionDraftC4.input p q tr = Option.some data ∧
            AspisR1.Port5Q1_QueryPorts.SessionAPrepare (AspisR1.Tx1Q_Carriers.prepared e.run.p) data.data q
                (AspisR1.SelectedChallengeMap.rhoOf data.rho) ∧
              ∃ out v,
                AspisR1CurrentCaller.InstalledPreparation.currentPrepared out = e.run.p ∧
                  AspisR1.LiteralOpeningView.read (AspisR1.OraclePortStoredDecisionDraftC4.typedRows p q tr) =
                      Option.some v ∧
                    AspisR1.F3L_SourcePrepared.numeric out =
                        AspisR1.OraclePortCheckpointResumeC5.prepared
                          (AspisR1.OraclePortAcceptedContextC6.context p data v) data.data
                          (AspisR1.SelectedChallengeMap.rhoOf data.rho) q ∧
                      AspisR1.AuS1_Recovery.log
                            (AspisR1.Uni_Install.current c.currentBase c.reserved c.query c.geometry) c.boundaries c.std
                            (AspisR1.F3V_RunEvidence.D1 c H) (AspisS6CurrentVerifierCarrier.toPublic e.semantic) e.proof
                            () (Aeneas.Std.Array.repeat 29#usize e.run.zero) =
                          (AspisV8R19.MemoizedProgramLaw.eval H
                              (AspisR1.F3J_SamplerRun.program i.proof 0 33 (FS.emptyPrefix i.semantic.value))).1 ∧
                        AspisR1.OraclePortAdmission.Guard tr
def AspisR1.FGl_FinishLeaves.Holds : {W : Type} →
  (finish : AspisR1Stage2.Stage2Finish.FinishOps W) →
    (v : AspisR1Stage2.verifier.View) →
      (p : AspisR1Stage2.verifier.Prepared) →
        (a : AspisR1Stage2.verifier.Accumulator) →
          AspisR1.F3S_FinishWitness.Primitives finish v p a →
            (Fin 22 → Fin 262144) →
              AspisR1.OraclePortCompactDraft.Parsed →
                AspisR1.RawCutTranscriptRun.ErasedPrefix → AspisR1.RecordedBinaryExperimentBin.SourceInputs → Prop :=
fun {W} finish v p a x q parsed tr input =>
  AspisR1.FGl_FinishLeaves.PairingRemaining finish v p input.data ∧
    (∀ (j : Fin 22), AspisR1.MatchingSupport.match0 input.data (q j)) ∧
      AspisR1.R3SemanticRemainingJoins.EquationEndpoint input.decoded
          (AspisR1.OraclePortStoredDecisionDraftC4.typedRows parsed q tr) input.data ∧
        AspisR1.CheckpointBytes5Output.ofE x.dot =
          ∑ l, input.data.f l * AspisR1.LiteralOpeningView.eK ((AspisR1.CheckpointBytes5Output.accumulator a).weights l)
