def AspisR1.SAG_NativeFull.Shape : VTop_Stages.Ops →
  Aeneas.Std.Slice Aeneas.Std.U8 → AspisR1.Cons_Native.Witness → Prop :=
fun ops proof t =>
  ∃ round0 folded round1 finalStart queryStart,
    ops.op22 = Aeneas.Std.Result.ok round0 ∧
      ops.op15 = Aeneas.Std.Result.ok folded ∧
        ops.op14 = Aeneas.Std.Result.ok round1 ∧
          ops.op21 = Aeneas.Std.Result.ok finalStart ∧
            ops.op20 = Aeneas.Std.Result.ok queryStart ∧
              Aeneas.Std.core.slice.index.Slice.index
                    (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8) proof
                    { start := round0, «end» := folded } =
                  Aeneas.Std.Result.ok t.v2.round0 ∧
                Aeneas.Std.core.slice.index.Slice.index
                      (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8) proof
                      { start := round1, «end» := finalStart } =
                    Aeneas.Std.Result.ok t.v2.round1 ∧
                  Aeneas.Std.core.slice.index.Slice.index
                      (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8) proof
                      { start := finalStart, «end» := queryStart } =
                    Aeneas.Std.Result.ok t.v2.final_message
