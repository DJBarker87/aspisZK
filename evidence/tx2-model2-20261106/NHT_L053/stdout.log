  (domain : AspisR1.NGC_KNE_Caller.WriterDomain prepared accumulator) (hp hu hc : AspisR1.CheckpointBytes5Effect.Digest)
  {Tx A W : Type} (p : AspisR1.CPG_Projection.Observations Tx A) (t u : Tx) (e1 e2 : AspisR1.S2W_D189Entry.Entry)
  (actions : List (AspisR1.CPP_BankState.Action A)) (n1 : AspisR1.S2W_ExtractionBoundary.First)
  (n2 : AspisR1.S2W_ExtractionBoundary.Second)
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (std : AspisR1.S2W_TrustedStd.TrustedStd copy) (allocator : AspisR1.S2W_D189Wrappers.Allocator A)
  (_valid1 : AspisR1.S2Trust.Valid e1.heap) (id system : AspisR1.S2W_ExtractionBoundary.Program)
  (data1 : Aeneas.Std.Slice Aeneas.Std.U8) (state1 final1 : A)
  (post1 : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record))
  (game :
    AspisR1.CPH_Game.DeployedPairExecution p t u e1 e2
      (AspisR1.NGR_HISTORY.checkpoint prepared accumulator domain hp hu hc) actions n1 n2 copy allocator id)
  (native_writer_result :
    AspisR1.S2W_D189Wrappers.first n1 copy allocator e1 id data1 state1 =
      Aeneas.Std.Result.ok
        (Aeneas.Std.core.result.Result.Ok
          (AspisR1.NGR_HISTORY.checkpoint prepared accumulator domain hp hu hc, post1, final1)))
  (protection :
    AspisR1.CPH_Protection.Facts p t (AspisR1.NGR_HISTORY.checkpoint prepared accumulator domain hp hu hc) id)
  (ordinary : AspisR1.CPG_Projection.ordinary p system t ((p.layout t).handles 2).1)
  (RuntimePersistence :
    AspisR1.CPR_DataPersistence.TwoTransactionLaw (AspisR1.CPG_Projection.adjacent p)
      (AspisR1.CPG_Projection.ordinary p system) (AspisR1.CPG_Projection.before p) (AspisR1.CPG_Projection.tentative p)
      (AspisR1.CPG_Projection.success p) (AspisR1.CPG_Projection.loaded p))
  (L : AspisR1.S2Trust.Library W (ℕ → AspisR1.S2W_D189Entry.Record)) (sdk : AspisR1.S2Trust.S2TrustedSdkBorrow L)
  (w2 : W) (related2 : L.related w2 e2.heap) (valid2 : AspisR1.S2Trust.Valid e2.heap) :
  AspisR1.CPG_Projection.adjacent p t u ∧
    ((p.layout t).handles 2).1 = ((p.layout u).handles 6).1 ∧
      AspisR1.CPG_Projection.success p t = true ∧
        p.copied t = AspisR1.NGR_HISTORY.checkpoint prepared accumulator domain hp hu hc ∧
          (↑(AspisR1.NGR_HISTORY.checkpoint prepared accumulator domain hp hu hc)).length = 1768 ∧
            AspisR1.CPG_Projection.loaded p u ((p.layout t).handles 2).1 =
                some
                  (AspisR1.MultiproofConeCanonical.bytesOf
                    ↑(AspisR1.NGR_HISTORY.checkpoint prepared accumulator domain hp hu hc)) ∧
              ↑(e2.buffers (e2.handles 6).1) = ↑(AspisR1.NGR_HISTORY.checkpoint prepared accumulator domain hp hu hc) ∧
                AspisR1.S2W_EntryWriteHistory.payloadBytes AspisR1.S2W_ReturnedCheckpoint.encode
                      (post1.payload (e1.heap.accounts 2).1) 1768 =
                    AspisR1.MultiproofConeCanonical.bytesOf
                      ↑(AspisR1.NGR_HISTORY.checkpoint prepared accumulator domain hp hu hc) ∧
                  AspisR1.S2W_EntryWriteHistory.payloadBytes AspisR1.S2W_ReturnedCheckpoint.encode
                        (L.cellPayload w2 (L.accountData w2 6))
                        (L.cellPayload w2 (L.accountData w2 6)).descriptor.length =
                      AspisR1.MultiproofConeCanonical.bytesOf
                        ↑(AspisR1.NGR_HISTORY.checkpoint prepared accumulator domain hp hu hc) ∧
                    AspisR1.CPH_Trace.Facts p t u (AspisR1.NGR_HISTORY.checkpoint prepared accumulator domain hp hu hc)
                      n1 n2 copy allocator id
