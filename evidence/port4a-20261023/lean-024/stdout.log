AspisR1.Port4A_PhysicalReads.six_reads (base : VTop_Stages.Ops) (reserved : Bool) {H : Type}
  (D : VTop_Stages.aspis_core.digest.Digest32 H) (hash : H) (wp : VTop_Stages.verifier.Prepared)
  (wa : VTop_Stages.verifier.Accumulator) (proof pub : Aeneas.Std.Slice Aeneas.Std.U8)
  (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8) (p : VTop_Stages.verifier.Prepared)
  (a : VTop_Stages.verifier.Accumulator)
  (wrote : AspisR1.Port3_CheckpointInstall.writer D wp wa proof pub hash = Aeneas.Std.Result.ok saved)
  (resumed :
    (AspisR1.Port4A_ReaderInstall.install base reserved).op18 D (AspisR1.VTop_Checkpoint.checkpointSlice saved) proof
        pub AspisR1Stage2.transport.Variant.S2 hash =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (p, a)))
  (before : AspisR1.CheckpointBytes5Effect.Log) :
  ∃ hp hu hc c,
    AspisR1.CheckpointBytes5Effect.run (AspisR1.VTop_Checkpoint.digest D) hash
        (AspisR1.CheckpointBytes5Join.stage reserved (AspisR1.CheckpointBytes3Namespaces.toPrepared wp)
          (AspisR1.CheckpointBytes3Namespaces.toAccumulator wa) proof pub)
        before =
      Aeneas.Std.Result.ok
        (Aeneas.Std.core.result.Result.Ok (p, a),
          before ++
            [(AspisR1Stage2.WireTx2.singletonParts proof, hp), (AspisR1Stage2.WireTx2.singletonParts pub, hu),
              (AspisR1Stage2.WireTx2.checksumParts
                  (AspisR1.CheckpointBytes5Writer.bodySlice (AspisR1.CheckpointBytes3Namespaces.toPrepared wp)
                    (AspisR1.CheckpointBytes3Namespaces.toAccumulator wa) hp hu),
                hc),
              (c.proofParts, c.proofDigest), (c.publicParts, c.publicDigest), (c.checksumParts, c.checksumDigest)])
