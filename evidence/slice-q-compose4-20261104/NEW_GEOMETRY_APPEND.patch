+// One line-buffer write on the SAME arbitrary old line state and disjoint flat view.
+fn NEW_line_step(lines:&mut Vec<M31>,value:M31){lines.push(value);}
+fn NEW_line_case<const N:usize,const M:usize>(){
+ assert_eq!(M,5*N);assert_eq!(core::mem::size_of::<M31>(),core::mem::size_of::<u32>());
+ assert_eq!(core::mem::align_of::<M31>(),core::mem::align_of::<u32>());
+ let k:usize=kani::any();kani::assume(k<N);
+ let raw:[u32;N]=kani::any();let flat_raw:[u32;M]=kani::any();
+ let flat=unsafe{core::slice::from_raw_parts(flat_raw.as_ptr().cast::<M31>(),M)};
+ let p=Box::into_raw(Box::new([core::mem::MaybeUninit::<M31>::uninit();N])) as *mut M31;
+ let mut i=0;while i<k{unsafe{p.add(i).write(M31(raw[i]));}i+=1;}
+ let mut lines=unsafe{Vec::from_raw_parts(p,k,N)};
+ let j:usize=kani::any();kani::assume(j<N);let f:usize=kani::any();kani::assume(f<M);
+ let value=M31(kani::any());let old_value=value.0;
+ assert_eq!(flat[f].0,flat_raw[f]);if j<k{assert_eq!(lines[j].0,raw[j]);}
+ NEW_line_step(&mut lines,value);
+ #[cfg(NET_bad_reply)] {lines[k].0^=1;}
+ #[cfg(NET_bad_frame)] {if j<k{lines[j].0^=1;}}
+ assert_eq!(lines.len(),k+1);assert_eq!(lines.capacity(),N);assert_eq!(lines.as_ptr(),p);
+ assert_eq!(lines[k].0,old_value);if j<k{assert_eq!(lines[j].0,raw[j]);}
+ assert_eq!(flat[f].0,flat_raw[f]);assert_ne!(flat.as_ptr(),lines.as_ptr());
+}
