def Lean.Order.admissible.{u} : {α : Sort u} → [Lean.Order.CCPO α] → (α → Prop) → Prop :=
fun {α} [Lean.Order.CCPO α] P =>
  ∀ (c : α → Prop) (hc : Lean.Order.chain c), (∀ (x : α), c x → P x) → P (Lean.Order.CCPO.csup hc)
def Aeneas.Std.UScalar.shiftRight_IScalar : {ty : Aeneas.Std.UScalarTy} →
  {tys : Aeneas.Std.IScalarTy} →
    Aeneas.Std.UScalar ty → Aeneas.Std.IScalar tys → Aeneas.Std.Result (Aeneas.Std.UScalar ty) :=
fun {ty} {tys} x s => if ↑s ≥ 0 then x.shiftRight s.toNat else Aeneas.Std.Result.fail Aeneas.Std.Error.integerOverflow
