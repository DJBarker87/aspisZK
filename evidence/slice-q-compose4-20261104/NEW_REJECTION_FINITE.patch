+// Finite-domain isolation: actual k is a compile-time constant; allocation
+// class remains arbitrary and spare memory is genuinely uninitialized.
+fn NEW_reject_fixed<const K:usize>(){
+ let tx1:bool=kani::any();kani::assume(!tx1 || K<10);kani::assume(K<12);
+ let n=if tx1{10}else{12};let m=5*n;
+ let raw:[u32;60]=kani::any();let old_lines:[u32;12]=kani::any();
+ let mut flat:Vec<M31>=Vec::with_capacity(m);let mut lines:Vec<M31>=Vec::with_capacity(n);
+ assert_eq!(flat.capacity(),m);assert_eq!(lines.capacity(),n);
+ let p=flat.as_mut_ptr();let lp=lines.as_mut_ptr();
+ let mut j=0;while j<5*K{unsafe{p.add(j).write(M31(raw[j]));}j+=1;}
+ let mut j=0;while j<K{unsafe{lp.add(j).write(M31(old_lines[j]));}j+=1;}
+ unsafe{flat.set_len(5*K);lines.set_len(K);}
+ let f:usize=kani::any();kani::assume(f<m);let l:usize=kani::any();kani::assume(l<n);
+ let values=row();let zero_lane:usize=kani::any();kani::assume(zero_lane<5);kani::assume(values[zero_lane].0==0);
+ let answer=NET_gather(&mut flat,&mut lines,values);
+ #[cfg(NET_bad_reply)] {assert_eq!(answer,Ok(()));}
+ #[cfg(not(NET_bad_reply))] {assert_eq!(answer,Err(Error::Query));}
+ assert_eq!(flat.len(),5*K);assert_eq!(lines.len(),K);
+ assert_eq!(flat.capacity(),m);assert_eq!(lines.capacity(),n);
+ assert_eq!(flat.as_ptr(),p);assert_eq!(lines.as_ptr(),lp);assert_ne!(p,lp);
+ if f<5*K{assert_eq!(flat[f].0,raw[f]);}
+ if l<K{assert_eq!(lines[l].0,old_lines[l]);}
+}
