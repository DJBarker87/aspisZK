theorem AspisR1.S2W_DigestExtraction.native_binding : ∀ (ops : AdapterRw.Ops)
  (native1 : AspisR1.S2W_ExtractionBoundary.First) (native2 : AspisR1.S2W_ExtractionBoundary.Second)
  (hashv : AspisR1.S2W_DigestExtraction.Parts → Aeneas.Std.Result AspisR1.S2W_DigestExtraction.Digest),
  AspisR1.S2W_DigestExtraction.AeneasExtraction ops native1 native2 hashv →
    AspisR1.S2Z.Oracle.NativeBinding ops hashv :=
fun ops native1 native2 hashv extraction self parts =>
  Eq.trans (extraction.digestSource self parts) (AspisR1.S2W_DigestExtraction.digest_eq_hashv hashv self parts)
'AspisR1.S2W_DigestExtraction.native_binding' depends on axioms: [propext, Classical.choice, Quot.sound]
