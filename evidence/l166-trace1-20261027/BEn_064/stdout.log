theorem AspisR1.BEh_Scope.reflexive : ∀ {S A E : Type} (out : AspisR1.BEh_Scope.Outcome S A E),
  AspisR1.BEh_Scope.Law out out :=
fun {S A E} out => ⟨⟨fun x => Iff.rfl, fun x x_1 => rfl⟩, ⟨Iff.rfl, fun x => rfl⟩⟩
'AspisR1.BEh_Scope.reflexive' depends on axioms: [propext, Classical.choice, Quot.sound]
