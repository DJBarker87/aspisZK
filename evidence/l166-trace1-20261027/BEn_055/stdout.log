theorem AspisR1.BEl_Recorder.entered : ∀ (before : AspisR1.BEl_Recorder.History) (parts : AspisR1.SdkC_Source.Parts),
  List.map AspisR1.BEl_Recorder.Attempt.parts (AspisR1.BEl_Recorder.enter before parts) =
    List.map AspisR1.BEl_Recorder.Attempt.parts before ++ [parts] :=
fun before parts =>
  of_eq_true
    (Eq.trans (congrFun' (congrArg Eq List.map_append) (List.map AspisR1.BEl_Recorder.Attempt.parts before ++ [parts]))
      (eq_self (List.map AspisR1.BEl_Recorder.Attempt.parts before ++ [parts])))
'AspisR1.BEl_Recorder.entered' depends on axioms: [propext, Classical.choice, Quot.sound]
