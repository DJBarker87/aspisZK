theorem AspisR1.SdkC_Source.associated : ∀
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest) {A : Type}
  (code : AspisR1.SdkC_Source.Code A) (before : AspisR1.SdkC_Source.Log),
  (∀ q ∈ before, q.returned = hashv q.parts) →
    ∀ q ∈ (AspisR1.SdkC_Source.run hashv code before).2, q.returned = hashv q.parts :=
fun hashv {A} code before initial =>
  AspisR1.CheckpointBytes5Effect.Code.rec (motive := fun code =>
    ∀ (before : AspisR1.SdkC_Source.Log),
      (∀ q ∈ before, q.returned = hashv q.parts) →
        ∀ q ∈ (AspisR1.SdkC_Source.run hashv code before).2, q.returned = hashv q.parts)
    (fun a before initial => initial)
    (fun {B} r k ih before initial =>
      Aeneas.Std.Result.casesOn (motive := fun t =>
        r = t →
          ∀ q ∈ (AspisR1.SdkC_Source.run hashv (AspisR1.CheckpointBytes5Effect.Code.step r k) before).2,
            q.returned = hashv q.parts)
        r
        (fun a h =>
          Eq.ndrec (motive := fun r =>
            ∀ q ∈ (AspisR1.SdkC_Source.run hashv (AspisR1.CheckpointBytes5Effect.Code.step r k) before).2,
              q.returned = hashv q.parts)
            (ih a before initial) (Eq.symm h))
        (fun e h =>
          Eq.ndrec (motive := fun r =>
            ∀ q ∈ (AspisR1.SdkC_Source.run hashv (AspisR1.CheckpointBytes5Effect.Code.step r k) before).2,
              q.returned = hashv q.parts)
            initial (Eq.symm h))
        (fun h =>
          Eq.ndrec (motive := fun r =>
            ∀ q ∈ (AspisR1.SdkC_Source.run hashv (AspisR1.CheckpointBytes5Effect.Code.step r k) before).2,
              q.returned = hashv q.parts)
            initial (Eq.symm h))
        (Eq.refl r))
    (fun parts k ih before initial =>
      have next := fun q member =>
        Or.casesOn (List.mem_append.mp member) (fun old => initial q old) fun fresh =>
          Eq.ndrec (motive := fun q =>
            q ∈ before ++ [{ parts := parts, returned := hashv parts }] →
              q ∈ [{ parts := parts, returned := hashv parts }] → q.returned = hashv q.parts)
            (fun member fresh => Eq.refl { parts := parts, returned := hashv parts }.returned)
            (Eq.symm (List.mem_singleton.mp fresh)) member fresh;
      Aeneas.Std.Result.casesOn (motive := fun t =>
        hashv parts = t →
          ∀ q ∈ (AspisR1.SdkC_Source.run hashv (AspisR1.CheckpointBytes5Effect.Code.read parts k) before).2,
            q.returned = hashv q.parts)
        (hashv parts)
        (fun digest h =>
          Eq.ndrec (motive := fun x =>
            hashv parts = x →
              ∀ q ∈ (AspisR1.SdkC_Source.run hashv (AspisR1.CheckpointBytes5Effect.Code.read parts k) before).2,
                q.returned = hashv q.parts)
            (fun h =>
              Eq.mpr
                (id
                  (forall_congr fun q =>
                    implies_congr
                      (congrFun'
                        (congrArg Membership.mem
                          (congrArg Prod.snd
                            (Eq.trans (AspisR1.SdkC_Source.run.eq_5 hashv before parts k)
                              (Eq.trans
                                (congrArg
                                  (fun x =>
                                    match x with
                                    | Aeneas.Std.Result.ok digest =>
                                      AspisR1.SdkC_Source.run hashv (k digest)
                                        (before ++ [{ parts := parts, returned := hashv parts }])
                                    | Aeneas.Std.Result.fail e =>
                                      (Aeneas.Std.Result.fail e,
                                        before ++ [{ parts := parts, returned := hashv parts }])
                                    | Aeneas.Std.Result.div =>
                                      (Aeneas.Std.Result.div, before ++ [{ parts := parts, returned := hashv parts }]))
                                  h)
                                (congrArg (AspisR1.SdkC_Source.run hashv (k digest))
                                  (congrArg (HAppend.hAppend before)
                                    (congrFun' (congrArg List.cons (congrArg (AspisR1.SdkC_Source.Query.mk parts) h))
                                      [])))))))
                        q)
                      (Eq.refl (q.returned = hashv q.parts))))
                (ih digest (before ++ [{ parts := parts, returned := Aeneas.Std.Result.ok digest }])
                  (Eq.mp
                    (forall_congr fun q =>
                      implies_congr
                        (congrFun'
                          (congrArg Membership.mem
                            (congrArg (HAppend.hAppend before)
                              (congrFun' (congrArg List.cons (congrArg (AspisR1.SdkC_Source.Query.mk parts) h)) [])))
                          q)
                        (Eq.refl (q.returned = hashv q.parts)))
                    next)))
            (Eq.symm h) (Eq.refl (hashv parts)))
        (fun e h =>
          Eq.ndrec (motive := fun x =>
            hashv parts = x →
              ∀ q ∈ (AspisR1.SdkC_Source.run hashv (AspisR1.CheckpointBytes5Effect.Code.read parts k) before).2,
                q.returned = hashv q.parts)
            (fun h =>
              Eq.mpr
                (id
                  (forall_congr fun q =>
                    implies_congr
                      (congrFun'
                        (congrArg Membership.mem
                          (congrArg Prod.snd
                            (Eq.trans (AspisR1.SdkC_Source.run.eq_5 hashv before parts k)
                              (Eq.trans
                                (congrArg
                                  (fun x =>
                                    match x with
                                    | Aeneas.Std.Result.ok digest =>
                                      AspisR1.SdkC_Source.run hashv (k digest)
                                        (before ++ [{ parts := parts, returned := hashv parts }])
                                    | Aeneas.Std.Result.fail e =>
                                      (Aeneas.Std.Result.fail e,
                                        before ++ [{ parts := parts, returned := hashv parts }])
                                    | Aeneas.Std.Result.div =>
                                      (Aeneas.Std.Result.div, before ++ [{ parts := parts, returned := hashv parts }]))
                                  h)
                                (congrArg (Prod.mk (Aeneas.Std.Result.fail e))
                                  (congrArg (HAppend.hAppend before)
                                    (congrFun' (congrArg List.cons (congrArg (AspisR1.SdkC_Source.Query.mk parts) h))
                                      [])))))))
                        q)
                      (Eq.refl (q.returned = hashv q.parts))))
                (Eq.mp
                  (forall_congr fun q =>
                    implies_congr
                      (congrFun'
                        (congrArg Membership.mem
                          (congrArg (HAppend.hAppend before)
                            (congrFun' (congrArg List.cons (congrArg (AspisR1.SdkC_Source.Query.mk parts) h)) [])))
                        q)
                      (Eq.refl (q.returned = hashv q.parts)))
                  next))
            (Eq.symm h) (Eq.refl (hashv parts)))
        (fun h =>
          Eq.ndrec (motive := fun x =>
            hashv parts = x →
              ∀ q ∈ (AspisR1.SdkC_Source.run hashv (AspisR1.CheckpointBytes5Effect.Code.read parts k) before).2,
                q.returned = hashv q.parts)
            (fun h =>
              Eq.mpr
                (id
                  (forall_congr fun q =>
                    implies_congr
                      (congrFun'
                        (congrArg Membership.mem
                          (congrArg Prod.snd
                            (Eq.trans (AspisR1.SdkC_Source.run.eq_5 hashv before parts k)
                              (Eq.trans
                                (congrArg
                                  (fun x =>
                                    match x with
                                    | Aeneas.Std.Result.ok digest =>
                                      AspisR1.SdkC_Source.run hashv (k digest)
                                        (before ++ [{ parts := parts, returned := hashv parts }])
                                    | Aeneas.Std.Result.fail e =>
                                      (Aeneas.Std.Result.fail e,
                                        before ++ [{ parts := parts, returned := hashv parts }])
                                    | Aeneas.Std.Result.div =>
                                      (Aeneas.Std.Result.div, before ++ [{ parts := parts, returned := hashv parts }]))
                                  h)
                                (congrArg (Prod.mk Aeneas.Std.Result.div)
                                  (congrArg (HAppend.hAppend before)
                                    (congrFun' (congrArg List.cons (congrArg (AspisR1.SdkC_Source.Query.mk parts) h))
                                      [])))))))
                        q)
                      (Eq.refl (q.returned = hashv q.parts))))
                (Eq.mp
                  (forall_congr fun q =>
                    implies_congr
                      (congrFun'
                        (congrArg Membership.mem
                          (congrArg (HAppend.hAppend before)
                            (congrFun' (congrArg List.cons (congrArg (AspisR1.SdkC_Source.Query.mk parts) h)) [])))
                        q)
                      (Eq.refl (q.returned = hashv q.parts)))
                  next))
            (Eq.symm h) (Eq.refl (hashv parts)))
        (Eq.refl (hashv parts)))
    code before initial
'AspisR1.SdkC_Source.associated' depends on axioms: [propext, Classical.choice, Quot.sound]
