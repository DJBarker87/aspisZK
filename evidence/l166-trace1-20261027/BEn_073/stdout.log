theorem AspisR1.SdkC_Source.prefix_preserved : ∀
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest) {A : Type}
  (code : AspisR1.SdkC_Source.Code A) (before : AspisR1.SdkC_Source.Log),
  ∃ suffix, (AspisR1.SdkC_Source.run hashv code before).2 = before ++ suffix :=
fun hashv {A} code before =>
  AspisR1.CheckpointBytes5Effect.Code.rec (motive := fun code =>
    ∀ (before : AspisR1.SdkC_Source.Log), ∃ suffix, (AspisR1.SdkC_Source.run hashv code before).2 = before ++ suffix)
    (fun a before =>
      Exists.intro []
        (Eq.symm
          (List.append_nil (AspisR1.SdkC_Source.run hashv (AspisR1.CheckpointBytes5Effect.Code.done a) before).2)))
    (fun {B} r k ih before =>
      Aeneas.Std.Result.casesOn (motive := fun t =>
        r = t →
          ∃ suffix,
            (AspisR1.SdkC_Source.run hashv (AspisR1.CheckpointBytes5Effect.Code.step r k) before).2 = before ++ suffix)
        r (fun a h => Eq.symm h ▸ ih a before)
        (fun e h =>
          Eq.symm h ▸
            Exists.intro []
              (Eq.symm
                (List.append_nil
                  (AspisR1.SdkC_Source.run hashv (AspisR1.CheckpointBytes5Effect.Code.step (Aeneas.Std.Result.fail e) k)
                      before).2)))
        (fun h =>
          Eq.symm h ▸
            Exists.intro []
              (Eq.symm
                (List.append_nil
                  (AspisR1.SdkC_Source.run hashv (AspisR1.CheckpointBytes5Effect.Code.step Aeneas.Std.Result.div k)
                      before).2)))
        (Eq.refl r))
    (fun parts k ih before =>
      Aeneas.Std.Result.casesOn (motive := fun t =>
        hashv parts = t →
          ∃ suffix,
            (AspisR1.SdkC_Source.run hashv (AspisR1.CheckpointBytes5Effect.Code.read parts k) before).2 =
              before ++ suffix)
        (hashv parts)
        (fun digest h =>
          Eq.ndrec (motive := fun x =>
            hashv parts = x →
              ∃ suffix,
                (AspisR1.SdkC_Source.run hashv (AspisR1.CheckpointBytes5Effect.Code.read parts k) before).2 =
                  before ++ suffix)
            (fun h =>
              let ⟨suffix, eq⟩ := ih digest (before ++ [{ parts := parts, returned := Aeneas.Std.Result.ok digest }])
              Exists.intro ({ parts := parts, returned := Aeneas.Std.Result.ok digest } :: suffix)
                (Eq.mpr
                  (id
                    (congrFun'
                      (congrArg Eq
                        (congrArg Prod.snd
                          (Eq.trans (AspisR1.SdkC_Source.run.eq_5 hashv before parts k)
                            (Eq.trans
                              (congrArg
                                (fun x =>
                                  match x with
                                  | Aeneas.Std.Result.ok digest =>
                                    AspisR1.SdkC_Source.run hashv (k digest)
                                      (before ++ [{ parts := parts, returned := hashv parts }])
                                  | Aeneas.Std.Result.fail e =>
                                    (Aeneas.Std.Result.fail e, before ++ [{ parts := parts, returned := hashv parts }])
                                  | Aeneas.Std.Result.div =>
                                    (Aeneas.Std.Result.div, before ++ [{ parts := parts, returned := hashv parts }]))
                                h)
                              (congrArg (AspisR1.SdkC_Source.run hashv (k digest))
                                (congrArg (HAppend.hAppend before)
                                  (congrFun' (congrArg List.cons (congrArg (AspisR1.SdkC_Source.Query.mk parts) h))
                                    [])))))))
                      (before ++ { parts := parts, returned := Aeneas.Std.Result.ok digest } :: suffix)))
                  (Eq.mp
                    (congrArg
                      (Eq
                        (AspisR1.SdkC_Source.run hashv (k digest)
                            (before ++ [{ parts := parts, returned := Aeneas.Std.Result.ok digest }])).2)
                      (List.append_assoc before [{ parts := parts, returned := Aeneas.Std.Result.ok digest }] suffix))
                    eq)))
            (Eq.symm h) (Eq.refl (hashv parts)))
        (fun e h =>
          Eq.ndrec (motive := fun x =>
            hashv parts = x →
              ∃ suffix,
                (AspisR1.SdkC_Source.run hashv (AspisR1.CheckpointBytes5Effect.Code.read parts k) before).2 =
                  before ++ suffix)
            (fun h =>
              Exists.intro [{ parts := parts, returned := Aeneas.Std.Result.fail e }]
                (of_eq_true
                  (Eq.trans
                    (congrFun'
                      (congrArg Eq
                        (congrArg Prod.snd
                          (Eq.trans (AspisR1.SdkC_Source.run.eq_5 hashv before parts k)
                            (Eq.trans
                              (congrArg
                                (fun x =>
                                  match x with
                                  | Aeneas.Std.Result.ok digest =>
                                    AspisR1.SdkC_Source.run hashv (k digest)
                                      (before ++ [{ parts := parts, returned := hashv parts }])
                                  | Aeneas.Std.Result.fail e =>
                                    (Aeneas.Std.Result.fail e, before ++ [{ parts := parts, returned := hashv parts }])
                                  | Aeneas.Std.Result.div =>
                                    (Aeneas.Std.Result.div, before ++ [{ parts := parts, returned := hashv parts }]))
                                h)
                              (congrArg (Prod.mk (Aeneas.Std.Result.fail e))
                                (congrArg (HAppend.hAppend before)
                                  (congrFun' (congrArg List.cons (congrArg (AspisR1.SdkC_Source.Query.mk parts) h))
                                    [])))))))
                      (before ++ [{ parts := parts, returned := Aeneas.Std.Result.fail e }]))
                    (eq_self (before ++ [{ parts := parts, returned := Aeneas.Std.Result.fail e }])))))
            (Eq.symm h) (Eq.refl (hashv parts)))
        (fun h =>
          Eq.ndrec (motive := fun x =>
            hashv parts = x →
              ∃ suffix,
                (AspisR1.SdkC_Source.run hashv (AspisR1.CheckpointBytes5Effect.Code.read parts k) before).2 =
                  before ++ suffix)
            (fun h =>
              Exists.intro [{ parts := parts, returned := Aeneas.Std.Result.div }]
                (of_eq_true
                  (Eq.trans
                    (congrFun'
                      (congrArg Eq
                        (congrArg Prod.snd
                          (Eq.trans (AspisR1.SdkC_Source.run.eq_5 hashv before parts k)
                            (Eq.trans
                              (congrArg
                                (fun x =>
                                  match x with
                                  | Aeneas.Std.Result.ok digest =>
                                    AspisR1.SdkC_Source.run hashv (k digest)
                                      (before ++ [{ parts := parts, returned := hashv parts }])
                                  | Aeneas.Std.Result.fail e =>
                                    (Aeneas.Std.Result.fail e, before ++ [{ parts := parts, returned := hashv parts }])
                                  | Aeneas.Std.Result.div =>
                                    (Aeneas.Std.Result.div, before ++ [{ parts := parts, returned := hashv parts }]))
                                h)
                              (congrArg (Prod.mk Aeneas.Std.Result.div)
                                (congrArg (HAppend.hAppend before)
                                  (congrFun' (congrArg List.cons (congrArg (AspisR1.SdkC_Source.Query.mk parts) h))
                                    [])))))))
                      (before ++ [{ parts := parts, returned := Aeneas.Std.Result.div }]))
                    (eq_self (before ++ [{ parts := parts, returned := Aeneas.Std.Result.div }])))))
            (Eq.symm h) (Eq.refl (hashv parts)))
        (Eq.refl (hashv parts)))
    code before
'AspisR1.SdkC_Source.prefix_preserved' depends on axioms: [propext, Classical.choice, Quot.sound]
