theorem AspisR1.S2W_DigestExtraction.native_oracle : ∀ (ops : AdapterRw.Ops)
  (native1 : AspisR1.S2W_ExtractionBoundary.First) (native2 : AspisR1.S2W_ExtractionBoundary.Second)
  (hashv : AspisR1.S2W_DigestExtraction.Parts → Aeneas.Std.Result AspisR1.S2W_DigestExtraction.Digest),
  AspisR1.S2W_DigestExtraction.AeneasExtraction ops native1 native2 hashv →
    ∀ (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      AspisR1.S2W_ExtractionBoundary.P1 sha256 H →
        AspisR1.S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
          AspisR1.CheckpointBytes5Inputs.Oracle (AspisR1.S2Z.Oracle.leadDigest ops) () H :=
fun ops native1 native2 hashv extraction sha256 H p1 runtime =>
  AspisR1.S2W_ExtractionBoundary.native_oracle ops native1 native2 hashv
    (AspisR1.S2W_DigestExtraction.sourceBoundary ops native1 native2 hashv extraction) sha256 H p1 runtime
'AspisR1.S2W_DigestExtraction.native_oracle' depends on axioms: [propext, Classical.choice, Quot.sound]
