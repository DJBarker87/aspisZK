theorem AspisR1.BEl_CodeCongr.bind_run : ∀ {S A B : Type}
  (call : AspisR1.SdkC_Source.Parts → S → Aeneas.Std.Result AspisR1.SdkC_Source.Digest × S)
  (code : AspisR1.SdkC_Source.Code A) (k : A → AspisR1.SdkC_Source.Code B) (state : S)
  (before : AspisR1.SdkC_Source.Log),
  AspisR1.BEl_CodeCongr.observe (AspisR1.BEf_Carrier.run call (code >>= k) state before) =
    AspisR1.BEl_CodeCongr.resumeRun call k
      (AspisR1.BEl_CodeCongr.observe (AspisR1.BEf_Carrier.run call code state before)) :=
fun {S A B} call code k state before =>
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          AspisR1.BEl_CodeCongr.observe _a =
            AspisR1.BEl_CodeCongr.resumeRun call k
              (AspisR1.BEl_CodeCongr.observe (AspisR1.BEf_Carrier.run call code state before)))
        (AspisR1.BEf_Bind.run call code k state before)))
    (let ⟨result, snd✝⟩ := AspisR1.BEf_Carrier.run call code state before
    let ⟨state, history⟩ := snd✝
    Aeneas.Std.Result.casesOn (motive := fun t =>
      result = t →
        AspisR1.BEl_CodeCongr.observe (AspisR1.BEf_Bind.continueRun call k (result, state, history)) =
          AspisR1.BEl_CodeCongr.resumeRun call k (AspisR1.BEl_CodeCongr.observe (result, state, history)))
      result
      (fun v h =>
        Eq.symm h ▸
          Eq.refl
            (AspisR1.BEl_CodeCongr.observe
              (AspisR1.BEf_Bind.continueRun call k (Aeneas.Std.Result.ok v, state, history))))
      (fun e h =>
        Eq.symm h ▸
          Eq.refl
            (AspisR1.BEl_CodeCongr.observe
              (AspisR1.BEf_Bind.continueRun call k (Aeneas.Std.Result.fail e, state, history))))
      (fun h =>
        Eq.symm h ▸
          Eq.refl
            (AspisR1.BEl_CodeCongr.observe
              (AspisR1.BEf_Bind.continueRun call k (Aeneas.Std.Result.div, state, history))))
      (Eq.refl result))
'AspisR1.BEl_CodeCongr.bind_run' depends on axioms: [propext, Classical.choice, Quot.sound]
