theorem AspisR1.RPx_Transport.transport : ∀ {F C : Type} (base : AspisR1.DrvC_Installation.Configuration F C)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (D : AspisR1.LiteralByteProtocol.Decoder) (w : AspisR1.CanonicalCutEnrichedTranscript.Words)
  (P : AspisR1.F3T_ByteCarrier.ByteProver) (Q : ℕ),
  (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      (AspisV8R19.MemoizedProgramLaw.eval H P).1.length ≤ Q) →
    AspisR1.RPx_Transport.Claims (AspisR1.F3V_Install.configuration base) hashv P Q :=
fun {F C} base hashv D w P Q queries H =>
  ⟨AspisR1.RPx_Prefix.occurrences (AspisR1.F3V_Install.configuration base) hashv P H,
    ⟨AspisR1.RPx_Accounting.exact base hashv D w P H,
      ⟨AspisR1.RPx_Accounting.attempted (AspisR1.F3V_Install.configuration base) hashv P Q queries H,
        AspisR1.RPx_Rejected.adaptive (AspisR1.F3V_Install.configuration base) hashv P H⟩⟩⟩
'AspisR1.RPx_Transport.transport' depends on axioms: [propext, Classical.choice, Quot.sound]
