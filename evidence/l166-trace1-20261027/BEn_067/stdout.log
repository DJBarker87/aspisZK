theorem AspisR1.BEj_SlotExport.stage : ∀ {S E : Type}
  (call : AspisR1.SdkC_Source.Parts → S → Aeneas.Std.Result AspisR1.SdkC_Source.Digest × S)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest),
  (∀ (parts : AspisR1.SdkC_Source.Parts) (state : S), (call parts state).1 = hashv parts) →
    ∀ (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      AspisR1.S2W_ExtractionBoundary.P1 sha256 H →
        AspisR1.S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
          ∀ (proof : Aeneas.Std.Slice Aeneas.Std.U8) (p : VTop_Stages.verifier.Prepared)
            (root : AspisR1.SdkC_Source.Digest) (state : S) (before : AspisR1.SdkC_Source.Log)
            (native : AspisR1.BEh_Scope.Outcome S Unit E),
            AspisR1.BEh_Scope.Law native
                (AspisR1.BEf_Carrier.run call (AspisR1.SdkC_BatchSource.stageCode hashv proof p root) state before) →
              AspisR1.BEj_SlotExport.Prefix hashv H (AspisR1.SdkC_BatchSource.stageCode hashv proof p root) before
                native.2.2 :=
fun {S E} call hashv binding sha256 H p1 syscall proof p root state before native law =>
  AspisR1.BEj_LocalExport.attempted call hashv binding sha256 H p1 syscall
    (AspisR1.SdkC_BatchSource.stageCode hashv proof p root) 900 (AspisR1.GExq_BatchBudget.stage hashv proof p root)
    state before native law
'AspisR1.BEj_SlotExport.stage' depends on axioms: [propext, Classical.choice, Quot.sound]
