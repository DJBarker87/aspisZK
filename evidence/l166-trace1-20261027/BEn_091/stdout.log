theorem AspisR1.ARX_AdmittedRuntime.on_admitted : ∀ {W A C Tx : Type}
  (L : AspisR1.S2Trust.Library W (ℕ → AspisR1.S2W_D189Entry.Record))
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A)
  (c : AspisR1.DrvC_Installation.Configuration AspisR1.FIo_Install.W C) (err : C) (r : AspisR1.NP6_StdModel.Reservation)
  (native1 : AspisR1.S2W_ExtractionBoundary.First) (native2 : AspisR1.S2W_ExtractionBoundary.Second)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (a : AspisR1.SCE_Experiment.Adversary A),
  AspisR1.S2W_DigestExtraction.AeneasExtraction
      (AspisR1.DrvC_Installation.sdk (AspisR1.FIp_Install.configuration err c r)) native1 native2 hashv →
    ∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
      (n : AspisR1.ARU_Support.At L copy allocator c err r native1 native2 hashv a H),
      AspisV8R19.MemoizedProgramLaw.eval H
          (AspisR1.ARX_AdmittedRuntime.runtime L copy allocator c err r native1 native2 hashv a) =
        AspisV8R19.MemoizedProgramLaw.eval H
          (AspisR1.ART_Runtime.runtime (AspisR1.FIp_Install.configuration err c r) hashv copy allocator
            AspisR1.CPH_Program.verifier a) :=
fun {W A C Tx} L copy allocator c err r native1 native2 hashv a extraction H n =>
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          _a =
            AspisV8R19.MemoizedProgramLaw.eval H
              (AspisR1.ART_Runtime.runtime (AspisR1.FIp_Install.configuration err c r) hashv copy allocator
                AspisR1.CPH_Program.verifier a))
        (AspisR1.ARX_AdmittedRuntime.evaluation L copy allocator c err r native1 native2 hashv a extraction H)))
    (Eq.mpr
      (id
        (congrArg
          (fun _a =>
            (have v :=
                AspisV8R19.MemoizedProgramLaw.eval H
                  (AspisR1.ART_PartialAccount.account (AspisR1.FIp_Install.configuration err c r) hashv copy allocator
                    AspisR1.CPH_Program.verifier a);
              (v.1, _a)) =
              AspisV8R19.MemoizedProgramLaw.eval H
                (AspisR1.ART_Runtime.runtime (AspisR1.FIp_Install.configuration err c r) hashv copy allocator
                  AspisR1.CPH_Program.verifier a))
          (if_pos (Nonempty.intro n))))
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              (have v :=
                  AspisV8R19.MemoizedProgramLaw.eval H
                    (AspisR1.ART_PartialAccount.account (AspisR1.FIp_Install.configuration err c r) hashv copy allocator
                      AspisR1.CPH_Program.verifier a);
                (v.1, _a.2)) =
                _a)
            (AspisR1.ART_Runtime.eval_runtime (AspisR1.FIp_Install.configuration err c r) hashv copy allocator
              AspisR1.CPH_Program.verifier a H)))
        (Eq.refl
          (have v :=
            AspisV8R19.MemoizedProgramLaw.eval H
              (AspisR1.ART_PartialAccount.account (AspisR1.FIp_Install.configuration err c r) hashv copy allocator
                AspisR1.CPH_Program.verifier a);
          (v.1,
            (have v :=
                AspisV8R19.MemoizedProgramLaw.eval H
                  (AspisR1.ART_PartialAccount.account (AspisR1.FIp_Install.configuration err c r) hashv copy allocator
                    AspisR1.CPH_Program.verifier a);
              (v.1,
                Option.some
                  (v.1,
                    AspisR1.F3T_Canon.canonInput
                      (AspisR1.F3T_ByteCarrier.input (AspisR1.FIp_Install.configuration err c r)
                        (AspisR1.SCE_Experiment.submitted v.2.1)),
                    AspisR1.SCE_Experiment.accepted v.2))).2)))))
'AspisR1.ARX_AdmittedRuntime.on_admitted' depends on axioms: [propext, Classical.choice, Quot.sound]
