theorem AspisR1.SdkC_Source.installed_digest : ∀ (ops : AdapterRw.Ops) (native1 : AspisR1.S2W_ExtractionBoundary.First)
  (native2 : AspisR1.S2W_ExtractionBoundary.Second)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest),
  AspisR1.S2W_DigestExtraction.AeneasExtraction ops native1 native2 hashv →
    ∀ (self : AdapterRw.SolanaDigest) (parts : AspisR1.SdkC_Source.Parts),
      (AspisR1.SdkC_Source.run hashv (AspisR1.SdkC_Source.digestCode parts) []).1 = ops.op43 self parts :=
fun ops native1 native2 hashv extraction self parts =>
  Eq.trans (AspisR1.SdkC_Source.digest_erasure hashv self parts) (Eq.symm (extraction.digestSource self parts))
'AspisR1.SdkC_Source.installed_digest' depends on axioms: [propext, Classical.choice, Quot.sound]
