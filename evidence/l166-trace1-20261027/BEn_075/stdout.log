theorem AspisR1.SdkC_Source.consistent : ∀
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  AspisR1.S2W_ExtractionBoundary.P1 sha256 H →
    AspisR1.S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
      ∀ {A : Type} (code : AspisR1.SdkC_Source.Code A),
        ∀ q ∈ AspisR1.SdkC_Source.readLog (AspisR1.SdkC_Source.run hashv code []).2, q.2 = H q.1 :=
fun hashv sha256 H p1 syscall {A} code q member =>
  let ⟨attempt, h✝⟩ := List.mem_filterMap.mp member
  let ⟨belongs, emitted⟩ := h✝
  have actual :=
    AspisR1.SdkC_Source.associated hashv code []
      (of_eq_true
        (Eq.trans
          (forall_congr fun q =>
            Eq.trans (implies_congr List.not_mem_nil._simp_1 (Eq.refl (q.returned = hashv q.parts)))
              IsEmpty.forall_iff._simp_1)
          (implies_true AspisR1.SdkC_Source.Query)))
      attempt belongs;
  Aeneas.Std.Result.casesOn (motive := fun t => attempt.returned = t → q.2 = H q.1) attempt.returned
    (fun digest h =>
      Eq.ndrec (motive := fun x => attempt.returned = x → q.2 = H q.1)
        (fun returned =>
          Eq.ndrec (motive := fun q =>
            q ∈ AspisR1.SdkC_Source.readLog (AspisR1.SdkC_Source.run hashv code []).2 → q.2 = H q.1)
            (fun member =>
              Eq.trans (syscall.returningValue attempt.parts digest (Eq.symm (Eq.trans (Eq.symm returned) actual)))
                (p1.realization (AspisV8R19.SqueezeOracleBridge.flatten attempt.parts)))
            (Eq.mp
              (Eq.trans
                (congrFun'
                  (congrArg Eq
                    (congrArg
                      (fun x =>
                        match x with
                        | Aeneas.Std.Result.ok digest =>
                          Option.some
                            (AspisV8R19.SqueezeOracleBridge.flatten attempt.parts,
                              AspisV8R19.SqueezeOracleBridge.decodeState digest)
                        | x => Option.none)
                      returned))
                  (Option.some q))
                (Option.some.injEq
                  (AspisV8R19.SqueezeOracleBridge.flatten attempt.parts,
                    AspisV8R19.SqueezeOracleBridge.decodeState digest)
                  q))
              emitted)
            member)
        (Eq.symm h) (Eq.refl attempt.returned))
    (fun e h =>
      Eq.ndrec (motive := fun x => attempt.returned = x → q.2 = H q.1)
        (fun returned =>
          False.elim
            (Eq.mp
              (Eq.trans
                (congrFun'
                  (congrArg Eq
                    (congrArg
                      (fun x =>
                        match x with
                        | Aeneas.Std.Result.ok digest =>
                          Option.some
                            (AspisV8R19.SqueezeOracleBridge.flatten attempt.parts,
                              AspisV8R19.SqueezeOracleBridge.decodeState digest)
                        | x => Option.none)
                      returned))
                  (Option.some q))
                (eq_false' fun h => False.elim (noConfusion_of_Nat Option.ctorIdx h)))
              emitted))
        (Eq.symm h) (Eq.refl attempt.returned))
    (fun h =>
      Eq.ndrec (motive := fun x => attempt.returned = x → q.2 = H q.1)
        (fun returned =>
          False.elim
            (Eq.mp
              (Eq.trans
                (congrFun'
                  (congrArg Eq
                    (congrArg
                      (fun x =>
                        match x with
                        | Aeneas.Std.Result.ok digest =>
                          Option.some
                            (AspisV8R19.SqueezeOracleBridge.flatten attempt.parts,
                              AspisV8R19.SqueezeOracleBridge.decodeState digest)
                        | x => Option.none)
                      returned))
                  (Option.some q))
                (eq_false' fun h => False.elim (noConfusion_of_Nat Option.ctorIdx h)))
              emitted))
        (Eq.symm h) (Eq.refl attempt.returned))
    (Eq.refl attempt.returned)
'AspisR1.SdkC_Source.consistent' depends on axioms: [propext, Classical.choice, Quot.sound]
