theorem AspisR1.JHi_EmissionAssociation.source : ∀ {C : Type}
  (c : AspisR1.DrvC_Installation.Configuration AspisR1.FIo_Install.W C) (err : C),
  (AspisR1.DrvC_Installation.sdk (AspisR1.JHi_Configuration.value c err)).op53 = AspisR1.JHb_EmitAdapter.source :=
fun {C} c err =>
  let ⟨adapter✝, currentBase✝, stageBase✝, finish✝, reserved✝, query✝, geometry✝, boundaries✝, std✝, h✝⟩ := c
  Eq.symm h✝ ▸
    Eq.refl
      (AspisR1.DrvC_Installation.sdk
          (AspisR1.JHi_Configuration.value
            { adapter := adapter✝, currentBase := currentBase✝, stageBase := stageBase✝, finish := finish✝,
              reserved := reserved✝, query := query✝, geometry := geometry✝, boundaries := boundaries✝, std := std✝ }
            err)).op53
'AspisR1.JHi_EmissionAssociation.source' depends on axioms: [propext, Classical.choice, Quot.sound]
def AspisR1.JHb_Emit.source : {A E : Type} →
  (AspisR1.S2I.ReturnData.State A E → List Aeneas.Std.U8 → Aeneas.Std.Result (AspisR1.S2I.ReturnData.State A E)) →
    AspisR1.S2I.ReturnData.State A E →
      AspisR1.S2K.StatementAdmission.Statement →
        Aeneas.Std.Result
          (Aeneas.Std.core.result.Result (AspisR1.S2I.ReturnData.State A E)
            AdapterRw.solana_program_error.ProgramError) :=
fun {A E} syscall state statement =>
  have result := AspisR1.S2K.ResultAdmission.value statement;
  do
  let validated ←
    AspisR1TerminalDecoder.pool_v1.pair_forest_terminal.validate_pool_v1_pair_forest_terminal_result_against_statement_v1
        statement result
  match validated with
    | Aeneas.Std.core.result.Result.Err a =>
      Aeneas.Std.Result.ok
        (Aeneas.Std.core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidInstructionData)
    | Aeneas.Std.core.result.Result.Ok PUnit.unit => do
      let encoded ←
        AspisR1TerminalDecoder.pool_v1.pair_forest_terminal.encode_pool_v1_pair_forest_terminal_result_v1 result
      match encoded with
        | Aeneas.Std.core.result.Result.Err a =>
          Aeneas.Std.Result.ok
            (Aeneas.Std.core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidInstructionData)
        | Aeneas.Std.core.result.Result.Ok bytes =>
          if (↑bytes).length ≠ 792 then
            Aeneas.Std.Result.ok
              (Aeneas.Std.core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidInstructionData)
          else
            if List.take 4 ↑bytes ≠ [65#u8, 83#u8, 82#u8, 56#u8] then
              Aeneas.Std.Result.ok
                (Aeneas.Std.core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidInstructionData)
            else do
              let state' ← syscall state ↑bytes
              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok state')
'AspisR1.JHb_Emit.real' depends on axioms: [propext, Classical.choice, Quot.sound]
