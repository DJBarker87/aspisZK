  [inst : MeasurableSpace R] (μR : PV_MEAS_Law.ProbabilityMeasure R)
  (completion :
    PV_EVH_Interface.Completion Public Signal Env
      (R0Z.FsStatement.ROMView R1Z.PrivacyR1AcctBasis.K CommitHandle Aux R1Z.Batched.R1Bat) A)
  (pubData : Public) (env : Env)
  (native :
    Env →
      PV_MEAS_Core.Observer Signal A →
        (R1Z.PhaseWireLog2Bin.honest PV_MEAS_Core.input).Instance → R → PV_RJ4IDB.NativeTrace A)
  (nativeSignal :
    Env → PV_MEAS_Core.Observer Signal A → (R1Z.PhaseWireLog2Bin.honest PV_MEAS_Core.input).Instance → R → Signal)
  (links :
    (adv : PV_MEAS_Core.Observer Signal A) →
      (w : (R1Z.PhaseWireLog2Bin.honest PV_MEAS_Core.input).Instance) →
        (R1Z.PhaseWireLog2Bin.honest PV_MEAS_Core.input).public w = x.1 →
          PV_MEAS_Core.Links template outputs x μR completion pubData env native nativeSignal adv w),
  (∀ (adv : PV_MEAS_Core.Observer Signal A) (w : (R1Z.PhaseWireLog2Bin.honest PV_MEAS_Core.input).Instance),
      (Measurable fun r => ↑(R0Z.FsStatement.bit (adv.decide (PV_MEAS_Core.real env native nativeSignal adv w r)))) →
        (R1Z.PhaseWireLog2Bin.honest PV_MEAS_Core.input).public w = x.1 →
          |∫ₚ (r : R), ↑(R0Z.FsStatement.bit (adv.decide (PV_MEAS_Core.real env native nativeSignal adv w r))) ∂↑μR -
                ∫ₚ (r :
                  (R1Z.ProverCommitReencode16.experiment
                      (R1Z.PhaseProtocolInstanceBin.wire (R1Z.PrivacyR1AcctModel.base template R1Z.PhaseWireLog2Bin.log)
                          ((R1Z.PrivacyR1AcctModel.base template R1Z.PhaseWireLog2Bin.log).pubBytes x).length
