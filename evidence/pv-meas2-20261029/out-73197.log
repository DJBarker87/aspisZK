                          (R1Z.PhaseWireLog2Bin.honest PV_MEAS_Core.input) R1Z.PrivacyR1AcctBasis.basis outputs x
                          (R1Z.PrivacyR1AcctModel.seed
                            (R1Z.PhaseProtocolInstanceBin.wire
                                (R1Z.PrivacyR1AcctModel.base template R1Z.PhaseWireLog2Bin.log)
                                ((R1Z.PrivacyR1AcctModel.base template R1Z.PhaseWireLog2Bin.log).pubBytes x).length
                                (R1Z.PhaseWireLog2Bin.honest PV_MEAS_Core.input) R1Z.PrivacyR1AcctBasis.basis outputs
                                x).toWire
                            PV_MEAS_Core.ownedDecode R1Z.PhaseWireLog2Bin.fib R1Z.PhaseWireLog2Bin.opens)).toProver
                      8 R1Z.PrivacyR1HeadlineWire2.eight_pos
                      (R1Z.PredicateR1.P_R1 (R1Z.PhaseWireLog2Bin.honest PV_MEAS_Core.input).transport
                        R1Z.PrivacyR1AcctBasis.basis R1Z.PrivacyR1AcctBasis.packing_laws)
                      (fun h' => R1Z.MaskImageVR1.VR1 h') R1Z.ProverCommitReencode16.encode).IdealRand),
                  ↑(R0Z.FsStatement.bit
                      (adv.decide
                        (PV_MEAS_Core.ideal template outputs x completion pubData env adv
                          r))) ∂↑(PV_MEAS_Uniform.uniform
                      (R1Z.ProverCommitReencode16.experiment
                          (R1Z.PhaseProtocolInstanceBin.wire
                              (R1Z.PrivacyR1AcctModel.base template R1Z.PhaseWireLog2Bin.log)
                              ((R1Z.PrivacyR1AcctModel.base template R1Z.PhaseWireLog2Bin.log).pubBytes x).length
