theorem PV_MEAS_Average.expectation_eq_of_equal_laws.{u_1, u_2, u_3} : ∀ {X : Type u_1} {Y : Type u_2} {Z : Type u_3}
  [inst : MeasurableSpace X] [inst_1 : MeasurableSpace Y] [inst_2 : MeasurableSpace Z] (μ : MeasureTheory.Measure X)
  (ν : MeasureTheory.Measure Y) (f : X → Z) (g : Y → Z),
  Measurable f →
    Measurable g →
      MeasureTheory.Measure.map f μ = MeasureTheory.Measure.map g ν →
        ∀ (test : Z → ℝ), Measurable test → ∫ₚ (x : X), test (f x) ∂μ = ∫ₚ (y : Y), test (g y) ∂ν :=
fun {X} {Y} {Z} [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace Z] μ ν f g hf hg law test htest =>
  id
    (Eq.mpr
      (id
        (congrArg (fun _a => _a.toReal = (∫⁻ (e : Y), ENNReal.ofReal ((fun y => test (g y)) e) ∂ν).toReal)
          (Eq.symm (MeasureTheory.lintegral_map (Measurable.ennreal_ofReal htest) hf))))
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              (∫⁻ (a : Z), ENNReal.ofReal (test a) ∂_a).toReal =
                (∫⁻ (e : Y), ENNReal.ofReal ((fun y => test (g y)) e) ∂ν).toReal)
            law))
        (Eq.mpr
          (id
            (congrArg (fun _a => _a.toReal = (∫⁻ (e : Y), ENNReal.ofReal ((fun y => test (g y)) e) ∂ν).toReal)
              (MeasureTheory.lintegral_map (Measurable.ennreal_ofReal htest) hg)))
          (Eq.refl (∫⁻ (a : Y), ENNReal.ofReal (test (g a)) ∂ν).toReal))))
