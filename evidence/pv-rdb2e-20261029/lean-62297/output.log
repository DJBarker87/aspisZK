theorem R1Z.PV_RDB2E_ShaHandles.callback_run : ∀
  (compress : R1Z.PV_RDB2E_ShaHandles.State → List Aeneas.Std.U8 → Aeneas.Std.Result R1Z.PV_RDB2E_ShaHandles.State)
  (blocks : List (List Aeneas.Std.U8)) (current : R1Z.PV_RDB2E_ShaHandles.Frame),
  R1Z.PV_RDB2E_ShaHandles.callbackRun compress blocks current = do
    let s ← R1Z.PV_DL_CompressionTrace.run compress blocks current.core.state
    Aeneas.Std.Result.ok (R1Z.PV_RDB2E_ShaHandles.putState current s) :=
fun compress blocks current =>
  List.rec (motive := fun blocks =>
    ∀ (current : R1Z.PV_RDB2E_ShaHandles.Frame),
      R1Z.PV_RDB2E_ShaHandles.callbackRun compress blocks current = do
        let s ← R1Z.PV_DL_CompressionTrace.run compress blocks current.core.state
        Aeneas.Std.Result.ok (R1Z.PV_RDB2E_ShaHandles.putState current s))
    (fun current => Eq.refl (R1Z.PV_RDB2E_ShaHandles.callbackRun compress [] current))
    (fun block tail ih current =>
      Eq.mpr
        (id
          (congr
            (congrArg Eq
              (Eq.trans
                (Aeneas.Std.bind_assoc_eq (compress current.core.state block)
                  (fun s => Aeneas.Std.Result.ok (R1Z.PV_RDB2E_ShaHandles.putState current s)) fun after =>
                  R1Z.PV_RDB2E_ShaHandles.callbackRun compress tail after)
                (congrArg (bind (compress current.core.state block))
                  (funext fun x =>
                    Aeneas.Std.bind_tc_ok (R1Z.PV_RDB2E_ShaHandles.putState current x)
                      (R1Z.PV_RDB2E_ShaHandles.callbackRun compress tail)))))
            (Aeneas.Std.bind_assoc_eq (compress current.core.state block)
              (fun next => R1Z.PV_DL_CompressionTrace.run compress tail next) fun s =>
              Aeneas.Std.Result.ok (R1Z.PV_RDB2E_ShaHandles.putState current s))))
        ((Aeneas.Std.bind_eq_iff (compress current.core.state block)
              (fun x => R1Z.PV_RDB2E_ShaHandles.callbackRun compress tail (R1Z.PV_RDB2E_ShaHandles.putState current x))
              fun x => do
              let s ← R1Z.PV_DL_CompressionTrace.run compress tail x
              Aeneas.Std.Result.ok (R1Z.PV_RDB2E_ShaHandles.putState current s)).mpr
          fun s hs =>
          Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  _a = do
                    let s ← R1Z.PV_DL_CompressionTrace.run compress tail s
                    Aeneas.Std.Result.ok (R1Z.PV_RDB2E_ShaHandles.putState current s))
                (ih (R1Z.PV_RDB2E_ShaHandles.putState current s))))
            (Eq.refl do
              let s_1 ←
                R1Z.PV_DL_CompressionTrace.run compress tail (R1Z.PV_RDB2E_ShaHandles.putState current s).core.state
              Aeneas.Std.Result.ok
                  (R1Z.PV_RDB2E_ShaHandles.putState (R1Z.PV_RDB2E_ShaHandles.putState current s) s_1))))
    blocks current
