def AspisR1.MultiproofConeP6Callbacks.ParentGate : (AspisR1.MultiproofConePhysicalProgram.Address →
    AspisR1.MultiproofConePhysicalProgram.Digest) →
  AspisR1.MultiproofConeP6Callbacks.Parent → Prop :=
fun H callback =>
  ∀ (left right : AspisR1.MultiproofConePhysicalProgram.Digest),
    AspisV8R19.MemoizedProgramLaw.eval H (callback left right) =
      ([(AspisR1.MultiproofConePhysicalDigest.parts left right,
            H (AspisR1.MultiproofConePhysicalDigest.parts left right))],
        H (AspisR1.MultiproofConePhysicalDigest.parts left right))
def AspisR1.MultiproofConeP6Batch.LeafGate : (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
  AspisR1.MultiproofConeP6Batch.Leaf → Prop :=
fun H source =>
  ∀ (p : AspisR1.OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144) (kind pos : ℕ)
    (s : MultiproofConeRef.reference.Scratch),
    ↑s.n < 16 →
      AspisV8R19.MemoizedProgramLaw.eval H (source p q kind pos s) =
        AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.MultiproofConeP6Batch.referenceLeaf p q kind pos s)
