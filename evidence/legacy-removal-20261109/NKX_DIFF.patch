-#[inline(never)]
-fn apply_authorized_append_after_checked_state_v1<F>(
-    program_id: &Pubkey,
-    pool_account: &AccountInfo,
-    current_page_account: &AccountInfo,
-    supplied_next_page: Option<&AccountInfo>,
-    source: AuthorizedSourceStateV1<'_>,
