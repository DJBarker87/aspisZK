-    let second = plan.receipt.second.map(|receipt| receipt.root);
-    if roots_in_current == 0 {
-        next_roots[0] = first;
-        if let Some(root) = second {
-            next_roots[1] = root;
-        }
-    } else {
-        current_roots[0] = first;
-        if roots_in_current == 2 {
