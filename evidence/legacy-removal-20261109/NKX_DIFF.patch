-fn append_roots(receipt: &AuthorizedAppendReceiptV1) -> Result<[Digest; 2], ProgramError> {
-    let mut roots = [receipt.first.root; 2];
-    if let Some(second) = receipt.second {
-        roots[1] = second.root;
-    }
-    Ok(roots)
-}
