'AspisR1.JFv_Inputs.inhabited' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.Rc7_Top.deployed : ∀ {W A F CoreError Tx : Type} (L : S2Trust.Library W (ℕ → S2W_D189Entry.Record)),
  S2Trust.S2TrustedSdkBorrow L →
    ∀
      (copy :
        S2Trust.Heap (ℕ → S2W_D189Entry.Record) →
          ℕ → S2Trust.Payload → S2W_TrustedStd.Outcome (ℕ → S2W_D189Entry.Record)),
      S2W_TrustedStd.TrustedStd copy →
        ∀ (allocator : S2W_D189Wrappers.Allocator A) (e1 e2 : S2W_D189Entry.Entry) (w1 w2 : W),
          S2W_D189Consolidation.RuntimeEntrypointAdmission L e1 w1 3 →
            S2W_D189Consolidation.RuntimeEntrypointAdmission L e2 w2 7 →
              ∀ (c : DrvC_Installation.Configuration F CoreError) (indexError : CoreError)
                (reservation : NP6_StdModel.Reservation) (native1 : S2W_ExtractionBoundary.First)
                (native2 : S2W_ExtractionBoundary.Second) (hashv : S2Z.Oracle.Parts → Result S2Z.Oracle.Digest),
                S2W_DigestExtraction.AeneasExtraction
                    (DrvC_Installation.sdk (Rc5_Install.configuration indexError c reservation)) native1 native2 hashv →
                  ∀ (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
                    S2W_ExtractionBoundary.P1 sha256 H →
                      S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
                        ∀ (data1 data2 : Slice U8) (slot : S2W_ExtractionBoundary.Slot)
                          (state1 state2 final1 final2 : A) (saved : alloc.vec.Vec U8)
                          (post1 post2 : S2Trust.Heap (ℕ → S2W_D189Entry.Record)),
                          S2W_D189Wrappers.first native1 copy allocator e1 CPH_Program.verifier data1 state1 =
                              ok (core.result.Result.Ok (saved, post1, final1)) →
                            S2W_D189Wrappers.second native2 allocator e2 CPH_Program.verifier data2 slot state2 =
                                ok (core.result.Result.Ok (post2, final2)) →
                              ∀ (root : Std.Array U8 32#usize) (length : U32)
                                (prior :
                                  AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes
                                    AspisV8R19.SourceDuplexStep.State Unit)
                                (words : CanonicalCutEnrichedTranscript.Words) (p : CPG_Projection.Observations Tx A)
                                (t u : Tx) (actions : List (CPP_BankState.Action A)),
                                CPH_Game.DeployedPairExecution p t u e1 e2 saved actions native1 native2 copy allocator
                                    CPH_Program.verifier →
                                  CPR_DataPersistence.TwoTransactionLaw (CPG_Projection.adjacent p)
                                      (CPG_Projection.ordinary p (Hist_Nonvacuity.key 0#u8)) (CPG_Projection.before p)
                                      (CPG_Projection.tentative p) (CPG_Projection.success p)
                                      (CPG_Projection.loaded p) →
                                    ∀ (D : LiteralByteProtocol.Decoder) (P : F3T_ByteCarrier.ByteProver) (Q0 Q1 : ℕ),
                                      (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
                                          (AspisV8R19.MemoizedProgramLaw.eval H P).1.length ≤ Q0 + Q1) →
                                        ∀ (runtime : F3T_Runtime.Runtime),
                                          FGl_PreparedAt.Owners (Rc5_Install.configuration indexError c reservation)
                                              (Rc2_Install.configuration (Rc5_Install.seed indexError c)
                                                  reservation).boundaries →
                                            F3T_Runtime.StoredCarrierBinding
                                                (Rc5_Install.configuration indexError c reservation) D
                                                (F3T_Installed.source
                                                  (Rc5_Install.configuration indexError c reservation) hashv)
                                                P runtime →
                                              have select := fun x =>
                                                P2P_NativeSelection.pair
                                                  (DrvC_Installation.sdk
                                                    (Rc5_Install.configuration indexError c reservation))
                                                  CPH_Program.verifier e1 e2 data2 slot;
                                              MultiproofConeP6Frozen2Stage.P6Boundary (P6C_Extension.dictionary hashv H)
                                                  () H Op5T_P6.parent Op5T_P6.parent Op5T_P6.parent
                                                  MultiproofConeP6Batch.referenceLeaf ∧
                                                DrvC_Implementation.driver
                                                      (Rc5_Install.configuration indexError c reservation) =
                                                    DrvC_SourceEntry.source
                                                      (Rc5_Install.configuration indexError c reservation) hashv ∧
                                                  DrvC_Installation.sdk
                                                        (Rc5_Install.configuration indexError c reservation) =
                                                      SdkD_PairBatches.dictionary
                                                        (Rc5_Install.configuration indexError c reservation).adapter
                                                        (Rc5_Install.configuration indexError c reservation).currentBase
                                                        (Rc5_Install.configuration indexError c reservation).stageBase
                                                        (Rc5_Install.configuration indexError c reservation).finish
                                                        (Rc5_Install.configuration indexError c reservation).reserved
                                                        (Rc5_Install.configuration indexError c reservation).query
                                                        (Rc5_Install.configuration indexError c reservation).geometry
                                                        (Rc5_Install.configuration indexError c reservation).boundaries
                                                        (Rc5_Install.configuration indexError c reservation).std ∧
                                                    P2P_Result.Outcome L e1 e2 w1 w2
                                                        (Rc5_Install.configuration indexError c reservation).adapter
                                                        (Rc5_Install.configuration indexError c reservation).currentBase
                                                        (Rc5_Install.configuration indexError c reservation).reserved
                                                        (Rc5_Install.configuration indexError c reservation).query
                                                        (Rc5_Install.configuration indexError c reservation).geometry
                                                        (Rc5_Install.configuration indexError c reservation).stageBase
                                                        (Rc5_Install.configuration indexError c reservation).finish
                                                        c.boundaries reservation CPH_Program.verifier data1 data2 slot
                                                        saved post1 post2 H
                                                        (DrvC_Implementation.driver
                                                          (Rc5_Install.configuration indexError c reservation))
                                                        prior (p.physicalEvents t) hashv
                                                        (BinRawByteCollisionTargets.event
                                                          SelectedTranscriptParams.params.iv (Q0 + Q1 + 2965)
                                                          (AspisV8R19.MemoizedProgramLaw.eval H
                                                            (Hiq_RecordedJoint.program
                                                              (F3X_Account.program
                                                                (Rc5_Install.configuration indexError c reservation)
                                                                hashv P)
                                                              F3X_Projection.project select))) ∧
                                                      (F3X_ModelClaims.Claims
                                                            (Rc5_Install.configuration indexError c reservation) D P
                                                            (Q0 + Q1) ∧
                                                          F3Y_SourceClaims.Claims
                                                              (Rc5_Install.configuration indexError c reservation) D
                                                              hashv P (Q0 + Q1) select ∧
                                                            ⋯) ∧
                                                        (native1 CPH_Program.verifier e1.first data1 =
                                                              ok (core.result.Result.Ok saved) ∧
                                                            ⋯) ∧
                                                          ⋯ ∧ ⋯ :=
fun {W A F CoreError Tx} L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 c indexError reservation native1
    native2 hashv extraction sha256 H p1 syscall data1 data2 slot state1 state2 final1 final2 saved post1 post2
    accepted1 accepted2 root length prior words p t u actions game RuntimePersistence D P Q0 Q1 queries runtime
    finishOwners binding =>
  id
    (let select := fun x =>
      P2P_NativeSelection.pair (DrvC_Installation.sdk (Rc5_Install.configuration indexError c reservation))
        CPH_Program.verifier e1 e2 data2 slot;
    have prepare := F3Y_InstalledLaws.prepare indexError c reservation;
    have ports := F3Y_InstalledLaws.primitives indexError c reservation;
    have canonical := F3Y_InstalledLaws.canonical indexError c reservation;
    have domain := F3Y_InstalledLaws.domain indexError c reservation;
    have multiply := F3Y_InstalledLaws.multiply indexError c reservation;
    have one := F3Y_InstalledLaws.one indexError c reservation;
    have inverse := F3Y_InstalledLaws.inverse indexError c reservation;
    have security :=
      FGl_Bound.bound (Rc2_Install.configuration (Rc5_Install.seed indexError c) reservation) hashv D words P (Q0 + Q1)
        queries runtime select prepare ports canonical domain multiply one inverse finishOwners binding;
    have sourceCost :=
      FGl_Cost.source_cost (Rc2_Install.configuration (Rc5_Install.seed indexError c) reservation) hashv D words P
        (Q0 + Q1) queries select prepare ports canonical domain multiply one inverse finishOwners;
    have accountMass :=
      F3Y_AccountMass.claims (Rc2_Install.configuration (Rc5_Install.seed indexError c) reservation) hashv D words P
        (Q0 + Q1) queries select;
    ⟨P6C_Extension.boundary hashv sha256 H p1 syscall,
      ⟨DrvC_SourceEntry.same_program (Rc3_Install.select (Rc5_Install.seed indexError c) reservation) hashv,
        ⟨DrvC_Installation.aus1_dictionary (Rc5_Install.configuration indexError c reservation),
          ⟨have original :=
              Rc7_Native.accepted L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 c indexError reservation
                native1 native2 hashv extraction sha256 H p1 syscall data1 data2 slot state1 state2 final1 final2 saved
                post1 post2 accepted1 accepted2 root length prior words p t u actions game RuntimePersistence;
            have strengthened :=
              P2P_R6Result.strengthen L e1 e2 w1 w2 (Rc5_Install.configuration indexError c reservation).adapter
                (Rc5_Install.configuration indexError c reservation).currentBase
                (Rc5_Install.configuration indexError c reservation).reserved
                (Rc5_Install.configuration indexError c reservation).query
                (Rc5_Install.configuration indexError c reservation).geometry
                (Rc5_Install.configuration indexError c reservation).stageBase
                (Rc5_Install.configuration indexError c reservation).finish c.boundaries reservation
                CPH_Program.verifier data1 data2 slot saved post1 post2 H
                (DrvC_Implementation.driver (Rc5_Install.configuration indexError c reservation)) prior
                (p.physicalEvents t) hashv native1 native2 extraction sha256 p1 syscall original;
            P2P_Release.remove L e1 e2 w1 w2 (Rc5_Install.configuration indexError c reservation).adapter
              (Rc5_Install.configuration indexError c reservation).currentBase
              (Rc5_Install.configuration indexError c reservation).reserved
              (Rc5_Install.configuration indexError c reservation).query
              (Rc5_Install.configuration indexError c reservation).geometry
              (Rc5_Install.configuration indexError c reservation).stageBase
              (Rc5_Install.configuration indexError c reservation).finish c.boundaries reservation CPH_Program.verifier
              data1 data2 slot saved post1 post2 H
              (DrvC_Implementation.driver (Rc5_Install.configuration indexError c reservation)) prior
              (p.physicalEvents t) hashv
              (F3X_Account.program (Rc5_Install.configuration indexError c reservation) hashv P) F3X_Projection.project
              (Q0 + Q1)
              (F3Y_AccountMass.budget (Rc2_Install.configuration (Rc5_Install.seed indexError c) reservation) hashv D
                words P (Q0 + Q1) queries)
              strengthened,
            ⟨⟨F3X_ModelClaims.claims (Rc5_Install.configuration indexError c reservation) D P (Q0 + Q1) queries,
                ⟨sourceCost,
                  ⟨accountMass,
                    ⟨security,
                      ⟨fun range =>
                        Eq.mp
                          (congrArg (LE.le (F3T_RuntimeBound.failureModel runtime))
                            (congrFun' (congrArg HMul.hMul (congrFun' (congrArg HAdd.hAdd (Nat.cast_add Q0 Q1)) 1))
                              (1 / 2 ^ 100)))
                          (LE.le.trans security (F3U_Range.per_attempt (Q0 + Q1) range)),
                        fun zero =>
                        F3U_Numeric.runtime_margin (F3T_RuntimeBound.failureModel runtime)
                          (Eq.mp
                            (congrArg (fun _a => F3T_RuntimeBound.failureModel runtime ≤ F3T_Numeric.total _a) zero)
                            security)⟩⟩⟩⟩⟩,
              ⟨PoolT_Write.accepted_verifier_writes_copy
                  (DrvC_Installation.sdk (Rc5_Install.configuration indexError c reservation)) native1 native2 hashv
                  extraction copy std allocator e1 CPH_Program.verifier data1 state1 final1 saved post1 accepted1,
                ⟨Rc2_Events.derive (Rc5_Install.configuration indexError c reservation) hashv native1 native2 extraction
                    copy allocator CPH_Program.verifier sha256 H p1 syscall saved,
                  ⟨CPH_Protection.derive p t u e1 e2 saved actions (Rc5_Install.configuration indexError c reservation)
                      (Rc5_Install.key indexError c reservation) native1 native2 hashv extraction copy std allocator
                      CPH_Program.verifier game data1 state1 final1 post1 accepted1,
                    ⟨CPH_Trace.derive game,
                      CPH_Recorder.physical p t u e1 e2 saved actions
                        (Rc5_Install.configuration indexError c reservation) native1 native2 hashv extraction copy
                        allocator CPH_Program.verifier game sha256 H p1 syscall⟩⟩⟩⟩⟩⟩⟩⟩⟩)
