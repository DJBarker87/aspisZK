    R1Z.ProverCommitRetry34.run (R1Z.ProverRwRetryModel.attempt entropy pub compiled variant hash) n k s
PV_L1E_RetrySource.complete_source [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns] {C : Type}
  (entropy : R1Z.ProverRwRetryModel.Entropy C) (pub : R1Z.ProverRwRetryModel.Pub)
  (compiled : R1Z.ProverRwRetryModel.Compiled) (variant : ProverRwFull.transport.Variant)
  (hash : R1Z.ProverRwRetryModel.Hash) (store : R1Z.ProverRwRetryModel.Store) (callback : C) (k : Aeneas.Std.Usize)
  (n : ℕ) (bound : ↑k + n = 8) :
  R1Z.ProverCommitSemanticTransport26.mapR R1Z.ProverRwRetryModel.sourceOutput
      (ProverRwFull.prover.retry_attempt entropy pub compiled variant hash store callback k) =
    R1Z.ProverCommitSemanticTransport26.mapR R1Z.ProverRwRetryModel.drop
      (PV_L1D_Logged.erase
        (PV_L1D_RetryFold.run (PV_L1E_RetrySource.attempt entropy pub compiled variant hash) n ↑k (callback, store)))
PV_L1E_RetrySource.client_no_final_rejected [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns] {C E : Type}
  (generate :
    C → Aeneas.Std.Usize → Aeneas.Std.Result (Aeneas.Std.core.result.Result R1Z.ProverRwRetryModel.Secret E × C))
  (pub : R1Z.ProverRwRetryModel.Pub) (compiled : R1Z.ProverRwRetryModel.Compiled)
  (variant : ProverRwFull.transport.Variant) (hash : R1Z.ProverRwRetryModel.Hash) (n k : ℕ)
  (s : C × R1Z.ProverRwRetryModel.Store) :
  PV_DIAG2.RejectFree
    (PV_L1D_Logged.erase
      (PV_L1D_RetryFold.run (PV_L1E_RetrySource.attempt (PV_DIAG2.clientEntropy generate) pub compiled variant hash) n k
        s))
