                  Prop :=
fun [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns] {C} entropy pub compiled variant hash owner =>
  ∀ (k : ℕ) (s : C × R1Z.ProverRwRetryModel.Store),
    (PV_L1E_RetrySource.attempt entropy pub compiled variant hash k s).events = (owner k s).1.events
