PV_L1E_SourceEntries.successful_callbacks [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns] {C : Type}
  (entropy : R1Z.ProverRwRetryModel.Entropy C) (pub : R1Z.ProverRwRetryModel.Pub)
