PV_L1E_CountSkeleton.count_trace {I A : Type} (actualCount : I → List ℕ × List ℕ) (native : I → PV_RJ4IDB.NativeTrace A)
  (sourceWorld bodyWorld originalWorld : I → PV_RJ4IDB.Trace A)
  (acquisition : PV_L1E_CountSkeleton.PV_L1E_Link_CountAcquisition actualCount sourceWorld)
  (body : PV_L1E_CountSkeleton.PV_L1E_Link_BodyWrapper sourceWorld bodyWorld)
  (retry : PV_L1E_CountSkeleton.PV_L1E_Link_RetryJoin bodyWorld originalWorld)
  (coupling : PV_L1E_CountSkeleton.PV_L1E_Link_NativeOriginal originalWorld native) :
  PV_RJ4IDB.OpenInputs.L1_COUNT_TRACE actualCount native
PV_L1E_EntryOrder.entryRange_length (k n : ℕ) : (PV_L1E_EntryOrder.entryRange k n).length = n
PV_L1E_EntryOrder.all_outcomes {S P : Type} (a : PV_L1D_RetryFold.Attempt S P)
  (entries : ∀ (k : ℕ) (s : S), PV_L1D_CallbackSafe.callbacks (a k s).events = [k]) (n k : ℕ) (s : S) :
  ∃ m ≤ n, PV_L1D_CallbackSafe.callbacks (PV_L1D_RetryFold.run a n k s).events = PV_L1E_EntryOrder.entryRange k m
PV_L1E_ErasureObstruction.result_erasure_does_not_determine_entries :
  ∃ x y,
    PV_L1D_Logged.erase x = PV_L1D_Logged.erase y ∧
      PV_L1D_CallbackSafe.callbacks x.events ≠ PV_L1D_CallbackSafe.callbacks y.events
PV_L1E_ErasureObstruction.outer_failure_not_total_owner {S P : Type} (a : PV_L1D_RetryFold.Attempt S P) (s : S) (k : ℕ)
  (e : Aeneas.Std.Error) (failed : (a k s).result = Aeneas.Std.Result.fail e) :
  ¬∃ owner, PV_L1E_OwnerJoin.PV_L1E_Link_SourceOwner a owner
PV_L1E_ErasureObstruction.native_output_does_not_determine_count :
  ∃ x y, x.terminal = y.terminal ∧ PV_RJ4IDB.nativeCounts x.events ≠ PV_RJ4IDB.nativeCounts y.events
PV_L1E_OriginalCountSkeleton.original_count_trace {I A S P : Type} (actualCount : I → List ℕ × List ℕ)
  (native : I → PV_RJ4IDB.NativeTrace A) (sourceWorld bodyWorld : I → PV_RJ4IDB.Trace A)
  (owner : I → R1Z.SideChannelL1AttemptRecord.Owner S P) (initial : I → S) (fuel index : I → ℕ)
  (adapt : I → R1Z.SideChannelL1AttemptRecord.Run P × S → PV_RJ4IDB.Trace A)
  (acquisition : PV_L1E_CountSkeleton.PV_L1E_Link_CountAcquisition actualCount sourceWorld)
  (body : PV_L1E_CountSkeleton.PV_L1E_Link_BodyWrapper sourceWorld bodyWorld)
  (retry : PV_L1E_OriginalCountSkeleton.PV_L1E_Link_OriginalRetry bodyWorld owner initial fuel index adapt)
  (coupling : PV_L1E_OriginalCountSkeleton.PV_L1E_Link_NativeD163 native owner initial fuel index adapt) :
  PV_RJ4IDB.OpenInputs.L1_COUNT_TRACE actualCount native
PV_L1E_OriginalSourceCount.same_original_success [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns] {C Key : Type}
  (entropy : R1Z.ProverRwRetryModel.Entropy C) (pub : R1Z.ProverRwRetryModel.Pub)
  (compiled : R1Z.ProverRwRetryModel.Compiled) (variant : ProverRwFull.transport.Variant)
  (hash : R1Z.ProverRwRetryModel.Hash)
  (owner : R1Z.SideChannelL1AttemptRecord.Owner (C × R1Z.ProverRwRetryModel.Store) R1Z.ProverRwRetryModel.Proof)
  (s after : C × R1Z.ProverRwRetryModel.Store) (keys : Fin 8 → Key)
  (p : R1Z.ProverCommitRetry34.Published R1Z.ProverRwRetryModel.Proof)
  (link : PV_L1E_OwnerJoin.PV_L1E_Link_SourceOwner (PV_L1E_RetrySource.attempt entropy pub compiled variant hash) owner)
  (success :
    (PV_L1D_RetryFold.run (PV_L1E_RetrySource.attempt entropy pub compiled variant hash) 8 0 s).result =
      Aeneas.Std.Result.ok (R1Z.ProverCommitRetry34.Step.done p, after)) :
  p.attempts =
      (PV_L1D_CallbackSafe.callbacks
          (PV_L1D_RetryFold.run (PV_L1E_RetrySource.attempt entropy pub compiled variant hash) 8 0 s).events).length ∧
    ∃ k,
      ↑k = p.attempts - 1 ∧
        PV_L1D_SelectedCount.selected keys p.attempts
              (R1Z.SideChannelL1AttemptRecord.run owner 8 0 s).1.attempts.length =
            some (↑k, keys k) ∧
          ((R1Z.SideChannelL1AttemptRecord.run owner 8 0 s).1.attempts.length,
              (List.filter PV_L1D_RejectionCount.retrying
                  (R1Z.SideChannelL1AttemptRecord.run owner 8 0 s).1.attempts).length,
              PV_L1D_UploadCounts.uploads p.proof.1.length, 1) =
            (p.attempts, p.attempts - 1, (p.proof.1.length + 3762) / 3763, 1)
PV_L1E_OwnerJoin.original_run {S P : Type} (owner : R1Z.SideChannelL1AttemptRecord.Owner S P) (n k : ℕ) (s : S) :
  PV_L1D_RetryFold.run (PV_L1E_OwnerJoin.liftOwner owner) n k s =
    { events := R1Z.SideChannelL1AttemptRecord.events (R1Z.SideChannelL1AttemptRecord.run owner n k s).1,
      result :=
        Aeneas.Std.Result.ok
          ((R1Z.SideChannelL1AttemptRecord.run owner n k s).1.result,
            (R1Z.SideChannelL1AttemptRecord.run owner n k s).2) }
PV_L1E_OwnerJoin.original_prefix {S P : Type} (owner : R1Z.SideChannelL1AttemptRecord.Owner S P) (n k m : ℕ) (s : S) :
  List.take m (PV_L1D_RetryFold.run (PV_L1E_OwnerJoin.liftOwner owner) n k s).events =
    List.take m (R1Z.SideChannelL1AttemptRecord.events (R1Z.SideChannelL1AttemptRecord.run owner n k s).1)
PV_L1E_OwnerJoin.run_of_link {S P : Type} (a : PV_L1D_RetryFold.Attempt S P)
  (owner : R1Z.SideChannelL1AttemptRecord.Owner S P) (link : PV_L1E_OwnerJoin.PV_L1E_Link_SourceOwner a owner) (n k : ℕ)
  (s : S) :
  PV_L1D_RetryFold.run a n k s =
    { events := R1Z.SideChannelL1AttemptRecord.events (R1Z.SideChannelL1AttemptRecord.run owner n k s).1,
      result :=
        Aeneas.Std.Result.ok
          ((R1Z.SideChannelL1AttemptRecord.run owner n k s).1.result,
            (R1Z.SideChannelL1AttemptRecord.run owner n k s).2) }
