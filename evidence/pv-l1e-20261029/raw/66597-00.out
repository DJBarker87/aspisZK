theorem PV_L1E_Statements.combined : ∀ {I A S P : Type} (actualCount : I → List ℕ × List ℕ) (native : I → NativeTrace A)
  (sourceWorld bodyWorld : I → Trace A) (owner : I → R1Z.SideChannelL1AttemptRecord.Owner S P) (initial : I → S)
  (fuel index : I → ℕ) (adapt : I → R1Z.SideChannelL1AttemptRecord.Run P × S → Trace A),
  PV_L1E_Link_CountAcquisition actualCount sourceWorld →
    PV_L1E_Link_BodyWrapper sourceWorld bodyWorld →
      PV_L1E_Link_OriginalRetry bodyWorld owner initial fuel index adapt →
        PV_L1E_Link_NativeD163 native owner initial fuel index adapt →
          OpenInputs.L1_COUNT_TRACE actualCount native ∧
            ∀ (i : I), nativeObservation (native i) = decoder (modelTrace (native i)) :=
fun {I A S P} actualCount native sourceWorld bodyWorld owner initial fuel index adapt acquisition body retry coupling =>
  ⟨original_count_trace actualCount native sourceWorld bodyWorld owner initial fuel index adapt acquisition body retry
      coupling,
    all_prefixes native⟩
'PV_L1E_Statements.combined' depends on axioms: [propext]
