def PV_L1E_CountSkeleton.PV_L1E_Link_CountAcquisition : {I A : Type} →
  (I → List ℕ × List ℕ) → (I → PV_RJ4IDB.Trace A) → Prop :=
fun {I A} actualCount sourceWorld =>
  ∀ (i : I), actualCount i = (PV_RJ4IDB.counts (sourceWorld i).events, PV_RJ4IDB.rejections (sourceWorld i).events)
def PV_L1E_CountSkeleton.PV_L1E_Link_BodyWrapper : {I A : Type} →
  (I → PV_RJ4IDB.Trace A) → (I → PV_RJ4IDB.Trace A) → Prop :=
fun {I A} sourceWorld bodyWorld => ∀ (i : I), sourceWorld i = bodyWorld i
def PV_L1E_CountSkeleton.PV_L1E_Link_RetryJoin : {I A : Type} →
  (I → PV_RJ4IDB.Trace A) → (I → PV_RJ4IDB.Trace A) → Prop :=
fun {I A} bodyWorld originalWorld => ∀ (i : I), bodyWorld i = originalWorld i
def PV_L1E_CountSkeleton.PV_L1E_Link_NativeOriginal : {I A : Type} →
  (I → PV_RJ4IDB.Trace A) → (I → PV_RJ4IDB.NativeTrace A) → Prop :=
fun {I A} originalWorld native => ∀ (i : I), originalWorld i = PV_RJ4IDB.modelTrace (native i)
def PV_L1E_OriginalCountSkeleton.PV_L1E_Link_OriginalRetry : {I A S P : Type} →
  (I → PV_RJ4IDB.Trace A) →
    (I → R1Z.SideChannelL1AttemptRecord.Owner S P) →
      (I → S) → (I → ℕ) → (I → ℕ) → (I → R1Z.SideChannelL1AttemptRecord.Run P × S → PV_RJ4IDB.Trace A) → Prop :=
fun {I A S P} bodyWorld owner initial fuel index adapt =>
  ∀ (i : I), bodyWorld i = adapt i (R1Z.SideChannelL1AttemptRecord.run (owner i) (fuel i) (index i) (initial i))
def PV_L1E_OriginalCountSkeleton.PV_L1E_Link_NativeD163 : {I A S P : Type} →
  (I → PV_RJ4IDB.NativeTrace A) →
    (I → R1Z.SideChannelL1AttemptRecord.Owner S P) →
      (I → S) → (I → ℕ) → (I → ℕ) → (I → R1Z.SideChannelL1AttemptRecord.Run P × S → PV_RJ4IDB.Trace A) → Prop :=
fun {I A S P} native owner initial fuel index adapt =>
  ∀ (i : I),
    adapt i (R1Z.SideChannelL1AttemptRecord.run (owner i) (fuel i) (index i) (initial i)) =
      PV_RJ4IDB.modelTrace (native i)
def PV_L1E_OwnerJoin.PV_L1E_Link_SourceOwner : {S P : Type} →
  PV_L1D_RetryFold.Attempt S P → R1Z.SideChannelL1AttemptRecord.Owner S P → Prop :=
fun {S P} a owner => ∀ (k : ℕ) (s : S), a k s = PV_L1E_OwnerJoin.liftOwner owner k s
def PV_L1E_SourceOwnerLinks.PV_L1E_Link_OwnerControl : [inst : ProverRwFull.ExternalTypes] →
  [ProverRwFull.ExternalFuns] →
    {C : Type} →
      R1Z.ProverRwRetryModel.Entropy C →
        R1Z.ProverRwRetryModel.Pub →
          R1Z.ProverRwRetryModel.Compiled →
            ProverRwFull.transport.Variant →
              R1Z.ProverRwRetryModel.Hash →
                R1Z.SideChannelL1AttemptRecord.Owner (C × R1Z.ProverRwRetryModel.Store) R1Z.ProverRwRetryModel.Proof →
                  Prop :=
fun [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns] {C} entropy pub compiled variant hash owner =>
  ∀ (k : ℕ) (s : C × R1Z.ProverRwRetryModel.Store),
    R1Z.ProverRwRetryModel.attempt entropy pub compiled variant hash k s =
      R1Z.SideChannelL1AttemptRecord.eraseOwner owner k s
def PV_L1E_SourceOwnerLinks.PV_L1E_Link_OwnerEvents : [inst : ProverRwFull.ExternalTypes] →
  [ProverRwFull.ExternalFuns] →
