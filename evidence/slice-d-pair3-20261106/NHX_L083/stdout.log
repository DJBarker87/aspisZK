  have ic2 := NHI_ScalarDomain.index (NHX_HighReference.row2 w) 4#usize (of_decide_eq_true (id (Eq.refl true)));
  Eq.mpr
    (id
      (congrArg (fun _a => _a = NHX_HighReference.reference partials w ap0 ap1 parts)
        (NHM_SharedHigh.cohort partials w ap0 ap1 parts)))
    (id
      (id
        (id
          (Eq.mpr
            (id
              (congr
                (congrArg Eq
                  (Eq.trans
                    (Eq.trans
                      (congr (congrArg bind ir0)
                        (funext fun a =>
                          congrArg (bind (a.index_usize 4#usize))
                            (funext fun a1 =>
                              congrArg (bind (NHM_HighDot.reference partials a1))
                                (funext fun r =>
