                                        NHI_ArrayCells.put (index_mut_back we2) 3#usize we5)
                                | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual => do
                                  let r2 ←
                                    Aeneas.Std.core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
                                        Unit (Aeneas.Std.core.convert.FromSame FIo_Native.verifier.Error) residual
                                  Aeneas.Std.Result.ok (r2, index_mut_back we2)
                          | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual => do
