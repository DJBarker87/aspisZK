                                  let we3 ← FIo_Native.weights.Weights.scalar_factor a6 ap0
                                  let a7 ← Aeneas.Std.Array.index_usize (NHX_HighReference.row2 w) 1#usize
                                  let we4 ← FIo_Native.weights.Weights.scalar_factor a7 ap1
