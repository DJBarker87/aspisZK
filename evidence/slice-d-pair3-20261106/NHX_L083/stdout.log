  FIo_Native.weights.shared_high partials w ap0 ap1 parts = NHX_HighReference.reference partials w ap0 ap1 parts :=
fun partials w ap0 ap1 parts =>
  have ir0 := NHI_ScalarDomain.index w.factors 0#usize (of_decide_eq_true (id (Eq.refl true)));
  have ir2 := NHI_ScalarDomain.index w.factors 2#usize (of_decide_eq_true (id (Eq.refl true)));
