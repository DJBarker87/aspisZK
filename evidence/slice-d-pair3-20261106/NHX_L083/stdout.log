            (↑(Aeneas.Std.alloc.vec.Vec.deref scratch)).length = 64 →
              NHX_ProcessPost.PartsCanon parts →
                NHX_ProcessReference.reference w kind f ap0 ap1 scratch parts =
                    Aeneas.Std.Result.ok (reply, after, out) →
                  NHI_CellCanon.slice (Aeneas.Std.alloc.vec.Vec.deref after) ∧
                    (↑(Aeneas.Std.alloc.vec.Vec.deref after)).length = 64 ∧
                      NHX_ProcessPost.PartsCanon out ∧ ∀ (j : ℕ), j ≠ ↑kind → (↑out)[j]? = (↑parts)[j]? :=
