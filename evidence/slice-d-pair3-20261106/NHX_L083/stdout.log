                            let a3 ← y.index_usize 1#usize
                            let we1 ← FIo_Native.weights.Weights.scalar_factor a3 ap1
                            let scale0 ← we.mul we1
                            let we2 ← scale0.mul val
                            let (_, index_mut_back) :=
                                (NHI_ScalarDomain.pick parts (↑1#usize) (of_decide_eq_true (id (Eq.refl true))),
                                  fun x => NHI_ArrayCells.put parts 1#usize x)
                              do
                              let r1 ← NHM_HighDot.reference partials (NHX_HighReference.coeff2 w)
                              let cf1 ← Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r1
                              match cf1 with
