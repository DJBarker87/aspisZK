                                  Unit (Aeneas.Std.core.convert.FromSame FIo_Native.verifier.Error) residual
                            Aeneas.Std.Result.ok (r1, parts))
                      (Aeneas.Std.bind_tc_ok (NHX_HighReference.coeff0 w) fun y => do
                        let r ← NHM_HighDot.reference partials y
                        let cf ← Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r
                        match cf with
                          | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue val => do
