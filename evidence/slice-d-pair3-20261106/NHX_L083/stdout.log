theorem NHX_FactoredPacket.source : ∀ (ap0 ap1 : NHM_FactoredPrefix.Cells)
  (extra : Aeneas.Std.Array AspisR1.LPi_FieldValues.NQ 2#usize),
  (∀ x ∈ ↑ap0, AspisR1.LPi_FieldValues.canonE x) →
    (∀ x ∈ ↑ap1, AspisR1.LPi_FieldValues.canonE x) →
      (∀ x ∈ ↑extra, AspisR1.LPi_FieldValues.canonQ x) →
        ∃ out,
          FIo_Native.weights.factored_s2_libra_weights ap0 ap1 extra = Aeneas.Std.Result.ok out ∧
            NHX_FactoredPacket.reference ap0 ap1 extra = Aeneas.Std.Result.ok out ∧
              ∀ x ∈ ↑out, AspisR1.LPi_FieldValues.canonE x :=
fun ap0 ap1 extra ha hb he =>
  have ci := fun x hx =>
    Eq.mpr
      (id (congrArg (fun _a => AspisR1.LPi_FieldValues.canonE _a) (Eq.mp NHX_FactoredPacket.source._simp_2 hx).right))
      NHI_Scalar.zero_canonical;
  have h0 := ⟨rfl, ⟨id (Decidable.byContradiction fun a => NHX_FactoredPacket.source._proof_2 a), ci⟩⟩;
  have n0 :=
    NHI_ForwardRange.exact_step NHX_FactoredPacket.initial.1 1#usize
      (id (Decidable.byContradiction fun a => NHX_FactoredPacket.source._proof_3 a)) (id (Eq.refl 1));
  let ⟨a, h✝⟩ :=
    NHX_FactoredPacket.active ap0 ap1 extra ha hb he NHX_FactoredPacket.initial h0 0#usize
      { start := 1#usize, «end» := 2#usize } n0
  let ⟨sa, ca⟩ := h✝
  let s1 := ({ start := 1#usize, «end» := 2#usize }, a);
  have h1 := ⟨rfl, ⟨id (Decidable.byContradiction fun a => NHX_FactoredPacket.source._proof_4 a), ca⟩⟩;
  have n1 :=
    NHI_ForwardRange.exact_step s1.1 2#usize
      (id (Decidable.byContradiction fun a => NHX_FactoredPacket.source._proof_5 a)) (id (Eq.refl 2));
  let ⟨b, h✝¹⟩ :=
    NHX_FactoredPacket.active ap0 ap1 extra ha hb he s1 h1 1#usize { start := 2#usize, «end» := 2#usize } n1
  let ⟨sb, cb⟩ := h✝¹
  let s2 := ({ start := 2#usize, «end» := 2#usize }, b);
  have stopped :=
    id
      (have dn :=
        NHI_ForwardRange.done s2.1 (id (Decidable.byContradiction fun a => NHX_FactoredPacket.source._proof_6 a));
      Eq.mpr
        (id
          (congrArg
            (fun _a =>
              (do
                  let (o, next) ← _a
                  match o with
                    | none => Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.done s2.2)
                    | some side => do
                      let q ← extra.index_usize side
                      let (low, high, q4, q16) ← NHI_FactoredProducers.run q
                      NHM_FactoredPrefix.tail ap0 ap1 side next s2.2 low high q4 q16) =
                Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.done b))
            dn))
        (Eq.refl do
          let (o, next) ← Aeneas.Std.Result.ok (none, s2.1)
          match o with
            | none => Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.done s2.2)
            | some side => do
              let q ← extra.index_usize side
              let (low, high, q4, q16) ← NHI_FactoredProducers.run q
              NHM_FactoredPrefix.tail ap0 ap1 side next s2.2 low high q4 q16));
  have bodies := funext fun s => NHM_FactoredPrefix.source ap0 ap1 extra s;
  Exists.intro b
    ⟨id
        (id
          (Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  (have weights :=
                      Aeneas.Std.Array.repeat 4#usize FIo_Native.aspis_core.field.wide_exact.WideExact.ZERO;
                    Aeneas.Std.loop _a ({ start := 0#usize, «end» := 2#usize }, weights)) =
                    Aeneas.Std.Result.ok b)
                bodies))
            (id
              (Eq.mpr
                (id
                  (congrArg (fun _a => _a = Aeneas.Std.Result.ok b)
                    (Aeneas.Std.loop.eq_def (NHM_FactoredPrefix.body ap0 ap1 extra) NHX_FactoredPacket.initial)))
                (Eq.mpr
                  (id
                    (congrArg
                      (fun _a =>
                        (match _a with
                          | Aeneas.Std.Result.ok r =>
                            match r with
                            | Aeneas.Std.ControlFlow.cont x => Aeneas.Std.loop (NHM_FactoredPrefix.body ap0 ap1 extra) x
                            | Aeneas.Std.ControlFlow.done x => Aeneas.Std.Result.ok x
                          | Aeneas.Std.Result.fail e => Aeneas.Std.Result.fail e
                          | Aeneas.Std.Result.div => Aeneas.Std.Result.div) =
                          Aeneas.Std.Result.ok b)
                      sa))
                  (id
                    (Eq.mpr
                      (id
                        (congrArg (fun _a => _a = Aeneas.Std.Result.ok b)
                          (Aeneas.Std.loop.eq_def (NHM_FactoredPrefix.body ap0 ap1 extra)
                            ({ start := 1#usize, «end» := 2#usize }, a))))
                      (Eq.mpr
                        (id
                          (congrArg
                            (fun _a =>
                              (match _a with
                                | Aeneas.Std.Result.ok r =>
                                  match r with
                                  | Aeneas.Std.ControlFlow.cont x =>
                                    Aeneas.Std.loop (NHM_FactoredPrefix.body ap0 ap1 extra) x
                                  | Aeneas.Std.ControlFlow.done x => Aeneas.Std.Result.ok x
                                | Aeneas.Std.Result.fail e => Aeneas.Std.Result.fail e
                                | Aeneas.Std.Result.div => Aeneas.Std.Result.div) =
                                Aeneas.Std.Result.ok b)
                            sb))
                        (id
                          (Eq.mpr
                            (id
                              (congrArg (fun _a => _a = Aeneas.Std.Result.ok b)
                                (Aeneas.Std.loop.eq_def (NHM_FactoredPrefix.body ap0 ap1 extra)
                                  ({ start := 2#usize, «end» := 2#usize }, b))))
                            (Eq.mpr
                              (id
                                (congrArg
                                  (fun _a =>
                                    (match _a with
                                      | Aeneas.Std.Result.ok r =>
                                        match r with
                                        | Aeneas.Std.ControlFlow.cont x =>
                                          Aeneas.Std.loop (NHM_FactoredPrefix.body ap0 ap1 extra) x
                                        | Aeneas.Std.ControlFlow.done x => Aeneas.Std.Result.ok x
                                      | Aeneas.Std.Result.fail e => Aeneas.Std.Result.fail e
                                      | Aeneas.Std.Result.div => Aeneas.Std.Result.div) =
                                      Aeneas.Std.Result.ok b)
                                  stopped))
                              (Eq.refl
                                (match Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.done b) with
                                | Aeneas.Std.Result.ok r =>
                                  match r with
                                  | Aeneas.Std.ControlFlow.cont x =>
                                    Aeneas.Std.loop (NHM_FactoredPrefix.body ap0 ap1 extra) x
                                  | Aeneas.Std.ControlFlow.done x => Aeneas.Std.Result.ok x
                                | Aeneas.Std.Result.fail e => Aeneas.Std.Result.fail e
                                | Aeneas.Std.Result.div => Aeneas.Std.Result.div))))))))))))),
      ⟨of_eq_true
          (Eq.trans
            (congrFun'
              (congrArg Eq
                (Eq.trans
                  (Eq.trans
                    (congrFun' (congrArg bind sa) fun cf =>
                      match cf with
                      | Aeneas.Std.ControlFlow.done a => Aeneas.Std.Result.ok a
                      | Aeneas.Std.ControlFlow.cont next => do
                        let cf ← NHM_FactoredPrefix.body ap0 ap1 extra next
                        match cf with
                          | Aeneas.Std.ControlFlow.done a => Aeneas.Std.Result.ok a
                          | Aeneas.Std.ControlFlow.cont next => do
                            let cf ← NHM_FactoredPrefix.body ap0 ap1 extra next
                            match cf with
                              | Aeneas.Std.ControlFlow.done a => Aeneas.Std.Result.ok a
                              | Aeneas.Std.ControlFlow.cont next => Aeneas.Std.Result.div)
                    (Aeneas.Std.bind_tc_ok (Aeneas.Std.ControlFlow.cont ({ start := 1#usize, «end» := 2#usize }, a))
                      fun y =>
                      match y with
                      | Aeneas.Std.ControlFlow.done a => Aeneas.Std.Result.ok a
                      | Aeneas.Std.ControlFlow.cont next => do
                        let cf ← NHM_FactoredPrefix.body ap0 ap1 extra next
                        match cf with
                          | Aeneas.Std.ControlFlow.done a => Aeneas.Std.Result.ok a
                          | Aeneas.Std.ControlFlow.cont next => do
                            let cf ← NHM_FactoredPrefix.body ap0 ap1 extra next
                            match cf with
                              | Aeneas.Std.ControlFlow.done a => Aeneas.Std.Result.ok a
                              | Aeneas.Std.ControlFlow.cont next => Aeneas.Std.Result.div))
                  (Eq.trans
                    (Eq.trans
                      (congrFun' (congrArg bind sb) fun cf =>
                        match cf with
                        | Aeneas.Std.ControlFlow.done a => Aeneas.Std.Result.ok a
                        | Aeneas.Std.ControlFlow.cont next => do
                          let cf ← NHM_FactoredPrefix.body ap0 ap1 extra next
                          match cf with
                            | Aeneas.Std.ControlFlow.done a => Aeneas.Std.Result.ok a
                            | Aeneas.Std.ControlFlow.cont next => Aeneas.Std.Result.div)
                      (Aeneas.Std.bind_tc_ok (Aeneas.Std.ControlFlow.cont ({ start := 2#usize, «end» := 2#usize }, b))
                        fun y =>
                        match y with
                        | Aeneas.Std.ControlFlow.done a => Aeneas.Std.Result.ok a
                        | Aeneas.Std.ControlFlow.cont next => do
                          let cf ← NHM_FactoredPrefix.body ap0 ap1 extra next
                          match cf with
                            | Aeneas.Std.ControlFlow.done a => Aeneas.Std.Result.ok a
                            | Aeneas.Std.ControlFlow.cont next => Aeneas.Std.Result.div))
                    (Eq.trans
                      (congrFun' (congrArg bind stopped) fun cf =>
                        match cf with
                        | Aeneas.Std.ControlFlow.done a => Aeneas.Std.Result.ok a
                        | Aeneas.Std.ControlFlow.cont next => Aeneas.Std.Result.div)
                      (Aeneas.Std.bind_tc_ok (Aeneas.Std.ControlFlow.done b) fun y =>
                        match y with
                        | Aeneas.Std.ControlFlow.done a => Aeneas.Std.Result.ok a
                        | Aeneas.Std.ControlFlow.cont next => Aeneas.Std.Result.div)))))
              (Aeneas.Std.Result.ok b))
            (eq_self (Aeneas.Std.Result.ok b))),
        cb⟩⟩
