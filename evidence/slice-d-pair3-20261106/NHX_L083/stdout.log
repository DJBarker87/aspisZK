theorem NHX_GroupPacket.source : ∀ (w : FIo_Native.weights.Weights) (f : Aeneas.Std.Slice Aeneas.Std.U8)
  (low : Aeneas.Std.Array AspisR1.LPi_FieldValues.NE 16#usize),
  w.variant = FIo_Native.transport.Variant.S2 →
    (↑f).length = 2048 → FIo_Native.weights.grouped_inactive_pair w f low = NHM_GroupRoot.reference f low :=
fun w f low s2 size => NHM_GroupDispatch.source w f low s2 size
