                                    (funext fun cf =>
                                      congrFun'
                                        (congrArg
                                          (NHM_SharedHigh.reference.match_1
                                            (fun cf =>
                                              Aeneas.Std.Result
                                                (Aeneas.Std.core.result.Result Unit FIo_Native.verifier.Error ×
                                                  Aeneas.Std.Array FIo_Native.aspis_core.field.wide_exact.WideExact
                                                    7#usize))
                                            cf)
                                          (funext fun val =>
                                            congrArg (bind (a.index_usize 0#usize))
                                              (funext fun a2 =>
                                                congrArg (bind (FIo_Native.weights.Weights.scalar_factor a2 ap0))
                                                  (funext fun we =>
                                                    congrArg (bind (a.index_usize 1#usize))
                                                      (funext fun a3 =>
