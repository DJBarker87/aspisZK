theorem NHX_SharedPacket.source : ∀ (f : Aeneas.Std.Slice Aeneas.Std.U8)
  (common : Aeneas.Std.Array AspisR1.LPi_FieldValues.NQ 16#usize),
  FIo_Native.weights.shared_partials f common = NHM_SharedPartials.reference f common :=
fun f common => NHM_SharedPartials.cohort f common
