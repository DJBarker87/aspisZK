theorem R1Z.PV_Inv_CouplingPole.contained : ∀ {K CommitHandle Aux Bat Adv W S : Type} [inst : Field K] [Fintype K]
  [DecidableEq K] [Algebra (ZMod AspisCircleGroupOrder.P) K] [inst_4 : Zero W] [inst_5 : DecidableEq W]
  (P : R0Z.JointView.Challenges K → Prop) (h : R0Z.JointView.HonestProver K)
  (ab : R0Z.FsAbort.AbortBridge K CommitHandle Aux Bat Adv) (adv : Adv) (x : R0Z.JointView.Statement K CommitHandle)
  (w : h.Instance) (toCoins : S → Fin ab.N → ab.Coins) (banks : S → Fin ab.N → R1Z.PV_Inv_BankSource.Banks K),
  (∀ (u : S) (k : Fin ab.N), R1Z.PV_Inv_RegistryInput.P_banks (banks u k) (h.build w)) →
    ∀ (weight : R1Z.PV_Inv_RegistryInput.SourceLink K → W) (registry : List (R1Z.PV_Inv_RegistryInput.SourceLink K)),
      R1Z.PV_Inv_RegistryInput.P_registry registry →
        ∀ (state : S → Fin ab.N → R1Z.PV_Inv_GlobalSlots.State R1Z.PV_Inv_EntryReference.Key K W),
          (∀ (u : S) (k : Fin ab.N),
              R1Z.PV_Inv_GlobalSlots.run (R1Z.PV_Inv_GlobalSafety.empty 0)
                  (R1Z.PV_Inv_EntryReference.entries (banks u k) ((ab.draw adv x (toCoins u k)).sem 0) weight
                    registry) =
                some (state u k)) →
            ∀ (u : S),
              (∃ k,
                  P (ab.draw adv x (toCoins u k)) ∧
                    R1Z.PV_Inv_RegistryZeroEvent.zeroEvent ((ab.draw adv x (toCoins u k)).sem 1) (state u k)) →
                R0Z.HvzkV.poleBad P h (R1Z.MaskImageVR1.VR1 h) ab adv x w (toCoins u) :=
fun {K CommitHandle Aux Bat Adv W S} [Field K] [Fintype K] [DecidableEq K] [Algebra (ZMod AspisCircleGroupOrder.P) K]
    [Zero W] [DecidableEq W] P h ab adv x w toCoins banks join weight registry enumeration state run u zero =>
  let ⟨k, h✝⟩ := zero
  let ⟨hp, hz⟩ := h✝
  Exists.intro k
    (R1Z.PV_Inv_HeadlinePole.attempt_contained P h ab adv x w (toCoins u k) (banks u k) (join u k) weight registry
      enumeration (state u k) (run u k) hp hz)
theorem R1Z.PV_Inv_GuardedNativeTests.tests_false : ∀ {W : Type} [inst : Zero W] [inst_1 : DecidableEq W]
  (chi : R1Z.ProverCommitPrimitive47.Old.Q),
  R1Z.ProverCommitSubfieldOps47.Canonical chi →
    ∀ (banks : R1Z.PV_Inv_BankSource.Banks AspisR1.ExtractedCurrentQM31Exact.QM31Exact)
      (t : R0P.Trace AspisR1.ExtractedCurrentQM31Exact.QM31Exact),
      R1Z.PV_Inv_RegistryInput.P_banks banks t →
        ∀ (lambda : AspisR1.ExtractedCurrentQM31Exact.QM31Exact)
          (weight : R1Z.PV_Inv_RegistryInput.SourceLink AspisR1.ExtractedCurrentQM31Exact.QM31Exact → W)
          (registry : List (R1Z.PV_Inv_RegistryInput.SourceLink AspisR1.ExtractedCurrentQM31Exact.QM31Exact)),
          R1Z.PV_Inv_RegistryInput.P_registry registry →
            ∀
              (es :
                List (R1Z.PV_Inv_EntryReference.Key × R1Z.PV_Inv_RawSlots.Entry R1Z.ProverCommitPrimitive47.Old.Q W)),
              List.map (R1Z.PV_Inv_MapGlobalStep.keyed AspisR1.ExtractedCurrentQM31Exact.decode) es =
                  R1Z.PV_Inv_EntryReference.entries banks lambda weight registry →
                (∀ e ∈ es, R1Z.ProverCommitSubfieldOps47.Canonical e.2.value) →
                  ∀
                    (s :
                      R1Z.PV_Inv_GlobalSlots.State R1Z.PV_Inv_EntryReference.Key R1Z.ProverCommitPrimitive47.Old.Q W),
                    R1Z.PV_Inv_GlobalSlots.run (R1Z.PV_Inv_GlobalSafety.empty R1Z.ProverCommitSubfieldOps47.zero) es =
                        some s →
                      ∀ (nativeGuard : Bool),
                        nativeGuard =
                            R1Z.PV_Inv_PreGuard.noPoleRef t lambda (AspisR1.ExtractedCurrentQM31Exact.decode chi) →
                          nativeGuard = true →
                            ∀ (key : R1Z.PV_Inv_EntryReference.Key),
                              R1Z.PV_Inv_SourceTests.tests chi (R1Z.PV_Inv_RawInvoke.reached (s key)) =
                                Aeneas.Std.Result.ok
                                  (List.replicate (R1Z.PV_Inv_RawInvoke.reached (s key)).length false) :=
fun {W} [Zero W] [DecidableEq W] chi hc banks t join lambda weight registry enumeration es entry_join canon s run
    nativeGuard P_guard_equation helper_called key =>
  have safe :=
    (R1Z.PV_Inv_PreGuard.source_equation t lambda (AspisR1.ExtractedCurrentQM31Exact.decode chi)).mp
      (Eq.trans (Eq.symm P_guard_equation) helper_called);
  R1Z.PV_Inv_DecodedNativeTests.tests_false chi hc banks t join lambda weight registry enumeration es entry_join canon s
    run safe key
theorem R1Z.PV_Inv_HeadlineCharge.mass_at_existing_term : ∀ {K W C : Type} [inst : Field K] [Fintype K] [DecidableEq K]
  [Algebra (ZMod AspisCircleGroupOrder.P) K] [inst_4 : Zero W] [inst_5 : DecidableEq W] [inst_6 : Fintype C]
  (t : R0P.Trace K) (draw : Fin 8 → C → R0Z.JointView.Challenges K),
  (∀ (k : Fin 8), R1Z.PoleMassR1.Sem1Uniform (draw k) ((2 ^ 31 - 1) ^ 4 - 1)) →
    (R0Z.FsAbort.eventMass fun c => ∃ k, R1Z.PV_Inv_RegistryFamilyEvent.event t ((draw k c).sem 0) ((draw k c).sem 1)) ≤
      R1Z.PV_Inv_HeadlineCharge.existingPoleCharge :=
fun {K W C} [Field K] [Fintype K] [DecidableEq K] [Algebra (ZMod AspisCircleGroupOrder.P) K] [Zero W] [DecidableEq W]
    [Fintype C] t draw law =>
  R1Z.PV_Inv_RegistryFamilyEight.eight_attempts t draw ((2 ^ 31 - 1) ^ 4 - 1) law
