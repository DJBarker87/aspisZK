  cases hf : first data with
  | ok o =>
    try simp only [Aeneas.Std.bind_tc_ok]
    cases hc : copied o with
    | ok o1 =>
      have hr : o1 ≠ some 7#u8 := h o1 (by rw [hf]; exact hc)
