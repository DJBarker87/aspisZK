  "path": "/home/dombarker/.rustup/toolchains/nightly-2026-06-01-x86_64-unknown-linux-gnu/lib/rustlib/src/rust/library/core/src/alloc/layout.rs",
  "sha256": "19119ede8a60d1a989f907118f9e7f36e24434b8e931875f66a379b856784124",
  "bodies": [
    {
      "anchor": "pub const fn repeat_packed(",
      "body": "{\n        if let Some(size) = self.size.checked_mul(n) {\n            \n            Layout::from_size_alignment(size, self.align)\n        } else {\n            Err(LayoutError)\n        }\n    }"
    },
    {
      "anchor": "fn max_size_for_alignment(",
      "body": "{\n        \n\n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n\n        \n        \n        unsafe { unchecked_sub(isize::MAX as usize + 1, alignment.as_usize()) }\n    }"
    },
    {
      "anchor": "const fn is_size_alignment_valid(",
      "body": "{\n        size <= Self::max_size_for_alignment(alignment)\n    }"
    },
    {
      "anchor": "const fn from_size_alignment(",
      "body": "{\n        if Layout::is_size_alignment_valid(size, alignment) {\n            \n            Ok(Layout { size, align: alignment })\n        } else {\n            Err(LayoutError)\n        }\n    }"
    }
  ]
}
