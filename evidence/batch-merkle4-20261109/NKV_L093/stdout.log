theorem NKV_LeafSlot.source : ∀ (H : Bytes → State) (p : OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144)
  (batch kind : ℕ) (nodes : Slice U8) (before : reference.Scratch),
  eval H (MultiproofConeSlotState.slotState p q batch kind nodes before) =
    have leaf :=
      NKV_LeafBuild.build H p q kind (OraclePortFrozenOrder.sortedPositions q batch kind)
        (MultiproofConeSlotState.reset before);
    have tail := following H p batch kind nodes before leaf.2;
    (leaf.1 ++ tail.1, tail.2) :=
⋯
theorem NKV_LeafSlot.rejected : ∀ (H : Bytes → State) (p : OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144)
  (batch kind : ℕ) (nodes : Slice U8) (before bad : reference.Scratch),
  (NKV_LeafBuild.build H p q kind (OraclePortFrozenOrder.sortedPositions q batch kind)
          (MultiproofConeSlotState.reset before)).2 =
      ok (false, bad) →
    eval H (MultiproofConeSlotState.slotState p q batch kind nodes before) =
      ((NKV_LeafBuild.build H p q kind (OraclePortFrozenOrder.sortedPositions q batch kind)
            (MultiproofConeSlotState.reset before)).1,
        false, before) :=
⋯
