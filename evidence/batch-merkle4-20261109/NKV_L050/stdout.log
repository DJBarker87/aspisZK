theorem NKV_TraceCases.third_error.{u_1, u_2, u_3} : ∀ {E : Type} (c0 : Indices → Values → sorry)
  (c1 : Indices → Values → sorry) (c2 : Indices → Values → sorry) (first second third : List E) (error : verifier.Error)
  (i0 i1 i2 : Indices) (v0 v1 v2 : Values) (reply0 : sorry) (reply1 : sorry) (reply2 : sorry),
  three sorry sorry sorry = (first ++ (second ++ third), ok (core.result.Result.Err error)) :=
fun {E} c0 c1 c2 first second third error i0 i1 i2 v0 v1 v2 reply0 reply1 reply2 =>
  Eq.mpr
    (id
      (congrArg (fun _a => _a = (first ++ (second ++ third), ok (core.result.Result.Err error)))
        (three.eq_1 sorry sorry sorry)))
    sorry
theorem NKV_TraceCases.all_ok.{u_1, u_2, u_3} : ∀ {E : Type} (c0 : Indices → Values → sorry)
  (c1 : Indices → Values → sorry) (c2 : Indices → Values → sorry) (first second third : List E) (i0 i1 i2 : Indices)
  (v0 v1 v2 : Values) (reply0 : sorry) (reply1 : sorry) (reply2 : sorry),
  three sorry sorry sorry = (first ++ (second ++ third), ok (core.result.Result.Ok ())) :=
fun {E} c0 c1 c2 first second third i0 i1 i2 v0 v1 v2 reply0 reply1 reply2 =>
  Eq.mpr
    (id
      (congrArg (fun _a => _a = (first ++ (second ++ third), ok (core.result.Result.Ok ())))
        (three.eq_1 sorry sorry sorry)))
    sorry
theorem NKV_TraceCases.first_abort.{u_1, u_2} : ∀ {E : Type} (c0 : Indices → Values → sorry)
  (c1 : Indices → Values → sorry) (c2 : Indices → Values → sorry) (events : List E) (error : sorry) (reply : sorry),
  three sorry sorry sorry = (events, fail sorry) :=
fun {E} c0 c1 c2 events error reply =>
  Eq.mpr (id (congrArg (fun _a => _a = (events, fail sorry)) (three.eq_1 sorry sorry sorry))) sorry
theorem NKV_TraceCases.second_abort.{u_1, u_2, u_3} : ∀ {E : Type} (c0 : Indices → Values → sorry)
  (c1 : Indices → Values → sorry) (c2 : Indices → Values → sorry) (first second : List E) (error : sorry) (i0 : Indices)
  (v0 : Values) (reply0 : sorry) (reply1 : sorry), three sorry sorry sorry = (first ++ second, fail sorry) :=
fun {E} c0 c1 c2 first second error i0 v0 reply0 reply1 =>
  Eq.mpr (id (congrArg (fun _a => _a = (first ++ second, fail sorry)) (three.eq_1 sorry sorry sorry))) sorry
theorem NKV_TraceCases.third_abort.{u_1, u_2, u_3, u_4} : ∀ {E : Type} (c0 : Indices → Values → sorry)
  (c1 : Indices → Values → sorry) (c2 : Indices → Values → sorry) (first second third : List E) (error : sorry)
  (i0 i1 : Indices) (v0 v1 : Values) (reply0 : sorry) (reply1 : sorry) (reply2 : sorry),
  three sorry sorry sorry = (first ++ (second ++ third), fail sorry) :=
fun {E} c0 c1 c2 first second third error i0 i1 v0 v1 reply0 reply1 reply2 =>
  Eq.mpr (id (congrArg (fun _a => _a = (first ++ (second ++ third), fail sorry)) (three.eq_1 sorry sorry sorry))) sorry
