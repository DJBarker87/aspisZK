theorem NKV_TailLoop.source : ∀ (H : Bytes → HashState) (proof : Slice U8),
  (↑proof).length = 57607 →
    ∀ (p : OraclePortCompactDraft.Parsed),
      p.wire = MultiproofConeCanonical.bytesOf ↑proof →
        ∀ (root : Std.Array U8 32#usize) (batch : ℕ) (kind lo n slot : Usize),
          root = encodeState (OraclePortBatchDraft.committedRoot p ↑kind) →
            batch < 2 →
              ↑kind < 3 →
                ↑slot = 3 * batch + ↑kind →
                  ∀ (keys : Std.Array U64 16#usize) (s : reference.Scratch),
                    ↑s.n ≤ 16 →
                      ∃ nodes,
                        (NKV_ConcreteChildren.ops H).op3 proof slot = ok nodes ∧
                          reject
                              (NKV_FRef.verifier.candidate.batch_tree_loop (NKV_ConcreteChildren.ops H)
                                  (NKV_ConcreteChildren.digest H) proof root kind s.idx s.val () lo n slot keys s.n
                                  n >>=
                                returned) =
                            NKV_TailModel.model
                              (eval H (MultiproofConeVerifyState.tailState p batch (↑kind) nodes s)).2 :=
⋯
