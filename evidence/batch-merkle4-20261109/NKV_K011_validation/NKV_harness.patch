+use super::*;
+#[allow(non_snake_case)]
+mod kmx { include!(concat!(env!("CARGO_MANIFEST_DIR"),"/../../KMX_stubs.rs")); }
+include!(concat!(env!("CARGO_MANIFEST_DIR"),"/../../NKV_fragments.rs"));
