theorem NKV_TreeTotal.source : ∀ (H : Bytes → HashState) (proof : Slice U8),
  (↑proof).length = 57607 →
    ∀ (p : OraclePortCompactDraft.Parsed),
      p.wire = MultiproofConeCanonical.bytesOf ↑proof →
        ∀ (raw : Std.Array U32 22#usize) (root : Std.Array U8 32#usize) (batch kind : Usize),
          ↑batch < 2 →
            ↑kind < 3 →
              (∀ j < 22, ↑(↑raw)[j]! < 262144) →
                ∀ (idx : Indices) (val : Values),
                  ∃ r i v,
                    NKV_FRef.verifier.candidate.batch_tree (NKV_ConcreteChildren.ops H) (NKV_ConcreteChildren.digest H)
                        proof raw root batch kind idx val () =
                      ok (r, i, v) :=
⋯
'NKV_TreeTotal.source' depends on axioms: [propext, Classical.choice, Quot.sound]
