theorem NKV_PaddingChunks.total : ∀ (padding : Slice U8),
  ∃ ce, core.slice.Slice.chunks_exact padding 8#usize = ok ce ∧ ∀ chunk ∈ ce.chunks, (↑chunk).length = 8 :=
⋯
theorem NKV_PaddingChunks.scan : ∀ (H : Bytes → HashState) (padding : Slice U8),
  ∃ ce after verdict,
    core.slice.Slice.chunks_exact padding 8#usize = ok ce ∧
      (NKV_ConcreteChildren.ops H).op0 (core.iter.traits.iterator.IteratorChunksExact U8)
            (NKV_PaddingInstall.predicate H) ce () =
          ok (verdict, after) ∧
        verdict = (NKB_AnyModel.scan ce.chunks).1 :=
⋯
'NKV_PaddingChunks.total' depends on axioms: [propext, Classical.choice, Quot.sound]
'NKV_PaddingChunks.scan' depends on axioms: [propext, Classical.choice, Quot.sound]
