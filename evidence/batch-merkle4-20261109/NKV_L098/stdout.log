theorem NKV_TailContinue.source : ∀ (H : Bytes → AspisV8R19.SourceDuplexStep.State) (proof : Slice U8),
  (↑proof).length = 57607 →
    ∀ (p : OraclePortCompactDraft.Parsed),
      p.wire = bytesOf ↑proof →
        ∀ (root : Std.Array U8 32#usize) (batch : ℕ) (kind lo n slot : Usize),
          batch < 2 →
            ↑kind < 3 →
              ↑slot = 3 * batch + ↑kind →
                ∀ (keys : Std.Array U64 16#usize) (s : reference.Scratch),
                  ↑s.n ≤ 16 →
                    OraclePortFrozenOrder.wellFormed (NJV_UnitDomain.keys s) →
                      OraclePortFrozenOrder.nodeCount 18 (NJV_UnitDomain.keys s) ≤
                          OraclePortSelectedDraft.capacity (3 * batch + ↑kind) →
                        ∃ nodes,
                          (NKV_ConcreteChildren.ops H).op3 proof slot = ok nodes ∧
                            (↑nodes).length = 32 * OraclePortSelectedDraft.capacity (3 * batch + ↑kind) ∧
                              NKV_FRef.verifier.candidate.batch_tree_loop.body (NKV_ConcreteChildren.ops H)
                                  (NKV_ConcreteChildren.digest H) proof root kind () lo n slot keys s.idx s.val s.n n =
                                if
                                    MultiproofConePadding.scan
                                        (4 *
                                          (OraclePortSelectedDraft.capacity (3 * batch + ↑kind) -
                                            OraclePortFrozenOrder.nodeCount 18 (NJV_UnitDomain.keys s)))
                                        (List.drop (32 * OraclePortFrozenOrder.nodeCount 18 (NJV_UnitDomain.keys s))
                                          (bytesOf ↑nodes)) =
                                      true then
                                  ok
                                    (done
                                      (returned
                                        (eval H
                                            (NJV_TX2Returning.endpoint root
                                              (MultiproofConeSlotTail.prefixNodes nodes
                                                (OraclePortFrozenOrder.nodeCount 18 (NJV_UnitDomain.keys s)))
                                              s.idx s.val s.n)).2))
                                else ok (done (s.idx, s.val, core.result.Result.Err verifier.Error.Parse, true)) :=
⋯
