{"charon_version":"0.1.223","translated":{"crate_name":"nco_reference","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::validate_ref","crate::parse_record_ref","crate::parse_at_ref"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["core::option::Option","core::result::Result","core::option::_::ok_or"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-native-cpilot-20261028/NCO_reference.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"nco_reference","contents":"// Safe references. No Kani, unsafe code, observer, or function pointer.\npub fn row_shape_ref(row:u8)->Option<(u8,usize)>{\n match row {\n  0|1|3..=13=>Some((0,0)),2=>Some((1,32)),14=>Some((3,32)),\n  15..=24=>Some((2,896)),25=>Some((4,3712)),26=>Some((5,928)),_=>None,\n }\n}\npub fn compact_row_ref(row:u8)->bool{row>=14}\npub fn slot_offset_ref(slot:usize)->usize{\n let sizes=[146usize,146,128,172,172,150];\n let mut i=0;let mut at=28359;\n while i<slot {at+=32*sizes[i];i+=1;}at\n}\n#[derive(Clone,Copy,PartialEq,Eq)]\npub enum RefError{InvalidRow,Length(u8),Tag(u8),NonCanonical(u8,usize)}\npub fn validate_ref(row:u8,payload:&[u8])->Result<(),RefError>{\n let mut i=0;\n while i<payload.len()/32 {\n  let mut j=0;\n  while j<8 {\n   let at=32*i+4*j;\n   let word=(payload[at] as u32)|((payload[at+1] as u32)<<8)|((payload[at+2] as u32)<<16)|((payload[at+3] as u32)<<24);\n   if word>=2147483647 || (j>=4 && word!=0){return Err(RefError::NonCanonical(row,i));}\n   j+=1;\n  }i+=1;\n }Ok(())\n}\npub fn parse_record_ref(row:u8,record:&[u8])->Result<&[u8],RefError>{\n let (tag,size)=row_shape_ref(row).ok_or(RefError::InvalidRow)?;\n if record.len()!=5+size{return Err(RefError::Length(row));}\n if record[0]!=tag{return Err(RefError::Tag(row));}\n let size_wire=(record[1] as usize)|((record[2] as usize)<<8)|((record[3] as usize)<<16)|((record[4] as usize)<<24);\n if size_wire!=size{return Err(RefError::Length(row));}\n let payload=&record[5..];if row>=14 {validate_ref(row,payload)?;}Ok(payload)\n}\npub fn parse_at_ref(bytes:&[u8],row:u8,offset:usize)->Result<(&[u8],usize),RefError>{\n let length=5+row_shape_ref(row).unwrap().1;\n let end=offset+length;\n let framed=bytes.get(offset..end).ok_or(RefError::Length(row))?;\n parse_record_ref(row,framed)?;Ok((framed,end))\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/convert/