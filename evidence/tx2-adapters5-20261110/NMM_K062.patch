+   if (h.next>>level)&1==0 {assert!(frontier==v7_pair_empty_roots::V7_PAIR_EMPTY_ROOTS[level][word].0,"success establishes source frontier guard");}
+  }
+ }
+ assert!(input.bytes[observer]==before,"immutable input frame");
+}
