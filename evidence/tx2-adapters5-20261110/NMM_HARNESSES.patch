+ let len=if i<seeds.len(){Some(seeds[i].len())}else{None};
+ let byte=if i<seeds.len()&&j<seeds[i].len(){Some(seeds[i][j])}else{None};
+ let r=NMM_Pda{count:seeds.len(),len,byte,program:program.to_bytes()[j],reply:out.clone()};unsafe{let n=*c.nw.get();assert!(n<2,"legacy PDA prefix bound");(*c.pda.get())[n]=Some(r);*c.nw.get()=n+1;}out
+}
+fn NMM_pda_replay(seeds:&[&[u8]],program:&Pubkey)->Result<Pubkey,solana_program::pubkey::PubkeyError>{
+ let c=NMM_from_seeds(seeds);let record=unsafe{let n=*c.nr.get();assert!(n<2,"replayed PDA prefix bound");*c.nr.get()=n+1;(*c.pda.get())[n].take()};
+ assert!(record.is_some(),"same PDA reply present");match record{Some(r)=>{let i=c.probe_seed;let j=c.probe_byte;let len=if i<seeds.len(){Some(seeds[i].len())}else{None};let byte=if i<seeds.len()&&j<seeds[i].len(){Some(seeds[i][j])}else{None};assert!(r.count==seeds.len()&&r.program==program.to_bytes()[j],"exact PDA program window and arity");assert!(r.len==len&&r.byte==byte,"exact PDA seed length and byte window");match r.reply{Err(e)=>Err(e),Ok(_)=>{assert!(false,"selected first PDA error arm");Err(solana_program::pubkey::PubkeyError::InvalidSeeds)}}},None=>Err(solana_program::pubkey::PubkeyError::InvalidSeeds)}
