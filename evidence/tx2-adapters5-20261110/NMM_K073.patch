+    let registry = NMM_reg_replay(NMM_data_replay(registry_account)?)
+        .map_err(|_| ProgramError::InvalidAccountData)?;
+    let expected_registry = NMM_pda_replay(
+        &[
+            VERIFIER_REGISTRY_SEED,
+            master_account.key().as_ref(),
+            &[registry.bump],
+        ],
+        &registry_program,
