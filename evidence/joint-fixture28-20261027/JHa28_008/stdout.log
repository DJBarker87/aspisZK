def AspisR1Post25SamplerOrdinaryCallbackV2.candidateOrdinaryPublic : Aeneas.Std.Array Aeneas.Std.U8 32#usize →
  Aeneas.Std.Result AspisR1Post25SamplerOrdinaryCallbackV2.PE :=
fun block => do
  let x ← AspisR1Post25Sampler.sampler.ordinary_sample block
