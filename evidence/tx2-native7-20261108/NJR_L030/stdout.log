def NJJ_Common.run : AspisR1.NP6_StdModel.Reservation →
  AspisR1.NP6_StdModel.Reservation →
    NJJ_Common.Merkle →
      NJJ_Common.Finish →
        {H : Type} →
          VTop_Stages.aspis_core.digest.Digest32 H →
            Aeneas.Std.Slice Aeneas.Std.U8 →
              Aeneas.Std.Slice Aeneas.Std.U8 →
                Aeneas.Std.Slice Aeneas.Std.U8 →
                  H →
                    Option (VTop_Stages.verifier.Phase → Aeneas.Std.Result Unit) →
                      Aeneas.Std.Result (Aeneas.Std.core.result.Result Unit VTop_Stages.verifier.Error) :=
fun weightReservation rawReservation merkle finish {H} aspis_coredigestDigest32Inst public_bytes proof checkpoint hash
    obs =>
  do
  let r ←
    NJJ_Common.resume weightReservation aspis_coredigestDigest32Inst checkpoint proof public_bytes
        AspisR1Stage2.transport.Variant.S2 hash
  let cf ← Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
    | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue val =>
      let (p, a) := val
      if (a.next != NHT_Constants.compact.SPLIT) = true then
        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err AdapterRw.aspis_r1_cost_probe.verifier.Error.Checkpoint)
      else do
        let g ← NHT_PacketOps.powers 29#usize p.gamma
        NHV_ReleaseOps.mark obs AdapterRw.aspis_r1_cost_probe.verifier.Phase.CheckpointRead
        let i ← NHT_Constants.compact.OFF_INACTIVE
        let i1 ← NHT_Constants.compact.OFF_ROUND0
        let s ←
          Aeneas.Std.core.slice.index.Slice.index (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8)
              proof { start := i, «end» := i1 }
        let o ← NJC_ClosedCalls.inactive s
        let r1 ← NHT_Constants.core.option.Option.ok_or o AdapterRw.aspis_r1_cost_probe.verifier.Error.Parse
        let cf1 ← Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r1
        match cf1 with
          | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue val1 => do
            let i2 ← NHT_Constants.compact.OFF_FOLDED_ROOT
            let i3 ← NHT_Constants.compact.OFF_ROUND1
            let s1 ←
              Aeneas.Std.core.slice.index.Slice.index
                  (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8) proof
                  { start := i2, «end» := i3 }
            let r2 ← Aeneas.Std.core.array.TryFromArrayCopySlice.try_from 32#usize Aeneas.Std.core.marker.CopyU8 s1
            let folded_root ← Aeneas.Std.core.result.Result.unwrap Aeneas.Std.core.fmt.DebugTryFromSliceError r2
            let r3 ← merkle aspis_coredigestDigest32Inst proof p folded_root 1#usize hash
            let cf2 ← Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r3
            match cf2 with
              | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue a_1 => do
                NHV_ReleaseOps.mark obs
                    (AdapterRw.aspis_r1_cost_probe.verifier.Phase.Merkle NHT_Constants.compact.SPLIT)
                let r4 ← NJC_ClosedCalls.geometry p.queries a.next 22#usize
                let cf3 ← Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r4
                match cf3 with
                  | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue val2 =>
                    have s2 := a.weights.deref;
                    do
                    let r5 ← NJJ_Common.pending rawReservation s2
                    let cf4 ← Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r5
                    match cf4 with
                      | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue val3 => do
                        let r6 ← NJJ_Common.query proof p a g obs val2 val3 22#usize
                        let cf5 ← Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r6
                        match cf5 with
                          | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue val4 =>
                            let (a1, pending) := val4
                            do
                            let (s3, deref_mut_back) ← Aeneas.Std.lift a1.weights.deref_mut
                            let s4 ← AspisR1.Port3_FlushInstall.flush pending s3
                            have weights : Aeneas.Std.alloc.vec.Vec AspisR1Stage2.aspis_core.field.QM31 :=
                              deref_mut_back s4
                            let s5 ← Aeneas.Std.lift (Aeneas.Std.Array.empty Aeneas.Std.U8).to_slice
                            let s6 ← Aeneas.Std.lift (Aeneas.Std.Array.empty Aeneas.Std.U8).to_slice
                            let s7 ←
                              Aeneas.Std.core.slice.index.Slice.index
                                  (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8) proof
                                  { start := i1, «end» := i2 }
                            let i4 ← NHT_Constants.compact.OFF_FINAL
                            let s8 ←
                              Aeneas.Std.core.slice.index.Slice.index
                                  (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8) proof
                                  { start := i3, «end» := i4 }
                            let i5 ← NHT_Constants.compact.OFF_OPENINGS
                            let s9 ←
                              Aeneas.Std.core.slice.index.Slice.index
                                  (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8) proof
                                  { start := i4, «end» := i5 }
                            let s10 ← Aeneas.Std.lift (Aeneas.Std.Array.empty Aeneas.Std.U8).to_slice
                            finish
                                { variant := AspisR1Stage2.transport.Variant.S2, semantic := s5, y1 := s6,
                                  inactive := val1, round0 := s7, folded_root := none, round1 := s8,
                                  final_message := s9, query_bytes := s10 }
                                p { weights := weights, rhs := a1.rhs, power := a1.power, next := a1.next } obs
                          | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual =>
                            Aeneas.Std.core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
                              Unit (Aeneas.Std.core.convert.FromSame VTop_Stages.verifier.Error) residual
                      | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual =>
                        Aeneas.Std.core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
                          Unit (Aeneas.Std.core.convert.FromSame VTop_Stages.verifier.Error) residual
                  | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual =>
                    Aeneas.Std.core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual Unit
                      (Aeneas.Std.core.convert.FromSame VTop_Stages.verifier.Error) residual
              | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual =>
                Aeneas.Std.core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual Unit
                  (Aeneas.Std.core.convert.FromSame VTop_Stages.verifier.Error) residual
          | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual =>
            Aeneas.Std.core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual Unit
              (Aeneas.Std.core.convert.FromSame VTop_Stages.verifier.Error) residual
    | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual =>
      Aeneas.Std.core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual Unit
        (Aeneas.Std.core.convert.FromSame VTop_Stages.verifier.Error) residual
theorem NJR_FinishAtSourceView.at_source_view : ∀ (reserved : Bool) (r : AspisR1.NP6_StdModel.Reservation)
  (loc : AspisR1.NIW_AlignFinishComposed.Locations) {H : Type} (d : AspisR1Stage2.aspis_core.digest.Digest32 H)
  (ck proof pub : Aeneas.Std.Slice Aeneas.Std.U8) (hash : H) (p : AspisR1Stage2.verifier.Prepared)
  (a after : AspisR1Stage2.verifier.Accumulator)
  (g : Aeneas.Std.Array AspisR1Stage2.aspis_core.field.wide_exact.WideExact 29#usize)
  (geometry : AspisR1Stage2.verifier.QueryGeometry) (pending : AspisR1Stage2.verifier.BatchedWeights)
  (inactive : AspisR1Stage2.aspis_core.field.wide_exact.WideExact),
  (↑ck).length = 1768 →
    AspisR1Stage2.verifier.resumeWithOps (AspisR1.CheckpointBytes4Ops.ops reserved) d ck proof pub
          AspisR1Stage2.transport.Variant.S2 hash =
        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (p, a)) →
      ↑a.next = 10 →
        AspisR1.Port3_NativeQueryBody.verifier.candidate.query_loop
              (AspisR1.NFS_QueryOps.installed NJJ_QueryOps.concrete) proof p a g none geometry
              (AspisR1.NFW_QueryResume.pending a) 22#usize =
            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (after, pending)) →
          (↑proof).length = 57607 →
            AspisR1.Op4P_Install.sourceBody proof = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) →
              ∃ out,
                AspisR1.Port3_FlushInstall.flush pending after.weights.deref = Aeneas.Std.Result.ok out ∧
                  have actual := { weights := ⟨↑out, ⋯⟩, rhs := after.rhs, power := after.power, next := after.next };
                  ∀ (port : AspisR1.NIT_Cuts.PairPort) (afterOwner : ℕ),
                    AspisR1.NIW_AlignFinishPort.Cut p port afterOwner
                        (AspisR1.NJF_FinishObserved.G r loc (NJR_ViewFinish.view proof inactive) p actual).2.2 →
                      have execution :=
                        AspisR1.NJF_FinishObserved.G r loc (NJR_ViewFinish.view proof inactive) p actual;
                      AspisR1.Port3_NativeFinishBody.verifier.finish_relation (NIG_Slots.installed r)
                            (NJR_ViewFinish.view proof inactive) p actual none =
                          execution.1 ∧
                        (∀ event ∈ execution.2.1, AspisR1.NIW_AlignFinishInvocation.Clause r event) ∧
                          (∀ event ∈ execution.2.1,
                              AspisR1.NIW_AlignFinishDomains.Inputs p (NJR_ViewFinish.view proof inactive) actual
                                event) ∧
                            AspisR1.NIW_AlignFinishPrefix.Prefix execution.2.1 ∧
                              AspisR1.NIW_AlignFinishPairCertificate.Bound r execution.2.2 ∧
                                AspisR1.NIW_AlignFinishInfoEvent.HasPair execution ∧
                                  AspisR1.NIW_AlignFinishInfoNew.HasNew p execution ∧
                                    AspisR1.NIW_AlignFinishPort.Bound r port execution.2.2 :=
fun reserved r loc {H} d ck proof pub hash p a after g geometry pending inactive ckSize resume start query proofLength
    scan =>
  NJR_FinishInstall.at_call reserved r loc d ck proof pub hash p a after g geometry pending
    (NJR_ViewFinish.view proof inactive) ckSize resume start query proofLength rfl rfl rfl scan
theorem NJJ_DomainAudit.public_lengths : ∀ n ≤ Aeneas.Std.Usize.max, ∃ pubBytes, (↑pubBytes).length = n :=
fun n fits =>
  Exists.intro
    ⟨List.replicate n 0#u8, Eq.mpr (id (congrFun' (congrArg LE.le List.length_replicate) Aeneas.Std.Usize.max)) fits⟩
    List.length_replicate
theorem AspisR1.NJF_Root.finish : ∀ (r : AspisR1.NP6_StdModel.Reservation)
  (loc : AspisR1.NIW_AlignFinishComposed.Locations) (proof : Aeneas.Std.Slice Aeneas.Std.U8)
  (v : AspisR1Stage2.verifier.View) (p : AspisR1Stage2.verifier.Prepared) (a : AspisR1Stage2.verifier.Accumulator),
  NIG_FinishInput.Domain proof v p a →
    ∀ (port : AspisR1.NIT_Cuts.PairPort) (afterOwner : ℕ),
      AspisR1.NIW_AlignFinishPort.Cut p port afterOwner (AspisR1.NJF_FinishObserved.G r loc v p a).2.2 →
        have execution := AspisR1.NJF_FinishObserved.G r loc v p a;
        AspisR1.Port3_NativeFinishBody.verifier.finish_relation (NIG_Slots.installed r) v p a none = execution.1 ∧
          (∀ event ∈ execution.2.1, AspisR1.NIW_AlignFinishInvocation.Clause r event) ∧
            (∀ event ∈ execution.2.1, AspisR1.NIW_AlignFinishDomains.Inputs p v a event) ∧
              AspisR1.NIW_AlignFinishPrefix.Prefix execution.2.1 ∧
                AspisR1.NIW_AlignFinishPairCertificate.Bound r execution.2.2 ∧
                  AspisR1.NIW_AlignFinishInfoEvent.HasPair execution ∧
                    AspisR1.NIW_AlignFinishInfoNew.HasNew p execution ∧
                      AspisR1.NIW_AlignFinishPort.Bound r port execution.2.2 :=
fun r loc proof v p a domain port afterOwner cut =>
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          let execution := _a;
          AspisR1.Port3_NativeFinishBody.verifier.finish_relation (NIG_Slots.installed r) v p a none = execution.1 ∧
            (∀ event ∈ execution.2.1, AspisR1.NIW_AlignFinishInvocation.Clause r event) ∧
              (∀ event ∈ execution.2.1, AspisR1.NIW_AlignFinishDomains.Inputs p v a event) ∧
                AspisR1.NIW_AlignFinishPrefix.Prefix execution.2.1 ∧
                  AspisR1.NIW_AlignFinishPairCertificate.Bound r execution.2.2 ∧
                    AspisR1.NIW_AlignFinishInfoEvent.HasPair execution ∧
                      AspisR1.NIW_AlignFinishInfoNew.HasNew p execution ∧
                        AspisR1.NIW_AlignFinishPort.Bound r port execution.2.2)
        (AspisR1.NJF_FinishObserved.source r loc proof v p a domain)))
    (AspisR1.NIW_AlignComposedRoot.source r loc proof v p a domain port afterOwner
      (Eq.mp
        (congrArg (fun _a => AspisR1.NIW_AlignFinishPort.Cut p port afterOwner _a.2.2)
          (AspisR1.NJF_FinishObserved.source r loc proof v p a domain))
        cut))
structure NIG_FinishInput.Domain (proof : Aeneas.Std.Slice Aeneas.Std.U8) (v : AspisR1Stage2.verifier.View)
  (p : AspisR1Stage2.verifier.Prepared) (a : AspisR1Stage2.verifier.Accumulator) : Prop
number of parameters: 4
fields:
  NIG_FinishInput.Domain.accumulator : AspisR1.NGM_FinishDomain.AccumulatorDomain a
  NIG_FinishInput.Domain.s2 : p.variant = AspisR1Stage2.transport.Variant.S2
  NIG_FinishInput.Domain.claim : NBO_TailDomain.WideCanonical p.claim
  NIG_FinishInput.Domain.alpha : ∀ i < 2,
      ∀ (x : AspisR1Stage2.Stage2E), (↑p.alpha)[i]? = some x → NBO_TailDomain.WideCanonical x
  NIG_FinishInput.Domain.kappa : NBO_TailDomain.WideCanonical p.kappa
  NIG_FinishInput.Domain.semantic : ∀ q ∈ ↑p.semantic_alpha, NGW_NewInterface.CanonK q
  NIG_FinishInput.Domain.points : ∀ point ∈ ↑p.z, NGW_NewInterface.CanonK point.x ∧ NGW_NewInterface.CanonK point.y
  NIG_FinishInput.Domain.round0 : ↑v.round0 = List.take 224 (List.drop 7527 ↑proof)
  NIG_FinishInput.Domain.round1 : ↑v.round1 = List.take 224 (List.drop 7783 ↑proof)
  NIG_FinishInput.Domain.final : ↑v.final_message = List.take 2048 (List.drop 8007 ↑proof)
  NIG_FinishInput.Domain.round0_words : NIG_FinishInput.Windows v.round0 7
  NIG_FinishInput.Domain.round1_words : NIG_FinishInput.Windows v.round1 7
  NIG_FinishInput.Domain.final_words : NIG_FinishInput.Windows v.final_message 64
constructor:
  NIG_FinishInput.Domain.mk {proof : Aeneas.Std.Slice Aeneas.Std.U8} {v : AspisR1Stage2.verifier.View}
    {p : AspisR1Stage2.verifier.Prepared} {a : AspisR1Stage2.verifier.Accumulator}
    (accumulator : AspisR1.NGM_FinishDomain.AccumulatorDomain a) (s2 : p.variant = AspisR1Stage2.transport.Variant.S2)
    (claim : NBO_TailDomain.WideCanonical p.claim)
    (alpha : ∀ i < 2, ∀ (x : AspisR1Stage2.Stage2E), (↑p.alpha)[i]? = some x → NBO_TailDomain.WideCanonical x)
    (kappa : NBO_TailDomain.WideCanonical p.kappa) (semantic : ∀ q ∈ ↑p.semantic_alpha, NGW_NewInterface.CanonK q)
    (points : ∀ point ∈ ↑p.z, NGW_NewInterface.CanonK point.x ∧ NGW_NewInterface.CanonK point.y)
    (round0 : ↑v.round0 = List.take 224 (List.drop 7527 ↑proof))
    (round1 : ↑v.round1 = List.take 224 (List.drop 7783 ↑proof))
    (final : ↑v.final_message = List.take 2048 (List.drop 8007 ↑proof))
    (round0_words : NIG_FinishInput.Windows v.round0 7) (round1_words : NIG_FinishInput.Windows v.round1 7)
    (final_words : NIG_FinishInput.Windows v.final_message 64) : NIG_FinishInput.Domain proof v p a
