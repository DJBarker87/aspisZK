theorem NJR_ChecksumAtHeadline.accepted_pair : ∀ {F : Type} (adapter : AdapterRw.Ops) (base : VTop_Stages.Ops)
  (finish : AspisR1Stage2.Stage2Finish.FinishOps F) (native1 : First) (native2 : Second)
  (hashv : S2Z.Oracle.Parts → Result S2Z.Oracle.Digest),
  AeneasExtraction (Tx2I_Install.install adapter base finish) native1 native2 hashv →
    ∀ (program : Program) (accounts1 accounts2 : Accounts) (data1 data2 : Slice U8) (slot : Slot)
      (saved : alloc.vec.Vec U8),
      native1 program accounts1 data1 = ok (core.result.Result.Ok saved) →
        native2 program accounts2 data2 slot = ok (core.result.Result.Ok ()) →
          ∃ f s,
            SourceCuts (Tx2I_Install.install adapter base finish) accounts1 accounts2 saved f s ∧
              NJR_ChecksumDomain.Scope s.pub s.proof :=
fun {F} adapter base finish native1 native2 hashv extraction program accounts1 accounts2 data1 data2 slot saved
    accepted1 accepted2 =>
  let ⟨f, h✝⟩ :=
    cuts_of_acceptance (Tx2I_Install.install adapter base finish) native1 native2 hashv extraction program accounts1
      accounts2 data1 data2 slot saved accepted1 accepted2
  let ⟨s, cuts⟩ := h✝
  Exists.intro f
    (Exists.intro s ⟨cuts, NJR_ChecksumDomain.of_source_cuts adapter base finish accounts1 accounts2 saved f s cuts⟩)
'NJR_ChecksumAtHeadline.accepted_pair' depends on axioms: [propext, Classical.choice, Quot.sound]
