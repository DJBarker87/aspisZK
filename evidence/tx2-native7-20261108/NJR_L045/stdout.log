theorem NJR_AcceptedFinishDomain.reached : ∀ (reserved : Bool) (r : NP6_StdModel.Reservation) {H : Type}
  (d : aspis_core.digest.Digest32 H) (ck proof pub : Slice U8) (hash : H) (p : verifier.Prepared)
  (a after : verifier.Accumulator) (g : Std.Array aspis_core.field.wide_exact.WideExact 29#usize)
  (geometry : verifier.QueryGeometry) (pending : verifier.BatchedWeights)
  (inactive : aspis_core.field.wide_exact.WideExact) (out : Slice aspis_core.field.QM31),
  (↑ck).length = 1768 →
    verifier.resumeWithOps (CheckpointBytes4Ops.ops reserved) d ck proof pub transport.Variant.S2 hash =
        ok (core.result.Result.Ok (p, a)) →
      ↑a.next = 10 →
        Port3_NativeQueryBody.verifier.candidate.query_loop (NFS_QueryOps.installed NJJ_QueryOps.concrete) proof p a g
              none geometry (NFW_QueryResume.pending a) 22#usize =
            ok (core.result.Result.Ok (after, pending)) →
          Port3_FlushInstall.flush pending after.weights.deref = ok out →
            (↑proof).length = 57607 →
              Port4D_FinishInstall.finish (IDa_Deployed.finish r) (NJR_ViewFinish.view proof inactive) p
                    { weights := ⟨↑out, ⋯⟩, rhs := after.rhs, power := after.power, next := after.next } none =
                  ok (core.result.Result.Ok ()) →
                NIG_FinishInput.Domain proof (NJR_ViewFinish.view proof inactive) p
                  { weights := ⟨↑out, ⋯⟩, rhs := after.rhs, power := after.power, next := after.next } :=
fun reserved r {H} d ck proof pub hash p a after g geometry pending inactive out ckSize resume start query flush size
    accepted =>
  have dom := NID_ResumeFields.returned reserved d ck proof pub hash p a ckSize resume;
  have qdom :=
    NFW_QueryResume.domain p a dom.width (NID_ResumeQuery.weights a dom.weights)
      (NID_ResumeCallerDomain.wide a.rhs dom.rhs) (NID_ResumeCallerDomain.power a.power dom.power)
      (NID_ResumeCallerDomain.power p.rho dom.rho) start;
  let ⟨actual, h✝⟩ :=
    NGM_FinishDomain.tx2_writeback NJJ_QueryOps.concrete proof p a after g geometry (NFW_QueryResume.pending a) pending
      qdom start query
  let ⟨actualFlush, right✝⟩ := h✝
  let ⟨acc, right✝¹⟩ := right✝
  have same := Eq.symm (ok.inj (Eq.mp (congrArg (fun _a => _a = ok actual) flush) actualFlush));
  Eq.ndrec (motive := fun actual =>
    Port3_FlushInstall.flush pending after.weights.deref = ok actual →
      NGM_FinishDomain.AccumulatorDomain
          { weights := ⟨↑actual, actual.property⟩, rhs := after.rhs, power := after.power, next := after.next } →
        { weights := ⟨↑actual, actual.property⟩, rhs := after.rhs, power := after.power, next := after.next }.rhs =
              after.rhs ∧
            { weights := ⟨↑actual, actual.property⟩, rhs := after.rhs, power := after.power,
                    next := after.next }.power =
                after.power ∧
              { weights := ⟨↑actual, actual.property⟩, rhs := after.rhs, power := after.power,
                    next := after.next }.next =
                after.next →
          NIG_FinishInput.Domain proof (NJR_ViewFinish.view proof inactive) p
            { weights := ⟨↑out, out.property⟩, rhs := after.rhs, power := after.power, next := after.next })
    (fun actualFlush acc right =>
      let ⟨r0size, right✝²⟩ := lengths proof inactive size
      let ⟨r1size, finalSize⟩ := right✝²
      have words :=
        NJR_WindowsFromFinish.source r (NJR_ViewFinish.view proof inactive) p
          { weights := ⟨↑out, out.property⟩, rhs := after.rhs, power := after.power, next := after.next } dom.variant
          acc.width r0size r1size finalSize accepted;
      { accumulator := acc, s2 := dom.variant, claim := NID_ResumeCallerDomain.wide p.claim dom.claim,
        alpha := fun i a_1 x hx => NID_ResumeCallerDomain.wide x (dom.alpha x (List.mem_of_getElem? hx)),
        kappa := NID_ResumeCallerDomain.wide p.kappa dom.kappa,
        semantic := fun q hq =>
          have h := dom.semantic q hq;
          ⟨⟨h.left, h.right.left⟩, h.right.right⟩,
        points := fun point hp =>
          have h := dom.coordinates point hp;
          ⟨⟨⟨h.left.left, h.left.right.left⟩, h.left.right.right⟩,
            ⟨⟨h.right.left, h.right.right.left⟩, h.right.right.right⟩⟩,
        round0 := rfl, round1 := rfl, final := rfl, round0_words := words.left, round1_words := words.right.left,
        final_words := words.right.right })
    (Eq.symm same) actualFlush acc right✝¹
'NJR_AcceptedFinishDomain.lengths' depends on axioms: [propext, Classical.choice, Quot.sound]
'NJR_AcceptedFinishDomain.reached' depends on axioms: [propext, Classical.choice, Quot.sound]
