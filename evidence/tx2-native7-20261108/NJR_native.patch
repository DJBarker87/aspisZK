+ // One entered iteration of the frozen for-loop, arbitrary pre-state.
+ let out=weights.iter_mut().nth(i).unwrap();
+ let value=match log.read(&mut reader){Ok(value)=>value,Err(e)=>{
+  // Explicit desugaring of the owned Vec drop in the frozen ? error arm.
+  log.freed_ptr=weights.as_ptr();log.freed_len=weights.len();log.freed_cap=weights.capacity();
+  drop(weights);log.freed=!cfg!(NJR_bad_drop);return Err(e);
+ }};
+ at=reader.at;*out=value;Ok((weights,at))
+}
