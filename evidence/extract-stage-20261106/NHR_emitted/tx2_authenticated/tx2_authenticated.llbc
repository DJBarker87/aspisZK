lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":521},{"Deduplicated":518}],"output":{"Deduplicated":519}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":4,"item_meta":{"name":[{"Ident":["aspis_r1_cost_probe",0]},{"Ident":["verifier",0]},{"Ident":["candidate",0]},{"Ident":["tx2_common",0]}],"span":{"data":{"file_id":0,"beg":{"line":294,"col":0},"end":{"line":322,"col":1}},"generated_from_span":null},"source_text":"fn tx2_common<H: Digest32>(public_bytes: &[u8], proof: &[u8], checkpoint: &[u8], hash: H, obs: Observer) -> Result<(), Error> {\n    let (p, a) = resume(checkpoint, proof, public_bytes, Variant::S2, hash)?;\n    if a.next != SPLIT {\n        return Err(Error::Checkpoint);\n    }\n    let g = powers::<29>(p.gamma);\n    mark(obs, Phase::CheckpointRead);\n    let inactive = E::from_le_bytes(&proof[compact::OFF_INACTIVE..compact::OFF_ROUND0]).ok_or(Error::Parse)?;\n    let folded_root: [u8; 32] = proof[compact::OFF_FOLDED_ROOT..compact::OFF_ROUND1].try_into().unwrap();\n    batch_merkle(proof, &p, &folded_root, 1, hash)?;\n    mark(obs, Phase::Merkle(SPLIT));\n    let geometry = QueryGeometry::for_range(&p.queries, a.next, 22)?;\n    let pending = BatchedWeights::new(&a.weights)?;\n    let (a, pending) = query_loop(proof, &p, a, &g, obs, &geometry, pending, 22)?;\n    // End the loop accumulator borrow before finishing its weights.\n    let Accumulator { mut weights, rhs, power, next } = a;\n    pending.finish(&mut weights);\n    let a = Accumulator { weights, rhs, power, next };\n    // Construct only the relation view after the last proof-consuming loop.\n    let v = View {\n        variant: Variant::S2, semantic: &[], y1: &[], inactive,\n        round0: &proof[compact::OFF_ROUND0..compact::OFF_FOLDED_ROOT],\n        folded_root: None,\n        round1: &proof[compact::OFF_ROUND1..compact::OFF_FINAL],\n        final_message: &proof[compact::OFF_FINAL..compact::OFF_OPENINGS],\n        query_bytes: &[],\n    };\n    finish_relation(&v, &p, &a, obs)\n}","attr_info":{"attributes":[],"inline":"Never","rename":null,"public":false},"is_local":true,"opacity":"Opaque","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"H"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{"line":294,"col":17},"end":{"line":294,"col":25}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":1134}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":1157},{"Deduplicated":1158},{"Deduplicated":1159},{"Deduplicated":1134},{"Deduplicated":521}],"output":{"Deduplicated":557}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":5,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["result",0]},{"Impl":{"Trait":1}},{"Ident":["from_residual",0]}],"span":{"data":{"file_id":7,"beg":{"line":2192,"col":4},"end":{"line":2192,"col":70}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T"},{"index":1,"name":"E"},{"index":2,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":7,"beg":{"line":2187,"col":20},"end":{"line":2187,"col":35}},"generated_from_span":null},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[