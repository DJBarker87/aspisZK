                                ⟨publicFacts,
                                  ⟨sourceFacts,
                                    ⟨AspisR1.T2R_Nonvacuity.same_cuts L sdk copy std allocator e1 e2 w1 w2 admission1
                                        admission2 c native1 native2 prepareOwner primitiveOwner hashv extraction sha256
                                        H p1 syscall program data1 data2 slot state1 state2 final1 final2 saved post1
                                        post2 accepted1 accepted2 f s cuts writer reader,
                                      caller⟩⟩⟩⟩⟩))))))))⟩⟩⟩
