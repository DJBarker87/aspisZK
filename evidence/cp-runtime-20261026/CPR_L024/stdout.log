fun {W A F CoreError Tx Key} L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 c native1 native2 prepareOwner
    primitiveOwner hashv extraction sha256 H p1 syscall program data1 data2 slot state1 state2 final1 final2 saved post1
    post2 accepted1 accepted2 root length prior D P Q0 Q1 hqueries runtime raw binding adversary chooseSecond
    prefixBound choiceBound project keyLaw initial layout1 entry1 actions positive next ordinary before tentative
    success loaded law t u physicalKey adjacent eligible tentativeView status entry2View =>
  let ⟨driverEq, right✝⟩ :=
    AspisR1.T2R_Top.deployed L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 c native1 native2 prepareOwner
      primitiveOwner hashv extraction sha256 H p1 syscall program data1 data2 slot state1 state2 final1 final2 saved
      post1 post2 accepted1 accepted2 root length prior D P Q0 Q1 hqueries runtime raw binding adversary chooseSecond
      prefixBound choiceBound project
  let ⟨sdkEq, right✝¹⟩ := right✝
  let ⟨headline, original⟩ := right✝¹
  let ⟨f, h✝⟩ := original
  let ⟨s, h✝¹⟩ := h✝
  let ⟨outer, h✝²⟩ := h✝¹
  let ⟨pre, h✝³⟩ := h✝²
  let ⟨middle, h✝⁴⟩ := h✝³
  let ⟨fs, h✝⁵⟩ := h✝⁴
  let ⟨ss, h✝⁶⟩ := h✝⁵
  let ⟨run, h✝⁷⟩ := h✝⁶
  let ⟨tx2, h✝⁸⟩ := h✝⁷
  let ⟨calls, right✝²⟩ := h✝⁸
  let ⟨base, right✝³⟩ := right✝²
  let ⟨publicFacts, right✝⁴⟩ := right✝³
  let ⟨parser, right✝⁵⟩ := right✝⁴
  let ⟨acceptance, caller⟩ := right✝⁵
  let version :=
    AspisR1.CPR_DataWriter.on_cuts (AspisR1.DrvC_FirstConstants.configuration c) keyLaw native1 native2 hashv extraction
      copy std allocator program initial layout1 e1 e2 entry1 data1 state1 final1 saved post1 accepted1 actions positive
      next ordinary before tentative success loaded law t u physicalKey adjacent eligible tentativeView status
      entry2View f s base.left;
  ⟨driverEq,
    ⟨sdkEq,
      ⟨headline,
        Exists.intro f
          (Exists.intro s
            (Exists.intro outer
              (Exists.intro pre
                (Exists.intro middle
                  (Exists.intro fs
                    (Exists.intro ss
                      (Exists.intro run
                        (Exists.intro tx2
                          ⟨calls,
                            ⟨base,
                              ⟨publicFacts,
                                ⟨parser,
                                  ⟨Nonempty.intro version,
                                    ⟨AspisR1.S2X.checkpoint_persistence
                                        (AspisR1.S2W_EntryWriteHistory.payloadBytes
                                          AspisR1.S2W_ReturnedCheckpoint.encode (post1.payload (e1.heap.accounts 2).1)
                                          1768)
                                        (AspisR1.MultiproofConeCanonical.bytesOf ↑s.checkpoint) version,
                                      ⟨let ⟨i, h✝⁹⟩ := acceptance
                                        let ⟨pub, right✝⁶⟩ := h✝⁹
                                        let ⟨proof, right✝⁷⟩ := right✝⁶
                                        let ⟨tag, right✝⁸⟩ := right✝⁷
                                        let ⟨size, right✝⁹⟩ := right✝⁸
                                        let ⟨fit, accepted⟩ := right✝⁹
                                        Exists.intro i
                                          ⟨pub, ⟨proof, ⟨tag, ⟨size, ⟨fit, fun p2prime => accepted version p2prime⟩⟩⟩⟩⟩,
                                        caller version⟩⟩⟩⟩⟩⟩⟩))))))))⟩⟩⟩
