              (AspisR1.DrvC_FirstConstants.configuration c).geometry
              (AspisR1.DrvC_FirstConstants.configuration c).boundaries (AspisR1.DrvC_FirstConstants.configuration c).std
              (AspisR1.SdkD_PairBatches.current (AspisR1.DrvC_FirstConstants.configuration c).adapter
                (AspisR1.DrvC_FirstConstants.configuration c).currentBase
                (AspisR1.DrvC_FirstConstants.configuration c).stageBase
                (AspisR1.DrvC_FirstConstants.configuration c).finish
                (AspisR1.DrvC_FirstConstants.configuration c).reserved
                (AspisR1.DrvC_FirstConstants.configuration c).query
                (AspisR1.DrvC_FirstConstants.configuration c).geometry
                (AspisR1.DrvC_FirstConstants.configuration c).boundaries
                (AspisR1.DrvC_FirstConstants.configuration c).std)
              () (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.pub f.proof f.split saved run
              header1.right.right.left scanned.right.right;
          Exists.intro f
            (Exists.intro s
              (Exists.intro outer
                (Exists.intro pre
                  (Exists.intro middle
                    (Exists.intro fs
                      (Exists.intro ss
                        (Exists.intro run
                          (Exists.intro tx2
                            ⟨calls,
