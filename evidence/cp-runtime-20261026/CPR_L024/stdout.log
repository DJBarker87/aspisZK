    post2 accepted1 accepted2 root length prior D P Q0 Q1 hqueries runtime raw binding adversary chooseSecond
    prefixBound choiceBound project =>
  ⟨AspisR1.DrvC_SourceEntry.same_program c hashv,
    ⟨AspisR1.DrvC_Installation.aus1_dictionary (AspisR1.DrvC_FirstConstants.configuration c),
      ⟨AspisR1.DrvC_SourceHeadline.deployed_headline_source c D P Q0 Q1 hqueries hashv runtime raw binding adversary
          chooseSecond prefixBound choiceBound project,
        let ⟨f, h✝⟩ :=
          AspisR1.T2R_Pair.accepted L sdk copy std allocator e1 e2 w1 w2 admission1 admission2
            (AspisR1.DrvC_FirstConstants.configuration c).adapter
            (AspisR1.DrvC_FirstConstants.configuration c).currentBase
            (AspisR1.DrvC_FirstConstants.configuration c).reserved (AspisR1.DrvC_FirstConstants.configuration c).query
            (AspisR1.DrvC_FirstConstants.configuration c).geometry
            (AspisR1.DrvC_FirstConstants.configuration c).stageBase (AspisR1.DrvC_FirstConstants.configuration c).finish
            (AspisR1.DrvC_FirstConstants.configuration c).boundaries (AspisR1.DrvC_FirstConstants.configuration c).std
            native1 native2 prepareOwner primitiveOwner hashv extraction prior sha256 H p1 syscall program data1 data2
            slot state1 state2 final1 final2 saved post1 post2 accepted1 accepted2 AspisR1.Par_Parameters.deployed root
            length
        let ⟨s, h✝¹⟩ := h✝
        let ⟨outer, h✝²⟩ := h✝¹
        let ⟨pre, h✝³⟩ := h✝²
        let ⟨middle, h✝⁴⟩ := h✝³
        let ⟨fs, h✝⁵⟩ := h✝⁴
        let ⟨ss, h✝⁶⟩ := h✝⁵
        let ⟨run, h✝⁷⟩ := h✝⁶
        let ⟨tx2, h✝⁸⟩ := h✝⁷
        let ⟨calls, right✝⟩ := h✝⁸
        let ⟨base, right✝¹⟩ := right✝
        let ⟨publicFacts, caller⟩ := right✝¹
        match base with
        |
        ⟨cuts,
            ⟨writer,
              ⟨reader, ⟨multiproof, ⟨scanY, ⟨checkY, ⟨scanned, ⟨tx1, ⟨batches, ⟨header2, ⟨header1, rest⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩ =>
          have sourceFacts :=
            AspisR1.T2R_Parser.on_run
