+#[kani::stub(alloc::alloc::realloc,crate::NFO_KMX::KMX_realloc)]
+fn association(){
+ let n:usize=kani::any();kani::assume(n>0&&n<=(1usize<<31));
+ let layout=core::alloc::Layout::from_size_align(n,1).unwrap();
+ let pointer=unsafe{alloc::alloc::alloc_zeroed(layout)};kani::assume(!pointer.is_null());
+ {
+  let i:usize=kani::any();kani::assume(i<n);let byte:u8=kani::any();unsafe{pointer.add(i).write(byte);}
+  let whole=unsafe{core::slice::from_raw_parts(pointer,n)};
+  let suffix=&whole[i..];
+let mut iter=suffix.iter();let mut observed=iter.next().map(|b|(*b,b as *const u8));let mut remaining=iter.as_slice().len();
+assert!(observed==Some((byte,pointer.wrapping_add(i) as *const u8)));assert!(remaining==n-i-1);assert!(iter.as_slice().as_ptr()==pointer.wrapping_add(i+1));
+ }
+ unsafe{alloc::alloc::dealloc(pointer,layout);}
