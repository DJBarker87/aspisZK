FIq_Native.pool_v1.pair_forest_copy_terminal.Selectors.expand_loop0_loop0.eq_def {N : Usize}
  (iter : core.iter.adapters.rev.Rev (core.ops.range.Range Usize)) (weights : Std.Array field.QM31 N)
  (prepared : field.PreparedQm31Multiplier) :
  pool_v1.pair_forest_copy_terminal.Selectors.expand_loop0_loop0 iter weights prepared = do
    let (o, iter1) ←
      core.iter.adapters.rev.Rev.Insts.CoreIterTraitsIteratorIterator.next
          (core.ops.range.Range.Insts.DoubleEndedIterator core.iter.range.StepUsize) iter
    match o with
      | none => Result.ok weights
      | some index => do
        let parent ← weights.index_usize index
        let right ← prepared.mul parent
        let q ← parent.sub right
        let i ← 2#usize * index
        let weights1 ← weights.update i q
        let i1 ← i + 1#usize
        let a ← weights1.update i1 right
        pool_v1.pair_forest_copy_terminal.Selectors.expand_loop0_loop0 iter1 a prepared
def Aeneas.Std.core.slice.iter.IteratorSliceIter.next : {T : Type} →
  core.slice.iter.Iter T → Result (Option T × core.slice.iter.Iter T) :=
fun {T} it =>
  if h : it.i < ↑it.slice.len then
    have x := it.slice[it.i];
    have it := { slice := it.slice, i := it.i + 1 };
    Result.ok (some x, it)
  else Result.ok (none, it)
