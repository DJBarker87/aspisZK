theorem Aeneas.Std.Array.update_spec.{u} : ∀ {α : Type u} {n : Usize} (v : Std.Array α n) (i : Usize) (x : α),
  ↑i < v.length → v.update i x ⦃ nv => nv = v.set i x ⦄ :=
fun {α} {n} v i x hbound =>
  id
    (Eq.mpr
      (id
        (congrFun'
          (congrArg WP.spec
            (congrArg
              (fun x_1 =>
                match x_1 with
                | none => fail Error.arrayOutOfBounds
                | some val => ok ⟨(↑v).set (↑i) x, Array.set._proof_1 v i x⟩)
              (Array.getElem?_Usize_eq v i)))
          fun nv => nv = ⟨(↑v).set (↑i) x, Array.set._proof_1 v i x⟩))
      (Aeneas.Std.Array.index_usize.match_1.splitter✝
        (fun x_1 =>
          (↑v)[↑i]? = x_1 →
            (match (↑v)[↑i]? with
              | none => fail Error.arrayOutOfBounds
              | some val => ok ⟨(↑v).set (↑i) x, Array.set._proof_1 v i x⟩) ⦃
              nv => nv = ⟨(↑v).set (↑i) x, Array.set._proof_1 v i x⟩ ⦄)
        (↑v)[↑i]?
        (fun _ h =>
          Eq.ndrec (motive := fun x_1 =>
