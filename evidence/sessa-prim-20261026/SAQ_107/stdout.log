                        (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
                          List (AspisV8R19.DuplexFrames.Bytes × AspisV8R19.SourceDuplexStep.State) →
                            AspisR1.OraclePortCompactDraft.Parsed → Prop :=
fun {CoreError H} {installed} {reserved} {query} {geo} {D} {hash} {semantic} {pub proof} {split} {saved} run H_1 trace
    parsed =>
  ∀ (q : Fin 22 → Fin 262144) (tr : AspisR1.RawCutTranscriptRun.ErasedPrefix)
    (data : AspisR1.MatchingSupport.Data AspisR1.OraclePortCheckpointAbiC5.E)
    (rho : AspisR1.OraclePortCheckpointAbiC5.K),
    AspisR1.Port5Q1_QueryPorts.SessionAPrepare (AspisR1.Tx1Q_Carriers.prepared run.p) data q rho →
      AspisR1.LiteralMatchingData.read (AspisR1.OraclePortStoredDecisionDraftC4.typedRows parsed q tr) = some data →
        have state :=
          AspisR1.Tx1Q_Carriers.accumulator
            (have __src := run.out;
            { weights := ⟨↑run.flushed, ⋯⟩, rhs := __src.rhs, power := __src.power, next := __src.next });
        AspisR1.AuS1_Finish.Collision H_1 trace parsed q ∨
          AspisR1.CheckpointBytes5Output.accumulator state =
              (AspisR1.OraclePortCheckpointStateC3.write
                  (AspisR1.OraclePortCheckpointResumeC5.model data rho q)).accumulator ∧
            AspisR1.Port3_CheckpointInstall.writer (AspisR1.Tx1Q_Install.digest D)
                  (AspisR1.Tx1Q_Carriers.prepared run.p) state proof pub hash =
                Aeneas.Std.Result.ok saved ∧
              (↑run.flushed).length = 64 ∧ ↑run.out.next = 10
def AspisR1.SAQ_CompleteCont.Outcome : {F C : Type} →
  (adapterOps : AdapterRw.Ops) →
    (ops : AspisR1CurrentCaller.Ops) →
      (stageBase : VTop_Stages.Ops) →
        (finishOps : AspisR1Stage2.Stage2Finish.FinishOps F) →
          (reserved : Bool) →
            (queryOps : AspisR1.Port3_NativeQueryBody.Ops) →
              (geoOps : AspisR1.Port3_NativeGeometryBody.Ops C) →
                (B : AspisR1PublicPreparation.FinishModel.Boundaries) →
                  (claimsStd : AspisR1.ClaimsUnrolledFinish.StdCalls) →
                    AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes
                        AspisV8R19.SourceDuplexStep.State Unit →
                      (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
                        (f : AspisR1.S2W_NativeConsolidation.FirstCut) →
                          AspisR1.S2W_NativeConsolidation.SecondCut →
                            (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8) →
                              AspisR1.Tx1Q_Execution.Run
                                  (AspisR1.Tx1Q_Execution.actual (AspisR1.Op5T_Concrete.current ops) reserved queryOps
                                    geoOps B claimsStd)
                                  reserved queryOps geoOps
                                  (AspisR1.SdkD_PairBatches.current adapterOps ops stageBase finishOps reserved queryOps
                                    geoOps B claimsStd)
                                  () (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.pub f.proof f.split saved →
                                AspisR1.Cons_Native.Witness → Prop :=
fun {F C} adapterOps ops stageBase finishOps reserved queryOps geoOps B claimsStd prior H f s saved run tx2 =>
  ∃ authParsed frame,
    AspisR1.OraclePortCompactDraft.parse (AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof) = some authParsed ∧
      FS2.Duplex.Read
          ((AspisV8R19.MemoizedProgramLaw.eval H prior).1 ++
            AspisR1.AuS1_Recovery.log (AspisR1.Uni_Install.current ops reserved queryOps geoOps) B claimsStd
              (AspisR1.SdkD_PairBatches.current adapterOps ops stageBase finishOps reserved queryOps geoOps B claimsStd)
              (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.proof ()
              (Aeneas.Std.Array.repeat 29#usize run.zero))
          frame ∧
        AspisR1.BinRawByteCollisionTargets.pred 3 frame =
            some (AspisR1.OraclePortBatchDraft.committedRoot authParsed 2) ∧
          AspisR1.SAQ_CompleteTen.Outcome run H
              ((AspisV8R19.MemoizedProgramLaw.eval H prior).1 ++
                AspisR1.AuS1_Recovery.log (AspisR1.Uni_Install.current ops reserved queryOps geoOps) B claimsStd
                  (AspisR1.SdkD_PairBatches.current adapterOps ops stageBase finishOps reserved queryOps geoOps B
                    claimsStd)
                  (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.proof ()
                  (Aeneas.Std.Array.repeat 29#usize run.zero))
              authParsed ∧
            AspisR1.T2R_Finish.Outcome finishOps tx2.v2 tx2.p2
              (have __src := tx2.returned2;
              { weights := tx2.back2 tx2.flushed2, rhs := __src.rhs, power := __src.power, next := __src.next })
              s.proof saved H (AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof)
              (AspisR1.MultiproofConeCanonical.bytesOf ↑f.pub) run.p authParsed
              ((AspisV8R19.MemoizedProgramLaw.eval H prior).1 ++
                AspisR1.AuS1_Recovery.log (AspisR1.Uni_Install.current ops reserved queryOps geoOps) B claimsStd
                  (AspisR1.SdkD_PairBatches.current adapterOps ops stageBase finishOps reserved queryOps geoOps B
                    claimsStd)
                  (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.proof ()
                  (Aeneas.Std.Array.repeat 29#usize run.zero))
