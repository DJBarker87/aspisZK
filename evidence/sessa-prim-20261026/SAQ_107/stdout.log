  C → Aeneas.Std.Usize → Aeneas.Std.Result (Aeneas.Std.core.result.Result Aeneas.Std.Usize C) :=
fun {C} indexError u =>
  if u < 262144#usize then Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok u)
  else Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err indexError)
