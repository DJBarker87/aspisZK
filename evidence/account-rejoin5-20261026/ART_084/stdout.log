                            AspisR1.CPH_Program.verifier)
theorem AspisR1.ARQ_SupportedTransport.clean : ∀ {W A C Tx : Type}
  (L : AspisR1.S2Trust.Library W (ℕ → AspisR1.S2W_D189Entry.Record)),
  AspisR1.S2Trust.S2TrustedSdkBorrow L →
    ∀
      (copy :
        AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
          ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record)),
      AspisR1.S2W_TrustedStd.TrustedStd copy →
        ∀ (allocator : AspisR1.S2W_D189Wrappers.Allocator A)
          (c : AspisR1.DrvC_Installation.Configuration AspisR1.FIo_Install.W C) (err : C)
          (r : AspisR1.NP6_StdModel.Reservation) (native1 : AspisR1.S2W_ExtractionBoundary.First)
          (native2 : AspisR1.S2W_ExtractionBoundary.Second)
          (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest),
          AspisR1.S2W_DigestExtraction.AeneasExtraction
              (AspisR1.DrvC_Installation.sdk (AspisR1.FIp_Install.configuration err c r)) native1 native2 hashv →
            ∀ (a : AspisR1.SCE_Experiment.Adversary A) (root : Aeneas.Std.Array Aeneas.Std.U8 32#usize)
              (length : Aeneas.Std.U32)
              (prior :
                AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State
                  Unit)
              (words : AspisR1.CanonicalCutEnrichedTranscript.Words) (D : AspisR1.LiteralByteProtocol.Decoder),
              AspisR1.FIp_GlobalOwners.Owners (AspisR1.FIp_Install.configuration err c r)
                  (AspisR1.Rc2_Install.configuration (AspisR1.Rc5_Install.seed err (AspisR1.FIp_Install.select r c))
                      r).boundaries →
                ∀ (Q0 Q1 : ℕ),
                  (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
                      (AspisV8R19.MemoizedProgramLaw.eval H a.first).1.length ≤ Q0) →
                    (∀ (i : AspisR1.GExq_AccountExperiment.FirstInputs A)
                        (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
                        (post : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record)) (final : A)
                        (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
                        (AspisV8R19.MemoizedProgramLaw.eval H (a.second i saved post final)).1.length ≤ Q1) →
                      AspisR1.ARQ_WorldSupport.Supported L copy allocator c err r native1 native2 hashv a →
                        AspisR1.SCF_RequiredTransport.CleanAccountTransport (AspisR1.FIp_Install.configuration err c r)
                          D hashv copy allocator AspisR1.CPH_Program.verifier a Q0 Q1 AspisR1.ARQ_Observer.project
                          (AspisR1.ARQ_Observer.select (AspisR1.FIp_Install.configuration err c r)
                            AspisR1.CPH_Program.verifier) :=
fun {W A C Tx} L sdk copy std allocator c err r native1 native2 hashv extraction a root length prior words D owners Q0
    Q1 prefixBound choiceBound support H =>
  id fun accepted clean =>
    let ⟨n⟩ := support H accepted
    have branch :=
      AspisR1.ARQ_Join.accepted_recovery_or_account_collision L sdk copy std allocator a n.w1 n.w2 c err r native1
        native2 hashv extraction n.sha256 H n.p1 n.syscall n.final1 n.final2 n.saved n.post1 n.post2 n.admission1
        n.admission2 n.accepted1 n.accepted2 root length prior words n.p n.t n.u n.actions n.game n.RuntimePersistence D
        owners Q0 Q1 prefixBound choiceBound accepted;
    Or.casesOn branch
      (fun good =>
        have physical :=
          Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  AspisR1.ARQ_AccountView.physical (AspisR1.FIp_Install.configuration err c r) hashv copy allocator
                      AspisR1.CPH_Program.verifier a H =
                    AspisR1.F3T_Experiment.view
                      ((AspisV8R19.MemoizedProgramLaw.eval H
                            (AspisR1.SCE_Experiment.account (AspisR1.FIp_Install.configuration err c r) hashv copy
                              allocator AspisR1.CPH_Program.verifier a)).1,
                        AspisR1.F3T_Canon.canonInput
                          (AspisR1.F3T_ByteCarrier.input (AspisR1.FIp_Install.configuration err c r)
                            (AspisR1.SCE_Experiment.submitted _a)),
                        AspisR1.SCE_Experiment.accepted
                          (AspisV8R19.MemoizedProgramLaw.eval H
                              (AspisR1.SCE_Experiment.account (AspisR1.FIp_Install.configuration err c r) hashv copy
                                allocator AspisR1.CPH_Program.verifier a)).2))
                (AspisR1.SCE_Experiment.first_projection (AspisR1.FIp_Install.configuration err c r) hashv copy
                  allocator AspisR1.CPH_Program.verifier a H)))
            (Eq.refl
              (AspisR1.ARQ_AccountView.physical (AspisR1.FIp_Install.configuration err c r) hashv copy allocator
                AspisR1.CPH_Program.verifier a H));
        (Eq.mp
            (congrArg
              (fun _a =>
                AspisV8R19.MemoizedProgramLaw.eval H
                      (AspisR1.F3T_Installed.source (AspisR1.FIp_Install.configuration err c r) hashv
                        (AspisR1.F3T_ByteCarrier.input (AspisR1.FIp_Install.configuration err c r)
                          (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.SCE_Experiment.submission a)).2)) =
                    AspisV8R19.MemoizedProgramLaw.eval H
                      (AspisR1.F3_Model.verifier D
                        (AspisR1.F3T_ByteCarrier.input (AspisR1.FIp_Install.configuration err c r)
                          (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.SCE_Experiment.submission a)).2)) ∧
                  (AspisV8R19.MemoizedProgramLaw.eval H
                            (AspisR1.F3T_Charged.projected D
                              (AspisR1.F3T_Canon.canon
                                (AspisR1.F3T_ByteCarrier.lift (AspisR1.FIp_Install.configuration err c r)
                                  (AspisR1.SCE_Experiment.submission a))))).2.2 =
                      Bool.true ∧
                    AspisR1.OraclePortRefineJoin.RecoveredInputAgreement _a
                      (AspisV8R19.MemoizedProgramLaw.eval H
                        (AspisR1.F3T_Charged.projected D
                          (AspisR1.F3T_Canon.canon
                            (AspisR1.F3T_ByteCarrier.lift (AspisR1.FIp_Install.configuration err c r)
                              (AspisR1.SCE_Experiment.submission a))))))
              physical)
            good).right)
      fun bad => False.elim (clean bad)
'AspisR1.ARQ_SupportedTransport.clean' depends on axioms: [propext, Classical.choice, Quot.sound]
