          (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3T_Charged.charged D P)).1 ≤
        Q + 34 :=
fun D P Q hq H =>
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          AspisR1.DecodedFirstReadUnionBound.decoderFirstReads AspisR1.RecordedBinaryExperimentBin.dec FS.emptyTable
              _a.1 ≤
            Q + 34)
        (AspisR1.F3T_Charged.charged_eval D P H)))
    (id
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              AspisR1.DecodedFirstReadUnionBound.decoderFirstReads AspisR1.RecordedBinaryExperimentBin.dec FS.emptyTable
                  (_a.1, (_a.2.1.1, AspisR1.RawCutTranscriptRun.proof (AspisR1.F3T_Charged.build D _a) _a.2.1.2),
                      Bool.true).1 ≤
                Q + 34)
            (AspisR1.RawCutProverCompiler.experiment_eval (AspisR1.F3T_Projection.project P)
              (AspisR1.RawCutProverCompiler.verifier D fun x x_1 => Bool.true) H)))
        (Eq.mpr
