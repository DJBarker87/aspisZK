                (AspisV8R19.MemoizedProgramLaw.eval H
                    (AspisR1.RawCutProverCompiler.verifier D (fun x x_1 => Bool.true)
                      (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3T_Projection.project P)).2.1
                      (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3T_Projection.project P)).2.2)).1)))
          (have hp :=
            AspisR1.DecoderQueryAccounting.starts_le_queries AspisR1.RecordedBinaryExperimentBin.dec FS.emptyTable
