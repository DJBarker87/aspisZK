          Nat.add_le_add (LE.le.trans hp hlen)
            (AspisR1.BinHonestQueryBudget.verifier_starts D (fun x x_1 => Bool.true) H
              (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3T_Projection.project P)).2.1
              (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3T_Projection.project P)).2.2
              (AspisR1.DecodedFirstReadUnionBound.applyTrace FS.emptyTable
                (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3T_Projection.project P)).1))))))
