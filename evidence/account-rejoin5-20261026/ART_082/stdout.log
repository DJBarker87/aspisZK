fun {W A CoreError Tx} L sdk copy std allocator a w1 w2 c indexError reservation native1 native2 hashv extraction sha256
    H p1 syscall final1 final2 saved post1 post2 admission1 admission2 accepted1 accepted2 root length prior words p t u
    actions game RuntimePersistence D finishOwners Q0 Q1 prefixBound choiceBound =>
  id fun accepted clean coins =>
    Or.casesOn
      (AspisR1.ARQ_Join.accepted_recovery_or_account_collision L sdk copy std allocator a w1 w2 c indexError reservation
        native1 native2 hashv extraction sha256 H p1 syscall final1 final2 saved post1 post2 admission1 admission2
        accepted1 accepted2 root length prior words p t u actions game RuntimePersistence D finishOwners Q0 Q1
        prefixBound choiceBound accepted)
      (fun good =>
        AspisR1.SCF_Recovery.extract
          (AspisR1.ARQ_AccountView.physical (AspisR1.FIp_Install.configuration indexError c reservation) hashv copy
            allocator AspisR1.CPH_Program.verifier a H)
          (AspisV8R19.MemoizedProgramLaw.eval H
            (AspisR1.F3T_Charged.projected D
              (AspisR1.F3T_Canon.canon
                (AspisR1.F3T_ByteCarrier.lift (AspisR1.FIp_Install.configuration indexError c reservation)
                  (AspisR1.SCE_Experiment.submission a)))))
          good.right.right coins)
      fun bad => False.elim (clean bad)
'AspisR1.ARQ_PerCoin.extract' depends on axioms: [propext, Classical.choice, Quot.sound]
