                                AspisR1.GExq_Caller.sdk c.adapter c.currentBase c.stageBase c.finish c.reserved c.query
                                  c.geometry c.boundaries c.std →
                              ∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
                                AspisR1.SCE_Experiment.accepted
                                      (AspisV8R19.MemoizedProgramLaw.eval H
                                          (AspisR1.SCE_Experiment.account c hashv copy allocator id a)).2 =
                                    Bool.true →
                                  (AspisV8R19.MemoizedProgramLaw.eval H
                                          (AspisR1.F3T_Installed.source c hashv
                                            (AspisR1.F3T_ByteCarrier.input c
                                              (AspisV8R19.MemoizedProgramLaw.eval H
                                                  (AspisR1.SCE_Experiment.submission a)).2))).2 =
                                      Bool.true →
                                    AspisV8R19.MemoizedProgramLaw.eval H
                                          (AspisR1.F3T_Installed.source c hashv
                                            (AspisR1.F3T_ByteCarrier.input c
                                              (AspisV8R19.MemoizedProgramLaw.eval H
                                                  (AspisR1.SCE_Experiment.submission a)).2)) =
                                        AspisV8R19.MemoizedProgramLaw.eval H
                                          (AspisR1.F3_Model.verifier D
                                            (AspisR1.F3T_ByteCarrier.input c
                                              (AspisV8R19.MemoizedProgramLaw.eval H
                                                  (AspisR1.SCE_Experiment.submission a)).2)) ∨
                                      AspisR1.BinRawByteCollisionTargets.event
                                        AspisR1.SelectedTranscriptParams.params.iv (Q0 + Q1 + 2965)
                                        (AspisV8R19.MemoizedProgramLaw.eval H
                                          (AspisR1.Hiq_RecordedJoint.program
                                            (AspisR1.SCE_Experiment.account c hashv copy allocator id a)
                                            AspisR1.ARQ_Observer.project (AspisR1.ARQ_Observer.select c id)))
theorem AspisR1.ARQ_SourceBranch.accepted : ∀ {A F C : Type} (base : AspisR1.DrvC_Installation.Configuration F C)
  (seed : AspisR1Stage2.Stage2Finish.FinishOps F),
  base.finish = AspisR1.FIn_Install.finishOps seed →
    base.stageBase.op22 = Aeneas.Std.Result.ok 7527#usize ∧
        base.stageBase.op21 = Aeneas.Std.Result.ok 8007#usize ∧ base.stageBase.op20 = Aeneas.Std.Result.ok 10055#usize →
      ∀ (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
        (D : AspisR1.LiteralByteProtocol.Decoder) (w : AspisR1.CanonicalCutEnrichedTranscript.Words)
        (copy :
          AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
            ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
        (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (id : AspisR1.S2W_ExtractionBoundary.Program)
        (a : AspisR1.SCE_Experiment.Adversary A) (Q0 Q1 : ℕ),
        (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
            (AspisV8R19.MemoizedProgramLaw.eval H a.first).1.length ≤ Q0) →
          (∀ (i : AspisR1.GExq_AccountExperiment.FirstInputs A) (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
              (post : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record)) (final : A)
              (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
              (AspisV8R19.MemoizedProgramLaw.eval H (a.second i saved post final)).1.length ≤ Q1) →
            have c := AspisR1.F3V_Install.configuration base;
            AspisR1.WAdm_Domain.SessionAPrepare
                (AspisR1.Tx1Q_Execution.actual (AspisR1.Op5T_Concrete.current c.currentBase) c.reserved c.query
                  c.geometry c.boundaries c.std) →
              AspisR1.Port5Q1_QueryPorts.SessionAPrimitives c.query →
                AspisR1.Port5Q1_GeometryCanonical.SessionAPrimitives c.geometry →
                  AspisR1.Port5Q1_Domain.SessionADomain c.geometry →
                    c.geometry.op9 = AspisR1Qm31ArithmeticProbe.field.M31.mul →
                      c.geometry.op7 = Aeneas.Std.Result.ok 1#u32 →
                        c.geometry.op11 = AspisR1.Port4C_InverseExecution.inverse_owned →
                          AspisR1.FIp_GlobalOwners.Owners c base.boundaries →
                            AspisR1.DrvC_Installation.sdk c =
                                AspisR1.GExq_Caller.sdk c.adapter c.currentBase c.stageBase c.finish c.reserved c.query
                                  c.geometry c.boundaries c.std →
                              ∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
                                AspisR1.SCE_Experiment.accepted
                                      (AspisV8R19.MemoizedProgramLaw.eval H
                                          (AspisR1.SCE_Experiment.account c hashv copy allocator id a)).2 =
                                    Bool.true →
                                  (AspisV8R19.MemoizedProgramLaw.eval H
                                          (AspisR1.F3T_Installed.source c hashv
                                            (AspisR1.F3T_ByteCarrier.input c
                                              (AspisV8R19.MemoizedProgramLaw.eval H
                                                  (AspisR1.SCE_Experiment.submission a)).2))).2 =
                                      Bool.true →
                                    AspisV8R19.MemoizedProgramLaw.eval H
                                          (AspisR1.F3T_Installed.source c hashv
                                            (AspisR1.F3T_ByteCarrier.input c
                                              (AspisV8R19.MemoizedProgramLaw.eval H
                                                  (AspisR1.SCE_Experiment.submission a)).2)) =
                                        AspisV8R19.MemoizedProgramLaw.eval H
                                          (AspisR1.F3_Model.verifier D
                                            (AspisR1.F3T_ByteCarrier.input c
                                              (AspisV8R19.MemoizedProgramLaw.eval H
                                                  (AspisR1.SCE_Experiment.submission a)).2)) ∨
                                      AspisR1.BinRawByteCollisionTargets.event
                                        AspisR1.SelectedTranscriptParams.params.iv (Q0 + Q1 + 2965)
                                        (AspisV8R19.MemoizedProgramLaw.eval H
                                          (AspisR1.Hiq_RecordedJoint.program
                                            (AspisR1.SCE_Experiment.account c hashv copy allocator id a)
                                            AspisR1.ARQ_Observer.project (AspisR1.ARQ_Observer.select c id))) :=
fun {A F C} base seed installed positions hashv D w copy allocator id a Q0 Q1 prefixBound choiceBound =>
  _root_.id
    (let c := AspisR1.F3V_Install.configuration base;
    fun prepareOwner primitiveOwner canonicalOwner domainOwner multiply one inverse finishOwners aligned H accepted
      sourceSuccess =>
    let ⟨saved, h✝⟩ := AspisR1.SCG_AcceptedPair.replies c hashv copy allocator id a H accepted
    let ⟨post, h✝¹⟩ := h✝
    let ⟨final, h✝²⟩ := h✝¹
    let ⟨post2, h✝³⟩ := h✝²
    let ⟨final2, h✝⁴⟩ := h✝³
    let ⟨reply, reply2⟩ := h✝⁴
    let s := AspisR1.SCE_Experiment.submitted (AspisV8R19.MemoizedProgramLaw.eval H a.first).2;
    have success :=
      Eq.mp
        (congrFun'
          (congrArg Eq
            (congrArg Prod.snd
              (congrArg (AspisV8R19.MemoizedProgramLaw.eval H)
                (congrArg (AspisR1.F3T_Installed.source (AspisR1.F3V_Install.configuration base) hashv)
                  (congrArg (AspisR1.F3T_ByteCarrier.input (AspisR1.F3V_Install.configuration base))
                    (congrArg Prod.snd (AspisR1.SCE_Experiment.submission_eval a H)))))))
          Bool.true)
        sourceSuccess;
    let account := AspisR1.SCE_Experiment.account c hashv copy allocator id a;
    let ⟨e, h✝⁵⟩ :=
      AspisR1.ARQ_Canonical.accepted base seed installed positions hashv s H w (AspisR1.F3X_Account.prior account)
        prepareOwner D primitiveOwner canonicalOwner domainOwner multiply one inverse success
    let ⟨first, right✝⟩ := h✝⁵
    let ⟨i, h✝⁶⟩ := right✝
    let ⟨p, h✝⁷⟩ := h✝⁶
    let ⟨q, h✝⁸⟩ := h✝⁷
    let ⟨data, h✝⁹⟩ := h✝⁸
    let ⟨t, h✝¹⁰⟩ := h✝⁹
    let ⟨physical, right✝¹⟩ := h✝¹⁰
    let ⟨stored, right✝²⟩ := right✝¹
    let ⟨parser, right✝³⟩ := right✝²
    let ⟨query, right✝⁴⟩ := right✝³
    let ⟨found, right✝⁵⟩ := right✝⁴
    let ⟨calls, right✝⁶⟩ := right✝⁵
    let ⟨aux, right✝⁷⟩ := right✝⁶
    let ⟨shape, right✝⁸⟩ := right✝⁷
    let ⟨atPrepared, result⟩ := right✝⁸
    have inclusion :=
      AspisR1.ARQ_AccountPreparation.included c aligned base.boundaries hashv copy allocator id a saved post final H
        reply e first;
    have parsed :=
      have hp :=
        (AspisR1.OraclePortStoredParserC4.parsed i.stored
            (AspisR1.LiteralTranscript.erasePrefix
              (AspisV8R19.MemoizedProgramLaw.eval H
                  (AspisR1.F3J_SamplerRun.program i.proof 0 33 (FS.emptyPrefix i.semantic.value))).2)
            p parser).left;
      Eq.mp (congrArg (fun _a => AspisR1.OraclePortCompactDraft.parse _a = Option.some p) e.proofBytes)
        (Eq.mp (congrArg (fun _a => AspisR1.OraclePortCompactDraft.parse _a = Option.some p) stored) hp);
    have port := atPrepared.right.right.right.right.right.left;
    let ⟨out, h✝¹¹⟩ := atPrepared.right.right.right.right.right.right
    let ⟨v, h✝¹²⟩ := h✝¹¹
    let ⟨output, right✝⁹⟩ := h✝¹²
    let ⟨opening, right✝¹⁰⟩ := right✝⁹
    let ⟨prepared, right✝¹¹⟩ := right✝¹⁰
    let ⟨log, guard⟩ := right✝¹¹
    have savedQueries :=
      AspisR1.ARQ_SavedQueries.decoded c base.boundaries s H e prepareOwner primitiveOwner out output data.data q
        (AspisR1.SelectedChallengeMap.rhoOf data.rho) port;
    have actualQueries :=
      Eq.mpr
        (_root_.id
          (congrArg
            (fun _a =>
              AspisR1.OraclePortCheckpointPreparedC5.decodeQueries
                  (AspisR1.OraclePortCompactDraft.slice (AspisR1.MultiproofConeCanonical.bytesOf ↑_a) 320 88) =
                Option.some q)
            inclusion.left))
        savedQueries;
    have project :=
      AspisR1.ARQ_QueryProjection.on_reply c hashv copy allocator id a H saved post final p q reply parsed
        actualQueries;
    have charge := fun collision =>
      AspisR1.ARQ_Charge.cached_preparation c hashv copy allocator id a Q0 Q1 prefixBound choiceBound
        (AspisR1.F3X_Account.prior (AspisR1.F3X_Preparation.program c s)) H p q project
        (fun addr read =>
          inclusion.right addr
            (Eq.mp
              (congrArg (fun _a => FS2.Duplex.Read _a addr)
                (AspisR1.F3X_Account.prior_log (AspisR1.F3X_Preparation.program c s) H))
              read))
        (Eq.mpr
          (_root_.id
            (congrArg
              (fun _a =>
                AspisR1.AuS1_Finish.Collision H
                  ((AspisV8R19.MemoizedProgramLaw.eval H
                        (AspisR1.SCE_Experiment.account c hashv copy allocator id a)).1 ++
                    _a)
                  p q)
              (AspisR1.F3X_Account.prior_log (AspisR1.F3X_Preparation.program c s) H)))
          (have preparation := congrArg Prod.fst (AspisR1.F3X_Preparation.on_evidence c base.boundaries s H e);
          Eq.mp
            (congrArg
              (fun _a => AspisR1.AuS1_Finish.Collision H ((AspisV8R19.MemoizedProgramLaw.eval H account).1 ++ _a) p q)
              (Eq.symm preparation))
            (Eq.mp
              (congrArg
                (fun _a =>
                  AspisR1.AuS1_Finish.Collision H
                    (_a ++
                      AspisR1.AuS1_Recovery.log
                        (AspisR1.Uni_Install.current c.currentBase c.reserved c.query c.geometry) c.boundaries c.std
                        (AspisR1.F3V_RunEvidence.D1 c H) (AspisS6CurrentVerifierCarrier.toPublic e.semantic) e.proof ()
                        (Aeneas.Std.Array.repeat 29#usize e.run.zero))
                    p q)
                (AspisR1.F3X_Account.prior_log account H))
              collision)));
    have branch :=
      Or.casesOn result (fun collision => Or.inr (charge collision)) fun h =>
        let ⟨x, continuation⟩ := h
        Or.casesOn (continuation (finishOwners s H e i p q data t atPrepared calls shape x))
          (fun collision => Or.inr (charge collision)) fun same => Or.inl same;
    Eq.mpr
      (_root_.id
        (congrFun'
          (congrArg Or
            (congr
              (congrArg Eq
                (congrArg (AspisV8R19.MemoizedProgramLaw.eval H)
                  (congrArg (AspisR1.F3T_Installed.source (AspisR1.F3V_Install.configuration base) hashv)
                    (congrArg (AspisR1.F3T_ByteCarrier.input (AspisR1.F3V_Install.configuration base))
                      (congrArg Prod.snd (AspisR1.SCE_Experiment.submission_eval a H))))))
              (congrArg (AspisV8R19.MemoizedProgramLaw.eval H)
                (congrArg (AspisR1.F3_Model.verifier D)
                  (congrArg (AspisR1.F3T_ByteCarrier.input (AspisR1.F3V_Install.configuration base))
                    (congrArg Prod.snd (AspisR1.SCE_Experiment.submission_eval a H)))))))
          (AspisR1.BinRawByteCollisionTargets.event AspisR1.SelectedTranscriptParams.params.iv (Q0 + Q1 + 2965)
            (AspisV8R19.MemoizedProgramLaw.eval H
              (AspisR1.Hiq_RecordedJoint.program
                (AspisR1.SCE_Experiment.account (AspisR1.F3V_Install.configuration base) hashv copy allocator id a)
                AspisR1.ARQ_Observer.project
                (AspisR1.ARQ_Observer.select (AspisR1.F3V_Install.configuration base) id))))))
      branch)
'AspisR1.ARQ_SourceBranch.accepted' depends on axioms: [propext, Classical.choice, Quot.sound]
