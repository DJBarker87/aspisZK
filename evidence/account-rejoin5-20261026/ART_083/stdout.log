                                                    (AspisR1.F3T_Charged.projected D
                                                      (AspisR1.F3T_Canon.canon
                                                        (AspisR1.F3T_ByteCarrier.lift r
                                                          (AspisR1.SCE_Experiment.submission a))))) +
                                                AspisV8R19.CausalFirstHitUnionBound.indicator
                                                  (AspisR1.BinRawByteCollisionTargets.event
                                                    AspisR1.SelectedTranscriptParams.params.iv (Q0 + Q1 + 2965)
