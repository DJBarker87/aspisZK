                                                AspisV8R19.CausalFirstHitUnionBound.indicator
                                                  (AspisR1.BinRawByteCollisionTargets.event
                                                    AspisR1.SelectedTranscriptParams.params.iv (Q0 + Q1 + 2965)
                                                    (AspisV8R19.MemoizedProgramLaw.eval H
                                                      (AspisR1.Hiq_RecordedJoint.program
                                                        (AspisR1.SCE_Experiment.account r hashv copy allocator
                                                          AspisR1.CPH_Program.verifier a)
                                                        AspisR1.ARQ_Observer.project
                                                        (AspisR1.ARQ_Observer.select r
                                                          AspisR1.CPH_Program.verifier)))) :=
fun {W A CoreError Tx} L sdk copy std allocator a w1 w2 c indexError reservation native1 native2 hashv extraction sha256
    H p1 syscall final1 final2 saved post1 post2 admission1 admission2 accepted1 accepted2 root length prior words p t u
    actions game RuntimePersistence D finishOwners Q0 Q1 prefixBound choiceBound =>
  id
    (let r := AspisR1.FIp_Install.configuration indexError c reservation;
    let left := AspisR1.ARQ_AccountView.physical r hashv copy allocator AspisR1.CPH_Program.verifier a H;
    let right :=
      AspisV8R19.MemoizedProgramLaw.eval H
        (AspisR1.F3T_Charged.projected D
          (AspisR1.F3T_Canon.canon (AspisR1.F3T_ByteCarrier.lift r (AspisR1.SCE_Experiment.submission a))));
    let bad :=
      AspisR1.BinRawByteCollisionTargets.event AspisR1.SelectedTranscriptParams.params.iv (Q0 + Q1 + 2965)
        (AspisV8R19.MemoizedProgramLaw.eval H
          (AspisR1.Hiq_RecordedJoint.program
            (AspisR1.SCE_Experiment.account r hashv copy allocator AspisR1.CPH_Program.verifier a)
            AspisR1.ARQ_Observer.project (AspisR1.ARQ_Observer.select r AspisR1.CPH_Program.verifier)));
    have clean := fun accepted notBad =>
      Or.casesOn
        (AspisR1.ARQ_Join.accepted_recovery_or_account_collision L sdk copy std allocator a w1 w2 c indexError
          reservation native1 native2 hashv extraction sha256 H p1 syscall final1 final2 saved post1 post2 admission1
          admission2 accepted1 accepted2 root length prior words p t u actions game RuntimePersistence D finishOwners Q0
          Q1 prefixBound choiceBound accepted)
        (fun good => good.right) fun hit => False.elim (notBad hit);
    have domination := AspisR1.SCF_Domination.pointwise_of_agreement left right bad clean;
    Eq.mpr
      (id
        (congrArg
          (fun _a =>
            _a ≤
              AspisR1.RawRecordedOracleExtractionMassBin.failureMass
                  (AspisV8R19.MemoizedProgramLaw.eval H
                    (AspisR1.F3T_Charged.projected D
                      (AspisR1.F3T_Canon.canon
                        (AspisR1.F3T_ByteCarrier.lift (AspisR1.FIp_Install.configuration indexError c reservation)
                          (AspisR1.SCE_Experiment.submission a))))) +
                AspisV8R19.CausalFirstHitUnionBound.indicator
                  (AspisR1.BinRawByteCollisionTargets.event AspisR1.SelectedTranscriptParams.params.iv (Q0 + Q1 + 2965)
                    (AspisV8R19.MemoizedProgramLaw.eval H
                      (AspisR1.Hiq_RecordedJoint.program
                        (AspisR1.SCE_Experiment.account (AspisR1.FIp_Install.configuration indexError c reservation)
                          hashv copy allocator AspisR1.CPH_Program.verifier a)
                        AspisR1.ARQ_Observer.project
                        (AspisR1.ARQ_Observer.select (AspisR1.FIp_Install.configuration indexError c reservation)
                          AspisR1.CPH_Program.verifier)))))
          (AspisR1.SCE_AccountMass.pointwise (AspisR1.FIp_Install.configuration indexError c reservation) hashv copy
            allocator AspisR1.CPH_Program.verifier a H)))
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              AspisR1.RawRecordedOracleExtractionMassBin.failureMass
                  (AspisR1.F3T_Experiment.view
                    ((AspisV8R19.MemoizedProgramLaw.eval H
                          (AspisR1.SCE_Experiment.account (AspisR1.FIp_Install.configuration indexError c reservation)
                            hashv copy allocator AspisR1.CPH_Program.verifier a)).1,
                      AspisR1.F3T_Canon.canonInput
                        (AspisR1.F3T_ByteCarrier.input (AspisR1.FIp_Install.configuration indexError c reservation)
                          (AspisR1.SCE_Experiment.submitted _a)),
                      AspisR1.SCE_Experiment.accepted
                        (AspisV8R19.MemoizedProgramLaw.eval H
                            (AspisR1.SCE_Experiment.account (AspisR1.FIp_Install.configuration indexError c reservation)
                              hashv copy allocator AspisR1.CPH_Program.verifier a)).2)) ≤
                AspisR1.RawRecordedOracleExtractionMassBin.failureMass
                    (AspisV8R19.MemoizedProgramLaw.eval H
                      (AspisR1.F3T_Charged.projected D
                        (AspisR1.F3T_Canon.canon
                          (AspisR1.F3T_ByteCarrier.lift (AspisR1.FIp_Install.configuration indexError c reservation)
                            (AspisR1.SCE_Experiment.submission a))))) +
                  AspisV8R19.CausalFirstHitUnionBound.indicator
                    (AspisR1.BinRawByteCollisionTargets.event AspisR1.SelectedTranscriptParams.params.iv
                      (Q0 + Q1 + 2965)
                      (AspisV8R19.MemoizedProgramLaw.eval H
                        (AspisR1.Hiq_RecordedJoint.program
                          (AspisR1.SCE_Experiment.account (AspisR1.FIp_Install.configuration indexError c reservation)
                            hashv copy allocator AspisR1.CPH_Program.verifier a)
                          AspisR1.ARQ_Observer.project
                          (AspisR1.ARQ_Observer.select (AspisR1.FIp_Install.configuration indexError c reservation)
                            AspisR1.CPH_Program.verifier)))))
            (AspisR1.SCE_Experiment.first_projection (AspisR1.FIp_Install.configuration indexError c reservation) hashv
              copy allocator AspisR1.CPH_Program.verifier a H)))
        domination))
'AspisR1.ARQ_Domination.pointwise' depends on axioms: [propext, Classical.choice, Quot.sound]
