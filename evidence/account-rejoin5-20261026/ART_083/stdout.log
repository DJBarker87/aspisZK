                                    (AspisR1.CPG_Projection.ordinary p (AspisR1.Hist_Nonvacuity.key 0#u8))
                                    (AspisR1.CPG_Projection.before p) (AspisR1.CPG_Projection.tentative p)
                                    (AspisR1.CPG_Projection.success p) (AspisR1.CPG_Projection.loaded p) →
