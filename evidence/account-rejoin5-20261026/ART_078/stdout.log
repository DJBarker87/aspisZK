                                            Bool.true ∨
                                          AspisR1.BinRawByteCollisionTargets.event
                                            AspisR1.SelectedTranscriptParams.params.iv (Q0 + Q1 + 2965)
                                            (AspisV8R19.MemoizedProgramLaw.eval H
                                              (AspisR1.Hiq_RecordedJoint.program
                                                (AspisR1.SCE_Experiment.account r hashv copy allocator
                                                  AspisR1.CPH_Program.verifier a)
                                                AspisR1.ARQ_Observer.project
                                                (AspisR1.ARQ_Observer.select r AspisR1.CPH_Program.verifier))) :=
fun {W A CoreError Tx} L sdk copy std allocator a w1 w2 c indexError reservation native1 native2 hashv extraction sha256
    H p1 syscall final1 final2 saved post1 post2 admission1 admission2 accepted1 accepted2 root length prior words p t u
    actions game RuntimePersistence Q0 Q1 prefixBound choiceBound =>
  id
    (let r := AspisR1.FIp_Install.configuration indexError c reservation;
    have native :=
      AspisR1.SCG_SharedNative.accepted L sdk copy std allocator a w1 w2 (AspisR1.FIp_Install.select reservation c)
        indexError reservation native1 native2 hashv extraction sha256 H p1 syscall final1 final2 saved post1 post2
        admission1 admission2 accepted1 accepted2 root length prior words p t u actions game RuntimePersistence Q0 Q1
        prefixBound choiceBound AspisR1.ARQ_Observer.project;
    let ⟨f, h✝⟩ := native
    let ⟨s, h✝¹⟩ := h✝
    let ⟨outer, h✝²⟩ := h✝¹
    let ⟨pre, h✝³⟩ := h✝²
    let ⟨middle, h✝⁴⟩ := h✝³
    let ⟨fs, h✝⁵⟩ := h✝⁴
    let ⟨ss, h✝⁶⟩ := h✝⁵
    let ⟨run, h✝⁷⟩ := h✝⁶
    let ⟨tx2, h✝⁸⟩ := h✝⁷
    let ⟨origin, right✝⟩ := h✝⁸
    let ⟨calls, right✝¹⟩ := right✝
    let ⟨encoding, right✝²⟩ := right✝¹
    let ⟨baseFacts, right✝³⟩ := right✝²
    let ⟨initial, right✝⁴⟩ := right✝³
    let ⟨selected, right✝⁵⟩ := right✝⁴
    let ⟨publicFacts, right✝⁶⟩ := right✝⁵
    let ⟨parser, right✝⁷⟩ := right✝⁶
    let ⟨version, h✝⁹⟩ := right✝⁷
    let ⟨writerKey, right✝⁸⟩ := h✝⁹
    let ⟨readerKey, right✝⁹⟩ := right✝⁸
    let ⟨events, right✝¹⁰⟩ := right✝⁹
    let ⟨persistent, right✝¹¹⟩ := right✝¹⁰
    let ⟨packet, right✝¹²⟩ := right✝¹¹
    let ⟨safe, right✝¹³⟩ := right✝¹²
    let ⟨whole, branch⟩ := right✝¹³
    Or.casesOn branch (fun bad => Or.inr bad) fun good =>
      let ⟨i, h✝¹⁰⟩ := good.right.left
      let ⟨pub, right✝¹⁴⟩ := h✝¹⁰
      let ⟨proof, right✝¹⁵⟩ := right✝¹⁴
      let ⟨tag, right✝¹⁶⟩ := right✝¹⁵
      let ⟨size, right✝¹⁷⟩ := right✝¹⁶
      let ⟨yes, nonempty⟩ := right✝¹⁷
      Or.inl
        (AspisR1.ARQ_ByteSourceAccepts.accepted r hashv (AspisR1.DrvC_Implementation.driver r)
          (AspisR1.DrvC_SourceEntry.same_program
            (AspisR1.Rc3_Install.select (AspisR1.Rc5_Install.seed indexError (AspisR1.FIp_Install.select reservation c))
              reservation)
            hashv)
          a H
          ((AspisV8R19.MemoizedProgramLaw.eval H
                    (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1 final1)).2.entry.second
            AspisR1.S2W_D189Wrappers.secondSizes)
          saved f s baseFacts.left i pub proof yes))
'AspisR1.ARQ_SourceAlternative.accepted' depends on axioms: [propext, Classical.choice, Quot.sound]
