                                    (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
                                        (AspisV8R19.MemoizedProgramLaw.eval H a.first).1.length ≤ Q0) →
                                      (∀ (i : AspisR1.GExq_AccountExperiment.FirstInputs A)
                                          (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
                                          (post : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record)) (final : A)
                                          (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
