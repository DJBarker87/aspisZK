fun {A C Tx} base err reservation hashv copy std allocator native1 native2 extraction a H saved post1 post2 final1
    final2 accepted1 accepted2 p t u actions game RuntimePersistence =>
  AspisR1.SCJ_NativeLoaded.entry_loaded p t u (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.entry
    (AspisV8R19.MemoizedProgramLaw.eval H
          (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1 final1)).2.entry
    saved actions (AspisR1.FIp_Install.configuration err base reservation)
    (AspisR1.Rc5_Install.key err (AspisR1.FIp_Install.select reservation base) reservation) native1 native2 hashv
    extraction copy std allocator AspisR1.CPH_Program.verifier (AspisR1.Hist_Nonvacuity.key 0#u8)
    AspisR1.CPH_Program.not_system (AspisR1.CPH_Game.recordedInstance game)
    (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.data
    (AspisV8R19.MemoizedProgramLaw.eval H
          (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1 final1)).2.data
    (AspisV8R19.MemoizedProgramLaw.eval H
          (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1 final1)).2.slot
    (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.state
    (AspisV8R19.MemoizedProgramLaw.eval H
          (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1 final1)).2.state
    final1 final2 post1 post2 accepted1 accepted2 RuntimePersistence
