@AspisR1.ARQ_NativeReplies.accepted : ∀ {A C : Type}
  (base : AspisR1.DrvC_Installation.Configuration AspisR1.FIo_Install.W C) (err : C)
  (reservation : AspisR1.NP6_StdModel.Reservation)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (native1 : AspisR1.S2W_ExtractionBoundary.First)
  (native2 : AspisR1.S2W_ExtractionBoundary.Second),
  AspisR1.S2W_DigestExtraction.AeneasExtraction
      (AspisR1.DrvC_Installation.sdk (AspisR1.FIp_Install.configuration err base reservation)) native1 native2 hashv →
    ∀ (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      AspisR1.S2W_ExtractionBoundary.P1 sha256 H →
        AspisR1.S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
          ∀ (a : AspisR1.SCE_Experiment.Adversary A) (id : AspisR1.S2W_ExtractionBoundary.Program)
            (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
            (post1 post2 : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record)) (final1 final2 : A),
            AspisR1.S2W_D189Wrappers.first native1 copy allocator (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.entry
                  id (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.data
                  (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.state =
                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post1, final1)) →
              (have j :=
                  (AspisV8R19.MemoizedProgramLaw.eval H
                      (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1 final1)).2;
                AspisR1.S2W_D189Wrappers.second native2 allocator j.entry id j.data j.slot j.state =
                  Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (post2, final2))) →
                have c := AspisR1.FIp_Install.configuration err base reservation;
                (AspisV8R19.MemoizedProgramLaw.eval H
                        (AspisR1.SCE_Execution.firstCode c hashv copy allocator id
                          (AspisV8R19.MemoizedProgramLaw.eval H a.first).2)).2 =
                    Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post1, final1)) ∧
                  (AspisV8R19.MemoizedProgramLaw.eval H
                          (AspisR1.SCE_Execution.secondCode c hashv allocator id
                            (AspisV8R19.MemoizedProgramLaw.eval H
                                (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1 final1)).2)).2 =
                      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (post2, final2)) ∧
                    AspisR1.SCE_Experiment.accepted
                        (AspisV8R19.MemoizedProgramLaw.eval H
                            (AspisR1.SCE_Experiment.account c hashv copy allocator id a)).2 =
                      Bool.true
theorem AspisR1.ARQ_NativeReplies.accepted : ∀ {A C : Type}
  (base : AspisR1.DrvC_Installation.Configuration AspisR1.FIo_Install.W C) (err : C)
  (reservation : AspisR1.NP6_StdModel.Reservation)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (native1 : AspisR1.S2W_ExtractionBoundary.First)
  (native2 : AspisR1.S2W_ExtractionBoundary.Second),
  AspisR1.S2W_DigestExtraction.AeneasExtraction
      (AspisR1.DrvC_Installation.sdk (AspisR1.FIp_Install.configuration err base reservation)) native1 native2 hashv →
    ∀ (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      AspisR1.S2W_ExtractionBoundary.P1 sha256 H →
        AspisR1.S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
          ∀ (a : AspisR1.SCE_Experiment.Adversary A) (id : AspisR1.S2W_ExtractionBoundary.Program)
            (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
            (post1 post2 : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record)) (final1 final2 : A),
            AspisR1.S2W_D189Wrappers.first native1 copy allocator (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.entry
                  id (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.data
                  (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.state =
                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post1, final1)) →
              (have j :=
                  (AspisV8R19.MemoizedProgramLaw.eval H
                      (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1 final1)).2;
                AspisR1.S2W_D189Wrappers.second native2 allocator j.entry id j.data j.slot j.state =
                  Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (post2, final2))) →
                have c := AspisR1.FIp_Install.configuration err base reservation;
                (AspisV8R19.MemoizedProgramLaw.eval H
                        (AspisR1.SCE_Execution.firstCode c hashv copy allocator id
                          (AspisV8R19.MemoizedProgramLaw.eval H a.first).2)).2 =
                    Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post1, final1)) ∧
                  (AspisV8R19.MemoizedProgramLaw.eval H
                          (AspisR1.SCE_Execution.secondCode c hashv allocator id
                            (AspisV8R19.MemoizedProgramLaw.eval H
                                (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1 final1)).2)).2 =
                      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (post2, final2)) ∧
                    AspisR1.SCE_Experiment.accepted
                        (AspisV8R19.MemoizedProgramLaw.eval H
                            (AspisR1.SCE_Experiment.account c hashv copy allocator id a)).2 =
                      Bool.true :=
fun {A C} base err reservation hashv copy allocator native1 native2 extraction sha256 H p1 syscall a id saved post1
    post2 final1 final2 one two =>
  _root_.id
    (let c := AspisR1.FIp_Install.configuration err base reservation;
    have ext :=
      Eq.mpr
        (_root_.id
          (congrArg (fun _a => AspisR1.S2W_DigestExtraction.AeneasExtraction _a native1 native2 hashv)
            (Eq.symm (AspisR1.ARQ_Installation.dictionary err base reservation))))
        extraction;
    have first :=
      AspisR1.SCE_NativeFirst.result c hashv allocator id native1 native2 ext sha256 H p1 syscall copy
        (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1 final1 one;
    have second :=
      AspisR1.SCE_NativeSecond.result c hashv allocator id native1 native2 ext sha256 H p1 syscall
        (AspisV8R19.MemoizedProgramLaw.eval H
            (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post1 final1)).2
        post2 final2 two;
    ⟨first,
      ⟨second,
        AspisR1.SCE_AcceptedOutcome.from_source_calls c hashv copy allocator id a H saved post1 post2 final1 final2
          first second⟩⟩)
'AspisR1.ARQ_NativeReplies.accepted' depends on axioms: [propext, Classical.choice, Quot.sound]
