                            (congrArg (AspisR1.F3T_Installed.source c hashv)
                              (congrArg (AspisR1.F3T_ByteCarrier.input c)
                                (congrArg Prod.snd (AspisR1.SCE_Experiment.submission_eval a H)))))))))
                  (Eq.mp
                    (congrArg
                      (Eq
                        (AspisV8R19.MemoizedProgramLaw.eval H
                            (AspisR1.SCE_Experiment.account c hashv copy allocator id a)).1)
                      (congrArg (HAppend.hAppend (AspisV8R19.MemoizedProgramLaw.eval H a.first).1)
                        (congrArg Prod.fst
                          (congrArg (AspisV8R19.MemoizedProgramLaw.eval H)
                            (congrArg (AspisR1.F3T_Installed.source c hashv)
                              (congrArg (AspisR1.F3T_ByteCarrier.input c)
                                (congrArg Prod.snd (AspisR1.SCE_Experiment.submission_eval a H))))))))
                    ordered)))))));
  ⟨Eq.mpr
      (_root_.id
        (congrArg (fun _a => _a.2.2 = Bool.true)
          (AspisR1.F3T_Charged.projected_eval D
            (AspisR1.F3T_Canon.canon (AspisR1.F3T_ByteCarrier.lift c (AspisR1.SCE_Experiment.submission a))) H)))
      (Eq.mpr
        (_root_.id
          (congrArg (fun _a => (AspisR1.F3T_Experiment.view _a).2.2 = Bool.true)
            (AspisR1.F3T_Experiment.recorded_eval D (AspisR1.F3T_Charged.build D)
