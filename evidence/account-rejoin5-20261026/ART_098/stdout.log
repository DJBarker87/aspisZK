    AspisR1.OraclePortRefineJoin.RecoveredInputAgreement
      (AspisR1.F3T_Experiment.view
        (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3T_Experiment.original D (AspisR1.F3T_Canon.canon P))))
      (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3T_Charged.projected D (AspisR1.F3T_Canon.canon P)))
theorem AspisR1.SCI_Recovery.model_agreement : ∀ (D : AspisR1.LiteralByteProtocol.Decoder)
  (P : AspisR1.F3T_Experiment.Prover) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3T_Experiment.original D (AspisR1.F3T_Canon.canon P))).2.2 =
      Bool.true →
    AspisR1.OraclePortRefineJoin.RecoveredInputAgreement
      (AspisR1.F3T_Experiment.view
        (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3T_Experiment.original D (AspisR1.F3T_Canon.canon P))))
      (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3T_Charged.projected D (AspisR1.F3T_Canon.canon P))) :=
fun D P H success =>
  let CP := AspisR1.F3T_Canon.canon P;
  let v := AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3T_Experiment.original D CP);
  let suffix := (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3_Model.verifier D v.2.1)).1;
  let w := AspisR1.F3T_Charged.build D (AspisR1.F3T_Experiment.view v);
  have shape :=
    Eq.mpr
      (id
        (congrArg (fun _a => _a = AspisR1.SCE_ReplayFrames.annotated (AspisR1.F3T_Experiment.view v) suffix w)
          (AspisR1.F3T_Charged.projected_eval D CP H)))
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              AspisR1.F3T_Experiment.view _a =
                AspisR1.SCE_ReplayFrames.annotated (AspisR1.F3T_Experiment.view v) suffix w)
            (AspisR1.F3T_Experiment.recorded_eval D (AspisR1.F3T_Charged.build D) CP H)))
        (Eq.refl
          (AspisR1.F3T_Experiment.view
            (have v := AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3T_Experiment.original D CP);
            (v.1 ++ (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3_Model.verifier D v.2.1)).1,
              AspisR1.F3T_Experiment.enrich (AspisR1.F3T_Charged.build D (AspisR1.F3T_Experiment.view v)) v.2.1,
              v.2.2)))));
  have consistent := fun q member =>
    Or.casesOn (List.mem_append.mp member)
      (fun first => FS.eval_consistent H (AspisR1.F3T_Experiment.original D CP) q first) fun second =>
      FS.eval_consistent H (AspisR1.F3_Model.verifier D v.2.1) q second;
  have known :=
    id
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              ∀ a ∈ List.map Prod.fst (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3_Model.verifier D _a.2.1)).1,
                a ∈ List.map Prod.fst _a.1)
            (AspisR1.F3T_Experiment.original_eval D CP H)))
        (id fun a member =>
          Eq.mpr (id (congrArg (fun _a => a ∈ _a) List.map_append))
            (Eq.mpr (id (congrArg (fun _a => _a) (propext List.mem_append))) (Or.inr member))));
  have frames := AspisR1.SCE_ModelReadFrames.frames D P H success;
  id
    (Eq.mpr
      (id
        (congrArg (fun _a => AspisR1.OraclePortRefineJoin.RecoveredInputAgreement (AspisR1.F3T_Experiment.view v) _a)
          shape))
      (AspisR1.SCF_Recovery.agreement (AspisR1.F3T_Experiment.view v)
        (AspisR1.SCE_ReplayFrames.annotated (AspisR1.F3T_Experiment.view v) suffix w)
        (Eq.refl (AspisR1.F3T_Experiment.view v).2.1.1)
        (fun row a =>
          Eq.symm (AspisR1.SCE_ReplayFrames.frame_same (AspisR1.F3T_Experiment.view v) suffix w H consistent known row))
        fun row selected =>
        Eq.mpr
          (id
            (congrArg
              (fun _a =>
                AspisR1.BinRawByteCutRecovery.cut (AspisR1.F3T_Experiment.view v).1 _a =
                  AspisR1.BinRawByteCutRecovery.cut
                    (AspisR1.SCE_ReplayFrames.annotated (AspisR1.F3T_Experiment.view v) suffix w).1 _a)
              (AspisR1.SCE_ReplayFrames.frame_same (AspisR1.F3T_Experiment.view v) suffix w H consistent known row)))
          (id
            (Eq.symm
              (AspisR1.SCE_ReplayTable.cut_append (AspisR1.F3T_Experiment.view v).1 suffix
                (AspisR1.RawCommitmentFrameReplay.frameFromView (AspisR1.F3T_Experiment.view v) row)
                (Or.casesOn selected (fun h => Eq.symm h ▸ frames.left) fun h =>
                  Or.casesOn h (fun h => Eq.symm h ▸ frames.right.left) fun h => Eq.symm h ▸ frames.right.right))))))
