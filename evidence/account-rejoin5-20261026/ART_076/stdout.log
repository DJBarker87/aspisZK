fun {W A C Tx} L copy allocator c err r native1 native2 hashv extraction a native H n consistent =>
  have replies :=
    AspisR1.ARQ_NativeReplies.accepted c err r hashv copy allocator native1 native2 extraction n.sha256 native n.p1
      n.syscall a AspisR1.CPH_Program.verifier n.saved n.post1 n.post2 n.final1 n.final2 n.accepted1 n.accepted2;
  have pieces :=
    AspisR1.ARS_Chronology.pieces (AspisR1.FIp_Install.configuration err c r) hashv copy allocator
      AspisR1.CPH_Program.verifier a native H n.saved n.post1 n.final1 replies.left consistent;
  have firstEq := congrArg Prod.snd pieces.left;
  have secondEq :=
    Eq.mpr
      (id
        (congrArg
          (fun _a =>
            (AspisV8R19.MemoizedProgramLaw.eval H (a.second _a n.saved n.post1 n.final1)).2 =
              (AspisV8R19.MemoizedProgramLaw.eval native
                  (a.second (AspisV8R19.MemoizedProgramLaw.eval native a.first).2 n.saved n.post1 n.final1)).2)
          firstEq))
      (congrArg Prod.snd pieces.right.right.left);
  have same :=
    AspisR1.ARS_AccountReplay.replay
      (AspisR1.SCE_Experiment.account (AspisR1.FIp_Install.configuration err c r) hashv copy allocator
        AspisR1.CPH_Program.verifier a)
      native H consistent;
  ⟨Nonempty.intro
      { saved := n.saved, post1 := n.post1, post2 := n.post2, final1 := n.final1, final2 := n.final2, w1 := n.w1,
        w2 := n.w2,
        admission1 :=
          Eq.mpr
            (id
              (congrFun'
                (congrFun'
                  (congrArg (AspisR1.S2W_D189Consolidation.RuntimeEntrypointAdmission L)
                    (congrArg AspisR1.GExq_AccountExperiment.FirstInputs.entry firstEq))
                  n.w1)
                3))
            n.admission1,
        admission2 :=
          Eq.mpr
            (id
              (congrFun'
                (congrFun'
                  (congrArg (AspisR1.S2W_D189Consolidation.RuntimeEntrypointAdmission L)
                    (congrArg AspisR1.GExq_AccountExperiment.SecondInputs.entry secondEq))
                  n.w2)
                7))
            n.admission2,
        accepted1 :=
          Eq.mpr
            (id
              (congrFun'
                (congrArg Eq
                  (congr
                    (congr
                      (congrFun'
                        (congrArg (AspisR1.S2W_D189Wrappers.first native1 copy allocator)
                          (congrArg AspisR1.GExq_AccountExperiment.FirstInputs.entry firstEq))
                        AspisR1.CPH_Program.verifier)
                      (congrArg AspisR1.GExq_AccountExperiment.FirstInputs.data firstEq))
                    (congrArg AspisR1.GExq_AccountExperiment.FirstInputs.state firstEq)))
                (Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (n.saved, n.post1, n.final1)))))
            n.accepted1,
        accepted2 :=
          Eq.mpr
            (id
              (congrFun'
                (congrArg Eq
                  (congr
                    (congr
                      (congr
                        (congrFun'
                          (congrArg (AspisR1.S2W_D189Wrappers.second native2 allocator)
                            (congrArg AspisR1.GExq_AccountExperiment.SecondInputs.entry secondEq))
                          AspisR1.CPH_Program.verifier)
                        (congrArg AspisR1.GExq_AccountExperiment.SecondInputs.data secondEq))
                      (congrArg AspisR1.GExq_AccountExperiment.SecondInputs.slot secondEq))
                    (congrArg AspisR1.GExq_AccountExperiment.SecondInputs.state secondEq)))
                (Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (n.post2, n.final2)))))
            n.accepted2,
        p := n.p, t := n.t, u := n.u, actions := n.actions,
        game :=
          Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  AspisR1.CPH_Game.DeployedPairExecution n.p n.t n.u
                    (AspisV8R19.MemoizedProgramLaw.eval H a.first).2.entry _a.entry n.saved n.actions native1 native2
                    copy allocator AspisR1.CPH_Program.verifier)
                secondEq))
            (Eq.mpr
              (id
                (congrArg
                  (fun _a =>
                    AspisR1.CPH_Game.DeployedPairExecution n.p n.t n.u _a.entry
                      (AspisV8R19.MemoizedProgramLaw.eval native
                            (a.second (AspisV8R19.MemoizedProgramLaw.eval native a.first).2 n.saved n.post1
                              n.final1)).2.entry
                      n.saved n.actions native1 native2 copy allocator AspisR1.CPH_Program.verifier)
                  firstEq))
              n.game),
