+use super::*;
+#[kani::proof] #[kani::unwind(10)] fn LPh_validate_window(){
+ let b:[u8;3712]=kani::any();let i:usize=kani::any();kani::assume(i<116);let row:u8=kani::any();
+ let prior:Result<(),Error>=if kani::any(){Ok(())}else{let earlier:usize=kani::any();kani::assume(earlier<=i);Err(Error::NonCanonical{row,value:earlier})};
+ let mut chunks=b[32*i..].chunks_exact(32);let n=chunks.len();let c=chunks.next().unwrap();assert_eq!(chunks.len()+1,n);assert!(core::ptr::eq(c.as_ptr(),b[32*i..].as_ptr()));
+ // Exact one iteration from validate_record_fields, on the arbitrary enumeration pre-state i.
+ let actual=prior.and_then(|()|{let x=WideExact::from_le_bytes(c).ok_or(Error::NonCanonical{row,value:i})?;if x.c1()!=QM31::ZERO{return Err(Error::NonCanonical{row,value:i});}Ok(())});
+ let step=validate_record_fields(row,c).map_err(|_|Error::NonCanonical{row,value:i});
+ assert_eq!(actual,prior.and(step));
+}
+fn decode_fixed<const OFF:usize>(){
+ let b:[u8;5+32*116]=kani::any();let row:u8=kani::any();kani::assume(row>=14);
+ let got=ValidatedRecord{row,framed:&b}.decode_k::<1>(OFF);let expected=QM31::from_le_bytes(&b[5+32*OFF..21+32*OFF]);
+ match(got,expected){(Ok([a]),Some(b))=>{assert_eq!(a.c0.a.0,b.c0.a.0);assert_eq!(a.c0.b.0,b.c0.b.0);assert_eq!(a.c1.a.0,b.c1.a.0);assert_eq!(a.c1.b.0,b.c1.b.0);},(Err(e),None)=>assert_eq!(e,Error::NonCanonical{row,value:OFF}),_=>panic!("LPh fixed decode disagreement")}
+}
