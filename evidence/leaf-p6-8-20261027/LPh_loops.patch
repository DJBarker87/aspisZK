+}
+fn expand<const PART:usize>(){
+ let input:[u8;464]=kani::any();let mut output:[u8;928]=kani::any();let i:usize=kani::any();kani::assume(i<29);
+ let j:usize=kani::any();kani::assume(j<928);kani::assume(if PART==0{j<32*i}else if PART==1{j>=32*i&&j<32*i+16}else if PART==2{j>=32*i+16&&j<32*i+32}else{j>=32*i+32});
+ let old=output[j];
+ {let mut src=input[16*i..].chunks_exact(16);let mut dst=output[32*i..].chunks_exact_mut(32);
+  let c=src.next().unwrap();let o=dst.next().unwrap();assert_eq!(expand_values(c,o),Ok(()));}
+ let expected=if j>=32*i&&j<32*i+16{input[16*i+j-32*i]}else if j>=32*i+16&&j<32*i+32{0}else{old};
+ assert_eq!(output[j],expected);
+}
