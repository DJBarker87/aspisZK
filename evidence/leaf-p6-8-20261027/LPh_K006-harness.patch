+use super::*;
+fn raw_spec(x:Q,y:Q)->[u64;4] {
+ let [a,b,c,d]=x.0.map(u64::from); let [e,f,g,h]=y.0.map(u64::from);
+ let pp=(P as u64)*(P as u64);
+ let u=(c*g).wrapping_add(pp).wrapping_sub(d*h);
+ let v=(c*h).wrapping_add(d*g);
+ let u=(u & P as u64).wrapping_add(u>>31);
+ let v=(v & P as u64).wrapping_add(v>>31);
+ [(a*e).wrapping_add(pp).wrapping_sub(b*f).wrapping_add(2*u).wrapping_add(3*P as u64).wrapping_sub(v),
+ (a*f).wrapping_add(b*e).wrapping_add(u).wrapping_add(2*v),
+ (a*g).wrapping_add(c*e).wrapping_add(2*pp).wrapping_sub(b*h).wrapping_sub(d*f),
+ (a*h).wrapping_add(b*g).wrapping_add(c*f).wrapping_add(d*e)]
+}
+
+static mut LPh_RAW:[u64;4]=[0;4];
+fn raw_stub(a:Q,b:Q)->[u64;4]{
+ for j in 0..4{assert!(a.0[j]<P && b.0[j]<P,"LPh raw canonical input");}
+ let spec=raw_spec(a,b);let out:[u64;4]=kani::any();
+ for j in 0..4{kani::assume(out[j]==spec[j]);} unsafe{LPh_RAW=out;} out
+}
+fn cell<const J:usize>(){
+ let a:[u32;4]=kani::any();let b:[u32;4]=kani::any();
+ for j in 0..4{kani::assume(a[j]<P && b[j]<P);}
+ let a=Q::from_limbs(a).unwrap();let b=Q::from_limbs(b).unwrap();
+ let old:[u64;4]=kani::any();let mut dot=Dot{sums:old};
+ dot.push(a,b); let raw=unsafe{LPh_RAW};
+ assert_eq!(dot.sums[J],old[J].wrapping_add((raw[J]&u64::from(P)).wrapping_add(raw[J]>>31)));
+}
