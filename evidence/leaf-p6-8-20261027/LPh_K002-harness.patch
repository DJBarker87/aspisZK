+use super::*;
+fn raw_stub(a:Q,b:Q)->[u64;4]{
+ for j in 0..4{assert!(a.0[j]<P && b.0[j]<P,"LPh raw canonical input");}
+ let spec=LPg_dot::reference(a,b);let out:[u64;4]=kani::any();
+ for j in 0..4{kani::assume(out[j]==spec[j]);}out
+}
+fn cell<const J:usize>(){
+ let a:[u32;4]=kani::any();let b:[u32;4]=kani::any();
+ for j in 0..4{kani::assume(a[j]<P && b[j]<P);}
+ let a=Q::from_limbs(a).unwrap();let b=Q::from_limbs(b).unwrap();
+ let old:[u64;4]=kani::any();let mut dot=Dot{sums:old};let raw=LPg_dot::reference(a,b);
+ dot.push(a,b);
+ assert_eq!(dot.sums[J],old[J].wrapping_add((raw[J]&u64::from(P)).wrapping_add(raw[J]>>31)));
+}
+#[kani::proof] #[kani::stub(Q::raw,raw_stub)] #[kani::unwind(6)] fn LPh_cell0(){cell::<0>()}
+#[kani::proof] #[kani::stub(Q::raw,raw_stub)] #[kani::unwind(6)] fn LPh_cell1(){cell::<1>()}
+#[kani::proof] #[kani::stub(Q::raw,raw_stub)] #[kani::unwind(6)] fn LPh_cell2(){cell::<2>()}
+#[kani::proof] #[kani::stub(Q::raw,raw_stub)] #[kani::unwind(6)] fn LPh_cell3(){cell::<3>()}
+#[kani::proof] #[kani::stub_verified(reduce)] #[kani::unwind(6)]
+fn LPh_finish_canonical(){let sums:[u64;4]=kani::any();let q=Dot{sums}.finish();for j in 0..4{assert!(q.0[j]<P);}}
