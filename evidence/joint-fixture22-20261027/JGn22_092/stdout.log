def Aeneas.Std.core.slice.Slice.split_at_mut : {T : Type} →
  Aeneas.Std.Slice T →
    Aeneas.Std.Usize →
      Aeneas.Std.Result
        ((Aeneas.Std.Slice T × Aeneas.Std.Slice T) × (Aeneas.Std.Slice T × Aeneas.Std.Slice T → Aeneas.Std.Slice T)) :=
fun {T} s n =>
  if h0 : ↑n ≤ s.length then
    let s0 := (List.splitAt ↑n ↑s).1;
    let s1 := (List.splitAt ↑n ↑s).2;
    have back := fun s' =>
      let s0' := s'.1;
      let s1' := s'.2;
      if h1 : s0'.length = s0.length ∧ s1'.length = s1.length then ⟨↑s0' ++ ↑s1', ⋯⟩ else s;
    have s0 := ⟨s0, ⋯⟩;
    have s1 := ⟨s1, ⋯⟩;
    Aeneas.Std.Result.ok ((s0, s1), back)
  else Aeneas.Std.Result.fail Aeneas.Std.Error.panic
