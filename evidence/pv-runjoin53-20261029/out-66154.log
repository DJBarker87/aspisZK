def Aeneas.Std.core.iter.range.IteratorRange.next : {A : Type} →
  core.iter.range.Step A → core.ops.range.Range A → Result (Option A × core.ops.range.Range A) :=
fun {A} StepInst range => do
  let cmp ← StepInst.partialOrdInst.lt range.start range.end
  if cmp = true then do
      let range' ← StepInst.cloneInst.clone range.start
      let n ← StepInst.forward_checked range' 1#usize
      match n with
        | none => fail Error.panic
        | some n => ok (some range', { start := n, «end» := range.end })
    else ok (none, range)
