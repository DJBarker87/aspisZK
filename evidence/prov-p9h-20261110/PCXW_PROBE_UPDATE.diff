+    #[test]
+    fn binding_tail_lengths_are_exact_for_both_variants() {
+        assert_eq!(TRANSFER_BYTES, 1520);
+        assert_eq!(WITHDRAWAL_BYTES, 1524);
+        let (transfer, withdrawal, transition) = fixture();
+        let t = r0::Public::Transfer(&transfer, &transition).public_bytes().unwrap();
+        let w = r0::Public::Withdrawal(&withdrawal, &transition).public_bytes().unwrap();
+        assert_eq!(t.len(), 1520);
+        assert_eq!(w.len(), 1524);
+        // Transfer tail: pool, domain, has_destination = 0, no destination.
+        assert_eq!(&t[1455..1487], &[1; 32]);
+        assert_eq!(&t[1487..1519], &[2; 32]);
+        assert_eq!(t[1519], 0);
+        // Withdrawal tail: pool, domain, has_destination = 1, destination.
+        assert_eq!(&w[1427..1459], &[1; 32]);
+        assert_eq!(&w[1459..1491], &[2; 32]);
+        assert_eq!(w[1491], 1);
+        assert_eq!(&w[1492..1524], &[7; 32]);
+    }
+
+    #[test]
+    fn withdrawal_destination_changes_public_bytes() {
+        let (_, withdrawal, transition) = fixture();
+        let base = r0::Public::Withdrawal(&withdrawal, &transition).public_bytes().unwrap();
+        for (byte, value) in [(0, 8), (17, 0), (31, 0xff)] {
+            let mut changed = withdrawal;
+            changed.destination_token_account[byte] = value;
+            let bytes = r0::Public::Withdrawal(&changed, &transition).public_bytes().unwrap();
+            assert_ne!(bytes, base);
+            assert_eq!(bytes.len(), base.len());
+            assert_eq!(bytes[..1492], base[..1492]);
+        }
+    }
+
+    #[test]
+    fn pool_and_deployment_domain_change_public_bytes_for_both_variants() {
+        let (transfer, withdrawal, transition) = fixture();
+        let t0 = r0::Public::Transfer(&transfer, &transition).public_bytes().unwrap();
+        let w0 = r0::Public::Withdrawal(&withdrawal, &transition).public_bytes().unwrap();
+        for field in 0..2 {
+            for byte in [0, 31] {
+                let mut t = transfer;
+                let mut w = withdrawal;
+                if field == 0 {
+                    t.pool[byte] ^= 0x80;
+                    w.pool[byte] ^= 0x80;
+                } else {
+                    t.deployment_domain[byte] ^= 0x80;
+                    w.deployment_domain[byte] ^= 0x80;
+                }
+                let t1 = r0::Public::Transfer(&t, &transition).public_bytes().unwrap();
+                let w1 = r0::Public::Withdrawal(&w, &transition).public_bytes().unwrap();
+                assert_ne!(t1, t0);
+                assert_ne!(w1, w0);
+                // Only the appended tail moves; the frozen prefix is unchanged.
+                assert_eq!(t1[..OLD_TRANSFER_BYTES], t0[..OLD_TRANSFER_BYTES]);
+                assert_eq!(w1[..OLD_WITHDRAWAL_BYTES], w0[..OLD_WITHDRAWAL_BYTES]);
+            }
+        }
+    }
