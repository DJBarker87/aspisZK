fun {W} finish v p a proof savedVec H stored publicBytes tx1p parsed trace semantic q tr i c =>
  p.variant = AspisR1Stage2.transport.Variant.S2 ∧
    ∃ alpha0 alpha1 alphas,
      p.alpha.index_usize 0#usize = Aeneas.Std.Result.ok alpha0 ∧
        p.alpha.index_usize 1#usize = Aeneas.Std.Result.ok alpha1 ∧
          Aeneas.Std.core.array.Array.index
                (Aeneas.Std.core.ops.index.IndexSlice
                  (Aeneas.Std.core.slice.index.SliceIndexRangeToUsizeSlice AspisR1Stage2.Stage2Finish.E))
                p.alpha { «end» := 2#usize } =
              Aeneas.Std.Result.ok alphas ∧
            ∃ r0 r1 weights pair dot,
              finish.newWeights p.variant p.semantic_alpha p.z =
                  Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok weights) ∧
                finish.pair weights alphas v.final_message p.kappa =
                    Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok pair) ∧
                  finish.dot v.final_message a.weights.deref =
                      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok dot) ∧
                    r0.lhs = r0.rhs ∧
                      r1.lhs = r1.rhs ∧
                        pair = r1.value ∧
                          dot = a.rhs ∧
                            (AspisR1.FIs_Pair.Law (AspisR1.Port3_FinishStage.release finish) v p i.data →
                              (∀ (j : Fin 22), AspisR1.MatchingSupport.match0 i.data (q j)) →
                                AspisR1.R3SemanticRemainingJoins.EquationEndpoint i.decoded
                                    (AspisR1.OraclePortStoredDecisionDraftC4.typedRows
                                      { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof, semantic := semantic } q
                                      tr)
                                    i.data →
                                  AspisR1.AuS1_Finish.Collision H trace parsed q ∨
                                    Decidable.decide
                                          (AspisR1.Port3_NativeFinishBody.verifier.finish_relation
                                              (AspisR1.Port4D_Round.native finish) v p a Option.none =
                                            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ())) =
                                        AspisR1.OraclePortFrozen2.finish
                                          { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof,
                                            semantic := semantic }
                                          q tr i (AspisR1.CheckpointBytes5Output.accumulator a) ∧
                                      Decidable.decide
                                            (AspisR1.Port4D_FinishInstall.finish finish v p a Option.none =
                                              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ())) =
                                          AspisR1.D0TypedChecks.verify
                                            (AspisR1.OraclePortStoredDecisionDraftC4.typedRows
                                              { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof,
                                                semantic := semantic }
                                              q tr)
                                            i ∧
                                        AspisR1.D0TypedChecks.verify
                                            (AspisR1.OraclePortStoredDecisionDraftC4.typedRows
                                              { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof,
                                                semantic := semantic }
                                              q tr)
                                            i =
                                          Bool.true)
