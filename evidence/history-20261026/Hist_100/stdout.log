fun {W A E M Cv CoreError} {N} L sdk copy std allocator initial final layout1 layout2 w1 w2 admission1 admission2
    adapterOps ops reserved queryOps geoOps B claimsStd prepareOwner primitiveOwner native1 native2 hashv extraction
    sourceProgram iv Q sourceBudget sha256 H p1 syscall program data1 data2 slot state1 state2 final1 final2 saved post1
    post2 accepted1 accepted2 events historyTrace sameKey p root length port firstMarks secondMarks =>
  let ⟨f, h✝⟩ :=
    AspisR1.Hist_AcceptedStrong.accepted_pair_claims_tx1 L sdk copy std allocator
      (AspisR1.Hist_RuntimeEntry.load initial layout1) (AspisR1.Hist_RuntimeEntry.load final layout2) w1 w2 admission1
      admission2 (AspisR1.Hist_Authority.install adapterOps) ops reserved queryOps geoOps B claimsStd prepareOwner
      primitiveOwner native1 native2 hashv extraction sha256 H p1 syscall program data1 data2 slot state1 state2 final1
      final2 saved post1 post2 accepted1 accepted2 p root length port firstMarks secondMarks
  let ⟨s, h✝¹⟩ := h✝
  let ⟨validated, h✝²⟩ := h✝¹
  let ⟨outer, h✝³⟩ := h✝²
  let ⟨pre, h✝⁴⟩ := h✝³
  let ⟨middle, h✝⁵⟩ := h✝⁴
  let ⟨fs, h✝⁶⟩ := h✝⁵
  let ⟨ss, h✝⁷⟩ := h✝⁶
  let ⟨cuts, right✝⟩ := h✝⁷
  let ⟨getter, right✝¹⟩ := right✝
  let ⟨validation, right✝²⟩ := right✝¹
  let ⟨encoder, right✝³⟩ := right✝²
  let ⟨execution, right✝⁴⟩ := right✝³
  let ⟨header, right✝⁵⟩ := right✝⁴
  let ⟨scan, right✝⁶⟩ := right✝⁵
  let ⟨writerInfo, right✝⁷⟩ := right✝⁶
  let ⟨expanded, right✝⁸⟩ := right✝⁷
  let ⟨owned, right✝⁹⟩ := right✝⁸
  let ⟨layout, right✝¹⁰⟩ := right✝⁹
  let ⟨unchanged, right✝¹¹⟩ := right✝¹⁰
  let ⟨before1, right✝¹²⟩ := right✝¹¹
  let ⟨before2, right✝¹³⟩ := right✝¹²
  let ⟨claims, caller⟩ := right✝¹³
  let ⟨owned1, right✝¹⁴⟩ :=
    AspisR1.S2W_D189Wrappers.first_accepted native1 copy std allocator (AspisR1.Hist_RuntimeEntry.load initial layout1)
      program data1 state1 final1 saved post1 accepted1
  let ⟨owned2, right✝¹⁵⟩ :=
    AspisR1.S2W_D189Wrappers.second_accepted native2 allocator (AspisR1.Hist_RuntimeEntry.load final layout2) program
      data2 slot state2 final2 post2 accepted2
  let boundary :=
    AspisR1.S2W_DigestExtraction.sourceBoundary
      (AspisR1.ClaimsUnrolledSdk.sdkOps (AspisR1.Hist_Authority.install adapterOps)
        (AspisR1.Tx1Q_SameCut.dictionary ops reserved queryOps geoOps) B claimsStd)
      native1 native2 hashv extraction;
  have source1 :=
    Eq.trans (Eq.symm (boundary.stage1 program (AspisR1.Hist_RuntimeEntry.load initial layout1).first data1)) owned1;
  have source2 :=
    Eq.trans
      (Eq.symm
        (boundary.stage2 program
          ((AspisR1.Hist_RuntimeEntry.load final layout2).second AspisR1.S2W_D189Wrappers.secondSizes) data2 slot))
      owned2;
  have readerArgument :=
    AspisR1.Hist_WholeEncoderTrace.second_public
      (AspisR1.ClaimsUnrolledSdk.sdkOps (AspisR1.Hist_Authority.install adapterOps)
        (AspisR1.Tx1Q_SameCut.dictionary ops reserved queryOps geoOps) B claimsStd)
      program (AspisR1.Hist_RuntimeEntry.load initial layout1).first
      ((AspisR1.Hist_RuntimeEntry.load final layout2).second AspisR1.S2W_D189Wrappers.secondSizes) data1 data2 slot
      saved source1 source2 validated s.encoded validation encoder outer execution;
  Exists.intro f
    (Exists.intro s
      (Exists.intro validated
        (Exists.intro outer
          (Exists.intro pre
            (Exists.intro middle
              (Exists.intro fs
                (Exists.intro ss
                  ⟨cuts,
                    ⟨getter,
                      ⟨validation,
                        ⟨encoder,
                          ⟨execution,
                            ⟨readerArgument,
                              ⟨header, ⟨scan, ⟨writerInfo, ⟨expanded, ⟨owned, ⟨layout, ⟨unchanged, ⋯⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩)))))))
theorem AspisR1.Hist_SuccessBinding.successful_equal_or_collision : ∀ (iv : AspisV8R19.SourceDuplexStep.State)
  (source :
    AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State
      AspisR1.Hist_ByteExperiment.BytesPair)
  (Q : ℕ),
  (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      FS.firstReads FS.emptyTable (AspisV8R19.MemoizedProgramLaw.eval H source).1 ≤ Q) →
    ∀ (success : AspisR1.Hist_ByteExperiment.BytesPair → Prop),
      (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
          success (AspisV8R19.MemoizedProgramLaw.eval H source).2 →
            AspisR1.R9PoolRuntimeBinding.digestMatches H (AspisV8R19.MemoizedProgramLaw.eval H source).2.1
              (AspisV8R19.MemoizedProgramLaw.eval H source).2.2) →
        ∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
          success (AspisV8R19.MemoizedProgramLaw.eval H source).2 →
            AspisR1.BinRawByteCollisionTargets.event iv (Q + 4)
                (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.Hist_ByteExperiment.charged source)) ∨
              (AspisV8R19.MemoizedProgramLaw.eval H source).2.2 = (AspisV8R19.MemoizedProgramLaw.eval H source).2.1 :=
fun iv source Q budget success successfulMatches H accepted =>
  AspisR1.Hist_SuccessBinding.equal_or_collision iv source Q budget H (successfulMatches H accepted)
theorem AspisR1.Hist_JointCharge.collision_bound : ∀ {A : Type} (iv : AspisV8R19.SourceDuplexStep.State)
  (source : AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State A)
  (prepare : A → AspisR1.OraclePortCompactDraft.Parsed × (Fin 22 → Fin 262144))
  (select : A → AspisR1.R9PoolRuntimeBinding.Inputs × AspisR1.R9PoolRuntimeBinding.Inputs) (Q : ℕ),
  (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      FS.firstReads FS.emptyTable (AspisV8R19.MemoizedProgramLaw.eval H source).1 ≤ Q) →
    (AspisV8R19.MemoizedProgramLaw.lazyMean (AspisR1.Hist_JointCharge.joint source prepare select) FS.emptyTable
        fun view =>
        AspisV8R19.CausalFirstHitUnionBound.indicator (AspisR1.BinRawByteCollisionTargets.event iv (Q + 1044) view)) ≤
      6 * ↑(Q + 1044) ^ 2 / 256 ^ 32 :=
fun {A} iv source prepare select Q sourceBudget =>
  AspisR1.BinRawByteCollisionTargets.mass iv (Q + 1044) (AspisR1.Hist_JointCharge.joint source prepare select)
    (AspisR1.Hist_JointCharge.budget source prepare select Q sourceBudget)
