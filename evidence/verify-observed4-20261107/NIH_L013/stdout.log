def FIq_Native.field.M31.reduce_u62 : Aeneas.Std.U64 → Aeneas.Std.Result FIq_Native.field.M31 :=
fun value => do
  let i ← FIq_Native.field.reduce_u64 value
  Aeneas.Std.Result.ok i
def FIq_Native.field.reduce_u64 : Aeneas.Std.U64 → Aeneas.Std.Result Aeneas.Std.U32 :=
fun x => do
  let i ← Aeneas.Std.lift (Aeneas.Std.UScalar.cast Aeneas.Std.UScalarTy.U64 FIq_Native.field.P)
  let i1 ← Aeneas.Std.lift (x &&& i)
  let i2 ← x >>> 31#u32
  let x1 ← i1 + i2
  let i3 ← Aeneas.Std.lift (Aeneas.Std.UScalar.cast Aeneas.Std.UScalarTy.U64 FIq_Native.field.P)
  let i4 ← Aeneas.Std.lift (x1 &&& i3)
  let i5 ← x1 >>> 31#u32
  let x2 ← i4 + i5
  let x3 ← Aeneas.Std.lift (Aeneas.Std.UScalar.cast Aeneas.Std.UScalarTy.U32 x2)
  if x3 ≥ FIq_Native.field.P then x3 - FIq_Native.field.P else Aeneas.Std.Result.ok x3
