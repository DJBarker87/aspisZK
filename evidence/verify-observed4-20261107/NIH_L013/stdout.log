def FIq_Native.field.CM31.new : FIq_Native.field.M31 → FIq_Native.field.M31 → Aeneas.Std.Result FIq_Native.field.CM31 :=
fun a b => Aeneas.Std.Result.ok { a := a, b := b }
def FIq_Native.state_only_poseidon.extension_from_raw_limbs : Aeneas.Std.Array Aeneas.Std.U64 4#usize →
  Aeneas.Std.Result FIq_Native.field.QM31 :=
fun limbs => do
  let i ← limbs.index_usize 0#usize
  let m ← FIq_Native.field.M31.reduce_u62 i
  let i1 ← limbs.index_usize 1#usize
  let m1 ← FIq_Native.field.M31.reduce_u62 i1
  let c ← FIq_Native.field.CM31.new m m1
  let i2 ← limbs.index_usize 2#usize
  let m2 ← FIq_Native.field.M31.reduce_u62 i2
  let i3 ← limbs.index_usize 3#usize
  let m3 ← FIq_Native.field.M31.reduce_u62 i3
  let c1 ← FIq_Native.field.CM31.new m2 m3
  Aeneas.Std.Result.ok { c0 := c, c1 := c1 }
