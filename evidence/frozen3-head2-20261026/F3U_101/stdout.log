@AspisR1.F3U_AllWorldMachine.accepted : ∀ {F C : Type} (c : AspisR1.DrvC_Installation.Configuration F C)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (s : AspisR1.F3T_ByteCarrier.Submission) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3T_Installed.source c hashv (AspisR1.F3T_ByteCarrier.input c s))).2 =
      Bool.true →
    ∃ pub proof semantic saved,
      AspisR1.MultiproofConeCanonical.bytesOf ↑pub = s.publicBytes ∧
        AspisR1.MultiproofConeCanonical.bytesOf ↑proof = s.stored ∧
          AspisR1.Port1_Driver.decodeSemantic (AspisR1.DrvC_Installation.sdk c) pub =
              Aeneas.Std.Result.ok (Option.some semantic) ∧
            AspisR1.CheckpointBytes5Effect.erase (AspisR1.SdkC_Source.dictionary (AspisR1.F3U_Oracle.hashv H)) ()
                  (AspisR1.GExp_FirstCode.code (AspisR1.GExp_FirstPair.base c.currentBase c.reserved c.query c.geometry)
                    c.boundaries c.std hashv (AspisR1.DrvC_Installation.currentDigest c)
                    (AspisS6CurrentVerifierCarrier.toPublic semantic) pub proof 10#usize) =
                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok saved) ∧
              AspisR1.CheckpointBytes5Effect.erase (AspisR1.SdkC_Source.dictionary (AspisR1.F3U_Oracle.hashv H)) ()
                  (AspisR1.GExp_SecondCode.code (AspisR1.DrvC_Installation.stage c) c.reserved hashv
                    (AspisR1.DrvC_Installation.digest c) pub proof saved.deref) =
                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ())
@AspisR1.F3U_BytePreparation.accepted : ∀ {F C : Type} (c : AspisR1.DrvC_Installation.Configuration F C)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (s : AspisR1.F3T_ByteCarrier.Submission) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.F3T_Installed.source c hashv (AspisR1.F3T_ByteCarrier.input c s))).2 =
      Bool.true →
    ∃ pub proof semantic zero p scratch,
      AspisR1.MultiproofConeCanonical.bytesOf ↑pub = s.publicBytes ∧
        AspisR1.MultiproofConeCanonical.bytesOf ↑proof = s.stored ∧
          AspisR1.Port1_Driver.decodeSemantic (AspisR1.DrvC_Installation.sdk c) pub =
              Aeneas.Std.Result.ok (Option.some semantic) ∧
            AspisR1PublicPreparation.PreparedHashCode.erase
                (AspisR1.F3U_Rehash.code H
                  (AspisR1.SdkD_PrepareSource.code
                    (AspisR1.Op5T_Concrete.current
                      (have __src := AspisR1.GExp_FirstPair.base c.currentBase c.reserved c.query c.geometry;
                      { op0 := __src.op0, op1 := @AspisR1CurrentCaller.Ops.op1 __src, op2 := __src.op2,
                        op3 := __src.op3, op4 := __src.op4, op5 := __src.op5,
                        op6 := @AspisR1CurrentCaller.Ops.op6 __src, op7 := __src.op7,
                        op8 := @AspisR1CurrentCaller.Ops.op8 __src, op9 := @AspisR1CurrentCaller.Ops.op9 __src,
                        op10 := __src.op10, op11 := __src.op11, op12 := __src.op12, op13 := __src.op13,
                        op14 := __src.op14, op15 := __src.op15, op16 := fun {H} => AspisR1.Tx1Q_Install.writer,
                        op17 := __src.op17, op18 := __src.op18, op19 := __src.op19, op20 := __src.op20,
                        op21 := __src.op21 }))
                    c.boundaries c.std (AspisR1.DrvC_Installation.currentDigest c)
                    (AspisS6CurrentVerifierCarrier.toPublic semantic) proof ()
                    (Aeneas.Std.Array.repeat 29#usize zero))) =
              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok p, scratch)
@AspisR1.F3U_PublicOracleValue.initial : ∀ {Hash : Type}
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
