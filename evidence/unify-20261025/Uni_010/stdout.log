def AspisR1.Op5T_Marks.accepted : AdapterRw.Ops → S2W_Trace.Event → Prop :=
fun ops x =>
  match x with
  | S2W_Trace.Event.returned (S2W_Trace.Call.op10 D semantic pub proof split hash obs) a =>
    ∃ saved, ops.op10 D semantic pub proof split hash obs = ok (core.result.Result.Ok saved)
  | S2W_Trace.Event.returned (S2W_Trace.Call.op11 D pub proof checkpoint hash obs) a =>
    ops.op11 D pub proof checkpoint hash obs = ok (core.result.Result.Ok ())
  | x => False
def AspisR1.Tx1Q_Endpoint.WhenBound : {CoreError H : Type} →
  {installed : AspisR1CurrentCaller.Ops} →
    {reserved : Bool} →
      {query : Port3_NativeQueryBody.Ops} →
        {geo : Port3_NativeGeometryBody.Ops CoreError} →
          {D : AspisR1CurrentCaller.aspis_core.digest.Digest32 H} →
            {hash : H} →
              {semantic : AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public} →
                {pub proof : Slice U8} →
                  {split : Usize} →
                    {saved : alloc.vec.Vec U8} →
                      Tx1Q_Execution.Run installed reserved query geo D hash semantic pub proof split saved → Prop :=
fun {CoreError H} {installed} {reserved} {query} {geo} {D} {hash} {semantic} {pub proof} {split} {saved} run =>
  Port5Q1_QueryPorts.SessionAPrimitives query →
    ∀ (parsed : OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144) (tr : RawCutTranscriptRun.ErasedPrefix)
      (data : MatchingSupport.Data OraclePortCheckpointAbiC5.E) (rho : OraclePortCheckpointAbiC5.K),
      Port5Q1_QueryPorts.SessionAPrepare (Tx1Q_Carriers.prepared run.p) data q rho →
        OraclePortStoredParserC4.parseReached (MultiproofConeCanonical.bytesOf ↑proof) tr = some parsed →
          LiteralMatchingData.read (OraclePortStoredDecisionDraftC4.typedRows parsed q tr) = some data →
            ∀ (recovered : ℕ → Option AspisV8R19.DuplexFrames.Bytes),
              (∀ pos < 22,
                  recovered (OraclePortSelectedDraft.index q 2 pos) =
                    some (OraclePortPackedChoiceC4.payload parsed 2 pos)) →
                Port5Q1_GeometryCanonical.SessionAPrimitives geo →
                  Port5Q1_Domain.SessionADomain geo →
                    geo.op9 = AspisR1Qm31ArithmeticProbe.field.M31.mul →
                      geo.op7 = ok 1#u32 →
                        geo.op11 = Port4C_InverseExecution.inverse_owned →
                          have state :=
                            Tx1Q_Carriers.accumulator
                              (have __src := run.out;
                              { weights := ⟨↑run.flushed, ⋯⟩, rhs := __src.rhs, power := __src.power,
                                next := __src.next });
                          CheckpointBytes5Output.accumulator state =
                              (OraclePortCheckpointStateC3.write
                                  (OraclePortCheckpointResumeC5.model data rho q)).accumulator ∧
                            Port3_CheckpointInstall.writer (Tx1Q_Install.digest D) (Tx1Q_Carriers.prepared run.p) state
                                  proof pub hash =
                                ok saved ∧
                              (↑run.flushed).length = 64 ∧ ↑run.out.next = 10
def AspisR1.Port1_CanonicalJoin.AcceptedVerifierJoin : LiteralByteProtocol.Decoder →
  OraclePortRuntimeBindingC7.Verifier → Prop :=
fun D rust =>
  ∀ (s : Port1_StoredCarrier.Submission) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
    (AspisV8R19.MemoizedProgramLaw.eval H (rust (Port1_StoredCarrier.input s))).2 = true →
      AspisV8R19.MemoizedProgramLaw.eval H (rust (Port1_StoredCarrier.input s)) =
        AspisV8R19.MemoizedProgramLaw.eval H
          (OraclePortStoredExperimentC4.verifier D OraclePortFrozen2.dV_frozen2 (Port1_StoredCarrier.input s))
