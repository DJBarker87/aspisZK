      S2W_TrustedStd.TrustedStd copy →
        ∀ (allocator : S2W_D189Wrappers.Allocator A) (e1 e2 : S2W_D189Entry.Entry) (w1 w2 : W),
          S2W_D189Consolidation.RuntimeEntrypointAdmission L e1 w1 3 →
            S2W_D189Consolidation.RuntimeEntrypointAdmission L e2 w2 7 →
              ∀ (adapterOps : AdapterRw.Ops) (ops : AspisR1CurrentCaller.Ops)
                (B : AspisR1PublicPreparation.FinishModel.Boundaries) (claimsStd : ClaimsUnrolledFinish.StdCalls)
                (native1 : S2W_ExtractionBoundary.First) (native2 : S2W_ExtractionBoundary.Second)
                (hashv : S2Z.Oracle.Parts → Result S2Z.Oracle.Digest),
                S2W_DigestExtraction.AeneasExtraction
                    (ClaimsUnrolledSdk.sdkOps adapterOps (Op3I_Install.install (Op4P_Install.install ops)) B claimsStd)
                    native1 native2 hashv →
                  ∀ (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
                    S2W_ExtractionBoundary.P1 sha256 H →
                      S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
                        ∀ (program : S2W_ExtractionBoundary.Program) (data1 data2 : Slice U8)
                          (slot : S2W_ExtractionBoundary.Slot) (state1 state2 final1 final2 : A)
                          (saved : alloc.vec.Vec U8) (post1 post2 : S2Trust.Heap (ℕ → S2W_D189Entry.Record)),
                          S2W_D189Wrappers.first native1 copy allocator e1 program data1 state1 =
                              ok (core.result.Result.Ok (saved, post1, final1)) →
                            S2W_D189Wrappers.second native2 allocator e2 program data2 slot state2 =
                                ok (core.result.Result.Ok (post2, final2)) →
                              ∀ (p : FS2.Duplex.Params M Cv N) (root : Std.Array U8 32#usize) (length : U32)
                                (port :
                                  S2W_ExpandedChildren.ChildConeJoin E
                                    (ClaimsUnrolledSdk.sdkOps adapterOps
                                      (Op3I_Install.install (Op4P_Install.install ops)) B claimsStd)),
                                S2W_TraceSplice.FirstMarks port →
                                  S2W_TraceSplice.SecondMarks port →
                                    ∃ f s outer pre middle fs ss,
                                      S2W_NativeConsolidation.SourceCuts
                                          (ClaimsUnrolledSdk.sdkOps adapterOps
                                            (Op3I_Install.install (Op4P_Install.install ops)) B claimsStd)
                                          e1.first (e2.second S2W_D189Wrappers.secondSizes) saved f s ∧
                                        ((RowShape_InstalledSlots.verifierOps
                                                    (Op3I_Install.install (Op4P_Install.install ops)) B claimsStd).op3
                                                f.proof =
                                              ok (core.result.Result.Ok AspisR1CurrentCaller.transport.Variant.S2) ∧
                                            Op3I_Install.sourceBody f.proof =
                                                ok (core.result.Result.Ok AspisR1CurrentCaller.transport.Variant.S2) ∧
                                              OraclePortHeader.accepts (MultiproofConeCanonical.bytesOf ↑f.proof) =
                                                  true ∧
                                                Op3I_Cuts.frozenHeader (MultiproofConeCanonical.bytesOf ↑f.proof) =
                                                  some AspisR1CurrentCaller.transport.Variant.S2) ∧
                                          ((RowShape_InstalledSlots.verifierOps
                                                      (Op3I_Install.install (Op4P_Install.install ops)) B claimsStd).op4
                                                  f.proof =
                                                ok (core.result.Result.Ok ()) ∧
                                              Op4P_Install.sourceBody f.proof = ok (core.result.Result.Ok ()) ∧
                                                OraclePortCompactDraft.scan
                                                  (MultiproofConeCanonical.bytesOf ↑f.proof)) ∧
