                                                    (Op3I_Install.install (Op4P_Install.install ops)) B claimsStd)
                                                  (S2W_ExpandedChildren.children port)
                                                  (S2W_Observation.two
                                                    (ClaimsUnrolledSdk.sdkOps adapterOps
                                                      (Op3I_Install.install (Op4P_Install.install ops)) B claimsStd)
                                                    program e1.first data1 (e2.second S2W_D189Wrappers.secondSizes)
                                                    data2 slot)
                                                  [] =
                                                ok
                                                  (core.result.Result.Ok saved,
                                                    S2W_ExpandedTrace.full (S2W_ExpandedChildren.children port) outer) ∧
                                              S2W_D189Interpretation.runOwned
                                                    (ClaimsUnrolledSdk.sdkOps adapterOps
                                                      (Op3I_Install.install (Op4P_Install.install ops)) B claimsStd)
                                                    (S2W_Observation.two
                                                      (ClaimsUnrolledSdk.sdkOps adapterOps
                                                        (Op3I_Install.install (Op4P_Install.install ops)) B claimsStd)
                                                      program e1.first data1 (e2.second S2W_D189Wrappers.secondSizes)
                                                      data2 slot)
                                                    [] e1.heap =
                                                  ok (core.result.Result.Ok saved, outer, e1.heap) ∧
                                                S2W_TraceSplice.projected port outer =
                                                    S2W_SiteSchedule.timeline pre middle fs ss ∧
                                                  post2 = e2.heap ∧
