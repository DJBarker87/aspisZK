@[defeq] theorem NLE_OwnedStep.proof_result : ∀ (ops : Ops) (state : State) (account : Account),
  (proof ops state account).result = r1_pool_adapter.owned.OwnedAccount.data ops account :=
fun ops state account => rfl
'NLE_OwnedStep.proof_result' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLE_OwnedStep.proof_events' depends on axioms: [propext, Classical.choice, Quot.sound]
