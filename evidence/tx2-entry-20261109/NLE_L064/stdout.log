def NLE_Auth.CommonResultPacket : {H : Type} → VTop_Stages.Ops → NLE_Auth.Common H → Prop :=
fun {H} ops child =>
  ∀ (f : NLE_Auth.Frame H),
    child f =
      VTop_Stages.verifier.candidate.tx2_common ops f.digest f.publicBytes f.proof f.checkpoint f.hash f.observer
def NLE_AuthLiteral.G : {H : Type} → NLE_Auth.Common H → NLE_Auth.Frame H → NLE_Auth.Run H NLE_Auth.Reply :=
fun {H} child frame => do
  let parsed ← NJU_Log.record (NLE_Auth.Event.parse frame.proof) (NLE_ParseInstall.parse frame.proof)
  NLE_Auth.tryR parsed fun x => do
      NJU_Log.record (NLE_Auth.Event.mark frame.observer)
          (NHV_ReleaseOps.mark frame.observer AdapterRw.aspis_r1_cost_probe.verifier.Phase.Parsed)
      NJU_Log.record (NLE_Auth.Event.common frame) (child frame)
@NLE_Auth.parameterized_fold : ∀ {H : Type} (ops : VTop_Stages.Ops) (child : NLE_Auth.Common H),
  NLE_Auth.CommonResultPacket ops child →
    ∀ (s : NLE_Auth.State H),
      (NLE_Auth.G ops child s).result =
        VTop_Stages.verifier.candidate.tx2_authenticated ops s.frame.digest s.frame.publicBytes s.frame.proof
          s.frame.checkpoint s.frame.hash s.frame.observer
NLE_OwnedFine.source : ∀ (ops : AdapterRw.Ops) (state : NLE_Owned.State),
  (NLE_OwnedFine.G ops state).result =
    AdapterRw.r1_pool_adapter.owned.stage2_owned ops state.frame.program state.frame.accounts state.frame.data
      state.frame.slot
