theorem NLE_Dispatch.source : ∀ {Account : Type} (ops : NIV_RawBoundary.Boundaries Account) (state : State Account),
  (G ops state).2 = NIV_RawBoundary.process ops state.program state.accounts state.data :=
fun {Account} ops state => id (NJD_EntrySpine.process_erasure ops state.program state.accounts state.data)
theorem NLE_Dispatch.emitted : ∀ {Account : Type} (ops : Hiq_DispatchSource.Ops Account) (state : State Account),
  (G (NIV_RawBoundary.profile ops) state).2 =
    NIV_ExtractedForward.process ops state.program state.accounts state.data :=
fun {Account} ops state =>
  Eq.mpr
    (id
      (congrArg (fun _a => _a = NIV_ExtractedForward.process ops state.program state.accounts state.data)
        (source (NIV_RawBoundary.profile ops) state)))
    (NIV_RawBoundary.process_profile ops state.program state.accounts state.data)
'NLE_Dispatch.source' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLE_Dispatch.emitted' depends on axioms: [propext, Classical.choice, Quot.sound]
