@[defeq] theorem NLE_OwnedStep.encode_result : ∀ (ops : Ops) (state : State) (statement : Statement),
  (encode ops state statement).result = ops.op22 statement :=
fun ops state statement => rfl
'NLE_OwnedStep.encode_result' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLE_OwnedStep.encode_events' depends on axioms: [propext, Classical.choice, Quot.sound]
