theorem NLE_RouteFold.entry : ∀ {Account : Type} (ops : Hiq_DispatchSource.Ops Account)
  (state : NLE_Dispatch.State Account),
  Hiq_ReleaseRoute.asq8 state.data →
    (NLE_Entry.G (NIV_RawBoundary.profile ops) state).2 = ops.second state.program state.accounts state.data :=
fun {Account} ops state header =>
  Eq.mpr
    (id (congrArg (fun _a => _a = ops.second state.program state.accounts state.data) (NLE_Entry.emitted ops state)))
    (Eq.mpr
      (id
        (congrArg (fun _a => _a = ops.second state.program state.accounts state.data)
          (NIV_ExtractedForward.forwarding ops state.program state.accounts state.data)))
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              (match _a with
                | Hiq_ReleaseRoute.Route.first => ops.first state.program state.accounts state.data
                | Hiq_ReleaseRoute.Route.second => ops.second state.program state.accounts state.data
                | Hiq_ReleaseRoute.Route.reject =>
                  ok (core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidInstructionData)) =
                ops.second state.program state.accounts state.data)
            (asq8_route state.data header)))
        (Eq.refl
          (match Hiq_ReleaseRoute.Route.second with
          | Hiq_ReleaseRoute.Route.first => ops.first state.program state.accounts state.data
          | Hiq_ReleaseRoute.Route.second => ops.second state.program state.accounts state.data
          | Hiq_ReleaseRoute.Route.reject =>
            ok (core.result.Result.Err AdapterRw.solana_program_error.ProgramError.InvalidInstructionData)))))
theorem NLE_RouteFold.child_packet : ∀ {Account State Event : Type}
  (children : NGL_EntryRouting.Children Account State Event) (state : State) (program : Hiq_DispatchSource.Key)
  (accounts : Slice Account) (data : Slice U8),
  Hiq_ReleaseRoute.asq8 data →
    NGL_EntryRouting.run children program accounts data state =
      (children.second program accounts data state, [NGL_EntryRouting.Call.second program accounts data]) :=
fun {Account State Event} children state program accounts data header =>
  NIV_ForwardPacket.second children state program accounts data (asq8_route data header)
'NLE_RouteFold.asq8_route' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLE_RouteFold.entry' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLE_RouteFold.child_packet' depends on axioms: [propext, Classical.choice, Quot.sound]
