@[defeq] theorem NLE_OwnedStep.emit_result : ∀ (ops : Ops) (state : State) (statement : Statement),
  (emit ops state statement).result = ops.op53 statement :=
fun ops state statement => rfl
'NLE_OwnedStep.emit_result' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLE_OwnedStep.emit_events' depends on axioms: [propext, Classical.choice, Quot.sound]
