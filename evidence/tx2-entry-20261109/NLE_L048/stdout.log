@[defeq] theorem NLE_OwnedStep.tx2_result : ∀ (ops : Ops) (state : State) (publicBytes proof checkpoint : Slice U8)
  (observer : Option (aspis_r1_cost_probe.verifier.Phase → Result Unit)),
  (tx2 ops state publicBytes proof checkpoint observer).result =
    ops.op11 (SolanaDigest.Insts.Aspis_coreDigestDigest32 ops) publicBytes proof checkpoint () observer :=
fun ops state publicBytes proof checkpoint observer => rfl
@[defeq] theorem NLE_OwnedStep.release_observer : ∀ (ops : Ops), observer ops = ok none :=
fun ops => rfl
'NLE_OwnedStep.tx2_result' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLE_OwnedStep.release_observer' depends on axioms: [propext, Classical.choice, Quot.sound]
