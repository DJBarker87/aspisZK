@[defeq] theorem NLE_OwnedStep.validate_result : ∀ (ops : Ops) (state : State),
  (validate ops state).result =
    r1_pool_adapter.owned.validate_asq8 ops state.frame.program state.frame.accounts state.frame.data
      state.frame.slot :=
fun ops state => rfl
'NLE_OwnedStep.validate_result' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLE_OwnedStep.validate_events' depends on axioms: [propext, Classical.choice, Quot.sound]
