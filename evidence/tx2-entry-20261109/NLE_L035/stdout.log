theorem NLE_AuthScope.common_domain : ∀ {H : Type} (ops : Ops) (child : Common H) (s : State H)
  (bytes : Std.Array U8 1880#usize) (frame : Frame H) (reply : Result Reply),
  Event.common frame reply ∈ (G (install ops) child (withPublic s bytes)).events →
    (↑frame.proof).length = 57607 ∧ (↑frame.publicBytes).length ≤ 1880 ∧ frame.observer = none :=
fun {H} ops child s bytes frame reply event =>
  let ⟨same, right✝⟩ := entered (install ops) child (withPublic s bytes) frame reply event
  let ⟨value, parsed⟩ := right✝
  Eq.ndrec (motive := fun frame =>
    Event.common frame reply ∈ (G (install ops) child (withPublic s bytes)).events →
      (↑frame.proof).length = 57607 ∧ (↑frame.publicBytes).length ≤ 1880 ∧ frame.observer = none)
    (fun event =>
      have exactProof := NLE_ParseInstall.success s.frame.proof value parsed;
      ⟨exactProof.right, ⟨(NLE_Length.public_scope bytes).right, rfl⟩⟩)
    (Eq.symm same) event
