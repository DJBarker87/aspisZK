theorem NLE_AuthScope.entered : ∀ {H : Type} (ops : Ops) (child : Common H) (s : State H) (frame : Frame H)
  (reply : Result Reply),
  Event.common frame reply ∈ (G ops child s).events →
    frame = s.frame ∧ ∃ value, ops.op3 s.frame.proof = ok (core.result.Result.Ok value) :=
fun {H} ops child s frame reply event =>
  casesOn (motive := fun t =>
    ops.op3 s.frame.proof = t → frame = s.frame ∧ ∃ value, ops.op3 s.frame.proof = ok (core.result.Result.Ok value))
    (ops.op3 s.frame.proof)
    (fun result h =>
      Eq.ndrec (motive := fun x =>
        ops.op3 s.frame.proof = x → frame = s.frame ∧ ∃ value, x = ok (core.result.Result.Ok value))
        (fun h =>
          core.result.Result.casesOn (motive := fun t =>
            result = t → frame = s.frame ∧ ∃ value, ok result = ok (core.result.Result.Ok value)) result
            (fun value h_1 =>
              Eq.ndrec (motive := fun result =>
                ops.op3 s.frame.proof = ok result →
                  frame = s.frame ∧ ∃ value, ok result = ok (core.result.Result.Ok value))
                (fun h =>
                  casesOn (motive := fun t =>
                    ops.op13 s.frame.observer AdapterRw.aspis_r1_cost_probe.verifier.Phase.Parsed = t →
                      frame = s.frame ∧
                        ∃ value_1, ok (core.result.Result.Ok value) = ok (core.result.Result.Ok value_1))
                    (ops.op13 s.frame.observer AdapterRw.aspis_r1_cost_probe.verifier.Phase.Parsed)
                    (fun unit h =>
                      Eq.ndrec (motive := fun x =>
                        ops.op13 s.frame.observer AdapterRw.aspis_r1_cost_probe.verifier.Phase.Parsed = x →
                          frame = s.frame ∧
                            ∃ value_1, ok (core.result.Result.Ok value) = ok (core.result.Result.Ok value_1))
                        (fun marker => ⟨sorry, Exists.intro value sorry⟩) (Eq.symm h)
                        (Eq.refl (ops.op13 s.frame.observer AdapterRw.aspis_r1_cost_probe.verifier.Phase.Parsed)))
                    (fun err h =>
                      Eq.ndrec (motive := fun x =>
                        ops.op13 s.frame.observer AdapterRw.aspis_r1_cost_probe.verifier.Phase.Parsed = x →
                          frame = s.frame ∧
                            ∃ value_1, ok (core.result.Result.Ok value) = ok (core.result.Result.Ok value_1))
                        (fun marker => sorry) (Eq.symm h)
                        (Eq.refl (ops.op13 s.frame.observer AdapterRw.aspis_r1_cost_probe.verifier.Phase.Parsed)))
                    (fun h =>
