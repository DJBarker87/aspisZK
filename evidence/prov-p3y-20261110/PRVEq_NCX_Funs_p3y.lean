  · simp only [if_neg c9, if_pos c9]; simp [mapRes, eMap]
  simp only [if_pos c9, if_neg (not_not_intro c9)]
  by_cases hm : e.retirement_slot = core.num.U64.MAX
  · simp [hm, mapRes, eMap]
  by_cases hle : e.retirement_slot ≤ e.activation_slot
  · simp [hm, hle, mapRes, eMap]
  · simp [hm, hle, mapRes, eMap]
