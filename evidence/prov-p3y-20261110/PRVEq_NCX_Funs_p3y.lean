theorem PRVEq.NCX_Reference.Funs_p3y.validate_verifier_registry_entry_v2
    (e : PRVFresh_NCX_Funs_p3y.pool_v1.verifier_registry.VerifierRegistryEntryV2) :
    (do let x ← PRVFresh_NCX_Funs_p3y.pool_v1.verifier_registry.validate_verifier_registry_entry_v2 e; ok (mapRes x))
      = NCX_Reference.validate_verifier_registry_entry_v2 (entMap e) := by
  unfold PRVFresh_NCX_Funs_p3y.pool_v1.verifier_registry.validate_verifier_registry_entry_v2
    NCX_Reference.validate_verifier_registry_entry_v2
  simp only [frbz, PRVEq_P3Y.rbz_gate, fne, fhnr, entMap, lift, bind_tc_ok, ite_bind', decide_eq_true_eq]
  by_cases c0 : e.statement_version = 0#u8
  · simp [c0, mapRes, eMap]
  simp only [c0, if_false]
  by_cases c1 : ∀ x ∈ e.pool.val, x = 0#u8
  · simp only [if_pos c1]; simp [mapRes, eMap]
  simp only [if_neg c1]
  by_cases c2 : ∀ x ∈ e.verifier_program.val, x = 0#u8
  · simp only [if_pos c2]; simp [mapRes, eMap]
  simp only [if_neg c2]
  by_cases c3 : ∀ x ∈ e.profile_binding.val, x = 0#u8
  · simp only [if_pos c3]; simp [mapRes, eMap]
  simp only [if_neg c3]
  by_cases c4 : ∀ x ∈ e.release_binding.val, x = 0#u8
  · simp only [if_pos c4]; simp [mapRes, eMap]
  simp only [if_neg c4]
  by_cases c5 : ∀ x ∈ e.loader_program.val, x = 0#u8
  · simp only [if_pos c5]; simp [mapRes, eMap]
  simp only [if_neg c5]
  by_cases c6 : ∀ x ∈ e.programdata_address.val, x = 0#u8
  · simp only [if_pos c6]; simp [mapRes, eMap]
  simp only [if_neg c6]
  by_cases c7 : ∀ x ∈ e.executable_hash.val, x = 0#u8
  · simp only [if_pos c7]; simp [mapRes, eMap]
  simp only [if_neg c7]
  by_cases c8 : ∀ x ∈ e.policy_binding.val, x = 0#u8
  · simp only [if_pos c8]; simp [mapRes, eMap]
  simp only [if_neg c8]
  by_cases c9 : ∀ x ∈ e.expected_upgrade_authority.val, x = 0#u8
