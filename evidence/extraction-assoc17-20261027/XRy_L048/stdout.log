theorem AspisR1ClaimPreparedBridge.scalar_candidate_gamma_canonical : ∀ {H : Type}
  (sampling : AspisR1PublicPreparation.PreparedModel.Boundaries) (D : AspisR1PublicPreparation.aspis_core.Digest32 H)
  (before after : AspisR1PublicPreparation.transcript.Transcript H) (row : U8) (payload : Slice U8)
  (out : AspisR1ClaimPreparedBridge.PE),
  AspisR1PublicPreparation.PreparedModel.scalar (AspisR1ClaimPreparedBridge.withCandidateGamma sampling) D before row
        payload true =
      ok (out, after) →
    AspisR1CurrentPreparedClaim.Concrete.Canonical (AspisR1ClaimPreparedBridge.toClaimE out) :=
fun {H} sampling D before after row payload out h =>
  let ⟨p, h✝⟩ :=
    AspisR1ClaimPreparedBridge.bind_success✝ (AspisR1PublicPreparation.transcript.Transcript.block D before row payload)
      (uncurry fun block self1 => do
        let out ←
          if true = true then (AspisR1ClaimPreparedBridge.withCandidateGamma sampling).gamma block
            else (AspisR1ClaimPreparedBridge.withCandidateGamma sampling).ordinary block
        let i ← lift (UScalar.cast UScalarTy.Usize row)
        AspisR1PublicPreparation.trace.value 4#u16 i out
        ok (out, self1))
      (out, after) h
  let ⟨hblock, h⟩ := h✝
  let ⟨block, t, hblock, h⟩ := p
  let ⟨value, h✝¹⟩ :=
    AspisR1ClaimPreparedBridge.bind_success✝ (AspisR1ClaimPreparedBridge.candidateGammaPublic block)
      (fun x => do
        let i ← lift (UScalar.cast UScalarTy.Usize row)
        AspisR1PublicPreparation.trace.value 4#u16 i x
        ok (x, t))
      (out, after)
      (Eq.mp
        (congrFun'
          (congrArg Eq
            (congrFun'
              (congrArg uncurry
                (funext fun block =>
                  funext fun self1 =>
                    congrFun'
                      (congrArg Bind.bind
                        (ite_congr (eq_self true)
                          (fun a => Eq.refl (AspisR1ClaimPreparedBridge.candidateGammaPublic block)) fun a =>
                          Eq.refl (sampling.ordinary block)))
                      fun out => do
                      let i ← lift (UScalar.cast UScalarTy.Usize row)
                      AspisR1PublicPreparation.trace.value 4#u16 i out
                      ok (out, self1)))
              (block, t)))
          (ok (out, after)))
        h)
  let ⟨hvalue, h⟩ := h✝¹
  let ⟨i, h✝²⟩ :=
    AspisR1ClaimPreparedBridge.bind_success✝ (lift (UScalar.cast UScalarTy.Usize row))
      (fun x => do
        AspisR1PublicPreparation.trace.value 4#u16 x value
        ok (value, t))
      (out, after) h
  let ⟨hi, h⟩ := h✝²
  let ⟨u, h✝³⟩ :=
    AspisR1ClaimPreparedBridge.bind_success✝ (AspisR1PublicPreparation.trace.value 4#u16 i value)
      (fun x => ok (value, t)) (out, after) h
  let ⟨htrace, h⟩ := h✝³
  have he := congrArg Prod.fst (ok.inj h);
  Eq.mpr
    (id
      (congrArg (fun _a => AspisR1CurrentPreparedClaim.Concrete.Canonical (AspisR1ClaimPreparedBridge.toClaimE _a))
        (Eq.symm he)))
    (AspisR1ClaimPreparedBridge.candidateGammaPublic_success_canonical block value hvalue)
def AspisR1ClaimPreparedBridge.candidateGammaPublic : Std.Array U8 32#usize → Result AspisR1ClaimPreparedBridge.PE :=
fun block => do
  let out ← AspisR1GammaCaller.sampler.gamma_sample AspisR1GammaCaller.DigitsModel.candidateGammaHelpers block
  ok (AspisR1ClaimPreparedBridge.gammaToPublic out)
