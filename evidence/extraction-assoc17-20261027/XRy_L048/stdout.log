    Array.repeat 7#usize AspisR1CurrentPreparedClaim.aspis_core.field.WideExact.ZERO
  let a ← parts.update 0#usize inactive
  AspisR1CurrentPreparedClaim.verifier.prepared_claim_loop ops aspis_coreDigest32Inst
      { start := 0#usize, «end» := 6#usize } sem y1 g k a
