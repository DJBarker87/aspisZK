+#[derive(Clone,Copy)]struct NBR_Digest;
+static mut NBR_ENABLED:bool=false;static mut NBR_MODE:u8=0;static mut NBR_STAGE:usize=0;static mut NBR_INDEX:usize=0;
+static mut NBR_STATES:[[u8;32];5]=[[0;32];5];static mut NBR_SEM_STATE:[u8;32]=[0;32];static mut NBR_SERIALIZED:[u8;32]=[0;32];static mut NBR_INACTIVE:E=E::ZERO;
+static mut NBR_Y:*const u8=core::ptr::null();static mut NBR_R0:*const u8=core::ptr::null();static mut NBR_ROOT:*const u8=core::ptr::null();static mut NBR_FINAL:*const u8=core::ptr::null();static mut NBR_PAYLOAD:*const u8=core::ptr::null();
+impl Digest32 for NBR_Digest{fn digest(&self,parts:&[&[u8]])->[u8;32]{unsafe{
+ if !NBR_ENABLED{return kani::any();}assert_eq!(NBR_MODE,0);assert_eq!(NBR_STAGE,0);assert_eq!(parts.len(),3);assert_eq!(parts[0].len(),29);assert_eq!(parts[1].len(),1);assert_eq!(parts[1][0],2);assert_eq!(parts[2].len(),32);
+ let j:usize=kani::any();kani::assume(j<29);assert_eq!(parts[0][j],b"UNPROVED:R1:PRIVATE-SALTED:P3"[j]);assert_eq!(parts[2][NBR_INDEX],NBR_SEM_STATE[NBR_INDEX]);NBR_STAGE=1;NBR_STATES[0]
+}}}
+fn NBR_scalar<H:Digest32>(t:&mut Transcript<H>,row:u8,payload:&[u8],nonzero:bool)->E{unsafe{
+ assert!(NBR_STAGE>=1&&NBR_STAGE<=4);let k=NBR_STAGE-1;assert_eq!(row,27+k as u8);assert_eq!(nonzero,k==0);assert_eq!(t.state[NBR_INDEX],NBR_STATES[k][NBR_INDEX]);
+ if k==0{assert_eq!(payload.as_ptr(),NBR_Y);assert_eq!(payload.len(),928);}
+ if k==1{assert_eq!(payload.len(),32);assert_eq!(payload[NBR_INDEX],NBR_SERIALIZED[NBR_INDEX]);}
+ if k==2{assert_eq!(payload.as_ptr(),NBR_R0);assert_eq!(payload.len(),224);}
