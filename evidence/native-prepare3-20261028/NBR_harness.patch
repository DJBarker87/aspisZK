+ t.state=NBR_STATES[k+1];NBR_STAGE+=1;core::mem::transmute::<[u8;32],E>(kani::any())
+}}
+fn NBR_serialize_cut(value:E)->[u8;32]{unsafe{assert_eq!(NBR_MODE,0);assert_eq!(NBR_STAGE,2);assert_eq!(value,NBR_INACTIVE);kani::cover!(true,"actual salted seed/gamma reach SAME inactive serializer");kani::assume(false);[0;32]}}
+fn NBR_extend_cut<T:Copy,A:alloc::alloc::Allocator>(dst:&mut alloc::vec::Vec<T,A>,src:&[T]){unsafe{assert_eq!(NBR_MODE,1);assert_eq!(NBR_STAGE,4);assert_eq!(core::mem::size_of::<T>(),1);assert_eq!(dst.len(),0);assert_eq!(dst.capacity(),256);assert_eq!(src.len(),32);assert_eq!(src.as_ptr() as *const u8,NBR_ROOT);kani::cover!(true,"kappa/alpha0 reach SAME first append carrier and root");kani::assume(false);}}
+fn NBR_queries<H:Digest32>(t:&mut Transcript<H>,row:u8,payload:&[u8])->Result<[u32;22],Error>{unsafe{assert_eq!(NBR_MODE,2);assert_eq!(NBR_STAGE,5);assert_eq!(row,31);assert_eq!(payload.as_ptr(),NBR_FINAL);assert_eq!(payload.len(),2048);assert_eq!(t.state[NBR_INDEX],NBR_STATES[4][NBR_INDEX]);NBR_STAGE=6;Err(Error::Transcript)}}
+fn NBR_after_serialized<H:Digest32>(v:&View<'_>,mut t:Transcript<H>,serialized:[u8;32])->Result<(),Error>{
+ let _kappa=t.scalar(28,&serialized,false);let alpha0=t.scalar(29,v.round0,false);
+ let (_alpha,_row)=if v.variant.folds()==2{let mut bytes=Vec::with_capacity(32+224);bytes.extend_from_slice(v.folded_root.unwrap());bytes.extend_from_slice(v.round1);([alpha0,t.scalar(30,&bytes,false)],31)}else{([alpha0,E::ZERO],30)};
+ assert!(false,"first append cut must terminate this S2 branch");Err(Error::Parse)
+}
+fn NBR_after_appended<H:Digest32>(v:&View<'_>,mut t:Transcript<H>,owned:Vec<u8>,alpha0:E)->Result<Box<Prepared>,Error>{
+ // Preserve the original branch-local Vec destruction BEFORE queries.
+ let (_alpha,row)={let bytes=owned;([alpha0,t.scalar(30,&bytes,false)],31)};
