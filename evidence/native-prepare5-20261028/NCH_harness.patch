+fn NCH_geometry(row:u8)->(usize,usize){let r=row as usize;let s=if r<=2{32+5*r}else if r<=14{64+5*r}else if r<=25{155+453*(r-15)}else{6546};let d=if r<=2{32+5*r}else if r<=14{64+5*r}else if r<=25{171+901*(r-15)}else{12898};(s,d)}
