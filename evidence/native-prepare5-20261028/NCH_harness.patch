+fn NCH_cell_borrow_domain(){let input:[u8;7015]=kani::any();let mut logical:[u8;14759]=kani::any();let base=logical.as_mut_ptr();let row:u8=kani::any();kani::assume(14<=row&&row<27);let(src,dst)=NCH_geometry(row);let size=crate::r1_wire::row_shape(row).unwrap().1;let i:usize=kani::any();kani::assume(i<size/32);let s=src+5+16*i;let d=dst+5+32*i;
