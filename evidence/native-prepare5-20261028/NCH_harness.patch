+fn NCH_row_borrow_domain(){
+ let input:[u8;7015]=kani::any();let mut logical:[u8;14759]=kani::any();let base=logical.as_mut_ptr();let row:u8=kani::any();kani::assume(row<27);let(src,dst)=NCH_geometry(row);let size=crate::r1_wire::row_shape(row).unwrap().1;
+ let(semantic,y1)=logical.split_at_mut(13831);assert_eq!(semantic.as_ptr(),base);assert_eq!(y1.as_ptr(),unsafe{base.add(13831)});assert_eq!(y1.len(),928);
+ {let source=&input[src..src+5];let target=&mut semantic[dst..dst+5];assert_eq!(source.len(),5);assert_eq!(target.len(),5);assert_eq!(source.as_ptr(),unsafe{input.as_ptr().add(src)});assert_eq!(target.as_ptr(),unsafe{base.add(dst)});}
+ let start_src=src+5;let start_dst=dst+5;let width=if row>=14{size/2}else{size};let source=&input[start_src..start_src+width];let target=&mut semantic[start_dst..start_dst+size];assert_eq!(source.len(),width);assert_eq!(target.len(),size);assert_eq!(target.as_ptr(),unsafe{base.add(start_dst)});assert!(start_dst+size<=13831);assert!(start_src+width<=7015);
+ if row>=14{assert!(width<=1856);assert_eq!(width%16,0);assert_eq!(target.len(),2*source.len());}else{assert_eq!(source.len(),target.len());}
