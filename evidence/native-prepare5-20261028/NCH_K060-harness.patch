+fn NCH_constructor_capacity(){let v=Vec::<u8>::with_capacity(32+224);assert_eq!(v.len(),0);assert_eq!(v.capacity(),256);}
+#[kani::proof]#[kani::unwind(3)]
+fn NCH_constructor_capacity_wrong(){let v=Vec::<u8>::with_capacity(32+224);assert_eq!(v.capacity(),0);}
