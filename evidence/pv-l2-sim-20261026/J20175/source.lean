import R1Z.PV_L2_F3SourceCounts
import R1Z.PV_L2_F3Blocks
import R1Z.ProverCommitOwnedArrayLaw

/-! Count arrays in the joint raw-block law are generated by the concrete
source-shaped scalar collector, starting from the actual empty-cache state. -/
set_option autoImplicit false
noncomputable section
namespace R1Z.PV_L2_F3SourceArrays
open Aeneas Aeneas.Std Result R0Z.FsStatement
open R1Z.ProverCommitOwnedDecoder R1Z.ProverCommitSequentialFibres
  R1Z.ProverCommitWordCarrier R1Z.FinalR1PBin R1Z.PV_L2_F3CountedFibres
  R1Z.PV_L2_F3SourceCounts
open R1Z.ProverCommitStepLoop (Hash)
attribute [local instance] Classical.propDecidable
attribute [local irreducible] sourceBase
variable {K : Type} [Field K] [Algebra (ZMod AspisCircleGroupOrder.P) K]
local notation "F" => sourceBase (K := K)

theorem initial_model {B : Nat} (answers : Fin B → OracleAnswer) (domain : Slice U8)
    (capacity : B<2^64) (L : Nat) (budget : 16*L≤B*8) :
    source (K := K) (blockHash answers) domain L 16 initial =
      (counted (accepted (K := K)) (B*8) L 16 (wordsE B answers)).map (valuesList L) := by
  cases L with
  | zero => rw [counted_no_values];simp only [source]
  | succ L =>
    apply source_model answers domain capacity (B*8) L 16 initial
      (by simp [valid,initial]) (initial_cache answers)
      (by have zero : position initial=0 := rfl;rw [zero];omega) (by omega)
      (wordsE B answers)
    intro i
    apply congrArg (wordsE B answers)
    apply Fin.ext
    have zero : position initial=0 := rfl
    simp only [zero,Nat.zero_add]

def splitList (L : Nat) (values : List (F × Nat)) : (Fin L → F) × (Fin L → Nat) :=
  ((fun i => (values[i.val]?.getD (fieldValue 0#u32,0)).1),
   (fun i => (values[i.val]?.getD (fieldValue 0#u32,0)).2))

theorem splitList_values (L : Nat) (v : Values (F × Nat) L) :
    splitList L (valuesList L v) = PV_L2_F3CountedArrays.split F L v := by
  apply Prod.ext <;> funext i
  · unfold splitList
    rw [valuesList_index (fieldValue 0#u32,0) L v i]
    rfl
  · unfold splitList
    rw [valuesList_index (fieldValue 0#u32,0) L v i]
    rfl

def sourceArrays (hash : Hash) (domain : Slice U8) (L : Nat) :=
  (source (K := K) hash domain L 16 initial).map (splitList L)

/-- Concrete source counts and values equal the history-aware block decoder.
No history-equality hypothesis is supplied by the caller. -/
theorem source_arrays {B : Nat} (answers : Fin B → OracleAnswer) (domain : Slice U8)
    (capacity : B<2^64) (L : Nat) (budget : 16*L≤B*8) :
    sourceArrays (K := K) (blockHash answers) domain L = PV_L2_F3Blocks.blocks B L answers := by
  unfold sourceArrays
  rw [initial_model answers domain capacity L budget]
  simp only [Option.map_map]
  unfold PV_L2_F3Blocks.blocks PV_L2_F3CountedArrays.arrays
  congr 1
  funext v
  exact splitList_values L v

#print axioms initial_model
#print axioms splitList_values
#print axioms source_arrays
end R1Z.PV_L2_F3SourceArrays
