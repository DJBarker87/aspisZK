import R1Z.PV_L2_F6FlagLoop

/-! Source-shaped nvec_row_ok: retain every checked arithmetic/index prefix.
Generated by make-checker-records.py; erasure checks the actual extraction. -/
set_option autoImplicit false
namespace R1Z.PV_L2_F6NullRowStep
open Aeneas Aeneas.Std Result R1CertCheck R1Z.CertCheck R1Z.PV_L2_Record

def step 
  (nm : Slice Std.U32) (e : Slice Std.U32) (n : Std.Usize)
  (tag : Slice Std.U32) (r : Std.Usize) (f : Std.Usize) (ff : Std.Usize) (ok1 : Bool) (t : Usize) : Result (Bool × Usize) := do
  let i ← Slice.index_usize tag t
  let g ← lift (UScalar.cast .Usize i)
  let isf ← lift (UScalar.cast_fromBool .U64 (t = ff))
  let ip ← lift (UScalar.cast_fromBool .U64 (g < r))
  let i1 ← g % r
  let i2 ← i1 * n
  let i3 ← i2 + ff
  let i4 ← Slice.index_usize e i3
  let i5 ← lift (UScalar.cast .U64 i4)
  let ev ← i5 % P
  let i6 ← isf + P
  let i7 ← ip * ev
  let i8 ← i6 - i7
  let want ← i8 % P
  let i9 ← f * n
  let i10 ← i9 + t
  let i11 ← Slice.index_usize nm i10
  let i12 ← lift (UScalar.cast .U64 i11)
  let t1 ← t + 1#usize
  ok (ok1 && (i12 = want),t1)

def recorded 
  (nm : Slice Std.U32) (e : Slice Std.U32) (n : Std.Usize)
  (tag : Slice Std.U32) (r : Std.Usize) (f : Std.Usize) (ff : Std.Usize) (ok1 : Bool) (t : Usize) : Recorded (Bool × Usize) := do
  let i ← operation (.index 3 t.val) (Slice.index_usize tag t)
  let g := UScalar.cast .Usize i
  let isf ← operation (.guard 14 0 0 (t = ff)) (ok (UScalar.cast_fromBool .U64 (t = ff)))
  let ip ← operation (.guard 14 0 0 (g < r)) (ok (UScalar.cast_fromBool .U64 (g < r)))
  let i1 ← operation (.rem g.val r.val) (g % r)
  let i2 ← operation (.mul i1.val n.val) (i1 * n)
  let i3 ← operation (.add i2.val ff.val) (i2 + ff)
  let i4 ← operation (.index 1 i3.val) (Slice.index_usize e i3)
  let i5 := UScalar.cast .U64 i4
  let ev ← operation (.rem i5.val P.val) (i5 % P)
  let i6 ← operation (.add isf.val P.val) (isf + P)
  let i7 ← operation (.mul ip.val ev.val) (ip * ev)
  let i8 ← operation (.guard 14 i6.val i7.val true) (i6 - i7)
  let want ← operation (.rem i8.val P.val) (i8 % P)
  let i9 ← operation (.mul f.val n.val) (f * n)
  let i10 ← operation (.add i9.val t.val) (i9 + t)
  let i11 ← operation (.index 0 i10.val) (Slice.index_usize nm i10)
  let i12 := UScalar.cast .U64 i11
  let t1 ← operation (.add t.val (1#usize).val) (t + 1#usize)
  operation (.guard 14 0 0 (i12 = want)) (ok (ok1 && (i12 = want),t1))

theorem recorded_erases 
  (nm : Slice Std.U32) (e : Slice Std.U32) (n : Std.Usize)
  (tag : Slice Std.U32) (r : Std.Usize) (f : Std.Usize) (ff : Std.Usize) (ok1 : Bool) (t : Usize) :
    (recorded nm e n tag r f ff ok1 t).value = step nm e n tag r f ff ok1 t := by
  simp only [recorded,step,operation_bind_value,operation_value,lift,bind_tc_ok]

theorem unroll 
  (nm : Slice Std.U32) (e : Slice Std.U32) (n : Std.Usize)
  (tag : Slice Std.U32) (r : Std.Usize) (f : Std.Usize) (ff : Std.Usize) (ok1 : Bool) (t : Usize) :
    nvec_row_ok_loop nm e n tag r f ff ok1 t =
      if t<n then (do
        let (flag1,index1) ← step nm e n tag r f ff ok1 t
        nvec_row_ok_loop nm e n tag r f ff flag1 index1) else ok ok1 := by
  rw [nvec_row_ok_loop]
  split
  · simp only [step,bind_assoc_eq,bind_tc_ok]
  · rfl

theorem increment 
  (nm : Slice Std.U32) (e : Slice Std.U32) (n : Std.Usize)
  (tag : Slice Std.U32) (r : Std.Usize) (f : Std.Usize) (ff : Std.Usize) (ok1 : Bool) (t : Usize) (after : Bool × Usize)
    (success : step nm e n tag r f ff ok1 t = ok after) : after.2.val=t.val+1 := by
  unfold step at success
  obtain ⟨i,hi,success⟩ := bind_eq_ok success
  obtain ⟨g,hg,success⟩ := bind_eq_ok success
  obtain ⟨isf,hisf,success⟩ := bind_eq_ok success
  obtain ⟨ip,hip,success⟩ := bind_eq_ok success
  obtain ⟨i1,hi1,success⟩ := bind_eq_ok success
  obtain ⟨i2,hi2,success⟩ := bind_eq_ok success
  obtain ⟨i3,hi3,success⟩ := bind_eq_ok success
  obtain ⟨i4,hi4,success⟩ := bind_eq_ok success
  obtain ⟨i5,hi5,success⟩ := bind_eq_ok success
  obtain ⟨ev,hev,success⟩ := bind_eq_ok success
  obtain ⟨i6,hi6,success⟩ := bind_eq_ok success
  obtain ⟨i7,hi7,success⟩ := bind_eq_ok success
  obtain ⟨i8,hi8,success⟩ := bind_eq_ok success
  obtain ⟨want,hwant,success⟩ := bind_eq_ok success
  obtain ⟨i9,hi9,success⟩ := bind_eq_ok success
  obtain ⟨i10,hi10,success⟩ := bind_eq_ok success
  obtain ⟨i11,hi11,success⟩ := bind_eq_ok success
  obtain ⟨i12,hi12,success⟩ := bind_eq_ok success
  obtain ⟨t1,ht1,success⟩ := bind_eq_ok success
  have he := ok_inj success
  rw [←he]
  simpa only [show (1#usize).val=1 from rfl] using add_ok ht1

