/-- [ndh_reference::point_ref]:
    Source: 'src/lib.rs', lines 263:0-263:166
    Visibility: public -/
def point_ref
  (index : Std.Usize) (product : Array Std.U32 2#usize) :
  Result (Array Std.U32 6#usize)
  := do
  let i ← lift (index &&& 511#usize)
  let left ← Array.index_usize TABLE_A i
  let i1 ← index >>> 9#i32
  let right ← Array.index_usize TABLE_B i1
  let (i2, i3) := left
  let (i4, i5) := right
  let i6 ← Array.index_usize product 0#usize
  let i7 ← Array.index_usize product 1#usize
  ok (Array.make 6#usize [ i2, i3, i4, i5, i6, i7 ])

end NEA_PointReference
