+use super::*;
+static mut COUNT:usize=0;
+static mut LEFT:[u32;2]=[0;2];
+static mut RIGHT:[u32;2]=[0;2];
+static mut REPLY:[u32;2]=[0;2];
+fn words(x:CM31)->[u32;2] {[x.a.0,x.b.0]}
+fn canonical(x:CM31)->bool {x.a.0<2147483647 && x.b.0<2147483647}
+// Opaque product log: UNIVERSAL over canonical replies, not an asserted product.
+// Lean selects the one exact canonical natural-number product after this check.
+fn cm_mul(x:CM31,y:CM31)->CM31 {
+ assert!(canonical(x) && canonical(y));
+ let z=CM31{a:M31(kani::any()),b:M31(kani::any())};kani::assume(canonical(z));
+ unsafe {COUNT+=1;LEFT=words(x);RIGHT=words(y);REPLY=words(z);}
+ z
+}
+pub fn point_post(u:FibreIndex,r:Point<M31>)->bool {unsafe {
+ let i=u.get();let a=TABLE_A[i&511];let b=TABLE_B[i>>9];
+ let association=COUNT==1 && LEFT==[a.0,a.1] && RIGHT==[b.0,b.1];
+ let returned=r.x.0==REPLY[0] && r.y.0==REPLY[1];
+ association && if cfg!(NEA_wrong_point){!returned}else{returned}
+}}
+#[kani::proof_for_contract(fibre_point)]
+#[kani::stub(CM31::mul,cm_mul)]
+#[kani::stub(core::ptr::copy_nonoverlapping,crate::NEA_copy::KMX_copy_nonoverlapping)]
+fn point() {unsafe{COUNT=0;} let i:usize=kani::any();kani::assume(i<262144);let u=FibreIndex::new(i).unwrap();let _=fibre_point(u);}
