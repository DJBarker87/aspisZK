+use super::*;
+#[derive(Clone,Copy,kani::Arbitrary)]
+pub(super) struct ScalarLog {pub count:usize,pub x:u32,pub y:u32,pub reply:u32}
+pub(super) static mut LOG:ScalarLog=ScalarLog{count:0,x:0,y:0,reply:0};
+fn m_mul(x:M31,y:M31)->M31 {assert!(x.0<2147483647 && y.0<2147483647);let z:u32=kani::any();kani::assume(z<2147483647);unsafe{LOG.count+=1;LOG.x=x.0;LOG.y=y.0;LOG.reply=z;}M31(z)}
+fn reference(square:u32)->u32 {let t=square+square;let d=if t>=2147483647 {t-2147483647}else{t};if d>=1 {d-1}else{2147483647-1}}
+pub fn line_post(u:FibreIndex,r:M31)->bool {unsafe {
+ let p=Point{x:M31(NEA_point::LOG.reply[0]),y:M31(NEA_point::LOG.reply[1])};
+ let point_ok=if cfg!(NEA_line_opaque){NEA_point::LOG.count==1 && NEA_point::LOG.left[0] as usize==u.get() && NEA_point::LOG.reply[0]<2147483647 && NEA_point::LOG.reply[1]<2147483647}else if cfg!(NEA_point_tail){NEA_point::tail_post(u,p)}else{NEA_point::point_post(u,p)};
+ let association=point_ok && LOG.count==1 && LOG.x==p.x.0 && LOG.y==p.x.0;
+ association && if cfg!(NEA_wrong_line){r.0!=reference(LOG.reply)}else{r.0==reference(LOG.reply)}
+}}
+#[kani::proof_for_contract(line_node)]
+#[cfg_attr(not(NEA_line_opaque),kani::stub_verified(fibre_point))]
+#[cfg_attr(NEA_line_opaque,kani::stub(fibre_point,point_cut))]
+#[cfg_attr(NEA_line_opaque,kani::stub(M31::double,m_double))]
+#[cfg_attr(NEA_line_opaque,kani::stub(M31::sub,m_sub_one))]
+#[kani::stub(CM31::mul,NEA_point::cm_mul)]
+#[kani::stub(M31::mul,m_mul)]
+#[kani::stub(core::ptr::copy_nonoverlapping,crate::NEA_copy::KMX_copy_nonoverlapping)]
+fn line(){unsafe{LOG=kani::any();NEA_point::LOG=kani::any();}let i:usize=kani::any();kani::assume(i<262144);let u=FibreIndex::new(i).unwrap();let _=line_node(u);}
