+ let reference=NEA_point_reference::point_ref(i,&TABLE_A,&TABLE_B,LOG.reply);
+ let returned=r.x.0==reference[4] && r.y.0==reference[5] && LOG.left==[reference[0],reference[1]] && LOG.right==[reference[2],reference[3]];
+ association && LOG.reply[0]<2147483647 && LOG.reply[1]<2147483647 && if cfg!(NEA_wrong_point){!returned}else{returned}
+}}
