+use super::*;
+#[path="NEA_point_reference.rs"] mod NEA_point_reference;
+#[derive(Clone,Copy,kani::Arbitrary)]
+pub(super) struct PointLog {pub count:usize,pub left:[u32;2],pub right:[u32;2],pub reply:[u32;2]}
+pub(super) static mut LOG:PointLog=PointLog{count:0,left:[0;2],right:[0;2],reply:[0;2]};
+fn words(x:CM31)->[u32;2] {[x.a.0,x.b.0]}
+fn canonical(x:CM31)->bool {x.a.0<2147483647 && x.b.0<2147483647}
+// Opaque product log: UNIVERSAL over canonical replies, not an asserted product.
+// Lean selects the one exact canonical natural-number product after this check.
+pub(super) fn cm_mul(x:CM31,y:CM31)->CM31 {
+ assert!(canonical(x) && canonical(y));
+ let z=CM31{a:M31(kani::any()),b:M31(kani::any())};kani::assume(canonical(z));
+ unsafe {LOG.count+=1;LOG.left=words(x);LOG.right=words(y);LOG.reply=words(z);}
+ z
+}
