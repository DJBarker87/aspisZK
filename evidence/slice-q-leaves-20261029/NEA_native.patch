+fn point_cut(u:FibreIndex)->Point<M31> {
+ assert!(u.get()<262144);
+ let a:u32=kani::any();let b:u32=kani::any();kani::assume(a<2147483647 && b<2147483647);
+ unsafe{NEA_point::LOG=NEA_point::PointLog{count:1,left:[u.get() as u32,0],right:[0;2],reply:[a,b]};}
+ Point{x:M31(a),y:M31(b)}
+}
+fn m_double(x:M31)->M31 {assert!(x.0<2147483647);let t=x.0+x.0;let spec=if t>=2147483647{t-2147483647}else{t};let out:u32=kani::any();kani::assume(out==spec);M31(out)}
+fn m_sub_one(x:M31,y:M31)->M31 {assert!(x.0<2147483647 && y.0==1);let spec=if x.0>=1{x.0-1}else{2147483646};let out:u32=kani::any();kani::assume(out==spec);M31(out)}
