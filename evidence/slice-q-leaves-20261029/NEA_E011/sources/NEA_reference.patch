+pub trait Ops<E,T>{fn limbs(x:E)->[u32;8];fn from_limbs(x:[u32;8])->Option<E>;fn reduce(x:u64)->u32;fn parse_k(b:&[u8])->Option<[u32;4]>;fn tail_new()->T;fn tail_push(t:T,x:E,k:[u32;4])->Result<T,u8>;fn tail_finish(t:T)->E;fn add(x:E,y:E)->E;}
