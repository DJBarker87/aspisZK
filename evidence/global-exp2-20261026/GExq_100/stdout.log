theorem AspisR1.GExq_RootAccepted.accepted : ∀ {F C : Type} (adapter : AdapterRw.Ops) (ops : AspisR1CurrentCaller.Ops)
  (stage : VTop_Stages.Ops) (finish : AspisR1Stage2.Stage2Finish.FinishOps F) (reserved : Bool)
  (query : AspisR1.Port3_NativeQueryBody.Ops) (geo : AspisR1.Port3_NativeGeometryBody.Ops C)
  (B : AspisR1PublicPreparation.FinishModel.Boundaries) (std : AspisR1.ClaimsUnrolledFinish.StdCalls)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (native1 : AspisR1.S2W_ExtractionBoundary.First) (native2 : AspisR1.S2W_ExtractionBoundary.Second),
  AspisR1.S2W_DigestExtraction.AeneasExtraction
      (AspisR1.GExq_Caller.sdk adapter ops stage finish reserved query geo B std) native1 native2 hashv →
    ∀ (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      AspisR1.S2W_ExtractionBoundary.P1 sha256 H →
        AspisR1.S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
          ∀ (id : AspisR1.S2W_ExtractionBoundary.Program)
            (accounts1 accounts2 : AspisR1.S2W_ExtractionBoundary.Accounts)
            (data1 data2 : Aeneas.Std.Slice Aeneas.Std.U8) (slot : AspisR1.S2W_ExtractionBoundary.Slot)
            (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8),
            native1 id accounts1 data1 = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok saved) →
              native2 id accounts2 data2 slot = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) →
                ∃ log semantic pub1 proof1 split pub2 proof2 checkpoint,
                  AspisR1.S2W_Trace.run (AspisR1.GExq_Caller.sdk adapter ops stage finish reserved query geo B std)
                        (AspisR1.S2W_Observation.two
                          (AspisR1.GExq_Caller.sdk adapter ops stage finish reserved query geo B std) id accounts1 data1
                          accounts2 data2 slot)
                        [] =
                      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok saved, log) ∧
                    AspisR1.GExq_RecordTrace.projectLog log =
                        [AspisR1.GExq_OuterRecord.Event.first semantic pub1 proof1 split
                            (Aeneas.Std.core.result.Result.Ok saved),
                          AspisR1.GExq_OuterRecord.Event.second pub2 proof2 checkpoint
                            (Aeneas.Std.core.result.Result.Ok ())] ∧
                      AspisV8R19.MemoizedProgramLaw.eval H
                            (AspisR1.GExq_CallerRecord.program adapter ops stage finish reserved query geo B std hashv
                              id accounts1 accounts2 data1 data2 slot) =
                          (AspisR1.SdkC_Source.readLog
                              (AspisR1.SdkC_Source.run hashv
                                  (AspisR1.GExq_CallerRecord.code adapter ops stage finish reserved query geo B std
                                    hashv id accounts1 accounts2 data1 data2 slot)
                                  []).2,
                            Aeneas.Std.Result.ok
                              (Aeneas.Std.core.result.Result.Ok saved,
                                [AspisR1.GExq_OuterRecord.Event.first semantic pub1 proof1 split
                                    (Aeneas.Std.core.result.Result.Ok saved),
                                  AspisR1.GExq_OuterRecord.Event.second pub2 proof2 checkpoint
                                    (Aeneas.Std.core.result.Result.Ok ())])) ∧
                        ∀ (parsed : AspisR1.OraclePortCompactDraft.Parsed),
                          parsed.wire = AspisR1.MultiproofConeCanonical.bytesOf ↑proof1 →
                            ∃ frame,
                              FS2.Duplex.Read
                                  (AspisV8R19.MemoizedProgramLaw.eval H
                                      (AspisR1.GExq_CallerRecord.program adapter ops stage finish reserved query geo B
                                        std hashv id accounts1 accounts2 data1 data2 slot)).1
                                  frame ∧
                                AspisR1.BinRawByteCollisionTargets.pred 3 frame =
                                  some (AspisR1.OraclePortBatchDraft.committedRoot parsed 2) :=
fun {F C} adapter ops stage finish reserved query geo B std hashv native1 native2 extraction sha256 H p1 syscall id
    accounts1 accounts2 data1 data2 slot saved accepted1 accepted2 =>
  let ⟨log, h✝⟩ :=
    AspisR1.GExq_NativeRecords.accepted adapter ops stage finish reserved query geo B std hashv native1 native2
      extraction sha256 H p1 syscall id accounts1 accounts2 data1 data2 slot saved accepted1 accepted2
  let ⟨semantic, h✝¹⟩ := h✝
  let ⟨pub1, h✝²⟩ := h✝¹
  let ⟨proof1, h✝³⟩ := h✝²
  let ⟨split, h✝⁴⟩ := h✝³
  let ⟨pub2, h✝⁵⟩ := h✝⁴
  let ⟨proof2, h✝⁶⟩ := h✝⁵
  let ⟨checkpoint, h✝⁷⟩ := h✝⁶
  let ⟨ran, right✝⟩ := h✝⁷
  let ⟨shape, evaluated⟩ := right✝
  Exists.intro log
    (Exists.intro semantic
      (Exists.intro pub1
        (Exists.intro proof1
          (Exists.intro split
            (Exists.intro pub2
              (Exists.intro proof2
                (Exists.intro checkpoint
                  ⟨ran,
                    ⟨shape,
                      ⟨evaluated, fun parsed wire =>
                        let ⟨frame, h✝⁸⟩ :=
                          AspisR1.GExq_OriginalRoot.frame adapter ops stage finish reserved query geo B std hashv
                            (AspisR1.S2W_DigestExtraction.native_binding
                              (AspisR1.GExq_Caller.sdk adapter ops stage finish reserved query geo B std) native1
                              native2 hashv extraction)
                            id accounts1 accounts2 data1 data2 slot saved log ran semantic pub1 proof1 split
                            (Eq.mpr
                              (_root_.id
                                (congrArg
                                  (fun _a =>
                                    AspisR1.GExq_OuterRecord.Event.first semantic pub1 proof1 split
                                        (Aeneas.Std.core.result.Result.Ok saved) ∈
                                      _a)
                                  shape))
                              List.mem_cons_self)
                            parsed wire
                        let ⟨read, target⟩ := h✝⁸
                        Exists.intro frame
                          ⟨have same := congrArg Prod.fst evaluated;
                            Eq.mpr (_root_.id (congrArg (fun _a => FS2.Duplex.Read _a frame) same)) read,
                            target⟩⟩⟩⟩)))))))
