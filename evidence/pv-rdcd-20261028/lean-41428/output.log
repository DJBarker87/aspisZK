@[irreducible] def Aeneas.Std.loop.{u, v} : {α : Type u} →
  {β : Type v} → (α → Result (ControlFlow α β)) → α → Result β :=
fun {α} {β} body =>
  Lean.Order.fix
    (fun f x =>
      match body x with
      | Result.ok r =>
        match r with
        | ControlFlow.cont x => f x
        | ControlFlow.done x => Result.ok x
      | Result.fail e => Result.fail e
      | Result.div => Result.div)
    ⋯
