def Aeneas.Std.core.array.equality.PartialEqArray.eq : {T U : Type} →
  {N : Usize} → core.cmp.PartialEq T U → Std.Array T N → Std.Array U N → Result Bool :=
fun {T U} {N} partialEqInst a0 a1 =>
  if a0.length = a1.length then
    List.allM
      (fun x =>
        match x with
        | (x, y) => do
          let b ← partialEqInst.ne x y
          Result.ok (decide ¬b = true))
      ((↑a0).zip ↑a1)
  else Result.ok false
structure Aeneas.Std.core.cmp.PartialEq (Self Rhs : Type) : Type
number of parameters: 2
fields:
  Aeneas.Std.core.cmp.PartialEq.eq : Self → Rhs → Result Bool
  Aeneas.Std.core.cmp.PartialEq.ne : Self → Rhs → Result Bool :=
    fun self_1 other => do
      let __do_lift ← self.eq self_1 other
      Result.ok !__do_lift
constructor:
  Aeneas.Std.core.cmp.PartialEq.mk {Self Rhs : Type} (eq ne : Self → Rhs → Result Bool) : core.cmp.PartialEq Self Rhs
