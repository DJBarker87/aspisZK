+pub fn NCP_ref_encode(d:&Digest)->[u8;32]{
+ let mut out=[0u8;32];let mut i=0;
+ while i<8 {let x=d[i].0;out[4*i]=(x&255) as u8;out[4*i+1]=((x>>8)&255) as u8;out[4*i+2]=((x>>16)&255) as u8;out[4*i+3]=(x>>24) as u8;i+=1;}out
+}
+pub fn NCP_ref_decode(b:&[u8;32])->Result<Digest,AtomicStatementError>{
+ let x0=u32::from_le_bytes([b[0],b[1],b[2],b[3]]);if x0>=2147483647{return Err(AtomicStatementError::NonCanonicalDigest)}
+ let x1=u32::from_le_bytes([b[4],b[5],b[6],b[7]]);if x1>=2147483647{return Err(AtomicStatementError::NonCanonicalDigest)}
+ let x2=u32::from_le_bytes([b[8],b[9],b[10],b[11]]);if x2>=2147483647{return Err(AtomicStatementError::NonCanonicalDigest)}
+ let x3=u32::from_le_bytes([b[12],b[13],b[14],b[15]]);if x3>=2147483647{return Err(AtomicStatementError::NonCanonicalDigest)}
+ let x4=u32::from_le_bytes([b[16],b[17],b[18],b[19]]);if x4>=2147483647{return Err(AtomicStatementError::NonCanonicalDigest)}
+ let x5=u32::from_le_bytes([b[20],b[21],b[22],b[23]]);if x5>=2147483647{return Err(AtomicStatementError::NonCanonicalDigest)}
+ let x6=u32::from_le_bytes([b[24],b[25],b[26],b[27]]);if x6>=2147483647{return Err(AtomicStatementError::NonCanonicalDigest)}
+ let x7=u32::from_le_bytes([b[28],b[29],b[30],b[31]]);if x7>=2147483647{return Err(AtomicStatementError::NonCanonicalDigest)}
+ Ok([M31(x0),M31(x1),M31(x2),M31(x3),M31(x4),M31(x5),M31(x6),M31(x7)])
+}
