+pub fn NCP_ref_encode(d:&Digest)->[u8;32]{
+ let mut out=[0u8;32];let mut i=0;
+ while i<8 {let x=d[i].0;out[4*i]=(x&255) as u8;out[4*i+1]=((x>>8)&255) as u8;out[4*i+2]=((x>>16)&255) as u8;out[4*i+3]=(x>>24) as u8;i+=1;}out
+}
