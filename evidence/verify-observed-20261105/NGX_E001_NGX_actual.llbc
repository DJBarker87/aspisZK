{"charon_version":"0.1.223","translated":{"crate_name":"aspis_r1_cost_probe","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::NGX_public_entry"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["core::option::Option","core::result::Result","core::option::_::ok_or","crate::transcript::Transcript","crate::r1_semantic::Verified","crate::r1_wire::SemanticTranscript","crate::r1_wire::Challenges","aspis_core::field::M31","aspis_core::field::CM31","aspis_core::field::QM31","aspis_core::field::wide_exact::WideExact","aspis_core::circle::SecureCirclePoint"],"opaque":["crate::sampler::_","aspis_core::field::_","crate::trace::_"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-verify-observed-20261105/NGX_actual.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"crates/aspis-r1-cost-probe/src/lib.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! UNPROVED R1 COST PROBE. P2 only; no production entrypoint.\n#![no_std]\n#![cfg_attr(kani, feature(allocator_api))]\nextern crate alloc;\npub mod sampler;\npub mod semantic_wire;\npub mod semantic;\npub mod fast_domain;\npub mod fast_dots;\npub mod fast_pairing;\n\n#[cfg(feature = \"prover\")]\nextern crate std;\npub mod r1_wire;\npub mod r1_semantic;\npub mod trace;\npub mod transport;\npub mod weights;\npub mod transcript;\npub mod verifier;\n#[cfg(feature = \"prover\")]\npub mod prover;\n/// Host client for the selected public proof-account nonce route (D162).\n#[cfg(feature = \"r1p-check\")]\n#[allow(non_snake_case)]\npub mod RealR1_client;\n#[cfg(feature = \"prover\")]\npub mod dense;\n/// G-sim (LOG D44.3): the explicit R1 simulator simE in the ideal game.\n#[cfg(feature = \"r1p-check\")]\npub mod sim;\n\n#[cfg(feature=\"prover\")] mod host_sumcheck;\n#[cfg(feature=\"prover\")] mod host_semantic;\n#[cfg(feature=\"prover\")] mod host_commitment;\n\n// Adopted R1 proof format (PREREG-PROOF-SIZE-2, 2026-10-19): compact QM31\n// storage and binary multiproofs. UNPROVED: see PROOF-SIZE-OBLIGATIONS.\npub mod multiproof;\npub mod compact;\n\n#[cfg(not(feature=\"private-leaf-salts\"))]\ncompile_error!(\"the adopted R1 proof format is defined over private leaf salts; enable `private-leaf-salts` (a default feature)\");\n#[cfg(all(feature=\"audit-eight-way\",feature=\"prover\"))]\ncompile_error!(\"`audit-eight-way` is audit-only: it is never combined with the prover (PREREG-PROOF-SIZE-2 item 4)\");\n#[cfg(all(feature=\"audit-eight-way\",any(target_os=\"solana\",feature=\"program-build\")))]\ncompile_error!(\"`audit-eight-way` is audit-only: it is never built for a program (PREREG-PROOF-SIZE-2 item 4)\");\n\n#[cfg(NGX_extract)] pub fn NGX_public_entry(public: aspis_statement::pool_v1::pair_forest_semantic_terminal::r0::Public<'_>)->Result<alloc::vec::Vec<u8>,aspis_core::state_only_prefix::r0::Error>{public.public_bytes()}\n"},{"id":1,"name":{"Local":"crates/aspis-statement/src/pool_v1/pair_forest_semantic_terminal.rs"},"crate_name":"aspis_statement","contents":null},{"id":2,"name":{"Local":"crates/aspis-statement/src/pool_v1/mod.rs"},"crate_name":"aspis_statement","contents":null},{"id":3,"name":{"Local":"crates/aspis-statement/src/lib.rs"},"crate_name":"aspis_statement","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":7,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":8,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":9,"name":{"Local":"crates/aspis-core/src/state_only_prefix.rs"},"crate_name":"aspis_core","contents":null},{"id":10,"name":{"Local":"crates/aspis-core/src/lib.rs"},"crate_name":"aspis_core","contents":null},{"id":11,"name":{"Local":"crates/aspis-statement/src/pool_v1/payment_relation.rs"},"crate_name":"aspis_statement","contents":null},{"id":12,"name":{"Local":"crates/aspis-statement/src/pool_v1/pair_tree_profile.rs"},"crate_name":"aspis_statement","contents":null},{"id":13,"name":{"Local":"crates/aspis-core/src/field.rs"},"crate_name":"aspis_core","contents":null},{"id":14,"name":{"Local":"crates/aspis-statement/src/pool_v1/pair_terminal.rs"},"crate_name":"aspis_statement","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["aspis_r1_cost_probe",0]},{"Ident":["NGX_public_entry",0]}]},{"key":{"Type":0},"value":[{"Ident":["aspis_statement",0]},{"Ident":["pool_v1",0]},{"Ident":["pair_forest_semantic_terminal",0]},{"Ident":["r0",0]},{"Ident":["Public",0]}]},{"key":{"Type":1},"value":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}]},{"key":{"Type":2},"value":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Ident":["Vec",0]}]},{"key":{"Type