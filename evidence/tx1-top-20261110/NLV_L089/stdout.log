'AspisR1.NLV_Tree.exact_source' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLV_Tree.exact_source : ∀ (cfg : Configuration) (h : SdkC_Source.Parts → Result SdkC_Source.Digest)
  (n : ℕ) (s : State),
  rank s ≤ n →
    ∀ (before : SdkC_Source.Log), SdkC_Source.run h (fold cfg n s) before = SdkC_Source.run h (denote cfg s) before :=
fun cfg h n s enough before =>
  Nat.recAux (motive := fun n =>
    ∀ (s : State),
      rank s ≤ n →
        ∀ (before : SdkC_Source.Log), SdkC_Source.run h (fold cfg n s) before = SdkC_Source.run h (denote cfg s) before)
    (fun s enough before =>
      have hp := positive s;
      Classical.byContradiction fun a => exact_source._proof_1 s enough hp)
    (fun n ih s enough before =>
      Eq.mpr
        (id
          (congrArg (fun _a => SdkC_Source.run h (fold cfg (n + 1) s) before = SdkC_Source.run h _a before)
            (Eq.symm (source_step cfg s))))
        (id
          (Eq.mpr
            (id
              (congrArg
                (fun _a => _a = SdkC_Source.run h (CheckpointBytes5Effect.bind (step cfg s) (continuation cfg)) before)
                (NLV_RunLaws.bind_run h (step cfg s)
                  (fun post =>
                    match post with
                    | Sum.inl out => pure out
                    | Sum.inr after => fold cfg n after)
                  before)))
            (Eq.mpr
              (id
                (congrArg
                  (fun _a =>
                    (match SdkC_Source.run h (step cfg s) before with
                      | (ok a, after) =>
                        SdkC_Source.run h
                          (match a with
                          | Sum.inl out => pure out
                          | Sum.inr after => fold cfg n after)
                          after
                      | (fail e, after) => (fail e, after)
                      | (div, after) => (div, after)) =
                      _a)
                  (NLV_RunLaws.bind_run h (step cfg s) (continuation cfg) before)))
              (let ⟨reply, log, h✝⟩ := SdkC_Source.run h (step cfg s) before
              Eq.ndrec (motive := fun x =>
                SdkC_Source.run h (step cfg s) before = x →
                  (match x with
                    | (ok a, after) =>
                      SdkC_Source.run h
                        (match a with
                        | Sum.inl out => pure out
                        | Sum.inr after => fold cfg n after)
                        after
                    | (fail e, after) => (fail e, after)
                    | (div, after) => (div, after)) =
                    match x with
                    | (ok a, after) => SdkC_Source.run h (continuation cfg a) after
                    | (fail e, after) => (fail e, after)
                    | (div, after) => (div, after))
                (fun edge =>
                  casesOn (motive := fun t =>
                    reply = t →
                      (match (reply, log) with
                        | (ok a, after) =>
                          SdkC_Source.run h
                            (match a with
                            | Sum.inl out => pure out
                            | Sum.inr after => fold cfg n after)
                            after
                        | (fail e, after) => (fail e, after)
                        | (div, after) => (div, after)) =
                        match (reply, log) with
                        | (ok a, after) => SdkC_Source.run h (continuation cfg a) after
                        | (fail e, after) => (fail e, after)
                        | (div, after) => (div, after))
                    reply
                    (fun post h_1 =>
                      Eq.ndrec (motive := fun reply =>
                        SdkC_Source.run h (step cfg s) before = (reply, log) →
                          (match (reply, log) with
                            | (ok a, after) =>
                              SdkC_Source.run h
                                (match a with
                                | Sum.inl out => pure out
                                | Sum.inr after => fold cfg n after)
                                after
                            | (fail e, after) => (fail e, after)
                            | (div, after) => (div, after)) =
                            match (reply, log) with
                            | (ok a, after) => SdkC_Source.run h (continuation cfg a) after
                            | (fail e, after) => (fail e, after)
                            | (div, after) => (div, after))
                        (fun edge =>
                          Sum.casesOn (motive := fun t =>
                            post = t →
                              (match (ok post, log) with
                                | (ok a, after) =>
                                  SdkC_Source.run h
                                    (match a with
                                    | Sum.inl out => pure out
                                    | Sum.inr after => fold cfg n after)
                                    after
                                | (fail e, after) => (fail e, after)
                                | (div, after) => (div, after)) =
                                match (ok post, log) with
                                | (ok a, after) => SdkC_Source.run h (continuation cfg a) after
                                | (fail e, after) => (fail e, after)
                                | (div, after) => (div, after))
                            post
                            (fun out h_2 =>
                              Eq.ndrec (motive := fun post =>
                                SdkC_Source.run h (step cfg s) before = (ok post, log) →
                                  (match (ok post, log) with
                                    | (ok a, after) =>
                                      SdkC_Source.run h
                                        (match a with
                                        | Sum.inl out => pure out
                                        | Sum.inr after => fold cfg n after)
                                        after
                                    | (fail e, after) => (fail e, after)
                                    | (div, after) => (div, after)) =
                                    match (ok post, log) with
                                    | (ok a, after) => SdkC_Source.run h (continuation cfg a) after
                                    | (fail e, after) => (fail e, after)
                                    | (div, after) => (div, after))
                                (fun edge =>
                                  Eq.refl
                                    (match (ok (Sum.inl out), log) with
                                    | (ok a, after) =>
                                      SdkC_Source.run h
                                        (match a with
                                        | Sum.inl out => pure out
                                        | Sum.inr after => fold cfg n after)
                                        after
                                    | (fail e, after) => (fail e, after)
                                    | (div, after) => (div, after)))
                                (Eq.symm h_2) edge)
                            (fun after h_2 =>
                              Eq.ndrec (motive := fun post =>
                                SdkC_Source.run h (step cfg s) before = (ok post, log) →
                                  (match (ok post, log) with
                                    | (ok a, after) =>
                                      SdkC_Source.run h
                                        (match a with
                                        | Sum.inl out => pure out
                                        | Sum.inr after => fold cfg n after)
                                        after
                                    | (fail e, after) => (fail e, after)
                                    | (div, after) => (div, after)) =
                                    match (ok post, log) with
                                    | (ok a, after) => SdkC_Source.run h (continuation cfg a) after
                                    | (fail e, after) => (fail e, after)
                                    | (div, after) => (div, after))
                                (fun edge =>
                                  have smaller := decrease cfg h s after before log edge;
                                  have room :=
                                    Decidable.byContradiction fun a => exact_source._proof_2 n s enough after smaller a;
                                  ih after room log)
                                (Eq.symm h_2) edge)
                            (Eq.refl post))
                        (Eq.symm h_1) edge)
                    (fun e h_1 =>
                      Eq.ndrec (motive := fun reply =>
                        SdkC_Source.run h (step cfg s) before = (reply, log) →
                          (match (reply, log) with
                            | (ok a, after) =>
                              SdkC_Source.run h
                                (match a with
                                | Sum.inl out => pure out
                                | Sum.inr after => fold cfg n after)
                                after
                            | (fail e, after) => (fail e, after)
                            | (div, after) => (div, after)) =
                            match (reply, log) with
                            | (ok a, after) => SdkC_Source.run h (continuation cfg a) after
                            | (fail e, after) => (fail e, after)
                            | (div, after) => (div, after))
                        (fun edge =>
                          Eq.refl
                            (match (fail e, log) with
                            | (ok a, after) =>
                              SdkC_Source.run h
                                (match a with
                                | Sum.inl out => pure out
                                | Sum.inr after => fold cfg n after)
                                after
                            | (fail e, after) => (fail e, after)
                            | (div, after) => (div, after)))
                        (Eq.symm h_1) edge)
                    (fun h_1 =>
                      Eq.ndrec (motive := fun reply =>
                        SdkC_Source.run h (step cfg s) before = (reply, log) →
                          (match (reply, log) with
                            | (ok a, after) =>
                              SdkC_Source.run h
                                (match a with
                                | Sum.inl out => pure out
                                | Sum.inr after => fold cfg n after)
                                after
                            | (fail e, after) => (fail e, after)
                            | (div, after) => (div, after)) =
                            match (reply, log) with
                            | (ok a, after) => SdkC_Source.run h (continuation cfg a) after
                            | (fail e, after) => (fail e, after)
                            | (div, after) => (div, after))
                        (fun edge =>
                          Eq.refl
                            (match (div, log) with
                            | (ok a, after) =>
                              SdkC_Source.run h
                                (match a with
                                | Sum.inl out => pure out
                                | Sum.inr after => fold cfg n after)
                                after
                            | (fail e, after) => (fail e, after)
                            | (div, after) => (div, after)))
                        (Eq.symm h_1) edge)
                    (Eq.refl reply))
                (Eq.symm h✝) (Eq.refl (SdkC_Source.run h (step cfg s) before)))))))
    n s enough before
