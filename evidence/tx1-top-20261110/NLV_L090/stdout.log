'AspisR1.NLV_Tree.from_cuts' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLV_Tree.from_cuts : ∀ (cfg : Configuration) (i : Input) (frame : NLJ_Packets.Frame094)
  (observed : NGP_L181.Observation Out) (events : List NLV.Event) (last : NLV.State),
  NLV.Invocation cfg i.hashv 20 (NLV.initial i frame) observed.result observed.attempted events last →
    NGP_L181.NativeAssociation i.hashv
        (NGQ_Normalize.normalize
          (GExp_FirstCode.code cfg.base cfg.boundaries cfg.std i.hashv i.digest i.publicValue i.publicBytes i.proof
            i.k))
        observed ∧
      last.external = (NLV.initial i frame).external ∧ last.core.input = i :=
