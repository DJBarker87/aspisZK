'AspisR1.SCD_Nonvacuity.admitted_game_with_unassociated' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.SCD_Nonvacuity.admitted_game_with_unassociated : ∀ {F C : Type}
  (c : DrvC_Installation.Configuration F C) (P : ByteProver) (H : Bytes → State) (data1 data2 : Slice U8)
  (slot : S2W_ExtractionBoundary.Slot),
  S2TrustedSdkBorrow (model (ℕ → Record)) ∧
    S2W_TrustedStd.TrustedStd copy ∧
      Nonempty (S2W_D189Consolidation.RuntimeEntrypointAdmission (model (ℕ → Record)) e1 e1.heap 3) ∧
        Nonempty (S2W_D189Consolidation.RuntimeEntrypointAdmission (model (ℕ → Record)) e2 e2.heap 7) ∧
          CPH_Game.DeployedPairExecution observations false true e1 e2 saved suffix n1 n2 copy allocator
              CPH_FixtureData.id ∧
            CPR_DataPersistence.TwoTransactionLaw (adjacent observations)
                (ordinary observations (Hist_Nonvacuity.key 0#u8)) (before observations) (tentative observations)
                (success observations) (loaded observations) ∧
              first n1 copy allocator e1 CPH_FixtureData.id data1 () =
                  ok (core.result.Result.Ok (saved, CPH_FixtureWrappers.post1, ())) ∧
                second n2 allocator e2 CPH_FixtureData.id data2 slot () = ok (core.result.Result.Ok (e2.heap, ())) ∧
                  observations.physicalEvents false ≠ [] ∧
                    (eval H (F3T_Canon.canon (F3T_ByteCarrier.lift c P))).2.stored = (eval H P).2.stored ∧
                      ∃ runtime run,
                        eval H runtime = ([], some run) ∧
                          run.2.2 = true ∧
                            run.2.1.stored ≠ (eval H P).2.stored ∧
                              ¬SCD_Carrier.ByteObservation P runtime ∧
                                ∀ (rust : F3T_TwoPass.Verifier),
                                  ¬SCC_Physical.FirstPassBinding rust (F3T_Canon.canon (F3T_ByteCarrier.lift c P))
                                      runtime :=
fun {F C} c P H data1 data2 slot =>
  let ⟨sdk, right✝⟩ := CPH_Nonvacuity.joint_runtime data1 data2 slot
  let ⟨std, right✝¹⟩ := right✝
  let ⟨a1, right✝²⟩ := right✝¹
  let ⟨a2, right✝³⟩ := right✝²
  let ⟨game, right✝⁴⟩ := right✝³
  let ⟨persistence, right✝⁵⟩ := right✝⁴
  let ⟨accepted1, right✝⁶⟩ := right✝⁵
  let ⟨accepted2, right✝⁷⟩ := right✝⁶
  let ⟨left✝, right✝⁸⟩ := right✝⁷
  let ⟨events, right✝⁹⟩ := right✝⁸
  ⟨sdk,
    ⟨std,
      ⟨a1,
        ⟨a2,
          ⟨game,
            ⟨persistence,
              ⟨accepted1,
                ⟨accepted2,
                  ⟨events,
                    ⟨SCD_Carrier.canonical_stored c P H,
                      let ⟨runtime, h✝⟩ :=
                        SCC_Physical.accepted_unassociated (F3T_Canon.canon (F3T_ByteCarrier.lift c P)) H
                      let ⟨run, h✝¹⟩ := h✝
                      let ⟨observed, right✝¹⁰⟩ := h✝¹
                      let ⟨accepted, right✝¹¹⟩ := right✝¹⁰
                      let ⟨different, right✝¹²⟩ := right✝¹¹
                      let ⟨notStored, notFirst⟩ := right✝¹²
                      have unequal :=
                        Eq.mp (congrArg (Ne run.2.1.stored) (SCD_Carrier.canonical_stored c P H)) different;
                      Exists.intro runtime
                        (Exists.intro run
                          ⟨observed,
                            ⟨accepted,
                              ⟨unequal,
                                ⟨fun observation =>
                                  notStored ((SCD_Carrier.stored_iff_observation c P runtime).mpr observation),
                                  notFirst⟩⟩⟩⟩)⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩
