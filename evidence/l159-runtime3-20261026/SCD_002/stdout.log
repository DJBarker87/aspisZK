theorem AspisR1.SCD_ExactTop.retained_context : ∀ {W A F CoreError Tx : Type} (L : Library W (ℕ → Record)),
  S2TrustedSdkBorrow L →
    ∀ (copy : Heap (ℕ → Record) → ℕ → Payload → Outcome (ℕ → Record)),
      TrustedStd copy →
        ∀ (allocator : Allocator A) (e1 e2 : Entry) (w1 w2 : W),
          RuntimeEntrypointAdmission L e1 w1 3 →
            RuntimeEntrypointAdmission L e2 w2 7 →
              ∀ (c : DrvC_Installation.Configuration F CoreError) (indexError : CoreError)
                (reservation : NP6_StdModel.Reservation) (native1 : S2W_ExtractionBoundary.First)
                (native2 : S2W_ExtractionBoundary.Second) (hashv : S2Z.Oracle.Parts → Result S2Z.Oracle.Digest),
                S2W_DigestExtraction.AeneasExtraction
                    (DrvC_Installation.sdk (Rc5_Install.configuration indexError c reservation)) native1 native2 hashv →
                  ∀ (sha256 H : Bytes → State),
                    S2W_ExtractionBoundary.P1 sha256 H →
                      S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
                        ∀ (data1 data2 : Slice U8) (slot : S2W_ExtractionBoundary.Slot)
                          (state1 state2 final1 final2 : A) (saved : alloc.vec.Vec U8)
                          (post1 post2 : Heap (ℕ → Record)),
                          first native1 copy allocator e1 CPH_Program.verifier data1 state1 =
                              ok (core.result.Result.Ok (saved, post1, final1)) →
                            second native2 allocator e2 CPH_Program.verifier data2 slot state2 =
                                ok (core.result.Result.Ok (post2, final2)) →
                              ∀ (root : Std.Array U8 32#usize) (length : U32) (prior : Program Bytes State Unit)
                                (words : CanonicalCutEnrichedTranscript.Words) (p : CPG_Projection.Observations Tx A)
                                (t u : Tx) (actions : List (CPP_BankState.Action A)),
                                CPH_Game.DeployedPairExecution p t u e1 e2 saved actions native1 native2 copy allocator
                                    CPH_Program.verifier →
                                  CPR_DataPersistence.TwoTransactionLaw (CPG_Projection.adjacent p)
                                      (CPG_Projection.ordinary p (Hist_Nonvacuity.key 0#u8)) (CPG_Projection.before p)
                                      (CPG_Projection.tentative p) (CPG_Projection.success p)
                                      (CPG_Projection.loaded p) →
                                    ∀ (D : LiteralByteProtocol.Decoder) (P : F3T_ByteCarrier.ByteProver) (Q0 Q1 : ℕ),
                                      (∀ (H : Bytes → State), (eval H P).1.length ≤ Q0 + Q1) →
                                        AcceptedVerifierJoin (Rc5_Install.configuration indexError c reservation) D
                                            (F3T_Installed.source (Rc5_Install.configuration indexError c reservation)
                                              hashv) →
                                          ∀ (adversary : Program Bytes State (GExq_AccountExperiment.FirstInputs A))
                                            (chooseSecond :
                                              GExq_AccountExperiment.FirstInputs A →
                                                alloc.vec.Vec U8 →
                                                  Heap (ℕ → Record) →
                                                    A → Program Bytes State (GExq_AccountExperiment.SecondInputs A)),
                                            (∀ (H : Bytes → State), (eval H adversary).1.length ≤ Q0) →
                                              (∀ (input : GExq_AccountExperiment.FirstInputs A)
                                                  (saved : alloc.vec.Vec U8) (post : Heap (ℕ → Record)) (final : A)
                                                  (H : Bytes → State),
                                                  (eval H (chooseSecond input saved post final)).1.length ≤ Q1) →
                                                ∀
                                                  (project :
                                                    GExq_AccountExperiment.Outcome A →
                                                      OraclePortCompactDraft.Parsed × (Fin 22 → Fin 262144))
                                                  (select :
                                                    GExq_AccountExperiment.Outcome A →
                                                      R9PoolRuntimeBinding.Inputs × R9PoolRuntimeBinding.Inputs),
                                                  ∃ runtime run, eval H runtime = ([], some run) ∧ run.2.2 = true ∧ ⋯ :=
fun {W A F CoreError Tx} L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 c indexError reservation native1
    native2 hashv extraction sha256 H p1 syscall data1 data2 slot state1 state2 final1 final2 saved post1 post2
    accepted1 accepted2 root length prior words p t u actions game RuntimePersistence D P Q0 Q1 queries raw adversary
    chooseSecond prefixBound choiceBound project select =>
  let r := Rc5_Install.configuration indexError c reservation;
  let ⟨runtime, h✝⟩ := SCC_Physical.accepted_unassociated (F3T_Canon.canon (F3T_ByteCarrier.lift r P)) H
  let ⟨run, h✝¹⟩ := h✝
  let ⟨observed, right✝⟩ := h✝¹
  let ⟨accepted, right✝¹⟩ := right✝
  let ⟨different, right✝²⟩ := right✝¹
  let ⟨notStored, notFirst⟩ := right✝²
  have unequal := Eq.mp (congrArg (Ne run.2.1.stored) (SCD_Carrier.canonical_stored r P H)) different;
  Exists.intro runtime
    (Exists.intro run
      ⟨observed,
        ⟨accepted,
          ⟨unequal,
            ⟨fun observation => notStored ((SCD_Carrier.stored_iff_observation r P runtime).mpr observation),
              notFirst (F3T_Installed.source (Rc5_Install.configuration indexError c reservation) hashv)⟩⟩⟩⟩)
