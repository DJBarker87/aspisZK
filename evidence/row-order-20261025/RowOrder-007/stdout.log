'AspisR1.RowOrder_AcceptedPairHistory.accepted_pair_history' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.RowOrder_AcceptedPairHistory.accepted_pair_history : ∀ {W A E M Cv : Type} {N : ℕ}
  (L : Library W (ℕ → Record)),
  S2TrustedSdkBorrow L →
    ∀ (copy : Heap (ℕ → Record) → ℕ → Payload → Outcome (ℕ → Record)),
      TrustedStd copy →
        ∀ (allocator : Allocator A) (e1 e2 : Entry) (w1 w2 : W),
          RuntimeEntrypointAdmission L e1 w1 3 →
            RuntimeEntrypointAdmission L e2 w2 7 →
              ∀ (adapterOps : AdapterRw.Ops) (ops : Ops) (B : AspisR1PublicPreparation.FinishModel.Boundaries)
                (claimsStd : ClaimsUnrolledFinish.StdCalls) (native1 : S2W_ExtractionBoundary.First)
                (native2 : S2W_ExtractionBoundary.Second) (hashv : S2Z.Oracle.Parts → Result S2Z.Oracle.Digest),
                S2W_DigestExtraction.AeneasExtraction (sdkOps adapterOps ops B claimsStd) native1 native2 hashv →
                  ∀ (sha256 H : Bytes → State),
                    S2W_ExtractionBoundary.P1 sha256 H →
                      S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
                        ∀ (program : S2W_ExtractionBoundary.Program) (data1 data2 : Slice U8)
                          (slot : S2W_ExtractionBoundary.Slot) (state1 state2 final1 final2 : A)
                          (saved : alloc.vec.Vec U8) (post1 post2 : Heap (ℕ → Record)),
                          first native1 copy allocator e1 program data1 state1 =
                              ok (core.result.Result.Ok (saved, post1, final1)) →
                            second native2 allocator e2 program data2 slot state2 =
                                ok (core.result.Result.Ok (post2, final2)) →
                              ∀ (p : FS2.Duplex.Params M Cv N) (root : Std.Array U8 32#usize) (length : U32)
                                (port : ChildConeJoin E (sdkOps adapterOps ops B claimsStd)),
                                FirstMarks port →
                                  SecondMarks port →
                                    ∃ f s outer pre middle fs ss,
                                      SourceCuts (sdkOps adapterOps ops B claimsStd) e1.first (e2.second secondSizes)
                                          saved f s ∧
                                        S2W_ExpandedTrace.runExpanded (sdkOps adapterOps ops B claimsStd)
                                              (children port)
                                              (S2W_Observation.two (sdkOps adapterOps ops B claimsStd) program e1.first
                                                data1 (e2.second secondSizes) data2 slot)
                                              [] =
                                            ok
                                              (core.result.Result.Ok saved,
                                                S2W_ExpandedTrace.full (children port) outer) ∧
                                          S2W_D189Interpretation.runOwned (sdkOps adapterOps ops B claimsStd)
                                                (S2W_Observation.two (sdkOps adapterOps ops B claimsStd) program
                                                  e1.first data1 (e2.second secondSizes) data2 slot)
                                                [] e1.heap =
                                              ok (core.result.Result.Ok saved, outer, e1.heap) ∧
                                            projected port outer = S2W_SiteSchedule.timeline pre middle fs ss ∧
                                              post2 = e2.heap ∧
                                                before e1 e2 Site.tx1 =
                                                    S2W_D189Interpretation.nativeObserve L encode e1.metadata 3 w1
                                                      e1.heap.ambient ∧
                                                  before e1 e2 Site.tx2 =
                                                      S2W_D189Interpretation.nativeObserve L encode e2.metadata 7 w2
                                                        e2.heap.ambient ∧
                                                    ⋯ ∧ ⋯ :=
fun {W A E M Cv} {N} L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 adapterOps ops B claimsStd native1
    native2 hashv extraction sha256 H p1 syscall program data1 data2 slot state1 state2 final1 final2 saved post1 post2
    accepted1 accepted2 p root length port firstMarks secondMarks =>
  let ⟨f, h✝⟩ :=
    accepted_pair_claims L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 adapterOps ops B claimsStd native1
      native2 hashv extraction sha256 H p1 syscall program data1 data2 slot state1 state2 final1 final2 saved post1
      post2 accepted1 accepted2 p root length port firstMarks secondMarks
  let ⟨s, h✝¹⟩ := h✝
  let ⟨outer, h✝²⟩ := h✝¹
  let ⟨pre, h✝³⟩ := h✝²
  let ⟨middle, h✝⁴⟩ := h✝³
  let ⟨fs, h✝⁵⟩ := h✝⁴
  let ⟨ss, h✝⁶⟩ := h✝⁵
  let ⟨cuts, right✝⟩ := h✝⁶
  let ⟨expanded, right✝¹⟩ := right✝
  let ⟨owned, right✝²⟩ := right✝¹
  let ⟨layout, right✝³⟩ := right✝²
  let ⟨unchanged, right✝⁴⟩ := right✝³
  let ⟨before1, right✝⁵⟩ := right✝⁴
  let ⟨before2, right✝⁶⟩ := right✝⁵
  let ⟨claims, caller⟩ := right✝⁶
  Exists.intro f
    (Exists.intro s
      (Exists.intro outer
        (Exists.intro pre
          (Exists.intro middle
            (Exists.intro fs
              (Exists.intro ss
                ⟨cuts,
                  ⟨expanded,
                    ⟨owned,
                      ⟨layout,
                        ⟨unchanged,
                          ⟨before1,
                            ⟨before2,
                              ⟨claims, fun decode nodes y1 writer reader runtime p2prime entry multiproof scan =>
                                let ⟨parsed, h✝⁷⟩ :=
                                  caller decode nodes y1 writer reader runtime p2prime entry multiproof scan
                                let ⟨facts, sites⟩ := h✝⁷
                                let ⟨version, h✝⁸⟩ :=
                                  RowOrder_History.on_d189_cuts copy std allocator e1 e2
                                    (sdkOps adapterOps ops B claimsStd) native1 native2 hashv extraction program data1
                                    state1 final1 saved post1 accepted1 f s cuts decode H writer reader runtime p2prime
                                let ⟨key, right✝⁷⟩ := h✝⁸
                                let ⟨ledger, right✝⁸⟩ := right✝⁷
                                let ⟨events, right✝⁹⟩ := right✝⁸
                                let ⟨checkpoint, right✝¹⁰⟩ := right✝⁹
                                let ⟨proof, right✝¹¹⟩ := right✝¹⁰
                                let ⟨pub, size⟩ := right✝¹¹
                                Exists.intro parsed
                                  ⟨facts,
                                    ⟨sites,
                                      Exists.intro version
                                        ⟨key, ⟨ledger, ⟨events, ⟨checkpoint, ⟨proof, ⟨pub, size⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩))))))
