def AspisR1.FIp_CircleSource.circle : E → Std.Array E 4#usize → Std.Array U32 5#usize → Result E :=
fun alpha a inverse => do
  let ix ← inverse.index_usize 0#usize
  let iy ← inverse.index_usize 1#usize
  let a1 ← a.index_usize 0#usize
  let b ← a.index_usize 1#usize
  let c ← a.index_usize 2#usize
  let d ← a.index_usize 3#usize
  let we ← field.wide_exact.WideExact.add a1 b
  let we1 ← we.add c
  let we2 ← we1.add d
  let h0 ← we2.mul_m31 SAQ_LineSource.quarter
  let we3 ← field.wide_exact.WideExact.sub a1 b
  let we4 ← we3.sub c
  let we5 ← we4.add d
  let m ← field.M31.mul SAQ_LineSource.quarter iy
  let h1 ← we5.mul_m31 m
  let we6 ← we.sub c
  let we7 ← we6.sub d
  let m1 ← field.M31.mul SAQ_LineSource.quarter ix
  let h2 ← we7.mul_m31 m1
  let we8 ← we3.add c
  let we9 ← we8.sub d
  let m2 ← m1.mul iy
  let h3 ← we9.mul_m31 m2
  let we10 ← field.wide_exact.WideExact.mul alpha h3
  let we11 ← h2.add we10
  let we12 ← field.wide_exact.WideExact.mul alpha we11
  let we13 ← h1.add we12
  let we14 ← field.wide_exact.WideExact.mul alpha we13
  h0.add we14
