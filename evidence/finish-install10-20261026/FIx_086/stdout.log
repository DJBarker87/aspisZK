def Aeneas.Std.core.slice.index.Slice.index : {T I Output : Type} →
  core.slice.index.SliceIndex I (Slice T) Output → Slice T → I → Result Output :=
fun {T I Output} inst slice i => inst.index i slice
def Aeneas.Std.core.slice.index.SliceIndexRangeToUsizeSlice.index : {T : Type} →
  core.ops.range.RangeTo Usize → Slice T → Result (Slice T) :=
fun {T} r s => if ↑r.end ≤ s.length then ok ⟨List.slice 0 ↑r.end ↑s, ⋯⟩ else fail Error.panic
