        data1 () =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post1, ())) →
    ↑saved = ↑AspisR1.JFx_NativeBytes.checkpoint →
      AspisR1.JGx_MagicGate.value
