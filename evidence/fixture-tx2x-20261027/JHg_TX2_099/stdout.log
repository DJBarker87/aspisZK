            AspisR1.JFn_HashBoundary.Realizes AspisR1.JFp_SHADigest.digest →
              AspisR1.S2W_D189Wrappers.first (AspisR1.JGx_Natives.first (AspisR1.JGx_CallerSeed.value c) err)
