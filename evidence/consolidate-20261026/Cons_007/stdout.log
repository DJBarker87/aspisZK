  AspisR1.OraclePortStoredExperimentC4.Prover → ℕ → AspisR1.OraclePortRuntimeBindingC7.Runtime → Prop :=
fun D P Q runtime =>
  (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.OraclePortHeadlineFrozen2.projected_frozen D P)).2.2 = Bool.true →
        (AspisV8R19.OracleResampling.mean fun coins =>
            ↑(AspisR1.ActualCostedExtractorM10.extractor.eval
                    (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.OraclePortHeadlineFrozen2.projected_frozen D P))
                    coins).2.total) ≤
          ↑(AspisR1.CostedAllocationLedgerM10.params (Q + 1161)).attemptBudget) ∧
    (∀ (run : AspisR1.RawCutProverCompiler.RunView) (coins : AspisR1.RawExtractorCostComposedV2.Coins)
        (w : AspisR1.SpendRelation.Wspend),
        (AspisR1.ActualCostedExtractorM10.extractor.eval run coins).1 = Option.some w →
          AspisR1.LiteralProtocol.relation run.2.1.1 w) ∧
      1 / 2 ^ 126 + 1 / 2 ^ 454 ≤ 1 / 2 ^ 120 ∧
        AspisR1.OraclePortHeadlineFrozen2PerAttempt.failureModel runtime ≤
            AspisR1.OraclePortHeadlineFrozen2PerAttempt.totalBound Q ∧
