fun {W Hash} finish reserved queryOps D hash pub proof checkpoint savedVec H stored publicBytes tx1p parsed trace =>
  ∃ p saved g geometry pending returned after flushed back v,
    AspisR1.Port4A_ReaderInstall.reader reserved D checkpoint proof pub AspisR1Stage2.transport.Variant.S2 hash =
        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (p, saved)) ∧
      AspisR1.Port3_QueryStage.query (AspisR1.Port4C_RowStd.install (AspisR1.Port5Q1_QueryPorts.install queryOps)) proof
            p saved g Option.none geometry pending 22#usize =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (returned, after)) ∧
        returned.weights.deref_mut = (returned.weights.deref, back) ∧
          AspisR1.Port3_FlushInstall.flush after returned.weights.deref = Aeneas.Std.Result.ok flushed ∧
            have a := { weights := back flushed, rhs := returned.rhs, power := returned.power, next := returned.next };
            AspisR1.Port4D_FinishInstall.finish finish v p a Option.none =
                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) ∧
              ∀ (alpha0 alpha1 : AspisR1Stage2.Stage2Finish.E)
                (r0 : AspisR1.RowFinish_Control.RoundValues finish v.round0 alpha0 p.claim)
                (r1 : AspisR1.RowFinish_Control.RoundValues finish v.round1 alpha1 r0.value) (weights : W)
                (alphas : Aeneas.Std.Slice AspisR1Stage2.Stage2Finish.E) (pair dot : AspisR1Stage2.Stage2Finish.E),
                p.variant = AspisR1Stage2.transport.Variant.S2 →
                  p.alpha.index_usize 0#usize = Aeneas.Std.Result.ok alpha0 →
                    p.alpha.index_usize 1#usize = Aeneas.Std.Result.ok alpha1 →
                      finish.newWeights p.variant p.semantic_alpha p.z =
                          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok weights) →
                        Aeneas.Std.core.array.Array.index
                              (Aeneas.Std.core.ops.index.IndexSlice
                                (Aeneas.Std.core.slice.index.SliceIndexRangeToUsizeSlice AspisR1Stage2.Stage2Finish.E))
                              p.alpha { «end» := 2#usize } =
                            Aeneas.Std.Result.ok alphas →
                          finish.pair weights alphas v.final_message p.kappa =
                              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok pair) →
                            finish.dot v.final_message a.weights.deref =
                                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok dot) →
                              ∀ (semantic : List AspisV8R19.DuplexFrames.Bytes) (q : Fin 22 → Fin 262144)
                                (tr : AspisR1.RawCutTranscriptRun.ErasedPrefix)
                                (i : AspisR1.RecordedBinaryExperimentBin.SourceInputs),
                                AspisR1.OraclePortStoredDecisionDraftC4.input
                                      { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof, semantic := semantic } q
                                      tr =
                                    Option.some i →
                                  AspisR1.OraclePortSelectedDraft.queries tr = Option.some q →
                                    AspisR1.LiteralMatchingData.read
                                          (AspisR1.OraclePortStoredDecisionDraftC4.typedRows
                                            { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof,
                                              semantic := semantic }
                                            q tr) =
                                        Option.some i.data →
                                      AspisR1.LiteralQueryRead.decode i.queryBytes = Option.some q →
                                        AspisR1.Port4D_Pairing.PairingLaws (AspisR1.Port3_FinishStage.release finish)
                                            AspisR1.CheckpointBytes5Output.ofE v p i.data →
                                          (∀ (j : Fin 22), AspisR1.MatchingSupport.match0 i.data (q j)) →
                                            AspisR1.R3SemanticRemainingJoins.EquationEndpoint i.decoded
                                                (AspisR1.OraclePortStoredDecisionDraftC4.typedRows
                                                  { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof,
                                                    semantic := semantic }
                                                  q tr)
                                                i.data →
                                              AspisR1.CheckpointBytes5Output.ofE dot =
                                                  ∑ l,
                                                    i.data.f l *
                                                      AspisR1.LiteralOpeningView.eK
                                                        ((AspisR1.CheckpointBytes5Output.accumulator a).weights l) →
                                                (∀ x ∈ [r0.lhs, r0.rhs, r1.lhs, r1.rhs, pair, r1.value, dot, a.rhs],
                                                    AspisR1.CheckpointBytes4ReaderFields.sourceE
                                                        (AspisR1.CheckpointBytes5Output.ofE x) =
                                                      x) →
                                                  ∀ (c : AspisR1.OraclePortCheckpointResumeC5.Context),
                                                    AspisR1.Port5Q1_QueryPorts.SessionAPrepare
                                                        (AspisR1.Tx1Q_Carriers.prepared tx1p) i.data q
                                                        (AspisR1.SelectedChallengeMap.rhoOf i.rho) →
                                                      savedVec =
                                                          AspisR1.Tx2N_Reader.writer H stored publicBytes
                                                            (AspisR1.OraclePortCheckpointResumeC5.prepared c i.data
                                                              (AspisR1.SelectedChallengeMap.rhoOf i.rho) q)
                                                            (AspisR1.OraclePortCheckpointStateC3.write
                                                                (AspisR1.OraclePortCheckpointResumeC5.model i.data
                                                                  (AspisR1.SelectedChallengeMap.rhoOf i.rho)
                                                                  q)).accumulator →
                                                        AspisR1.AuS1_Finish.Collision H trace parsed q ∨
                                                          Decidable.decide
                                                                (AspisR1.Port3_NativeFinishBody.verifier.finish_relation
                                                                    (AspisR1.Port4D_Round.native finish) v p a
                                                                    Option.none =
                                                                  Aeneas.Std.Result.ok
                                                                    (Aeneas.Std.core.result.Result.Ok ())) =
                                                              AspisR1.OraclePortFrozen2.finish
                                                                {
                                                                  wire :=
                                                                    AspisR1.MultiproofConeCanonical.bytesOf ↑proof,
                                                                  semantic := semantic }
                                                                q tr i (AspisR1.CheckpointBytes5Output.accumulator a) ∧
                                                            Decidable.decide
                                                                  (AspisR1.Port4D_FinishInstall.finish finish v p a
                                                                      Option.none =
                                                                    Aeneas.Std.Result.ok
                                                                      (Aeneas.Std.core.result.Result.Ok ())) =
                                                                AspisR1.D0TypedChecks.verify ⋯ i ∧
                                                              AspisR1.D0TypedChecks.verify ⋯ i = Bool.true
