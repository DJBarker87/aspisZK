{"charon_version":"0.1.223","translated":{"crate_name":"nfu_reference","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::parse_g"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["core::option::Option","core::result::Result","core::option::_::ok_or"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-slice-d-check-20261104/NFU_E001.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"nfu_reference","contents":"// Safe references for remaining caller composition. No field arithmetic,\n// pointers, callbacks, allocation, statics, or production-source edits.\n#[derive(Clone,Copy)]\npub enum Error { InvalidRow, Length{row:u8}, Tag{row:u8}, NonCanonical{row:u8,value:usize}, Parse }\npub fn shape(row:u8)->Option<(u8,usize)>{match row{0|1|3..=13=>Some((0,0)),2=>Some((1,32)),14=>Some((3,32)),15..=24=>Some((2,896)),25=>Some((4,3712)),26=>Some((5,928)),_=>None}}\n// The validation reply is a complete value supplied at the original cut.\npub fn parse_g(row:u8,record:&[u8],reply:Result<(),Error>)->Result<&[u8],Error>{\n let(tag,size)=shape(row).ok_or(Error::InvalidRow)?;\n if record.len()!=5+size{return Err(Error::Length{row});}\n if record[0]!=tag{return Err(Error::Tag{row});}\n if u32::from_le_bytes([record[1],record[2],record[3],record[4]])as usize!=size{return Err(Error::Length{row});}\n let payload=&record[5..];if row>=14{reply?;}Ok(payload)\n}\npub fn parse_at_g(bytes:&[u8],row:u8,offset:usize,reply:Result<(),Error>)->Result<(&[u8],usize),Error>{\n let length=5+shape(row).unwrap().1;\n let framed=bytes.get(offset..offset+length).ok_or(Error::Length{row})?;\n parse_g(row,framed,reply)?;Ok((framed,offset+length))\n}\n// Opaque push-state reply at ONE native iteration. Products are absent.\npub fn finish_step_g(updated:[u64;9],index:usize,accepted:bool)->Result<([u64;9],usize),Error>{\n if !accepted{return Err(Error::Parse);}Ok((updated,index+1))\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/cor