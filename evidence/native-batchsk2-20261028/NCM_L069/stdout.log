def AspisR1.NCM_Assembly.Claim : {X : Type} →
  AspisR1Stage2.aspis_core.digest.Digest32 X →
    X → (Bytes → State) → Ops → ℕ → NCE_VerifierCuts.Digest → Carrier → OraclePortCompactDraft.Parsed → Prop :=
fun {X} D hash H ops batch folded s parsed =>
  have source := NCM_BatchCore.execute D hash H ops batch folded s;
  have target :=
    NCE_FirstFailure.observe H (NCM_BatchCore.slot parsed s) [(batch, 0), (batch, 1), (batch, 2)]
      Port4B_BatchJoin.initial;
  source.1 = target.1 ∧
    source.2.1 = Option.map Prod.snd target.2.1 ∧
      source.2.2.prepared = s.prepared ∧
        source.2.2.proof = s.proof ∧
          source.2.2.log = s.log ++ source.1 ∧ (source.2.1 = none → source.2.2.scratch = target.2.2)
theorem AspisR1.NCM_Assembly.bridge : ∀ {X : Type} (D : AspisR1Stage2.aspis_core.digest.Digest32 X) (hash : X)
  (H : Bytes → State),
  (∀ (input : Slice (Slice U8)), D.digest hash input = ok (MultiproofConePhysicalTransport.rawOracle H input)) →
    ∀ (ops : Ops) (base : Port3_NativeBatchBody.Ops),
      NCE_KeyProducerCuts.NCE_Native_KeysZero ops.keys.create →
        NCE_KeyCuts.NCE_Native_KeysWrite ops.keys.write →
          NCE_SortCarrierCuts.NCE_Native_KeysSortCarrier ops.keys.sort →
            NCE_SortCuts.NCE_Native_KeysSort ops.valueSort →
              NCE_KeyReadCuts.NCE_Native_KeysRead ops.leaf.get →
                NCE_Native_Opening ops.leaf.reader →
                  NCE_LeafCuts.NCE_Native_Leaf ops.leaf.request ops.leaf.post →
                    NCE_CountInitCuts.NCE_Native_CountZero ops.count.create →
                      NCE_CountInitCuts.NCE_Native_CountCopy ops.count.copy →
                        NCE_CountCuts.NCE_Native_CountScan ops.count.scan →
                          NCE_CountRowCuts.NCE_Native_CountCommit ops.count.store →
                            NCE_CountLevelCuts.NCE_Native_CountHeight ops.count.height →
                              NCE_PaddingCuts.NCE_Native_Padding (NCM_PaddingPredicate.predicate base D) ops.padding →
                                NCE_CarrierEffects.NCE_Native_Row H ops.verifier.node →
                                  NCE_RowStoreCuts.NCE_Native_RowStore ops.rowStore →
                                    NCE_VerifierCuts.NCE_Native_Verifier ops.verifier.entry ops.verifier.exit
                                        ops.verifier.finish →
                                      NCE_AdmissionCuts.NCE_Native_Admission ops.verifier.pair ops.verifier.range →
                                        NCE_OuterCuts.NCE_Native_ThreeTrees ops.start ops.after0 ops.after1 ops.finish →
                                          ∀ batch < 2,
                                            ∀ (s : Carrier) (parsed : OraclePortCompactDraft.Parsed)
                                              (folded : NCE_VerifierCuts.Digest),
                                              Inputs s parsed folded → Claim D hash H ops batch folded s parsed :=
fun {X} D hash H oracle ops base keysZero keysWrite keysSort valueSort get opening leafCut countZero countCopy countScan
    countStore countHeight paddingCut row rowStore verifier admission outer batch bb s parsed folded inputs =>
  have related :=
    NCM_OuterRefinement.refinement H (NCM_BatchCore.child D hash H ops batch folded) (NCM_BatchCore.slot parsed s) batch
      (Good s) [0, 1, 2]
      (fun kind member current good =>
        have kb :=
          Decidable.byContradiction fun a =>
            bridge._proof_2 batch kind
              (Eq.mp
                (Eq.trans bridge._simp_1
                  (congrArg (Or (kind = 0))
                    (Eq.trans bridge._simp_1
                      (congrArg (Or (kind = 1))
                        (Eq.trans bridge._simp_1
                          (Eq.trans (congrArg (Or (kind = 2)) bridge._simp_2) (or_false (kind = 2))))))))
                member)
              a;
        NCM_BatchCore.child_agrees D hash H oracle ops base keysZero keysWrite keysSort valueSort get opening leafCut
          countZero countCopy countScan countStore countHeight paddingCut row rowStore verifier admission outer batch bb
          s current parsed folded inputs good kind kb)
      (NCM_BatchCore.initial s) ⟨rfl, rfl⟩;
  let ⟨reads, right✝⟩ :=
    Eq.mp
      (congrArg
        (fun _a =>
          have source := _a;
          have target :=
            NCE_FirstFailure.observe H (NCM_BatchCore.slot parsed s) (List.map (fun k => (batch, k)) [0, 1, 2])
              (NCM_BatchCore.initial s).scratch;
          source.1 = target.1 ∧
            source.2.1 = Option.map Prod.snd target.2.1 ∧
              Good s source.2.2 ∧
                source.2.2.log = (NCM_BatchCore.initial s).log ++ source.1 ∧
                  (source.2.1 = none → source.2.2.scratch = target.2.2))
        (Eq.symm
          (NCM_OuterRefinement.control ops.start ops.after0 ops.after1 ops.finish outer
            (NCM_BatchCore.child D hash H ops batch folded) (NCM_BatchCore.initial s))))
      related
  let ⟨first, right✝¹⟩ := right✝
  let ⟨good, right✝²⟩ := right✝¹
  let ⟨log, final⟩ := right✝²
  ⟨reads, ⟨first, ⟨good.left, ⟨good.right, ⟨log, final⟩⟩⟩⟩⟩
'AspisR1.NCM_Assembly.bridge' depends on axioms: [propext, Classical.choice, Quot.sound]
