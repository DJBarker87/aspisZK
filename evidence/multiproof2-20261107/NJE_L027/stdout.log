                (run.eq_2 input matrix n)))
            (Eq.mpr
              (id
                (congrArg (fun _a => write (bs ↑⟨n, h⟩) ⟨n, h⟩ (matrix (block (bs ↑⟨n, h⟩) ⟨n, h⟩)) = _a) (dif_pos h)))
