fun input bs sums args steps cut =>
  have all := fun n hn =>
    Nat.recAux (motive := fun n => n ≤ 4 → bs n = run input matrix n) (fun hn => cut.block_start)
      (fun n ih hn =>
        have h := Decidable.byContradiction fun a => blocks_result._proof_1 n hn a;
        Eq.mpr
          (id (congrArg (fun _a => _a = run input matrix (n + 1)) (block_next input bs sums args steps cut ⟨n, h⟩)))
          (Eq.mpr
            (id
