theorem NJE_WellSource.all_result : ∀ {α : Type} (p : α → Bool) (xs : List α), allValues p xs = ok (xs.all p) :=
fun {α} p xs =>
  let ⟨tail, h⟩ := NJE_AllAdapter.default_all p xs
  Eq.mpr
    (id
      (congrFun'
        (congrArg Eq
          (Eq.trans (congrFun' (congrArg Bind.bind h) (uncurry fun b _ => ok b))
            (bind_tc_ok (xs.all p, tail) (uncurry fun b _ => ok b))))
        (ok (xs.all p))))
    (Eq.refl
      (let (b, _) := (xs.all p, tail)
      ok b))
