  a.bits = (NJA_CohortArity.arity a).bits ∧
    (do
        let b ← a.bits
        k b) =
      k
        (match a with
        | multiproof.Arity.Two => 1#u32
        | multiproof.Arity.Eight => 3#u32) :=
fun {α} a k =>
  ⟨NJA_CohortArity.bits a,
    multiproof.Arity.casesOn (motive := fun t =>
      a = t →
        (do
            let b ← a.bits
            k b) =
          k
            (match a with
            | multiproof.Arity.Two => 1#u32
            | multiproof.Arity.Eight => 3#u32))
      a
      (fun h =>
        Eq.symm h ▸
          Eq.refl do
            let b ← multiproof.Arity.Two.bits
            k b)
      (fun h =>
        Eq.symm h ▸
          Eq.refl do
            let b ← multiproof.Arity.Eight.bits
            k b)
      (Eq.refl a)⟩
