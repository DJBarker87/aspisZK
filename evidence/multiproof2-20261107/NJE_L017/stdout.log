    ∀ (sibling : Digest) (left : Bool),
      multiproof.sibling_binary_parent (backend hashv) () values i (Array.to_slice sibling) left =
        ok (hashv (if left = true then parts (cell values ↑i) sibling else parts sibling (cell values ↑i))) :=
