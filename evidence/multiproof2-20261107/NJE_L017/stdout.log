theorem NJE_ParentPackets.TX1_123 : ∀ (hashv : Slice (Slice U8) → Digest) (values : Std.Array Digest 16#usize)
  (i : Usize),
  ↑i + 1 < 16 →
    multiproof.occupied_binary_parent (backend hashv) () values i =
      ok (hashv (parts (cell values ↑i) (cell values (↑i + 1)))) :=
fun hashv values i bound =>
  Eq.mpr
    (id
      (congrArg (fun _a => _a = ok (hashv (parts (cell values ↑i) (cell values (↑i + 1)))))
        (NJA_ParentAddress.occupied (backend hashv) () values i bound)))
    (id
      ((fun {α} v v_1 e_v => e_v ▸ Eq.refl (ok v)) (hashv (parts (↑values)[↑i] (↑values)[↑i + 1]))
        (hashv (parts (cell values ↑i) (cell values (↑i + 1))))
        ((fun a a_1 e_a => e_a ▸ Eq.refl (hashv a)) (parts (↑values)[↑i] (↑values)[↑i + 1])
          (parts (cell values ↑i) (cell values (↑i + 1))) (id sorry))))
