theorem NJE_CompressSeed.result : ∀ (left right : Fin 8 → U32),
  (∀ (i : Fin 8), ↑(left i) < 2147483647) →
    (∀ (i : Fin 8), ↑(right i) < 2147483647) →
      ∀ (states : Fin 23 → State) (bs : ℕ → State) (sums : Fin 4 → ℕ → ℕ) (args : Fin 16 → ℕ) (leading : ℕ → State),
        states 0 = leading 16 →
          NJE_ExternalStages.Cut (seed left right) bs sums args leading →
            (∀ (r : Fin 22), NJE_RoundTrace.Witness (states r.castSucc) (states r.succ) r) →
              ∀ (i : Fin 8),
                ↑↑(states (Fin.last 22) ⟨↑i, ⋯⟩) = R0P.nodeCompress (fun j => ↑↑(left j)) (fun j => ↑↑(right j)) i :=
fun left right hl hr states bs sums args leading start initial_cut rounds =>
  have joined := NJE_RoundTrace.composition (seed left right) states bs sums args leading start initial_cut rounds;
  have seed_value := (value left right hl hr).right;
  fun i =>
  have selected := congrFun joined.right ⟨↑i, Decidable.byContradiction fun a => result._proof_1 i a⟩;
  Eq.mp
    (congrArg
      (fun _a =>
        NJE_RoundTrace.cast (states (Fin.last 22)) ⟨↑i, Decidable.byContradiction fun a => result._proof_1 i a⟩ =
          R0P.poseidonPermutation _a ⟨↑i, Decidable.byContradiction fun a => result._proof_1 i a⟩)
      (NJA_Compress.seed_model (fun i => ↑↑(left i)) fun i => ↑↑(right i)))
    (Eq.mp
      (congrArg
        (fun _a =>
          NJE_RoundTrace.cast (states (Fin.last 22)) ⟨↑i, Decidable.byContradiction fun a => result._proof_1 i a⟩ =
            R0P.poseidonPermutation _a ⟨↑i, Decidable.byContradiction fun a => result._proof_1 i a⟩)
        seed_value)
      selected)
