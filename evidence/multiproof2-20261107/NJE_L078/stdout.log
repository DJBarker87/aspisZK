                          ↑c + _a)
                      (nodeCount.eq_2 (cells (NJA_CountDrop.keys a) 0 ↑n) height)))
                  (have len :=
                    of_eq_true
                      (Eq.trans
                        (congrFun'
                          (congrArg Eq
                            (Eq.trans
                              (Eq.trans
                                (congrArg List.length
                                  (congrFun'
                                    (congrArg List.map (funext fun j => congrArg (NJA_CountDrop.keys a) (zero_add j)))
                                    (List.range ↑n)))
                                (List.length_map fun j => NJA_CountDrop.keys a j))
                              List.length_range))
                          ↑n)
                        (eq_self ↑n));
                  Eq.mpr
                    (id
                      (congrArg
                        (fun _a =>
                          ↑c + (countLevel (↑n) (cells (NJA_CountDrop.keys a) 0 ↑n)).2 +
                              nodeCount height (countLevel (↑n) (cells (NJA_CountDrop.keys a) 0 ↑n)).1 =
                            ↑c +
                              ((countLevel _a (cells (NJA_CountDrop.keys a) 0 ↑n)).2 +
                                nodeCount height (countLevel _a (cells (NJA_CountDrop.keys a) 0 ↑n)).1))
                        len))
                    (of_eq_true
                      (Eq.trans
                        (congrFun'
                          (congrArg Eq
                            (Nat.add_assoc (↑c) (countLevel (↑n) (cells (NJA_CountDrop.keys a) 0 ↑n)).2
                              (nodeCount height (countLevel (↑n) (cells (NJA_CountDrop.keys a) 0 ↑n)).1)))
                          (↑c +
                            ((countLevel (↑n) (cells (NJA_CountDrop.keys a) 0 ↑n)).2 +
                              nodeCount height (countLevel (↑n) (cells (NJA_CountDrop.keys a) 0 ↑n)).1)))
                        (eq_self
                          (↑c +
                            ((countLevel (↑n) (cells (NJA_CountDrop.keys a) 0 ↑n)).2 +
                              nodeCount height (countLevel (↑n) (cells (NJA_CountDrop.keys a) 0 ↑n)).1)))))))))⟩)
    height start a n c clock hn sorted range budget
