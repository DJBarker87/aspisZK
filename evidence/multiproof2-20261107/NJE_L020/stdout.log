theorem NJE_InternalCut.frame_result : ∀ (input : State) (part full : ℕ) (args : Fin 16 → ℕ) (steps : ℕ → State),
  Cut input part full args steps → steps 16 = fun i => NJE_Residue.word (args i) :=
fun input part full args steps cut =>
  NJA_PointStaging.complete input (fun i x => NJE_Residue.word (args i)) steps cut.start cut.next
'NJE_InternalCut.frame_result' depends on axioms: [propext, Classical.choice, Quot.sound]
