              let i1 ← multiproof.index_at a i
              let i2 ← multiproof.Arity.Two.bits
              let parent ← lift (i1.wrapping_shr i2)
              let j ← multiproof.node_count_loop0_loop0_loop0 multiproof.Arity.Two a n parent i
              let i3 ← multiproof.Arity.Two.width
