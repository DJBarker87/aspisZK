theorem NJE_RoundTrace.composition : ∀ (input : State) (states : Fin 23 → State) (bs : ℕ → State) (sums : Fin 4 → ℕ → ℕ)
  (args : Fin 16 → ℕ) (leading : ℕ → State),
  states 0 = leading 16 →
    NJE_ExternalStages.Cut input bs sums args leading →
      (∀ (r : Fin 22), Witness (states r.castSucc) (states r.succ) r) →
        Canonical (states (Fin.last 22)) ∧ cast (states (Fin.last 22)) = R0P.poseidonPermutation (cast input) :=
fun input states bs sums args leading start initial_cut rounds =>
  let ⟨canonical, right✝⟩ := facts input states bs sums args leading start initial_cut rounds
  let ⟨steps, initial_value⟩ := right✝
  have joined := NJE_PermutationFold.compose (fun i => cast (states i)) (fun r => R0P.poseidonApplyRound r) steps;
  have map :=
    Eq.mpr (id (congrArg (fun _a => (List.ofFn fun r => R0P.poseidonApplyRound r) = _a) List.map_ofFn))
      (Eq.refl (List.ofFn fun r => R0P.poseidonApplyRound r));
  ⟨canonical (Fin.last 22),
    Eq.trans
      (Eq.symm
        (Eq.mp
          (congrArg
            (fun _a =>
              List.foldl (fun x y => R0P.poseidonApplyRound y x) _a (List.ofFn fun r => r) =
                cast (states (Fin.last 22)))
            initial_value)
          (Eq.mp (congrArg (fun _a => _a = cast (states (Fin.last 22))) List.foldl_map)
            (Eq.mp
              (congrArg (fun _a => List.foldl (fun s step => step s) (cast (states 0)) _a = cast (states (Fin.last 22)))
                map)
              joined))))
      (NJE_PermutationFold.folded (cast input))⟩
