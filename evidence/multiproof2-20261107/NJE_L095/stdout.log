theorem NJE_RoundTrace.facts : ∀ (input : State) (states : Fin 23 → State) (bs : ℕ → State) (sums : Fin 4 → ℕ → ℕ)
  (args : Fin 16 → ℕ) (leading : ℕ → State),
  states 0 = leading 16 →
    NJE_ExternalStages.Cut input bs sums args leading →
      (∀ (r : Fin 22), Witness (states r.castSucc) (states r.succ) r) →
        (∀ (i : Fin 23), Canonical (states i)) ∧
          (∀ (r : Fin 22), cast (states r.succ) = R0P.poseidonApplyRound r (cast (states r.castSucc))) ∧
            cast (states 0) = R0P.poseidonExternalLinear (cast input) :=
fun input states bs sums args leading start initial_cut rounds =>
  have first := NJE_ExternalTotal.result input bs sums args leading initial_cut;
  have initial := Eq.mpr (id (congrArg (fun _a => Canonical _a) start)) fun i => (first.right i).left;
  have canonical := fun i =>
    Fin.induction initial (fun i ih => (one (states i.castSucc) (states i.succ) i ih (rounds i)).left) i;
  have steps := fun r => (one (states r.castSucc) (states r.succ) r (canonical r.castSucc) (rounds r)).right;
  have initial_value :=
    Eq.mpr (id (congrArg (fun _a => cast _a = R0P.poseidonExternalLinear (cast input)) start))
      (funext fun i => (first.right i).right);
  ⟨canonical, ⟨steps, initial_value⟩⟩
