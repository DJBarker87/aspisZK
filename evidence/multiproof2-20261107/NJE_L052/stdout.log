theorem NJE_CountKeyFrame.whole : ∀ (a : Std.Array U32 16#usize) (i w : Usize),
  ↑i < 16 →
    ↑w < 16 →
      NJA_CountDrop.keys (a.set w ((↑a)[↑i]!.wrapping_shr 1#u32)) =
        AspisR1.MultiproofConeLiveOrder.write (NJA_CountDrop.keys a) ↑i ↑w :=
fun a i w ib wb => funext fun j => if jb : j < 16 then NJE_CountArrayFrame.keys_write a i w ib wb j jb else sorry
