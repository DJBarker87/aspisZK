def Aeneas.Std.Array.from_slice.{u} : {α : Type u} → {n : Usize} → Std.Array α n → Slice α → Std.Array α n :=
fun {α} {n} a s => if h : (↑s).length = ↑n then ⟨↑s, ⋯⟩ else a
def List.setSlice!.{u_1} : {α : Type u_1} → List α → ℕ → List α → List α :=
fun {α} s i s' =>
  have s0 := List.take i s;
  have n := min s'.length (s.length - i);
  have s1 := List.take n s';
  have s2 := List.drop (i + n) s;
  s0 ++ s1 ++ s2
