theorem NJE_PermutationFold.compose : ∀ {σ : Type} {n : ℕ} (states : Fin (n + 1) → σ) (steps : Fin n → σ → σ),
  (∀ (i : Fin n), states i.succ = steps i (states i.castSucc)) →
    List.foldl (fun s step => step s) (states 0) (List.ofFn steps) = states (Fin.last n) :=
fun {σ} {n} states steps next => R0P.poseidon_compose_steps✝ states steps next
