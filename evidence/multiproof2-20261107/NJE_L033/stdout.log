theorem NJE_CountArithmetic.sub_value : ∀ (a b : Usize), ↑b ≤ ↑a → ↑(a.wrapping_sub b) = ↑a - ↑b :=
fun a b order =>
  Eq.mpr (id (congrArg (fun _a => _a = ↑a - ↑b) (Usize.wrapping_sub_val_eq a b)))
    (have ha := UScalar.hSize a;
    sorry ha)
'NJE_CountArithmetic.sub_value' depends on axioms: [propext, sorryAx, Classical.choice, Quot.sound]
theorem NJE_CountArithmetic.add_value : ∀ (a b : Usize),
  ↑a + ↑b < UScalar.size UScalarTy.Usize → ↑(a.wrapping_add b) = ↑a + ↑b :=
fun a b small =>
  Eq.mpr (id (congrArg (fun _a => _a = ↑a + ↑b) (Usize.wrapping_add_val_eq a b))) (Nat.mod_eq_of_lt small)
'NJE_CountArithmetic.add_value' depends on axioms: [propext, Classical.choice, Quot.sound]
