theorem NJE_RoundTrace.one : ∀ (pre post : State) (r : Fin 22),
  Canonical pre → Witness pre post r → Canonical post ∧ cast post = R0P.poseidonApplyRound r (cast pre) :=
fun pre post r canonical cut => if first : ↑r < 4 then sorry else if middle : ↑r < 4 + 14 then sorry else sorry
