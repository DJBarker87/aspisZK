theorem NJE_Pow5Packet.TX1_307 : ∀ (x : U32) (len : ℕ) (out : U32),
  Cut x (events x) len out → NJA_FieldLaws.pow5_ref x = ok out ∧ ↑out < 2147483647 ∧ ↑↑out = R0P.poseidonPow5 ↑↑x :=
fun x len out cut =>
  have h := compose x (events x) len out cut (laws x);
  let ⟨z, h✝⟩ := NJA_Pow5Model.reference x
  let ⟨hz, right✝⟩ := h✝
  let ⟨cz, vz⟩ := right✝
  have eq := ok.inj (Eq.trans (Eq.symm hz) h);
  ⟨h,
    ⟨Eq.mp (congrFun' (congrArg LT.lt (congrArg UScalar.val eq)) 2147483647) cz,
      Eq.mp (congrFun' (congrArg Eq (congrArg Nat.cast (congrArg UScalar.val eq))) (R0P.poseidonPow5 ↑↑x)) vz⟩⟩
