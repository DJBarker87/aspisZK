theorem NJE_CountGroup.total : ∀ (a : Std.Array U32 16#usize) (n i : Usize) (hn : ↑n ≤ 16) (active : ↑i < ↑n),
  List.Pairwise (fun x1 x2 => x1 < x2) (unread (NJA_CountDrop.keys a) ↑n ↑i) →
    ∃ q,
      multiproof.node_count_loop0_loop0_loop0 multiproof.Arity.Two a n ((↑a)[↑i].wrapping_shr 1#u32) i = ok q ∧
        ↑q = MultiproofConeLiveOrder.advance (NJA_CountDrop.keys a) ↑n ↑i ∧ ↑i + 1 ≤ ↑q ∧ ↑q ≤ ↑n ∧ ↑q ≤ ↑i + 2 :=
fun a n i hn active sorted =>
  let k := NJA_CountDrop.keys a;
  have head := unread_cons k (↑n) (↑i) active;
  have sorted' :=
    id (fun sorted => Eq.mp (congrArg (fun _a => List.Pairwise (fun x1 x2 => x1 < x2) _a) head) sorted) sorted;
  let ⟨q, h✝⟩ := NJA_CountSorted.group a n i hn active (unread k (↑n) (↑i + 1)) head sorted'
  let ⟨hq, right✝⟩ := h✝
  let ⟨lower, right✝¹⟩ := right✝
  let ⟨upper, tail⟩ := right✝¹
  have rest_length :=
    of_eq_true
      (Eq.trans
        (congrFun' (congrArg Eq (Eq.trans (List.length_map fun j => k (↑i + 1 + j)) List.length_range)) (↑n - (↑i + 1)))
        (eq_self (↑n - (↑i + 1))));
  have eq :=
    List.casesOn (motive := fun t => unread k (↑n) (↑i + 1) = t → ↑q = MultiproofConeLiveOrder.advance k ↑n ↑i)
      (unread k (↑n) (↑i + 1))
      (fun h =>
        Eq.ndrec (motive := fun x => unread k (↑n) (↑i + 1) = x → ↑q = MultiproofConeLiveOrder.advance k ↑n ↑i)
          (fun rest_eq => sorry) (Eq.symm h) (Eq.refl (unread k (↑n) (↑i + 1))))
      (fun x xs h =>
        Eq.ndrec (motive := fun x => unread k (↑n) (↑i + 1) = x → ↑q = MultiproofConeLiveOrder.advance k ↑n ↑i)
          (fun rest_eq =>
            have next :=
              Decidable.byContradiction fun a =>
                total._proof_3 n i active q xs
                  (Eq.mp (congrFun' (congrArg Eq (congrArg List.length rest_eq)) (↑n - (↑i + 1))) rest_length) a;
            have heads := unread_cons k (↑n) (↑i + 1) next;
            have xeq := (List.cons.inj (Eq.trans (Eq.symm rest_eq) heads)).left;
            if both : paired (k ↑i) x then sorry else sorry)
          (Eq.symm h) (Eq.refl (unread k (↑n) (↑i + 1))))
      (Eq.refl (unread k (↑n) (↑i + 1)));
  have adv := advance_bounds k (↑n) (↑i) active;
  Exists.intro q
    ⟨hq,
      ⟨eq,
        ⟨Decidable.byContradiction fun a_1 => total._proof_4 a n i q eq adv a_1,
          ⟨upper,
            Eq.mpr (id (congrArg (fun _a => _a ≤ ↑i + 2) eq))
              (id
                (Decidable.casesOn (MultiproofConeLiveOrder.instDecidablePairAt k ↑n ↑i)
                  (fun h =>
                    Eq.mpr (id (congrFun' (congrArg LE.le (if_neg h)) (↑i + 2)))
                      (Decidable.byContradiction fun a_1 => total._proof_6 a n i q a_1))
                  fun h =>
                  Eq.mpr (id (congrFun' (congrArg LE.le (if_pos h)) (↑i + 2)))
                    (Decidable.byContradiction fun a_1 => total._proof_5 a n i q a_1)))⟩⟩⟩⟩
'NJE_CountGroup.total' depends on axioms: [propext, sorryAx, Classical.choice, Quot.sound]
