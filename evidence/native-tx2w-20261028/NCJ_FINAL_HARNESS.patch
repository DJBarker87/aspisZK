+fn scalar_gate(bad:bool){
+ let f=[cq(),cq(),cq(),cq()];let p=[ce(),ce(),ce(),ce()];let v=ce();
+ let s:usize=kani::any();kani::assume(s<4);reset();
+ let out=v.add(p[PERM[s]].mul_qm31(f[s]));
