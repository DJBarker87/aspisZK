+fn q()->K {K{c0:CM31{a:M31(kani::any()),b:M31(kani::any())},c1:CM31{a:M31(kani::any()),b:M31(kani::any())}}}
+fn weights()->Weights {
+ let mut w=Weights{variant:Variant::S2,factors:[[[K::ZERO;4];5];5],points:[[K::ZERO;10];3],extra:[K::ZERO;2]};
+ for k in [0usize,2usize] {for d in [2usize,3usize] {for i in 0..4 {w.factors[k][d][i]=q();}}}
+ w
