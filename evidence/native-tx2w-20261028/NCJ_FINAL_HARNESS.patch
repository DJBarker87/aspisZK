+#[kani::proof] #[kani::unwind(6)]
+fn NCJ_guard_exact(){
+ let w=weights();let folds:usize=kani::any();
+ let actual=shared_two_point_guard(&w,folds);
+ let expected=folds==2 && w.factors[0][2]==w.factors[2][2] && w.factors[0][3]==w.factors[2][3];
+ assert_eq!(actual,expected);
+}
+#[kani::proof] #[kani::unwind(6)]
+fn NCJ_guard_wrong(){
+ let w=weights();let actual=shared_two_point_guard(&w,2);
+ assert!(actual);
