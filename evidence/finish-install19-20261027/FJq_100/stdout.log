  (B : AspisR1PublicPreparation.FinishModel.Boundaries) (std : AspisR1.ClaimsUnrolledFinish.StdCalls)
  (D : AspisR1CurrentCaller.aspis_core.digest.Digest32 H) (hash : H)
  (pub : AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public)
  (publicBytes proof : Aeneas.Std.Slice Aeneas.Std.U8) (split : Aeneas.Std.Usize)
  (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
  (run :
    AspisR1.Tx1Q_Execution.Run (AspisR1.Tx1Q_Execution.actual ops reserved query geo B std) reserved query geo D hash
      pub publicBytes proof split saved)
  (p : AspisR1.OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144) (tr : AspisR1.RawCutTranscriptRun.ErasedPrefix),
  AspisR1.OraclePortStoredParserC4.parseReached (AspisR1.MultiproofConeCanonical.bytesOf ↑proof) tr = some p →
    ∀ (data : AspisR1.MatchingSupport.Data AspisWideTower.WideExact),
      AspisR1.LiteralMatchingData.read (AspisR1.OraclePortStoredDecisionDraftC4.typedRows p q tr) = some data →
        ∃ expanded y1 view sem,
          AspisR1CurrentCaller.InstalledPreparation.sourceView proof expanded y1 =
              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok view) ∧
            view.semantic = expanded ∧
              AspisR1CurrentCaller.S1SemanticInstallation.verify AspisS1ExtractedRoundChildren.children
                    (AspisR1.ClaimsUnrolledFinish.install std B) D pub expanded hash =
                  Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok sem) ∧
                AspisR1CurrentCaller.BorrowedClaimPrepared.originalNew
                      (AspisR1CurrentCaller.OriginalSerializerInstallation.withOriginalSerializer
                        AspisR1CurrentCaller.BorrowedClaimPrepared.closedSampling)
                      AspisS1M31Embedding.Total.embed D sem view hash (Aeneas.Std.Array.repeat 29#usize run.zero) =
                    Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok run.p, run.scratch) ∧
                  ((fun j l =>
                        AspisR1.FIz_ConcretePack.embed
                          (AspisR1.FJn_MainClaims.claims
                            (AspisR1CurrentCaller.InstalledPreparation.retainedSem sem).claims j l)) =
                      fun j l => data.Y ⟨↑j, ⋯⟩ l) ∧
                    (fun l =>
                          AspisR1.FIz_ConcretePack.embed
                            (AspisR1.FIp_SemanticValues.decode
                              (AspisR1.FJq_MainCells.cell
                                (AspisR1CurrentCaller.InstalledPreparation.retainedSem sem).extra l))) =
                        data.Y 3 ∧
                      ∀ x ∈ ↑(AspisR1CurrentCaller.InstalledPreparation.retainedSem sem).extra,
                        AspisR1.FIp_SemanticValues.Canon x
@AspisR1.FJq_ArbitraryChallengeLiteral.values : ∀ {Hash : Type} {D : AspisR1PublicPreparation.aspis_core.Digest32 Hash}
  {pre : AspisR1PublicPreparation.r1_wire.Prefix}
  {before after : AspisR1PublicPreparation.r1_wire.SemanticTranscript Hash}
  {cs : List (AspisR1PublicPreparation.SourceFull25.Call D pre)},
  AspisR1PublicPreparation.SourceFull25.Trace D pre before after cs →
    cs.length = 25 →
      ∀ (c : AspisR1PublicPreparation.r1_wire.Challenges)
        (alpha : Aeneas.Std.Array AspisR1PublicPreparation.aspis_core.field.QM31 10#usize),
        List.map AspisR1PublicPreparation.SourceFull25.Call.q cs =
            AspisR1PublicPreparation.BeginCalls.challengeList c ++ ↑alpha →
          ∀ {pubInput : AspisR1PublicPreparation.pool_v1.pair_forest_semantic_terminal.r0.Public}
            {root : AspisR1PublicPreparation.TranscriptStep.Bytes32}
            (init : AspisR1PublicPreparation.SourceGlobalOracleInitial.PublicInitCall D pubInput root before)
            (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
            AspisR1PublicPreparation.Tx1DigestLog.ByteOracleBackend D H →
              ∀ (p : AspisR1.OraclePortCompactDraft.Parsed),
                AspisR1.OraclePortCompactDraft.semanticRows 27 0 (AspisR1.OraclePortCompactDraft.slice p.wire 48 6983) =
                    some p.semantic →
                  p.semantic = List.map (fun s => AspisR1.MultiproofConeCanonical.bytesOf ↑s) ↑pre.records →
                    ∀ (w : AspisR1.CanonicalCutEnrichedTranscript.Words),
                      (∀ (row : ℕ),
                          List.length (AspisR1.OraclePortCompactDraft.rowBytes p row) ≤
                            AspisR1.SelectedTranscriptParams.D) →
                        ∀ (pub : AspisR1.LiteralTranscript.Public),
                          pub.pubBytes = AspisR1PublicPreparation.SourceDigestAddresses.rawBytes init.encoded.deref →
                            AspisV8R19.SourceDuplexStep.bytes (AspisV8R19.SqueezeOracleBridge.decodeState root) =
                                AspisR1.OraclePortCompactDraft.root0 p →
                              ∀ (pf : AspisR1.RawCutProverCompiler.Proof),
                                AspisR1.OraclePortCompactDraft.Aligned p
                                    (AspisR1.LiteralTranscript.erasePrefix
                                      (AspisV8R19.MemoizedProgramLaw.eval H
                                          (AspisR1.F3J_SamplerRun.program pf 0 33 (FS.emptyPrefix pub))).2) →
                                  ∀ (q : Fin 22 → Fin 262144) (v : AspisR1.LiteralOpeningView.View),
                                    AspisR1.LiteralOpeningView.read
                                          (AspisR1.OraclePortStoredDecisionDraftC4.typedRows p q
                                            (AspisR1.LiteralTranscript.erasePrefix
                                              (AspisV8R19.MemoizedProgramLaw.eval H
                                                  (AspisR1.F3J_SamplerRun.program pf 0 33 (FS.emptyPrefix pub))).2)) =
                                        some v →
                                      List.map Prod.snd v.semantic = AspisR1.FJq_ChallengeSlots.values c alpha
@AspisR1.FJq_LastPhysical.value : ∀ {H : Type} (D : AspisR1PublicPreparation.aspis_core.Digest32 H)
  (bytes : Aeneas.Std.Slice Aeneas.Std.U8) (pre : AspisR1PublicPreparation.r1_wire.Prefix),
  AspisR1PublicPreparation.PrefixAdapter.parseAccepted bytes =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok pre) →
    ∀ (before after : AspisR1PublicPreparation.r1_wire.SemanticTranscript H)
      (running : AspisR1PublicPreparation.aspis_core.field.QM31)
      (alpha : Aeneas.Std.Array AspisR1PublicPreparation.aspis_core.field.QM31 10#usize),
      AspisR1PublicPreparation.RoundModel.rounds AspisS1ExtractedRoundChildren.children D pre before =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (running, alpha, after)) →
        ∀ (stored : AspisV8R19.DuplexFrames.Bytes) (p : AspisR1.OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144)
          (tr : AspisR1.RawCutTranscriptRun.ErasedPrefix),
          AspisR1.OraclePortStoredParserC4.parseReached stored tr = some p →
            p.semantic = List.map (fun s => AspisR1.MultiproofConeCanonical.bytesOf ↑s) ↑pre.records →
              ∀ (v : AspisR1.LiteralOpeningView.View),
                AspisR1.LiteralOpeningView.read (AspisR1.OraclePortStoredDecisionDraftC4.typedRows p q tr) = some v →
                  ∀ (c : AspisR1PublicPreparation.r1_wire.Challenges),
                    List.map Prod.snd v.semantic = AspisR1.FJq_ChallengeSlots.values c alpha →
                      ∀ (polys : Fin 10 → Polynomial AspisWideTower.WideExact),
                        R0P.Mask.semPolysZ (AspisR1.SelectedSemanticPrefixFacts.lift v.semantic) = some polys →
                          Polynomial.eval ((List.map Prod.snd v.semantic).getD 24 0) (polys 9) =
                            AspisR1.FIz_ConcretePack.embed (AspisR1.FIp_SemanticValues.decode running)
@AspisR1.FJq_InstallationCondition.iff_fixed : ∀ {C : Type} (err : C)
  (c : AspisR1.DrvC_Installation.Configuration AspisR1.FIo_Install.W C) (r : AspisR1.NP6_StdModel.Reservation),
  (AspisR1.FIp_Install.configuration err c r).boundaries.terminal = AspisR1.FIq_Terminal.terminal ↔
    c.boundaries.terminal = AspisR1.FIq_Terminal.terminal
@AspisR1.FJq_InstallationCondition.seed_exists : ∀ {C : Type} (err : C)
  (c : AspisR1.DrvC_Installation.Configuration AspisR1.FIo_Install.W C) (r : AspisR1.NP6_StdModel.Reservation),
  ∃ chosen,
    chosen.boundaries.terminal = AspisR1.FIq_Terminal.terminal ∧
      AspisR1.FIp_Install.configuration err chosen r = AspisR1.FIq_Install.configuration err c r
