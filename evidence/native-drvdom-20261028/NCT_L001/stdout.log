      (AspisR1.Tx1Q_Carriers.pending run.after) 10#usize init.left pend.right.right.right
      (Eq.mpr (id (congrArg (fun _a => _a ≤ ↑10#usize) init.right.left)) (of_decide_eq_true (id (Eq.refl true))))
      native;
  have size := Eq.mpr (id (congrArg (fun _a => (↑_a).length = 64) frame.left)) init.left;
  have lengths :=
    id
      (Eq.mpr (id (congrArg (fun _a => _a ≤ (↑(AspisR1.Tx1Q_Carriers.pending run.after).raw).length) size))
        (Eq.mpr (id (congrArg (fun _a => 64 ≤ _a) frame.right.left)) (le_refl 64)));
  have contents :=
    AspisR1.Port3_FlushInstall.accepted_contents (AspisR1.Tx1Q_Carriers.pending run.after)
      (AspisR1.Tx1Q_Carriers.accumulator run.out).weights.deref
      (AspisR1.Tx1Q_Carriers.slice AspisR1.Tx1Q_Carriers.k run.flushed) lengths run.flush_call;
  have canonical :=
    AspisR1.Port3_FlushInstall.accepted_canonical (AspisR1.Tx1Q_Carriers.pending run.after)
      (AspisR1.Tx1Q_Carriers.accumulator run.out).weights.deref
      (AspisR1.Tx1Q_Carriers.slice AspisR1.Tx1Q_Carriers.k run.flushed) lengths run.flush_call;
