  have reader := { checkedHeader := fun x => checked };
  have length0 := Eq.mp ⋯ ⋯;
  have length1 := ⋯;
  ⋯
theorem AspisR1.EndP_Headline.deployed_headline : ∀ (D : LiteralByteProtocol.Decoder)
  (P : Port1_StoredCarrier.ByteProver) (Q0 Q1 : ℕ),
  (∀ (H : Bytes → State), (eval H P).1.length ≤ Q0 + Q1) →
    ∀ (adapter : AdapterRw.Ops) (impl : VTop_OracleCode.Implementation) {Hash : Type}
      (digest : VTop_Stages.aspis_core.digest.Digest32 Hash) (hash : Hash)
      (runtime : OraclePortRuntimeBindingC7.Runtime),
      Port1_CanonicalJoin.AcceptedVerifierJoin D (Port1_Driver.rust adapter (fun {A} => impl) digest hash) →
        OraclePortRuntimeBindingC7.StoredCarrierBinding D (Port1_Driver.rust adapter (fun {A} => impl) digest hash)
            (Port1_StoredCarrier.lift P) runtime →
          ∀ (current : AspisR1CurrentCaller.Ops) (stage : VTop_Stages.Ops) (reserved : Bool)
            (B : AspisR1PublicPreparation.FinishModel.Boundaries) (std : ClaimsUnrolledFinish.StdCalls)
            (hashv : SdkC_Source.Parts → Result SdkC_Source.Digest)
            (D1 : AspisR1CurrentCaller.aspis_core.digest.Digest32 Unit)
            (D2 : VTop_Stages.aspis_core.digest.Digest32 Unit)
            (adversary : Program Bytes State GExp_Experiment.FirstInputs)
            (chooseSecond :
              GExp_Experiment.FirstInputs → alloc.vec.Vec U8 → Program Bytes State GExp_Experiment.SecondInputs),
            (∀ (H : Bytes → State), (eval H adversary).1.length ≤ Q0) →
              (∀ (input : GExp_Experiment.FirstInputs) (saved : alloc.vec.Vec U8) (H : Bytes → State),
                  (eval H (chooseSecond input saved)).1.length ≤ Q1) →
                ∀ (project : GExp_Experiment.Outcome → OraclePortCompactDraft.Parsed × (Fin 22 → Fin 262144)),
                  have source :=
                    GExp_Experiment.program current stage reserved B std hashv D1 D2 adversary chooseSecond;
                  OraclePortHeadlineFrozen2PerAttempt.Claims D (Port1_StoredCarrier.lift P) (Q0 + Q1) runtime ∧
                    OraclePortHeadlineFrozen2PerAttempt.failureModel runtime + EndP_AuthMass.mass source project ≤
                        ↑(Q0 + Q1 + 34) * PerAttemptEnvelope.B +
                              (6 * ↑(Q0 + Q1 + 1161) ^ 2 / 2 ^ 256 + 6 * ↑(Q0 + Q1 + 23625) ^ 2 / 2 ^ 256) +
                            1 / 2 ^ 126 +
                          1 / 2 ^ 454 ∧
                      (Q0 + Q1 = 0 →
                        OraclePortHeadlineFrozen2PerAttempt.failureModel runtime + EndP_AuthMass.mass source project ≤
                          1 / 2 ^ 100) :=
fun D P Q0 Q1 hqueries adapter impl {Hash} digest hash runtime raw binding current stage reserved B std hashv D1 D2
    adversary chooseSecond prefixBound choiceBound project =>
  id
    (have claims :=
      EndP_Endpoint.final_soundness D P (Q0 + Q1) hqueries adapter (fun {A} => impl) digest hash runtime raw binding;
    have auth :=
      EndP_AuthMass.bound (GExp_Experiment.program current stage reserved B std hashv D1 D2 adversary chooseSecond)
        project (Q0 + Q1)
        (GExp_CollisionBudget.first_reads current stage reserved B std hashv D1 D2 adversary chooseSecond Q0 Q1
          prefixBound choiceBound);
    have total :=
      LE.le.trans_eq (add_le_add claims.right.right.right.left auth) (Eq.symm (EndP_Numeric.total_eq (Q0 + Q1)));
    ⟨claims,
      ⟨total, fun zero =>
        LE.le.trans total
          (Eq.mpr (id (congrArg (fun _a => EndP_Numeric.total _a ≤ 1 / 2 ^ 100) zero)) EndP_Numeric.zero_queries)⟩⟩)
