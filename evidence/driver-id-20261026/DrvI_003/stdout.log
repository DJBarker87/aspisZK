                                          (Op5T_Concrete.stage
                                            (Tx2N_Execution.control stageBase reserved queryOps geoOps))
                                          finishOps B claimsStd;
                                      ∃ f s outer pre middle fs ss,
                                        S2W_NativeConsolidation.SourceCuts
                                            (ClaimsUnrolledSdk.sdkOps
                                              (Tx2I_Install.install adapterOps
                                                (Op5T_Concrete.stage
                                                  (Tx2N_Execution.control stageBase reserved queryOps geoOps))
                                                finishOps)
                                              (Uni_Install.current ops reserved queryOps geoOps) B claimsStd)
                                            e1.first (e2.second S2W_D189Wrappers.secondSizes) saved f s ∧
                                          S2W_AuthenticatedInputs.CheckpointWriterConeJoin ⋯ CPhy_Header.decode H
                                              f.semantic f.pub f.proof f.split ∧
                                            ⋯ ∧ ⋯ :=
fun {W A M Cv F CoreError} {N} L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 adapterOps ops reserved
    queryOps geoOps stageBase finishOps B claimsStd native1 native2 prepareOwner primitiveOwner hashv extraction sha256
    H p1 syscall program data1 data2 slot state1 state2 final1 final2 saved post1 post2 accepted1 accepted2 p root
    length =>
  let ⟨f, h✝⟩ :=
    CPhy_Accepted.accepted_pair_unified L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 adapterOps ops
      reserved queryOps geoOps stageBase finishOps B claimsStd native1 native2 prepareOwner primitiveOwner hashv
      extraction sha256 H p1 syscall program data1 data2 slot state1 state2 final1 final2 saved post1 post2 accepted1
      accepted2 p root length
  let ⟨s, h✝¹⟩ := h✝
  let ⟨outer, h✝²⟩ := h✝¹
  let ⟨pre, h✝³⟩ := h✝²
  let ⟨middle, h✝⁴⟩ := h✝³
  let ⟨fs, h✝⁵⟩ := h✝⁴
  let ⟨ss, h✝⁶⟩ := h✝⁵
  let ⟨cuts, right✝⟩ := h✝⁶
  let ⟨scan, right✝¹⟩ := right✝
  let ⟨tx1, right✝²⟩ := right✝¹
  let ⟨batches, right✝³⟩ := right✝²
  let ⟨tx2, right✝⁴⟩ := right✝³
  let ⟨first, right✝⁵⟩ := right✝⁴
  let ⟨expanded, right✝⁶⟩ := right✝⁵
  let ⟨owned, right✝⁷⟩ := right✝⁶
  let ⟨layout, right✝⁸⟩ := right✝⁷
  let ⟨unchanged, right✝⁹⟩ := right✝⁸
  let ⟨before1, right✝¹⁰⟩ := right✝⁹
  let ⟨before2, right✝¹¹⟩ := right✝¹⁰
  let ⟨claims, caller⟩ := right✝¹¹
  have oracle :=
    S2W_DigestExtraction.native_oracle
      (ClaimsUnrolledSdk.sdkOps
        (Tx2I_Install.install adapterOps
          (Op5T_Concrete.stage (Tx2N_Execution.control stageBase reserved queryOps geoOps)) finishOps)
        (Uni_Install.current ops reserved queryOps geoOps) B claimsStd)
      native1 native2 hashv extraction sha256 H p1 syscall;
  let ⟨run, h✝⁷⟩ := tx1
  let ⟨r, right✝¹²⟩ := h✝⁷
  let ⟨sp, right✝¹³⟩ := right✝¹²
  let ⟨n, right✝¹⁴⟩ := right✝¹³
  let ⟨w, right✝¹⁵⟩ := right✝¹⁴
  let ⟨can, right✝¹⁶⟩ := right✝¹⁵
  let ⟨write, right✝¹⁷⟩ := right✝¹⁶
  let ⟨domain, right✝¹⁸⟩ := right✝¹⁷
  let ⟨wide, right✝¹⁹⟩ := right✝¹⁸
  let ⟨content, right✝²⁰⟩ := right✝¹⁹
  let ⟨native, bound⟩ := right✝²⁰
  have written :=
    CPhy_Header.writer
      (AdapterRw.SolanaDigest.Insts.Aspis_coreDigestDigest32
        (ClaimsUnrolledSdk.sdkOps
          (Tx2I_Install.install adapterOps
            (Op5T_Concrete.stage (Tx2N_Execution.control stageBase reserved queryOps geoOps)) finishOps)
          (Uni_Install.current ops reserved queryOps geoOps) B claimsStd))
      () H oracle (Tx1Q_Carriers.prepared run.p)
      (Tx1Q_Carriers.accumulator
        (have __src := run.out;
        { weights := ⟨↑run.flushed, run.flushed.property⟩, rhs := __src.rhs, power := __src.power,
          next := __src.next }))
      f.proof f.pub saved write;
  have writer :=
    {
      header := fun checkpoint success =>
        have eq := core.result.Result.Ok.inj (ok.inj (Eq.trans (Eq.symm cuts.first) success));
        Eq.mpr
          (id
            (congrFun'
              (congrArg Eq
                (congrArg CPhy_Header.decode
                  (congrArg MultiproofConeCanonical.bytesOf (congrArg Subtype.val (Eq.symm eq)))))
              (some (H (MultiproofConeCanonical.bytesOf ↑f.proof), H (MultiproofConeCanonical.bytesOf ↑f.pub)))))
          written.left,
      size := fun checkpoint success =>
        have eq := core.result.Result.Ok.inj (ok.inj (Eq.trans (Eq.symm cuts.first) success));
        Eq.mpr (id (congrFun' (congrArg Eq (congrArg List.length (congrArg Subtype.val (Eq.symm eq)))) 1768))
          written.right };
  let ⟨p2, h✝⁸⟩ := tx2.right.right.right
  let ⟨a2, h✝⁹⟩ := h✝⁸
  let ⟨g2, h✝¹⁰⟩ := h✝⁹
  let ⟨geo2, h✝¹¹⟩ := h✝¹⁰
  let ⟨pending2, h✝¹²⟩ := h✝¹¹
  let ⟨out2, h✝¹³⟩ := h✝¹²
  let ⟨after2, h✝¹⁴⟩ := h✝¹³
  let ⟨flushed2, h✝¹⁵⟩ := h✝¹⁴
  let ⟨back2, h✝¹⁶⟩ := h✝¹⁵
  let ⟨v2, h✝¹⁷⟩ := h✝¹⁶
  let ⟨read, tail⟩ := h✝¹⁷
  have resumed :=
    Port4A_ReaderInstall.accepted_source stageBase reserved
      (AdapterRw.SolanaDigest.Insts.Aspis_coreDigestDigest32
        (ClaimsUnrolledSdk.sdkOps
          (Tx2I_Install.install adapterOps
            (Op5T_Concrete.stage (Tx2N_Execution.control stageBase reserved queryOps geoOps)) finishOps)
