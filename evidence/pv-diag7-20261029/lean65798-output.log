theorem PV_DIAG7.optionB_bound_unchanged : ∀ {O R Bound : Type} [inst : LE Bound] (distance : (R → O) → (R → O) → Bound)
  (actual publicReal ideal : R → O) (epsilon : Bound),
  actual = publicReal → distance publicReal ideal ≤ epsilon → distance actual ideal ≤ epsilon :=
fun {O R Bound} [LE Bound] distance actual publicReal ideal epsilon he existingBound =>
  Eq.mpr (id (congrArg (fun _a => distance _a ideal ≤ epsilon) he)) existingBound
