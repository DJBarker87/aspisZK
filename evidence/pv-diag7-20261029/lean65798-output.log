def PV_DIAG7.V400_OptionB_P : {W P C : Type} → (W → P) → (W → C) → (W → PV_DIAG7.Signal) → Prop :=
fun {W P C} pub coins signal => ∀ (w u : W), pub w = pub u → coins w = coins u → signal w = signal u
