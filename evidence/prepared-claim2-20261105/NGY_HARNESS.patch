+//! One arbitrary native iteration, frozen source cut and local ruled-(y) oracle.
+use super::*;
+use crate::fast_pairing::{EbyKDot,NGY_carrier as carrier};
+use aspis_core::field::CM31;
+include!(concat!(env!("CARGO_MANIFEST_DIR"),"/../../KMX_stubs.rs"));
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+struct State {sums:[u64;8],count:usize}
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+struct Log {value:[u32;8],scalar:[u32;4],before:State,after:State,reply:bool,calls:u8}
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+struct Out {parse:bool,next:usize,state:State,log:Log}
+fn state(d:&EbyKDot)->State{let (sums,count)=carrier::get(d);State{sums,count}}
+fn words(q:K)->[u32;4]{[q.c0.a.0,q.c0.b.0,q.c1.a.0,q.c1.b.0]}
+fn q(w:[u32;4])->K{K{c0:CM31{a:M31(w[0]),b:M31(w[1])},c1:CM31{a:M31(w[2]),b:M31(w[3])}}}
+fn empty()->Log{Log{value:[0;8],scalar:[0;4],before:State{sums:[0;8],count:0},after:State{sums:[0;8],count:0},reply:false,calls:0}}
+// All state and both Result arms are arbitrary parameters; no child success premise.
+fn oracle(d:&mut EbyKDot,v:E,s:K,post:State,reply:bool,log:&mut Log)->Result<(),()>{
+ *log=Log{value:v.to_limbs(),scalar:words(s),before:state(d),after:post,reply,calls:1};
+ #[cfg(NGY_corrupt)] {log.scalar[0]^=1;}
+ *d=carrier::from(post.sums,post.count);
+ if reply{Ok(())}else{Err(())}
+}
+// Hand reference: selected operands + full poststate + Parse/continue/control/log.
+fn f_ref<H:Digest32>(sem:&crate::r1_semantic::Verified<H>,y1:&[u8],g:&[E;29],point:usize,l:usize,pre:State,post:State,reply:bool)->Out{
+ let scalar=if point<3{sem.claims[point][l]}else if point==3{sem.extra[l]}else if point==4{sem.before_z1[l]}else{field(y1,l).c0()};
+ Out{parse:!reply,next:if reply{l+1}else{l},state:post,log:Log{value:g[l].to_limbs(),scalar:words(scalar),before:pre,after:post,reply,calls:1}}
+}
+fn domain(y1:&[u8],point:usize,l:usize)->bool{
+ if point>=6||l>=29||y1.len()!=928{return false}
+ if point!=5{return true}
+ for j in 0..8{let at=32*l+4*j;if u32::from_le_bytes([y1[at],y1[at+1],y1[at+2],y1[at+3]])>=2147483647{return false}}true
+}
+#[kani::requires(domain(y1,point,l))]
+#[kani::ensures(|r| *r==f_ref(sem,y1,g,point,l,pre,post,reply))]
+#[kani::modifies()]
+fn native<H:Digest32>(sem:&crate::r1_semantic::Verified<H>,y1:&[u8],g:&[E;29],point:usize,l:usize,pre:State,post:State,reply:bool)->Out{
+ let mut dot=carrier::from(pre.sums,pre.count);let mut log=empty();
+ let result:Result<(),Error>=(||{
+                let scalar=match point {0..=2=>sem.claims[point][l],3=>sem.extra[l],4=>sem.before_z1[l],_=>field(y1,l).c0()};
+                oracle(&mut dot,g[l],scalar,post,reply,&mut log).map_err(|_|Error::Parse)?;
+ Ok(())})();
+ Out{parse:matches!(result,Err(Error::Parse)),next:if result.is_ok(){l+1}else{l},state:state(&dot),log}
+}
+#[derive(Clone,Copy)]struct Hash(u64);
+impl Digest32 for Hash{fn digest(&self,_:&[&[u8]])->[u8;32]{[0;32]}}
+macro_rules! qs{($n:expr)=>{unsafe{core::mem::transmute(kani::any::<[u32;$n]>())}}}
+fn sem()->crate::r1_semantic::Verified<Hash>{
+ let challenges=crate::r1_wire::Challenges{lambda:q(kani::any()),chi:q(kani::any()),theta:q(kani::any()),zc:qs!(40),mu:q(kani::any()),eta:q(kani::any())};
+ crate::r1_semantic::Verified{roots:kani::any(),challenges,alpha:qs!(40),claims:Box::new(qs!(348)),extra:qs!(116),before_z1:qs!(116),state_before_z0:kani::any(),z:[SecureCirclePoint{x:q(kani::any()),y:q(kani::any())},SecureCirclePoint{x:q(kani::any()),y:q(kani::any())}],transcript:crate::r1_wire::NGY_carrier::from(kani::any(),Hash(kani::any()),kani::any())}
+}
+macro_rules! harness {($name:ident,$point:expr)=>{
+ #[kani::proof_for_contract(native)]#[kani::unwind(1000)]
+ #[kani::stub(core::ptr::copy_nonoverlapping,KMX_copy_nonoverlapping)]
+ #[kani::stub(<[u8]>::copy_from_slice,KMX_copy_from_slice)]
+ fn $name(){let sem=sem();let y1:[u8;928]=kani::any();
+ let g:[E;29]=unsafe{core::mem::transmute(kani::any::<[u32;232]>())};
+ let point:usize=$point;let l:usize=kani::any();kani::assume(domain(&y1,point,l));
+ let pre=State{sums:kani::any(),count:kani::any()};let post=State{sums:kani::any(),count:kani::any()};let reply:bool=kani::any();
+ let _=native(&sem,&y1,&g,point,l,pre,post,reply);
+ }
+}}
+harness!(point_0,0);
+harness!(point_1,1);
+harness!(point_2,2);
+harness!(point_3,3);
+harness!(point_4,4);
+harness!(point_5,5);
