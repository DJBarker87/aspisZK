theorem NKL_ScanSequence.exact : ∀ {xs : List Check} {out : Reply} {events : List Check} {pre post : Bytes},
  Invoke xs out events pre post → out = (run xs).1 ∧ events = (run xs).2 ∧ post = pre :=
⋯
