{"charon_version":"0.1.223","translated":{"crate_name":"nkl_ref","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::batch_tree"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["core::option::Option","core::result::Result"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-batch-merkle3-20261108/NKL_emitted/NKL_reference.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"nkl_ref","contents":"#![no_std]\n#[derive(Clone,Copy)]\npub enum Error { Parse, Merkle }\n#[derive(Clone,Copy)]\npub struct State { pub idx:[u32;16], pub val:[[u8;32];16], pub d:usize, pub error:Option<Error> }\npub trait Children {\n fn keys(&self,queries:[u32;22],lo:usize,n:usize,tree:usize)->[u64;16];\n fn leaf(&self,tree:usize,q:&[u8])->[u8;32];\n fn count(&self,idx:[u32;16],d:usize)->Option<usize>;\n fn verify(&self,root:[u8;32],state:State,nodes:&[u8])->(bool,State);\n}\npub fn leaf_step(mut state:State,index:u32,leaf:[u8;32])->State {\n if state.d>0 && state.idx[state.d-1]==index {\n  if state.val[state.d-1]!=leaf { state.error=Some(Error::Merkle); }\n } else {\n  state.idx[state.d]=index; state.val[state.d]=leaf; state.d+=1;\n }\n state\n}\npub fn padding_word(bytes:&[u8],at:usize)->bool {\n bytes[at]!=0 || bytes[at+1]!=0 || bytes[at+2]!=0 || bytes[at+3]!=0 || bytes[at+4]!=0 || bytes[at+5]!=0 || bytes[at+6]!=0 || bytes[at+7]!=0\n}\npub fn padding(bytes:&[u8],start:usize)->bool {\n let mut at=start; let mut bad=false;\n while at+8<=bytes.len() && !bad { bad=padding_word(bytes,at); at+=8; }\n bad\n}\npub fn tail<C:Children>(children:&C,root:[u8;32],state:State,nodes:&[u8],capacity:usize)->(Result<(),Error>,State) {\n match children.count(state.idx,state.d) {\n  None=>(Err(Error::Merkle),state),\n  Some(count)=>{\n   if count>capacity || padding(nodes,32*count) { (Err(Error::Parse),state) }\n   else {\n    let (valid,after)=children.verify(root,state,&nodes[..32*count]);\n    if valid { (Ok(()),after) } else { (Err(Error::Merkle),after) }\n   }\n  }\n }\n}\npub fn slot_start(s:usize)->usize {\n let sizes=[146usize,146,128,172,172,150]; let mut at=28359; let mut i=0;\n while i<s {at+=32*sizes[i];i+=1;} at\n}\npub fn batch_tree<C:Children>(children:&C,proof:&[u8],queries:[u32;22],root:[u8;32],batch:usize,tree:usize,idx:[u32;16],val:[[u8;32];16])->(Result<(),Error>,State) {\n let (lo,n)=if batch==0{(0,10)}else{(10,12)};\n let keys=children.keys(queries,lo,n,tree); let mut state=State{idx,val,d:0,error:None}; let mut pos=0;\n while pos<n && state.error.is_none() {\n  let key=keys[pos];pos+=1;let index=(key>>8)as u32;let ordinal=lo+(key&255)as usize;\n  let at=10055+ordinal*832;let leaf=children.leaf(tree,&proof[at..at+832]);state=leaf_step(state,index,leaf);\n }\n match state.error {\n  Some(e)=>(Err(e),state),\n  None=>{let s=3*batch+tree;let sizes=[146usize,146,128,172,172,150];tail(children,root,state,&proof[slot_start(s)..slot_start(s+1)],sizes[s])}\n }\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/array/equality.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["nkl_ref",0]},{"Ident":["batch_tree",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["nkl_ref",0]},{"Ident":["Children",0]}]},{"key":{"Type":0},"value":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}]},{"key":{"Type":1},"value":[{"Ident":["nkl_ref",0]},{"Ident":["Error",0]}]},{"key":{"Type":2},"value":[{"Ident":["nkl_ref",0]},{"Ident":["State",0]}]},{"key":{"Type":3},"value":[{"Ident":["core",0]},{"Ident":["option",0]},{"Ident":["Option",0]}]},{"key":{"Type":4},"value":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["Range",0]}]},{"key":{"Fun":1},"value":[{"Ident":["core",0]},{"Ident":["option",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"t