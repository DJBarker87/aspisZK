theorem NKL_ExitTransport.result : ∀ (exit : Exit) (idx : Indices) (val : Values) (out : Reply) (afterIdx : Indices)
  (afterVal : Values), Cut exit idx val out afterIdx afterVal → (out, afterIdx, afterVal) = (reply exit, idx, val) :=
fun exit idx val out afterIdx afterVal cut =>
  Eq.mpr (id (congrArg (fun _a => (_a, afterIdx, afterVal) = (reply exit, idx, val)) cut.result))
    (Eq.mpr (id (congrArg (fun _a => (reply exit, _a, afterVal) = (reply exit, idx, val)) cut.indices))
      (Eq.mpr (id (congrArg (fun _a => (reply exit, idx, _a) = (reply exit, idx, val)) cut.values))
        (Eq.refl (reply exit, idx, val))))
