def NBW_Horner.Total : NBW_Horner.Mul → Prop :=
fun mul =>
  ∀ (x y : AspisR1Stage2.Stage2E),
    NBO_TailDomain.WideCanonical x →
      NBO_TailDomain.WideCanonical y → ∃ out, mul x y = Aeneas.Std.Result.ok out ∧ NBO_TailDomain.WideCanonical out
theorem NBW_Horner.transport : ∀ (left right : NBW_Horner.Mul),
  NBW_Horner.Total left →
    (∀ (x y : AspisR1Stage2.Stage2E),
        NBO_TailDomain.WideCanonical x → NBO_TailDomain.WideCanonical y → left x y = right x y) →
      ∀ (alpha tail : AspisR1Stage2.Stage2E),
        NBO_TailDomain.WideCanonical alpha →
          NBO_TailDomain.WideCanonical tail →
            ∀ (coefficients : List AspisR1Stage2.Stage2E),
              (∀ h ∈ coefficients, NBO_TailDomain.WideCanonical h) →
                NBW_Horner.eval left alpha coefficients tail = NBW_Horner.eval right alpha coefficients tail :=
fun left right law bind alpha tail ha ht coefficients hc =>
  List.rec (motive := fun coefficients =>
    (∀ h ∈ coefficients, NBO_TailDomain.WideCanonical h) →
      NBW_Horner.eval left alpha coefficients tail = NBW_Horner.eval right alpha coefficients tail)
    (fun hc => Eq.refl (NBW_Horner.eval left alpha [] tail))
    (fun h hs ih hc =>
      have hhs := fun h_1 mem => hc h_1 (List.mem_cons_of_mem h mem);
      let ⟨prior, h✝⟩ := NBW_Horner.total left law alpha tail ha ht hs hhs
      let ⟨hprior, cprior⟩ := h✝
      have same := ih hhs;
      of_eq_true
        (Eq.trans
          (congr
            (congrArg Eq
              (Eq.trans
                (Eq.trans
                  (congrFun' (congrArg Bind.bind hprior) fun prior => do
                    let product ← left alpha prior
                    NBO_FieldSemantics.add h product)
                  (Aeneas.Std.bind_tc_ok prior fun y => do
                    let product ← left alpha y
                    NBO_FieldSemantics.add h product))
                (congrFun' (congrArg Bind.bind (bind alpha prior ha cprior)) fun product =>
                  NBO_FieldSemantics.add h product)))
            (Eq.trans
              (congrFun' (congrArg Bind.bind (Eq.trans (Eq.symm same) hprior)) fun prior => do
                let product ← right alpha prior
                NBO_FieldSemantics.add h product)
              (Aeneas.Std.bind_tc_ok prior fun y => do
                let product ← right alpha y
                NBO_FieldSemantics.add h product)))
          (eq_self do
            let product ← right alpha prior
            NBO_FieldSemantics.add h product)))
    coefficients hc
theorem NBW_FinishWindow.prefix_index : ∀ (f original : ℕ → S8Kani2MutableValue.F.Q)
  (old : S8Kani2MutableExtraction.batched_weights.FinishSlice) (n : ℕ) (i : Aeneas.Std.Usize),
  n ≤ ↑(Aeneas.Std.Slice.len old) →
    ↑i < ↑(Aeneas.Std.Slice.len old) →
      Aeneas.Std.Slice.index_usize old i = Aeneas.Std.Result.ok (original ↑i) →
        Aeneas.Std.Slice.index_usize (S8Kani2MutableExtraction.batched_weights.prefixWrite f 0 n old) i =
          Aeneas.Std.Result.ok (KMX_CopyMeaning.loop f original 0 n ↑i) :=
fun f original old n i extent bound read =>
  if inside : ↑i < n then
    Eq.mpr
      (id
        (congrArg (fun _a => _a = Aeneas.Std.Result.ok (KMX_CopyMeaning.loop f original 0 n ↑i))
          (S8Kani2PrefixWriteIndex.prefixWrite_index f n old i extent inside)))
      (Eq.mpr
        (id
          (congrArg (fun _a => Aeneas.Std.Result.ok (f ↑i) = Aeneas.Std.Result.ok _a)
            (KMX_CopyMeaning.copy_prefix f original n ↑i)))
        (Eq.mpr (id (congrArg (fun _a => Aeneas.Std.Result.ok (f ↑i) = Aeneas.Std.Result.ok _a) (if_pos inside)))
          (Eq.refl (Aeneas.Std.Result.ok (f ↑i)))))
  else
    Eq.mpr
      (id
        (congrArg (fun _a => _a = Aeneas.Std.Result.ok (KMX_CopyMeaning.loop f original 0 n ↑i))
          (S8Kani2PrefixWriteIndex.suffix_index_unchanged f n old i extent
            (Decidable.byContradiction fun a => NBW_FinishWindow.prefix_index._proof_1 old n i inside a) bound)))
      (Eq.mpr (id (congrArg (fun _a => _a = Aeneas.Std.Result.ok (KMX_CopyMeaning.loop f original 0 n ↑i)) read))
        (Eq.mpr
          (id
            (congrArg (fun _a => Aeneas.Std.Result.ok (original ↑i) = Aeneas.Std.Result.ok _a)
              (KMX_CopyMeaning.copy_prefix f original n ↑i)))
          (Eq.mpr
            (id (congrArg (fun _a => Aeneas.Std.Result.ok (original ↑i) = Aeneas.Std.Result.ok _a) (if_neg inside)))
            (Eq.refl (Aeneas.Std.Result.ok (original ↑i))))))
def NBW_Dictionary.install : AspisR1.Port3_NativeQueryBody.Ops → AspisR1.Port3_NativeQueryBody.Ops :=
fun ops =>
  { op0 := @AspisR1.Port3_NativeQueryBody.Ops.op0 ops, op1 := fun q => Aeneas.Std.Result.ok (NBF_RowInstall.embedQ q),
    op2 := ops.op2, op3 := ops.op3, op4 := Aeneas.Std.Result.ok 0#u32, op5 := Aeneas.Std.Result.ok 1#u32,
    op6 := ops.op6, op7 := ops.op7, op8 := ops.op8, op9 := ops.op9,
    op10 := fun m => Aeneas.Std.Result.ok (NBF_RowInstall.embedM m), op11 := ops.op11, op12 := ops.op12,
    op13 := ops.op13, op14 := ops.op14, op15 := ops.op15, op16 := ops.op16, op17 := ops.op17, op18 := ops.op18,
    op19 := ops.op19, op20 := ops.op20, op21 := ops.op21, widePartialEq := NBW_Dictionary.equality }
NBO_WriterEntry.same_writer (base : VTop_Stages.Ops) (reserved : Bool) (ops : AspisR1.Port3_NativeQueryBody.Ops)
  (producers : NBO_ProducerDomains.NBA_NBC base ops) (bounds : NBO_Entry.NBC_Bounds base)
  (lower : NBO_QueryDomains.Lower ops) (bindings : NBO_FieldSemantics.NBC_Bindings ops) {Hash : Type}
  (D : VTop_Stages.aspis_core.digest.Digest32 Hash) (hash : Hash)
  (semantic : VTop_Stages.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public)
  (proof : Aeneas.Std.Slice Aeneas.Std.U8) (split : Aeneas.Std.Usize) (p : AspisR1Stage2.verifier.Prepared)
  (a : AspisR1Stage2.verifier.Accumulator)
  (reached :
    AspisR1.VTop_Provenance.WriterPrefix (NBO_TopInstall.install base reserved ops) D hash semantic proof split none p
      a) :
  ∃ g initial pending geometry after,
    NBO_Entry.Prelude base reserved D hash semantic proof split p g initial pending geometry ∧
      NBO_Composite.source ops proof p initial g geometry pending =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (a, after)) ∧
        NBO_Composite.reference ops proof p initial g geometry pending =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (a, after))
NBO_EveryCaller.ready (base : VTop_Stages.Ops) (reserved : Bool) (ops : AspisR1.Port3_NativeQueryBody.Ops)
  (producers : NBO_ProducerDomains.NBA_NBC base ops) (bounds : NBO_Entry.NBC_Bounds base)
  (lower : NBO_QueryDomains.Lower ops) (bindings : NBO_FieldSemantics.NBC_Bindings ops) {Hash : Type}
  (D : VTop_Stages.aspis_core.digest.Digest32 Hash) (hash : Hash)
  (semantic : VTop_Stages.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public)
  (proof : Aeneas.Std.Slice Aeneas.Std.U8) (split : Aeneas.Std.Usize) (p : AspisR1Stage2.verifier.Prepared)
  (g : Aeneas.Std.Array AspisR1Stage2.Stage2E 29#usize) (initial a : AspisR1Stage2.verifier.Accumulator)
  (pending b : AspisR1Stage2.verifier.BatchedWeights) (geometry : AspisR1Stage2.verifier.QueryGeometry)
  (entry : NBO_Entry.Prelude base reserved D hash semantic proof split p g initial pending geometry)
  (prefixRun : NBO_AllCalls.Prefix ops proof p g geometry initial pending a b) (active : ↑a.next < 10) :
  (↑proof).length = 57607 ∧
    NBO_QueryRhs.Good a b ∧
      a.weights = initial.weights ∧
        NBO_AllCalls.CanonicalWeights a.weights ∧
          NBO_ProducerDomains.Prepared p g ∧
            (∃ q, p.queries.index_usize a.next = Aeneas.Std.Result.ok q ∧ ↑q < 262144) ∧
              (∃ z,
                  Aeneas.Std.alloc.vec.Vec.index (Aeneas.Std.core.slice.index.SliceIndexUsizeSlice Aeneas.Std.U32)
                        geometry.line_z (a.next.wrapping_sub geometry.start) =
                      Aeneas.Std.Result.ok z ∧
                    ↑z < 2147483647) ∧
                ∀ (q : Aeneas.Std.Slice Aeneas.Std.U8),
                  ops.op11 proof a.next = Aeneas.Std.Result.ok q → NBO_CircleDomain.OpeningDomain q
NBO_QueryAssociation.source (ops : AspisR1.Port3_NativeQueryBody.Ops) (proof : Aeneas.Std.Slice Aeneas.Std.U8)
  (p : AspisR1Stage2.verifier.Prepared) (a : AspisR1Stage2.verifier.Accumulator)
  (g : Aeneas.Std.Array AspisR1Stage2.Stage2E 29#usize)
  (obs : Option (AspisR1Stage2.verifier.Phase → Aeneas.Std.Result Unit))
  (geometry : AspisR1Stage2.verifier.QueryGeometry) (b : AspisR1Stage2.verifier.BatchedWeights)
  (size : (↑a.weights).length = 64) (raw : (↑b.raw).length = 64) (active : ↑a.next < 10) (sync : b.terms = a.next)
  (order : ↑geometry.start ≤ ↑a.next) :
  AspisR1.Port3_NativeQueryBody.verifier.candidate.query_values (NBO_QueryAssociation.sourceOps ops) proof p a g obs
      geometry b =
    AspisR1Stage2.verifier.candidate.queryWithOps (NBO_AccumulateAssociation.reference ops)
      (NBO_QueryAssociation.reference ops) proof p a g obs geometry b
