+use super::*;
+// Same base-256 polynomial as LPl_Kit_Bytes.le32, in a nonwrapping u64 carrier.
+fn le(b:&[u8])->u64{u64::from(b[0])+256*(u64::from(b[1])+256*(u64::from(b[2])+256*u64::from(b[3])))}
+fn predicate(b:&[u8],k:bool)->bool{
+ let mut good=true;
+ for j in 0..8 {let n=le(&b[4*j..4*j+4]);good=good&&(n<2147483647)&&(!k||j<4||n==0);}
+ good
+}
+#[kani::proof] #[kani::unwind(10)]
+fn LPl_decoder(){
+ let b:[u8;32]=kani::any();let k:bool=kani::any();
+ let native=match E::from_le_bytes(&b){None=>false,Some(x)=>!k||x.c1()==K::ZERO};
+ assert_eq!(native,predicate(&b,k));
+}
+#[kani::proof] #[kani::unwind(10)]
+fn LPl_iterator(){
+ let b:[u8;928]=kani::any();let i:usize=kani::any();kani::assume(i<=29);
+ let tail=&b[32*i..];let mut it=tail.chunks_exact(32);
+ assert_eq!(it.len(),29-i);assert_eq!(it.remainder().len(),0);
+ match it.next(){
+  None=>{assert_eq!(i,29);assert_eq!(it.len(),0);},
+  Some(c)=>{assert!(i<29);assert_eq!(c.len(),32);assert!(core::ptr::eq(c.as_ptr(),b[32*i..].as_ptr()));
+   assert_eq!(it.len(),29-(i+1));
+   if let Some(next)=it.next(){assert!(i+1<29);assert!(core::ptr::eq(next.as_ptr(),b[32*(i+1)..].as_ptr()));}
+   else {assert_eq!(i+1,29);}
+  }
+ }
+}
+#[kani::proof] #[kani::unwind(10)]
+fn LPl_step(){
+ let b:[u8;32]=kani::any();let k:bool=kani::any();let prior:bool=kani::any();
+ let native=if prior {echeck(&b,k)}else{Err(Error::Parse)};
+ assert_eq!(native,if prior&&predicate(&b,k){Ok(())}else{Err(Error::Parse)});
+}
+#[kani::proof] #[kani::unwind(10)]
+fn LPl_nonvacuity(){
+ let zero=[0u8;32];assert_eq!(echeck(&zero,false),Ok(()));assert_eq!(echeck(&zero,true),Ok(()));
+ let mut high=zero;high[16]=1;assert_eq!(echeck(&high,false),Ok(()));assert_eq!(echeck(&high,true),Err(Error::Parse));
+ let mut bad=zero;bad[0]=255;bad[1]=255;bad[2]=255;bad[3]=127;assert_eq!(echeck(&bad,false),Err(Error::Parse));
+ assert_eq!(echeck(&[],true),Ok(()));
+}
+// Replaces the overly narrow whole-release domain claim, not a timed-out run.
+// Only iterator metadata is inspected; no whole-buffer field loop is executed.
+#[kani::proof] #[kani::unwind(10)]
+fn LPl_release_iterator(){
+ let b:[u8;2272]=kani::any();let n:usize=kani::any();kani::assume(n<=2272);
+ let i:usize=kani::any();kani::assume(i<=n/32);
+ let mut it=b[32*i..n].chunks_exact(32);
+ assert_eq!(it.len(),n/32-i);assert_eq!(it.remainder().len(),n%32);
+ assert!(core::ptr::eq(it.remainder().as_ptr(),b[n-n%32..n].as_ptr()));
+ match it.next(){None=>{assert_eq!(i,n/32);assert_eq!(it.len(),0);},Some(c)=>{
+  assert!(i<n/32);assert_eq!(c.len(),32);assert!(core::ptr::eq(c.as_ptr(),b[32*i..].as_ptr()));assert_eq!(it.len(),n/32-(i+1));
+  match it.next(){None=>assert_eq!(i+1,n/32),Some(next)=>{assert!(i+1<n/32);assert!(core::ptr::eq(next.as_ptr(),b[32*(i+1)..].as_ptr()));}}
+ }}
+}
