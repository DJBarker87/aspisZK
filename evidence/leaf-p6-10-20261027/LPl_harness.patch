+ assert_eq!(c::OFF_FOLDED_ROOT-c::OFF_ROUND0,224);
+ assert_eq!(c::OFF_OPENINGS-c::OFF_ROUND1,2272);
+ assert!(32<=2272&&224<=2272&&800-672<=2272);
+ assert_eq!(c::FINAL_LEN,64);
+}
