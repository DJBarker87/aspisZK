+#[kani::proof] #[kani::unwind(18)] fn LPl_frame_after(){frame::<3>()}
+// Constant-offset replacement for K014's timed-out symbolic destination mux.
+fn fixed<const ROW:usize>(){
+ let input:[u8;16]=kani::any();let mut out:[u8;3712]=kani::any();let j:usize=kani::any();kani::assume(j<3712);
+ let old=out[j];let at=32*ROW;assert_eq!(expand_values(&input,&mut out[at..at+32]),Ok(()));
+ assert_eq!(out[j],if j>=at&&j<at+16{input[j-at]}else if j>=at+16&&j<at+32{0}else{old});
+}
+#[kani::proof] #[kani::unwind(18)] fn LPl_fixed_probe(){fixed::<1>()}
+// No global symbolic store offset: all116 rows are an exhaustive disjoint set
+// of constant-offset classes, with shared arbitrary input/output/j per class.
+#[inline(always)]
+fn constant<const ROW:usize>(input:&[u8;16],out:&mut[u8;3712],j:usize,old:u8){
+ let at=32*ROW;assert_eq!(expand_values(input,&mut out[at..at+32]),Ok(()));
+ assert_eq!(out[j],if j>=at&&j<at+16{input[j-at]}else if j>=at+16&&j<at+32{0}else{old});
+}
