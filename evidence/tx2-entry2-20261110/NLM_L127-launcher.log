def NLM_Process221.dispatch : {Account Ambient : Type} →
  ChildCode Account Ambient → State Account Ambient → Option U8 → Code (Out Ambient) :=
fun {Account Ambient} callee s head =>
  match head with
  | none => fallback callee s
  | some byte =>
    if byte = 4#u8 then callee Child.init s.frame s.world
    else
      if byte = 5#u8 then callee Child.write s.frame s.world
      else if byte = 6#u8 then callee Child.finalize s.frame s.world else fallback callee s

