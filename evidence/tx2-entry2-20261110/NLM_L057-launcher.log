theorem NLM_ReadWindow.all_windows : ∀ (before after : Slice U8), (∀ (i : ℕ), Window before after i) → after = before :=
fun before after windows =>
  Subtype.ext
    (List.ext_getElem (windows 0).left fun i hi hj =>
      have same := (windows i).right hj;
      Eq.mp
        (Eq.trans (congr (congrArg Eq (List.getElem?_eq_getElem hi)) (List.getElem?_eq_getElem hj))
          (Option.some.injEq (↑after)[i] (↑before)[i]))
        same)
