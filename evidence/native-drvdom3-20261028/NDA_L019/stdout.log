theorem AspisR1.NDA_DriverDomain.domain_iff : ∀ {F C : Type} (c : AspisR1.DrvC_Installation.Configuration F C)
  (semantic : AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public)
  (pub proof : Aeneas.Std.Slice Aeneas.Std.U8)
  (cut :
    AspisR1.NCU_DriverDomain.Prefix (AspisR1.DrvC_Installation.currentInstalled c)
      (AspisR1.DrvC_Installation.currentDigest c) semantic pub proof ()),
  AspisR1.KNE_Caller.WriterDomain (AspisR1.NCT_DriverDomain.writerPrepared cut.prepared)
      (AspisR1.NCT_DriverDomain.writerAccumulator cut.out cut.flushed) ↔
    (∀ (j : Fin 4),
        AspisR1.OraclePortCkptAbi4Decode.Canonical
          ((AspisR1.NDA_DriverDomain.inventory c semantic pub proof cut).coordinates j)) ∧
      AspisR1.OraclePortCkptAbi4Decode.CanonicalWide (AspisR1.NDA_DriverDomain.inventory c semantic pub proof cut).rhs ∧
        AspisR1.OraclePortCkptAbi4Decode.Canonical
          (AspisR1.NDA_DriverDomain.inventory c semantic pub proof cut).power :=
fun {F C} c semantic pub proof cut =>
  { mp := fun h => ⟨h.canonical.coordinates, ⟨h.canonical.rhs, h.canonical.power⟩⟩,
    mpr := fun a =>
      let ⟨coordinates, right✝⟩ := a
      let ⟨rhs, power⟩ := right✝
      AspisR1.NDA_DriverDomain.domain c semantic pub proof cut coordinates rhs power }
theorem AspisR1.NDA_DriverDomain.leaf : ∀ {F C : Type} (c : AspisR1.DrvC_Installation.Configuration F C)
  (semantic : AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public)
  (pub proof : Aeneas.Std.Slice Aeneas.Std.U8)
  (cut :
    AspisR1.NCU_DriverDomain.Prefix (AspisR1.DrvC_Installation.currentInstalled c)
      (AspisR1.DrvC_Installation.currentDigest c) semantic pub proof ())
  (coordinates :
    ∀ (j : Fin 4),
      AspisR1.OraclePortCkptAbi4Decode.Canonical
        ((AspisR1.NDA_DriverDomain.inventory c semantic pub proof cut).coordinates j))
  (rhs :
    AspisR1.OraclePortCkptAbi4Decode.CanonicalWide (AspisR1.NDA_DriverDomain.inventory c semantic pub proof cut).rhs)
  (power :
    AspisR1.OraclePortCkptAbi4Decode.Canonical (AspisR1.NDA_DriverDomain.inventory c semantic pub proof cut).power)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  AspisR1.CheckpointBytes5Inputs.Oracle
      (AspisR1.VTop_Checkpoint.digest (AspisR1.Tx1Q_Install.digest (AspisR1.DrvC_Installation.currentDigest c))) () H →
    ∀ (native : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.DuplexFrames.Bytes → AspisV8R19.DuplexFrames.Bytes → Prop),
      AspisR1.KNE_Composition.LocalCorrect native KND_Schedule.schedule →
        ∀ (hp hu hc : AspisR1.CheckpointBytes5Effect.Digest) (body out : Aeneas.Std.Slice Aeneas.Std.U8)
          (before : AspisR1.CheckpointBytes5Effect.Log),
          AspisR1.KNE_Composition.Trace native
              (AspisR1.KNE_Model.bodyEmissions
                (AspisR1.CheckpointBytesBody.fields (AspisR1.NCT_DriverDomain.writerPrepared cut.prepared)
                  (AspisR1.NCT_DriverDomain.writerAccumulator cut.out cut.flushed) ⋯ ⋯)
                (AspisR1.CheckpointBytesDigest.stateOf hp) (AspisR1.CheckpointBytesDigest.stateOf hu))
              [] (AspisR1.MultiproofConeCanonical.bytesOf ↑body) →
            native (AspisR1.MultiproofConeCanonical.bytesOf ↑body) (AspisR1.MultiproofConeCanonical.bytesOf ↑hc)
                (AspisR1.MultiproofConeCanonical.bytesOf ↑out) →
              (AspisR1.VTop_Checkpoint.digest
                        (AspisR1.Tx1Q_Install.digest (AspisR1.DrvC_Installation.currentDigest c))).digest
                    () (AspisR1Stage2.WireTx2.singletonParts proof) =
                  Aeneas.Std.Result.ok hp →
                (AspisR1.VTop_Checkpoint.digest
                          (AspisR1.Tx1Q_Install.digest (AspisR1.DrvC_Installation.currentDigest c))).digest
                      () (AspisR1Stage2.WireTx2.singletonParts pub) =
                    Aeneas.Std.Result.ok hu →
                  (AspisR1.VTop_Checkpoint.digest
                            (AspisR1.Tx1Q_Install.digest (AspisR1.DrvC_Installation.currentDigest c))).digest
                        () (AspisR1Stage2.WireTx2.checksumParts body) =
                      Aeneas.Std.Result.ok hc →
                    (↑out).length = 1768 ∧
                      out =
                          AspisR1.LPm_CheckpointProgram.returned (AspisR1.NCT_DriverDomain.writerPrepared cut.prepared)
                            (AspisR1.NCT_DriverDomain.writerAccumulator cut.out cut.flushed) ⋯ ⋯ ⋯ ⋯ hp hu hc ∧
                        AspisR1.CheckpointBytes5Effect.run
                              (AspisR1.VTop_Checkpoint.digest
                                (AspisR1.Tx1Q_Install.digest (AspisR1.DrvC_Installation.currentDigest c)))
                              ()
                              (AspisR1.CheckpointBytes5Writer.writer
                                (AspisR1.NCT_DriverDomain.writerPrepared cut.prepared)
                                (AspisR1.NCT_DriverDomain.writerAccumulator cut.out cut.flushed) proof pub)
                              before =
                            Aeneas.Std.Result.ok
                              (out,
                                before ++ [(AspisR1Stage2.WireTx2.singletonParts proof, hp)] ++
                                    [(AspisR1Stage2.WireTx2.singletonParts pub, hu)] ++
                                  [(AspisR1Stage2.WireTx2.checksumParts body, hc)]) ∧
                          AspisR1.MultiproofConeCanonical.bytesOf ↑out =
                            AspisR1.OraclePortCheckpointAbiC5.encode H (AspisR1.MultiproofConeCanonical.bytesOf ↑proof)
                              (AspisR1.MultiproofConeCanonical.bytesOf ↑pub)
                              (AspisR1.CheckpointBytesBlocks.prepared
                                (AspisR1.CheckpointBytesBody.fields
                                  (AspisR1.NCT_DriverDomain.writerPrepared cut.prepared)
                                  (AspisR1.NCT_DriverDomain.writerAccumulator cut.out cut.flushed) ⋯ ⋯)
                                ⋯)
                              (AspisR1.CheckpointBytesBlocks.accumulator
                                (AspisR1.CheckpointBytesBody.fields
                                  (AspisR1.NCT_DriverDomain.writerPrepared cut.prepared)
                                  (AspisR1.NCT_DriverDomain.writerAccumulator cut.out cut.flushed) ⋯ ⋯)
                                ⋯) :=
fun {F C} c semantic pub proof cut coordinates rhs power H oracle native valid hp hu hc body out before tr checksumWrite
    proofCall publicCall checksumCall =>
  AspisR1.NCU_DriverDomain.leaf c semantic pub proof cut
    (AspisR1.NDA_DriverDomain.preparation c semantic pub proof cut).left
    (AspisR1.NDA_DriverDomain.preparation c semantic pub proof cut).right.left
    ((AspisR1.NDA_DriverDomain.remaining_iff c semantic pub proof cut).mpr ⟨coordinates, ⟨rhs, power⟩⟩) H oracle native
    valid hp hu hc body out before tr checksumWrite proofCall publicCall checksumCall
