def AspisR1.S2Z.Oracle.RuntimeSyscall : (S2Z.Oracle.Parts → Result S2Z.Oracle.Digest) →
  (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) → Prop :=
fun hashv sha256 =>
  ∀ (parts : S2Z.Oracle.Parts) (digest : S2Z.Oracle.Digest),
    hashv parts = ok digest →
      AspisV8R19.SqueezeOracleBridge.decodeState digest = sha256 (AspisV8R19.SqueezeOracleBridge.flatten parts)
