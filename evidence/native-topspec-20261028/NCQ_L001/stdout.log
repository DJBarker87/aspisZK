fun sha256 H => ∀ (bytes : AspisV8R19.DuplexFrames.Bytes), sha256 bytes = H bytes
def AspisR1.S2W_D189Wrappers.first : {A : Type} →
  First →
    (S2Trust.Heap (ℕ → S2W_D189Entry.Record) →
        ℕ → S2Trust.Payload → S2W_TrustedStd.Outcome (ℕ → S2W_D189Entry.Record)) →
      S2W_D189Wrappers.Allocator A →
        S2W_D189Entry.Entry →
          Program →
            Slice U8 →
              A →
                Result
                  (core.result.Result (alloc.vec.Vec U8 × S2Trust.Heap (ℕ → S2W_D189Entry.Record) × A)
                    AdapterRw.Cuts.PE) :=
fun {A} native copy allocator e program data state => do
  let allocated ←
    S2W_D189Wrappers.reserve allocator (S2W_D189Wrappers.admittedSizes e 3 S2W_D189Wrappers.firstSizes) state
  let result ← native program e.first data
  match result with
    | core.result.Result.Err error => ok (core.result.Result.Err error)
    | core.result.Result.Ok saved =>
      match
        copy (S2Trust.acquire e.heap (e.heap.accounts 2).1 0 0 S2Trust.Kind.exclusive) (e.heap.accounts 2).1
          (S2W_CommittedCheckpoint.source (S2W_ReturnedCheckpoint.nativeBytes saved)) with
      | S2W_TrustedStd.Outcome.panic => fail Error.assertionFailure
      | S2W_TrustedStd.Outcome.returned written => do
        let cleaned ← allocator.cleanup allocated
        ok
            (core.result.Result.Ok
              (saved, S2Trust.release written (S2W_WrapperLaws.exclusiveGuard e.heap 2 0 0), cleaned))
def AspisR1.S2W_D189Wrappers.second : {A : Type} →
  Second →
    S2W_D189Wrappers.Allocator A →
      S2W_D189Entry.Entry →
        Program →
          Slice U8 →
            Slot → A → Result (core.result.Result (S2Trust.Heap (ℕ → S2W_D189Entry.Record) × A) AdapterRw.Cuts.PE) :=
fun {A} native allocator e program data slot state => do
  let allocated ←
    S2W_D189Wrappers.reserve allocator (S2W_D189Wrappers.admittedSizes e 7 S2W_D189Wrappers.secondSizes) state
  let result ← native program (e.second S2W_D189Wrappers.secondSizes) data slot
  match result with
    | core.result.Result.Err error => ok (core.result.Result.Err error)
    | core.result.Result.Ok PUnit.unit => do
      let cleaned ← allocator.cleanup allocated
      ok (core.result.Result.Ok (e.heap, cleaned))
