  (D : AspisR1PublicPreparation.aspis_core.Digest32 H) (p : FS2.Duplex.Params M Cv L)
  (pubInput : Aeneas.Std.Slice Aeneas.Std.U8) (root : AspisR1PublicPreparation.TranscriptStep.Bytes32)
  (length : Aeneas.Std.U32) (sem : AspisR1PublicPreparation.r1_semantic.Verified H)
  (v : AspisR1PublicPreparation.verifier.View) (hash : H) (out : AspisR1PublicPreparation.verifier.Prepared)
  (scratch : Aeneas.Std.Array AspisR1PublicPreparation.aspis_core.field.WideExact 29#usize),
  AspisR1CurrentCaller.OriginalSerializerInstallation.ExactSerializedRankTrace D p pubInput root length sem v hash out
      scratch →
    AspisR1CurrentCaller.OriginalSerializerInstallation.QueryScannerMeaning D v out
AspisR1CurrentCaller.S1SemanticCarrier.semantic_round: ∀ {H : Type}
  (x : AspisR1PublicPreparation.r1_semantic.Verified H),
  AspisR1CurrentCaller.InstalledPreparation.retainedSem (AspisR1CurrentCaller.S1SemanticCarrier.currentSem x) = x
AspisR1CurrentCaller.BorrowedClaimPrepared.prepare_semantic_roots: ∀ (ops : AspisR1CurrentCaller.Ops)
  (R : AspisR1PublicPreparation.RoundModel.Boundaries) (B : AspisR1PublicPreparation.FinishModel.Boundaries) {H : Type}
  (D : AspisR1CurrentCaller.aspis_core.digest.Digest32 H)
  (pub : AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public)
  (proof : Aeneas.Std.Slice Aeneas.Std.U8) (hash : H) (prepared : AspisR1CurrentCaller.verifier.Prepared)
  (input scratch : Aeneas.Std.Array AspisR1CurrentCaller.aspis_core.field.wide_exact.WideExact 29#usize),
  AspisR1CurrentCaller.verifier.candidate.prepare
        (AspisR1CurrentCaller.BorrowedClaimPrepared.closedInstall
          (AspisR1CurrentCaller.S1SemanticInstallation.install ops R B))
        D pub proof hash none input =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok prepared, scratch) →
    prepared.variant = AspisR1CurrentCaller.transport.Variant.S2 ∧
      ∃ semantic y1 view sem pre initial after challenges payload root2,
        AspisR1CurrentCaller.InstalledPreparation.sourceView proof semantic y1 =
            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok view) ∧
          AspisR1CurrentCaller.S1SemanticInstallation.verify R B D pub view.semantic hash =
              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok sem) ∧
            AspisR1CurrentCaller.BorrowedClaimPrepared.originalNew
                  (AspisR1CurrentCaller.OriginalSerializerInstallation.withOriginalSerializer
                    AspisR1CurrentCaller.BorrowedClaimPrepared.closedSampling)
                  AspisS1M31Embedding.Total.embed D sem view hash input =
                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok prepared, scratch) ∧
              AspisR1PublicPreparation.PrefixAdapter.parseAccepted view.semantic =
                  Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok pre) ∧
                AspisR1PublicPreparation.r1_semantic.public_transcript
                      (AspisR1CurrentCaller.InstalledPreparation.retainedDigest D)
                      (AspisR1CurrentCaller.FirstComposition.toRetainedPublic pub) hash pre.c1_root =
                    Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok initial) ∧
                  AspisR1PublicPreparation.r1_wire.begin (AspisR1CurrentCaller.InstalledPreparation.retainedDigest D)
                        pre initial =
                      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok challenges, after) ∧
                    AspisR1PublicPreparation.FinishModel.finish R
                          (AspisR1PublicPreparation.S1SemanticRootCopy.install B)
                          (AspisR1CurrentCaller.InstalledPreparation.retainedDigest D)
                          (AspisR1CurrentCaller.FirstComposition.toRetainedPublic pub) pre after challenges none =
                        Aeneas.Std.Result.ok
                          (Aeneas.Std.core.result.Result.Ok
                            (AspisR1CurrentCaller.InstalledPreparation.retainedSem sem)) ∧
                      AspisR1PublicPreparation.FinishModel.payload pre 2#u8 =
                          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok payload) ∧
                        Aeneas.Std.core.array.TryFromArrayCopySlice.try_from 32#usize Aeneas.Std.core.marker.CopyU8
                              payload =
                            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok root2) ∧
                          ↑root2 = ↑payload ∧
                            prepared.roots = Aeneas.Std.Array.make 2#usize [pre.c1_root, root2] ⋯ ∧
                              prepared.semantic_alpha = sem.alpha ∧
                                prepared.z = sem.z ∧
                                  ∀ (i : Fin 10),
                                    AspisR1CurrentCaller.S1SemanticInstallation.CanonicalQ
                                      (↑prepared.semantic_alpha)[↑i]
AspisR1CurrentCaller.OriginalSerializerInstallation.queryRhoFacts_scanner_meaning: ∀ {H M Cv : Type} {L : ℕ}
  (D : AspisR1PublicPreparation.aspis_core.Digest32 H) (p : FS2.Duplex.Params M Cv L)
  (pubInput : Aeneas.Std.Slice Aeneas.Std.U8) (root : AspisR1PublicPreparation.TranscriptStep.Bytes32)
  (length : Aeneas.Std.U32) (v : AspisR1PublicPreparation.verifier.View)
  (out : AspisR1PublicPreparation.verifier.Prepared) (row : Aeneas.Std.U8)
  (before : AspisR1PublicPreparation.transcript.Transcript H),
  row = 30#u8 ∨ row = 31#u8 →
    AspisR1ClaimPreparedBridge.InstalledMeaning.ConcreteQueryRhoFacts AspisS1M31Embedding.Total.embed D p pubInput root
        length v out row before →
      AspisR1CurrentCaller.OriginalSerializerInstallation.QueryScannerMeaning D v out
AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public.Withdrawal.sizeOf_spec: ∀
  (a : AspisR1CurrentCaller.aspis_statement.pool_v1.payment_relation.PoolV1WithdrawalPublicV1)
  (a_1 : AspisR1CurrentCaller.aspis_statement.pool_v1.pair_tree_profile.PoolV1PairLatePublicStatementV1),
  sizeOf (AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public.Withdrawal a a_1) =
    1 + sizeOf a + sizeOf a_1
AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public.Withdrawal.injEq: ∀
  (a : AspisR1CurrentCaller.aspis_statement.pool_v1.payment_relation.PoolV1WithdrawalPublicV1)
  (a_1 : AspisR1CurrentCaller.aspis_statement.pool_v1.pair_tree_profile.PoolV1PairLatePublicStatementV1)
  (a_2 : AspisR1CurrentCaller.aspis_statement.pool_v1.payment_relation.PoolV1WithdrawalPublicV1)
  (a_3 : AspisR1CurrentCaller.aspis_statement.pool_v1.pair_tree_profile.PoolV1PairLatePublicStatementV1),
  (AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public.Withdrawal a a_1 =
      AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public.Withdrawal a_2 a_3) =
    (a = a_2 ∧ a_1 = a_3)
AspisR1CurrentCaller.r1_semantic.Verified.mk.sizeOf_spec: ∀ {H : Type} [inst : SizeOf H]
  (roots : Aeneas.Std.Array (Aeneas.Std.Array Aeneas.Std.U8 32#usize) 2#usize)
  (challenges : AspisR1CurrentCaller.aspis_core.state_only_prefix.r0.Challenges)
  (alpha : Aeneas.Std.Array AspisR1CurrentCaller.aspis_core.field.QM31 10#usize)
  (claims : Aeneas.Std.Array (Aeneas.Std.Array AspisR1CurrentCaller.aspis_core.field.QM31 29#usize) 3#usize)
  (extra before_z1 : Aeneas.Std.Array AspisR1CurrentCaller.aspis_core.field.QM31 29#usize)
  (state_before_z0 : Aeneas.Std.Array Aeneas.Std.U8 32#usize)
  (z : Aeneas.Std.Array AspisR1CurrentCaller.aspis_core.circle.SecureCirclePoint 2#usize)
  (transcript : AspisR1CurrentCaller.r1_wire.SemanticTranscript H),
  sizeOf
      { roots := roots, challenges := challenges, alpha := alpha, claims := claims, extra := extra,
        before_z1 := before_z1, state_before_z0 := state_before_z0, z := z, transcript := transcript } =
    1 + sizeOf roots + sizeOf challenges + sizeOf alpha + sizeOf claims + sizeOf extra + sizeOf before_z1 +
          sizeOf state_before_z0 +
        sizeOf z +
      sizeOf transcript
