  AspisR1CurrentCaller.r1_semantic.Verified H → AspisR1PublicPreparation.r1_semantic.Verified H :=
fun {H} x =>
  { roots := x.roots,
    challenges :=
      { lambda := AspisR1CurrentCaller.InstalledPreparation.retainedQ x.challenges.lambda,
        chi := AspisR1CurrentCaller.InstalledPreparation.retainedQ x.challenges.chi,
        theta := AspisR1CurrentCaller.InstalledPreparation.retainedQ x.challenges.theta,
        zc := AspisR1ClaimPreparedBridge.mapArray AspisR1CurrentCaller.InstalledPreparation.retainedQ x.challenges.zc,
        mu := AspisR1CurrentCaller.InstalledPreparation.retainedQ x.challenges.mu,
        eta := AspisR1CurrentCaller.InstalledPreparation.retainedQ x.challenges.eta },
    alpha := AspisR1ClaimPreparedBridge.mapArray AspisR1CurrentCaller.InstalledPreparation.retainedQ x.alpha,
    claims :=
      AspisR1ClaimPreparedBridge.mapArray
        (AspisR1ClaimPreparedBridge.mapArray AspisR1CurrentCaller.InstalledPreparation.retainedQ) x.claims,
    extra := AspisR1ClaimPreparedBridge.mapArray AspisR1CurrentCaller.InstalledPreparation.retainedQ x.extra,
    before_z1 := AspisR1ClaimPreparedBridge.mapArray AspisR1CurrentCaller.InstalledPreparation.retainedQ x.before_z1,
    state_before_z0 := x.state_before_z0,
    z := AspisR1ClaimPreparedBridge.mapArray AspisR1CurrentCaller.InstalledPreparation.retainedPoint x.z,
