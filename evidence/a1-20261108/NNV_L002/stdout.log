def AspisR1CurrentCaller.S1SemanticInstallation.verify : AspisR1PublicPreparation.RoundModel.Boundaries →
  AspisR1PublicPreparation.FinishModel.Boundaries →
    {H : Type} →
      AspisR1CurrentCaller.aspis_core.digest.Digest32 H →
        AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public →
          Aeneas.Std.Slice Aeneas.Std.U8 →
            H →
              Aeneas.Std.Result
                (Aeneas.Std.core.result.Result (AspisR1CurrentCaller.r1_semantic.Verified H)
                  AspisR1CurrentCaller.r1_wire.Error) :=
fun R B {H} D pub bytes hash => do
  let result ←
    AspisR1PublicPreparation.VerifyPrefix.verify
        (fun {H} =>
          AspisR1PublicPreparation.FinishModel.finish R (AspisR1PublicPreparation.S1SemanticRootCopy.install B))
        (AspisR1CurrentCaller.InstalledPreparation.retainedDigest D)
        (AspisR1CurrentCaller.FirstComposition.toRetainedPublic pub) bytes hash none
  Aeneas.Std.Result.ok
      (match result with
      | Aeneas.Std.core.result.Result.Ok sem =>
        Aeneas.Std.core.result.Result.Ok (AspisR1CurrentCaller.S1SemanticCarrier.currentSem sem)
      | Aeneas.Std.core.result.Result.Err error =>
        Aeneas.Std.core.result.Result.Err (AspisR1CurrentCaller.S1SemanticCarrier.currentWireError error))
def AspisR1CurrentCaller.S1SemanticInstallation.install : AspisR1CurrentCaller.Ops →
  AspisR1PublicPreparation.RoundModel.Boundaries →
    AspisR1PublicPreparation.FinishModel.Boundaries → AspisR1CurrentCaller.Ops :=
fun ops R B =>
  { op0 := ops.op0, op1 := @AspisR1CurrentCaller.Ops.op1 ops, op2 := ops.op2, op3 := ops.op3, op4 := ops.op4,
    op5 := ops.op5, op6 := @AspisR1CurrentCaller.Ops.op6 ops, op7 := ops.op7, op8 := @AspisR1CurrentCaller.Ops.op8 ops,
    op9 := fun {H} D pub bytes hash obs =>
      match obs with
      | none => AspisR1CurrentCaller.S1SemanticInstallation.verify R B D pub bytes hash
      | some observe => ops.op9 D pub bytes hash (some observe),
    op10 := ops.op10, op11 := ops.op11, op12 := ops.op12, op13 := ops.op13, op14 := ops.op14, op15 := ops.op15,
    op16 := @AspisR1CurrentCaller.Ops.op16 ops, op17 := ops.op17, op18 := ops.op18, op19 := ops.op19, op20 := ops.op20,
    op21 := ops.op21 }
