'AspisR1.NKD_Values.gamma' depends on axioms: [propext, Classical.choice, Quot.sound]
'AspisR1.NKD_Values.gamma_unique' depends on axioms: [propext, Classical.choice, Quot.sound]
gamma : ∀ (block : NGT_NBL_SamplerReplay.Bytes32) (out : aspis_core.field.WideExact),
  NKD_Gamma.Cut block out → Canonical (toClaimE out) ∧ GammaRankMeaning block out
gamma_unique : ∀ (block : NGT_NBL_SamplerReplay.Bytes32) (a b : aspis_core.field.WideExact),
  NKD_Gamma.Cut block a → NKD_Gamma.Cut block b → a = b
