theorem AspisR1.NKD_Gamma.root : ∀ (block : Bytes32) (out : AspisR1PublicPreparation.aspis_core.field.WideExact),
  Cut block out → NGT_NBA_Installed.actual.sampling.gamma block = ok out :=
fun block out cut => NGT_Reduction.scalar cut
'AspisR1.NKD_Gamma.root' depends on axioms: [propext, Classical.choice, Quot.sound]
