theorem AspisR1.NKD_Ordinary.root : ∀ (block : Bytes32) (digits q : Words),
  NKD_Low.Cut block digits q →
    NGT_NBA_Installed.actual.sampling.ordinary block =
      ok (AspisR1Post25SamplerPreparedCarrier.candidateToPE (NGT_NBL_DecodeNative.pack digits)) :=
fun block digits q cut => NGT_NBL_SamplerNative.ordinary block digits q cut
'AspisR1.NKD_Ordinary.root' depends on axioms: [propext, Classical.choice, Quot.sound]
