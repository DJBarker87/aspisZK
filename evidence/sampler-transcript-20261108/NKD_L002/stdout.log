theorem AspisR1.NKD_Decode.root : ∀ (digits : Digits),
  Canonical digits → AspisR1Post25Sampler.sampler.decode8 digits = ok (NGT_NBL_DecodeNative.pack digits) :=
fun digits canonical => NGT_NBL_DecodeNative.source digits canonical
'AspisR1.NKD_Decode.root' depends on axioms: [propext, Classical.choice, Quot.sound]
