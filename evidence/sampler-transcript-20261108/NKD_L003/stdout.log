theorem AspisR1.NKD_Low.root : ∀ (block : Bytes32) (digits q : Words),
  Cut block digits q →
    AspisR1Post25Sampler.sampler.low_base_p_digits block = ok (digits, quotient q) ∧
      Canonical digits ∧ ↑(quotient q) ≤ 256 :=
fun block digits q cut => low block digits q cut
'AspisR1.NKD_Low.root' depends on axioms: [propext, Classical.choice, Quot.sound]
