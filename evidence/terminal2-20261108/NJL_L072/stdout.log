theorem AspisR1.NJL_TagRawTrace.source : ∀ (s : Selectors) (xs : List (Fin 272)) (before : State) (k : ℕ),
  k + xs.length ≤ 4 →
    FIw_ArrayValue.canonical s.high →
      (∀ (i : Fin 4), ↑(before i) ≤ k * B) →
        ∃ after,
          run s xs before = ok after ∧
            Trace s xs k before after ∧
              (∀ (i : Fin 4), ↑(after i) = ↑(before i) + dot s xs i) ∧
                ∀ (i : Fin 4), ↑(after i) ≤ (k + xs.length) * B :=
fun s xs before k small hs hb =>
  List.rec (motive := fun xs =>
    ∀ (before : State) (k : ℕ),
      k + xs.length ≤ 4 →
        (∀ (i : Fin 4), ↑(before i) ≤ k * B) →
          ∃ after,
            run s xs before = ok after ∧
              Trace s xs k before after ∧
                (∀ (i : Fin 4), ↑(after i) = ↑(before i) + dot s xs i) ∧
                  ∀ (i : Fin 4), ↑(after i) ≤ (k + xs.length) * B)
    (fun before k small hb =>
      Exists.intro before
        ⟨rfl,
          ⟨Trace.nil k before,
            ⟨fun i => of_eq_true (Eq.trans (congrArg (Eq ↑(before i)) (add_zero ↑(before i))) (eq_self ↑(before i))),
              Eq.mpr
                (id
                  (forall_congr fun i => congrArg (LE.le ↑(before i)) (congrFun' (congrArg HMul.hMul (add_zero k)) B)))
                hb⟩⟩⟩)
    (fun t ts ih before k small hb =>
      have hk := Decidable.byContradiction fun a => source._proof_2 ts k small a;
      let ⟨products, h✝⟩ := NJL_TagRawStep.source s t before k hk hs hb
      let ⟨middle, h✝¹⟩ := h✝
      let ⟨events, h✝²⟩ := h✝¹
      let ⟨call, right✝⟩ := h✝²
      let ⟨cut, right✝¹⟩ := right✝
      let ⟨productsLaw, right✝²⟩ := right✝¹
      let ⟨left✝, hm⟩ := right✝²
      let ⟨after, h✝³⟩ := ih middle (k + 1) (Decidable.byContradiction fun a => source._proof_3 ts k small a) hm
      let ⟨rest, right✝³⟩ := h✝³
      let ⟨tr, right✝⁴⟩ := right✝³
      let ⟨values, bounds⟩ := right✝⁴
      Exists.intro after
        ⟨of_eq_true
            (Eq.trans
              (congrFun'
                (congrArg Eq
                  (Eq.trans
                    (Eq.trans (congrFun' (congrArg Bind.bind call) fun after => run s ts after)
                      (bind_tc_ok middle (run s ts)))
                    rest))
                (ok after))
              (eq_self (ok after))),
          ⟨Trace.cons (Exists.intro products (Exists.intro events ⟨call, ⟨cut, productsLaw⟩⟩)) tr,
            ⟨fun i =>
              Eq.mpr (id (congrArg (fun _a => _a = ↑(before i) + dot s (t :: ts) i) (values i)))
                (Eq.mpr
                  (id
                    (congrArg (fun _a => _a + dot s ts i = ↑(before i) + dot s (t :: ts) i) (cut.right.right.right i)))
                  (Eq.mpr
                    (id
                      (congrArg (fun _a => ↑(before i) + _a + dot s ts i = ↑(before i) + dot s (t :: ts) i)
                        (productsLaw i).right.left))
                    (id (Decidable.byContradiction fun a => source._proof_6 s t ts before k i a)))),
              fun i =>
              have h := bounds i;
              id
                (Eq.mp
                  (congrArg (LE.le ↑(after i))
                    (congrFun'
                      (congrArg HMul.hMul
                        (Eq.trans (Nat.add_assoc k 1 ts.length)
                          (congrArg (HAdd.hAdd k) ((fun m => Nat.add_comm 1 m) ts.length))))
                      B))
                  h)⟩⟩⟩)
    xs before k small hb
