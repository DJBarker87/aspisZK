theorem AspisR1.NJL_OccupancyPacket.source : ∀ (input output : NQ) (expected : U32) (opened : Std.Array NQ 16#usize),
  Canon input →
    Canon output →
      ↑expected < FIw_ScalarArithmetic.P →
        FIw_ArrayValue.canonical opened →
          ∃ p, reference input output expected opened = ok (pack p.last) ∧ FIw_ArrayValue.canonical (pack p.last) :=
fun input output expected opened hi ho he ha =>
  have hc := fun i => ha (cell opened i) (List.getElem_mem (NJB_Absorption.cell._proof_2 opened i));
  let ⟨c, h✝⟩ := NJL_OccupancyContext.source input output (cell opened 0) hi ho (hc 0)
  let ⟨cc, right✝⟩ := h✝
  let ⟨cd, right✝¹⟩ := right✝
  let ⟨clauses, right✝²⟩ := right✝¹
  let ⟨cut, right✝³⟩ := right✝²
  let ⟨one, right✝⁴⟩ := right✝³
  let ⟨both, right✝⁵⟩ := right✝⁴
  let ⟨selected, empty⟩ := right✝⁵
  let ⟨rh, h✝¹⟩ := NJL_OccupancyHead.source c (cell opened 0) (cell opened 1) (cell opened 9) cd (hc 0) (hc 1) (hc 9)
  let ⟨head, h✝²⟩ := h✝¹
  let ⟨eh, h✝³⟩ := h✝²
  let ⟨ch, right✝⁶⟩ := h✝³
  let ⟨hclauses, right✝⁷⟩ := right✝⁶
  let ⟨hcut, right✝⁸⟩ := right✝⁷
  let ⟨hh, vh⟩ := right✝⁸
  let ⟨middle, h✝⁴⟩ := NJL_OccupancyFrame.source c (cell opened) head cd hc hh
  let ⟨cm, right✝⁹⟩ := h✝⁴
  let ⟨trace, right✝¹⁰⟩ := right✝⁹
  let ⟨hm, vm⟩ := right✝¹⁰
  let ⟨rt, h✝⁵⟩ :=
    NJL_OccupancyTail.source middle input output (cell opened 0) (cell opened 10) c.oneMinus expected hm hi ho (hc 0)
      (hc 10) cd.left he
  let ⟨last, h✝⁶⟩ := h✝⁵
  let ⟨et, h✝⁷⟩ := h✝⁶
  let ⟨ct, right✝¹¹⟩ := h✝⁷
  let ⟨tclauses, right✝¹²⟩ := right✝¹¹
  let ⟨tcut, right✝¹³⟩ := right✝¹²
  let ⟨hl, vl⟩ := right✝¹³
  let p :=
    { context := c, head := head, middle := middle, last := last, context_call := cc, context_domain := cd,
      context_clauses := clauses, context_cut := cut, one_value := one, both_value := both, selected_value := selected,
      empty_value := empty, head_call := ch, head_cut := Exists.intro rh (Exists.intro eh ⟨hclauses, hcut⟩),
      head_value := vh, middle_call := cm, middle_trace := trace, middle_value := vm, last_call := ct,
      last_cut := Exists.intro rt (Exists.intro et ⟨tclauses, tcut⟩), last_canonical := hl, last_value := vl };
  Exists.intro p
    ⟨Eq.mpr
        (id
          (congrFun'
            (congrArg Eq
              (Eq.trans
                (Eq.trans
                  (congrFun' (congrArg Bind.bind cc) fun c => do
                    let head ← NJL_OccupancyHead.reference c (cell opened 0) (cell opened 1) (cell opened 9)
                    let middle ← NJL_OccupancyLanes.run c (cell opened) NJL_OccupancyFrame.indices head
                    let last ←
                      NJL_OccupancyTail.reference middle input output (cell opened 0) (cell opened 10) c.oneMinus
                          expected
                    ok (pack last))
                  (bind_tc_ok c fun y => do
                    let head ← NJL_OccupancyHead.reference y (cell opened 0) (cell opened 1) (cell opened 9)
                    let middle ← NJL_OccupancyLanes.run y (cell opened) NJL_OccupancyFrame.indices head
                    let last ←
                      NJL_OccupancyTail.reference middle input output (cell opened 0) (cell opened 10) y.oneMinus
                          expected
                    ok (pack last)))
                (Eq.trans
                  (Eq.trans
                    (congrFun' (congrArg Bind.bind ch) fun head => do
                      let middle ← NJL_OccupancyLanes.run c (cell opened) NJL_OccupancyFrame.indices head
                      let last ←
                        NJL_OccupancyTail.reference middle input output (cell opened 0) (cell opened 10) c.oneMinus
                            expected
                      ok (pack last))
                    (bind_tc_ok head fun y => do
                      let middle ← NJL_OccupancyLanes.run c (cell opened) NJL_OccupancyFrame.indices y
                      let last ←
                        NJL_OccupancyTail.reference middle input output (cell opened 0) (cell opened 10) c.oneMinus
                            expected
                      ok (pack last)))
                  (Eq.trans
                    (Eq.trans
                      (congrFun' (congrArg Bind.bind cm) fun middle => do
                        let last ←
                          NJL_OccupancyTail.reference middle input output (cell opened 0) (cell opened 10) c.oneMinus
                              expected
                        ok (pack last))
                      (bind_tc_ok middle fun y => do
                        let last ←
                          NJL_OccupancyTail.reference y input output (cell opened 0) (cell opened 10) c.oneMinus
                              expected
                        ok (pack last)))
                    (Eq.trans (congrFun' (congrArg Bind.bind ct) fun last => ok (pack last))
                      (bind_tc_ok last fun y => ok (pack y)))))))
            (ok (pack p.last))))
        (Eq.refl (ok (pack last))),
      NJB_ArrayCarrier.canonical_array (fun i => p.last (Fin.cast size12 i)) fun i => hl (Fin.cast size12 i)⟩
