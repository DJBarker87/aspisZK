theorem AspisR1.NJL_TagReduction.step_source : ∀ (raw : NJL_TagRawStep.State) (limb : Fin 4) (before : State),
  (∀ (i : Fin 4), ↑(before i) < P) →
    ∃ after,
      step raw limb before = ok after ∧
        Step raw limb before after ∧
          (∀ (i : Fin 4), ↑(after i) < P) ∧
            ∀ (i : Fin 4), ↑(after i) = if i = limb then (↑(before i) + ↑(raw i) % P) % P else ↑(before i) :=
fun raw limb before hb =>
  let ⟨residue, h✝⟩ := NJB_TagReduce.reduce (raw limb)
  let ⟨cr, right✝⟩ := h✝
  let ⟨vr, hr⟩ := right✝
  let ⟨reply, h✝¹⟩ := NJB_TagReduce.add (before limb) residue (hb limb) hr
  let ⟨ca, right✝¹⟩ := h✝¹
  let ⟨va, ha⟩ := right✝¹
  let after := put before limb reply;
  Exists.intro after
    ⟨Eq.mpr
        (id
          (congrFun'
            (congrArg Eq
              (Eq.trans
                (congrFun'
                  (congrArg Bind.bind
                    (Eq.trans
                      (Eq.trans
                        (congrFun' (congrArg Bind.bind cr) fun residue =>
                          FIq_Native.field.M31.add (before limb) residue)
                        (bind_tc_ok residue (FIq_Native.field.M31.add (before limb))))
                      ca))
                  fun reply => ok (put before limb reply))
                (bind_tc_ok reply fun y => ok (put before limb y))))
            (ok after)))
        (Eq.refl (ok (put before limb reply))),
      ⟨Exists.intro residue (Exists.intro reply ⟨cr, ⟨ca, ⟨rfl, ⟨rfl, ⟨rfl, ⟨rfl, ⟨rfl, ⟨rfl, rfl⟩⟩⟩⟩⟩⟩⟩⟩),
        ⟨fun i =>
          id
            (Decidable.casesOn (instDecidableEqFin 4 i limb)
              (fun h => Eq.mpr (id (congrFun' (congrArg LT.lt (congrArg UScalar.val (if_neg h))) P)) (hb i)) fun h =>
              Eq.mpr (id (congrFun' (congrArg LT.lt (congrArg UScalar.val (if_pos h))) P)) ha),
          fun i =>
          if h : i = limb then
            Eq.symm h ▸
              of_eq_true
                (Eq.trans
                  (congr
                    (congrArg Eq
                      (Eq.trans
                        (Eq.trans
                          (congrArg UScalar.val
                            (Eq.trans (put.eq_1 before limb reply limb)
                              (ite_cond_eq_true reply (before limb) (eq_self limb))))
                          va)
                        (Eq.trans (congrFun' (congrArg HMod.hMod (congrArg (HAdd.hAdd ↑(before limb)) vr)) P)
                          (Nat.add_mod_mod (↑(before limb)) (↑(raw limb)) P))))
                    (Eq.trans
                      (ite_cond_eq_true ((↑(before limb) + ↑(raw limb) % P) % P) (↑(before limb)) (eq_self limb))
                      (Nat.add_mod_mod (↑(before limb)) (↑(raw limb)) P)))
                  (eq_self ((↑(before limb) + ↑(raw limb)) % P)))
          else
            of_eq_true
              (Eq.trans
                (congr
                  (congrArg Eq
                    (congrArg UScalar.val
                      (Eq.trans (put.eq_1 before limb reply i) (ite_cond_eq_false reply (before i) (eq_false h)))))
                  (ite_cond_eq_false ((↑(before i) + ↑(raw i) % P) % P) (↑(before i)) (eq_false h)))
                (eq_self ↑(before i)))⟩⟩⟩
