                  decode c.oneMinus = 1 - decode occupied ∧
                    decode c.both = decode input + decode output ∧
                      decode c.selected = (decode input + decode output) * decode occupied ∧
                        decode c.emptyValue = (decode input + decode output) * (1 - decode occupied) :=
