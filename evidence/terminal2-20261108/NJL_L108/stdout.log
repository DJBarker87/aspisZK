theorem AspisR1.NJL_CachedPowers.source : ∀ (lambda : NQ), Canon lambda → Nonempty (Packet lambda) :=
fun lambda hl =>
  let ⟨powers, h✝⟩ := NJL_WindowPowers.source lambda lambda 8 hl hl
  let ⟨next, h✝¹⟩ := h✝
  let ⟨call, right✝⟩ := h✝¹
  let ⟨trace, right✝¹⟩ := right✝
  let ⟨length, right✝²⟩ := right✝¹
  let ⟨canonical, right✝³⟩ := right✝²
  let ⟨left✝, right✝⁴⟩ := right✝³
  let ⟨values, right✝⁵⟩ := right✝⁴
  let ⟨caches, h✝²⟩ := NJL_WindowCache.source powers canonical
  let ⟨cacheCall, domains⟩ := h✝²
  Nonempty.intro
    { powers := powers, next := next, eight := length, power_call := call, power_trace := trace, canonical := canonical,
      values := values, caches := caches, cache_call := cacheCall, domains := domains }
'AspisR1.NJL_CachedPowers.source' depends on axioms: [propext, Classical.choice, Quot.sound]
