AspisR1.NJL_WindowPowers.source (lambda power : AspisR1.FIv_NativeArithmetic.NQ) (n : ℕ)
  (hl : AspisR1.FIv_NativeValue.Canon lambda) (hp : AspisR1.FIv_NativeValue.Canon power) :
  ∃ values next,
    AspisR1.NJL_WindowPowers.run lambda n power = Aeneas.Std.Result.ok (values, next) ∧
