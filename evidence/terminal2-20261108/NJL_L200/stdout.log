AspisR1.NJL_WindowStep.source (theta before : AspisR1.FIv_NativeArithmetic.NQ) (cache : AspisR1.FIv_PreparedNew.NP)
  (o : Aeneas.Std.Array AspisR1.FIv_NativeArithmetic.NQ 16#usize) (start : Fin 9) (slot : Fin 8)
  (ht : AspisR1.FIv_NativeValue.Canon theta) (hb : AspisR1.FIv_NativeValue.Canon before)
  (ho : AspisR1.FIw_ArrayValue.canonical o) (domain : AspisR1.NJB_PreparedLaws.Domain cache theta) :
  ∃ product reply,
    FIq_Native.field.PreparedQm31Multiplier.mul cache (AspisR1.NJL_WindowStep.opened o start slot) =
        Aeneas.Std.Result.ok product ∧
      FIq_Native.field.QM31.add before product = Aeneas.Std.Result.ok reply ∧
        AspisR1.NJL_WindowStep.reference cache o start slot before = Aeneas.Std.Result.ok reply ∧
          AspisR1.NJL_WindowStep.Cut cache o start slot before product reply reply
              (AspisR1.NJB_PreparedCarrier.words cache) (AspisR1.NJL_WindowStep.opened o start slot)
              { operation := 1, left := before, right := product } 2 (↑slot + 1) ∧
            AspisR1.FIv_NativeValue.Canon reply ∧
              AspisR1.FIv_NativeValue.decode reply =
                AspisR1.FIv_NativeValue.decode before +
                  AspisR1.FIv_NativeValue.decode theta *
                    AspisR1.FIv_NativeValue.decode (AspisR1.NJL_WindowStep.opened o start slot)
