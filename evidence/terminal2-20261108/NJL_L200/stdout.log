  (start : Fin 9) (slots : List (Fin 8)) (before : AspisR1.FIv_NativeArithmetic.NQ)
  (ht : ∀ (i : Fin 8), AspisR1.FIv_NativeValue.Canon (theta i)) (hb : AspisR1.FIv_NativeValue.Canon before)
  (ho : AspisR1.FIw_ArrayValue.canonical o)
  (domains : ∀ (i : Fin 8), AspisR1.NJB_PreparedLaws.Domain (cache i) (theta i)) :
  ∃ after,
    AspisR1.NJL_WindowFold.run cache o start slots before = Aeneas.Std.Result.ok after ∧
      AspisR1.NJL_WindowFold.Trace cache o start slots before after ∧
        AspisR1.FIv_NativeValue.Canon after ∧
          AspisR1.FIv_NativeValue.decode after =
            AspisR1.FIv_NativeValue.decode before +
              (List.map
                  (fun i =>
                    AspisR1.FIv_NativeValue.decode (theta i) *
                      AspisR1.FIv_NativeValue.decode (AspisR1.NJL_WindowStep.opened o start i))
                  slots).sum
