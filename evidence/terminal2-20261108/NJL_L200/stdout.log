AspisR1.NJL_WindowPowerArray.source (lambda : AspisR1.FIv_NativeArithmetic.NQ)
  (hl : AspisR1.FIv_NativeValue.Canon lambda) :
  ∃ p,
    AspisR1.NJL_WindowPowerFrame.run lambda (List.finRange 8) (fun x => FIq_Native.field.QM31.ZERO) lambda =
        Aeneas.Std.Result.ok (AspisR1.NJL_CacheReads.power p, p.next) ∧
      AspisR1.NJL_WindowPowerFrame.Trace lambda (List.finRange 8) (fun x => FIq_Native.field.QM31.ZERO) lambda
        (AspisR1.NJL_CacheReads.power p) p.next
