AspisR1.NJL_WriteFrame.fold {I V : Type} [DecidableEq I] (values : I → V) (xs : List I) (s : I → V) (j : I) :
  List.foldl (fun before i => AspisR1.NJL_WriteFrame.write before i (values i)) s xs j =
    if j ∈ xs then values j else s j
