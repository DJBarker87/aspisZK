        reference selector bit = ok c ∧
          Domain c ∧
            Clauses selector bit residual c ∧
              Cut selector bit residual c events c.left c.right (initial c) 6 2 ∧
                (∀ (i : Fin 17), Canon (initial c i)) ∧
