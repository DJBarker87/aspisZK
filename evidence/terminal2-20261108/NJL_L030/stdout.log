theorem AspisR1.NJL_PathAssociation.source : ∀ (selector : NQ) (o : Openings),
  Canon selector →
    FIw_ArrayValue.canonical o.z →
      FIw_ArrayValue.canonical o.succ_z →
        ∃ p,
          NJL_PathPacket.reference selector o = ok (pack p.after) ∧
            FIq_Native.pool_v1.pair_forest_semantic_terminal.path_lanes_literal selector o = ok (pack p.after) ∧
              FIw_ArrayValue.canonical (pack p.after) :=
fun selector o hs hz hb =>
  let ⟨p, h✝⟩ := NJL_PathPacket.source selector o hs hz hb
  let ⟨call, canonical⟩ := h✝
  let ⟨old, h✝¹⟩ := WP.spec_imp_exists (JFy_PathLiteral.source selector o hs hz hb)
  let ⟨oldCall, oldCanonical⟩ := h✝¹
  have oldValue := FIx_PathMeaning.value selector o old hs hz hb oldCall;
  have same :=
    NJL_ArrayCodec.ext (pack p.after) old canonical oldCanonical
      (Eq.trans (value selector o p) (Eq.symm oldValue.right));
  Exists.intro p
    ⟨call,
      ⟨Eq.mpr
          (id
            (congrArg (fun _a => FIq_Native.pool_v1.pair_forest_semantic_terminal.path_lanes_literal selector o = ok _a)
              same))
          oldCall,
        canonical⟩⟩
