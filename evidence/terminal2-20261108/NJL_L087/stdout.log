theorem AspisR1.NJL_TagChunks.source : ∀ (s : Selectors) (chunks : List (List (Fin 272))) (before : State),
  (∀ terms ∈ chunks, terms.length ≤ 4) →
    FIw_ArrayValue.canonical s.high →
      (∀ (i : Fin 4), ↑(before i) < P) →
        ∃ after,
          run s chunks before = ok after ∧
            Trace s chunks before after ∧
              (∀ (i : Fin 4), ↑(after i) < P) ∧
                ∀ (i : Fin 4), ↑(after i) = (↑(before i) + dot s chunks.flatten i) % P :=
fun s chunks before small hs hb =>
  List.rec (motive := fun chunks =>
    ∀ (before : State),
      (∀ terms ∈ chunks, terms.length ≤ 4) →
        (∀ (i : Fin 4), ↑(before i) < P) →
          ∃ after,
            run s chunks before = ok after ∧
              Trace s chunks before after ∧
                (∀ (i : Fin 4), ↑(after i) < P) ∧
                  ∀ (i : Fin 4), ↑(after i) = (↑(before i) + dot s chunks.flatten i) % P)
    (fun before small hb =>
      Exists.intro before
        ⟨rfl,
          ⟨Trace.nil before,
            ⟨hb, fun i =>
              of_eq_true (Eq.trans (congrArg (Eq ↑(before i)) (Nat.mod_eq_of_lt (hb i))) (eq_self ↑(before i)))⟩⟩⟩)
    (fun chunk rest ih before small hb =>
      let ⟨middle, h✝⟩ :=
        NJL_TagChunk.source s chunk before
          (small chunk
            (of_eq_true
              (Eq.trans List.mem_cons._simp_1
                (Eq.trans (congrFun' (congrArg Or (eq_self chunk)) (chunk ∈ rest)) (true_or (chunk ∈ rest))))))
          hs hb
      let ⟨cc, right✝⟩ := h✝
      let ⟨tc, right✝¹⟩ := right✝
      let ⟨hc, vc⟩ := right✝¹
      let ⟨after, h✝¹⟩ :=
        ih middle
          (fun xs hx =>
            small xs
              (of_eq_true
                (Eq.trans List.mem_cons._simp_1
                  (Eq.trans (congrArg (Or (xs = chunk)) (eq_true hx)) (or_true (xs = chunk))))))
          hc
      let ⟨ca, right✝²⟩ := h✝¹
      let ⟨ta, right✝³⟩ := right✝²
      let ⟨ha, va⟩ := right✝³
      Exists.intro after
        ⟨of_eq_true
            (Eq.trans
              (congrFun'
                (congrArg Eq
                  (Eq.trans
                    (Eq.trans (congrFun' (congrArg Bind.bind cc) fun middle => run s rest middle)
                      (bind_tc_ok middle (run s rest)))
                    ca))
                (ok after))
              (eq_self (ok after))),
          ⟨Trace.cons tc ta,
            ⟨ha, fun i =>
              Eq.mpr (id (congrArg (fun _a => _a = (↑(before i) + dot s (chunk :: rest).flatten i) % P) (va i)))
                (Eq.mpr
                  (id
                    (congrArg
                      (fun _a => (_a + dot s rest.flatten i) % P = (↑(before i) + dot s (chunk :: rest).flatten i) % P)
                      (vc i)))
                  (Eq.mpr
                    (id
                      (congrArg
                        (fun _a =>
                          ((↑(before i) + dot s chunk i) % P + dot s rest.flatten i) % P =
                            (↑(before i) + dot s _a i) % P)
                        List.flatten_cons))
                    (Eq.mpr
                      (id
                        (congrArg
                          (fun _a =>
                            ((↑(before i) + dot s chunk i) % P + dot s rest.flatten i) % P = (↑(before i) + _a) % P)
                          (dot_append s chunk rest.flatten i)))
                      (of_eq_true
                        (Eq.trans
                          (congrFun'
                            (congrArg Eq
                              (Eq.trans (Nat.mod_add_mod (↑(before i) + dot s chunk i) P (dot s rest.flatten i))
                                (congrFun'
                                  (congrArg HMod.hMod
                                    (Nat.add_assoc (↑(before i)) (dot s chunk i) (dot s rest.flatten i)))
                                  P)))
                            ((↑(before i) + (dot s chunk i + dot s rest.flatten i)) % P))
                          (eq_self ((↑(before i) + (dot s chunk i + dot s rest.flatten i)) % P)))))))⟩⟩⟩)
    chunks before small hb
