theorem AspisR1.NJL_OccupancyAssociation.source : ∀ (input output : NQ) (expected : U32)
  (opened : Std.Array NQ 16#usize),
  Canon input →
    Canon output →
      ↑expected < FIw_ScalarArithmetic.P →
        FIw_ArrayValue.canonical opened →
          ∃ p,
            NJL_OccupancyPacket.reference input output expected opened = ok (pack p.last) ∧
              FIq_Native.pool_v1.pair_forest_semantic_terminal.occupancy_lanes_literal input output expected opened =
                  ok (pack p.last) ∧
                FIw_ArrayValue.canonical (pack p.last) :=
fun input output expected opened hi ho he ha =>
  let ⟨p, h✝⟩ := NJL_OccupancyPacket.source input output expected opened hi ho he ha
  let ⟨call, canonical⟩ := h✝
  let ⟨old, h✝¹⟩ := WP.spec_imp_exists (JFy_OccupancyLiteral.source input output expected opened hi ho he ha)
  let ⟨oldCall, oldCanonical⟩ := h✝¹
  have oldValue := FIy_OccupancyMeaning.value input output expected opened old hi ho he ha oldCall;
  have same :=
    NJL_ArrayCodec.ext (pack p.last) old canonical oldCanonical
      (Eq.trans (value input output expected opened p) (Eq.symm oldValue.right));
  Exists.intro p
    ⟨call,
      ⟨Eq.mpr
          (id
            (congrArg
              (fun _a =>
                FIq_Native.pool_v1.pair_forest_semantic_terminal.occupancy_lanes_literal input output expected opened =
                  ok _a)
              same))
          oldCall,
        canonical⟩⟩
