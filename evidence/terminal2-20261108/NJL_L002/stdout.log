theorem AspisR1.NJL_LowDischarge.source : ∀ (high : Fin 7 → NQ) (low : Fin 16 → NQ) (sum : NQ) (c : Fin 7),
  (∀ (i : Fin 7), Canon (high i)) →
    (∀ (i : Fin 16), Canon (low i)) →
      Canon sum →
        ∃ r,
          (∀ (j : Fin 17), Canon (r j)) ∧
            Clauses high low sum r c ∧
              ∀ (events : Fin (NJB_Cuts.lowCount c + 1) → NJB_Cuts.Event) (calls next : ℕ) (out : NQ),
                NJB_Cuts.low high low sum r c events calls next out → NJB_ActiveRawLow.step high low sum c = ok out :=
sorry
'AspisR1.NJL_LowDischarge.source' depends on axioms: [propext, sorryAx, Classical.choice, Quot.sound]
