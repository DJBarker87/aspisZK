theorem AspisR1.NJL_TagMeaning.value : ∀ (s : Selectors) (xs : List (Fin 272)),
  (encode fun i => ↑(dot s xs i)) = model s xs :=
fun s xs =>
  List.rec encode_zero
    (fun t ts ih =>
      have same :=
        funext fun i =>
          of_eq_true
            (Eq.trans
              (congrFun'
                (congrArg Eq
                  (Nat.cast_add (↑(NJL_TagWords.highWord s t i) * ↑(NJL_TagWords.tagWord t))
                    (List.map (fun t => ↑(NJL_TagWords.highWord s t i) * ↑(NJL_TagWords.tagWord t)) ts).sum))
                (↑(↑(NJL_TagWords.highWord s t i) * ↑(NJL_TagWords.tagWord t)) +
                  ↑(List.map (fun t => ↑(NJL_TagWords.highWord s t i) * ↑(NJL_TagWords.tagWord t)) ts).sum))
              (eq_self
                (↑(↑(NJL_TagWords.highWord s t i) * ↑(NJL_TagWords.tagWord t)) +
                  ↑(List.map (fun t => ↑(NJL_TagWords.highWord s t i) * ↑(NJL_TagWords.tagWord t)) ts).sum)));
      Eq.mpr (id (congrArg (fun _a => encode _a = model s (t :: ts)) same))
        (Eq.mpr
          (id
            (congrArg (fun _a => _a = model s (t :: ts))
              (encode_add (fun i => ↑(↑(NJL_TagWords.highWord s t i) * ↑(NJL_TagWords.tagWord t))) fun i =>
                ↑(dot s ts i))))
          (Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  (encode fun i => ↑(↑(NJL_TagWords.highWord s t i) * ↑(NJL_TagWords.tagWord t))) + _a =
                    model s (t :: ts))
                ih))
            (have castProduct :=
              Eq.mpr
                (id
                  (congrFun'
                    (congrArg Eq
                      (congrArg encode
                        (funext fun i =>
                          congrArg Nat.cast
                            (congr
                              (congrArg HMul.hMul
                                (NJL_TagWords.cast64
                                  (NJB_Words.word (NJB_ActiveReference.high s (NJL_TagData.block t)) i)))
                              (NJL_TagWords.cast64 (NJL_TagData.tag t))))))
                    (decode (NJB_ActiveReference.high s (NJL_TagData.block t)) * ↑↑(NJL_TagData.tag t))))
                (scalar (NJB_ActiveReference.high s (NJL_TagData.block t)) ↑(NJL_TagData.tag t));
            Eq.mpr (id (congrArg (fun _a => _a + model s ts = model s (t :: ts)) castProduct))
              (Eq.refl
                (decode (NJB_ActiveReference.high s (NJL_TagData.block t)) * ↑↑(NJL_TagData.tag t) + model s ts))))))
    xs
