theorem AspisR1.NJL_CachedWindow.source : ∀ (lambda : NQ) (o : Std.Array NQ 16#usize),
  Canon lambda →
    FIw_ArrayValue.canonical o →
      ∃ p,
        ∀ (start : Fin 9),
          ∃ after,
            NJL_WindowFold.run (NJL_CacheReads.cache p) o start (List.finRange 8) FIq_Native.field.QM31.ZERO =
                ok after ∧
              NJL_WindowFold.Trace (NJL_CacheReads.cache p) o start (List.finRange 8) FIq_Native.field.QM31.ZERO after ∧
                Canon after ∧
                  decode after =
                    (List.ofFn fun i => decode lambda ^ (↑i + 1) * decode (NJL_WindowStep.opened o start i)).sum :=
fun lambda o hl ho =>
  let ⟨p⟩ := NJL_CachedPowers.source lambda hl
  Exists.intro p fun start =>
    let ⟨after, h✝⟩ :=
      NJL_WindowFold.source (NJL_CacheReads.power p) (NJL_CacheReads.cache p) o start (List.finRange 8)
        FIq_Native.field.QM31.ZERO (NJL_CacheReads.canonical p) FIv_NativeValue.zero.left ho fun i =>
        (NJL_CacheReads.constructor p i).right
    let ⟨call, right✝⟩ := h✝
    let ⟨trace, right✝¹⟩ := right✝
    let ⟨ha, value⟩ := right✝¹
    Exists.intro after
      ⟨call,
        ⟨trace,
          ⟨ha,
            Eq.mpr
              (id
                (congrArg
                  (fun _a =>
                    _a = (List.ofFn fun i => decode lambda ^ (↑i + 1) * decode (NJL_WindowStep.opened o start i)).sum)
                  value))
              (Eq.mpr
                (id
                  (congrArg
                    (fun _a =>
                      _a +
                          (List.map
                              (fun i => decode (NJL_CacheReads.power p i) * decode (NJL_WindowStep.opened o start i))
                              (List.finRange 8)).sum =
                        (List.ofFn fun i => decode lambda ^ (↑i + 1) * decode (NJL_WindowStep.opened o start i)).sum)
                    FIv_NativeValue.zero.right))
                (Eq.mpr
                  (id
                    (congrArg
                      (fun _a =>
                        _a =
                          (List.ofFn fun i => decode lambda ^ (↑i + 1) * decode (NJL_WindowStep.opened o start i)).sum)
                      (zero_add
                        (List.map
                            (fun i => decode (NJL_CacheReads.power p i) * decode (NJL_WindowStep.opened o start i))
                            (List.finRange 8)).sum)))
                  ((fun {α} [Add α] [Zero α] a a_1 e_a => e_a ▸ Eq.refl a.sum)
                    (List.map (fun i => decode (NJL_CacheReads.power p i) * decode (NJL_WindowStep.opened o start i))
                      (List.finRange 8))
                    (List.ofFn fun i => decode lambda ^ (↑i + 1) * decode (NJL_WindowStep.opened o start i))
                    (id
                      ((fun {α} {n} f f_1 e_f => e_f ▸ Eq.refl (List.ofFn f))
                        (fun i => decode (NJL_CacheReads.power p i) * decode (NJL_WindowStep.opened o start i))
                        (fun i => decode lambda ^ (↑i + 1) * decode (NJL_WindowStep.opened o start i))
                        (funext fun i =>
                          Eq.mpr
                            (id
                              (congrArg
                                (fun _a =>
                                  _a * decode (NJL_WindowStep.opened o start i) =
                                    decode lambda ^ (↑i + 1) * decode (NJL_WindowStep.opened o start i))
                                (NJL_CacheReads.value p i)))
                            (Eq.refl (decode lambda ^ (↑i + 1) * decode (NJL_WindowStep.opened o start i)))))))))⟩⟩⟩
