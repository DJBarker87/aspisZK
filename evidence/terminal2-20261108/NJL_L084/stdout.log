theorem AspisR1.NJL_TagChunk.source : ∀ (s : Selectors) (terms : List (Fin 272)) (before : State),
  terms.length ≤ 4 →
    FIw_ArrayValue.canonical s.high →
      (∀ (i : Fin 4), ↑(before i) < P) →
        ∃ after,
          reference s terms before = ok after ∧
            Invocation s terms before after ∧
              (∀ (i : Fin 4), ↑(after i) < P) ∧ ∀ (i : Fin 4), ↑(after i) = (↑(before i) + dot s terms i) % P :=
fun s terms before small hs hb =>
  have hz := fun x => rfl;
  let ⟨raw, h✝⟩ :=
    NJL_TagRawTrace.source s terms zero 0 (Decidable.byContradiction fun a => source._proof_1 terms small a) hs fun i =>
      Eq.mpr (id (congrArg (fun _a => _a ≤ 0 * NJB_TagRaw.B) (hz i)))
        (Decidable.byContradiction fun a => source._proof_2 terms a)
  let ⟨cr, right✝⟩ := h✝
  let ⟨tr, right✝¹⟩ := right✝
  let ⟨vr, right✝²⟩ := right✝¹
  let ⟨after, h✝¹⟩ := NJL_TagReduction.source raw before hb
  let ⟨ca, right✝³⟩ := h✝¹
  let ⟨ta, right✝⁴⟩ := right✝³
  let ⟨ha, va⟩ := right✝⁴
  Exists.intro after
    ⟨of_eq_true
        (Eq.trans
          (congrFun'
            (congrArg Eq
              (Eq.trans
                (Eq.trans (congrFun' (congrArg Bind.bind cr) fun raw => NJL_TagReduction.run raw [0, 1, 2, 3] before)
                  (bind_tc_ok raw fun y => NJL_TagReduction.run y [0, 1, 2, 3] before))
                ca))
            (ok after))
          (eq_self (ok after))),
      ⟨Exists.intro raw ⟨tr, ta⟩,
        ⟨ha, fun i =>
          have rawValue :=
            Eq.mp
              (congrArg (Eq ↑(raw i))
                (Eq.trans (congrFun' (congrArg HAdd.hAdd ((fun i => hz i) i)) (dot s terms i))
                  (Nat.zero_add (dot s terms i))))
              (vr i);
          Eq.mpr (id (congrArg (fun _a => _a = (↑(before i) + dot s terms i) % P) (va i)))
            (Eq.mpr (id (congrArg (fun _a => (↑(before i) + _a % P) % P = (↑(before i) + dot s terms i) % P) rawValue))
              (of_eq_true
                (Eq.trans
                  (congr
                    (congrArg Eq
                      (Eq.trans (Nat.add_mod (↑(before i)) (dot s terms i % P) P)
                        (Eq.trans
                          (Eq.trans
                            (congrFun'
                              (congrArg HMod.hMod
                                (congrArg (HAdd.hAdd (↑(before i) % P)) (Nat.mod_mod (dot s terms i) P)))
                              P)
                            (Nat.add_mod (↑(before i) % P) (dot s terms i % P) P))
                          (Eq.trans
                            (congrFun'
                              (congrArg HMod.hMod
                                (congr (congrArg HAdd.hAdd (Nat.mod_mod (↑(before i)) P))
                                  (Nat.mod_mod (dot s terms i) P)))
                              P)
                            (Nat.add_mod (↑(before i) % P) (dot s terms i % P) P)))))
                    (Eq.trans (Nat.add_mod (↑(before i)) (dot s terms i) P)
                      (Eq.trans (Nat.add_mod (↑(before i) % P) (dot s terms i % P) P)
                        (Eq.trans
                          (congrFun'
                            (congrArg HMod.hMod
                              (congr (congrArg HAdd.hAdd (Nat.mod_mod (↑(before i)) P))
                                (Nat.mod_mod (dot s terms i) P)))
                            P)
                          (Nat.add_mod (↑(before i) % P) (dot s terms i % P) P)))))
                  (eq_self ((↑(before i) % P % P + dot s terms i % P % P) % P)))))⟩⟩⟩
'AspisR1.NJL_TagChunk.source' depends on axioms: [propext, Classical.choice, Quot.sound]
