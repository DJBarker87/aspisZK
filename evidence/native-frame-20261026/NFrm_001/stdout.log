structure AspisR1.AdapterRw.RuntimeEntrypointAdmission {F : Type} (s : S2Trust.Heap F) (keys : ℕ → List UInt8)
  (accountCount : ℕ) : Prop
number of parameters: 4
fields:
  AspisR1.AdapterRw.RuntimeEntrypointAdmission.valid : S2Trust.Valid s
  AspisR1.AdapterRw.RuntimeEntrypointAdmission.freshGuards : s.guards = []
  AspisR1.AdapterRw.RuntimeEntrypointAdmission.noExternalBorrows : ∀ (c : ℕ), s.external c = 0
  AspisR1.AdapterRw.RuntimeEntrypointAdmission.liveAccount : ∀ a < accountCount, s.ownerLive a = true
  AspisR1.AdapterRw.RuntimeEntrypointAdmission.counterZero : ∀ a < accountCount, s.counter (s.accounts a).1 = 0
  AspisR1.AdapterRw.RuntimeEntrypointAdmission.sharedCellsOnlyEqualKeys : ∀ (a b : ℕ),
      a < accountCount → b < accountCount → (s.accounts a).1 = (s.accounts b).1 → keys a = keys b
  AspisR1.AdapterRw.RuntimeEntrypointAdmission.duplicateKeysShareCell : ∀ (a b : ℕ),
      a < accountCount → b < accountCount → keys a = keys b → (s.accounts a).1 = (s.accounts b).1
constructor:
  AspisR1.AdapterRw.RuntimeEntrypointAdmission.mk {F : Type} {s : S2Trust.Heap F} {keys : ℕ → List UInt8}
    {accountCount : ℕ} (valid : S2Trust.Valid s) (freshGuards : s.guards = [])
    (noExternalBorrows : ∀ (c : ℕ), s.external c = 0) (liveAccount : ∀ a < accountCount, s.ownerLive a = true)
    (counterZero : ∀ a < accountCount, s.counter (s.accounts a).1 = 0)
    (sharedCellsOnlyEqualKeys :
      ∀ (a b : ℕ), a < accountCount → b < accountCount → (s.accounts a).1 = (s.accounts b).1 → keys a = keys b)
    (duplicateKeysShareCell :
      ∀ (a b : ℕ), a < accountCount → b < accountCount → keys a = keys b → (s.accounts a).1 = (s.accounts b).1) :
    AdapterRw.RuntimeEntrypointAdmission s keys accountCount
