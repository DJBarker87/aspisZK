PV_L1F_Statements.combined {I A S P C : Type} (actualCount : I → List ℕ × List ℕ) (native : I → PV_RJ4IDB.NativeTrace A)
  (sourceWorld bodyWorld : I → PV_RJ4IDB.Trace A) (owner : I → R1Z.SideChannelL1AttemptRecord.Owner S P)
  (initial : I → S) (fuel index : I → ℕ) (adapt : I → R1Z.SideChannelL1AttemptRecord.Run P × S → PV_RJ4IDB.Trace A)
  (context : I → C) (calls : I → PV_DIAG9.DiagnosticCall)
  (acquisition : PV_L1E_CountSkeleton.PV_L1E_Link_CountAcquisition actualCount sourceWorld)
  (body : PV_L1E_CountSkeleton.PV_L1E_Link_BodyWrapper sourceWorld bodyWorld)
  (retry : PV_L1E_OriginalCountSkeleton.PV_L1E_Link_OriginalRetry bodyWorld owner initial fuel index adapt)
  (coupling : PV_L1E_OriginalCountSkeleton.PV_L1E_Link_NativeD163 native owner initial fuel index adapt)
  (sites : PV_DIAG10.PV_DIAG10_Link_Sites context calls) :
  PV_RJ4IDB.OpenInputs.L1_COUNT_TRACE actualCount native ∧
    PV_DIAG10.PV_DIAG10_Link_Sites context calls ∧
      ∀ (i : I), PV_RJ4IDB.nativeObservation (native i) = PV_RJ4IDB.decoder (PV_RJ4IDB.modelTrace (native i))
PV_L1F_ActualPublication.source_publication_read [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns]
  (out :
    Aeneas.Std.Result
      (Aeneas.Std.core.result.Result ProverRwFull.prover.RetriedProof ProverRwFull.verifier.Error ×
        R1Z.ProverRwRetryModel.Store))
  (prior : List PV_RJ4IDB.Event) :
  (PV_RJ4IDB.counts
        (prior ++
          PV_L1F_ReturnedPrefix.suffix
            (R1Z.ProverCommitSemanticTransport26.mapR R1Z.ProverRwRetryModel.sourceOutput out)),
      PV_RJ4IDB.rejections
        (prior ++
          PV_L1F_ReturnedPrefix.suffix
            (R1Z.ProverCommitSemanticTransport26.mapR R1Z.ProverRwRetryModel.sourceOutput out))) =
    (PV_RJ4IDB.counts prior ++ (PV_L1F_ReturnedCount.sourceRead out).toList, PV_RJ4IDB.rejections prior)
PV_L1F_LoggedCount.source_logged_count [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns] {C : Type}
  (entropy : R1Z.ProverRwRetryModel.Entropy C) (pub : R1Z.ProverRwRetryModel.Pub)
  (compiled : R1Z.ProverRwRetryModel.Compiled) (variant : ProverRwFull.transport.Variant)
  (hash : R1Z.ProverRwRetryModel.Hash) (store : R1Z.ProverRwRetryModel.Store) (callback : C) (k : Aeneas.Std.Usize)
  (n : ℕ) (bound : ↑k + n = 8) :
  PV_L1F_ReturnedCount.sourceRead
      (ProverRwFull.prover.retry_attempt entropy pub compiled variant hash store callback k) =
    PV_L1F_ReturnedCount.read
      (PV_L1D_RetryFold.run (PV_L1E_RetrySource.attempt entropy pub compiled variant hash) n ↑k
          (callback, store)).result
PV_L1F_LoggedCount.source_count_entries [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns] {C : Type}
  (entropy : R1Z.ProverRwRetryModel.Entropy C) (pub : R1Z.ProverRwRetryModel.Pub)
  (compiled : R1Z.ProverRwRetryModel.Compiled) (variant : ProverRwFull.transport.Variant)
  (hash : R1Z.ProverRwRetryModel.Hash) (store : R1Z.ProverRwRetryModel.Store) (callback : C) (k : Aeneas.Std.Usize)
  (n : ℕ) (bound : ↑k + n = 8) (p : R1Z.ProverCommitRetry34.Published R1Z.ProverRwRetryModel.Proof)
  (after : C × R1Z.ProverRwRetryModel.Store)
  (success :
    (PV_L1D_RetryFold.run (PV_L1E_RetrySource.attempt entropy pub compiled variant hash) n ↑k
          (callback, store)).result =
      Aeneas.Std.Result.ok (R1Z.ProverCommitRetry34.Step.done p, after)) :
  PV_L1F_ReturnedCount.sourceRead
      (ProverRwFull.prover.retry_attempt entropy pub compiled variant hash store callback k) =
    some
      (↑k +
        (PV_L1D_CallbackSafe.callbacks
            (PV_L1D_RetryFold.run (PV_L1E_RetrySource.attempt entropy pub compiled variant hash) n ↑k
                (callback, store)).events).length)
PV_L1F_ReachedJoin.reached_producer {S P : Type} (a : PV_L1D_RetryFold.Attempt S P)
  (owner : R1Z.SideChannelL1AttemptRecord.Owner S P) (start : ℕ) (initial : S)
  (link : PV_L1F_ReachedJoin.ReachedOwner a owner start initial) :
  PV_DIAG10.PV_DIAG10_Link_ReachedAttempt (fun j t => (a j t).result) start initial
PV_L1F_ReachedJoin.reached_join {S P : Type} (a : PV_L1D_RetryFold.Attempt S P)
  (owner : R1Z.SideChannelL1AttemptRecord.Owner S P) (start : ℕ) (initial : S)
  (link : PV_L1F_ReachedJoin.ReachedOwner a owner start initial) (n k : ℕ) (s : S)
  (reached : PV_DIAG10.RetryReach (fun j t => (a j t).result) start initial k s) :
  PV_L1D_RetryFold.run a n k s =
    { events := R1Z.SideChannelL1AttemptRecord.events (R1Z.SideChannelL1AttemptRecord.run owner n k s).1,
      result :=
        Aeneas.Std.Result.ok
          ((R1Z.SideChannelL1AttemptRecord.run owner n k s).1.result,
            (R1Z.SideChannelL1AttemptRecord.run owner n k s).2) }
PV_L1F_RetryBounds.read_bounds {S P : Type} (attempt : R1Z.ProverCommitRetry34.Attempt S P) (n k : ℕ) (s : S)
  (count : ℕ) (h : PV_L1F_ReturnedCount.read (R1Z.ProverCommitRetry34.run attempt n k s) = some count) :
  k < count ∧ count ≤ k + n
PV_L1F_ReturnedCount.finish_read {P S : Type} (capture : PV_DIAG2.Capture)
  (x : PV_DIAG2.Observed (R1Z.ProverCommitRetry34.Step (R1Z.ProverCommitRetry34.Published P) × S)) :
  PV_L1F_ReturnedCount.read (PV_DIAG2.finish capture x).result = PV_L1F_ReturnedCount.read x.result
PV_L1F_ReturnedCount.read_done {P S : Type} (p : R1Z.ProverCommitRetry34.Published P) (s : S) :
  PV_L1F_ReturnedCount.read (Aeneas.Std.Result.ok (R1Z.ProverCommitRetry34.Step.done p, s)) = some p.attempts
PV_L1F_ReturnedCount.read_map_state {P S T : Type} (project : S → T)
  (out : Aeneas.Std.Result (R1Z.ProverCommitRetry34.Step (R1Z.ProverCommitRetry34.Published P) × S)) :
  PV_L1F_ReturnedCount.read (R1Z.ProverCommitSemanticTransport26.mapR (fun v => (v.1, project v.2)) out) =
    PV_L1F_ReturnedCount.read out
PV_L1F_ReturnedCount.source_read [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns]
  (out :
    Aeneas.Std.Result
      (Aeneas.Std.core.result.Result ProverRwFull.prover.RetriedProof ProverRwFull.verifier.Error ×
        R1Z.ProverRwRetryModel.Store)) :
  PV_L1F_ReturnedCount.read (R1Z.ProverCommitSemanticTransport26.mapR R1Z.ProverRwRetryModel.sourceOutput out) =
    PV_L1F_ReturnedCount.sourceRead out
PV_L1F_ReturnedPrefix.counts_suffix {P S : Type}
  (out : Aeneas.Std.Result (R1Z.ProverCommitRetry34.Step (R1Z.ProverCommitRetry34.Published P) × S)) :
  PV_RJ4IDB.counts (PV_L1F_ReturnedPrefix.suffix out) = (PV_L1F_ReturnedCount.read out).toList
PV_L1F_ReturnedPrefix.rejects_suffix {P S : Type}
  (out : Aeneas.Std.Result (R1Z.ProverCommitRetry34.Step (R1Z.ProverCommitRetry34.Published P) × S)) :
  PV_RJ4IDB.rejections (PV_L1F_ReturnedPrefix.suffix out) = []
PV_L1F_ReturnedPrefix.ordered_acquisition {P S : Type} (prior : List PV_RJ4IDB.Event)
  (out : Aeneas.Std.Result (R1Z.ProverCommitRetry34.Step (R1Z.ProverCommitRetry34.Published P) × S)) :
  (PV_RJ4IDB.counts (prior ++ PV_L1F_ReturnedPrefix.suffix out),
      PV_RJ4IDB.rejections (prior ++ PV_L1F_ReturnedPrefix.suffix out)) =
    (PV_RJ4IDB.counts prior ++ (PV_L1F_ReturnedCount.read out).toList, PV_RJ4IDB.rejections prior)
PV_L1F_SourceBounds.actual_count_bounds [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns] {C : Type}
  (entropy : R1Z.ProverRwRetryModel.Entropy C) (pub : R1Z.ProverRwRetryModel.Pub)
  (compiled : R1Z.ProverRwRetryModel.Compiled) (variant : ProverRwFull.transport.Variant)
  (hash : R1Z.ProverRwRetryModel.Hash) (store : R1Z.ProverRwRetryModel.Store) (callback : C) (k : Aeneas.Std.Usize)
  (n : ℕ) (bound : ↑k + n = 8) (count : ℕ)
  (readout :
    PV_L1F_ReturnedCount.sourceRead
        (ProverRwFull.prover.retry_attempt entropy pub compiled variant hash store callback k) =
      some count) :
  1 ≤ count ∧ count ≤ 8
PV_L1F_SourceRead.actual_retry_count [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns] {C : Type}
  (entropy : R1Z.ProverRwRetryModel.Entropy C) (pub : R1Z.ProverRwRetryModel.Pub)
  (compiled : R1Z.ProverRwRetryModel.Compiled) (variant : ProverRwFull.transport.Variant)
  (hash : R1Z.ProverRwRetryModel.Hash) (store : R1Z.ProverRwRetryModel.Store) (callback : C) (k : Aeneas.Std.Usize)
  (n : ℕ) (bound : ↑k + n = 8) :
  PV_L1F_ReturnedCount.sourceRead
      (ProverRwFull.prover.retry_attempt entropy pub compiled variant hash store callback k) =
    PV_L1F_ReturnedCount.read
      (R1Z.ProverCommitRetry34.run (R1Z.ProverRwRetryModel.attempt entropy pub compiled variant hash) n ↑k
        (callback, store))
PV_L1F_SourceRead.reported_source_count [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns] {C : Type}
  (entropy : R1Z.ProverRwRetryModel.Entropy C) (pub : R1Z.ProverRwRetryModel.Pub)
  (compiled : R1Z.ProverRwRetryModel.Compiled) (variant : ProverRwFull.transport.Variant)
  (hash : R1Z.ProverRwRetryModel.Hash) (store : R1Z.ProverRwRetryModel.Store) (callback : C) (k : Aeneas.Std.Usize)
  (n : ℕ) (bound : ↑k + n = 8) (capture : PV_DIAG2.Capture)
  (a :
    ℕ →
      C × R1Z.ProverRwRetryModel.Store →
        PV_DIAG2.Observed
          (R1Z.ProverCommitRetry34.Step R1Z.ProverRwRetryModel.Proof × C × R1Z.ProverRwRetryModel.Store))
  (resultLaw :
    ∀ (i : ℕ) (s : C × R1Z.ProverRwRetryModel.Store),
      (a i s).result = R1Z.ProverRwRetryModel.attempt entropy pub compiled variant hash i s) :
  PV_L1F_ReturnedCount.read (PV_DIAG2.finish capture (PV_DIAG2.runEffects a n ↑k (callback, store))).result =
    PV_L1F_ReturnedCount.sourceRead
      (ProverRwFull.prover.retry_attempt entropy pub compiled variant hash store callback k)
PV_L1F_WorldFields.runtime_fields {Os Fs S X : Type} (w : R1Z.PV_W_Enriched.World Os Fs S X)
  (h : R1Z.PV_OWN_Heap.Heap) :
  (R1Z.PV_OWN_WorldAdapter.commit w h).process.allocator = w.process.allocator ∧
    (R1Z.PV_OWN_WorldAdapter.commit w h).process.volatileWrites = w.process.volatileWrites ∧
      (R1Z.PV_OWN_WorldAdapter.commit w h).process.atomicOrder = w.process.atomicOrder ∧
        (R1Z.PV_OWN_WorldAdapter.commit w h).process.fences = w.process.fences ∧
          (R1Z.PV_OWN_WorldAdapter.commit w h).process.currentThread = w.process.currentThread
PV_L1F_WorldFields.prefix_frame {Os Fs S X C : Type} (w : R1Z.PV_W_Enriched.World Os Fs S X) (h : R1Z.PV_OWN_Heap.Heap)
  (prior : List C) :
  ((R1Z.PV_OWN_WorldAdapter.commit w h).os, (R1Z.PV_OWN_WorldAdapter.commit w h).filesystem, prior) =
    (w.os, w.filesystem, prior)
PV_L1F_WorldLog.bind_log {W E A B : Type} (error : E → Aeneas.Std.Error)
  (m : R1Z.PV_W_Threading.M W PV_L1F_WorldLog.Event E A) (k : A → R1Z.PV_W_Threading.M W PV_L1F_WorldLog.Event E B)
  (w : W) :
  PV_L1F_WorldLog.log error (R1Z.PV_W_Threading.bind m k w) =
    PV_L1D_Logged.bind (PV_L1F_WorldLog.log error (m w)) fun a => PV_L1F_WorldLog.log error (k a (m w).world)
PV_L1F_WorldLog.fail_world {W E A B : Type} (m : R1Z.PV_W_Threading.M W PV_L1F_WorldLog.Event E A)
  (k : A → R1Z.PV_W_Threading.M W PV_L1F_WorldLog.Event E B) (w : W) (e : E)
  (h : (m w).outcome = R1Z.PV_W_Threading.Outcome.fail e) :
  (R1Z.PV_W_Threading.bind m k w).world = (m w).world ∧ (R1Z.PV_W_Threading.bind m k w).calls = (m w).calls
PV_L1F_WorldLog.div_world {W E A B : Type} (m : R1Z.PV_W_Threading.M W PV_L1F_WorldLog.Event E A)
  (k : A → R1Z.PV_W_Threading.M W PV_L1F_WorldLog.Event E B) (w : W)
  (h : (m w).outcome = R1Z.PV_W_Threading.Outcome.div) :
  (R1Z.PV_W_Threading.bind m k w).world = (m w).world ∧ (R1Z.PV_W_Threading.bind m k w).calls = (m w).calls
'PV_L1F_Statements.combined' depends on axioms: [propext]
