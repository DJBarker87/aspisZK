def BitVec.toLEBytes._unary : (w : ℕ) ×' BitVec w → List Byte :=
WellFounded.Nat.fix
  (fun x =>
    let ⟨w, b⟩ := x
    w)
  fun _x a =>
  let ⟨w, b, a✝⟩ := _x
  if h : w > 0 then BitVec.setWidth 8 b :: a✝ ⟨w - 8, BitVec.setWidth (w - 8) (b >>> 8)⟩ ⋯ else []
