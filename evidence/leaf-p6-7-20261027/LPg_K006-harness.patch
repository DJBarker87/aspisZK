+#[kani::proof_for_contract(Q::add)] #[kani::unwind(6)] fn LPg_qadd_contract(){let(a,b)=operands();a.add(b);}
+#[kani::proof_for_contract(Q::sub)] #[kani::unwind(6)] fn LPg_qsub_contract(){let(a,b)=operands();a.sub(b);}
+#[kani::proof_for_contract(Q::half)] #[kani::unwind(6)] fn LPg_qhalf_contract(){let(a,b)=operands();a.half();}
