+use super::*;
+fn view<const PART:usize>(){
+ let p:[u8;compact::PROOF_BYTES]=kani::any();let semantic:[u8;compact::LOGICAL_SEMANTIC]=kani::any();let y1:[u8;compact::LOGICAL_Y1]=kani::any();
+ let expected=E::from_le_bytes(&p[compact::OFF_INACTIVE..compact::OFF_ROUND0]);
+ let got=wide_view(&p,&semantic,&y1);
+ match (got,expected){
+  (Err(Error::Parse),None)=>{},
+  (Ok(v),Some(x))=>{
+   let a=v.inactive.to_limbs();let b=x.to_limbs();for j in 0..8{assert_eq!(a[j],b[j]);}
+   assert!(core::ptr::eq(v.semantic.as_ptr(),semantic.as_ptr()));assert_eq!(v.semantic.len(),semantic.len());
+   assert!(core::ptr::eq(v.y1.as_ptr(),y1.as_ptr()));assert_eq!(v.y1.len(),y1.len());
+   let (bytes,lo,hi)=match PART{
+    0=>(v.round0,compact::OFF_ROUND0,compact::OFF_FOLDED_ROOT),
+    1=>(v.folded_root.unwrap().as_slice(),compact::OFF_FOLDED_ROOT,compact::OFF_ROUND1),
+    2=>(v.round1,compact::OFF_ROUND1,compact::OFF_FINAL),
+    _=>(v.final_message,compact::OFF_FINAL,compact::OFF_OPENINGS)};
+   assert!(core::ptr::eq(bytes.as_ptr(),p[lo..hi].as_ptr()));assert_eq!(bytes.len(),hi-lo);
+   assert!(v.query_bytes.is_empty());
+  },_=>panic!("native range/decoder disagreement")
+ }
+}
