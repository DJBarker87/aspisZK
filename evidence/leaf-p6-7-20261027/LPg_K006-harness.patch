+use super::*;
+#[kani::proof] #[kani::unwind(10)] fn LPg_validate_step(){
+ let b:[u8;32]=kani::any();let row:u8=kani::any();
+ let expected=match WideExact::from_le_bytes(&b){Some(x) if x.c1()==QM31::ZERO=>Ok(()),_=>Err(Error::NonCanonical{row,value:0})};
+ assert_eq!(validate_record_fields(row,&b),expected);
+}
+fn decode_step<const POINT:usize,const LO:usize,const HI:usize>() {
+ let i:usize=kani::any();kani::assume(i>=LO&&i<HI);
+ // A one-value record at an arbitrary absolute offset; original decoder takes N=1.
+ let b:[u8;5+116*32]=kani::any();let row:u8=kani::any();kani::assume(row>=14);
+ let off=POINT+i;let at=5+32*off;
+ let expected=QM31::from_le_bytes(&b[at..at+16]).map(|q|[q]).ok_or(Error::NonCanonical{row,value:off});
+ let got=ValidatedRecord{row,framed:&b}.decode_k::<1>(off);
+ match (got,expected){
+  (Ok([a]),Ok([b]))=>{assert_eq!(a.c0.a.0,b.c0.a.0);assert_eq!(a.c0.b.0,b.c0.b.0);assert_eq!(a.c1.a.0,b.c1.a.0);assert_eq!(a.c1.b.0,b.c1.b.0);},
+  (Err(a),Err(b))=>assert_eq!(a,b),_=>panic!("step disagreement")
+ }
+}
