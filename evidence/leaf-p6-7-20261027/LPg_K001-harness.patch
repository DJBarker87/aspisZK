+use super::*;
+pub(super) fn reference(x:Q,y:Q)->[u64;4] {
+ let [a,b,c,d]=x.0.map(u64::from); let [e,f,g,h]=y.0.map(u64::from);
+ let pp=(P as u64)*(P as u64);
+ let u=(c*g).wrapping_add(pp).wrapping_sub(d*h);
+ let v=(c*h).wrapping_add(d*g);
+ let u=(u & P as u64).wrapping_add(u>>31);
+ let v=(v & P as u64).wrapping_add(v>>31);
+ [(a*e).wrapping_add(pp).wrapping_sub(b*f).wrapping_add(2*u).wrapping_add(3*P as u64).wrapping_sub(v),
+ (a*f).wrapping_add(b*e).wrapping_add(u).wrapping_add(2*v),
+ (a*g).wrapping_add(c*e).wrapping_add(2*pp).wrapping_sub(b*h).wrapping_sub(d*f),
+ (a*h).wrapping_add(b*g).wrapping_add(c*f).wrapping_add(d*e)]
+}
+fn operands()->(Q,Q) {let x:[u32;4]=kani::any();let y:[u32;4]=kani::any();
+ kani::assume(x.iter().all(|v|*v<P)&&y.iter().all(|v|*v<P));
+ (Q::from_limbs(x).unwrap(),Q::from_limbs(y).unwrap())}
+#[kani::proof_for_contract(Q::raw)] #[kani::unwind(6)]
+fn LPg_raw_contract(){let (a,b)=operands();a.raw(b);}
+fn cell<const J:usize>() {let (a,b)=operands();let sums:[u64;4]=kani::any();let mut actual=Dot{sums};
+ let raw=reference(a,b); actual.push(a,b);
+ assert_eq!(actual.sums[J],sums[J].wrapping_add((raw[J] & P as u64).wrapping_add(raw[J]>>31)));}
+#[kani::proof] #[kani::stub_verified(Q::raw)] #[kani::unwind(6)] fn LPg_cell0(){cell::<0>()}
+#[kani::proof] #[kani::stub_verified(Q::raw)] #[kani::unwind(6)] fn LPg_cell1(){cell::<1>()}
+#[kani::proof] #[kani::stub_verified(Q::raw)] #[kani::unwind(6)] fn LPg_cell2(){cell::<2>()}
+#[kani::proof] #[kani::stub_verified(Q::raw)] #[kani::unwind(6)] fn LPg_cell3(){cell::<3>()}
