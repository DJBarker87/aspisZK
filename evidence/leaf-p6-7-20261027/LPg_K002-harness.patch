+use super::*;
+fn step<const K:bool,const J:usize>() {
+ let b:[u8;32]=kani::any();let prior:bool=kani::any();
+ let x=E::from_le_bytes(&b);let expected=match x {None=>Err(Error::Parse),Some(x)=>if K&&x.c1()!=K::ZERO{Err(Error::Parse)}else{Ok(())}};
+ let native=if prior {echeck(&b,K)}else{Err(Error::Parse)};
+ assert_eq!(native,if prior{expected}else{Err(Error::Parse)});
+ let _=J;
+}
+#[kani::proof] #[kani::unwind(10)] fn LPg_echeck0(){step::<false,0>()}
+#[kani::proof] #[kani::unwind(10)] fn LPg_echeck1(){step::<true,0>()}
