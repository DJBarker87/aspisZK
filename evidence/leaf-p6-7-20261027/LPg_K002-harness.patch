+use super::*;
+#[kani::proof] #[kani::unwind(10)] fn LPg_validate_step(){
+ let b:[u8;32]=kani::any();let row:u8=kani::any();
+ let expected=match WideExact::from_le_bytes(&b){Some(x) if x.c1()==QM31::ZERO=>Ok(()),_=>Err(Error::NonCanonical{row,value:0})};
+ assert_eq!(validate_record_fields(row,&b),expected);
+}
+fn decode_step<const POINT:usize,const LO:usize,const HI:usize>() {
+ let i:usize=kani::any();kani::assume(i>=LO&&i<HI);
+ // A one-value record at an arbitrary absolute offset; original decoder takes N=1.
+ let b:[u8;37]=kani::any();let row:u8=kani::any();kani::assume(row>=14);
+ let expected=QM31::from_le_bytes(&b[5..21]).map(|q|[q]).ok_or(Error::NonCanonical{row,value:0});
+ let got=ValidatedRecord{row,framed:&b}.decode_k::<1>(0);
+ assert_eq!(got,expected);let _=(POINT,i);
+}
+#[kani::proof] #[kani::unwind(10)] fn LPg_decode0_0(){decode_step::<0,0,15>()}
+#[kani::proof] #[kani::unwind(10)] fn LPg_decode0_1(){decode_step::<0,15,29>()}
+#[kani::proof] #[kani::unwind(10)] fn LPg_decode29_0(){decode_step::<29,0,15>()}
+#[kani::proof] #[kani::unwind(10)] fn LPg_decode29_1(){decode_step::<29,15,29>()}
+#[kani::proof] #[kani::unwind(10)] fn LPg_decode58_0(){decode_step::<58,0,15>()}
