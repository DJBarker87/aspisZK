+use super::*;
+pub fn canonical(x:QM31)->bool {x.c0.a.0<P && x.c0.b.0<P && x.c1.a.0<P && x.c1.b.0<P}
+fn words(x:QM31)->[u32;4] {[x.c0.a.0,x.c0.b.0,x.c1.a.0,x.c1.b.0]}
+fn neg(x:u32)->u32 {if x==0 {0}else{P-x}}
+pub fn neg_post(x:QM31,r:QM31)->bool {
+ let a=words(x);let want=[neg(a[0]),neg(a[1]),neg(a[2]),neg(a[3])];
+ if cfg!(NEA_wrong_neg) {words(r)!=want} else {words(r)==want}
+}
+#[kani::proof_for_contract(QM31::neg)]
+fn qm_neg() {let x=QM31{c0:CM31{a:M31(kani::any()),b:M31(kani::any())},c1:CM31{a:M31(kani::any()),b:M31(kani::any())}};kani::assume(canonical(x));let _=x.neg();}
