        let o ← PRVFresh_WAdm_q1.verifier.checkpoint_loop5 iter out
        k o) = (do let o ← WAdm_model.WAdm_tail out xs
                   k o) := by
  unfold WAdm_model.WAdm_tail
  simp only [bind_assoc, E_loop5]

theorem K_queries {β : Type} (xs : Array Std.U32 22#usize) (out : alloc.vec.Vec Std.U8)
    (k : alloc.vec.Vec Std.U8 → Result β) :
    (do let iter ← Array.Insts.CoreIterTraitsCollectIntoIteratorTIntoIter.into_iter xs
        let o ← PRVFresh_WAdm_q1.verifier.checkpoint_loop2 iter out
        k o) = (do let o ← WAdm_model.WAdm_queries out xs
                   k o) := by
  unfold WAdm_model.WAdm_queries
  simp only [bind_assoc, E_loop2]

theorem K_semantic {β : Type} (xs : Array aspis_core.field.QM31 10#usize) (out : alloc.vec.Vec Std.U8)
    (k : alloc.vec.Vec Std.U8 → Result β) :
    (do let iter ← Array.Insts.CoreIterTraitsCollectIntoIteratorTIntoIter.into_iter xs
        let o ← PRVFresh_WAdm_q1.verifier.checkpoint_loop3 iter out
        k o) = (do let o ← WAdm_model.WAdm_semantic out xs
                   k o) := by
  unfold WAdm_model.WAdm_semantic
  simp only [bind_assoc, E_loop3]

theorem K_coord {β : Type} (z : Array aspis_core.circle.SecureCirclePoint 2#usize)
    (z0 z1 : aspis_core.circle.SecureCirclePoint) (hz : z.val = [z0, z1]) (out : alloc.vec.Vec Std.U8)
    (k : alloc.vec.Vec Std.U8 → Result β) :
    (do let iter ← Array.Insts.CoreIterTraitsCollectIntoIteratorTIntoIter.into_iter z
        let o ← PRVFresh_WAdm_q1.verifier.checkpoint_loop4 iter out
        k o) = (do let o ← WAdm_model.WAdm_coordinates out (Array.make 4#usize [z0.x, z0.y, z1.x, z1.y])
                   k o) := by
  unfold WAdm_model.WAdm_coordinates
  have h1 : Array.Insts.CoreIterTraitsCollectIntoIteratorTIntoIter.into_iter z = ok [z0, z1] := by
    show ok z.val = ok [z0, z1]
    rw [hz]
  have h2 : Array.Insts.CoreIterTraitsCollectIntoIteratorTIntoIter.into_iter
      (Array.make 4#usize [z0.x, z0.y, z1.x, z1.y]) = ok [z0.x, z0.y, z1.x, z1.y] := rfl
  simp only [h1, h2, bind_tc_ok, E_loop4, List.flatMap_cons, List.flatMap_nil, List.append_nil, List.cons_append,
    List.nil_append]

theorem K_weights {β : Type}
    (S : {T : Type} → (A : Type) → alloc.vec.Vec T → Result (core.slice.iter.Iter T))
    (w : alloc.vec.Vec aspis_core.field.QM31)
    (hS : S Global w = ok ⟨⟨w.val, w.property⟩, 0⟩) (out : alloc.vec.Vec Std.U8)
    (k : alloc.vec.Vec Std.U8 → Result β) :
    (do let iter ← S Global w
        let o ← PRVFresh_WAdm_q1.verifier.checkpoint_loop6 iter out
        k o) = (do let o ← WAdm_model.WAdm_weights out w
                   k o) := by
  unfold WAdm_model.WAdm_weights
  rw [hS]
  simp only [alloc.vec.IntoIteratorVec.into_iter, bind_tc_ok]
  rw [E_loop6 ⟨⟨w.val, w.property⟩, 0⟩ w (by simp) out]
