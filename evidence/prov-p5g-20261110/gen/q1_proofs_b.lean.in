    subst hs'
    rfl
  · intro s out x xs hs
    have hs' : s = x :: xs := hs
    subst hs'
    exact ⟨xs, rfl, by simp only [WAdm_model.WAdm_early_loop.body, arr_next_cons, bind_tc_ok, stepE, bind_assoc] <;> rfl⟩

