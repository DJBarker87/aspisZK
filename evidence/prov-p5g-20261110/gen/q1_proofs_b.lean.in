theorem F_loop4 (xs : List aspis_core.circle.SecureCirclePoint) (out : alloc.vec.Vec Std.U8) :
    PRVFresh_WAdm_q1.verifier.checkpoint_loop4 xs out = fold stepPt xs out := by
