/-! pointwise equalities -/
theorem stepPt_eq (z : aspis_core.circle.SecureCirclePoint) (out : alloc.vec.Vec Std.U8) :
    stepPt z out = fold stepK [z.x, z.y] out := by
  unfold stepPt
  rw [show Array.Insts.CoreIterTraitsCollectIntoIteratorTIntoIter.into_iter (Array.make 2#usize [ z.x, z.y ])
      = ok [z.x, z.y] from rfl]
  simp only [bind_tc_ok, F_loop4_0]

theorem coord_fold (pts : List aspis_core.circle.SecureCirclePoint) (out : alloc.vec.Vec Std.U8) :
    fold stepPt pts out = fold stepK (pts.flatMap (fun z => [z.x, z.y])) out := by
  induction pts generalizing out with
  | nil => rfl
  | cons z zs ih =>
    simp only [List.flatMap_cons, fold_append, fold, stepPt_eq, ih]

theorem E_loop0 (it : core.slice.iter.Iter (Array Std.U8 32#usize)) (out : alloc.vec.Vec Std.U8) :
    PRVFresh_WAdm_q1.verifier.checkpoint_loop0 it out
      = WAdm_model.WAdm_roots_loop (it.slice.val.drop it.i) out := by
  rw [F_loop0, G_roots]

theorem E_loop1 (it : List aspis_core.field.wide_exact.WideExact) (out : alloc.vec.Vec Std.U8) :
    PRVFresh_WAdm_q1.verifier.checkpoint_loop1 it out = WAdm_model.WAdm_early_loop it out := by
  rw [F_loop1, G_early]

theorem E_loop2 (it : List Std.U32) (out : alloc.vec.Vec Std.U8) :
    PRVFresh_WAdm_q1.verifier.checkpoint_loop2 it out = WAdm_model.WAdm_queries_loop it out := by
  rw [F_loop2, G_queries]

theorem E_loop3 (it : List aspis_core.field.QM31) (out : alloc.vec.Vec Std.U8) :
    PRVFresh_WAdm_q1.verifier.checkpoint_loop3 it out = WAdm_model.WAdm_semantic_loop it out := by
  rw [F_loop3, G_semantic]

theorem E_loop4 (it : List aspis_core.circle.SecureCirclePoint) (out : alloc.vec.Vec Std.U8) :
    PRVFresh_WAdm_q1.verifier.checkpoint_loop4 it out
      = WAdm_model.WAdm_coordinates_loop (it.flatMap (fun z => [z.x, z.y])) out := by
  rw [F_loop4, coord_fold, G_coord]

theorem E_loop5 (it : List aspis_core.field.wide_exact.WideExact) (out : alloc.vec.Vec Std.U8) :
    PRVFresh_WAdm_q1.verifier.checkpoint_loop5 it out = WAdm_model.WAdm_tail_loop it out := by
  rw [F_loop5, G_tail]

theorem E_loop6 (it : core.slice.iter.Iter aspis_core.field.QM31) (v : alloc.vec.Vec aspis_core.field.QM31)
    (hv : v.val = it.slice.val.drop it.i) (out : alloc.vec.Vec Std.U8) :
    PRVFresh_WAdm_q1.verifier.checkpoint_loop6 it out = WAdm_model.WAdm_weights_loop v out := by
  rw [F_loop6, G_weights, hv]

theorem E_putK (out : alloc.vec.Vec Std.U8) (x : aspis_core.field.QM31) :
    PRVFresh_WAdm_q1.verifier.put_k out x = WAdm_model.WAdm_putK out x := rfl
