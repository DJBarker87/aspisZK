
theorem vec_nx_nil {T : Type} (v : alloc.vec.into_iter.IntoIter T) (h : (v : alloc.vec.Vec T).val = []) :
    alloc.vec.into_iter.IteratorIntoIter.next v = ok (none, v) := by
  match v, h with
  | ⟨[], _⟩, _ => rfl

theorem vec_nx_cons {T : Type} (v : alloc.vec.into_iter.IntoIter T) (x : T) (xs : List T)
    (h : (v : alloc.vec.Vec T).val = x :: xs) :
    ∃ s' : alloc.vec.into_iter.IntoIter T, (s' : alloc.vec.Vec T).val = xs ∧
      alloc.vec.into_iter.IteratorIntoIter.next v = ok (some x, s') := by
  match v, h with
  | ⟨hd :: tl, hp⟩, h =>
    have hx : hd = x := (List.cons.inj h).1
    have hxs : tl = xs := (List.cons.inj h).2
    subst hx; subst hxs
    exact ⟨⟨tl, by simp at hp; omega⟩, rfl, rfl⟩

theorem arr_next_cons {T : Type} {N : Usize} (x : T) (xs : List T) :
    core.array.iter.IntoIter.Insts.CoreIterTraitsIteratorIterator.next (N := N) (x :: xs) = ok (some x, xs) := rfl

/-! step functions (the per-element bodies shared by both sides) -/
def stepRoot (root : Array Std.U8 32#usize) (out : alloc.vec.Vec Std.U8) : Result (alloc.vec.Vec Std.U8) := do
  let s ← lift (Array.to_slice root)
  alloc.vec.Vec.extend_from_slice core.clone.CloneU8 out s

def stepE (x : aspis_core.field.wide_exact.WideExact) (out : alloc.vec.Vec Std.U8) :
    Result (alloc.vec.Vec Std.U8) := do
  let a ← aspis_core.field.wide_exact.WideExact.to_le_bytes x
  let s ← lift (Array.to_slice a)
  alloc.vec.Vec.extend_from_slice core.clone.CloneU8 out s

def stepQ (x : Std.U32) (out : alloc.vec.Vec Std.U8) : Result (alloc.vec.Vec Std.U8) := do
  let a ← lift (core.num.U32.to_le_bytes x)
  let s ← lift (Array.to_slice a)
  alloc.vec.Vec.extend_from_slice core.clone.CloneU8 out s

def stepK (x : aspis_core.field.QM31) (out : alloc.vec.Vec Std.U8) : Result (alloc.vec.Vec Std.U8) :=
  WAdm_model.WAdm_putK out x

def stepPt (z : aspis_core.circle.SecureCirclePoint) (out : alloc.vec.Vec Std.U8) :
    Result (alloc.vec.Vec Std.U8) := do
  let iter2 ← Array.Insts.CoreIterTraitsCollectIntoIteratorTIntoIter.into_iter (Array.make 2#usize [ z.x, z.y ])
  PRVFresh_WAdm_q1.verifier.checkpoint_loop4_loop0 iter2 out



theorem E_wlb (x : aspis_core.field.QM31) (out : Slice Std.U8) :
    PRVFresh_WAdm_q1.aspis_core.field.QM31.write_le_bytes x out = aspis_core.field.QM31.write_le_bytes x out := rfl

theorem H3 (x : aspis_core.field.QM31) (o : alloc.vec.Vec Std.U8) (xs : List aspis_core.field.QM31) :
    PRVFresh_WAdm_q1.verifier.checkpoint_loop3.body (x :: xs) o = (do let o1 ← stepK x o; ok (cont (xs, o1))) := by
  simp [PRVFresh_WAdm_q1.verifier.checkpoint_loop3.body, arr_next_cons, stepK,
    WAdm_model.WAdm_putK, lift, Array.to_slice_mut, E_wlb]

theorem H4 (x : aspis_core.field.QM31) (o : alloc.vec.Vec Std.U8) (xs : List aspis_core.field.QM31) :
    PRVFresh_WAdm_q1.verifier.checkpoint_loop4_loop0.body (x :: xs) o = (do let o1 ← stepK x o; ok (cont (xs, o1))) := by
  simp [PRVFresh_WAdm_q1.verifier.checkpoint_loop4_loop0.body, arr_next_cons, stepK,
    WAdm_model.WAdm_putK, lift, Array.to_slice_mut, E_wlb]

/-! gate loops in closed form -/
theorem G_roots (xs : List (Array Std.U8 32#usize)) (out : alloc.vec.Vec Std.U8) :
    WAdm_model.WAdm_roots_loop xs out = fold stepRoot xs out := by
  unfold WAdm_model.WAdm_roots_loop
  refine loop_fold_gen _ stepRoot (fun s => s) ?_ ?_ _ xs out rfl
  · intro s out hs
    have hs' : s = [] := hs
    subst hs'
    rfl
  · intro s out x xs hs
    have hs' : s = x :: xs := hs
    subst hs'
    exact ⟨xs, rfl, by simp only [WAdm_model.WAdm_roots_loop.body, arr_next_cons, bind_tc_ok, stepRoot, bind_assoc] <;> rfl⟩

theorem G_early (xs : List aspis_core.field.wide_exact.WideExact) (out : alloc.vec.Vec Std.U8) :
    WAdm_model.WAdm_early_loop xs out = fold stepE xs out := by
