theorem G_weights (v : alloc.vec.Vec aspis_core.field.QM31) (out : alloc.vec.Vec Std.U8) :
    WAdm_model.WAdm_weights_loop v out = fold stepK v.val out := by
  unfold WAdm_model.WAdm_weights_loop
  refine loop_fold_gen _ stepK (fun v => (v : alloc.vec.Vec aspis_core.field.QM31).val) ?_ ?_ _ v out rfl
  · intro s out hs
    simp only [WAdm_model.WAdm_weights_loop.body, vec_nx_nil s hs, bind_tc_ok] <;> rfl
  · intro s out x xs hs
    obtain ⟨s', h1, h2⟩ := vec_nx_cons s x xs hs
    exact ⟨s', h1, by simp only [WAdm_model.WAdm_weights_loop.body, h2, bind_tc_ok, stepK] <;> rfl⟩

/-! fresh (frozen 4bb3b3f emission) loops in closed form -/
theorem F_loop0 (it : core.slice.iter.Iter (Array Std.U8 32#usize)) (out : alloc.vec.Vec Std.U8) :
    PRVFresh_WAdm_q1.verifier.checkpoint_loop0 it out = fold stepRoot (it.slice.val.drop it.i) out := by
  unfold PRVFresh_WAdm_q1.verifier.checkpoint_loop0
  refine loop_fold_gen _ stepRoot (fun it => it.slice.val.drop it.i) ?_ ?_ _ it out rfl
  · intro s out hs
    obtain ⟨sl, i⟩ := s
    simp only [PRVFresh_WAdm_q1.verifier.checkpoint_loop0.body, sliceIter_nil sl i hs, bind_tc_ok] <;> rfl
  · intro s out x xs hs
    obtain ⟨sl, i⟩ := s
    obtain ⟨h1, h2⟩ := sliceIter_cons sl i x xs hs
    exact ⟨⟨sl, i + 1⟩, h2, by
      simp only [PRVFresh_WAdm_q1.verifier.checkpoint_loop0.body, h1, bind_tc_ok, stepRoot, bind_assoc] <;> rfl⟩

theorem F_loop6 (it : core.slice.iter.Iter aspis_core.field.QM31) (out : alloc.vec.Vec Std.U8) :
    PRVFresh_WAdm_q1.verifier.checkpoint_loop6 it out = fold stepK (it.slice.val.drop it.i) out := by
  unfold PRVFresh_WAdm_q1.verifier.checkpoint_loop6
  refine loop_fold_gen _ stepK (fun it => it.slice.val.drop it.i) ?_ ?_ _ it out rfl
  · intro s out hs
    obtain ⟨sl, i⟩ := s
    simp only [PRVFresh_WAdm_q1.verifier.checkpoint_loop6.body, sliceIter_nil sl i hs, bind_tc_ok] <;> rfl
  · intro s out x xs hs
    obtain ⟨sl, i⟩ := s
    obtain ⟨h1, h2⟩ := sliceIter_cons sl i x xs hs
    exact ⟨⟨sl, i + 1⟩, h2, by
      simp only [PRVFresh_WAdm_q1.verifier.checkpoint_loop6.body, h1, bind_tc_ok, stepK, WAdm_model.WAdm_putK,
        PRVFresh_WAdm_q1.verifier.put_k] <;> rfl⟩

