namespace PRVQ

/-- one step of the Aeneas `loop` functional (copy of PRVC.bs, evidence/prov-p1h-20261109/PRVC_LoopBridge.lean) -/
def bs {α β : Type _} (body : α → Result (ControlFlow α β)) (h : α → Result β) (x : α) : Result β :=
  match body x with
  | ok r => match r with
    | ControlFlow.cont x' => h x'
    | ControlFlow.done y => ok y
  | fail e => fail e
  | div => div

theorem loop_unfold {α β : Type _} (body : α → Result (ControlFlow α β)) (x : α) :
    loop body x = bs body (loop body) x := by
  rw [loop]; rfl

/-- right fold of a Result-valued step over a list -/
def fold {α V : Type} (step : α → V → Result V) : List α → V → Result V
  | [], out => ok out
  | x :: xs, out => do
      let out' ← step x out
      fold step xs out'

theorem fold_append {α V : Type} (step : α → V → Result V) (l1 l2 : List α) (out : V) :
    fold step (l1 ++ l2) out = (do let o ← fold step l1 out; fold step l2 o) := by
  induction l1 generalizing out with
  | nil => simp [fold]
  | cons x xs ih =>
    simp only [List.cons_append, fold, bind_assoc, ih]

theorem loop_next_fold {σ α V : Type}
    (nx : σ → Result (Option α × σ)) (view : σ → List α)
    (bodySome : α → V → σ → Result (ControlFlow (σ × V) V))
    (step : α → V → Result V)
    (hnil : ∀ s, view s = [] → nx s = ok (none, s))
    (hcons : ∀ s x xs, view s = x :: xs → ∃ s', view s' = xs ∧ nx s = ok (some x, s'))
    (hsome : ∀ x o it1, bodySome x o it1 = (do let o1 ← step x o; ok (cont (it1, o1)))) :
    ∀ (n : Nat) (s : σ) (out : V), (view s).length = n →
      loop (fun (iter1, out1) => do
        let (o, iter2) ← nx iter1
        match o with
        | none => ok (done out1)
        | some x => bodySome x out1 iter2) (s, out) = fold step (view s) out := by
  intro n
  induction n with
  | zero =>
    intro s out h
    have hv : view s = [] := List.eq_nil_of_length_eq_zero h
    rw [loop_unfold]
    simp only [bs, hnil s hv, hv, fold, bind_tc_ok]
  | succ n ih =>
    intro s out h
    cases hv : view s with
    | nil => rw [hv] at h; simp at h
    | cons x xs =>
      obtain ⟨s', hs', hnx⟩ := hcons s x xs hv
      rw [hv] at h
      have hlen : (view s').length = n := by rw [hs']; simpa using h
      rw [loop_unfold]
      simp only [bs, hnx, bind_tc_ok, hsome, fold]
      cases hst : step x out with
      | ok o =>
        simp only [bind_tc_ok]
        have := ih s' o hlen
        rw [hs'] at this
        exact this
      | fail e => simp
      | div => simp

theorem bind_ok_id {α : Type} (m : Result α) : (m >>= fun x => ok x) = m := by
  cases m <;> rfl

/-- generic facts for the owned array iterator model of the gate (a list) -/
theorem arr_nx_nil {T : Type} {N : Usize} (s : core.array.iter.IntoIter T N) (h : s = []) :
    core.array.iter.IntoIter.Insts.CoreIterTraitsIteratorIterator.next s = ok (none, s) := by
  subst h; rfl

theorem arr_nx_cons {T : Type} {N : Usize} (s : core.array.iter.IntoIter T N) (x : T) (xs : List T)
    (h : s = x :: xs) :
    ∃ s' : core.array.iter.IntoIter T N, s' = xs ∧
      core.array.iter.IntoIter.Insts.CoreIterTraitsIteratorIterator.next s = ok (some x, s') :=
  ⟨xs, rfl, by subst h; rfl⟩

/-- the shared-slice iterator model of the Aeneas library (slice and index) -/
theorem sliceIter_nil {T : Type} (sl : Slice T) (i : Nat) (h : sl.val.drop i = []) :
    core.slice.iter.IteratorSliceIter.next (⟨sl, i⟩ : core.slice.iter.Iter T) = ok (none, ⟨sl, i⟩) := by
  have hle : sl.val.length ≤ i := by
    by_contra hc
    have hl : (sl.val.drop i).length = sl.val.length - i := List.length_drop
    rw [h] at hl
    simp at hl
    omega
  unfold core.slice.iter.IteratorSliceIter.next
  have hl2 := Slice.len_val sl
  split
  · next hlt =>
    exfalso
    simp only [Slice.length] at hl2
    omega
  · rfl

theorem sliceIter_cons {T : Type} (sl : Slice T) (i : Nat) (x : T) (xs : List T)
    (h : sl.val.drop i = x :: xs) :
    core.slice.iter.IteratorSliceIter.next (⟨sl, i⟩ : core.slice.iter.Iter T) = ok (some x, ⟨sl, i + 1⟩) ∧
      sl.val.drop (i + 1) = xs := by
  have hlt : i < sl.val.length := by
    by_contra hc
    have hl : (sl.val.drop i).length = sl.val.length - i := List.length_drop
    rw [h] at hl
    simp at hl
    omega
  have hd := List.drop_eq_getElem_cons hlt
  rw [h] at hd
  have hx : x = sl.val[i] := (List.cons.inj hd).1.symm
  have hxs : sl.val.drop (i + 1) = xs := (List.cons.inj hd).2.symm
  refine ⟨?_, hxs⟩
  unfold core.slice.iter.IteratorSliceIter.next
  have hl2 := Slice.len_val sl
  rw [dif_pos]
  · subst hx; rfl
  · simp only [Slice.length] at hl2
    omega


theorem vec_nx_nil {T : Type} (v : alloc.vec.into_iter.IntoIter T) (h : (v : alloc.vec.Vec T).val = []) :
    alloc.vec.into_iter.IteratorIntoIter.next v = ok (none, v) := by
  match v, h with
  | ⟨[], _⟩, _ => rfl

theorem vec_nx_cons {T : Type} (v : alloc.vec.into_iter.IntoIter T) (x : T) (xs : List T)
    (h : (v : alloc.vec.Vec T).val = x :: xs) :
    ∃ s' : alloc.vec.into_iter.IntoIter T, (s' : alloc.vec.Vec T).val = xs ∧
      alloc.vec.into_iter.IteratorIntoIter.next v = ok (some x, s') := by
  match v, h with
  | ⟨hd :: tl, hp⟩, h =>
    have hx : hd = x := (List.cons.inj h).1
    have hxs : tl = xs := (List.cons.inj h).2
    subst hx; subst hxs
    exact ⟨⟨tl, by simp at hp; omega⟩, rfl, rfl⟩

theorem loop_arr_fold {α V : Type} {N : Usize}
    (bodySome : α → V → core.array.iter.IntoIter α N → Result (ControlFlow (core.array.iter.IntoIter α N × V) V))
    (step : α → V → Result V)
    (hsome : ∀ x o it1, bodySome x o it1 = (do let o1 ← step x o; ok (cont (it1, o1))))
    (it : core.array.iter.IntoIter α N) (out : V) :
    loop (fun (iter1, out1) => do
        let (o, iter2) ← core.array.iter.IntoIter.Insts.CoreIterTraitsIteratorIterator.next iter1
        match o with
        | none => ok (done out1)
        | some x => bodySome x out1 iter2) (it, out) = fold step it out :=
  loop_next_fold (core.array.iter.IntoIter.Insts.CoreIterTraitsIteratorIterator.next) (fun s => s)
    bodySome step (fun s h => arr_nx_nil s h) (fun s x xs h => arr_nx_cons s x xs h) hsome
    (List.length it) it out rfl

theorem loop_slice_fold {α V : Type}
    (bodySome : α → V → core.slice.iter.Iter α → Result (ControlFlow (core.slice.iter.Iter α × V) V))
    (step : α → V → Result V)
    (hsome : ∀ x o it1, bodySome x o it1 = (do let o1 ← step x o; ok (cont (it1, o1))))
    (it : core.slice.iter.Iter α) (out : V) :
    loop (fun (iter1, out1) => do
        let (o, iter2) ← core.slice.iter.IteratorSliceIter.next iter1
        match o with
        | none => ok (done out1)
        | some x => bodySome x out1 iter2) (it, out) = fold step (it.slice.val.drop it.i) out :=
  loop_next_fold (core.slice.iter.IteratorSliceIter.next) (fun it => it.slice.val.drop it.i)
    bodySome step
    (fun s hs => by obtain ⟨sl, i⟩ := s; exact sliceIter_nil sl i hs)
    (fun s x xs hs => by
      obtain ⟨sl, i⟩ := s
      obtain ⟨h1, h2⟩ := sliceIter_cons sl i x xs hs
      exact ⟨⟨sl, i + 1⟩, h2, h1⟩)
    hsome _ it out rfl

theorem loop_vec_fold {α V : Type}
    (bodySome : α → V → alloc.vec.into_iter.IntoIter α → Result (ControlFlow (alloc.vec.into_iter.IntoIter α × V) V))
    (step : α → V → Result V)
    (hsome : ∀ x o it1, bodySome x o it1 = (do let o1 ← step x o; ok (cont (it1, o1))))
    (it : alloc.vec.into_iter.IntoIter α) (out : V) :
    loop (fun (iter1, out1) => do
        let (o, iter2) ← alloc.vec.into_iter.IteratorIntoIter.next iter1
        match o with
        | none => ok (done out1)
        | some x => bodySome x out1 iter2) (it, out) = fold step (it : alloc.vec.Vec α).val out :=
  loop_next_fold (alloc.vec.into_iter.IteratorIntoIter.next) (fun v => (v : alloc.vec.Vec α).val)
    bodySome step (fun s h => vec_nx_nil s h) (fun s x xs h => vec_nx_cons s x xs h) hsome
    _ it out rfl

