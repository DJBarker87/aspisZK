    PRVFresh_WAdm_q1.transport.Variant
  | .S1 => .S1
  | .S2 => .S2
  | .D => .D

def toGatePrepared (p : PRVFresh_WAdm_q1.verifier.Prepared) :
    OraclePortCkptAbi2Extracted.aspis_r1_cost_probe.verifier.Prepared :=
  { variant := toGateVariant p.variant, roots := p.roots, gamma := p.gamma, kappa := p.kappa,
    alpha := p.alpha, rho := p.rho, queries := p.queries, semantic_alpha := p.semantic_alpha,
    z := p.z, claim := p.claim, state := p.state }

def ofGatePrepared (p : OraclePortCkptAbi2Extracted.aspis_r1_cost_probe.verifier.Prepared) :
    PRVFresh_WAdm_q1.verifier.Prepared :=
  { variant := ofGateVariant p.variant, roots := p.roots, gamma := p.gamma, kappa := p.kappa,
    alpha := p.alpha, rho := p.rho, queries := p.queries, semantic_alpha := p.semantic_alpha,
    z := p.z, claim := p.claim, state := p.state }

