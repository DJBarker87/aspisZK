    (do let iter ← SharedArray.Insts.CoreIterTraitsCollectIntoIteratorSharedIter.into_iter roots
        let o ← PRVFresh_WAdm_q1.verifier.checkpoint_loop0 iter out
        k o) = (do let o ← WAdm_model.WAdm_roots out roots
                   k o) := by
  unfold WAdm_model.WAdm_roots
  simp only [SharedArray.Insts.CoreIterTraitsCollectIntoIteratorSharedIter.into_iter,
    Array.Insts.CoreIterTraitsCollectIntoIteratorTIntoIter.into_iter, bind_tc_ok, E_loop0, List.drop_zero]

