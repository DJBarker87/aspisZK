    "source_lines": [
      {
        "line": 139,
        "text": "    pub(crate) fn decode_k<const N: usize>("
      },
      {
        "line": 140,
        "text": "        &self,"
      },
      {
        "line": 141,
        "text": "        offset_values: usize,"
      },
      {
        "line": 142,
        "text": "    ) -> Result<[QM31; N], Error> {"
      },
      {
        "line": 143,
        "text": "        if self.row < 14 {"
      },
      {
        "line": 144,
        "text": "            return Err(Error::InvalidRow);"
      },
      {
        "line": 145,
        "text": "        }"
      },
      {
        "line": 146,
        "text": "        let byte_offset = offset_values"
      },
      {
        "line": 147,
        "text": "            .checked_mul(32)"
      },
      {
        "line": 148,
        "text": "            .ok_or(Error::Length { row: self.row })?;"
      },
      {
        "line": 149,
        "text": "        let byte_len = N.checked_mul(32).ok_or(Error::Length { row: self.row })?;"
      },
      {
        "line": 150,
        "text": "        let end = byte_offset"
      },
      {
        "line": 151,
        "text": "            .checked_add(byte_len)"
      },
      {
        "line": 152,
        "text": "            .ok_or(Error::Length { row: self.row })?;"
      },
      {
        "line": 153,
        "text": "        let bytes = self"
      },
      {
        "line": 154,
        "text": "            .payload()"
      },
      {
        "line": 155,
        "text": "            .get(byte_offset..end)"
      },
      {
        "line": 156,
        "text": "            .ok_or(Error::Length { row: self.row })?;"
      },
      {
        "line": 157,
        "text": "        let mut out = [QM31::ZERO; N];"
      },
      {
        "line": 158,
        "text": "        for (value, part) in bytes.chunks_exact(32).enumerate() {"
      },
      {
        "line": 159,
        "text": "            out[value] = QM31::from_le_bytes(&part[..16]).ok_or(Error::NonCanonical {"
      },
      {
        "line": 160,
        "text": "                row: self.row,"
      },
      {
        "line": 161,
        "text": "                value: offset_values + value,"
      },
      {
        "line": 162,
        "text": "            })?;"
      },
      {
        "line": 163,
        "text": "        }"
      },
      {
        "line": 164,
        "text": "        Ok(out)"
      },
      {
        "line": 165,
        "text": "    }"
      },
      {
        "line": 166,
        "text": "}"
      }
