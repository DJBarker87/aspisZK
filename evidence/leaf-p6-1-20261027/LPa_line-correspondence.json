    "owned_reference": {
      "path": "evidence/extraction-repro7-20261027/XRg_reference.rs",
      "name": "XRg_decode_reference",
      "start_line": 7,
      "end_line": 24,
      "sha256": "950baa1197116c8a3ad539a3161476ad6a58f26c1a5c3f4f06bb3f52c1d86a4c",
      "lines": [
        {
          "line": 7,
          "text": "fn XRg_decode_reference<const N:usize>(row:u8,framed:&[u8],offset:usize)->Result<[K;N],Error> {"
        },
        {
          "line": 8,
          "text": "    if row<14 {return Err(Error::InvalidRow)}"
        },
        {
          "line": 9,
          "text": "    let start=offset.checked_mul(32).ok_or(Error::Length{row})?;"
        },
        {
          "line": 10,
          "text": "    let size=N.checked_mul(32).ok_or(Error::Length{row})?;"
        },
        {
          "line": 11,
          "text": "    let end=start.checked_add(size).ok_or(Error::Length{row})?;"
        },
        {
          "line": 12,
          "text": "    let payload=&framed[5..];"
        },
        {
          "line": 13,
          "text": "    if end>payload.len() {return Err(Error::Length{row})}"
        },
        {
          "line": 14,
          "text": "    let mut out=[K::ZERO;N];"
        },
        {
          "line": 15,
          "text": "    let mut i=0;"
        },
        {
          "line": 16,
          "text": "    while i<N {"
        },
        {
          "line": 17,
          "text": "        let mut limbs=[0u32;4];"
        },
        {
          "line": 18,
          "text": "        for j in 0..4 {let at=start+32*i+4*j; limbs[j]=u32::from_le_bytes(payload[at..at+4].try_into().unwrap());}"
        },
        {
          "line": 19,
          "text": "        if limbs.iter().any(|x| *x>=2147483647) {return Err(Error::NonCanonical{row,value:offset+i})}"
        },
        {
          "line": 20,
          "text": "        out[i]=K::from_le_bytes(&payload[start+32*i..start+32*i+16]).unwrap();"
        },
        {
          "line": 21,
          "text": "        i+=1;"
        },
        {
          "line": 22,
          "text": "    }"
        },
        {
          "line": 23,
          "text": "    Ok(out)"
        },
        {
          "line": 24,
          "text": "}"
        }
      ]
    },
