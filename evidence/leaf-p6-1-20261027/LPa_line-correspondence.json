    "source_lines": [
      {
        "line": 127,
        "text": "pub fn expand_values(compact: &[u8], out: &mut [u8]) -> Result<(), CodecError> {"
      },
      {
        "line": 128,
        "text": "    if compact.len() % 16 != 0 || out.len() != 2 * compact.len() {"
      },
      {
        "line": 129,
        "text": "        return Err(CodecError::Length);"
      },
      {
        "line": 130,
        "text": "    }"
      },
      {
        "line": 131,
        "text": "    for (c, o) in compact.chunks_exact(16).zip(out.chunks_exact_mut(32)) {"
      },
      {
        "line": 132,
        "text": "        o[..16].copy_from_slice(c);"
      },
      {
        "line": 133,
        "text": "        o[16..].fill(0);"
      },
      {
        "line": 134,
        "text": "    }"
      },
      {
        "line": 135,
        "text": "    Ok(())"
      }
    ],
    "owned_reference": {
      "path": "evidence/extraction-repro6-20261027/XRf_reference.rs",
      "name": "XRf_reference_expand_values",
      "start_line": 39,
      "end_line": 48,
