          "line": 39,
          "text": "fn XRf_reference_expand_values(bytes:&[u8],out:&mut[u8])->Result<(),compact::CodecError> {"
        },
        {
          "line": 40,
          "text": "    if bytes.len()%16!=0 || out.len()!=2*bytes.len() {return Err(compact::CodecError::Length)}"
        },
        {
          "line": 41,
          "text": "    let mut i=0;"
        },
        {
          "line": 42,
          "text": "    while i<bytes.len()/16 {"
        },
        {
          "line": 43,
          "text": "        let mut j=0;"
        },
        {
          "line": 44,
          "text": "        while j<32 {out[32*i+j]=if j<16 {bytes[16*i+j]} else {0};j+=1;}"
        },
        {
          "line": 45,
          "text": "        i+=1;"
        },
        {
          "line": 46,
          "text": "    }"
        },
        {
          "line": 47,
          "text": "    Ok(())"
        },
        {
          "line": 48,
