          { start := NFA_Iterator.cursor ⟨↑((fun i => i) ⟨6, ⋯⟩), ⋯⟩,
            «end» := NFA_Iterator.cursor ⟨↑((fun i => i) ⟨6, ⋯⟩) + 1, ⋯⟩ }
          (Array.repeat 8#usize 0#u64)
    let out ← NFE_NFA_FoldEight.eight sums limbs
    ok (cont (NFA_Iterator.value ⟨↑((fun i => i) ⟨6, ⋯⟩) + 1, ⋯⟩, out))
