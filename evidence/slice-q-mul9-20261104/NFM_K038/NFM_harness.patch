+struct NFM_WindowLog { replies:[[u64;8];4], left:[[u32;8];4], right:[u32;4], order:[usize;32], calls:usize }
+fn NFM_window_product(log:&mut NFM_WindowLog,offset:usize,lane:usize,a:u32,b:u32)->u64{
