                    JFr_TX2_Powers.value (JFv_TX2_Geometry.value err geometrySeed) b 22#usize
                    (Eq.mpr (id (congrArg (fun _a => ↑_a = ↑22#usize) next)) (Eq.refl ↑22#usize))))),
            ⟨weights, ⟨next, ⟨flush, ⟨size, canon⟩⟩⟩⟩⟩⟩))
