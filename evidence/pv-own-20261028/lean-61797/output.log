theorem R1Z.PV_OWN_CheckedAlloc.owned_success : ∀ {S X E : Type}
  (primitive : R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E (Option ℕ) × S)
  (w : R1Z.PV_OWN_Operations.State S X) (cmd : R1Z.PV_OWN_CheckedAlloc.Command primitive w) (p : ℕ) (s : S),
  primitive cmd.request w.allocator = (R1Z.PV_W_Threading.Outcome.ok (some p), s) →
    R1Z.PV_OWN_Heap.Owned (R1Z.PV_OWN_Operations.allocate primitive cmd.request cmd.owner w).world.memory cmd.owner
      { address := p, generation := w.memory.generations p + 1 }
      (R1Z.PV_OWN_Heap.emptyCell cmd.request.size cmd.request.alignment cmd.owner) :=
fun {S X E} primitive w cmd p s h =>
  of_eq_true
    (Eq.trans
      (congr
        (congrArg And
          (Eq.trans
            (congr
              (congrArg And
                (Eq.trans
                  (congrFun'
                    (congrArg Eq
                      (Eq.trans
                        (congrFun'
                          (congrArg R1Z.PV_OWN_Heap.Memory.heap
                            (congrArg R1Z.PV_OWN_Operations.State.memory
                              (congrArg R1Z.PV_W_Threading.Run.world
                                (congrFun'
                                  (congr
                                    (congrArg R1Z.PV_W_Threading.Run.mk
                                      (congrArg Prod.fst
                                        (Eq.trans
                                          (congrArg
                                            (fun x =>
                                              match x.1 with
