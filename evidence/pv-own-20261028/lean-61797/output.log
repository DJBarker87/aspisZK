  (bytes : R1Z.PV_OWN_Bytes.Bytes) (read write next : ℕ) (value : T),
  write ≤ read →
    read < next →
      R1Z.PV_OWN_View.Represents codec cell (next * codec.width) value →
        R1Z.PV_OWN_View.Represents codec (R1Z.PV_OWN_Bytes.store cell (write * codec.width) codec.width bytes)
          (next * codec.width) value :=
fun {T} codec cell bytes read write next value compact future represented =>
  ⟨represented.left, fun i hi =>
    Eq.mpr
      (id
        (congrArg (fun _a => _a = codec.encode value i)
          (have this :=
            R1Z.PV_OWN_CollectorCursor.future_byte cell.contents bytes codec.width read write next i compact future;
          this)))
      (represented.right i hi)⟩
