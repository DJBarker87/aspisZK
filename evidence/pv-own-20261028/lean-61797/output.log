R1Z.PV_OWN_Laws.AllocDisjoint {S X E : Type}
  (prim : R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E (Option ℕ) × S)
  (r : R1Z.PV_OWN_Operations.Request) (w : R1Z.PV_OWN_Operations.State S X) (p q : ℕ) (s : S) (c : R1Z.PV_OWN_Heap.Cell)
  (adequate : R1Z.PV_OWN_Operations.AllocatorAdequate prim r w)
  (h : prim r w.allocator = (R1Z.PV_W_Threading.Outcome.ok (some p), s)) (old : w.memory.heap q = some c)
  (live : c.live = true) : q + c.size ≤ p ∨ p + r.size ≤ q
R1Z.PV_OWN_Laws.AllocDivergence {S X E : Type}
  (prim : R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E (Option ℕ) × S)
  (r : R1Z.PV_OWN_Operations.Request) (owner : ℕ) (w : R1Z.PV_OWN_Operations.State S X) (s : S)
  (h : prim r w.allocator = (R1Z.PV_W_Threading.Outcome.div, s)) :
  (R1Z.PV_OWN_Operations.allocate prim r owner w).world = { memory := w.memory, allocator := s, extra := w.extra }
R1Z.PV_OWN_Laws.AllocFailure {S X E : Type}
  (prim : R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E (Option ℕ) × S)
  (r : R1Z.PV_OWN_Operations.Request) (owner : ℕ) (w : R1Z.PV_OWN_Operations.State S X) (s : S) (e : E)
  (h : prim r w.allocator = (R1Z.PV_W_Threading.Outcome.fail e, s)) :
  (R1Z.PV_OWN_Operations.allocate prim r owner w).world = { memory := w.memory, allocator := s, extra := w.extra }
R1Z.PV_OWN_Laws.AllocFresh {S X E : Type}
  (prim : R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E (Option ℕ) × S)
  (r : R1Z.PV_OWN_Operations.Request) (w : R1Z.PV_OWN_Operations.State S X) (p : ℕ) (s : S)
  (adequate : R1Z.PV_OWN_Operations.AllocatorAdequate prim r w)
  (h : prim r w.allocator = (R1Z.PV_W_Threading.Outcome.ok (some p), s)) : p ≠ 0 ∧ r.alignment > 0 ∧ p % r.alignment = 0
R1Z.PV_OWN_Laws.AllocGeneration {S X E : Type}
  (prim : R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E (Option ℕ) × S)
  (r : R1Z.PV_OWN_Operations.Request) (owner p : ℕ) (w : R1Z.PV_OWN_Operations.State S X) (s : S)
  (h : prim r w.allocator = (R1Z.PV_W_Threading.Outcome.ok (some p), s)) :
  (R1Z.PV_OWN_Operations.allocate prim r owner w).world.memory.generations p = w.memory.generations p + 1
R1Z.PV_OWN_Laws.AllocNull {S X E : Type}
  (prim : R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E (Option ℕ) × S)
  (r : R1Z.PV_OWN_Operations.Request) (owner : ℕ) (w : R1Z.PV_OWN_Operations.State S X) (s : S)
  (h : prim r w.allocator = (R1Z.PV_W_Threading.Outcome.ok none, s)) :
  (R1Z.PV_OWN_Operations.allocate prim r owner w).world = { memory := w.memory, allocator := s, extra := w.extra }
R1Z.PV_OWN_Laws.AllocSpareUninit (r : R1Z.PV_OWN_Operations.Request) (owner i : ℕ) :
  (R1Z.PV_OWN_Heap.emptyCell r.size r.alignment owner).contents i = none
R1Z.PV_OWN_Laws.AllocSuccess {S X E : Type}
  (prim : R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E (Option ℕ) × S)
  (r : R1Z.PV_OWN_Operations.Request) (owner p : ℕ) (w : R1Z.PV_OWN_Operations.State S X) (s : S)
  (h : prim r w.allocator = (R1Z.PV_W_Threading.Outcome.ok (some p), s)) :
  (R1Z.PV_OWN_Operations.allocate prim r owner w).world.memory.heap p =
    some (R1Z.PV_OWN_Heap.emptyCell r.size r.alignment owner)
R1Z.PV_OWN_Laws.AllocTrace {S X E : Type}
  (prim : R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E (Option ℕ) × S)
  (r : R1Z.PV_OWN_Operations.Request) (owner : ℕ) (w : R1Z.PV_OWN_Operations.State S X) :
  (R1Z.PV_OWN_Operations.allocate prim r owner w).calls = [(w, R1Z.PV_OWN_Operations.Event.allocate r.size r.alignment)]
R1Z.PV_OWN_AllocationAbort.null {S X E A : Type}
  (primitive : R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E (Option ℕ) × S)
  (r : R1Z.PV_OWN_Operations.Request) (owner : ℕ) (abort : R1Z.PV_OWN_Operations.Action S X E A)
  (next : R1Z.PV_OWN_Heap.Token → R1Z.PV_OWN_Operations.Action S X E A) (w : R1Z.PV_OWN_Operations.State S X) (s : S)
  (h : primitive r w.allocator = (R1Z.PV_W_Threading.Outcome.ok none, s)) :
  R1Z.PV_OWN_AllocationAbort.request primitive r owner abort next w =
    { outcome := (abort { memory := w.memory, allocator := s, extra := w.extra }).outcome,
      world := (abort { memory := w.memory, allocator := s, extra := w.extra }).world,
      calls :=
        [(w, R1Z.PV_OWN_Operations.Event.allocate r.size r.alignment)] ++
          (abort { memory := w.memory, allocator := s, extra := w.extra }).calls }
R1Z.PV_OWN_AllocationAbort.divergence {S X E A : Type}
  (primitive : R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E (Option ℕ) × S)
  (r : R1Z.PV_OWN_Operations.Request) (owner : ℕ) (abort : R1Z.PV_OWN_Operations.Action S X E A)
  (next : R1Z.PV_OWN_Heap.Token → R1Z.PV_OWN_Operations.Action S X E A) (w : R1Z.PV_OWN_Operations.State S X) (s : S)
  (h : primitive r w.allocator = (R1Z.PV_W_Threading.Outcome.div, s)) :
  R1Z.PV_OWN_AllocationAbort.request primitive r owner abort next w =
    { outcome := R1Z.PV_W_Threading.Outcome.div, world := { memory := w.memory, allocator := s, extra := w.extra },
      calls := [(w, R1Z.PV_OWN_Operations.Event.allocate r.size r.alignment)] }
R1Z.PV_OWN_Laws.ArrayRead {T : Type} (k : R1Z.PV_OWN_View.Codec T) (c : R1Z.PV_OWN_Heap.Cell) (start i : ℕ)
  (xs : List T) (x : T) (h : R1Z.PV_OWN_Operations.ArrayView k c start xs) (hi : xs[i]? = some x) :
  R1Z.PV_OWN_View.Represents k c (start + i * k.width) x
R1Z.PV_OWN_Laws.BorrowBlocksWrite (m : R1Z.PV_OWN_Heap.Memory) (l : R1Z.PV_OWN_Heap.Loan) (slot : ℕ)
  (c : R1Z.PV_OWN_Heap.Cell) : ¬R1Z.PV_OWN_Heap.Writable (R1Z.PV_OWN_Operations.borrow l m) slot l.token c
R1Z.PV_OWN_Laws.BorrowHeap (m : R1Z.PV_OWN_Heap.Memory) (l : R1Z.PV_OWN_Heap.Loan) :
  (R1Z.PV_OWN_Operations.borrow l m).heap = m.heap ∧
    (R1Z.PV_OWN_Operations.borrow l m).slots = m.slots ∧ (R1Z.PV_OWN_Operations.borrow l m).generations = m.generations
R1Z.PV_OWN_Laws.BorrowOwned (m : R1Z.PV_OWN_Heap.Memory) (l : R1Z.PV_OWN_Heap.Loan) (slot : ℕ)
  (t : R1Z.PV_OWN_Heap.Token) (c : R1Z.PV_OWN_Heap.Cell) (h : R1Z.PV_OWN_Heap.Owned m slot t c) :
  R1Z.PV_OWN_Heap.Owned (R1Z.PV_OWN_Operations.borrow l m) slot t c
R1Z.PV_OWN_Laws.BorrowRelease (m : R1Z.PV_OWN_Heap.Memory) (l : R1Z.PV_OWN_Heap.Loan) :
  R1Z.PV_OWN_Operations.endBorrow (R1Z.PV_OWN_Operations.borrow l m) = m
R1Z.PV_OWN_Laws.BoxInitialized {T : Type} (k : R1Z.PV_OWN_View.Codec T) (m : R1Z.PV_OWN_Heap.Memory) (o : ℕ)
  (t : R1Z.PV_OWN_Heap.Token) (v : T) (h : R1Z.PV_OWN_Operations.BoxView k m o t v) : R1Z.PV_OWN_View.View k m t 0 v
R1Z.PV_OWN_ByteFrames.commute (old a b : R1Z.PV_OWN_Bytes.Bytes) (s n t m : ℕ) (disjoint : s + n ≤ t ∨ t + m ≤ s) :
  R1Z.PV_OWN_Bytes.overwrite (R1Z.PV_OWN_Bytes.overwrite old s n a) t m b =
    R1Z.PV_OWN_Bytes.overwrite (R1Z.PV_OWN_Bytes.overwrite old t m b) s n a
R1Z.PV_OWN_ByteFrames.fits_subrange (size start width i : ℕ) (fits : start + width ≤ size) (hi : i < width) :
  start + i < size
R1Z.PV_OWN_Bytes.inside (old value : R1Z.PV_OWN_Bytes.Bytes) (start width i : ℕ) (h : i < width) :
  R1Z.PV_OWN_Bytes.overwrite old start width value (start + i) = value i
R1Z.PV_OWN_Bytes.outside (old value : R1Z.PV_OWN_Bytes.Bytes) (start width i : ℕ) (h : i < start ∨ start + width ≤ i) :
  R1Z.PV_OWN_Bytes.overwrite old start width value i = old i
R1Z.PV_OWN_Bytes.empty (old value : R1Z.PV_OWN_Bytes.Bytes) (start : ℕ) :
  R1Z.PV_OWN_Bytes.overwrite old start 0 value = old
R1Z.PV_OWN_Bytes.shadow (old a b : R1Z.PV_OWN_Bytes.Bytes) (start width : ℕ) :
  R1Z.PV_OWN_Bytes.overwrite (R1Z.PV_OWN_Bytes.overwrite old start width a) start width b =
    R1Z.PV_OWN_Bytes.overwrite old start width b
R1Z.PV_OWN_Bytes.store_header (c : R1Z.PV_OWN_Heap.Cell) (s n : ℕ) (v : R1Z.PV_OWN_Bytes.Bytes) :
  (R1Z.PV_OWN_Bytes.store c s n v).size = c.size ∧
    (R1Z.PV_OWN_Bytes.store c s n v).alignment = c.alignment ∧
      (R1Z.PV_OWN_Bytes.store c s n v).capacity = c.capacity ∧
        (R1Z.PV_OWN_Bytes.store c s n v).owner = c.owner ∧ (R1Z.PV_OWN_Bytes.store c s n v).live = c.live
R1Z.PV_OWN_CheckedAlloc.fresh {S X E : Type}
  (primitive : R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E (Option ℕ) × S)
  (w : R1Z.PV_OWN_Operations.State S X) (cmd : R1Z.PV_OWN_CheckedAlloc.Command primitive w) (p : ℕ) (s : S)
  (h : primitive cmd.request w.allocator = (R1Z.PV_W_Threading.Outcome.ok (some p), s)) (c : R1Z.PV_OWN_Heap.Cell) :
  w.memory.heap p = some c → c.live = true → False
R1Z.PV_OWN_CheckedAlloc.owned_success {S X E : Type}
  (primitive : R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E (Option ℕ) × S)
  (w : R1Z.PV_OWN_Operations.State S X) (cmd : R1Z.PV_OWN_CheckedAlloc.Command primitive w) (p : ℕ) (s : S)
  (h : primitive cmd.request w.allocator = (R1Z.PV_W_Threading.Outcome.ok (some p), s)) :
  R1Z.PV_OWN_Heap.Owned (R1Z.PV_OWN_Operations.allocate primitive cmd.request cmd.owner w).world.memory cmd.owner
    { address := p, generation := w.memory.generations p + 1 }
    (R1Z.PV_OWN_Heap.emptyCell cmd.request.size cmd.request.alignment cmd.owner)
R1Z.PV_OWN_CheckedMove.transferred {m : R1Z.PV_OWN_Heap.Memory} (c : R1Z.PV_OWN_CheckedMove.Command m) :
  R1Z.PV_OWN_Heap.Owned (R1Z.PV_OWN_CheckedMove.execute c) c.destination c.token
    (have __src := c.cell;
    { size := __src.size, alignment := __src.alignment, capacity := __src.capacity, contents := __src.contents,
      owner := c.destination, live := __src.live })
R1Z.PV_OWN_CheckedMove.source_consumed {m : R1Z.PV_OWN_Heap.Memory} (c : R1Z.PV_OWN_CheckedMove.Command m) :
  (R1Z.PV_OWN_CheckedMove.execute c).slots c.source = none
R1Z.PV_OWN_CheckedStore.representation {T : Type} {k : R1Z.PV_OWN_View.Codec T} {m : R1Z.PV_OWN_Heap.Memory}
  (c : R1Z.PV_OWN_CheckedStore.Command k m) :
  R1Z.PV_OWN_View.View k (R1Z.PV_OWN_CheckedStore.execute c) c.token c.offset c.value
R1Z.PV_OWN_CheckedStore.frame {T : Type} {k : R1Z.PV_OWN_View.Codec T} {m : R1Z.PV_OWN_Heap.Memory}
  (c : R1Z.PV_OWN_CheckedStore.Command k m) (a : ℕ) (h : a ≠ c.token.address) :
  (R1Z.PV_OWN_CheckedStore.execute c).heap a = m.heap a
R1Z.PV_OWN_CollectorCursor.before_unread (width read write next : ℕ) (compact : write ≤ read) (unread : read < next) :
  write * width + width ≤ next * width
R1Z.PV_OWN_CollectorCursor.future_byte (old value : R1Z.PV_OWN_Bytes.Bytes) (width read write next j : ℕ)
  (compact : write ≤ read) (unread : read < next) :
  R1Z.PV_OWN_Bytes.overwrite old (write * width) width value (next * width + j) = old (next * width + j)
R1Z.PV_OWN_CollectorCursor.reject_progress (read write : ℕ) (compact : write ≤ read) : write ≤ read + 1
R1Z.PV_OWN_CollectorCursor.keep_progress (read write : ℕ) (compact : write ≤ read) : write + 1 ≤ read + 1
R1Z.PV_OWN_CollectorFrame.unread {T : Type} (codec : R1Z.PV_OWN_View.Codec T) (cell : R1Z.PV_OWN_Heap.Cell)
  (bytes : R1Z.PV_OWN_Bytes.Bytes) (read write next : ℕ) (value : T) (compact : write ≤ read) (future : read < next)
  (represented : R1Z.PV_OWN_View.Represents codec cell (next * codec.width) value) :
  R1Z.PV_OWN_View.Represents codec (R1Z.PV_OWN_Bytes.store cell (write * codec.width) codec.width bytes)
    (next * codec.width) value
R1Z.PV_OWN_ConcreteDrop.positive_request {S X E : Type}
  (dealloc : ℕ → R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E Unit × S) (t : R1Z.PV_OWN_Heap.Token)
  (cap width alignment owner : ℕ) (w : R1Z.PV_OWN_Operations.State S X) (positive : cap * width ≠ 0) :
  (R1Z.PV_OWN_Operations.dropVecPod dealloc t (R1Z.PV_OWN_ConcreteDrop.header cap width alignment owner) w).calls =
    [(w, R1Z.PV_OWN_Operations.Event.deallocate t.address (cap * width) alignment)]
R1Z.PV_OWN_ConcreteDrop.zero_request {S X E : Type}
  (dealloc : ℕ → R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E Unit × S) (t : R1Z.PV_OWN_Heap.Token)
  (width alignment owner : ℕ) (w : R1Z.PV_OWN_Operations.State S X) :
  (R1Z.PV_OWN_Operations.dropVecPod dealloc t (R1Z.PV_OWN_ConcreteDrop.header 0 width alignment owner) w).calls = []
R1Z.PV_OWN_ConcreteDrop.row_layouts : 254 * 8 = 2032 ∧ 272 * 2 = 544 ∧ 69 * 1 = 69 ∧ 1024 * 24 = 24576
R1Z.PV_OWN_ConcreteDrop.array_no_heap {S X E : Type} (w : R1Z.PV_OWN_Operations.State S X) :
  (R1Z.PV_OWN_Operations.dropPod w).calls = []
R1Z.PV_OWN_Laws.DropConsumeBeforeGlue {S X : Type} (slot : ℕ) (w : R1Z.PV_OWN_Operations.State S X) :
  (R1Z.PV_OWN_Operations.take slot w.memory).slots slot = none
R1Z.PV_OWN_DropGate.preworld {S X E : Type} (w : R1Z.PV_OWN_Operations.State S X)
  (c : R1Z.PV_OWN_DropGate.Command w.memory) (glue : R1Z.PV_OWN_Heap.Token → R1Z.PV_OWN_Operations.Action S X E Unit) :
  R1Z.PV_OWN_DropGate.execute w c glue =
    glue c.token { memory := R1Z.PV_OWN_Operations.take c.owner w.memory, allocator := w.allocator, extra := w.extra }
R1Z.PV_OWN_DropGate.loan_blocks (m : R1Z.PV_OWN_Heap.Memory) (l : R1Z.PV_OWN_Heap.Loan) : ¬∃ c, c.token = l.token
R1Z.PV_OWN_Laws.DropOwnedAbsent {S X E : Type} (slot : ℕ)
  (glue : R1Z.PV_OWN_Heap.Token → R1Z.PV_OWN_Operations.Action S X E Unit) (w : R1Z.PV_OWN_Operations.State S X)
  (h : w.memory.slots slot = none) : (R1Z.PV_OWN_Operations.dropOwned slot glue w).calls = []
R1Z.PV_OWN_Laws.DropOwnedPresent {S X E : Type} (slot : ℕ)
  (glue : R1Z.PV_OWN_Heap.Token → R1Z.PV_OWN_Operations.Action S X E Unit) (w : R1Z.PV_OWN_Operations.State S X)
  (t : R1Z.PV_OWN_Heap.Token) (h : w.memory.slots slot = some t) :
  R1Z.PV_OWN_Operations.dropOwned slot glue w =
    glue t { memory := R1Z.PV_OWN_Operations.take slot w.memory, allocator := w.allocator, extra := w.extra }
R1Z.PV_OWN_Laws.DropPod {S X E : Type} (w : R1Z.PV_OWN_Operations.State S X) :
  (R1Z.PV_OWN_Operations.dropPod w).outcome = R1Z.PV_W_Threading.Outcome.ok () ∧
    (R1Z.PV_OWN_Operations.dropPod w).world = w ∧ (R1Z.PV_OWN_Operations.dropPod w).calls = []
R1Z.PV_OWN_Laws.DropString {S X E : Type}
  (prim : ℕ → R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E Unit × S) (t : R1Z.PV_OWN_Heap.Token)
  (c : R1Z.PV_OWN_Heap.Cell) : R1Z.PV_OWN_Operations.dropString prim t c = R1Z.PV_OWN_Operations.dropVecPod prim t c
R1Z.PV_OWN_Laws.ExclusiveBlocksRead (m : R1Z.PV_OWN_Heap.Memory) (l : R1Z.PV_OWN_Heap.Loan) (slot : ℕ)
  (c : R1Z.PV_OWN_Heap.Cell) (hx : l.exclusive = true) :
  ¬R1Z.PV_OWN_Operations.Readable (R1Z.PV_OWN_Operations.borrow l m) slot l.token c
R1Z.PV_OWN_Laws.FreeAllocator {S X E : Type}
  (prim : ℕ → R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E Unit × S) (t : R1Z.PV_OWN_Heap.Token)
  (c : R1Z.PV_OWN_Heap.Cell) (w : R1Z.PV_OWN_Operations.State S X) :
  (R1Z.PV_OWN_Operations.free prim t c w).world.allocator =
    (prim t.address { size := c.size, alignment := c.alignment } w.allocator).2
R1Z.PV_OWN_Laws.FreeExtra {S X E : Type}
  (prim : ℕ → R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E Unit × S) (t : R1Z.PV_OWN_Heap.Token)
  (c : R1Z.PV_OWN_Heap.Cell) (w : R1Z.PV_OWN_Operations.State S X) :
  (R1Z.PV_OWN_Operations.free prim t c w).world.extra = w.extra
R1Z.PV_OWN_Laws.FreeOutcome {S X E : Type}
  (prim : ℕ → R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E Unit × S) (t : R1Z.PV_OWN_Heap.Token)
  (c : R1Z.PV_OWN_Heap.Cell) (w : R1Z.PV_OWN_Operations.State S X) :
  (R1Z.PV_OWN_Operations.free prim t c w).outcome =
    (prim t.address { size := c.size, alignment := c.alignment } w.allocator).1
R1Z.PV_OWN_Laws.FreeTrace {S X E : Type}
  (prim : ℕ → R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E Unit × S) (t : R1Z.PV_OWN_Heap.Token)
  (c : R1Z.PV_OWN_Heap.Cell) (w : R1Z.PV_OWN_Operations.State S X) :
  (R1Z.PV_OWN_Operations.free prim t c w).calls =
    [(w, R1Z.PV_OWN_Operations.Event.deallocate t.address c.size c.alignment)]
R1Z.PV_OWN_Growth.prefix_bytes (c : R1Z.PV_OWN_Heap.Cell) (newSize newCap i : ℕ) (h : i < c.size) :
  (R1Z.PV_OWN_Growth.grownCell c newSize newCap).contents i = c.contents i
R1Z.PV_OWN_Growth.spare (c : R1Z.PV_OWN_Heap.Cell) (newSize newCap i : ℕ) (h : c.size ≤ i) :
  (R1Z.PV_OWN_Growth.grownCell c newSize newCap).contents i = none
R1Z.PV_OWN_Growth.typed_prefix {T : Type} (k : R1Z.PV_OWN_View.Codec T) (c : R1Z.PV_OWN_Heap.Cell)
  (newSize newCap s : ℕ) (v : T) (grow : c.size ≤ newSize) (h : R1Z.PV_OWN_View.Represents k c s v) :
  R1Z.PV_OWN_View.Represents k (R1Z.PV_OWN_Growth.grownCell c newSize newCap) s v
R1Z.PV_OWN_Growth.same_address_live (m : R1Z.PV_OWN_Heap.Memory) (t : R1Z.PV_OWN_Heap.Token) (c : R1Z.PV_OWN_Heap.Cell)
  (n cap : ℕ) :
  (R1Z.PV_OWN_Growth.relocate m t c t.address n cap).heap t.address = some (R1Z.PV_OWN_Growth.grownCell c n cap)
R1Z.PV_OWN_Growth.distinct_address_dead (m : R1Z.PV_OWN_Heap.Memory) (t : R1Z.PV_OWN_Heap.Token)
  (c : R1Z.PV_OWN_Heap.Cell) (p n cap : ℕ) (h : t.address ≠ p) :
  (R1Z.PV_OWN_Growth.relocate m t c p n cap).heap t.address =
    some
      { size := c.size, alignment := c.alignment, capacity := c.capacity, contents := c.contents, owner := c.owner,
        live := false }
R1Z.PV_OWN_Growth.stale_generation (m : R1Z.PV_OWN_Heap.Memory) (t : R1Z.PV_OWN_Heap.Token) (c : R1Z.PV_OWN_Heap.Cell)
  (n cap : ℕ) (generation : m.generations t.address = t.generation) :
  (R1Z.PV_OWN_Growth.relocate m t c t.address n cap).generations t.address ≠ t.generation
R1Z.PV_OWN_Heap.put_same (h : R1Z.PV_OWN_Heap.Heap) (p : ℕ) (c : Option R1Z.PV_OWN_Heap.Cell) :
  R1Z.PV_OWN_Heap.put h p c p = c
R1Z.PV_OWN_Heap.put_other (h : R1Z.PV_OWN_Heap.Heap) (p a : ℕ) (c : Option R1Z.PV_OWN_Heap.Cell) (hne : a ≠ p) :
  R1Z.PV_OWN_Heap.put h p c a = h a
