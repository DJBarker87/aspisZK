  (destination offset : ℕ) (v : T),
  request.oldCapacity ≤ request.newCapacity →
    c.size = request.oldCapacity * request.shape.width →
      (∀ i < c.size, memory (request.address + i) = Option.map UInt8.toNat (c.contents i)) →
        R1Z.PV_OWN_View.Represents codec c offset v →
          ∀ i < codec.width,
            R1Z.PV_RDB1_V183_ReserveWorld.memoryAfter request destination memory (destination + (offset + i)) =
              Option.map UInt8.toNat (codec.encode v i) :=
fun {T} codec request memory c destination offset v grow size association repr i hi =>
  have hin :=
    have hh := repr.left;
    Decidable.byContradiction fun a => R1Z.PV_OWN_Reserve.typed_prefix._proof_1 codec request c offset size i hi hh a;
  Eq.mpr
    (id
      (congrArg (fun _a => _a = Option.map UInt8.toNat (codec.encode v i))
        (R1Z.PV_OWN_Reserve.initialized_prefix request memory c destination grow size association (offset + i) hin)))
    (Eq.mpr
      (id
        (congrArg (fun _a => Option.map UInt8.toNat _a = Option.map UInt8.toNat (codec.encode v i)) (repr.right i hi)))
      (Eq.refl (Option.map UInt8.toNat (codec.encode v i))))
'R1Z.PV_OWN_Reserve.typed_prefix' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem R1Z.PV_OWN_Unique.move_preserves : ∀ (m : R1Z.PV_OWN_Heap.Memory) (src dst : ℕ) (t : R1Z.PV_OWN_Heap.Token)
  (c : R1Z.PV_OWN_Heap.Cell),
  R1Z.PV_OWN_Unique.Unique m →
    m.slots src = some t →
      m.slots dst = none → dst ≠ src → R1Z.PV_OWN_Unique.Unique (R1Z.PV_OWN_Operations.move src dst t c m) :=
fun m src dst t c unique source empty distinct i j u hi hj =>
  have ni := fun h =>
    Eq.ndrec (motive := fun i => (R1Z.PV_OWN_Operations.move src dst t c m).slots i = some u → False)
      (fun hi =>
        False.elim
          (Eq.mp
            (Eq.trans
              (congrFun' (congrArg Eq (ite_cond_eq_true none (if src = dst then some t else m.slots src) (eq_self src)))
                (some u))
              (eq_false' fun h => False.elim (noConfusion_of_Nat Option.ctorIdx h)))
            hi))
      (Eq.symm h) hi;
  have nj := fun h =>
    Eq.ndrec (motive := fun j => (R1Z.PV_OWN_Operations.move src dst t c m).slots j = some u → False)
      (fun hj =>
        False.elim
          (Eq.mp
            (Eq.trans
              (congrFun' (congrArg Eq (ite_cond_eq_true none (if src = dst then some t else m.slots src) (eq_self src)))
                (some u))
              (eq_false' fun h => False.elim (noConfusion_of_Nat Option.ctorIdx h)))
            hj))
      (Eq.symm h) hj;
  if di : i = dst then
    Eq.ndrec (motive := fun i => i ≠ src → (if i = dst then some t else m.slots i) = some u → i = j)
      (fun ni hi =>
        let ⟨⟩ := some u
        Eq.mp
          (congrFun' (congrArg Eq (ite_congr (eq_self dst) (fun a => Eq.refl (some t)) fun a => Eq.refl (m.slots dst)))
            (some u))
          hi)
      (Eq.symm di) ni
      (Eq.mp
        (congrFun'
          (congrArg Eq
            (ite_congr (eq_false ni) (fun a => Eq.refl none) fun a => Eq.refl (if i = dst then some t else m.slots i)))
          (some u))
        hi)
  else
    if dj : j = dst then
      Eq.ndrec (motive := fun j => j ≠ src → (if j = dst then some t else m.slots j) = some u → i = j)
        (fun nj hj =>
          let ⟨⟩ := some u
          Eq.mp
            (congrFun'
              (congrArg Eq (ite_congr (eq_self dst) (fun a => Eq.refl (some t)) fun a => Eq.refl (m.slots dst)))
              (some u))
            hj)
        (Eq.symm dj) nj
        (Eq.mp
          (congrFun'
            (congrArg Eq
              (ite_congr (eq_false nj) (fun a => Eq.refl none) fun a =>
                Eq.refl (if j = dst then some t else m.slots j)))
            (some u))
          hj)
    else
      unique i j u
        (Eq.mp
          (congrFun' (congrArg Eq (ite_congr (eq_false di) (fun a => Eq.refl (some t)) fun a => Eq.refl (m.slots i)))
            (some u))
          (Eq.mp
            (congrFun'
              (congrArg Eq
                (ite_congr (eq_false ni) (fun a => Eq.refl none) fun a =>
                  Eq.refl (if i = dst then some t else m.slots i)))
              (some u))
            hi))
        (Eq.mp
          (congrFun' (congrArg Eq (ite_congr (eq_false dj) (fun a => Eq.refl (some t)) fun a => Eq.refl (m.slots j)))
            (some u))
          (Eq.mp
            (congrFun'
              (congrArg Eq
                (ite_congr (eq_false nj) (fun a => Eq.refl none) fun a =>
                  Eq.refl (if j = dst then some t else m.slots j)))
              (some u))
            hj))
'R1Z.PV_OWN_Unique.move_preserves' depends on axioms: [propext]
