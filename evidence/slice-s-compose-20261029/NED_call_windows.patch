+fn NED_frontier()->[Digest;20] {[NED_digest(),NED_digest(),NED_digest(),NED_digest(),NED_digest(),NED_digest(),NED_digest(),NED_digest(),NED_digest(),NED_digest(),NED_digest(),NED_digest(),NED_digest(),NED_digest(),NED_digest(),NED_digest(),NED_digest(),NED_digest(),NED_digest(),NED_digest()]}
+fn NED_common()->PoolV1PairForestTerminalCommonV1 {PoolV1PairForestTerminalCommonV1{master_account:kani::any(),checkpoint_account:kani::any(),selected_lane_account:kani::any(),output_lane:kani::any(),checkpoint_sequence:kani::any(),historical_global_anchor:NED_digest(),lane_transition:PoolV1PairLatePublicStatementV1{live_snapshot:super::super::PoolV1PairLiveSnapshotV1{pool:kani::any(),deployment_domain:kani::any(),sequence:kani::any(),next_pair_index:kani::any(),current_root:NED_digest(),frontier:NED_frontier()},candidate_afterstate:PoolV1PairVerifiedAfterstateV1{next_pair_index:kani::any(),next_root:NED_digest(),next_frontier:NED_frontier()}}}}
+fn NED_statement()->PoolV1PairForestTerminalStatementV1 {
+ if kani::any::<bool>() {PoolV1PairForestTerminalStatementV1::PrivateTransfer{common:NED_common(),public:PoolV1PrivateTransferPublicV1{pool:kani::any(),deployment_domain:kani::any(),anchor_sequence:kani::any(),anchor_root:NED_digest(),nullifier:NED_digest(),asset_id:M31(kani::any()),change_commitment:NED_digest(),recipient_commitment:NED_digest()}}}
+ else {PoolV1PairForestTerminalStatementV1::Withdrawal{common:NED_common(),public:PoolV1WithdrawalPublicV1{pool:kani::any(),deployment_domain:kani::any(),anchor_sequence:kani::any(),anchor_root:NED_digest(),nullifier:NED_digest(),asset_id:M31(kani::any()),change_commitment:NED_digest(),amount:kani::any(),destination_token_account:kani::any()}}}
