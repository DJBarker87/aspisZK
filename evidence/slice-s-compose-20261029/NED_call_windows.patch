+ if !selected(1){return false} check(core::ptr::eq(d,unsafe {&(*ROOT).common().historical_global_anchor}));true
+}
+pub(super) fn lane(d:&Digest)->bool {
+ if !selected(4){return false} let j=unsafe {PROBE};kani::assume(j<8);
+ let expected=unsafe {match &*ROOT {PoolV1PairForestTerminalStatementV1::PrivateTransfer{public,..}=>public.nullifier[j].0,
+ PoolV1PairForestTerminalStatementV1::Withdrawal{public,..}=>public.nullifier[j].0}};
+ check(d[j].0==expected);true
