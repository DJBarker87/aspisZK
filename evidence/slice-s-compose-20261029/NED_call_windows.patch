+pub(super) fn base(p:*const u8){unsafe {BASE=p;}}
+pub(super) fn root(s:&PoolV1PairForestTerminalStatementV1)->bool {
+ if !selected(0){return false} check(core::ptr::eq(s,unsafe {&*ROOT}));true
+}
+pub(super) fn payment(t:u8,p:*const (),transfer:bool)->bool {
+ if !selected(t){return false}
+ let expected=unsafe {match &*ROOT {
+ PoolV1PairForestTerminalStatementV1::PrivateTransfer{public,..}=>{assert!(transfer);public as *const _ as *const ()},
+ PoolV1PairForestTerminalStatementV1::Withdrawal{public,..}=>{assert!(!transfer);public as *const _ as *const ()},
+ }};check(p==expected);true
