+// Domain-only decoder call windows. No decoder value/effects bridge credit.
+#![allow(non_snake_case)]
+use super::*;
+static mut BASE:*const u8=core::ptr::null();
+static mut MODE:u8=0;
+static mut NEG:bool=false;
+static mut PROBE:usize=0;
+static mut SEEN:u8=0;
+static mut COMMON:*const PoolV1PairForestTerminalCommonV1=core::ptr::null();
+pub(super) fn window(payload:&[u8],kind:PoolV1TransitionKind,common:*const PoolV1PairForestTerminalCommonV1)->bool{
+ let offset=unsafe{if MODE==0 {104}else{1664}};let j=unsafe{PROBE};kani::assume(j<216);
+ let same=payload.len()==216 && payload.as_ptr()==unsafe{BASE.add(offset)} && payload[j]==unsafe{*BASE.add(offset+j)};
+ assert!(same!=unsafe{NEG},"NED decode payload window");
+ assert!((kind as u8)==unsafe{*BASE.add(5)});
+ if unsafe{MODE}==1 {assert!(common==unsafe{COMMON});}
+ unsafe{SEEN=kind as u8;} true
+}
+fn zero_common()->PoolV1PairForestTerminalCommonV1{
+ let digest=[M31(0);8];
+ PoolV1PairForestTerminalCommonV1{master_account:[0;32],checkpoint_account:[0;32],selected_lane_account:[0;32],output_lane:0,
+ checkpoint_sequence:0,historical_global_anchor:digest,lane_transition:PoolV1PairLatePublicStatementV1{
+ live_snapshot:super::super::PoolV1PairLiveSnapshotV1{pool:[0;32],deployment_domain:[0;32],sequence:0,next_pair_index:0,current_root:digest,frontier:[digest;20]},
+ candidate_afterstate:PoolV1PairVerifiedAfterstateV1{next_pair_index:0,next_root:digest,next_frontier:[digest;20]}}}
+}
+fn common_reply(_: &[u8])->Result<Box<PoolV1PairForestTerminalCommonV1>,PoolV1PairForestTerminalFormatErrorV1>{
+ if kani::any(){let value=Box::new(zero_common());unsafe{COMMON=value.as_ref();}Ok(value)}else{Err(PoolV1PairForestTerminalFormatErrorV1::WrongLength)}
+}
+fn run(mode:u8,negative:bool){unsafe{MODE=mode;NEG=negative;PROBE=kani::any();SEEN=0;}
+ if mode==0{let bytes:[u8;320]=kani::any();unsafe{BASE=bytes.as_ptr();}let _=decode_pool_v1_pair_forest_terminal_request_v1(&bytes);}
+ else{let bytes:[u8;1880]=kani::any();unsafe{BASE=bytes.as_ptr();}let _=decode_pool_v1_pair_forest_terminal_statement_v1(&bytes);}
+ kani::cover!(unsafe{SEEN}==PoolV1TransitionKind::PrivateTransfer as u8,"NED decode transfer");
+ kani::cover!(unsafe{SEEN}==PoolV1TransitionKind::Withdrawal as u8,"NED decode withdrawal");
+}
