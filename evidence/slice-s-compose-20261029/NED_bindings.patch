+fn parts(negative:bool){let s=NED_statement();let (pool,domain,sequence,anchor,nullifier,asset)=statement_public_common(&s);
+ let k:u8=kani::any();kani::assume(k<6);let j:usize=kani::any();
+ let good=match &s{
+ PoolV1PairForestTerminalStatementV1::PrivateTransfer{public,..}=>match k{
+ 0=>{kani::assume(j<32);pool[j]==public.pool[j]},1=>{kani::assume(j<32);domain[j]==public.deployment_domain[j]},
