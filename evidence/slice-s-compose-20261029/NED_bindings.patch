+fn validator_control(negative:bool){let s=NED_statement();
+ let payment=if kani::any(){Ok(kani::any())}else{Err(NED_any_PoolV1PaymentStatementFormatError())};
+ let lane=if kani::any(){Ok(kani::any())}else{Err(NED_any_PoolV1PairForestAccountErrorV1())};
+ let late=if kani::any(){Ok(())}else{Err(NED_any_PoolV1PairLatePublicStatementErrorV1())};
+ unsafe{TRACE=Trace{len:0,log:[0;3]};PAYMENT=payment;LANE=lane;LATE=late;}
+ let actual=validate_pool_v1_pair_forest_terminal_statement_v1(&s);let observed=unsafe{TRACE};
+ let mut expected_log=Trace{len:0,log:[0;3]};let expected=validator_ref(&s,payment,lane,late,&mut expected_log);
+ check(actual==expected && observed==expected_log,negative);
+ covers(&s);
+ kani::cover!(actual.is_ok(),"NED native validator success");
+ kani::cover!(observed.len==3,"NED all three native calls");
+}
