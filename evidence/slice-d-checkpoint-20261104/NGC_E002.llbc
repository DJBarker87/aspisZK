{"charon_version":"0.1.223","translated":{"crate_name":"ngc_reference","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::filled_ref"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["core::option::Option","core::result::Result","core::option::_::ok_or"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-slice-d-checkpoint-20261104/NGC_E002.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"ngc_reference","contents":"#![no_std]\nextern crate alloc;\nuse alloc::vec::Vec;\n// hashv is an external runtime call. Its complete reply is the explicit\n// observation supplied to this safe reference; no SHA computation is modeled.\npub fn digest_ref(_parts:&[&[u8]],reply:[u8;32])->[u8;32]{reply}\n#[derive(Clone,Copy)]\npub struct Q{pub limbs:[u32;4]}\npub fn finish_step_ref(weights:&mut[Q],index:usize,value:Q){weights[index]=value;}\npub fn filled_ref(n:usize,value:Q,reserved:bool)->Result<Vec<Q>,()>{\n if !reserved{return Err(());}\n let mut out=Vec::new();out.resize(n,value);Ok(out)\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":4,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":5,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["ngc_reference",0]},{"Ident":["filled_ref",0]}]},{"key":{"Type":0},"value":[{"Ident":["ngc_reference",0]},{"Ident":["Q",0]}]},{"key":{"Type":1},"value":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}]},{"key":{"Type":2},"value":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Ident":["Vec",0]}]},{"key":{"Type":3},"value":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Ident":["Global",0]}]},{"key":{"Fun":1},"value":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"HashConsedValue":[558,{"Adt":{"id":{"Adt":2},"generics":{"regions":[],"types":[{"HashConsedValue":[430,{"TypeVar":{"Bound":[0,0]}}]}],"const_generics":[],"trait_refs":[]}}}]},"kind":"InherentImplBlock"}}},{"Ident":["new",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["core",0]},{"Ident":["clone",0]},{"Ident":["Clone",0]}]},{"key":{"Fun":2},"value":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Impl":{"Ty":{"params