def Aeneas.Std.UScalar.shiftRight_IScalar : {ty : UScalarTy} →
  {tys : IScalarTy} → UScalar ty → IScalar tys → Result (UScalar ty) :=
fun {ty} {tys} x s => if ↑s ≥ 0 then x.shiftRight s.toNat else Result.fail Error.integerOverflow
def Aeneas.Std.UScalar.shiftRight : {ty : Aeneas.Std.UScalarTy} →
  (x : Aeneas.Std.UScalar ty) → (s : Nat) → Aeneas.Std.Result.{0} (Aeneas.Std.UScalar ty) :=
fun {ty : Aeneas.Std.UScalarTy} (x : Aeneas.Std.UScalar ty) (s : Nat) =>
  @ite.{1} (Aeneas.Std.Result.{0} (Aeneas.Std.UScalar ty))
    (@LT.lt.{0} Nat instLTNat s (Aeneas.Std.UScalarTy.numBits ty)) (Nat.decLt s (Aeneas.Std.UScalarTy.numBits ty))
    (@Aeneas.Std.Result.ok.{0} (Aeneas.Std.UScalar ty)
      (@Aeneas.Std.UScalar.mk ty
        (@BitVec.ushiftRight (Aeneas.Std.UScalarTy.numBits ty) (@Aeneas.Std.UScalar.bv ty x) s)))
    (@Aeneas.Std.Result.fail.{0} (Aeneas.Std.UScalar ty) Aeneas.Std.Error.integerOverflow)
def Aeneas.Std.UScalar.val : {ty : UScalarTy} → UScalar ty → ℕ :=
fun {ty} x => x.bv.toNat
