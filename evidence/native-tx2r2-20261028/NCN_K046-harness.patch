+#[kani::stub_verified(Reader::k)]
+fn order_ok(){let bytes:[u8;1768]=kani::any();let out=read_checkpoint_semantic_alpha(&bytes,408);let calls=unsafe{CALLS};assert!(calls>=1&&calls<=10);let j:usize=kani::any();kani::assume(j<calls);
+assert!(unsafe{INPUT[j]}==408+16*j);assert!(unsafe{OUTPUT[j]}==424+16*j);
+}
+#[kani::proof] #[kani::unwind(40)]
+#[kani::stub(core::ptr::copy_nonoverlapping,NCI_kmx::KMX_copy_nonoverlapping)]
+#[kani::stub(<[u8]>::copy_from_slice,NCI_kmx::KMX_copy_from_slice)]
+#[kani::stub_verified(Reader::k)]
+fn order_wrong(){let bytes:[u8;1768]=kani::any();let out=read_checkpoint_semantic_alpha(&bytes,408);let calls=unsafe{CALLS};assert!(calls>=1&&calls<=10);let j:usize=kani::any();kani::assume(j<calls);
+assert!(unsafe{INPUT[j]}!=408+16*j);assert!(unsafe{OUTPUT[j]}==424+16*j);
+}
+#[kani::proof] #[kani::unwind(40)]
+#[kani::stub(core::ptr::copy_nonoverlapping,NCI_kmx::KMX_copy_nonoverlapping)]
+#[kani::stub(<[u8]>::copy_from_slice,NCI_kmx::KMX_copy_from_slice)]
+#[kani::stub_verified(Reader::k)]
+fn values_ok(){let bytes:[u8;1768]=kani::any();let out=read_checkpoint_semantic_alpha(&bytes,408);let calls=unsafe{CALLS};assert!(calls>=1&&calls<=10);let j:usize=kani::any();kani::assume(j<calls);
+if let Ok((values,at))=out{assert!(calls==10&&at==568);assert!(values[j]==unsafe{REPLY[j]});assert!(unsafe{GOOD[j]});}
+}
+#[kani::proof] #[kani::unwind(40)]
+#[kani::stub(core::ptr::copy_nonoverlapping,NCI_kmx::KMX_copy_nonoverlapping)]
+#[kani::stub(<[u8]>::copy_from_slice,NCI_kmx::KMX_copy_from_slice)]
+#[kani::stub_verified(Reader::k)]
+fn values_wrong(){let bytes:[u8;1768]=kani::any();let out=read_checkpoint_semantic_alpha(&bytes,408);let calls=unsafe{CALLS};assert!(calls>=1&&calls<=10);let j:usize=kani::any();kani::assume(j<calls);
+if let Ok((values,at))=out{assert!(calls==10&&at==568);assert!(values[j]!=unsafe{REPLY[j]});assert!(unsafe{GOOD[j]});}
+}
+#[kani::proof] #[kani::unwind(40)]
+#[kani::stub(core::ptr::copy_nonoverlapping,NCI_kmx::KMX_copy_nonoverlapping)]
+#[kani::stub(<[u8]>::copy_from_slice,NCI_kmx::KMX_copy_from_slice)]
