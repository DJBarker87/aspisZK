+fn prefix_ok(){
+let bytes:[u8;1768]=kani::any();let slot:usize=kani::any();kani::assume(slot<7);let start=80+32*slot;
+let j:usize=kani::any();kani::assume(j<32);let k:usize=kani::any();kani::assume(k<1768);
+let want=bytes[start+j];let frame=bytes[k];let ptr=bytes.as_ptr();
+let mut r=Reader{bytes:&bytes,at:start};let out=r.raw::<32>();
+assert!(out[j]==want);assert!(r.at==start+32);assert!(r.bytes.as_ptr()==ptr);assert!(r.bytes.len()==1768);assert!(r.bytes[k]==frame);
