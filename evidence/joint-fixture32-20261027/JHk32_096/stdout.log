              AspisR1.Tx1Q_Carriers.e out.rhs = AspisR1.JFq_Rhs.scalar :=
fun p input scratch initial out pending after g prepare queries init pend geo query =>
  have meaning :=
    AspisR1.JHk_CurrentRhsFormula.source p input scratch initial out pending after g prepare queries init pend geo
      query;
  let ⟨out1, h✝⟩ := AspisR1.JHc_QueryPost.source p input scratch initial pending g prepare queries init pend geo
  let ⟨after1, h✝¹⟩ := h✝
  let ⟨flushed, h✝²⟩ := h✝¹
  let ⟨run, right✝⟩ := h✝²
  let ⟨flush, right✝¹⟩ := right✝
  let ⟨next, right✝²⟩ := right✝¹
  let ⟨length, right✝³⟩ := right✝²
  let ⟨variant, right✝⁴⟩ := right✝³
  let ⟨canon, cp⟩ := right✝⁴
  have same :=
    congrArg Prod.fst (Aeneas.Std.core.result.Result.Ok.inj (Aeneas.Std.Result.ok.inj (Eq.trans (Eq.symm run) query)));
  id
    (fun same =>
      AspisR1.JHk_EUnique.source (AspisR1.Tx1Q_Carriers.e out.rhs) AspisR1.JFq_Rhs.scalar
        (Eq.mp
          (congrArg (fun _a => AspisR1.Port4C_QueryArithmetic.CanonE (AspisR1.Tx1Q_Carriers.accumulator _a).rhs) same)
          canon)
        AspisR1.JFn_AccumulatorCanonical.rhs meaning)
    same
