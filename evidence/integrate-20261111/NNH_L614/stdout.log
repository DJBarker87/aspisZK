Aeneas.Std.Slice.index_usize_spec.{u} {α : Type u} (v : Slice α) (i : Usize) (hbound : ↑i < v.length) :
  v.index_usize i ⦃ x => x = (↑v)[↑i] ⦄
List.getElem?_eq_some_iff.{u_1} {α : Type u_1} {i : ℕ} {a : α} {l : List α} :
  l[i]? = some a ↔ ∃ (h : i < l.length), l[i] = a
Aeneas.Std.core.slice.index.SliceIndexRangeToUsizeSlice (T : Type) :
  core.slice.index.SliceIndex (core.ops.range.RangeTo Usize) (Slice T) (Slice T)
Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice (T : Type) :
  core.slice.index.SliceIndex (core.ops.range.Range Usize) (Slice T) (Slice T)
