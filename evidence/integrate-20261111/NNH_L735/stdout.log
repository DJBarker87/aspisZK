NLB_Parent.G.eq_def: ∀ {A : Type} (window : NLB_Parent.Event → NLB_Parent.Event)
  (p : NKE_Free.Program NLB_Parent.Event A) (before : List NLB_Parent.Event),
  NLB_Parent.G window p before =
    match p with
    | NKE_Free.Program.ret value => NLB_Parent.State.done (ok value) before
    | NKE_Free.Program.prim actual next =>
      match actual with
      | ok value => NLB_Parent.G window (next value) before
      | fail error => NLB_Parent.State.done (fail error) before
      | div => NLB_Parent.State.done div before
    | NKE_Free.Program.call codec seed next =>
      have event := window (codec.encode seed);
      have attempted := before ++ [event];
      match codec.decode event with
      | none => NLB_Parent.State.invalid attempted
      | some (ok value) => NLB_Parent.G window (next value) attempted
      | some (fail error) => NLB_Parent.State.done (fail error) attempted
      | some div => NLB_Parent.State.done div attempted
