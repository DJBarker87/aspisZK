NHT_FinishRelationModel.after_pair: ∀ {W : Type} (ops : AspisR1.Port3_NativeFinishBody.Ops W)
  (v : AspisR1Stage2.verifier.View) (p : AspisR1Stage2.verifier.Prepared) (a : AspisR1Stage2.verifier.Accumulator)
  (obs : Option (AspisR1Stage2.verifier.Phase → Aeneas.Std.Result Unit)) (weights : Aeneas.Std.Slice NHE_DotBody.NQ),
  (↑weights).length ≤ 64 →
    a.weights.deref = AspisR1.SAG_DotAdapter.mapSlice NHE_DotRead.stageQ weights →
      ops.op4 v.final_message a.weights.deref = AspisR1.SAG_DotClosed.source v.final_message a.weights.deref →
        ∀ (claim : AspisR1.NGM_FinishControl.E) (reply : AspisR1.NGM_FinishControl.R AspisR1.NGM_FinishControl.E),
          NHQ_FinishRelationModel.afterPairReply ops v p a obs claim reply =
            NHT_FinishRelationModel.afterPairPacket ops v p a obs weights claim reply
NHT_ResultPort.returned_error: ∀ {A : Type} (e : NHT_ResultPort.SourceError),
  NHT_ResultPort.action (Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err e)) =
    Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err (NHT_ResultPort.error e))
NHT_ResultPort.roundtrip: ∀ (e : NHT_ResultPort.SourceError), NHT_ResultPort.back (NHT_ResultPort.error e) = e
NHT_FinishRelationModel.pair_frame: ∀ {W : Type} (ops : AspisR1.Port3_NativeFinishBody.Ops W)
  (v : AspisR1Stage2.verifier.View) (p : AspisR1Stage2.verifier.Prepared) (a : AspisR1Stage2.verifier.Accumulator)
  (obs : Option (AspisR1Stage2.verifier.Phase → Aeneas.Std.Result Unit)) (weights : W)
  (alpha : Aeneas.Std.Slice AspisR1.NGM_FinishControl.E) (claim : AspisR1.NGM_FinishControl.E)
  (packet : Aeneas.Std.Result (AspisR1.NGM_FinishControl.R AspisR1.NGM_FinishControl.E)),
  NHT_FinishRelationModel.PairLaw ops v p weights alpha packet →
    (do
        let reply ← ops.op2 weights alpha v.final_message p.kappa
        NHQ_FinishRelationModel.afterPairReply ops v p a obs claim reply) =
      do
      let reply ← packet
      NHQ_FinishRelationModel.afterPairReply ops v p a obs claim reply
NHT_ResultPort.divergence: ∀ {A : Type}, NHT_ResultPort.action Aeneas.Std.Result.div = Aeneas.Std.Result.div
NHT_ResultPort.failure: ∀ {A : Type} (e : Aeneas.Std.Error),
  NHT_ResultPort.action (Aeneas.Std.Result.fail e) = Aeneas.Std.Result.fail e
NHT_ResultPort.injective: Function.Injective NHT_ResultPort.error
NHT_FinishRelationModel.source: ∀ {W : Type} (ops : AspisR1.Port3_NativeFinishBody.Ops W)
  (v : AspisR1Stage2.verifier.View) (p : AspisR1Stage2.verifier.Prepared) (a : AspisR1Stage2.verifier.Accumulator)
  (obs : Option (AspisR1Stage2.verifier.Phase → Aeneas.Std.Result Unit)),
  AspisR1.Port3_NativeFinishBody.verifier.finish_relation ops v p a obs = NHQ_FinishRelationModel.staged ops v p a obs
NHT_FinishRelationModel.round_frame: ∀ {W : Type} (ops : AspisR1.Port3_NativeFinishBody.Ops W)
  (r : AspisR1.NP6_StdModel.Reservation) (bytes : Aeneas.Std.Slice Aeneas.Std.U8)
  (alpha claim : AspisR1.LPi_FieldValues.NE) (i : Aeneas.Std.Usize),
  AspisR1.LPi_FieldValues.canonE alpha →
    ↑i < 2 →
      ops.op5 bytes (AspisR1.FIo_Install.fromE alpha) (AspisR1.FIo_Install.fromE claim) i =
          AspisR1Stage2.Stage2Finish.verifier.finishRelationRoundWithOps (AspisR1.IDa_Deployed.finish r) bytes
            (AspisR1.FIo_Install.fromE alpha) (AspisR1.FIo_Install.fromE claim) i →
        ∀
          (next :
            AspisR1.NGM_FinishControl.R AspisR1.NGM_FinishControl.E →
              Aeneas.Std.Result (AspisR1.NGM_FinishControl.R Unit)),
          (do
              let reply ← ops.op5 bytes (AspisR1.FIo_Install.fromE alpha) (AspisR1.FIo_Install.fromE claim) i
              next reply) =
            do
            let reply ← NHQ_PacketPorts.round bytes alpha claim
            next reply
def NLP_NativeMerkle.action : (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
  NJU_CommonObserved.Merkle :=
fun H {X} x proof p folded batch x_1 =>
  NHT_ResultPort.action
    (NKV_FRef.verifier.candidate.batch_merkle (NKV_ConcreteChildren.ops H) (NKV_ConcreteChildren.digest H) proof p
      folded batch ())
def NIG_Slots.installed : AspisR1.NP6_StdModel.Reservation → AspisR1.Port3_NativeFinishBody.Ops NIG_Slots.W :=
fun r => AspisR1.Port4D_Round.native (AspisR1.IDa_Deployed.finish r)
