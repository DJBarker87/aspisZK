AspisR1.NNH_064PrefixCoverage.unfinished_iff (env : RSL.Env) (r : AspisR1.NP6_StdModel.Reservation)
  (pub proof ck : Aeneas.Std.Slice Aeneas.Std.U8) :
  AspisR1.NNH_064Prefix.run env r pub proof ck = none ↔
    ∃ v p a,
      NLE_ParseInstall.parse proof = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok v) ∧
        AspisR1.NNH_064ResumeError.reply env r pub proof ck =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (p, a))
