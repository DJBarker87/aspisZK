AspisR1.NNH_ModelLeafPorts.lane {E : Type} (missing : AspisR1.IDa_Deployed.Uninstalled E) (env : RSL.Env) (err : E)
  (r : AspisR1.NP6_StdModel.Reservation) (b : Aeneas.Std.Slice Aeneas.Std.U8)
  (o : RSL.Obs (Except RSL.ProgramError RSL.LaneState)) (value : Except RSL.ProgramError RSL.LaneState)
  (law : RSL.TX2_217.Ref (NND_Carrier.bytes b) env o) (ret : o.exit = RSL.Exit.ret value) :
  NNH_ModelCarrier.outer (NND_Carrier.reply NND_Carrier.lane) ((AspisR1.NNH_ModelConfig.sdk missing env err r).op50 b) =
