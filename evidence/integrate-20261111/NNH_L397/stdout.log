NNH_RegistryModel.represented {E : Type} (missing : AspisR1.IDa_Deployed.Uninstalled E) (sha : List RSL.Bytes → RSL.B32)
  (pda : List RSL.Bytes → RSL.B32 → Option RSL.B32) (clock : Except RSL.ProgramError UInt64)
  (reserve : AspisR1.NP6_StdModel.Reservation) (env : RSL.Env)
  (rep : AspisR1.NNH_HostEnv.EnvRep sha pda clock reserve env) (err : E) (v p : AdapterRw.solana_pubkey.Pubkey)
  (m : AdapterRw.r1_pool_adapter.owned.OwnedAccount)
  (s : AdapterRw.aspis_statement.pool_v1.pair_forest_accounts.PoolV1PairForestMasterV1)
  (reg ent : AdapterRw.r1_pool_adapter.owned.OwnedAccount) (t : Aeneas.Std.U64)
  (o : RSL.Obs (Except RSL.ProgramError Unit)) (r : Except RSL.ProgramError Unit)
  (law : RSL.TX2_234.Ref NNH_Libraries.L NNH_Libraries.D (NNH_MRegistryArgs.args v p m s reg ent t) env o)
  (ret : o.exit = RSL.Exit.ret r) :
  AdapterRw.r1_pool_adapter.owned.authenticate_invariant_release_registry
      (NNH_RegistryConfig.sdk missing NNH_Libraries.D (AspisR1.NNH_HostEnv.environment sha pda clock reserve) err
        reserve)
      v p m s reg ent t =
    Aeneas.Std.Result.ok (NND_Carrier.unreply id r)
AspisR1.NNH_ModelLeafPorts.pending {E : Type} (missing : AspisR1.IDa_Deployed.Uninstalled E)
  (sha : List RSL.Bytes → RSL.B32) (pda : List RSL.Bytes → RSL.B32 → Option RSL.B32)
  (clock : Except RSL.ProgramError UInt64) (r : AspisR1.NP6_StdModel.Reservation) (env : RSL.Env)
  (rep : AspisR1.NNH_HostEnv.EnvRep sha pda clock r env) (err : E)
  (weights : Aeneas.Std.Slice VTop_Stages.aspis_core.field.QM31) (width : (↑weights).length = 64) :
