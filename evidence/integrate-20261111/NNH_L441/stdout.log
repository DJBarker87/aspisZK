fun ops account program_id writable => do
  let p ← AdapterRw.r1_pool_adapter.owned.OwnedAccount.impl.owner account
  let b ←
    Aeneas.Std.core.cmp.impls.PartialEqShared.ne (AdapterRw.solana_pubkey.Pubkey.Insts.CoreCmpPartialEqPubkey ops) p
        program_id
