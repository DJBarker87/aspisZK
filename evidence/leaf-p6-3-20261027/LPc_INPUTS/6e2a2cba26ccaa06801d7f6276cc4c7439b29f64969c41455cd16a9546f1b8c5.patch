+use super::*;
+fn cell<const J:usize>() {
+ let x:[u32;4]=kani::any(); let y:[u32;4]=kani::any();
+ kani::assume(x.iter().all(|v|*v<P));kani::assume(y.iter().all(|v|*v<P));
+ let a=Q::from_limbs(x).unwrap();let b=Q::from_limbs(y).unwrap();
+ let sums:[u64;4]=kani::any();let mut actual=Dot{sums};
+ let raw=a.raw(b);actual.push(a,b);
+ assert_eq!(actual.sums[J],sums[J].wrapping_add((raw[J]%(1u64<<31)).wrapping_add(raw[J]/(1u64<<31))));
+}
+#[kani::proof] #[kani::unwind(6)] fn LPc_dot_cell0(){cell::<0>()}
+#[kani::proof] #[kani::unwind(6)] fn LPc_dot_cell1(){cell::<1>()}
+#[kani::proof] #[kani::unwind(6)] fn LPc_dot_cell2(){cell::<2>()}
+#[kani::proof] #[kani::unwind(6)] fn LPc_dot_cell3(){cell::<3>()}
