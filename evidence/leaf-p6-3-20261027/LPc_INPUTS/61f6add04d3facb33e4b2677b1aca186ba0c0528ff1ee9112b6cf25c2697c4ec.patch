+  let n=u32::from_le_bytes(b[16*i+4*j..16*i+4*j+4].try_into().unwrap());
+  if n>=0x7fff_ffff{expected=Err(CodecError::NonCanonical);}
+ }}assert_eq!(check_values(&b),expected);
