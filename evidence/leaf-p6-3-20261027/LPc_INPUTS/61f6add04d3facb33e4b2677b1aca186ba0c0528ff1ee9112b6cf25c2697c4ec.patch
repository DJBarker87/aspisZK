+use super::*;
+fn expansion<const CASE:usize>() {
+ let b:[u8;464]=kani::any();let mut o:[u8;928]=kani::any();let before=o;
+ let i:usize=kani::any();kani::assume(i<29);
+ assert_eq!(expand_values(&b[16*i..16*i+16],&mut o[32*i..32*i+32]),Ok(()));
+ let j:usize=kani::any();kani::assume(j<928);
+ match CASE {
+  0=>{kani::assume(j>=32*i&&j<32*i+16);assert_eq!(o[j],b[16*i+j-32*i]);}
+  1=>{kani::assume(j>=32*i+16&&j<32*i+32);assert_eq!(o[j],0);}
+  2=>{kani::assume(j<32*i);assert_eq!(o[j],before[j]);}
+  _=>{kani::assume(j>=32*i+32);assert_eq!(o[j],before[j]);}
+ }
+}
+#[kani::proof] #[kani::unwind(35)] fn LPc_expand0(){expansion::<0>()}
+#[kani::proof] #[kani::unwind(35)] fn LPc_expand1(){expansion::<1>()}
+#[kani::proof] #[kani::unwind(35)] fn LPc_expand2(){expansion::<2>()}
+#[kani::proof] #[kani::unwind(35)] fn LPc_expand3(){expansion::<3>()}
