+use super::*;
+// Each claim call is checked separately; no allocator/child stub is installed.
+fn decode<const POINT:usize>() {
+ let b:[u8;5+116*32]=kani::any();
+ let record=ValidatedRecord{row:25,framed:&b};
+ let actual=record.decode_k::<29>(POINT*29);
+ let mut expected=Ok([QM31::ZERO;29]);
+ let mut out=[QM31::ZERO;29];
+ for i in 0..29 {
+  let at=5+32*(POINT*29+i);
+  match QM31::from_le_bytes(&b[at..at+16]) {
+   Some(q)=>out[i]=q,
+   None=>{expected=Err(Error::NonCanonical{row:25,value:POINT*29+i});break;}
+  }
+ }
+ if expected.is_ok(){expected=Ok(out);}
+ assert_eq!(actual,expected);
+}
+#[kani::proof] #[kani::unwind(32)] fn LPc_claim_decode0(){decode::<0>()}
+#[kani::proof] #[kani::unwind(32)] fn LPc_claim_decode1(){decode::<1>()}
+#[kani::proof] #[kani::unwind(32)] fn LPc_claim_decode2(){decode::<2>()}
+
+#[kani::proof] #[kani::unwind(120)] fn LPc_validate116(){
+ let b:[u8;3712]=kani::any();let row:u8=kani::any();let mut expected=Ok(());
+ 'outer:for i in 0..116{for j in 0..8{
+  let x=u32::from_le_bytes(b[32*i+4*j..32*i+4*j+4].try_into().unwrap());
+  if x>=0x7fff_ffff||(j>=4&&x!=0){expected=Err(Error::NonCanonical{row,value:i});break 'outer;}
+ }}assert_eq!(validate_record_fields(row,&b),expected);
+}
+#[kani::proof] #[kani::unwind(10)] fn LPc_decode_reached1(){
+ let b:[u8;5+116*32]=kani::any();let point:usize=kani::any();kani::assume(point<3);
+ let offset=point*29;let at=5+offset*32;
+ let expected=QM31::from_le_bytes(&b[at..at+16]).map(|x|[x]).ok_or(Error::NonCanonical{row:25,value:offset});
+ assert_eq!(ValidatedRecord{row:25,framed:&b}.decode_k::<1>(offset),expected);
+}
