+use super::*;
+fn tail<const LO:usize,const HI:usize>() {
+ let b:[u8;63]=kani::any();let n:usize=kani::any();kani::assume(n>=LO&&n<=HI);
+ let k:bool=kani::any();
+ assert_eq!(echeck(&b[..n],k),if n<32{Ok(())}else{echeck(&b[..32],k)});
+}
