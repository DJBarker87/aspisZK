theorem NLT_FinishInstalled.installed : ∀ (H : Bytes → State) {X : Type} (d : aspis_core.digest.Digest32 X)
  (pub proof ck : Slice U8) (hash : X),
  (↑proof).length = 57607 →
    ∀ (result : R Unit) (records : List (Occurrence H d hash)),
      Invocation H d hash (NLT_NativeSource.skeleton H d pub proof ck hash) result records →
        ∀ r ∈ records, Law r.entered r.input :=
⋯
'NLT_FinishInstalled.installed' depends on axioms: [propext, Classical.choice, Quot.sound]
