theorem NLT_ParentInvocation.source : ∀ (f : NLT_Interpreted.Uninstalled) (H : Bytes → State) {X : Type}
  (d : aspis_core.digest.Digest32 X) (pub proof ck : Slice U8) (hash : X),
  (↑proof).length = 57607 →
    ∀ (result : R Unit) (events : List Event),
      Interpreted f H d pub proof ck hash result events →
        result =
            NJJ_Common.run f.resume f.pending (fun {H_1} => NLP_NativeMerkle.action H) (NLB_Parent.finish f.finish) d
              pub proof ck hash none ∧
          events =
            (run f.resume f.pending (fun {H_1} => NLP_NativeMerkle.action H) (NLB_Parent.finish f.finish) d pub proof ck
                hash none).events :=
⋯
'NLT_ParentInvocation.source' depends on axioms: [propext, Classical.choice, Quot.sound]
