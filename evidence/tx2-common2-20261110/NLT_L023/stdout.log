theorem NLT_ReseedTransport.forward : ∀ {H : Bytes → State} {X : Type} {d : aspis_core.digest.Digest32 X} {hash : X}
  {A : Type} (left right : Program Event A),
  NLT_Reseed.Same left right →
    ∀ (result : Result A) (records : List (Occurrence H d hash)),
      Invocation H d hash left result records → Invocation H d hash right result records :=
⋯
'NLT_ReseedTransport.forward' depends on axioms: [propext, Classical.choice, Quot.sound]
