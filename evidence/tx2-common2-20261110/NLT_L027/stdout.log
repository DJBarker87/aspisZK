theorem NLT_NativeSource.source : ∀ (H : Bytes → State) {X : Type} (d : aspis_core.digest.Digest32 X)
  (pub proof ck : Slice U8) (hash : X),
  (↑proof).length = 57607 →
    ∀ (result : R Unit) (records : List (Occurrence H d hash)),
      Invocation H d hash (skeleton H d pub proof ck hash) result records →
        have f := NLT_FrameFromCuts.frame records;
        result =
            NJJ_Common.run f.resume f.pending (fun {H_1} => NLP_NativeMerkle.action H) (NLB_Parent.finish f.finish) d
              pub proof ck hash none ∧
          List.map actual records =
            (run f.resume f.pending (fun {H_1} => NLP_NativeMerkle.action H) (NLB_Parent.finish f.finish) d pub proof ck
                hash none).events :=
⋯
'NLT_NativeSource.source' depends on axioms: [propext, Classical.choice, Quot.sound]
