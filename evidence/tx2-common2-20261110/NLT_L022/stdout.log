theorem NLT_Reseed.source : ∀ (wr rr wr' rr' : NP6_StdModel.Reservation) (merkle : Merkle) (finish finish' : Finish)
  {X : Type} (d : aspis_core.digest.Digest32 X) (pub proof ck : Slice U8) (hash : X),
  Same (NKE_CommonProgram.run wr rr (fun {H} => merkle) finish d pub proof ck hash none)
    (NKE_CommonProgram.run wr' rr' (fun {H} => merkle) finish' d pub proof ck hash none) :=
⋯
'NLT_Reseed.source' depends on axioms: [propext, Classical.choice, Quot.sound]
