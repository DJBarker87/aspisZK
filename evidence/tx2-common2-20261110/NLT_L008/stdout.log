  (↑proof).length = 57607 →
    NLP_InputDomain.Root0 ck proof →
      ∀ e ∈ (run wr rr (fun {H_1} => NLP_NativeMerkle.action H) finish d pub proof ck hash none).events,
        ∀ (detail : NLT_Subcuts.Detail H e), Law H detail :=
⋯
