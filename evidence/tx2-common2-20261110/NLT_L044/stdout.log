number of parameters: 1
fields:
  NLT_ParentCuts.Query.observation : NLB_Parent.QueryObservation
  NLT_ParentCuts.Query.frame : NLB_Parent.QueryCut before self.observation
constructor:
  NLT_ParentCuts.Query.mk {before : NKE_QueryInput.Args} (observation : NLB_Parent.QueryObservation)
    (frame : NLB_Parent.QueryCut before observation) : NLT_ParentCuts.Query before
def NLB_Parent.QueryCut : NKE_QueryInput.Args → NLB_Parent.QueryObservation → Prop :=
fun before o =>
  ↑before.proof = NKO_ReadonlyFrame.view o.heap o.proofBase (↑before.proof).length ∧
    (o.proofBase + (↑before.proof).length ≤ o.logBase ∨ o.logBase + o.logSize ≤ o.proofBase) ∧
      NJJ_Constructors.PreparedCut before.prepared o.args.prepared ∧
        NJJ_Constructors.AccumulatorCut before.accumulator o.args.accumulator ∧
          (∀ (i : Fin 29), (↑o.args.powers)[↑i]? = (↑before.powers)[↑i]?) ∧
            NKE_GeometryCuts.Cut before.geometry o.args.geometry ∧
              (↑o.args.pending.raw).length = 64 ∧
                (∀ i < 64, (↑o.args.pending.raw)[i]? = (↑before.pending.raw)[i]?) ∧
                  o.args.pending.terms = before.pending.terms
def NLP_InputDomain.Root0 : Slice U8 → Slice U8 → Prop :=
fun ck proof =>
  List.take 32 (List.drop 112 ↑ck) =
    ↑(AspisV8R19.SqueezeOracleBridge.encodeState
        ((SemanticRecordCodec.decodeState
              (OraclePortCompactDraft.slice (MultiproofConeCanonical.bytesOf ↑proof) 16 32)).getD
          fun x => 0))
'NLT_Root.root' depends on axioms: [propext, Classical.choice, Quot.sound]
