theorem NLT_Root.root : ∀ (H : Bytes → State) (pub proof ck : Slice U8),
  (↑proof).length = 57607 → (↑pub).length ≤ 1880 → NLP_InputDomain.Root0 ck proof → RowSpec H pub proof ck :=
⋯
def NLT_Root.RowSpec : (Bytes → State) → Slice U8 → Slice U8 → Slice U8 → Prop :=
fun H pub proof ck =>
  (∀ (result : R Unit) (records : List (Occurrence H (NLT_RuntimeDigest.digest H) ())),
      Invocation H (NLT_RuntimeDigest.digest H) ()
          (NLT_NativeSource.skeleton H (NLT_RuntimeDigest.digest H) pub proof ck ()) result records →
        have f := NLT_FrameFromCuts.frame records;
        result =
            NJJ_Common.run f.resume f.pending (fun {H_1} => NLP_NativeMerkle.action H) (NLB_Parent.finish f.finish)
              (NLT_RuntimeDigest.digest H) pub proof ck () none ∧
          List.map actual records =
              (run f.resume f.pending (fun {H_1} => NLP_NativeMerkle.action H) (NLB_Parent.finish f.finish)
                  (NLT_RuntimeDigest.digest H) pub proof ck () none).events ∧
            (∀ r ∈ records, NLT_NativeWindows.question (actual r) = NLT_NativeWindows.question r.entered) ∧
              (∀ r ∈ records, CallLaw H r) ∧
                ∀ (inside : NLL.History),
                  NLT_Chronology.completed records = some inside →
                    NLP_EffectOrder.expand (NLP_C04Chronology.atEvent H) (List.map actual records) = inside) ∧
    ∀ (records : List (Occurrence H (NLT_RuntimeDigest.digest H) ())),
      ¬Invalid H (NLT_RuntimeDigest.digest H) ()
          (NLT_NativeSource.skeleton H (NLT_RuntimeDigest.digest H) pub proof ck ()) records
def NLT_Root.CallLaw : (H : Bytes → State) → Occurrence H (NLT_RuntimeDigest.digest H) () → Prop :=
fun H r =>
  NLT_AllocationInstalled.ResumeLaw (NLT_RuntimeDigest.digest H) () r.entered r.input ∧
    NLT_NativeFacts.ResumeScope r.entered r.input ∧
      NLT_AllocationInstalled.PendingLaw r.entered r.input ∧
        NLT_QueryInstalled.Law r.entered r.input ∧
          NLT_FinishInstalled.Law r.entered r.input ∧
            NLT_C04Installed.Law H r.detail ∧ NLT_ReplyInstalled.Law H r.detail
