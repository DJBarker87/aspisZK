def NLT_NativeWindows.Input : NLT_NativeWindows.Event → Type :=
fun x =>
  match x with
  | Event.resume ck proof pub reply => NP6_StdModel.Reservation
  | Event.pending weights reply => NP6_StdModel.Reservation
  | Event.finish v p a reply => NP6_StdModel.Reservation × NIW_AlignFinishComposed.Locations
  | Event.query pr p a g geo pending reply =>
    NLT_ParentCuts.Query
      { proof := pr, prepared := p, accumulator := a, powers := g, geometry := geo, pending := pending }
  | x => PUnit.{1}
