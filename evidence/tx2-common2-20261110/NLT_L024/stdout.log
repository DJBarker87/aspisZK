theorem NLT_QuestionStep.source : ∀ (f : NLT_Interpreted.Uninstalled) (H : Bytes → State) {X : Type}
  (d : aspis_core.digest.Digest32 X) (pub proof ck : Slice U8) (hash : X),
  (↑proof).length = 57607 →
    ∀
      e ∈
        (run f.resume f.pending (fun {H_1} => NLP_NativeMerkle.action H) (NLB_Parent.finish f.finish) d pub proof ck
            hash none).events,
      ∀ (recorded : Event) (input : NLT_NativeWindows.Input recorded),
        NLT_NativeWindows.question recorded = NLT_NativeWindows.question e →
          NLT_NativeWindows.Compatible f recorded input → NLT_NativeWindows.window H d hash recorded input = e :=
⋯
'NLT_QuestionStep.source' depends on axioms: [propext, Classical.choice, Quot.sound]
