def NLT_RuntimeDigest.digest : (Bytes → State) → VTop_Stages.aspis_core.digest.Digest32 Unit :=
fun H =>
  { coremarkerCopyInst := (NKV_ConcreteChildren.digest H).coremarkerCopyInst,
    digest := (NKV_ConcreteChildren.digest H).digest }
'NLT_RuntimeDigest.resume_same' depends on axioms: [propext, Classical.choice, Quot.sound]
'NLT_RuntimeDigest.reply_same' depends on axioms: [propext, Classical.choice, Quot.sound]
