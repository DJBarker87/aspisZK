{
  "command": [
    "cargo",
    "+1.94.1",
    "build",
    "--locked",
    "--offline",
    "-j",
    "4",
    "--features",
    "optimized-terminal,r1p-check,ct-host-prover",
    "--release",
    "-p",
    "aspis-r1-cost-probe",
    "--example",
    "prover_rw_differential",
    "--example",
    "prover_rw_gate",
    "-Z",
    "unstable-options",
    "--unit-graph"
  ],
  "environment": {
    "RUSTC_BOOTSTRAP": "1",
    "RUSTFLAGS": "--cfg getrandom_backend=\"linux_raw\" -C panic=abort -C link-arg=-Wl,--threads=4"
