theorem AspisR1.FJj_Part1Meaning.value : ∀ (r : AspisR1.NP6_StdModel.Reservation)
  (semAlpha : Aeneas.Std.Array AspisR1Stage2.Stage2Finish.K 10#usize)
  (z : Aeneas.Std.Array AspisR1Stage2.aspis_core.circle.SecureCirclePoint 2#usize) (w : AspisR1.FIo_Install.W)
  (alpha : Aeneas.Std.Slice AspisR1Stage2.Stage2Finish.E) (f : Aeneas.Std.Slice Aeneas.Std.U8)
  (kappa out : AspisR1Stage2.Stage2Finish.E),
  AspisR1.FJc_WeightArray.canonical (AspisR1.FJg_LiteralTensor.source semAlpha) →
    AspisR1.FIn_WeightsInstall.newWeights AspisR1Stage2.transport.Variant.S2 semAlpha z =
        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok w) →
      (AspisR1.FIo_Install.toSlice alpha).len = 2#usize →
        (↑f).length = 2048 →
          (∀ x ∈ ↑(AspisR1.FIo_Install.toSlice alpha), AspisR1.FIo_WideValues.Canon x) →
            AspisR1.FIo_Install.pair r w alpha f kappa = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok out) →
              ∃ nativeOut a0 a1 low parts k,
                (AspisR1.FIo_Install.toWeights w).pair (AspisR1.FIo_Install.toSlice alpha) f
                      (AspisR1.FIo_Install.toE kappa) =
                    Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok nativeOut) ∧
                  AspisR1.FIo_Install.fromE nativeOut = out ∧
                    (AspisR1.FIo_Install.toSlice alpha).index_usize 0#usize = Aeneas.Std.Result.ok a0 ∧
                      (AspisR1.FIo_Install.toSlice alpha).index_usize 1#usize = Aeneas.Std.Result.ok a1 ∧
                        AspisR1.FIo_ArrayCanon.Holds low ∧
                          FIo_Native.weights.powers 7#usize (AspisR1.FIo_Install.toE kappa) = Aeneas.Std.Result.ok k ∧
                            FIo_Native.weights.Weights.pair_loop17 { start := 0#usize, «end» := 7#usize } parts k
                                  FIo_Native.aspis_core.field.wide_exact.WideExact.ZERO =
                                Aeneas.Std.Result.ok nativeOut ∧
                              AspisR1.FIp_ArrayValue.value parts 0 = AspisR1.FJc_InactiveValue.sumPrefix f low 12 ∧
                                AspisR1.FIp_ArrayValue.value parts 1 =
                                  AspisR1.RoundPairing.dot (fun i => AspisR1.FJc_InactiveCoefficientsModel.field f ↑i)
                                    (AspisR1.RoundPairing.dualFold
                                      (AspisR1CurrentWide.Proof.decodeWide (AspisR1.FIo_FieldBridge.wide a1))
                                      (AspisR1.RoundPairing.dualFold
                                        (AspisR1CurrentWide.Proof.decodeWide (AspisR1.FIo_FieldBridge.wide a0)) fun j =>
                                        (algebraMap AspisR1.FJj_Part1Meaning.FK AspisR1.FJj_Part1Meaning.FE)
                                          (AspisR1.tensorPoint
                                            (AspisR1.FJf_ModelPoint.decoded (AspisR1.FJg_LiteralTensor.source semAlpha))
                                            j))) :=
fun r semAlpha z w alpha f kappa out hc hw folds len halpha run =>
  let ⟨nativeOut, h✝⟩ := AspisR1.FJg_Part1Final.value r semAlpha z w alpha f kappa out hc hw folds len halpha run
  let ⟨a0, h✝¹⟩ := h✝
  let ⟨a1, h✝²⟩ := h✝¹
  let ⟨ap0, h✝³⟩ := h✝²
  let ⟨ap1, h✝⁴⟩ := h✝³
  let ⟨common, h✝⁵⟩ := h✝⁴
  let ⟨partials, h✝⁶⟩ := h✝⁵
  let ⟨row, h✝⁷⟩ := h✝⁶
  let ⟨coeff, h✝⁸⟩ := h✝⁷
  let ⟨low0, h✝⁹⟩ := h✝⁸
  let ⟨low1, h✝¹⁰⟩ := h✝⁹
  let ⟨low, h✝¹¹⟩ := h✝¹⁰
  let ⟨parts, h✝¹²⟩ := h✝¹¹
  let ⟨k, h✝¹³⟩ := h✝¹²
  let ⟨hn, right✝⟩ := h✝¹³
  let ⟨he, right✝¹⟩ := right✝
  let ⟨h0, right✝²⟩ := right✝¹
  let ⟨h1, right✝³⟩ := right✝²
  let ⟨hp0, right✝⁴⟩ := right✝³
  let ⟨hp1, right✝⁵⟩ := right✝⁴
  let ⟨hcom, right✝⁶⟩ := right✝⁵
  let ⟨vcom, right✝⁷⟩ := right✝⁶
  let ⟨vp, right✝⁸⟩ := right✝⁷
  let ⟨hr, right✝⁹⟩ := right✝⁸
  let ⟨hd4, right✝¹⁰⟩ := right✝⁹
  let ⟨hd0, right✝¹¹⟩ := right✝¹⁰
  let ⟨hd1, right✝¹²⟩ := right✝¹¹
  let ⟨lc, right✝¹³⟩ := right✝¹²
  let ⟨hk, right✝¹⁴⟩ := right✝¹³
  let ⟨hsum, right✝¹⁵⟩ := right✝¹⁴
  let ⟨v0, v1⟩ := right✝¹⁵
  have ca0 := AspisR1.FJc_SliceCanonical.read (AspisR1.FIo_Install.toSlice alpha) 0#usize a0 halpha h0;
  have ca1 := AspisR1.FJc_SliceCanonical.read (AspisR1.FIo_Install.toSlice alpha) 1#usize a1 halpha h1;
  have scale0 := AspisR1.FJj_ScaleModel.value semAlpha z w hc hw 0 row low0 hr hd0 a0 ap0 ca0 hp0;
  have scale1 := AspisR1.FJj_ScaleModel.value semAlpha z w hc hw 1 row low1 hr hd1 a1 ap1 ca1 hp1;
  have high := AspisR1.FJj_HighReference.value semAlpha z w hc hw f common partials vcom vp row coeff hr hd4;
  Exists.intro nativeOut
    (Exists.intro a0
      (Exists.intro a1
        (Exists.intro low (Exists.intro parts (Exists.intro k ⟨hn, ⟨he, ⟨h0, ⟨h1, ⟨lc, ⟨hk, ⟨hsum, ⟨v0, ⋯⟩⟩⟩⟩⟩⟩⟩⟩)))))
