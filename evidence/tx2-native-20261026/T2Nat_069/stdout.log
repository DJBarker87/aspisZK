fun {A} r s => ∀ (a : A), r = Aeneas.Std.Result.ok a ↔ s = Aeneas.Std.Result.ok a
def AspisR1.T2Nat_CodeEq.EqRun : {A : Type} →
  AspisR1.CheckpointBytes5Effect.Code A → AspisR1.CheckpointBytes5Effect.Code A → Prop :=
fun {A} p q =>
  ∀ {H : Type} (D : AspisR1Stage2.aspis_core.digest.Digest32 H) (hash : H)
    (before : AspisR1.CheckpointBytes5Effect.Log),
    AspisR1.T2Nat_ResultEq.EqOk (AspisR1.CheckpointBytes5Effect.run D hash p before)
      (AspisR1.CheckpointBytes5Effect.run D hash q before)
def AspisR1.T2Nat_ReaderOps.ops : Bool → AspisR1Stage2.ResumeOps :=
fun reserved =>
  have __src := AspisR1.CheckpointBytes4Ops.ops reserved;
  { checkpointSize := __src.checkpointSize, tag := __src.tag, finalLen := __src.finalLen,
    eq := @AspisR1Stage2.ResumeOps.eq __src, ne := @AspisR1Stage2.ResumeOps.ne __src, headerAny := __src.headerAny,
    raw := AspisR1.T2Nat_ScalarJoin.raw AspisR1.T2Nat_ReaderOps.unwrap,
    readE := AspisR1.T2Nat_ScalarJoin.readE AspisR1.T2Nat_ReaderOps.unwrap,
    readK := AspisR1.T2Nat_ScalarJoin.readK AspisR1.T2Nat_ReaderOps.unwrap,
    validate := AspisR1.Port5Q2_ReaderValidate.validate, zeroK := __src.zeroK, filled := __src.filled,
    readQueries := __src.readQueries,
    readSemanticAlpha :=
      AspisR1.Port5Q2_ReaderSemantic.semantic (AspisR1.T2Nat_ScalarJoin.readK AspisR1.T2Nat_ReaderOps.unwrap),
    readWeights :=
      AspisR1.Port5Q2_ReaderWeights.weights (AspisR1.T2Nat_ScalarJoin.readK AspisR1.T2Nat_ReaderOps.unwrap) }
def AspisR1.T2Nat_ReaderJoin.reader : Bool →
  {H : Type} →
    VTop_Stages.aspis_core.digest.Digest32 H →
      Aeneas.Std.Slice Aeneas.Std.U8 →
        Aeneas.Std.Slice Aeneas.Std.U8 →
          Aeneas.Std.Slice Aeneas.Std.U8 →
            VTop_Stages.transport.Variant →
              H →
                Aeneas.Std.Result
                  (Aeneas.Std.core.result.Result (AspisR1Stage2.verifier.Prepared × AspisR1Stage2.verifier.Accumulator)
                    VTop_Stages.verifier.Error) :=
fun reserved {H} D bytes proof pub v hash => do
  let out ←
    AspisR1.Port4A_NativeReader.resume (AspisR1.T2Nat_ReaderOps.ops reserved) (AspisR1.VTop_Checkpoint.digest D) bytes
        proof pub v hash
  match out with
    | Aeneas.Std.core.result.Result.Ok pair => Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok pair)
    | Aeneas.Std.core.result.Result.Err e =>
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err (AspisR1.Port3_CheckpointInstall.error e))
def AspisR1.T2Nat_ReaderEffects.OnRun : Bool →
  {H : Type} →
    VTop_Stages.aspis_core.digest.Digest32 H →
      H →
        Aeneas.Std.Slice Aeneas.Std.U8 →
          Aeneas.Std.Slice Aeneas.Std.U8 →
            Aeneas.Std.Slice Aeneas.Std.U8 →
              AspisR1Stage2.verifier.Prepared → AspisR1Stage2.verifier.Accumulator → Prop :=
fun reserved {H} D hash bytes proof pub p a =>
  ∀ (before : AspisR1.CheckpointBytes5Effect.Log),
    ∃ after,
      AspisR1.CheckpointBytes5Effect.run (AspisR1.VTop_Checkpoint.digest D) hash
            (AspisR1.CheckpointBytes5Resume.program (AspisR1.T2Nat_ReaderOps.ops reserved) bytes proof pub
              AspisR1Stage2.transport.Variant.S2)
            before =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (p, a), after) ∧
        AspisR1.CheckpointBytes5Effect.run (AspisR1.VTop_Checkpoint.digest D) hash
            (AspisR1.CheckpointBytes5Resume.program (AspisR1.CheckpointBytes4Ops.ops reserved) bytes proof pub
              AspisR1Stage2.transport.Variant.S2)
            before =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (p, a), after)
