  (R1Z.PV_OWNI_BuildTotal.entries point width trailing suffix).length = 2 ^ width
R1Z.PV_OWNI_BuilderStores.initialized : ∀ (encode : ℕ × R1Z.PV_OWNI_RawOps.Q → R1Z.PV_OWNI_EntryBytes.Entry)
  (point : List R1Z.PV_OWNI_RawOps.Q) (width trailing suffix p owner : ℕ) (m : R1Z.PV_OWN_Heap.Memory),
  R1Z.PV_OWN_Heap.NoLoans m (R1Z.PV_OWNI_EmptyVec.token m p) →
    R1Z.PV_OWNC_Vector.Valid R1Z.PV_OWNI_EntryBytes.codec
        (R1Z.PV_OWNC_PushFold.append R1Z.PV_OWNI_EntryBytes.codec (R1Z.PV_OWNI_EmptyVec.buffer m p owner (2 ^ width))
          (List.map encode (R1Z.PV_OWNI_BuildTotal.entries point width trailing suffix))) ∧
      (R1Z.PV_OWNC_PushFold.append R1Z.PV_OWNI_EntryBytes.codec (R1Z.PV_OWNI_EmptyVec.buffer m p owner (2 ^ width))
            (List.map encode (R1Z.PV_OWNI_BuildTotal.entries point width trailing suffix))).length =
        2 ^ width
R1Z.PV_OWNI_ByteWord.u32_injective : ∀ (a b : ℕ),
  a < 4294967296 → b < 4294967296 → (∀ i < 4, R1Z.PV_OWNI_ByteWord.byte a i = R1Z.PV_OWNI_ByteWord.byte b i) → a = b
R1Z.PV_OWNI_ByteWord.row_injective : ∀ (a b : ℕ),
  a < 1024 → b < 1024 → (∀ i < 8, R1Z.PV_OWNI_ByteWord.byte a i = R1Z.PV_OWNI_ByteWord.byte b i) → a = b
@R1Z.PV_OWNI_DensePrune.boolean_weight : ∀ {K : Type} [inst : Field K] {I : Type} [inst_1 : Fintype I] [DecidableEq I]
  (s b : I → Bool), R1Z.PV_OWNI_DensePrune.weight (fun i => if s i = true then 1 else 0) b = if b = s then 1 else 0
@R1Z.PV_OWNI_DensePrune.dense_sparse : ∀ {K : Type} [inst : Field K] {I J : Type} [inst_1 : Fintype I]
  [inst_2 : Fintype J] [inst_3 : DecidableEq I] [inst_4 : DecidableEq J] (p : I → K) (suffix : J → Bool)
  (column : (I → Bool) → (J → Bool) → K),
  ∑ a,
      ∑ b,
        R1Z.PV_OWNI_DensePrune.weight p a *
            R1Z.PV_OWNI_DensePrune.weight (fun j => if suffix j = true then 1 else 0) b *
          column a b =
    ∑ a, R1Z.PV_OWNI_DensePrune.weight p a * column a suffix
@R1Z.PV_OWNI_Drop.backing : ∀ {S X E : Type}
  (primitive : ℕ → R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E Unit × S)
  (w : R1Z.PV_OWN_Operations.State S X) (t : R1Z.PV_OWN_Heap.Token) (c : R1Z.PV_OWN_Heap.Cell),
  0 < c.size →
    R1Z.PV_OWN_Operations.dropVecPod primitive t c w =
      { outcome := (primitive t.address { size := c.size, alignment := c.alignment } w.allocator).1,
        world :=
          { memory := R1Z.PV_OWN_Operations.retire t c w.memory,
            allocator := (primitive t.address { size := c.size, alignment := c.alignment } w.allocator).2,
            extra := w.extra },
        calls := [(w, R1Z.PV_OWN_Operations.Event.deallocate t.address c.size c.alignment)] }
@R1Z.PV_OWNI_Drop.retired : ∀ {S X E : Type}
  (primitive : ℕ → R1Z.PV_OWN_Operations.Request → S → R1Z.PV_W_Threading.Outcome E Unit × S)
  (w : R1Z.PV_OWN_Operations.State S X) (t : R1Z.PV_OWN_Heap.Token) (c : R1Z.PV_OWN_Heap.Cell),
  0 < c.size →
    (R1Z.PV_OWN_Operations.dropVecPod primitive t c w).world.memory.heap t.address =
      some
        { size := c.size, alignment := c.alignment, capacity := c.capacity, contents := c.contents, owner := c.owner,
          live := false }
@R1Z.PV_OWNI_Drop.pod_no_effect : ∀ {S X E : Type} (w : R1Z.PV_OWN_Operations.State S X),
  (R1Z.PV_OWN_Operations.dropPod w).calls = [] ∧ (R1Z.PV_OWN_Operations.dropPod w).world = w
