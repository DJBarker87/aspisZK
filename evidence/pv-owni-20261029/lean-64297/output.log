          hn))
      (Eq.refl (R1Z.PV_OWNI_PublicPlan.plan isBoolean right other failures)))
theorem R1Z.PV_OWNI_DensePrune.dense_sparse : ∀ {K : Type} [inst : Field K] {I J : Type} [inst_1 : Fintype I]
  [inst_2 : Fintype J] [inst_3 : DecidableEq I] [inst_4 : DecidableEq J] (p : I → K) (suffix : J → Bool)
  (column : (I → Bool) → (J → Bool) → K),
