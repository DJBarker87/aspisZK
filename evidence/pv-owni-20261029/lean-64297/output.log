  (∀ l ∈ m.loans, l.token.generation ≤ m.generations l.token.address) →
    R1Z.PV_OWN_Heap.NoLoans m (R1Z.PV_OWNI_EmptyVec.token m p)
@R1Z.PV_OWNI_BuildTotal.mapM_pure : ∀ {A B : Type} (xs : List A) (f : A → B),
