              congrFun'
                (congrArg HMul.hMul
                  (congrArg (HMul.hMul (R1Z.PV_OWNI_DensePrune.weight p a))
                    (R1Z.PV_OWNI_DensePrune.boolean_weight suffix x)))
                (column a x)))
          (R1Z.PV_OWNI_DensePrune.weight p a * column a suffix)))
      (of_eq_true
        (Eq.trans
          (congrFun'
            (congrArg Eq
              (Eq.trans
                (Eq.trans
                  (Finset.sum_congr (Eq.refl Finset.univ) fun x a_1 =>
                    Eq.trans
                      (Eq.trans
                        (congrFun'
                          (congrArg HMul.hMul
                            (Eq.trans (mul_ite (x = suffix) (R1Z.PV_OWNI_DensePrune.weight p a) 1 0)
                              (ite_congr (Eq.refl (x = suffix)) (fun a_2 => mul_one (R1Z.PV_OWNI_DensePrune.weight p a))
                                fun a_2 => mul_zero (R1Z.PV_OWNI_DensePrune.weight p a))))
                          (column a x))
                        (ite_mul (x = suffix) (R1Z.PV_OWNI_DensePrune.weight p a) 0 (column a x)))
                      (ite_congr (Eq.refl (x = suffix))
                        (fun a_2 => Eq.refl (R1Z.PV_OWNI_DensePrune.weight p a * column a x)) fun a_2 =>
                        zero_mul (column a x)))
                  (Finset.sum_ite_eq' Finset.univ suffix fun x => R1Z.PV_OWNI_DensePrune.weight p a * column a x))
                (ite_cond_eq_true (R1Z.PV_OWNI_DensePrune.weight p a * column a suffix) 0
                  (Finset.mem_univ._simp_1 suffix))))
            (R1Z.PV_OWNI_DensePrune.weight p a * column a suffix))
          (eq_self (R1Z.PV_OWNI_DensePrune.weight p a * column a suffix))))
