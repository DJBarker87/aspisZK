R1Z.PV_OWNI_BuildTotal.result : ∀ (point : List R1Z.PV_OWNI_RawOps.Q) (width trailing suffix : ℕ),
  R1Z.PV_RDB2D_SparseWeights.build R1Z.PV_OWNI_RawOps.ops point width trailing suffix =
