theorem R1Z.RealR1_ReachableRetry.outer_owner_reachable : ∀ {Extra Proof : Type} (pub : R1Z.RealR1_OuterOwner.Pub)
  (nonce : R1Z.RealR1_OuterOwner.NoncePolicy Extra) (schedule : R1Z.ProverCommitLedger36.Schedule)
  (tape : ℕ → AspisR1PublicNonce41.owner.Raw) (unix : Bool) (pre : R1Z.RealR1_OuterOwner.Prefix Extra)
  (Inv : ℕ → R1Z.RealR1_OuterOwner.Store Extra → Prop) (left right : R1Z.RealR1_OuterOwner.Body Extra Proof),
  R1Z.RealR1_ReachableRetry.PreparedBodyContract pub (R1Z.RealR1_OuterOwner.modelEntropy nonce schedule tape) pre
      schedule unix Inv left right →
    (∀ (index : ℕ) (s after : R1Z.RealR1_OuterOwner.Store Extra),
        index < 8 →
          Inv index s →
            R1Z.ProverCommitRetry34.realAttempt pub (R1Z.RealR1_OuterOwner.modelEntropy nonce schedule tape)
                  (R1Z.RealR1_OuterOwner.reserved pre schedule unix right) index s =
                Aeneas.Std.Result.ok (R1Z.ProverCommitRetry34.Step.retry, after) →
              Inv (index + 1) after) →
      ∀ (s : R1Z.RealR1_OuterOwner.Store Extra),
        Inv 0 s →
          R1Z.RealR1_OuterOwner.selected true pub (R1Z.RealR1_OuterOwner.nativeEntropy nonce schedule tape)
              (R1Z.RealR1_OuterOwner.reserved pre schedule unix left) s =
            R1Z.RealR1_OuterOwner.selected true pub (R1Z.RealR1_OuterOwner.modelEntropy nonce schedule tape)
              (R1Z.RealR1_OuterOwner.reserved pre schedule unix right) s :=
fun {Extra Proof} pub nonce schedule tape unix pre Inv left right contract advance s initial =>
  have entropy := funext fun i => funext (R1Z.RealR1_OuterOwner.entropy_exact nonce schedule tape i);
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          R1Z.RealR1_OuterOwner.selected true pub _a (R1Z.RealR1_OuterOwner.reserved pre schedule unix left) s =
            R1Z.RealR1_OuterOwner.selected true pub (R1Z.RealR1_OuterOwner.modelEntropy nonce schedule tape)
              (R1Z.RealR1_OuterOwner.reserved pre schedule unix right) s)
        entropy))
    (R1Z.RealR1_ReachableRetry.run_reachable
      (R1Z.ProverCommitRetry34.realAttempt pub (R1Z.RealR1_OuterOwner.modelEntropy nonce schedule tape)
        (R1Z.RealR1_OuterOwner.reserved pre schedule unix left))
      (R1Z.ProverCommitRetry34.realAttempt pub (R1Z.RealR1_OuterOwner.modelEntropy nonce schedule tape)
        (R1Z.RealR1_OuterOwner.reserved pre schedule unix right))
      Inv
      (R1Z.RealR1_ReachableRetry.prepared_attempt pub (R1Z.RealR1_OuterOwner.modelEntropy nonce schedule tape) pre
        schedule unix Inv left right contract)
      advance 8 0 s (Decidable.byContradiction fun a => R1Z.RealR1_ReachableRetry.outer_owner_reachable._proof_1 a)
      initial)
theorem R1Z.RealR1_RetryHazards.selected_trace : ∀ {Extra Proof : Type} (pub : R1Z.RealR1_OuterOwner.Pub)
  (nonce : R1Z.RealR1_OuterOwner.NoncePolicy Extra) (schedule : R1Z.ProverCommitLedger36.Schedule)
  (tape : ℕ → AspisR1PublicNonce41.owner.Raw) (unix : Bool) (pre : R1Z.RealR1_OuterOwner.Prefix Extra)
  (body : R1Z.RealR1_OuterOwner.Body Extra Proof)
  (records : R1Z.SideChannelL1AttemptRecord.Owner (R1Z.RealR1_OuterOwner.Store Extra) Proof)
  (Inv : ℕ → R1Z.RealR1_OuterOwner.Store Extra → Prop),
  (∀ (index : ℕ) (s : R1Z.RealR1_OuterOwner.Store Extra),
      index < 8 →
        Inv index s →
          R1Z.ProverCommitRetry34.realAttempt pub (R1Z.RealR1_OuterOwner.nativeEntropy nonce schedule tape)
              (R1Z.RealR1_OuterOwner.reserved pre schedule unix body) index s =
            Aeneas.Std.Result.ok ((records index s).1.result, (records index s).2)) →
    (∀ (index : ℕ) (s after : R1Z.RealR1_OuterOwner.Store Extra),
        index < 8 →
          Inv index s →
            R1Z.SideChannelL1AttemptRecord.eraseOwner records index s =
                Aeneas.Std.Result.ok (R1Z.ProverCommitRetry34.Step.retry, after) →
              Inv (index + 1) after) →
      ∀ (s : R1Z.RealR1_OuterOwner.Store Extra),
        Inv 0 s →
          R1Z.RealR1_OuterOwner.selected true pub (R1Z.RealR1_OuterOwner.nativeEntropy nonce schedule tape)
              (R1Z.RealR1_OuterOwner.reserved pre schedule unix body) s =
            Aeneas.Std.Result.ok
              ((R1Z.SideChannelL1AttemptRecord.run records 8 0 s).1.result,
                (R1Z.SideChannelL1AttemptRecord.run records 8 0 s).2) :=
fun {Extra Proof} pub nonce schedule tape unix pre body records Inv erasure advance s initial =>
  Eq.trans
    (R1Z.RealR1_ReachableRetry.run_reachable
      (R1Z.ProverCommitRetry34.realAttempt pub (R1Z.RealR1_OuterOwner.nativeEntropy nonce schedule tape)
        (R1Z.RealR1_OuterOwner.reserved pre schedule unix body))
      (R1Z.SideChannelL1AttemptRecord.eraseOwner records) Inv erasure advance 8 0 s
      (Decidable.byContradiction fun a => R1Z.RealR1_RetryHazards.selected_trace._proof_1 a) initial)
    (R1Z.SideChannelL1AttemptRecord.erase_run records 8 0 s)
theorem R1Z.RealR1_RetryHazards.entered_abort_hazard : ∀ {Sample S Proof : Type} [inst : Fintype Sample]
  (records : Sample → R1Z.SideChannelL1AttemptRecord.Owner S Proof) (initial : Sample → S) (k : Fin 8)
  (e : R1Z.ProverCommitRetry34.Error),
  (R1Z.SideChannelRetryLaw.mass fun r =>
      ↑k < (R1Z.SideChannelL1AttemptRecord.run (records r) 8 0 (initial r)).1.attempts.length ∧
        R1Z.SideChannelRetryLaw.E records initial (↑k + 1) e r) =
    R1Z.SideChannelRetryLaw.mass (R1Z.SideChannelRetryLaw.C records initial (↑k + 1)) *
      R1Z.SideChannelRetryLaw.hazard (R1Z.SideChannelRetryLaw.C records initial (↑k + 1))
        (R1Z.SideChannelRetryLaw.E records initial (↑k + 1) e) :=
fun {Sample S Proof} [Fintype Sample] records initial k e =>
  have same :=
    funext fun r =>
      propext
        (and_congr
          (Eq.mpr
            (id
              (congrArg (Iff (↑k < (R1Z.SideChannelL1AttemptRecord.run (records r) 8 0 (initial r)).1.attempts.length))
                (congrArg (R1Z.SideChannelRetryLaw.rejectionPrefix (records r) (initial r))
                  (Nat.add_sub_cancel (↑k) 1))))
            (R1Z.SideChannelRetryLaw.actual_entry_iff (records r) (initial r) k))
          Iff.rfl);
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          R1Z.SideChannelRetryLaw.mass _a =
            R1Z.SideChannelRetryLaw.mass (R1Z.SideChannelRetryLaw.C records initial (↑k + 1)) *
              R1Z.SideChannelRetryLaw.hazard (R1Z.SideChannelRetryLaw.C records initial (↑k + 1))
                (R1Z.SideChannelRetryLaw.E records initial (↑k + 1) e))
        same))
    (R1Z.SideChannelRetryLaw.abort_hazard records initial k e)
