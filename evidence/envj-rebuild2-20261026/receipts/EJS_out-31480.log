theorem R1Z.RealR1_OuterOwner.outer_owner : ∀ {Extra Proof : Type} (s2 : Bool) (pub : R1Z.RealR1_OuterOwner.Pub)
  (nonce : R1Z.RealR1_OuterOwner.NoncePolicy Extra) (schedule : R1Z.ProverCommitLedger36.Schedule)
  (tape : ℕ → AspisR1PublicNonce41.owner.Raw) (unix : Bool)
  (leftPrefix rightPrefix : R1Z.RealR1_OuterOwner.Prefix Extra),
  R1Z.RealR1_OuterOwner.PrefixContract leftPrefix rightPrefix →
    ∀ (left right : R1Z.RealR1_OuterOwner.Body Extra Proof),
      R1Z.RealR1_OuterOwner.BodyContract left right →
        ∀ (s : R1Z.RealR1_OuterOwner.Store Extra),
          R1Z.RealR1_OuterOwner.selected s2 pub (R1Z.RealR1_OuterOwner.nativeEntropy nonce schedule tape)
              (R1Z.RealR1_OuterOwner.reserved leftPrefix schedule unix left) s =
            R1Z.RealR1_OuterOwner.selected s2 pub (R1Z.RealR1_OuterOwner.modelEntropy nonce schedule tape)
              (R1Z.RealR1_OuterOwner.reserved rightPrefix schedule unix right) s :=
fun {Extra Proof} s2 pub nonce schedule tape unix leftPrefix rightPrefix pre left right body s =>
  have he := funext fun index => funext (R1Z.RealR1_OuterOwner.entropy_exact nonce schedule tape index);
  have hc := R1Z.RealR1_OuterOwner.reserved_exact leftPrefix rightPrefix pre schedule unix left right body;
  have hb := funext fun secret => funext fun bytes => funext (hc secret bytes);
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          R1Z.RealR1_OuterOwner.selected s2 pub _a (R1Z.RealR1_OuterOwner.reserved leftPrefix schedule unix left) s =
            R1Z.RealR1_OuterOwner.selected s2 pub (R1Z.RealR1_OuterOwner.modelEntropy nonce schedule tape)
              (R1Z.RealR1_OuterOwner.reserved rightPrefix schedule unix right) s)
        he))
    (Eq.mpr
      (id
        (congrArg
          (fun _a =>
            R1Z.RealR1_OuterOwner.selected s2 pub (R1Z.RealR1_OuterOwner.modelEntropy nonce schedule tape) _a s =
              R1Z.RealR1_OuterOwner.selected s2 pub (R1Z.RealR1_OuterOwner.modelEntropy nonce schedule tape)
                (R1Z.RealR1_OuterOwner.reserved rightPrefix schedule unix right) s)
          hb))
      (Eq.refl
        (R1Z.RealR1_OuterOwner.selected s2 pub (R1Z.RealR1_OuterOwner.modelEntropy nonce schedule tape)
          (R1Z.RealR1_OuterOwner.reserved rightPrefix schedule unix right) s)))
def R1Z.RealR1_ReachableRetry.Ready : {Extra : Type} →
  R1Z.RealR1_OuterOwner.Pub →
    R1Z.ProverCommitRetry34.Entropy (R1Z.RealR1_OuterOwner.Store Extra) R1Z.RealR1_OuterOwner.Secret →
      R1Z.RealR1_OuterOwner.Prefix Extra →
        R1Z.ProverCommitLedger36.Schedule →
          Bool →
            ℕ →
              R1Z.RealR1_OuterOwner.Store Extra →
                R1Z.RealR1_OuterOwner.Secret →
                  R1Z.RealR1_OuterOwner.PubBytes → R1Z.RealR1_OuterOwner.Store Extra → Prop :=
fun {Extra} pub entropy pre schedule unix index start secret bytes ready =>
  ∃ generated path extra,
    entropy index start = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok secret, generated) ∧
      R1Z.RealR1_ReachableRetry.serializer pub = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok bytes) ∧
        pre secret.1 bytes generated.2 = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok path, extra) ∧
          R1Z.ProverCommitLedger36.reserve schedule unix path generated.1 = (Except.ok (), ready.1) ∧ ready.2 = extra
