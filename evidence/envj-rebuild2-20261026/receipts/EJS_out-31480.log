fun {Extra Proof} pub entropy pre schedule unix Inv left right =>
  ∀ (index : ℕ) (start : R1Z.RealR1_OuterOwner.Store Extra),
    index < 8 →
      Inv index start →
        ∀ (secret : R1Z.RealR1_OuterOwner.Secret) (bytes : R1Z.RealR1_OuterOwner.PubBytes)
          (ready : R1Z.RealR1_OuterOwner.Store Extra),
