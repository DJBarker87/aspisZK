+ let mut protected:[u32;22]=kani::any();let q:usize=kani::any();kani::assume(q<22);let before=protected[q];
+ let start:usize=kani::any();
+ let mut result=NFB_pack(start,inverses,lines).unwrap();
+ #[cfg(NET_bad_reply)]{result.inverses[r][lane].0^=1;}
+ #[cfg(NET_bad_frame)]{protected[q]^=1;}
+ #[cfg(NET_bad_argument)]{result.start^=1;}
+ #[cfg(NFB_wrong_wrapper)]{result.inverses=result.inverses.clone();}
+ assert_eq!(result.start,start);assert_eq!(result.inverses.len(),N);assert_eq!(result.line_z.len(),N);
+ assert_eq!(result.inverses.capacity(),N);assert_eq!(result.line_z.capacity(),N);
+ assert_eq!(result.inverses.as_ptr(),p);assert_eq!(result.line_z.as_ptr(),lp);
+ assert_ne!(result.inverses.as_ptr().cast::<u8>(),result.line_z.as_ptr().cast::<u8>());
+ assert_eq!(result.inverses[r][lane].0,raw[r][lane]);assert_eq!(result.line_z[r].0,line_raw[r]);
+ assert_eq!(protected[q],before);
