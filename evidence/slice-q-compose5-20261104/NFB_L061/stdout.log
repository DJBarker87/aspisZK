def Aeneas.Std.alloc.vec.Vec.resize : {T : Type} →
  Aeneas.Std.core.clone.Clone T →
    Aeneas.Std.alloc.vec.Vec T → Aeneas.Std.Usize → T → Aeneas.Std.Result (Aeneas.Std.alloc.vec.Vec T) :=
fun {T} cloneInst v new_len value =>
  if ↑new_len < v.length then Aeneas.Std.Result.ok ⟨(↑v).resize (↑new_len) value, ⋯⟩
  else do
    let value ← cloneInst.clone value
    Aeneas.Std.Result.ok ⟨(↑v).resize (↑new_len) value, ⋯⟩
theorem Aeneas.Std.alloc.vec.Vec.resize_spec : ∀ {T : Type} (cloneInst : Aeneas.Std.core.clone.Clone T)
  (v : Aeneas.Std.alloc.vec.Vec T) (new_len : Aeneas.Std.Usize) (value : T),
  cloneInst.clone value = Aeneas.Std.Result.ok value →
    Aeneas.Std.WP.spec (Aeneas.Std.alloc.vec.Vec.resize cloneInst v new_len value) fun nv =>
      ↑nv = (↑v).resize (↑new_len) value :=
fun {T} cloneInst v new_len value hClone =>
  Eq.mpr
    (id
      (congrArg (fun _a => Aeneas.Std.WP.spec _a fun nv => ↑nv = (↑v).resize (↑new_len) value)
        (Aeneas.Std.alloc.vec.Vec.resize.eq_1 cloneInst v new_len value)))
    (Decidable.casesOn ((↑new_len).decLt v.length)
      (fun h =>
        Eq.mpr (id (congrFun' (congrArg Aeneas.Std.WP.spec (if_neg h)) fun nv => ↑nv = (↑v).resize (↑new_len) value))
          (of_eq_true
            (Eq.trans
              (Eq.trans
                (congrFun'
                  (congrArg Aeneas.Std.WP.spec
                    (Eq.trans
                      (congrFun' (congrArg bind hClone) fun value =>
                        Aeneas.Std.Result.ok
                          ⟨(↑v).resize (↑new_len) value, Aeneas.Std.alloc.vec.Vec.resize._proof_1 v new_len value⟩)
                      (Aeneas.Std.bind_tc_ok value fun y =>
                        Aeneas.Std.Result.ok
                          ⟨(↑v).resize (↑new_len) y, Aeneas.Std.alloc.vec.Vec.resize._proof_1 v new_len y⟩)))
                  fun nv => ↑nv = (↑v).resize (↑new_len) value)
                (Aeneas.Std.WP.spec_ok._simp_1
                  ⟨(↑v).resize (↑new_len) value, Aeneas.Std.alloc.vec.Vec.resize._proof_1 v new_len value⟩))
              (eq_self ((↑v).resize (↑new_len) value)))))
      fun h =>
      Eq.mpr (id (congrFun' (congrArg Aeneas.Std.WP.spec (if_pos h)) fun nv => ↑nv = (↑v).resize (↑new_len) value))
        (of_eq_true
          (Eq.trans
            (Aeneas.Std.WP.spec_ok._simp_1
              ⟨(↑v).resize (↑new_len) value, Aeneas.Std.alloc.vec.Vec.resize._proof_1 v new_len value⟩)
            (eq_self ((↑v).resize (↑new_len) value)))))
