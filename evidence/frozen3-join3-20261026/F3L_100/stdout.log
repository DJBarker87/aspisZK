theorem AspisR1.F3L_NativePreparedModel.native : ∀ {CoreError : Type} (adapter : AdapterRw.Ops)
  (ops : AspisR1CurrentCaller.Ops) (reserved : Bool) (query : AspisR1.Port3_NativeQueryBody.Ops)
  (geo : AspisR1.Port3_NativeGeometryBody.Ops CoreError) (B : AspisR1PublicPreparation.FinishModel.Boundaries)
  (std : AspisR1.ClaimsUnrolledFinish.StdCalls) (native1 : AspisR1.S2W_ExtractionBoundary.First)
  (native2 : AspisR1.S2W_ExtractionBoundary.Second)
  (hashv : AspisR1.S2Z.Oracle.Parts → Aeneas.Std.Result AspisR1.S2Z.Oracle.Digest),
  AspisR1.S2W_DigestExtraction.AeneasExtraction
      (AspisR1.ClaimsUnrolledSdk.sdkOps adapter (AspisR1.Uni_Install.current ops reserved query geo) B std) native1
      native2 hashv →
    ∀ (id : AspisR1.S2W_ExtractionBoundary.Program) (accounts1 accounts2 : AspisR1.S2W_ExtractionBoundary.Accounts)
      (data1 data2 : Aeneas.Std.Slice Aeneas.Std.U8) (slot : AspisR1.S2W_ExtractionBoundary.Slot)
      (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8),
      native1 id accounts1 data1 = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok saved) →
        native2 id accounts2 data2 slot = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) →
          ∀ (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
            AspisR1.S2W_ExtractionBoundary.P1 sha256 H →
              AspisR1.S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
                ∀ (w : AspisR1.CanonicalCutEnrichedTranscript.Words),
                  ∃ f s log,
                    AspisR1.S2W_NativeConsolidation.SourceCuts
                        (AspisR1.ClaimsUnrolledSdk.sdkOps adapter (AspisR1.Uni_Install.current ops reserved query geo) B
                          std)
                        accounts1 accounts2 saved f s ∧
                      AspisR1.RawJ_RecordCuts.Recorded f s saved log ∧
                        AspisR1.S2W_Trace.run
                              (AspisR1.ClaimsUnrolledSdk.sdkOps adapter
                                (AspisR1.Uni_Install.current ops reserved query geo) B std)
                              (AspisR1.S2W_Observation.two
                                (AspisR1.ClaimsUnrolledSdk.sdkOps adapter
                                  (AspisR1.Uni_Install.current ops reserved query geo) B std)
                                id accounts1 data1 accounts2 data2 slot)
                              [] =
                            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok saved, log) ∧
                          ∃ run i pre t0 t25 t26 t27 r25 r26 z0 z1 start cs init v c,
                            c.t0 = start ∧
                              i.physical.bytes = AspisR1.MultiproofConeCanonical.bytesOf ↑f.pub ∧
                                i.stored = AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof ∧
                                  i.semantic.value.pubBytes = AspisR1.MultiproofConeCanonical.bytesOf ⋯ ∧
                                    i.semantic.value.tag = 2 ∧ ⋯ ∧ ⋯ :=
fun {CoreError} adapter ops reserved query geo B std native1 native2 hashv extraction id accounts1 accounts2 data1 data2
    slot saved accepted1 accepted2 sha256 H p1 syscall w =>
  let ⟨f, h✝⟩ :=
    AspisR1.RawJ_RecordCuts.native
      (AspisR1.ClaimsUnrolledSdk.sdkOps adapter (AspisR1.Uni_Install.current ops reserved query geo) B std) native1
      native2 hashv extraction id accounts1 accounts2 data1 data2 slot saved accepted1 accepted2
  let ⟨s, h✝¹⟩ := h✝
  let ⟨log, h✝²⟩ := h✝¹
  let ⟨cuts, right✝⟩ := h✝²
  let ⟨recorded, ran⟩ := right✝
  have canonical :=
    (AspisR1.Uni_Cuts.scan adapter ops reserved query geo B std accounts1 accounts2 saved f s cuts).right.right;
  have shape :=
    AspisR1.Op3I_Cuts.same_cut_header adapter
      (AspisR1.Op5T_Concrete.current (AspisR1.Uni_Install.base ops reserved query geo)) B std accounts1 accounts2 saved
      f s cuts;
  have header := shape.right.right.left;
  have length :=
    Eq.mp (congrFun' (congrArg Eq (List.length_map AspisV8R19.SqueezeOracleBridge.decodeByte)) 57607)
      ((AspisR1.OraclePortHeader.accepts_iff (AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof)).mp header).left;
  let ⟨run, properties⟩ :=
    AspisR1.Uni_Cuts.tx1 adapter ops reserved query geo B std accounts1 accounts2 saved f s cuts length
  have inputCuts :=
    Eq.mp
      (congrFun'
        (congrFun'
          (congrFun'
            (congrFun'
              (congrFun'
                (congrArg AspisR1.S2W_NativeConsolidation.SourceCuts
                  (congrFun'
                    (congrFun'
                      (congrArg (AspisR1.ClaimsUnrolledSdk.sdkOps adapter)
                        (AspisR1.Uni_Install.compose_tx1 ops reserved query geo))
                      B)
                    std))
                accounts1)
              accounts2)
            saved)
          f)
        s)
      cuts;
  have extracted :=
    Eq.mp
      (congrFun'
        (congrFun'
          (congrFun'
            (congrArg AspisR1.S2W_DigestExtraction.AeneasExtraction
              (congrFun'
                (congrFun'
                  (congrArg (AspisR1.ClaimsUnrolledSdk.sdkOps adapter)
                    (AspisR1.Uni_Install.compose_tx1 ops reserved query geo))
                  B)
                std))
            native1)
          native2)
        hashv)
      extraction;
  have backend :=
    AspisR1.PAln_Oracle.installed_backend adapter (AspisR1.Op5T_Concrete.current ops) reserved query geo B std native1
      native2 hashv extracted sha256 H p1 syscall;
  Exists.intro f
    (Exists.intro s
      (Exists.intro log
        ⟨cuts,
          ⟨recorded,
            ⟨ran,
              Exists.intro run
                (AspisR1.F3L_PreparedModel.from_cut adapter (AspisR1.Op5T_Concrete.current ops) reserved query geo B std
                  accounts1 accounts2 saved f s inputCuts recorded.left run header H backend w canonical)⟩⟩⟩))
theorem AspisR1.F3L_PreparedRemaining.remaining : ∀ (out : AspisR1PublicPreparation.verifier.Prepared)
  (p : AspisR1.OraclePortCompactDraft.Parsed) (i : AspisR1.RecordedBinaryExperimentBin.SourceInputs)
  (v : AspisR1.LiteralOpeningView.View) (q : Fin 22 → Fin 262144),
  AspisR1.F3L_PreparedModelSix.Fields out i q →
    ((AspisR1.F3L_SourcePrepared.numeric out).roots = fun j => AspisR1.OraclePortBatchDraft.committedRoot p ↑j) →
      have source := AspisR1.F3L_SourcePrepared.numeric out;
      have target :=
        AspisR1.OraclePortCheckpointResumeC5.prepared (AspisR1.OraclePortAcceptedContextC6.context p i v) i.data
          (AspisR1.SelectedChallengeMap.rhoOf i.rho) q;
      source = target ↔
        source.semanticAlpha = target.semanticAlpha ∧
          source.coordinates = target.coordinates ∧ source.claim = target.claim :=
fun out p i v q six roots =>
  {
    mp := fun same =>
      ⟨congrArg (fun x => x.semanticAlpha) same,
        ⟨congrArg (fun x => x.coordinates) same, congrArg (fun x => x.claim) same⟩⟩,
    mpr := fun a =>
      let ⟨alpha, right✝⟩ := a
      let ⟨coordinates, claim⟩ := right✝
      AspisR1.F3L_PreparedExt.fields (AspisR1.F3L_SourcePrepared.numeric out)
        (AspisR1.OraclePortCheckpointResumeC5.prepared (AspisR1.OraclePortAcceptedContextC6.context p i v) i.data
          (AspisR1.SelectedChallengeMap.rhoOf i.rho) q)
        six.right.right.right.right.right roots six.left six.right.left six.right.right.left six.right.right.right.left
        six.right.right.right.right.left alpha coordinates claim }
theorem AspisR1.F3L_CheckpointNumeric.stage : ∀ {Hash : Type} (D : AspisR1Stage2.aspis_core.digest.Digest32 Hash)
  (hash : Hash) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) (reserved : Bool)
  (out : AspisR1PublicPreparation.verifier.Prepared) (a : AspisR1Stage2.verifier.Accumulator)
  (proof pub : Aeneas.Std.Slice Aeneas.Std.U8) (stored physical : AspisV8R19.DuplexFrames.Bytes),
  AspisR1.CheckpointBytes5Join.S2S10CallerBinding D hash H proof pub stored physical →
    out.variant = AspisR1PublicPreparation.transport.Variant.S2 →
      ∀ (size : (↑a.weights).length = 64)
        (qb : ∀ (j : Fin 22), ↑(↑(AspisR1.F3K_CheckpointPreparedFields.writerPrepared out).queries)[↑j] < 262144),
        AspisR1.CheckpointBytesBlocks.CanonicalFields
            (AspisR1.CheckpointBytesBody.fields (AspisR1.F3K_CheckpointPreparedFields.writerPrepared out)
              (AspisR1.CheckpointBytes3Namespaces.toAccumulator a) ⋯ qb) →
          ↑a.next = 10 →
            ∀ (p2 : AspisR1Stage2.verifier.Prepared) (a2 : AspisR1Stage2.verifier.Accumulator)
              (after : AspisR1.CheckpointBytes5Effect.Log),
              AspisR1.CheckpointBytes5Effect.run D hash
                    (AspisR1.CheckpointBytes5Join.stage reserved
                      (AspisR1.F3K_CheckpointPreparedFields.writerPrepared out)
                      (AspisR1.CheckpointBytes3Namespaces.toAccumulator a) proof pub)
                    [] =
                  Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (p2, a2), after) →
                AspisR1.CheckpointBytes4SavedFields.BodyMatches p2 a2 (AspisR1.F3L_SourcePrepared.numeric out)
                    (AspisR1.CheckpointBytes5Output.accumulator a) ∧
                  AspisR1.CheckpointBytes5Inputs.observe after =
                    AspisR1.CheckpointBytes5Join.six H stored physical
                      (AspisR1.OraclePortPhysicalFrameDraft.domain ++
                        AspisR1.OraclePortCheckpointAbiC5.body (AspisR1.F3L_SourcePrepared.numeric out)
                          (AspisR1.CheckpointBytes5Output.accumulator a) (H stored) (H physical)) :=
fun {Hash} D hash H reserved out a proof pub stored physical caller variant size qb canonical next p2 a2 after
    success =>
  have provenance :=
    {
      variant :=
        id
          (Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  AspisR1.CheckpointBytes3Namespaces.toVariant
                      (AspisR1.Tx1Q_Carriers.variant (AspisR1CurrentCaller.InstalledPreparation.currentVariant _a)) =
                    OraclePortCkptAbi2Extracted.aspis_r1_cost_probe.transport.CheckpointAbi2Variant.S2)
                variant))
            (Eq.refl
              (AspisR1.CheckpointBytes3Namespaces.toVariant
                (AspisR1.Tx1Q_Carriers.variant
                  (AspisR1CurrentCaller.InstalledPreparation.currentVariant
                    AspisR1PublicPreparation.transport.Variant.S2))))),
      size := Eq.mpr (id (congrFun' (congrArg Eq (List.length_map AspisR1.CheckpointBytes3Namespaces.toK)) 64)) size,
      queriesBound := qb, canonical := canonical, next := next,
      prepared :=
        AspisR1.F3L_WriterPreparedEq.numeric out (AspisR1.CheckpointBytes3Namespaces.toAccumulator a)
          (Eq.mpr (id (congrFun' (congrArg Eq (List.length_map AspisR1.CheckpointBytes3Namespaces.toK)) 64)) size) qb
          canonical,
      accumulator :=
        AspisR1.F3L_WriterAccumulator.numeric (AspisR1.F3K_CheckpointPreparedFields.writerPrepared out) a size qb
          canonical next };
  have checked :=
    AspisR1.CheckpointBytes5Join.successful_fields_and_reads D hash H reserved
      (AspisR1.F3K_CheckpointPreparedFields.writerPrepared out) (AspisR1.CheckpointBytes3Namespaces.toAccumulator a)
      proof pub stored physical (AspisR1.F3L_SourcePrepared.numeric out) (AspisR1.CheckpointBytes5Output.accumulator a)
      caller provenance p2 a2 [] after success;
  ⟨checked.left, id checked.right.right.right⟩
