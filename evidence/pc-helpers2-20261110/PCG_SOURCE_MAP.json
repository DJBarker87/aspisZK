  "body": "{\n    let mut seed = [0u8; POOL_V1_PAIR_FOREST_MARKER_SEED_BYTES];\n    let mut chunk = 0;\n    while chunk < 4 {\n        let mut word = 0u64;\n        let mut byte = 0;\n        while byte < 7 {\n            word = (word << 8) | u64::from(digest[7 * chunk + byte]);\n            byte += 1;\n        }\n        let mut group = 0;\n        while group < 8 {\n            seed[8 * chunk + group] = ((word >> (7 * (7 - group))) & 0x7f) as u8;\n            group += 1;\n        }\n        chunk += 1;\n    }\n    seed\n}",
  "caller_occurrences": 1
