def NKU_ResumeRoot.G : {H : Type} →
  AspisR1Stage2.aspis_core.digest.Digest32 H → H → NKU.State → Run (core.result.Result NKU.Pair verifier.Error) :=
fun {H} d hash s => do
  let reply ← NKU_HeaderStep.run d s
  NKK_Try.emitted reply fun x =>
      match x with
      | (fst, post) => suffix d hash post
theorem NKU_ResumeRoot.source : ∀ {H : Type} (d : AspisR1Stage2.aspis_core.digest.Digest32 H) (hash : H)
  (s : NKU.State),
  G d hash s =
    run s.frame.reservation d s.frame.checkpoint s.frame.proof s.frame.publicBytes transport.Variant.S2 hash :=
fun {H} d hash s =>
  Eq.symm
    (Eq.mpr (id (congrArg (fun _a => _a = G d hash s) (NKU_HeaderStep.source d hash s)))
      (id
        (NKK_LogAlgebra.bind_congr (NKU_HeaderStep.run d s)
          (fun reply =>
            NKK_Try.emitted reply fun x =>
              match x with
              | (fst, post) => NKU_HeaderStep.suffix d hash post)
          (fun reply =>
            NKK_Try.emitted reply fun x =>
              match x with
              | (fst, post) => suffix d hash post)
          fun reply =>
          core.result.Result.casesOn (motive := fun t =>
            reply = t →
              (NKK_Try.emitted reply fun x =>
                  match x with
                  | (fst, post) => NKU_HeaderStep.suffix d hash post) =
                NKK_Try.emitted reply fun x =>
                  match x with
                  | (fst, post) => suffix d hash post)
            reply (fun pair h => Eq.symm h ▸ suffix_eq d hash pair.2)
            (fun err h =>
              Eq.symm h ▸
                Eq.refl
                  (NKK_Try.emitted (core.result.Result.Err err) fun x =>
                    match x with
                    | (fst, post) => NKU_HeaderStep.suffix d hash post))
            (Eq.refl reply))))
theorem NKU_ResumeRoot.clauses : ∀ {H : Type} (d : AspisR1Stage2.aspis_core.digest.Digest32 H) (hash : H)
  (s : NKU.State), NKK_LogClauses.Holds (NKK_Clauses.Clause s.frame.reservation d hash) (G d hash s) :=
fun {H} d hash s =>
  Eq.mpr
    (id
      (congrArg (fun _a => NKK_LogClauses.Holds (NKK_Clauses.Clause s.frame.reservation d hash) _a) (source d hash s)))
    (NKK_ClauseRoot.source s.frame.reservation d s.frame.checkpoint s.frame.proof s.frame.publicBytes
        transport.Variant.S2 hash).left
theorem NKU_ResumeRoot.cohort : ∀ {H : Type} (d : AspisR1Stage2.aspis_core.digest.Digest32 H) (hash : H)
  (s : NKU.State),
  NIL_StatePort.reply (G d hash s).result =
    AspisR1Stage2.verifier.resumeWithOps (CheckpointBytes4Ops.ops (NJC_FilledClause.reserved s.frame.reservation)) d
      s.frame.checkpoint s.frame.proof s.frame.publicBytes AspisR1Stage2.transport.Variant.S2 hash :=
fun {H} d hash s =>
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          NIL_StatePort.reply _a.result =
            AspisR1Stage2.verifier.resumeWithOps
              (CheckpointBytes4Ops.ops (NJC_FilledClause.reserved s.frame.reservation)) d s.frame.checkpoint
              s.frame.proof s.frame.publicBytes AspisR1Stage2.transport.Variant.S2 hash)
        (source d hash s)))
    (NJU_ResumeRoot.cohort s.frame.reservation d s.frame.checkpoint s.frame.proof s.frame.publicBytes hash)
