def NKU_ParentFold.G : {H : Type} →
  AspisR1Stage2.aspis_core.digest.Digest32 H → H → NKU.State → Run (core.result.Result NKU.Pair verifier.Error) :=
fun {H} d hash s => do
  let reply ← NKU_FineHeader.run d s
  NKK_Try.emitted reply fun x =>
      match x with
      | (fst, post) => NKU_Fold.suffix d hash post
theorem NKU_ParentFold.source : ∀ {H : Type} (d : AspisR1Stage2.aspis_core.digest.Digest32 H) (hash : H)
  (s : NKU.State),
  G d hash s =
    NJU_ResumeObserved.run s.frame.reservation d s.frame.checkpoint s.frame.proof s.frame.publicBytes
      transport.Variant.S2 hash :=
fun {H} d hash s => Eq.trans (installed d hash s) (NKU_FineRoot.source d hash s)
theorem NKU_ParentFold.cohort : ∀ {H : Type} (d : AspisR1Stage2.aspis_core.digest.Digest32 H) (hash : H)
  (s : NKU.State),
  NIL_StatePort.reply (G d hash s).result =
    AspisR1Stage2.verifier.resumeWithOps (CheckpointBytes4Ops.ops (NJC_FilledClause.reserved s.frame.reservation)) d
      s.frame.checkpoint s.frame.proof s.frame.publicBytes AspisR1Stage2.transport.Variant.S2 hash :=
fun {H} d hash s =>
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          NIL_StatePort.reply _a.result =
            AspisR1Stage2.verifier.resumeWithOps
              (CheckpointBytes4Ops.ops (NJC_FilledClause.reserved s.frame.reservation)) d s.frame.checkpoint
              s.frame.proof s.frame.publicBytes AspisR1Stage2.transport.Variant.S2 hash)
        (installed d hash s)))
    (NKU_FineRoot.cohort d hash s)
theorem NKU_ParentFold.clauses : ∀ {H : Type} (d : AspisR1Stage2.aspis_core.digest.Digest32 H) (hash : H)
  (s : NKU.State), NKK_LogClauses.Holds (NKK_Clauses.Clause s.frame.reservation d hash) (G d hash s) :=
fun {H} d hash s =>
  Eq.mpr
    (id
      (congrArg (fun _a => NKK_LogClauses.Holds (NKK_Clauses.Clause s.frame.reservation d hash) _a)
        (installed d hash s)))
    (Eq.mpr
      (id
        (congrArg (fun _a => NKK_LogClauses.Holds (NKK_Clauses.Clause s.frame.reservation d hash) _a)
          (NKU_FineRoot.installed d hash s)))
      (NKU_ResumeRoot.clauses d hash s))
'NKU_ParentFold.installed' depends on axioms: [propext, Classical.choice, Quot.sound]
'NKU_ParentFold.source' depends on axioms: [propext, Classical.choice, Quot.sound]
'NKU_ParentFold.cohort' depends on axioms: [propext, Classical.choice, Quot.sound]
'NKU_ParentFold.clauses' depends on axioms: [propext, Classical.choice, Quot.sound]
