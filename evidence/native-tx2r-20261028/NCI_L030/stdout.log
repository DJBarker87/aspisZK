def Aeneas.Std.Array.update.{u} : {α : Type u} →
  {n : Aeneas.Std.Usize} → Aeneas.Std.Array α n → Aeneas.Std.Usize → α → Aeneas.Std.Result (Aeneas.Std.Array α n) :=
fun {α} {n} v i x =>
  match v[i]? with
  | none => Aeneas.Std.Result.fail Aeneas.Std.Error.arrayOutOfBounds
  | some val => Aeneas.Std.Result.ok ⟨(↑v).set (↑i) x, ⋯⟩
def Aeneas.Std.UScalar.mul : {ty : Aeneas.Std.UScalarTy} →
  Aeneas.Std.UScalar ty → Aeneas.Std.UScalar ty → Aeneas.Std.Result (Aeneas.Std.UScalar ty) :=
fun {ty} x y => Aeneas.Std.UScalar.tryMk ty (↑x * ↑y)
def Aeneas.Std.UScalar.add : {ty : Aeneas.Std.UScalarTy} →
  Aeneas.Std.UScalar ty → Aeneas.Std.UScalar ty → Aeneas.Std.Result (Aeneas.Std.UScalar ty) :=
fun {ty} x y => Aeneas.Std.UScalar.tryMk ty (↑x + ↑y)
