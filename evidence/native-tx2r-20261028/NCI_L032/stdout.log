def Aeneas.Std.UScalar.tryMk : (ty : Aeneas.Std.UScalarTy) → ℕ → Aeneas.Std.Result (Aeneas.Std.UScalar ty) :=
fun ty x => Aeneas.Std.Result.ofOption (Aeneas.Std.UScalar.tryMkOpt ty x) Aeneas.Std.Error.integerOverflow
def Aeneas.Std.UScalar.ofNatCore : {ty : Aeneas.Std.UScalarTy} → (x : ℕ) → x < 2 ^ ty.numBits → Aeneas.Std.UScalar ty :=
fun {ty} x h => { toFin := ⟨x, h⟩ }#uscalar
def Aeneas.Std.UScalar.tryMkOpt : (ty : Aeneas.Std.UScalarTy) → ℕ → Option (Aeneas.Std.UScalar ty) :=
fun ty x => if h : Aeneas.Std.UScalar.check_bounds ty x = true then some (Aeneas.Std.UScalar.ofNatCore x ⋯) else none
@[reducible] def Aeneas.Std.UScalar.ofNat : {ty : Aeneas.Std.UScalarTy} →
  (x : ℕ) → autoParam (x ≤ Aeneas.Std.UScalar.cMax ty) Aeneas.Std.UScalar.ofNat._auto_1 → Aeneas.Std.UScalar ty :=
fun {ty} x hInBounds => Aeneas.Std.UScalar.ofNatCore x ⋯
