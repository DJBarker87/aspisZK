    ∀ {s : AspisR1.NLD.ParentState}, AspisR1.NLD.Chain s t events → AspisR1.NLD.Frames events → AspisR1.NLD.Frame s t)
    (fun {s} chain frames =>
      let ⟨⟩ := t
      chain)
