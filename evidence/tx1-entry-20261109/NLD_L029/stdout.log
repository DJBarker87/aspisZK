theorem AspisR1.NLD.events_from_cuts : ∀ {A : Type} {p : AspisR1.NLD.Program A} {s t : AspisR1.NLD.ParentState}
  {r : Aeneas.Std.Result A} {events : List AspisR1.NLD.Event},
  AspisR1.NLD.Cuts p s r t events → AspisR1.NLD.run p s = (r, t, events) :=
fun {A} {p} {s t} {r} {events} cuts =>
  AspisR1.NLD.Cuts.rec (fun a s => Eq.refl (AspisR1.NLD.run (AspisR1.NLD.Program.done a) s))
    (fun {B} site action k pre post final b result tail head rest ih =>
      of_eq_true
        (Eq.trans
          (congrFun'
            (congrArg Eq
              (Eq.trans (AspisR1.NLD.run.eq_2 pre B site action k)
                (Eq.trans
                  (congrArg
                    (fun x =>
                      match x.1 with
                      | Aeneas.Std.Result.ok b =>
                        match AspisR1.NLD.run (k b (action pre).2) (action pre).2 with
                        | (result, final, tail) =>
                          (result, final, { site := site, before := pre, after := (action pre).2 } :: tail)
                      | Aeneas.Std.Result.fail e =>
                        (Aeneas.Std.Result.fail e, (action pre).2,
                          [{ site := site, before := pre, after := (action pre).2 }])
                      | Aeneas.Std.Result.div =>
                        (Aeneas.Std.Result.div, (action pre).2,
                          [{ site := site, before := pre, after := (action pre).2 }]))
                    head)
                  (congr
                    (congrArg Prod.mk
                      (congrArg Prod.fst
                        (Eq.trans
                          (congr (congrArg AspisR1.NLD.run (congrArg (k b) (congrArg Prod.snd head)))
                            (congrArg Prod.snd head))
                          ih)))
                    (congr
                      (congrArg Prod.mk
                        (congrArg Prod.fst
                          (Eq.trans
                              (congr (congrArg AspisR1.NLD.run (congrArg (k b) (congrArg Prod.snd head)))
                                (congrArg Prod.snd head))
                              ih ▸
                            Eq.refl (AspisR1.NLD.run (k b (action pre).2) (action pre).2).2)))
                      (congr (congrArg List.cons (congrArg (AspisR1.NLD.Event.mk site pre) (congrArg Prod.snd head)))
                        (congrArg Prod.snd
                          (Eq.trans
                              (congr (congrArg AspisR1.NLD.run (congrArg (k b) (congrArg Prod.snd head)))
                                (congrArg Prod.snd head))
                              ih ▸
                            Eq.refl (AspisR1.NLD.run (k b (action pre).2) (action pre).2).2))))))))
            (result, final, { site := site, before := pre, after := post } :: tail))
          (eq_self (result, final, { site := site, before := pre, after := post } :: tail))))
    (fun {B} site action k pre post e head =>
      of_eq_true
        (Eq.trans
          (congrFun'
            (congrArg Eq
              (Eq.trans (AspisR1.NLD.run.eq_2 pre B site action k)
                (Eq.trans
                  (congrArg
                    (fun x =>
                      match x.1 with
                      | Aeneas.Std.Result.ok b =>
                        match AspisR1.NLD.run (k b (action pre).2) (action pre).2 with
                        | (result, final, tail) =>
                          (result, final, { site := site, before := pre, after := (action pre).2 } :: tail)
                      | Aeneas.Std.Result.fail e =>
                        (Aeneas.Std.Result.fail e, (action pre).2,
                          [{ site := site, before := pre, after := (action pre).2 }])
                      | Aeneas.Std.Result.div =>
                        (Aeneas.Std.Result.div, (action pre).2,
                          [{ site := site, before := pre, after := (action pre).2 }]))
                    head)
                  (congrArg (Prod.mk (Aeneas.Std.Result.fail e))
                    (congr (congrArg Prod.mk (congrArg Prod.snd head))
                      (congrFun'
                        (congrArg List.cons (congrArg (AspisR1.NLD.Event.mk site pre) (congrArg Prod.snd head)))
                        []))))))
            (Aeneas.Std.Result.fail e, post, [{ site := site, before := pre, after := post }]))
          (eq_self (Aeneas.Std.Result.fail e, post, [{ site := site, before := pre, after := post }]))))
    (fun {B} site action k pre post head =>
      of_eq_true
        (Eq.trans
          (congrFun'
            (congrArg Eq
              (Eq.trans (AspisR1.NLD.run.eq_2 pre B site action k)
                (Eq.trans
                  (congrArg
                    (fun x =>
                      match x.1 with
                      | Aeneas.Std.Result.ok b =>
                        match AspisR1.NLD.run (k b (action pre).2) (action pre).2 with
                        | (result, final, tail) =>
                          (result, final, { site := site, before := pre, after := (action pre).2 } :: tail)
                      | Aeneas.Std.Result.fail e =>
                        (Aeneas.Std.Result.fail e, (action pre).2,
                          [{ site := site, before := pre, after := (action pre).2 }])
                      | Aeneas.Std.Result.div =>
                        (Aeneas.Std.Result.div, (action pre).2,
                          [{ site := site, before := pre, after := (action pre).2 }]))
                    head)
                  (congrArg (Prod.mk Aeneas.Std.Result.div)
                    (congr (congrArg Prod.mk (congrArg Prod.snd head))
                      (congrFun'
                        (congrArg List.cons (congrArg (AspisR1.NLD.Event.mk site pre) (congrArg Prod.snd head)))
                        []))))))
            (Aeneas.Std.Result.div, post, [{ site := site, before := pre, after := post }]))
          (eq_self (Aeneas.Std.Result.div, post, [{ site := site, before := pre, after := post }]))))
    cuts
theorem AspisR1.NLD.firstDecoded_erasure : ∀ (ops : AdapterRw.Ops) (semantic : AspisR1.NLD.Public)
  (publicBytes proof : AspisR1.NLD.Bytes) (split : Aeneas.Std.Usize) (s : AspisR1.NLD.ParentState),
  (AspisR1.NLD.run (AspisR1.NLD.firstDecoded ops semantic publicBytes proof split) s).1 =
    AdapterRw.first_decoded ops semantic publicBytes proof split :=
fun ops semantic publicBytes proof split s =>
  id
    (id
