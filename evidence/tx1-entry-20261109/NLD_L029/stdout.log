theorem AspisR1.NLD.chain : ∀ {A : Type} {p : AspisR1.NLD.Program A} {s t : AspisR1.NLD.ParentState}
  {r : Aeneas.Std.Result A} {events : List AspisR1.NLD.Event},
  AspisR1.NLD.Cuts p s r t events → AspisR1.NLD.Chain s t events :=
fun {A} {p} {s t} {r} {events} cuts =>
  AspisR1.NLD.Cuts.rec (fun a s => Eq.refl s)
    (fun {B} site action k pre post final b result tail head rest ih => ⟨rfl, ih⟩)
    (fun {B} site action k pre post e head => ⟨rfl, rfl⟩) (fun {B} site action k pre post head => ⟨rfl, rfl⟩) cuts
theorem AspisR1.NLD.cuts_from_run : ∀ {A : Type} (p : AspisR1.NLD.Program A) (s : AspisR1.NLD.ParentState),
  AspisR1.NLD.Cuts p s (AspisR1.NLD.run p s).1 (AspisR1.NLD.run p s).2.1 (AspisR1.NLD.run p s).2.2 :=
fun {A} p s =>
  AspisR1.NLD.Program.rec (motive := fun p =>
    ∀ (s : AspisR1.NLD.ParentState),
      AspisR1.NLD.Cuts p s (AspisR1.NLD.run p s).1 (AspisR1.NLD.run p s).2.1 (AspisR1.NLD.run p s).2.2)
    (fun a s => AspisR1.NLD.Cuts.done a s)
    (fun {B} site action k ih s =>
      let ⟨out, post, h✝⟩ := action s
      Eq.ndrec (motive := fun x =>
        action s = x →
          AspisR1.NLD.Cuts (AspisR1.NLD.Program.step site action k) s
            (AspisR1.NLD.run (AspisR1.NLD.Program.step site action k) s).1
            (AspisR1.NLD.run (AspisR1.NLD.Program.step site action k) s).2.1
            (AspisR1.NLD.run (AspisR1.NLD.Program.step site action k) s).2.2)
        (fun h =>
          Aeneas.Std.Result.casesOn (motive := fun t =>
            out = t →
              AspisR1.NLD.Cuts (AspisR1.NLD.Program.step site action k) s
                (AspisR1.NLD.run (AspisR1.NLD.Program.step site action k) s).1
                (AspisR1.NLD.run (AspisR1.NLD.Program.step site action k) s).2.1
                (AspisR1.NLD.run (AspisR1.NLD.Program.step site action k) s).2.2)
            out
            (fun b h_1 =>
              Eq.ndrec (motive := fun out =>
                action s = (out, post) →
                  AspisR1.NLD.Cuts (AspisR1.NLD.Program.step site action k) s
                    (AspisR1.NLD.run (AspisR1.NLD.Program.step site action k) s).1
                    (AspisR1.NLD.run (AspisR1.NLD.Program.step site action k) s).2.1
                    (AspisR1.NLD.run (AspisR1.NLD.Program.step site action k) s).2.2)
                (fun h =>
                  Eq.mpr
                    (id
                      (congr
                        (congr
                          (congrArg (AspisR1.NLD.Cuts (AspisR1.NLD.Program.step site action k) s)
                            (congrArg Prod.fst
                              (Eq.trans (AspisR1.NLD.run.eq_2 s B site action k)
                                (Eq.trans
                                  (congrArg
                                    (fun x =>
                                      match x.1 with
                                      | Aeneas.Std.Result.ok b =>
                                        match AspisR1.NLD.run (k b (action s).2) (action s).2 with
                                        | (result, final, tail) =>
                                          (result, final, { site := site, before := s, after := (action s).2 } :: tail)
