                                      | Aeneas.Std.Result.div =>
                                        (Aeneas.Std.Result.div, (action s).2,
                                          [{ site := site, before := s, after := (action s).2 }]))
                                    h)
                                  (congrArg (Prod.mk (Aeneas.Std.Result.fail e))
                                    (congr (congrArg Prod.mk (congrArg Prod.snd h))
                                      (congrFun'
                                        (congrArg List.cons
                                          (congrArg (AspisR1.NLD.Event.mk site s) (congrArg Prod.snd h)))
                                        [])))))))
                          (congrArg Prod.fst
                            (congrArg Prod.snd
                              (Eq.trans (AspisR1.NLD.run.eq_2 s B site action k)
                                (Eq.trans
                                  (congrArg
