                                            (congrArg Prod.snd h) ▸
                                          Eq.refl (AspisR1.NLD.run (k b (action s).2) (action s).2).2)))))))))))
                    (AspisR1.NLD.Cuts.next site action k s post (AspisR1.NLD.run (k b post) post).2.1 b
                      (AspisR1.NLD.run (k b post) post).1 (AspisR1.NLD.run (k b post) post).2.2 h (ih b post post)))
