+fn push(d:&mut Dot,x:[u32;8],y:[u32;4],l:&mut Log)->Result<(),()>{l.left=x;l.right=y;l.before=*d;*d=l.after;l.calls+=1;if l.fail{Err(())}else{Ok(())}}
