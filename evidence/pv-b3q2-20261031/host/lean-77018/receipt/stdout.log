def Aeneas.Std.core.slice.iter.IteratorSliceIter.next : {T : Type} →
  core.slice.iter.Iter T → Result (Option T × core.slice.iter.Iter T) :=
fun {T} it =>
  if h : it.i < ↑it.slice.len then
    have x := it.slice[it.i];
    have it := { slice := it.slice, i := it.i + 1 };
    Result.ok (some x, it)
  else Result.ok (none, it)
