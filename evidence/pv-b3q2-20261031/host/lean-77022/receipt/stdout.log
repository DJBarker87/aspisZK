  Aeneas.Std.core.iter.traits.iterator.Iterator I Item →
    Aeneas.Std.core.iter.adapters.step_by.StepBy I →
      Aeneas.Std.Result (Option Item × Aeneas.Std.core.iter.adapters.step_by.StepBy I)
def Aeneas.Std.core.iter.traits.iterator.Iterator.step_by.default : {Self : Type} →
  Self → Aeneas.Std.Usize → Aeneas.Std.Result (Aeneas.Std.core.iter.adapters.step_by.StepBy Self) :=
fun {Self} self step_by =>
  if ↑step_by = 0 then Aeneas.Std.Result.fail Aeneas.Std.Error.panic
  else Aeneas.Std.Result.ok { iter := self, step_by := step_by }
def Aeneas.Std.Slice.subslice.{u} : {α : Type u} →
  Aeneas.Std.Slice α → Aeneas.Std.core.ops.range.Range Aeneas.Std.Usize → Aeneas.Std.Result (Aeneas.Std.Slice α) :=
fun {α} s r =>
  if ↑r.start < ↑r.end ∧ ↑r.end ≤ s.length then Aeneas.Std.Result.ok ⟨List.slice ↑r.start ↑r.end ↑s, ⋯⟩
  else Aeneas.Std.Result.fail Aeneas.Std.Error.panic
def Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice.index : {T : Type} →
  Aeneas.Std.core.ops.range.Range Aeneas.Std.Usize → Aeneas.Std.Slice T → Aeneas.Std.Result (Aeneas.Std.Slice T) :=
fun {T} r s =>
  if r.start ≤ r.end ∧ ↑r.end ≤ s.length then Aeneas.Std.Result.ok ⟨List.slice ↑r.start ↑r.end ↑s, ⋯⟩
  else Aeneas.Std.Result.fail Aeneas.Std.Error.panic
