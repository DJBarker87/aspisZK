def Aeneas.Std.core.iter.traits.iterator.Iterator.step_by.trait_default : {Self Item : Type} →
  core.iter.traits.iterator.Iterator Self Item → Self → Usize → Result (core.iter.adapters.step_by.StepBy Self) :=
fun {Self Item} _IteratorInst self step_by => core.iter.traits.iterator.Iterator.step_by.default self step_by
def Aeneas.Std.core.slice.cmp.PartialEqSlice.eq : {T U : Type} →
  core.cmp.PartialEq T U → Slice T → Slice U → Result Bool :=
fun {T U} partialEqInst s0 s1 =>
  if s0.length = s1.length then
    List.allM
      (fun x =>
        match x with
        | (x, y) => do
          let b ← partialEqInst.ne x y
          Result.ok (decide ¬b = true))
      ((↑s0).zip ↑s1)
  else Result.ok false
