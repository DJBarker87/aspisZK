set_option autoImplicit false
namespace NMS_R2RequestRefTotal
open Aeneas Aeneas.Std Result WP
open AspisR20Request
@[step] theorem reference_spec (bytes : Array U8 320#usize) :
 pool_v1.pair_forest_terminal.decode_pool_v1_pair_forest_terminal_request_reference_v1 bytes
  ⦃ _ => True ⦄ := by
 unfold pool_v1.pair_forest_terminal.decode_pool_v1_pair_forest_terminal_request_reference_v1
 unfold pool_v1.pair_forest_terminal.POOL_V1_PAIR_FOREST_TERMINAL_REQUEST_BYTES
   pool_v1.payment_relation.POOL_V1_PAYMENT_STATEMENT_BYTES
 simp only [bind_tc_ok]
 step*
 all_goals try scalar_tac
 all_goals try exact AspisS6StdByteSlice.eq_spec _ _
 all_goals step*
#print axioms reference_spec
end NMS_R2RequestRefTotal
