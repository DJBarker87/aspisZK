def AspisR1.SCC_Physical.FirstPassBinding : Verifier → Prover → F3T_Runtime.Runtime → Prop :=
fun rust P runtime =>
  ∀ (H : Bytes → State) (run : RunView),
    (eval H runtime).2 = some run → run.2.2 = true → run = eval H (originalWith rust P)
def AspisR1.SCC_Physical.StoredInputLaw : Prover → F3T_Runtime.Runtime → Prop :=
fun P runtime =>
  ∀ (H : Bytes → State) (run : RunView),
    (eval H runtime).2 = some run → run.2.2 = true → run.2.1.stored = (eval H P).2.stored
theorem AspisR1.SCC_Physical.accepted_unassociated : ∀ (P : Prover) (H : Bytes → State),
  ∃ runtime run,
    eval H runtime = ([], some run) ∧
      run.2.2 = true ∧
        run.2.1.stored ≠ (eval H P).2.stored ∧
          ¬SCC_Physical.StoredInputLaw P runtime ∧ ∀ (rust : Verifier), ¬SCC_Physical.FirstPassBinding rust P runtime :=
fun P H =>
  Exists.intro (SCC_Physical.constantRuntime (eval H P).2)
    (Exists.intro (SCC_Physical.acceptedView (eval H P).2)
      ⟨rfl,
        ⟨rfl,
          ⟨SCC_Physical.changed_stored (eval H P).2,
            ⟨fun law =>
              SCC_Physical.changed_stored (eval H P).2 (law H (SCC_Physical.acceptedView (eval H P).2) rfl rfl),
              fun rust binding =>
              SCC_Physical.changed_stored (eval H P).2
                (SCC_Physical.stored_of_first rust P (SCC_Physical.constantRuntime (eval H P).2) binding H
                  (SCC_Physical.acceptedView (eval H P).2) rfl rfl)⟩⟩⟩⟩)
def AspisR1.F3T_Runtime.StoredCarrierBinding : {F C : Type} →
  DrvC_Installation.Configuration F C →
    LiteralByteProtocol.Decoder → Verifier → F3T_ByteCarrier.ByteProver → F3T_Runtime.Runtime → Prop :=
fun {F C} c D rust P runtime =>
  ∀ (H : Bytes → State) (run : RunView),
    (eval H runtime).2 = some run →
      run.2.2 = true → run = eval H (annotatedWith D rust (F3T_Canon.canon (F3T_ByteCarrier.lift c P)))
