def AspisR1.CPR_DataPersistence.TwoTransactionLaw : {Tx Key : Type} →
  (Tx → Tx → Prop) →
    (Tx → Key → Prop) →
      (Tx → Key → CPR_DataPersistence.Image) →
        (Tx → Key → CPR_DataPersistence.Image) → (Tx → Bool) → (Tx → Key → Option Bytes) → Prop :=
fun {Tx Key} next ordinary before tentative success loaded =>
  ∀ (t u : Tx),
    next t u →
      ∀ (key : Key),
        ordinary t key →
          loaded u key = CPR_DataPersistence.visible (if success t = true then tentative t key else before t key)
