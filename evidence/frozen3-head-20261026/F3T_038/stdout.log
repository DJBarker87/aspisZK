                                  (AspisV8R19.MemoizedProgramLaw.eval H prior).1 ++
                                    AuS1_Recovery.log (Uni_Install.current ops reserved query geo)
                                      (F3M_CircleSource.install B0) std
                                      (SdkD_PairBatches.current a ops stage finish reserved query geo
                                        (F3M_CircleSource.install B0) std)
                                      (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.proof ()
                                      (Array.repeat 29#usize run.zero);
                                AuS1_Finish.Collision H trace p q ∨
                                  (AspisV8R19.MemoizedProgramLaw.eval H
                                          (GExq_CallerRecord.program a ops (AuS1_Install.base stage) finish reserved
                                            query geo (F3M_CircleSource.install B0) std hashv id accounts1 accounts2
                                            data1 data2 slot)).1 =
                                      (AspisV8R19.MemoizedProgramLaw.eval H (F3_Model.verifier decoder i)).1 ∧
                                    (AspisV8R19.MemoizedProgramLaw.eval H (F3_Model.verifier decoder i)).2 = true
'AspisR1.F3T_SourcePair.accepted_pair' depends on axioms: [propext, sorryAx, Classical.choice, Quot.sound]
