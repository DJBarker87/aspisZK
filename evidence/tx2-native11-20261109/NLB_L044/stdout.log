    (Aeneas.Std.Result.fail Aeneas.Std.Error.panic)
theorem NLB_ErrorTransport.entered_common_transport : ∀ (wr rr : AspisR1.NP6_StdModel.Reservation)
  (nativeMerkle modelMerkle : NJU_CommonObserved.Merkle) (finish : NJU_CommonObserved.Finish) {H : Type}
  (d : VTop_Stages.aspis_core.digest.Digest32 H) (pub proof ck : Aeneas.Std.Slice Aeneas.Std.U8) (hash : H),
  (∀ (proofArg : Aeneas.Std.Slice Aeneas.Std.U8) (p : VTop_Stages.verifier.Prepared)
      (root : Aeneas.Std.Array Aeneas.Std.U8 32#usize),
      NLB_ErrorTransport.MerkleDomain wr d ck proof pub hash proofArg p →
        NLB_ErrorTransport.ReplyRel (nativeMerkle d proofArg p root 1#usize hash)
          (modelMerkle d proofArg p root 1#usize hash)) →
    NLB_ErrorTransport.observeCommon
        (NJU_CommonObserved.run wr rr (fun {H} => nativeMerkle) finish d pub proof ck hash none) =
      NLB_ErrorTransport.observeCommon
        (NJU_CommonObserved.run wr rr (fun {H} => modelMerkle) finish d pub proof ck hash none) :=
