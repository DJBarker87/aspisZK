theorem NLB_Parent.transport_fold : ∀ (wr rr fr : AspisR1.NP6_StdModel.Reservation)
  (loc : AspisR1.NIW_AlignFinishComposed.Locations) (nativeResume : NLB_ResumePacket.Native)
  (nativeMerkle modelMerkle : NJU_CommonObserved.Merkle) {H : Type} (d : VTop_Stages.aspis_core.digest.Digest32 H)
  (pub proof ck : Aeneas.Std.Slice Aeneas.Std.U8) (hash : H),
  NLB_ResumePacket.At nativeResume wr d ck proof pub hash →
    (∀ (proofArg : Aeneas.Std.Slice Aeneas.Std.U8) (p : VTop_Stages.verifier.Prepared)
        (root : Aeneas.Std.Array Aeneas.Std.U8 32#usize),
        NLB_ErrorTransport.MerkleDomain wr d ck proof pub hash proofArg p →
          NLB_ErrorTransport.ReplyRel (nativeMerkle d proofArg p root 1#usize hash)
            (modelMerkle d proofArg p root 1#usize hash)) →
      (↑proof).length = 57607 →
        ∀ (observe : NKE_QueryInput.Args → NLB_Parent.QueryObservation),
          NLB_Parent.QueryCuts wr rr fr (fun {H} => nativeMerkle) d pub proof ck hash observe →
            ∀ (before : List NLB_Parent.Event),
              have w :=
                NLB_Parent.queryWindow
                  (NLB_Parent.window rr fr loc (fun {H} => NLB_ResumePacket.action nativeResume wr)
                    (fun {H} => nativeMerkle) d hash)
                  observe;
              have p :=
                NKE_CommonProgram.run wr rr (fun {H} => nativeMerkle) (NLB_Parent.finish fr) d pub proof ck hash none;
              NLB_Parent.G w p before =
                  NLB_Parent.State.done
                    (NJJ_Common.run wr rr (fun {H} => nativeMerkle) (NLB_Parent.finish fr) d pub proof ck hash none)
                    (before ++
                      (NJU_CommonObserved.run wr rr (fun {H} => nativeMerkle) (NLB_Parent.finish fr) d pub proof ck hash
                          none).events) ∧
                NLB_ErrorTransport.observeCommon
                    (NJU_CommonObserved.run wr rr (fun {H} => nativeMerkle) (NLB_Parent.finish fr) d pub proof ck hash
                      none) =
                  NLB_ErrorTransport.observeCommon
                    (NJU_CommonObserved.run wr rr (fun {H} => modelMerkle) (NLB_Parent.finish fr) d pub proof ck hash
                      none) :=
⋯
def NLB_ResumePacket.At : NLB_ResumePacket.Native →
  AspisR1.NP6_StdModel.Reservation →
    {H : Type} →
      VTop_Stages.aspis_core.digest.Digest32 H →
        Aeneas.Std.Slice Aeneas.Std.U8 → Aeneas.Std.Slice Aeneas.Std.U8 → Aeneas.Std.Slice Aeneas.Std.U8 → H → Prop :=
fun native r {H} d ck proof pub hash =>
  native r (NJC_ResumeCalls.digest d) ck proof pub hash =
    NJU_ResumeObserved.run r (NJC_ResumeCalls.digest d) ck proof pub NID_ResumeEmission.transport.Variant.S2 hash
@[reducible] def NLB_ResumePacket.Native : Type 1 :=
AspisR1.NP6_StdModel.Reservation →
  {H : Type} →
    AspisR1Stage2.aspis_core.digest.Digest32 H →
      Aeneas.Std.Slice Aeneas.Std.U8 →
        Aeneas.Std.Slice Aeneas.Std.U8 → Aeneas.Std.Slice Aeneas.Std.U8 → H → NLB_ResumePacket.Run
def NLB_Parent.QueryCut : NKE_QueryInput.Args → NLB_Parent.QueryObservation → Prop :=
fun before o =>
  ↑before.proof = NKO_ReadonlyFrame.view o.heap o.proofBase (↑before.proof).length ∧
    (o.proofBase + (↑before.proof).length ≤ o.logBase ∨ o.logBase + o.logSize ≤ o.proofBase) ∧
      NJJ_Constructors.PreparedCut before.prepared o.args.prepared ∧
        NJJ_Constructors.AccumulatorCut before.accumulator o.args.accumulator ∧
          (∀ (i : Fin 29), (↑o.args.powers)[↑i]? = (↑before.powers)[↑i]?) ∧
            NKE_GeometryCuts.Cut before.geometry o.args.geometry ∧
              (↑o.args.pending.raw).length = 64 ∧
                (∀ i < 64, (↑o.args.pending.raw)[i]? = (↑before.pending.raw)[i]?) ∧
                  o.args.pending.terms = before.pending.terms
def NLB_Parent.QueryCuts : AspisR1.NP6_StdModel.Reservation →
  AspisR1.NP6_StdModel.Reservation →
    AspisR1.NP6_StdModel.Reservation →
      NJU_CommonObserved.Merkle →
        {H : Type} →
          VTop_Stages.aspis_core.digest.Digest32 H →
            Aeneas.Std.Slice Aeneas.Std.U8 →
              Aeneas.Std.Slice Aeneas.Std.U8 →
                Aeneas.Std.Slice Aeneas.Std.U8 → H → (NKE_QueryInput.Args → NLB_Parent.QueryObservation) → Prop :=
fun wr rr fr modelMerkle {H} d pub proof ck hash observe =>
  ∀ (pr : Aeneas.Std.Slice Aeneas.Std.U8) (p : VTop_Stages.verifier.Prepared) (a : VTop_Stages.verifier.Accumulator)
    (g : Aeneas.Std.Array NJU_CommonObserved.E 29#usize) (geo : VTop_Stages.verifier.QueryGeometry)
    (pending : VTop_Stages.verifier.BatchedWeights)
    (reply : NJU_CommonObserved.R (VTop_Stages.verifier.Accumulator × VTop_Stages.verifier.BatchedWeights)),
    NJU_CommonObserved.Event.query pr p a g geo pending reply ∈
        (NJU_CommonObserved.run wr rr (fun {H} => modelMerkle) (NLB_Parent.finish fr) d pub proof ck hash none).events →
      NLB_Parent.QueryCut
        { proof := pr, prepared := p, accumulator := a, powers := g, geometry := geo, pending := pending }
        (observe { proof := pr, prepared := p, accumulator := a, powers := g, geometry := geo, pending := pending })
def NLB_ErrorTransport.MerkleDomain : AspisR1.NP6_StdModel.Reservation →
  {H : Type} →
    VTop_Stages.aspis_core.digest.Digest32 H →
      Aeneas.Std.Slice Aeneas.Std.U8 →
        Aeneas.Std.Slice Aeneas.Std.U8 →
          Aeneas.Std.Slice Aeneas.Std.U8 → H → Aeneas.Std.Slice Aeneas.Std.U8 → VTop_Stages.verifier.Prepared → Prop :=
fun wr {H} d ck proof pub hash proofArg p =>
  proofArg = proof ∧
    ∃ a,
      NJJ_Common.resume wr d ck proof pub AspisR1Stage2.transport.Variant.S2 hash =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (p, a)) ∧
        a.next = 10#usize ∧ NID_ResumeFields.Domain p a
inductive NLB_ErrorTransport.ReplyRel : NLB_ErrorTransport.R Unit → NLB_ErrorTransport.R Unit → Prop
number of parameters: 0
constructors:
NLB_ErrorTransport.ReplyRel.same : ∀ (reply : NLB_ErrorTransport.R Unit), NLB_ErrorTransport.ReplyRel reply reply
