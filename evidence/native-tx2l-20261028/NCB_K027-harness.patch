+#[cfg(kani)] mod NCB_dotcuts {
+use super::*;
+fn word(q:&[u8;608],at:usize)->u32{u32::from_le_bytes([q[at],q[at+1],q[at+2],q[at+3]])}
+#[kani::proof] #[kani::unwind(512)]
+#[kani::stub(<[u8]>::copy_from_slice,crate::NBS_copy::KMX_copy_from_slice)]
+#[kani::stub(core::ptr::copy_nonoverlapping,crate::NBS_copy::KMX_copy_nonoverlapping)]
+#[kani::stub(<[u8]>::clone_from_slice,crate::NBS_copy::KMX_clone_from_slice)]
+#[kani::stub(alloc::vec::Vec::<u8>::extend_from_slice,crate::NBS_copy::KMX_extend_from_slice)]
+#[kani::stub(<[u8]>::to_vec,crate::NBS_copy::KMX_to_vec)]
+#[kani::stub(alloc::alloc::realloc,crate::NBS_copy::KMX_realloc)]
+fn inner_iterator(){
+let q:[u8;608]=kani::any();let raw:[[u32;8];29]=kani::any();let g:[WideExact;29]=unsafe{core::mem::transmute(raw)};
+ let slot:usize=kani::any();kani::assume(slot<4);let start:usize=kani::any();let end:usize=kani::any();kani::assume(start<end&&end<=26);
+ let at=slot*120+start*4;let expected=word(&q,at);kani::assume(expected<2147483647);
+ let want=g[start].to_limbs();let mut iter=start..end;
+ let term=iter.next().unwrap();
+ let scalar = M31::from_le_bytes(
+                    q[slot * 120 + term * 4..slot * 120 + term * 4 + 4]
+                        .try_into()
+                        .unwrap(),
+                )
+                .unwrap();
+                let coefficient = g[term].to_limbs();
+
+assert!(term==start&&iter.start==start+1&&iter.end==end);
+}
