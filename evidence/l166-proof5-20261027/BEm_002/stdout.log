List.any_eq_true.{u_1} {α : Type u_1} {p : α → Bool} {l : List α} : l.any p = true ↔ ∃ x ∈ l, p x = true
List.any_eq_false.{u_1} {α : Type u_1} {p : α → Bool} {l : List α} : l.any p = false ↔ ∀ x ∈ l, ¬p x = true
Bool.eq_iff_iff {a b : Bool} : a = b ↔ (a = true ↔ b = true)
