List.any_flatten.{u_1} {α : Type u_1} {f : α → Bool} {l : List (List α)} : l.flatten.any f = l.any fun x => x.any f
List.any_map.{u_1, u_2} {α : Type u_1} {β : Type u_2} {f : α → β} {l : List α} {p : β → Bool} :
  (List.map f l).any p = l.any (p ∘ f)
