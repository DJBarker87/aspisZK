+fn NET_copy_positive(){let src:[u32;16]=kani::any();let mut dst=[0;16];dst.copy_from_slice(&src);let i:usize=kani::any();kani::assume(i<16);assert_eq!(dst[i],src[i]);}
+#[kani::proof] #[kani::unwind(18)]
+#[kani::stub(<[u32]>::copy_from_slice,KMX_copy_from_slice)]
+fn NET_copy_negative(){let mut src=[0u32;16];src[15]=512;let mut dst=[0;16];dst.copy_from_slice(&src);assert_eq!(dst[15],0);}
