+#[kani::stub(<[u8]>::copy_from_slice,KMX_copy_from_slice)]
+fn NET_q608(){
+ let mut raw:[u8;608]=kani::any();let slot:usize=kani::any();let tail:usize=kani::any();let first:bool=kani::any();
+ kani::assume(slot<4);kani::assume(tail<2);let start=offset(slot,tail,first);
+ let j:usize=kani::any();kani::assume(j<608);let before=raw[j];
+ let native=&raw[start..start+16];let native_ptr=native.as_ptr();
