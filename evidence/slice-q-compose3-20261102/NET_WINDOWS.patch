+mod NET_reference {include!("NET_window_reference.rs");}
+fn c_words(x:CM31)->[u32;2]{[x.a.0,x.b.0]}
+fn q_words(x:QM31)->[u32;4]{[x.c0.a.0,x.c0.b.0,x.c1.a.0,x.c1.b.0]}
+fn offset(slot:usize,tail:usize,first:bool)->usize{if first{slot*120+104}else{480+slot*32+tail*16}}
+#[kani::proof] #[kani::unwind(34)]
