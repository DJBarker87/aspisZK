+// One actual reserve, separately from the exact KMX loop's one push.
+fn NET_reserve_case<const N:usize,const M:usize>(){
+ assert_eq!(M,5*N);assert_eq!(core::mem::size_of::<M31>(),core::mem::size_of::<u32>());
+ assert_eq!(core::mem::align_of::<M31>(),core::mem::align_of::<u32>());
+ let k:usize=kani::any();kani::assume(k<N);let len=5*k;let raw:[u32;M]=kani::any();
+ let p=Box::into_raw(Box::new([core::mem::MaybeUninit::<M31>::uninit();M])) as *mut M31;
+ let mut j=0;while j<len{unsafe{p.add(j).write(M31(raw[j]));}j+=1;}
+ let mut dst=unsafe{Vec::from_raw_parts(p,len,M)};
+ let offset:usize=kani::any();kani::assume(offset<M);if offset<len{assert_eq!(dst[offset].0,raw[offset]);}
+ dst.reserve(5);
+ #[cfg(NET_bad_reply)] let cap=M+1;
+ #[cfg(not(NET_bad_reply))] let cap=M;
+ assert_eq!(dst.len(),len);assert_eq!(dst.capacity(),cap);assert_eq!(dst.as_ptr(),p);
+ if offset<len{assert_eq!(dst[offset].0,raw[offset]);}
+}
+fn NET_extend_step(dst:&mut Vec<M31>,src:&[M31;5],i:usize)->usize{
+ dst.push(src[i]);
+ let i=i+1;
+ i
+}
+fn NET_push_case<const N:usize,const M:usize>(){
+ assert_eq!(M,5*N);assert_eq!(core::mem::size_of::<M31>(),core::mem::size_of::<u32>());
+ assert_eq!(core::mem::align_of::<M31>(),core::mem::align_of::<u32>());
+ let k:usize=kani::any();kani::assume(k<N);let t:usize=kani::any();kani::assume(t<5);let len=5*k+t;
+ let raw:[u32;M]=kani::any();let values=row();
+ let p=Box::into_raw(Box::new([core::mem::MaybeUninit::<M31>::uninit();M])) as *mut M31;
+ let mut j=0;while j<len{unsafe{p.add(j).write(M31(raw[j]));}j+=1;}
+ let mut dst=unsafe{Vec::from_raw_parts(p,len,M)};
+ let offset:usize=kani::any();kani::assume(offset<M);if offset<len{assert_eq!(dst[offset].0,raw[offset]);}
+ let before_values=[values[0].0,values[1].0,values[2].0,values[3].0,values[4].0];
+ let out=NET_extend_step(&mut dst,&values,t);
+ #[cfg(NET_bad_reply)] {dst[len].0^=1;}
+ assert_eq!(out,t+1);assert_eq!(dst.len(),len+1);assert_eq!(dst.capacity(),M);assert_eq!(dst.as_ptr(),p);
+ assert_eq!(dst[len].0,before_values[t]);if offset<len{assert_eq!(dst[offset].0,raw[offset]);}
+ let selected:usize=kani::any();kani::assume(selected<5);assert_eq!(values[selected].0,before_values[selected]);
+}
