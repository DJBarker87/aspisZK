+}
+#[derive(Clone,Copy)]
+struct NET_BackEvent{a:u32,b:u32,reply:u32}
+struct NET_BackLog{events:[NET_BackEvent;2],next:usize}
+fn NET_back_product(a:M31,b:M31,reply:M31,log:&mut NET_BackLog)->M31{
+ let n=log.next;log.events[n]=NET_BackEvent{a:a.0,b:b.0,reply:reply.0};log.next+=1;reply
+}
+fn NET_back_step(flat:&Vec<M31>,prefixes:&Vec<M31>,inverse:&mut Vec<M31>,suffix:M31,i:usize,reply:[u32;2],log:&mut NET_BackLog)->M31{
+ inverse[i]=NET_back_product(suffix,prefixes[i],M31(reply[0]),log);
+ let suffix=NET_back_product(suffix,flat[i],M31(reply[1]),log);
+ suffix
+}
+fn NET_backward_case<const M:usize>(){
+ assert_eq!(core::mem::size_of::<M31>(),core::mem::size_of::<u32>());
+ assert_eq!(core::mem::align_of::<M31>(),core::mem::align_of::<u32>());
+ let flat_raw:[u32;M]=kani::any();let prefix_raw:[u32;M]=kani::any();let old:[u32;M]=kani::any();
+ let f=Box::into_raw(Box::new(flat_raw)) as *mut M31;
+ let p=Box::into_raw(Box::new(prefix_raw)) as *mut M31;
+ let out=Box::into_raw(Box::new(old)) as *mut M31;
+ let flat=unsafe{Vec::from_raw_parts(f,M,M)};let prefixes=unsafe{Vec::from_raw_parts(p,M,M)};let mut inverse=unsafe{Vec::from_raw_parts(out,M,M)};
+ let i:usize=kani::any();kani::assume(i<M);let j:usize=kani::any();kani::assume(j<M);
+ assert_eq!(flat[j].0,flat_raw[j]);assert_eq!(prefixes[j].0,prefix_raw[j]);assert_eq!(inverse[j].0,old[j]);
+ let suffix=M31(kani::any());let reply:[u32;2]=kani::any();
+ let mut log=NET_BackLog{events:[NET_BackEvent{a:0,b:0,reply:0};2],next:0};
+ let result=NET_back_step(&flat,&prefixes,&mut inverse,suffix,i,reply,&mut log);
+ #[cfg(NET_bad_reply)] {inverse[i].0^=1;}
+ assert_eq!(result.0,reply[1]);assert_eq!(inverse[i].0,reply[0]);
+ if j!=i{assert_eq!(inverse[j].0,old[j]);}
+ assert_eq!(flat[j].0,flat_raw[j]);assert_eq!(prefixes[j].0,prefix_raw[j]);
+ assert_eq!(inverse.len(),M);assert_eq!(inverse.capacity(),M);assert_eq!(inverse.as_ptr(),out);
+ assert_eq!(flat.as_ptr(),f);assert_eq!(prefixes.as_ptr(),p);
+ assert_eq!(log.next,2);assert_eq!(log.events[0].a,suffix.0);assert_eq!(log.events[0].b,prefix_raw[i]);assert_eq!(log.events[0].reply,reply[0]);
+ assert_eq!(log.events[1].a,suffix.0);assert_eq!(log.events[1].b,flat_raw[i]);assert_eq!(log.events[1].reply,reply[1]);
+}
+#[kani::proof] #[kani::unwind(4)]
+#[kani::stub(core::ptr::copy_nonoverlapping,KMX_copy_nonoverlapping)]
+fn NET_backward_tx1(){NET_backward_case::<50>()}
+#[kani::proof] #[kani::unwind(4)]
+#[kani::stub(core::ptr::copy_nonoverlapping,KMX_copy_nonoverlapping)]
+fn NET_backward_tx2(){NET_backward_case::<60>()}
