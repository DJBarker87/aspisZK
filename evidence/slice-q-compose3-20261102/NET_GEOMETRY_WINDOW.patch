+fn NET_gather_rejected(){
+ let values=row();kani::assume(values.iter().any(|x|*x==M31::ZERO));
+ let mut flat=Vec::new();let mut lines=Vec::new();
+ assert_eq!(NET_gather(&mut flat,&mut lines,values),Err(Error::Query));
