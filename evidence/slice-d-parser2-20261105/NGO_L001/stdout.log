theorem Aeneas.Std.core.iter.range.IteratorRange.next_UScalar_none_spec : ∀ {ty : UScalarTy}
  {cloneInst : core.clone.Clone (UScalar ty)} {partialOrdInst : core.cmp.PartialOrd (UScalar ty) (UScalar ty)},
  (∀ (a b : UScalar ty), partialOrdInst.lt a b = ok (decide (↑a < ↑b))) →
