fun N self offset_values =>
  if self.row < 14#u8 then ok (core.result.Result.Err AspisR1DecodeKFullV10.r1_wire.Error.InvalidRow)
  else do
    let o ← lift (offset_values.checked_mul 32#usize)
    let r ← AspisR1DecodeKFullV10.core.option.Option.ok_or o (AspisR1DecodeKFullV10.r1_wire.Error.Length self.row)
    let cf ← core.result.Result.Insts.CoreOpsTry.branch r
    match cf with
      | core.ops.control_flow.ControlFlow.Continue val => do
        let o1 ← lift (N.checked_mul 32#usize)
        let r1 ← AspisR1DecodeKFullV10.core.option.Option.ok_or o1 (AspisR1DecodeKFullV10.r1_wire.Error.Length self.row)
        let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
        match cf1 with
          | core.ops.control_flow.ControlFlow.Continue val1 => do
            let o2 ← lift (val.checked_add val1)
            let r2 ←
              AspisR1DecodeKFullV10.core.option.Option.ok_or o2 (AspisR1DecodeKFullV10.r1_wire.Error.Length self.row)
            let cf2 ← core.result.Result.Insts.CoreOpsTry.branch r2
            match cf2 with
              | core.ops.control_flow.ControlFlow.Continue val2 => do
                let s ← self.payload
                let o3 ←
                  core.slice.Slice.get (core.slice.index.SliceIndexRangeUsizeSlice U8) s { start := val, «end» := val2 }
                let r3 ←
                  AspisR1DecodeKFullV10.core.option.Option.ok_or o3
                      (AspisR1DecodeKFullV10.r1_wire.Error.Length self.row)
                let cf3 ← core.result.Result.Insts.CoreOpsTry.branch r3
                match cf3 with
                  | core.ops.control_flow.ControlFlow.Continue a =>
                    have out := Array.repeat N AspisR1DecodeKFullV10.aspis_core.field.QM31.ZERO;
                    do
                    let (out1, pending_return) ←
                      self.decode_k_loop { start := 0#usize, «end» := N } self.row offset_values val out
                    match pending_return with
                      | none => ok (core.result.Result.Ok out1)
                      | some r4 => ok r4
                  | core.ops.control_flow.ControlFlow.Break residual =>
                    core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
                      (Std.Array AspisR1DecodeKFullV10.aspis_core.field.QM31 N)
                      (core.convert.FromSame AspisR1DecodeKFullV10.r1_wire.Error) residual
              | core.ops.control_flow.ControlFlow.Break residual =>
                core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
                  (Std.Array AspisR1DecodeKFullV10.aspis_core.field.QM31 N)
                  (core.convert.FromSame AspisR1DecodeKFullV10.r1_wire.Error) residual
          | core.ops.control_flow.ControlFlow.Break residual =>
            core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
              (Std.Array AspisR1DecodeKFullV10.aspis_core.field.QM31 N)
              (core.convert.FromSame AspisR1DecodeKFullV10.r1_wire.Error) residual
      | core.ops.control_flow.ControlFlow.Break residual =>
        core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
          (Std.Array AspisR1DecodeKFullV10.aspis_core.field.QM31 N)
