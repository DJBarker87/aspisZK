fun {ty} {cloneInst} {partialOrdInst} h_lt range hge =>
  Eq.mpr
    (id
      (congrFun'
        (congrArg WP.spec
          (Eq.trans
            (Eq.trans
              (congr
                (congrArg Bind.bind
                  (Eq.trans ((fun a b => h_lt a b) range.start range.end)
                    (congrArg ok
                      (Eq.trans
                        (Decidable.decide.congr_simp (↑range.start < ↑range.end) False
                          (eq_false
                            (have this := fun a =>
                              core.iter.range.IteratorRange.next_UScalar_none_spec._proof_1_4 range hge a;
                            this)))
                        (decide_false instDecidableFalse)))))
                (funext fun cmp =>
                  ite_congr (Eq.refl (cmp = true))
                    (fun a =>
                      Eq.refl do
                        let range' ← cloneInst.clone range.start
                        let n ←
                          if h : ↑range' + ↑1#usize ≤ UScalar.max ty then
                              ok
