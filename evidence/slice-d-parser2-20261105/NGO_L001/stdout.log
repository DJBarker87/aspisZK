def NFU_Retarget.r1_wire.validate_record_fields : U8 →
  Slice U8 → Result (core.result.Result Unit NFU_Retarget.LPl_Kit_Release.r1_wire.Error) :=
fun row bytes =>
  match
    List.find? (fun i => !NFU_Retarget.LPl_Kit_Bytes.validChunk 8 true (List.take 32 (List.drop (32 * i) ↑bytes)))
      (List.range ((↑bytes).length / 32)) with
  | none => ok (core.result.Result.Ok ())
  | some i =>
    if h : i ≤ UScalar.cMax UScalarTy.Usize then
      ok (core.result.Result.Err (NFU_Retarget.LPl_Kit_Release.r1_wire.Error.NonCanonical row (UScalar.ofNat i h)))
    else fail Error.panic
