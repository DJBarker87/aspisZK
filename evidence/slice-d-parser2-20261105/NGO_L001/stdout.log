                                  (UScalar.ofNatCore (↑range' + ↑1#usize)
                                    (core.iter.range.UScalarStep.forward_checked._proof_7 range' 1#usize h)))
                            else ok none
                        match n with
                          | none => fail Error.panic
                          | some n => ok (some range', { start := n, «end» := range.end }))
                    fun a => Eq.refl (ok (none, range))))
              (bind_tc_ok false fun y =>
                if y = true then do
                  let range' ← cloneInst.clone range.start
                  let n ←
                    if h : ↑range' + ↑1#usize ≤ UScalar.max ty then
                        ok
                          (some
                            (UScalar.ofNatCore (↑range' + ↑1#usize)
                              (core.iter.range.UScalarStep.forward_checked._proof_7 range' 1#usize h)))
                      else ok none
                  match n with
                    | none => fail Error.panic
                    | some n => ok (some range', { start := n, «end» := range.end })
                else ok (none, range)))
            (ite_cond_eq_false
              (do
                let range' ← cloneInst.clone range.start
