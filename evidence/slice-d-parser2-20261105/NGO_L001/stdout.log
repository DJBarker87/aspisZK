theorem Aeneas.Std.core.iter.range.IteratorRange.next_UScalar_some_spec : ∀ {ty : UScalarTy}
  {cloneInst : core.clone.Clone (UScalar ty)} {partialOrdInst : core.cmp.PartialOrd (UScalar ty) (UScalar ty)},
