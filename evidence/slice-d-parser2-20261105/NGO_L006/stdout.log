@[irreducible] def Aeneas.Std.List.toChunksExact.{u_1} : {α : Type u_1} →
  (n : ℕ) → 0 < n → List α → List (List α) × List α :=
fun {α} n hn =>
  WellFounded.Nat.fix (fun x => x.length) fun l a =>
    if _h : l.length < n then ([], l)
    else
      match a (List.drop n l) ⋯ with
      | (chunks, rem) => (List.take n l :: chunks, rem)
def AspisR1PrefixAggregateParser.r1_wire.validate_record_fields_loop : core.iter.adapters.enumerate.Enumerate
    (core.slice.iter.ChunksExact U8) →
  U8 → Result (core.result.Result Unit AspisR1PrefixAggregateParser.r1_wire.Error) :=
fun iter row => loop (fun iter1 => AspisR1PrefixAggregateParser.r1_wire.validate_record_fields_loop.body row iter1) iter
def AspisR1PrefixAggregateParser.r1_wire.validate_record_fields_loop.body : U8 →
  core.iter.adapters.enumerate.Enumerate (core.slice.iter.ChunksExact U8) →
    Result
      (ControlFlow (core.iter.adapters.enumerate.Enumerate (core.slice.iter.ChunksExact U8))
        (core.result.Result Unit AspisR1PrefixAggregateParser.r1_wire.Error)) :=
fun row iter => do
  let (o, iter1) ←
    core.iter.adapters.enumerate.IteratorEnumerate.next (core.iter.traits.iterator.IteratorChunksExact U8) iter
  match o with
    | none => ok (ControlFlow.done (core.result.Result.Ok ()))
    | some p =>
      let (value, bytes) := p
      do
      let o1 ← AspisR1PrefixAggregateParser.field.wide_exact.WideExact.from_le_bytes bytes
      let r ←
        AspisR1PrefixAggregateParser.core.option.Option.ok_or o1
            (AspisR1PrefixAggregateParser.r1_wire.Error.NonCanonical row value)
      let cf ← core.result.Result.Insts.CoreOpsTry.branch r
      match cf with
        | core.ops.control_flow.ControlFlow.Continue val => do
          let q ← AspisR1PrefixAggregateParser.field.wide_exact.WideExact.impl.c1 val
          let b ←
            core.cmp.PartialEq.ne.trait_default AspisR1PrefixAggregateParser.field.QM31.Insts.CoreCmpPartialEqQM31 q
                AspisR1PrefixAggregateParser.field.QM31.ZERO
          if b = true then
              ok
                (ControlFlow.done
                  (core.result.Result.Err (AspisR1PrefixAggregateParser.r1_wire.Error.NonCanonical row value)))
            else ok (ControlFlow.cont iter1)
        | core.ops.control_flow.ControlFlow.Break residual => do
          let r1 ←
            core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual Unit
                (core.convert.FromSame AspisR1PrefixAggregateParser.r1_wire.Error) residual
          ok (ControlFlow.done r1)
