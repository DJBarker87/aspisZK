+pub(super) fn common_spec(c:&CommonPublicV1)->Result<(),PoolV1PaymentStatementFormatError> {
+ if c.pool==[0;32]||c.deployment_domain==[0;32]{Err(PoolV1PaymentStatementFormatError::ZeroRequiredBinding)}
