+use super::*;
+use core::cell::Cell;
+#[derive(Clone,Copy)]
+struct Hash<'a> {answer:[u8;32],left:&'a [u8],right:&'a [u8],coordinate:usize,calls:&'a Cell<usize>}
+impl Digest32 for Hash<'_> {
+ fn digest(&self,p:&[&[u8]])->[u8;32] {
+  assert_eq!(p.len(),3);assert_eq!(p[0].len(),1);assert_eq!(p[0][0],0x12);
+  assert_eq!(p[1].len(),32);assert_eq!(p[2].len(),32);
+  assert_eq!(p[1][self.coordinate],self.left[self.coordinate]);
+  assert_eq!(p[2][self.coordinate],self.right[self.coordinate]);
+  self.calls.set(self.calls.get()+1);self.answer
+ }
+}
+#[kani::proof] #[kani::unwind(34)]
+fn NBE_parent() {
+ let values:[[u8;32];16]=kani::any();let sibling:[u8;32]=kani::any();
+ let index:usize=kani::any();let c:usize=kani::any();let left:bool=kani::any();
+ kani::assume(index<15 && c<32);
+ let answer:[u8;32]=kani::any();let calls=Cell::new(0);
+ let hash=Hash{answer,left:&values[index],right:&values[index+1],coordinate:c,calls:&calls};
+ assert_eq!(occupied_binary_parent(hash,&values,index)[c],answer[c]);assert_eq!(calls.get(),1);
+ calls.set(0);
+ let hash=Hash{answer,left:if left {&values[index]}else{&sibling},right:if left{&sibling}else{&values[index]},coordinate:c,calls:&calls};
+ assert_eq!(sibling_binary_parent(hash,&values,index,&sibling,left)[c],answer[c]);assert_eq!(calls.get(),1);
+}
+#[derive(Clone,Copy)]struct NoHash;
+impl Digest32 for NoHash {fn digest(&self,_:&[&[u8]])->[u8;32]{assert!(false,"no digest on rejected admission");[0;32]}}
+#[kani::proof] #[kani::unwind(18)]
+fn NBE_zero_reject() {
+ let mut idx:[u32;16]=kani::any();let mut val:[[u8;32];16]=kani::any();
+ let before_idx=idx;let before_val=val;let root:[u8;32]=kani::any();
+ let n:usize=kani::any();kani::assume(n==0 || n>16);
+ assert!(!verify_in_place(NoHash,Arity::Two,&root,&mut idx,&mut val,n,&[]));
+ let i:usize=kani::any();let c:usize=kani::any();kani::assume(i<16 && c<32);
+ assert_eq!(idx[i],before_idx[i]);assert_eq!(val[i][c],before_val[i][c]);
+}
+fn NBE_row<H:Digest32>(hash:H,idx:&mut [u32;16],val:&mut [[u8;32];16],n:usize,nodes:&[u8],mut at:usize,mut w:usize,mut i:usize)->(bool,usize,usize,usize) {
+ let parent=index_at(idx,i)>>1;
+ let digest={
+                    if i + 1 < n && index_at(idx, i + 1) == index_at(idx, i) ^ 1 {
+                        let d = occupied_binary_parent(hash, val, i);
+                        i += 2;
+                        d
+                    } else {
+                        let Some(sibling) = nodes.get(at..at + 32) else { return (false,at,w,i) };
+                        at += 32;
+                        let d = sibling_binary_parent(hash, val, i, sibling, index_at(idx, i) & 1 == 0);
+                        i += 1;
+                        d
+                    }
+ };
+ idx[w]=parent;val[w]=digest;w+=1;
+ (true,at,w,i)
+}
+
+#[kani::proof] #[kani::unwind(18)]
+fn NBE_row_check(){
+ let mut idx:[u32;16]=kani::any();let mut val:[[u8;32];16]=kani::any();
+ let old_idx=idx;let old_val=val;let nodes:[u8;64]=kani::any();
+ let n:usize=kani::any();let i:usize=kani::any();let w:usize=kani::any();let at:usize=kani::any();
+ let length:usize=kani::any();let c:usize=kani::any();let k:usize=kani::any();
+ kani::assume(n>0 && n<=16 && i<n && w<=i && length<=64 && at<=length && c<32 && k<16);
+ let paired=i+1<n && idx[i+1]==idx[i]^1;
+ let answer:[u8;32]=kani::any();let calls=Cell::new(0);
+ // A missing sibling returns before the hash; pass arbitrary expected slices,
+ // which will be checked only if digest is actually called.
+ let sibling=if length-at>=32{&nodes[at..at+32]}else{&nodes[0..32]};
+ let (left,right):(&[u8],&[u8])=if paired{(&old_val[i],&old_val[i+1])}else if idx[i]&1==0{(&old_val[i],sibling)}else{(sibling,&old_val[i])};
+ let hash=Hash{answer,left,right,coordinate:c,calls:&calls};
+ let (ok,next_at,next_w,next_i)=NBE_row(hash,&mut idx,&mut val,n,&nodes[..length],at,w,i);
+ if !paired && length-at<32{
+  assert!(!ok);assert_eq!(next_at,at);assert_eq!(next_w,w);assert_eq!(next_i,i);assert_eq!(calls.get(),0);
+  assert_eq!(idx[k],old_idx[k]);assert_eq!(val[k][c],old_val[k][c]);
+ }else{
+  assert!(ok);assert_eq!(next_at,if paired{at}else{at+32});assert_eq!(next_w,w+1);assert_eq!(next_i,i+if paired{2}else{1});assert_eq!(calls.get(),1);
+  assert_eq!(idx[k],if k==w{old_idx[i]>>1}else{old_idx[k]});assert_eq!(val[k][c],if k==w{answer[c]}else{old_val[k][c]});
+ }
+}
