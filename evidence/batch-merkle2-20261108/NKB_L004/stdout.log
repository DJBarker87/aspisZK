                              | core.ops.control_flow.ControlFlow.Break residual => do
                                let _ ←
                                  match residual with
                                    | core.result.Result.Ok x =>
                                      core.convert.Infallible.rec
                                        (fun x => Result (core.result.Result Unit NJS_Extract.verifier.Error)) x
                                    | core.result.Result.Err e =>
                                      ok (core.result.Result.Err (core.convert.FromSame.from e))
                                ok (done (idx, val, none)))
                          (Eq.trans
                            (bind_tc_ok
                              (core.ops.control_flow.ControlFlow.Break
                                (core.result.Result.Err NJS_Extract.verifier.Error.Merkle))
                              fun y =>
                              match y with
                              | core.ops.control_flow.ControlFlow.Continue val1 => do
                                let nodes ←
                                  NJS_Extract.verifier.candidate.slot (fun x => fail Error.panic) proof 0#usize
                                let i ← NJS_Extract.compact.SLOT_NODES.index_usize 0#usize
                                if val1 > i then ok (done (idx, val, none))
                                  else do
                                    let i1 ← lift (Usize.wrapping_mul 32#usize val1)
                                    let s2 ←
                                      core.slice.index.Slice.index (core.slice.index.SliceIndexRangeFromUsizeSlice U8)
                                          nodes { start := i1 }
                                    let _ ← core.slice.Slice.chunks_exact s2 8#usize
                                    let (b, _) ← fail Error.panic
                                    if b = true then ok (done (idx, val, none))
                                      else do
                                        let i2 ← lift (Usize.wrapping_mul 32#usize val1)
                                        let _ ←
                                          core.slice.index.Slice.index (core.slice.index.SliceIndexRangeToUsizeSlice U8)
                                              nodes { «end» := i2 }
                                        let (b1, idx1, val2) ← fail Error.panic
                                        if b1 = true then ok (done (idx1, val2, some (core.result.Result.Ok ())))
                                          else ok (done (idx1, val2, none))
                              | core.ops.control_flow.ControlFlow.Break residual => do
                                let _ ←
                                  match residual with
                                    | core.result.Result.Ok x =>
                                      core.convert.Infallible.rec
                                        (fun x => Result (core.result.Result Unit NJS_Extract.verifier.Error)) x
                                    | core.result.Result.Err e =>
                                      ok (core.result.Result.Err (core.convert.FromSame.from e))
                                ok (done (idx, val, none)))
                            (bind_tc_ok
                              (core.result.Result.Err (core.convert.FromSame.from NJS_Extract.verifier.Error.Merkle))
                              fun y => ok (done (idx, val, none))))))))
                (ok (done (idx, val, none)))))
            sorry))))
