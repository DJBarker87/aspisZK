def Aeneas.Std.UScalar.shiftRight : {ty : Aeneas.Std.UScalarTy} →
  Aeneas.Std.UScalar ty → ℕ → Aeneas.Std.Result (Aeneas.Std.UScalar ty) :=
fun {ty} x s =>
  if s < ty.numBits then Aeneas.Std.Result.ok (x.bv.ushiftRight s#uscalar)
  else Aeneas.Std.Result.fail Aeneas.Std.Error.integerOverflow
def Aeneas.Std.UScalar.div : {ty : Aeneas.Std.UScalarTy} →
