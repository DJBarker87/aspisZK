+use super::*;
+pub(crate) fn make(x:[u64;8],count:usize)->EbyKDot{EbyKDot{c0:canonical::NDL_dot::make([x[0],x[1],x[2],x[3]]),c1:canonical::NDL_dot::make([x[4],x[5],x[6],x[7]]),count}}
+pub(crate) fn word(x:&EbyKDot,i:usize)->u64{if i<4{canonical::NDL_dot::word(&x.c0,i)}else{canonical::NDL_dot::word(&x.c1,i-4)}}
+pub(crate) fn count(x:&EbyKDot)->usize{x.count}
