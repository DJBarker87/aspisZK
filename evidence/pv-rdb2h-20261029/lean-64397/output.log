      (Aeneas.Std.Result.casesOn (motive := fun t =>
        R1Z.PV_RDB2E_FromFn.build f n 0 s = t →
          (do
              let (tail, after) ← R1Z.PV_RDB2E_FromFn.build f n 0 s
