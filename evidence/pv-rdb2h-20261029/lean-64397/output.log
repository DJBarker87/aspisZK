theorem R1Z.PV_RDB2F_LoadWrites.every_store : ∀ {A : Type} (old decoded : List A),
  old.length = decoded.length → R1Z.PV_RDB2F_LoadWrites.zipStores old decoded = decoded :=
fun {A} old decoded length =>
  List.rec (motive := fun old =>
    ∀ (decoded : List A), old.length = decoded.length → R1Z.PV_RDB2F_LoadWrites.zipStores old decoded = decoded)
    (fun decoded length =>
      List.casesOn (motive := fun t => decoded = t → R1Z.PV_RDB2F_LoadWrites.zipStores [] decoded = decoded) decoded
        (fun h =>
          Eq.ndrec (motive := fun decoded =>
            [].length = decoded.length → R1Z.PV_RDB2F_LoadWrites.zipStores [] decoded = decoded)
            (fun length => of_eq_true (Eq.trans (congrFun' (congrArg Eq List.zipWith_self) []) (eq_self [])))
            (Eq.symm h) length)
        (fun head tail h =>
          Eq.ndrec (motive := fun decoded =>
            [].length = decoded.length → R1Z.PV_RDB2F_LoadWrites.zipStores [] decoded = decoded)
            (fun length =>
              False.elim
                (Eq.mp
                  (Eq.trans Nat.right_eq_add._simp_1
                    (Eq.trans Nat.add_eq_zero_iff._simp_1
                      (Eq.trans (congr (congrArg And List.length_eq_zero_iff._simp_1) one_ne_zero._simp_1)
                        (and_false (tail = [])))))
                  length))
            (Eq.symm h) length)
        (Eq.refl decoded))
    (fun x old ih decoded length =>
      List.casesOn (motive := fun t => decoded = t → R1Z.PV_RDB2F_LoadWrites.zipStores (x :: old) decoded = decoded)
        decoded
        (fun h =>
          Eq.ndrec (motive := fun decoded =>
            (x :: old).length = decoded.length → R1Z.PV_RDB2F_LoadWrites.zipStores (x :: old) decoded = decoded)
            (fun length =>
              False.elim
                (Eq.mp
                  (Eq.trans Nat.add_eq_zero_iff._simp_1
                    (Eq.trans (congr (congrArg And List.length_eq_zero_iff._simp_1) one_ne_zero._simp_1)
                      (and_false (old = []))))
                  length))
            (Eq.symm h) length)
        (fun y decoded_1 h =>
          Eq.ndrec (motive := fun decoded =>
            (x :: old).length = decoded.length → R1Z.PV_RDB2F_LoadWrites.zipStores (x :: old) decoded = decoded)
            (fun length =>
              have h := Eq.mp Nat.add_right_cancel_iff._simp_1 length;
              id (congrArg (List.cons y) (ih decoded_1 h)))
            (Eq.symm h) length)
        (Eq.refl decoded))
    old decoded length
