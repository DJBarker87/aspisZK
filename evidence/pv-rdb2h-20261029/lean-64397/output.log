          (R1Z.PV_RDB2E_Dispatch.select backend R1Z.PV_RDB2F_ConcreteSoft.software shani) f valid)))
    (R1Z.PV_RDB2D_SHAState.all_mutable_fields
      (R1Z.PV_RDB2E_Dispatch.select backend R1Z.PV_RDB2F_ConcreteSoft.software shani) f.core f.buffer
