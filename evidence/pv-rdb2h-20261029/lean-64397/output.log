theorem R1Z.PV_RDB2F_ShaNi.loop_refinement : ∀ (intr : R1Z.PV_RDB2F_ShaNi.Intrinsics),
  R1Z.PV_RDB2F_ShaNi.SHA_NI_IntrinsicsSemantics intr →
    ∀ (input : List R1Z.PV_RDB2F_ShaNi.Block) (state : R1Z.PV_RDB2F_ShaNi.State),
      R1Z.PV_RDB2F_ShaNi.hardwareLoop intr input state = R1Z.PV_RDB2F_SoftOuter.blocks input state :=
fun intr h input state =>
  List.rec (motive := fun input =>
    ∀ (state : R1Z.PV_RDB2F_ShaNi.State),
      R1Z.PV_RDB2F_ShaNi.hardwareLoop intr input state = R1Z.PV_RDB2F_SoftOuter.blocks input state)
    (fun state => Eq.refl (R1Z.PV_RDB2F_ShaNi.hardwareLoop intr [] state))
    (fun block tail ih state =>
      Eq.mpr
        (id
          (congrFun'
            (congrArg Eq
              (congr (congrArg bind (congrFun h.load block))
                (funext fun words =>
                  congrFun'
                    (congrArg bind
                      ((fun state words => R1Z.PV_RDB2F_ShaNi.word_block_semantics intr h state words) state words))
                    fun after => R1Z.PV_RDB2F_ShaNi.hardwareLoop intr tail after)))
            do
            let block_u32 ← PV_CBL_ShaBytes.sha_load64 block
            let state_cpy ← PV_CBL_FallbackBlock.sha_fallback_reference.extracted_block state block_u32
            R1Z.PV_RDB2F_SoftOuter.blocks tail state_cpy))
        ((Aeneas.Std.bind_eq_iff (PV_CBL_ShaBytes.sha_load64 block)
              (fun words => do
                let after ← PV_CBL_FallbackBlock.sha_fallback_reference.extracted_block state words
                R1Z.PV_RDB2F_ShaNi.hardwareLoop intr tail after)
              fun block_u32 => do
              let state_cpy ← PV_CBL_FallbackBlock.sha_fallback_reference.extracted_block state block_u32
              R1Z.PV_RDB2F_SoftOuter.blocks tail state_cpy).mpr
          fun words hw =>
          (Aeneas.Std.bind_eq_iff (PV_CBL_FallbackBlock.sha_fallback_reference.extracted_block state words)
                (fun after => R1Z.PV_RDB2F_ShaNi.hardwareLoop intr tail after) fun state_cpy =>
                R1Z.PV_RDB2F_SoftOuter.blocks tail state_cpy).mpr
            fun next hn => ih next))
    input state
theorem R1Z.PV_RDB2F_ShaNi.digest_blocks_refinement : ∀ (intr : R1Z.PV_RDB2F_ShaNi.Intrinsics),
  R1Z.PV_RDB2F_ShaNi.SHA_NI_IntrinsicsSemantics intr →
    ∀ (state : R1Z.PV_RDB2F_ShaNi.State) (input : List R1Z.PV_RDB2F_ShaNi.Block),
      R1Z.PV_RDB2F_ShaNi.digestBlocks intr state input = R1Z.PV_RDB2F_SoftOuter.compress state input :=
fun intr h state input =>
  Eq.mpr
    (id
      (congrFun'
        (congrArg Eq
          (Eq.trans
            (congr (congrArg bind ((fun s => h.pack s) state))
              (funext fun packed =>
                congrFun'
                  (congrArg bind
                    ((fun input state => R1Z.PV_RDB2F_ShaNi.loop_refinement intr h input state) input packed))
                  fun after => intr.unpack after))
            (Aeneas.Std.bind_tc_ok state fun y => do
              let after ← R1Z.PV_RDB2F_SoftOuter.blocks input y
              intr.unpack after)))
        do
        let state_cpy ← R1Z.PV_RDB2F_SoftOuter.blocks input state
        Aeneas.Std.Result.ok state_cpy))
    ((Aeneas.Std.bind_eq_iff (R1Z.PV_RDB2F_SoftOuter.blocks input state) (fun after => intr.unpack after)
          fun state_cpy => Aeneas.Std.Result.ok state_cpy).mpr
      fun after ha => h.unpack after)
theorem R1Z.PV_RDB2F_ShaNi.one_block_refinement : ∀ (intr : R1Z.PV_RDB2F_ShaNi.Intrinsics),
  R1Z.PV_RDB2F_ShaNi.SHA_NI_IntrinsicsSemantics intr →
    R1Z.PV_RDB2F_ShaNi.oneBlock intr = R1Z.PV_RDB2F_ConcreteSoft.software :=
fun intr h =>
  funext fun state =>
    funext fun bytes =>
      id
        (id
          (Decidable.casesOn (instDecidableEqNat bytes.length 64)
            (fun h =>
              Eq.mpr (id (congr (congrArg Eq (dif_neg h)) (dif_neg h)))
                (Eq.refl (Aeneas.Std.Result.fail Aeneas.Std.Error.panic)))
            fun h_1 =>
            Eq.mpr (id (congr (congrArg Eq (dif_pos h_1)) (dif_pos h_1)))
              (Eq.mpr
                (id
                  (congrArg
                    (fun _a =>
                      _a = do
                        let words ← PV_CBL_ShaBytes.sha_load64 ⟨bytes, h_1⟩
                        PV_CBL_FallbackBlock.sha_fallback_reference.extracted_block state words)
                    (R1Z.PV_RDB2F_ShaNi.digest_blocks_refinement intr h state [⟨bytes, h_1⟩])))
                (Eq.mpr
                  (id
                    (congrFun'
                      (congrArg Eq
