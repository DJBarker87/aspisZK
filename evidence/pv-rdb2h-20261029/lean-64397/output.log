  else Aeneas.Std.Result.fail Aeneas.Std.Error.panic
theorem R1Z.PV_RDB2F_Iterator.digits_body : ∀ (q ds : R1Z.PV_RDB2F_Iterator.Words) (i : Aeneas.Std.Usize),
  R1Z.PV_RDB2F_Iterator.digitsBody q ds i = R1Z.PV_RDB2D_SamplerRestoration.digitsBody q ds i :=
fun q ds i =>
  of_eq_true
    (Eq.trans
      (congrFun'
        (congrArg Eq
          (ite_congr (Eq.refl (i < 8#usize))
            (fun a =>
              congrFun' (congrArg bind (R1Z.PV_RDB2F_Iterator.division_complete q 0#u64 8#usize))
                (Aeneas.Std.uncurry fun q1 r => do
                  let value ← Aeneas.Std.lift (Aeneas.Std.UScalar.cast Aeneas.Std.UScalarTy.U32 r)
                  let ds1 ← Aeneas.Std.Array.update ds i value
                  let j ← Aeneas.Std.lift (i.wrapping_add 1#usize)
                  Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.cont (q1, ds1, j))))
            fun a => Eq.refl (Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.done (q, ds)))))
        (if i < 8#usize then do
          let (q1, remainder) ← R1Z.PV_RDB2D_SamplerRestoration.division q 0#u64 8#usize
          let digit ← Aeneas.Std.lift (Aeneas.Std.UScalar.cast Aeneas.Std.UScalarTy.U32 remainder)
          let ds1 ← Aeneas.Std.Array.update ds i digit
          let d1 ← Aeneas.Std.lift (i.wrapping_add 1#usize)
          Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.cont (q1, ds1, d1))
        else Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.done (q, ds))))
      (eq_self
        (if i < 8#usize then do
          let (q1, r) ← R1Z.PV_RDB2D_SamplerRestoration.division q 0#u64 8#usize
          let value ← Aeneas.Std.lift (Aeneas.Std.UScalar.cast Aeneas.Std.UScalarTy.U32 r)
          let ds1 ← Aeneas.Std.Array.update ds i value
          let j ← Aeneas.Std.lift (i.wrapping_add 1#usize)
          Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.cont (q1, ds1, j))
        else Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.done (q, ds)))))
theorem R1Z.PV_RDB2F_Iterator.digits_complete : ∀ (q ds : R1Z.PV_RDB2F_Iterator.Words) (i : Aeneas.Std.Usize),
  R1Z.PV_RDB2F_Iterator.digits q ds i = PV_B2_C_Sampler.host_sampler.low_base_p_digits_loop1 q ds i :=
fun q ds i =>
