  R1Z.PV_RDB2F_Iterator.Words →
    Aeneas.Std.Usize →
      Aeneas.Std.Result
        (Aeneas.Std.ControlFlow (R1Z.PV_RDB2F_Iterator.Words × R1Z.PV_RDB2F_Iterator.Words × Aeneas.Std.Usize)
          (R1Z.PV_RDB2F_Iterator.Words × R1Z.PV_RDB2F_Iterator.Words)) :=
