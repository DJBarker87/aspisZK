            (fun h => do
              let words ← PV_CBL_ShaBytes.sha_load64 ⟨block, h⟩
              PV_CBL_FallbackBlock.sha_fallback_reference.extracted_block state words)
            fun h => Aeneas.Std.Result.fail Aeneas.Std.Error.panic))
        (Aeneas.Std.Result.fail Aeneas.Std.Error.panic))
      (eq_self (Aeneas.Std.Result.fail Aeneas.Std.Error.panic)))
