            (congrFun' (congrArg Eq (dif_neg h)) do
              let words ← PV_CBL_ShaBytes.sha_load64 block
              PV_CBL_FallbackBlock.sha_fallback_reference.extracted_block state words))
          (False.elim
            (h
              (have this := block.property;
              this))))
      fun h =>
      Eq.mpr
        (id
          (congrFun' (congrArg Eq (dif_pos h)) do
            let words ← PV_CBL_ShaBytes.sha_load64 block
            PV_CBL_FallbackBlock.sha_fallback_reference.extracted_block state words))
        (Eq.refl do
          let words ← PV_CBL_ShaBytes.sha_load64 ⟨↑block, h⟩
          PV_CBL_FallbackBlock.sha_fallback_reference.extracted_block state words))
