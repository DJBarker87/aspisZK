theorem R1Z.PV_RDB2F_ConcreteSoft.wrong_length : ∀ (state : R1Z.PV_RDB2E_ShaHandles.State) (block : List Aeneas.Std.U8),
  block.length ≠ 64 → R1Z.PV_RDB2F_ConcreteSoft.software state block = Aeneas.Std.Result.fail Aeneas.Std.Error.panic :=
fun state block h =>
  of_eq_true
    (Eq.trans
      (congrFun'
        (congrArg Eq
          ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => dif_neg h) x_0 x_1 x_2 x_3)
