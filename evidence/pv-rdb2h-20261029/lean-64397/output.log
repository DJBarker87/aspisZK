theorem R1Z.PV_RDB2F_ByteArray.native_byte_store : ∀ (n : Aeneas.Std.Usize) (current : Aeneas.Std.Array Aeneas.Std.U8 n)
  (mem : R1Z.PV_RDB2F_ByteArray.Memory) (base : ℕ) (i : Aeneas.Std.Usize) (value : Aeneas.Std.U8),
  ↑i < ↑n →
    R1Z.PV_RDB2F_ByteArray.Represents n mem base current →
      R1Z.PV_RDB2F_ByteArray.Represents n (R1Z.PV_RDB2F_ByteArray.store mem (base + ↑i) value) base
        (current.set i value) :=
fun n current mem base i value h rep j hj =>
  if e : ↑j = ↑i then
    have read :=
      of_eq_true
        (Eq.trans
          (congrFun'
            (congrArg Eq
              (Eq.trans
                (Eq.trans (congrFun' (congrArg getElem? (Aeneas.Std.Array.set_val_eq current i value)) ↑i)
                  (getElem?_pos ((↑current).set (↑i) value) (↑i)
                    (of_eq_true
                      (Eq.trans (congrArg (LT.lt ↑i) (Eq.trans List.length_set current.property)) (eq_true h)))))
                (congrArg some
                  (List.getElem_set_self
                    (of_eq_true
                      (Eq.trans (congrArg (LT.lt ↑i) (Eq.trans List.length_set current.property)) (eq_true h)))))))
            (some value))
          (eq_self (some value)));
    Eq.mpr
      (id
        (congrFun'
          (congrArg Eq
            (Eq.trans
              (ite_congr
                (Eq.trans
                  (congrFun'
                    (congrArg Eq
                      (have this :=
                        Decidable.byContradiction fun a =>
                          R1Z.PV_RDB2F_ByteArray.native_byte_store._proof_2 n base i j e a;
                      this))
                    (base + ↑i))
                  (eq_self (base + ↑i)))
                (fun a => Eq.refl (some value)) fun a =>
                congrArg mem
                  (have this :=
                    Decidable.byContradiction fun a => R1Z.PV_RDB2F_ByteArray.native_byte_store._proof_2 n base i j e a;
                  this))
              (if_true (some value) (mem (base + ↑i)))))
          (↑(current.set i value))[↑j]?))
      (Eq.mpr (id (congrArg (Eq (some value)) (congrArg (getElem? ↑(current.set i value)) e))) (Eq.symm read))
  else
    have frame :=
      of_eq_true
        (Eq.trans
          (congrFun'
            (congrArg Eq
              (Eq.trans (congrFun' (congrArg getElem? (Aeneas.Std.Array.set_val_eq current i value)) ↑j)
                (List.getElem?_set_ne (of_eq_true (Eq.trans (congrArg Not (eq_false (Ne.symm e))) not_false_eq_true)))))
            (↑current)[↑j]?)
          (eq_self (↑current)[↑j]?));
    Eq.mpr
      (id
        (congr
          (congrArg Eq
            (Eq.trans
              (ite_congr
                (eq_false
                  (have this := fun a => R1Z.PV_RDB2F_ByteArray.native_byte_store._proof_3 n base i j e a;
                  this))
                (fun a => Eq.refl (some value)) fun a => Eq.refl (mem (base + ↑j)))
              (if_false (some value) (mem (base + ↑j)))))
          frame))
      (rep j hj)
theorem R1Z.PV_RDB2F_ByteArray.other_allocation : ∀ (mem : R1Z.PV_RDB2F_ByteArray.Memory) (ptr a : ℕ)
