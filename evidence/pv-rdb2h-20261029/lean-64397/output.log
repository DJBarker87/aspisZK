theorem R1Z.PV_RDB2F_Iterator.low_complete : ∀ (b : Aeneas.Std.Array Aeneas.Std.U8 32#usize),
  R1Z.PV_RDB2F_Iterator.low b = PV_B2_C_Sampler.host_sampler.low_base_p_digits b :=
fun b =>
  of_eq_true
    (Eq.trans
      (congrFun'
        (congrArg Eq
          (congrArg
            (bind
              (PV_B2_C_Sampler.host_sampler.low_base_p_digits_loop0 b (Aeneas.Std.Array.repeat 8#usize 0#u32) 0#usize))
            (funext fun q =>
              congrFun'
                (congrArg bind
                  (R1Z.PV_RDB2F_Iterator.digits_complete q (Aeneas.Std.Array.repeat 8#usize 0#u32) 0#usize))
                (Aeneas.Std.uncurry fun q1 ds => do
                  PV_B2_C_Sampler.host_sampler.low_base_p_digits_loop2 1#usize
                  let high ← Aeneas.Std.Array.index_usize q1 0#usize
                  Aeneas.Std.Result.ok (ds, high)))))
        do
        let quotient1 ←
          PV_B2_C_Sampler.host_sampler.low_base_p_digits_loop0 b (Aeneas.Std.Array.repeat 8#usize 0#u32) 0#usize
        let (quotient2, digits1) ←
          PV_B2_C_Sampler.host_sampler.low_base_p_digits_loop1 quotient1 (Aeneas.Std.Array.repeat 8#usize 0#u32) 0#usize
        PV_B2_C_Sampler.host_sampler.low_base_p_digits_loop2 1#usize
        let i ← quotient2.index_usize 0#usize
        Aeneas.Std.Result.ok (digits1, i))
      (eq_self do
        let q ← PV_B2_C_Sampler.host_sampler.low_base_p_digits_loop0 b (Aeneas.Std.Array.repeat 8#usize 0#u32) 0#usize
        let (q1, ds) ←
          PV_B2_C_Sampler.host_sampler.low_base_p_digits_loop1 q (Aeneas.Std.Array.repeat 8#usize 0#u32) 0#usize
        PV_B2_C_Sampler.host_sampler.low_base_p_digits_loop2 1#usize
        let high ← Aeneas.Std.Array.index_usize q1 0#usize
        Aeneas.Std.Result.ok (ds, high)))
theorem R1Z.PV_RDB2F_Iterator.final_read_uses_returned_quotient : ∀ (q ds : R1Z.PV_RDB2F_Iterator.Words)
  (out : R1Z.PV_RDB2F_Iterator.Words × R1Z.PV_RDB2F_Iterator.Words),
  R1Z.PV_RDB2F_Iterator.digits q ds 0#usize = Aeneas.Std.Result.ok out →
    (do
        let (current, _) ← R1Z.PV_RDB2F_Iterator.digits q ds 0#usize
        Aeneas.Std.Array.index_usize current 0#usize) =
      Aeneas.Std.Array.index_usize out.1 0#usize :=
fun q ds out h =>
  Eq.mpr
    (id
      (congrFun'
        (congrArg Eq
          (Eq.trans
            (congrFun' (congrArg bind h)
              (Aeneas.Std.uncurry fun current _ => Aeneas.Std.Array.index_usize current 0#usize))
            (Aeneas.Std.bind_tc_ok out
              (Aeneas.Std.uncurry fun current _ => Aeneas.Std.Array.index_usize current 0#usize))))
        (Aeneas.Std.Array.index_usize out.1 0#usize)))
    (Eq.refl
      (let (current, _) := out
      Aeneas.Std.Array.index_usize current 0#usize))
def R1Z.PV_RDB2F_Iterator.low : Aeneas.Std.Array Aeneas.Std.U8 32#usize →
  Aeneas.Std.Result (R1Z.PV_RDB2F_Iterator.Words × Aeneas.Std.U32) :=
fun b => do
  let q ← PV_B2_C_Sampler.host_sampler.low_base_p_digits_loop0 b (Aeneas.Std.Array.repeat 8#usize 0#u32) 0#usize
  let (q1, ds) ← R1Z.PV_RDB2F_Iterator.digits q (Aeneas.Std.Array.repeat 8#usize 0#u32) 0#usize
  PV_B2_C_Sampler.host_sampler.low_base_p_digits_loop2 1#usize
  let high ← Aeneas.Std.Array.index_usize q1 0#usize
  Aeneas.Std.Result.ok (ds, high)
theorem R1Z.PV_RDB2F_NativeLoanFrame.disjoint_stores_commute : ∀ (mem : R1Z.PV_RDB2F_ByteArray.Memory) (p q : ℕ)
  (x y : Aeneas.Std.U8),
  p ≠ q →
    R1Z.PV_RDB2F_ByteArray.store (R1Z.PV_RDB2F_ByteArray.store mem p x) q y =
      R1Z.PV_RDB2F_ByteArray.store (R1Z.PV_RDB2F_ByteArray.store mem q y) p x :=
fun mem p q x y ne =>
  funext fun a =>
    if hp : a = p then
      if hq : a = q then
        Eq.mpr
          (id
            (Eq.trans
              (congr
                (congrArg Eq
                  (ite_cond_eq_true (some y) (R1Z.PV_RDB2F_ByteArray.store mem p x a)
                    (Eq.trans
                      (congr
                        (congrArg Eq (id (Eq.mp (congrArg (Eq a) (id (Eq.mp (congrFun' (congrArg Eq hq) p) hp))) hq)))
                        (id (Eq.mp (congrFun' (congrArg Eq hq) p) hp)))
                      (eq_self p))))
                (ite_cond_eq_true (some x) (R1Z.PV_RDB2F_ByteArray.store mem q y a)
                  (Eq.trans
                    (congrFun'
                      (congrArg Eq (id (Eq.mp (congrArg (Eq a) (id (Eq.mp (congrFun' (congrArg Eq hq) p) hp))) hq))) p)
                    (eq_self p))))
              (Option.some.injEq y x)))
          (False.elim
            (Eq.mp
              (Eq.trans
                (congrArg Not (Eq.trans (congrArg (Eq p) (id (Eq.mp (congrFun' (congrArg Eq hq) p) hp))) (eq_self p)))
                not_true_eq_false)
              (id ne)))
      else
        of_eq_true
          (Eq.trans
            (congr
              (congrArg Eq
                (Eq.trans
                  (ite_cond_eq_false (some y) (R1Z.PV_RDB2F_ByteArray.store mem p x a)
                    (Eq.trans (congrFun' (congrArg Eq hp) q) (eq_false (id (id ne)))))
                  (ite_cond_eq_true (some x) (mem a) (Eq.trans (congrFun' (congrArg Eq hp) p) (eq_self p)))))
              (ite_cond_eq_true (some x) (R1Z.PV_RDB2F_ByteArray.store mem q y a)
                (Eq.trans (congrFun' (congrArg Eq hp) p) (eq_self p))))
            (eq_self (some x)))
    else
      if hq : a = q then
        of_eq_true
          (Eq.trans
            (congr
              (congrArg Eq
                (ite_cond_eq_true (some y) (R1Z.PV_RDB2F_ByteArray.store mem p x a)
                  (Eq.trans (congrFun' (congrArg Eq hq) q) (eq_self q))))
              (Eq.trans
                (ite_cond_eq_false (some x) (R1Z.PV_RDB2F_ByteArray.store mem q y a)
                  (Eq.trans (congrFun' (congrArg Eq hq) p)
                    (eq_false (id (Eq.mp (congrArg Not (congrFun' (congrArg Eq hq) p)) hp)))))
                (ite_cond_eq_true (some y) (mem a) (Eq.trans (congrFun' (congrArg Eq hq) q) (eq_self q)))))
            (eq_self (some y)))
      else
        of_eq_true
          (Eq.trans
            (congr
              (congrArg Eq
                (Eq.trans (ite_cond_eq_false (some y) (R1Z.PV_RDB2F_ByteArray.store mem p x a) (eq_false hq))
                  (ite_cond_eq_false (some x) (mem a) (eq_false hp))))
              (Eq.trans (ite_cond_eq_false (some x) (R1Z.PV_RDB2F_ByteArray.store mem q y a) (eq_false hp))
                (ite_cond_eq_false (some y) (mem a) (eq_false hq))))
            (eq_self (mem a)))
