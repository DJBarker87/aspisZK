          (Eq.trans
            (Aeneas.Std.bind_assoc_eq
              (R1Z.PV_RDB2E_ShaHandles.finalize R1Z.PV_RDB2F_ConcreteSoft.software
                (R1Z.PV_RDB2F_NativeShaFrame.associate native) valid)
              (fun current => Aeneas.Std.Result.ok (R1Z.PV_RDB2F_NativeShaFrame.restore current)) fun after =>
              Aeneas.Std.Result.ok (R1Z.PV_RDB2E_ShaHandles.forget (R1Z.PV_RDB2F_NativeShaFrame.associate after)))
            (congrArg
              (bind
                (R1Z.PV_RDB2E_ShaHandles.finalize R1Z.PV_RDB2F_ConcreteSoft.software
                  (R1Z.PV_RDB2F_NativeShaFrame.associate native) valid))
              (funext fun x =>
                Eq.trans
                  (Aeneas.Std.bind_tc_ok (R1Z.PV_RDB2F_NativeShaFrame.restore x) fun y =>
                    Aeneas.Std.Result.ok (R1Z.PV_RDB2E_ShaHandles.forget (R1Z.PV_RDB2F_NativeShaFrame.associate y)))
                  (congrArg Aeneas.Std.Result.ok
                    (congrArg R1Z.PV_RDB2E_ShaHandles.forget (R1Z.PV_RDB2F_NativeShaFrame.all_model_fields x)))))))
        (R1Z.PV_RDB2D_SHAState.completeState R1Z.PV_RDB2F_ConcreteSoft.software
          (R1Z.PV_RDB2F_NativeShaFrame.associate native).core (R1Z.PV_RDB2F_NativeShaFrame.associate native).buffer
          (R1Z.PV_RDB2E_ShaHandles.position (R1Z.PV_RDB2F_NativeShaFrame.associate native)))))
    (R1Z.PV_RDB2F_ConcreteSoft.all_fields (R1Z.PV_RDB2F_NativeShaFrame.associate native) valid)
