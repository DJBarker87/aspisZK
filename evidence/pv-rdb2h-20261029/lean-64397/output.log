theorem R1Z.PV_RDB2F_CapturedQuotient.body_association : ∀ (q output : R1Z.PV_RDB2F_Iterator.Words)
  (initialized : Aeneas.Std.Usize),
  R1Z.PV_RDB2F_CapturedQuotient.guardBody q output initialized =
    R1Z.PV_RDB2F_Iterator.digitsBody q output initialized :=
fun q output initialized =>
  id
    (id
      (Decidable.casesOn (Aeneas.Std.UScalar.decLt initialized 8#usize)
        (fun h =>
          Eq.mpr (id (congr (congrArg Eq (if_neg h)) (if_neg h)))
            (Eq.refl (Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.done (q, output)))))
        fun h =>
        Eq.mpr (id (congr (congrArg Eq (if_pos h)) (if_pos h)))
          (Eq.mpr
            (id
              (congrFun'
                (congrArg Eq
                  (Aeneas.Std.bind_assoc_eq (R1Z.PV_RDB2F_Iterator.division q 0#u64 8#usize)
                    (Aeneas.Std.uncurry fun current remainder => do
                      let digit ← Aeneas.Std.lift (Aeneas.Std.UScalar.cast Aeneas.Std.UScalarTy.U32 remainder)
                      Aeneas.Std.Result.ok (digit, current))
                    (Aeneas.Std.uncurry fun item current => do
                      let storage ← Aeneas.Std.Array.update output initialized item
                      let count ← Aeneas.Std.lift (initialized.wrapping_add 1#usize)
                      Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.cont (current, storage, count)))))
                do
                let (q1, r) ← R1Z.PV_RDB2F_Iterator.division q 0#u64 8#usize
                let value ← Aeneas.Std.lift (Aeneas.Std.UScalar.cast Aeneas.Std.UScalarTy.U32 r)
                let ds1 ← Aeneas.Std.Array.update output initialized value
                let j ← Aeneas.Std.lift (initialized.wrapping_add 1#usize)
                Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.cont (q1, ds1, j))))
            ((Aeneas.Std.bind_eq_iff (R1Z.PV_RDB2F_Iterator.division q 0#u64 8#usize)
                  (fun x => do
                    let (item, current) ←
                      let (current, remainder) := x
                        do
                        let digit ← Aeneas.Std.lift (Aeneas.Std.UScalar.cast Aeneas.Std.UScalarTy.U32 remainder)
                        Aeneas.Std.Result.ok (digit, current)
                    let storage ← Aeneas.Std.Array.update output initialized item
                    let count ← Aeneas.Std.lift (initialized.wrapping_add 1#usize)
                    Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.cont (current, storage, count)))
                  (Aeneas.Std.uncurry fun q1 r => do
                    let value ← Aeneas.Std.lift (Aeneas.Std.UScalar.cast Aeneas.Std.UScalarTy.U32 r)
                    let ds1 ← Aeneas.Std.Array.update output initialized value
                    let j ← Aeneas.Std.lift (initialized.wrapping_add 1#usize)
                    Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.cont (q1, ds1, j)))).mpr
              fun pair hp =>
              let ⟨current, remainder, hp⟩ := pair
              Eq.mpr
                (id
                  (congr
                    (congrArg Eq
                      (congr
                        (congrArg bind
                          (congrFun'
                            (congrArg Aeneas.Std.uncurry
                              (funext fun current =>
                                funext fun remainder =>
                                  Aeneas.Std.bind_tc_ok (Aeneas.Std.UScalar.cast Aeneas.Std.UScalarTy.U32 remainder)
                                    fun y => Aeneas.Std.Result.ok (y, current)))
                            (current, remainder)))
                        (congrArg Aeneas.Std.uncurry
                          (funext fun item =>
                            funext fun current =>
                              congrArg (bind (Aeneas.Std.Array.update output initialized item))
                                (funext fun storage =>
                                  Aeneas.Std.bind_tc_ok (initialized.wrapping_add 1#usize) fun y =>
                                    Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.cont (current, storage, y)))))))
                    (congrFun'
                      (congrArg Aeneas.Std.uncurry
                        (funext fun q1 =>
                          funext fun r =>
                            Eq.trans
                              (congrArg
                                (bind (Aeneas.Std.Result.ok (Aeneas.Std.UScalar.cast Aeneas.Std.UScalarTy.U32 r)))
                                (funext fun value =>
                                  congrArg (bind (Aeneas.Std.Array.update output initialized value))
                                    (funext fun ds1 =>
                                      Aeneas.Std.bind_tc_ok (initialized.wrapping_add 1#usize) fun y =>
                                        Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.cont (q1, ds1, y)))))
                              (Aeneas.Std.bind_tc_ok (Aeneas.Std.UScalar.cast Aeneas.Std.UScalarTy.U32 r) fun y => do
                                let ds1 ← Aeneas.Std.Array.update output initialized y
                                Aeneas.Std.Result.ok
                                    (Aeneas.Std.ControlFlow.cont (q1, ds1, initialized.wrapping_add 1#usize)))))
                      (current, remainder))))
                (Eq.refl do
                  let (item, current) ←
                    let (current, remainder) := (current, remainder)
