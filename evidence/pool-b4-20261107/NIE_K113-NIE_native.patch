+#[kani::proof]
+#[kani::unwind(33)]
+fn association() {
+ let data:[u8;8]=kani::any();let len:usize=kani::any();kani::assume(len<=8);
+ if len>=4 {let magic=&data[..4];kani::assume(!(magic == b"AS8I" || magic == b"AS8C" || magic == b"AS8D" || magic == b"ASQ8" || magic == b"ASF8" || magic == POOL_V1_INITIALIZE_INSTRUCTION_MAGIC || magic == POOL_V1_DEPOSIT_INSTRUCTION_MAGIC || magic == POOL_V1_PREPARE_SETTLEMENT_INSTRUCTION_MAGIC || magic == POOL_V1_CANCEL_PREPARED_SETTLEMENT_INSTRUCTION_MAGIC || magic == POOL_V1_SETTLE_PREPARED_INSTRUCTION_MAGIC || magic == POOL_V1_PRIVATE_TRANSFER_INSTRUCTION_MAGIC || magic == POOL_V1_WITHDRAWAL_INSTRUCTION_MAGIC));}
+ let program=Pubkey::new_from_array(kani::any());let mut log=ClearLog{calls:0};
+ let result=NIE_after_guard(&program,&[],&data[..len],&mut log);
+ assert!(result==Err(ProgramError::InvalidInstructionData));
+ assert!(log.calls==usize::from(len>=4));
+}
