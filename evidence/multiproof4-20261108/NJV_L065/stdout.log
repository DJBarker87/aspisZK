theorem NJV_TX2.TX2_093 : ∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (root : NJP_DigestCarrier.RefDigest) (physical : Aeneas.Std.Slice Aeneas.Std.U8)
  (idx : Aeneas.Std.Array Aeneas.Std.U32 16#usize) (val : Aeneas.Std.Array NJP_DigestCarrier.RefDigest 16#usize)
  (n : Aeneas.Std.Usize),
  (↑physical).length ≤ 9216 →
    ∀ (events : List (NJP_RowModel.Request × NJP_RowModel.Digest)) (out : Bool × NJP_RowModel.Scratch),
      NJV_NativeEntry.Invocation (NJP_RequestTransport.hash (AspisR1.MultiproofConePhysicalTransport.rawOracle H)) root
          physical (NJV_EntryABI.initial idx val n) events out →
        (have adopted := AspisV8R19.MemoizedProgramLaw.eval H (NJV_TX2Returning.endpoint root physical idx val n);
          (adopted.1, Aeneas.Std.Result.ok (NJP_CohortReturning.answer adopted.2)) =
            (NJV_AdoptedObservation.history events, Aeneas.Std.Result.ok out)) ∧
          NJV_Admission.Admissible (NJP_RequestTransport.hash (AspisR1.MultiproofConePhysicalTransport.rawOracle H))
            root physical (NJV_EntryABI.initial idx val n) events out :=
fun H root physical idx val n bytes events out native =>
  ⟨NJV_TX2Returning.returning H root physical idx val n bytes events out native,
    NJV_Admission.all (NJP_RequestTransport.hash (AspisR1.MultiproofConePhysicalTransport.rawOracle H)) root physical
      (NJV_EntryABI.initial idx val n) bytes events out native⟩
