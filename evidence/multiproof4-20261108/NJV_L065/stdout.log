theorem NJV_TX2.abort : ∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (root : NJP_DigestCarrier.RefDigest) (physical : Aeneas.Std.Slice Aeneas.Std.U8)
  (idx : Aeneas.Std.Array Aeneas.Std.U32 16#usize) (val : Aeneas.Std.Array NJP_DigestCarrier.RefDigest 16#usize)
  (n : Aeneas.Std.Usize),
  (↑physical).length ≤ 9216 →
    ∀ (events : List (NJP_RowModel.Request × NJP_RowModel.Digest)) (q : NJP_RowModel.Request)
      (pending : NJP_RowModel.Scratch),
      NJV_AbortEntry.Invocation (NJP_RequestTransport.hash (AspisR1.MultiproofConePhysicalTransport.rawOracle H)) root
          physical (NJV_EntryABI.initial idx val n) events q pending →
        (have log := (AspisV8R19.MemoizedProgramLaw.eval H (NJV_TX2Returning.endpoint root physical idx val n)).1;
          List.take events.length log = NJV_AdoptedObservation.history events ∧
            Option.map Prod.fst log[events.length]? =
              some (AspisV8R19.SqueezeOracleBridge.flatten (NJP_RequestTransport.address q))) ∧
          NJP_AbortTransport.physicalPending (AspisR1.MultiproofConePhysicalTransport.rawOracle H) events.length
                (NJP_RequestTransport.transport (NJV_Entry.rawProgram root physical (NJV_EntryABI.initial idx val n))) =
              some (NJP_AbortTransport.history events, NJP_RequestTransport.address q) ∧
            NJV_AbortDomains.LastDomain (fun j => (↑physical)[j]!) (↑physical).length q pending :=
fun H root physical idx val n bytes events q pending native =>
  ⟨NJV_AbortEntry.adopted_prefix H root physical (NJV_EntryABI.initial idx val n) rfl bytes events q pending native,
    ⟨NJV_AbortEntry.physical_prefix (AspisR1.MultiproofConePhysicalTransport.rawOracle H) root physical
        (NJV_EntryABI.initial idx val n) events q pending native,
      NJV_AbortDomains.entry (AspisR1.MultiproofConePhysicalTransport.rawOracle H) root physical
        (NJV_EntryABI.initial idx val n) bytes events q pending native⟩⟩
