theorem NJV_AdoptedObservation.returning : ∀ (H : Bytes → State) (root : RefDigest) (physical : Slice U8)
  (s : reference.Scratch),
  s.at = 0#usize →
    (↑physical).length ≤ 9216 →
      ∀ (events : List (NJP_RowModel.Request × NJP_RowModel.Digest)) (out : Bool × NJP_RowModel.Scratch),
        NJV_NativeEntry.Invocation (NJP_RequestTransport.hash (rawOracle H)) root physical s events out →
          have adopted := eval H (AspisR1.MultiproofConeVerifyState.verifyState root physical s);
          (adopted.1, ok (NJP_CohortReturning.answer adopted.2)) = (history events, ok out) :=
fun H root physical s zero bytes events out native =>
  id
    (have source := NJV_Entry.adopted H root physical s zero bytes;
    have nativeObs := NJV_NativeEntry.observation (rawOracle H) root physical s events out native;
    have sourceLogs :=
      congrArg Prod.fst
        (Eq.mp
          (congrArg
            (fun _a =>
              _a =
                ((eval H (AspisR1.MultiproofConeVerifyState.verifyState root physical s)).1,
                  ok (eval H (AspisR1.MultiproofConeVerifyState.verifyState root physical s)).2))
            (transport_observation H (NJV_Entry.program root physical s)))
          source);
    have sourceReturn :=
      congrArg Prod.snd
        (Eq.mp
          (congrArg
            (fun _a =>
              _a =
                ((eval H (AspisR1.MultiproofConeVerifyState.verifyState root physical s)).1,
                  ok (eval H (AspisR1.MultiproofConeVerifyState.verifyState root physical s)).2))
            (transport_observation H (NJV_Entry.program root physical s)))
          source);
    have nativeLogs := congrArg Prod.fst nativeObs;
    have nativeReturn := congrArg Prod.snd nativeObs;
    Prod.ext (Eq.trans (Eq.symm sourceLogs) (congrArg (List.map fun e => (flatten e.1, decodeState e.2)) nativeLogs))
      (Eq.mp (congrArg (fun _a => mapResult NJP_CohortReturning.answer _a = ok out) sourceReturn) nativeReturn))
'NJV_AdoptedObservation.returning' depends on axioms: [propext, Classical.choice, Quot.sound]
