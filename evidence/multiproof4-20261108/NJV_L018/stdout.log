theorem NJV_Pending.request : ∀ (H : Request → Digest) (nodes : ℕ → U8) (length : ℕ) (s pending : Scratch) (i w : ℕ)
  (q : Request),
  Cut s i length nodes pending q → NJP_AbortPrefix.pending H 0 (node nodes length s i w) = some ([], q) :=
fun H nodes length s pending i w q cut =>
  if both : paired s i then
    Eq.mpr
      (id
        (congrArg (fun _a => _a = some ([], q))
          (NJP_AbortPrefix.occupied_pending H nodes length s i w cut.active both)))
      (Eq.mpr (id (congrArg (fun _a => some ([], occupiedRequest s i) = some ([], _a)) cut.arguments))
        (Eq.mpr (id (congrArg (fun _a => some ([], occupiedRequest s i) = some ([], _a)) (if_pos both)))
          (Eq.refl (some ([], occupiedRequest s i)))))
  else
    have available := Or.resolve_left cut.available both;
    Eq.mpr
      (id
        (congrArg (fun _a => _a = some ([], q))
          (NJP_AbortPrefix.sibling_pending H nodes length s i w cut.active both available)))
      (Eq.mpr (id (congrArg (fun _a => some ([], siblingRequest s i nodes) = some ([], _a)) cut.arguments))
        (Eq.mpr (id (congrArg (fun _a => some ([], siblingRequest s i nodes) = some ([], _a)) (if_neg both)))
          (Eq.refl (some ([], siblingRequest s i nodes)))))
