        (congrArg Eq
          (congrArg (NJP_AbortPrefix.pending H events.length)
            ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_pos native.guard) x_0 x_1 x_2 x_3)
              (Classical.propDecidable (NJV_Entry.Guard physical s))
              (Program NJP_RowModel.Request NJP_RowModel.Digest (Result (Bool × NJP_RowModel.Scratch)))
              (NJP_LoopModel.run (decode root) (fun n => (↑physical)[n]!) (↑physical).length (raw s))
              (Program.done (ok (false, raw s))))))
