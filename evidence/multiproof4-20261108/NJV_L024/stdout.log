theorem NJV_PendingBind.after_return : ∀ {α β : Type} (H : Request → Digest) (p : Program Request Digest α)
  (f : α → Program Request Digest β) (first rest : List (Request × Digest)) (a : α) (n : ℕ) (q : Request),
  eval H p = (first, a) →
    NJP_AbortPrefix.pending H n (f a) = some (rest, q) →
      NJP_AbortPrefix.pending H (first.length + n) (AspisV8R19.OracleProgramOps.bind p f) = some (first ++ rest, q) :=
fun {α β} H p f first rest a n q returned pending =>
  Program.rec (motive := fun p =>
    ∀ (first : List (Request × Digest)),
      eval H p = (first, a) →
        NJP_AbortPrefix.pending H (first.length + n) (AspisV8R19.OracleProgramOps.bind p f) = some (first ++ rest, q))
    (fun a' first returned =>
      have eqs := Prod.mk.inj returned;
      let ⟨left✝, right✝⟩ := eqs
      Eq.ndrec (motive := fun first =>
        ([], a') = (first, a) →
          NJP_AbortPrefix.pending H (first.length + n) (AspisV8R19.OracleProgramOps.bind (Program.done a') f) =
            some (first ++ rest, q))
        (fun returned =>
          Eq.ndrec (motive := fun a =>
            NJP_AbortPrefix.pending H n (f a) = some (rest, q) →
              ([], a') = ([], a) →
                NJP_AbortPrefix.pending H ([].length + n) (AspisV8R19.OracleProgramOps.bind (Program.done a') f) =
                  some ([] ++ rest, q))
            (fun pending returned =>
              Eq.mpr
                (id
                  (congrFun' (congrArg Eq (congrFun' (congrArg (NJP_AbortPrefix.pending H) (Nat.zero_add n)) (f a')))
                    (some (rest, q))))
                pending)
            right✝ pending returned)
        left✝ returned)
    (fun r next ih first returned =>
      have firstEq := congrArg Prod.fst returned;
      have valueEq := congrArg Prod.snd returned;
      have tailReturned := Prod.ext rfl valueEq;
      have tail := ih (H r) (eval H (next (H r))).1 tailReturned;
      Eq.mpr
        (id
          (congrArg
            (fun _a =>
              NJP_AbortPrefix.pending H (_a.length + n) (AspisV8R19.OracleProgramOps.bind (Program.ask r next) f) =
                some (_a ++ rest, q))
            (Eq.symm firstEq)))
        (id
          (Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  NJP_AbortPrefix.pending H _a (AspisV8R19.OracleProgramOps.bind (Program.ask r next) f) =
                    some ((r, H r) :: (eval H (next (H r))).1 ++ rest, q))
                (Nat.add_right_comm (eval H (next (H r))).1.length 1 n)))
            (of_eq_true
              (Eq.trans
                (congrFun'
                  (congrArg Eq
                    (Eq.trans
                      (NJP_AbortPrefix.pending.eq_4 H ((eval H (next (H r))).1.length + n) r fun a =>
                        AspisV8R19.OracleProgramOps.bind (next a) f)
                      (congrArg (Option.map fun x => ((r, H r) :: x.1, x.2)) tail)))
                  (some ((r, H r) :: ((eval H (next (H r))).1 ++ rest), q)))
                (eq_self (some ((r, H r) :: ((eval H (next (H r))).1 ++ rest), q))))))))
    p first returned
