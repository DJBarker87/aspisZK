theorem NJV_Entry.adopted : ∀ (H : Bytes → State) (root : RefDigest) (physical : Slice U8) (s : reference.Scratch),
  s.at = 0#usize →
    (↑physical).length ≤ 9216 →
      eval H (transport (program root physical s)) =
        ((eval H (AspisR1.MultiproofConeVerifyState.verifyState root physical s)).1,
          ok (eval H (AspisR1.MultiproofConeVerifyState.verifyState root physical s)).2) :=
fun H root physical s zero bytes =>
  if guard : Guard physical s then
    have d := guard_domain physical s guard;
    have domain :=
      ⟨d.left,
        ⟨d.right,
          Eq.mpr (id (congrArg (fun _a => ↑_a ≤ (↑physical).length) zero))
            (of_eq_true
              (Eq.trans
                (congrFun'
                  (congrArg LE.le
                    (UScalar.ofNatCore_val_eq
                      (UScalar.bound_suffices UScalarTy.Usize 0 (of_decide_eq_true (id (Eq.refl true))))))
                  (↑physical).length)
                zero_le._simp_1))⟩⟩;
    Eq.mpr
      (id
        (congrFun'
          (congrArg Eq
            (congrArg (eval H)
              (congrArg transport
                ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_pos guard) x_0 x_1 x_2 x_3)
                  (Classical.propDecidable (Guard physical s))
                  (AspisR1.MultiproofConePhysicalProgram.Run (Bool × reference.Scratch))
                  (NJP_CohortReturning.run root physical s) (Program.done (ok (false, s)))))))
          ((eval H (AspisR1.MultiproofConeVerifyState.verifyState root physical s)).1,
            ok (eval H (AspisR1.MultiproofConeVerifyState.verifyState root physical s)).2)))
      (NJV_VerifierView.returning H root physical s zero domain bytes guard)
  else
    Eq.mpr
      (id
        (congrFun'
          (congrArg Eq
            (congrArg (eval H)
              (congrArg transport
                ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_neg guard) x_0 x_1 x_2 x_3)
                  (Classical.propDecidable (Guard physical s))
                  (AspisR1.MultiproofConePhysicalProgram.Run (Bool × reference.Scratch))
                  (NJP_CohortReturning.run root physical s) (Program.done (ok (false, s)))))))
          ((eval H (AspisR1.MultiproofConeVerifyState.verifyState root physical s)).1,
            ok (eval H (AspisR1.MultiproofConeVerifyState.verifyState root physical s)).2)))
      (of_eq_true
        (Eq.trans
          (congr (congrArg Eq (eval.eq_1 H (ok (false, s))))
            (congr
              (congrArg Prod.mk
                (congrArg Prod.fst
                  (Eq.trans
                    (congrArg (eval H)
                      ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_neg guard) x_0 x_1 x_2 x_3) instDecidableAnd
                        (Program Bytes State (Bool × reference.Scratch))
                        (AspisV8R19.OracleProgramOps.bind
                          (transport (AspisR1.MultiproofConePhysicalLevels.levels 18 s physical)) fun result =>
                          Program.done (AspisR1.MultiproofConeVerifyState.finishState root physical s result))
                        (Program.done (false, s))))
                    (eval.eq_1 H (false, s)))))
              (congrArg ok
                (congrArg Prod.snd
                  (Eq.trans
                    (congrArg (eval H)
                      ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_neg guard) x_0 x_1 x_2 x_3) instDecidableAnd
                        (Program Bytes State (Bool × reference.Scratch))
                        (AspisV8R19.OracleProgramOps.bind
                          (transport (AspisR1.MultiproofConePhysicalLevels.levels 18 s physical)) fun result =>
                          Program.done (AspisR1.MultiproofConeVerifyState.finishState root physical s result))
                        (Program.done (false, s))))
                    (eval.eq_1 H (false, s)))))))
          (eq_self ([], ok (false, s)))))
