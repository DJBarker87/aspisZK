theorem NJV_Entry.guard_domain : ∀ (physical : Slice U8) (s : reference.Scratch),
  Guard physical s → 0 < ↑s.n ∧ ↑s.n ≤ 16 :=
fun physical s guard =>
  have len :=
    of_eq_true
      (Eq.trans
        (congrFun'
          (congrArg Eq (Eq.trans (List.length_map Prod.fst) (AspisR1.MultiproofConeRootGuard.live_length s 0 ↑s.n)))
          ↑s.n)
        (eq_self ↑s.n));
  ⟨Decidable.byContradiction fun bad =>
      have empty := List.length_eq_zero_iff.mp (Decidable.byContradiction fun a => guard_domain._proof_1 s len bad a);
      guard.left.left empty,
    have small := guard.left.right.left;
    Decidable.byContradiction fun a => guard_domain._proof_2 s len small a⟩
'NJV_Entry.guard_domain' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem NJV_Entry.observation : ∀ (H : Slice (Slice U8) → RefDigest) (root : RefDigest) (physical : Slice U8)
  (s : reference.Scratch),
  have typed := eval H (program root physical s);
  (typed.1, mapResult NJP_CohortReturning.answer typed.2) =
    eval H (NJP_RequestTransport.transport (rawProgram root physical s)) :=
fun H root physical s =>
  id
    (if guard : Guard physical s then
      have d := guard_domain physical s guard;
      Eq.mpr
        (id
          (congr
            (congrArg Eq
              (congr
                (congrArg Prod.mk
                  (congrArg Prod.fst
                    (congrArg (eval H)
                      ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_pos guard) x_0 x_1 x_2 x_3)
                        (Classical.propDecidable (Guard physical s))
                        (AspisR1.MultiproofConePhysicalProgram.Run (Bool × reference.Scratch))
                        (NJP_CohortReturning.run root physical s) (Program.done (ok (false, s)))))))
                (congrArg (mapResult NJP_CohortReturning.answer)
                  (congrArg Prod.snd
                    (congrArg (eval H)
                      ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_pos guard) x_0 x_1 x_2 x_3)
                        (Classical.propDecidable (Guard physical s))
                        (AspisR1.MultiproofConePhysicalProgram.Run (Bool × reference.Scratch))
                        (NJP_CohortReturning.run root physical s) (Program.done (ok (false, s)))))))))
            (congrArg (eval H)
              (congrArg NJP_RequestTransport.transport
                ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_pos guard) x_0 x_1 x_2 x_3)
                  (Classical.propDecidable (Guard physical s))
                  (Program NJP_RowModel.Request NJP_RowModel.Digest (Result (Bool × NJP_RowModel.Scratch)))
                  (NJP_LoopModel.run (decode root) (fun n => (↑physical)[n]!) (↑physical).length (raw s))
                  (Program.done (ok (false, raw s))))))))
        (NJP_CohortReturning.observation H root physical s d.left d.right)
    else
      of_eq_true
        (Eq.trans
          (congr
            (congrArg Eq
              (congr
                (congrArg Prod.mk
                  (congrArg Prod.fst
                    (Eq.trans
                      (congrArg (eval H)
                        ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_neg guard) x_0 x_1 x_2 x_3)
                          (Classical.propDecidable (Guard physical s))
                          (AspisR1.MultiproofConePhysicalProgram.Run (Bool × reference.Scratch))
                          (NJP_CohortReturning.run root physical s) (Program.done (ok (false, s)))))
                      (eval.eq_1 H (ok (false, s))))))
                (congrArg
                  (fun x =>
                    match x.2 with
                    | ok x => ok (NJP_CohortReturning.answer x)
                    | fail e => fail e
                    | div => div)
                  (Eq.trans
                    (congrArg (eval H)
                      ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_neg guard) x_0 x_1 x_2 x_3)
                        (Classical.propDecidable (Guard physical s))
                        (AspisR1.MultiproofConePhysicalProgram.Run (Bool × reference.Scratch))
                        (NJP_CohortReturning.run root physical s) (Program.done (ok (false, s)))))
                    (eval.eq_1 H (ok (false, s)))))))
            (Eq.trans
              (congrArg (eval H)
                (Eq.trans
                  (congrArg NJP_RequestTransport.transport
                    ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_neg guard) x_0 x_1 x_2 x_3)
                      (Classical.propDecidable (Guard physical s))
                      (Program NJP_RowModel.Request NJP_RowModel.Digest (Result (Bool × NJP_RowModel.Scratch)))
                      (NJP_LoopModel.run (decode root) (fun n => (↑physical)[n]!) (↑physical).length (raw s))
                      (Program.done (ok (false, raw s)))))
                  (NJP_RequestTransport.transport.eq_1 (ok (false, raw s)))))
              (eval.eq_1 H (ok (false, raw s)))))
          (eq_self ([], ok (false, raw s)))))
