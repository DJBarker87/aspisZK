              else AspisR1.MultiproofConePhysicalDigest.parts digest (NJE_ParentPackets.cell s.val ↑i))) =
          ok
            (H
              (NJP_RequestTransport.address
                (if left = true then (NJP_RowModel.value (raw s) ↑i, decode digest)
                else (decode digest, NJP_RowModel.value (raw s) ↑i)))))
      left
      (fun h =>
        Eq.symm h ▸
          of_eq_true
            (Eq.trans
              (congr
                (congrArg Eq
                  (congrArg ok
                    (congrArg H
                      (ite_congr Bool.false_eq_true
                        (fun a => Eq.refl (AspisR1.MultiproofConePhysicalDigest.parts (↑s.val)[↑i]! digest)) fun a =>
                        Eq.refl (AspisR1.MultiproofConePhysicalDigest.parts digest (↑s.val)[↑i]!)))))
                (congrArg ok
                  (congrArg H
                    (congr
                      (congrArg AspisR1.MultiproofConePhysicalDigest.parts
                        (Eq.trans
                          (congrArg encode
                            (congrArg Prod.fst
                              (ite_congr Bool.false_eq_true
                                (fun a => congrFun' (congrArg Prod.mk (NJP_CohortRead.value s i bound)) (decode digest))
                                fun a => congrArg (Prod.mk (decode digest)) (NJP_CohortRead.value s i bound))))
                          (encode_decode digest)))
                      (Eq.trans
                        (congrArg encode
                          (congrArg Prod.snd
                            (ite_congr Bool.false_eq_true
                              (fun a => congrFun' (congrArg Prod.mk (NJP_CohortRead.value s i bound)) (decode digest))
                              fun a => congrArg (Prod.mk (decode digest)) (NJP_CohortRead.value s i bound))))
                        (encode_decode (↑s.val)[↑i]!))))))
              (eq_self (ok (H (AspisR1.MultiproofConePhysicalDigest.parts digest (↑s.val)[↑i]!))))))
      (fun h =>
        Eq.symm h ▸
          of_eq_true
            (Eq.trans
              (congr
                (congrArg Eq
                  (congrArg ok
                    (congrArg H
                      (ite_congr (eq_self true)
                        (fun a => Eq.refl (AspisR1.MultiproofConePhysicalDigest.parts (↑s.val)[↑i]! digest)) fun a =>
                        Eq.refl (AspisR1.MultiproofConePhysicalDigest.parts digest (↑s.val)[↑i]!)))))
                (congrArg ok
                  (congrArg H
                    (congr
                      (congrArg AspisR1.MultiproofConePhysicalDigest.parts
                        (Eq.trans
                          (congrArg encode
                            (congrArg Prod.fst
                              (ite_congr (eq_self true)
                                (fun a => congrFun' (congrArg Prod.mk (NJP_CohortRead.value s i bound)) (decode digest))
                                fun a => congrArg (Prod.mk (decode digest)) (NJP_CohortRead.value s i bound))))
                          (encode_decode (↑s.val)[↑i]!)))
                      (Eq.trans
                        (congrArg encode
                          (congrArg Prod.snd
                            (ite_congr (eq_self true)
                              (fun a => congrFun' (congrArg Prod.mk (NJP_CohortRead.value s i bound)) (decode digest))
                              fun a => congrArg (Prod.mk (decode digest)) (NJP_CohortRead.value s i bound))))
                        (encode_decode digest))))))
              (eq_self (ok (H (AspisR1.MultiproofConePhysicalDigest.parts (↑s.val)[↑i]! digest))))))
      (Eq.refl left))
