theorem NJV_ChildArguments.sibling : ∀ (H : Slice (Slice U8) → RefDigest) (s : reference.Scratch) (i : Usize),
  ↑i < 16 →
    ∀ (digest : RefDigest) (left : Bool),
      NJA_Multiproof.multiproof.sibling_binary_parent (NJE_ParentPackets.backend H) () s.val i (Array.to_slice digest)
          left =
        ok
          (H
            (NJP_RequestTransport.address
              (if left = true then (NJP_RowModel.value (raw s) ↑i, decode digest)
              else (decode digest, NJP_RowModel.value (raw s) ↑i)))) :=
fun H s i bound digest left =>
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          _a =
            ok
              (H
                (NJP_RequestTransport.address
                  (if left = true then (NJP_RowModel.value (raw s) ↑i, decode digest)
