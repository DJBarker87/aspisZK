theorem NJV_ChildArguments.occupied : ∀ (H : Slice (Slice U8) → RefDigest) (s : reference.Scratch) (i next : Usize),
  ↑i + 1 < 16 →
    ↑next = ↑i + 1 →
      NJA_Multiproof.multiproof.occupied_binary_parent (NJE_ParentPackets.backend H) () s.val i =
        ok (H (NJP_RequestTransport.address (NJP_RowModel.occupiedRequest (raw s) ↑i))) :=
fun H s i next bound next_value =>
  Eq.mpr
    (id
      (congrArg (fun _a => _a = ok (H (NJP_RequestTransport.address (NJP_RowModel.occupiedRequest (raw s) ↑i))))
        (NJE_ParentPackets.TX2_089 H s.val i bound)))
    (Eq.mpr
      (id
        (congrArg
          (fun _a =>
            ok
                (H
                  (AspisR1.MultiproofConePhysicalDigest.parts (NJE_ParentPackets.cell s.val ↑i)
                    (NJE_ParentPackets.cell s.val (↑i + 1)))) =
              ok (H _a))
          (NJP_CohortRead.occupied_address s i next
            (Decidable.byContradiction fun a => occupied._proof_1 i next bound next_value a)
            (Decidable.byContradiction fun a => occupied._proof_2 i next bound next_value a) next_value)))
      (of_eq_true
        (Eq.trans
          (congrArg (Eq (ok (H (AspisR1.MultiproofConePhysicalDigest.parts (↑s.val)[↑i]! (↑s.val)[↑i + 1]!))))
            (congrArg ok
              (congrArg H
                (congrArg (AspisR1.MultiproofConePhysicalDigest.parts (↑s.val)[↑i]!)
                  (congrArg (getElem! ↑s.val) next_value)))))
          (eq_self (ok (H (AspisR1.MultiproofConePhysicalDigest.parts (↑s.val)[↑i]! (↑s.val)[↑i + 1]!)))))))
