theorem NJV_ChildArguments.domains : ∀ (physical : Slice U8) (s : reference.Scratch) (i w : Usize),
  AspisR1.MultiproofConeNodeDomain.RowDomain physical s i w →
    ↑i < ↑s.n → ↑i < 16 ∧ ↑w < 16 ∧ (NJP_RowModel.paired (raw s) ↑i → ↑i + 1 < 16) :=
fun physical s i w domain active =>
  have size := domain.right.left;
  have write := domain.right.right.right.left;
  ⟨Decidable.byContradiction fun a => domains._proof_1 s i w active size a,
    ⟨Decidable.byContradiction fun a => domains._proof_2 s i w active size write a, fun both =>
      have next := both.left;
      id (fun next => Decidable.byContradiction fun a => domains._proof_3 s i w size next a) next⟩⟩
