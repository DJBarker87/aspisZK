theorem NJV_WellInput.keys : ∀ (s : reference.Scratch),
  ↑s.n ≤ 16 → NJV_UnitDomain.keys s = List.map (fun x => ↑x) (List.take ↑s.n ↑s.idx) :=
fun s bound =>
  have len := s.idx.property;
  List.ext_getElem
    (of_eq_true
      (Eq.trans
        (congr (congrArg Eq (NJV_UnitDomain.key_length s))
          (Eq.trans (List.length_map fun x => ↑x)
            (Eq.trans List.length_take (Eq.trans (congrArg (min ↑s.n) len) (Nat.min_eq_left bound)))))
        (eq_self ↑s.n)))
    fun j hj hj' =>
    have jb := Eq.mp (congrArg (LT.lt j) (NJV_UnitDomain.key_length s)) hj;
    have arr := Decidable.byContradiction fun a => keys._proof_1 s bound len j jb a;
    of_eq_true
      (Eq.trans
        (congr
          (congrArg Eq
            (Eq.trans
              (Eq.trans
                (GetElem.getElem.congr_simp (NJV_UnitDomain.keys s)
                  (List.map (Prod.fst ∘ decodeEntry ∘ fun j => (↑(↑s.idx)[j]!, (↑s.val)[j]!)) (List.range ↑s.n))
                  (Eq.trans
                    (congrArg (List.map Prod.fst)
                      (Eq.trans
                        (congrArg (List.map decodeEntry)
                          (congrFun'
                            (congrArg List.map
                              (funext fun j =>
                                congr
                                  (congrArg Prod.mk
                                    (congrArg UScalar.val (congrArg (getElem! ↑s.idx) (Nat.zero_add j))))
                                  (congrArg (getElem! ↑s.val) (Nat.zero_add j))))
                            (List.range ↑s.n)))
                        List.map_map))
                    List.map_map)
                  j j (Eq.refl j) hj)
                (List.getElem_map (Prod.fst ∘ decodeEntry ∘ fun j => (↑(↑s.idx)[j]!, (↑s.val)[j]!))))
              (Eq.trans
                (congrArg (Prod.fst ∘ decodeEntry ∘ fun j => (↑(↑s.idx)[j]!, (↑s.val)[j]!))
                  (List.getElem_range
                    (List.length_map (Prod.fst ∘ decodeEntry ∘ fun j => (↑(↑s.idx)[j]!, (↑s.val)[j]!)) ▸
                      Eq.trans
                          (congrArg (List.map Prod.fst)
                            (Eq.trans
                              (congrArg (List.map decodeEntry)
                                (congrFun'
                                  (congrArg List.map
                                    (funext fun j =>
                                      congr
                                        (congrArg Prod.mk
                                          (congrArg UScalar.val (congrArg (getElem! ↑s.idx) (Nat.zero_add j))))
                                        (congrArg (getElem! ↑s.val) (Nat.zero_add j))))
                                  (List.range ↑s.n)))
                              List.map_map))
                          List.map_map ▸
                        Eq.refl j ▸ hj)))
                (congrArg Prod.fst
                  (congrFun' (congrArg Prod.mk (congrArg UScalar.val (getElem!_pos (↑s.idx) j arr)))
                    (AspisV8R19.SqueezeOracleBridge.decodeState (↑s.val)[j]!))))))
          (Eq.trans (List.getElem_map fun x => ↑x) (congrArg UScalar.val List.getElem_take)))
        (eq_self ↑(↑s.idx)[j]))
'NJV_WellInput.keys' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem NJV_WellInput.reply : ∀ (s : reference.Scratch),
  ↑s.n ≤ 16 → NJE_WellFrozen.emitted ⟨List.take ↑s.n ↑s.idx, ⋯⟩ = ok (decide (wellFormed (NJV_UnitDomain.keys s))) :=
fun s bound =>
  Eq.mpr
    (id
      (congrArg (fun _a => _a = ok (decide (wellFormed (NJV_UnitDomain.keys s))))
        (NJE_WellFrozen.association
          ⟨List.take ↑s.n ↑s.idx,
            have cap := s.idx.to_slice.property;
            id
              (fun cap =>
                Eq.mpr (id (congrFun' (congrArg LE.le List.length_take) Usize.max))
                  (Decidable.byContradiction fun a => reply._proof_1 s cap a))
              cap⟩)))
    (Eq.mpr
      (id
        (congrArg (fun _a => _a = ok (decide (wellFormed (NJV_UnitDomain.keys s))))
          (NJE_WellSource.source
            ↑⟨List.take ↑s.n ↑s.idx,
                have cap := s.idx.to_slice.property;
                id
                  (fun cap =>
                    Eq.mpr (id (congrFun' (congrArg LE.le List.length_take) Usize.max))
                      (Decidable.byContradiction fun a => reply._proof_1 s cap a))
                  cap⟩)))
      (Eq.mpr
        (id
          (congrArg (fun _a => ok _a = ok (decide (wellFormed (NJV_UnitDomain.keys s))))
            (NJA_WellFormed.source_eq
              (List.map (fun x => ↑x)
                ↑⟨List.take ↑s.n ↑s.idx,
                    have cap := s.idx.to_slice.property;
                    id
                      (fun cap =>
                        Eq.mpr (id (congrFun' (congrArg LE.le List.length_take) Usize.max))
                          (Decidable.byContradiction fun a => reply._proof_1 s cap a))
                      cap⟩))))
        (Eq.mpr
          (id
            (congrArg
              (fun _a =>
                ok
                    (decide
                      (wellFormed
                        (List.map (fun x => ↑x)
                          ↑⟨List.take ↑s.n ↑s.idx,
                              have cap := s.idx.to_slice.property;
                              id
                                (fun cap =>
                                  Eq.mpr (id (congrFun' (congrArg LE.le List.length_take) Usize.max))
                                    (Decidable.byContradiction fun a => reply._proof_1 s cap a))
                                cap⟩))) =
                  ok (decide (wellFormed _a)))
              (keys s bound)))
          (Eq.refl
            (ok
              (decide
                (wellFormed
                  (List.map (fun x => ↑x)
                    ↑⟨List.take ↑s.n ↑s.idx,
                        have cap := s.idx.to_slice.property;
                        id
                          (fun cap =>
                            Eq.mpr (id (congrFun' (congrArg LE.le List.length_take) Usize.max))
                              (Decidable.byContradiction fun a => reply._proof_1 s cap a))
                          cap⟩))))))))
