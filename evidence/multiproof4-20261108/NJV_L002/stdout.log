                        (AspisR1.MultiproofConePhysicalProgram.Run (Bool × reference.Scratch))
                        (NJP_CohortReturning.run root physical s) (Program.done (ok (false, s)))))))))
            (congrArg (eval H)
              (congrArg NJP_RequestTransport.transport
                ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_pos guard) x_0 x_1 x_2 x_3)
                  (Classical.propDecidable (Guard physical s))
                  (Program NJP_RowModel.Request NJP_RowModel.Digest (Result (Bool × NJP_RowModel.Scratch)))
                  (NJP_LoopModel.run (decode root) (fun n => (↑physical)[n]!) (↑physical).length (raw s))
                  (Program.done (ok (false, raw s))))))))
        (NJP_CohortReturning.observation H root physical s d.left d.right)
