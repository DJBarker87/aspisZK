theorem NJV_Entry.guard_domain : ∀ (physical : Slice U8) (s : reference.Scratch),
  Guard physical s → 0 < ↑s.n ∧ ↑s.n ≤ 16 :=
fun physical s guard =>
  have len :=
    of_eq_true
      (Eq.trans
        (congrFun'
          (congrArg Eq (Eq.trans (List.length_map Prod.fst) (AspisR1.MultiproofConeRootGuard.live_length s 0 ↑s.n)))
          ↑s.n)
        (eq_self ↑s.n));
  ⟨Decidable.byContradiction fun bad =>
      have empty := List.length_eq_zero_iff.mp (Decidable.byContradiction fun a => guard_domain._proof_1 s len bad a);
      guard.left.left empty,
    have small := guard.left.right.left;
    Decidable.byContradiction fun a => guard_domain._proof_2 s len small a⟩
