      AspisR1.JFx_NativeBytes.proof AspisR1.JFo_Prepared.value.queries
      (AspisV8R19.SqueezeOracleBridge.encodeState AspisR1.JGr_M2Root.retainedRoot) 0#usize 2#usize s.idx s.val hash =
    Aeneas.Std.Result.ok
