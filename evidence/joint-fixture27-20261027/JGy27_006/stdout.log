AspisR1.JGw_Tree1.tree {Hash : Type} (D : AspisR1Stage2.aspis_core.digest.Digest32 Hash) (hash : Hash)
  (s : MultiproofConeRef.reference.Scratch) :
  AspisR1.Port3_NativeBatchBody.verifier.candidate.batch_tree
      (AspisR1.Port3_BatchStd.install AspisR1.Port4B_Install.leaves) (AspisR1.JGc_TX2_RealLeaves.dictionary D)
      AspisR1.JFx_NativeBytes.proof AspisR1.JFo_Prepared.value.queries
      (AspisV8R19.SqueezeOracleBridge.encodeState AspisR1.JGr_M1Root.retainedRoot) 0#usize 1#usize s.idx s.val hash =
    Aeneas.Std.Result.ok
      (Aeneas.Std.core.result.Result.Ok (), (AspisR1.JGu_Verify1.output D hash s).idx,
        (AspisR1.JGu_Verify1.output D hash s).val)
AspisR1.JGw_Tree2.tree {Hash : Type} (D : AspisR1Stage2.aspis_core.digest.Digest32 Hash) (hash : Hash)
