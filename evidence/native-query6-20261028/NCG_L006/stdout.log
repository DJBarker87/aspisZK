        FIo_Native.fast_pairing.canonical.Q.raw x y =
            Aeneas.Std.Result.ok (Aeneas.Std.Array.make 4#usize [a, b, c, d] ⋯) →
          (↑a, ↑b, ↑c, ↑d) = AspisR1.LPi_RawValues.spec x y :=
fun x y hx hy a b c d association =>
  let ⟨r0, h✝⟩ := AspisR1.LPi_RawValues.source x y hx hy
  let ⟨r1, h✝¹⟩ := h✝
  let ⟨r2, h✝²⟩ := h✝¹
  let ⟨r3, h✝³⟩ := h✝²
  let ⟨run, value⟩ := h✝³
  have same := Aeneas.Std.Result.ok.inj (Eq.trans (Eq.symm association) run);
  have words := congrArg (fun z => ↑z) same;
  let ⟨left✝, right✝⟩ :=
    Eq.mp
      (Eq.trans (List.cons.injEq a [b, c, d] r0 [r1, r2, r3])
        (congrArg (And (a = r0))
          (Eq.trans (List.cons.injEq b [c, d] r1 [r2, r3])
            (congrArg (And (b = r1))
              (Eq.trans (List.cons.injEq c [d] r2 [r3])
                (congrArg (And (c = r2))
                  (Eq.trans (List.cons.injEq d [] r3 [])
                    (Eq.trans (congrArg (And (d = r3)) (eq_self [])) (and_true (d = r3))))))))))
      words
  Eq.ndrec (motive := fun r0 =>
    FIo_Native.fast_pairing.canonical.Q.raw x y =
