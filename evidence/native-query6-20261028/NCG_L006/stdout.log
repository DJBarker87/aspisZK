                    (congrFun'
                      (congrArg HAdd.hAdd
                        (congrFun' (congrArg HAdd.hAdd (congrFun' (congrArg HAdd.hAdd (zero_add 1)) 1)) 1))
                      1))
                  (Aeneas.Std.UScalar.ofNatCore_val_eq
                    (Aeneas.Std.UScalar.bound_suffices Aeneas.Std.UScalarTy.Usize 4
                      (of_decide_eq_true (id (Eq.refl true))))))
                (eq_self 4)))) →
      (↑r0, ↑r1, ↑r2, ↑r3) = AspisR1.LPi_RawValues.spec x y →
        Aeneas.Std.Array.make 4#usize [a, b, c, d]
              (of_eq_true
                (Eq.trans
