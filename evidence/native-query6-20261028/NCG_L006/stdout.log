theorem NCG_CallLog.base_substitution : ∀ (log : Fin 8 → NCG_CallLog.Call) (terms : ℕ)
  (before after : Fin 8 → Aeneas.Std.U64) (coeff : Fin 8 → Aeneas.Std.U32) (scalar : Aeneas.Std.U32),
  (∀ (k : Fin 8), (log k).old = before k) →
    (∀ (k : Fin 8), (log k).coefficient = coeff k) →
      (∀ (k : Fin 8), (log k).scalar = scalar) →
        (∀ (k : Fin 8), after k = (log k).reply) →
          (∀ (k : Fin 8), ↑(coeff k) < 2 ^ 31 - 1) →
            ↑scalar < 2 ^ 31 - 1 →
              (∀ (k : Fin 8), NBB_Phase.Bound terms ↑(before k)) →
                (∀ (k : Fin 8),
                    S7OwnedP6Scalar.residue_scalar_owned (log k).old (log k).coefficient (log k).scalar false =
                      Aeneas.Std.Result.ok (log k).reply) →
                  ∀ (k : Fin 8), ↑(after k) = ↑(before k) + ↑(coeff k) * ↑scalar :=
fun log terms before after coeff scalar old_input coefficient_input scalar_input stores hc hs ho association k =>
  have h :=
    NCG_CallLog.substitute (log k) terms (Eq.symm (coefficient_input k) ▸ hc k) (Eq.symm (scalar_input k) ▸ hs)
      (Eq.symm (old_input k) ▸ ho k) (association k);
  Eq.mpr (id (congrArg (fun _a => ↑_a = ↑(before k) + ↑(coeff k) * ↑scalar) (stores k)))
    (Eq.mp (congrArg (fun _a => ↑(log k).reply = ↑(before k) + ↑(coeff k) * ↑_a) (scalar_input k))
      (Eq.mp (congrArg (fun _a => ↑(log k).reply = ↑(before k) + ↑_a * ↑(log k).scalar) (coefficient_input k))
        (Eq.mp (congrArg (fun _a => ↑(log k).reply = ↑_a + ↑(log k).coefficient * ↑(log k).scalar) (old_input k)) h)))
theorem NCG_HornerLog.three : ∀ (alpha h0 h1 h2 h3 z0 z1 z2 t0 t1 out : AspisR1Stage2.Stage2E),
  NBZ_Wide.product alpha h3 = Aeneas.Std.Result.ok z0 →
    NBO_FieldSemantics.add h2 z0 = Aeneas.Std.Result.ok t0 →
      NBZ_Wide.product alpha t0 = Aeneas.Std.Result.ok z1 →
        NBO_FieldSemantics.add h1 z1 = Aeneas.Std.Result.ok t1 →
          NBZ_Wide.product alpha t1 = Aeneas.Std.Result.ok z2 →
            NBO_FieldSemantics.add h0 z2 = Aeneas.Std.Result.ok out →
              NBW_Horner.eval NBZ_Wide.product alpha [h0, h1, h2] h3 = Aeneas.Std.Result.ok out :=
fun alpha h0 h1 h2 h3 z0 z1 z2 t0 t1 out p0 a0 p1 a1 p2 a2 =>
  of_eq_true
    (Eq.trans
      (congrFun'
        (congrArg Eq
          (Eq.trans
            (Eq.trans
              (congrFun'
                (congrArg bind
                  (Eq.trans
                    (Eq.trans
                      (congrFun'
                        (congrArg bind
                          (Eq.trans
                            (Aeneas.Std.bind_tc_ok h3 fun y => do
                              let product ← NBZ_Wide.product alpha y
                              NBO_FieldSemantics.add h2 product)
                            (Eq.trans
                              (Eq.trans (congrFun' (congrArg bind p0) fun product => NBO_FieldSemantics.add h2 product)
                                (Aeneas.Std.bind_tc_ok z0 (NBO_FieldSemantics.add h2)))
                              a0)))
                        fun prior => do
                        let product ← NBZ_Wide.product alpha prior
                        NBO_FieldSemantics.add h1 product)
                      (Aeneas.Std.bind_tc_ok t0 fun y => do
                        let product ← NBZ_Wide.product alpha y
                        NBO_FieldSemantics.add h1 product))
                    (Eq.trans
                      (Eq.trans (congrFun' (congrArg bind p1) fun product => NBO_FieldSemantics.add h1 product)
                        (Aeneas.Std.bind_tc_ok z1 (NBO_FieldSemantics.add h1)))
                      a1)))
                fun prior => do
                let product ← NBZ_Wide.product alpha prior
                NBO_FieldSemantics.add h0 product)
              (Aeneas.Std.bind_tc_ok t1 fun y => do
                let product ← NBZ_Wide.product alpha y
                NBO_FieldSemantics.add h0 product))
            (Eq.trans
              (Eq.trans (congrFun' (congrArg bind p2) fun product => NBO_FieldSemantics.add h0 product)
                (Aeneas.Std.bind_tc_ok z2 (NBO_FieldSemantics.add h0)))
              a2)))
        (Aeneas.Std.Result.ok out))
      (eq_self (Aeneas.Std.Result.ok out)))
