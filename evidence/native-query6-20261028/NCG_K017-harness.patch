+fn NCG_base_iteration(q:&[u8;608],g:&[E;29],slot:usize,term:usize,sums:&mut[u64;8]) {
+ let scalar=M31::from_le_bytes(q[slot*120+term*4..slot*120+term*4+4].try_into().unwrap()).unwrap();
+ let coefficient=g[term].to_limbs();
+ sums[0]=NCG_add_expression(sums[0],coefficient[0],scalar.0);
+ sums[1]=NCG_add_expression(sums[1],coefficient[1],scalar.0);
+ sums[2]=NCG_add_expression(sums[2],coefficient[2],scalar.0);
+ sums[3]=NCG_add_expression(sums[3],coefficient[3],scalar.0);
+ sums[4]=NCG_add_expression(sums[4],coefficient[4],scalar.0);
+ sums[5]=NCG_add_expression(sums[5],coefficient[5],scalar.0);
+ sums[6]=NCG_add_expression(sums[6],coefficient[6],scalar.0);
+ sums[7]=NCG_add_expression(sums[7],coefficient[7],scalar.0);
+}
+fn NCG_base_case(negative:bool){
+ let q:[u8;608]=kani::any();let g=NCG_g();let slot:usize=kani::any();let term:usize=kani::any();let phase:usize=kani::any();let k:usize=kani::any();
+ kani::assume(slot<4&&term<26&&phase<4&&k<8);
+ let offset=slot*120+term*4;let scalar=u32::from_le_bytes([q[offset],q[offset+1],q[offset+2],q[offset+3]]);kani::assume(scalar<2147483647);
+ let mut sums:[u64;8]=kani::any();for x in sums{kani::assume(x<(1u64<<34)+(phase as u64)*NCG_D);}let old=sums[k];let coefficient=g[term].to_limbs()[k];
+ unsafe{NCG_PHASE=phase;}
+ NCG_base_iteration(&q,&g,slot,term,&mut sums);
+ unsafe{assert_eq!(NCG_CALLS,8);assert_eq!(NCG_OLD[k],old);assert_eq!(NCG_COEFF[k],coefficient);assert_eq!(NCG_SCALAR[k],scalar);
+ if negative{assert_ne!(sums[k],NCG_OUT[k]);}else{assert_eq!(sums[k],NCG_OUT[k]);}}
+ kani::cover!(slot==3&&term==25&&k==7);kani::cover!(phase==0);kani::cover!(phase==3);
+}
+fn NCG_fold_iteration(limbs:&mut[u64;8],sums:&[u64;8]) {
+ limbs[0]+=(sums[0]&0x7fff_ffff)+(sums[0]>>31);
+ limbs[1]+=(sums[1]&0x7fff_ffff)+(sums[1]>>31);
+ limbs[2]+=(sums[2]&0x7fff_ffff)+(sums[2]>>31);
+ limbs[3]+=(sums[3]&0x7fff_ffff)+(sums[3]>>31);
+ limbs[4]+=(sums[4]&0x7fff_ffff)+(sums[4]>>31);
+ limbs[5]+=(sums[5]&0x7fff_ffff)+(sums[5]>>31);
+ limbs[6]+=(sums[6]&0x7fff_ffff)+(sums[6]>>31);
+ limbs[7]+=(sums[7]&0x7fff_ffff)+(sums[7]>>31);
+}
+fn NCG_fold_case(negative:bool){
+ let mut limbs:[u64;8]=kani::any();let sums:[u64;8]=kani::any();
+ for x in limbs {kani::assume(x<6*(1u64<<34));}
+ let k:usize=kani::any();kani::assume(k<8);let old=limbs[k];let input=sums[k];
+ NCG_fold_iteration(&mut limbs,&sums);
+ let expected=old+(input%(1u64<<31))+(input/(1u64<<31));
+ if negative{assert_ne!(limbs[k],expected);}else{assert_eq!(limbs[k],expected);}
+ assert!(limbs[k]<7*(1u64<<34));kani::cover!(k==0);kani::cover!(k==7);
+}
+static mut NCG_REDUCE_CALLS:usize=0;static mut NCG_REDUCE_IN:[u64;8]=[0;8];static mut NCG_REDUCE_OUT:[u32;8]=[0;8];
+fn NCG_reduce_spec(x:u64)->M31{let out:u32=kani::any();kani::assume(u64::from(out)==x%NCG_P);unsafe{let i=NCG_REDUCE_CALLS;assert!(i<8);NCG_REDUCE_IN[i]=x;NCG_REDUCE_OUT[i]=out;NCG_REDUCE_CALLS+=1;}M31(out)}
+fn NCG_canonical_expression(limbs:[u64;8])->E {E::from_limbs([
+M31::reduce_u64(limbs[0]).0,M31::reduce_u64(limbs[1]).0,M31::reduce_u64(limbs[2]).0,M31::reduce_u64(limbs[3]).0,M31::reduce_u64(limbs[4]).0,M31::reduce_u64(limbs[5]).0,M31::reduce_u64(limbs[6]).0,M31::reduce_u64(limbs[7]).0]).unwrap()}
+fn NCG_canonical_case(negative:bool){
