+const NCG_P:u64=2147483647;const NCG_D:u64=4611686009837453316;
+fn NCG_e()->E {let w:[u32;8]=kani::any();for x in w{kani::assume(x<2147483647);}E::from_limbs(w).unwrap()}
+fn NCG_g()->[E;29] {[NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e(),NCG_e()]}
