+  h[0].add(E::from_limbs(NCG_WO[2]).unwrap())
+ }else{t0};
+ if negative{assert_ne!(out.to_limbs()[k],expected.to_limbs()[k]);}else{assert_eq!(out.to_limbs()[k],expected.to_limbs()[k]);}
+ }
