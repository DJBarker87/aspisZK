theorem R1Z.PV_OWNC_LinkPush.forest : ∀ (b : R1Z.PV_OWNC_Vector.Buffer R1Z.PV_OWN_Link.Link)
  (xs : List R1Z.PV_OWN_Link.Link),
  R1Z.PV_OWNC_Vector.Valid R1Z.PV_OWNB_LinkCodec.codec b →
    b.length = 64 →
      b.capacity = 254 →
        xs.length = 72 →
          R1Z.PV_OWNC_Vector.Valid R1Z.PV_OWNB_LinkCodec.codec
              (R1Z.PV_OWNC_PushFold.append R1Z.PV_OWNB_LinkCodec.codec b xs) ∧
            (R1Z.PV_OWNC_PushFold.append R1Z.PV_OWNB_LinkCodec.codec b xs).length = 136 ∧
              (R1Z.PV_OWNC_PushFold.append R1Z.PV_OWNB_LinkCodec.codec b xs).capacity = 254 :=
fun b xs h len cap count =>
  ⟨R1Z.PV_OWNC_PushFold.valid R1Z.PV_OWNB_LinkCodec.codec b xs h
      (Decidable.byContradiction fun a => R1Z.PV_OWNC_LinkPush.forest._proof_1 b xs len cap count a) fun x i z hi =>
      R1Z.PV_OWNB_LinkBound.bounded x i z hi,
    ⟨Eq.mpr (id (congrArg (fun _a => _a = 136) (R1Z.PV_OWNC_PushFold.length R1Z.PV_OWNB_LinkCodec.codec b xs)))
        (Eq.mpr (id (congrArg (fun _a => _a + xs.length = 136) len))
          (Eq.mpr (id (congrArg (fun _a => 64 + _a = 136) count)) (Eq.refl (64 + 72)))),
      Eq.mpr (id (congrArg (fun _a => _a = 254) (R1Z.PV_OWNC_PushFold.capacity R1Z.PV_OWNB_LinkCodec.codec b xs)))
        (Eq.mpr (id (congrArg (fun _a => _a = 254) cap)) (Eq.refl 254))⟩⟩
