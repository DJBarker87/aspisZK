theorem R1Z.PV_OWNC_FlatMap.initialized : ∀ (b : R1Z.PV_OWNC_Vector.Buffer UInt16) (xs : List R1Z.PV_OWN_Link.Link),
  R1Z.PV_OWNC_Vector.Valid R1Z.PV_OWN_U16.codec b →
    b.length = 0 →
      b.capacity = 272 →
        xs.length = 136 →
          R1Z.PV_OWNC_Vector.Valid R1Z.PV_OWN_U16.codec
              (R1Z.PV_OWNC_PushFold.append R1Z.PV_OWN_U16.codec b (R1Z.PV_OWNC_FlatMap.rows xs)) ∧
            (R1Z.PV_OWNC_PushFold.append R1Z.PV_OWN_U16.codec b (R1Z.PV_OWNC_FlatMap.rows xs)).length = 272 :=
fun b xs h empty cap n =>
  have len :=
    Eq.mpr (id (congrArg (fun _a => _a = 272) (R1Z.PV_OWNC_FlatMap.count xs)))
      (Eq.mpr (id (congrArg (fun _a => 2 * _a = 272) n)) (Eq.refl (2 * 136)));
  ⟨R1Z.PV_OWNC_PushFold.valid R1Z.PV_OWN_U16.codec b (R1Z.PV_OWNC_FlatMap.rows xs) h
      (Decidable.byContradiction fun a => R1Z.PV_OWNC_FlatMap.initialized._proof_1 b xs empty cap len a)
      R1Z.PV_OWNC_FlatMap.u16_bound,
    Eq.mpr
      (id
        (congrArg (fun _a => _a = 272)
          (R1Z.PV_OWNC_PushFold.length R1Z.PV_OWN_U16.codec b (R1Z.PV_OWNC_FlatMap.rows xs))))
      (Eq.mpr (id (congrArg (fun _a => _a + (R1Z.PV_OWNC_FlatMap.rows xs).length = 272) empty))
        (Eq.mpr (id (congrArg (fun _a => 0 + _a = 272) len)) (Eq.refl (0 + 272))))⟩
