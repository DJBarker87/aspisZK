{"charon_version":"0.1.223","translated":{"crate_name":"aspis_r1_cost_probe","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::verifier::candidate::tx1","crate::verifier::candidate::tx2_common","crate::verifier::candidate::tx2_authenticated"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["crate::verifier::candidate::tx1","crate::verifier::candidate::tx2_common","crate::verifier::candidate::tx2_authenticated","crate::verifier::Prepared","crate::verifier::Accumulator","crate::verifier::BatchedWeights","crate::verifier::QueryGeometry","crate::verifier::View","crate::verifier::Error","crate::verifier::Phase","crate::transport::Variant","aspis_core::field::M31","aspis_core::field::CM31","aspis_core::field::QM31","aspis_core::field::WideExact","aspis_core::circle::SecureCirclePoint","aspis_statement::pool_v1::pair_forest_semantic_terminal::r0::Public","core::result::Result","core::option::Option"],"opaque":["crate","aspis_core","aspis_statement"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":"Initializers","unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-verifier-top-20261023/VTop_Stages.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"crates/aspis-r1-cost-probe/src/candidate.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! ADOPTED R1 VERIFIER (PREREG-PROOF-SIZE-2, 2026-10-19; prototype from the\n//! proof-size feasibility test). UNPROVED: PROOF-SIZE-OBLIGATIONS-20261019.\n//!\n//! Two-transaction verifier for the fixed-length compact binary-multiproof\n//! format (`crate::compact`), re-exported as `verifier::{tx1, tx2,\n//! tx2_authenticated, parse_shape}`. Child module of `verifier`, so it reuses\n//! the transcript, folding, accumulation, relation and checkpoint code\n//! unchanged. Differences from the retired eight-way path\n//! (`verifier::eight_way`, audit builds only), and nothing else:\n//! - the stored proof is the compact format; semantic rows 14..26 and `y1`\n//!   are expanded to their logical 32-byte form (zero high half) before any\n//!   parse or hash, so every Fiat-Shamir message keeps its byte definition;\n//! - C1, C2 and the folded tree are binary trees; authentication is one\n//!   multiproof per tree per transaction batch (queries 0..SPLIT in stage 1,\n//!   SPLIT..22 in stage 2), from fixed, zero-padded node slots;\n//! - the checkpoint hashes the compact stored bytes.\nuse super::*;\nuse crate::compact::{self, CodecError, OPENING, SLOT_NODES, SPLIT};\nuse crate::multiproof::{self, Arity};\nuse aspis_core::state_only_private_merkle::private_leaf_hash_with_digest;\n\nimpl From<CodecError> for Error {\n    fn from(_: CodecError) -> Self {\n        Error::Parse\n    }\n}\n\n#[inline(always)]\nfn opening(proof: &[u8], i: usize) -> &[u8] {\n    let at = compact::OFF_OPENINGS + i * OPENING;\n    &proof[at..at + OPENING]\n}\n#[inline(always)]\nfn slot(proof: &[u8], s: usize) -> &[u8] {\n    &proof[compact::slot_offset(s)..compact::slot_offset(s + 1)]\n}\n\n/// Fixed length, magic, variant S2, zero header tail.\n#[inline(never)]\npub fn parse_shape(proof: &[u8]) -> Result<Variant, Error> {\n    if proof.len() != compact::PROOF_BYTES\n        || &proof[..8] != compact::MAGIC\n        || proof[8] != Variant::S2.tag()\n        || proof[9..16].iter().any(|&x| x != 0)\n    {\n        return Err(Error::Parse);\n    }\n    Ok(Variant::S2)\n}\n\n/// The shipped strict scan for every field outside the semantic prefix\n/// (the semantic prefix is checked by `Prefix::parse` after expansion).\n#[inline(never)]\nfn canonical_scan(proof: &[u8]) -> Result<(), Error> {\n    compact::check_values(&proof[compact::OFF_Y1..compact::OFF_INACTIVE])?;\n    echeck(&proof[compact::OFF_INACTIVE..compact::OFF_INACTIVE + 32], false)?;\n    echeck(&proof[compact::OFF_ROUND0..compact::OFF_FOLDED_ROOT], false)?;\n    echeck(&proof[compact::OFF_ROUND1..compact::OFF_OPENINGS], false)?;\n    for i in 0..22 {\n        let q = opening(proof, i);\n        for s in 0..4 {\n            for l in 0..26 {\n                M31::from_le_bytes(q[s * 120 + l * 4..s * 120 + l * 4 + 4].try_into().unwrap()).ok_or(Error::Parse)?;\n            }\n            K::from_le_bytes(&q[s * 120 + 104..s * 120 + 120]).ok_or(Error::Parse)?;\n            for l in 0..2 {\n                K::from_le_bytes(&q[480 + s * 32 + l * 16..480 + s * 32 + l * 16 + 16]).ok_or(Error::Parse)?;\n            }\n        }\n        echeck(&q[672..800], false)?;\n    }\n    Ok(())\n}\n\n/// View over the logical semantic/y1 buffers and the stored wide fields.\nfn wide_view<'a>(proof: &'a [u8], semantic: &'a [u8], y1: &'a [u8]) -> Result<View<'a>, Error> {\n    Ok(View {\n        variant: Variant::S2,\n        semantic,\n        y1,\n        inactive: E::from_le_bytes(&proof[compact::OFF_INACTIVE..compact::OFF_ROUND0]).ok_or(Error::Parse)?,\n        round0: &proof[compact::OFF_ROUND0..compact::OFF_FOLDED_ROOT],\n        folded_root: Some(proof[compact::OFF_FOLDED_ROOT..compact::OFF_ROUND1].try_into().unwrap()),\n        round1: &proof[compact::OFF_ROUND1..compact::OFF_FINAL],\n        final_message: &proof[compact::OFF_FINAL..compact::OFF_OPENINGS],\n        query_bytes: &[],\n    })\n}\n\n\n#[inline(always)]\nfn batch_keys(queries: &[u32; 22], lo: usize, n: usize, tree: usize) -> [u64; multiproof::MAX_BATCH] {\n    let mut keys = [0u64; multiproof::MAX_BATCH];\n    for j in 0..n {\n        let u = queries[lo + j];\n        let index = if tree == 2 { u / 4 } else { u };\n        keys[j] = (u64::from(index) << 8) | j as u64;\n    }\n    keys\n}\n\n\n#[inline(always)]\nfn sort_batch_keys(mut keys: [u64; multiproof::MAX_BATCH], n: usize) -> [u64; multiproof::MAX_BATCH] {\n    for i in 1..n {\n        let mut j = i;\n        while j > 0 && batch_key_at(&keys, j - 1) > batch_key_at(&keys, j) {\n            keys.swap(j - 1, j);\n            j -= 1;\n        }\n    }\n    keys\n}\n\n\n#[inline(always)]\nfn batch_leaf<H: Digest32>(hash: H, tree: usize, q: &[u8]) -> [u8; 32] {\n    match tree {\n        0 => {\n            let salt: [u8; 32] = q[608..640].try_into().unwrap();\n            private_leaf_hash_with_digest(hash, merkle::C1_TAG, &q[..480], &salt)\n        }\n        1 => {\n            let salt: [u8; 32] = q[640..672].try_into().unwrap();\n            private_leaf_hash_with_digest(hash, merkle::C2_TAG, &q[480..608], &salt)\n        }\n        _ => {\n            let salt: [u8; 32] = q[800..832].try_into().unwrap();\n            private_leaf_hash_with_digest(hash, 0x72, &q[672..800], &salt)\n        }\n    }\n}\n\n\n#[inline(always)]\nfn same_batch_leaf(values: &[[u8; 32]; multiproof::MAX_BATCH], index: usize, leaf: [u8; 32]) -> bool {\n    values[index] == leaf\n}\n\n\n#[inline(always)]\nfn same_batch_index(values: &[u32; multiproof::MAX_BATCH], index: usize, expected: u32) -> bool {\n    values[index] == expected\n}\n\n\n#[inline(always)]\nfn batch_key_at(keys: &[u64; multiproof::MAX_BATCH], index: usize) -> u64 {\n    keys[index]\n}\n\n/// Verify the three multiproofs of one batch. Indices are sorted as u64\n/// keys (index << 8 | position) so leaf hashes are written once, in sorted\n/// order; equal folded indices must carry identical leaves and are merged.\n#[inline(never)]\nfn batch_merkle<H: Digest32>(proof: &[u8], p: &Prepared, folded_root: &[u8; 32], batch: usize, hash: H) -> Result<(), Error> {\n    let [root0, root1] = p.roots;\n    batch_merkle_values(proof, p.queries, [root0, root1, *folded_root], batch, hash)\n}\n\n#[inline(always)]\nfn batch_merkle_values<H: Digest32>(proof: &[u8], queries: [u32; 22], roots: [[u8; 32]; 3], batch: usize, hash: H) -> Result<(), Error> {\n    let mut idx = [0u32; multiproof::MAX_BATCH];\n    let mut val = [[0u8; 32]; multiproof::MAX_BATCH];\n    let [root0, root1, root2] = roots;\n    batch_tree(proof, queries, root0, batch, 0, &mut idx, &mut val, hash)?;\n    batch_tree(proof, queries, root1, batch, 1, &mut idx, &mut val, hash)?;\n    batch_tree(proof, queries, root2, batch, 2, &mut idx, &mut val, hash)?;\n    Ok(())\n}\n\n#[inline(always)]\nfn batch_tree<H: Digest32>(proof: &[u8], queries: [u32; 22], root: [u8; 32], batch: usize, tree: usize, idx: &mut [u32; multiproof::MAX_BATCH], val: &mut [[u8; 32]; multiproof::MAX_BATCH], hash: H) -> Result<(), Error> {\n    let (lo, hi) = if batch == 0 { (0, SPLIT) } else { (SPLIT, 22) };\n    let n = hi - lo;\n    let s = 3 * batch + tree;\n    let keys = sort_batch_keys(batch_keys(&queries, lo, n, tree), n);\n    let mut d = 0;\n    let mut key_position = 0;\n    while key_position < n {\n        let key = batch_key_at(&keys, key_position);\n        key_position += 1;\n        let index = (key >> 8) as u32;\n        let q = opening(proof, lo + (key & 0xff) as usize);\n        let leaf = batch_leaf(hash, tree, q);\n        if d > 0 && same_batch_index(idx, d - 1, index) {\n            if !same_batch_leaf(val, d - 1, leaf) {\n                return Err(Error::Merkle);\n            }\n            continue;\n        }\n        idx[d] = index;\n        val[d] = leaf;\n        d += 1;\n    }\n    let count = multiproof::node_count(Arity::Two, &idx[..d]).ok_or(Error::Merkle)?;\n    let nodes = slot(proof, s);\n    // Padding is whole 32-byte words: scan it 8 bytes at a time.\n    if count > SLOT_NODES[s] || nodes[32 * count..].chunks_exact(8).any(|w| u64::from_le_bytes(w.try_into().unwrap()) != 0) {\n        return Err(Error::Parse);\n    }\n    if !multiproof::verify_in_place(hash, Arity::Two, &root, idx, val, d, &nodes[..32 * count]) {\n        return Err(Error::Merkle);\n    }\n    Ok(())\n}\n\n/// The shipped per-query folding and accumulation, reading the candidate\n/// opening (C1/C2 values at the shipped offsets 0..608, folded values at\n/// 672..800). Merkle authentication was done per batch.\n#[inline(always)]\nfn query_values(proof: &[u8], p: &Prepared, mut a: Accumulator, g: &[E; 29], obs: Observer, geometry: &QueryGeometry, mut pending: BatchedWeights) -> Result<(Accumulator, BatchedWeights), Error> {\n    let i = a.next;\n    let u = p.queries[i] as usize;\n    let q = opening(proof, i);\n    let dots = crate::fast_dots::four_dots(q, g);\n    crate::trace::value(9, 4 * i, dots[0]);\n    crate::trace::value(9, 4 * i + 1, dots[1]);\n    crate::trace::value(9, 4 * i + 2, dots[2]);\n    crate::trace::value(9, 4 * i + 3, dots[3]);\n    let inverse = *geometry.for_query(i);\n    let folded = circle_fold_with_inverses(p.alpha[0], dots, &inverse);\n    crate::trace::value(10, 2 * i, folded);\n    let values = core::array::from_fn(|s| field(&q[672..800], s));\n    if folded != values[u % 4] {\n        return Err(Error::Query);\n    }\n    let folded = line_fold_with_inverses(p.alpha[1], values, &inverse);\n    crate::trace::value(10, 2 * i + 1, folded);\n    let z = geometry.line_z[i - geometry.start];\n    let node = z.mul(z).double().sub(M31::ONE);\n    accumulate_batched_with_node(p, &mut a, node, folded, &mut pending);\n    mark(obs, Phase::Query(i));\n    Ok((a, pending))\n}\n\n\n#[inline(always)]\nfn query_loop(proof: &[u8], p: &Prepared, mut a: Accumulator, g: &[E; 29], obs: Observer, geometry: &QueryGeometry, pending: BatchedWeights, end: usize) -> Result<(Accumulator, BatchedWeights), Error> {\n    let mut state = Ok((a, pending));\n    loop {\n        match state {\n            Err(error) => return Err(error),\n            Ok((a, pending)) => {\n                if a.next >= end {\n                    return Ok((a, pending));\n                }\n                state = query_values(proof, p, a, g, obs, geometry, pending);\n            }\n        }\n    }\n}\n\n#[inline(never)]\nfn prepare<H: Digest32>(public: Public<'_>, proof: &[u8], hash: H, obs: Observer, g: &mut [E; 29]) -> Result<Box<Prepared>, Error> {\n    let mut logical = aspis_core::r0::heap::filled(compact::LOGICAL_SEMANTIC + compact::LOGICAL_Y1, 0u8).map_err(|_| Error::Allocation)?;\n    let (semantic, y1) = logical.split_at_mut(compact::LOGICAL_SEMANTIC);\n    compact::expand_semantic(&proof[compact::OFF_SEMANTIC..compact::OFF_Y1], semantic)?;\n    compact::expand_values(&proof[compact::OFF_Y1..compact::OFF_INACTIVE], y1)?;\n    let v = wide_view(proof, &logical[..compact::LOGICAL_SEMANTIC], &logical[compact::LOGICAL_SEMANTIC..])?;\n    let sem = crate::r1_semantic::verify_observed(public, v.semantic, hash, obs).map_err(|_| Error::Semantic)?;\n    mark(obs, Phase::Semantic);\n    Prepared::new(&sem, &v, hash, g)\n}\n\n/// Stage 1: strict parse of the whole stored proof, semantic layer,\n/// challenges, batch-A multiproofs and queries 0..SPLIT; returns the\n/// checkpoint over the compact stored bytes.\n#[inline(never)]\npub fn tx1<H: Digest32>(public: Public<'_>, public_bytes: &[u8], proof: &[u8], k: usize, hash: H, obs: Observer) -> Result<Vec<u8>, Error> {\n    if k != SPLIT {\n        return Err(Error::Parse);\n    }\n    parse_shape(proof)?;\n    canonical_scan(proof)?;\n    mark(obs, Phase::Parsed);\n    let mut g = [E::ZERO; 29];\n    let p = prepare(public, proof, hash, obs, &mut g)?;\n    let a = Accumulator::new(Variant::S2)?;\n    mark(obs, Phase::Prepare);\n    let folded_root: [u8; 32] = proof[compact::OFF_FOLDED_ROOT..compact::OFF_ROUND1].try_into().unwrap();\n    batch_merkle(proof, &p, &folded_root, 0, hash)?;\n    mark(obs, Phase::Merkle(0));\n    let geometry = QueryGeometry::for_range(&p.queries, 0, k)?;\n    let pending = BatchedWeights::new(&a.weights)?;\n    let (mut a, pending) = query_loop(proof, &p, a, &g, obs, &geometry, pending, k)?;\n    pending.finish(&mut a.weights);\n    let bytes = checkpoint(&p, &a, proof, public_bytes, hash);\n    mark(obs, Phase::CheckpointWrite);\n    Ok(bytes)\n}\n\n#[inline(never)]\nfn tx2_common<H: Digest32>(public_bytes: &[u8], proof: &[u8], checkpoint: &[u8], hash: H, obs: Observer) -> Result<(), Error> {\n    let (p, a) = resume(checkpoint, proof, public_bytes, Variant::S2, hash)?;\n    if a.next != SPLIT {\n        return Err(Error::Checkpoint);\n    }\n    let g = powers::<29>(p.gamma);\n    mark(obs, Phase::CheckpointRead);\n    let inactive = E::from_le_bytes(&proof[compact::OFF_INACTIVE..compact::OFF_ROUND0]).ok_or(Error::Parse)?;\n    let folded_root: [u8; 32] = proof[compact::OFF_FOLDED_ROOT..compact::OFF_ROUND1].try_into().unwrap();\n    batch_merkle(proof, &p, &folded_root, 1, hash)?;\n    mark(obs, Phase::Merkle(SPLIT));\n    let geometry = QueryGeometry::for_range(&p.queries, a.next, 22)?;\n    let pending = BatchedWeights::new(&a.weights)?;\n    let (a, pending) = query_loop(proof, &p, a, &g, obs, &geometry, pending, 22)?;\n    // End the loop accumulator borrow before finishing its weights.\n    let Accumulator { mut weights, rhs, power, next } = a;\n    pending.finish(&mut weights);\n    let a = Accumulator { weights, rhs, power, next };\n    // Construct only the relation view after the last proof-consuming loop.\n    let v = View {\n        variant: Variant::S2, semantic: &[], y1: &[], inactive,\n        round0: &proof[compact::OFF_ROUND0..compact::OFF_FOLDED_ROOT],\n        folded_root: None,\n        round1: &proof[compact::OFF_ROUND1..compact::OFF_FINAL],\n        final_message: &proof[compact::OFF_FINAL..compact::OFF_OPENINGS],\n        query_bytes: &[],\n    };\n    finish_relation(&v, &p, &a, obs)\n}\n\n/// Stage 2 with checkpoint provenance established by the caller (Pool\n/// route); same precondition as the shipped `tx2_authenticated`.\n#[inline(never)]\npub fn tx2_authenticated<H: Digest32>(public_bytes: &[u8], proof: &[u8], checkpoint: &[u8], hash: H, obs: Observer) -> Result<(), Error> {\n    parse_shape(proof)?;\n    mark(obs, Phase::Parsed);\n    tx2_common(public_bytes, proof, checkpoint, hash, obs)\n}\n\n/// Stage 2 repeating the full canonical scan.\n#[inline(never)]\npub fn tx2<H: Digest32>(public_bytes: &[u8], proof: &[u8], checkpoint: &[u8], hash: H, obs: Observer) -> Result<(), Error> {\n    parse_shape(proof)?;\n    canonical_scan(proof)?;\n    mark(obs, Phase::Parsed);\n    tx2_common(public_bytes, proof, checkpoint, hash, obs)\n}\n"},{"id":1,"name":{"Local":"crates/aspis-r1-cost-probe/src/verifier.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! UNPROVED R1 COST PROBE. Two-transaction verifier shape; no production use.\nuse aspis_core::r0::CodeField;\nuse alloc::{boxed::Box,vec::Vec};\nuse aspis_core::{Digest32,field::{WideExact as E,QM31 as K,M31},circle::SecureCirclePoint,r0::{domain,merkle}};\nuse aspis_statement::pool_v1::pair_forest_semantic_terminal::r0::Public;\nuse crate::{transport::Variant,weights::{Weights,field,powers,QUARTER},transcript::Transcript};\n\npub const SEMANTIC_BYTES:usize=12903+29*32;\npub const HEADER:usize=16;\n#[cfg(not(feature = \"private-leaf-salts\"))]\npub const INITIAL_QUERY_BYTES:usize=480+128+2*6*7*32;\n#[cfg(feature = \"private-leaf-salts\")]\npub const INITIAL_QUERY_BYTES:usize=480+128+64+2*6*7*32;\n#[cfg(not(feature = \"private-leaf-salts\"))]\npub const SECOND_QUERY_BYTES:usize=4*32+6*7*32;\n#[cfg(feature = \"private-leaf-salts\")]\npub const SECOND_QUERY_BYTES:usize=4*32+32+6*7*32;\npub const CHECKPOINT_FIXED:usize=16+32*3+64+32*4+16+88+160+64+32*2+16+32;\n#[derive(Debug,Clone,Copy,PartialEq,Eq)]\npub enum Error { Parse,Semantic,Transcript,Relation,Merkle,Query,Checkpoint,Allocation,\n    /// Host prover only (LOG D38.3): this attempt's challenges fail the public\n    /// P_R1 check. Carries no challenge and no conjunct.\n    #[cfg(feature=\"prover\")] Rejected,\n    /// Host prover only (D38.3): all N = 8 attempts were rejected; nothing is published.\n    #[cfg(feature=\"prover\")] AttemptsExhausted,\n    /// Host prover only: the operating-system entropy source failed.\n    #[cfg(feature=\"prover\")] Entropy }\n#[derive(Debug,Clone,Copy,PartialEq,Eq)]\npub enum Phase { Parsed,Semantic,SemanticPart(u8),Prepare,CheckpointRead,Merkle(usize),Query(usize),QueryPart(usize,u8),CheckpointWrite,Relation,Final }\npub type Observer=Option<fn(Phase)>;\nfn mark(obs:Observer,p:Phase) { if let Some(f)=obs {f(p);} }\npub fn checkpoint_size(v:Variant)->usize {CHECKPOINT_FIXED+16*v.final_len()}\n\npub struct View<'a> {\n    pub variant:Variant,pub semantic:&'a[u8],pub y1:&'a[u8],pub inactive:E,\n    pub round0:&'a[u8],pub folded_root:Option<&'a[u8;32]>,pub round1:&'a[u8],\n    pub final_message:&'a[u8],pub query_bytes:&'a[u8],\n}\nfn echeck(b:&[u8],k:bool)->Result<(),Error> {\n    for c in b.chunks_exact(32) {let x=E::from_le_bytes(c).ok_or(Error::Parse)?;if k&&x.c1()!=K::ZERO {return Err(Error::Parse);}}\n    Ok(())\n}\nimpl<'a> View<'a> {\n    /// Length of the retired eight-way stored proof for `v` (124,343 bytes for\n    /// S2). A layout figure only: the adopted stored length is `PROOF_BYTES`.\n    pub fn eight_way_proof_bytes(v:Variant)->usize {HEADER+SEMANTIC_BYTES+29*32+32+7*32+if v.folds()==2 {32+7*32}else{0}+v.final_len()*32+22*(INITIAL_QUERY_BYTES+if v.folds()==2 {SECOND_QUERY_BYTES}else{0})}\n}\n\npub struct Prepared {\n    pub variant:Variant,pub roots:[[u8;32];2],pub gamma:E,pub kappa:E,pub alpha:[E;2],pub rho:K,\n    pub queries:[u32;22],pub semantic_alpha:[K;10],pub z:[SecureCirclePoint;2],pub claim:E,pub state:[u8;32],\n}\nfn prepared_claim<H:Digest32>(sem:&crate::r1_semantic::Verified<H>,y1:&[u8],inactive:E,g:&[E;29],kappa:E)->Result<E,Error> {\n        let k=powers::<7>(kappa);\n        let mut parts=[E::ZERO;7];parts[0]=inactive;\n        for point in 0..6 {\n            let mut dot=crate::fast_pairing::EbyKDot::new();\n            for l in 0..29 {\n                let scalar=match point {0..=2=>sem.claims[point][l],3=>sem.extra[l],4=>sem.before_z1[l],_=>field(y1,l).c0()};\n                dot.push(g[l],scalar).map_err(|_|Error::Parse)?;\n            }\n            parts[point+1]=dot.finish();\n        }\n        let mut claim=E::ZERO;\n        for i in 0..7 {crate::trace::value(14,i,parts[i]);claim=claim.add(k[i].mul(parts[i]));}\n        crate::trace::value(14,7,claim);\n        Ok(claim)\n}\n\nimpl Prepared {\n    #[inline(never)]\n    pub fn new<H:Digest32>(sem:&crate::r1_semantic::Verified<H>,v:&View<'_>,hash:H,g:&mut [E;29])->Result<Box<Self>,Error> {\n        let mut t=Transcript::new(hash,sem.transcript.state(),v.variant);\n        let gamma=t.scalar(27,v.y1,true);\n        let kappa=t.scalar(28,&v.inactive.to_le_bytes(),false);\n        let alpha0=t.scalar(29,v.round0,false);\n        let (alpha,row)=if v.variant.folds()==2 {\n            let mut bytes=Vec::with_capacity(32+224);bytes.extend_from_slice(v.folded_root.unwrap());bytes.extend_from_slice(v.round1);\n            ([alpha0,t.scalar(30,&bytes,false)],31)\n        } else {\n            ([alpha0,E::ZERO],30)\n        };\n        let queries=t.queries(row,v.final_message)?;\n        let rho=t.scalar_k(row+1,&[]);\n        // Reuse this caller-owned scratch array in tx1; it is never serialized.\n        *g=powers::<29>(gamma);\n        let claim=prepared_claim(sem,v.y1,v.inactive,g,kappa)?;\n        Ok(Box::new(Self{variant:v.variant,roots:sem.roots,gamma,kappa,alpha,rho,queries,semantic_alpha:sem.alpha,z:sem.z,claim,state:t.state}))\n    }\n}\npub struct Accumulator { pub weights:Vec<K>,pub rhs:E,pub power:K,pub next:usize }\nimpl Accumulator {\n    pub fn new(v:Variant)->Result<Self,Error> {Ok(Self{weights:aspis_core::r0::heap::filled(v.final_len(),K::ZERO).map_err(|_|Error::Allocation)?,rhs:E::ZERO,power:K::ONE,next:0})}\n}\n\npub fn four_dots(q:&[u8],g:&[E;29])->[E;4] {\n    core::array::from_fn(|s| {\n        let mut a=E::ZERO;\n        for l in 0..26 {a=a.add(g[l].mul_m31(M31::from_le_bytes(q[s*120+l*4..s*120+l*4+4].try_into().unwrap()).unwrap()));}\n        a=a.add(g[28].mul_qm31(K::from_le_bytes(&q[s*120+104..s*120+120]).unwrap()));\n        for l in 0..2 {a=a.add(g[l+26].mul_qm31(K::from_le_bytes(&q[480+s*32+l*16..480+s*32+l*16+16]).unwrap()));}\n        a\n    })\n}\npub fn circle_fold(alpha:E,u:usize,a:[E;4])->E {\n    let p=crate::fast_domain::fibre_point(domain::FibreIndex::new(u).unwrap());\n    let ix=p.x.inv();let iy=p.y.inv();let [a,b,c,d]=a;\n    let h0=a.add(b).add(c).add(d).mul_m31(QUARTER);\n    let h1=a.sub(b).sub(c).add(d).mul_m31(QUARTER.mul(iy));\n    let h2=a.add(b).sub(c).sub(d).mul_m31(QUARTER.mul(ix));\n    let h3=a.sub(b).add(c).sub(d).mul_m31(QUARTER.mul(ix).mul(iy));\n    h0.add(alpha.mul(h1.add(alpha.mul(h2.add(alpha.mul(h3))))))\n}\npub fn line_fold(alpha:E,v:usize,a:[E;4])->E {\n    let x=crate::fast_domain::line_node(domain::FibreIndex::new(4*v).unwrap());\n    let y=crate::fast_domain::line_node(domain::FibreIndex::new(4*v+3).unwrap());\n    let z=x.mul(x).double().sub(M31::ONE);\n    let half=M31(1073741824);\n    let [a,b,c,d]=a;\n    let h0=a.add(b).add(c).add(d).mul_m31(QUARTER);\n    let h2=a.add(b).sub(c).sub(d).mul_m31(QUARTER.mul(z.inv()));\n    let c0=a.sub(b).mul_m31(half.mul(x.inv()));\n    let c1=d.sub(c).mul_m31(half.mul(y.inv()));\n    let h1=c0.add(c1).mul_m31(half);\n    let h3=c0.sub(c1).mul_m31(half.mul(z.inv()));\n    h0.add(alpha.mul(h1.add(alpha.mul(h2.add(alpha.mul(h3))))))\n}\n/// The five base-field denominators used to fold one sampled query: circle\n/// x/y, followed by line x/y/z. Their inverses are batch-computed once per\n/// transaction so each query avoids five independent field inversions.\nstruct QueryGeometry { start:usize, inverses:Vec<[M31;5]>, line_z:Vec<M31> }\n\n#[inline(always)]\nfn batch_prefix_products(flat:&[M31])->(Vec<M31>,M31) {\n    let mut prefixes=Vec::with_capacity(flat.len());\n    let mut product=M31::ONE;\n    let mut index=0;\n    while index<flat.len() {\n        let value=flat[index];\n        prefixes.push(product);\n        product=product.mul(value);\n        index+=1;\n    }\n    (prefixes,product)\n}\n\nimpl QueryGeometry {\n    fn for_range(queries:&[u32;22],start:usize,end:usize)->Result<Self,Error> {\n        if start>end||end>queries.len(){return Err(Error::Query);}\n        let mut line_z_values=Vec::with_capacity(end-start);\n        let mut flat=Vec::with_capacity((end-start)*5);\n        for &query in &queries[start..end] {\n            let u=query as usize;\n            let fibre=domain::FibreIndex::new(u).map_err(|_|Error::Query)?;\n            let domain::Point{x:circle_x,y:circle_y}=crate::fast_domain::fibre_point(fibre);\n            let line_x=crate::fast_domain::line_node(domain::FibreIndex::new(u/4*4).map_err(|_|Error::Query)?);\n            let line_y=crate::fast_domain::line_node(domain::FibreIndex::new(u/4*4+3).map_err(|_|Error::Query)?);\n            let line_z=line_x.mul(line_x).double().sub(M31::ONE);\n            let values=[circle_x,circle_y,line_x,line_y,line_z];\n            if values.iter().any(|x|*x==M31::ZERO){return Err(Error::Query);}\n            flat.extend_from_slice(&values);\n            line_z_values.push(line_z);\n        }\n        if flat.is_empty(){return Ok(Self{start,inverses:Vec::new(),line_z:line_z_values});}\n        // Standard prefix-product/backward batch inversion. The only `inv`\n        // in this routine is applied to the product of all nonzero entries.\n        let (prefixes,product)=batch_prefix_products(&flat);\n        let mut suffix_inverse=product.inv();\n        let mut flat_inverse=Vec::with_capacity(flat.len());\n        flat_inverse.resize(flat.len(),M31::ZERO);\n        for i in (0..flat.len()).rev() {\n            flat_inverse[i]=suffix_inverse.mul(prefixes[i]);\n            suffix_inverse=suffix_inverse.mul(flat[i]);\n        }\n        let inverses=(0..line_z_values.len()).map(|i|core::array::from_fn(|j|flat_inverse[5*i+j])).collect();\n        Ok(Self{start,inverses,line_z:line_z_values})\n    }\n    #[inline(always)]\n    fn for_query(&self,index:usize)->&[M31;5] {&self.inverses[index-self.start]}\n}\n#[inline(always)]\nfn circle_fold_with_inverses(alpha:E,a:[E;4],inverse:&[M31;5])->E {\n    let [ix,iy,_,_,_]=*inverse;let [a,b,c,d]=a;\n    let h0=a.add(b).add(c).add(d).mul_m31(QUARTER);\n    let h1=a.sub(b).sub(c).add(d).mul_m31(QUARTER.mul(iy));\n    let h2=a.add(b).sub(c).sub(d).mul_m31(QUARTER.mul(ix));\n    let h3=a.sub(b).add(c).sub(d).mul_m31(QUARTER.mul(ix).mul(iy));\n    h0.add(alpha.mul(h1.add(alpha.mul(h2.add(alpha.mul(h3))))))\n}\n#[inline(always)]\nfn line_fold_with_inverses(alpha:E,a:[E;4],inverse:&[M31;5])->E {\n    let [_,_,ix,iy,iz]=*inverse;let half=M31(1073741824);let [a,b,c,d]=a;\n    let h0=a.add(b).add(c).add(d).mul_m31(QUARTER);\n    let h2=a.add(b).sub(c).sub(d).mul_m31(QUARTER.mul(iz));\n    let c0=a.sub(b).mul_m31(half.mul(ix));\n    let c1=d.sub(c).mul_m31(half.mul(iy));\n    let h1=c0.add(c1).mul_m31(half);\n    let h3=c0.sub(c1).mul_m31(half.mul(iz));\n    h0.add(alpha.mul(h1.add(alpha.mul(h2.add(alpha.mul(h3))))))\n}\n/// Transaction-local residues. At a group boundary each limb is <2^34.\n/// Four products add at most 4*(P-1)^2; adding the retained folded residue\n/// still fits u64 because 4*(P-1)^2+2^34 < 2^64. Flush after each four queries.\nstruct BatchedWeights { raw:Vec<[u64;4]>, terms:usize }\nimpl BatchedWeights {\n    fn new(weights:&[K])->Result<Self,Error> {\n        let mut raw=aspis_core::r0::heap::filled(weights.len(),[0u64;4]).map_err(|_|Error::Allocation)?;\n        let mut index=0;\n        while index<weights.len() {\n            let w=weights[index];\n            raw[index]=[w.c0.a.0 as u64,w.c0.b.0 as u64,w.c1.a.0 as u64,w.c1.b.0 as u64];\n            index+=1;\n        }\n        Ok(Self{raw,terms:0})\n    }\n    #[inline(always)]\n    fn push(&mut self,index:usize,power:K,basis:M31) {\n        let flush=self.terms&3==3;\n        update_residue_row(&mut self.raw[index],power,basis,flush);\n    }\n\n    fn value(&self,index:usize)->K {\n        let [a,b,c,d]=self.raw[index].map(M31::reduce_u64);\n        K{c0:aspis_core::field::CM31{a,b},c1:aspis_core::field::CM31{a:c,b:d}}\n    }\n    fn finish(&self,weights:&mut[K]) {for (i,w) in weights.iter_mut().enumerate(){*w=self.value(i);}}\n}\n\n\n#[inline(always)]\nfn residue_limb_at(row:&[u64;4],index:usize)->u64 {row[index]}\n#[inline(always)]\nfn power_limb_at(limbs:&[u32;4],index:usize)->u32 {limbs[index]}\n#[inline(always)]\nfn update_residue_row(row:&mut [u64;4],power:K,basis:M31,flush:bool) {\n    let limbs=[power.c0.a.0,power.c0.b.0,power.c1.a.0,power.c1.b.0];\n    for j in 0..4 {\n        let old=residue_limb_at(row,j);\n        let limb=power_limb_at(&limbs,j);\n        row[j]=old+u64::from(limb)*u64::from(basis.0);\n    }\n    if flush {\n        for limb in row {*limb=(*limb&0x7fff_ffff)+(*limb>>31);}\n    }\n}\n\n#[inline(never)]\npub fn accumulate(p:&Prepared,a:&mut Accumulator,index:usize,value:E) {\n    let mut node=crate::fast_domain::line_node(domain::FibreIndex::new(if p.variant.folds()==1 {index}else{index/4*4}).unwrap());\n    if p.variant.folds()==2 {for _ in 0..2 {node=node.mul(node).double().sub(M31::ONE);}}\n    accumulate_with_node(p,a,node,value,None)\n}\n#[inline(never)]\nfn accumulate_with_node(p:&Prepared,a:&mut Accumulator,mut node:M31,value:E,mut pending:Option<&mut BatchedWeights>) {\n    let mut basis=[M31::ZERO;256];basis[0]=M31::ONE;let mut n=1;\n    while n<a.weights.len() {for j in 0..n {basis[n+j]=basis[j].mul(node);} node=node.mul(node).double().sub(M31::ONE);n*=2;}\n    for j in 0..a.weights.len() {\n        if let Some(weights)=pending.as_deref_mut() {\n            weights.push(j,a.power,basis[j]);\n            #[cfg(feature=\"prover\")] {a.weights[j]=weights.value(j);}\n        } else {a.weights[j]=a.weights[j].add(a.power.mul_m31(basis[j]));}\n        crate::trace::value(12,a.next*a.weights.len()+j,E::from_qm31(a.weights[j]));\n        crate::trace::value(13,a.next*a.weights.len()+j,E::from_m31(basis[j]));\n    }\n    if let Some(weights)=pending {weights.terms+=1;}\n    a.rhs=a.rhs.add(value.mul_qm31(a.power));crate::trace::value(11,a.next,a.rhs);\n    a.power=a.power.mul(p.rho);a.next+=1;\n}\n\n\n#[inline(always)]\nfn basis_at(basis:&[M31;256],index:usize)->M31 {basis[index]}\n#[inline(always)]\nfn accumulated_weight_at(weights:&[K],index:usize)->K {weights[index]}\n\n#[inline(never)]\nfn accumulate_batched_with_node(p:&Prepared,a:&mut Accumulator,mut node:M31,value:E,weights:&mut BatchedWeights) {\n    let width=a.weights.len();\n    let mut basis=[M31::ZERO;256];basis[0]=M31::ONE;let mut n=1;\n    while n<width {for j in 0..n {basis[n+j]=basis[j].mul(node);} node=node.mul(node).double().sub(M31::ONE);n*=2;}\n    for j in 0..width {\n        weights.push(j,a.power,basis_at(&basis,j));\n        #[cfg(feature=\"prover\")] {a.weights[j]=weights.value(j);}\n        crate::trace::value(12,a.next*width+j,E::from_qm31(accumulated_weight_at(&a.weights,j)));\n        crate::trace::value(13,a.next*width+j,E::from_m31(basis_at(&basis,j)));\n    }\n    weights.terms+=1;\n    a.rhs=a.rhs.add(value.mul_qm31(a.power));crate::trace::value(11,a.next,a.rhs);\n    a.power=a.power.mul(p.rho);a.next+=1;\n}\n\npub fn polynomial(bytes:&[u8],x:E)->E {(0..7).rev().fold(E::ZERO,|a,i|a.mul(x).add(field(bytes,i)))}\nfn finish_relation_round(poly:&[u8],alpha:E,mut claim:E,round:usize)->Result<E,Error> {\n        let lhs=field(poly,0).add(field(poly,4));let rhs=claim.mul_m31(QUARTER);\n        crate::trace::value(15,3*round,lhs);crate::trace::value(15,3*round+1,rhs);\n        if lhs!=rhs {return Err(Error::Relation);}\n        claim=polynomial(poly,alpha);crate::trace::value(15,3*round+2,claim);\n    Ok(claim)\n}\n\nfn finish_query_dot(final_message:&[u8],weights:&[K])->Result<E,Error> {\n    let mut dot=crate::fast_pairing::EbyKDot::new();\n    let mut j=0;\n    while j<weights.len() {dot.push(field(final_message,j),weights[j]).map_err(|_|Error::Parse)?;j+=1;}\n    Ok(dot.finish())\n}\n\n#[inline(never)]\npub fn finish_relation(v:&View<'_>,p:&Prepared,a:&Accumulator,obs:Observer)->Result<(),Error> {\n    let mut claim=p.claim;\n    claim=finish_relation_round(v.round0,p.alpha[0],claim,0)?;\n    if p.variant.folds()==2 {claim=finish_relation_round(v.round1,p.alpha[1],claim,1)?;}\n    let weights=Weights::new(p.variant,&p.semantic_alpha,&p.z)?;\n    let pair=weights.pair(&p.alpha[..p.variant.folds()],v.final_message,p.kappa)?;\n    crate::trace::value(16,0,pair);crate::trace::value(16,1,claim);\n    if pair!=claim {return Err(Error::Relation);}\n    mark(obs,Phase::Relation);\n    let actual=finish_query_dot(v.final_message,&a.weights)?;\n    crate::trace::value(17,0,actual);crate::trace::value(17,1,a.rhs);\n    if a.next!=22||actual!=a.rhs {return Err(Error::Query);}\n    mark(obs,Phase::Final);Ok(())\n}\n\nfn put(out:&mut Vec<u8>,x:E) {out.extend_from_slice(&x.to_le_bytes());}\nfn put_k(out:&mut Vec<u8>,x:K) {let mut b=[0;16];x.write_le_bytes(&mut b);out.extend_from_slice(&b);}\npub fn checkpoint<H:Digest32>(p:&Prepared,a:&Accumulator,proof:&[u8],public:&[u8],hash:H)->Vec<u8> {\n    let mut out=Vec::with_capacity(checkpoint_size(p.variant));\n    out.extend_from_slice(b\"R1P2CKP2\");out.extend_from_slice(&[p.variant.tag(),a.next as u8,1,0,0,0,0,0]);\n    out.extend_from_slice(&hash.digest(&[proof]));out.extend_from_slice(&hash.digest(&[public]));out.extend_from_slice(&p.state);\n    for root in &p.roots {out.extend_from_slice(root);}\n    for x in [p.gamma,p.kappa,p.alpha[0],p.alpha[1]] {put(&mut out,x);}\n    put_k(&mut out,p.rho);\n    for q in p.queries {out.extend_from_slice(&q.to_le_bytes());}\n    for x in p.semantic_alpha {let mut b=[0;16];x.write_le_bytes(&mut b);out.extend_from_slice(&b);}\n    for z in p.z {for x in [z.x,z.y] {let mut b=[0;16];x.write_le_bytes(&mut b);out.extend_from_slice(&b);}}\n    for x in [p.claim,a.rhs] {put(&mut out,x);}\n    put_k(&mut out,a.power);\n    for &x in &a.weights {put_k(&mut out,x);}\n    let sum=hash.digest(&[b\"UNPROVED:R1:checkpoint\",&out]);out.extend_from_slice(&sum);\n    assert_eq!(out.len(),checkpoint_size(p.variant));out\n}\nstruct Reader<'a>{bytes:&'a[u8],at:usize}\nimpl<'a> Reader<'a>{\n    fn raw<const N:usize>(&mut self)->[u8;N] {let b=self.bytes[self.at..self.at+N].try_into().unwrap();self.at+=N;b}\n    fn e(&mut self)->Result<E,Error>{E::from_le_bytes(&self.raw::<32>()).ok_or(Error::Checkpoint)}\n    #[inline(always)]\n    fn k(&mut self)->Result<K,Error>{K::from_le_bytes(&self.raw::<16>()).ok_or(Error::Checkpoint)}\n}\n\n\n#[inline(always)]\nfn validate_checkpoint_queries(queries:&[u32;22])->Result<(),Error> {\n    let mut i=0;\n    while i<queries.len() {\n        let q=queries[i];\n        if q>=1<<18||queries[..i].contains(&q){return Err(Error::Checkpoint);}\n        i+=1;\n    }\n    Ok(())\n}\n\n#[inline(always)]\nfn read_checkpoint_weights(bytes:&[u8],mut at:usize,mut weights:Vec<K>)->Result<(Vec<K>,usize),Error> {\n    for out in &mut weights {\n        let mut reader=Reader{bytes,at};\n        let value=reader.k()?;\n        at=reader.at;\n        *out=value;\n    }\n    Ok((weights,at))\n}\n\n\n#[inline(always)]\nfn read_checkpoint_semantic_alpha(bytes:&[u8],at:usize)->Result<([K;10],usize),Error> {\n    let mut r=Reader{bytes,at};\n    let values=[\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n        r.k()?,\n    ];\n    Ok((values,r.at))\n}\n\n#[inline(never)]\npub fn resume<H:Digest32>(bytes:&[u8],proof:&[u8],public:&[u8],v:Variant,hash:H)->Result<(Box<Prepared>,Accumulator),Error> {\n    if bytes.len()!=checkpoint_size(v)||&bytes[..8]!=b\"R1P2CKP2\"||bytes[8]!=v.tag()||bytes[9]>22||bytes[10]!=1||bytes[11..16].iter().any(|&b|b!=0) {return Err(Error::Checkpoint);}\n    let end=bytes.len()-32;\n    if bytes[16..48]!=hash.digest(&[proof])||bytes[48..80]!=hash.digest(&[public])||bytes[end..]!=hash.digest(&[b\"UNPROVED:R1:checkpoint\",&bytes[..end]]) {return Err(Error::Checkpoint);}\n    let mut r=Reader{bytes,at:80};let state=r.raw();let roots=[r.raw(),r.raw()];\n    let gamma=r.e()?;let kappa=r.e()?;let alpha=[r.e()?,r.e()?];let rho=r.k()?;\n    let queries=[\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n        u32::from_le_bytes(r.raw()),\n    ];\n    validate_checkpoint_queries(&queries)?;\n    let (semantic_alpha,at)=read_checkpoint_semantic_alpha(bytes,r.at)?;\n    r.at=at;\n    let z=[SecureCirclePoint{x:r.k()?,y:r.k()?},SecureCirclePoint{x:r.k()?,y:r.k()?}];\n    let claim=r.e()?;let rhs=r.e()?;let power=r.k()?;\n    let weights=aspis_core::r0::heap::filled(v.final_len(),K::ZERO).map_err(|_|Error::Allocation)?;\n    let (weights,at)=read_checkpoint_weights(bytes,r.at,weights)?;\n    if at!=end {return Err(Error::Checkpoint);}\n    Ok((Box::new(Prepared{variant:v,roots,gamma,kappa,alpha,rho,queries,semantic_alpha,z,claim,state}),Accumulator{weights,rhs,power,next:bytes[9] as usize}))\n}\n\n#[cfg(test)]\nmod query_geometry_tests {\n    use super::*;\n    use aspis_core::field::{CM31,QM31,P};\n\n    fn next(state:&mut u64)->u64 {\n        *state=state.wrapping_add(0x9e37_79b9_7f4a_7c15);\n        let mut value=*state;\n        value=(value^(value>>30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);\n        value=(value^(value>>27)).wrapping_mul(0x94d0_49bb_1331_11eb);\n        value^(value>>31)\n    }\n    fn random_m31(state:&mut u64)->M31 {M31((next(state)%u64::from(P)) as u32)}\n    fn random_e(state:&mut u64)->E {\n        let mut scalar=||random_m31(state);\n        let mut k=||QM31{c0:CM31{a:scalar(),b:scalar()},c1:CM31{a:scalar(),b:scalar()}};\n        E::new(k(),k())\n    }\n    fn queries()->[u32;22] {core::array::from_fn(|i|((i*7919+12345)%262144) as u32)}\n\n    #[test]\n    fn batched_geometry_inverses_match_individual_inverses_for_ranges() {\n        let queries=queries();\n        for (start,end) in [(0,0),(0,1),(0,7),(7,22),(0,22),(5,19)] {\n            let geometry=QueryGeometry::for_range(&queries,start,end).unwrap();\n            assert_eq!(geometry.start,start);\n            assert_eq!(geometry.inverses.len(),end-start);\n            for index in start..end {\n                let u=queries[index] as usize;\n                let point=crate::fast_domain::fibre_point(domain::FibreIndex::new(u).unwrap());\n                let line_x=crate::fast_domain::line_node(domain::FibreIndex::new(u/4*4).unwrap());\n                let line_y=crate::fast_domain::line_node(domain::FibreIndex::new(u/4*4+3).unwrap());\n                let line_z=line_x.mul(line_x).double().sub(M31::ONE);\n                assert_eq!(*geometry.for_query(index),[point.x.inv(),point.y.inv(),line_x.inv(),line_y.inv(),line_z.inv()]);\n            }\n        }\n    }\n\n    #[test]\n    fn batched_circle_and_line_folds_match_independent_reference() {\n        let queries=queries();\n        let geometry=QueryGeometry::for_range(&queries,0,22).unwrap();\n        let mut state=0x243f_6a88_85a3_08d3;\n        let max=E::from_limbs([P-1;8]).unwrap();\n        for index in 0..22 {\n            for case in 0..8 {\n                let alpha=match case%4 {0=>E::ZERO,1=>E::ONE,2=>max,_=>random_e(&mut state)};\n                let values=core::array::from_fn(|slot|match (case+slot)%4 {0=>E::ZERO,1=>E::ONE,2=>max,_=>random_e(&mut state)});\n                let inverse=geometry.for_query(index);\n                assert_eq!(circle_fold_with_inverses(alpha,values,inverse),circle_fold(alpha,queries[index] as usize,values),\"circle index {index}, case {case}\");\n                assert_eq!(line_fold_with_inverses(alpha,values,inverse),line_fold(alpha,queries[index] as usize/4,values),\"line index {index}, case {case}\");\n            }\n        }\n    }\n}\n\n#[cfg(test)]\nmod batched_weight_tests {\n    use super::*;\n    #[test]\n    fn bounded_rho_residues_match_all_canonical_prefixes() {\n        let hi=M31(aspis_core::field::P-1);\n        let max=K{c0:aspis_core::field::CM31{a:hi,b:hi},c1:aspis_core::field::CM31{a:hi,b:hi}};\n        for power in [K::ZERO,K::ONE,max] {\n            let mut reference=alloc::vec![max;64];let mut pending=BatchedWeights::new(&reference).unwrap();\n            for _ in 0..22 {\n                for j in 0..64 {\n                    pending.push(j,power,hi);\n                    reference[j]=reference[j].add(power.mul_m31(hi));\n                    assert_eq!(pending.value(j),reference[j]);\n                }\n                pending.terms+=1;\n            }\n            let mut actual=alloc::vec![K::ZERO;64];pending.finish(&mut actual);assert_eq!(actual,reference);\n        }\n    }\n}\n\n// The adopted R1 verifier (PREREG-PROOF-SIZE-2, 2026-10-19): the compact\n// binary-multiproof format of `crate::compact`. These are the only R1\n// verification entrypoints of a default build.\n#[path=\"candidate.rs\"]\npub mod candidate;\npub use candidate::{parse_shape,tx1,tx2,tx2_authenticated};\n/// The one stored proof length of the adopted format (57,607 bytes).\npub const PROOF_BYTES:usize=crate::compact::PROOF_BYTES;\n/// The one stage-1 split of the adopted format (queries 0..10 in stage 1).\npub const SPLIT:usize=crate::compact::SPLIT;\nconst _:()=assert!(PROOF_BYTES==57_607&&SPLIT==10);\n\n// AUDIT ONLY: the retired eight-way verifier, for differential evidence on\n// saved eight-way fixtures. Never in a prover or SBF build (lib.rs guards).\n#[cfg(feature=\"audit-eight-way\")]\n#[path=\"eight_way.rs\"]\npub mod eight_way;\n"},{"id":2,"name":{"Local":"crates/aspis-r1-cost-probe/src/lib.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! UNPROVED R1 COST PROBE. P2 only; no production entrypoint.\n#![no_std]\nextern crate alloc;\npub mod sampler;\npub mod semantic_wire;\npub mod semantic;\npub mod fast_domain;\npub mod fast_dots;\npub mod fast_pairing;\n\n#[cfg(feature = \"prover\")]\nextern crate std;\npub mod r1_wire;\npub mod r1_semantic;\npub mod trace;\npub mod transport;\npub mod weights;\npub mod transcript;\npub mod verifier;\n#[cfg(feature = \"prover\")]\npub mod prover;\n/// Host client for the selected public proof-account nonce route (D162).\n#[cfg(feature = \"r1p-check\")]\n#[allow(non_snake_case)]\npub mod RealR1_client;\n#[cfg(feature = \"prover\")]\npub mod dense;\n/// G-sim (LOG D44.3): the explicit R1 simulator simE in the ideal game.\n#[cfg(feature = \"r1p-check\")]\npub mod sim;\n\n#[cfg(feature=\"prover\")] mod host_sumcheck;\n#[cfg(feature=\"prover\")] mod host_semantic;\n#[cfg(feature=\"prover\")] mod host_commitment;\n\n// Adopted R1 proof format (PREREG-PROOF-SIZE-2, 2026-10-19): compact QM31\n// storage and binary multiproofs. UNPROVED: see PROOF-SIZE-OBLIGATIONS.\npub mod multiproof;\npub mod compact;\n\n#[cfg(not(feature=\"private-leaf-salts\"))]\ncompile_error!(\"the adopted R1 proof format is defined over private leaf salts; enable `private-leaf-salts` (a default feature)\");\n#[cfg(all(feature=\"audit-eight-way\",feature=\"prover\"))]\ncompile_error!(\"`audit-eight-way` is audit-only: it is never combined with the prover (PREREG-PROOF-SIZE-2 item 4)\");\n#[cfg(all(feature=\"audit-eight-way\",any(target_os=\"solana\",feature=\"program-build\")))]\ncompile_error!(\"`audit-eight-way` is audit-only: it is never built for a program (PREREG-PROOF-SIZE-2 item 4)\");\n"},{"id":3,"name":{"Local":"crates/aspis-core/src/digest.rs"},"crate_name":"aspis_core","contents":null},{"id":4,"name":{"Local":"crates/aspis-core/src/lib.rs"},"crate_name":"aspis_core","contents":null},{"id":5,"name":{"Local":"crates/aspis-statement/src/pool_v1/pair_forest_semantic_terminal.rs"},"crate_name":"aspis_statement","contents":null},{"id":6,"name":{"Local":"crates/aspis-statement/src/pool_v1/mod.rs"},"crate_name":"aspis_statement","contents":null},{"id":7,"name":{"Local":"crates/aspis-statement/src/lib.rs"},"crate_name":"aspis_statement","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":12,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":13,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":14,"name":{"Local":"crates/aspis-r1-cost-probe/src/transport.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! UNPROVED COST PROBE. S uses the D18 digit permutation; D uses retained D13.\n#[derive(Clone,Copy,Debug,PartialEq,Eq)]\npub enum Variant { S1, S2, D }\npub const TAU: [usize; 5] = [3, 4, 2, 0, 1];\nimpl Variant {\n    pub fn tag(self) -> u8 { match self { Self::S1=>1,Self::S2=>2,Self::D=>3 } }\n    pub fn from_tag(tag:u8) -> Option<Self> { match tag {1=>Some(Self::S1),2=>Some(Self::S2),3=>Some(Self::D),_=>None} }\n    pub fn folds(self) -> usize { if self == Self::S1 { 1 } else { 2 } }\n    pub fn final_len(self) -> usize { 1024 >> (2*self.folds()) }\n    pub fn row(self, j:usize) -> usize {\n        if self == Self::D { return aspis_core::r0::transport::COEFFICIENT_TO_ROW[j] as usize; }\n        let mut out=0;\n        for d in 0..5 { out |= ((j>>(2*d))&3) << (2*TAU[d]); }\n        out\n    }\n    pub fn coefficients<T:Copy>(self, rows: &[T;1024]) -> [T;1024] {\n        core::array::from_fn(|j|rows[self.row(j)])\n    }\n    pub fn rows<T:Copy>(self, coefficients: &[T;1024]) -> [T;1024] {\n        let mut out=*coefficients;\n        for j in 0..1024 { out[self.row(j)]=coefficients[j]; }\n        out\n    }\n}\n"},{"id":15,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"crates/aspis-core/src/field/wide_exact.rs"},"crate_name":"aspis_core","contents":null},{"id":19,"name":{"Local":"crates/aspis-core/src/field.rs"},"crate_name":"aspis_core","contents":null},{"id":20,"name":{"Local":"/rustc/library/alloc/src/boxed.rs"},"crate_name":"alloc","contents":null},{"id":21,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":22,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":23,"name":{"Local":"crates/aspis-r1-cost-probe/src/compact.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! ADOPTED R1 PROOF FORMAT (PREREG-PROOF-SIZE-2, 2026-10-19; prototype from\n//! the proof-size feasibility test). UNPROVED: PROOF-SIZE-OBLIGATIONS.\n//!\n//! Compact QM31 storage for the 455 proof values that the shipped format\n//! stores as 32-byte WideExact with the high QM31 half required to be zero:\n//! every value of semantic rows 14..26 (426) and the 29 `y1` values. They are\n//! stored as their 16-byte canonical QM31 encoding; `expand_*` rebuilds the\n//! logical 32-byte form (zero high half) before any hashing, so every\n//! Fiat-Shamir message and record keeps its shipped byte definition.\n//!\n//! Stored layout (`MAGIC`, variant S2 only):\n//! header 16 | compact semantic 7,015 | compact y1 464 | inactive 32 |\n//! round0 224 | folded root 32 | round1 224 | final 2,048 |\n//! 22 openings x 832 (C1 values 480, C2 values 128, C1 salt, C2 salt,\n//! folded values 128, folded salt) | six fixed node slots, batch A then\n//! batch B, each batch C1, C2, folded (`SLOT_NODES`). Batch A = queries\n//! 0..SPLIT, batch B = SPLIT..22. Fixed length (lead ruling 2026-10-19): each\n//! slot holds its multiproof's nodes followed by zero bytes up to the slot's\n//! worst-case node count; the padding must be zero and is hashed with the\n//! rest of the stored bytes.\nuse crate::r1_wire::row_shape;\nuse alloc::vec::Vec;\nuse aspis_core::field::QM31;\n\npub const MAGIC: &[u8; 8] = b\"R1P3CB18\";\npub const HEADER: usize = 16;\npub const SPLIT: usize = 10;\npub const QUERIES: usize = 22;\npub const SEMANTIC_ROWS: u8 = 27;\n/// Logical (shipped) semantic bytes: root 32 + 27 framed records.\npub const LOGICAL_SEMANTIC: usize = crate::verifier::SEMANTIC_BYTES;\n/// Values with an implied zero high half: rows 14..=26.\npub const SEMANTIC_COMPACT_VALUES: usize = 1 + 10 * 28 + (87 + 29) + 29;\npub const COMPACT_SEMANTIC: usize = LOGICAL_SEMANTIC - 16 * SEMANTIC_COMPACT_VALUES;\npub const COMPACT_Y1: usize = 29 * 16;\npub const LOGICAL_Y1: usize = 29 * 32;\npub const OPENING: usize = 480 + 128 + 32 + 32 + 128 + 32;\npub const OFF_SEMANTIC: usize = HEADER;\npub const OFF_Y1: usize = OFF_SEMANTIC + COMPACT_SEMANTIC;\npub const OFF_INACTIVE: usize = OFF_Y1 + COMPACT_Y1;\npub const OFF_ROUND0: usize = OFF_INACTIVE + 32;\npub const OFF_FOLDED_ROOT: usize = OFF_ROUND0 + 224;\npub const OFF_ROUND1: usize = OFF_FOLDED_ROOT + 32;\npub const OFF_FINAL: usize = OFF_ROUND1 + 224;\npub const FINAL_LEN: usize = 64;\npub const OFF_OPENINGS: usize = OFF_FINAL + FINAL_LEN * 32;\npub const OFF_NODES: usize = OFF_OPENINGS + QUERIES * OPENING;\n/// Bytes before the multiproof nodes (28,359).\npub const FIXED: usize = OFF_NODES;\n/// Worst-case supplied nodes over all query sets (S1 counting bound).\npub const MAX_NODES: usize = 2 * (146 + 172) + (128 + 150);\npub const MAX_PROOF: usize = FIXED + 32 * MAX_NODES;\n/// Worst-case node counts per slot: [C1 A, C2 A, folded A, C1 B, C2 B, folded B].\npub const SLOT_NODES: [usize; 6] = [146, 146, 128, 172, 172, 150];\n/// Byte offset of each slot inside the stored proof.\npub const fn slot_offset(slot: usize) -> usize {\n    let mut at = OFF_NODES;\n    let mut i = 0;\n    while i < slot {\n        at += 32 * SLOT_NODES[i];\n        i += 1;\n    }\n    at\n}\n/// The candidate's one stored length.\npub const PROOF_BYTES: usize = MAX_PROOF;\nconst _: () = assert!(slot_offset(6) == MAX_PROOF);\nconst _: () = assert!(SEMANTIC_COMPACT_VALUES == 426 && COMPACT_SEMANTIC == 7015);\nconst _: () = assert!(FIXED == 28_359 && MAX_PROOF == 57_607);\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum CodecError {\n    Length,\n    NonZeroHigh,\n    NonCanonical,\n}\n\n/// Is a semantic row's payload made of implied-zero-high values?\n#[inline(always)]\nfn compact_row(row: u8) -> bool {\n    row >= 14\n}\n\n/// Encoder (prover side): logical semantic bytes -> compact. Refuses any\n/// value whose high half is not zero (such a value has no compact form).\npub fn compact_semantic(logical: &[u8], out: &mut Vec<u8>) -> Result<(), CodecError> {\n    if logical.len() != LOGICAL_SEMANTIC {\n        return Err(CodecError::Length);\n    }\n    out.extend_from_slice(&logical[..32]);\n    let mut at = 32;\n    for row in 0..SEMANTIC_ROWS {\n        let size = row_shape(row).ok_or(CodecError::Length)?.1;\n        out.extend_from_slice(&logical[at..at + 5]);\n        at += 5;\n        if compact_row(row) {\n            compact_values(&logical[at..at + size], out)?;\n        } else {\n            out.extend_from_slice(&logical[at..at + size]);\n        }\n        at += size;\n    }\n    if at != logical.len() {\n        return Err(CodecError::Length);\n    }\n    Ok(())\n}\n\npub fn compact_values(logical: &[u8], out: &mut Vec<u8>) -> Result<(), CodecError> {\n    if logical.len() % 32 != 0 {\n        return Err(CodecError::Length);\n    }\n    for v in logical.chunks_exact(32) {\n        if v[16..].iter().any(|&b| b != 0) {\n            return Err(CodecError::NonZeroHigh);\n        }\n        out.extend_from_slice(&v[..16]);\n    }\n    Ok(())\n}\n\n/// Decoder (verifier side): compact values -> logical 32-byte values with a\n/// zero high half. Canonicality is not checked here: the verifier checks the\n/// stored `y1` values in its strict scan and the rebuilt semantic records in\n/// the shipped `Prefix::parse` (one check per value, as in the shipped path).\n#[inline(always)]\npub fn expand_values(compact: &[u8], out: &mut [u8]) -> Result<(), CodecError> {\n    if compact.len() % 16 != 0 || out.len() != 2 * compact.len() {\n        return Err(CodecError::Length);\n    }\n    for (c, o) in compact.chunks_exact(16).zip(out.chunks_exact_mut(32)) {\n        o[..16].copy_from_slice(c);\n        o[16..].fill(0);\n    }\n    Ok(())\n}\n\n/// Every stored compact value is a canonical QM31.\npub fn check_values(compact: &[u8]) -> Result<(), CodecError> {\n    for c in compact.chunks_exact(16) {\n        QM31::from_le_bytes(c).ok_or(CodecError::NonCanonical)?;\n    }\n    Ok(())\n}\n\n/// Decoder: compact semantic -> logical semantic (framing bytes copied;\n/// the shipped `Prefix::parse` then checks tag, length and every limb).\npub fn expand_semantic(compact: &[u8], out: &mut [u8]) -> Result<(), CodecError> {\n    if compact.len() != COMPACT_SEMANTIC || out.len() != LOGICAL_SEMANTIC {\n        return Err(CodecError::Length);\n    }\n    out[..32].copy_from_slice(&compact[..32]);\n    let (mut src, mut dst) = (32, 32);\n    for row in 0..SEMANTIC_ROWS {\n        let size = row_shape(row).ok_or(CodecError::Length)?.1;\n        out[dst..dst + 5].copy_from_slice(&compact[src..src + 5]);\n        src += 5;\n        dst += 5;\n        if compact_row(row) {\n            expand_values(&compact[src..src + size / 2], &mut out[dst..dst + size])?;\n            src += size / 2;\n        } else {\n            out[dst..dst + size].copy_from_slice(&compact[src..src + size]);\n            src += size;\n        }\n        dst += size;\n    }\n    if src != compact.len() || dst != out.len() {\n        return Err(CodecError::Length);\n    }\n    Ok(())\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    #[test]\n    fn layout_constants() {\n        assert_eq!(LOGICAL_SEMANTIC, 13_831);\n        assert_eq!(COMPACT_SEMANTIC + 16 * 426, 13_831);\n        assert_eq!(OPENING, 832);\n    }\n    #[test]\n    fn values_roundtrip_and_reject() {\n        let mut logical = [0u8; 64];\n        logical[0] = 5;\n        logical[32] = 7;\n        let mut c = Vec::new();\n        compact_values(&logical, &mut c).unwrap();\n        assert_eq!(c.len(), 32);\n        let mut back = [0xffu8; 64];\n        expand_values(&c, &mut back).unwrap();\n        assert_eq!(back, logical);\n        let mut high = logical;\n        high[20] = 1;\n        assert_eq!(compact_values(&high, &mut Vec::new()), Err(CodecError::NonZeroHigh));\n        let mut bad = c.clone();\n        bad[0..4].copy_from_slice(&0x7fff_ffffu32.to_le_bytes());\n        assert_eq!(check_values(&bad), Err(CodecError::NonCanonical));\n    }\n}\n"},{"id":24,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":25,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":26,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":27,"name":{"Local":"/rustc/library/core/src/fmt/mod.rs"},"crate_name":"core","contents":null},{"id":28,"name":{"Local":"crates/aspis-r1-cost-probe/src/weights.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! UNPROVED COST PROBE. Seven coefficient functionals and their dual folds.\nuse alloc::{boxed::Box,vec::Vec};\nuse aspis_core::{field::{QM31 as K,WideExact as E,M31},circle::SecureCirclePoint};\nuse crate::{transport::{Variant,TAU},verifier::Error};\npub const QUARTER:M31=M31(536870912);\npub const PERM:[usize;4]=[0,3,2,1];\npub fn powers<const N:usize>(x:E)->[E;N]{\n let mut out=[E::ZERO;N];\n let mut p=E::ONE;\n let mut i=0usize;\n while i<N {\n  out[i]=p;\n  i+=1;\n  if i==N { return out; }\n  p=p.mul(x);\n }\n out\n}\npub fn kpowers<const N:usize>(x:K)->[K;N]{\n let mut out=[K::ZERO;N]; let mut p=K::ONE;\n for i in 0..N { out[i]=p; p=p.mul(x); }\n out\n}\npub fn double(x:K)->K { x.mul(x).add(x.mul(x)).sub(K::ONE) }\npub fn field(bytes:&[u8],i:usize)->E { E::from_le_bytes(&bytes[i*32..(i+1)*32]).unwrap() }\n\n// Exact S2 coefficient-to-row inactive classification, in first-occurrence order.\n// Exhaustive table correspondence is checked against Variant::row and raw(0, _).\nconst S2_INACTIVE_GROUPS:[u8;64]=[0,1,2,3,4,5,5,6,4,5,5,5,7,7,7,7,7,7,7,4,4,5,5,6,4,5,5,5,7,7,7,4,7,7,7,7,4,5,5,5,4,5,5,5,8,9,10,8,11,2,2,10,4,5,5,6,4,5,5,6,7,7,7,7];\nconst S2_INACTIVE_MASKS:[u16;12]=[32769,49217,49280,16448,32767,16383,49151,65535,49152,57344,49216,33024];\n\n#[inline(never)]\nfn s2_grouped_inactive_pair(f:&[u8],low:&[E;16])->E {\n    let mut coefficients=[E::ZERO;12];\n    for j in 0..64 {\n        let group=S2_INACTIVE_GROUPS[j] as usize;\n        coefficients[group]=coefficients[group].add(field(f,j));\n    }\n    let mut pair=E::ZERO;\n    for group in 0..12 {\n        let mut weight=E::ZERO;\n        for bit in 0..16 {\n            let challenge=low[bit];\n            if S2_INACTIVE_MASKS[group]&(1<<bit)!=0 {weight=weight.add(challenge);}\n        }\n        pair=pair.add(coefficients[group].mul(weight));\n    }\n    pair\n}\n\n/// Contract the inactive row after combining coefficients with the same\n/// sixteen-entry inactive mask. The zero mask is retained as a group; its\n/// subset weight is zero, matching the ungrouped sum.\n#[inline(never)]\nfn grouped_inactive_pair(weights:&Weights,f:&[u8],low:&[E;16])->E {\n    if weights.variant==Variant::S2 && f.len()==64*32 {return s2_grouped_inactive_pair(f,low);}\n    let mut group_masks=[0u16;64];\n    let mut group_coefficients=[E::ZERO;64];\n    let mut groups=0;\n    for j in 0..f.len()/32 {\n        let mut mask=0u16;\n        for s in 0..16 {if weights.raw(0,16*j+s)==K::ONE {mask|=1<<s;}}\n        let coefficient=field(f,j);\n        let mut group=0;\n        while group<groups && group_masks[group]!=mask {group+=1;}\n        if group==groups {group_masks[group]=mask;groups+=1;}\n        group_coefficients[group]=group_coefficients[group].add(coefficient);\n    }\n    let mut pair=E::ZERO;\n    for group in 0..groups {\n        let mask=group_masks[group];\n        let mut weight=E::ZERO;\n        for s in 0..16 {\n            let challenge=low[s];\n            if mask&(1<<s)!=0 {weight=weight.add(challenge);}\n        }\n        pair=pair.add(group_coefficients[group].mul(weight));\n    }\n    pair\n}\n\n/// Build the four two-fold Libra dual weights without per-cell exponentiation.\n#[inline(never)]\nfn twofold_libra_weights(low:&[E;16],extra:[K;2])->[E;4] {\n    let mut powers=[[K::ZERO;28];2];\n    for side in 0..2 {\n        let mut power=K::ONE;\n        for index in 0..28 { powers[side][index]=power; power=power.mul(extra[side]); }\n    }\n    let mut out=[E::ZERO;4];\n    for j in 0..4 {\n        let mut weight=E::ZERO;\n        for s in 0..16 {\n            let index=16*j+s;\n            if index<56 { weight=weight.add(low[s].mul_qm31(powers[index/28][index%28])); }\n        }\n        out[j]=weight;\n    }\n    out\n}\n\n/// Exact factorization of the existing 56-entry Libra row into two 28-entry\n/// geometric runs. The 16-entry low tensor is a product of two four-entry\n/// tensors; the only cut blocks have lengths 12 and 4 (28 = 16 + 12).\n#[inline(never)]\nfn factored_s2_libra_weights(ap0:&[E;4],ap1:&[E;4],extra:[K;2])->[E;4] {\n    let mut weights=[E::ZERO;4];\n    for side in 0..2 {\n        let q0=K::ONE;\n        let q1=q0.mul(extra[side]);\n        let q2=q1.mul(extra[side]);\n        let q3=q2.mul(extra[side]);\n        let _q4=q3.mul(extra[side]);\n        let q=[q0,q1,q2,q3];\n        let q4=q[2].square();let q8=q4.square();let q12=q8.mul(q4);let q16=q8.square();\n        let low=Weights::scalar_factor(&q,ap0);\n        let high_powers=[K::ONE,q4,q8,q12];\n        let term0=ap1[PERM[0]].mul_qm31(high_powers[0]).mul_m31(QUARTER);\n        let term1=ap1[PERM[1]].mul_qm31(high_powers[1]).mul_m31(QUARTER);\n        let term2=ap1[PERM[2]].mul_qm31(high_powers[2]).mul_m31(QUARTER);\n        let term3=ap1[PERM[3]].mul_qm31(high_powers[3]).mul_m31(QUARTER);\n        let terms=[term0,term1,term2,term3];\n        let first2=terms[0].add(terms[1]);let first3=first2.add(terms[2]);let all=first3.add(terms[3]);\n        if side==0 {\n            weights[0]=low.mul(all);\n            weights[1]=low.mul(first3).mul_qm31(q16);\n        } else {\n            weights[1]=weights[1].add(low.mul(ap1[PERM[3]].mul_m31(QUARTER)));\n            weights[2]=low.mul(all).mul_qm31(q4);\n            weights[3]=low.mul(first2).mul_qm31(q16.mul(q4));\n        }\n    }\n    weights\n}\n\nfn shared_two_point_guard(w:&Weights,folds:usize)->bool {\n    w.variant==Variant::S2 && folds==2 && w.factors[0][2]==w.factors[2][2] && w.factors[0][3]==w.factors[2][3]\n }\nfn push_byte_products(pair:&mut crate::fast_pairing::EbyKDot,f:&[u8],scratch:&[K],n:usize)->Result<(),Error>{\n  for j in 0..n { match pair.push(field(f,j),scratch[j]) { Ok(()) => {}, Err(_) => return Err(Error::Parse) } }\n  Ok(())\n }\nfn partial_dot(f:&[u8],common:&[K;16],s:usize)->Result<E,Error>{\n  let mut dot=crate::fast_pairing::EbyKDot::new();\n  for j in 0..16 { match dot.push(field(f,16*s+j),common[j]) { Ok(()) => {}, Err(_) => return Err(Error::Parse) } }\n  Ok(dot.finish())\n }\nfn high_dot(partials:&[E;4],coeffs:&[K;4])->Result<E,Error>{\n  let mut high=crate::fast_pairing::EbyKDot::new();\n  for s in 0..4 { match high.push(partials[s],coeffs[s]) { Ok(()) => {}, Err(_) => return Err(Error::Parse) } }\n  Ok(high.finish())\n }\nfn process_regular_kinds(w:&Weights,shared_two_point:bool,alpha:&[E],f:&[u8],folds:usize,n:usize,\n     ap0:&[E;4],ap1:&[E;4],scratch:&mut Vec<K>,parts:&mut [E;7])->Result<(),Error>{\n  if !shared_two_point { process_kind(w,1,alpha,f,folds,n,ap0,ap1,scratch,parts)?; }\n  process_kind(w,2,alpha,f,folds,n,ap0,ap1,scratch,parts)?;\n  if !shared_two_point { process_kind(w,3,alpha,f,folds,n,ap0,ap1,scratch,parts)?; }\n  process_kind(w,5,alpha,f,folds,n,ap0,ap1,scratch,parts)?;\n  process_kind(w,6,alpha,f,folds,n,ap0,ap1,scratch,parts)?;\n  Ok(())\n }\nfn shared_partials(f:&[u8],common:&[K;16])->Result<[E;4],Error>{\n  let mut partials=[E::ZERO;4];\n  for s in 0..4 { partials[s]=partial_dot(f,common,s)?; }\n  Ok(partials)\n }\nfn shared_high(partials:&[E;4],w:&Weights,ap0:&[E;4],ap1:&[E;4],parts:&mut [E;7])->Result<(),Error>{\n  let high0=high_dot(partials,&w.factors[0][4])?;\n  let scale0=Weights::scalar_factor(&w.factors[0][0],ap0)\n    .mul(Weights::scalar_factor(&w.factors[0][1],ap1));\n  parts[1]=scale0.mul(high0);\n  let high2=high_dot(partials,&w.factors[2][4])?;\n  let scale2=Weights::scalar_factor(&w.factors[2][0],ap0)\n    .mul(Weights::scalar_factor(&w.factors[2][1],ap1));\n  parts[3]=scale2.mul(high2);\n  Ok(())\n }\nfn process_kind(w:&Weights,kind:usize,alpha:&[E],f:&[u8],folds:usize,n:usize,\n     ap0:&[E;4],ap1:&[E;4],scratch:&mut Vec<K>,parts:&mut [E;7])->Result<(),Error>{\n  if w.variant==Variant::D && kind<4 {\n   parts[kind]=w.dense_point_pair(kind,alpha,f)?;\n  } else {\n   let k=if kind<4 {kind-1}else{kind-2};\n   w.tensor(k,folds,scratch);\n   let mut scale=Weights::scalar_factor(&w.factors[k][0],ap0);\n   if folds==2 {scale=scale.mul(Weights::scalar_factor(&w.factors[k][1],ap1));}\n   let mut pair=crate::fast_pairing::EbyKDot::new();\n   push_byte_products(&mut pair,f,scratch,n)?;\n   parts[kind]=scale.mul(pair.finish());\n  }\n  Ok(())\n }\n\npub struct Weights {\n    pub variant:Variant,\n    pub factors:[[[K;4];5];5],\n    pub points:[[K;10];3],\n    pub extra:[K;2],\n}\nimpl Weights {\n    #[inline(never)]\n    fn box_from_parts(variant:Variant,factors:[[[K;4];5];5],points:[[K;10];3],extra:[K;2])->Box<Self> {\n        Box::new(Self { variant, factors, points, extra })\n    }\n    #[inline(never)]\n    pub fn new(variant:Variant,alpha:&[K;10],z:&[SecureCirclePoint;2])->Result<Box<Self>,Error> {\n        let points=aspis_core::state_only_prefix::r0::statement_points(alpha);\n        let extra=[alpha[8],alpha[9]];\n        let mut factors=[[[K::ZERO;4];5];5];\n        for k in 0..3 { for d in 0..5 {\n            let a=points[k][9-2*TAU[d]]; let b=points[k][8-2*TAU[d]];\n            factors[k][d]=[K::ONE.sub(a).mul(K::ONE.sub(b)),a.mul(K::ONE.sub(b)),K::ONE.sub(a).mul(b),a.mul(b)];\n        }}\n        for k in 0..2 {\n            factors[3+k][0]=[K::ONE,z[k].y,z[k].x,z[k].x.mul(z[k].y)];\n            let mut x=double(z[k].x);\n            for d in 1..5 {\n                let y=double(x); factors[3+k][d]=[K::ONE,x,y,x.mul(y)]; x=double(y);\n            }\n        }\n        Ok(Self::box_from_parts(variant, factors, points, extra))\n    }\n    pub fn raw(&self,kind:usize,j:usize)->K {\n        match kind {\n            0=>if aspis_core::r0::opening::inactive(self.variant.row(j)).unwrap() {K::ONE} else {K::ZERO},\n            4=>if j<56 { self.extra[j/28].pow((j%28) as u64) } else {K::ZERO},\n            1..=3 if self.variant==Variant::D => {\n                let r=self.variant.row(j);\n                (0..10).fold(K::ONE,|v,b|v.mul(if r&(1<<b)==0 {K::ONE.sub(self.points[kind-1][9-b])}else{self.points[kind-1][9-b]}))\n            },\n            _=> {\n                let k=if kind<4 {kind-1}else{kind-2};\n                (0..5).fold(K::ONE,|v,d|v.mul(self.factors[k][d][(j>>(2*d))&3]))\n            }\n        }\n    }\n    fn scalar_factor(f:&[K;4],p:&[E;4])->E {\n        (0..4).fold(E::ZERO,|v,s|v.add(p[PERM[s]].mul_qm31(f[s]))).mul_m31(QUARTER)\n    }\n    fn tensor(&self,k:usize,folds:usize,output:&mut[K]) {\n        output[0]=K::ONE;let mut n=1;\n        for d in folds..5 {\n            for j in (0..n).rev() {\n                let x=output[j];\n                output[j+0*n]=x.mul(self.factors[k][d][0]);\n                output[j+1*n]=x.mul(self.factors[k][d][1]);\n                output[j+2*n]=x.mul(self.factors[k][d][2]);\n                output[j+3*n]=x.mul(self.factors[k][d][3]);\n            }\n            n*=4;\n        }\n    }\n    pub fn dual_raw(&self,kind:usize,j:usize,alpha:&[E])->E {\n        let p0=powers::<4>(alpha[0]);\n        let p1=if alpha.len()==2 {powers::<4>(alpha[1])}else{[E::ONE;4]};\n        let width=1<<(2*alpha.len());\n        let mut sum=E::ZERO;\n        for s in 0..width {\n            let p=p0[PERM[s%4]].mul(p1[PERM[s/4]]);\n            sum=sum.add(p.mul_qm31(self.raw(kind,width*j+s)));\n        }\n        for _ in alpha { sum=sum.mul_m31(QUARTER); }\n        sum\n    }\n    /// Product rows keep a K tensor after their low digits have been folded.\n    /// Only the contracted scalar is in E. Sparse rows are handled separately.\n    #[inline(never)]\n    pub fn pair(&self,alpha:&[E],f:&[u8],kappa:E)->Result<E,Error> {\n        let n=f.len()/32; let folds=alpha.len();\n        let mut expected_n=1024usize; for _ in 0..folds { expected_n=expected_n>>2u32; } if n!=expected_n {return Err(Error::Parse);}\n        let ap0=powers::<4>(alpha[0]);\n        let ap1=if folds==2 {powers::<4>(alpha[1])}else{[E::ONE;4]};\n        let mut scratch=match aspis_core::r0::heap::filled(n,K::ZERO) { Ok(v) => v, Err(_) => return Err(Error::Allocation) };\n        let mut parts=[E::ZERO;7];\n        // On S2's two-fold path the high tensor factors for point rows 0 and\n        // 2 are identical. Keep the equality guard so arbitrary constructed\n        // `Weights` values retain the original per-row fallback.\n        let shared_two_point=shared_two_point_guard(self,folds);\n        process_regular_kinds(self,shared_two_point,alpha,f,folds,n,&ap0,&ap1,&mut scratch,&mut parts)?;\n        if shared_two_point {\n            // The two point rows share the d2/d3 coefficients. Preserve the\n            // tensor's least-significant-first order: d2 is j mod 4 and d3\n            // is j / 4. Each d4 slice then contracts one 16-term EbyKDot.\n            let mut common=[K::ZERO;16];\n            for j in 0..16 { common[j]=self.factors[0][2][j&3].mul(self.factors[0][3][j>>2u32]); }\n            let partials=shared_partials(f,&common)?;\n            shared_high(&partials,self,&ap0,&ap1,&mut parts)?;\n        }\n        if folds==1 {\n            let mut dual=[E::ZERO;16];\n            for mask in 0..16 {\n                let mut weight=E::ZERO;\n                for s in 0..4 { if mask&(1usize<<(s as u32))!=0 { weight=weight.add(ap0[PERM[s]]); } }\n                dual[mask]=weight.mul_m31(QUARTER);\n            }\n            let mut groups=[E::ZERO;16];\n            for j in 0..n {\n                let mut mask=0;\n                for s in 0..4 {if self.raw(0,4*j+s)==K::ONE {mask|=1usize<<(s as u32);}}\n                groups[mask]=groups[mask].add(field(f,j));\n            }\n            for m in 1..16 {parts[0]=parts[0].add(groups[m].mul(dual[m]));}\n            for side in 0..2 {\n                let p=kpowers::<5>(self.extra[side]);\n                let scale=Self::scalar_factor(&[p[0],p[1],p[2],p[3]],&ap0);\n                let mut power=K::ONE; let mut pair=E::ZERO;\n                for j in 0..7 {pair=pair.add(field(f,j+7*side).mul_qm31(power));power=power.mul(p[4]);}\n                parts[4]=parts[4].add(pair.mul(scale));\n            }\n        } else {\n            // Two-fold 0/1 row: compute the sixteen challenge products once.\n            // Coefficients with the same inactive mask share one subset sum.\n            let mut low=[E::ZERO;16];\n            for s in 0..16 { low[s]=ap0[PERM[s%4]].mul(ap1[PERM[s/4]]).mul_m31(QUARTER.mul(QUARTER)); }\n            parts[0]=grouped_inactive_pair(self,f,&low);\n            let libra=if self.variant==Variant::S2 {factored_s2_libra_weights(&ap0,&ap1,self.extra)}else{twofold_libra_weights(&low,self.extra)};\n            for j in 0..4 {parts[4]=parts[4].add(field(f,j).mul(libra[j]));}\n        }\n        #[cfg(feature=\"prover\")]\n        for kind in 0..7 {\n            for j in 0..1024 {crate::trace::value(6,kind*1024+j,E::from_qm31(self.raw(kind,j)));}\n            for j in 0..n {crate::trace::value(7,kind*n+j,self.dual_raw(kind,j,alpha));}\n        }\n        let k=powers::<7>(kappa);let mut sum=E::ZERO;\n        for kind in 0..7 {crate::trace::value(8,kind,parts[kind]);sum=sum.add(k[kind].mul(parts[kind]));}\n        Ok(sum)\n    }\n    #[inline(never)]\n    fn dense_point_pair(&self,kind:usize,alpha:&[E],f:&[u8])->Result<E,Error> {\n        // D keeps the full eq tensor. Hoist the sixteen shared E products\n        // before combining its K entries; no tensor factorization is assumed.\n        let mut rows=match aspis_core::r0::heap::filled(1024,K::ZERO) { Ok(v) => v, Err(_) => return Err(Error::Allocation) };\n        rows[0]=K::ONE;let mut width=1;\n        for b in 0..10 {\n            let p=self.points[kind-1][9-b];\n            for j in (0..width).rev() {let x=rows[j];rows[j+width]=x.mul(p);rows[j]=x.mul(K::ONE.sub(p));}\n            width*=2;\n        }\n        let a=powers::<4>(alpha[0]);let b=powers::<4>(alpha[1]);\n        let mut low=[E::ZERO;16];\n        for s in 0..16 { low[s]=a[PERM[s%4]].mul(b[PERM[s/4]]).mul_m31(QUARTER.mul(QUARTER)); }\n        let mut pair=E::ZERO;\n        for j in 0..64 {\n            let mut w=E::ZERO;\n            for s in 0..16 {w=w.add(low[s].mul_qm31(rows[self.variant.row(16*j+s)]));}\n            pair=pair.add(field(f,j).mul(w));\n        }\n        Ok(pair)\n    }\n    pub fn materialize(&self,kappa:E)->Result<Vec<E>,Error> {\n        let kp=powers::<7>(kappa);\n        let mut w=match aspis_core::r0::heap::filled(1024,E::ZERO) { Ok(v) => v, Err(_) => return Err(Error::Allocation) };\n        for (j,v) in w.iter_mut().enumerate() {for kind in 0..7 {*v=v.add(kp[kind].mul_qm31(self.raw(kind,j)));}}\n        Ok(w)\n    }\n}\n\n#[cfg(test)]\nmod s2_inactive_table_tests {\n    use super::*;\n    #[test]\n    fn all_s2_inactive_table_entries_match_reference() {\n        for j in 0..64 {\n            let group=S2_INACTIVE_GROUPS[j] as usize;\n            assert!(group<S2_INACTIVE_MASKS.len());\n            for bit in 0..16 {\n                assert_eq!((S2_INACTIVE_MASKS[group]>>bit)&1!=0,\n                    aspis_core::r0::opening::inactive(Variant::S2.row(16*j+bit)).unwrap());\n            }\n        }\n        // Equality of each coefficient's scalar factor establishes the\n        // regrouping identity independently of particular message values.\n        for bit in 0..16 {\n            let low=core::array::from_fn(|i|if i==bit {E::ONE}else{E::ZERO});\n            for j in 0..64 {\n                let mut f=alloc::vec![0u8;64*32];f[j*32..(j+1)*32].copy_from_slice(&E::ONE.to_le_bytes());\n                let expected=if aspis_core::r0::opening::inactive(Variant::S2.row(16*j+bit)).unwrap(){E::ONE}else{E::ZERO};\n                assert_eq!(s2_grouped_inactive_pair(&f,&low),expected);\n            }\n        }\n    }\n}\n\n#[cfg(test)]\nmod libra_factor_tests {\n    use super::*;\n    #[test]\n    fn factored_libra_matches_all_four_original_weights() {\n        let mut state=0x13198a2e03707344u64;\n        let mut field=|| {state=state.wrapping_mul(6364136223846793005).wrapping_add(1);(state%u64::from(aspis_core::field::P)) as u32};\n        for case in 0..512 {\n            let mut value=||E::from_limbs(core::array::from_fn(|_|match case {0=>0,1=>1,2=>aspis_core::field::P-1,_=>field()})).unwrap();\n            let ap0=core::array::from_fn(|_|value());let ap1=core::array::from_fn(|_|value());\n            let extra=[value().c0(),value().c0()];\n            let low=core::array::from_fn(|s|ap0[PERM[s%4]].mul(ap1[PERM[s/4]]).mul_m31(QUARTER.mul(QUARTER)));\n            assert_eq!(factored_s2_libra_weights(&ap0,&ap1,extra),twofold_libra_weights(&low,extra),\"case {case}\");\n        }\n    }\n}\n"},{"id":29,"name":{"Local":"crates/aspis-statement/src/pool_v1/payment_relation.rs"},"crate_name":"aspis_statement","contents":null},{"id":30,"name":{"Local":"crates/aspis-statement/src/pool_v1/pair_tree_profile.rs"},"crate_name":"aspis_statement","contents":null},{"id":31,"name":{"Local":"crates/aspis-core/src/circle.rs"},"crate_name":"aspis_core","contents":null},{"id":32,"name":{"Local":"/rustc/library/core/src/ops/try_trait.rs"},"crate_name":"core","contents":null},{"id":33,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":34,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":35,"name":{"Local":"/rustc/library/core/src/ops/deref.rs"},"crate_name":"core","contents":null},{"id":36,"name":{"Local":"/rustc/library/core/src/ptr/mod.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["aspis_r1_cost_probe",0]},{"Ident":["verifier",0]},{"Ident":["candidate",0]},{"Ident":["tx1",0]}]},{"key":{"Fun":1},"value":[{"Ident":["aspis_r1_cost_probe",0]},{"Ident":["ver