        }\n    }\n}","attr_info":{"attributes":[],"inline":"Always","rename":null,"public":false},"is_local":true,"opacity":"Opaque","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"},{"index":3,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":4294},{"Deduplicated":4353},{"Deduplicated":1623},{"HashConsedValue":[4358,{"Ref":[{"Var":{"Free":2}},{"Deduplicated":1555},"Shared"]}]},{"Deduplicated":1237},{"HashConsedValue":[4359,{"Ref":[{"Var":{"Free":3}},{"Deduplicated":1684},"Shared"]}]},{"Deduplicated":1707},{"Deduplicated":1180}],"output":{"Deduplicated":1741}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":18,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Impl":{"Trait":17}},{"Ident":["deref_mut",0]}],"span":{"data":{"file_id":11,"beg":{"line":3802,"col":4},"end":{"line":3802,"col":39}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"},{"index":1,"name":"A"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[4360,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":4315},"Mut"]}]}],"output":{"HashConsedValue":[4361,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":4307},"Mut"]}]}},"src":{"TraitImpl":{"impl_ref":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":4287},{"Deduplicated":4288}],"const_generics":[],"trait_refs":[]}},"trait_re