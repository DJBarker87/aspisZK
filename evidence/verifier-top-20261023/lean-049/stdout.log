fun ops {Hash} D hash semantic proof split obs p a =>
  ∃ zero g preparation initial root geometry pending returned flushed parsed splitValue,
    ops.op16 = Aeneas.Std.Result.ok splitValue ∧
      ↑split = ↑splitValue ∧
        ops.op3 proof = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok parsed) ∧
          ops.op4 proof = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) ∧
            ops.op1 = Aeneas.Std.Result.ok zero ∧
              ops.op7 D semantic proof hash obs (Aeneas.Std.Array.repeat 29#usize zero) =
                  Aeneas.Std.Result.ok (preparation, g) ∧
                Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch preparation =
                    Aeneas.Std.Result.ok (Aeneas.Std.core.ops.control_flow.ControlFlow.Continue p) ∧
                  ops.op12 AspisR1Stage2.transport.Variant.S2 =
                      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok initial) ∧
                    ops.op5 D proof p root 0#usize hash = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) ∧
                      ops.op11 p.queries 0#usize split =
                          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok geometry) ∧
                        ops.op10 initial.weights.deref =
                            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok pending) ∧
                          ops.op6 proof p initial g obs geometry pending split =
                              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok returned) ∧
                            ops.op9 returned.2 returned.1.weights.deref = Aeneas.Std.Result.ok flushed ∧
                              ↑a.weights = ↑flushed ∧
                                a.rhs = returned.1.rhs ∧ a.power = returned.1.power ∧ a.next = returned.1.next
