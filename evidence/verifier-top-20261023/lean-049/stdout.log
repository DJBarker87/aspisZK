fun {W A E} L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 adapter stage native1 native2 hashv extraction
    sha256 H p1 syscall program data1 data2 slot state1 state2 final1 final2 saved post1 post2 accepted1 accepted2
    reserved checkpointSource checkpointOracle port firstMarks secondMarks =>
  let ⟨f, h✝⟩ :=
    AspisR1.ChildJoin_Accepted.accepted_run L sdk copy std allocator e1 e2 w1 w2 admission1 admission2
      (AspisR1.VTop_Entry.install adapter stage) native1 native2 hashv extraction sha256 H p1 syscall program data1
      data2 slot state1 state2 final1 final2 saved post1 post2 accepted1 accepted2 port firstMarks secondMarks
  let ⟨s, h✝¹⟩ := h✝
  let ⟨outer, h✝²⟩ := h✝¹
  let ⟨pre, h✝³⟩ := h✝²
  let ⟨middle, h✝⁴⟩ := h✝³
  let ⟨fs, h✝⁵⟩ := h✝⁴
  let ⟨ss, h✝⁶⟩ := h✝⁵
  let ⟨cuts, right✝⟩ := h✝⁶
  let ⟨expanded, right✝¹⟩ := right✝
  let ⟨owned, right✝²⟩ := right✝¹
  let ⟨layout, right✝³⟩ := right✝²
  let ⟨unchanged, right✝⁴⟩ := right✝³
  let ⟨firstBefore, right✝⁵⟩ := right✝⁴
  let ⟨secondBefore, continuation⟩ := right✝⁵
  Exists.intro f
    (Exists.intro s
      (Exists.intro outer
        (Exists.intro pre
          (Exists.intro middle
            (Exists.intro fs
              (Exists.intro ss
                ⟨cuts,
                  ⟨expanded,
                    ⟨owned,
                      ⟨layout,
                        ⟨unchanged,
                          ⟨firstBefore,
                            ⟨secondBefore, fun nodes y1 provenance history p2prime entry multiproof scan =>
                              continuation nodes y1
                                (AspisR1.VTop_Checkpoint.writer_join adapter stage H f.semantic f.pub f.proof f.split
                                  reserved checkpointSource checkpointOracle provenance)
                                (AspisR1.VTop_Checkpoint.reader_join adapter stage H s.pub s.proof s.checkpoint reserved
                                  checkpointSource checkpointOracle)
                                history p2prime entry multiproof scan⟩⟩⟩⟩⟩⟩⟩))))))
