fun {W F CoreError} L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps stageBase finishOps B claimsStd program data1
    data2 slot saved post1 post2 H f s outer pre middle fs ss run prior tx2 =>
  have port :=
