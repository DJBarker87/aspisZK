    ∀ (native1 : AspisR1.S2W_ExtractionBoundary.First) (native2 : AspisR1.S2W_ExtractionBoundary.Second)
      (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest),
      AspisR1.S2W_DigestExtraction.AeneasExtraction
          (AspisR1.DrvC_Installation.sdk (AspisR1.DrvC_FirstConstants.configuration c)) native1 native2 hashv →
        ∀
          (copy :
            AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
              ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record)),
          AspisR1.S2W_TrustedStd.TrustedStd copy →
            ∀ (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (id : AspisR1.S2W_ExtractionBoundary.Program)
              (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
              AspisR1.S2W_ExtractionBoundary.P1 sha256 H →
                AspisR1.S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
                  ∀ (initial : AspisR1.Hist_Store.Store)
                    (schedule : AspisR1.Hir_Schedule.Schedule A (AspisR1.Hir_Call.Call A)) (Q0 Q1 : ℕ),
                    (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
                        (AspisV8R19.MemoizedProgramLaw.eval H
                                (AspisR1.Hir_Schedule.program native1 copy allocator id
                                  (AspisR1.DrvC_FirstConstants.configuration c) hashv initial schedule)).1.length ≤
                          Q0 + Q1 + 1018) →
                      (∀ (key : ℕ), (initial key).owner = id → ¬AspisR1.Hist_Store.Initialized (initial key).data) →
                        AspisR1.Hir_ProvenanceModel.admissible native1 native2 copy allocator id H initial schedule →
                          ∀ (post2 : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record)) (final2 : A),
                            (have out := AspisR1.Hir_Schedule.run native1 native2 copy allocator id H initial schedule;
                              AspisR1.S2W_D189Wrappers.second native2 allocator
                                  (AspisR1.Hist_RuntimeEntry.load out.1 out.2.2.layout) id out.2.2.data out.2.2.slot
                                  out.2.2.state =
                                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (post2, final2))) →
                              ∀
                                (project :
                                  AspisR1.Hir_LifetimeExperiment.Execution A →
                                    AspisR1.OraclePortCompactDraft.Parsed × (Fin 22 → Fin 262144)),
                                have out :=
                                  AspisR1.Hir_Schedule.run native1 native2 copy allocator id H initial schedule;
                                ∃ writer f s v,
                                  AspisR1.Hir_WriterSelect.search native1 copy allocator id (out.2.2.layout.handles 6).1
                                        (out.1 (out.2.2.layout.handles 6).1).data
                                        (AspisR1.Hir_ProvenanceModel.calls native1 native2 copy allocator id H initial
                                          schedule) =
                                      some writer ∧
                                    AspisR1.S2W_NativeConsolidation.SourceCuts
                                        (AspisR1.DrvC_Installation.sdk (AspisR1.DrvC_FirstConstants.configuration c))
                                        (AspisR1.Hist_RuntimeEntry.load writer.site.before
                                            writer.site.call.layout).first
                                        ((AspisR1.Hist_RuntimeEntry.load out.1 out.2.2.layout).second
                                          AspisR1.S2W_D189Wrappers.secondSizes)
                                        writer.saved f s ∧
                                      AdapterRw.aspis_statement.pool_v1.pair_forest_terminal.PoolV1PairForestTerminalStatementV1.semantic_public
                                            f.statement =
                                          Aeneas.Std.Result.ok f.semantic ∧
                                        AdapterRw.r1_pool_adapter.owned.validate_asq8
                                              (AspisR1.DrvC_Installation.sdk
                                                (AspisR1.DrvC_FirstConstants.configuration c))
                                              id
                                              ((AspisR1.Hist_RuntimeEntry.load out.1 out.2.2.layout).second
                                                AspisR1.S2W_D189Wrappers.secondSizes)
                                              out.2.2.data out.2.2.slot =
                                            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok v) ∧
                                          (AspisR1.DrvC_Installation.sdk
                                                    (AspisR1.DrvC_FirstConstants.configuration c)).op22
                                                v.statement =
                                              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok s.encoded) ∧
                                            AspisR1.Hir_LifetimeExperiment.select
                                                  (AspisR1.DrvC_FirstConstants.configuration c) native1 copy allocator
                                                  id
                                                  (AspisV8R19.MemoizedProgramLaw.eval H
                                                      (AspisR1.Hir_LifetimeExperiment.program
                                                        (AspisR1.DrvC_FirstConstants.configuration c) hashv native1 copy
                                                        allocator id initial schedule)).2 =
                                                AspisR1.Hist_PairExperiment.select { first := f, second := s } ∧
                                              (AspisR1.BinRawByteCollisionTargets.event
                                                  AspisR1.SelectedTranscriptParams.params.iv (Q0 + Q1 + 2965)
                                                  (AspisV8R19.MemoizedProgramLaw.eval H
                                                    (AspisR1.Hir_SelectedJoint.program
                                                      (AspisR1.DrvC_FirstConstants.configuration c) hashv native1 copy
                                                      allocator id initial schedule project)) ∨
                                                ∃ i,
                                                  i = AspisR1.Hiq_CanonicalCarrier.input f.pub f.proof ∧
                                                    AspisR1.Port1_StoredCarrier.Carried i ∧
                                                      i.statement.pubBytes =
                                                          AspisR1.MultiproofConeCanonical.bytesOf ↑f.pub ∧
                                                        i.stored = AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof ∧
                                                          (AspisV8R19.MemoizedProgramLaw.eval H
                                                                  (AspisR1.DrvC_Implementation.driver
                                                                    (AspisR1.DrvC_FirstConstants.configuration c)
                                                                    i)).2 =
                                                              true ∧
                                                            ¬∀ (j : AspisR1.OraclePortStoredExperimentC4.Input),
                                                                (AspisV8R19.MemoizedProgramLaw.eval H
                                                                      (AspisR1.DrvC_Implementation.driver
                                                                        (AspisR1.DrvC_FirstConstants.configuration c)
                                                                        j)).2 =
                                                                  false) :=
