def AspisR1.T2R_Parser.Facts : Aeneas.Std.Slice Aeneas.Std.U8 → Prop :=
fun proof =>
  ∃ expanded pre,
    AspisR1PublicPreparation.PrefixAdapter.parseAccepted expanded =
        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok pre) ∧
      AspisR1.OraclePortCompactDraft.semanticRows 27 0
            (AspisR1.OraclePortCompactDraft.slice (AspisR1.MultiproofConeCanonical.bytesOf ↑proof) 48 6983) =
          Option.some (List.map (fun s => AspisR1.MultiproofConeCanonical.bytesOf ↑s) ↑pre.records) ∧
        AspisR1.OraclePortCompactDraft.parse (AspisR1.MultiproofConeCanonical.bytesOf ↑proof) =
          Option.some
            { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof,
              semantic := List.map (fun s => AspisR1.MultiproofConeCanonical.bytesOf ↑s) ↑pre.records }
def AspisR1.TxS_Encoding.Facts : {CoreError H : Type} →
  {installed : AspisR1CurrentCaller.Ops} →
    {reserved : Bool} →
      {query : AspisR1.Port3_NativeQueryBody.Ops} →
        {geo : AspisR1.Port3_NativeGeometryBody.Ops CoreError} →
          {D : AspisR1CurrentCaller.aspis_core.digest.Digest32 H} →
            {hash : H} →
              {semantic : AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public} →
                {pub proof : Aeneas.Std.Slice Aeneas.Std.U8} →
                  {split : Aeneas.Std.Usize} →
                    {saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8} →
                      AspisR1.Tx1Q_Execution.Run installed reserved query geo D hash semantic pub proof split saved →
                        (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) → Prop :=
fun {CoreError H} {installed} {reserved} {query} {geo} {D} {hash} {semantic} {pub proof} {split} {saved} run H_1 =>
  ∃ pm,
    saved =
      AspisR1.Tx2N_Reader.writer H_1 (AspisR1.MultiproofConeCanonical.bytesOf ↑proof)
        (AspisR1.MultiproofConeCanonical.bytesOf ↑pub) pm
        (AspisR1.CheckpointBytes5Output.accumulator
          (AspisR1.Tx1Q_Carriers.accumulator
            (have __src := run.out;
            { weights := ⟨↑run.flushed, ⋯⟩, rhs := __src.rhs, power := __src.power, next := __src.next })))
def AspisR1.TxS_RawPublic.Facts : Aeneas.Std.Slice Aeneas.Std.U8 → Aeneas.Std.Slice Aeneas.Std.U8 → Prop :=
fun pub proof =>
  ∃ i,
    i.statement.pubBytes = AspisR1.MultiproofConeCanonical.bytesOf ↑pub ∧
      i.stored = AspisR1.MultiproofConeCanonical.bytesOf ↑proof ∧
        i.statement.tag = 2 ∧
          List.length i.statement.pubBytes = 1880 ∧
            75 + List.length i.statement.pubBytes ≤ AspisR1.SelectedTranscriptParams.L ∧
              ∀ (raw : AspisR1.TxS_Carriers.Prefix),
                raw.publicBytes = AspisR1.MultiproofConeCanonical.bytesOf ↑pub →
                  75 + List.length raw.publicBytes ≤ AspisR1.SelectedTranscriptParams.L
def AspisR1.SAQ_Decoder.read : Aeneas.Std.Slice Aeneas.Std.U8 →
  Aeneas.Std.Usize → Aeneas.Std.Result AspisR1.SAQ_WideABI.E :=
fun bytes i => do
  let start ← 32#usize * i
  let finish ← start + 32#usize
  let selected ←
    Aeneas.Std.core.slice.index.Slice.index (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8) bytes
        { start := start, «end» := finish }
  let decoded ← AspisR1RecordParser.field.wide_exact.WideExact.from_le_bytes selected
  let raw ← Aeneas.Std.core.option.Option.unwrap decoded
  Aeneas.Std.Result.ok (AspisR1.SAQ_RecordDecode.fromRecord raw)
def AspisR1.SAQ_Constructor.fibre : {C : Type} →
  C → Aeneas.Std.Usize → Aeneas.Std.Result (Aeneas.Std.core.result.Result Aeneas.Std.Usize C) :=
fun {C} indexError u =>
  if u < 262144#usize then Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok u)
  else Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err indexError)
