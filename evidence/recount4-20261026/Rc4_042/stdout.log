def AspisR1.Rc3_Nonvacuity.Facts : (AspisR1.OraclePortStoredExperimentC4.Input →
    AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State Bool) →
  (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
    Aeneas.Std.Slice Aeneas.Std.U8 →
      Aeneas.Std.Slice Aeneas.Std.U8 →
        Aeneas.Std.Slice Aeneas.Std.U8 →
          Aeneas.Std.Slice Aeneas.Std.U8 → Aeneas.Std.Slice Aeneas.Std.U8 → AspisV8R19.DuplexFrames.Bytes → Prop :=
fun driver H pub proof pub2 proof2 checkpoint written =>
  ∀ (a : AspisR1.S2X.CheckpointVersionBinding written (AspisR1.MultiproofConeCanonical.bytesOf ↑checkpoint)),
    AspisR1.S2W_AuthenticatedInputs.P2Prime H proof pub proof2 pub2 →
      ∃ i,
        i.statement.pubBytes = AspisR1.MultiproofConeCanonical.bytesOf ↑pub ∧
          i.stored = AspisR1.MultiproofConeCanonical.bytesOf ↑proof ∧
            i.statement.tag = 2 ∧
              List.length i.statement.pubBytes = 1880 ∧
                (AspisV8R19.MemoizedProgramLaw.eval H (driver i)).2 = Bool.true ∧
                  ¬∀ (j : AspisR1.OraclePortStoredExperimentC4.Input),
                      (AspisV8R19.MemoizedProgramLaw.eval H (driver j)).2 = Bool.false
@AspisR1.Rc4_Nonvacuity.contracts : ∀ {F C : Type} (err : C) (c : AspisR1.DrvC_Installation.Configuration F C)
  (r : AspisR1.NP6_StdModel.Reservation),
  AspisR1.Port5Q1_QueryPorts.SessionAPrimitives (AspisR1.Rc4_Install.configuration err c r).query ∧
    AspisR1.Port5Q1_GeometryCanonical.SessionAPrimitives (AspisR1.Rc4_Install.configuration err c r).geometry ∧
      AspisR1.Port5Q1_Domain.SessionADomain (AspisR1.Rc4_Install.configuration err c r).geometry
AspisR1.Rc4_Nonvacuity.model_surjective : ∀ (i : AspisR1.F3_Model.Input), ∃ raw, AspisR1.Rc4_Model.typed raw = i
AspisR1.Rc4_Nonvacuity.data_surjective : ∀ (rs : AspisR1.LiteralAcceptanceTerminal.TranscriptRounds)
  (i : AspisR1.R1FinalSoundness.SourceInputs),
  AspisR1.LiteralMatchingData.read rs = Option.some i.data → ∃ metadata, AspisR1.TxS_Carriers.source metadata rs = i
def AspisR1.T2R_Acceptance.Facts : (AspisR1.OraclePortStoredExperimentC4.Input →
    AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State Bool) →
  (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
    Aeneas.Std.Slice Aeneas.Std.U8 →
      Aeneas.Std.Slice Aeneas.Std.U8 →
        Aeneas.Std.Slice Aeneas.Std.U8 →
          Aeneas.Std.Slice Aeneas.Std.U8 → Aeneas.Std.Slice Aeneas.Std.U8 → AspisV8R19.DuplexFrames.Bytes → Prop :=
fun driver H pub proof pub2 proof2 checkpoint written =>
  ∃ i,
    i.statement.pubBytes = AspisR1.MultiproofConeCanonical.bytesOf ↑pub ∧
      i.stored = AspisR1.MultiproofConeCanonical.bytesOf ↑proof ∧
        i.statement.tag = 2 ∧
          List.length i.statement.pubBytes = 1880 ∧
            75 + List.length i.statement.pubBytes ≤ AspisR1.SelectedTranscriptParams.L ∧
              ∀
                (history :
                  AspisR1.S2X.CheckpointVersionBinding written (AspisR1.MultiproofConeCanonical.bytesOf ↑checkpoint)),
                AspisR1.S2W_AuthenticatedInputs.P2Prime H proof pub proof2 pub2 →
                  (AspisV8R19.MemoizedProgramLaw.eval H (driver i)).2 = Bool.true ∧
                    ¬∀ (j : AspisR1.OraclePortStoredExperimentC4.Input),
                        (AspisV8R19.MemoizedProgramLaw.eval H (driver j)).2 = Bool.false
