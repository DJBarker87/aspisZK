def AspisR1.Rc4_Install.configuration : {F C : Type} →
  C →
    AspisR1.DrvC_Installation.Configuration F C →
      AspisR1.NP6_StdModel.Reservation → AspisR1.DrvC_Installation.Configuration F C :=
fun {F C} err c r => AspisR1.Rc3_Install.configuration (AspisR1.Rc4_Install.select err c) r
def AspisR1.SAQ_CompleteInstall.select : {F C : Type} →
  C → AspisR1.DrvC_Installation.Configuration F C → AspisR1.DrvC_Installation.Configuration F C :=
fun {F C} indexError c =>
  { adapter := c.adapter, currentBase := c.currentBase, stageBase := c.stageBase, finish := c.finish,
    reserved := c.reserved, query := AspisR1.SAQ_Decoder.install c.query,
    geometry := AspisR1.SAQ_Constructor.install indexError c.geometry, boundaries := c.boundaries, std := c.std }
@AspisR1.Rc4_Install.exact_scope : ∀ {F C : Type} (err : C) (c : AspisR1.DrvC_Installation.Configuration F C)
  (r : AspisR1.NP6_StdModel.Reservation),
  AspisR1.Rc4_Install.configuration err c r = AspisR1.Rc3_Install.configuration c r ↔
    AspisR1.SAQ_Decoder.install c.query = c.query ∧ AspisR1.SAQ_Constructor.install err c.geometry = c.geometry
@AspisR1.Rc4_Install.saq : ∀ {F C : Type} (err : C) (c : AspisR1.DrvC_Installation.Configuration F C)
  (r : AspisR1.NP6_StdModel.Reservation),
  AspisR1.Rc4_Install.configuration err c r =
    AspisR1.SAQ_CompleteInstall.configuration err
      { adapter := c.adapter, currentBase := c.currentBase, stageBase := c.stageBase, finish := c.finish,
        reserved := c.reserved, query := c.query, geometry := c.geometry,
        boundaries := AspisR1.F3M_CircleSource.install c.boundaries, std := c.std }
      r
@AspisR1.Rc4_Install.rc3 : ∀ {F C : Type} (err : C) (c : AspisR1.DrvC_Installation.Configuration F C)
  (r : AspisR1.NP6_StdModel.Reservation),
  AspisR1.Rc4_Install.configuration err c r =
    AspisR1.Rc3_Install.configuration (AspisR1.SAQ_CompleteInstall.select err c) r
