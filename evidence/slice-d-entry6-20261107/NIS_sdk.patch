+ AccountInfo::new(&keys[2],kani::any(),kani::any(),l2,b2,&owners[2],kani::any(),kani::any()),
+ AccountInfo::new(&keys[3],kani::any(),kani::any(),l3,b3,&owners[3],kani::any(),kani::any()),
+ AccountInfo::new(&keys[4],kani::any(),kani::any(),l4,b4,&owners[4],kani::any(),kani::any()),
+ AccountInfo::new(&keys[5],kani::any(),kani::any(),l5,b5,&owners[5],kani::any(),kani::any()),
+ AccountInfo::new(&keys[6],kani::any(),kani::any(),l6,b6,&owners[6],kani::any(),kani::any()),
+ ]);
+
+ let count=if SECOND{7}else{3};let accounts=&a[..count];
+ let base:usize=kani::any();kani::assume(base<=7-count);
+ let mut log=Log{n:base,account:kani::any(),first:kani::any(),second:kani::any()};let before=log;
+ if SECOND{second_cut(accounts,&mut log)}else{first_cut(accounts,&mut log)};
+ let (left,right)=if SECOND{match PORT{0=>(58295,58295),1=>(384,384),2=>(192,192),3=>(768,768),4=>(128,256),5=>(192,320),_=>(1768,1768)}}else{match PORT{0=>(58295,58295),1=>(1880,1880),_=>(1768,1768)}};
+ if wrong{log.first[base+PORT]^=1;}
+ assert!(log.n==base+count&&log.account[base+PORT]==&accounts[PORT] as *const AccountInfo<'_> as usize&&log.first[base+PORT]==left&&log.second[base+PORT]==right);
+ let j:usize=kani::any();kani::assume(j<7);
+ if j<base||j>=base+count{assert!(log.account[j]==before.account[j]&&log.first[j]==before.first[j]&&log.second[j]==before.second[j]);}
+}
