theorem NKE_RawAtSource.source : ∀ (reservation : AspisR1.NP6_StdModel.Reservation) {H : Type}
  (d : AspisR1Stage2.aspis_core.digest.Digest32 H) (ck proof pub : Aeneas.Std.Slice Aeneas.Std.U8)
  (v : NID_ResumeEmission.transport.Variant) (hash : H) (n : Aeneas.Std.Usize) (r : NID_ResumeEmission.verifier.Reader)
  (reply : Aeneas.Std.Result (Aeneas.Std.Array Aeneas.Std.U8 n × NID_ResumeEmission.verifier.Reader)),
  NJU_ResumeObserved.Event.raw n r reply ∈ (NJU_ResumeObserved.run reservation d ck proof pub v hash).events →
    ↑r.at + ↑n ≤ (↑r.bytes).length →
      ∃ b out,
        reply = Aeneas.Std.Result.ok (b, out) ∧
          ↑b = List.take (↑n) (List.drop ↑r.at ↑r.bytes) ∧ ↑out.at = ↑r.at + ↑n ∧ out.bytes = r.bytes :=
⋯
