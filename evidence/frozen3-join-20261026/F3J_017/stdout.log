          let s5 ← liftM (ok (Array.make 2#usize [s3, s4] ⋯).to_slice)
          let block ← Code.digest D c.before.hash s5 Code.done
          let s6 ← liftM (ok absorbed.to_slice)
          let s7 ← liftM (ok (Array.make 1#usize [2#u8] S1SemanticCode.sampleBlock._proof_13).to_slice)
          let s8 ← liftM (ok (Array.make 2#usize [s6, s7] ⋯).to_slice)
          let a ← Code.digest D c.before.hash s8 Code.done
          let i1 ← liftM (ok c.next)
          pure (core.result.Result.Ok block, { state := a, hash := c.before.hash, next_row := i1 })).1 =
    [(flatten (TranscriptStep.absorbParts c.before.state c.tag c.record.framed), decodeState c.absorbed),
