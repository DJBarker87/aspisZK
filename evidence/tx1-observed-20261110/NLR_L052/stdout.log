theorem AspisR1.NHL_PrepareDomain.reached : ∀ (base : AspisR1CurrentCaller.Ops) (reserved : Bool) {H : Type}
  (D : AspisR1CurrentCaller.aspis_core.digest.Digest32 H) (proof : Aeneas.Std.Slice Aeneas.Std.U8)
  (v : AspisR1CurrentCaller.verifier.View),
  (↑proof).length = 57607 →
    AspisR1.NHL_PrepareModel.Reaches base reserved D proof v →
      reserved = true ∧
        (↑v.semantic).length = 13831 ∧
          ∃ semantic y1,
            (↑semantic).length = 13831 ∧
              (↑y1).length = 928 ∧
                AspisR1CurrentCaller.InstalledPreparation.sourceView proof semantic y1 =
                    Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok v) ∧
                  v.semantic = semantic :=
