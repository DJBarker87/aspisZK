theorem AspisR1.NHS_PreparedPacket.source : ∀ (B : AspisR1PublicPreparation.FinishModel.Boundaries)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (pub : AspisR1PublicPreparation.pool_v1.pair_forest_semantic_terminal.r0.Public)
