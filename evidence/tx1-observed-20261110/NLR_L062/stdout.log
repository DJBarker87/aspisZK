'AspisR1.NLR_ObservedFinish.reached' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLR_ObservedFinish.reached : ∀ (F : S1SemanticCode.Finish) {H : Type} (D : aspis_core.Digest32 H)
  (pub : pool_v1.pair_forest_semantic_terminal.r0.Public) (bytes : Slice U8) (hash : H) (sem : r1_semantic.Verified H),
  (run (S1SemanticCode.verify (fun {H} => F) D pub bytes hash none)).2 = ok (core.result.Result.Ok sem) →
    ∃ p initial after c,
      PrefixAdapter.parseAccepted bytes = ok (core.result.Result.Ok p) ∧
        (run (S1SemanticCode.publicTranscript D pub hash p.c1_root)).2 = ok (core.result.Result.Ok initial) ∧
          (run (S1SemanticCode.begin D p initial)).2 = ok (core.result.Result.Ok c, after) ∧
            (run (F D pub p after c none)).2 = ok (core.result.Result.Ok sem) :=
⋯
