+fn begin_window<'a>(prefix:Prefix<'a>,transcript:&mut SemanticTranscript<Hash>,
+ after:SemanticTranscript<Hash>,reply:Result<Challenges,Error>)->Result<(Prefix<'a>,Challenges),Error>{
+ // Child begin writes its complete declared transcript footprint, even on Err.
+ *transcript=after;
+ let challenges=reply?;super::mark(None,1);Ok((prefix,challenges))
+}
