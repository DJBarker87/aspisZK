+fn NMD_actual_parse_caller(){let storage=NMD_Buffer{header:kani::any(),tail:kani::any()};let bytes=unsafe{core::slice::from_raw_parts(core::ptr::addr_of!(storage).cast::<u8>(),core::mem::size_of::<NMD_Buffer>())};let result=parse_shape(&bytes);assert_eq!(result,NMD_parse_ref(&bytes));}
