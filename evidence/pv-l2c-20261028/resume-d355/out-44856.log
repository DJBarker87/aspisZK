def Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice.index : {T : Type} →
  core.ops.range.Range Usize → Slice T → Result (Slice T) :=
fun {T} r s => if r.start ≤ r.end ∧ ↑r.end ≤ s.length then ok ⟨List.slice ↑r.start ↑r.end ↑s, ⋯⟩ else fail Error.panic
