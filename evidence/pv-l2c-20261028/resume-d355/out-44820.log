@[reducible] def Aeneas.Std.core.slice.index.Usize.index_mut : {T : Type} →
  Usize → Slice T → Result (T × (T → Slice T)) :=
fun {T} i s => s.index_mut_usize i
def Aeneas.Std.alloc.vec.Vec.index_mut : {T I Output : Type} →
  core.slice.index.SliceIndex I (Slice T) Output → alloc.vec.Vec T → I → Result (Output × (Output → alloc.vec.Vec T)) :=
fun {T I Output} inst self i => inst.index_mut i self
def Aeneas.Std.Slice.index_mut_usize.{u} : {α : Type u} → Slice α → Usize → Result (α × (α → Slice α)) :=
fun {α} v i => do
  let x ← v.index_usize i
  ok (x, v.set i)
def Aeneas.Std.Slice.set.{u} : {α : Type u} → Slice α → Usize → α → Slice α :=
fun {α} v i x => v.setAtNat (↑i) x

exit=0
