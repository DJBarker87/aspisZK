def Aeneas.Std.core.array.TryFromArrayCopySlice.try_from : {T : Type} →
  (N : Usize) →
    core.marker.Copy T → Slice T → Result (core.result.Result (Std.Array T N) core.array.TryFromSliceError) :=
fun {T} N _copyInst s =>
  if h0 : s.length = ↑N then Result.ok (core.result.Result.Ok ⟨↑s, ⋯⟩) else Result.ok (core.result.Result.Err ())
def Aeneas.Std.core.result.Result.unwrap : {T E : Type} → core.fmt.Debug E → core.result.Result T E → Result T :=
fun {T E} x e =>
  match e with
  | core.result.Result.Ok x => Result.ok x
  | core.result.Result.Err a => Result.fail Error.panic
def Aeneas.Std.Array.index_usize.{u} : {α : Type u} → {n : Usize} → Std.Array α n → Usize → Result α :=
fun {α} {n} v i =>
  match v[i]? with
  | none => Result.fail Error.arrayOutOfBounds
  | some x => Result.ok x
theorem Aeneas.Std.Array.index_usize_spec.{u} : ∀ {α : Type u} {n : Usize} (v : Std.Array α n) (i : Usize)
  (hbound : ↑i < v.length), v.index_usize i ⦃ x => x = (↑v)[↑i] ⦄ :=
fun {α} {n} v i hbound => Array.index_usize_spec._proof_1_5 v i hbound
