Aeneas.Std.UScalar.add_equiv._sparseCasesOn_1: {α : Type u} →
  {motive : Aeneas.Std.Result α → Sort u_1} →
    (t : Aeneas.Std.Result α) →
      ((v : α) → motive (Aeneas.Std.Result.ok v)) →
        ((e : Aeneas.Std.Error) → motive (Aeneas.Std.Result.fail e)) → (Nat.hasNotBit 3 t.ctorIdx → motive t) → motive t
Aeneas.Std.UScalar.add_equiv: ∀ {ty : Aeneas.Std.UScalarTy} (x y : Aeneas.Std.UScalar ty),
  match x + y with
  | Aeneas.Std.Result.ok z => ↑x + ↑y < 2 ^ ty.numBits ∧ ↑z = ↑x + ↑y ∧ z.bv = x.bv + y.bv
  | Aeneas.Std.Result.fail e => ¬Aeneas.Std.UScalar.inBounds ty (↑x + ↑y)
  | x => ⊥
