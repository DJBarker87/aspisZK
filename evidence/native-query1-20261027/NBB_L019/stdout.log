NBB_RowTrace.native_result (before out : Fin 4 → Aeneas.Std.U64) (power : S7Kani2OwnedRow.K) (basis : Aeneas.Std.U32)
  (terms : ℕ) (added : NBB_RowTrace.Row)
  (hc : ∀ (j : Fin 4), ↑(S7Kani2OwnedRowRefinement.powerLimb power j) < 2 ^ 31 - 1) (hb : ↑basis < 2 ^ 31 - 1)
  (hp : ∀ (j : Fin 4), NBB_Phase.Bound terms ↑(before j))
  (adds :
    NBB_RowTrace.Steps (fun j row => row j + ↑(S7Kani2OwnedRowRefinement.powerLimb power j) * ↑basis) [0, 1, 2, 3]
      (fun j => ↑(before j)) added)
  (folds :
    if decide (terms % 4 = 3) = true then
      NBB_RowTrace.Steps (fun j row => AspisV8R17.RawReducer.foldBits (row j)) [0, 1, 2, 3] added fun j => ↑(out j)
    else (fun j => ↑(out j)) = added) :
  S7Kani2OwnedRow.residue_owned (S7Kani2OwnedRowRefinement.makeRow before) power basis (decide (terms % 4 = 3)) =
    Aeneas.Std.Result.ok (S7Kani2OwnedRowRefinement.makeRow out)
NBB_RowWitness.construct (before : Fin 4 → Aeneas.Std.U64) (power : S7Kani2OwnedRow.K) (basis : Aeneas.Std.U32)
  (terms : ℕ) (hc : ∀ (j : Fin 4), ↑(S7Kani2OwnedRowRefinement.powerLimb power j) < 2 ^ 31 - 1)
  (hb : ↑basis < 2 ^ 31 - 1) (hp : ∀ (j : Fin 4), NBB_Phase.Bound terms ↑(before j)) :
  ∃ added out,
    NBB_RowTrace.Steps (fun j row => row j + ↑(S7Kani2OwnedRowRefinement.powerLimb power j) * ↑basis) [0, 1, 2, 3]
        (fun j => ↑(before j)) added ∧
      (if decide (terms % 4 = 3) = true then
          NBB_RowTrace.Steps (fun j row => AspisV8R17.RawReducer.foldBits (row j)) [0, 1, 2, 3] added fun j => ↑(out j)
        else (fun j => ↑(out j)) = added) ∧
        S7Kani2OwnedRow.residue_owned (S7Kani2OwnedRowRefinement.makeRow before) power basis (decide (terms % 4 = 3)) =
          Aeneas.Std.Result.ok (S7Kani2OwnedRowRefinement.makeRow out)
NBB_QueryWitness.direct (ops : AspisR1.Port3_NativeQueryBody.Ops) (proof : Aeneas.Std.Slice Aeneas.Std.U8)
  (p : AspisR1Stage2.verifier.Prepared)
  (g : Aeneas.Std.Array AspisR1Stage2.aspis_core.field.wide_exact.WideExact 29#usize)
  (obs : Option (AspisR1Stage2.verifier.Phase → Aeneas.Std.Result Unit)) (geo : AspisR1Stage2.verifier.QueryGeometry)
  (end1 : Aeneas.Std.Usize) (a : NBB_QueryTrace.Acc) (b : NBB_QueryTrace.BW) :
  ∃ out,
    NBB_QueryTrace.Trace
        (fun a b => AspisR1.Port3_NativeQueryBody.verifier.candidate.query_values ops proof p a g obs geo b) (↑end1)
        (Aeneas.Std.core.result.Result.Ok (a, b)) out ∧
      AspisR1.Port3_NativeQueryBody.verifier.candidate.query_loop ops proof p a g obs geo b end1 = out
NBB_Finish.source (b : AspisR1.Port3_FlushInstall.BW) (old : Aeneas.Std.Slice AspisR1.Port3_FlushInstall.K)
  (raw64 : (↑b.raw).length = 64) (old64 : (↑old).length = 64) :
  ∃ out,
    AspisR1.Port3_FlushInstall.flush b old = Aeneas.Std.Result.ok out ∧
      (↑out).length = 64 ∧
        ↑out =
            List.map
              (fun row =>
                AspisR1.Port3_FlushInstall.fromMutable
                  (S8Kani2FinishReferenceJoin.toFinish (S8OwnedP6Finish.modelValue row)))
              (List.take 64 ↑b.raw) ∧
          ∀ q ∈ ↑out, AspisR1.Port3_FlushInstall.Canonical q
