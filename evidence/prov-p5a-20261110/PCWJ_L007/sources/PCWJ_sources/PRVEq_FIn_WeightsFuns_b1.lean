  (variant : FInVariant) (alpha : Array field.QM31 10#usize)
  (z : Array circle.SecureCirclePoint 2#usize) :
  Result (core.result.Result Weights FInError)
  := do
  let points ← state_only_prefix.r0.statement_points alpha
  let q ← Array.index_usize alpha 8#usize
  let q1 ← Array.index_usize alpha 9#usize
  let q2 ← field.QM31.ZERO
  let a := Array.repeat 4#usize q2
  let a1 := Array.repeat 5#usize a
  let factors := Array.repeat 5#usize a1
  let factors1 ←
    weights_new_loop0 { start := 0#usize, «end» := 3#usize } points
      factors
  let factors2 ←
    weights_new_loop1 { start := 0#usize, «end» := 2#usize } z
      factors1
  let w ←
    Weights.box_from_parts variant factors2 points
      (Array.make 2#usize [ q, q1 ])
  ok (core.result.Result.Ok w)

end PRVFresh_FIn_WeightsFuns
