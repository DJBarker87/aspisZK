  {s final : AspisR1.NHK_NativeWords.State} {pending : Option Bool},
  AspisR1.NHK_NativeWords.Cuts cursor xs s final last pending →
    AspisR1.NHB_WordTrace.Trace cursor xs s final last pending :=
fun {cursor last} {xs} {s final} {pending} cuts =>
  AspisR1.NHK_NativeWords.Cuts.rec (fun cursor s => AspisR1.NHB_WordTrace.Trace.exhausted cursor s)
    (fun cursor last x xs s after reply full windows =>
      let ⟨left✝, right✝⟩ := AspisR1.NHK_WordAssociation.stopped_post s after x cursor last true reply full windows
      let ⟨hc, ha⟩ := right✝
      Eq.ndrec (motive := fun after =>
        (∀ (j : Fin 22),
            AspisR1.NHB_Observation.observe after x last true j = AspisR1.NHK_WordAssociation.G s x cursor reply j) →
          AspisR1.NHB_WordTrace.Trace cursor (x :: xs) s after last none)
        (fun windows =>
          Eq.ndrec (motive := fun last =>
            (∀ (j : Fin 22),
                AspisR1.NHB_Observation.observe s x last true j = AspisR1.NHK_WordAssociation.G s x cursor reply j) →
              AspisR1.NHB_WordTrace.Trace cursor (x :: xs) s s last none)
            (fun windows =>
              have hfull :=
                Or.casesOn full (fun hn => Or.inl (Aeneas.Std.UScalar.eq_of_val_eq hn)) fun hd =>
                  Or.inr (Aeneas.Std.UScalar.eq_of_val_eq hd);
              AspisR1.NHB_WordTrace.Trace.stopped cursor x xs s hfull)
            (Eq.symm hc) windows)
        (Eq.symm ha) windows)
    (fun cursor nextCursor last x xs s after final pending reply hlen hdraw value windows tail ih =>
      have observed := fun j => Eq.trans (windows j) (AspisR1.NHK_WordAssociation.substitute s x cursor reply value j);
      let ⟨left✝¹, right✝¹⟩ :=
        AspisR1.NHB_Observation.continuing_frame s after x cursor nextCursor false hlen hdraw observed
      let ⟨hc, frame⟩ := right✝¹
      Eq.ndrec (motive := fun nextCursor =>
        (∀ (j : Fin 22),
            AspisR1.NHB_Observation.observe after x nextCursor false j =
              AspisR1.NHK_WordAssociation.G s x cursor reply j) →
          AspisR1.NHK_NativeWords.Cuts nextCursor xs after final last pending →
            AspisR1.NHB_WordTrace.Trace nextCursor xs after final last pending →
              AspisR1.NHB_Observation.Relation s after x cursor nextCursor false →
                AspisR1.NHB_WordTrace.Trace cursor (x :: xs) s final last pending)
        (fun windows tail ih observed =>
          AspisR1.NHB_WordTrace.Trace.continuing cursor x xs s after final last pending hlen hdraw frame ih)
        (Eq.symm hc) windows tail ih observed)
    cuts
