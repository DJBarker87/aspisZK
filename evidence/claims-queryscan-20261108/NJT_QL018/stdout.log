initial_scan : ∀ (native : NJT_QScan.Native),
  NJT_QScan.Cut native →
    ∀ (b : Bytes),
      Query31ModelScanCall.modelScanFn Query31ConcreteWordsDriverChain.actualQueryWords NGQ_SamplerPacket.initial b =
        ok
          (optionStop (NJT_QScan.run native (↑(words b)) NGQ_SamplerPacket.initial).2,
            (NJT_QScan.run native (↑(words b)) NGQ_SamplerPacket.initial).1)
