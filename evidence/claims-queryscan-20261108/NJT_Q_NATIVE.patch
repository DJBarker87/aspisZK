+mod NJT_Q_rank {
+ use super::*;
+ #[kani::proof]
+ #[kani::unwind(34)]
+ #[kani::stub(core::ptr::copy_nonoverlapping,crate::KMX_stubs::KMX_copy_nonoverlapping)]
+ fn NJT_Q_block_rank() {
+  let block: [u8;32] = kani::any();
+  let k: usize = kani::any(); kani::assume(k<8);
+  let out=block_rank(&block);
+  let j=4*k;
+  let expected=(block[j] as u32)|((block[j+1] as u32)<<8)|((block[j+2] as u32)<<16)|((block[j+3] as u32)<<24);
+  #[cfg(not(NJT_Q_invert))] assert!(out[k]==expected);
+  #[cfg(NJT_Q_invert)] assert!(out[k]==(expected^1));
+ }
