+// Borrow-minimal safe reference; three rows are values before allocation.
+pub fn NJT_claims_ref(prefix: &Prefix<'_>) -> Result<Box<[[[QM31; 29]; 3]]>, Error> {
+    let record = prefix.validated_record(25)?;
+    let row0 = record.decode_k::<29>(0)?;
+    let row1 = record.decode_k::<29>(29)?;
+    let row2 = record.decode_k::<29>(58)?;
+    let value = [row0, row1, row2];
+    let out = aspis_core::r0::heap::filled(1, value)
+        .map_err(|_| Error::Allocation)?;
+    Ok(out.into_boxed_slice())
+}
+
+#[cfg(kani)] pub mod NJT_claims_carrier {
+ use super::*;
+ use aspis_core::field::{CM31,M31};
+ type Claims=[[QM31;29];3];
+ fn q()->QM31{QM31{c0:CM31{a:M31(kani::any()),b:M31(kani::any())},c1:CM31{a:M31(kani::any()),b:M31(kani::any())}}}
+ // Safe reference's allocation and ownership phase, split from data windows.
+ // Payload is unrestricted. No content assertion or second native data write.
+ pub fn check(mode:u8){
+  let payload:Claims=core::array::from_fn(|_|core::array::from_fn(|_|q()));
+  let out=aspis_core::r0::heap::filled(1,payload).unwrap();
+  assert_eq!(out.len(),1);
+  let original=out.as_ptr();
+  let boxed=out.into_boxed_slice();
+  if mode==1{assert_eq!(boxed.len(),2);}else{assert_eq!(boxed.len(),1);}
+  if mode==2{
+   let other=aspis_core::r0::heap::filled(1,payload).unwrap().into_boxed_slice();
+   assert_eq!(other.as_ptr(),original);
+  }else{assert_eq!(boxed.as_ptr(),original);}
+ }
+}
+
+#[cfg(kani)] pub mod NJT_resize_window {
+ use super::*;
+ use alloc::vec::Vec;
+ use aspis_core::field::{CM31,M31};
+ type Claims=[[QM31;29];3];
+ fn q()->QM31{QM31{c0:CM31{a:M31(kani::any()),b:M31(kani::any())},c1:CM31{a:M31(kani::any()),b:M31(kani::any())}}}
+ fn native(out:&mut Vec<Claims>,value:Claims){out.resize(1,value);}
+ pub fn check(negative:bool){
+  let value:Claims=core::array::from_fn(|_|core::array::from_fn(|_|q()));
+  let offset:usize=kani::any();kani::assume(offset<348);
+  let expected=unsafe{value.as_ptr().cast::<u32>().add(offset).read()};
+  let mut out:Vec<Claims>=Vec::new();out.try_reserve_exact(1).unwrap();
+  // Data cut starts here: reserve finished, len0 and cap>=1. Exactly ONE
+  // native resize/push iteration. Allocation identity is a separate cut.
+  native(&mut out,value);
+  assert_eq!(out.len(),1);
+  let got=unsafe{out[0].as_ptr().cast::<u32>().add(offset).read()};
+  if negative{assert_eq!(got,expected^1);}else{assert_eq!(got,expected);}
+ }
+}
