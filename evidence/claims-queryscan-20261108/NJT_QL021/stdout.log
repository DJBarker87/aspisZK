'AspisR1.NJT_QPairs.walk_source' depends on axioms: [propext, Classical.choice, Quot.sound]
'AspisR1.NJT_QPairs.reference' depends on axioms: [propext, Classical.choice, Quot.sound]
reference : ∀ (native : NJT_QScan.Native),
  NJT_QScan.Cut native →
    ∀ (blocks advances : Blocks),
      AspisR1Query31Transcript.queries_from_pairs_with_scan NGQ_SamplerPacket.Scan NGQ_SamplerPacket.initial blocks
          advances =
        NGQ_SamplerDriver.walk (nativeScan native) advances 7#usize
          ((↑blocks).zip [0#usize, 1#usize, 2#usize, 3#usize, 4#usize, 5#usize, 6#usize, 7#usize])
          NGQ_SamplerPacket.initial
