def AspisR1.OraclePortStdAllocation.filled : {T : Type} →
  Usize → T → Bool → Result (Except OraclePortStdAllocation.AllocationError (alloc.vec.Vec T)) :=
fun {T} n value reserved =>
  if reserved = true then do
    let v ← OraclePortCkptAbi2Vec.appendModel (alloc.vec.Vec.new T) (List.replicate (↑n) value)
    ok (Except.ok v)
  else ok (Except.error OraclePortStdAllocation.AllocationError.allocation)
