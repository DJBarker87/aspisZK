                      Eq.mpr (id (congrFun' (congrArg LE.le List.length_replicate) Usize.max))
                        (CheckpointBytes3Allocation.filled_exact._proof_1 n)⟩))
                (ok (core.result.Result.Err AspisR1Stage2.verifier.Error.Allocation)) Bool.false_eq_true))
