def NMB_Stage1Source.G : NMB_Input.Input →
  AdapterRw.Ops → Key → Slice U8 → Result Unit → Result Unit → Result Unit → Run :=
fun x ops p d alloc0 alloc1 alloc2 =>
  have snapshots := NMB_ThreeSnapshots.G x alloc0 alloc1 alloc2;
