AspisR1.JHn_ExactReturned.source : ∀ (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8),
  AspisR1CurrentCaller.verifier.candidate.tx1 AspisR1.JGr_Geometry.installed AspisR1.JGr_Geometry.digest
        (AspisR1CurrentCaller.FirstComposition.toCurrentPublic AspisR1.JFs_PublicSerialization.value)
        AspisR1.JFx_NativeBytes.publicInput AspisR1.JFx_NativeBytes.proof 10#usize () none =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok saved) →
    ↑saved = ↑AspisR1.JFx_NativeBytes.checkpoint
AspisR1.JHn_NonVacuity.source : ∃ saved,
  ↑saved = ↑AspisR1.JFx_NativeBytes.checkpoint ∧
    (↑saved).length = 1768 ∧
      ∃ p a,
        AspisR1.JGr_Geometry.installed.op16 AspisR1.JGr_Geometry.digest p a AspisR1.JFx_NativeBytes.proof
