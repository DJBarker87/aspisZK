+ kani::assume(sums[6]<=n*4611686009837453316&&p[6]<=4611686009837453316);
+ kani::assume(sums[7]<=n*4611686009837453316&&p[7]<=4611686009837453316);
+ sums[0]+=p[0];
+ sums[1]+=p[1];
+ sums[2]+=p[2];
