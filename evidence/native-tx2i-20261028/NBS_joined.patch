+ assert!(sums[1]==before[1]+p[1]);assert!(sums[1]<18446744073709551615);
+ assert!(sums[2]==before[2]+p[2]);assert!(sums[2]<18446744073709551615);
+ assert!(sums[3]==before[3]+p[3]);assert!(sums[3]<18446744073709551615);
+ assert!(sums[4]==before[4]+p[4]);assert!(sums[4]<18446744073709551615);
