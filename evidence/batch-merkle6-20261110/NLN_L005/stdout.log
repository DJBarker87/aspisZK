theorem NLN_AdoptedFold.source : ∀ (H : Bytes → State) (proof : Slice U8) (p : OraclePortCompactDraft.Parsed)
  (raw : Std.Array U32 22#usize) (batch : Usize) (sites : List Call),
  (∀ c ∈ sites, NLN.TreePacket H proof p raw c.1 batch c.2) →
    ∀ (idx : Indices) (val : Values) (history : History) (out : Reply),
      Calls H proof raw batch sites idx val history out →
        NLL_ObservedCalls.calls H proof p raw batch sites idx val = (history, NKV_ParentSource.observe (ok out)) :=
⋯
'NLN_AdoptedFold.source' depends on axioms: [propext, Classical.choice, Quot.sound]
