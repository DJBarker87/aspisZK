theorem NLN_AdoptedAbortFold.source : ∀ (H : Bytes → State) (proof : Slice U8) (p : OraclePortCompactDraft.Parsed)
  (raw : Std.Array U32 22#usize) (batch : Usize) (sites : List Call),
  (∀ c ∈ sites, NLN.TreePacket H proof p raw c.1 batch c.2) →
    ∀ (idx : Indices) (val : Values) (history : History) (pending : Pending),
      AbortCalls H proof raw batch sites idx val history pending →
        NLL_Prefix.At (NLL_ObservedCalls.calls H proof p raw batch sites idx val).1 (history ++ pending.answered)
          pending.parts :=
⋯
'NLN_AdoptedAbortFold.source' depends on axioms: [propext, Classical.choice, Quot.sound]
