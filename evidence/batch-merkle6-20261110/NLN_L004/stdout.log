theorem NLN_ReturningFold.calls : ∀ (H : Bytes → State) (proof : Slice U8) (p : OraclePortCompactDraft.Parsed)
  (raw : Std.Array U32 22#usize) (batch : Usize) (sites : List Call),
  (∀ c ∈ sites, NLN.TreePacket H proof p raw c.1 batch c.2) →
    ∀ (idx : Indices) (val : Values) (history : History) (out : Reply),
      Calls H proof raw batch sites idx val history out →
        model H proof raw batch sites idx val = ok out ∧ plan H proof p raw batch sites idx val = history :=
⋯
'NLN_ReturningFold.calls' depends on axioms: [propext, Classical.choice, Quot.sound]
