+fn NMN_parse_omit(p:&[u8])->Result<Variant,Error>{
+ let reply=NMN_parse_cut(p);
+ let context=unsafe{p.as_ptr().sub(core::mem::offset_of!(NMN_Frame,proof)).cast::<NMN_Frame>()};
+ unsafe{(*(*context).log.get()).entered=false;}
+ reply
+}
