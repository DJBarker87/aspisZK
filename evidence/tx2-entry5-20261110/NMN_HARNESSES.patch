+#[derive(Clone,Copy)]
+struct NMN_ParseLog { entered:bool,ptr:*const u8,len:usize,tag:u8 }
+#[repr(C)]
+struct NMN_Proof { header:[u8;16],root:[u8;32],suffix:[u8;57559] }
+#[repr(C)]
+struct NMN_Frame { log:UnsafeCell<NMN_ParseLog>,proof:NMN_Proof }
+#[derive(Clone,Copy)]
+struct NMN_CommonLog { entered:bool,ptr:[*const u8;3],len:[usize;3],tag:u8,omit:bool,stop:bool }
+#[derive(Clone,Copy)]
+struct NMN_Hash<'a>(&'a RefCell<NMN_CommonLog>);
+fn NMN_error(t:u8)->Error {match t {0=>Error::Parse,1=>Error::Semantic,2=>Error::Transcript,
+ 3=>Error::Relation,4=>Error::Merkle,5=>Error::Query,6=>Error::Checkpoint,_=>Error::Allocation}}
+fn NMN_reply(t:u8)->Result<(),Error>{if t==0{Ok(())}else{Err(NMN_error(t-1))}}
+impl aspis_core::Digest32 for NMN_Hash<'_> {
+ fn digest(&self,parts:&[&[u8]])->[u8;32] {
+  assert_eq!(parts.len(),3);let tag:u8=kani::any();kani::assume(tag<9);
+  let omit=self.0.borrow().omit;let stop=self.0.borrow().stop;
+  if !omit {*self.0.borrow_mut()=NMN_CommonLog{entered:true,
+   ptr:[parts[0].as_ptr(),parts[1].as_ptr(),parts[2].as_ptr()],
+   len:[parts[0].len(),parts[1].len(),parts[2].len()],tag,omit,stop};}
+  let mut result=[0;32];result[0]=tag;result[1]=u8::from(stop);result
+ }
+}
+fn NMN_parse_cut(p:&[u8])->Result<Variant,Error>{
+ // Both candidate inputs are subobjects of valid NMN_Frame allocations.
+ let context=unsafe{p.as_ptr().sub(core::mem::offset_of!(NMN_Frame,proof)).cast::<NMN_Frame>()};
+ let tag:u8=kani::any();kani::assume(tag<11);
+ unsafe{*(*context).log.get()=NMN_ParseLog{entered:true,ptr:p.as_ptr(),len:p.len(),tag};}
+ match tag {0=>Ok(Variant::S1),1=>Ok(Variant::S2),2=>Ok(Variant::D),_=>Err(NMN_error(tag-3))}
+}
+fn NMN_marker_cut(_obs:Observer,p:Phase){assert!(matches!(p,Phase::Parsed));}
+fn NMN_common_cut<H:aspis_core::Digest32>(public:&[u8],proof:&[u8],ck:&[u8],hash:H,_obs:Observer)->Result<(),Error>{
+ let reply=hash.digest(&[public,proof,ck]);
+ if reply[1]!=0{panic!("stopped common: ordered prefix only");}
+ NMN_reply(reply[0])
+}
+fn NMN_common_wrong<H:aspis_core::Digest32>(public:&[u8],proof:&[u8],ck:&[u8],hash:H,_obs:Observer)->Result<(),Error>{
+ let tag=hash.digest(&[public,proof,ck])[0];NMN_reply((tag+1)%9)
+}
+fn NMN_parent<const SUCCESS:bool,const MUTANT:bool,const OMIT:bool,const IGNORE:bool,const STOP:bool>(){
+ let public:[u8;1880]=kani::any();let checkpoint:[u8;1768]=kani::any();
+ let seed=NMN_ParseLog{entered:false,ptr:core::ptr::null(),len:0,tag:0};
+ let frame=NMN_Frame{log:UnsafeCell::new(seed),proof:NMN_Proof{header:kani::any(),root:kani::any(),suffix:kani::any()}};
+ let alternate=NMN_Frame{log:UnsafeCell::new(seed),proof:NMN_Proof{header:kani::any(),root:kani::any(),suffix:kani::any()}};
+ let proof=unsafe{core::slice::from_raw_parts((&frame.proof as *const NMN_Proof).cast::<u8>(),57607)};
+ let other=unsafe{core::slice::from_raw_parts((&alternate.proof as *const NMN_Proof).cast::<u8>(),57607)};
+ let n:usize=kani::any();kani::assume(n<=1880);let pub_=&public[..n];
+ let log=RefCell::new(NMN_CommonLog{entered:false,ptr:[core::ptr::null();3],len:[0;3],tag:0,omit:OMIT,stop:STOP});
+ let result=tx2_authenticated(pub_,if MUTANT{other}else{proof},&checkpoint,NMN_Hash(&log),None);
+ let parsed=unsafe{*frame.log.get()};let common=*log.borrow();
+ let actual_parsed=if MUTANT{unsafe{*alternate.log.get()}}else{parsed};
+ kani::assume((actual_parsed.tag<3)==SUCCESS);
+ assert!(parsed.entered,"parse write coverage");assert_eq!(parsed.ptr,proof.as_ptr(),"parse argument");assert_eq!(parsed.len,proof.len());
+ if SUCCESS {
+  assert!(common.entered,"common log write coverage");
+  assert_eq!(common.ptr[0],pub_.as_ptr());assert_eq!(common.ptr[1],proof.as_ptr());assert_eq!(common.ptr[2],checkpoint.as_ptr());
+  assert_eq!(common.len[0],pub_.len());assert_eq!(common.len[1],proof.len());assert_eq!(common.len[2],checkpoint.len());
+  assert_eq!(result,if IGNORE{Ok(())}else{NMN_reply(common.tag)},"complete returned Result");
+ }else{
+  assert!(!common.entered);assert_eq!(result,if IGNORE{Err(Error::Parse)}else{Err(NMN_error(parsed.tag-3))},"parser error propagation");
+ }
+ // Separate frame obligation: the scalar forwarding cut performs no arbitrary whole-buffer read.
+}
