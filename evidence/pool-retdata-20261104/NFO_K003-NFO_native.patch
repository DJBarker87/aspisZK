+use super::*;
+use aspis_core::field::M31;
+use aspis_statement::pool_v1::*;
+fn digest()->aspis_statement::Digest{core::array::from_fn(|_|M31(kani::any()))}
+fn result()->PoolV1PairForestTerminalResultV1{PoolV1PairForestTerminalResultV1{
+ transition_kind:if kani::any(){PoolV1TransitionKind::PrivateTransfer}else{PoolV1TransitionKind::Withdrawal},
+ master_account:kani::any(),selected_lane_account:kani::any(),output_lane:kani::any(),nullifier:digest(),
+ verified_afterstate:PoolV1PairVerifiedAfterstateV1{next_pair_index:kani::any(),next_root:digest(),next_frontier:[digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest()]}}}
+struct Runtime {calls:u8,cpi_ok:bool,returned:Option<(Pubkey,Vec<u8>)>,instruction:*const Instruction,infos:*const AccountInfo<'static>}
+impl PairForestVerifierRuntimeV1 for Runtime{
+ fn clear_return_data(&mut self){assert!(self.calls==0);self.calls=1;}
+ fn invoke(&mut self,instruction:&Instruction,infos:&[AccountInfo<'_>])->ProgramResult{
+  assert!(self.calls==1&&core::ptr::eq(instruction,self.instruction));assert!(infos.is_empty());self.calls=2;
+  if self.cpi_ok {Ok(())}else{Err(ProgramError::InvalidArgument)}
+ }
+ fn get_return_data(&mut self)->Option<(Pubkey,Vec<u8>)>{assert!(self.calls==2);self.calls=3;self.returned.take()}
+}
+struct Frame{calls:u8,ptr:*const u8,j:usize,byte:u8,ok:bool,reply:PoolV1PairForestTerminalResultV1}
+fn decode(bytes:&[u8],f:&mut Frame)->Result<PoolV1PairForestTerminalResultV1,PoolV1PairForestTerminalFormatErrorV1>{
+ assert!(f.calls==0&&bytes.len()==792&&core::ptr::eq(bytes.as_ptr(),f.ptr)&&bytes[f.j]==f.byte);f.calls=1;
+ if f.ok {Ok(f.reply)}else{Err(PoolV1PairForestTerminalFormatErrorV1::WrongMagic)}
+}
+fn native(selected:Pubkey,instruction:&Instruction,infos:&[AccountInfo<'_>],runtime:&mut Runtime,frame:&mut Frame)->Result<AuthenticatedPairForestResultV1,ProgramError>{
+    runtime.clear_return_data();
+    runtime.invoke(&instruction, &infos)?;
+    let (returned_program, returned_data) = runtime
+        .get_return_data()
+        .ok_or(PoolV1ProgramError::MissingVerifierReturnData)?;
+    if returned_program != selected {
+        return Err(PoolV1ProgramError::InvalidVerifierReturnProgram.into());
+    }
+    if returned_data.len() != POOL_V1_PAIR_FOREST_TERMINAL_RESULT_BYTES {
+        return Err(PoolV1ProgramError::InvalidVerifierReturnData.into());
+    }
+    let result = decode(&returned_data,frame)
+        .map_err(|_| PoolV1ProgramError::InvalidVerifierReturnData)?;
+    Ok(AuthenticatedPairForestResultV1 {
+        value: Box::new(result),
+        exact_bytes: returned_data.into_boxed_slice(),
+    })
+}
+#[kani::proof]
+#[kani::unwind(18)]
+#[kani::stub(core::ptr::copy_nonoverlapping,crate::NFO_KMX::KMX_copy_nonoverlapping)]
+#[kani::stub(<[u8]>::copy_from_slice,crate::NFO_KMX::KMX_copy_from_slice)]
+fn association(){
+ let selected=Pubkey::new_from_array(kani::any());let returned_program=Pubkey::new_from_array(kani::any());
+ let raw:[u8;792]=kani::any();let j:usize=kani::any();kani::assume(j<792);
+ let boxdata:Box<[u8]>=Box::new(raw);let data=boxdata.into_vec();let ptr=data.as_ptr();let byte=data[j];
+ let present:bool=kani::any();let cpi_ok:bool=kani::any();let decode_ok:bool=kani::any();let reply=result();
+ let instruction=Instruction{program_id:selected,accounts:Vec::new(),data:Vec::new()};
+ let mut runtime=Runtime{calls:0,cpi_ok,returned:if present{Some((returned_program,data))}else{None},instruction:&instruction,infos:core::ptr::null()};
+ let mut frame=Frame{calls:0,ptr,j,byte,ok:decode_ok,reply};
+ let actual=native(selected,&instruction,&[],&mut runtime,&mut frame);
+ if !cpi_ok {assert!(runtime.calls==2&&frame.calls==0&&matches!(actual,Err(ProgramError::InvalidArgument)));}
+ else if !present {assert!(runtime.calls==3&&frame.calls==0&&matches!(actual,Err(e) if e==PoolV1ProgramError::MissingVerifierReturnData.into()));}
+ else if returned_program!=selected {assert!(runtime.calls==3&&frame.calls==0&&matches!(actual,Err(e) if e==PoolV1ProgramError::InvalidVerifierReturnProgram.into()));}
+ else if !decode_ok {assert!(runtime.calls==3&&frame.calls==1&&matches!(actual,Err(e) if e==PoolV1ProgramError::InvalidVerifierReturnData.into()));}
+ else {let a=actual.unwrap();assert!(runtime.calls==3&&frame.calls==1&&*a.value()==reply);assert!(a.exact_bytes().len()==792&&a.exact_bytes()[j]==byte&&core::ptr::eq(a.exact_bytes().as_ptr(),ptr));}
+}
