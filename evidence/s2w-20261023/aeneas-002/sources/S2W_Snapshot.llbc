":{"Signed":["Isize","21"]}}},{"id":22,"span":{"data":{"file_id":6,"beg":{"line":59,"col":4},"end":{"line":59,"col":23}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"InvalidAccountOwner","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","22"]}}},{"id":23,"span":{"data":{"file_id":6,"beg":{"line":60,"col":4},"end":{"line":60,"col":22}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"ArithmeticOverflow","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","23"]}}},{"id":24,"span":{"data":{"file_id":6,"beg":{"line":61,"col":4},"end":{"line":61,"col":13}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"Immutable","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","24"]}}},{"id":25,"span":{"data":{"file_id":6,"beg":{"line":62,"col":4},"end":{"line":62,"col":22}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"IncorrectAuthority","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","25"]}}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Branch":{"offset":0,"int_ty":{"Unsigned":"U64"},"children":[[{"start":{"Unsigned":["U64","9223372036854775808"]},"end":{"Unsigned":["U64","9223372036854775833"]}},{"Branch":{"offset":0,"int_ty":{"Unsigned":"U64"},"children":[[{"start":{"Unsigned":["U64","9223372036854775808"]},"end":{"Unsigned":["U64","9223372036854775808"]}},{"Known":0}],[{"start":{"Unsigned":["U64","9223372036854775809"]},"end":{"Unsigned":["U64","9223372036854775809"]}},{"Known":1}],[{"start":{"Unsigned":["U64","9223372036854775810"]},"end":{"Unsigned":["U64","9223372036854775810"]}},{"Known":2}],[{"start":{"Unsigned":["U64","9223372036854775811"]},"end":{"Unsigned":["U64","9223372036854775811"]}},{"Known":3}],[{"start":{"Unsigned":["U64","9223372036854775812"]},"end":{