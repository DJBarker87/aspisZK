{"charon_version":"0.1.223","translated":{"crate_name":"aspis_r1_cost_probe_program","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::r1_pool_adapter::owned::snapshot"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["crate::observer","aspis_statement::pool_v1::pair_forest_terminal::PoolV1PairForestTerminalStatementV1","aspis_statement::pool_v1::pair_forest_terminal::PoolV1PairForestTerminalCommonV1","aspis_statement::pool_v1::pair_terminal::PoolV1PairVerifiedAfterstateV1","aspis_statement::pool_v1::pair_forest_terminal::_::common","aspis_statement::pool_v1::pair_forest_terminal::_::semantic_public","aspis_statement::pool_v1::pair_forest_semantic_terminal::r0::Public","aspis_r1_cost_probe::verifier::Error","aspis_r1_cost_probe::verifier::Phase","aspis_r1_cost_probe::transport::Variant","aspis_r1_cost_probe::transport::_::tag","core::option::Option","core::result::Result","core::result::_::map_err","solana_program_error::ProgramError","aspis_statement::pool_v1::pair_tree_profile::PoolV1PairLatePublicStatementV1","aspis_statement::pool_v1::pair_tree_profile::PoolV1PairLiveSnapshotV1","aspis_statement::pool_v1::payment_relation::PoolV1PrivateTransferPublicV1","aspis_statement::pool_v1::payment_relation::PoolV1WithdrawalPublicV1","aspis_core::field::M31","aspis_core::field::CM31","aspis_core::field::QM31","crate::SolanaDigest","aspis_statement::pool_v1::pair_forest_terminal::PoolV1PairForestTerminalFormatErrorV1","aspis_statement::pool_v1::pair_terminal::PoolV1PairVerifierTransportErrorV1","aspis_statement::pool_v1::pair_forest_accounts::PoolV1PairForestAccountErrorV1","aspis_statement::pool_v1::payment_relation::PoolV1PaymentStatementFormatError","aspis_statement::pool_v1::pair_tree_profile::PoolV1PairLatePublicStatementErrorV1","aspis_statement::pool_v1::pair_tree_profile::PoolV1Pair