More calls may or may not return `None`. Here, they always will."},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"next"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10698}],"output":{"HashConsedValue":[10737,{"Adt":{"id":{"Adt":10},"generics":{"regions":[],"types":[{"Deduplicated":10639}],"const_generics":[],"trait_refs":[]}}}]}},"default":null},"kind":{"TraitMethod":[34,0]}},null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],"vtable":{"id":{"Adt":32},"generics":{"regions":[],"types":[{"Deduplicated":10639}],"const_generics":[],"trait_refs":[]}}},{"def_id":35,"item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["de",0]},{"Ident":["Expected",0]}],"span":{"data":{"file_id":47,"beg":{"line":484,"col":0},"end":{"line":484,"col":18}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Expected` represents an explanation of what data a `Visitor` was expecting"},{"DocComment":" to receive."},{"DocComment":""},{"DocComment":" This is used as an argument to the `invalid_type`, `invalid_value`, and"},{"DocComment":" `invalid_length` methods of the `Error` trait to build error messages. The"},{"DocComment":" message should be a noun or noun phrase that completes the sentence \"This"},{"DocComment":" Visitor expects to receive ...\", for example the message could be \"an"},{"DocComment":" integer between 0 and 64\". The message should not be capitalized and should"},{"DocComment":" not end with a period."},{"DocComment":""},{"DocComment":" Within the context of a `Visitor` implementation, the `Visitor` itself"},{"DocComment":" (`&self`) is an implementation of this trait."},{"DocComment":""},{"DocComment":" ```edition2021"},{"DocComment":" # use serde::de::{self, Unexpected, Visitor};"},{"DocComment":" # use std::fmt;"},{"DocComment":" #"},{"DocComment":" # struct Example;"},{"DocComment":" #"},{"DocComment":" # impl<'de> Visitor<'de> for Example {"},{"DocComment":" #     type Value = ();"},{"DocComment":" #"},{"DocComment":" #     fn expecting(&self, formatter: &mut fmt::Formatter) -> fmt::Result {"},{"DocComment":" #         write!(formatter, \"definitely not a boolean\")"},{"DocComment":" #     }"},{"DocComment":" #"},{"DocComment":" fn visit_bool<E>(self, v: bool) -> Result<Self::Value, E>"},{"DocComment":" where"},{"DocComment":"     E: de::Error,"},{"DocComment":" {"},{"DocComment":"     Err(de::Error::invalid_type(Unexpected::Bool(v), &self))"},{"DocComment":" }"},{"DocComment":" # }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Outside of a `Visitor`, `&\"...\"` can be used."},{"DocComment":""},{"DocComment":" ```edition2021"},{"DocComment":" # use serde::de::{self, Unexpected};"},{"DocComment":" #"},{"DocComment":" # fn example<E>() -> Result<(), E>"},{"DocComment":" # where"},{"DocComment":" #     E: de::Error,"},{"DocComment":" # {"},{"DocComment":" #     let v = true;"},{"DocComment":" return Err(de::Error::invalid_type("},{"DocComment":"     Unexpected::Bool(v),"},{"DocComment":"     &\"a negative integer\","},{"DocComment":" ));"},{"DocComment":" # }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"m