,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":{"VTableTy":{"dyn_predicate":{"binder":{"params":{"regions":[],"types":[{"index":0,"name":"_dyn"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":2,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"Dyn","trait_":{"regions":[],"skip_binder":{"id":33,"generics":{"regions":[],"types":[{"Deduplicated":2973}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":2973},"Erased"]}],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1306},"kind":"Dyn"}},"field_map":[],"supertrait_map":[null,null]}},"kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":29,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["error",0]},{"Ident":["private",0]},{"Ident":["Internal",0]}],"span":{"data":{"file_id":58,"beg":{"line":268,"col":4},"end":{"line":268,"col":23}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":30,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["any",0]},{"Ident":["TypeId",0]}],"span":{"data":{"file_id":61,"beg":{"line":724,"col":0},"end":{"line":724,"col":17}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A `TypeId` represents a globally unique identifier for a type."},{"DocComment":""},{"DocComment":" Each `TypeId` is an opaque object which does not allow inspection of what's"},{"DocComment":" inside but does allow basic operations such as cloning, comparison,"},{"DocComment":" printing, and showing."},{"DocComment":""},{"DocComment":" A `TypeId` is currently only available for types which ascribe to `'static`,"},{"DocComment":" but this limitation may be removed in the future."},{"DocComment":""},{"DocComment":" While `TypeId` implements `Hash`, `PartialOrd`, and `Ord`, it is worth"},{"DocComment":" noting that the hashes and ordering will vary between Rust releases. Beware"},{"DocComment":" of relying on them inside of your code!"},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":""},{"DocComment":" Like other [`Rust`-representation][repr-rust] types, `TypeId`'s size and layout are unstable."},{"DocComment":" In particular, this means that you cannot rely on the size and layout of `TypeId` remaining the"},{"DocComment":" same between Rust releases; they are subject to change without prior notice between Rust"},{"DocComment":" releases."},{"DocComment":""},{"DocComment":" [repr-rust]: https://doc.rust-lang.org/reference/type-layout.html#r-layout.repr.rust.unspecified"},{"DocComment":""},{"DocComment":" # Danger of Improper Variance"},{"DocComment":""},{"DocComment":" You might think that subtyping is impossible between two static types,"},{"DocComment":" but this is false; there exists a static type with a static subtype."},{"DocComment":" To wit, `fn(&str)`, which is short for `for<'any> fn(&'any str)`, and"},{"DocComment":" `fn(&'static str)`, are two distinct, static types, and yet,"},{"DocComment":" `fn(&str)` is a subtype of `fn(&'static str)`, since any value of type"},{"DocComment":" `fn(&str)` can be used where a value of type `fn(&'static str)` is needed."},{"DocComment":""},{"DocComment":" This means that abstractions around `TypeId`, despite its"},{"DocComment":" `'static` bound on arguments, still need to worry about unnecessary"},{"DocComment":" and improper variance: it is advisable to strive for invariance"},{"DocComment":" first. The usability impact will be negligible, while the reduction"},{"DocComment":" in the risk of unsoundness will be most welcome."},{"DocComment":""},{"DocComment":" ## Examples"},{"DocComment":""},{"DocComment":" Suppose `SubType` is a subtype of `SuperType`, that is,"},{"DocComment":" a value of type `SubType` can be used wherever"},{"DocComment":" a value of type `SuperType` is expected."},{"DocComment":" Suppose also that `CoVar<T>` is a generic type, which is covariant over `T`"},{"DocComment":" (like many other types, including `PhantomData<T>` and `Vec<T>`)."},{"DocComment":""},{"DocComment":" Then, by covariance, `CoVar<SubType>` is a subtype of `CoVar<SuperType>`,"},{"DocComment":" that is, a value of type `CoVar<SubType>` can be used wherever"},{"DocComment":" a value of type `CoVar<SuperType>` is expected."},{"DocComment":""},{"DocComment":" Then if `CoVar<SuperType>` relies on `TypeId::of::<SuperType>()` to uphold any invariants,"},{"DocComment":" those invariants may be broken because a value of type `CoVar<SuperType>` can be created"},{"DocComment":" without going through any of its methods, like so:"},{"DocComment":" ```"},{"DocComment":" type SubType = fn(&());"},{"DocComment":" type SuperType = fn(&'static ());"},{"DocComment":" type CoVar<T> = Vec<T>; // imagine something more complicated"},{"DocComment":""},{"DocComment":" let sub: CoVar<SubType> = CoVar::new();"},{"DocComment":" // we have a `CoVar<SuperType>` instance without"},{"DocComment":" // *ever* having called `CoVar::<SuperType>::new()`!"},{"DocComment":" let fake_super: CoVar<SuperType> = sub;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The following is an example program that tries to use `TypeId::of` to"},{"DocComment":" implement a generic type `Unique<T>` that guarantees unique instances for each `Unique<T>`,"},{"DocComment":" that is, for each type `T` there can be at most one value of type `Unique<T>` at any time."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" mod unique {"},{"DocComment":"     use std::any::TypeId;"},{"DocComment":"     use std::collections::BTreeSet;"},{"DocComment":"     use std::marker::PhantomData;"},{"DocComment":"     use std::sync::Mutex;"},{"DocComment":""},{"DocComment":"     static ID_SET: Mutex<BTreeSet<TypeId>> = Mutex::new(BTreeSet::new());"},{"DocComment":""},{"DocComment":"     // TypeId has only covariant uses, which makes Unique covariant over TypeAsId 🚨"},{"DocComment":"     #[derive(Debug, PartialEq)]"},{"DocComment":"     pub struct Unique<TypeAsId: 'static>("},{"DocComment":"         // private field prevents creation without `new` outside this module"},{"DocComment":"         PhantomData<TypeAsId>,"},{"DocComment":"     );"},{"DocComment":""},{"DocComment":"     impl<TypeAsId: 'static> Unique<TypeAsId> {"},{"DocComment":"         pub fn new() -> Option<Self> {"},{"DocComment":"             let mut set = ID_SET.lock().unwrap();"},{"DocComment":"             (set.insert(TypeId::of::<TypeAsId>())).then(|| Self(PhantomData))"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     impl<TypeAsId: 'static> Drop for Unique<TypeAsId> {"},{"DocComment":"         fn drop(&mut self) {"},{"DocComment":"             let mut set = ID_SET.lock().unwrap();"},{"DocComment":"             (!set.remove(&TypeId::of::<TypeAsId>())).then(|| panic!(\"duplicity detected\"));"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" use unique::Unique;"},{"DocComment":""},{"DocComment":" // `OtherRing` is a subtype of `TheOneRing`. Both are 'static, and thus have a TypeId."},{"DocComment":" type TheOneRing = fn(&'static ());"},{"DocComment":" type OtherRing = fn(&());"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let the_one_ring: Unique<TheOneRing> = Unique::new().unwrap();"},{"DocComment":"     assert_eq!(Unique::<TheOneRing>::new(), None);"},{"DocComment":""},{"DocComment":"     let other_ring: Unique<OtherRing> = Unique::new().unwrap();"},{"DocComment":"     // Use that `Unique<OtherRing>` is a subtype of `Unique<TheOneRing>` 🚨"},{"DocComment":"     let fake_one_ring: Unique<TheOneRing> = other_ring;"},{"DocComment":"     assert_eq!(fake_one_ring, the_one_ring);"},{"DocComment":""},{"DocComment":"     std::mem::forget(fake_one_ring);"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"type_id"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":16,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":31,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["error",0]},{"Ident":["Request",0]}],"span":{"data":{"file_id":58,"beg":{"line":588,"col":0},"end":{"line":588,"col":22}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Request` supports generic, type-driven access to data. Its use is currently restricted to the"},{"DocComment":" standard library in cases where trait authors wish to allow trait implementors to share generic"},{"DocComment":" information across trait boundaries. The motivating and prototypical use case is"},{"DocComment":" `core::error::Error` which would otherwise require a method per concrete type (e.g."},{"DocComment":" `std::backtrace::Backtrace` instance that implementors want to expose to users)."},{"DocComment":""},{"DocComment":" # Data flow"},{"DocComment":""},{"DocComment":" To describe the intended data flow for Request objects, let's consider two conceptual users"},{"DocComment":" separated by API boundaries:"},{"DocComment":""},{"DocComment":" * Consumer - the consumer requests objects using a Request instance; e.g. a crate that offers"},{"DocComment":"   fancy `Error`/`Result` reporting to users wants to request a Backtrace from a given `dyn Error`."},{"DocComment":""},{"DocComment":" * Producer - the producer provides objects when requested via Request; e.g. a library with an"},{"DocComment":"   an `Error` implementation that automatically captures backtraces at the time instances are"},{"DocComment":"   created."},{"DocComment":""},{"DocComment":" The consumer only needs to know where to submit their request and is expected to handle the"},{"DocComment":" request not being fulfilled by the use of `Option<T>` in the responses offered by the producer."},{"DocComment":""},{"DocComment":" * A Producer initializes the value of one of its fields of a specific type. (or is otherwise"},{"DocComment":"   prepared to generate a value requested). e.g., `backtrace::Backtrace` or"},{"DocComment":"   `std::backtrace::Backtrace`."},{"DocComment":" * A Consumer requests an object of a specific type (say `std::backtrace::Backtrace`). In the"},{"DocComment":"   case of a `dyn Error` trait object (the Producer), there are functions called `request_ref` and"},{"DocComment":"   `request_value` to simplify obtaining an `Option<T>` for a given type."},{"DocComment":" * The Producer, when requested, populates the given Request object which is given as a mutable"},{"DocComment":"   reference."},{"DocComment":" * The Consumer extracts a value or reference to the requested type from the `Request` object"},{"DocComment":"   wrapped in an `Option<T>`; in the case of `dyn Error` the aforementioned `request_ref` and"},{"DocComment":"   `request_value` methods mean that `dyn Error` users don't have to deal with the `Request` type at"},{"DocComment":"   all (but `Error` implementors do). The `None` case of the `Option` suggests only that the"},{"DocComment":"   Producer cannot currently offer an instance of the requested type, not that it can't or never will."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The best way to demonstrate this is using an example implementation of `Error`'s `provide` trait"},{"DocComment":" method:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(error_generic_member_access)]"},{"DocComment":" use core::fmt;"},{"DocComment":" use core::error::Request;"},{"DocComment":" use core::error::request_ref;"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" enum MyLittleTeaPot {"},{"DocComment":"     Empty,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct MyBacktrace {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl MyBacktrace {"},{"DocComment":"     fn new() -> MyBacktrace {"},{"DocComment":"         // ..."},{"DocComment":"         # MyBacktrace {}"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Error {"},{"DocComment":"     backtrace: MyBacktrace,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Display for Error {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"Example Error\")"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl std::error::Error for Error {"},{"DocComment":"     fn provide<'a>(&'a self, request: &mut Request<'a>) {"},{"DocComment":"         request"},{"DocComment":"             .provide_ref::<MyBacktrace>(&self.backtrace);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let backtrace = MyBacktrace::new();"},{"DocComment":"     let error = Error { backtrace };"},{"DocComment":"     let dyn_error = &error as &dyn std::error::Error;"},{"DocComment":"     let backtrace_ref = request_ref::<MyBacktrace>(dyn_error).unwrap();"},{"DocComment":""},{"DocComment":"     assert!(core::ptr::eq(&error.backtrace, backtrace_ref));"},{"DocComment":"     assert!(request_ref::<MyLittleTeaPot>(dyn_error).is_none());"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Shared"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":null,"align":null,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},null,{"def_id":33,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["iter",0]},{"Ident":["IntoIter",0]}],"span":{"data":{"file_id":62,"beg":{"line":20,"col":0},"end":{"line":20,"col":38}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A by-value [array] iterator."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"ArrayIntoIter"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":659}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":34,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Ident":["nonzero",0]},{"Ident":["NonZero",0]}],"span":{"data":{"file_id":63,"beg":{"line":128,"col":0},"end":{"line":128,"col":40}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A value that is known not to equal zero."},{"DocComment":""},{"DocComment":" This enables some memory layout optimization."},{"DocComment":" For example, `Option<NonZero<u32>>` is the same size as `u32`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use core::{num::NonZero};"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<Option<NonZero<u32>>>(), size_of::<u32>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":""},{"DocComment":" `NonZero<T>` is guaranteed to have the same layout and bit validity as `T`"},{"DocComment":" with the exception that the all-zero bit pattern is invalid."},{"DocComment":" `Option<NonZero<T>>` is guaranteed to be compatible with `T`, including in"},{"DocComment":" FFI."},{"DocComment":""},{"DocComment":" Thanks to the [null pointer optimization], `NonZero<T>` and"},{"DocComment":" `Option<NonZero<T>>` are guaranteed to have the same size and alignment:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::num::NonZero;"},{"DocComment":""},{"DocComment":" assert_eq!(size_of::<NonZero<u32>>(), size_of::<Option<NonZero<u32>>>());"},{"DocComment":" assert_eq!(align_of::<NonZero<u32>>(), align_of::<Option<NonZero<u32>>>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [null pointer optimization]: crate::option#representation"},{"DocComment":""},{"DocComment":" # Note on generic usage"},{"DocComment":""},{"DocComment":" `NonZero<T>` can only be used with some standard library primitive types"},{"DocComment":" (such as `u8`, `i32`, and etc.). The type parameter `T` must implement the"},{"DocComment":" internal trait [`ZeroablePrimitive`], which is currently permanently unstable"},{"DocComment":" and cannot be implemented by users. Therefore, you cannot use `NonZero<T>`"},{"DocComment":" with your own types, nor can you implement traits for all `NonZero<T>`,"},{"DocComment":" only for concrete types."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"NonZero"},"generics":{"regions":[],"types":[{"index":0,"name":"T"},{"index":1,"name":"Clause0_NonZeroInner"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":35,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["step_by",0]},{"Ident":["StepBy",0]}],"span":{"data":{"file_id":65,"beg":{"line":16,"col":0},"end":{"line":16,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator for stepping iterators by a custom amount."},{"DocComment":""},{"DocComment":" This `struct` is created by the [`step_by`] method on [`Iterator`]. See"},{"DocComment":" its documentation for more."},{"DocComment":""},{"DocComment":" [`step_by`]: Iterator::step_by"},{"DocComment":" [`Iterator`]: trait.Iterator.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"I"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":36,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["chain",0]},{"Ident":["Chain",0]}],"span":{"data":{"file_id":67,"beg":{"line":23,"col":0},"end":{"line":23,"col":22}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator that links two iterators together, in a chain."},{"DocComment":""},{"DocComment":" This `struct` is created by [`chain`] or [`Iterator::chain`]. See their"},{"DocComment":" documentation for more."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::iter::Chain;"},{"DocComment":" use std::slice::Iter;"},{"DocComment":""},{"DocComment":" let a1 = [1, 2, 3];"},{"DocComment":" let a2 = [4, 5, 6];"},{"DocComment":" let iter: Chain<Iter<'_, _>, Iter<'_, _>> = a1.iter().chain(a2.iter());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"A"},{"index":1,"name":"B"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":37,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["zip",0]},{"Ident":["Zip",0]}],"span":{"data":{"file_id":68,"beg":{"line":13,"col":0},"end":{"line":13,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator that iterates two other iterators simultaneously."},{"DocComment":""},{"DocComment":" This `struct` is created by [`zip`] or [`Iterator::zip`]."},{"DocComment":" See their documentation for more."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"A"},{"index":1,"name":"B"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":38,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["intersperse",0]},{"Ident":["Intersperse",0]}],"span":{"data":{"file_id":69,"beg":{"line":9,"col":0},"end":{"line":9,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator adapter that places a separator between all elements."},{"DocComment":""},{"DocComment":" This `struct` is created by [`Iterator::intersperse`]. See its documentation"},{"DocComment":" for more information."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"I"},{"index":1,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":39,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["intersperse",0]},{"Ident":["IntersperseWith",0]}],"span":{"data":{"file_id":69,"beg":{"line":83,"col":0},"end":{"line":83,"col":32}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator adapter that places a separator between all elements."},{"DocComment":""},{"DocComment":" This `struct` is created by [`Iterator::intersperse_with`]. See its"},{"DocComment":" documentation for more information."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"I"},{"index":1,"name":"G"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":40,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["map",0]},{"Ident":["Map",0]}],"span":{"data":{"file_id":71,"beg":{"line":61,"col":0},"end":{"line":61,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator that maps the values of `iter` with `f`."},{"DocComment":""},{"DocComment":" This `struct` is created by the [`map`] method on [`Iterator`]. See its"},{"DocComment":" documentation for more."},{"DocComment":""},{"DocComment":" [`map`]: Iterator::map"},{"DocComment":" [`Iterator`]: trait.Iterator.html"},{"DocComment":""},{"DocComment":" # Notes about side effects"},{"DocComment":""},{"DocComment":" The [`map`] iterator implements [`DoubleEndedIterator`], meaning that"},{"DocComment":" you can also [`map`] backwards:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" let v: Vec<i32> = [1, 2, 3].into_iter().map(|x| x + 1).rev().collect();"},{"DocComment":""},{"DocComment":" assert_eq!(v, [4, 3, 2]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`DoubleEndedIterator`]: trait.DoubleEndedIterator.html"},{"DocComment":""},{"DocComment":" But if your closure has state, iterating backwards may act in a way you do"},{"DocComment":" not expect. Let's go through an example. First, in the forward direction:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" let mut c = 0;"},{"DocComment":""},{"DocComment":" for pair in ['a', 'b', 'c'].into_iter()"},{"DocComment":"                                .map(|letter| { c += 1; (letter, c) }) {"},{"DocComment":"     println!(\"{pair:?}\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will print `('a', 1), ('b', 2), ('c', 3)`."},{"DocComment":""},{"DocComment":" Now consider this twist where we add a call to `rev`. This version will"},{"DocComment":" print `('c', 1), ('b', 2), ('a', 3)`. Note that the letters are reversed,"},{"DocComment":" but the values of the counter still go in order. This is because `map()` is"},{"DocComment":" still being called lazily on each item, but we are popping items off the"},{"DocComment":" back of the vector now, instead of shifting them from the front."},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" let mut c = 0;"},{"DocComment":""},{"DocComment":" for pair in ['a', 'b', 'c'].into_iter()"},{"DocComment":"                                .map(|letter| { c += 1; (letter, c) })"},{"DocComment":"                                .rev() {"},{"DocComment":"     println!(\"{pair:?}\");"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"I"},{"index":1,"name":"F"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":41,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["filter",0]},{"Ident":["Filter",0]}],"span":{"data":{"file_id":72,"beg":{"line":21,"col":0},"end":{"line":21,"col":23}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator that filters the elements of `iter` with `predicate`."},{"DocComment":""},{"DocComment":" This `struct` is created by the [`filter`] method on [`Iterator`]. See its"},{"DocComment":" documentation for more."},{"DocComment":""},{"DocComment":" [`filter`]: Iterator::filter"},{"DocComment":" [`Iterator`]: trait.Iterator.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"I"},{"index":1,"name":"P"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":42,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["filter_map",0]},{"Ident":["FilterMap",0]}],"span":{"data":{"file_id":73,"beg":{"line":18,"col":0},"end":{"line":18,"col":26}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator that uses `f` to both filter and map elements from `iter`."},{"DocComment":""},{"DocComment":" Thi