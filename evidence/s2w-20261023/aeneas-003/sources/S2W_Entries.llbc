:" converted to an iterator. This is common for types which describe a"},{"DocComment":" collection of some kind."},{"DocComment":""},{"DocComment":" One benefit of implementing `IntoIterator` is that your type will [work"},{"DocComment":" with Rust's `for` loop syntax](crate::iter#for-loops-and-intoiterator)."},{"DocComment":""},{"DocComment":" See also: [`FromIterator`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = [1, 2, 3];"},{"DocComment":" let mut iter = v.into_iter();"},{"DocComment":""},{"DocComment":" assert_eq!(Some(1), iter.next());"},{"DocComment":" assert_eq!(Some(2), iter.next());"},{"DocComment":" assert_eq!(Some(3), iter.next());"},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":" ```"},{"DocComment":" Implementing `IntoIterator` for your type:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // A sample collection, that's just a wrapper over Vec<T>"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct MyCollection(Vec<i32>);"},{"DocComment":""},{"DocComment":" // Let's give it some methods so we can create one and add things"},{"DocComment":" // to it."},{"DocComment":" impl MyCollection {"},{"DocComment":"     fn new() -> MyCollection {"},{"DocComment":"         MyCollection(Vec::new())"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     fn add(&mut self, elem: i32) {"},{"DocComment":"         self.0.push(elem);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // and we'll implement IntoIterator"},{"DocComment":" impl IntoIterator for MyCollection {"},{"DocComment":"     type Item = i32;"},{"DocComment":"     type IntoIter = std::vec::IntoIter<Self::Item>;"},{"DocComment":""},{"DocComment":"     fn into_iter(self) -> Self::IntoIter {"},{"DocComment":"         self.0.into_iter()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Now we can make a new collection..."},{"DocComment":" let mut c = MyCollection::new();"},{"DocComment":""},{"DocComment":" // ... add some stuff to it ..."},{"DocComment":" c.add(0);"},{"DocComment":" c.add(1);"},{"DocComment":" c.add(2);"},{"DocComment":""},{"DocComment":" // ... and then turn it into an Iterator:"},{"DocComment":" for (i, n) in c.into_iter().enumerate() {"},{"DocComment":"     assert_eq!(i as i32, n);"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It is common to use `IntoIterator` as a trait bound. This allows"},{"DocComment":" the input collection type to change, so long as it is still an"},{"DocComment":" iterator. Additional bounds can be specified by restricting on"},{"DocComment":" `Item`:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" fn collect_as_strings<T>(collection: T) -> Vec<String>"},{"DocComment":" where"},{"DocComment":"     T: IntoIterator,"},{"DocComment":"     T::Item: std::fmt::Debug,"},{"DocComment":" {"},{"DocComment":"     collection"},{"DocComment":"         .into_iter()"},{"DocComment":"         .map(|item| format!(\"{item:?}\"))"},{"DocComment":"         .collect()"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"IntoIterator"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Self_Item"},{"index":2,"name":"Self_IntoIter"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"data":{"file_id":52,"beg":{"line":291,"col":19},"end":{"line":291,"col":46}},"generated_from_span":null},"origin":{"TraitItem":1},"trait_":{"regions":[],"skip_binder":{"id":34,"generics":{"regions":[],"types":[{"Deduplicated":10660},{"Deduplicated":10639}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[null,null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"into_iter","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["collect",0]},{"Ident":["IntoIterator",0]},{"Ident":["into_iter",0]}],"span":{"data":{"file_id":52,"beg":{"line":312,"col":4},"end":{"line":312,"col":41}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator from a value."},{"DocComment":""},{"DocComment":" See the [module-level documentation] for more."},{"DocComment":""},{"DocComment":" [module-level documentation]: crate::iter"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = [1, 2, 3];"},{"DocComment":" let mut iter = v.into_iter();"},{"DocComment":""},{"DocComment":" assert_eq!(Some(1), iter.next());"},{"DocComment":" assert_eq!(Some(2), iter.next());"},{"DocComment":" assert_eq!(Some(3), iter.next());"},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"into_iter"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10638}],"output":{"Deduplicated":10660}},"default":null},"kind":{"TraitMethod":[29,0]}}],"vtable":{"id":{"Adt":22},"generics":{"regions":[],"types":[{"Deduplicated":10639},{"Deduplicated":10660}],"const_generics":[],"trait_refs":[]}}},{"def_id":30,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Display",0]}],"span":{"data":{"file_id":55,"beg":{"line":1187,"col":0},"end":{"line":1187,"col":31}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Format trait for an empty format, `{}`."},{"DocComment":""},{"DocComment":" Implementing this trait for a type will automatically implement the"},{"DocComment":" [`ToString`][tostring] trait for the type, allowing the usage"},{"DocComment":" of the [`.to_string()`][tostring_function] method. Prefer implementing"},{"DocComment":" the `Display` trait for a type, rather than [`ToString`][tostring]."},{"DocComment":""},{"DocComment":" `Display` is similar to [`Debug`], but `Display` is for user-facing"},{"DocComment":" output, and so cannot be derived."},{"DocComment":""},{"DocComment":" For more information on formatters, see [the module-level documentation][module]."},{"DocComment":""},{"DocComment":" [module]: ../../std/fmt/index.html"},{"DocComment":" [tostring]: ../../std/string/trait.ToString.html"},{"DocComment":" [tostring_function]: ../../std/string/trait.ToString.html#tymethod.to_string"},{"DocComment":""},{"DocComment":" # Completeness and parseability"},{"DocComment":""},{"DocComment":" `Display` for a type might not necessarily be a lossless or complete representation of the type."},{"DocComment":" It may omit internal state, precision, or other information the type does not consider important"},{"DocComment":" for user-facing output, as determined by the type. As such, the output of `Display` might not be"},{"DocComment":" possible to parse, and even if it is, the result of parsing might not exactly match the original"},{"DocComment":" value."},{"DocComment":""},{"DocComment":" However, if a type has a lossless `Display` implementation whose output is meant to be"},{"DocComment":" conveniently machine-parseable and not just meant for human consumption, then the type may wish"},{"DocComment":" to accept the same format in `FromStr`, and document that usage. Having both `Display` and"},{"DocComment":" `FromStr` implementations where the result of `Display` cannot be parsed with `FromStr` may"},{"DocComment":" surprise users."},{"DocComment":""},{"DocComment":" # Internationalization"},{"DocComment":""},{"DocComment":" Because a type can only have one `Display` implementation, it is often preferable"},{"DocComment":" to only implement `Display` when there is a single most \"obvious\" way that"},{"DocComment":" values can be formatted as text. This could mean formatting according to the"},{"DocComment":" \"invariant\" culture and \"undefined\" locale, or it could mean that the type"},{"DocComment":" display is designed for a specific culture/locale, such as developer logs."},{"DocComment":""},{"DocComment":" If not all values have a justifiably canonical textual format or if you want"},{"DocComment":" to support alternative formats not covered by the standard set of possible"},{"DocComment":" [formatting traits], the most flexible approach is display adapters: methods"},{"DocComment":" like [`str::escape_default`] or [`Path::display`] which create a wrapper"},{"DocComment":" implementing `Display` to output the specific display format."},{"DocComment":""},{"DocComment":" [formatting traits]: ../../std/fmt/index.html#formatting-traits"},{"DocComment":" [`Path::display`]: ../../std/path/struct.Path.html#method.display"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Implementing `Display` on a type:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Display for Point {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"({}, {})\", self.x, self.y)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"The origin is: {origin}\"), \"The origin is: (0, 0)\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Display"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"fmt","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Display",0]},{"Ident":["fmt",0]}],"span":{"data":{"file_id":55,"beg":{"line":1212,"col":4},"end":{"line":1212,"col":51}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":"Formats the value using the given formatter.\n\n# Errors\n\nThis function should return [`Err`] if, and only if, the provided [`Formatter`] returns [`Err`].\nString formatting is considered an infallible operation; this function only\nreturns a [`Result`] because writing to the underlying stream might fail and it must\nprovide a way to propagate the fact that an error has occurred back up the stack.\n"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Position {"},{"DocComment":"     longitude: f32,"},{"DocComment":"     latitude: f32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Display for Position {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"({}, {})\", self.longitude, self.latitude)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     \"(1.987, 2.983)\","},{"DocComment":"     format!(\"{}\", Position { longitude: 1.987, latitude: 2.983, }),"},{"DocComment":" );"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10695},{"HashConsedValue":[5524,{"Ref":[{"Var":{"Bound":[0,1]}},{"HashConsedValue":[5523,{"Adt":{"id":{"Adt":24},"generics":{"regions":[{"Var":{"Bound":[0,2]}}],"types":[],"const_generics":[],"trait_refs":[]}}}]},"Mut"]}]}],"output":{"HashConsedValue":[5526,{"Adt":{"id":{"Adt":2},"generics":{"regions":[],"types":[{"Deduplicated":566},{"HashConsedValue":[5525,{"Adt":{"id":{"Adt":25},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}],"const_generics":[],"trait_refs":[]}}}]}},"default":null},"kind":{"TraitMethod":[30,0]}}],"vtable":{"id":{"Adt":23},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":31,"item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["de",0]},{"Ident":["Error",0]}],"span":{"data":{"file_id":47,"beg":{"line":165,"col":8},"end":{"line":165,"col":48}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The `Error` trait allows `Deserialize` implementations to create descriptive"},{"DocComment":" error messages belonging to the `Deserializer` against which they are"},{"DocComment":" currently running."},{"DocComment":""},{"DocComment":" Every `Deserializer` declares an `Error` type that encompasses both"},{"DocComment":" general-purpose deserialization errors as well as errors specific to the"},{"DocComment":" particular deserialization format. For example the `Error` type of"},{"DocComment":" `serde_json` can represent errors like an invalid JSON escape sequence or an"},{"DocComment":" unterminated string literal, in addition to the error cases that are part of"},{"DocComment":" this trait."},{"DocComment":""},{"DocComment":" Most deserializers should only need to provide the `Error::custom` method"},{"DocComment":" and inherit the default behavior for the other methods."},{"DocComment":""},{"DocComment":" # Example implementation"},{"DocComment":""},{"DocComment":" The [example data format] presented on the website shows an error"},{"DocComment":" type appropriate for a basic JSON data format."},{"DocComment":""},{"DocComment":" [example data format]: https://serde.rs/data-format.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"data":{"file_id":47,"beg":{"line":165,"col":37},"end":{"line":165,"col":48}},"generated_from_span":null},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":33,"generics":{"regions":[],"types":[{"Deduplicated":10638}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":47,"beg":{"line":197,"col":19},"end":{"line":197,"col":26}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":30,"generics":{"regions":[],"types":[{"Deduplicated":2973}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"custom","item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["de",0]},{"Ident":["Error",0]},{"Ident":["custom",0]}],"span":{"data":{"file_id":47,"beg":{"line":195,"col":12},"end":{"line":197,"col":27}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Raised when there is general error when deserializing a type."},{"DocComment":""},{"DocComment":" The message should not be capitalized and should not end with a period."},{"DocComment":""},{"DocComment":" ```edition2021"},{"DocComment":" # use std::str::FromStr;"},{"DocComment":" #"},{"DocComment":" # struct IpAddr;"},{"DocComment":" #"},{"DocComment":" # impl FromStr for IpAddr {"},{"DocComment":" #     type Err = String;"},{"DocComment":" #"},{"DocComment":" #     fn from_str(_: &str) -> Result<Self, String> {"},{"DocComment":" #         unimplemented!()"},{"DocComment":" #     }"},{"DocComment":" # }"},{"DocComment":" #"},{"DocComment":" use serde::de::{self, Deserialize, Deserializer};"},{"DocComment":""},{"DocComment":" impl<'de> Deserialize<'de> for IpAddr {"},{"DocComment":"     fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>"},{"DocComment":"     where"},{"DocComment":"         D: Deserializer<'de>,"},{"DocComment":"     {"},{"DocComment":"         let s = String::deserialize(deserializer)?;"},{"DocComment":"         s.parse().map_err(de::Error::custom)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":1306}],"output":{"Deduplicated":10638}},"default":null},"kind":{"TraitMethod":[31,0]}},null,null,null,null,null,null,null],"vtable":null},{"def_id":32,"item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["de",0]},{"Ident":["Visitor",0]}],"span":{"data":{"file_id":47,"beg":{"line":1317,"col":0},"end":{"line":1317,"col":29}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" This trait represents a visitor that walks through a deserializer."},{"DocComment":""},{"DocComment":" # Lifetime"},{"DocComment":""},{"DocComment":" The `'de` lifetime of this trait is the requirement for lifetime of data"},{"DocComment":" that may be borrowed by `Self::Value`. See the page [Understanding"},{"DocComment":" deserializer lifetimes] for a more detailed explanation of these lifetimes."},{"DocComment":""},{"DocComment":" [Understanding deserializer lifetimes]: https://serde.rs/lifetimes.html"},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```edition2021"},{"DocComment":" # use serde::de::{self, Unexpected, Visitor};"},{"DocComment":" # use std::fmt;"},{"DocComment":" #"},{"DocComment":" /// A visitor that deserializes a long string - a string containing at least"},{"DocComment":" /// some minimum number of bytes."},{"DocComment":" struct LongString {"},{"DocComment":"     min: usize,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<'de> Visitor<'de> for LongString {"},{"DocComment":"     type Value = String;"},{"DocComment":""},{"DocComment":"     fn expecting(&self, formatter: &mut fmt::Formatter) -> fmt::Result {"},{"DocComment":"         write!(formatter, \"a string containing at least {} bytes\", self.min)"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     fn visit_str<E>(self, s: &str) -> Result<Self::Value, E>"},{"DocComment":"     where"},{"DocComment":"         E: de::Error,"},{"DocComment":"     {"},{"DocComment":"         if s.len() >= self.min {"},{"DocComment":"             Ok(s.to_owned())"},{"DocComment":"         } else {"},{"DocComment":"             Err(de::Error::invalid_value(Unexpected::Str(s), &self))"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":"'de","mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Self_Value"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"expecting","item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["de",0]},{"Ident":["Visitor",0]},{"Ident":["expecting",0]}],"span":{"data":{"file_id":47,"beg":{"line":1343,"col":4},"end":{"line":1343,"col":71}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Format a message stating what data this Visitor expects to receive."},{"DocComment":""},{"DocComment":" This is used in error messages. The message should complete the sentence"},{"DocComment":" \"This Visitor expects to receive ...\", for example the message could be"},{"DocComment":" \"an integer between 0 and 64\". The message should not be capitalized and"},{"DocComment":" should not end with a period."},{"DocComment":""},{"DocComment":" ```edition2021"},{"DocComment":" # use std::fmt;"},{"DocComment":" #"},{"DocComment":" # struct S {"},{"DocComment":" #     max: usize,"},{"DocComment":" # }"},{"DocComment":" #"},{"DocComment":" # impl<'de> serde::de::Visitor<'de> for S {"},{"DocComment":" #     type Value = ();"},{"DocComment":" #"},{"DocComment":" fn expecting(&self, formatter: &mut fmt::Formatter) -> fmt::Result {"},{"DocComment":"     write!(formatter, \"an integer between 0 and {}\", self.max)"},{"DocComment":" }"},{"DocComment":" # }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10695},{"Deduplicated":5524}],"output":{"Deduplicated":5526}},"default":null},"kind":{"TraitMethod":[32,0]}},null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],"vtable":null},{"def_id":33,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["error",0]},{"Ident":["Error",0]}],"span":{"data":{"file_id":58,"beg":{"line":59,"col":0},"end":{"line":59,"col":32}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Error` is a trait representing the basic expectations for error values,"},{"DocComment":" i.e., values of type `E` in [`Result<T, E>`]."},{"DocComment":""},{"DocComment":" Errors must describe themselves through the [`Display`] and [`Debug`]"},{"DocComment":" traits. Error messages are typically concise lowercase sentences without"},{"DocComment":" trailing punctuation:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let err = \"NaN\".parse::<u32>().unwrap_err();"},{"DocComment":" assert_eq!(err.to_string(), \"invalid digit found in string\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Error source"},{"DocComment":""},{"DocComment":" Errors may provide cause information. [`Error::source()`] is generally"},{"DocComment":" used when errors cross \"abstraction boundaries\". If one module must report"},{"DocComment":" an error that is caused by an error from a lower-level module, it can allow"},{"DocComment":" accessing that error via `Error::source()`. This makes it possible for the"},{"DocComment":" high-level module to provide its own errors while also revealing some of the"},{"DocComment":" implementation for debugging."},{"DocComment":""},{"DocComment":" In error types that wrap an underlying error, the underlying error"},{"DocComment":" should be either returned by the outer error's `Error::source()`, or rendered"},{"DocComment":" by the outer error's `Display` implementation, but not both."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" Implementing the `Error` trait only requires that `Debug` and `Display` are implemented too."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::error::Error;"},{"DocComment":" use std::fmt;"},{"DocComment":" use std::path::PathBuf;"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct ReadConfigError {"},{"DocComment":"     path: PathBuf"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Display for ReadConfigError {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         let path = self.path.display();"},{"DocComment":"         write!(f, \"unable to read configuration at {path}\")"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Error for ReadConfigError {}"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Error"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"data":{"file_id":58,"beg":{"line":59,"col":17},"end":{"line":59,"col":22}},"generated_from_span":null},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":39,"generics":{"regions":[],"types":[{"Deduplicated":10638}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":58,"beg":{"line":59,"col":25},"end":{"line":59,"col":32}},"generated_from_span":null},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":30,"generics":{"regions":[],"types":[{"Deduplicated":10638}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[null,null,null,null,null],"vtable":{"id":{"Adt":28},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":34,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]}],"span":{"data":{"file_id":59,"beg":{"line":42,"col":0},"end":{"line":42,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A trait for dealing with iterators."},{"DocComment":""},{"DocComment":" This is the main iterator trait. For more about the concept of iterators"},{"DocComment":" generally, please see the [module-level documentation]. In particular, you"},{"DocComment":" may want to know how to [implement `Iterator`][impl]."},{"DocComment":""},{"DocComment":" [module-level documentat