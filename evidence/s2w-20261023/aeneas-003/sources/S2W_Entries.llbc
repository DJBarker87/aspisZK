ontains a different type of variant, the following"},{"DocComment":" `invalid_type` error should be constructed:"},{"DocComment":""},{"DocComment":" ```edition2021"},{"DocComment":" # use serde::de::{self, value, DeserializeSeed, Visitor, VariantAccess, Unexpected};"},{"DocComment":" #"},{"DocComment":" # struct X;"},{"DocComment":" #"},{"DocComment":" # impl<'de> VariantAccess<'de> for X {"},{"DocComment":" #     type Error = value::Error;"},{"DocComment":" #"},{"DocComment":" #     fn unit_variant(self) -> Result<(), Self::Error> {"},{"DocComment":" #         unimplemented!()"},{"DocComment":" #     }"},{"DocComment":" #"},{"DocComment":" #     fn newtype_variant_seed<T>(self, _: T) -> Result<T::Value, Self::Error>"},{"DocComment":" #     where"},{"DocComment":" #         T: DeserializeSeed<'de>,"},{"DocComment":" #     { unimplemented!() }"},{"DocComment":" #"},{"DocComment":" #     fn tuple_variant<V>(self, _: usize, _: V) -> Result<V::Value, Self::Error>"},{"DocComment":" #     where"},{"DocComment":" #         V: Visitor<'de>,"},{"DocComment":" #     { unimplemented!() }"},{"DocComment":" #"},{"DocComment":" fn struct_variant<V>("},{"DocComment":"     self,"},{"DocComment":"     _fields: &'static [&'static str],"},{"DocComment":"     _visitor: V,"},{"DocComment":" ) -> Result<V::Value, Self::Error>"},{"DocComment":" where"},{"DocComment":"     V: Visitor<'de>,"},{"DocComment":" {"},{"DocComment":"     // What the data actually contained; suppose it is a unit variant."},{"DocComment":"     let unexp = Unexpected::UnitVariant;"},{"DocComment":"     Err(de::Error::invalid_type(unexp, &\"struct variant\"))"},{"DocComment":" }"},{"DocComment":" # }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10638},{"Deduplicated":4917},{"Deduplicated":1306}],"output":{"Deduplicated":10735}},"default":null},"kind":{"TraitMethod":[53,4]}}],"vtable":null},{"def_id":54,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Ident":["nonzero",0]},{"Ident":["private",0]},{"Ident":["Sealed",0]}],"span":{"data":{"file_id":63,"beg":{"line":47,"col":12},"end":{"line":47,"col":28}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":{"Adt":69},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":55,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["Eq",0]}],"span":{"data":{"file_id":15,"beg":{"line":338,"col":0},"end":{"line":338,"col":58}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Trait for comparisons corresponding to [equivalence relations]("},{"DocComment":" https://en.wikipedia.org/wiki/Equivalence_relation)."},{"DocComment":""},{"DocComment":" The primary difference to [`PartialEq`] is the additional requirement for reflexivity. A type"},{"DocComment":" that implements [`PartialEq`] guarantees that for all `a`, `b` and `c`:"},{"DocComment":""},{"DocComment":" - symmetric: `a == b` implies `b == a`"},{"DocComment":" - transitive: `a == b` and `b == c` implies `a == c`"},{"DocComment":" - consistent: `a != b` if and only if `!(a == b)`"},{"DocComment":""},{"DocComment":" `Eq`, which builds on top of [`PartialEq`] also implies:"},{"DocComment":""},{"DocComment":" - reflexive: `a == a`"},{"DocComment":""},{"DocComment":" This property cannot be checked by the compiler, and therefore `Eq` is a trait without methods."},{"DocComment":""},{"DocComment":" Violating this property is a logic error. The behavior resulting from a logic error is not"},{"DocComment":" specified, but users of the trait must ensure that such logic errors do *not* result in"},{"DocComment":" undefined behavior. This means that `unsafe` code **must not** rely on the correctness of these"},{"DocComment":" methods."},{"DocComment":""},{"DocComment":" Floating point types such as [`f32`] and [`f64`] implement only [`PartialEq`] but *not* `Eq`"},{"DocComment":" because `NaN` != `NaN`."},{"DocComment":""},{"DocComment":" ## Derivable"},{"DocComment":""},{"DocComment":" This trait can be used with `#[derive]`. When `derive`d, because `Eq` has no extra methods, it"},{"DocComment":" is only informing the compiler that this is an equivalence relation rather than a partial"},{"DocComment":" equivalence relation. Note that the `derive` strategy requires all fields are `Eq`, which isn't"},{"DocComment":" always desired."},{"DocComment":""},{"DocComment":" ## How can I implement `Eq`?"},{"DocComment":""},{"DocComment":" If you cannot use the `derive` strategy, specify that your type implements `Eq`, which has no"},{"DocComment":" extra methods:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" enum BookFormat {"},{"DocComment":"     Paperback,"},{"DocComment":"     Hardback,"},{"DocComment":"     Ebook,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" struct Book {"},{"DocComment":"     isbn: i32,"},{"DocComment":"     format: BookFormat,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl PartialEq for Book {"},{"DocComment":"     fn eq(&self, other: &Self) -> bool {"},{"DocComment":"         self.isbn == other.isbn"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Eq for Book {}"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Eq"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},