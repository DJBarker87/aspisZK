cComment":"         S: Serializer,"},{"DocComment":"     {"},{"DocComment":"         let mut map = serializer.serialize_map(Some(self.len()))?;"},{"DocComment":"         for (k, v) in self {"},{"DocComment":"             map.serialize_entry(k, v)?;"},{"DocComment":"         }"},{"DocComment":"         map.end()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10638},{"Deduplicated":4255}],"output":{"HashConsedValue":[10732,{"Adt":{"id":{"Adt":2},"generics":{"regions":[],"types":[{"Deduplicated":10723},{"Deduplicated":10660}],"const_generics":[],"trait_refs":[]}}}]}},"default":null},"kind":{"TraitMethod":[19,27]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"serialize_struct","item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["ser",0]},{"Ident":["Serializer",0]},{"Ident":["serialize_struct",0]}],"span":{"data":{"file_id":44,"beg":{"line":1220,"col":4},"end":{"line":1224,"col":52}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Begin to serialize a struct like `struct Rgb { r: u8, g: u8, b: u8 }`."},{"DocComment":" This call must be followed by zero or more calls to `serialize_field`,"},{"DocComment":" then a call to `end`."},{"DocComment":""},{"DocComment":" The `name` is the name of the struct and the `len` is the number of"},{"DocComment":" data fields that will be serialized. `len` does not include fields"},{"DocComment":" which are skipped with [`SerializeStruct::skip_field`]."},{"DocComment":""},{"DocComment":" ```edition2021"},{"DocComment":" use serde::ser::{Serialize, SerializeStruct, Serializer};"},{"DocComment":""},{"DocComment":" struct Rgb {"},{"DocComment":"     r: u8,"},{"DocComment":"     g: u8,"},{"DocComment":"     b: u8,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Serialize for Rgb {"},{"DocComment":"     fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>"},{"DocComment":"     where"},{"DocComment":"         S: Serializer,"},{"DocComment":"     {"},{"DocComment":"         let mut rgb = serializer.serialize_struct(\"Rgb\", 3)?;"},{"DocComment":"         rgb.serialize_field(\"r\", &self.r)?;"},{"DocComment":"         rgb.serialize_field(\"g\", &self.g)?;"},{"DocComment":"         rgb.serialize_field(\"b\", &self.b)?;"},{"DocComment":"         rgb.end()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10638},{"Deduplicated":4219},{"Deduplicated":659}],"output":{"HashConsedValue":[10733,{"Adt":{"id":{"Adt":2},"generics":{"regions":[],"types":[{"Deduplicated":10724},{"Deduplicated":10660}],"const_generics":[],"trait_refs":[]}}}]}},"default":null},"kind":{"TraitMethod":[19,28]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"serialize_struct_variant","item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["ser",0]},{"Ident":["Serializer",0]},{"Ident":["serialize_struct_variant",0]}],"span":{"data":{"file_id":44,"beg":{"line":1264,"col":4},"end":{"line":1270,"col":59}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Begin to serialize a struct variant like `E::S` in `enum E { S { r: u8,"},{"DocComment":" g: u8, b: u8 } }`. This call must be followed by zero or more calls to"},{"DocComment":" `serialize_field`, then a call to `end`."},{"DocComment":""},{"DocComment":" The `name` is the name of the enum, the `variant_index` is the index of"},{"DocComment":" this variant within the enum, the `variant` is the name of the variant,"},{"DocComment":" and the `len` is the number of data fields that will be serialized."},{"DocComment":" `len` does not include fields which are skipped with"},{"DocComment":" [`SerializeStructVariant::skip_field`]."},{"DocComment":""},{"DocComment":" ```edition2021"},{"DocComment":" use serde::ser::{Serialize, SerializeStructVariant, Serializer};"},{"DocComment":""},{"DocComment":" enum E {"},{"DocComment":"     S { r: u8, g: u8, b: u8 },"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Serialize for E {"},{"DocComment":"     fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>"},{"DocComment":"     where"},{"DocComment":"         S: Serializer,"},{"DocComment":"     {"},{"DocComment":"         match *self {"},{"DocComment":"             E::S {"},{"DocComment":"                 ref r,"},{"DocComment":"                 ref g,"},{"DocComment":"                 ref b,"},{"DocComment":"             } => {"},{"DocComment":"                 let mut sv = serializer.serialize_struct_variant(\"E\", 0, \"S\", 3)?;"},{"DocComment":"                 sv.serialize_field(\"r\", r)?;"},{"DocComment":"                 sv.serialize_field(\"g\", g)?;"},{"DocComment":"                 sv.serialize_field(\"b\", b)?;"},{"DocComment":"                 sv.end()"},{"DocComment":"             }"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10638},{"Deduplicated":4219},{"Deduplicated":2906},{"Deduplicated":4219},{"Deduplicated":659}],"output":{"HashConsedValue":[10734,{"Adt":{"id":{"Adt":2},"generics":{"regions":[],"types":[{"Deduplicated":10725},{"Deduplicated":10660}],"const_generics":[],"trait_refs":[]}}}]}},"default":null},"kind":{"TraitMethod":[19,29]}},null,null,null,null],"vtable":null},{"def_id":20,"item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["de",0]},{"Ident":["Deserializer",0]}],"span":{"data":{"file_id":47,"beg":{"line":945,"col":0},"end":{"line":945,"col":34}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A **data format** that can deserialize any data structure supported by"},{"DocComment":" Serde."},{"DocComment":""},{"DocComment":" The role of this trait is to define the deserialization half of the [Serde"},{"DocComment":" data model], which is a way to categorize every Rust data type into one of"},{"DocComment":" 29 possible types. Each method of the `Deserializer` trait corresponds to one"},{"DocComment":" of the types of the data model."},{"DocComment":""},{"DocComment":" Implementations of `Deserialize` map themselves into this data model by"},{"DocComment":" passing to the `Deserializer` a `Visitor` implementation that can receive"},{"DocComment":" these various types."},{"DocComment":""},{"DocComment":" The types that make up the Serde data model are:"},{"DocComment":""},{"DocComment":"  - **14 primitive types**"},{"DocComment":"    - bool"},{"DocComment":"    - i8, i16, i32, i64, i128"},{"DocComment":"    - u8, u16, u32, u64, u128"},{"DocComment":"    - f32, f64"},{"DocComment":"    - char"},{"DocComment":"  - **string**"},{"DocComment":"    - UTF-8 bytes with a length and no null terminator."},{"DocComment":"    - When serializing, all strings are handled equally. When deserializing,"},{"DocComment":"      there are three flavors of strings: transient, owned, and borrowed."},{"DocComment":"  - **byte array** - \\[u8\\]"},{"DocComment":"    - Similar to strings, during deserialization byte arrays can be"},{"DocComment":"      transient, owned, or borrowed."},{"DocComment":"  - **option**"},{"DocComment":"    - Either none or some value."},{"DocComment":"  - **unit**"},{"DocComment":"    - The type of `()` in Rust. It represents an anonymous value containing"},{"DocComment":"      no data."},{"DocComment":"  - **unit_struct**"},{"DocComment":"    - For example `struct Unit` or `PhantomData<T>`. It represents a named"},{"DocComment":"      value containing no data."},{"DocComment":"  - **unit_variant**"},{"DocComment":"    - For example the `E::A` and `E::B` in `enum E { A, B }`."},{"DocComment":"  - **newtype_struct**"},{"DocComment":"    - For example `struct Millimeters(u8)`."},{"DocComment":"  - **newtype_variant**"},{"DocComment":"    - For example the `E::N` in `enum E { N(u8) }`."},{"DocComment":"  - **seq**"},{"DocComment":"    - A variably sized heterogeneous sequence of values, for example `Vec<T>`"},{"DocComment":"      or `HashSet<T>`. When serializing, the length may or may not be known"},{"DocComment":"      before iterating through all the data. When deserializing, the length"},{"DocComment":"      is determined by looking at the serialized data."},{"DocComment":"  - **tuple**"},{"DocComment":"    - A statically sized heterogeneous sequence of values for which the"},{"DocComment":"      length will be known at deserialization time without looking at the"},{"DocComment":"      serialized data, for example `(u8,)` or `(String, u64, Vec<T>)` or"},{"DocComment":"      `[u64; 10]`."},{"DocComment":"  - **tuple_struct**"},{"DocComment":"    - A named tuple, for example `struct Rgb(u8, u8, u8)`."},{"DocComment":"  - **tuple_variant**"},{"DocComment":"    - For example the `E::T` in `enum E { T(u8, u8) }`."},{"DocComment":"  - **map**"},{"DocComment":"    - A heterogeneous key-value pairing, for example `BTreeMap<K, V>`."},{"DocComment":"  - **struct**"},{"DocComment":"    - A heterogeneous key-value pairing in which the keys are strings and"},{"DocComment":"      will be known at deserialization time without looking at the serialized"},{"DocComment":"      data, for example `struct S { r: u8, g: u8, b: u8 }`."},{"DocComment":"  - **struct_variant**"},{"DocComment":"    - For example the `E::S` in `enum E { S { r: u8, g: u8, b: u8 } }`."},{"DocComment":""},{"DocComment":" The `Deserializer` trait supports two entry point styles which enables"},{"DocComment":" different kinds of deserialization."},{"DocComment":""},{"DocComment":" 1. The `deserialize_any` method. Self-describing data formats like JSON are"},{"DocComment":"    able to look at the serialized data and tell what it represents. For"},{"DocComment":"    example the JSON deserializer may see an opening curly brace (`{`) and"},{"DocComment":"    know that it is seeing a map. If the data format supports"},{"DocComment":"    `Deserializer::deserialize_any`, it will drive the Visitor using whatever"},{"DocComment":"    type it sees in the input. JSON uses this approach when deserializing"},{"DocComment":"    `serde_json::Value` which is an enum that can represent any JSON"},{"DocComment":"    document. Without knowing what is in a JSON document, we can deserialize"},{"DocComment":"    it to `serde_json::Value` by going through"},{"DocComment":"    `Deserializer::deserialize_any`."},{"DocComment":""},{"DocComment":" 2. The various `deserialize_*` methods. Non-self-describing formats like"},{"DocComment":"    Postcard need to be told what is in the input in order to deserialize it."},{"DocComment":"    The `deserialize_*` methods are hints to the deserializer for how to"},{"DocComment":"    interpret the next piece of input. Non-self-describing formats are not"},{"DocComment":"    able to deserialize something like `serde_json::Value` which relies on"},{"DocComment":"    `Deserializer::deserialize_any`."},{"DocComment":""},{"DocComment":" When implementing `Deserialize`, you should avoid relying on"},{"DocComment":" `Deserializer::deserialize_any` unless you need to be told by the"},{"DocComment":" Deserializer what type is in the input. Know that relying on"},{"DocComment":" `Deserializer::deserialize_any` means your data type will be able to"},{"DocComment":" deserialize from self-describing formats only, ruling out Postcard and many"},{"DocComment":" others."},{"DocComment":""},{"DocComment":" [Serde data model]: https://serde.rs/data-model.html"},{"DocComment":""},{"DocComment":" # Lifetime"},{"DocComment":""},{"DocComment":" The `'de` lifetime of this trait is the lifetime of data that may be"},{"DocComment":" borrowed from the input when deserializing. See the page [Understanding"},{"DocComment":" deserializer lifetimes] for a more detailed explanation of these lifetimes."},{"DocComment":""},{"DocComment":" [Understanding deserializer lifetimes]: https://serde.rs/lifetimes.html"},{"DocComment":""},{"DocComment":" # Example implementation"},{"DocComment":""},{"DocComment":" The [example data format] presented on the website contains example code for"},{"DocComment":" a basic JSON `Deserializer`."},{"DocComment":""},{"DocComment":" [example data format]: https://serde.rs/data-format.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":"'de","mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Self_Error"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"data":{"file_id":47,"beg":{"line":948,"col":16},"end":{"line":948,"col":21}},"generated_from_span":null},"origin":{"TraitItem":0},"trait_":{"regions":[],"skip_binder":{"id":31,"generics":{"regions":[],"types":[{"Deduplicated":10639}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[{"index":0,"name":"V"},{"index":1,"name":"Clause0_Value"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":47,"beg":{"line":961,"col":11},"end":{"line":961,"col":23}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":32,"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Dedupl