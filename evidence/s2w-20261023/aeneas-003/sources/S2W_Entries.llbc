{"charon_version":"0.1.223","translated":{"crate_name":"aspis_r1_cost_probe_program","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::r1_pool_adapter::owned::stage1","crate::r1_pool_adapter::owned::stage2"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["crate::observer","aspis_statement::pool_v1::pair_forest_terminal::PoolV1PairForestTerminalStatementV1","aspis_statement::pool_v1::pair_forest_terminal::PoolV1PairForestTerminalCommonV1","aspis_statement::pool_v1::pair_terminal::PoolV1PairVerifiedAfterstateV1","aspis_statement::pool_v1::pair_forest_terminal::_::common","aspis_statement::pool_v1::pair_forest_terminal::_::semantic_public","aspis_statement::pool_v1::pair_forest_semantic_terminal::r0::Public","aspis_r1_cost_probe::verifier::Error","aspis_r1_cost_probe::verifier::Phase","aspis_r1_cost_probe::transport::Variant","aspis_r1_cost_probe::transport::_::tag","core::option::Option","core::result::Result","core::result::_::map_err","solana_program_error::ProgramError","aspis_statement::pool_v1::pair_tree_profile::PoolV1PairLatePublicStatementV1","aspis_statement::pool_v1::pair_tree_profile::PoolV1PairLiveSnapshotV1","aspis_statement::pool_v1::payment_relation::PoolV1PrivateTransferPublicV1","aspis_statement::pool_v1::payment_relation::PoolV1WithdrawalPublicV1","aspis_core::field::M31","aspis_core::field::CM31","aspis_core::field::QM31","crate::SolanaDigest","aspis_statement::pool_v1::pair_forest_terminal::PoolV1PairForestTerminalFormatErrorV1","aspis_statement::pool_v1::pair_terminal::PoolV1PairVerifierTransportErrorV1","aspis_statement::pool_v1::pair_forest_accounts::PoolV1PairForestAccountErrorV1","aspis_statement::pool_v1::payment_relation::PoolV1PaymentStatementFormatError","aspis_statement::pool_v1::pair_tree_profile::PoolV1PairLatePublicStatementErrorV1","aspis_statement::pool_v1::pair_tree_profile::PoolV1PairLiveSnapshotErrorV1","aspis_statement::pool_v1::incremental_merkle::PoolV1TreeError","crate::r1_pool_adapter::AuthenticatedAsq8Accounts","crate::r1_pool_adapter::ValidatedAsqa","crate::r1_pool_adapter::ScannedAsqaProof","solana_pubkey::Pubkey","solana_pubkey::PubkeyError","aspis_statement::pool_v1::pair_forest_accounts::PoolV1PairForestMasterV1","aspis_statement::pool_v1::pair_forest_accounts::PoolV1PairForestCheckpointV1","aspis_statement::pool_v1::pair_forest_accounts::PoolV1PairForestLaneStateV1","aspis_statement::pool_v1::verifier_registry::VerifierRegistryV1","aspis_statement::pool_v1::verifier_registry::VerifierRegistryV2","aspis_statement::pool_v1::verifier_registry::VerifierRegistryEntryV1","aspis_statement::pool_v1::verifier_registry::VerifierRegistryEntryV2","aspis_statement::pool_v1::verifier_registry::PoolV1VerifierRegistryFormatError","aspis_statement::pool_v1::pool_identity::PoolIdentityV1","aspis_statement::pool_v1::verifier_policy::VerifierPolicyV1","aspis_statement::pool_v1::incremental_merkle::IncrementalMerkleTreeV1","aspis_statement::pool_v1::format::PoolIdentityV1","aspis_statement::pool_v1::format::VerifierPolicyV1","aspis_statement::pool_v1::pair_forest_terminal::PoolV1PairForestTerminalRequestV1","aspis_statement::pool_v1::pair_forest_terminal::PoolV1PairForestTerminalPaymentV1","aspis_statement::pool_v1::format::PoolV1FormatError","aspis_statement::pool_v1::verifier_registry::VerifierEntryStatusV1","crate::r1_pool_adapter::readonly_meta_ok","crate::r1_pool_adapter::readonly_buffer_meta_ok","aspis_r1_cost_probe::verifier::PROOF_BYTES","aspis_statement::pool_v1::pair_terminal::POOL_V1_PAIR_VERIFIED_AFTERSTATE_BYTES","aspis_statement::pool_v1::pair_forest_terminal::POOL_V1_PAIR_FOREST_TERMINAL_REQUEST_MAGIC","aspis_statement::pool_v1::pair_forest_terminal::POOL_V1_PAIR_FOREST_TERMINAL_REQUEST_BYTES","aspis_statement::pool_v1::pair_forest_terminal::POOL_V1_PAIR_FOREST_TERMINAL_STATEMENT_BYTES","crate::r1_pool_adapter::PROFILE_BINDING","crate::r1_pool_adapter::RELEASE_BINDING","crate::r1_pool_adapter::AUDIT_POLICY_BINDING","crate::r1_pool_adapter::PAIR_FOREST_MASTER_SEED","crate::r1_pool_adapter::PAIR_FOREST_LANE_SEED","crate::r1_pool_adapter::PAIR_FOREST_CHECKPOINT_SEED","crate::r1_pool_adapter::VERIFIER_REGISTRY_SEED","crate::r1_pool_adapter::VERIFIER_ENTRY_SEED","crate::r1_pool_adapter::VERIFIER_REGISTRY_V2_SEED","crate::r1_pool_adapter::VERIFIER_ENTRY_V2_SEED","aspis_r1_cost_probe::compact::MAGIC","aspis_r1_cost_probe::compact::HEADER","aspis_r1_cost_probe::compact::SPLIT","aspis_r1_cost_probe::compact::QUERIES","aspis_r1_cost_probe::compact::SEMANTIC_ROWS","aspis_r1_cost_probe::compact::LOGICAL_SEMANTIC","aspis_r1_cost_probe::compact::SEMANTIC_COMPACT_VALUES","aspis_r1_cost_probe::compact::COMPACT_SEMANTIC","aspis_r1_cost_probe::compact::COMPACT_Y1","aspis_r1_cost_probe::compact::LOGICAL_Y1","aspis_r1_cost_probe::compact::OPENING","aspis_r1_cost_probe::compact::OFF_SEMANTIC","aspis_r1_cost_probe::compact::OFF_Y1","aspis_r1_cost_probe::compact::OFF_INACTIVE","aspis_r1_cost_probe::compact::OFF_ROUND0","aspis_r1_cost_probe::compact::OFF_FOLDED_ROOT","aspis_r1_cost_probe::compact::OFF_ROUND1","aspis_r1_cost_probe::compact::OFF_FINAL","aspis_r1_cost_probe::compact::FINAL_LEN","aspis_r1_cost_probe::compact::OFF_OPENINGS","aspis_r1_cost_probe::compact::OFF_NODES","aspis_r1_cost_probe::compact::FIXED","aspis_r1_cost_probe::compact::MAX_NODES","aspis_r1_cost_probe::compact::MAX_PROOF","aspis_r1_cost_probe::compact::SLOT_NODES","aspis_r1_cost_probe::compact::fn","aspis_r1_cost_probe::compact::PROOF_BYTES","aspis_r1_cost_probe::verifier::SEMANTIC_BYTES","aspis_statement::pool_v1::pair_terminal::POOL_V1_PAIR_VERIFIED_AFTERSTATE_PAYLOAD_BYTES","aspis_statement::pool_v1::payment_relation::POOL_V1_PAYMENT_STATEMENT_BYTES","core::option::_::ok_or","core::result::_::clone","crate::r1_pool_adapter::owned::stage1","crate::r1_pool_adapter::owned::stage2","crate::r1_pool_adapter::owned::OwnedAccount"],"opaque":["crate","aspis_core","aspis_statement","aspis_r1_cost_probe","solana_program_error","crate::r1_pool_adapter::owned::snapshot","solana_account_info::AccountInfo"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":"Initializers","unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-s2w-20261023/S2W_Entries.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"programs/r1-cost-probe/src/r1_pool_adapter_owned.rs"},"crate_name":"aspis_r1_cost_probe_program","contents":"//! Owned caller boundary. SDK guards exist only in snapshot/write wrappers.\nuse super::*;\nuse aspis_statement::pool_v1::{\n    POOL_V1_PAIR_FOREST_MASTER_ACCOUNT_BYTES, POOL_V1_PAIR_FOREST_CHECKPOINT_ACCOUNT_BYTES,\n    POOL_V1_VERIFIER_REGISTRY_BYTES, POOL_V1_VERIFIER_REGISTRY_V2_BYTES,\n    POOL_V1_VERIFIER_ENTRY_BYTES, POOL_V1_VERIFIER_ENTRY_V2_BYTES,\n};\n\nstruct OwnedAccount {\n    key: Pubkey,\n    owner: Pubkey,\n    is_signer: bool,\n    is_writable: bool,\n    executable: bool,\n    length: Result<usize, ProgramError>,\n    bytes: Result<Vec<u8>, ProgramError>,\n}\nimpl OwnedAccount {\n    fn key(&self) -> &Pubkey { &self.key }\n    fn owner(&self) -> &Pubkey { &self.owner }\n    fn data(&self) -> Result<&[u8], ProgramError> {\n        match &self.bytes { Ok(bytes) => Ok(bytes), Err(error) => Err(error.clone()) }\n    }\n    fn data_len(&self) -> Result<usize, ProgramError> { self.length.clone() }\n}\n\n// Copy only decoder-admitted lengths; malformed lengths retain their original\n// length and a deferred error. No adversarial account length drives allocation.\nfn snapshot(account: &AccountInfo<'_>, length1: usize, length2: usize) -> OwnedAccount {\n    let (length, bytes) = match account.try_borrow_data() {\n        Ok(data) => {\n            let length = data.len();\n            let bytes = if length == length1 || length == length2 {\n                Ok(data.to_vec())\n            } else { Err(ProgramError::InvalidAccountData) };\n            (Ok(length), bytes)\n        }\n        Err(error) => (Err(error.clone()), Err(error)),\n    };\n    OwnedAccount { key: *account.key, owner: *account.owner,\n        is_signer: account.is_signer, is_writable: account.is_writable,\n        executable: account.executable, length, bytes }\n}\n\nfn require_readonly_buffer(account: &OwnedAccount) -> ProgramResult {\n    readonly_buffer_meta_ok(account.is_signer, account.is_writable, account.executable)\n}\nfn require_readonly_account(account: &OwnedAccount, owner: &Pubkey) -> ProgramResult {\n    readonly_meta_ok(account.owner(), owner, account.is_signer, account.is_writable, account.executable)\n}\nfn require_verifier_checkpoint(account: &OwnedAccount, program_id: &Pubkey, writable: bool) -> ProgramResult {\n    if account.owner() != program_id || account.is_signer || account.executable\n        || account.is_writable != writable\n        || account.data_len()? != verifier::checkpoint_size(Variant::S2) {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    Ok(())\n}\nfn require_distinct_accounts<const N: usize>(accounts: &[&OwnedAccount; N]) -> ProgramResult {\n    let mut index = 0;\n    while index < N {\n        let mut previous = 0;\n        while previous < index {\n            if accounts[previous].key() == accounts[index].key() {\n                return Err(ProgramError::InvalidArgument);\n            }\n            previous += 1;\n        }\n        index += 1;\n    }\n    Ok(())\n}\nfn require_zero(bytes: &[u8]) -> ProgramResult {\n    let mut index = 0;\n    while index < bytes.len() {\n        if bytes[index] != 0 { return Err(ProgramError::AccountAlreadyInitialized); }\n        index += 1;\n    }\n    Ok(())\n}\n#[inline(never)]\nfn authenticate_invariant_release_registry(\n    verifier_program: &Pubkey,\n    pool_program: &Pubkey,\n    master_account: &OwnedAccount,\n    master: &PoolV1PairForestMasterV1,\n    registry_account: &OwnedAccount,\n    entry_account: &OwnedAccount,\n    current_slot: u64,\n) -> ProgramResult {\n    // Versioned, owner-authenticated registry images carry the canonical bumps\n    // saved by their initializers. Address checks below perform one derivation;\n    // they neither search for a bump nor establish canonicality independently.\n    if pool_program.to_bytes() != pool_program_id()\n        || master.verifier_policy.flags & POOL_V1_VERIFIER_POLICY_FLAG_IMMUTABLE_REGISTRY == 0\n        || master.verifier_policy.registry_program != registry_program_id()\n        || master.verifier_policy.registry_authority != [0u8; 32]\n        || master.verifier_policy.policy_binding != AUDIT_POLICY_BINDING\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    validate_verifier_policy_v1(&master.verifier_policy)\n        .map_err(|_| ProgramError::InvalidAccountData)?;\n    let registry_program = Pubkey::new_from_array(registry_program_id());\n    require_readonly_account(registry_account, &registry_program)?;\n    let immutable_deployment =\n        master.verifier_policy.flags & POOL_V1_VERIFIER_POLICY_FLAG_IMMUTABLE_DEPLOYMENT != 0;\n    if immutable_deployment {\n        let loader = bpf_loader_upgradeable::id();\n        let registry = decode_verifier_registry_v2(registry_account.data()?)\n            .map_err(|_| ProgramError::InvalidAccountData)?;\n        let expected_registry = Pubkey::create_program_address(\n            &[\n                VERIFIER_REGISTRY_V2_SEED,\n                master_account.key().as_ref(),\n                &[registry.bump],\n            ],\n            &registry_program,\n        )\n        .map_err(|_| ProgramError::InvalidAccountData)?;\n        if registry_account.key() != &expected_registry {\n            return Err(ProgramError::InvalidAccountData);\n        }\n        let registry_programdata = Pubkey::create_program_address(\n            &[registry_program.as_ref(), &[registry.programdata_bump]],\n            &loader,\n        )\n        .map_err(|_| ProgramError::InvalidAccountData)?;\n        if registry.pool != master_account.key().to_bytes()\n            || registry.authority != master.verifier_policy.registry_authority\n            || registry.policy_binding != master.verifier_policy.policy_binding\n            || registry.registry_program != registry_program.to_bytes()\n            || registry.loader_program != loader.to_bytes()\n            || registry.programdata_address != registry_programdata.to_bytes()\n            || !registry.is_immutable()\n            || registry.is_paused()\n        {\n            return Err(ProgramError::InvalidAccountData);\n        }\n        require_readonly_account(entry_account, &registry_program)?;\n        let entry = decode_verifier_registry_entry_v2(entry_account.data()?)\n            .map_err(|_| ProgramError::InvalidAccountData)?;\n        let expected_entry = Pubkey::create_program_address(\n            &[\n                VERIFIER_ENTRY_V2_SEED,\n                master_account.key().as_ref(),\n                &PROFILE_BINDING,\n                &RELEASE_BINDING,\n                &[entry.bump],\n            ],\n            &registry_program,\n        )\n        .map_err(|_| ProgramError::InvalidAccountData)?;\n        if entry_account.key() != &expected_entry {\n            return Err(ProgramError::InvalidAccountData);\n        }\n        let verifier_programdata = Pubkey::create_program_address(\n            &[verifier_program.as_ref(), &[entry.programdata_bump]],\n            &loader,\n        )\n        .map_err(|_| ProgramError::InvalidAccountData)?;\n        if entry.pool != master_account.key().to_bytes()\n            || entry.policy_binding != AUDIT_POLICY_BINDING\n            || entry.verifier_program != verifier_program.to_bytes()\n            || entry.profile_binding != PROFILE_BINDING\n            || entry.release_binding != RELEASE_BINDING\n            || entry.statement_version != POOL_V1_PAIR_FOREST_TERMINAL_VERSION\n            || entry.loader_program != loader.to_bytes()\n            || entry.programdata_address != verifier_programdata.to_bytes()\n            || entry.expected_upgrade_authority != [0u8; 32]\n            || !entry.is_active_at(current_slot)\n        {\n            return Err(ProgramError::InvalidAccountData);\n        }\n        return Ok(());\n    }\n\n    let registry = decode_verifier_registry_v1(registry_account.data()?)\n        .map_err(|_| ProgramError::InvalidAccountData)?;\n    let expected_registry = Pubkey::create_program_address(\n        &[\n            VERIFIER_REGISTRY_SEED,\n            master_account.key().as_ref(),\n            &[registry.bump],\n        ],\n        &registry_program,\n    )\n    .map_err(|_| ProgramError::InvalidAccountData)?;\n    if registry_account.key() != &expected_registry {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    if registry.pool != master_account.key().to_bytes()\n        || registry.authority != master.verifier_policy.registry_authority\n        || registry.policy_binding != master.verifier_policy.policy_binding\n        || !registry.is_immutable()\n        || registry.is_paused()\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    require_readonly_account(entry_account, &registry_program)?;\n    let entry = decode_verifier_registry_entry_v1(entry_account.data()?)\n        .map_err(|_| ProgramError::InvalidAccountData)?;\n    let expected_entry = Pubkey::create_program_address(\n        &[\n            VERIFIER_ENTRY_SEED,\n            master_account.key().as_ref(),\n            &PROFILE_BINDING,\n            &RELEASE_BINDING,\n            &[entry.bump],\n        ],\n        &registry_program,\n    )\n    .map_err(|_| ProgramError::InvalidAccountData)?;\n    if entry_account.key() != &expected_entry {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    if entry.pool != master_account.key().to_bytes()\n        || entry.policy_binding != AUDIT_POLICY_BINDING\n        || entry.verifier_program != verifier_program.to_bytes()\n        || entry.profile_binding != PROFILE_BINDING\n        || entry.release_binding != RELEASE_BINDING\n        || entry.statement_version != POOL_V1_PAIR_FOREST_TERMINAL_VERSION\n        || !entry.is_active_at(current_slot)\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    Ok(())\n}\n\n#[inline(never)]\nfn authenticate_asq8_accounts(\n    verifier_program: &Pubkey,\n    accounts: &[OwnedAccount],\n    pool_program: &Pubkey,\n    output_lane: u8,\n    current_slot: u64,\n) -> Result<AuthenticatedAsq8Accounts, ProgramError> {\n    let [proof_account, master_account, checkpoint_account, lane_account, registry_account, entry_account, verifier_checkpoint] =\n        accounts\n    else {\n        return Err(if accounts.len() < 7 {\n            ProgramError::NotEnoughAccountKeys\n        } else {\n            ProgramError::InvalidArgument\n        });\n    };\n    require_readonly_buffer(proof_account)?;\n    require_verifier_checkpoint(verifier_checkpoint, verifier_program, false)?;\n    require_readonly_account(master_account, pool_program)?;\n    require_readonly_account(checkpoint_account, pool_program)?;\n    require_readonly_account(lane_account, pool_program)?;\n    require_distinct_accounts(&[\n        proof_account,\n        master_account,\n        checkpoint_account,\n        lane_account,\n        registry_account,\n        entry_account,\n        verifier_checkpoint,\n    ])?;\n\n    let master = decode_master_box(master_account.data()?)?;\n    if master.identity.pool != master_account.key().to_bytes()\n        || master.initialized_lane_mask != POOL_V1_PAIR_FOREST_ALL_LANES_MASK\n        || Pubkey::create_program_address(\n            &[\n                PAIR_FOREST_MASTER_SEED,\n                Pubkey::new_from_array(master.identity.asset_mint).as_ref(),\n                &[master.bump],\n            ],\n            pool_program,\n        )\n        .map_err(|_| ProgramError::InvalidAccountData)? != *master_account.key()\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    authenticate_invariant_release_registry(\n        verifier_program,\n        pool_program,\n        master_account,\n        &master,\n        registry_account,\n        entry_account,\n        current_slot,\n    )?;\n\n    let checkpoint = decode_checkpoint_box(checkpoint_account.data()?)?;\n    if checkpoint.master != master_account.key().to_bytes()\n        || checkpoint.deployment_domain != master.identity.deployment_domain\n        || Pubkey::create_program_address(\n            &[\n                PAIR_FOREST_CHECKPOINT_SEED,\n                master_account.key().as_ref(),\n                &checkpoint.checkpoint_sequence.to_le_bytes(),\n                &[checkpoint.bump],\n            ],\n            pool_program,\n        )\n        .map_err(|_| ProgramError::InvalidAccountData)? != *checkpoint_account.key()\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    let selected_lane = decode_lane_from_pool_release(lane_account.data()?)?;\n    if selected_lane.master != master_account.key().to_bytes()\n        || selected_lane.lane_id != output_lane\n        || Pubkey::create_program_address(\n            &[\n                PAIR_FOREST_LANE_SEED,\n                master_account.key().as_ref(),\n                &[output_lane],\n                &[selected_lane.bump],\n            ],\n            pool_program,\n        )\n        .map_err(|_| ProgramError::InvalidAccountData)? != *lane_account.key()\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    let live_snapshot = Box::new(PoolV1PairLiveSnapshotV1 {\n        pool: master_account.key().to_bytes(),\n        deployment_domain: master.identity.deployment_domain,\n        sequence: selected_lane.tree.next_leaf_index,\n        next_pair_index: selected_lane.tree.next_leaf_index,\n        current_root: selected_lane.tree.root,\n        frontier: selected_lane.tree.frontier,\n    });\n    Ok(AuthenticatedAsq8Accounts {\n        master_account: master_account.key().to_bytes(),\n        checkpoint_account: checkpoint_account.key().to_bytes(),\n        selected_lane_account: lane_account.key().to_bytes(),\n        master,\n        checkpoint,\n        selected_lane,\n        live_snapshot,\n    })\n}\n\n#[inline(never)]\nfn validate_asq8(\n    verifier_program: &Pubkey,\n    accounts: &[OwnedAccount],\n    instruction_data: &[u8],\n    current_slot: Result<u64, ProgramError>,\n) -> Result<ValidatedAsqa, ProgramError> {\n    if instruction_data.len() != POOL_V1_PAIR_FOREST_TERMINAL_REQUEST_BYTES {\n        return Err(ProgramError::InvalidInstructionData);\n    }\n    let request = decode_pool_v1_pair_forest_terminal_request_v1(instruction_data)\n        .map_err(|_| ProgramError::InvalidInstructionData)?;\n    if request.verifier_profile != PROFILE_BINDING\n        || request.verifier_release != RELEASE_BINDING\n        || request.pool_program != pool_program_id()\n    {\n        return Err(ProgramError::InvalidInstructionData);\n    }\n    let pool_program = Pubkey::new_from_array(request.pool_program);\n    let output_lane = pool_v1_pair_forest_output_lane_v1(request.public.nullifier())\n        .map_err(|_| ProgramError::InvalidInstructionData)?;\n    let authenticated = authenticate_asq8_accounts(\n        verifier_program,\n        accounts,\n        &pool_program,\n        output_lane,\n        current_slot?,\n    )?;\n    let proof_account = accounts.first().ok_or(ProgramError::NotEnoughAccountKeys)?;\n    let scanned = scan_proof_buffer(proof_account.data()?)?;\n    let statement =\n        reconstruct_asq8_statement(&request, &authenticated, &scanned.candidate_afterstate)?;\n    Ok(ValidatedAsqa {\n        statement,\n        proof_length: scanned.proof_length,\n    })\n}\n\n#[inline(never)]\nfn stage1_owned(program_id: &Pubkey, accounts: &[OwnedAccount], data: &[u8]) -> Result<Vec<u8>, ProgramError> {\n    if !(data == &[3, 10] || data == &[3, 11]) || accounts.len() != 3 {\n        return Err(ProgramError::InvalidInstructionData);\n    }\n    let proof_account = &accounts[0];\n    let public_account = &accounts[1];\n    let checkpoint_account = &accounts[2];\n    require_distinct_accounts(&[proof_account, public_account, checkpoint_account])?;\n    require_readonly_buffer(proof_account)?;\n    require_readonly_buffer(public_account)?;\n    require_verifier_checkpoint(checkpoint_account, program_id, true)?;\n    let checkpoint_data = checkpoint_account.data()?;\n    require_zero(checkpoint_data)?;\n    let public_data = public_account.data()?;\n    let statement = decode_public_statement_box(&public_data)?;\n    validate_pool_v1_pair_forest_terminal_statement_v1(&statement)\n        .map_err(|_| ProgramError::InvalidAccountData)?;\n    let candidate = encode_pool_v1_pair_verified_afterstate_v1(\n        &statement.common().lane_transition.candidate_afterstate,\n    )\n    .map_err(|_| ProgramError::InvalidAccountData)?;\n\n    let proof_data = proof_account.data()?;\n    let proof_length = verifier::PROOF_BYTES;\n    let proof_start = POOL_V1_PAIR_VERIFIED_AFTERSTATE_BYTES;\n    let proof_end = proof_start.checked_add(proof_length)\n        .ok_or(ProgramError::InvalidAccountData)?;\n    if proof_data.len() != proof_end\n        || proof_data[..proof_start] != candidate\n        || proof_data[proof_start + 8] != Variant::S2.tag()\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    let checkpoint = super::super::first_decoded(statement.semantic_public(), &public_data, &proof_data[proof_start..proof_end], data[1] as usize)?;\n    if checkpoint.len() != checkpoint_data.len() {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    Ok(checkpoint)\n}\n\n#[inline(never)]\nfn stage2_owned(program_id: &Pubkey, accounts: &[OwnedAccount], data: &[u8], current_slot: Result<u64, ProgramError>) -> ProgramResult {\n    if accounts.len() != 7 || data.get(..4) != Some(&POOL_V1_PAIR_FOREST_TERMINAL_REQUEST_MAGIC[..])\n    {\n        return Err(ProgramError::InvalidInstructionData);\n    }\n    let validated = validate_asq8(program_id, accounts, data, current_slot)?;\n    let proof_data = accounts[0].data()?;\n    let checkpoint_data = accounts[6].data()?;\n    let proof_start = POOL_V1_PAIR_VERIFIED_AFTERSTATE_BYTES;\n    let proof_end = proof_start.checked_add(validated.proof_length)\n        .ok_or(ProgramError::InvalidAccountData)?;\n    if proof_data.len() != proof_end {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    let public_bytes = encode_pool_v1_pair_forest_terminal_statement_v1(&validated.statement)\n        .map_err(|_| ProgramError::InvalidInstructionData)?;\n    if public_bytes.len() != POOL_V1_PAIR_FOREST_TERMINAL_STATEMENT_BYTES {\n        return Err(ProgramError::InvalidInstructionData);\n    }\n    verifier::tx2_authenticated(\n        &public_bytes,\n        &proof_data[proof_start..proof_end],\n        &checkpoint_data,\n        super::super::SolanaDigest,\n        super::super::observer(),\n    )\n    .map_err(super::super::error)?;\n    emit_result(&validated.statement)\n}\n\npub(super) fn stage1(program_id: &Pubkey, accounts: &[AccountInfo<'_>], data: &[u8]) -> ProgramResult {\n    if !(data == &[3, 10] || data == &[3, 11]) || accounts.len() != 3 {\n        return Err(ProgramError::InvalidInstructionData);\n    }\n    let owned = [\n        snapshot(&accounts[0], POOL_V1_PAIR_VERIFIED_AFTERSTATE_BYTES + verifier::PROOF_BYTES, POOL_V1_PAIR_VERIFIED_AFTERSTATE_BYTES + verifier::PROOF_BYTES),\n        snapshot(&accounts[1], POOL_V1_PAIR_FOREST_TERMINAL_STATEMENT_BYTES, POOL_V1_PAIR_FOREST_TERMINAL_STATEMENT_BYTES),\n        snapshot(&accounts[2], CHECKPOINT_TAIL_BYTES, CHECKPOINT_TAIL_BYTES),\n    ];\n    let checkpoint = stage1_owned(program_id, &owned, data)?;\n    accounts[2].try_borrow_mut_data()?.copy_from_slice(&checkpoint);\n    #[cfg(feature=\"cu-profiling\")]\n    { msg!(\"r1:pool-adapter-stage1-checkpoint-written\"); solana_program::log::sol_log_compute_units(); }\n    Ok(())\n}\n\npub(super) fn stage2(program_id: &Pubkey, accounts: &[AccountInfo<'_>], data: &[u8]) -> ProgramResult {\n    if accounts.len() != 7 || data.get(..4) != Some(&POOL_V1_PAIR_FOREST_TERMINAL_REQUEST_MAGIC[..]) {\n        return Err(ProgramError::InvalidInstructionData);\n    }\n    program::set_return_data(&[]);\n    #[cfg(feature=\"cu-profiling\")]\n    { msg!(\"r1:pool-adapter-stage2-begin\"); solana_program::log::sol_log_compute_units(); }\n    let owned = [\n        snapshot(&accounts[0], POOL_V1_PAIR_VERIFIED_AFTERSTATE_BYTES + verifier::PROOF_BYTES, POOL_V1_PAIR_VERIFIED_AFTERSTATE_BYTES + verifier::PROOF_BYTES),\n        snapshot(&accounts[1], POOL_V1_PAIR_FOREST_MASTER_ACCOUNT_BYTES, POOL_V1_PAIR_FOREST_MASTER_ACCOUNT_BYTES),\n        snapshot(&accounts[2], POOL_V1_PAIR_FOREST_CHECKPOINT_ACCOUNT_BYTES, POOL_V1_PAIR_FOREST_CHECKPOINT_ACCOUNT_BYTES),\n        snapshot(&accounts[3], POOL_V1_PAIR_FOREST_LANE_ACCOUNT_BYTES, POOL_V1_PAIR_FOREST_LANE_ACCOUNT_BYTES),\n        snapshot(&accounts[4], POOL_V1_VERIFIER_REGISTRY_BYTES, POOL_V1_VERIFIER_REGISTRY_V2_BYTES),\n        snapshot(&accounts[5], POOL_V1_VERIFIER_ENTRY_BYTES, POOL_V1_VERIFIER_ENTRY_V2_BYTES),\n        snapshot(&accounts[6], CHECKPOINT_TAIL_BYTES, CHECKPOINT_TAIL_BYTES),\n    ];\n    let current_slot = match Clock::get() { Ok(clock) => Ok(clock.slot), Err(error) => Err(error) };\n    stage2_owned(program_id, &owned, data, current_slot)\n}\n"},{"id":1,"name":{"Local":"programs/r1-cost-probe/src/r1_pool_adapter.rs"},"crate_name":"aspis_r1_cost_probe_program","contents":"//! Default-off Pool adapter for the R1 S2 split.\n//!\n//! ASQ8 authentication and reconstruction are copied from the verifier's\n//! `v7_pair_forest_dispatch` path. This module keeps the audit-pinned Pool,\n//! registry, and policy bindings while replacing only its proof engine with\n//! the R1 `tx1`/`tx2` checkpoints. Admitted routes read raw proof/public buffers\n//! of any owner and use a separate verifier-owned checkpoint. Legacy lifecycle\n//! helpers below are unreachable through the release entrypoint guard.\n\nextern crate alloc;\n\nuse alloc::boxed::Box;\nuse aspis_core::field::M31;\nuse aspis_r1_cost_probe::{transport::Variant, verifier};\nuse aspis_statement::decode_digest_canonical;\nuse aspis_statement::pool_v1::{\n    decode_pool_v1_pair_forest_checkpoint_v1, decode_pool_v1_pair_forest_master_v1,\n    decode_pool_v1_pair_forest_terminal_request_v1,\n    decode_pool_v1_pair_forest_terminal_statement_v1, decode_pool_v1_pair_verified_afterstate_v1,\n    decode_verifier_registry_entry_v1, decode_verifier_registry_entry_v2,\n    decode_verifier_registry_v1, decode_verifier_registry_v2,\n    encode_pool_v1_pair_forest_terminal_result_v1,\n    encode_pool_v1_pair_forest_terminal_statement_v1, encode_pool_v1_pair_verified_afterstate_v1,\n    pool_v1_pair_forest_output_lane_v1,\n    validate_pool_v1_pair_forest_terminal_result_against_statement_v1,\n    validate_pool_v1_pair_forest_terminal_statement_v1, validate_verifier_policy_v1,\n    IncrementalMerkleTreeV1, PoolV1PairForestCheckpointV1, PoolV1PairForestLaneStateV1,\n    PoolV1PairForestMasterV1, PoolV1PairForestTerminalCommonV1, PoolV1PairForestTerminalPaymentV1,\n    PoolV1PairForestTerminalRequestV1, PoolV1PairForestTerminalResultV1,\n    PoolV1PairForestTerminalStatementV1, PoolV1PairLatePublicStatementV1, PoolV1PairLiveSnapshotV1,\n    POOL_V1_DIGEST_ENCODING_VERSION, POOL_V1_PAIR_CAPACITY,\n    POOL_V1_PAIR_FOREST_ACCOUNT_FORMAT_BINDING, POOL_V1_PAIR_FOREST_ALL_LANES_MASK,\n    POOL_V1_PAIR_FOREST_LANE_ACCOUNT_BYTES, POOL_V1_PAIR_FOREST_LANE_COUNT,\n    POOL_V1_PAIR_FOREST_LANE_HEADER_BYTES, POOL_V1_PAIR_FOREST_LANE_MAGIC,\n    POOL_V1_PAIR_FOREST_LANE_VERSION, POOL_V1_PAIR_FOREST_TERMINAL_REQUEST_BYTES,\n    POOL_V1_PAIR_FOREST_TERMINAL_REQUEST_MAGIC, POOL_V1_PAIR_FOREST_TERMINAL_RESULT_BYTES,\n    POOL_V1_PAIR_FOREST_TERMINAL_RESULT_MAGIC, POOL_V1_PAIR_FOREST_TERMINAL_STATEMENT_BYTES,\n    POOL_V1_PAIR_FOREST_TERMINAL_VERSION, POOL_V1_PAIR_TREE_DEPTH,\n    POOL_V1_PAIR_VERIFIED_AFTERSTATE_BYTES, POOL_V1_TREE_HASH_VERSION, POOL_V1_TREE_STATE_MAGIC,\n    POOL_V1_TREE_STATE_VERSION, POOL_V1_VERIFIER_POLICY_FLAG_IMMUTABLE_DEPLOYMENT,\n    POOL_V1_VERIFIER_POLICY_FLAG_IMMUTABLE_REGISTRY, POOL_V1_VERIFIER_PROOF_ACCOUNT_HEADER_BYTES,\n    POOL_V1_VERIFIER_PROOF_ACCOUNT_MAGIC,\n};\nuse solana_program::{\n    account_info::AccountInfo, bpf_loader_upgradeable, clock::Clock, entrypoint::ProgramResult,\n    hash::hashv, msg, program, program_error::ProgramError, pubkey::Pubkey, sysvar::Sysvar,\n};\n\n#[path = \"../../aspis-verifier/src/v7_pair_empty_roots.rs\"]\nmod v7_pair_empty_roots;\n\nconst ASPU_HEADER: usize = POOL_V1_VERIFIER_PROOF_ACCOUNT_HEADER_BYTES;\nconst ASPU_AUTHORITY: core::ops::Range<usize> = 8..40;\nconst CHECKPOINT_TAIL_BYTES: usize = 1_768;\nconst ASRU_MAGIC: [u8; 4] = *b\"ASRU\";\nconst ASRU_BODY_BYTES: usize = POOL_V1_PAIR_FOREST_TERMINAL_STATEMENT_BYTES;\n#[cfg(not(feature = \"private-leaf-salts\"))]\nconst PROFILE_BINDING: [u8; 32] = [\n    0x78, 0x17, 0x1b, 0x56, 0x9e, 0xa7, 0xbc, 0xe5, 0x97, 0x63, 0xa2, 0xb5, 0x78, 0x81, 0x06, 0xa7,\n    0x49, 0xbe, 0xd7, 0x47, 0x75, 0x6c, 0xf2, 0xd2, 0x00, 0x69, 0x99, 0x37, 0x92, 0x19, 0x13, 0xe9,\n];\n#[cfg(not(feature = \"private-leaf-salts\"))]\nconst RELEASE_BINDING: [u8; 32] = [\n    0x45, 0x90, 0xcd, 0x06, 0x35, 0x37, 0xb3, 0xb0, 0x2f, 0xae, 0xb1, 0x0d, 0x9a, 0x7f, 0x39, 0x99,\n    0x3f, 0xbe, 0x4b, 0xb6, 0x20, 0x30, 0x53, 0x32, 0x8d, 0x60, 0x0d, 0xbd, 0x48, 0x1c, 0xe0, 0x34,\n];\n#[cfg(feature = \"private-leaf-salts\")]\nconst PROFILE_BINDING: [u8; 32] = [\n    0x57,0x94,0x73,0x13,0xd2,0x32,0x64,0x1a,0xd8,0x15,0x7d,0x66,0xbf,0xaf,0xfa,0xb1,\n    0x1e,0x4c,0x3a,0x99,0x33,0x1d,0x18,0xf4,0x4b,0xfa,0xca,0xb6,0x89,0x97,0x37,0xd3,\n];\n#[cfg(feature = \"private-leaf-salts\")]\nconst RELEASE_BINDING: [u8; 32] = [\n    0xe2,0x94,0xaf,0xbc,0x14,0xef,0x6a,0xfe,0x76,0xb8,0x47,0xde,0xf4,0x44,0x52,0xf8,\n    0x4c,0xc3,0x72,0x80,0x64,0x65,0x76,0x07,0xb5,0x44,0xa5,0x39,0xca,0x9b,0x32,0x3a,\n];\n// Retained deployment data, never instruction immediates. The SBF linker merges\n// these named input sections into .rodata; the release audit pins both slots.\n#[link_section = \".rodata.aspis_pool_program_id\"]\nstatic AUDIT_POOL_PROGRAM: [u8; 32] = deployment_ids::deployment_id(\n    option_env!(\"ASPIS_R1_POOL_PROGRAM_ID\"), [0x41; 32],\n);\n#[link_section = \".rodata.aspis_registry_program_id\"]\nstatic AUDIT_REGISTRY_PROGRAM: [u8; 32] = deployment_ids::deployment_id(\n    option_env!(\"ASPIS_R1_REGISTRY_PROGRAM_ID\"), [0x44; 32],\n);\n\n#[inline(always)]\nfn pool_program_id() -> [u8; 32] {\n    *core::hint::black_box(&AUDIT_POOL_PROGRAM)\n}\n\n#[inline(always)]\nfn registry_program_id() -> [u8; 32] {\n    *core::hint::black_box(&AUDIT_REGISTRY_PROGRAM)\n}\nconst AUDIT_POLICY_BINDING: [u8; 32] = [7; 32];\n\nconst PAIR_FOREST_MASTER_SEED: &[u8] = b\"aspis-pair-forest-master-v1\";\nconst PAIR_FOREST_LANE_SEED: &[u8] = b\"aspis-pair-forest-lane-v1\";\nconst PAIR_FOREST_CHECKPOINT_SEED: &[u8] = b\"aspis-pair-forest-checkpoint-v1\";\nconst VERIFIER_REGISTRY_SEED: &[u8] = b\"aspis-verifier-registry-v1\";\nconst VERIFIER_ENTRY_SEED: &[u8] = b\"aspis-verifier-entry-v1\";\nconst VERIFIER_REGISTRY_V2_SEED: &[u8] = b\"aspis-verifier-registry-v2\";\nconst VERIFIER_ENTRY_V2_SEED: &[u8] = b\"aspis-verifier-entry-v2\";\nconst _: () = assert!(ASPU_HEADER == 40);\n\n#[derive(Clone, Copy, PartialEq, Eq)]\nenum LifecycleKind {\n    Proof,\n    Public,\n}\n\nimpl LifecycleKind {\n    fn from_byte(value: u8) -> Result<Self, ProgramError> {\n        match value {\n            0 => Ok(Self::Proof),\n            1 => Ok(Self::Public),\n            _ => Err(ProgramError::InvalidInstructionData),\n        }\n    }\n\n    fn magic(self) -> [u8; 4] {\n        match self {\n            Self::Proof => POOL_V1_VERIFIER_PROOF_ACCOUNT_MAGIC,\n            Self::Public => ASRU_MAGIC,\n        }\n    }\n\n    fn body_len(self) -> Result<usize, ProgramError> {\n        match self {\n            Self::Proof => POOL_V1_PAIR_VERIFIED_AFTERSTATE_BYTES\n                .checked_add(verifier::PROOF_BYTES)\n                .and_then(|length| length.checked_add(CHECKPOINT_TAIL_BYTES))\n                .ok_or(ProgramError::InvalidAccountData),\n            Self::Public => Ok(ASRU_BODY_BYTES),\n        }\n    }\n\n    fn writable_prefix_len(self) -> Result<usize, ProgramError> {\n        match self {\n            Self::Proof => POOL_V1_PAIR_VERIFIED_AFTERSTATE_BYTES\n                .checked_add(verifier::PROOF_BYTES)\n                .ok_or(ProgramError::InvalidAccountData),\n            Self::Public => Ok(ASRU_BODY_BYTES),\n        }\n    }\n}\n\nstruct AuthenticatedAsq8Accounts {\n    master_account: [u8; 32],\n    checkpoint_account: [u8; 32],\n    selected_lane_account: [u8; 32],\n    master: Box<PoolV1PairForestMasterV1>,\n    checkpoint: Box<PoolV1PairForestCheckpointV1>,\n    selected_lane: Box<PoolV1PairForestLaneStateV1>,\n    live_snapshot: Box<PoolV1PairLiveSnapshotV1>,\n}\n\nstruct ScannedAsqaProof {\n    candidate_afterstate: Box<aspis_statement::pool_v1::PoolV1PairVerifiedAfterstateV1>,\n    proof_length: usize,\n}\n\nstruct ValidatedAsqa {\n    statement: Box<PoolV1PairForestTerminalStatementV1>,\n    proof_length: usize,\n}\n\nfn readonly_meta_ok(\n    owner: &Pubkey,\n    expected: &Pubkey,\n    is_signer: bool,\n    is_writable: bool,\n    executable: bool,\n) -> ProgramResult {\n    if owner != expected || is_signer || is_writable || executable {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    Ok(())\n}\n\nfn require_readonly_account(account: &AccountInfo<'_>, owner: &Pubkey) -> ProgramResult {\n    readonly_meta_ok(account.owner, owner, account.is_signer, account.is_writable, account.executable)\n}\n\n#[cfg(test)]\n#[path = \"readonly_meta_tests.rs\"]\nmod readonly_meta_tests;\n\nfn readonly_buffer_meta_ok(\n    is_signer: bool,\n    is_writable: bool,\n    executable: bool,\n) -> ProgramResult {\n    if is_signer || is_writable || executable {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    Ok(())\n}\n\nfn require_readonly_buffer(account: &AccountInfo<'_>) -> ProgramResult {\n    readonly_buffer_meta_ok(account.is_signer, account.is_writable, account.executable)\n}\n\n#[cfg(test)]\n#[path = \"readonly_buffer_tests.rs\"]\nmod readonly_buffer_tests;\n\nfn require_verifier_checkpoint(\n    account: &AccountInfo<'_>,\n    program_id: &Pubkey,\n    writable: bool,\n) -> ProgramResult {\n    if account.owner != program_id || account.is_signer || account.executable\n        || account.is_writable != writable\n        || account.try_data_len()? != verifier::checkpoint_size(Variant::S2)\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    Ok(())\n}\n\nfn require_distinct_accounts<const N: usize>(accounts: &[&AccountInfo<'_>; N]) -> ProgramResult {\n    for (index, account) in accounts.iter().enumerate() {\n        if accounts[..index]\n            .iter()\n            .any(|previous| previous.key == account.key)\n        {\n            return Err(ProgramError::InvalidArgument);\n        }\n    }\n    Ok(())\n}\n\n#[inline(never)]\nfn decode_public_statement_box(\n    bytes: &[u8],\n) -> Result<Box<PoolV1PairForestTerminalStatementV1>, ProgramError> {\n    Ok(Box::new(\n        decode_pool_v1_pair_forest_terminal_statement_v1(bytes)\n            .map_err(|_| ProgramError::InvalidAccountData)?,\n    ))\n}\n\n#[inline(never)]\nfn lifecycle_accounts<'a, 'info>(\n    program_id: &Pubkey,\n    accounts: &'a [AccountInfo<'info>],\n) -> Result<(&'a AccountInfo<'info>, &'a AccountInfo<'info>), ProgramError> {\n    let [target, authority] = accounts else {\n        return Err(if accounts.len() < 2 {\n            ProgramError::NotEnoughAccountKeys\n        } else {\n            ProgramError::InvalidArgument\n        });\n    };\n    if target.key == authority.key\n        || target.owner != program_id\n        || !target.is_writable\n        || target.is_signer\n        || target.executable\n        || authority.is_writable\n        || !authority.is_signer\n        || authority.executable\n        || authority.key.to_bytes() == [0; 32]\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    Ok((target, authority))\n}\n\n#[inline(never)]\nfn validate_lifecycle_header(\n    data: &[u8],\n    authority: &Pubkey,\n    sealed: bool,\n) -> Result<LifecycleKind, ProgramError> {\n    if data.len() < ASPU_HEADER {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    let kind = if data[..4] == POOL_V1_VERIFIER_PROOF_ACCOUNT_MAGIC {\n        LifecycleKind::Proof\n    } else if data[..4] == ASRU_MAGIC {\n        LifecycleKind::Public\n    } else {\n        return Err(ProgramError::InvalidAccountData);\n    };\n    let body_len = kind.body_len()?;\n    let encoded_body_len = u32::from_le_bytes(\n        data[4..8]\n            .try_into()\n            .map_err(|_| ProgramError::InvalidAccountData)?,\n    ) as usize;\n    let auth = &data[ASPU_AUTHORITY.clone()];\n    let authority_bytes = authority.to_bytes();\n    let auth_valid = if sealed {\n        auth.iter().all(|byte| *byte == 0)\n    } else {\n        auth == authority_bytes.as_slice() && auth.iter().any(|byte| *byte != 0)\n    };\n    if encoded_body_len != body_len || data.len() != ASPU_HEADER + body_len || !auth_valid {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    Ok(kind)\n}\n\n#[inline(never)]\nfn validate_lifecycle_final_body(data: &[u8], kind: LifecycleKind) -> ProgramResult {\n    match kind {\n        LifecycleKind::Proof => {\n            let candidate_end = ASPU_HEADER + POOL_V1_PAIR_VERIFIED_AFTERSTATE_BYTES;\n            let proof_end = candidate_end + verifier::PROOF_BYTES;\n            let candidate_bytes = &data[ASPU_HEADER..candidate_end];\n            let candidate = decode_pool_v1_pair_verified_afterstate_v1(candidate_bytes)\n                .map_err(|_| ProgramError::InvalidAccountData)?;\n            if encode_pool_v1_pair_verified_afterstate_v1(&candidate)\n                .map_err(|_| ProgramError::InvalidAccountData)?\n                .as_ref()\n                != candidate_bytes\n            {\n                return Err(ProgramError::InvalidAccountData);\n            }\n            let variant = verifier::parse_shape(&data[candidate_end..proof_end])\n                .map_err(|_| ProgramError::InvalidAccountData)?;\n            if variant != Variant::S2\n                || data[proof_end..].len() != CHECKPOINT_TAIL_BYTES\n                || data[proof_end..].iter().any(|byte| *byte != 0)\n            {\n                return Err(ProgramError::InvalidAccountData);\n            }\n        }\n        LifecycleKind::Public => {\n            let statement = decode_public_statement_box(&data[ASPU_HEADER..])?;\n            validate_pool_v1_pair_forest_terminal_statement_v1(&statement)\n                .map_err(|_| ProgramError::InvalidAccountData)?;\n        }\n    }\n    Ok(())\n}\n\n#[inline(never)]\nfn lifecycle_init(\n    program_id: &Pubkey,\n    accounts: &[AccountInfo<'_>],\n    instruction_data: &[u8],\n) -> ProgramResult {\n    if instruction_data.len() != 2 || instruction_data[0] != 4 {\n        return Err(ProgramError::InvalidInstructionData);\n    }\n    let kind = LifecycleKind::from_byte(instruction_data[1])?;\n    let (target, authority) = lifecycle_accounts(program_id, accounts)?;\n    let body_len = kind.body_len()?;\n    if u32::try_from(body_len).is_err() {\n        return Err(ProgramError::InvalidInstructionData);\n    }\n    let mut target_data = target.try_borrow_mut_data()?;\n    if target_data.len() != ASPU_HEADER + body_len || target_data.iter().any(|byte| *byte != 0) {\n        return Err(ProgramError::AccountAlreadyInitialized);\n    }\n    target_data[..4].copy_from_slice(&kind.magic());\n    target_data[4..8].copy_from_slice(&(body_len as u32).to_le_bytes());\n    target_data[ASPU_AUTHORITY.clone()].copy_from_slice(authority.key.as_ref());\n    Ok(())\n}\n\n#[inline(never)]\nfn lifecycle_write(\n    program_id: &Pubkey,\n    accounts: &[AccountInfo<'_>],\n    instruction_data: &[u8],\n) -> ProgramResult {\n    if instruction_data.len() <= 5 || instruction_data[0] != 5 {\n        return Err(ProgramError::InvalidInstructionData);\n    }\n    let (target, authority) = lifecycle_accounts(program_id, accounts)?;\n    let offset = u32::from_le_bytes(\n        instruction_data[1..5]\n            .try_into()\n            .map_err(|_| ProgramError::InvalidInstructionData)?,\n    ) as usize;\n    let payload = &instruction_data[5..];\n    let kind = {\n        let target_data = target.try_borrow_data()?;\n        validate_lifecycle_header(&target_data, authority.key, false)?\n    };\n    let end = offset\n        .checked_add(payload.len())\n        .ok_or(ProgramError::InvalidInstructionData)?;\n    if end > kind.writable_prefix_len()? || end > kind.body_len()? {\n        return Err(ProgramError::InvalidInstructionData);\n    }\n    let mut target_data = target.try_borrow_mut_data()?;\n    let start = ASPU_HEADER\n        .checked_add(offset)\n        .ok_or(ProgramError::InvalidInstructionData)?;\n    let write_end = start\n        .checked_add(payload.len())\n        .ok_or(ProgramError::InvalidInstructionData)?;\n    target_data[start..write_end].copy_from_slice(payload);\n    Ok(())\n}\n\n#[inline(never)]\nfn lifecycle_finalize(\n    program_id: &Pubkey,\n    accounts: &[AccountInfo<'_>],\n    instruction_data: &[u8],\n) -> ProgramResult {\n    if instruction_data != &[6] {\n        return Err(ProgramError::InvalidInstructionData);\n    }\n    let (target, authority) = lifecycle_accounts(program_id, accounts)?;\n    let kind = {\n        let target_data = target.try_borrow_data()?;\n        let kind = validate_lifecycle_header(&target_data, authority.key, false)?;\n        validate_lifecycle_final_body(&target_data, kind)?;\n        kind\n    };\n    let mut target_data = target.try_borrow_mut_data()?;\n    if target_data[..4] != kind.magic() {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    target_data[ASPU_AUTHORITY.clone()].fill(0);\n    Ok(())\n}\n\n#[inline(never)]\nfn decode_master_box(bytes: &[u8]) -> Result<Box<PoolV1PairForestMasterV1>, ProgramError> {\n    Ok(Box::new(\n        decode_pool_v1_pair_forest_master_v1(bytes)\n            .map_err(|_| ProgramError::InvalidAccountData)?,\n    ))\n}\n\n#[inline(never)]\nfn decode_checkpoint_box(bytes: &[u8]) -> Result<Box<PoolV1PairForestCheckpointV1>, ProgramError> {\n    Ok(Box::new(\n        decode_pool_v1_pair_forest_checkpoint_v1(bytes)\n            .map_err(|_| ProgramError::InvalidAccountData)?,\n    ))\n}\n\n/// Exact source-release lane decoder copied from the ASQ8 audit path. It\n/// retains the pinned account format, frontier canonicality, and empty-root\n/// conditions for each unoccupied subtree.\n#[inline(never)]\nfn decode_lane_from_pool_release(\n    bytes: &[u8],\n) -> Result<Box<PoolV1PairForestLaneStateV1>, ProgramError> {\n    use v7_pair_empty_roots::V7_PAIR_EMPTY_ROOTS;\n    if bytes.len() != POOL_V1_PAIR_FOREST_LANE_ACCOUNT_BYTES\n        || bytes[..4] != POOL_V1_PAIR_FOREST_LANE_MAGIC\n        || bytes[4] != POOL_V1_PAIR_FOREST_LANE_VERSION\n        || usize::from(bytes[5]) >= POOL_V1_PAIR_FOREST_LANE_COUNT\n        || bytes[6] != POOL_V1_PAIR_FOREST_LANE_COUNT as u8\n        || bytes[7] != POOL_V1_PAIR_TREE_DEPTH as u8\n        || bytes[8..40] != POOL_V1_PAIR_FOREST_ACCOUNT_FORMAT_BINDING\n        || bytes[73..POOL_V1_PAIR_FOREST_LANE_HEADER_BYTES]\n            .iter()\n            .any(|byte| *byte != 0)\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    let master: [u8; 32] = bytes[40..72]\n        .try_into()\n        .map_err(|_| ProgramError::InvalidAccountData)?;\n    if master == [0u8; 32] {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    let tree = &bytes[POOL_V1_PAIR_FOREST_LANE_HEADER_BYTES..];\n    if tree[..4] != POOL_V1_TREE_STATE_MAGIC\n        || tree[4] != POOL_V1_TREE_STATE_VERSION\n        || tree[5] != POOL_V1_PAIR_TREE_DEPTH as u8\n        || tree[6] != POOL_V1_TREE_HASH_VERSION\n        || tree[7] != POOL_V1_DIGEST_ENCODING_VERSION\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    let next_leaf_index = u64::from_le_bytes(\n        tree[8..16]\n            .try_into()\n            .map_err(|_| ProgramError::InvalidAccountData)?,\n    );\n    if next_leaf_index > POOL_V1_PAIR_CAPACITY {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    let root = decode_digest_canonical(\n        tree[16..48]\n            .try_into()\n            .map_err(|_| ProgramError::InvalidAccountData)?,\n    )\n    .map_err(|_| ProgramError::InvalidAccountData)?;\n    let mut frontier = [[M31::ZERO; 8]; POOL_V1_PAIR_TREE_DEPTH];\n    for (level, node) in frontier.iter_mut().enumerate() {\n        let start = 48 + 32 * level;\n        *node = decode_digest_canonical(\n            tree[start..start + 32]\n                .try_into()\n                .map_err(|_| ProgramError::InvalidAccountData)?,\n        )\n        .map_err(|_| ProgramError::InvalidAccountData)?;\n        if (next_leaf_index >> level) & 1 == 0 && *node != V7_PAIR_EMPTY_ROOTS[level] {\n            return Err(ProgramError::InvalidAccountData);\n        }\n    }\n    if next_leaf_index == 0 && root != V7_PAIR_EMPTY_ROOTS[POOL_V1_PAIR_TREE_DEPTH] {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    Ok(Box::new(PoolV1PairForestLaneStateV1 {\n        bump: bytes[72],\n        master,\n        lane_id: bytes[5],\n        tree: IncrementalMerkleTreeV1 {\n            next_leaf_index,\n            root,\n            frontier,\n        },\n    }))\n}\n\n#[inline(never)]\nfn authenticate_invariant_release_registry(\n    verifier_program: &Pubkey,\n    pool_program: &Pubkey,\n    master_account: &AccountInfo<'_>,\n    master: &PoolV1PairForestMasterV1,\n    registry_account: &AccountInfo<'_>,\n    entry_account: &AccountInfo<'_>,\n    current_slot: u64,\n) -> ProgramResult {\n    // Versioned, owner-authenticated registry images carry the canonical bumps\n    // saved by their initializers. Address checks below perform one derivation;\n    // they neither search for a bump nor establish canonicality independently.\n    if pool_program.to_bytes() != pool_program_id()\n        || master.verifier_policy.flags & POOL_V1_VERIFIER_POLICY_FLAG_IMMUTABLE_REGISTRY == 0\n        || master.verifier_policy.registry_program != registry_program_id()\n        || master.verifier_policy.registry_authority != [0u8; 32]\n        || master.verifier_policy.policy_binding != AUDIT_POLICY_BINDING\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    validate_verifier_policy_v1(&master.verifier_policy)\n        .map_err(|_| ProgramError::InvalidAccountData)?;\n    let registry_program = Pubkey::new_from_array(registry_program_id());\n    require_readonly_account(registry_account, &registry_program)?;\n    let immutable_deployment =\n        master.verifier_policy.flags & POOL_V1_VERIFIER_POLICY_FLAG_IMMUTABLE_DEPLOYMENT != 0;\n    if immutable_deployment {\n        let loader = bpf_loader_upgradeable::id();\n        let registry = decode_verifier_registry_v2(&registry_account.try_borrow_data()?)\n            .map_err(|_| ProgramError::InvalidAccountData)?;\n        let expected_registry = Pubkey::create_program_address(\n            &[\n                VERIFIER_REGISTRY_V2_SEED,\n                master_account.key.as_ref(),\n                &[registry.bump],\n            ],\n            &registry_program,\n        )\n        .map_err(|_| ProgramError::InvalidAccountData)?;\n        if registry_account.key != &expected_registry {\n            return Err(ProgramError::InvalidAccountData);\n        }\n        let registry_programdata = Pubkey::create_program_address(\n            &[registry_program.as_ref(), &[registry.programdata_bump]],\n            &loader,\n        )\n        .map_err(|_| ProgramError::InvalidAccountData)?;\n        if registry.pool != master_account.key.to_bytes()\n            || registry.authority != master.verifier_policy.registry_authority\n            || registry.policy_binding != master.verifier_policy.policy_binding\n            || registry.registry_program != registry_program.to_bytes()\n            || registry.loader_program != loader.to_bytes()\n            || registry.programdata_address != registry_programdata.to_bytes()\n            || !registry.is_immutable()\n            || registry.is_paused()\n        {\n            return Err(ProgramError::InvalidAccountData);\n        }\n        require_readonly_account(entry_account, &registry_program)?;\n        let entry = decode_verifier_registry_entry_v2(&entry_account.try_borrow_data()?)\n            .map_err(|_| ProgramError::InvalidAccountData)?;\n        let expected_entry = Pubkey::create_program_address(\n            &[\n                VERIFIER_ENTRY_V2_SEED,\n                master_account.key.as_ref(),\n                &PROFILE_BINDING,\n                &RELEASE_BINDING,\n                &[entry.bump],\n            ],\n            &registry_program,\n        )\n        .map_err(|_| ProgramError::InvalidAccountData)?;\n        if entry_account.key != &expected_entry {\n            return Err(ProgramError::InvalidAccountData);\n        }\n        let verifier_programdata = Pubkey::create_program_address(\n            &[verifier_program.as_ref(), &[entry.programdata_bump]],\n            &loader,\n        )\n        .map_err(|_| ProgramError::InvalidAccountData)?;\n        if entry.pool != master_account.key.to_bytes()\n            || entry.policy_binding != AUDIT_POLICY_BINDING\n            || entry.verifier_program != verifier_program.to_bytes()\n            || entry.profile_binding != PROFILE_BINDING\n            || entry.release_binding != RELEASE_BINDING\n            || entry.statement_version != POOL_V1_PAIR_FOREST_TERMINAL_VERSION\n            || entry.loader_program != loader.to_bytes()\n            || entry.programdata_address != verifier_programdata.to_bytes()\n            || entry.expected_upgrade_authority != [0u8; 32]\n            || !entry.is_active_at(current_slot)\n        {\n            return Err(ProgramError::InvalidAccountData);\n        }\n        return Ok(());\n    }\n\n    let registry = decode_verifier_registry_v1(&registry_account.try_borrow_data()?)\n        .map_err(|_| ProgramError::InvalidAccountData)?;\n    let expected_registry = Pubkey::create_program_address(\n        &[\n            VERIFIER_REGISTRY_SEED,\n            master_account.key.as_ref(),\n            &[registry.bump],\n        ],\n        &registry_program,\n    )\n    .map_err(|_| ProgramError::InvalidAccountData)?;\n    if registry_account.key != &expected_registry {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    if registry.pool != master_account.key.to_bytes()\n        || registry.authority != master.verifier_policy.registry_authority\n        || registry.policy_binding != master.verifier_policy.policy_binding\n        || !registry.is_immutable()\n        || registry.is_paused()\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    require_readonly_account(entry_account, &registry_program)?;\n    let entry = decode_verifier_registry_entry_v1(&entry_account.try_borrow_data()?)\n        .map_err(|_| ProgramError::InvalidAccountData)?;\n    let expected_entry = Pubkey::create_program_address(\n        &[\n            VERIFIER_ENTRY_SEED,\n            master_account.key.as_ref(),\n            &PROFILE_BINDING,\n            &RELEASE_BINDING,\n            &[entry.bump],\n        ],\n        &registry_program,\n    )\n    .map_err(|_| ProgramError::InvalidAccountData)?;\n    if entry_account.key != &expected_entry {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    if entry.pool != master_account.key.to_bytes()\n        || entry.policy_binding != AUDIT_POLICY_BINDING\n        || entry.verifier_program != verifier_program.to_bytes()\n        || entry.profile_binding != PROFILE_BINDING\n        || entry.release_binding != RELEASE_BINDING\n        || entry.statement_version != POOL_V1_PAIR_FOREST_TERMINAL_VERSION\n        || !entry.is_active_at(current_slot)\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    Ok(())\n}\n\n#[inline(never)]\nfn authenticate_asq8_accounts(\n    verifier_program: &Pubkey,\n    accounts: &[AccountInfo<'_>],\n    pool_program: &Pubkey,\n    output_lane: u8,\n    current_slot: u64,\n) -> Result<AuthenticatedAsq8Accounts, ProgramError> {\n    let [proof_account, master_account, checkpoint_account, lane_account, registry_account, entry_account, verifier_checkpoint] =\n        accounts\n    else {\n        return Err(if accounts.len() < 7 {\n            ProgramError::NotEnoughAccountKeys\n        } else {\n            ProgramError::InvalidArgument\n        });\n    };\n    require_readonly_buffer(proof_account)?;\n    require_verifier_checkpoint(verifier_checkpoint, verifier_program, false)?;\n    require_readonly_account(master_account, pool_program)?;\n    require_readonly_account(checkpoint_account, pool_program)?;\n    require_readonly_account(lane_account, pool_program)?;\n    require_distinct_accounts(&[\n        proof_account,\n        master_account,\n        checkpoint_account,\n        lane_account,\n        registry_account,\n        entry_account,\n        verifier_checkpoint,\n    ])?;\n\n    let master = decode_master_box(&master_account.try_borrow_data()?)?;\n    if master.identity.pool != master_account.key.to_bytes()\n        || master.initialized_lane_mask != POOL_V1_PAIR_FOREST_ALL_LANES_MASK\n        || Pubkey::create_program_address(\n            &[\n                PAIR_FOREST_MASTER_SEED,\n                Pubkey::new_from_array(master.identity.asset_mint).as_ref(),\n                &[master.bump],\n            ],\n            pool_program,\n        )\n        .map_err(|_| ProgramError::InvalidAccountData)? != *master_account.key\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    authenticate_invariant_release_registry(\n        verifier_program,\n        pool_program,\n        master_account,\n        &master,\n        registry_account,\n        entry_account,\n        current_slot,\n    )?;\n\n    let checkpoint = decode_checkpoint_box(&checkpoint_account.try_borrow_data()?)?;\n    if checkpoint.master != master_account.key.to_bytes()\n        || checkpoint.deployment_domain != master.identity.deployment_domain\n        || Pubkey::create_program_address(\n            &[\n                PAIR_FOREST_CHECKPOINT_SEED,\n                master_account.key.as_ref(),\n                &checkpoint.checkpoint_sequence.to_le_bytes(),\n                &[checkpoint.bump],\n            ],\n            pool_program,\n        )\n        .map_err(|_| ProgramError::InvalidAccountData)? != *checkpoint_account.key\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    let selected_lane = decode_lane_from_pool_release(&lane_account.try_borrow_data()?)?;\n    if selected_lane.master != master_account.key.to_bytes()\n        || selected_lane.lane_id != output_lane\n        || Pubkey::create_program_address(\n            &[\n                PAIR_FOREST_LANE_SEED,\n                master_account.key.as_ref(),\n                &[output_lane],\n                &[selected_lane.bump],\n            ],\n            pool_program,\n        )\n        .map_err(|_| ProgramError::InvalidAccountData)? != *lane_account.key\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    let live_snapshot = Box::new(PoolV1PairLiveSnapshotV1 {\n        pool: master_account.key.to_bytes(),\n        deployment_domain: master.identity.deployment_domain,\n        sequence: selected_lane.tree.next_leaf_index,\n        next_pair_index: selected_lane.tree.next_leaf_index,\n        current_root: selected_lane.tree.root,\n        frontier: selected_lane.tree.frontier,\n    });\n    Ok(AuthenticatedAsq8Accounts {\n        master_account: master_account.key.to_bytes(),\n        checkpoint_account: checkpoint_account.key.to_bytes(),\n        selected_lane_account: lane_account.key.to_bytes(),\n        master,\n        checkpoint,\n        selected_lane,\n        live_snapshot,\n    })\n}\n\n#[inline(never)]\nfn scan_proof_buffer(bytes: &[u8]) -> Result<ScannedAsqaProof, ProgramError> {\n    let proof_length = verifier::PROOF_BYTES;\n    let expected_body = POOL_V1_PAIR_VERIFIED_AFTERSTATE_BYTES\n        .checked_add(proof_length)\n        .ok_or(ProgramError::InvalidAccountData)?;\n    if bytes.len() != expected_body {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    let candidate_start = 0;\n    let proof_start = candidate_start + POOL_V1_PAIR_VERIFIED_AFTERSTATE_BYTES;\n    let candidate_bytes = &bytes[candidate_start..proof_start];\n    let candidate = Box::new(\n        decode_pool_v1_pair_verified_afterstate_v1(candidate_bytes)\n            .map_err(|_| ProgramError::InvalidAccountData)?,\n    );\n    if encode_pool_v1_pair_verified_afterstate_v1(&candidate)\n        .map_err(|_| ProgramError::InvalidAccountData)?\n        .as_ref()\n        != candidate_bytes\n        || bytes[proof_start + 8] != Variant::S2.tag()\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    Ok(ScannedAsqaProof {\n        candidate_afterstate: candidate,\n        proof_length,\n    })\n}\n\n#[inline(never)]\nfn asq8_common(\n    authenticated: &AuthenticatedAsq8Accounts,\n    candidate_afterstate: &aspis_statement::pool_v1::PoolV1PairVerifiedAfterstateV1,\n) -> Box<PoolV1PairForestTerminalCommonV1> {\n    Box::new(PoolV1PairForestTerminalCommonV1 {\n        master_account: authenticated.master_account,\n        checkpoint_account: authenticated.checkpoint_account,\n        selected_lane_account: authenticated.selected_lane_account,\n        output_lane: authenticated.selected_lane.lane_id,\n        checkpoint_sequence: authenticated.checkpoint.checkpoint_sequence,\n        historical_global_anchor: authenticated.checkpoint.global_root,\n        lane_transition: PoolV1PairLatePublicStatementV1 {\n            live_snapshot: *authenticated.live_snapshot,\n            candidate_afterstate: *candidate_afterstate,\n        },\n    })\n}\n\n#[inline(never)]\nfn transfer_statement_box(\n    common: Box<PoolV1PairForestTerminalCommonV1>,\n    public: aspis_statement::pool_v1::PoolV1PrivateTransferPublicV1,\n) -> Result<Box<PoolV1PairForestTerminalStatementV1>, ProgramError> {\n    let statement = Box::new(PoolV1PairForestTerminalStatementV1::PrivateTransfer {\n        common: *common,\n        public,\n    });\n    validate_pool_v1_pair_forest_terminal_statement_v1(&statement)\n        .map_err(|_| ProgramError::InvalidInstructionData)?;\n    Ok(statement)\n}\n\n#[inline(never)]\nfn withdrawal_statement_box(\n    common: Box<PoolV1PairForestTerminalCommonV1>,\n    public: aspis_statement::pool_v1::PoolV1WithdrawalPublicV1,\n) -> Result<Box<PoolV1PairForestTerminalStatementV1>, ProgramError> {\n    let statement = Box::new(PoolV1PairForestTerminalStatementV1::Withdrawal {\n        common: *common,\n        public,\n    });\n    validate_pool_v1_pair_forest_terminal_statement_v1(&statement)\n        .map_err(|_| ProgramError::InvalidInstructionData)?;\n    Ok(statement)\n}\n\n#[inline(never)]\nfn reconstruct_asq8_statement(\n    request: &PoolV1PairForestTerminalRequestV1,\n    authenticated: &AuthenticatedAsq8Accounts,\n    candidate_afterstate: &aspis_statement::pool_v1::PoolV1PairVerifiedAfterstateV1,\n) -> Result<Box<PoolV1PairForestTerminalStatementV1>, ProgramError> {\n    if authenticated.live_snapshot.next_pair_index.checked_add(1)\n        != Some(candidate_afterstate.next_pair_index)\n    {\n        return Err(ProgramError::InvalidAccountData);\n    }\n    let requested_asset_id = match request.public {\n        PoolV1PairForestTerminalPaymentV1::PrivateTransfer(public) => public.asset_id,\n        PoolV1PairForestTerminalPaymentV1::Withdrawal(public) => public.asset_id,\n    };\n    if authenticated.master.identity.asset_id != requested_asset_id {\n        return Err(ProgramError::InvalidInstructionData);\n    }\n    let common = asq8_common(authenticated, candidate_afterstate);\n    match request.public {\n        PoolV1PairForestTerminalPaymentV1::PrivateTransfer(public) => {\n            transfer_statement_box(common, public)\n        }\n        PoolV1PairForestTerminalPaymentV1::Withdrawal(public) => {\n            withdrawal_statement_box(common, public)\n        }\n    }\n}\n\n#[inline(never)]\nfn validate_asq8(\n    verifier_program: &Pubkey,\n    accounts: &[AccountInfo<'_>],\n    instruction_data: &[u8],\n) -> Result<ValidatedAsqa, ProgramError> {\n    if instruction_data.len() != POOL_V1_PAIR_FOREST_TERMINAL_REQUEST_BYTES {\n        return Err(ProgramError::InvalidInstructionData);\n    }\n    let request = decode_pool_v1_pair_forest_terminal_request_v1(instruction_data)\n        .map_err(|_| ProgramError::InvalidInstructionData)?;\n    if request.verifier_profile != PROFILE_BINDING\n        || request.verifier_release != RELEASE_BINDING\n        || request.pool_program != pool_program_id()\n    {\n        return Err(ProgramError::InvalidInstructionData);\n    }\n    let pool_program = Pubkey::new_from_array(request.pool_program);\n    let output_lane = pool_v1_pair_forest_output_lane_v1(request.public.nullifier())\n        .map_err(|_| ProgramError::InvalidInstructionData)?;\n    let authenticated = authenticate_asq8_accounts(\n        verifier_program,\n        accounts,\n        &pool_program,\n        output_lane,\n        Clock::get()?.slot,\n    )?;\n    let proof_account = accounts.first().ok_or(ProgramError::NotEnoughAccountKeys)?;\n    let scanned = scan_proof_buffer(&proof_account.try_borrow_data()?)?;\n    let statement =\n        reconstruct_asq8_statement(&request, &authenticated, &scanned.candidate_afterstate)?;\n    Ok(ValidatedAsqa {\n        statement,\n        proof_length: scanned.proof_length,\n    })\n}\n\n#[inline(never)]\nfn emit_result(statement: &PoolV1PairForestTerminalStatementV1) -> ProgramResult {\n    let result = PoolV1PairForestTerminalResultV1 {\n        transition_kind: statement.transition_kind(),\n        master_account: statement.common().master_account,\n        selected_lane_account: statement.common().selected_lane_account,\n        output_lane: statement.common().output_lane,\n        nullifier: *statement.nullifier(),\n        verified_afterstate: statement.common().lane_transition.candidate_afterstate,\n    };\n    validate_pool_v1_pair_forest_terminal_result_against_statement_v1(statement, &result)\n        .map_err(|_| ProgramError::InvalidInstructionData)?;\n    let encoded = encode_pool_v1_pair_forest_terminal_result_v1(&result)\n        .map_err(|_| ProgramError::InvalidInstructionData)?;\n    if encoded.len() != POOL_V1_PAIR_FOREST_TERMINAL_RESULT_BYTES\n        || encoded[..4] != POOL_V1_PAIR_FOREST_TERMINAL_RESULT_MAGIC\n    {\n        return Err(ProgramError::InvalidInstructionData);\n    }\n    program::set_return_data(&encoded);\n    Ok(())\n}\n\n#[path = \"r1_pool_adapter_owned.rs\"]\nmod owned;\nuse owned::{stage1, stage2};\n\n#[inline(never)]\npub(super) fn process(\n    program_id: &Pubkey,\n    accounts: &[AccountInfo<'_>],\n    data: &[u8],\n) -> ProgramResult {\n    match data.first().copied() {\n        Some(4) => lifecycle_init(program_id, accounts, data),\n        Some(5) => lifecycle_write(program_id, accounts, data),\n        Some(6) => lifecycle_finalize(program_id, accounts, data),\n        _ if data == &[3, 10] || data == &[3, 11] => stage1(program_id, accounts, data),\n        _ => stage2(program_id, accounts, data),\n    }\n}\n\n#[cfg(all(test, feature = \"private-leaf-salts\"))]\n#[path = \"r1_checkpoint_tests.rs\"]\nmod checkpoint_tests;\n\n#[path = \"deployment_ids.rs\"]\nmod deployment_ids;\n\n#[cfg(all(test, feature = \"private-leaf-salts\"))]\n#[path = \"adapter_rw_tests.rs\"]\nmod rw_tests;\n"},{"id":2,"name":{"Local":"programs/r1-cost-probe/src/lib.rs"},"crate_name":"aspis_r1_cost_probe_program","contents":"//! UNPROVED R1 COST PROBE. Local measurement entrypoint only.\nuse aspis_r1_cost_probe::verifier::{self,Phase};\nuse aspis_statement::pool_v1::decode_pool_v1_pair_forest_terminal_statement_v1;\nuse solana_program::{account_info::AccountInfo,entrypoint::ProgramResult,pubkey::Pubkey,program_error::ProgramError,hash::hashv,msg,log::sol_log_compute_units};\n// PREREG-PROOF-SIZE-2: the program verifies the adopted compact\n// binary-multiproof format only (the eight-way verifier cannot be built for SBF).\nconst _:()=assert!(verifier::PROOF_BYTES==57_607&&verifier::SPLIT==10);\n/// The sole digest backend instantiated by the admitted R1 program routes.\n#[derive(Clone, Copy)]\nstruct SolanaDigest;\nimpl aspis_core::Digest32 for SolanaDigest {\n    #[inline(always)]\n    fn digest(&self, parts: &[&[u8]]) -> [u8; 32] {\n        hashv(parts).to_bytes()\n    }\n}\n#[cfg(target_os=\"solana\")]\n#[global_allocator]\nstatic ALLOCATOR:solana_program::entrypoint::BumpAllocator=solana_program::entrypoint::BumpAllocator{start:solana_program::entrypoint::HEAP_START_ADDRESS as usize,len:256*1024};\n#[cfg(not(feature=\"no-entrypoint\"))]\nsolana_program::entrypoint!(process_r1_cost_probe_instruction);\n#[cfg(feature=\"cu-profiling\")]\n#[inline(never)]\nfn mark(phase:Phase){\n    match phase {\n        Phase::QueryPart(i,j)=>msg!(\"r1:query-part:{}:{}\",i,j),\n        Phase::SemanticPart(i)=>msg!(\"r1:semantic-part:{}\",i),\n        Phase::Parsed=>msg!(\"r1:parsed\"),Phase::Semantic=>msg!(\"r1:semantic\"),Phase::Prepare=>msg!(\"r1:prepare\"),\n        Phase::CheckpointRead=>msg!(\"r1:checkpoint-read\"),Phase::CheckpointWrite=>msg!(\"r1:checkpoint-write\"),\n        Phase::Merkle(i)=>msg!(\"r1:merkle:{}\",i),Phase::Query(i)=>msg!(\"r1:query:{}\",i),\n        Phase::Relation=>msg!(\"r1:relation\"),Phase::Final=>msg!(\"r1:final\"),\n    }\n    sol_log_compute_units();\n}\n#[inline(always)]\nfn observer()->verifier::Observer {\n    #[cfg(feature=\"cu-profiling\")] {Some(mark)}\n    #[cfg(not(feature=\"cu-profiling\"))] {None}\n}\nfn error(e:verifier::Error)->ProgramError{msg!(\"r1:error:{:?}\",e);ProgramError::InvalidInstructionData}\n#[inline(never)]\nfn first(public_bytes:&[u8],proof:&[u8],k:usize)->Result<Vec<u8>,ProgramError>{\n    let statement=decode_pool_v1_pair_forest_terminal_statement_v1(public_bytes).map_err(|_|ProgramError::InvalidAccountData)?;\n    first_decoded(statement.semantic_public(),public_bytes,proof,k)\n}\n/// Reuse the adapter's decoded statement while hashing its original bytes.\n/// The immutable account-data borrow keeps this value tied to those same bytes.\n#[inline(never)]\nfn first_decoded(public:aspis_statement::pool_v1::pair_forest_semantic_terminal::r0::Public<'_>,public_bytes:&[u8],proof:&[u8],k:usize)->Result<Vec<u8>,ProgramError>{\n    verifier::tx1(public,public_bytes,proof,k,SolanaDigest,observer()).map_err(error)\n}\n#[cfg(feature=\"pool-adapter\")]\nmod r1_pool_adapter;\n#[cfg(feature=\"pool-adapter\")]\nmod pool_route;\npub fn process_r1_cost_probe_instruction(program_id:&Pubkey,accounts:&[AccountInfo],data:&[u8])->ProgramResult{\n    #[cfg(feature=\"pool-adapter\")]\n    {\n        // Reject before inspecting or borrowing any account. Lifecycle loaders\n        // are not part of the release instruction surface.\n        if !pool_route::admitted(data) {\n            return Err(ProgramError::InvalidInstructionData);\n        }\n        return r1_pool_adapter::process(program_id,accounts,data);\n    }\n\n    #[cfg(not(feature=\"pool-adapter\"))]\n    {\n    if accounts.len()!=3||!matches!(data,[1,0..=22]|[2]) {return Err(ProgramError::InvalidInstructionData);}\n    for (i,a) in accounts.iter().enumerate(){if a.owner!=program_id||a.executable||a.is_writable!=(i==2){return Err(ProgramError::InvalidAccountData);}}\n    let proof=accounts[0].try_borrow_data()?;let public=accounts[1].try_borrow_data()?;let mut checkpoint=accounts[2].try_borrow_mut_data()?;\n    msg!(\"UNPROVED R1 COST PROBE\");msg!(\"r1:begin\");sol_log_compute_units();\n    if data[0]==1 {\n        if checkpoint.iter().any(|&b|b!=0){return Err(ProgramError::AccountAlreadyInitialized);}\n        let bytes=first(&public,&proof,data[1]as usize)?;\n        if checkpoint.len()!=bytes.len(){return Err(ProgramError::InvalidAccountData);}\n        checkpoint.copy_from_slice(&bytes);\n    } else {\n        verifier::tx2(&public,&proof,&checkpoint,SolanaDigest,observer()).map_err(error)?;\n        checkpoint[10]=2;let end=checkpoint.len()-32;let sum=hashv(&[b\"UNPROVED:R1:checkpoint\",&checkpoint[..end]]).to_bytes();checkpoint[end..].copy_from_slice(&sum);\n    }\n    msg!(\"r1:account-write\");sol_log_compute_units();\n    #[cfg(target_os=\"solana\")]\n    unsafe {\n        let cursor=*(solana_program::entrypoint::HEAP_START_ADDRESS as *const usize);\n        msg!(\"r1:heap-high-water\");solana_program::log::sol_log_64((solana_program::entrypoint::HEAP_START_ADDRESS as usize+256*1024-cursor+core::mem::size_of::<usize>())as u64,0,0,0,0);\n    }\n    Ok(())\n    }\n}\n\n#[cfg(all(test, feature=\"pool-adapter\"))]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn pool_adapter_rejects_other_routes_before_borrowing_accounts() {\n        let program_id = Pubkey::new_unique();\n        let proof_key = Pubkey::new_unique();\n        let public_key = Pubkey::new_unique();\n        let checkpoint_key = Pubkey::new_unique();\n        let mut proof_lamports = 0;\n        let mut public_lamports = 0;\n        let mut checkpoint_lamports = 0;\n        let mut proof_data = [0u8; 1];\n        let mut public_data = [0u8; 1];\n        let mut checkpoint_data = [0u8; 1];\n        let proof = AccountInfo::new(\n            &proof_key,\n            false,\n            false,\n            &mut proof_lamports,\n            &mut proof_data,\n            &program_id,\n            false,\n            0,\n        );\n        let public = AccountInfo::new(\n            &public_key,\n            false,\n            false,\n            &mut public_lamports,\n            &mut public_data,\n            &program_id,\n            false,\n            0,\n        );\n        let checkpoint = AccountInfo::new(\n            &checkpoint_key,\n            false,\n            true,\n            &mut checkpoint_lamports,\n            &mut checkpoint_data,\n            &program_id,\n            false,\n            0,\n        );\n        let accounts = [proof, public, checkpoint];\n        let _held_proof_data = accounts[0].try_borrow_mut_data().unwrap();\n\n        for k in 0..=22 {\n            assert_eq!(\n                process_r1_cost_probe_instruction(&program_id, &accounts, &[1, k]),\n                Err(ProgramError::InvalidInstructionData),\n                \"legacy stage-1 tag [1, {k}] must be rejected before borrowing proof data\",\n            );\n        }\n        assert_eq!(\n            process_r1_cost_probe_instruction(&program_id, &accounts, &[2]),\n            Err(ProgramError::InvalidInstructionData),\n            \"legacy stage-2 tag [2] must be rejected before borrowing proof data\",\n        );\n        for tag in [4, 5, 6] {\n            for suffix in [&[][..], &[0, 1, 2], b\"ASQ8\"] {\n                let mut data = vec![tag];\n                data.extend_from_slice(suffix);\n                assert_eq!(\n                    process_r1_cost_probe_instruction(&program_id, &accounts, &data),\n                    Err(ProgramError::InvalidInstructionData),\n                    \"lifecycle tag {tag} must be rejected before borrowing proof data\",\n                );\n            }\n        }\n        assert_eq!(&**accounts[2].try_borrow_data().unwrap(), &[0]);\n    }\n}\n\n#[cfg(all(test, feature=\"pool-adapter\"))]\n#[path=\"r1_pool_adapter_original.rs\"]\nmod r1_pool_adapter_original;\n"},{"id":3,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/solana-pubkey-2.4.0/src/lib.rs"},"crate_name":"solana_pubkey","contents":null},{"id":4,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/solana-account-info-2.3.0/src/lib.rs"},"crate_name":"solana_account_info","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/solana-program-error-2.2.2/src/lib.rs"},"crate_name":"solana_program_error","contents":null},{"id":8,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":9,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":10,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/cell.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/array/equality.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":19,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":20,"name":{"Local":"crates/aspis-statement/src/pool_v1/pair_terminal.rs"},"crate_name":"aspis_statement","contents":null},{"id":21,"name":{"Local":"crates/aspis-statement/src/pool_v1/mod.rs"},"crate_name":"aspis_statement","contents":null},{"id":22,"name":{"Local":"crates/aspis-statement/src/lib.rs"},"crate_name":"aspis_statement","contents":null},{"id":23,"name":{"Local":"crates/aspis-r1-cost-probe/src/verifier.rs"},"crate_name":"aspis_r1_cost_probe","contents":null},{"id":24,"name":{"Local":"crates/aspis-r1-cost-probe/src/lib.rs"},"crate_name":"aspis_r1_cost_probe","contents":null},{"id":25,"name":{"Local":"crates/aspis-statement/src/pool_v1/pair_forest_terminal.rs"},"crate_name":"aspis_statement","contents":null},{"id":26,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":27,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":28,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/solana-clock-2.2.3/src/lib.rs"},"crate_name":"s