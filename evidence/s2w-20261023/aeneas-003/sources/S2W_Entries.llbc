nt":"     where"},{"DocComment":"         S: Serializer,"},{"DocComment":"     {"},{"DocComment":"         let mut seq = serializer.serialize_tuple(VRAM_SIZE)?;"},{"DocComment":"         for element in &self.0[..] {"},{"DocComment":"             seq.serialize_element(element)?;"},{"DocComment":"         }"},{"DocComment":"         seq.end()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10638},{"Deduplicated":659}],"output":{"HashConsedValue":[10729,{"Adt":{"id":{"Adt":2},"generics":{"regions":[],"types":[{"Deduplicated":10720},{"Deduplicated":10660}],"const_generics":[],"trait_refs":[]}}}]}},"default":null},"kind":{"TraitMethod":[19,24]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"serialize_tuple_struct","item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["ser",0]},{"Ident":["Serializer",0]},{"Ident":["serialize_tuple_struct",0]}],"span":{"data":{"file_id":44,"beg":{"line":1089,"col":4},"end":{"line":1093,"col":57}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Begin to serialize a tuple struct like `struct Rgb(u8, u8, u8)`. This"},{"DocComment":" call must be followed by zero or more calls to `serialize_field`, then a"},{"DocComment":" call to `end`."},{"DocComment":""},{"DocComment":" The `name` is the name of the tuple struct and the `len` is the number"},{"DocComment":" of data fields that will be serialized."},{"DocComment":""},{"DocComment":" ```edition2021"},{"DocComment":" use serde::ser::{Serialize, SerializeTupleStruct, Serializer};"},{"DocComment":""},{"DocComment":" struct Rgb(u8, u8, u8);"},{"DocComment":""},{"DocComment":" impl Serialize for Rgb {"},{"DocComment":"     fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>"},{"DocComment":"     where"},{"DocComment":"         S: Serializer,"},{"DocComment":"     {"},{"DocComment":"         let mut ts = serializer.serialize_tuple_struct(\"Rgb\", 3)?;"},{"DocComment":"         ts.serialize_field(&self.0)?;"},{"DocComment":"         ts.serialize_field(&self.1)?;"},{"DocComment":"         ts.serialize_field(&self.2)?;"},{"DocComment":"         ts.end()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10638},{"Deduplicated":4219},{"Deduplicated":659}],"output":{"HashConsedValue":[10730,{"Adt":{"id":{"Adt":2},"generics":{"regions":[],"types":[{"Deduplicated":10721},{"Deduplicated":10660}],"const_generics":[],"trait_refs":[]}}}]}},"default":null},"kind":{"TraitMethod":[19,25]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"serialize_tuple_variant","item_meta":{"name":[{"Ident":["serde_core",0]},{"Ident":["ser",0]},{"Ident":["Serializer",0]},{"Ident":["serialize_tuple_variant",0]}],"span":{"data":{"file_id":44,"beg":{"line":1134,"col":4},"end":{"line":1140,"col":58}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Begin to serialize a tuple variant like `E::T` in `enum E { T(u8, u8)"},{"DocComment":" }`. This call must be followed by zero or more calls to"},{"DocComment":" `serialize_field`, then a call to `end`."},{"DocComment":""},{"DocComment":" The `name` is the name of the enum, the `variant_index` is the index of"},{"DocComment":" this variant within the enum, the `variant` is the name of the variant,"},{"DocComment":" and the `len` is the number of data fields that will be serialized."},{"DocComment":""},{"DocComment":" ```edition2021"},{"DocComment":" use serde::ser::{Serialize, SerializeTupleVariant, Serializer};"},{"DocComment":""},{"DocComment":" enum E {"},{"DocComment":"     T(u8, u8),"},{"DocComment":"     U(String, u32, u32),"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Serialize for E {"},{"DocComment":"     fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>"},{"DocComment":"     where"},{"DocComment":"         S: Serializer,"},{"DocComment":"     {"},{"DocComment":"         match *self {"},{"DocComment":"             E::T(ref a, ref b) => {"},{"DocComment":"                 let mut tv = serializer.serialize_tuple_variant(\"E\", 0, \"T\", 2)?;"},{"DocComment":"                 tv.serialize_field(a)?;"},{"DocComment":"                 tv.serialize_field(b)?;"},{"DocComment":"                 tv.end()"},{"DocComment":"             }"},{"DocComment":"             E::U(ref a, ref b, ref c) => {"},{"DocComment":"                 let mut tv = serializer.serialize_tuple_variant(\"E\", 1, \"U\", 3)?;"},{"DocComment":"                 tv.serialize_field(a)?;"},{"DocComment":"                 tv.serialize_field(b)?;"},{"DocComment":"                 tv.serialize_field(c)?;"},{"DocComment":"                 tv.end()"},{"DocComment":"             }"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10638},{"Deduplicated":4219},{"Deduplicated":2906},{"Deduplicated":4219},{"Deduplicated":659}],"output":{"HashConsedValue":[10731,{"Adt":{"id":{"Adt":2},"generics":{"regions":[],"types":[{"Deduplicated":10722},{"Deduplicated":10660}],"const_generics":[],"trait_refs":[]}}}]}},"default":null},"kind":{"TraitMethod":[19,26]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_out