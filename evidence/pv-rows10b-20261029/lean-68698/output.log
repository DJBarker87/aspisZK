theorem R1Z.PV_ROWS10B_CanonConsumed.consumed : ∀ {Q Trace State E : Type} (limb : Q → Fin 4 → Aeneas.Std.U32)
  (reached : Aeneas.Std.Array Q 28#usize → Q → Prop) (occurs : R1Z.PV_ROWS10B_CanonConsumed.Event Q Trace State → Prop)
  (interpolate : Aeneas.Std.Array Q 28#usize → Aeneas.Std.Result (Aeneas.Std.Array Q 28#usize))
  (semantic : Trace → Aeneas.Std.Result (Aeneas.Std.core.result.Result Q E × State)),
  R1Z.PV_ROWS10B_CanonConsumed.PV_ROWS10B_Link_CallerPrefix reached occurs →
    R1Z.PV_ROWS10B_CanonConsumed.PV_ROWS10B_Link_PrefixEquations occurs interpolate semantic →
      R1Z.PV_ROWS10B_CanonConsumed.PV_ROWS10B_Link_RoundRange occurs →
        R1Z.PV_ROWS10B_CanonConsumed.PV_ROWS10B_Link_Interpolation limb interpolate →
          R1Z.PV_ROWS10B_CanonConsumed.PV_ROWS10B_Link_Semantic limb semantic →
            ∀ (p : Aeneas.Std.Array Q 28#usize) (q : Q),
              reached p q →
                R1Z.PV_ROWS10B_CanonConsumed.Coefficients limb p ∧ R1Z.PV_ROWS10B_CanonConsumed.Canonical limb q :=
fun {Q Trace State E} limb reached occurs interpolate semantic caller prefixEq range polynomial challenge p q hit =>
  let ⟨e, h✝⟩ := caller p q hit
  let ⟨he, right✝⟩ := h✝
  let ⟨hp, hq⟩ := right✝
  let ⟨hi, right✝¹⟩ := prefixEq e he
  let ⟨hs, right✝²⟩ := right✝¹
  let ⟨hu, hr⟩ := right✝²
  Eq.mpr
    (id
      (congrArg
        (fun _a => R1Z.PV_ROWS10B_CanonConsumed.Coefficients limb _a ∧ R1Z.PV_ROWS10B_CanonConsumed.Canonical limb q)
        (Eq.symm hp)))
    (Eq.mpr
      (id
        (congrArg
          (fun _a =>
            R1Z.PV_ROWS10B_CanonConsumed.Coefficients limb e.coefficients ∧
              R1Z.PV_ROWS10B_CanonConsumed.Canonical limb _a)
          (Eq.symm hq)))
      ⟨polynomial e.values e.coefficients hi,
        have same :=
          R1Z.PV_ROWS10B_CanonConsumed.update_read e.point e.updated e.round e.sampled e.read (range e he) hu hr;
        Eq.mpr (id (congrArg (fun _a => R1Z.PV_ROWS10B_CanonConsumed.Canonical limb _a) same))
          (challenge e.trace e.sampled e.after hs)⟩)
