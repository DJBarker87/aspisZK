def NLW_AuthState.transcription : {Ambient H : Type} →
  Child Ambient → State Ambient H → Observation Ambient (Event Ambient H) Reply :=
fun {Ambient H} child s =>
  have p := NLE_ParseInstall.parse s.args.proof;
  have e := Event.parse s p;
  match p with
  | fail err => { post := s.world, run := { result := fail err, events := [e] } }
  | div => { post := s.world, run := { result := div, events := [e] } }
  | ok (core.result.Result.Err err) =>
    { post := s.world, run := { result := ok (core.result.Result.Err err), events := [e] } }
  | ok (core.result.Result.Ok a) =>
    have c := child s.args s.world;
    { post := c.post, run := { result := c.run.result, events := [e, Event.parsed s, Event.common s c] } }

