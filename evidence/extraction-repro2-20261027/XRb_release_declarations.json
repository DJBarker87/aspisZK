    "source_text": "fn query_loop(proof: &[u8], p: &Prepared, mut a: Accumulator, g: &[E; 29], obs: Observer, geometry: &QueryGeometry, pending: BatchedWeights, end: usize) -> Result<(Accumulator, BatchedWeights), Error> {\n    let mut state = Ok((a, pending));\n    loop {\n        match state {\n            Err(error) => return Err(error),\n            Ok((a, pending)) => {\n                if a.next >= end {\n                    return Ok((a, pending));\n                }\n                state = query_values(proof, p, a, g, obs, geometry, pending);\n            }\n        }\n    }\n}",
