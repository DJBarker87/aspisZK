theorem AspisR1.NJF_RegularContinuation.source : ∀ [inst : FIo_Native.Allocation] (c : Context) (before : Scratch),
  NIT_PairDomain.Domain c.w.value c.alpha.value c.f.value c.kappa →
    canonical c.ap0.value →
      canonical c.ap1.value →
        NHX_RegularPost.Inv before initial →
          continueWith c (G (NGM_GuardExact.guard c.w.value 2#usize) (instantiate c before)).1 =
            (NIW_AlignRegularPhase.run c before).1 :=
fun [FIo_Native.Allocation] c before domain c0 c1 inv =>
  Eq.mpr
    (id
      (congrArg (fun _a => continueWith c _a.1 = (NIW_AlignRegularPhase.run c before).1)
        (NJF_RegularInstantiation.source c before)))
    (Eq.trans (interpreted c before domain.factors) (NIW_AlignRegularPhaseSource.source c before domain c0 c1 inv))
