    (commonReply c)
    (fun value h =>
      Eq.ndrec (motive := fun x => commonReply c = x → continueWith c (stage c scratch parts) = shared c parts)
        (fun hc =>
          let ⟨owner, cells, hc⟩ := value
          id
            (fun common =>
              have produced := common.right;
              have same :=
                (Eq.mp
                      (congrArg
                        (fun x =>
                          match x with
                          | ok value =>
                            (fun out =>
                                NIT_CommonChain.Trace c.w.value 17
                                    ({ start := 0#usize, «end» := 16#usize },
