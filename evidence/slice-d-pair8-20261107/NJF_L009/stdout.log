theorem AspisR1.NJF_SharedContinuation.source : ∀ (c : Context) (scratch : Scratch) (parts : Parts),
  NHI_TensorOuterStep.Factors c.w.value → continueWith c (stage c scratch parts) = shared c parts :=
fun c scratch parts hf =>
  have cz := fun x hx => Eq.symm (Eq.mp source._simp_1 hx).right ▸ NHX_FilledZero.zero_canonical;
  have common := NIW_AlignCommonSource.source c.w.value hf (Array.repeat 16#usize NHX_FilledZero.zeroQ) cz;
  casesOn (motive := fun t => commonReply c = t → continueWith c (stage c scratch parts) = shared c parts)
    (commonReply c)
    (fun value h =>
      Eq.ndrec (motive := fun x => commonReply c = x → continueWith c (stage c scratch parts) = shared c parts)
        (fun hc =>
          let ⟨owner, cells, hc⟩ := value
          id
            (fun common =>
              have produced := common.right;
              have same :=
                (Eq.mp
                      (congrArg
                        (fun x =>
                          match x with
                          | ok value =>
                            (fun out =>
                                NIT_CommonChain.Trace c.w.value 17
                                    ({ start := 0#usize, «end» := 16#usize },
                                      Array.repeat 16#usize NHX_FilledZero.zeroQ)
                                    out ∧
                                  out.1 = c.w.value ∧ NHI_CellCanon.array out.2)
                              value
                          | fail e => False
                          | div => False)
                        hc)
                      produced).right.left;
              Eq.ndrec (motive := fun owner =>
                commonReply c = ok (owner, cells) →
                  NIT_CommonChain.Trace c.w.value 17
                        ({ start := 0#usize, «end» := 16#usize }, Array.repeat 16#usize NHX_FilledZero.zeroQ)
                        (owner, cells) ∧
                      owner = c.w.value ∧ NHI_CellCanon.array cells →
                    continueWith c (stage c scratch parts) = shared c parts)
                (fun hc produced =>
                  have reference :=
                    Eq.mpr
                      (id
                        (congrArg (fun _a => _a = ok (c.w.value, cells))
                          (Eq.symm
                            (NIG_CommonLoop.common_source c.w.value (Array.repeat 16#usize NHX_FilledZero.zeroQ)))))
                      (Eq.trans common.left hc);
                  casesOn (motive := fun t =>
                    FIo_Native.weights.shared_partials c.f.value cells = t →
                      continueWith c (stage c scratch parts) = shared c parts)
                    (FIo_Native.weights.shared_partials c.f.value cells)
                    (fun partials h =>
                      Eq.ndrec (motive := fun x =>
                        FIo_Native.weights.shared_partials c.f.value cells = x →
                          continueWith c (stage c scratch parts) = shared c parts)
                        (fun hp =>
                          core.result.Result.casesOn (motive := fun t =>
                            partials = t → continueWith c (stage c scratch parts) = shared c parts) partials
                            (fun values h =>
                              Eq.ndrec (motive := fun partials =>
                                FIo_Native.weights.shared_partials c.f.value cells = ok partials →
                                  continueWith c (stage c scratch parts) = shared c parts)
                                (fun hp =>
                                  casesOn (motive := fun t =>
                                    FIo_Native.weights.shared_high values c.w.value c.ap0.value c.ap1.value parts = t →
                                      continueWith c (stage c scratch parts) = shared c parts)
                                    (FIo_Native.weights.shared_high values c.w.value c.ap0.value c.ap1.value parts)
                                    (fun result h =>
                                      Eq.ndrec (motive := fun x =>
                                        FIo_Native.weights.shared_high values c.w.value c.ap0.value c.ap1.value parts =
                                            x →
                                          continueWith c (stage c scratch parts) = shared c parts)
                                        (fun hh =>
                                          let ⟨reply, after, hh⟩ := result
                                          of_eq_true
                                            (Eq.trans
                                              (congr
                                                (congrArg Eq
                                                  (congrArg
                                                    (fun x =>
                                                      match x with
                                                      | fail err => fail err
                                                      | div => div
                                                      | ok (reply, fst, parts) => afterHigh c c.w parts reply)
                                                    (Eq.trans
                                                      (congrArg
                                                        (fun x =>
                                                          match x with
                                                          | fail err => fail err
                                                          | div => div
                                                          | ok (owner, cells) =>
                                                            match
                                                              FIo_Native.weights.shared_partials c.f.value cells with
                                                            | fail err => fail err
                                                            | div => div
                                                            | ok (core.result.Result.Err err) =>
                                                              ok (core.result.Result.Err err, scratch, parts)
                                                            | ok (core.result.Result.Ok values) =>
                                                              match
                                                                FIo_Native.weights.shared_high values owner c.ap0.value
                                                                  c.ap1.value parts with
                                                              | fail err => fail err
                                                              | div => div
                                                              | ok (reply, after) => ok (reply, scratch, after))
                                                        hc)
                                                      (Eq.trans
                                                        (congrArg
                                                          (fun x =>
                                                            match x with
