def KMX_CopyMeaning.loop : {α : Type} → (ℕ → α) → (ℕ → α) → ℕ → ℕ → ℕ → α :=
fun {α} src dst start x => Nat.brecOn (motive := fun x => (ℕ → α) → ℕ → ℕ → α) x (KMX_CopyMeaning.loop._f src) dst start
