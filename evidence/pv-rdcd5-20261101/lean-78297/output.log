  ↑last ≤ (↑v).length →
    ↑first ≤ ↑last →
      ∃ a,
        PV_AL_SplitFlat.copy_range v first last (Aeneas.Std.alloc.vec.Vec.new Aeneas.Std.U8) = Aeneas.Std.Result.ok a ∧
          ↑a = R1Z.PV_AL_RangeLists.segment ↑v ↑first ↑last
R1Z.PV_AL_RangeSource.source : ∀ (v : Aeneas.Std.Slice Aeneas.Std.U8) (first last : Aeneas.Std.Usize)
  (out : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8),
  ↑last ≤ (↑v).length →
    ↑first ≤ ↑last →
      ↑out = [] →
        ∃ a,
          PV_AL_SplitFlat.copy_range v first last out = Aeneas.Std.Result.ok a ∧
            ↑a = R1Z.PV_AL_RangeLists.segment ↑v ↑first ↑last
R1Z.PV_AL_RangeStep.continuing : ∀ (v : Aeneas.Std.Slice Aeneas.Std.U8) (out : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
  (last i : Aeneas.Std.Usize) (h : ↑i < ↑last) (hv : ↑last ≤ (↑v).length),
  (↑out).length < Aeneas.Std.Usize.max →
    ∃ next,
      PV_AL_SplitFlat.copy_range_loop.body v last out i =
          Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.cont (next, i.wrapping_add 1#usize)) ∧
        ↑next = ↑out ++ [(↑v)[↑i]]
R1Z.PV_AL_RangeStep.done : ∀ (v : Aeneas.Std.Slice Aeneas.Std.U8) (out : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
  (last i : Aeneas.Std.Usize),
  ↑last ≤ ↑i →
    PV_AL_SplitFlat.copy_range_loop.body v last out i = Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.done out)
R1Z.PV_AL_RangeUnfold.same_body : ∀ (v : Aeneas.Std.Slice Aeneas.Std.U8) (last : Aeneas.Std.Usize)
  (out : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8) (i : Aeneas.Std.Usize),
  PV_AL_SplitFlat.copy_range_loop.body v last out i = PV_CBL_PopSlices.pop_slices_reference_loop.body v last out i
R1Z.PV_AL_RangeUnfold.same_loop : ∀ (v : Aeneas.Std.Slice Aeneas.Std.U8) (last : Aeneas.Std.Usize)
  (out : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8) (i : Aeneas.Std.Usize),
  PV_AL_SplitFlat.copy_range_loop v last out i = PV_CBL_PopSlices.pop_slices_reference_loop v out last i
R1Z.PV_AL_RangeUnfold.unfold_loop : ∀ (v : Aeneas.Std.Slice Aeneas.Std.U8) (last : Aeneas.Std.Usize)
  (out : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8) (i : Aeneas.Std.Usize),
  PV_AL_SplitFlat.copy_range_loop v last out i = do
    let cf ← PV_AL_SplitFlat.copy_range_loop.body v last out i
    match cf with
      | Aeneas.Std.ControlFlow.done a => Aeneas.Std.Result.ok a
      | Aeneas.Std.ControlFlow.cont (a, j) => PV_AL_SplitFlat.copy_range_loop v last a j
