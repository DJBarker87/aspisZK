R1Z.PV_AL_RangeInvariant.advance : ∀ (v : Aeneas.Std.Slice Aeneas.Std.U8)
  (out next : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8) (lo : ℕ) (i : Aeneas.Std.Usize),
  lo ≤ ↑i →
    ∀ (hi : ↑i < (↑v).length),
      ↑out = R1Z.PV_AL_RangeLists.segment (↑v) lo ↑i →
        ↑next = ↑out ++ [(↑v)[↑i]] → ↑next = R1Z.PV_AL_RangeLists.segment (↑v) lo (↑i + 1)
R1Z.PV_AL_RangeInvariant.capacity : ∀ (v : Aeneas.Std.Slice Aeneas.Std.U8)
  (out : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8) (lo : ℕ) (i last : Aeneas.Std.Usize),
  ↑last ≤ (↑v).length →
    ↑i < ↑last → lo ≤ ↑i → ↑out = R1Z.PV_AL_RangeLists.segment (↑v) lo ↑i → (↑out).length < Aeneas.Std.Usize.max
@R1Z.PV_AL_RangeLists.advance : ∀ {T : Type} (xs : List T) (lo i : ℕ),
  lo ≤ i →
    ∀ (hi : i < xs.length), R1Z.PV_AL_RangeLists.segment xs lo i ++ [xs[i]] = R1Z.PV_AL_RangeLists.segment xs lo (i + 1)
@R1Z.PV_AL_RangeLists.initial_segment : ∀ {T : Type} (xs : List T) (hiEnd : ℕ),
  R1Z.PV_AL_RangeLists.segment xs 0 hiEnd = List.take hiEnd xs
@R1Z.PV_AL_RangeLists.length : ∀ {T : Type} (xs : List T) (lo hiEnd : ℕ),
  lo ≤ hiEnd → hiEnd ≤ xs.length → (R1Z.PV_AL_RangeLists.segment xs lo hiEnd).length = hiEnd - lo
