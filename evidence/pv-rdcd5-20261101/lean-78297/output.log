R1Z.PV_AL_RangeLoop.source : ∀ (v : Aeneas.Std.Slice Aeneas.Std.U8) (out : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
  (lo : ℕ) (last i : Aeneas.Std.Usize),
  ↑last ≤ (↑v).length →
    ↑i ≤ ↑last →
      lo ≤ ↑i →
        ↑out = R1Z.PV_AL_RangeLists.segment (↑v) lo ↑i →
          ∃ a,
            PV_AL_SplitFlat.copy_range_loop v last out i = Aeneas.Std.Result.ok a ∧
              ↑a = R1Z.PV_AL_RangeLists.segment (↑v) lo ↑last
