@AspisR1.ART_Runtime.eval_runtime : ∀ {A F C : Type} (c : AspisR1.DrvC_Installation.Configuration F C)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (id : AspisR1.S2W_ExtractionBoundary.Program)
  (a : AspisR1.SCE_Experiment.Adversary A) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.ART_Runtime.runtime c hashv copy allocator id a) =
    have v := AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.ART_PartialAccount.account c hashv copy allocator id a);
    (v.1,
      Option.some
        (v.1, AspisR1.F3T_Canon.canonInput (AspisR1.F3T_ByteCarrier.input c (AspisR1.SCE_Experiment.submitted v.2.1)),
          AspisR1.SCE_Experiment.accepted v.2))
'AspisR1.ART_Runtime.eval_runtime' depends on axioms: [propext, Classical.choice, Quot.sound]
