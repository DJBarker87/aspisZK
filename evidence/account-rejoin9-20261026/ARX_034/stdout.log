@AspisR1.ARW_Induced.evaluation : ∀ {A : Type} (native1 : AspisR1.S2W_ExtractionBoundary.First)
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (id : AspisR1.S2W_ExtractionBoundary.Program)
  (a : AspisR1.SCE_Experiment.Adversary A) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.ARW_Induced.program native1 copy allocator id a) =
    (AspisR1.ARW_Induced.issued native1 copy allocator id a H,
      AspisR1.SCE_Experiment.submitted (AspisV8R19.MemoizedProgramLaw.eval H a.first).2)
'AspisR1.ARW_Induced.evaluation' depends on axioms: [propext, Classical.choice, Quot.sound]
