                R1Z.QueryScanFreshUnion.freshBudget
                  (8 *
                      R1Z.GamesR1PBin.n1
                        (R1Z.PhaseProtocolInstanceBin.wire
                            (R1Z.PrivacyR1AcctModel.base template R1Z.PhaseWireLog2Bin.log)
                            ((R1Z.PrivacyR1AcctModel.base template R1Z.PhaseWireLog2Bin.log).pubBytes x).length
                            (R1Z.PhaseWireLog2Bin.honest R1Z.PrivacyR1HeadlineDeployedEvents.input)
                            R1Z.PrivacyR1AcctBasis.basis outputs x).toWire
                        (R1Z.PhaseProtocolInstanceBin.prover
                            (R1Z.PrivacyR1AcctModel.base template R1Z.PhaseWireLog2Bin.log)
                            ((R1Z.PrivacyR1AcctModel.base template R1Z.PhaseWireLog2Bin.log).pubBytes x).length
                            (R1Z.PhaseWireLog2Bin.honest R1Z.PrivacyR1HeadlineDeployedEvents.input)
                            R1Z.PrivacyR1AcctBasis.basis outputs x
                            (R1Z.PrivacyR1AcctModel.seed
                              (R1Z.PhaseProtocolInstanceBin.wire
                                  (R1Z.PrivacyR1AcctModel.base template R1Z.PhaseWireLog2Bin.log)
                                  ((R1Z.PrivacyR1AcctModel.base template R1Z.PhaseWireLog2Bin.log).pubBytes x).length
                                  (R1Z.PhaseWireLog2Bin.honest R1Z.PrivacyR1HeadlineDeployedEvents.input)
                                  R1Z.PrivacyR1AcctBasis.basis outputs x).toWire
                              R1Z.PrivacyR1HeadlineDeployedEvents.ownedDecode R1Z.PhaseWireLog2Bin.fib
                              R1Z.PhaseWireLog2Bin.opens)).toProver +
                    1) +
              2 * R1Z.ProverCommitSeedEvent19.budget (2 ^ 64) +
            2 * R1Z.ProverCommitFuelMass22.charge ∧
        PV_EVH_Core.bound template outputs x < 1 / 2 ^ 100 :=
⋯
