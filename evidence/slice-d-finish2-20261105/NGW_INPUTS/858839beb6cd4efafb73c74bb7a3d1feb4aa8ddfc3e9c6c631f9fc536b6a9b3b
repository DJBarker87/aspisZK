fn words(x:K)->[u32;4]{[x.c0.a.0,x.c0.b.0,x.c1.a.0,x.c1.b.0]}
fn q(x:[u32;4])->K{K{c0:aspis_core::field::CM31{a:M31(x[0]),b:M31(x[1])},c1:aspis_core::field::CM31{a:M31(x[2]),b:M31(x[3])}}}
fn anyq()->K{let w:[u32;4]=kani::any();for x in w{kani::assume(x<2147483647);}q(w)}
type Factors=[[[K;4];5];5];
fn arbitrary()->Factors{core::array::from_fn(|_|core::array::from_fn(|_|core::array::from_fn(|_|q(kani::any()))))}
struct Products{replies:[K;4],left:[K;4],right:[K;4],calls:usize}
fn product(a:K,b:K,log:&mut Products)->K{let i=log.calls;log.left[i]=a;log.right[i]=b;log.calls+=1;log.replies[i]}
fn regular(points:&[[K;10];3],factors:&mut Factors,k:usize,d:usize,log:&mut Products){
 let a=points[k][9-2*TAU[d]];let b=points[k][8-2*TAU[d]];
 factors[k][d]=[product(K::ONE.sub(a),K::ONE.sub(b),log),product(a,K::ONE.sub(b),log),product(K::ONE.sub(a),b,log),product(a,b,log)];
}

fn row(a:K,b:K,log:&mut Products)->[K;4]{[product(K::ONE.sub(a),K::ONE.sub(b),log),product(a,K::ONE.sub(b),log),product(K::ONE.sub(a),b,log),product(a,b,log)]}
fn regular_exercise(g:u8){let a=anyq();let b=anyq();let replies=core::array::from_fn(|_|anyq());let mut log=Products{replies,left:[K::ZERO;4],right:[K::ZERO;4],calls:0};let out=row(a,b,&mut log);let limb:usize=kani::any();kani::assume(limb<4);let term:usize=kani::any();kani::assume(term<4);let left=[K::ONE.sub(a),a,K::ONE.sub(a),a];let right=[K::ONE.sub(b),K::ONE.sub(b),b,b];
 if cfg!(NGW_invert){match g{0..=3=>{let mut w=words(log.left[g as usize]);w[limb]^=1;log.left[g as usize]=q(w)},4=>log.calls+=1,_=>{let mut w=words(log.replies[term]);w[limb]^=1;log.replies[term]=q(w)}}}
 assert!(match g{0..=3=>words(log.left[g as usize])[limb]==words(left[g as usize])[limb]&&words(log.right[g as usize])[limb]==words(right[g as usize])[limb],4=>log.calls==4,_=>words(out[term])[limb]==words(log.replies[term])[limb]});}
fn store(dst:&mut[K;4],row:[K;4]){*dst=row;}
fn frame(g:u8){let mut dst=core::array::from_fn(|_|q(kani::any()));let row=core::array::from_fn(|_|q(kani::any()));store(&mut dst,row);let term:usize=kani::any();kani::assume(term<4);let limb:usize=kani::any();kani::assume(limb<4);let mut expected=words(row[term])[limb];if cfg!(NGW_invert){expected^=1;}assert!(words(dst[term])[limb]==expected);let _=g;}
fn window(g:u8){let mut f=arbitrary();let k:usize=kani::any();kani::assume(k<5);let d:usize=kani::any();kani::assume(d<5);let base=f.as_mut_ptr().cast::<K>();let selected=&mut f[k][d];let mut ptr=selected.as_mut_ptr();let len=selected.len();if cfg!(NGW_invert){ptr=ptr.wrapping_add(1);}assert!(len==4&&ptr==base.wrapping_add((5*k+d)*4));let _=g;}
fn lookup(g:u8){let points=core::array::from_fn::<_,3,_>(|_|core::array::from_fn::<_,10,_>(|_|q(kani::any())));let k:usize=kani::any();kani::assume(k<3);let d:usize=kani::any();kani::assume(d<5);let limb:usize=kani::any();kani::assume(limb<4);let a=points[k][9-2*TAU[d]];let b=points[k][8-2*TAU[d]];let t=match d{0=>3,1=>4,2=>2,3=>0,_=>1};let mut expected=words(points[k][9-2*t])[limb];if cfg!(NGW_invert){expected^=1;}assert!(words(a)[limb]==expected&&words(b)[limb]==words(points[k][8-2*t])[limb]);let _=g;}

struct CircleLog{products:Products,doubles:[K;2],double_args:[K;2],double_calls:usize,events:[u8;3],count:usize}
fn cmul(a:K,b:K,log:&mut CircleLog)->K{log.events[log.count]=1;log.count+=1;product(a,b,&mut log.products)}
fn dbl(x:K,log:&mut CircleLog)->K{let i=log.double_calls;log.double_args[i]=x;log.double_calls+=1;log.events[log.count]=0;log.count+=1;log.doubles[i]}
fn circle(factors:&mut Factors,k:usize,d:usize,x:&mut K,log:&mut CircleLog){let y=dbl(*x,log);factors[3+k][d]=[K::ONE,*x,y,cmul(*x,y,log)];*x=dbl(y,log);}
fn circle_exercise(g:u8){let term:usize=kani::any();kani::assume(term<4);let limb:usize=kani::any();kani::assume(limb<4);let mut a=anyq();let before=a;let y=anyq();let next=anyq();let p=anyq();let mut log=CircleLog{products:Products{replies:[p;4],left:[K::ZERO;4],right:[K::ZERO;4],calls:0},doubles:[y,next],double_args:[K::ZERO;2],double_calls:0,events:[9;3],count:0};let y=dbl(a,&mut log);let mut out=[K::ONE,a,y,cmul(a,y,&mut log)];a=dbl(y,&mut log);let expected=[K::ONE,before,y,p];let mut frame=words(expected[term])[limb];
 if cfg!(NGW_invert){match g{0=>{let mut w=words(log.products.left[0]);w[limb]^=1;log.products.left[0]=q(w)},1..=2=>{let mut w=words(log.double_args[(g-1)as usize]);w[limb]^=1;log.double_args[(g-1)as usize]=q(w)},3=>{let mut w=words(out[term]);w[limb]^=1;out[term]=q(w)},4=>{let mut w=words(a);w[limb]^=1;a=q(w)},5=>frame^=1,6=>log.events[1]^=1,_=>log.double_calls+=1}}
 assert!(match g{0=>words(log.products.left[0])[limb]==words(before)[limb]&&words(log.products.right[0])[limb]==words(y)[limb],1=>words(log.double_args[0])[limb]==words(before)[limb],2=>words(log.double_args[1])[limb]==words(y)[limb],3=>words(out[term])[limb]==words(expected[term])[limb],4=>words(a)[limb]==words(next)[limb],5=>words(out[term])[limb]==frame,6=>log.events==[0,1,0]&&log.count==3,_=>log.double_calls==2&&log.products.calls==1});}
fn initial(factors:&mut Factors,k:usize,z:&[SecureCirclePoint;2],log:&mut CircleLog)->K{factors[3+k][0]=[K::ONE,z[k].y,z[k].x,cmul(z[k].x,z[k].y,log)];dbl(z[k].x,log)}
fn initial_exercise(g:u8){let zx=anyq();let zy=anyq();let term:usize=kani::any();kani::assume(term<4);let limb:usize=kani::any();kani::assume(limb<4);let p=anyq();let next=anyq();let mut log=CircleLog{products:Products{replies:[p;4],left:[K::ZERO;4],right:[K::ZERO;4],calls:0},doubles:[next,K::ZERO],double_args:[K::ZERO;2],double_calls:0,events:[9;3],count:0};let mut out=[K::ONE,zy,zx,cmul(zx,zy,&mut log)];let x=dbl(zx,&mut log);let expected=[K::ONE,zy,zx,p];let mut frame=words(expected[term])[limb];
