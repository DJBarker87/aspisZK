 assert!(match g{0=>words(out[term])[limb]==words(expected[term])[limb],1=>words(log.products.left[0])[limb]==words(zx)[limb]&&words(log.products.right[0])[limb]==words(zy)[limb],2=>words(out[term])[limb]==frame,3=>words(log.double_args[0])[limb]==words(zx)[limb]&&words(x)[limb]==words(next)[limb],_=>log.products.calls==1&&log.double_calls==1&&log.count==2&&log.events[0]==1&&log.events[1]==0});}
