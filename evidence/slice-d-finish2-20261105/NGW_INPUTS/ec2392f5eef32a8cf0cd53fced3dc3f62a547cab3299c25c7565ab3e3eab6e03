struct Products{replies:[K;4],left:[K;4],right:[K;4],calls:usize}
fn product(a:K,b:K,log:&mut Products)->K{let i=log.calls;log.left[i]=a;log.right[i]=b;log.calls+=1;log.replies[i]}
fn regular(points:&[[K;10];3],factors:&mut Factors,k:usize,d:usize,log:&mut Products){
 let a=points[k][9-2*TAU[d]];let b=points[k][8-2*TAU[d]];
