+use super::*;
+fn phase() -> Phase {
+    match kani::any::<u8>() % 11 {
+        0 => Phase::Parsed, 1 => Phase::Semantic,
+        2 => Phase::SemanticPart(kani::any()), 3 => Phase::Prepare,
+        4 => Phase::CheckpointRead, 5 => Phase::Merkle(kani::any()),
+        6 => Phase::Query(kani::any()),
+        7 => Phase::QueryPart(kani::any(),kani::any()),
+        8 => Phase::CheckpointWrite, 9 => Phase::Relation, _ => Phase::Final,
+    }
+}
+#[kani::proof]
+fn NBC_mark_none() {
+    let p=phase();
+    super::mark(None,p);
+    kani::cover!(true);
+}
