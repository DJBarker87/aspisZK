+use super::*;
+struct NIO_Log {
+    next: u8, fail: u8, error: u64,
+    plan: Option<PlannedPairForestCheckpointAccountsV1>,
+    seen_master: bool, seen_checkpoint: bool, seen_lanes: usize,
+}
+impl NIO_Log {
+ fn step(&mut self, tag:u8)->ProgramResult {
+   assert!(self.next==tag);self.next+=1;
+   if self.fail==tag { Err(ProgramError::from(self.error)) } else {Ok(())}
+ }
+}
+fn NIO_call0(l:&mut NIO_Log,_data:&[u8])->ProgramResult {l.step(0)}
+fn NIO_call1(l:&mut NIO_Log,a:&[AccountInfo<'_>],n:usize)->ProgramResult {
+ assert!(a.len()==n);l.step(1)
+}
+fn NIO_call2(l:&mut NIO_Log,_a:&[AccountInfo<'_>])->ProgramResult {l.step(2)}
+fn NIO_call3(l:&mut NIO_Log,p:&AccountInfo<'_>,s:&AccountInfo<'_>)->ProgramResult {
+ assert!(p.rent_epoch==10);assert!(s.rent_epoch==11);l.step(3)
+}
+fn NIO_call4(l:&mut NIO_Log,_pid:&Pubkey,m:&AccountInfo<'_>,lanes:&[AccountInfo<'_>],c:&AccountInfo<'_>)->Result<PlannedPairForestCheckpointAccountsV1,ProgramError>{
+ l.seen_master=m.rent_epoch==0;l.seen_checkpoint=c.rent_epoch==9;l.seen_lanes=lanes.len();
+ assert!(l.seen_master && l.seen_checkpoint && l.seen_lanes==8);
+ l.step(4)?;Ok(l.plan.take().unwrap())
+}
+fn NIO_call5(l:&mut NIO_Log,c:&AccountInfo<'_>,_pid:&Pubkey,_key:&Pubkey,n:usize)->Result<FreshPdaPreparationV1,ProgramError>{
+ assert!(c.rent_epoch==9 && n==POOL_V1_PAIR_FOREST_CHECKPOINT_ACCOUNT_BYTES);
+ l.step(5)?;Ok(FreshPdaPreparationV1::ProgramOwnedZeroed)
+}
+fn NIO_call6(l:&mut NIO_Log,c:&AccountInfo<'_>,_pid:&Pubkey,n:usize,_rent:&Rent)->ProgramResult{
+ assert!(c.rent_epoch==9 && n==POOL_V1_PAIR_FOREST_CHECKPOINT_ACCOUNT_BYTES);l.step(6)
+}
+struct NIO_Runtime;
+impl PoolCpiRuntimeV1 for NIO_Runtime {
+ fn invoke<'i>(&mut self,_i:&Instruction,_a:&[AccountInfo<'i>])->ProgramResult {assert!(false);Ok(())}
+ fn invoke_signed<'i>(&mut self,_i:&Instruction,_a:&[AccountInfo<'i>],_s:&[&[&[u8]]])->ProgramResult {assert!(false);Ok(())}
+}
+
+pub(crate) fn NIO_checkpoint<'info, R: PoolCpiRuntimeV1>(
+    program_id: &Pubkey,
+    accounts: &[AccountInfo<'info>],
+    instruction_data: &[u8],
+    rent: &Rent,
+    runtime: &mut R,
+    nio_log: &mut NIO_Log,
+) -> ProgramResult {
+    NIO_call0(nio_log, instruction_data)?;
+    NIO_call1(nio_log, accounts, POOL_V1_PAIR_FOREST_CHECKPOINT_ACCOUNT_COUNT)?;
+    NIO_call2(nio_log, accounts)?;
+    let master = &accounts[FOREST_MASTER_ACCOUNT_INDEX];
+    let lanes = &accounts[FOREST_FIRST_LANE_ACCOUNT_INDEX
+        ..FOREST_FIRST_LANE_ACCOUNT_INDEX + POOL_V1_PAIR_FOREST_LANE_COUNT];
+    let checkpoint = &accounts[FOREST_MINT_OR_CHECKPOINT_ACCOUNT_INDEX];
+    let payer = &accounts[FOREST_CHECKPOINT_PAYER_ACCOUNT_INDEX];
+    let system_program_account = &accounts[FOREST_CHECKPOINT_SYSTEM_ACCOUNT_INDEX];
+    NIO_call3(nio_log, payer, system_program_account)?;
+
+    let planned = NIO_call4(nio_log, program_id, master, lanes, checkpoint)?;
+    let preparation = NIO_call5(nio_log, 
+        checkpoint,
+        program_id,
+        &planned.checkpoint,
+        POOL_V1_PAIR_FOREST_CHECKPOINT_ACCOUNT_BYTES,
+    )?;
+    if preparation == FreshPdaPreparationV1::CreateOrAllocateSystemOwned {
+        let checkpoint_state = decode_pool_v1_pair_forest_checkpoint_v1(&planned.checkpoint_image)
+            .map_err(|_| PoolV1ProgramError::StateHistoryMismatch)?;
+        let sequence_bytes = checkpoint_state.checkpoint_sequence.to_le_bytes();
+        let bump_bytes = [checkpoint_state.bump];
+        let seeds: &[&[u8]] = &[
+            POOL_V1_PAIR_FOREST_CHECKPOINT_SEED,
+            master.key.as_ref(),
+            &sequence_bytes,
+            &bump_bytes,
+        ];
+        create_or_allocate_pda(
+            runtime,
+            payer,
+            checkpoint,
+            system_program_account,
+            POOL_V1_PAIR_FOREST_CHECKPOINT_ACCOUNT_BYTES,
+            program_id,
+            seeds,
+        )?;
+    }
+    NIO_call6(nio_log, 
+        checkpoint,
+        program_id,
+        POOL_V1_PAIR_FOREST_CHECKPOINT_ACCOUNT_BYTES,
+        rent,
+    )?;
+
+    let mut master_data = master.try_borrow_mut_data()?;
+    let mut checkpoint_data = checkpoint.try_borrow_mut_data()?;
+    checkpoint_data.copy_from_slice(&planned.checkpoint_image);
+    master_data.copy_from_slice(&planned.next_master_image);
+    Ok(())
+}
