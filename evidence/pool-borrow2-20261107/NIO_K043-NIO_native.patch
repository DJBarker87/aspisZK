+let wantm=plan.next_master_image[jm];let wantc=plan.checkpoint_image[jc];let fail:u8=kani::any();let error:u64=kani::any();let mut log=NIO_Log{next:0,fail,error,plan:Some(plan),seen_master:false,seen_checkpoint:false,seen_lanes:0};
+let result=NIO_checkpoint(&k0,&accounts,&[],&Rent::default(),&mut NIO_Runtime,&mut log);
+if fail<7 {assert!(result==Err(ProgramError::from(error)));assert!(log.next==fail+1);}else{assert!(log.next==7);assert!(result==Ok(()));}
