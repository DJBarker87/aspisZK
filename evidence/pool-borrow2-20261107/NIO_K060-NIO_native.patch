+#[kani::proof]
+fn certificate(){let n0:i64=kani::any();kani::assume(n0>=-1);let c0=NIO_Cell{counter:Cell::new(n0),payload:Cell::new(kani::any())};
+let n1:i64=kani::any();kani::assume(n1>=-1);let c1=NIO_Cell{counter:Cell::new(n1),payload:Cell::new(kani::any())};
+let n2:i64=kani::any();kani::assume(n2>=-1);let c2=NIO_Cell{counter:Cell::new(n2),payload:Cell::new(kani::any())};
+let n3:i64=kani::any();kani::assume(n3>=-1);let c3=NIO_Cell{counter:Cell::new(n3),payload:Cell::new(kani::any())};
+kani::assume(n3>=0 && n3<i64::MAX);
+let cells=[&c0,&c1,&c2];let m0:usize=kani::any();kani::assume(m0<3);let m1:usize=kani::any();kani::assume(m1<3);let m2:usize=kani::any();kani::assume(m2<3);
+let mut log=NIO_Log{next:0,fail:kani::any(),code:kani::any()};let _result=NIO_reference([cells[m0],cells[m1],cells[m2],&c3],&mut log);
+assert!(c0.counter.get()==n0);
+assert!(c1.counter.get()==n1);
+assert!(c2.counter.get()==n2);
+assert!(c3.counter.get()==n3);
+}
