@XRm_ActualDot.associated : ∀ {H : Type} (D : aspis_core.digest.Digest32 H) (sem : r1_semantic.Verified H)
  (view : verifier.View) (hash : H) (old scratch : Std.Array XRk_Wide 29#usize) (prepared : verifier.Prepared),
  verifier.Prepared.new D sem view hash old = ok (core.result.Result.Ok prepared, scratch) →
    ∀ (q : Std.Array U8 608#usize) (slot : Usize) (out : XRk_Wide),
      fast_dots.four_dots_one q scratch slot = ok out →
        ∃ xs d ops,
          XRl_DotHistory.Reached xs d ∧
            xs.length = 3 ∧
              ↑d.count = 3 ∧
                (∀ v ∈ xs, XRl_WideCanonical.Canonical v.1 ∧ XRk_CanonicalScalar.Canonical v.2) ∧
                  XRl_DotSums.Operands xs ops ∧
                    ∀ (j : Fin 4),
                      ↑((↑d.c0.sums)[↑j]?.getD 0#u64) =
                          List.foldl (XRm_DotNoWrap.natStep j) 0 (List.map (fun v => (v.1, v.2.2)) ops) ∧
                        ↑((↑d.c1.sums)[↑j]?.getD 0#u64) =
                          List.foldl (XRm_DotNoWrap.natStep j) 0 (List.map (fun v => (v.2.1, v.2.2)) ops)
XRm_ReverseSites.reverse_site : ∀ (c : sampler.low_base_p_digits.closure_1) (s : XRm_ReverseSites.State),
  XRm_ReverseSites.Reached c s → XRk_reverseNext XRm_ReverseSites.dict s.1 = XRl_Adapter.originalReverseNext s.1
XRm_QueryPoint.reached : ∀ (start : Usize) (it next : core.slice.iter.Iter U32) (query : U32)
  (lines flat outLines outFlat : alloc.vec.Vec aspis_core.field.M31),
  core.slice.iter.IteratorSliceIter.next it = ok (some query, next) →
    verifier.QueryGeometry.for_range_loop0.body start it lines flat = ok (cont (next, outLines, outFlat)) →
      ∃ point high a b,
        UScalar.cast UScalarTy.Usize query < 262144#usize ∧
          fast_domain.fibre_point (UScalar.cast UScalarTy.Usize query) = ok point ∧
            UScalar.cast UScalarTy.Usize query >>> 9#i32 = ok high ∧
              fast_domain.TABLE_A.index_usize (UScalar.cast UScalarTy.Usize query &&& 511#usize) = ok a ∧
                fast_domain.TABLE_B.index_usize high = ok b ∧
                  ↑↑point.x = ↑↑a.1 * ↑↑b.1 - ↑↑a.2 * ↑↑b.2 ∧ ↑↑point.y = ↑↑a.1 * ↑↑b.2 + ↑↑a.2 * ↑↑b.1
XRm_QueryLineStep.continuation : ∀ (start : Usize) (it next : core.slice.iter.Iter U32) (query : U32)
  (lines flat outLines outFlat : alloc.vec.Vec aspis_core.field.M31),
  core.slice.iter.IteratorSliceIter.next it = ok (some query, next) →
    verifier.QueryGeometry.for_range_loop0.body start it lines flat = ok (cont (next, outLines, outFlat)) →
      ∃ fibre point xIndex yIndex x y square double one z,
        fast_domain.fibre_point fibre = ok point ∧
          fast_domain.line_node xIndex = ok x ∧
            fast_domain.line_node yIndex = ok y ∧
              aspis_core.field.M31.mul x x = ok square ∧
                aspis_core.field.M31.double square = ok double ∧
                  aspis_core.field.M31.ONE = ok one ∧
                    aspis_core.field.M31.sub double one = ok z ∧
                      ↑outLines = ↑lines ++ [z] ∧
                        ↑outFlat = ↑flat ++ [point.x, point.y, x, y, z] ∧
                          (XRm_FieldCanonical.M point.x ∧
                              XRm_FieldCanonical.M point.y ∧
                                XRm_FieldCanonical.M x ∧ XRm_FieldCanonical.M y ∧ XRm_FieldCanonical.M z) ∧
                            ↑↑z = 2 * ↑↑x ^ 2 - 1
@XRm_CandidateAssociation.source : ∀ {H : Type} (D : aspis_core.digest.Digest32 H)
  (pub : aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public) (physical proof : Slice U8) (split : Usize)
  (hash : H) (obs : Option (verifier.Phase → Result Unit)) (out : alloc.vec.Vec U8),
  verifier.candidate.tx1 D pub physical proof split hash obs = ok (core.result.Result.Ok out) →
    ∃ p scratch zero a,
      verifier.candidate.parse_shape proof = ok (core.result.Result.Ok transport.Variant.S2) ∧
        verifier.candidate.canonical_scan proof = ok (core.result.Result.Ok ()) ∧
          split = compact.SPLIT ∧
            aspis_core.field.wide_exact.WideExact.ZERO = ok zero ∧
              verifier.candidate.prepare D pub proof hash obs (Array.repeat 29#usize zero) =
                  ok (core.result.Result.Ok p, scratch) ∧
                (∀ e ∈ ↑scratch, XRm_WideProducer.Canonical e) ∧
                  ∃ proofHash publicHash wideBytes payload checksum,
                    XRk_digest D hash [proof] = ok proofHash ∧
                      XRk_digest D hash [physical] = ok publicHash ∧
                        XRk_asSlice (XRm_CheckpointCalls.bytes p a proofHash publicHash wideBytes) = ok payload ∧
                          XRk_digest D hash [XRm_CheckpointCalls.label, payload] = ok checksum ∧
                            ↑out = ↑payload ++ ↑checksum
