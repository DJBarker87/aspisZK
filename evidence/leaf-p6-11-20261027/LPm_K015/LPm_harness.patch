+ let mut s=EbyKDot{c0:Dot{sums:old[0]},c1:Dot{sums:old[1]},count};
+ unsafe{LPm_CALLS=0;LPm_A=[[w[0],w[1],w[2],w[3]],[w[4],w[5],w[6],w[7]]];LPm_B=scalar;LPm_PTR=[&s.c0 as *const Dot,&s.c1 as *const Dot];}
+ let result=s.push(value,q);let canonical=scalar[0]<P&&scalar[1]<P&&scalar[2]<P&&scalar[3]<P;
+ assert_eq!(result.is_ok(),canonical);
+ assert_eq!(unsafe{LPm_CALLS},if canonical{2}else{0});assert_eq!(s.count,count+usize::from(canonical));
+ if !canonical {let j:usize=kani::any();kani::assume(j<4);assert_eq!(s.c0.sums[j],old[0][j]);assert_eq!(s.c1.sums[j],old[1][j]);}
+ kani::cover!(canonical);kani::cover!(!canonical);kani::cover!(count==28);
+}
