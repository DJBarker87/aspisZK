+//! Native public caller with a Lean-discharged private Dot update.
+use super::*;
+use super::super::{E,EbyKDot};
+use aspis_core::field::{CM31,QM31,M31};
+static mut LPm_CALLS:usize=0;
+static mut LPm_A:[[u32;4];2]=[[0;4];2];
+static mut LPm_B:[u32;4]=[0;4];
+static mut LPm_PTR:[*const Dot;2]=[core::ptr::null();2];
+fn LPm_spec(a:[u32;4],b:[u32;4])->[u64;4]{
+ let [a,b0,c,d]=a.map(u64::from);let [e,f,g,h]=b.map(u64::from);
+ const PP:u64=2147483647u64*2147483647u64;
+ let partial=|x:u64|(x&2147483647).wrapping_add(x>>31);
+ let u=partial(c.wrapping_mul(g).wrapping_add(PP).wrapping_sub(d.wrapping_mul(h)));
+ let v=partial(c.wrapping_mul(h).wrapping_add(d.wrapping_mul(g)));
+ [a.wrapping_mul(e).wrapping_add(PP).wrapping_sub(b0.wrapping_mul(f)).wrapping_add(2u64.wrapping_mul(u)).wrapping_add(3*2147483647u64).wrapping_sub(v),
+  a.wrapping_mul(f).wrapping_add(b0.wrapping_mul(e)).wrapping_add(u).wrapping_add(2u64.wrapping_mul(v)),
+  a.wrapping_mul(g).wrapping_add(c.wrapping_mul(e)).wrapping_add(2*PP).wrapping_sub(b0.wrapping_mul(h)).wrapping_sub(d.wrapping_mul(f)),
+  a.wrapping_mul(h).wrapping_add(b0.wrapping_mul(g)).wrapping_add(c.wrapping_mul(f)).wrapping_add(d.wrapping_mul(e))]
+}
+fn LPm_dot(self_:&mut Dot,a:Q,b:Q){
+ let av=a.limbs();let bv=b.limbs();let phase=unsafe{LPm_CALLS};assert!(phase<2);
+ for j in 0..4 {assert!(av[j]<P);assert!(bv[j]<P);assert_eq!(av[j],unsafe{LPm_A[phase][j]});assert_eq!(bv[j],unsafe{LPm_B[j]});}
+ assert!(core::ptr::eq(self_ as *const Dot,unsafe{LPm_PTR[phase]}));
+ let raw:[u64;4]=kani::any();kani::assume(raw==LPm_spec(av,bv));
+ for j in 0..4 {self_.sums[j]=self_.sums[j].wrapping_add((raw[j]&u64::from(P)).wrapping_add(raw[j]>>31));}
+ unsafe{LPm_CALLS=phase+1;}
+}
