+mod LPm_emul {
+ use super::*;
+ const P:u64=2147483647;
+ fn add(a:u32,b:u32)->u32{(u64::from(a).wrapping_add(u64::from(b))%P) as u32}
+ fn sub(a:u32,b:u32)->u32{(u64::from(a).wrapping_add(P).wrapping_sub(u64::from(b))%P) as u32}
+ fn cm(a:[u32;2],b:[u32;2])->[u32;2]{
+  let m0=(u64::from(a[0]).wrapping_mul(u64::from(b[0]))%P) as u32;
+  let m1=(u64::from(a[1]).wrapping_mul(u64::from(b[1]))%P) as u32;
+  let sa=u64::from(a[0]).wrapping_add(u64::from(a[1]));let sb=u64::from(b[0]).wrapping_add(u64::from(b[1]));
+  let m2=(sa.wrapping_mul(sb)%P) as u32;[sub(m0,m1),sub(sub(m2,m0),m1)]
+ }
+ fn ca(a:[u32;2],b:[u32;2])->[u32;2]{[add(a[0],b[0]),add(a[1],b[1])]}
+ fn cs(a:[u32;2],b:[u32;2])->[u32;2]{[sub(a[0],b[0]),sub(a[1],b[1])]}
+ fn cr(a:[u32;2])->[u32;2]{[sub(add(a[0],a[0]),a[1]),add(a[0],add(a[1],a[1]))]}
+ fn qm(a:[u32;4],b:[u32;4])->[u32;4]{
+  let ac=cm([a[0],a[1]],[b[0],b[1]]);let bd=cm([a[2],a[3]],[b[2],b[3]]);
+  let cross=cm(ca([a[0],a[1]],[a[2],a[3]]),ca([b[0],b[1]],[b[2],b[3]]));
+  let lo=ca(ac,cr(bd));let hi=cs(cs(cross,ac),bd);[lo[0],lo[1],hi[0],hi[1]]
+ }
+ fn qa(a:[u32;4],b:[u32;4])->[u32;4]{[add(a[0],b[0]),add(a[1],b[1]),add(a[2],b[2]),add(a[3],b[3])]}
+ fn qs(a:[u32;4],b:[u32;4])->[u32;4]{[sub(a[0],b[0]),sub(a[1],b[1]),sub(a[2],b[2]),sub(a[3],b[3])]}
+ fn qu(a:[u32;4])->[u32;4]{let r=cr([a[2],a[3]]);[r[0],r[1],a[0],a[1]]}
+ pub fn spec(a:[u32;8],b:[u32;8])->[u32;8]{
+  let a0=[a[0],a[1],a[2],a[3]];let a1=[a[4],a[5],a[6],a[7]];
+  let b0=[b[0],b[1],b[2],b[3]];let b1=[b[4],b[5],b[6],b[7]];
+  let ac=qm(a0,b0);let bd=qm(a1,b1);let cross=qm(qa(a0,a1),qa(b0,b1));
