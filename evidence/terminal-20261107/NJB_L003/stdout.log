theorem AspisR1.NJB_SemanticPublic.result : ∀ (statement : PoolV1PairForestTerminalStatementV1),
  statement.semantic_public = ok (value statement) :=
fun statement =>
  PoolV1PairForestTerminalStatementV1.casesOn (motive := fun t =>
    statement = t → statement.semantic_public = ok (value statement)) statement
    (fun a a_1 h => Eq.symm h ▸ Eq.refl (PoolV1PairForestTerminalStatementV1.PrivateTransfer a a_1).semantic_public)
    (fun a a_1 h => Eq.symm h ▸ Eq.refl (PoolV1PairForestTerminalStatementV1.Withdrawal a a_1).semantic_public)
    (Eq.refl statement)
'AspisR1.NJB_SemanticPublic.result' depends on axioms: [propext, Classical.choice, Quot.sound]
