theorem AspisR1.NJB_CopyResidual.result : ∀ (r : CopyRowExtension) (helper chi : field.QM31),
  canonical r.producer_values →
    canonical r.consumer_values →
      canonical r.producer_weights →
        canonical r.consumer_weights →
          Canon helper →
            Canon chi →
              ∃ out,
                copy_residual r helper chi = ok out ∧
                  Canon out ∧ decode out = FIw_CopyMeaning.residual r (decode helper) (decode chi) :=
fun r helper chi hpv hcv hpw hcw hh hc => JFy_CopyResidualValue.source r helper chi hpv hcv hpw hcw hh hc
'AspisR1.NJB_CopyResidual.result' depends on axioms: [propext, Classical.choice, Quot.sound]
