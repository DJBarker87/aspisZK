theorem AspisR1.NJB_ActiveReference.result : ∀ (s : Selectors),
  FIw_ArrayValue.canonical s.high →
    FIw_ArrayValue.canonical s.low →
      ∃ out, reference s = ok out ∧ Canon out ∧ decode out = R0P.copyActiveLiteral (model s) :=
fun s hh hl =>
  have hhigh := fun b => hh (high s b) (List.getElem_mem (high._proof_3 s b));
  have hlow := fun c => hl (low s c) (List.getElem_mem (low._proof_3 s c));
  let ⟨grouped, h✝⟩ :=
    NJB_ActiveRawHigh.run_result (high s) (List.ofFn fun b => b) (fun x => FIq_Native.field.QM31.ZERO) hhigh fun x =>
      FIv_NativeValue.zero.left
  let ⟨call, right✝⟩ := h✝
  let ⟨hgrouped, vgrouped⟩ := right✝
  let ⟨out, h✝¹⟩ :=
    NJB_ActiveRawLow.run_result grouped (low s) (List.ofFn fun c => c) FIq_Native.field.QM31.ZERO hgrouped hlow
      FIv_NativeValue.zero.left
  let ⟨cout, right✝¹⟩ := h✝¹
  let ⟨hout, vout⟩ := right✝¹
  Exists.intro out
    ⟨of_eq_true
        (Eq.trans
          (congrFun'
            (congrArg Eq
              (Eq.trans
                (Eq.trans
                  (congrFun' (congrArg Bind.bind call) fun grouped =>
                    NJB_ActiveRawLow.run grouped (low s) (List.ofFn fun c => c) FIq_Native.field.QM31.ZERO)
                  (bind_tc_ok grouped fun y =>
                    NJB_ActiveRawLow.run y (low s) (List.ofFn fun c => c) FIq_Native.field.QM31.ZERO))
                cout))
            (ok out))
          (eq_self (ok out))),
      ⟨hout,
        have hz := funext fun x => FIv_NativeValue.zero.right;
        id
          (fun vout =>
            Eq.trans
              (Eq.mp
                (congrArg
                  (fun _a =>
                    decode out =
                      NJB_ActiveModel.lowRun
                        (NJB_ActiveModel.highRun (fun i => decode (high s i)) (List.ofFn fun b => b) fun x => 0)
                        (fun c => decode (low s c)) (List.ofFn fun c => c) _a)
                  FIv_NativeValue.zero.right)
                (Eq.mp
                  (congrArg
                    (fun _a =>
                      decode out =
                        NJB_ActiveModel.lowRun _a (fun c => decode (low s c)) (List.ofFn fun c => c)
                          (decode FIq_Native.field.QM31.ZERO))
                    (Eq.mp
                      (congrArg
                        (fun _a =>
                          NJB_ActiveRawHigh.decoded grouped =
                            NJB_ActiveModel.highRun (fun i => decode (high s i)) (List.ofFn fun b => b) _a)
                        hz)
                      vgrouped))
                  vout))
              (NJB_ActiveModel.result (model s)))
          vout⟩⟩
'AspisR1.NJB_ActiveReference.result' depends on axioms: [propext, Classical.choice, Quot.sound]
