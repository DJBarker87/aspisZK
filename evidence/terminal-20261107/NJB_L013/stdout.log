theorem AspisR1.NJB_StubLaws.qm_mul : ∀ (x y : NQ),
  Canon x → Canon y → ∃ z, field.QM31.mul x y = ok z ∧ Canon z ∧ decode z = decode x * decode y :=
fun x y hx hy => JFy_FieldTotal.mul x y hx hy
theorem AspisR1.NJB_StubLaws.qm_add : ∀ (x y : NQ),
  Canon x → Canon y → ∃ z, field.QM31.add x y = ok z ∧ Canon z ∧ decode z = decode x + decode y :=
fun x y hx hy => FIv_PreparedTotal.add x y hx hy
theorem AspisR1.NJB_StubLaws.qm_sub : ∀ (x y : NQ),
  Canon x → Canon y → ∃ z, field.QM31.sub x y = ok z ∧ Canon z ∧ decode z = decode x - decode y :=
fun x y hx hy => JFy_FieldTotal.sub x y hx hy
'AspisR1.NJB_StubLaws.qm_mul' depends on axioms: [propext, Classical.choice, Quot.sound]
'AspisR1.NJB_StubLaws.qm_add' depends on axioms: [propext, Classical.choice, Quot.sound]
'AspisR1.NJB_StubLaws.qm_sub' depends on axioms: [propext, Classical.choice, Quot.sound]
