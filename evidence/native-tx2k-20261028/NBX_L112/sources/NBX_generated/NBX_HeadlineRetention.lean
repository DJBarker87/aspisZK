set_option autoImplicit false
noncomputable section
namespace NBX_HeadlineRetention
open Aeneas Aeneas.Std Result AspisR1
/-- Exact field of the actual headline missing record after installation.
This retention identity supplies no native extraction/frame premise. -/
theorem op23 {E : Type} (m : IDa_Deployed.Uninstalled E) (err : E)
    (r : NP6_StdModel.Reservation) :
    (DrvC_Installation.sdk (FIp_Install.configuration err
      (IDa_Deployed.deployedConfiguration (NBX_HeadlineSelection.nativeMissing m) err r) r)).op23 =
      m.adapter.op23 := by
  simpa only [IDa_Deployed.deployedConfiguration,NBX_HeadlineSelection.seed_instance,
    NBX_SeedAdapter.adapter] using
    NBX_InstalledOp23.retained (IDa_Deployed.seed m r) err r
#print axioms op23
