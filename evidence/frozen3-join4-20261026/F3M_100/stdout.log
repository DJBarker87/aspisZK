AspisR1.F3M_NativeClaim.native {CoreError : Type} (adapter : AdapterRw.Ops) (ops : AspisR1CurrentCaller.Ops)
  (reserved : Bool) (query : AspisR1.Port3_NativeQueryBody.Ops) (geo : AspisR1.Port3_NativeGeometryBody.Ops CoreError)
  (B : AspisR1PublicPreparation.FinishModel.Boundaries) (std : AspisR1.ClaimsUnrolledFinish.StdCalls)
  (native1 : AspisR1.S2W_ExtractionBoundary.First) (native2 : AspisR1.S2W_ExtractionBoundary.Second)
  (hashv : AspisR1.S2Z.Oracle.Parts → Aeneas.Std.Result AspisR1.S2Z.Oracle.Digest)
  (extraction :
    AspisR1.S2W_DigestExtraction.AeneasExtraction
      (AspisR1.ClaimsUnrolledSdk.sdkOps adapter (AspisR1.Uni_Install.current ops reserved query geo) B std) native1
      native2 hashv)
  (id : AspisR1.S2W_ExtractionBoundary.Program) (accounts1 accounts2 : AspisR1.S2W_ExtractionBoundary.Accounts)
  (data1 data2 : Aeneas.Std.Slice Aeneas.Std.U8) (slot : AspisR1.S2W_ExtractionBoundary.Slot)
  (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
  (accepted1 : native1 id accounts1 data1 = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok saved))
  (accepted2 : native2 id accounts2 data2 slot = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()))
  (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (p1 : AspisR1.S2W_ExtractionBoundary.P1 sha256 H)
  (syscall : AspisR1.S2W_ExtractionBoundary.RuntimeSyscall hashv sha256)
  (w : AspisR1.CanonicalCutEnrichedTranscript.Words) :
  ∃ f s log,
    AspisR1.S2W_NativeConsolidation.SourceCuts
        (AspisR1.ClaimsUnrolledSdk.sdkOps adapter (AspisR1.Uni_Install.current ops reserved query geo) B std) accounts1
        accounts2 saved f s ∧
      AspisR1.RawJ_RecordCuts.Recorded f s saved log ∧
        AspisR1.S2W_Trace.run
              (AspisR1.ClaimsUnrolledSdk.sdkOps adapter (AspisR1.Uni_Install.current ops reserved query geo) B std)
              (AspisR1.S2W_Observation.two
                (AspisR1.ClaimsUnrolledSdk.sdkOps adapter (AspisR1.Uni_Install.current ops reserved query geo) B std) id
                accounts1 data1 accounts2 data2 slot)
              [] =
            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok saved, log) ∧
          ∃ run i pre t0 t25 t26 t27 r25 r26 z0 z1 start cs init v c,
            c.t0 = start ∧
              i.physical.bytes = AspisR1.MultiproofConeCanonical.bytesOf ↑f.pub ∧
                i.stored = AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof ∧
                  i.semantic.value.pubBytes = AspisR1.MultiproofConeCanonical.bytesOf ↑init.encoded ∧
                    i.semantic.value.tag = 2 ∧
                      AspisR1PublicPreparation.SourceFull25.Trace
                          (AspisR1CurrentCaller.InstalledPreparation.retainedDigest
                            (AspisR1.Tx1Q_SameCut.callerDigest adapter (AspisR1.Op5T_Concrete.current ops) reserved
                              query geo B std))
                          pre t0 t25 cs ∧
                        List.map (fun c => ↑c.row) cs = List.range 25 ∧
                          (∀ row < 33, AspisR1.LiteralTranscript.valid row (i.proof row)) ∧
                            pre.validated_record 25#u8 = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok r25) ∧
                              AspisR1PublicPreparation.FinishModel.circle_validated
                                    (AspisR1PublicPreparation.S1SemanticRootCopy.install
                                      (AspisR1.ClaimsUnrolledFinish.install std B))
                                    (AspisR1CurrentCaller.InstalledPreparation.retainedDigest
                                      (AspisR1.Tx1Q_SameCut.callerDigest adapter (AspisR1.Op5T_Concrete.current ops)
                                        reserved query geo B std))
                                    t25 r25 =
                                  Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok z0, t26) ∧
                                pre.validated_record 26#u8 =
                                    Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok r26) ∧
                                  AspisR1PublicPreparation.FinishModel.circle_validated
                                        (AspisR1PublicPreparation.S1SemanticRootCopy.install
                                          (AspisR1.ClaimsUnrolledFinish.install std B))
                                        (AspisR1CurrentCaller.InstalledPreparation.retainedDigest
                                          (AspisR1.Tx1Q_SameCut.callerDigest adapter (AspisR1.Op5T_Concrete.current ops)
                                            reserved query geo B std))
                                        t26 r26 =
                                      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok z1, t27) ∧
                                    AspisR1PublicPreparation.transcript.Transcript.new
                                          (AspisR1CurrentCaller.InstalledPreparation.retainedDigest
                                            (AspisR1.Tx1Q_SameCut.callerDigest adapter
                                              (AspisR1.Op5T_Concrete.current ops) reserved query geo B std))
                                          () t27.state AspisR1PublicPreparation.transport.Variant.S2 =
                                        Aeneas.Std.Result.ok start ∧
                                      (AspisV8R19.MemoizedProgramLaw.eval H
                                              (AspisR1.F3J_SamplerRun.program i.proof 0 33
                                                (FS.emptyPrefix i.semantic.value))).1 =
                                          AspisR1PublicPreparation.SourceGlobalOracleInitial.initPair init ::
                                              AspisR1PublicPreparation.SourceDigestLog.sourceLog cs ++
                                            (AspisR1PublicPreparation.PreparedHashCode.observe
                                                  (AspisR1PublicPreparation.PreparedHashCode.run
                                                      (AspisR1PublicPreparation.S1SemanticCode.circleValidated
                                                        (AspisR1PublicPreparation.S1SemanticRootCopy.install
                                                          (AspisR1.ClaimsUnrolledFinish.install std B))
                                                        (AspisR1CurrentCaller.InstalledPreparation.retainedDigest
                                                          (AspisR1.Tx1Q_SameCut.callerDigest adapter
                                                            (AspisR1.Op5T_Concrete.current ops) reserved query geo B
                                                            std))
                                                        t25 r25)).1 ++
                                                (AspisR1PublicPreparation.PreparedHashCode.observe
                                                    (AspisR1PublicPreparation.PreparedHashCode.run
                                                        (AspisR1PublicPreparation.S1SemanticCode.circleValidated
                                                          (AspisR1PublicPreparation.S1SemanticRootCopy.install
                                                            (AspisR1.ClaimsUnrolledFinish.install std B))
                                                          (AspisR1CurrentCaller.InstalledPreparation.retainedDigest
                                                            (AspisR1.Tx1Q_SameCut.callerDigest adapter
                                                              (AspisR1.Op5T_Concrete.current ops) reserved query geo B
                                                              std))
                                                          t26 r26)).1 ++
                                                  AspisR1PublicPreparation.PreparedHashCode.observe
                                                    (AspisR1PublicPreparation.PreparedHashCode.run
                                                        (AspisR1PublicPreparation.PreparedHashEffects.new
                                                          AspisR1PublicPreparation.PreparedHashCode.effects
                                                          (AspisR1CurrentCaller.InstalledPreparation.retainedDigest
                                                            (AspisR1.Tx1Q_SameCut.callerDigest adapter
                                                              (AspisR1.Op5T_Concrete.current ops) reserved query geo B
                                                              std))
                                                          () t27.state
                                                          AspisR1PublicPreparation.transport.Variant.S2)).1) ++
                                              AspisR1.F3K_OpeningCalls.log c) ∧
                                        AspisR1.UnifiedSampler.stateOf AspisR1.SelectedTranscriptParams.params
                                              (AspisR1.LiteralTranscript.erasePrefix
                                                (AspisV8R19.MemoizedProgramLaw.eval H
                                                    (AspisR1.F3J_SamplerRun.program i.proof 0 33
                                                      (FS.emptyPrefix i.semantic.value))).2) =
                                            AspisV8R19.SqueezeOracleBridge.decodeState c.t6.state ∧
                                          (∃ j,
                                              AspisR1.D0InstanceAdmission.Fields
                                                (AspisR1.LiteralTranscript.erasePrefix
                                                  (AspisV8R19.MemoizedProgramLaw.eval H
                                                      (AspisR1.F3J_SamplerRun.program i.proof 0 33
                                                        (FS.emptyPrefix i.semantic.value))).2)
                                                j) ∧
                                            ∃ q,
                                              AspisR1.OraclePortSelectedDraft.queries
                                                    (AspisR1.LiteralTranscript.erasePrefix
                                                      (AspisV8R19.MemoizedProgramLaw.eval H
                                                          (AspisR1.F3J_SamplerRun.program i.proof 0 33
                                                            (FS.emptyPrefix i.semantic.value))).2) =
                                                  some q ∧
                                                (∀ (j : Fin 22), ↑(↑c.queries)[↑j] = ↑(q j)) ∧
                                                  AspisR1.OraclePortStoredParserC4.parseReached i.stored
                                                        (AspisR1.LiteralTranscript.erasePrefix
                                                          (AspisV8R19.MemoizedProgramLaw.eval H
                                                              (AspisR1.F3J_SamplerRun.program i.proof 0 33
                                                                (FS.emptyPrefix i.semantic.value))).2) =
                                                      some
                                                        { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof,
                                                          semantic :=
                                                            List.map
                                                              (fun s => AspisR1.MultiproofConeCanonical.bytesOf ↑s)
                                                              ↑pre.records } ∧
                                                    ∃ sourceInput,
                                                      AspisR1.OraclePortStoredDecisionDraftC4.input
                                                            { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof,
                                                              semantic :=
                                                                List.map
                                                                  (fun s => AspisR1.MultiproofConeCanonical.bytesOf ↑s)
                                                                  ↑pre.records }
                                                            q
                                                            (AspisR1.LiteralTranscript.erasePrefix
                                                              (AspisV8R19.MemoizedProgramLaw.eval H
                                                                  (AspisR1.F3J_SamplerRun.program i.proof 0 33
                                                                    (FS.emptyPrefix i.semantic.value))).2) =
                                                          some sourceInput ∧
                                                        AspisR1.Port5Q1_QueryPorts.SessionAPrepare
                                                            (AspisR1.Tx1Q_Carriers.prepared run.p) sourceInput.data q
                                                            (AspisR1.SelectedChallengeMap.rhoOf sourceInput.rho) ∧
                                                          ∃ sourcePrepared,
                                                            AspisR1CurrentCaller.InstalledPreparation.currentPrepared
                                                                  sourcePrepared =
                                                                run.p ∧
                                                              AspisR1.F3L_PreparedModelSix.Fields sourcePrepared
                                                                  sourceInput q ∧
                                                                ((AspisR1.F3L_SourcePrepared.numeric
                                                                        sourcePrepared).roots =
                                                                    fun j => ⋯) ∧
                                                                  ∃ modelView, ⋯ ∧ ⋯
AspisR1.F3M_PreparedRemaining.remaining (out : AspisR1PublicPreparation.verifier.Prepared)
  (p : AspisR1.OraclePortCompactDraft.Parsed) (i : AspisR1.RecordedBinaryExperimentBin.SourceInputs)
  (v : AspisR1.LiteralOpeningView.View) (q : Fin 22 → Fin 262144) (six : AspisR1.F3L_PreparedModelSix.Fields out i q)
  (roots : (AspisR1.F3L_SourcePrepared.numeric out).roots = fun j => AspisR1.OraclePortBatchDraft.committedRoot p ↑j)
  (alpha :
    (AspisR1.F3L_SourcePrepared.numeric out).semanticAlpha =
      (AspisR1.OraclePortAcceptedContextC6.context p i v).semanticAlpha) :
  have source := AspisR1.F3L_SourcePrepared.numeric out;
  have target :=
    AspisR1.OraclePortCheckpointResumeC5.prepared (AspisR1.OraclePortAcceptedContextC6.context p i v) i.data
      (AspisR1.SelectedChallengeMap.rhoOf i.rho) q;
  source = target ↔ source.coordinates = target.coordinates ∧ source.claim = target.claim
AspisR1.F3M_InactiveInput.c0 (proof semantic y1 : Aeneas.Std.Slice Aeneas.Std.U8)
  (view : AspisR1CurrentCaller.verifier.View)
  (accepted :
    AspisR1CurrentCaller.InstalledPreparation.sourceView proof semantic y1 =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok view))
  (p : AspisR1.OraclePortCompactDraft.Parsed) (wire : p.wire = AspisR1.MultiproofConeCanonical.bytesOf ↑proof)
  (q : Fin 22 → Fin 262144) (tr : AspisR1.RawCutTranscriptRun.ErasedPrefix)
  (aligned : AspisR1.OraclePortCompactDraft.Aligned p tr) (i : AspisR1.RecordedBinaryExperimentBin.SourceInputs)
  (found : AspisR1.OraclePortStoredDecisionDraftC4.input p q tr = some i) :
  i.data.c0 =
    AspisR1CurrentPreparedClaim.Concrete.decode
      (AspisR1ClaimPreparedBridge.toClaimE (AspisR1CurrentCaller.InstalledPreparation.retainedView view).inactive)
