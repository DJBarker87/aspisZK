uplicated":480}}}]]}]},"comments_before":[]},{"span":{"data":{"file_id":2,"beg":{"line":877,"col":8},"end":{"line":877,"col":9}},"generated_from_span":null},"id":820,"kind":{"StorageDead":6},"comments_before":[]},{"span":{"data":{"file_id":2,"beg":{"line":877,"col":8},"end":{"line":877,"col":9}},"generated_from_span":null},"id":821,"kind":{"StorageDead":5},"comments_before":[]},{"span":{"data":{"file_id":2,"beg":{"line":869,"col":27},"end":{"line":878,"col":5}},"generated_from_span":null},"id":822,"kind":{"Assign":[{"kind":{"Local":0},"ty":{"Deduplicated":412}},{"Aggregate":[{"Adt":[{"id":{"Adt":0},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}},null,null]},[{"Move":{"kind":{"Local":1},"ty":{"Deduplicated":444}}},{"Move":{"kind":{"Local":4},"ty":{"Deduplicated":444}}}]]}]},"comments_before":[]},{"span":{"data":{"file_id":2,"beg":{"line":878,"col":4},"end":{"line":878,"col":5}},"generated_from_span":null},"id":823,"kind":{"StorageDead":4},"comments_before":[]},{"span":{"data":{"file_id":2,"beg":{"line":878,"col":4},"end":{"line":878,"col":5}},"generated_from_span":null},"id":824,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":2,"beg":{"line":869,"col":4},"end":{"line":878,"col":6}},"generated_from_span":null},"id":825,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":4,"item_meta":{"name":[{"Ident":["pv_b3p6_reference227",0]},{"Ident":["reference_poseidon",0]},{"Ident":["external_local_packed_raw",0]}],"span":{"data":{"file_id":0,"beg":{"line":154,"col":0},"end":{"line":265,"col":1}},"generated_from_span":null},"source_text":"fn external_local_packed_raw(input: [QM31; 4]) -> [u64; 4] {\n    let input = [extension_limbs(input[0]),extension_limbs(input[1]),extension_limbs(input[2]),extension_limbs(input[3])];\n    let local: [[u64; 4]; 4] = array4!(output, {\n        array4!(limb, {\n            let a = u64::from(input[0][limb]);\n            let b = u64::from(input[1][limb]);\n            let c = u64::from(input[2][limb]);\n            let d = u64::from(input[3][limb]);\n            raw_limb227(output,a,b,c,d)\n        })\n    });\n    let mut all_local_limbs_bounded = true;\n    let mut output = 0usize;\n    \n        let mut limb = 0usize;\n        \n            all_local_limbs_bounded &= local[0usize][0usize] < EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n            \n        \n\n            all_local_limbs_bounded &= local[0usize][1usize] < EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n            \n        \n\n            all_local_limbs_bounded &= local[0usize][2usize] < EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n            \n        \n\n            all_local_limbs_bounded &= local[0usize][3usize] < EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n            \n        \n        \n    \n\n        let mut limb = 0usize;\n        \n            all_local_limbs_bounded &= local[1usize][0usize] < EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n            \n        \n\n            all_local_limbs_bounded &= local[1usize][1usize] < EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n            \n        \n\n            all_local_limbs_bounded &= local[1usize][2usize] < EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n            \n        \n\n            all_local_limbs_bounded &= local[1usize][3usize] < EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n            \n        \n        \n    \n\n        let mut limb = 0usize;\n        \n            all_local_limbs_bounded &= local[2usize][0usize] < EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n            \n        \n\n            all_local_limbs_bounded &= local[2usize][1usize] < EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n            \n        \n\n            all_local_limbs_bounded &= local[2usize][2usize] < EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n            \n        \n\n            all_local_limbs_bounded &= local[2usize][3usize] < EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n            \n        \n        \n    \n\n        let mut limb = 0usize;\n        \n            all_local_limbs_bounded &= local[3usize][0usize] < EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n            \n        \n\n            all_local_limbs_bounded &= local[3usize][1usize] < EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n            \n        \n\n            all_local_limbs_bounded &= local[3usize][2usize] < EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n            \n        \n\n            all_local_limbs_bounded &= local[3usize][3usize] < EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n            \n        \n        \n    \n    debug_assert!(all_local_limbs_bounded);\n\n    let bound = EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n    let packed = [\n        local[0][0] + 5 * bound - local[1][1] + 2 * local[2][2]\n            - local[2][3]\n            - local[3][2]\n            - 2 * local[3][3],\n        local[0][1] + local[1][0] + local[2][2] + 2 * local[2][3] + 2 * local[3][2] + bound\n            - local[3][3],\n        local[0][2] + 2 * bound - local[1][3] + local[2][0] - local[3][1],\n        local[0][3] + local[1][2] + local[2][1] + local[3][0],\n    ];\n    debug_assert!(packed[0] < 8 * bound);\n    debug_assert!(packed[1] < 8 * bound);\n    debug_assert!(packed[2] < 4 * bound);\n    debug_assert!(packed[3] < 4 * bound);\n    packed\n}","attr_info":{"attributes":[{"DocComment":" Apply the local external matrix and the tower-basis packing functional in"},{"DocComment":" one raw-limb pass."},{"DocComment":""},{"DocComment":" If `t[r,l] = sum_j B[r,j] * input[j,l]`, packing the four local outputs"},{"DocComment":" against `(1, i, u, i*u)` gives exactly"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" c0.a = t[0,a] - t[1,b] + 2t[2,c] - t[2,d] - t[3,c] - 2t[3,d]"},{"DocComment":" c0.b = t[0,b] + t[1,a] + t[2,c] + 2t[2,d] + 2t[3,c] - t[3,d]"},{"DocComment":" c1.a = t[0,c] - t[1,d] + t[2,a] - t[3,b]"},{"DocComment":" c1.b = t[0,d] + t[1,c] + t[2,b] + t[3,a]"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The signed offsets below are multiples of P and do not change the field"},{"DocComment":" value. The first two raw outputs are below `56P`; the last two are below"},{"DocComment":" `28P`. Thus one final reduction per output limb is sufficient."}],"inline":"Always","rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":415}],"output":{"Deduplicated":453}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":0,"beg":{"line":154,"col":0},"end":{"line":265,"col":1}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":0,"beg":{"line":154,"col":50},"end":{"line":154,"col":58}},"generated_from_span":null},"ty":{"Deduplicated":453}},{"index":1,"name":"input","span":{"data":{"file_id":0,"beg":{"line":154,"col":29},"end":{"line":154,"col":34}},"generated_from_span":null},"ty":{"Deduplicated":415}},{"index":2,"name":"input","span":{"data":{"file_id":0,"beg":{"line":155,"col":8},"end":{"line":155,"col":13}},"generated_from_span":null},"ty":{"HashConsedValue":[489,{"Array":[{"HashConsedValue":[488,{"Array":[{"Deduplicated":483},{"kind":{"Literal":{"Scalar":{"Unsigned":["Usize","4"]}}},"ty":{"Deduplicated":413}}]}]},{"kind":{"Literal":{"Scalar":{"Unsigned":["Usize","4"]}}},"ty":{"Deduplicated":413}}]}]}},{"index":3,"name":null,"span":{"data":{"file_id":0,"beg":{"line":155,"col":17},"end":{"line":155,"col":42}},"generated_from_span":null},"ty":{"Deduplicated":488}},{"index":4,"name":null,"span":{"data":{"file_id":0,"beg":{"line":155,"col":33},"end":{"line":155,"col":41}},"generated_from_span":null},"ty":{"Deduplicated":412}},{"index":5,"name":null,"span":{"data":{"file_id":0,"beg":{"line":155,"col":39},"end":{"line":155,"col":40}},"generated_from_span":null},"ty":{"Deduplicated":413}},{"index":6,"name":null,"span":{"data":{"fi