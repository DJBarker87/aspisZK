d by `Self`,"},{"DocComment":" this function is allowed to panic, wrap, or saturate."},{"DocComment":" The suggested behavior is to panic when debug assertions are enabled,"},{"DocComment":" and to wrap or saturate otherwise."},{"DocComment":""},{"DocComment":" Unsafe code should not rely on the correctness of behavior after overflow."},{"DocComment":""},{"DocComment":" # Invariants"},{"DocComment":""},{"DocComment":" For any `a`, `n`, and `m`, where no overflow occurs:"},{"DocComment":""},{"DocComment":" * `Step::forward(Step::forward(a, n), m) == Step::forward(a, n + m)`"},{"DocComment":""},{"DocComment":" For any `a` and `n`, where no overflow occurs:"},{"DocComment":""},{"DocComment":" * `Step::forward_checked(a, n) == Some(Step::forward(a, n))`"},{"DocComment":" * `Step::forward(a, n) == (0..n).fold(a, |x, _| Step::forward(x, 1))`"},{"DocComment":"   * Corollary: `Step::forward(a, 0) == a`"},{"DocComment":" * `Step::forward(a, n) >= a`"},{"DocComment":" * `Step::backward(Step::forward(a, n), n) == a`"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":17907}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":17907},{"Deduplicated":1112}],"output":{"Deduplicated":17907}},"src":{"TraitDecl":{"trait_ref":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":17907}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":2}}},"is_global_initializer":null,"body":"Opaque"},null,null,null,{"def_id":179,"item_meta":{"name":[{"Ident":["cor