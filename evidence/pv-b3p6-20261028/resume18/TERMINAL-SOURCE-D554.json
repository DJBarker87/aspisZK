        "signature": "fn add_path_lanes(\n    packed: &mut [QM31; POOL_V1_PAIR_FOREST_PACKED_SEMANTIC_LANES_V1],\n    openings: &StateOnlyPoseidonOpenings,\n    selectors: &Selectors,\n) ",
