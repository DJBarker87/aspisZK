def Aeneas.Std.UScalar.add : {ty : Aeneas.Std.UScalarTy} →
  Aeneas.Std.UScalar ty → Aeneas.Std.UScalar ty → Aeneas.Std.Result (Aeneas.Std.UScalar ty) :=
fun {ty} x y => Aeneas.Std.UScalar.tryMk ty (↑x + ↑y)
def Aeneas.Std.UScalar.sub : {ty : Aeneas.Std.UScalarTy} →
  Aeneas.Std.UScalar ty → Aeneas.Std.UScalar ty → Aeneas.Std.Result (Aeneas.Std.UScalar ty) :=
fun {ty} x y =>
  if ↑x < ↑y then Aeneas.Std.Result.fail Aeneas.Std.Error.integerOverflow
  else Aeneas.Std.Result.ok (BitVec.ofNat ty.numBits (↑x - ↑y)#uscalar)
def Aeneas.Std.UScalar.mul : {ty : Aeneas.Std.UScalarTy} →
  Aeneas.Std.UScalar ty → Aeneas.Std.UScalar ty → Aeneas.Std.Result (Aeneas.Std.UScalar ty) :=
fun {ty} x y => Aeneas.Std.UScalar.tryMk ty (↑x * ↑y)
def Aeneas.Std.UScalar.tryMk : (ty : Aeneas.Std.UScalarTy) → ℕ → Aeneas.Std.Result (Aeneas.Std.UScalar ty) :=
fun ty x => Aeneas.Std.Result.ofOption (Aeneas.Std.UScalar.tryMkOpt ty x) Aeneas.Std.Error.integerOverflow
