theorem AspisR1.LiteralSemanticIndex.read_index : ∀
  (eK : AspisV8R15.ExactTowerBase.QM31Exact →+* AspisR1.LiteralSemanticPrefix.E) (offset : ℕ)
  (xs : List (AspisR1.LiteralSemanticPrefix.Message × AspisR1.LiteralSemanticPrefix.Challenge))
  (out : List (R0P.Mask.SemMsgZ AspisR1.LiteralSemanticPrefix.E × AspisR1.LiteralSemanticPrefix.E))
  (hread : AspisR1.LiteralSemanticPrefix.read eK offset xs = some out) (i : ℕ) (hi : i < xs.length),
  ∃ (hrow : offset + i < 25),
    ∃ parsed c,
      AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + i, hrow⟩ xs[i].1 = some parsed ∧
        xs[i].2.1 = AspisR1.TranscriptView.Value.ordinary c ∧ out[i] = (parsed, c) :=
fun eK offset xs out hread =>
  List.rec (motive := fun xs =>
    ∀ (offset : ℕ) (out : List (R0P.Mask.SemMsgZ AspisR1.LiteralSemanticPrefix.E × AspisR1.LiteralSemanticPrefix.E))
      (hread : AspisR1.LiteralSemanticPrefix.read eK offset xs = some out) (i : ℕ) (hi : i < xs.length),
      ∃ (hrow : offset + i < 25),
        ∃ parsed c,
          AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + i, hrow⟩ xs[i].1 = some parsed ∧
            xs[i].2.1 = AspisR1.TranscriptView.Value.ordinary c ∧ out[i] = (parsed, c))
    (fun offset out hread i hi => False.elim (Eq.mp not_lt_zero._simp_1 hi))
    (fun item rest ih offset out hread i hi =>
      let ⟨message, challenge, hread, hi⟩ := item
      Nat.casesAuxOn (motive := fun a =>
        i = a →
          ∃ (hrow : offset + i < 25),
            ∃ parsed c,
              AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + i, hrow⟩ ((message, challenge) :: rest)[i].1 =
                  some parsed ∧
                ((message, challenge) :: rest)[i].2.1 = AspisR1.TranscriptView.Value.ordinary c ∧ out[i] = (parsed, c))
        i
        (fun h =>
          Eq.ndrec (motive := fun i =>
            ∀ (hi : i < ((message, challenge) :: rest).length),
              ∃ (hrow : offset + i < 25),
                ∃ parsed c,
                  AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + i, hrow⟩ ((message, challenge) :: rest)[i].1 =
                      some parsed ∧
                    ((message, challenge) :: rest)[i].2.1 = AspisR1.TranscriptView.Value.ordinary c ∧
                      out[i] = (parsed, c))
            (fun hi =>
              if hoff : offset < 25 then
                AspisR1.TranscriptView.Value.casesOn (motive := fun t =>
                  challenge.1 = t →
                    ∃ (hrow : offset + 0 < 25),
                      ∃ parsed c,
                        AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + 0, hrow⟩
                              ((message, challenge) :: rest)[0].1 =
                            some parsed ∧
                          ((message, challenge) :: rest)[0].2.1 = AspisR1.TranscriptView.Value.ordinary c ∧
                            out[0] = (parsed, c))
                  challenge.1
                  (fun c h =>
                    Eq.ndrec (motive := fun x =>
                      challenge.1 = x →
                        ∃ (hrow : offset + 0 < 25),
                          ∃ parsed c,
                            AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + 0, hrow⟩
                                  ((message, challenge) :: rest)[0].1 =
                                some parsed ∧
                              ((message, challenge) :: rest)[0].2.1 = AspisR1.TranscriptView.Value.ordinary c ∧
                                out[0] = (parsed, c))
                      (fun hvalue =>
                        Option.casesOn (motive := fun t =>
                          AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset, hoff⟩ message = t →
                            ∃ (hrow : offset + 0 < 25),
                              ∃ parsed c,
                                AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + 0, hrow⟩
                                      ((message, challenge) :: rest)[0].1 =
                                    some parsed ∧
                                  ((message, challenge) :: rest)[0].2.1 = AspisR1.TranscriptView.Value.ordinary c ∧
                                    out[0] = (parsed, c))
                          (AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset, hoff⟩ message)
                          (fun h =>
                            Eq.ndrec (motive := fun x =>
                              AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset, hoff⟩ message = x →
                                ∃ (hrow : offset + 0 < 25),
                                  ∃ parsed c,
                                    AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + 0, hrow⟩
                                          ((message, challenge) :: rest)[0].1 =
                                        some parsed ∧
                                      ((message, challenge) :: rest)[0].2.1 = AspisR1.TranscriptView.Value.ordinary c ∧
                                        out[0] = (parsed, c))
                              (fun hmessage =>
                                False.elim
                                  (Eq.mp
                                    (Eq.trans
                                      (congrFun'
                                        (congrArg Eq
                                          (Eq.trans (dite_cond_eq_true (eq_true hoff))
                                            (Eq.trans
                                              (congrArg
                                                (fun x =>
                                                  match x with
                                                  | AspisR1.TranscriptView.Value.ordinary c =>
                                                    (AspisR1.LiteralSemanticPrefix.parseMessage eK
                                                          ⟨offset, of_eq_true (eq_true hoff)⟩ message).bind
                                                      fun parsed =>
                                                      Option.map (fun out => (parsed, c) :: out)
                                                        (AspisR1.LiteralSemanticPrefix.read eK (offset + 1) rest)
                                                  | AspisR1.TranscriptView.Value.queries result => none)
                                                hvalue)
                                              (Option.bind_congr' hmessage fun a a_1 =>
                                                Eq.refl
                                                  (Option.map (fun out => (a, c) :: out)
                                                    (AspisR1.LiteralSemanticPrefix.read eK (offset + 1) rest))))))
                                        (some out))
                                      (eq_false' fun h => False.elim (noConfusion_of_Nat Option.ctorIdx h)))
                                    hread))
                              (Eq.symm h)
                              (Eq.refl (AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset, hoff⟩ message)))
                          (fun parsed h =>
                            Eq.ndrec (motive := fun x =>
                              AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset, hoff⟩ message = x →
                                ∃ (hrow : offset + 0 < 25),
                                  ∃ parsed c,
                                    AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + 0, hrow⟩
                                          ((message, challenge) :: rest)[0].1 =
                                        some parsed ∧
                                      ((message, challenge) :: rest)[0].2.1 = AspisR1.TranscriptView.Value.ordinary c ∧
                                        out[0] = (parsed, c))
                              (fun hmessage =>
                                Option.casesOn (motive := fun t =>
                                  AspisR1.LiteralSemanticPrefix.read eK (offset + 1) rest = t →
                                    ∃ (hrow : offset + 0 < 25),
                                      ∃ parsed c,
                                        AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + 0, hrow⟩
                                              ((message, challenge) :: rest)[0].1 =
                                            some parsed ∧
                                          ((message, challenge) :: rest)[0].2.1 =
                                              AspisR1.TranscriptView.Value.ordinary c ∧
                                            out[0] = (parsed, c))
                                  (AspisR1.LiteralSemanticPrefix.read eK (offset + 1) rest)
                                  (fun h =>
                                    Eq.ndrec (motive := fun x =>
                                      AspisR1.LiteralSemanticPrefix.read eK (offset + 1) rest = x →
                                        ∃ (hrow : offset + 0 < 25),
                                          ∃ parsed c,
                                            AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + 0, hrow⟩
                                                  ((message, challenge) :: rest)[0].1 =
                                                some parsed ∧
                                              ((message, challenge) :: rest)[0].2.1 =
                                                  AspisR1.TranscriptView.Value.ordinary c ∧
                                                out[0] = (parsed, c))
                                      (fun htail =>
                                        False.elim
                                          (Eq.mp
                                            (Eq.trans
                                              (congrFun'
                                                (congrArg Eq
                                                  (Eq.trans (dite_cond_eq_true (eq_true hoff))
                                                    (Eq.trans
                                                      (congrArg
                                                        (fun x =>
                                                          match x with
                                                          | AspisR1.TranscriptView.Value.ordinary c =>
                                                            (AspisR1.LiteralSemanticPrefix.parseMessage eK
                                                                  ⟨offset, of_eq_true (eq_true hoff)⟩ message).bind
                                                              fun parsed =>
                                                              Option.map (fun out => (parsed, c) :: out)
                                                                (AspisR1.LiteralSemanticPrefix.read eK (offset + 1)
                                                                  rest)
                                                          | AspisR1.TranscriptView.Value.queries result => none)
                                                        hvalue)
                                                      (Eq.trans
                                                        (Option.bind_congr' hmessage fun a a_1 =>
                                                          congrArg (Option.map fun out => (a, c) :: out) htail)
                                                        (Option.bind_fun_none (some parsed))))))
                                                (some out))
                                              (eq_false' fun h => False.elim (noConfusion_of_Nat Option.ctorIdx h)))
                                            hread))
                                      (Eq.symm h) (Eq.refl (AspisR1.LiteralSemanticPrefix.read eK (offset + 1) rest)))
                                  (fun tail h =>
                                    Eq.ndrec (motive := fun x =>
                                      AspisR1.LiteralSemanticPrefix.read eK (offset + 1) rest = x →
                                        ∃ (hrow : offset + 0 < 25),
                                          ∃ parsed c,
                                            AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + 0, hrow⟩
                                                  ((message, challenge) :: rest)[0].1 =
                                                some parsed ∧
                                              ((message, challenge) :: rest)[0].2.1 =
                                                  AspisR1.TranscriptView.Value.ordinary c ∧
                                                out[0] = (parsed, c))
                                      (fun htail =>
                                        have hout :=
                                          Eq.mp
                                            (Eq.trans
                                              (congrFun'
                                                (congrArg Eq
                                                  (Eq.trans (dite_cond_eq_true (eq_true hoff))
                                                    (Eq.trans
                                                      (congrArg
                                                        (fun x =>
                                                          match x with
                                                          | AspisR1.TranscriptView.Value.ordinary c =>
                                                            (AspisR1.LiteralSemanticPrefix.parseMessage eK
                                                                  ⟨offset, of_eq_true (eq_true hoff)⟩ message).bind
                                                              fun parsed =>
                                                              Option.map (fun out => (parsed, c) :: out)
                                                                (AspisR1.LiteralSemanticPrefix.read eK (offset + 1)
                                                                  rest)
                                                          | AspisR1.TranscriptView.Value.queries result => none)
                                                        hvalue)
                                                      (Option.bind_congr' hmessage fun a a_1 =>
                                                        congrArg (Option.map fun out => (a, c) :: out) htail))))
                                                (some out))
                                              (Option.some.injEq ((parsed, c) :: tail) out))
                                            hread;
                                        Eq.ndrec (motive := fun out =>
                                          ∀
                                            (hread :
                                              AspisR1.LiteralSemanticPrefix.read eK offset
                                                  ((message, challenge) :: rest) =
                                                some out),
                                            ∃ (hrow : offset + 0 < 25),
                                              ∃ parsed c,
                                                AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + 0, hrow⟩
                                                      ((message, challenge) :: rest)[0].1 =
                                                    some parsed ∧
                                                  ((message, challenge) :: rest)[0].2.1 =
                                                      AspisR1.TranscriptView.Value.ordinary c ∧
                                                    out[0] = (parsed, c))
                                          (fun hread =>
                                            Exists.intro hoff
                                              (Exists.intro parsed
                                                (Exists.intro c
                                                  ⟨Eq.mpr
                                                      (id
                                                        (congrFun'
                                                          (congrArg Eq
                                                            (congrFun'
                                                              (congrArg (AspisR1.LiteralSemanticPrefix.parseMessage eK)
                                                                (Fin.mk.congr_simp (offset + 0) offset (add_zero offset)
                                                                  hoff))
                                                              message))
                                                          (some parsed)))
                                                      hmessage,
                                                    ⟨id hvalue, of_eq_true (eq_self (parsed, c))⟩⟩)))
                                          hout hread)
                                      (Eq.symm h) (Eq.refl (AspisR1.LiteralSemanticPrefix.read eK (offset + 1) rest)))
                                  (Eq.refl (AspisR1.LiteralSemanticPrefix.read eK (offset + 1) rest)))
                              (Eq.symm h)
                              (Eq.refl (AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset, hoff⟩ message)))
                          (Eq.refl (AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset, hoff⟩ message)))
                      (Eq.symm h) (Eq.refl challenge.1))
                  (fun result h =>
                    Eq.ndrec (motive := fun x =>
                      challenge.1 = x →
                        ∃ (hrow : offset + 0 < 25),
                          ∃ parsed c,
                            AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + 0, hrow⟩
                                  ((message, challenge) :: rest)[0].1 =
                                some parsed ∧
                              ((message, challenge) :: rest)[0].2.1 = AspisR1.TranscriptView.Value.ordinary c ∧
                                out[0] = (parsed, c))
                      (fun hvalue =>
                        False.elim
                          (Eq.mp
                            (Eq.trans
                              (congrFun'
                                (congrArg Eq
                                  (Eq.trans (dite_cond_eq_true (eq_true hoff))
                                    (congrArg
                                      (fun x =>
                                        match x with
                                        | AspisR1.TranscriptView.Value.ordinary c =>
                                          (AspisR1.LiteralSemanticPrefix.parseMessage eK
                                                ⟨offset, of_eq_true (eq_true hoff)⟩ message).bind
                                            fun parsed =>
                                            Option.map (fun out => (parsed, c) :: out)
                                              (AspisR1.LiteralSemanticPrefix.read eK (offset + 1) rest)
                                        | AspisR1.TranscriptView.Value.queries result => none)
                                      hvalue)))
                                (some out))
                              (eq_false' fun h => False.elim (noConfusion_of_Nat Option.ctorIdx h)))
                            hread))
                      (Eq.symm h) (Eq.refl challenge.1))
                  (Eq.refl challenge.1)
              else
                False.elim
                  (Eq.mp
                    (Eq.trans (congrFun' (congrArg Eq (dite_cond_eq_false (eq_false hoff))) (some out))
                      (eq_false' fun h => False.elim (noConfusion_of_Nat Option.ctorIdx h)))
                    hread))
            (Eq.symm h) hi)
        (fun i_1 h =>
          Eq.ndrec (motive := fun i =>
            ∀ (hi : i < ((message, challenge) :: rest).length),
              ∃ (hrow : offset + i < 25),
                ∃ parsed c,
                  AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + i, hrow⟩ ((message, challenge) :: rest)[i].1 =
                      some parsed ∧
                    ((message, challenge) :: rest)[i].2.1 = AspisR1.TranscriptView.Value.ordinary c ∧
                      out[i] = (parsed, c))
            (fun hi =>
              if hoff : offset < 25 then
                AspisR1.TranscriptView.Value.casesOn (motive := fun t =>
                  challenge.1 = t →
                    ∃ (hrow : offset + (i_1 + 1) < 25),
                      ∃ parsed c,
                        AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + (i_1 + 1), hrow⟩
                              ((message, challenge) :: rest)[i_1 + 1].1 =
                            some parsed ∧
                          ((message, challenge) :: rest)[i_1 + 1].2.1 = AspisR1.TranscriptView.Value.ordinary c ∧
                            out[i_1 + 1] = (parsed, c))
                  challenge.1
                  (fun c h =>
                    Eq.ndrec (motive := fun x =>
                      challenge.1 = x →
                        ∃ (hrow : offset + (i_1 + 1) < 25),
                          ∃ parsed c,
                            AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + (i_1 + 1), hrow⟩
                                  ((message, challenge) :: rest)[i_1 + 1].1 =
                                some parsed ∧
                              ((message, challenge) :: rest)[i_1 + 1].2.1 = AspisR1.TranscriptView.Value.ordinary c ∧
                                out[i_1 + 1] = (parsed, c))
                      (fun hvalue =>
                        Option.casesOn (motive := fun t =>
                          AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset, hoff⟩ message = t →
                            ∃ (hrow : offset + (i_1 + 1) < 25),
                              ∃ parsed c,
                                AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + (i_1 + 1), hrow⟩
                                      ((message, challenge) :: rest)[i_1 + 1].1 =
                                    some parsed ∧
                                  ((message, challenge) :: rest)[i_1 + 1].2.1 =
                                      AspisR1.TranscriptView.Value.ordinary c ∧
                                    out[i_1 + 1] = (parsed, c))
                          (AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset, hoff⟩ message)
                          (fun h =>
                            Eq.ndrec (motive := fun x =>
                              AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset, hoff⟩ message = x →
                                ∃ (hrow : offset + (i_1 + 1) < 25),
                                  ∃ parsed c,
                                    AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + (i_1 + 1), hrow⟩
                                          ((message, challenge) :: rest)[i_1 + 1].1 =
                                        some parsed ∧
                                      ((message, challenge) :: rest)[i_1 + 1].2.1 =
                                          AspisR1.TranscriptView.Value.ordinary c ∧
                                        out[i_1 + 1] = (parsed, c))
                              (fun hmessage =>
                                False.elim
                                  (Eq.mp
                                    (Eq.trans
                                      (congrFun'
                                        (congrArg Eq
                                          (Eq.trans (dite_cond_eq_true (eq_true hoff))
                                            (Eq.trans
                                              (congrArg
                                                (fun x =>
                                                  match x with
                                                  | AspisR1.TranscriptView.Value.ordinary c =>
                                                    (AspisR1.LiteralSemanticPrefix.parseMessage eK
                                                          ⟨offset, of_eq_true (eq_true hoff)⟩ message).bind
                                                      fun parsed =>
                                                      Option.map (fun out => (parsed, c) :: out)
                                                        (AspisR1.LiteralSemanticPrefix.read eK (offset + 1) rest)
                                                  | AspisR1.TranscriptView.Value.queries result => none)
                                                hvalue)
                                              (Option.bind_congr' hmessage fun a a_1 =>
                                                Eq.refl
                                                  (Option.map (fun out => (a, c) :: out)
                                                    (AspisR1.LiteralSemanticPrefix.read eK (offset + 1) rest))))))
                                        (some out))
                                      (eq_false' fun h => False.elim (noConfusion_of_Nat Option.ctorIdx h)))
                                    hread))
                              (Eq.symm h)
                              (Eq.refl (AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset, hoff⟩ message)))
                          (fun parsed h =>
                            Eq.ndrec (motive := fun x =>
                              AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset, hoff⟩ message = x →
                                ∃ (hrow : offset + (i_1 + 1) < 25),
                                  ∃ parsed c,
                                    AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + (i_1 + 1), hrow⟩
                                          ((message, challenge) :: rest)[i_1 + 1].1 =
                                        some parsed ∧
                                      ((message, challenge) :: rest)[i_1 + 1].2.1 =
                                          AspisR1.TranscriptView.Value.ordinary c ∧
                                        out[i_1 + 1] = (parsed, c))
                              (fun hmessage =>
                                Option.casesOn (motive := fun t =>
                                  AspisR1.LiteralSemanticPrefix.read eK (offset + 1) rest = t →
                                    ∃ (hrow : offset + (i_1 + 1) < 25),
                                      ∃ parsed c,
                                        AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + (i_1 + 1), hrow⟩
                                              ((message, challenge) :: rest)[i_1 + 1].1 =
                                            some parsed ∧
                                          ((message, challenge) :: rest)[i_1 + 1].2.1 =
                                              AspisR1.TranscriptView.Value.ordinary c ∧
                                            out[i_1 + 1] = (parsed, c))
                                  (AspisR1.LiteralSemanticPrefix.read eK (offset + 1) rest)
                                  (fun h =>
                                    Eq.ndrec (motive := fun x =>
                                      AspisR1.LiteralSemanticPrefix.read eK (offset + 1) rest = x →
                                        ∃ (hrow : offset + (i_1 + 1) < 25),
                                          ∃ parsed c,
                                            AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + (i_1 + 1), hrow⟩
                                                  ((message, challenge) :: rest)[i_1 + 1].1 =
                                                some parsed ∧
                                              ((message, challenge) :: rest)[i_1 + 1].2.1 =
                                                  AspisR1.TranscriptView.Value.ordinary c ∧
                                                out[i_1 + 1] = (parsed, c))
                                      (fun htail =>
                                        False.elim
                                          (Eq.mp
                                            (Eq.trans
                                              (congrFun'
                                                (congrArg Eq
                                                  (Eq.trans (dite_cond_eq_true (eq_true hoff))
                                                    (Eq.trans
                                                      (congrArg
                                                        (fun x =>
                                                          match x with
                                                          | AspisR1.TranscriptView.Value.ordinary c =>
                                                            (AspisR1.LiteralSemanticPrefix.parseMessage eK
                                                                  ⟨offset, of_eq_true (eq_true hoff)⟩ message).bind
                                                              fun parsed =>
                                                              Option.map (fun out => (parsed, c) :: out)
                                                                (AspisR1.LiteralSemanticPrefix.read eK (offset + 1)
                                                                  rest)
                                                          | AspisR1.TranscriptView.Value.queries result => none)
                                                        hvalue)
                                                      (Eq.trans
                                                        (Option.bind_congr' hmessage fun a a_1 =>
                                                          congrArg (Option.map fun out => (a, c) :: out) htail)
                                                        (Option.bind_fun_none (some parsed))))))
                                                (some out))
                                              (eq_false' fun h => False.elim (noConfusion_of_Nat Option.ctorIdx h)))
                                            hread))
                                      (Eq.symm h) (Eq.refl (AspisR1.LiteralSemanticPrefix.read eK (offset + 1) rest)))
                                  (fun tail h =>
                                    Eq.ndrec (motive := fun x =>
                                      AspisR1.LiteralSemanticPrefix.read eK (offset + 1) rest = x →
                                        ∃ (hrow : offset + (i_1 + 1) < 25),
                                          ∃ parsed c,
                                            AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + (i_1 + 1), hrow⟩
                                                  ((message, challenge) :: rest)[i_1 + 1].1 =
                                                some parsed ∧
                                              ((message, challenge) :: rest)[i_1 + 1].2.1 =
                                                  AspisR1.TranscriptView.Value.ordinary c ∧
                                                out[i_1 + 1] = (parsed, c))
                                      (fun htail =>
                                        have hout :=
                                          Eq.mp
                                            (Eq.trans
                                              (congrFun'
                                                (congrArg Eq
                                                  (Eq.trans (dite_cond_eq_true (eq_true hoff))
                                                    (Eq.trans
                                                      (congrArg
                                                        (fun x =>
                                                          match x with
                                                          | AspisR1.TranscriptView.Value.ordinary c =>
                                                            (AspisR1.LiteralSemanticPrefix.parseMessage eK
                                                                  ⟨offset, of_eq_true (eq_true hoff)⟩ message).bind
                                                              fun parsed =>
                                                              Option.map (fun out => (parsed, c) :: out)
                                                                (AspisR1.LiteralSemanticPrefix.read eK (offset + 1)
                                                                  rest)
                                                          | AspisR1.TranscriptView.Value.queries result => none)
                                                        hvalue)
                                                      (Option.bind_congr' hmessage fun a a_1 =>
                                                        congrArg (Option.map fun out => (a, c) :: out) htail))))
                                                (some out))
                                              (Option.some.injEq ((parsed, c) :: tail) out))
                                            hread;
                                        Eq.ndrec (motive := fun out =>
                                          ∀
                                            (hread :
                                              AspisR1.LiteralSemanticPrefix.read eK offset
                                                  ((message, challenge) :: rest) =
                                                some out),
                                            ∃ (hrow : offset + (i_1 + 1) < 25),
                                              ∃ parsed c,
                                                AspisR1.LiteralSemanticPrefix.parseMessage eK ⟨offset + (i_1 + 1), hrow⟩
                                                      ((message, challenge) :: rest)[i_1 + 1].1 =
                                                    some parsed ∧
                                                  ((message, challenge) :: rest)[i_1 + 1].2.1 =
                                                      AspisR1.TranscriptView.Value.ordinary c ∧
                                                    out[i_1 + 1] = (parsed, c))
                                          (fun hread =>
                                            have hrest :=
                                              ih (offset + 1) tail htail i_1
                                                (Eq.mp AspisR1.LiteralSemanticIndex.read_index._simp_1 hi);
                                            let ⟨hrow', h✝⟩ := hrest
                                            let ⟨parsed', h✝¹⟩ := h✝
                                            let ⟨c', h✝²⟩ := h✝¹
                                            let ⟨hparse', right✝⟩ := h✝²
                                            let ⟨hchallenge', hindex'⟩ := right✝
                                            have hrow :=
                                              Decidable.byContradiction fun a =>
