def RSL.TAS.lib : (V0 : RSL.TX2_241.V2Lib) →
  (RSL.Bytes → RSL.Bytes → Prop) →
    (RSL.Bytes → RSL.Bytes → RSL.Bytes → RSL.Spec (Except V0.VErr Unit)) → RSL.TX2_241.V2Lib :=
fun V0 R0 w => { VErr := V0.VErr, debug := V0.debug, Root0 := R0, tx2auth := w }
