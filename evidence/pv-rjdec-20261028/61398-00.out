theorem R1Z.PV_RJDec_ZeroizeFinding.byte_fence_mismatch : ∀ {F : Type} (a : ℕ) (w : R1Z.PV_FXM_ZeroWorld.World F),
  (R1Z.PV_FXM_ZeroWorld.native a 1 w).fences ≠ w.fences + R1Z.PV_RJDec_ZeroizeFinding.inspectedByteCompilerFences :=
fun {F} a w =>
  Eq.mpr
    (id
      (congrArg (fun _a => _a ≠ w.fences + R1Z.PV_RJDec_ZeroizeFinding.inspectedByteCompilerFences)
        (R1Z.PV_FXM_ZeroWorld.counts a 1 w).right))
    (id fun a => R1Z.PV_RJDec_ZeroizeFinding.byte_fence_mismatch._proof_2 w a)
theorem R1Z.PV_RJDec_ZeroizeFinding.array32_fence_mismatch : ∀ {F : Type} (a : ℕ) (w : R1Z.PV_FXM_ZeroWorld.World F),
  (R1Z.PV_FXM_ZeroWorld.native a 32 w).fences ≠ w.fences + R1Z.PV_RJDec_ZeroizeFinding.inspectedArray32CompilerFences :=
fun {F} a w =>
  Eq.mpr
    (id
      (congrArg (fun _a => _a ≠ w.fences + R1Z.PV_RJDec_ZeroizeFinding.inspectedArray32CompilerFences)
        (R1Z.PV_FXM_ZeroWorld.counts a 32 w).right))
    (id fun a => R1Z.PV_RJDec_ZeroizeFinding.array32_fence_mismatch._proof_2 w a)
