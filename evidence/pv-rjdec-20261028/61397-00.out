  {CH Aux Coins NA LA CA NB LB CB : Type} (a : R1Z.PV_RunJoin_Deployed.Runtime CH Aux Coins NA LA CA)
  (b : R1Z.PV_RunJoin_Deployed.Runtime CH Aux Coins NB LB CB)
