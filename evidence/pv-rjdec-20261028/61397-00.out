def R1Z.PV_RJDec_Factor.Fibres : {W C A V : Type} →
  (R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A → Prop) → (R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A → V) → Prop :=
fun {W C A V} reachable observe =>
  ∀ (l r : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A),
    reachable l →
      reachable r →
        R1Z.PV_RunJoin_WorldDecode33.returned l = R1Z.PV_RunJoin_WorldDecode33.returned r → observe l = observe r
theorem R1Z.PV_RJDec_Factor.exists_iff : ∀ {W C A V : Type} [Nonempty V]
  (reachable : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A → Prop)
  (observe : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A → V),
  (∃ decode,
      ∀ (r : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A),
        reachable r → decode (R1Z.PV_RunJoin_WorldDecode33.returned r) = observe r) ↔
    R1Z.PV_RJDec_Factor.Fibres reachable observe :=
fun {W C A V} [Nonempty V] reachable observe =>
  {
    mp := fun a =>
      let ⟨decode, law, l, r, hl, hr, same⟩ := a
      Eq.mpr (id (congrArg (fun _a => _a = observe r) (Eq.symm (law l hl))))
        (Eq.mpr (id (congrArg (fun _a => decode (R1Z.PV_RunJoin_WorldDecode33.returned l) = _a) (Eq.symm (law r hr))))
          (Eq.mpr (id (congrArg (fun _a => decode _a = decode (R1Z.PV_RunJoin_WorldDecode33.returned r)) same))
            (Eq.refl (decode (R1Z.PV_RunJoin_WorldDecode33.returned r))))),
    mpr := fun fibres =>
      let decode := fun out =>
        if h : ∃ r, reachable r ∧ R1Z.PV_RunJoin_WorldDecode33.returned r = out then observe (Classical.choose h)
        else Classical.choice inferInstance;
      Exists.intro decode fun r hr =>
        have h := Exists.intro r ⟨hr, rfl⟩;
        id
          (Eq.mpr (id (congrArg (fun _a => _a = observe r) (dif_pos h)))
            (fibres (Classical.choose h) r (Classical.choose_spec h).left hr (Classical.choose_spec h).right)) }
theorem R1Z.PV_RJDec_Factor.pair_iff : ∀ {W C A V U : Type}
  (reachable : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A → Prop)
  (disclosed : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A → V)
  (oracle : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A → U),
  (R1Z.PV_RJDec_Factor.Fibres reachable fun r => (disclosed r, oracle r)) ↔
    R1Z.PV_RJDec_Factor.Fibres reachable disclosed ∧ R1Z.PV_RJDec_Factor.Fibres reachable oracle :=
fun {W C A V U} reachable disclosed oracle =>
  {
    mp := fun h =>
      ⟨fun l r hl hr same => congrArg Prod.fst (h l r hl hr same), fun l r hl hr same =>
        congrArg Prod.snd (h l r hl hr same)⟩,
    mpr := fun a =>
      let ⟨hd, ho, l, r, hl, hr, same⟩ := a
      Prod.ext (hd l r hl hr same) (ho l r hl hr same) }
theorem R1Z.PV_RJDec_ResultCases.returned_eq : ∀ {W C A : Type} (l r : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A),
  R1Z.PV_RunJoin_WorldDecode33.returned l = R1Z.PV_RunJoin_WorldDecode33.returned r ↔
    (∃ a,
        l.outcome = R1Z.PV_W_Threading.Outcome.ok a ∧ r.outcome = R1Z.PV_W_Threading.Outcome.ok a ∧ l.world = r.world) ∨
