        (kind : ProverCommitEnvironment35.Kind),
        boundary.fault secret s kind =
          boundary.schedule (List.length (boundary.ledger s).history) kind (boundary.ledger s).history) ∧
      (∀ (t u : Fin 128 → ProverCommitPublicNonce40.Raw) (rest : Rest),
          boundary.ledger (PV_RunJoin_Deployed.initialState runtime (boundary.coordinates.symm (t, rest))) =
            boundary.ledger (PV_RunJoin_Deployed.initialState runtime (boundary.coordinates.symm (u, rest)))) ∧
        ∀ (i : Fin 128) (t u : Fin 128 → ProverCommitPublicNonce40.Raw) (rest : Rest),
          (∀ (j : Fin 128), ↑j < ↑i → t j = u j) → boundary.frame i (t, rest) = boundary.frame i (u, rest)
  R1Z.PV_RunJoin_TrustEndpoint.ProofObligations.trace : ∀ (adv : R1Adv K CommitHandle Aux) (w : h.Instance),
      h.public w = x.1 →
        ∀ (r : World),
          (¬∃ i,
                ProverCommitFuelJoin22.bad
                  (QueryScanRealLazyBound.realBad (wire base (base.pubBytes x).length h B outputs x).toWire
                    (prover base (base.pubBytes x).length h B outputs x
                        (PrivacyR1AcctModel.seed (wire base (base.pubBytes x).length h B outputs x).toWire decode fib
                          opens)).toProver
                    8 h B outputs x w)
                  (queries adv w) i r.coins) →
            extracted r.coins adv w =
              (ProverCommitReencode16.experiment (wire base (base.pubBytes x).length h B outputs x).toWire
                    (prover base (base.pubBytes x).length h B outputs x
                        (PrivacyR1AcctModel.seed (wire base (base.pubBytes x).length h B outputs x).toWire decode fib
                          opens)).toProver
                    8 eight_pos (P_R1 h.transport B hB) (fun h' => VR1 h') ProverCommitReencode16.encode).real
                h B outputs (RomObserverBin.observerMap rust observer_program adv) x w r.coins.1.1
