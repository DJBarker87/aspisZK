        ∀ (secret : ProverRwRetryModel.Secret) (s next : State)
          (status : Aeneas.Std.core.result.Result ProverRwRetryModel.Proof ProverRwFull.verifier.Error),
          runtime.body h x w secret s = Aeneas.Std.Result.ok (status, next) →
            boundary.ledger next =
              match boundary.reservation secret s with
