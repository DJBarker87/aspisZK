@R1Z.PV_RunJoin_CommonSample32.complete_view : ∀ [ProverRwFull.ExternalTypes] {CH Aux Coins NA LA CA NB LB CB : Type}
  (a : R1Z.PV_RunJoin_Deployed.Runtime CH Aux Coins NA LA CA)
  (b : R1Z.PV_RunJoin_Deployed.Runtime CH Aux Coins NB LB CB)
  (project : R1Z.PV_RunJoin_UnifiedRetry.State NA LA CA → R1Z.PV_RunJoin_UnifiedRetry.State NB LB CB)
  (h : R0Z.ZkStatement.HonestProver R1Z.PrivacyR1AcctBasis.K) (x : R0Z.JointView.Statement R1Z.PrivacyR1AcctBasis.K CH)
  (w : h.Instance),
  (∀ (index : ℕ) (s : R1Z.PV_RunJoin_UnifiedRetry.State NA LA CA),
      R1Z.ProverCommitSemanticTransport26.mapR (fun out => (out.1, project out.2))
          (R1Z.PV_RunJoin_UnifiedRetry.entropy a.account index s) =
        R1Z.PV_RunJoin_UnifiedRetry.entropy b.account index (project s)) →
    (∀ (secret : R1Z.ProverRwRetryModel.Secret) (s : R1Z.PV_RunJoin_Deployed.State NA LA CA),
        R1Z.ProverCommitSemanticTransport26.mapR (fun out => (out.1, project out.2)) (a.body h x w secret s) =
          b.body h x w secret (project s)) →
      (∀ (c : Coins), project (R1Z.PV_RunJoin_Deployed.initialState a c) = R1Z.PV_RunJoin_Deployed.initialState b c) →
        ∀
          (outputs :
            R0Z.JointView.Statement R1Z.PrivacyR1AcctBasis.K CH →
              R0Z.JointView.Challenges R1Z.PrivacyR1AcctBasis.K → Aux)
          (adv : R1Z.GamesR1.R1Adv R1Z.PrivacyR1AcctBasis.K CH Aux),
          (∀ (out : Aeneas.Std.Result (R1Z.PV_RunJoin_Deployed.Output NA LA CA)),
              a.disclosed adv x out =
                b.disclosed adv x
                  (R1Z.ProverCommitSemanticTransport26.mapR (fun pair => (pair.1, project pair.2)) out)) →
            (∀ (out : Aeneas.Std.Result (R1Z.PV_RunJoin_Deployed.Output NA LA CA)),
                a.observerOracle adv x out =
                  b.observerOracle adv x
                    (R1Z.ProverCommitSemanticTransport26.mapR (fun pair => (pair.1, project pair.2)) out)) →
              ∀ (c : Coins),
                (R1Z.PV_RunJoin_Deployed.rust a).real h R1Z.PrivacyR1AcctBasis.basis outputs adv x w
                    (R1Z.PV_RunJoin_FiniteGraph.create (R1Z.PV_RunJoin_Deployed.initialState a) c) =
                  (R1Z.PV_RunJoin_Deployed.rust b).real h R1Z.PrivacyR1AcctBasis.basis outputs adv x w
                    (R1Z.PV_RunJoin_FiniteGraph.create (R1Z.PV_RunJoin_Deployed.initialState b) c)
@R1Z.PV_RunJoin_CommonObserver32.complete_pair : ∀ [ProverRwFull.ExternalTypes] {CH Aux Coins NA LA CA NB LB CB : Type}
  (a : R1Z.PV_RunJoin_Deployed.Runtime CH Aux Coins NA LA CA)
  (b : R1Z.PV_RunJoin_Deployed.Runtime CH Aux Coins NB LB CB)
  (project : R1Z.PV_RunJoin_UnifiedRetry.State NA LA CA → R1Z.PV_RunJoin_UnifiedRetry.State NB LB CB)
  (h : R0Z.ZkStatement.HonestProver R1Z.PrivacyR1AcctBasis.K) (x : R0Z.JointView.Statement R1Z.PrivacyR1AcctBasis.K CH)
  (w : h.Instance),
  (∀ (index : ℕ) (s : R1Z.PV_RunJoin_UnifiedRetry.State NA LA CA),
      R1Z.ProverCommitSemanticTransport26.mapR (fun out => (out.1, project out.2))
          (R1Z.PV_RunJoin_UnifiedRetry.entropy a.account index s) =
        R1Z.PV_RunJoin_UnifiedRetry.entropy b.account index (project s)) →
    (∀ (secret : R1Z.ProverRwRetryModel.Secret) (s : R1Z.PV_RunJoin_Deployed.State NA LA CA),
        R1Z.ProverCommitSemanticTransport26.mapR (fun out => (out.1, project out.2)) (a.body h x w secret s) =
          b.body h x w secret (project s)) →
      (∀ (c : Coins), project (R1Z.PV_RunJoin_Deployed.initialState a c) = R1Z.PV_RunJoin_Deployed.initialState b c) →
        ∀
          (outputs :
            R0Z.JointView.Statement R1Z.PrivacyR1AcctBasis.K CH →
              R0Z.JointView.Challenges R1Z.PrivacyR1AcctBasis.K → Aux)
          (adv : R1Z.GamesR1.R1Adv R1Z.PrivacyR1AcctBasis.K CH Aux),
          (∀ (out : Aeneas.Std.Result (R1Z.PV_RunJoin_Deployed.Output NA LA CA)),
              a.disclosed adv x out =
                b.disclosed adv x
                  (R1Z.ProverCommitSemanticTransport26.mapR (fun pair => (pair.1, project pair.2)) out)) →
            (∀ (out : Aeneas.Std.Result (R1Z.PV_RunJoin_Deployed.Output NA LA CA)),
                a.observerOracle adv x out =
                  b.observerOracle adv x
                    (R1Z.ProverCommitSemanticTransport26.mapR (fun pair => (pair.1, project pair.2)) out)) →
              ∀ (c : Coins),
                (have v :=
                    (R1Z.PV_RunJoin_Deployed.rust a).real h R1Z.PrivacyR1AcctBasis.basis outputs adv x w
                      (R1Z.PV_RunJoin_FiniteGraph.create (R1Z.PV_RunJoin_Deployed.initialState a) c);
                  (v, (R1Z.PV_RunJoin_Deployed.rust a).observe adv v)) =
                  have v :=
                    (R1Z.PV_RunJoin_Deployed.rust b).real h R1Z.PrivacyR1AcctBasis.basis outputs adv x w
                      (R1Z.PV_RunJoin_FiniteGraph.create (R1Z.PV_RunJoin_Deployed.initialState b) c);
                  (v, (R1Z.PV_RunJoin_Deployed.rust b).observe adv v)
@R1Z.PV_RJDec_Factor.exists_iff : ∀ {W C A V : Type} [Nonempty V]
  (reachable : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A → Prop)
  (observe : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A → V),
  (∃ decode,
      ∀ (r : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A),
        reachable r → decode (R1Z.PV_RunJoin_WorldDecode33.returned r) = observe r) ↔
    R1Z.PV_RJDec_Factor.Fibres reachable observe
@R1Z.PV_RJDec_ResultCases.fibres_iff : ∀ {W C A V : Type}
  (reachable : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A → Prop)
  (observe : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A → V),
  R1Z.PV_RJDec_Factor.Fibres reachable observe ↔
    (∀ (l r : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A) (a : A),
        reachable l →
          reachable r →
            l.outcome = R1Z.PV_W_Threading.Outcome.ok a →
              r.outcome = R1Z.PV_W_Threading.Outcome.ok a → l.world = r.world → observe l = observe r) ∧
      (∀ (l r : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A) (e : Aeneas.Std.Error),
          reachable l →
            reachable r →
              l.outcome = R1Z.PV_W_Threading.Outcome.fail e →
                r.outcome = R1Z.PV_W_Threading.Outcome.fail e → observe l = observe r) ∧
        ∀ (l r : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A),
          reachable l →
            reachable r →
              l.outcome = R1Z.PV_W_Threading.Outcome.div →
                r.outcome = R1Z.PV_W_Threading.Outcome.div → observe l = observe r
