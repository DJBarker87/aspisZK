@R1Z.PV_RJDec_Runtime.source : ∀ [inst : ProverRwFull.ExternalTypes] (ops : ProverRwFull.ExternalFuns)
  (input : R1Z.PV_RJDec_Runtime.Inputs) (secret : R1Z.PV_RJDec_Runtime.Secret),
  R1Z.PV_W_ReachedEffects.erase (R1Z.PV_RJDec_ZeroizingSelected.selected ops)
      (R1Z.PV_RJDec_Runtime.program input secret) =
    ProverRwFull.prover.prove_masked_attempt input.publicInput input.compiled ProverRwFull.transport.Variant.S2
      input.hash secret input.store
@R1Z.PV_RJDec_Runtime.executes : ∀ [inst : ProverRwFull.ExternalTypes] {W S F D DF ZF AF C : Type}
  (base : R1Z.PV_W_TypedEffects.Algebra W (Option C) Aeneas.Std.Error)
  (memory : R1Z.PV_RunJoin_RuntimeMemory38.Memory W S F D DF ZF) (zero : R1Z.PV_RJDec_AsmMemory.Memory W AF)
  (input : R1Z.PV_RJDec_Runtime.Inputs) (secret : R1Z.PV_RJDec_Runtime.Secret) (w : W),
  R1Z.PV_W_Syntax.Executes
    (fun {B} => R1Z.PV_W_ReachedThreading.interpret (R1Z.PV_RJDec_MemoryInstalled.algebra base memory zero))
    (R1Z.PV_RJDec_Runtime.program input secret) w (R1Z.PV_RJDec_Runtime.run base memory zero input secret w)
@R1Z.PV_RJDec_MemoryInstalled.array_complete : ∀ [inst : ProverRwFull.ExternalTypes] {W S F D DF ZF AF C : Type}
  (ops : ProverRwFull.ExternalFuns) (base : R1Z.PV_W_TypedEffects.Algebra W (Option C) Aeneas.Std.Error)
  (m : R1Z.PV_RunJoin_RuntimeMemory38.Memory W S F D DF ZF) (z : R1Z.PV_RJDec_AsmMemory.Memory W AF)
  (N : Aeneas.Std.Usize) (v : Aeneas.Std.Array Aeneas.Std.U8 N) (w : W),
  (R1Z.PV_RJDec_MemoryInstalled.algebra base m z).zeroArray N v w =
    {
      outcome :=
        R1Z.PV_W_SourceSyntax.resultOutcome
          (ProverRwFull.ExternalFuns.op130
            (ProverRwFull.Array.Insts.ZeroizeZeroize N
              (ProverRwFull.zeroize.Zeroize.Blanket ProverRwFull.U8.Insts.ZeroizeDefaultIsZeroes))
            v),
      world := z.commit w (R1Z.PV_RDCD_ZeroWorld.indexed (z.arrayAddress w v) 0 (↑N) (z.view w)), calls := [(w, none)] }
@R1Z.PV_RJDec_ReachedZero.complete : ∀ [inst : ProverRwFull.ExternalTypes] {W F C : Type}
  (ops : ProverRwFull.ExternalFuns) (m : R1Z.PV_RJDec_AsmMemory.Memory W F)
  (v : Aeneas.Std.Array Aeneas.Std.U8 32#usize) (w : W),
  R1Z.PV_RJDec_AsmMemory.array m 32#usize v w =
    {
      outcome :=
        R1Z.PV_W_SourceSyntax.resultOutcome
          ((R1Z.PV_RJDec_ReachedZero.op v).source (R1Z.PV_RJDec_ZeroizingSelected.selected ops)),
      world := m.commit w (R1Z.PV_RDCD_ZeroWorld.indexed (m.arrayAddress w v) 0 32 (m.view w)), calls := [(w, none)] }
@R1Z.PV_RJDec_AsmBind.complete : ∀ [ProverRwFull.ExternalTypes] {W F C A : Type} (m : R1Z.PV_RJDec_AsmMemory.Memory W F)
  (N : Aeneas.Std.Usize) (v : Aeneas.Std.Array Aeneas.Std.U8 N) (w : W)
  (k : Aeneas.Std.Array Aeneas.Std.U8 N → R1Z.PV_W_Threading.M W (Option C) Aeneas.Std.Error A),
  R1Z.PV_W_Threading.bind (R1Z.PV_RJDec_AsmMemory.array m N v) k w =
    have z := m.commit w (R1Z.PV_RDCD_ZeroWorld.indexed (m.arrayAddress w v) 0 (↑N) (m.view w));
    have r := k (Aeneas.Std.Array.repeat N 0#u8) z;
    { outcome := r.outcome, world := r.world, calls := [(w, none)] ++ r.calls }
