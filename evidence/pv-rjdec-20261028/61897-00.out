  (disclosed : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A → V)
  (oracle : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A → U),
  (R1Z.PV_RJDec_Factor.Fibres reachable fun r => (disclosed r, oracle r)) ↔
    R1Z.PV_RJDec_Factor.Fibres reachable disclosed ∧ R1Z.PV_RJDec_Factor.Fibres reachable oracle :=
fun {W C A V U} reachable disclosed oracle =>
  {
    mp := fun h =>
      ⟨fun l r hl hr same => congrArg Prod.fst (h l r hl hr same), fun l r hl hr same =>
        congrArg Prod.snd (h l r hl hr same)⟩,
    mpr := fun a =>
      let ⟨hd, ho, l, r, hl, hr, same⟩ := a
      Prod.ext (hd l r hl hr same) (ho l r hl hr same) }
theorem R1Z.PV_RJDec_ResultCases.fibres_iff : ∀ {W C A V : Type}
  (reachable : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A → Prop)
  (observe : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A → V),
  R1Z.PV_RJDec_Factor.Fibres reachable observe ↔
    (∀ (l r : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A) (a : A),
        reachable l →
          reachable r →
            l.outcome = R1Z.PV_W_Threading.Outcome.ok a →
              r.outcome = R1Z.PV_W_Threading.Outcome.ok a → l.world = r.world → observe l = observe r) ∧
      (∀ (l r : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A) (e : Aeneas.Std.Error),
          reachable l →
            reachable r →
              l.outcome = R1Z.PV_W_Threading.Outcome.fail e →
                r.outcome = R1Z.PV_W_Threading.Outcome.fail e → observe l = observe r) ∧
        ∀ (l r : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A),
          reachable l →
            reachable r →
              l.outcome = R1Z.PV_W_Threading.Outcome.div →
                r.outcome = R1Z.PV_W_Threading.Outcome.div → observe l = observe r :=
fun {W C A V} reachable observe =>
  {
    mp := fun h =>
      ⟨fun l r a hl hr hol hor hw =>
        h l r hl hr ((R1Z.PV_RJDec_ResultCases.returned_eq l r).mpr (Or.inl (Exists.intro a ⟨hol, ⟨hor, hw⟩⟩))),
        ⟨fun l r e hl hr hol hor =>
          h l r hl hr ((R1Z.PV_RJDec_ResultCases.returned_eq l r).mpr (Or.inr (Or.inl (Exists.intro e ⟨hol, hor⟩)))),
          fun l r hl hr hol hor =>
          h l r hl hr ((R1Z.PV_RJDec_ResultCases.returned_eq l r).mpr (Or.inr (Or.inr ⟨hol, hor⟩)))⟩⟩,
    mpr := fun a =>
      let ⟨hs, right✝⟩ := a
      let ⟨hf, hd, l, r, hl, hr, same⟩ := right✝
      Or.casesOn ((R1Z.PV_RJDec_ResultCases.returned_eq l r).mp same)
        (fun h =>
          let ⟨a, h✝⟩ := h
          let ⟨hol, right✝¹⟩ := h✝
          let ⟨hor, hw⟩ := right✝¹
          hs l r a hl hr hol hor hw)
        fun h =>
        Or.casesOn h
          (fun h =>
            let ⟨e, h✝¹⟩ := h
            let ⟨hol, hor⟩ := h✝¹
            hf l r e hl hr hol hor)
          fun h =>
          let ⟨hol, hor⟩ := h
          hd l r hl hr hol hor }
