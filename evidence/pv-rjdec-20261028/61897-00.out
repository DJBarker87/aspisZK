  ∃ w, AspisR1.PV_2TNV_HeadlineFibre.H.public w = (AspisR1.PV_2TNV_PublicEncoding.x handle).1 :=
fun {CommitHandle} handle =>
  Exists.intro AspisR1.PV_2TNV_HeadlineFibre.witness (AspisR1.PV_2TNV_HeadlineFibre.public_eq handle)
