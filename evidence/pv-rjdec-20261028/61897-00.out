@[defeq] theorem R1Z.PV_RJDec_RuntimeFields.execute_independent : ∀ [ProverRwFull.ExternalTypes]
  {CH Aux Coins N L C : Type} (r : R1Z.PV_RunJoin_Deployed.Runtime CH Aux Coins N L C)
  (disclosed :
    R1Z.GamesR1.R1Adv R1Z.PrivacyR1AcctBasis.K CH Aux →
      R0Z.JointView.Statement R1Z.PrivacyR1AcctBasis.K CH →
        Aeneas.Std.Result (R1Z.PV_RunJoin_Deployed.Output N L C) →
          R0Z.JointView.View R1Z.PrivacyR1AcctBasis.K CH Aux R1Z.Batched.R1Bat)
  (oracle :
    R1Z.GamesR1.R1Adv R1Z.PrivacyR1AcctBasis.K CH Aux →
      R0Z.JointView.Statement R1Z.PrivacyR1AcctBasis.K CH →
        Aeneas.Std.Result (R1Z.PV_RunJoin_Deployed.Output N L C) →
          List (R0Z.FsStatement.Bytes × R0Z.FsStatement.OracleAnswer))
  (h : R0Z.ZkStatement.HonestProver R1Z.PrivacyR1AcctBasis.K) (x : R0Z.JointView.Statement R1Z.PrivacyR1AcctBasis.K CH)
  (w : h.Instance) (coin : R1Z.PV_RunJoin_Deployed.World r),
  R1Z.PV_RunJoin_Deployed.execute
      { world := r.world, account := r.account, body := r.body, disclosed := disclosed, observerOracle := oracle,
        ideal := r.ideal }
      h x w coin =
    R1Z.PV_RunJoin_Deployed.execute r h x w coin :=
fun [ProverRwFull.ExternalTypes] {CH Aux Coins N L C} r disclosed oracle h x w coin => rfl
theorem R1Z.PV_RJDec_RuntimeFields.oracle_underdetermined : ∀ [ProverRwFull.ExternalTypes] {CH Aux Coins N L C : Type}
  (r : R1Z.PV_RunJoin_Deployed.Runtime CH Aux Coins N L C)
  (event : R0Z.FsStatement.Bytes × R0Z.FsStatement.OracleAnswer)
  (adv : R1Z.GamesR1.R1Adv R1Z.PrivacyR1AcctBasis.K CH Aux) (x : R0Z.JointView.Statement R1Z.PrivacyR1AcctBasis.K CH)
  (out : Aeneas.Std.Result (R1Z.PV_RunJoin_Deployed.Output N L C)),
  { world := r.world, account := r.account, body := r.body, disclosed := r.disclosed,
          observerOracle := fun x x_1 x_2 => [], ideal := r.ideal }.observerOracle
      adv x out ≠
    { world := r.world, account := r.account, body := r.body, disclosed := r.disclosed,
          observerOracle := fun x x_1 x_2 => [event], ideal := r.ideal }.observerOracle
      adv x out :=
fun [ProverRwFull.ExternalTypes] {CH Aux Coins N L C} r event adv x out same =>
  have lengths := congrArg List.length same;
  of_decide_eq_true (id (Eq.refl true)) lengths
theorem R1Z.PV_RJDec_TotalExtension.cases_iff : ∀ {A B V : Type} (project : A → B) (left : Aeneas.Std.Result A → V)
  (right : Aeneas.Std.Result B → V),
  (∀ (out : Aeneas.Std.Result A), left out = right (R1Z.ProverCommitSemanticTransport26.mapR project out)) ↔
    (∀ (a : A), left (Aeneas.Std.Result.ok a) = right (Aeneas.Std.Result.ok (project a))) ∧
      (∀ (e : Aeneas.Std.Error), left (Aeneas.Std.Result.fail e) = right (Aeneas.Std.Result.fail e)) ∧
        left Aeneas.Std.Result.div = right Aeneas.Std.Result.div :=
fun {A B V} project left right =>
  {
    mp := fun law =>
      ⟨fun a => law (Aeneas.Std.Result.ok a), ⟨fun e => law (Aeneas.Std.Result.fail e), law Aeneas.Std.Result.div⟩⟩,
    mpr := fun a =>
      let ⟨success, right✝⟩ := a
      let ⟨failure, divergence, out⟩ := right✝
      Aeneas.Std.Result.casesOn (motive := fun t =>
        out = t → left out = right (R1Z.ProverCommitSemanticTransport26.mapR project out)) out
        (fun a h => Eq.symm h ▸ success a) (fun e h => Eq.symm h ▸ failure e) (fun h => Eq.symm h ▸ divergence)
        (Eq.refl out) }
theorem R1Z.PV_RJDec_TotalExtension.unreachable_free : ∀ {A V : Type} (reachable : Aeneas.Std.Result A → Prop)
  (left right : Aeneas.Std.Result A → V) (absent : Aeneas.Std.Result A),
  ¬reachable absent →
    (∀ (out : Aeneas.Std.Result A), out ≠ absent → left out = right out) →
      ∀ (out : Aeneas.Std.Result A), reachable out → left out = right out :=
fun {A V} reachable left right absent not_reachable same out admitted =>
  same out fun eq => not_reachable (eq ▸ admitted)
theorem R1Z.PV_RJDec_CommonCases.complete_pair : ∀ [ProverRwFull.ExternalTypes] {CH Aux Coins NA LA CA NB LB CB : Type}
  (a : R1Z.PV_RunJoin_Deployed.Runtime CH Aux Coins NA LA CA)
  (b : R1Z.PV_RunJoin_Deployed.Runtime CH Aux Coins NB LB CB)
  (project : R1Z.PV_RunJoin_UnifiedRetry.State NA LA CA → R1Z.PV_RunJoin_UnifiedRetry.State NB LB CB)
  (h : R0Z.ZkStatement.HonestProver R1Z.PrivacyR1AcctBasis.K) (x : R0Z.JointView.Statement R1Z.PrivacyR1AcctBasis.K CH)
  (w : h.Instance),
  (∀ (index : ℕ) (s : R1Z.PV_RunJoin_UnifiedRetry.State NA LA CA),
      R1Z.ProverCommitSemanticTransport26.mapR (fun out => (out.1, project out.2))
          (R1Z.PV_RunJoin_UnifiedRetry.entropy a.account index s) =
        R1Z.PV_RunJoin_UnifiedRetry.entropy b.account index (project s)) →
    (∀ (secret : R1Z.ProverRwRetryModel.Secret) (s : R1Z.PV_RunJoin_Deployed.State NA LA CA),
        R1Z.ProverCommitSemanticTransport26.mapR (fun out => (out.1, project out.2)) (a.body h x w secret s) =
          b.body h x w secret (project s)) →
      (∀ (c : Coins), project (R1Z.PV_RunJoin_Deployed.initialState a c) = R1Z.PV_RunJoin_Deployed.initialState b c) →
        ∀
          (outputs :
            R0Z.JointView.Statement R1Z.PrivacyR1AcctBasis.K CH →
              R0Z.JointView.Challenges R1Z.PrivacyR1AcctBasis.K → Aux)
          (adv : R1Z.GamesR1.R1Adv R1Z.PrivacyR1AcctBasis.K CH Aux),
          (∀ (value : R1Z.ProverCommitRetry34.Step (R1Z.ProverCommitRetry34.Published R1Z.ProverRwRetryModel.Proof))
              (state : R1Z.PV_RunJoin_Deployed.State NA LA CA),
              a.disclosed adv x (Aeneas.Std.Result.ok (value, state)) =
                b.disclosed adv x (Aeneas.Std.Result.ok (value, project state))) →
            (∀ (error : Aeneas.Std.Error),
                a.disclosed adv x (Aeneas.Std.Result.fail error) = b.disclosed adv x (Aeneas.Std.Result.fail error)) →
              a.disclosed adv x Aeneas.Std.Result.div = b.disclosed adv x Aeneas.Std.Result.div →
                (∀
                    (value :
                      R1Z.ProverCommitRetry34.Step (R1Z.ProverCommitRetry34.Published R1Z.ProverRwRetryModel.Proof))
                    (state : R1Z.PV_RunJoin_Deployed.State NA LA CA),
                    a.observerOracle adv x (Aeneas.Std.Result.ok (value, state)) =
                      b.observerOracle adv x (Aeneas.Std.Result.ok (value, project state))) →
                  (∀ (error : Aeneas.Std.Error),
                      a.observerOracle adv x (Aeneas.Std.Result.fail error) =
                        b.observerOracle adv x (Aeneas.Std.Result.fail error)) →
                    a.observerOracle adv x Aeneas.Std.Result.div = b.observerOracle adv x Aeneas.Std.Result.div →
                      ∀ (c : Coins),
                        (have v :=
                            (R1Z.PV_RunJoin_Deployed.rust a).real h R1Z.PrivacyR1AcctBasis.basis outputs adv x w
                              (R1Z.PV_RunJoin_FiniteGraph.create (R1Z.PV_RunJoin_Deployed.initialState a) c);
                          (v, (R1Z.PV_RunJoin_Deployed.rust a).observe adv v)) =
                          have v :=
                            (R1Z.PV_RunJoin_Deployed.rust b).real h R1Z.PrivacyR1AcctBasis.basis outputs adv x w
                              (R1Z.PV_RunJoin_FiniteGraph.create (R1Z.PV_RunJoin_Deployed.initialState b) c);
                          (v, (R1Z.PV_RunJoin_Deployed.rust b).observe adv v) :=
fun [ProverRwFull.ExternalTypes] {CH Aux Coins NA LA CA NB LB CB} a b project h x w entropy_step body_step initial
    outputs adv disclosed_ok disclosed_fail disclosed_div oracle_ok oracle_fail oracle_div c =>
  have hd :=
    (R1Z.PV_RJDec_TotalExtension.cases_iff (fun pair => (pair.1, project pair.2)) (a.disclosed adv x)
          (b.disclosed adv x)).mpr
      ⟨fun pair => disclosed_ok pair.1 pair.2, ⟨disclosed_fail, disclosed_div⟩⟩;
  have ho :=
    (R1Z.PV_RJDec_TotalExtension.cases_iff (fun pair => (pair.1, project pair.2)) (a.observerOracle adv x)
          (b.observerOracle adv x)).mpr
      ⟨fun pair => oracle_ok pair.1 pair.2, ⟨oracle_fail, oracle_div⟩⟩;
  R1Z.PV_RunJoin_CommonObserver32.complete_pair a b project h x w entropy_step body_step initial outputs adv hd ho c
