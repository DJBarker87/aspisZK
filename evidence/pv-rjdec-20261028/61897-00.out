theorem R1Z.PV_RJDec_V047Native.consume : ∀ {CH : Type} (actual : R0Z.ZkStatement.Statement R1Z.PrivacyR1AcctBasis.K CH)
  (native_handle : CH),
  actual = AspisR1.PV_2TNV_PublicEncoding.x native_handle → ∃ w, R1Z.PV_RJDec_V047.H.public w = actual.1 :=
fun {CH} actual native_handle native_identification =>
  R1Z.PV_RJDec_V047.consume (AspisR1.PV_2TNV_PublicEncoding.x native_handle) actual
    (AspisR1.PV_2TNV_HeadlineFibre.fibre native_handle) native_identification
theorem R1Z.PV_RJDec_V047Native.identification_iff : ∀ {CH : Type}
  (actual : R0Z.ZkStatement.Statement R1Z.PrivacyR1AcctBasis.K CH) (native_handle : CH),
  actual = AspisR1.PV_2TNV_PublicEncoding.x native_handle ↔
    actual.1 = (AspisR1.PV_2TNV_PublicEncoding.x native_handle).1 ∧ actual.2 = native_handle :=
fun {CH} actual native_handle =>
  { mp := fun eq => ⟨congrArg Prod.fst eq, congrArg Prod.snd eq⟩,
    mpr := fun a =>
      let ⟨public_eq, handle_eq⟩ := a
      Prod.ext public_eq handle_eq }
theorem R1Z.PV_RJDec_SnapshotGuard.wrong_length : ∀ [inst : ProverRwFull.ExternalTypes]
  [inst_1 : ProverRwFull.ExternalFuns] (bytes : Aeneas.Std.Slice Aeneas.Std.U8),
  (bytes.len != AspisR1TerminalDecoder.pool_v1.pair_tree_profile.POOL_V1_PAIR_LIVE_SNAPSHOT_BYTES) = true →
    R1Z.PV_W_TypedEffects.erase inferInstance (R1Z.PV_RJDec_ParserR12.program bytes) =
      Aeneas.Std.Result.ok
        (Aeneas.Std.core.result.Result.Err
          AspisR1TerminalDecoder.pool_v1.pair_tree_profile.PoolV1PairLiveSnapshotErrorV1.WrongLength) :=
fun [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns] bytes wrong =>
  of_eq_true
    (Eq.trans
      (congrFun'
        (congrArg Eq
          (congrArg (R1Z.PV_W_TypedEffects.erase inferInstance)
            (ite_cond_eq_true
              (pure
                (Aeneas.Std.core.result.Result.Err
                  AspisR1TerminalDecoder.pool_v1.pair_tree_profile.PoolV1PairLiveSnapshotErrorV1.WrongLength))
              (do
                let s ←
                  R1Z.PV_W_TypedEffects.invoke "core.slice.index.Slice.index" fun ops =>
                      Aeneas.Std.core.slice.index.Slice.index
                        (Aeneas.Std.core.slice.index.SliceIndexRangeToUsizeSlice Aeneas.Std.U8) bytes
                        { «end» := 8#usize }
                let s1 ←
                  R1Z.PV_W_TypedEffects.invoke "core.array.Array.index" fun ops =>
                      Aeneas.Std.core.array.Array.index
                        (Aeneas.Std.core.ops.index.IndexSlice
                          (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8))
                        AspisR1TerminalDecoder.pool_v1.pair_tree_profile.POOL_V1_PAIR_LIVE_SNAPSHOT_MAGIC
                        { start := 0#usize, «end» := 8#usize }
                let b ←
                  R1Z.PV_W_TypedEffects.invoke "core.cmp.PartialEq.ne.trait_default" fun ops =>
                      Aeneas.Std.core.cmp.PartialEq.ne.trait_default
                        (AspisR1TerminalDecoder.Slice.Insts.CoreCmpPartialEqSlice Aeneas.Std.core.cmp.PartialEqU8) s s1
                if b = true then
                    pure
                      (Aeneas.Std.core.result.Result.Err
                        AspisR1TerminalDecoder.pool_v1.pair_tree_profile.PoolV1PairLiveSnapshotErrorV1.WrongMagic)
                  else do
                    let i1 ← R1Z.PV_W_TypedEffects.invoke "Slice.index_usize" fun ops => bytes.index_usize 8#usize
                    if
                          (i1 != AspisR1TerminalDecoder.pool_v1.pair_tree_profile.POOL_V1_PAIR_LIVE_SNAPSHOT_VERSION) =
                            true then
                        pure
                          (Aeneas.Std.core.result.Result.Err
                            AspisR1TerminalDecoder.pool_v1.pair_tree_profile.PoolV1PairLiveSnapshotErrorV1.WrongVersion)
                      else do
                        let i2 ← R1Z.PV_W_TypedEffects.invoke "Slice.index_usize" fun ops => bytes.index_usize 9#usize
                        if (i2 != 0#u8) = true then
                            pure
                              (Aeneas.Std.core.result.Result.Err
                                AspisR1TerminalDecoder.pool_v1.pair_tree_profile.PoolV1PairLiveSnapshotErrorV1.NonZeroReserved)
                          else do
                            let i3 ←
                              R1Z.PV_W_TypedEffects.invoke "Slice.index_usize" fun ops => bytes.index_usize 10#usize
                            if (i3 != 0#u8) = true then
                                pure
                                  (Aeneas.Std.core.result.Result.Err
                                    AspisR1TerminalDecoder.pool_v1.pair_tree_profile.PoolV1PairLiveSnapshotErrorV1.NonZeroReserved)
                              else do
                                let i4 ←
                                  R1Z.PV_W_TypedEffects.invoke "Slice.index_usize" fun ops => bytes.index_usize 11#usize
                                if (i4 != 0#u8) = true then
                                    pure
                                      (Aeneas.Std.core.result.Result.Err
                                        AspisR1TerminalDecoder.pool_v1.pair_tree_profile.PoolV1PairLiveSnapshotErrorV1.NonZeroReserved)
                                  else do
                                    let i5 ←
                                      R1Z.PV_W_TypedEffects.invoke "Slice.index_usize" fun ops =>
                                          bytes.index_usize 12#usize
                                    if (i5 != 0#u8) = true then
                                        pure
                                          (Aeneas.Std.core.result.Result.Err
                                            AspisR1TerminalDecoder.pool_v1.pair_tree_profile.PoolV1PairLiveSnapshotErrorV1.NonZeroReserved)
                                      else do
                                        let i6 ←
                                          R1Z.PV_W_TypedEffects.invoke "Slice.index_usize" fun ops =>
                                              bytes.index_usize 13#usize
                                        if (i6 != 0#u8) = true then
                                            pure
                                              (Aeneas.Std.core.result.Result.Err
                                                AspisR1TerminalDecoder.pool_v1.pair_tree_profile.PoolV1PairLiveSnapshotErrorV1.NonZeroReserved)
                                          else do
                                            let i7 ←
                                              R1Z.PV_W_TypedEffects.invoke "Slice.index_usize" fun ops =>
                                                  bytes.index_usize 14#usize
                                            if (i7 != 0#u8) = true then
                                                pure
                                                  (Aeneas.Std.core.result.Result.Err
                                                    AspisR1TerminalDecoder.pool_v1.pair_tree_profile.PoolV1PairLiveSnapshotErrorV1.NonZeroReserved)
                                              else do
                                                let i8 ←
                                                  R1Z.PV_W_TypedEffects.invoke "Slice.index_usize" fun ops =>
                                                      bytes.index_usize 15#usize
                                                if (i8 != 0#u8) = true then
                                                    pure
                                                      (Aeneas.Std.core.result.Result.Err
                                                        AspisR1TerminalDecoder.pool_v1.pair_tree_profile.PoolV1PairLiveSnapshotErrorV1.NonZeroReserved)
                                                  else do
                                                    let s2 ←
                                                      R1Z.PV_W_TypedEffects.invoke "core.slice.index.Slice.index"
