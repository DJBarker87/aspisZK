fun {W C A V} [Nonempty V] reachable observe =>
  {
    mp := fun a =>
      let ⟨decode, law, l, r, hl, hr, same⟩ := a
      Eq.mpr (id (congrArg (fun _a => _a = observe r) (Eq.symm (law l hl))))
        (Eq.mpr (id (congrArg (fun _a => decode (R1Z.PV_RunJoin_WorldDecode33.returned l) = _a) (Eq.symm (law r hr))))
          (Eq.mpr (id (congrArg (fun _a => decode _a = decode (R1Z.PV_RunJoin_WorldDecode33.returned r)) same))
            (Eq.refl (decode (R1Z.PV_RunJoin_WorldDecode33.returned r))))),
    mpr := fun fibres =>
      let decode := fun out =>
        if h : ∃ r, reachable r ∧ R1Z.PV_RunJoin_WorldDecode33.returned r = out then observe (Classical.choose h)
