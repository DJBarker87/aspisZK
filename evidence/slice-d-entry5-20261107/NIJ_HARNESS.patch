+fn NHY_any_verifier_error()->verifier::Error{let tag:u8=kani::any();kani::assume(tag<8);match tag{0=>verifier::Error::Parse,1=>verifier::Error::Semantic,2=>verifier::Error::Transcript,3=>verifier::Error::Relation,4=>verifier::Error::Merkle,5=>verifier::Error::Query,6=>verifier::Error::Checkpoint,_=>verifier::Error::Allocation}}
