def head : List (List Nat) := [B00.input]
def tail : List Nat := [173]
def message : List Nat := head.flatten ++ tail
def chunks : List (List Nat) := head ++ [B01.input]
theorem tailLength : tail.length=1 := by rfl
#print axioms tailLength
theorem headLength : head.flatten.length=64 := by
  simp only [head,List.length_flatten,List.map_cons,List.map_nil,List.sum_cons,List.sum_nil,lenB00]
  omega
#print axioms headLength
theorem messageLength : message.length=65 := by
  simp only [message,List.length_append,headLength,tailLength]
#print axioms messageLength
theorem tailPad : tail ++ [128] ++ List.replicate 54 0 ++ [0,0,0,0,0,0,2,8] = [B01.input].flatten := by rfl
#print axioms tailPad
theorem padded : pad message=chunks.flatten := by
  rw [pad,messageLength]
  change (head.flatten ++ tail) ++ [128] ++ List.replicate 54 0 ++ [0,0,0,0,0,0,2,8]=_
  simp only [List.append_assoc,chunks,List.flatten_append]
  exact congrArg (fun t => head.flatten ++ t) (by simpa only [List.append_assoc] using tailPad)
#print axioms padded
theorem lengths : ∀ c ∈ chunks,c.length=64 := by
  intro c hc
  simp only [chunks,head,List.mem_append,List.mem_cons,List.not_mem_nil,or_false,or_assoc] at hc
  rcases hc with h0|h1
  · subst c; rfl
  · subst c; rfl
#print axioms lengths
theorem paddedLength : (pad message).length=128 := by
  rw [padded]
  simp only [chunks,head,List.flatten_append,List.flatten_cons,List.flatten_nil,List.length_append,List.length_nil,List.length_flatten,List.map_cons,List.map_nil,List.sum_cons,List.sum_nil,lenB00,lenB01]
#print axioms paddedLength
theorem blockList : blocks ((pad message).length/64) (pad message)=chunks := by
  rw [paddedLength,padded]
  exact blocks_chunks chunks lengths
#print axioms blockList
