AspisR1.SAG_UnrestrictedScale.wide_mul_m31_success : ∀ (x z : AspisR1CurrentWide.Proof.E)
  (s : AspisR1CurrentWide.field.M31),
  AspisR1CurrentWide.field.wide_exact.WideExact.mul_m31 x s = Aeneas.Std.Result.ok z →
    AspisR1CurrentWide.Proof.CanonicalWide z ∧
