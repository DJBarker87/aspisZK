theorem AspisR1FinishDotReturnedProductWords.successful_current_finish_query_product_words : ∀ {W : Type}
  (ops : AspisR1FinishRelationCurrent.FinishOps W AspisR1FinishDotDecodedProductTrace.PushState)
  (fm : Aeneas.Std.Slice Aeneas.Std.U8) (ws : Aeneas.Std.Slice AspisR1FinishDotDecodedProductTrace.FinishQM)
  (out : AspisR1FinishDotDecodedProductTrace.FinishE),
  AspisR1FinishRelationCurrent.verifier.finish_query_dot
        (AspisR1FinishDotConcreteOps.withConcreteDot (AspisR1CurrentWide.Proof.finishConcreteField ops)
          AspisR1EbyKPushDecodedProductUpdate.QRaw)
        fm ws =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok out) →
    ∃ final xs,
      AspisR1FinishDotSourceABI.finishFromPush final = Aeneas.Std.Result.ok out ∧
        AspisR1FinishDotSourceABI.finishWords out =
            List.map AspisR1EbyKFinish.Proof.word (↑final.c0.sums ++ ↑final.c1.sums) ∧
          AspisR1FinishDotDecodedProductTrace.stateDelta final = AspisR1FinishDotDecodedProductTrace.deltaSum xs ∧
            xs.length = ↑ws.len ∧
              (∀ (k : ℕ) (hk : k < xs.length), ↑xs[k].1 = k) ∧
                ∀ t ∈ xs,
                  t.1 < ws.len ∧
                    AspisR1CurrentWide.Proof.finishField fm t.1 = Aeneas.Std.Result.ok t.2.1 ∧
                      ws.index_usize t.1 = Aeneas.Std.Result.ok t.2.2 :=
fun {W} ops fm ws out hrun =>
  let ⟨final, h✝⟩ :=
    AspisR1FinishDotDecodedProductTrace.successful_current_finish_query_product_trace ops fm ws out hrun
  let ⟨xs, h✝¹⟩ := h✝
  let ⟨hfinish, right✝⟩ := h✝¹
  let ⟨hcount, right✝¹⟩ := right✝
  let ⟨hdelta, right✝²⟩ := right✝¹
  let ⟨hlen, right✝³⟩ := right✝²
  let ⟨hseq, hreads⟩ := right✝³
  have hwords := AspisR1FinishDotSourceABI.finishFromPush_success_canonical final out hfinish;
  Exists.intro final (Exists.intro xs ⟨hfinish, ⟨hwords.right, ⟨hdelta, ⟨hlen, ⟨hseq, hreads⟩⟩⟩⟩⟩)
