def AspisR1.SAG_ScaleConfig.select : {F C : Type} →
  AspisR1.DrvC_Installation.Configuration F C → AspisR1.DrvC_Installation.Configuration F C :=
fun {F C} c =>
  { adapter := c.adapter, currentBase := c.currentBase, stageBase := c.stageBase,
    finish := AspisR1.SAG_StageScale.install c.finish, reserved := c.reserved, query := c.query, geometry := c.geometry,
    boundaries := c.boundaries, std := c.std }
def AspisR1.SAG_ScaleConfig.configuration : {F C : Type} →
  AspisR1.DrvC_Installation.Configuration F C →
    AspisR1.NP6_StdModel.Reservation → AspisR1.DrvC_Installation.Configuration F C :=
fun {F C} c r => AspisR1.Rc3_Install.configuration (AspisR1.SAG_ScaleConfig.select c) r
def AspisR1.SAG_StageScale.install : {W : Type} →
  AspisR1Stage2.Stage2Finish.FinishOps W → AspisR1Stage2.Stage2Finish.FinishOps W :=
fun {W} seed =>
  { field := seed.field, quarter := Aeneas.Std.Result.ok 536870912#u32, add := seed.add,
    mulM := AspisR1.SAG_StageScale.mulM, ne := seed.ne, polynomial := seed.polynomial, trace := seed.trace,
    folds := seed.folds, newWeights := seed.newWeights, pair := seed.pair, mark := seed.mark, dot := seed.dot }
def AspisR1.SAG_StageScale.mulM : AspisR1Stage2.Stage2Finish.E →
  AspisR1Stage2.Stage2Finish.M → Aeneas.Std.Result AspisR1Stage2.Stage2Finish.E :=
fun claim scalar => do
  let value ← AspisR1CurrentWide.field.wide_exact.WideExact.mul_m31 (AspisR1.SAQ_WideABI.toW claim) scalar
  Aeneas.Std.Result.ok (AspisR1.SAQ_WideABI.fromW value)
@AspisR1.SAG_ScaleScope.compatible : ∀ {F C : Type} (c : AspisR1.DrvC_Installation.Configuration F C)
  (r : AspisR1.NP6_StdModel.Reservation),
  c.finish.quarter = Aeneas.Std.Result.ok 536870912#u32 →
    c.finish.mulM = AspisR1.SAG_StageScale.mulM →
      AspisR1.SAG_ScaleConfig.configuration c r = AspisR1.Rc3_Install.configuration c r
