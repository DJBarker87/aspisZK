def AspisR1.Port1_CanonicalJoin.AcceptedVerifierJoin : AspisR1.LiteralByteProtocol.Decoder →
  AspisR1.OraclePortRuntimeBindingC7.Verifier → Prop :=
fun D rust =>
  ∀ (s : AspisR1.Port1_StoredCarrier.Submission)
    (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
    (AspisV8R19.MemoizedProgramLaw.eval H (rust (AspisR1.Port1_StoredCarrier.input s))).2 = Bool.true →
      AspisV8R19.MemoizedProgramLaw.eval H (rust (AspisR1.Port1_StoredCarrier.input s)) =
        AspisV8R19.MemoizedProgramLaw.eval H
          (AspisR1.OraclePortStoredExperimentC4.verifier D AspisR1.OraclePortFrozen2.dV_frozen2
            (AspisR1.Port1_StoredCarrier.input s))
