def AspisR1.FIs_Native.Calls : {F CoreError Hash : Type} →
  VTop_Stages.Ops →
    AspisR1Stage2.Stage2Finish.FinishOps F →
      Bool →
        AspisR1.Port3_NativeQueryBody.Ops →
          AspisR1.Port3_NativeGeometryBody.Ops CoreError →
            VTop_Stages.aspis_core.digest.Digest32 Hash →
              Hash →
                Aeneas.Std.Slice Aeneas.Std.U8 →
                  Aeneas.Std.Slice Aeneas.Std.U8 →
                    Aeneas.Std.Slice Aeneas.Std.U8 → AspisR1.Cons_Native.Witness → Prop :=
fun {F CoreError Hash} base finishOps reserved queryOps geoOps D hash pub proof checkpoint t =>
  AspisR1.Cons_Native.Calls base finishOps reserved queryOps geoOps D hash pub proof checkpoint t ∧
    AspisR1.Cons_NativeBuild.Aux reserved queryOps geoOps D hash pub proof checkpoint t ∧
      AspisR1.SAG_NativeFull.Shape
        (AspisR1.Tx2N_Execution.control (AspisR1.Tx2I_Install.stage (AspisR1.Op5T_Concrete.stage base) finishOps)
          reserved queryOps geoOps)
        proof t
@AspisR1.FIs_Cons_Second.accepted : ∀ {F C : Type} (adapter : AdapterRw.Ops) (ops : AspisR1CurrentCaller.Ops)
  (stage : VTop_Stages.Ops) (finish : AspisR1Stage2.Stage2Finish.FinishOps F) (reserved : Bool)
  (query : AspisR1.Port3_NativeQueryBody.Ops) (geo : AspisR1.Port3_NativeGeometryBody.Ops C)
  (B : AspisR1PublicPreparation.FinishModel.Boundaries) (std : AspisR1.ClaimsUnrolledFinish.StdCalls)
  (accounts1 accounts2 : AspisR1.S2W_ExtractionBoundary.Accounts) (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
  (f : AspisR1.S2W_NativeConsolidation.FirstCut) (s : AspisR1.S2W_NativeConsolidation.SecondCut),
  AspisR1.S2W_NativeConsolidation.SourceCuts
      (AspisR1.ClaimsUnrolledSdk.sdkOps
        (AspisR1.Tx2I_Install.install adapter
          (AspisR1.Op5T_Concrete.stage
            (AspisR1.Tx2N_Execution.control (AspisR1.AuS1_Install.base stage) reserved query geo))
          finish)
        (AspisR1.Uni_Install.current ops reserved query geo) B std)
      accounts1 accounts2 saved f s →
    have D :=
      AdapterRw.SolanaDigest.Insts.Aspis_coreDigestDigest32
        (AspisR1.ClaimsUnrolledSdk.sdkOps
          (AspisR1.Tx2I_Install.install adapter
            (AspisR1.Op5T_Concrete.stage
              (AspisR1.Tx2N_Execution.control (AspisR1.AuS1_Install.base stage) reserved query geo))
            finish)
          (AspisR1.Uni_Install.current ops reserved query geo) B std);
    ∃ t,
      AspisR1.FIs_Native.Calls (AspisR1.AuS1_Install.base stage) finish reserved query geo D () s.pub s.proof
          s.checkpoint t ∧
        AspisR1.Cons_NativeBuild.Aux reserved query geo D () s.pub s.proof s.checkpoint t
'AspisR1.FIs_Cons_Second.accepted' depends on axioms: [propext, Classical.choice, Quot.sound]
