def AspisR1.SAG_NativeFull.Shape : VTop_Stages.Ops →
  Aeneas.Std.Slice Aeneas.Std.U8 → AspisR1.Cons_Native.Witness → Prop :=
fun ops proof t =>
  ∃ round0 folded round1 finalStart queryStart,
    ops.op22 = Aeneas.Std.Result.ok round0 ∧
      ops.op15 = Aeneas.Std.Result.ok folded ∧
        ops.op14 = Aeneas.Std.Result.ok round1 ∧
          ops.op21 = Aeneas.Std.Result.ok finalStart ∧
            ops.op20 = Aeneas.Std.Result.ok queryStart ∧
              Aeneas.Std.core.slice.index.Slice.index
                    (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8) proof
                    { start := round0, «end» := folded } =
                  Aeneas.Std.Result.ok t.v2.round0 ∧
                Aeneas.Std.core.slice.index.Slice.index
                      (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8) proof
                      { start := round1, «end» := finalStart } =
                    Aeneas.Std.Result.ok t.v2.round1 ∧
                  Aeneas.Std.core.slice.index.Slice.index
                      (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8) proof
                      { start := finalStart, «end» := queryStart } =
                    Aeneas.Std.Result.ok t.v2.final_message
@AspisR1.SAG_NativeFull.accepted : ∀ {F C Hash : Type} (base : VTop_Stages.Ops)
  (finish : AspisR1Stage2.Stage2Finish.FinishOps F) (reserved : Bool) (query : AspisR1.Port3_NativeQueryBody.Ops)
  (geo : AspisR1.Port3_NativeGeometryBody.Ops C) (D : VTop_Stages.aspis_core.digest.Digest32 Hash) (hash : Hash)
  (pub proof checkpoint : Aeneas.Std.Slice Aeneas.Std.U8),
  VTop_Stages.verifier.candidate.tx2_authenticated
        (AspisR1.Tx2I_Install.stage (AspisR1.Tx2N_Execution.control base reserved query geo) finish) D pub proof
        checkpoint hash Option.none =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) →
    ∃ t,
      AspisR1.Cons_Native.Calls base finish reserved query geo D hash pub proof checkpoint t ∧
        AspisR1.Cons_NativeBuild.Aux reserved query geo D hash pub proof checkpoint t ∧
          AspisR1.SAG_NativeFull.Shape
            (AspisR1.Tx2N_Execution.control (AspisR1.Tx2I_Install.stage base finish) reserved query geo) proof t
'AspisR1.SAG_NativeFull.accepted' depends on axioms: [propext, Classical.choice, Quot.sound]
