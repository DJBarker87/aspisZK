    AspisR1.S2W_D189Entry.Entry →
      AspisR1.S2W_D189Entry.Entry →
        W →
          W →
            AdapterRw.Ops →
              AspisR1CurrentCaller.Ops →
                Bool →
                  AspisR1.Port3_NativeQueryBody.Ops →
                    AspisR1.Port3_NativeGeometryBody.Ops CoreError →
                      VTop_Stages.Ops →
                        AspisR1Stage2.Stage2Finish.FinishOps F →
                          AspisR1PublicPreparation.FinishModel.Boundaries →
                            AspisR1.ClaimsUnrolledFinish.StdCalls →
                              AspisR1.S2W_ExtractionBoundary.Program →
                                Aeneas.Std.Slice Aeneas.Std.U8 →
                                  Aeneas.Std.Slice Aeneas.Std.U8 →
                                    AspisR1.S2W_ExtractionBoundary.Slot →
                                      Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8 →
                                        AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
                                          AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
                                            (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
                                              AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes
                                                  AspisV8R19.SourceDuplexStep.State Unit →
                                                Prop :=
fun {W F CoreError} L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps stageBase finishOps B claimsStd program data1
    data2 slot saved post1 post2 H prior =>
  have port :=
    AspisR1.SdkD_Child.port adapterOps (AspisR1.Uni_Install.current ops reserved queryOps geoOps)
      (AspisR1.Op5T_Concrete.stage
        (AspisR1.Tx2N_Execution.control (AspisR1.AuS1_Install.base stageBase) reserved queryOps geoOps))
      finishOps (AspisR1.F3M_CircleSource.install B) claimsStd;
  ∃ f s outer pre middle fs ss run tx2,
    AspisR1.P2P_Origin.Fact
        (AspisR1.ClaimsUnrolledSdk.sdkOps
          (AspisR1.Tx2I_Install.install adapterOps
            (AspisR1.Op5T_Concrete.stage
              (AspisR1.Tx2N_Execution.control (AspisR1.AuS1_Install.base stageBase) reserved queryOps geoOps))
            finishOps)
          (AspisR1.Uni_Install.current ops reserved queryOps geoOps) (AspisR1.F3M_CircleSource.install B) claimsStd)
        program (e2.second AspisR1.S2W_D189Wrappers.secondSizes) data2 slot s ∧
      AspisR1.FIs_Native.Calls (AspisR1.AuS1_Install.base stageBase) finishOps reserved queryOps geoOps
          (AdapterRw.SolanaDigest.Insts.Aspis_coreDigestDigest32
            (AspisR1.ClaimsUnrolledSdk.sdkOps
              (AspisR1.Tx2I_Install.install adapterOps
                (AspisR1.Op5T_Concrete.stage
                  (AspisR1.Tx2N_Execution.control (AspisR1.AuS1_Install.base stageBase) reserved queryOps geoOps))
                finishOps)
              (AspisR1.Uni_Install.current ops reserved queryOps geoOps) (AspisR1.F3M_CircleSource.install B)
              claimsStd))
          () s.pub s.proof s.checkpoint tx2 ∧
        AspisR1.Cons_Base.Outcome L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps stageBase finishOps
            (AspisR1.F3M_CircleSource.install B) claimsStd program data1 data2 slot saved post1 post2 H f s outer pre
            middle fs ss run ∧
          AdapterRw.aspis_statement.pool_v1.pair_forest_terminal.PoolV1PairForestTerminalStatementV1.semantic_public
                f.statement =
              Aeneas.Std.Result.ok f.semantic ∧
            AspisR1.T2R_Public.Facts f.pub f.proof ∧
              AspisR1.SAF_C_SAP_ActualCaller.Outcome L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps stageBase
                finishOps B claimsStd program data1 data2 slot saved post1 post2 H f s outer pre middle fs ss run prior
                tx2
