def Aeneas.Std.alloc.vec.Vec.extend_from_slice : {T : Type} →
  core.clone.Clone T → alloc.vec.Vec T → Slice T → Result (alloc.vec.Vec T) :=
fun {T} cloneInst v s =>
  if h : v.length + s.length ≤ Usize.max then
    match h' : Slice.clone cloneInst.clone s with
    | ok s' => ok ⟨↑v ++ ↑s', ⋯⟩
    | fail e => fail e
    | div => div
  else fail Error.panic
def Aeneas.Std.Slice.clone : {T : Type} → (T → Result T) → Slice T → Result (Slice T) :=
fun {T} clone s => do
  let s' ← List.clone clone ↑s
  ok ⟨↑s', ⋯⟩
