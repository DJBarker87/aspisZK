theorem NLP_C04Trees.packet : ∀ (H : Bytes → State) (wr rr : NP6_StdModel.Reservation) (merkle : Merkle)
  (finish : Finish) {X : Type} (d : aspis_core.digest.Digest32 X) (pub proof ck : Slice U8) (hash : X),
  (↑proof).length = 57607 →
    NLP_InputDomain.Root0 ck proof →
      ∀ (pr : Slice U8) (p : verifier.Prepared) (folded : Std.Array U8 32#usize) (reply : R Unit),
        Event.merkle pr p folded reply ∈ (run wr rr (fun {H} => merkle) finish d pub proof ck hash none).events →
          ∀ (kind : Usize) (hk : ↑kind < 3),
            NLN.TreePacket H pr (NLP_RootCodec.parsed pr (Port3_BatchStage.root1 p)) p.queries
              (Port3_NativeBatchCalls.rootAt (NLL_BatchSource.roots p folded) ⟨↑kind, hk⟩) 1#usize kind :=
⋯
'NLP_C04Trees.packet' depends on axioms: [propext, Classical.choice, Quot.sound]
