theorem NLP_RootDomain.mismatch : ∀ (proof : Slice U8) (p : verifier.Prepared) (folded : Std.Array U8 32#usize),
  Port3_BatchStage.root0 p ≠
      encodeState
        ((SemanticRecordCodec.decodeState
              (OraclePortCompactDraft.slice (MultiproofConeCanonical.bytesOf ↑proof) 16 32)).getD
          fun x => 0) →
    ¬∃ parsed,
        parsed.wire = MultiproofConeCanonical.bytesOf ↑proof ∧
          ∀ (k : Fin 3),
            Port3_NativeBatchCalls.rootAt (NLL_BatchSource.roots p folded) k =
              encodeState (OraclePortBatchDraft.committedRoot parsed ↑k) :=
fun proof p folded different a =>
  let ⟨parsed, h✝⟩ := a
  let ⟨wire, roots⟩ := h✝
  different (necessary proof parsed wire p folded roots)
