theorem NLP_C04Chronology.at_actual : ∀ (H : Bytes → State) (wr rr : NP6_StdModel.Reservation) (finish : Finish)
  {X : Type} (d : aspis_core.digest.Digest32 X) (pub proof ck : Slice U8) (hash : X),
  (↑proof).length = 57607 →
    NLP_InputDomain.Root0 ck proof →
      ∀ (history : NLL.History),
        Native H (run wr rr (fun {H_1} => NLP_NativeMerkle.action H) finish d pub proof ck hash none).events history →
          NLP_EffectOrder.expand (atEvent H)
              (run wr rr (fun {H_1} => NLP_NativeMerkle.action H) finish d pub proof ck hash none).events =
            history :=
⋯
