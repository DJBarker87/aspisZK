NLP_C04Chronology.Native.skip : ∀ {H : Bytes → State} (e : Event),
  (∀ (pr : Slice U8) (p : verifier.Prepared) (folded : Std.Array U8 32#usize) (reply : R Unit),
      e ≠ Event.merkle pr p folded reply) →
