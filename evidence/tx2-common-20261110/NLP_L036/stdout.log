NLP_C04Chronology.Native.merkle : ∀ {H : Bytes → State} (pr : Slice U8) (p : verifier.Prepared)
  (folded : Std.Array U8 32#usize) (reply : R Unit) (inside : NLL.History) (out : NLL.Reply),
  NLL_BatchSource.Invocation H pr p folded 1#usize inside out →
