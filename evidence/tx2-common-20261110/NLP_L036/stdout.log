theorem NLP_C04Chronology.fold : ∀ (H : Bytes → State) (events : List Event),
  (∀ e ∈ events, NLP_C04All.Clause H e) →
    ∀ (history : NLL.History), Native H events history → NLP_EffectOrder.expand (atEvent H) events = history :=
