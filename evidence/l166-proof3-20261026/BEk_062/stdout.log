theorem AspisR1.SdkC_Oracle.accepted_exact : ∀
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  AspisR1.S2W_ExtractionBoundary.P1 sha256 H →
    AspisR1.S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
      ∀ {A : Type} (code : AspisR1.SdkC_Source.Code A) (value : A),
        (AspisR1.SdkC_Source.run hashv code []).1 = Aeneas.Std.Result.ok value →
          AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.SdkC_Oracle.program code) =
            (AspisR1.SdkC_Source.readLog (AspisR1.SdkC_Source.run hashv code []).2, Aeneas.Std.Result.ok value) :=
⋯
'AspisR1.SdkC_Oracle.accepted_exact' depends on axioms: [propext, Classical.choice, Quot.sound]
