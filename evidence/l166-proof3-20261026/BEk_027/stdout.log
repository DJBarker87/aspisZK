theorem AspisR1.S2W_ExtractionBoundary.native_first_fields : ∀ (ops : AdapterRw.Ops)
  (native1 : AspisR1.S2W_ExtractionBoundary.First) (native2 : AspisR1.S2W_ExtractionBoundary.Second)
  (hashv : AspisR1.S2Z.Oracle.Parts → Aeneas.Std.Result AspisR1.S2Z.Oracle.Digest),
  AspisR1.S2W_ExtractionBoundary.AeneasExtraction ops native1 native2 hashv →
    ∀ (program : AspisR1.S2W_ExtractionBoundary.Program) (accounts : AspisR1.S2W_ExtractionBoundary.Accounts)
      (data : Aeneas.Std.Slice Aeneas.Std.U8) (checkpoint : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8),
      native1 program accounts data = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok checkpoint) →
        ∃ proofAccount publicAccount publicInput raw statement semantic proof split,
          Aeneas.Std.Slice.index_usize accounts 0#usize = Aeneas.Std.Result.ok proofAccount ∧
            Aeneas.Std.Slice.index_usize accounts 1#usize = Aeneas.Std.Result.ok publicAccount ∧
              AdapterRw.r1_pool_adapter.owned.OwnedAccount.data ops proofAccount =
                  Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok raw) ∧
                AdapterRw.r1_pool_adapter.owned.OwnedAccount.data ops publicAccount =
                    Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok publicInput) ∧
                  ops.op47 publicInput = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok statement) ∧
                    AdapterRw.first_decoded ops semantic publicInput proof split =
                        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok checkpoint) ∧
                      List.length (AspisR1.MultiproofConeCanonical.bytesOf ↑proof) = 57607 ∧
                        AspisR1.MultiproofConeCanonical.bytesOf ↑raw =
                          List.take 688 (AspisR1.MultiproofConeCanonical.bytesOf ↑raw) ++
                            AspisR1.MultiproofConeCanonical.bytesOf ↑proof :=
⋯
'AspisR1.S2W_ExtractionBoundary.native_first_fields' depends on axioms: [propext, Classical.choice, Quot.sound]
