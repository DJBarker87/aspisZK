def AspisR1.ARS_QueryTransport.Agrees : (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
  AspisR1.SdkC_Source.Log → Prop :=
fun H log =>
  ∀ q ∈ log,
    ∀ (digest : AspisR1.SdkC_Source.Digest),
      q.returned = Aeneas.Std.Result.ok digest →
        AspisV8R19.SqueezeOracleBridge.decodeState digest = H (AspisV8R19.SqueezeOracleBridge.flatten q.parts)
'AspisR1.ARS_QueryTransport.Agrees' depends on axioms: [propext, Classical.choice, Quot.sound]
