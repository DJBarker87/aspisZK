def AspisR1.BEh_Scope.RejectedPrefix : {S A E F : Type} →
  AspisR1.BEh_Scope.Outcome S A E → AspisR1.BEh_Scope.Outcome S A F → Prop :=
fun {S A E F} native source =>
  (AspisR1.BEg_Observation.accepted native.1 = Option.none ↔ AspisR1.BEg_Observation.accepted source.1 = Option.none) ∧
    (AspisR1.BEg_Observation.accepted native.1 = Option.none → native.2.2 = source.2.2)
'AspisR1.BEh_Scope.RejectedPrefix' depends on axioms: [propext, Classical.choice, Quot.sound]
