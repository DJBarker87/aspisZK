'AspisR1.NKQ_MaskCuts.arguments' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NKQ_MaskCuts.arguments : ∀ (native : Native),
  LowCut native →
    HighCut native →
      BlindCut native →
        AlphaCut native →
          FrameCut native →
            ∀ (c : Claims) (a : Alpha) (i : ℕ) (reply : Q),
              CanonClaims c →
                CanonAlpha a →
                  Canon reply →
                    ∀ (inside : i < 16),
                      have p := native c a i reply;
                      p.calls = 1 ∧
                        p.result = reply ∧
                          p.low = low c i inside ∧
                            p.high = high c i ∧
                              p.blind = blind c ∧ p.alpha = alpha a i ∧ p.claimsAfter = c ∧ p.alphaAfter = a :=
fun native lo hi bl al fr c a i reply cc ca cr inside =>
  have l := lo c a i reply cc ca cr inside;
  have h := hi c a i reply cc ca cr inside;
  have b := bl c a i reply cc ca cr inside;
  have v := al c a i reply cc ca cr inside;
  have claims :=
    extensional (native c a i reply).claimsAfter c fun row hr =>
      extensional (cell (native c a i reply).claimsAfter row hr) (cell c row hr) fun col hc =>
        (fr c a i reply cc ca cr inside row hr col hc 0 (of_decide_eq_true (id (Eq.refl true)))).left;
  have alph :=
    extensional (native c a i reply).alphaAfter a fun index bound =>
      (fr c a i reply cc ca cr inside 0 (of_decide_eq_true (id (Eq.refl true))) 0
            (of_decide_eq_true (id (Eq.refl true))) index bound).right.left;
  ⟨l.left, ⟨l.right.left, ⟨l.right.right, ⟨h.right.right, ⟨b.right.right, ⟨v.right.right, ⟨claims, alph⟩⟩⟩⟩⟩⟩⟩
