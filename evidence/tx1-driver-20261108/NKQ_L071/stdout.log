theorem AspisR1.NKQ_RecordDomains.entered : ∀ (bytes : Aeneas.Std.Slice Aeneas.Std.U8)
  (pre : AspisR1PrefixAggregateParser.r1_wire.Prefix),
  AspisR1PrefixAggregateParser.r1_wire.Prefix.parse bytes =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok pre) →
    ∀ (row : Aeneas.Std.U8) (N off : Aeneas.Std.Usize),
      ↑row < 27 →
        14 ≤ ↑row →
          NGO_CallerDomains.Call ↑row ↑N ↑off →
            ∃ record,
              (AspisR1PublicPreparation.PrefixAdapter.fromOld pre).validated_record row =
                  Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok record) ∧
                record.row = row ∧ AspisR1.NKQ_RecordDomains.Ready record N off :=
fun bytes pre parsed row N off live fields call =>
  let idx := ⟨↑row, live⟩;
  let frame := AspisR1.FJb_TailCell.cell pre.records idx;
  have recordLength := pre.records.property;
  have rowLength := rfl;
  have pairMember :=
    have bound :=
      Eq.mpr (id (congrArg (LT.lt ↑row) (Eq.trans List.length_zip (congr (congrArg min rowLength) recordLength)))) live;
    have mem := List.mem_of_getElem List.getElem_zip;
    have selected :=
      Aeneas.Std.UScalar.eq_of_val_eq
        (have mapped :=
          of_eq_true
            (Eq.trans
              (congrFun'
                (congrArg Eq
                  (Eq.trans
                    (GetElem.getElem.congr_simp (List.map Aeneas.Std.UScalar.val AspisR1.ExtractedPrefixTrace.rowOrder)
                      (List.range 27) AspisR1.ExtractedPrefixTypedFull.rowOrder_values (↑row) (↑row) (Eq.refl ↑row)
                      (Eq.mpr (id (congrArg (LT.lt ↑row) (Eq.trans (List.length_map Aeneas.Std.UScalar.val) rowLength)))
                        live))
                    (List.getElem_range
                      (AspisR1.ExtractedPrefixTypedFull.rowOrder_values ▸
                        Eq.refl ↑row ▸
                          Eq.mpr
                            (id (congrArg (LT.lt ↑row) (Eq.trans (List.length_map Aeneas.Std.UScalar.val) rowLength)))
                            live))))
                ↑row)
              (eq_self ↑row));
        Eq.mp (congrFun' (congrArg Eq (List.getElem_map Aeneas.Std.UScalar.val)) ↑row) mapped);
    Eq.mpr
      (id
        (congrArg (Membership.mem (AspisR1.ExtractedPrefixTrace.rowOrder.zip ↑pre.records))
          (congrArg (Prod.mk row) (AspisR1.FJb_TailCell.cell.eq_1 pre.records idx))))
      (Eq.mp
        (congrArg (Membership.mem (AspisR1.ExtractedPrefixTrace.rowOrder.zip ↑pre.records))
          (congrFun' (congrArg Prod.mk selected) (↑pre.records)[↑row]))
        mem);
  let ⟨payload, recordParsed⟩ :=
    AspisR1.ExtractedPrefixParse.parse_record_of_success bytes pre parsed row frame pairMember
  have strict := AspisR1.NJT_QClaimsCanonical.strict_frame row frame payload fields recordParsed;
  let ⟨record, h✝⟩ := AspisR1.NIX_ProducerInstall.lookup pre row live
  let ⟨getter, right✝⟩ := h✝
  let ⟨tag, same⟩ := right✝
  have geometry :=
    Eq.mpr (id (congrArg (fun _a => (↑record.framed).length = 5 + NFU_PacketDomains.payloadSize ↑_a) tag))
      (Eq.mpr (id (congrArg (fun _a => (↑_a).length = 5 + NFU_PacketDomains.payloadSize ↑row) same))
        (AspisR1.NIX_PredecessorFrames.aggregate bytes pre parsed idx));
  Exists.intro record
    ⟨getter,
      ⟨tag,
        ⟨Eq.mpr (id (congrArg (fun _a => NGO_CallerDomains.Call ↑_a ↑N ↑off) tag)) call,
          ⟨geometry,
            Eq.mpr
              (id
                (congrArg
                  (fun _a =>
                    ∀
                      chunk ∈
                        (Aeneas.Std.List.toChunksExact 32 AspisR1.NKQ_RecordDomains.Ready._proof_1 (List.drop 5 ↑_a)).1,
                      AspisR1.ExtractedPrefixStrictPayload.StrictLowChunk chunk)
                  same))
              (Eq.mpr (pi_congr fun a => propext Iff.rfl) strict)⟩⟩⟩⟩
'AspisR1.NKQ_StrictDecode.total' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NKQ_StrictDecode.total : ∀ (N off : Aeneas.Std.Usize)
  (record : AspisR1PublicPreparation.RawActualDecodeKMainAdapter.MainRecord),
  NGO_CallerDomains.Call ↑record.row ↑N ↑off →
    (↑record.framed).length = 5 + NFU_PacketDomains.payloadSize ↑record.row →
      (∀ chunk ∈ (Aeneas.Std.List.toChunksExact 32 ⋯ (List.drop 5 ↑record.framed)).1,
          AspisR1.ExtractedPrefixStrictPayload.StrictLowChunk chunk) →
        ∃ out,
          AspisR1PublicPreparation.RawActualDecodeKMainAdapter.decodeMain N record off =
              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok out) ∧
            AspisR1.NKQ_DecodeCanonical.MainRowCanon out :=
fun N off record call geometry strict =>
  let ⟨start, h✝⟩ := NGO_DecodeComposed.result N off record call geometry
  let ⟨d, h✝¹⟩ := h✝
  let ⟨window, h✝²⟩ := h✝¹
  let ⟨ce, h✝³⟩ := h✝²
  let ⟨final, h✝⁴⟩ := h✝³
  let ⟨same, right✝⟩ := h✝⁴
  let ⟨chunks, right✝¹⟩ := right✝
  let ⟨native, right✝²⟩ := right✝¹
  let ⟨run, right✝³⟩ := right✝²
  let ⟨halt, h✝⁵⟩ := right✝³
  let ⟨bound, right✝⁴⟩ := h✝⁵
  let ⟨terminal, rest⟩ := right✝⁴
  Or.casesOn terminal
    (fun h =>
      let ⟨finished, right✝⁵⟩ := h
      have decoded :=
        Eq.mp
          (congrArg (Eq (AspisR1PublicPreparation.RawActualDecodeKMainAdapter.decodeMain N record off))
            (congrArg
              (fun x =>
                match
                  Aeneas.Std.Result.ok
                    (match x with
                    | none => Aeneas.Std.core.result.Result.Ok final.1
                    | some reply => reply) with
                | Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok a) =>
                  Aeneas.Std.Result.ok
                    (Aeneas.Std.core.result.Result.Ok
                      (AspisR1PublicPreparation.RawActualDecodeKMainAdapter.decoderArrayToMain a))
                | Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err e) =>
                  Aeneas.Std.Result.ok
                    (Aeneas.Std.core.result.Result.Err
                      (AspisR1PublicPreparation.RawActualDecodeKMainAdapter.decoderErrorToMain e))
                | Aeneas.Std.Result.fail e => Aeneas.Std.Result.fail e
                | Aeneas.Std.Result.div => Aeneas.Std.Result.div)
              finished))
          run;
      Exists.intro (AspisR1PublicPreparation.RawActualDecodeKMainAdapter.decoderArrayToMain final.1)
        ⟨decoded,
          AspisR1.NKQ_DecodeCanonical.main record off
            (AspisR1PublicPreparation.RawActualDecodeKMainAdapter.decoderArrayToMain final.1) decoded⟩)
    fun h =>
    let ⟨index, h✝⁶⟩ := h
    let ⟨active, h✝⁷⟩ := h✝⁶
    let ⟨error, h✝⁸⟩ := h✝⁷
    let ⟨left✝, right✝⁶⟩ := h✝⁸
    let ⟨failed, reply⟩ := right✝⁶
    let ⟨q, good⟩ := AspisR1.NJT_QClaimsLow.answer d strict index active
    let ⟨⟩ := Aeneas.Std.core.result.Result.Err error
    Eq.mp (congrArg (fun _a => _a = Aeneas.Std.core.result.Result.Err error) good) reply
