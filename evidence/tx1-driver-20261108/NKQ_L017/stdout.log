'AspisR1.NKQ_PrepareStages.factor' depends on axioms: [propext, Classical.choice, Quot.sound]
'AspisR1.NKQ_PrepareStages.semantic_error' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NKQ_PrepareStages.factor : ∀ (ops : Ops) {H : Type} (D : aspis_core.digest.Digest32 H)
  (pub : aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public) (hash : H) (g : Scratch) (v : verifier.View),
  NHL_PrepareStages.semanticCut ops D pub hash none g v = do
    let r ← ops.op9 D pub v.semantic hash none
    afterSemantic ops D hash g v r :=
fun ops {H} D pub hash g v => Eq.refl (NHL_PrepareStages.semanticCut ops D pub hash none g v)
