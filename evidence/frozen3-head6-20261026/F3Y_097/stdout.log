def AspisR1.Rc5_Result.Outcome : {W F CoreError : Type} →
  AspisR1.S2Trust.Library W (ℕ → AspisR1.S2W_D189Entry.Record) →
    AspisR1.S2W_D189Entry.Entry →
      AspisR1.S2W_D189Entry.Entry →
        W →
          W →
            AdapterRw.Ops →
              AspisR1CurrentCaller.Ops →
                Bool →
                  AspisR1.Port3_NativeQueryBody.Ops →
                    AspisR1.Port3_NativeGeometryBody.Ops CoreError →
                      VTop_Stages.Ops →
                        AspisR1Stage2.Stage2Finish.FinishOps F →
                          AspisR1PublicPreparation.FinishModel.Boundaries →
                            AspisR1.NP6_StdModel.Reservation →
                              AspisR1.S2W_ExtractionBoundary.Program →
                                Aeneas.Std.Slice Aeneas.Std.U8 →
                                  Aeneas.Std.Slice Aeneas.Std.U8 →
                                    AspisR1.S2W_ExtractionBoundary.Slot →
                                      Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8 →
                                        AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
                                          AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
                                            (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
                                              (AspisR1.OraclePortStoredExperimentC4.Input →
                                                  AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes
                                                    AspisV8R19.SourceDuplexStep.State Bool) →
                                                AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes
                                                    AspisV8R19.SourceDuplexStep.State Unit →
                                                  List AspisR1.S2X.AccountEvent → Prop :=
fun {W F CoreError} L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps stageBase finishOps B reservation program
    data1 data2 slot saved post1 post2 H driver prior events =>
  have port :=
    AspisR1.SdkD_Child.port adapterOps (AspisR1.Uni_Install.current ops reserved queryOps geoOps)
      (AspisR1.Op5T_Concrete.stage
        (AspisR1.Tx2N_Execution.control (AspisR1.AuS1_Install.base stageBase) reserved queryOps geoOps))
      finishOps (AspisR1.F3M_CircleSource.install B) (AspisR1.NP6_StdModel.calls reservation);
  ∃ f s outer pre middle fs ss run tx2,
    AspisR1.Cons_Native.Calls (AspisR1.AuS1_Install.base stageBase) finishOps reserved queryOps geoOps
        (AdapterRw.SolanaDigest.Insts.Aspis_coreDigestDigest32
          (AspisR1.ClaimsUnrolledSdk.sdkOps
            (AspisR1.Tx2I_Install.install adapterOps
              (AspisR1.Op5T_Concrete.stage
                (AspisR1.Tx2N_Execution.control (AspisR1.AuS1_Install.base stageBase) reserved queryOps geoOps))
              finishOps)
            (AspisR1.Uni_Install.current ops reserved queryOps geoOps) (AspisR1.F3M_CircleSource.install B)
            (AspisR1.NP6_StdModel.calls reservation)))
        () s.pub s.proof s.checkpoint tx2 ∧
      AspisR1.TxS_Encoding.Facts run H ∧
        AspisR1.Rc2_Base.Outcome L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps stageBase finishOps
            (AspisR1.F3M_CircleSource.install B) reservation program data1 data2 slot saved post1 post2 H f s outer pre
            middle fs ss run ∧
          AspisR1.NP6_Constructors.Contents run.initial run.pending ∧
            AdapterRw.aspis_statement.pool_v1.pair_forest_terminal.PoolV1PairForestTerminalStatementV1.semantic_public
                  f.statement =
                Aeneas.Std.Result.ok f.semantic ∧
              AspisR1.TxS_RawPublic.Facts f.pub f.proof ∧
                AspisR1.T2R_Parser.Facts f.proof ∧
                  ∃ version,
                    version.key = (e1.handles 2).1 ∧
                      version.key = (e2.handles 6).1 ∧
                        version.events = events ∧
                          AspisR1.MultiproofConeCanonical.bytesOf ↑s.checkpoint =
                              AspisR1.S2W_EntryWriteHistory.payloadBytes AspisR1.S2W_ReturnedCheckpoint.encode
                                (post1.payload (e1.heap.accounts 2).1) 1768 ∧
                            AspisR1.CPP_Acceptance.Facts driver H f.pub f.proof s.pub s.proof s.checkpoint
                                (AspisR1.S2W_EntryWriteHistory.payloadBytes AspisR1.S2W_ReturnedCheckpoint.encode
                                  (post1.payload (e1.heap.accounts 2).1) 1768) ∧
                              AspisR1.Rc5_Nonvacuity.Facts driver H f.pub f.proof s.pub s.proof s.checkpoint
                                  (AspisR1.S2W_EntryWriteHistory.payloadBytes AspisR1.S2W_ReturnedCheckpoint.encode
                                    (post1.payload (e1.heap.accounts 2).1) 1768) ∧
                                AspisR1.Rc5_Caller.Outcome L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps
                                  stageBase finishOps B (AspisR1.NP6_StdModel.calls reservation) program data1 data2
                                  slot saved post1 post2 H f s outer pre middle fs ss run prior tx2
