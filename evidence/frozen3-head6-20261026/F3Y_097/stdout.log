  (prior : AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State Unit)
  (events : List AspisR1.S2X.AccountEvent),
  AspisR1.Rc5_Result.Outcome L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps stageBase finishOps B reservation
      program data1 data2 slot saved post1 post2 H driver prior events →
