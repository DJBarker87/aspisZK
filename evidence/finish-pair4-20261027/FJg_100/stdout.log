  let ⟨hhigh, right✝⁷⟩ := right✝⁶
  let ⟨hstatus, right✝⁸⟩ := right✝⁷
  let ⟨hl, right✝⁹⟩ := right✝⁸
  let ⟨hi, right✝¹⁰⟩ := right✝⁹
  let ⟨hu, right✝¹¹⟩ := right✝¹⁰
  let ⟨hlib, right✝¹²⟩ := right✝¹¹
  let ⟨hk, hsum⟩ := right✝¹²
