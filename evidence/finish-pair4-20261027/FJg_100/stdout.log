  let ⟨highParts, h✝¹⁵⟩ := h✝¹⁴
  let ⟨lowParts, h✝¹⁶⟩ := h✝¹⁵
  let ⟨parts, h✝¹⁷⟩ := h✝¹⁶
  let ⟨k, h✝¹⁸⟩ := h✝¹⁷
  let ⟨low, h✝¹⁹⟩ := h✝¹⁸
  let ⟨inactive, h✝²⁰⟩ := h✝¹⁹
  let ⟨libra, h✝²¹⟩ := h✝²⁰
