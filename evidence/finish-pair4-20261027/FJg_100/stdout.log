            AspisR1.FIo_Install.pair r w alpha f kappa = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok out) →
              ∃ nativeOut a0 a1 ap0 ap1 common partials row coeff low0 low1 low parts k,
                (AspisR1.FIo_Install.toWeights w).pair (AspisR1.FIo_Install.toSlice alpha) f
                      (AspisR1.FIo_Install.toE kappa) =
                    Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok nativeOut) ∧
                  AspisR1.FIo_Install.fromE nativeOut = out ∧
                    (AspisR1.FIo_Install.toSlice alpha).index_usize 0#usize = Aeneas.Std.Result.ok a0 ∧
                      (AspisR1.FIo_Install.toSlice alpha).index_usize 1#usize = Aeneas.Std.Result.ok a1 ∧
                        FIo_Native.weights.powers 4#usize a0 = Aeneas.Std.Result.ok ap0 ∧
                          FIo_Native.weights.powers 4#usize a1 = Aeneas.Std.Result.ok ap1 ∧
