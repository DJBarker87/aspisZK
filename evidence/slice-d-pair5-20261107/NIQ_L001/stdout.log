                            AspisR1.Port3_NativeFinishBody.verifier.finish_relation ops v p a obs =
                              NHT_FinishRun.run (NHT_FinishNewPacket.installed ops newPacket) v p a obs
                                (NHQ_WeightPort.weights a.weights.deref) pair alpha0 alpha1 :=
fun {W} ops r v p a obs alpha0 alpha1 index0 index1 ca0 ca1 folds native_round0 native_round1 accumulator native_dot
    newPacket NHM_new pair NHM_pair =>
  NHT_FinishComplete.source ops r v p a obs alpha0 alpha1 index0 index1 ca0 ca1 folds native_round0
    (fun claim returned => native_round1 claim (NHT_RoundOutput.canonical v.round0 alpha0 p.claim claim ca0 returned))
    (NHQ_WeightPort.weights a.weights.deref) (NHQ_FinishFrames.dot_width a accumulator)
    (Eq.symm (NHQ_WeightPort.same a.weights.deref)) native_dot newPacket NHM_new pair NHM_pair
