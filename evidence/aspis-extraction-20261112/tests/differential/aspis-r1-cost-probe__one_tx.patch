+/// Differential test of `parse_packed_shape` against its frozen body (commit 3d700effcabe, one_tx.rs 861-870). The
+/// frozen body is kept verbatim; adapted only by its name and by dropping `pub` and `#[inline(never)]`.
+#[cfg(test)]
+mod differential_parse_packed_shape {
+    extern crate std;
+    use super::*;
+    use alloc::vec::Vec;
+
+    fn frozen_parse_packed_shape(proof: &[u8]) -> Result<(), Error> {
+        if proof.len() != format::PROOF_BYTES
+            || &proof[..8] != format::MAGIC
+            || proof[8] != Variant::S2.tag()
+            || proof[9..16].iter().any(|&x| x != 0)
+        {
+            return Err(Error::Parse);
+        }
+        Ok(())
+    }
+
+    /// splitmix64 with a fixed seed.
+    struct Rng(u64);
+    impl Rng {
+        fn next(&mut self) -> u64 {
+            self.0 = self.0.wrapping_add(0x9e37_79b9_7f4a_7c15);
+            let mut z = self.0;
+            z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+            z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+            z ^ (z >> 31)
+        }
+        fn bytes(&mut self, n: usize) -> Vec<u8> {
+            (0..n).map(|_| self.next() as u8).collect()
+        }
+    }
+
+    #[test]
+    fn same_result_as_frozen_body() {
+        let start = std::time::Instant::now();
+        let mut rng = Rng(0x9ac4_0000_0000_000e);
+        // [Ok, Parse]
+        let mut seen = [0usize; 2];
+        let mut cases = 0usize;
+        let check = |proof: &[u8], seen: &mut [usize; 2]| {
+            let new = parse_packed_shape(proof);
+            assert_eq!(new, frozen_parse_packed_shape(proof), "length {} header {:?}", proof.len(), &proof[..proof.len().min(16)]);
+            seen[usize::from(new.is_err())] += 1;
+        };
+        let mut proof = rng.bytes(compact::PROOF_BYTES.max(format::PROOF_BYTES + 1));
+        proof[..8].copy_from_slice(&format::MAGIC[..]);
+        proof[8] = Variant::S2.tag();
+        proof[9..16].fill(0);
+        // Every length from 0 to 17, one short, exact and one long, and the two-transaction (compact) length.
+        for length in (0..=17).chain([format::PROOF_BYTES - 1, format::PROOF_BYTES, format::PROOF_BYTES + 1, compact::PROOF_BYTES]) {
+            check(&proof[..length], &mut seen);
+            cases += 1;
+        }
+        // Every value of every header byte, at the exact length.
+        for position in 0..16 {
+            for value in 0..=255u8 {
+                let mut p = proof[..format::PROOF_BYTES].to_vec();
+                p[position] = value;
+                check(&p, &mut seen);
+                cases += 1;
+            }
+        }
+        // Random headers: valid magic and tag, tail bytes zero or with up to three random bytes.
+        for n in 0..20_000 {
+            let mut p = proof[..format::PROOF_BYTES].to_vec();
+            for _ in 0..(n % 4) {
+                p[9 + (rng.next() % 7) as usize] = rng.next() as u8;
+            }
+            if n % 5 == 0 {
+                p[(rng.next() % 9) as usize] = rng.next() as u8;
+            }
+            check(&p, &mut seen);
+            cases += 1;
+        }
+        assert_eq!(cases, 22 + 16 * 256 + 20_000);
+        assert!(seen[0] > 1_000 && seen[1] > 1_000, "{seen:?}");
+        std::println!(
+            "differential_parse_packed_shape: {cases} cases (Ok {}, Parse {}), {} ms",
+            seen[0],
+            seen[1],
+            start.elapsed().as_millis()
+        );
+    }
+}
