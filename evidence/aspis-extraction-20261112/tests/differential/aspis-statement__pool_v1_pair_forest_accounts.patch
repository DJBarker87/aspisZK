+/// Differential test of `decode_pool_v1_pair_forest_lane_state_v1` against its frozen body (commit 3d700effcabe,
+/// pair_forest_accounts.rs 335-380). The frozen body is kept verbatim; adapted only by its name and by dropping
+/// `pub`. Both bodies call the shipped `IncrementalMerkleTreeV1::decode_with_empty_roots` (which has its own
+/// differential test in incremental_merkle.rs).
+#[cfg(test)]
+mod differential_decode_pool_v1_pair_forest_lane_state_v1 {
+    extern crate std;
+    use super::*;
+    use crate::pool_v1::{pool_v1_empty_roots, pool_v1_tree_parent};
+    use aspis_core::field::M31;
+
+    fn frozen_decode_pool_v1_pair_forest_lane_state_v1(
+        bytes: &[u8],
+        pair_empty_roots: &[Digest; POOL_V1_TREE_DEPTH + 1],
+    ) -> Result<PoolV1PairForestLaneStateV1, PoolV1PairForestAccountErrorV1> {
+        if bytes.len() != POOL_V1_PAIR_FOREST_LANE_ACCOUNT_BYTES {
+            return Err(PoolV1PairForestAccountErrorV1::WrongLength);
+        }
+        if bytes[..4] != POOL_V1_PAIR_FOREST_LANE_MAGIC {
+            return Err(PoolV1PairForestAccountErrorV1::WrongMagic);
+        }
+        if bytes[4] != POOL_V1_PAIR_FOREST_LANE_VERSION {
+            return Err(PoolV1PairForestAccountErrorV1::WrongVersion);
+        }
+        if usize::from(bytes[5]) >= POOL_V1_PAIR_FOREST_LANE_COUNT {
+            return Err(PoolV1PairForestAccountErrorV1::InvalidLane);
+        }
+        if bytes[6] != POOL_V1_PAIR_FOREST_LANE_COUNT as u8 {
+            return Err(PoolV1PairForestAccountErrorV1::WrongLaneCount);
+        }
+        if bytes[7] != POOL_V1_TREE_DEPTH as u8 {
+            return Err(PoolV1PairForestAccountErrorV1::WrongDepth);
+        }
+        if bytes[8..40] != POOL_V1_PAIR_FOREST_ACCOUNT_FORMAT_BINDING {
+            return Err(PoolV1PairForestAccountErrorV1::WrongFormatBinding);
+        }
+        let master: [u8; 32] = bytes[LANE_MASTER_OFFSET..72].try_into().unwrap();
+        if master == [0u8; 32] {
+            return Err(PoolV1PairForestAccountErrorV1::ZeroRequiredBinding);
+        }
+        if bytes[73..LANE_TREE_OFFSET].iter().any(|byte| *byte != 0) {
+            return Err(PoolV1PairForestAccountErrorV1::NonZeroReserved);
+        }
+        let tree = IncrementalMerkleTreeV1::decode_with_empty_roots(
+            &bytes[LANE_TREE_OFFSET..],
+            pair_empty_roots,
+        )?;
+        if tree.next_leaf_index > POOL_V1_PAIR_CAPACITY {
+            return Err(PoolV1PairForestAccountErrorV1::InvalidMasterState);
+        }
+        Ok(PoolV1PairForestLaneStateV1 {
+            bump: bytes[72],
+            master,
+            lane_id: bytes[5],
+            tree,
+        })
+    }
+
+    /// splitmix64 with a fixed seed.
+    struct Rng(u64);
+    impl Rng {
+        fn next(&mut self) -> u64 {
+            self.0 = self.0.wrapping_add(0x9e37_79b9_7f4a_7c15);
+            let mut z = self.0;
+            z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+            z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+            z ^ (z >> 31)
+        }
+        fn byte(&mut self) -> u8 {
+            self.next() as u8
+        }
+        /// A canonical digest limb: 0, 1, 2, p - 2 or p - 1 with probability 3/8, otherwise uniform below p.
+        fn canonical(&mut self) -> M31 {
+            M31(match self.next() % 8 {
+                0 => 0,
+                1 => 1,
+                2 => [2, P - 2, P - 1][(self.next() % 3) as usize],
+                _ => (self.next() % u64::from(P)) as u32,
+            })
+        }
+        fn digest(&mut self) -> Digest {
+            core::array::from_fn(|_| self.canonical())
+        }
+        /// A lane sequence: an edge (0, 1, capacity - 1, capacity, capacity + 1, u64::MAX - 1, u64::MAX), uniform up
+        /// to the capacity, or any u64.
+        fn sequence(&mut self) -> u64 {
+            const EDGES: [u64; 7] = [
+                0,
+                1,
+                POOL_V1_PAIR_CAPACITY - 1,
+                POOL_V1_PAIR_CAPACITY,
+                POOL_V1_PAIR_CAPACITY + 1,
+                u64::MAX - 1,
+                u64::MAX,
+            ];
+            match self.next() % 8 {
+                0 | 1 => EDGES[(self.next() % 7) as usize],
+                2 => self.next(),
+                _ => self.next() % (POOL_V1_PAIR_CAPACITY + 1),
+            }
+        }
+    }
+
+    fn error_index(error: PoolV1PairForestAccountErrorV1) -> usize {
+        use PoolV1PairForestAccountErrorV1 as A;
+        match error {
+            A::WrongLength => 1,
+            A::WrongMagic => 2,
+            A::WrongVersion => 3,
+            A::WrongLaneCount => 4,
+            A::WrongDigestEncoding => 5,
+            A::WrongDepth => 6,
+            A::WrongFormatBinding => 7,
+            A::NonZeroReserved => 8,
+            A::ZeroRequiredBinding => 9,
+            A::InvalidBoolean => 10,
+            A::InvalidMasterState => 11,
+            A::InvalidLane => 12,
+            A::LaneMasterMismatch => 13,
+            A::LaneOrderMismatch => 14,
+            A::LaneSequenceDecreased => 15,
+            A::DuplicateCheckpoint => 16,
+            A::CheckpointSequenceOverflow => 17,
+            A::NonCanonicalDigest => 18,
+            A::Identity => 19,
+            A::Policy => 20,
+            A::Tree(_) => 21,
+        }
+    }
+
+    /// Outcome names in the order of `error_index` (0 = accepted).
+    const OUTCOMES: [&str; 22] = [
+        "Ok", "WrongLength", "WrongMagic", "WrongVersion", "WrongLaneCount", "WrongDigestEncoding", "WrongDepth",
+        "WrongFormatBinding", "NonZeroReserved", "ZeroRequiredBinding", "InvalidBoolean", "InvalidMasterState",
+        "InvalidLane", "LaneMasterMismatch", "LaneOrderMismatch", "LaneSequenceDecreased", "DuplicateCheckpoint",
+        "CheckpointSequenceOverflow", "NonCanonicalDigest", "Identity", "Policy", "Tree",
+    ];
+
+    fn summary(seen: &[usize; 22]) -> std::string::String {
+        let mut out = std::string::String::new();
+        for (k, n) in seen.iter().enumerate() {
+            if *n > 0 {
+                out.push_str(&std::format!("{} {}, ", OUTCOMES[k], n));
+            }
+        }
+        out
+    }
+
+    fn pair_empty_roots() -> [Digest; POOL_V1_TREE_DEPTH + 1] {
+        let ordinary = pool_v1_empty_roots();
+        core::array::from_fn(|level| {
+            if level < POOL_V1_TREE_DEPTH {
+                ordinary[level + 1]
+            } else {
+                pool_v1_tree_parent(&ordinary[POOL_V1_TREE_DEPTH], &ordinary[POOL_V1_TREE_DEPTH])
+            }
+        })
+    }
+
+    /// Valid lane images (each checked to decode to its lane): trees with 0, 1, 2, 3 and 5 appended leaves and a
+    /// full tree (index 2^20, empty frontier), lane ids 0 to 7, bumps 0, 255 and random, random masters.
+    fn images(rng: &mut Rng, empty: &[Digest; POOL_V1_TREE_DEPTH + 1]) -> alloc::vec::Vec<[u8; POOL_V1_PAIR_FOREST_LANE_ACCOUNT_BYTES]> {
+        let mut out = alloc::vec::Vec::new();
+        let mut trees = alloc::vec::Vec::new();
+        let mut tree = IncrementalMerkleTreeV1 {
+            next_leaf_index: 0,
+            root: empty[POOL_V1_TREE_DEPTH],
+            frontier: core::array::from_fn(|level| empty[level]),
+        };
+        for leaves in 0..=5u64 {
+            if leaves != 4 {
+                trees.push(tree);
+            }
+            tree = tree.append_one_with_empty_roots(rng.digest(), empty).unwrap().0;
+        }
+        trees.push(IncrementalMerkleTreeV1 {
+            next_leaf_index: POOL_V1_PAIR_CAPACITY,
+            root: rng.digest(),
+            frontier: core::array::from_fn(|level| empty[level]),
+        });
+        for (k, tree) in trees.into_iter().enumerate() {
+            let lane = PoolV1PairForestLaneStateV1 {
+                bump: [0, 255, rng.byte()][k % 3],
+                master: core::array::from_fn(|_| rng.byte() | 1),
+                lane_id: (k % 8) as u8,
+                tree,
+            };
+            let image = encode_pool_v1_pair_forest_lane_state_v1(&lane, empty).unwrap();
+            assert_eq!(decode_pool_v1_pair_forest_lane_state_v1(&image, empty), Ok(lane));
+            out.push(image);
+        }
+        out
+    }
+
+    fn compare(bytes: &[u8], empty: &[Digest; POOL_V1_TREE_DEPTH + 1], seen: &mut [usize; 22]) {
+        let new = decode_pool_v1_pair_forest_lane_state_v1(bytes, empty);
+        assert_eq!(new, frozen_decode_pool_v1_pair_forest_lane_state_v1(bytes, empty), "{bytes:?}");
+        seen[match new {
+            Ok(_) => 0,
+            Err(e) => error_index(e),
+        }] += 1;
+    }
+
+    #[test]
+    fn same_result_as_frozen_body() {
+        let start = std::time::Instant::now();
+        let mut rng = Rng(0x1a7e_0000_0000_0006);
+        let empty = pair_empty_roots();
+        let mut seen = [0usize; 22];
+        let mut cases = 0usize;
+        let images = images(&mut rng, &empty);
+        assert_eq!(images.len(), 6);
+        for image in &images {
+            compare(image, &empty, &mut seen);
+            cases += 1;
+            // Every value of every header byte (magic, version, lane id, lane count, depth, format binding,
+            // master, bump, reserved bytes 73..80).
+            for position in 0..LANE_TREE_OFFSET {
+                for value in 0..=255u8 {
+                    let mut corrupted = *image;
+                    corrupted[position] = value;
+                    compare(&corrupted, &empty, &mut seen);
+                    cases += 1;
+                }
+            }
+            // Six values at every tree byte.
+            for position in LANE_TREE_OFFSET..POOL_V1_PAIR_FOREST_LANE_ACCOUNT_BYTES {
+                for value in [0u8, 1, 0x7f, 0x80, 0xff, image[position] ^ 1] {
+                    let mut corrupted = *image;
+                    corrupted[position] = value;
+                    compare(&corrupted, &empty, &mut seen);
+                    cases += 1;
+                }
+            }
+            // Every length from 0 to the account length plus 8 (one byte short, exact, one byte long among them).
+            let mut long = image.to_vec();
+            long.extend_from_slice(&[0u8; 8]);
+            for length in 0..=long.len() {
+                compare(&long[..length], &empty, &mut seen);
+                cases += 1;
+            }
+        }
+        // Random images: several reserved, master, lane id and tree-index bytes changed at once.
+        for _ in 0..20_000 {
+            let mut image = images[(rng.next() % 6) as usize];
+            for _ in 0..(1 + rng.next() % 3) {
+                match rng.next() % 5 {
+                    0 => image[73 + (rng.next() % 7) as usize] = rng.byte(),
+                    1 => image[LANE_MASTER_OFFSET..72].fill(0),
+                    2 => image[5] = rng.byte() % 10,
+                    3 => {
+                        let start = LANE_TREE_OFFSET + 8;
+                        image[start..start + 8].copy_from_slice(&rng.sequence().to_le_bytes());
+                    }
+                    _ => image[(rng.next() % 768) as usize] = rng.byte(),
+                }
+            }
+            compare(&image, &empty, &mut seen);
+            cases += 1;
+        }
+        assert_eq!(cases, 6 * (1 + 80 * 256 + 688 * 6 + 777) + 20_000);
+        assert!(seen[0] > 1_000 && seen[8] > 1_000 && seen[9] > 0 && seen[12] > 0 && seen[21] > 1_000, "{seen:?}");
+        std::println!(
+            "differential_decode_pool_v1_pair_forest_lane_state_v1: {cases} cases; {}{} ms",
+            summary(&seen),
+            start.elapsed().as_millis()
+        );
+    }
+}
