+/// Differential test of `checkpoint_lane_sequence_v1`, a function the rewrite introduced, against one iteration of
+/// the frozen loop it replaces in `plan_pool_v1_pair_forest_checkpoint_v1` (commit 3d700effcabe,
+/// pair_forest_accounts.rs 490-501). The three checks are kept verbatim; adapted only by taking the pool key as the
+/// parameter `pool` (frozen: `master.identity.pool`) and returning the value the frozen loop stores into
+/// `lane_sequences[expected_lane]`.
+#[cfg(test)]
+mod differential_checkpoint_lane_sequence_v1 {
+    extern crate std;
+    use super::*;
+    use aspis_core::field::M31;
+
+    fn frozen_iteration(
+        lane: &PoolV1PairForestLaneStateV1,
+        expected_lane: usize,
+        pool: &[u8; 32],
+    ) -> Result<u64, PoolV1PairForestAccountErrorV1> {
+        if lane.master != *pool {
+            return Err(PoolV1PairForestAccountErrorV1::LaneMasterMismatch);
+        }
+        if usize::from(lane.lane_id) != expected_lane {
+            return Err(PoolV1PairForestAccountErrorV1::LaneOrderMismatch);
+        }
+        if lane.tree.next_leaf_index > POOL_V1_PAIR_CAPACITY {
+            return Err(PoolV1PairForestAccountErrorV1::InvalidMasterState);
+        }
+        Ok(lane.tree.next_leaf_index)
+    }
+
+    /// splitmix64 with a fixed seed.
+    struct Rng(u64);
+    impl Rng {
+        fn next(&mut self) -> u64 {
+            self.0 = self.0.wrapping_add(0x9e37_79b9_7f4a_7c15);
+            let mut z = self.0;
+            z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+            z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+            z ^ (z >> 31)
+        }
+        fn byte(&mut self) -> u8 {
+            self.next() as u8
+        }
+        /// A canonical digest limb: 0, 1, 2, p - 2 or p - 1 with probability 3/8, otherwise uniform below p.
+        fn canonical(&mut self) -> M31 {
+            M31(match self.next() % 8 {
+                0 => 0,
+                1 => 1,
+                2 => [2, P - 2, P - 1][(self.next() % 3) as usize],
+                _ => (self.next() % u64::from(P)) as u32,
+            })
+        }
+        fn digest(&mut self) -> Digest {
+            core::array::from_fn(|_| self.canonical())
+        }
+        /// 32 bytes: all zero, one non-zero byte, or random non-zero bytes.
+        fn binding(&mut self, zero_one_in: u64) -> [u8; 32] {
+            if self.next() % zero_one_in == 0 {
+                return [0u8; 32];
+            }
+            if self.next() % 4 == 0 {
+                let mut b = [0u8; 32];
+                b[(self.next() % 32) as usize] = 1 + (self.next() % 255) as u8;
+                return b;
+            }
+            core::array::from_fn(|_| self.byte() | 1)
+        }
+        /// A lane sequence: an edge (0, 1, capacity - 1, capacity, capacity + 1, u64::MAX - 1, u64::MAX), uniform up
+        /// to the capacity, or any u64.
+        fn sequence(&mut self) -> u64 {
+            const EDGES: [u64; 7] = [
+                0,
+                1,
+                POOL_V1_PAIR_CAPACITY - 1,
+                POOL_V1_PAIR_CAPACITY,
+                POOL_V1_PAIR_CAPACITY + 1,
+                u64::MAX - 1,
+                u64::MAX,
+            ];
+            match self.next() % 8 {
+                0 | 1 => EDGES[(self.next() % 7) as usize],
+                2 => self.next(),
+                _ => self.next() % (POOL_V1_PAIR_CAPACITY + 1),
+            }
+        }
+    }
+
+    #[test]
+    fn same_result_as_frozen_loop_iteration() {
+        let start = std::time::Instant::now();
+        let mut rng = Rng(0x1a9e_5e90_0000_0009);
+        // [Ok, LaneMasterMismatch, LaneOrderMismatch, InvalidMasterState]
+        let mut seen = [0usize; 4];
+        let mut cases = 0usize;
+        let indices = [0, 1, POOL_V1_PAIR_CAPACITY - 1, POOL_V1_PAIR_CAPACITY, POOL_V1_PAIR_CAPACITY + 1, u64::MAX];
+        let expected_lanes = [0usize, 1, 2, 3, 4, 5, 6, 7, 8, 255, 256, usize::MAX];
+        // Every lane id, every expected lane in and around 0..8, every index edge, three master relations.
+        for lane_id in 0..=255u8 {
+            for &expected_lane in &expected_lanes {
+                for &index in &indices {
+                    for relation in 0..3 {
+                        let pool: [u8; 32] = core::array::from_fn(|_| rng.byte() | 1);
+                        let mut master = pool;
+                        match relation {
+                            0 => {}
+                            1 => master[(rng.next() % 32) as usize] ^= 1 << (rng.next() % 8),
+                            _ => master = [0u8; 32],
+                        }
+                        let lane = PoolV1PairForestLaneStateV1 {
+                            bump: rng.byte(),
+                            master,
+                            lane_id,
+                            tree: IncrementalMerkleTreeV1 {
+                                next_leaf_index: index,
+                                root: rng.digest(),
+                                frontier: core::array::from_fn(|_| rng.digest()),
+                            },
+                        };
+                        let new = checkpoint_lane_sequence_v1(&lane, expected_lane, &pool);
+                        assert_eq!(new, frozen_iteration(&lane, expected_lane, &pool), "{lane:?} {expected_lane} {pool:?}");
+                        seen[match new {
+                            Ok(_) => 0,
+                            Err(PoolV1PairForestAccountErrorV1::LaneMasterMismatch) => 1,
+                            Err(PoolV1PairForestAccountErrorV1::LaneOrderMismatch) => 2,
+                            Err(PoolV1PairForestAccountErrorV1::InvalidMasterState) => 3,
+                            Err(e) => panic!("unexpected {e:?}"),
+                        }] += 1;
+                        cases += 1;
+                    }
+                }
+            }
+        }
+        // Random lanes, with the index drawn from the sequence edges.
+        for _ in 0..100_000 {
+            let pool: [u8; 32] = core::array::from_fn(|_| rng.byte() | 1);
+            let lane = PoolV1PairForestLaneStateV1 {
+                bump: rng.byte(),
+                master: if rng.next() % 4 == 0 { rng.binding(4) } else { pool },
+                lane_id: if rng.next() % 2 == 0 { (rng.next() % 8) as u8 } else { rng.byte() },
+                tree: IncrementalMerkleTreeV1 {
+                    next_leaf_index: rng.sequence(),
+                    root: rng.digest(),
+                    frontier: core::array::from_fn(|_| rng.digest()),
+                },
+            };
+            let expected_lane = (rng.next() % 9) as usize;
+            let new = checkpoint_lane_sequence_v1(&lane, expected_lane, &pool);
+            assert_eq!(new, frozen_iteration(&lane, expected_lane, &pool), "{lane:?} {expected_lane} {pool:?}");
+            seen[match new {
+                Ok(_) => 0,
+                Err(PoolV1PairForestAccountErrorV1::LaneMasterMismatch) => 1,
+                Err(PoolV1PairForestAccountErrorV1::LaneOrderMismatch) => 2,
+                Err(PoolV1PairForestAccountErrorV1::InvalidMasterState) => 3,
+                Err(e) => panic!("unexpected {e:?}"),
+            }] += 1;
+            cases += 1;
+        }
+        assert_eq!(cases, 256 * 12 * 6 * 3 + 100_000);
+        assert!(seen.iter().all(|n| *n > 1_000), "{seen:?}");
+        std::println!(
+            "differential_checkpoint_lane_sequence_v1: {cases} cases; Ok {}, LaneMasterMismatch {}, LaneOrderMismatch {}, \
+             InvalidMasterState {}; {} ms",
+            seen[0],
+            seen[1],
+            seen[2],
+            seen[3],
+            start.elapsed().as_millis()
+        );
+    }
+}
