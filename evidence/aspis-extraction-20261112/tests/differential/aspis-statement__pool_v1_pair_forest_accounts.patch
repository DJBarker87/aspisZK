+/// Differential test of `plan_pool_v1_pair_forest_checkpoint_v1` as a whole against its frozen body (commit
+/// 3d700effcabe, pair_forest_accounts.rs 476-537). The frozen body is kept verbatim; adapted only by its name and by
+/// dropping `pub`. Both bodies call the shipped `validate_master` and `digest_is_canonical` (`validate_master` has
+/// its own differential test above). The complete result is compared: the plan (next master and checkpoint) or the
+/// error value.
+#[cfg(test)]
+mod differential_plan_pool_v1_pair_forest_checkpoint_v1 {
+    extern crate std;
+    use super::*;
+    use aspis_core::field::M31;
+
+    fn frozen_plan_pool_v1_pair_forest_checkpoint_v1(
+        master: &PoolV1PairForestMasterV1,
+        lanes: &[PoolV1PairForestLaneStateV1; POOL_V1_PAIR_FOREST_LANE_COUNT],
+        global_root: Digest,
+        checkpoint_bump: u8,
+    ) -> Result<PoolV1PairForestCheckpointPlanV1, PoolV1PairForestAccountErrorV1> {
+        validate_master(master)?;
+        if master.initialized_lane_mask != POOL_V1_PAIR_FOREST_ALL_LANES_MASK {
+            return Err(PoolV1PairForestAccountErrorV1::InvalidMasterState);
+        }
+        if !digest_is_canonical(&global_root) {
+            return Err(PoolV1PairForestAccountErrorV1::NonCanonicalDigest);
+        }
+        let mut lane_sequences = [0u64; POOL_V1_PAIR_FOREST_LANE_COUNT];
+        for (expected_lane, lane) in lanes.iter().enumerate() {
+            if lane.master != master.identity.pool {
+                return Err(PoolV1PairForestAccountErrorV1::LaneMasterMismatch);
+            }
+            if usize::from(lane.lane_id) != expected_lane {
+                return Err(PoolV1PairForestAccountErrorV1::LaneOrderMismatch);
+            }
+            if lane.tree.next_leaf_index > POOL_V1_PAIR_CAPACITY {
+                return Err(PoolV1PairForestAccountErrorV1::InvalidMasterState);
+            }
+            lane_sequences[expected_lane] = lane.tree.next_leaf_index;
+        }
+        if master.has_checkpoint {
+            let mut progressed = false;
+            for lane in 0..POOL_V1_PAIR_FOREST_LANE_COUNT {
+                if lane_sequences[lane] < master.last_checkpoint_lane_sequences[lane] {
+                    return Err(PoolV1PairForestAccountErrorV1::LaneSequenceDecreased);
+                }
+                progressed |= lane_sequences[lane] > master.last_checkpoint_lane_sequences[lane];
+            }
+            if !progressed {
+                return Err(PoolV1PairForestAccountErrorV1::DuplicateCheckpoint);
+            }
+        }
+        let next_sequence = master
+            .next_checkpoint_sequence
+            .checked_add(1)
+            .ok_or(PoolV1PairForestAccountErrorV1::CheckpointSequenceOverflow)?;
+        let checkpoint = PoolV1PairForestCheckpointV1 {
+            bump: checkpoint_bump,
+            master: master.identity.pool,
+            deployment_domain: master.identity.deployment_domain,
+            checkpoint_sequence: master.next_checkpoint_sequence,
+            global_root,
+            lane_sequences,
+        };
+        let next_master = PoolV1PairForestMasterV1 {
+            has_checkpoint: true,
+            next_checkpoint_sequence: next_sequence,
+            last_checkpoint_lane_sequences: lane_sequences,
+            ..*master
+        };
+        validate_master(&next_master)?;
+        Ok(PoolV1PairForestCheckpointPlanV1 {
+            next_master,
+            checkpoint,
+        })
+    }
+
+    /// splitmix64 with a fixed seed.
+    struct Rng(u64);
+    impl Rng {
+        fn next(&mut self) -> u64 {
+            self.0 = self.0.wrapping_add(0x9e37_79b9_7f4a_7c15);
+            let mut z = self.0;
+            z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+            z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+            z ^ (z >> 31)
+        }
+        fn byte(&mut self) -> u8 {
+            self.next() as u8
+        }
+        /// A canonical digest limb: 0, 1, 2, p - 2 or p - 1 with probability 3/8, otherwise uniform below p.
+        fn canonical(&mut self) -> M31 {
+            M31(match self.next() % 8 {
+                0 => 0,
+                1 => 1,
+                2 => [2, P - 2, P - 1][(self.next() % 3) as usize],
+                _ => (self.next() % u64::from(P)) as u32,
+            })
+        }
+        fn digest(&mut self) -> Digest {
+            core::array::from_fn(|_| self.canonical())
+        }
+    }
+
+    fn error_index(error: PoolV1PairForestAccountErrorV1) -> usize {
+        use PoolV1PairForestAccountErrorV1 as A;
+        match error {
+            A::WrongLength => 1,
+            A::WrongMagic => 2,
+            A::WrongVersion => 3,
+            A::WrongLaneCount => 4,
+            A::WrongDigestEncoding => 5,
+            A::WrongDepth => 6,
+            A::WrongFormatBinding => 7,
+            A::NonZeroReserved => 8,
+            A::ZeroRequiredBinding => 9,
+            A::InvalidBoolean => 10,
+            A::InvalidMasterState => 11,
+            A::InvalidLane => 12,
+            A::LaneMasterMismatch => 13,
+            A::LaneOrderMismatch => 14,
+            A::LaneSequenceDecreased => 15,
+            A::DuplicateCheckpoint => 16,
+            A::CheckpointSequenceOverflow => 17,
+            A::NonCanonicalDigest => 18,
+            A::Identity => 19,
+            A::Policy => 20,
+            A::Tree(_) => 21,
+        }
+    }
+
+    /// Outcome names in the order of `error_index` (0 = accepted).
+    const OUTCOMES: [&str; 22] = [
+        "Ok", "WrongLength", "WrongMagic", "WrongVersion", "WrongLaneCount", "WrongDigestEncoding", "WrongDepth",
+        "WrongFormatBinding", "NonZeroReserved", "ZeroRequiredBinding", "InvalidBoolean", "InvalidMasterState",
+        "InvalidLane", "LaneMasterMismatch", "LaneOrderMismatch", "LaneSequenceDecreased", "DuplicateCheckpoint",
+        "CheckpointSequenceOverflow", "NonCanonicalDigest", "Identity", "Policy", "Tree",
+    ];
+
+    fn summary(seen: &[usize; 22]) -> std::string::String {
+        let mut out = std::string::String::new();
+        for (k, n) in seen.iter().enumerate() {
+            if *n > 0 {
+                out.push_str(&std::format!("{} {}, ", OUTCOMES[k], n));
+            }
+        }
+        out
+    }
+
+    fn valid_master(rng: &mut Rng) -> PoolV1PairForestMasterV1 {
+        let immutable = rng.next() % 2 == 0;
+        let has_checkpoint = rng.next() % 4 != 0;
+        PoolV1PairForestMasterV1 {
+            bump: rng.byte(),
+            identity: PoolIdentityV1 {
+                pool: core::array::from_fn(|_| rng.byte() | 1),
+                asset_mint: core::array::from_fn(|_| rng.byte() | 1),
+                token_program: core::array::from_fn(|_| rng.byte() | 1),
+                asset_id: rng.canonical(),
+                deployment_domain: core::array::from_fn(|_| rng.byte() | 1),
+            },
+            verifier_policy: VerifierPolicyV1 {
+                flags: if immutable { 1 | (rng.byte() & 2) } else { 0 },
+                registry_program: core::array::from_fn(|_| rng.byte() | 1),
+                registry_authority: if immutable { [0u8; 32] } else { core::array::from_fn(|_| rng.byte() | 1) },
+                policy_binding: core::array::from_fn(|_| rng.byte() | 1),
+            },
+            initialized_lane_mask: POOL_V1_PAIR_FOREST_ALL_LANES_MASK,
+            has_checkpoint,
+            next_checkpoint_sequence: if has_checkpoint {
+                [1, 2, u64::MAX - 1, u64::MAX, 1 + rng.next() % 1000][(rng.next() % 5) as usize]
+            } else {
+                0
+            },
+            last_checkpoint_lane_sequences: [0u64; POOL_V1_PAIR_FOREST_LANE_COUNT],
+        }
+    }
+
+    /// A small lane sequence or an edge near the capacity (so equal, smaller and larger last sequences occur).
+    fn lane_sequence(rng: &mut Rng) -> u64 {
+        match rng.next() % 4 {
+            0 => [POOL_V1_PAIR_CAPACITY - 1, POOL_V1_PAIR_CAPACITY][(rng.next() % 2) as usize],
+            _ => rng.next() % 3,
+        }
+    }
+
+    fn lane(rng: &mut Rng, pool: [u8; 32], lane_id: u8, next_leaf_index: u64) -> PoolV1PairForestLaneStateV1 {
+        PoolV1PairForestLaneStateV1 {
+            bump: rng.byte(),
+            master: pool,
+            lane_id,
+            tree: IncrementalMerkleTreeV1 {
+                next_leaf_index,
+                root: rng.digest(),
+                frontier: core::array::from_fn(|_| rng.digest()),
+            },
+        }
+    }
+
+    #[test]
+    fn same_result_as_frozen_body() {
+        let start = std::time::Instant::now();
+        let mut rng = Rng(0x91a2_0000_0000_0008);
+        let mut seen = [0usize; 22];
+        let mut cases = 0usize;
+        for n in 0..300_000u64 {
+            let mut master = valid_master(&mut rng);
+            let pool = master.identity.pool;
+            let sequences: [u64; 8] = core::array::from_fn(|_| lane_sequence(&mut rng));
+            let mut lanes: [PoolV1PairForestLaneStateV1; 8] =
+                core::array::from_fn(|k| lane(&mut rng, pool, k as u8, sequences[k]));
+            if master.has_checkpoint {
+                // Last sequences equal to, one below or one above the lane sequences, within the capacity.
+                for k in 0..8 {
+                    master.last_checkpoint_lane_sequences[k] = match rng.next() % 6 {
+                        0 => sequences[k].saturating_sub(1),
+                        1 => (sequences[k] + 1).min(POOL_V1_PAIR_CAPACITY),
+                        _ => sequences[k],
+                    };
+                }
+            }
+            let mut root = rng.digest();
+            // From the fifth case on, up to three mutations, each a distinct check (several at once test which
+            // check fails first).
+            let mutations = if n % 5 == 0 { 0 } else { 1 + rng.next() % 3 };
+            for _ in 0..mutations {
+                let k = (rng.next() % 8) as usize;
+                match rng.next() % 12 {
+                    0 => master.identity.pool = [0u8; 32],
+                    1 => master.identity.deployment_domain = [0u8; 32],
+                    2 => master.verifier_policy.flags = rng.byte(),
+                    3 => master.last_checkpoint_lane_sequences[k] = POOL_V1_PAIR_CAPACITY + 1 + rng.next() % 2,
+                    4 => master.has_checkpoint = !master.has_checkpoint,
+                    5 => master.initialized_lane_mask = rng.byte() & 0x7f,
+                    6 => root[(rng.next() % 8) as usize] = M31([P, P + 1, u32::MAX][(rng.next() % 3) as usize]),
+                    7 => lanes[k].master[(rng.next() % 32) as usize] ^= 1 << (rng.next() % 8),
+                    8 => lanes.swap(k, (k + 1 + (rng.next() % 7) as usize) % 8),
+                    9 => lanes[k].lane_id = [8, 255, (k as u8 + 1) % 8][(rng.next() % 3) as usize],
+                    10 => lanes[k].tree.next_leaf_index = [POOL_V1_PAIR_CAPACITY + 1, u64::MAX][(rng.next() % 2) as usize],
+                    _ => master.next_checkpoint_sequence = [u64::MAX, u64::MAX - 1, 0][(rng.next() % 3) as usize],
+                }
+            }
+            let bump = rng.byte();
+            let new = plan_pool_v1_pair_forest_checkpoint_v1(&master, &lanes, root, bump);
+            assert_eq!(
+                new,
+                frozen_plan_pool_v1_pair_forest_checkpoint_v1(&master, &lanes, root, bump),
+                "master {master:?} lanes {lanes:?} root {root:?} bump {bump}"
+            );
+            seen[match new {
+                Ok(_) => 0,
+                Err(e) => error_index(e),
+            }] += 1;
+            cases += 1;
+        }
+        assert_eq!(cases, 300_000);
+        // Every error value the frozen planner returns is reached (validate_master's ZeroRequiredBinding, Policy
+        // and InvalidMasterState; the planner's own InvalidMasterState, NonCanonicalDigest, LaneMasterMismatch,
+        // LaneOrderMismatch, LaneSequenceDecreased, DuplicateCheckpoint, CheckpointSequenceOverflow).
+        for k in [0, 9, 11, 13, 14, 15, 16, 17, 18, 20] {
+            assert!(seen[k] > 100, "{}: {seen:?}", OUTCOMES[k]);
+        }
+        std::println!(
+            "differential_plan_pool_v1_pair_forest_checkpoint_v1: {cases} cases; {}{} ms",
+            summary(&seen),
+            start.elapsed().as_millis()
+        );
+    }
+}
