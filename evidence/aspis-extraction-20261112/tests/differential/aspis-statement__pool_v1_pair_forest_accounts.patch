+            compare(&c, &mut seen);
+            cases += 1;
+        }
+        assert_eq!(cases, 50 * (1 + 8 * 7 + 8 * 9 + 16 + 32 * 2 * 2) + 300_000);
+        assert!(seen[0] > 10_000 && seen[9] > 1_000 && seen[11] > 1_000 && seen[18] > 1_000, "{seen:?}");
+        std::println!(
+            "differential_encode_pool_v1_pair_forest_checkpoint_v1: {cases} cases; {}{} ms",
+            summary(&seen),
+            start.elapsed().as_millis()
+        );
     }
 }
