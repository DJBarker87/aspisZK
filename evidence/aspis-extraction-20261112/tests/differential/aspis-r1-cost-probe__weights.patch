+/// Differential test of `Weights::scalar_factor` against its frozen body (commit 3d700effcabe, weights.rs 237-239).
+/// The frozen body is kept verbatim; adapted only by its name (a free function in place of an associated one).
+#[cfg(test)]
+mod differential_scalar_factor {
+    extern crate std;
+    use super::*;
+    use aspis_core::field::{CM31, P};
+
+    fn frozen_scalar_factor(f:&[K;4],p:&[E;4])->E {
+        (0..4).fold(E::ZERO,|v,s|v.add(p[PERM[s]].mul_qm31(f[s]))).mul_m31(QUARTER)
+    }
+
+    /// splitmix64 with a fixed seed.
+    struct Rng(u64);
+    impl Rng {
+        fn next(&mut self) -> u64 {
+            self.0 = self.0.wrapping_add(0x9e37_79b9_7f4a_7c15);
+            let mut z = self.0;
+            z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+            z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+            z ^ (z >> 31)
+        }
+        /// A canonical limb: 0, 1, 2, p - 2 or p - 1 with probability 3/8, otherwise uniform below p.
+        fn limb(&mut self) -> u32 {
+            match self.next() % 8 {
+                0 => 0,
+                1 => 1,
+                2 => [2, P - 2, P - 1][(self.next() % 3) as usize],
+                _ => (self.next() % u64::from(P)) as u32,
+            }
+        }
+        fn k(&mut self) -> K {
+            K { c0: CM31 { a: M31(self.limb()), b: M31(self.limb()) }, c1: CM31 { a: M31(self.limb()), b: M31(self.limb()) } }
+        }
+        fn e(&mut self) -> E {
+            E::from_limbs(core::array::from_fn(|_| self.limb())).unwrap()
+        }
+    }
+
+    #[test]
+    fn same_result_as_frozen_body() {
+        let start = std::time::Instant::now();
+        let mut rng = Rng(0x5ca1_0000_0000_000f);
+        let mut cases = 0usize;
+        let ks = [K::ZERO, K::ONE, K { c0: CM31 { a: M31(P - 1), b: M31(P - 1) }, c1: CM31 { a: M31(P - 1), b: M31(P - 1) } }];
+        let es = [E::ZERO, E::ONE, E::from_limbs([P - 1; 8]).unwrap(), E::from_limbs([P - 2; 8]).unwrap()];
+        // One factor and one value at an edge, the others random (each position of both arrays).
+        for slot in 0..4 {
+            for &k in &ks {
+                for &e in &es {
+                    let mut f: [K; 4] = core::array::from_fn(|_| rng.k());
+                    let mut p: [E; 4] = core::array::from_fn(|_| rng.e());
+                    f[slot] = k;
+                    p[slot] = e;
+                    assert_eq!(Weights::scalar_factor(&f, &p), frozen_scalar_factor(&f, &p), "{f:?} {p:?}");
+                    cases += 1;
+                }
+            }
+        }
+        // All four at one edge.
+        for &k in &ks {
+            for &e in &es {
+                assert_eq!(Weights::scalar_factor(&[k; 4], &[e; 4]), frozen_scalar_factor(&[k; 4], &[e; 4]));
+                cases += 1;
+            }
+        }
+        for _ in 0..200_000 {
+            let f: [K; 4] = core::array::from_fn(|_| rng.k());
+            let p: [E; 4] = core::array::from_fn(|_| rng.e());
+            assert_eq!(Weights::scalar_factor(&f, &p), frozen_scalar_factor(&f, &p), "{f:?} {p:?}");
+            cases += 1;
+        }
+        assert_eq!(cases, 4 * 3 * 4 + 3 * 4 + 200_000);
+        std::println!("differential_scalar_factor: {cases} cases, {} ms", start.elapsed().as_millis());
+    }
+}
