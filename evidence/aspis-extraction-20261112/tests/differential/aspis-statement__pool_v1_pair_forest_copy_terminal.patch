+
+/// Differential test of `Selectors::expand` against its frozen body (commit 3d700effcabe,
+/// pair_forest_copy_terminal.rs 144-159) at both sizes the crates use it with: 64 (`high`, six coordinates) and 16
+/// (`low`, four coordinates), from `Selectors::at_point`, its only caller. Also every shorter coordinate list at
+/// both sizes, and one coordinate too many at both sizes, where both bodies panic. The frozen body is kept
+/// verbatim; adapted only by its name (a free function in place of an associated one).
+#[cfg(test)]
+mod differential_selectors_expand_sizes {
+    extern crate std;
+    use super::*;
+    use aspis_core::field::P;
+
+    fn frozen_expand<const N: usize>(coordinates: &[QM31]) -> [QM31; N] {
+        let mut weights = [QM31::ZERO; N];
+        weights[0] = QM31::ONE;
+        let mut len = 1usize;
+        for coordinate in coordinates {
+            let prepared = PreparedQm31Multiplier::new(*coordinate);
+            for index in (0..len).rev() {
+                let parent = weights[index];
+                let right = prepared.mul(parent);
+                weights[2 * index] = parent.sub(right);
+                weights[2 * index + 1] = right;
+            }
+            len *= 2;
+        }
+        weights
+    }
+
+    /// splitmix64 with a fixed seed.
+    struct Rng(u64);
+    impl Rng {
+        fn next(&mut self) -> u64 {
+            self.0 = self.0.wrapping_add(0x9e37_79b9_7f4a_7c15);
+            let mut z = self.0;
+            z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+            z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+            z ^ (z >> 31)
+        }
+        /// A canonical M31 limb: 0, 1, 2, p - 2 or p - 1 with probability 3/8, otherwise uniform below p.
+        fn limb(&mut self) -> u32 {
+            match self.next() % 8 {
+                0 => 0,
+                1 => 1,
+                2 => [2, P - 2, P - 1][(self.next() % 3) as usize],
+                _ => (self.next() % u64::from(P)) as u32,
+            }
+        }
+        fn qm31(&mut self) -> QM31 {
+            qm31([self.limb(), self.limb(), self.limb(), self.limb()])
+        }
+    }
+
+    fn qm31(l: [u32; 4]) -> QM31 {
+        QM31 { c0: CM31 { a: M31(l[0]), b: M31(l[1]) }, c1: CM31 { a: M31(l[2]), b: M31(l[3]) } }
+    }
+
+    /// The panic message, or the value.
+    fn outcome<T>(f: impl FnOnce() -> T) -> Result<T, std::string::String> {
+        std::panic::catch_unwind(std::panic::AssertUnwindSafe(f)).map_err(|payload| {
+            if let Some(s) = payload.downcast_ref::<&str>() {
+                std::string::String::from(*s)
+            } else if let Some(s) = payload.downcast_ref::<std::string::String>() {
+                s.clone()
+            } else {
+                std::string::String::from("non-string panic payload")
+            }
+        })
+    }
+
+    #[test]
+    fn same_result_as_frozen_body_at_sizes_16_and_64() {
+        let start = std::time::Instant::now();
+        let mut rng = Rng(0xe7a0_d000_0000_0004);
+        let edges = [
+            QM31::ZERO,
+            QM31::ONE,
+            qm31([P - 1, 0, 0, 0]),
+            qm31([0, P - 1, 0, 0]),
+            qm31([0, 0, P - 1, 0]),
+            qm31([0, 0, 0, P - 1]),
+            qm31([2; 4]),
+            qm31([P - 2; 4]),
+            qm31([P - 1; 4]),
+        ];
+        let mut cases = 0usize;
+        // All coordinates at one edge value; every list length at both sizes.
+        for &e in &edges {
+            let c = [e; 7];
+            for k in 0..=6 {
+                assert_eq!(Selectors::expand::<64>(&c[..k]), frozen_expand::<64>(&c[..k]));
+                cases += 1;
+            }
+            for k in 0..=4 {
+                assert_eq!(Selectors::expand::<16>(&c[..k]), frozen_expand::<16>(&c[..k]));
+                cases += 1;
+            }
         }
+        // One coordinate at an edge value, the others random.
+        for slot in 0..6 {
+            for &e in &edges {
+                let mut c: [QM31; 6] = core::array::from_fn(|_| rng.qm31());
+                c[slot] = e;
+                assert_eq!(Selectors::expand::<64>(&c), frozen_expand::<64>(&c));
+                assert_eq!(Selectors::expand::<16>(&c[..4]), frozen_expand::<16>(&c[..4]));
+                cases += 2;
+            }
+        }
+        // The call sites: `at_point` against the frozen body on the same halves of the point.
+        for _ in 0..20_000 {
+            let point: [QM31; 10] = core::array::from_fn(|_| rng.qm31());
+            let selectors = Selectors::at_point(&point);
+            assert_eq!(selectors.high, frozen_expand::<64>(&point[..6]), "point {point:?}");
+            assert_eq!(selectors.low, frozen_expand::<16>(&point[6..]), "point {point:?}");
+            cases += 2;
+        }
+        // Random coordinates, every list length at both sizes.
+        for _ in 0..20_000 {
+            let c: [QM31; 6] = core::array::from_fn(|_| rng.qm31());
+            for k in 0..=6 {
+                assert_eq!(Selectors::expand::<64>(&c[..k]), frozen_expand::<64>(&c[..k]), "coordinates {c:?}");
+                cases += 1;
+            }
+            for k in 0..=4 {
+                assert_eq!(Selectors::expand::<16>(&c[..k]), frozen_expand::<16>(&c[..k]), "coordinates {c:?}");
+                cases += 1;
+            }
+        }
+        // One coordinate too many: both bodies panic, with the same message.
+        let mut panics = 0usize;
+        for _ in 0..10 {
+            let c: [QM31; 7] = core::array::from_fn(|_| rng.qm31());
+            let new = outcome(|| Selectors::expand::<64>(&c));
+            assert!(new.is_err());
+            assert_eq!(new, outcome(|| frozen_expand::<64>(&c)));
+            let new = outcome(|| Selectors::expand::<16>(&c[..5]));
+            assert!(new.is_err());
+            assert_eq!(new, outcome(|| frozen_expand::<16>(&c[..5])));
+            cases += 2;
+            panics += 2;
+        }
+        assert_eq!(cases, 9 * 12 + 6 * 9 * 2 + 20_000 * 2 + 20_000 * 12 + 20);
+        std::println!(
+            "differential_selectors_expand_sizes: {cases} cases ({panics} panicking in both), {} ms",
+            start.elapsed().as_millis()
+        );
     }
 }
