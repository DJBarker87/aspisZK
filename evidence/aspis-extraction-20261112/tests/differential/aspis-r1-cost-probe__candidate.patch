+/// Differential test of `wide_view` against its frozen body (commit 3d700effcabe, candidate.rs 151-163). The frozen
+/// body is kept verbatim; adapted only by its name. The complete result is compared (every field of the view, the
+/// slices by address and length, or the error value), and where the frozen body panics (a proof shorter than the
+/// fields it reads) the new one must panic with the same message.
+#[cfg(test)]
+mod differential_wide_view {
+    extern crate std;
+    use super::*;
+    use alloc::vec::Vec;
+    use aspis_core::field::P;
+
+    fn frozen_wide_view<'a>(proof: &'a [u8], semantic: &'a [u8], y1: &'a [u8]) -> Result<View<'a>, Error> {
+        Ok(View {
+            variant: Variant::S2,
+            semantic,
+            y1,
+            inactive: E::from_le_bytes(&proof[compact::OFF_INACTIVE..compact::OFF_ROUND0]).ok_or(Error::Parse)?,
+            round0: &proof[compact::OFF_ROUND0..compact::OFF_FOLDED_ROOT],
+            folded_root: Some(proof[compact::OFF_FOLDED_ROOT..compact::OFF_ROUND1].try_into().unwrap()),
+            round1: &proof[compact::OFF_ROUND1..compact::OFF_FINAL],
+            final_message: &proof[compact::OFF_FINAL..compact::OFF_OPENINGS],
+            query_bytes: NO_QUERY_BYTES,
+        })
+    }
+
+    /// splitmix64 with a fixed seed.
+    struct Rng(u64);
+    impl Rng {
+        fn next(&mut self) -> u64 {
+            self.0 = self.0.wrapping_add(0x9e37_79b9_7f4a_7c15);
+            let mut z = self.0;
+            z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+            z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+            z ^ (z >> 31)
+        }
+        /// A canonical limb: 0, 1, 2, p - 2 or p - 1 with probability 3/8, otherwise uniform below p.
+        fn limb(&mut self) -> u32 {
+            match self.next() % 8 {
+                0 => 0,
+                1 => 1,
+                2 => [2, P - 2, P - 1][(self.next() % 3) as usize],
+                _ => (self.next() % u64::from(P)) as u32,
+            }
+        }
+        /// Any limb: as `limb`, or with probability 1/16 one of p, p + 1, 2^31, u32::MAX.
+        fn any_limb(&mut self) -> u32 {
+            if self.next() % 16 == 0 {
+                [P, P + 1, 1 << 31, u32::MAX][(self.next() % 4) as usize]
+            } else {
+                self.limb()
+            }
+        }
+        fn bytes(&mut self, n: usize) -> Vec<u8> {
+            (0..n).map(|_| self.next() as u8).collect()
+        }
+    }
+
+    /// Eight little-endian limbs into 32 bytes.
+    fn put(out: &mut [u8], limbs: [u32; 8]) {
+        for (k, limb) in limbs.iter().enumerate() {
+            out[4 * k..4 * k + 4].copy_from_slice(&limb.to_le_bytes());
+        }
+    }
+
+    /// The panic message, or the value.
+    fn outcome<T>(f: impl FnOnce() -> T) -> Result<T, std::string::String> {
+        std::panic::catch_unwind(std::panic::AssertUnwindSafe(f)).map_err(|payload| {
+            if let Some(s) = payload.downcast_ref::<&str>() {
+                std::string::String::from(*s)
+            } else if let Some(s) = payload.downcast_ref::<std::string::String>() {
+                s.clone()
+            } else {
+                std::string::String::from("non-string panic payload")
+            }
+        })
+    }
+
+    /// Every field of a view: each slice as (address, length), an empty slice as (0, 0); the inactive value; the
+    /// folded root as (address, bytes).
+    type Key = (Variant, [(usize, usize); 6], E, Option<(usize, [u8; 32])>);
+    fn key(v: View<'_>) -> Key {
+        fn s(x: &[u8]) -> (usize, usize) {
+            if x.is_empty() {
+                (0, 0)
+            } else {
+                (x.as_ptr() as usize, x.len())
+            }
+        }
+        (
+            v.variant,
+            [s(v.semantic), s(v.y1), s(v.round0), s(v.round1), s(v.final_message), s(v.query_bytes)],
+            v.inactive,
+            v.folded_root.map(|r| (r.as_ptr() as usize, *r)),
+        )
+    }
+
+    /// Proof lengths: zero, and one short, exact and one long at the end of every field the view reads, and at
+    /// the full proof length.
+    fn lengths() -> [usize; 23] {
+        use compact::*;
+        [
+            0,
+            1,
+            OFF_INACTIVE,
+            OFF_ROUND0 - 1,
+            OFF_ROUND0,
+            OFF_ROUND0 + 1,
+            OFF_FOLDED_ROOT - 1,
+            OFF_FOLDED_ROOT,
+            OFF_FOLDED_ROOT + 1,
+            OFF_ROUND1 - 1,
+            OFF_ROUND1,
+            OFF_ROUND1 + 1,
+            OFF_FINAL - 1,
+            OFF_FINAL,
+            OFF_FINAL + 1,
+            OFF_OPENINGS - 1,
+            OFF_OPENINGS,
+            OFF_OPENINGS + 1,
+            PROOF_BYTES - 1,
+            PROOF_BYTES,
+            PROOF_BYTES + 1,
+            OFF_INACTIVE + 16,
+            OFF_INACTIVE + 31,
+        ]
+    }
+
+    /// The inactive field: canonical, or one limb (0 or 7) non-canonical.
+    fn inactive_variants(rng: &mut Rng) -> [[u32; 8]; 9] {
+        let good: [u32; 8] = core::array::from_fn(|_| rng.limb());
+        let mut out = [good; 9];
+        for (k, v) in [P, P + 1, 1 << 31, u32::MAX].into_iter().enumerate() {
+            out[1 + 2 * k][0] = v;
+            out[2 + 2 * k][7] = v;
+        }
+        out
+    }
+
+    /// [view, Parse, panic]
+    fn compare(proof: &[u8], semantic: &[u8], y1: &[u8], seen: &mut [usize; 3]) {
+        let new = outcome(|| wide_view(proof, semantic, y1).map(key));
+        let old = outcome(|| frozen_wide_view(proof, semantic, y1).map(key));
+        assert_eq!(new, old, "proof length {} inactive {:?}", proof.len(), proof.get(compact::OFF_INACTIVE..compact::OFF_ROUND0));
+        seen[match new {
+            Ok(Ok(_)) => 0,
+            Ok(Err(_)) => 1,
+            Err(_) => 2,
+        }] += 1;
+    }
+
+    #[test]
+    fn same_result_as_frozen_body() {
+        let start = std::time::Instant::now();
+        let mut rng = Rng(0x01de_0000_0000_000a);
+        let mut seen = [0usize; 3];
+        let mut cases = 0usize;
+        let semantic = rng.bytes(SEMANTIC_BYTES);
+        let y1 = rng.bytes(29 * 32);
+        // Every length edge with three inactive fields (canonical, limb 0 = p, limb 7 = p): the short lengths panic
+        // in both bodies, or return Parse in both when the inactive field is present and non-canonical.
+        for length in lengths() {
+            let variants = inactive_variants(&mut rng);
+            for limbs in [variants[0], variants[1], variants[2]] {
+                let mut proof = rng.bytes(compact::PROOF_BYTES + 1);
+                put(&mut proof[compact::OFF_INACTIVE..compact::OFF_ROUND0], limbs);
+                compare(&proof[..length], &semantic, &y1, &mut seen);
+                cases += 1;
+            }
+        }
+        // Full-length proofs: every inactive variant, with empty and non-empty semantic and y1 buffers.
+        for _ in 0..20 {
+            for limbs in inactive_variants(&mut rng) {
+                let mut proof = rng.bytes(compact::PROOF_BYTES);
+                put(&mut proof[compact::OFF_INACTIVE..compact::OFF_ROUND0], limbs);
+                compare(&proof, &semantic, &y1, &mut seen);
+                compare(&proof, &[], &[], &mut seen);
+                cases += 2;
+            }
+        }
+        // Random full-length proofs: inactive limbs over the whole range, some non-canonical.
+        for _ in 0..20_000 {
+            let mut proof = rng.bytes(compact::PROOF_BYTES);
+            let limbs = core::array::from_fn(|_| rng.any_limb());
+            put(&mut proof[compact::OFF_INACTIVE..compact::OFF_ROUND0], limbs);
+            let s = (rng.next() % 64) as usize;
+            compare(&proof, &semantic[..s], &y1[s..], &mut seen);
+            cases += 1;
+        }
+        assert_eq!(cases, 23 * 3 + 20 * 9 * 2 + 20_000);
+        assert!(seen[0] > 5_000 && seen[1] > 1_000 && seen[2] > 10, "{seen:?}");
+        std::println!(
+            "differential_wide_view: {cases} cases (view {}, Parse {}, panic in both {}), {} ms",
+            seen[0],
+            seen[1],
+            seen[2],
+            start.elapsed().as_millis()
+        );
+    }
+}
+
+/// Differential test of `parse_shape` against its frozen body (commit 3d700effcabe, candidate.rs 40-49). The frozen
+/// body is kept verbatim; adapted only by its name and by dropping `pub` and `#[inline(never)]`.
+#[cfg(test)]
+mod differential_parse_shape {
+    extern crate std;
+    use super::*;
+    use alloc::vec::Vec;
+
+    fn frozen_parse_shape(proof: &[u8]) -> Result<Variant, Error> {
+        if proof.len() != compact::PROOF_BYTES
+            || &proof[..8] != compact::MAGIC
+            || proof[8] != Variant::S2.tag()
+            || proof[9..16].iter().any(|&x| x != 0)
+        {
+            return Err(Error::Parse);
+        }
+        Ok(Variant::S2)
+    }
+
+    /// splitmix64 with a fixed seed.
+    struct Rng(u64);
+    impl Rng {
+        fn next(&mut self) -> u64 {
+            self.0 = self.0.wrapping_add(0x9e37_79b9_7f4a_7c15);
+            let mut z = self.0;
+            z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+            z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+            z ^ (z >> 31)
+        }
+        fn bytes(&mut self, n: usize) -> Vec<u8> {
+            (0..n).map(|_| self.next() as u8).collect()
+        }
+    }
+
+    fn header(proof: &mut [u8]) {
+        proof[..8].copy_from_slice(&compact::MAGIC[..]);
+        proof[8] = Variant::S2.tag();
+        proof[9..16].fill(0);
+    }
+
+    #[test]
+    fn same_result_as_frozen_body() {
+        let start = std::time::Instant::now();
+        let mut rng = Rng(0x5a9e_0000_0000_000b);
+        // [Ok, Parse]
+        let mut seen = [0usize; 2];
+        let mut cases = 0usize;
+        let check = |proof: &[u8], seen: &mut [usize; 2]| {
+            let new = parse_shape(proof);
+            assert_eq!(new, frozen_parse_shape(proof), "length {} header {:?}", proof.len(), &proof[..proof.len().min(16)]);
+            seen[usize::from(new.is_err())] += 1;
+        };
+        let mut proof = rng.bytes(compact::PROOF_BYTES + 1);
+        header(&mut proof);
+        // Every length from 0 to 17, and one short, exact and one long.
+        for length in (0..=17).chain([compact::PROOF_BYTES - 1, compact::PROOF_BYTES, compact::PROOF_BYTES + 1]) {
+            check(&proof[..length], &mut seen);
+            cases += 1;
+        }
+        // Every value of every header byte, at the exact length.
+        for position in 0..16 {
+            for value in 0..=255u8 {
+                let mut p = proof[..compact::PROOF_BYTES].to_vec();
+                p[position] = value;
+                check(&p, &mut seen);
+                cases += 1;
+            }
+        }
+        // Random headers: valid magic and tag, tail bytes zero or with up to three random bytes.
+        for n in 0..20_000 {
+            let mut p = proof[..compact::PROOF_BYTES].to_vec();
+            for _ in 0..(n % 4) {
+                p[9 + (rng.next() % 7) as usize] = rng.next() as u8;
+            }
+            if n % 5 == 0 {
+                p[(rng.next() % 9) as usize] = rng.next() as u8;
+            }
+            check(&p, &mut seen);
+            cases += 1;
+        }
+        assert_eq!(cases, 21 + 16 * 256 + 20_000);
+        assert!(seen[0] > 1_000 && seen[1] > 1_000, "{seen:?}");
+        std::println!(
+            "differential_parse_shape: {cases} cases (Ok {}, Parse {}), {} ms",
+            seen[0],
+            seen[1],
+            start.elapsed().as_millis()
+        );
+    }
+}
