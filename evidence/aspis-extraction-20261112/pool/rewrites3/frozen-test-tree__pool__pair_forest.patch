+    // ---- X2c handler-state recorder (test only; identical text in the frozen and the rewritten test trees) ----
+    // The four handler names are shadowed here (local items take precedence over the glob import), so every test
+    // call of a handler is recorded: the result, and for every account passed in, its key, owner, lamports and
+    // complete data before and after the call. Enabled only when X2C_STATE_DUMP names a directory.
+    fn x2c_snapshot(accounts: &[AccountInfo<'_>]) -> std::string::String {
+        use std::fmt::Write as _;
+        let mut out = std::string::String::new();
+        for (index, account) in accounts.iter().enumerate() {
+            let data = account.try_borrow_data().map(|d| d.to_vec()).unwrap_or_default();
+            let _ = write!(out, " [{} key={} owner={} lamports={} len={} data=", index, account.key, account.owner, account.lamports(), data.len());
+            for byte in &data {
+                let _ = write!(out, "{:02x}", byte);
+            }
+            out.push(']');
+        }
+        out
+    }
+
+    fn x2c_record(handler: &str, before: &str, accounts: &[AccountInfo<'_>], result: &ProgramResult) {
+        let Ok(dir) = std::env::var("X2C_STATE_DUMP") else { return };
+        let after = x2c_snapshot(accounts);
+        let test = std::thread::current().name().unwrap_or("unnamed").replace("::", "__");
+        let line = std::format!(
+            "{} result={:?} unchanged={}\n  before{}\n  after{}\n",
+            handler,
+            result,
+            before == after,
+            before,
+            after
+        );
+        use std::io::Write as _;
+        let mut file = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(std::format!("{}/{}.txt", dir, test))
+            .unwrap();
+        file.write_all(line.as_bytes()).unwrap();
+    }
