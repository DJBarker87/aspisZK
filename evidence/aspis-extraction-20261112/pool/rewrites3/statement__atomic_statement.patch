+/// X2c: `decode_digest_canonical` against its frozen body (commit 3d700effcabe), kept here.
+#[cfg(test)]
+mod x2c_decode_digest_differential {
+    use super::*;
+
+    fn frozen(bytes: &[u8; 32]) -> Result<Digest, AtomicStatementError> {
+        let limb = |k: usize| {
+            M31::from_le_bytes([bytes[4 * k], bytes[4 * k + 1], bytes[4 * k + 2], bytes[4 * k + 3]])
+                .ok_or(AtomicStatementError::NonCanonicalDigest)
+        };
+        Ok([limb(0)?, limb(1)?, limb(2)?, limb(3)?, limb(4)?, limb(5)?, limb(6)?, limb(7)?])
     }
+
+    #[test]
+    fn x2c_same_result_as_frozen_body() {
+        let mut seed = 5u64;
+        for round in 0..50_000u64 {
+            let mut bytes = [0u8; 32];
+            for k in 0..8 {
+                seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+                let v = match (round + k as u64) % 4 {
+                    0 => aspis_core::field::P - 1,
+                    1 => aspis_core::field::P,
+                    2 => u32::MAX,
+                    _ => (seed >> 33) as u32,
+                };
+                bytes[4 * k..4 * k + 4].copy_from_slice(&v.to_le_bytes());
+            }
+            assert_eq!(decode_digest_canonical(&bytes), frozen(&bytes));
+        }
+    }
