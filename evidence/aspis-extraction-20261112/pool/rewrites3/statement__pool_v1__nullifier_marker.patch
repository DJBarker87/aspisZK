+    #[test]
+    fn x2c_same_result_as_iter_all() {
+        for mask in 0u32..256 {
+            let digest: Digest = core::array::from_fn(|k| if mask & (1 << k) != 0 { M31(P + k as u32) } else { M31(P - 1 - k as u32) });
