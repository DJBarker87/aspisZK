+#[cfg(test)]
+mod x2b_marker_seed_differential {
+    use super::*;
+
+    /// The frozen body (commit 3d700effcabe); the rewrite changes only the shift amounts' types (u32).
+    fn frozen_pack_pool_v1_pair_forest_marker_seed_v1(digest: &[u8; 32]) -> [u8; 32] {
+        let mut seed = [0u8; POOL_V1_PAIR_FOREST_MARKER_SEED_BYTES];
+        let mut chunk = 0;
+        while chunk < 4 {
+            let mut word = 0u64;
+            let mut byte = 0;
+            while byte < 7 {
+                word = (word << 8) | u64::from(digest[7 * chunk + byte]);
+                byte += 1;
+            }
+            let mut group = 0;
+            while group < 8 {
+                seed[8 * chunk + group] = ((word >> (7 * (7 - group))) & 0x7f) as u8;
+                group += 1;
+            }
+            chunk += 1;
+        }
+        seed
+    }
+
+    #[test]
+    fn same_result_as_frozen_body() {
+        let mut state = 0x5eed_5eed_u64;
+        for digest in [[0u8; 32], [0xffu8; 32], [0x80u8; 32], [0x7fu8; 32]] {
+            assert_eq!(pack_pool_v1_pair_forest_marker_seed_v1(&digest), frozen_pack_pool_v1_pair_forest_marker_seed_v1(&digest));
+        }
+        for _ in 0..2000 {
+            let mut digest = [0u8; 32];
+            for byte in digest.iter_mut() {
+                state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+                *byte = (state >> 56) as u8;
+            }
+            assert_eq!(pack_pool_v1_pair_forest_marker_seed_v1(&digest), frozen_pack_pool_v1_pair_forest_marker_seed_v1(&digest));
+        }
+    }
+}
