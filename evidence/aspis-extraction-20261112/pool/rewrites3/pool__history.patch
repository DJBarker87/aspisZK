+/// X2c: the plain-value page writes against the frozen in-place writers, on zeroed pages (the only pages the
+/// handlers write fresh) and on valid pages for the append.
+#[cfg(test)]
+mod x2c_page_write_tests {
+    use super::*;
+    use aspis_core::field::M31;
+    use std::vec;
+
+    fn digest(seed: u64) -> Digest {
+        core::array::from_fn(|i| M31(((seed.wrapping_mul(2654435761).wrapping_add(i as u64 * 97)) % u64::from(P)) as u32))
+    }
+
+    #[test]
+    fn fresh_prefix_equals_frozen_writer_on_zeroed_page() {
+        for round in 0..400u64 {
+            let pool = Pubkey::new_from_array([(round % 251) as u8; 32]);
+            let page_number = round.wrapping_mul(0x9e37_79b9_7f4a_7c15);
+            let first = round.wrapping_mul(31);
+            let (a, b) = (digest(round), digest(round + 1000));
+            let mut frozen = vec![0u8; POOL_V1_ROOT_HISTORY_PAGE_ACCOUNT_BYTES];
+            let mut new = vec![0u8; POOL_V1_ROOT_HISTORY_PAGE_ACCOUNT_BYTES];
+            if round % 2 == 0 {
+                write_new_page_unchecked(&mut frozen, &pool, page_number, first, &[a]);
+                new[..ROOT_PAGE_ONE_ROOT_PREFIX_BYTES]
+                    .copy_from_slice(&new_root_page_prefix_one_v1(&pool, page_number, first, &a));
+            } else {
+                write_new_page_unchecked(&mut frozen, &pool, page_number, first, &[a, b]);
+                new[..ROOT_PAGE_TWO_ROOT_PREFIX_BYTES]
+                    .copy_from_slice(&new_root_page_prefix_two_v1(&pool, page_number, first, &a, &b));
             }
+            assert_eq!(frozen, new);
         }
     }
+
+    #[test]
+    fn append_one_equals_frozen_writer() {
+        for filled in 0..POOL_V1_ROOT_HISTORY_CAPACITY as u16 {
+            let pool = Pubkey::new_from_array([3u8; 32]);
+            let roots: std::vec::Vec<Digest> = (0..u64::from(filled)).map(digest).collect();
+            let mut frozen = vec![0u8; POOL_V1_ROOT_HISTORY_PAGE_ACCOUNT_BYTES];
+            write_new_page_unchecked(&mut frozen, &pool, 4, 4 * POOL_V1_ROOT_HISTORY_CAPACITY as u64, &roots);
+            let header = RootPageHeaderV1 { pool, page_number: 4, first_sequence: 4 * POOL_V1_ROOT_HISTORY_CAPACITY as u64, filled };
+            let mut new = frozen.clone();
+            let root = digest(5000 + u64::from(filled));
+            append_roots_unchecked(&mut frozen, header, &[root]);
+            let w = root_page_append_one_v1(header, &root);
+            new[w.root_start..w.root_end].copy_from_slice(&w.root_bytes);
+            new[w.filled_start..w.filled_end].copy_from_slice(&w.filled_bytes);
+            assert_eq!(frozen, new);
+        }
+    }
