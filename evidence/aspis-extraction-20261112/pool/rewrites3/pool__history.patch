+/// X2c (write boundary): the bytes that `write_new_page_unchecked` sets in a fresh page, as plain values.
+/// The header of a fresh page (bytes `0..64`; bytes 7 and `58..64` are zero).
+pub(crate) fn root_page_header_bytes_v1(
+    pool: &Pubkey,
+    page_number: u64,
+    first_sequence: u64,
+    filled: u16,
+) -> [u8; PAGE_ROOTS_OFFSET] {
+    let mut header = [0u8; PAGE_ROOTS_OFFSET];
+    header[..4].copy_from_slice(&POOL_V1_ROOT_HISTORY_PAGE_MAGIC);
+    header[4] = POOL_V1_ROOT_HISTORY_PAGE_VERSION;
+    header[5] = POOL_V1_ROOT_HISTORY_CAPACITY_LOG2;
+    header[6] = POOL_V1_DIGEST_ENCODING_VERSION;
+    header[PAGE_POOL_OFFSET..PAGE_NUMBER_OFFSET].copy_from_slice(&pool.to_bytes());
+    header[PAGE_NUMBER_OFFSET..PAGE_FIRST_SEQUENCE_OFFSET].copy_from_slice(&page_number.to_le_bytes());
+    header[PAGE_FIRST_SEQUENCE_OFFSET..PAGE_FILLED_OFFSET].copy_from_slice(&first_sequence.to_le_bytes());
+    header[PAGE_FILLED_OFFSET..58].copy_from_slice(&filled.to_le_bytes());
+    header
 }
 
+/// Length of the written prefix of a fresh page holding one root.
+pub(crate) const ROOT_PAGE_ONE_ROOT_PREFIX_BYTES: usize = PAGE_ROOTS_OFFSET + 32;
+/// Length of the written prefix of a fresh page holding two roots.
+pub(crate) const ROOT_PAGE_TWO_ROOT_PREFIX_BYTES: usize = PAGE_ROOTS_OFFSET + 64;
+
+/// The prefix `0..96` of a fresh page holding one root, equal to the same bytes of
+/// `write_new_page_unchecked(data, pool, page_number, first_sequence, &[root])`. Every later byte of that page is
+/// zero; callers write this prefix only into a page they have checked to be entirely zero, so the page after the
+/// write equals the frozen writer's page (which first zeroes the whole page).
+pub(crate) fn new_root_page_prefix_one_v1(
+    pool: &Pubkey,
+    page_number: u64,
+    first_sequence: u64,
+    root: &Digest,
+) -> [u8; ROOT_PAGE_ONE_ROOT_PREFIX_BYTES] {
+    let mut prefix = [0u8; ROOT_PAGE_ONE_ROOT_PREFIX_BYTES];
+    prefix[..PAGE_ROOTS_OFFSET].copy_from_slice(&root_page_header_bytes_v1(pool, page_number, first_sequence, 1));
+    prefix[PAGE_ROOTS_OFFSET..ROOT_PAGE_ONE_ROOT_PREFIX_BYTES].copy_from_slice(&encode_digest_canonical(root));
+    prefix
+}
+
+/// The prefix `0..128` of a fresh page holding two roots (see `new_root_page_prefix_one_v1`).
+pub(crate) fn new_root_page_prefix_two_v1(
+    pool: &Pubkey,
+    page_number: u64,
+    first_sequence: u64,
+    first_root: &Digest,
+    second_root: &Digest,
+) -> [u8; ROOT_PAGE_TWO_ROOT_PREFIX_BYTES] {
+    let mut prefix = [0u8; ROOT_PAGE_TWO_ROOT_PREFIX_BYTES];
+    prefix[..PAGE_ROOTS_OFFSET].copy_from_slice(&root_page_header_bytes_v1(pool, page_number, first_sequence, 2));
+    prefix[PAGE_ROOTS_OFFSET..ROOT_PAGE_ONE_ROOT_PREFIX_BYTES].copy_from_slice(&encode_digest_canonical(first_root));
+    prefix[ROOT_PAGE_ONE_ROOT_PREFIX_BYTES..ROOT_PAGE_TWO_ROOT_PREFIX_BYTES]
+        .copy_from_slice(&encode_digest_canonical(second_root));
+    prefix
+}
+
+/// The two writes of `append_roots_unchecked(data, header, &[root])`, as plain values in its order: the root at
+/// `root_start..root_end`, then the filled counter at `filled_start..filled_end`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct RootPageAppendOneV1 {
+    pub(crate) root_start: usize,
+    pub(crate) root_end: usize,
+    pub(crate) root_bytes: [u8; 32],
+    pub(crate) filled_start: usize,
+    pub(crate) filled_end: usize,
+    pub(crate) filled_bytes: [u8; 2],
+}
+
+pub(crate) fn root_page_append_one_v1(header: RootPageHeaderV1, root: &Digest) -> RootPageAppendOneV1 {
+    let root_start = PAGE_ROOTS_OFFSET + usize::from(header.filled) * 32;
+    RootPageAppendOneV1 {
+        root_start,
+        root_end: root_start + 32,
+        root_bytes: encode_digest_canonical(root),
+        filled_start: PAGE_FILLED_OFFSET,
+        filled_end: 58,
+        filled_bytes: (header.filled + 1).to_le_bytes(),
+    }
+}
