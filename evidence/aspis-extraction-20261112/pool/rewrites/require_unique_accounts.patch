+fn account_key_repeats_after(accounts: &[AccountInfo<'_>], left: usize, right: usize) -> bool {
+    if right >= accounts.len() {
+        false
+    } else if *accounts[left].key == *accounts[right].key {
+        true
+    } else {
+        account_key_repeats_after(accounts, left, right + 1)
+    }
+}
