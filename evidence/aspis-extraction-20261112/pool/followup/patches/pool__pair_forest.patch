+    /// Oracle independent of the checked expression: `data[start..end].copy_from_slice(bytes)` does not panic iff
+    /// the range exists in the data and has the bytes' length.
+    fn copy_would_succeed(data_len: usize, start: usize, end: usize, bytes_len: usize) -> bool {
+        let data = alloc::vec![0u8; data_len];
+        data.get(start..end).map_or(false, |range| range.len() == bytes_len)
