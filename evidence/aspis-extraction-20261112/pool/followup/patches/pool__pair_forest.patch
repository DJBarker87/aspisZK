+            POOL_V1_PAIR_FOREST_LANE_ACCOUNT_BYTES,
+            POOL_V1_PAIR_FOREST_LANE_ACCOUNT_BYTES,
+            POOL_V1_PAIR_FOREST_LANE_ACCOUNT_BYTES,
+            POOL_V1_PAIR_FOREST_LANE_ACCOUNT_BYTES,
+            POOL_V1_PAIR_FOREST_LANE_ACCOUNT_BYTES,
+            POOL_V1_PAIR_FOREST_LANE_ACCOUNT_BYTES,
+            POOL_V1_PAIR_FOREST_LANE_ACCOUNT_BYTES,
+        ];
+        let (result, data) = run_initialize_writes(exact);
+        assert_eq!(result, Ok(()));
+        assert!(data[0].iter().all(|b| *b == 0xcd));
+        for lane in 0..8 {
+            assert!(data[1 + lane].iter().all(|b| usize::from(*b) == lane + 1));
+        }
+        // One account one byte short, at each of the nine positions: the frozen writes (and the boundary without
+        // the check) would have written the accounts before it and then panicked; now nothing is written.
+        for short in 0..9 {
+            let mut lengths = exact;
+            lengths[short] -= 1;
+            let (result, data) = run_initialize_writes(lengths);
+            assert_eq!(result, Err(PoolV1ProgramError::InvalidFreshAccount.into()), "position {short}");
+            assert!(data.iter().all(|account| account.iter().all(|b| *b == 0)), "position {short}");
+        }
+    }
+}
