+/// The checks of `require_alias_free` over plain keys, in its order: master against checkpoint, then for each lane
+/// (ascending) the lane against master, against checkpoint, and against every previous lane (ascending). One loop
+/// over (lane, previous) pairs; a nested loop is rejected by the translator.
+fn lane_keys_alias(
+    master: &Pubkey,
+    lanes: &[Pubkey; POOL_V1_PAIR_FOREST_LANE_COUNT],
+    count: usize,
+    checkpoint: &Pubkey,
+) -> bool {
+    let mut alias = *master == *checkpoint;
+    let mut index = 0;
+    let mut previous = 0;
+    let mut own_checked = false;
+    while !alias && index < count {
+        if !own_checked {
+            alias = lanes[index] == *master || lanes[index] == *checkpoint;
+            own_checked = true;
+        } else if previous < index {
+            alias = lanes[previous] == lanes[index];
+            previous += 1;
+        } else {
+            index += 1;
+            previous = 0;
+            own_checked = false;
+        }
+    }
+    alias
