+        let mut output = [0u8; POOL_V1_PAIR_FOREST_LANE_ACCOUNT_BYTES];
+        output[..4].copy_from_slice(&POOL_V1_PAIR_FOREST_LANE_MAGIC);
+        output[4] = POOL_V1_PAIR_FOREST_LANE_VERSION;
+        output[5] = lane.lane_id;
+        output[6] = POOL_V1_PAIR_FOREST_LANE_COUNT as u8;
+        output[7] = POOL_V1_PAIR_TREE_DEPTH as u8;
+        output[8..40].copy_from_slice(&POOL_V1_PAIR_FOREST_ACCOUNT_FORMAT_BINDING);
+        output[40..72].copy_from_slice(&lane.master);
+        output[72] = lane.bump;
+        let tree = &mut output[POOL_V1_PAIR_FOREST_LANE_HEADER_BYTES..];
+        tree[..4].copy_from_slice(&POOL_V1_TREE_STATE_MAGIC);
+        tree[4] = POOL_V1_TREE_STATE_VERSION;
+        tree[5] = POOL_V1_PAIR_TREE_DEPTH as u8;
+        tree[6] = POOL_V1_TREE_HASH_VERSION;
+        tree[7] = POOL_V1_DIGEST_ENCODING_VERSION;
+        tree[8..16].copy_from_slice(&lane.tree.next_leaf_index.to_le_bytes());
+        tree[16..48].copy_from_slice(&encode_digest_canonical(&lane.tree.root));
+        for (level, node) in lane.tree.frontier.iter().enumerate() {
+            let start = 48 + 32 * level;
+            tree[start..start + 32].copy_from_slice(&encode_digest_canonical(node));
+        }
+        Ok(output)
+    }
+
+    fn frozen_require_alias_free(
+        master: &AccountInfo<'_>,
+        lanes: &[AccountInfo<'_>],
+        checkpoint: &AccountInfo<'_>,
+    ) -> Result<(), ProgramError> {
+        if master.key == checkpoint.key {
+            return Err(ProgramError::InvalidArgument);
+        }
+        for (index, lane) in lanes.iter().enumerate() {
+            if lane.key == master.key
+                || lane.key == checkpoint.key
+                || lanes[..index]
+                    .iter()
+                    .any(|previous| previous.key == lane.key)
+            {
+                return Err(ProgramError::InvalidArgument);
+            }
+        }
+        Ok(())
+    }
+
+    fn next(state: &mut u64) -> u64 {
+        *state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        *state >> 33
+    }
+
+    fn digest(state: &mut u64) -> Digest {
+        core::array::from_fn(|_| M31((next(state) as u32) % P))
+    }
+
+    #[test]
+    fn encode_lane_same_result_as_frozen_body() {
+        let mut state = 0x1a7e_u64;
+        for round in 0..3000u64 {
+            let mut lane = genesis_lane_state(&Pubkey::new_from_array([7u8; 32]), (round % 10) as u8, (round % 256) as u8);
+            lane.tree.next_leaf_index = match round % 4 {
+                0 => next(&mut state) % 64,
+                1 => POOL_V1_PAIR_CAPACITY - (next(&mut state) % 3),
+                2 => POOL_V1_PAIR_CAPACITY + (next(&mut state) % 3),
+                _ => next(&mut state),
+            };
+            for level in 0..POOL_V1_PAIR_TREE_DEPTH {
+                if next(&mut state) % 3 == 0 {
+                    lane.tree.frontier[level] = digest(&mut state);
+                }
+            }
+            if round % 5 == 0 {
+                lane.tree.root = digest(&mut state);
+            }
+            if round % 11 == 0 {
+                lane.master = [0u8; 32];
+            }
+            assert_eq!(encode_lane_from_authenticated_result_v1(&lane), frozen_encode_lane(&lane));
+        }
+    }
+
+    #[test]
+    fn require_alias_free_same_result_as_frozen_body() {
+        let owner = Pubkey::new_from_array([9u8; 32]);
+        let mut state = 0xa11a5_u64;
+        for round in 0..4000 {
+            let alphabet = if round % 2 == 0 { 4 } else { 40 };
+            let mut keys = [Pubkey::new_from_array([0u8; 32]); 10];
+            for key in keys.iter_mut() {
+                *key = Pubkey::new_from_array([(next(&mut state) % alphabet) as u8; 32]);
+            }
+            let count = (round % (POOL_V1_PAIR_FOREST_LANE_COUNT + 1)) as usize;
+            let mut lamports = [0u64; 10];
+            let mut data = [[0u8; 1]; 10];
+            let (master_l, rest_l) = lamports.split_at_mut(1);
+            let (checkpoint_l, lane_l) = rest_l.split_at_mut(1);
+            let (master_d, rest_d) = data.split_at_mut(1);
+            let (checkpoint_d, lane_d) = rest_d.split_at_mut(1);
+            let master = AccountInfo::new(&keys[0], false, false, &mut master_l[0], &mut master_d[0], &owner, false, 0);
+            let checkpoint = AccountInfo::new(&keys[1], false, false, &mut checkpoint_l[0], &mut checkpoint_d[0], &owner, false, 0);
+            let mut lanes = Vec::new();
+            for ((key, lamport), datum) in keys[2..2 + count].iter().zip(lane_l.iter_mut()).zip(lane_d.iter_mut()) {
+                lanes.push(AccountInfo::new(key, false, false, lamport, datum, &owner, false, 0));
+            }
+            assert_eq!(require_alias_free(&master, &lanes, &checkpoint), frozen_require_alias_free(&master, &lanes, &checkpoint));
+        }
+    }
