AspisFailureBoundModel.failure_bound40P_model : ∀ (D : AspisR1.LiteralByteProtocol.Decoder)
  (P : AspisR1.OraclePortStoredExperimentC4.Prover) (Q : ℕ),
  (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      (AspisV8R19.MemoizedProgramLaw.eval H P).1.length ≤ Q) →
    AspisV8R19.MemoizedProgramLaw.lazyMean (AspisFailureBound.exp D P) FS.emptyTable
          AspisR1.RawRecordedOracleExtractionMassBin.failureMass +
        AspisR1.QueryScanModelFailure.failureProbability (2 ^ 18) ≤
      AspisR1.BinCombinedMerkleCollision.kappa (Q + 1111) +
            (↑Q * AspisPerStep.RowStarts.capMax + AspisRowStarts40.verifierCharge40) +
          1 / 2 ^ 126 +
        1 / 2 ^ 454
AspisFailureBoundModel.failure_le_per_query_model : ∀ (D : AspisR1.LiteralByteProtocol.Decoder)
  (P : AspisR1.OraclePortStoredExperimentC4.Prover),
  ∀ Q ≤ 2 ^ 150,
    (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
        (AspisV8R19.MemoizedProgramLaw.eval H P).1.length ≤ Q) →
      AspisV8R19.MemoizedProgramLaw.lazyMean (AspisFailureBound.exp D P) FS.emptyTable
            AspisR1.RawRecordedOracleExtractionMassBin.failureMass +
          AspisR1.QueryScanModelFailure.failureProbability (2 ^ 18) ≤
        (↑Q + 1) / 2 ^ 100
'AspisFailureBoundModel.failure_bound40P_model' depends on axioms: [propext, Classical.choice, Quot.sound]
