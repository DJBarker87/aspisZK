import AspisFailureBoundModel
/-! X5 check c (adapted from AspisChainUses.lean: watch list reduced to the 38 kind (d) modules; output uses_d_after.tsv).
Aspis port preparation (tool, nothing proved): for every declaration of the Aspis model chain, the constants it
uses (type and value) that are defined in a module of the two-transaction proof which is a gate carrier (tag d) or
imports one transitively (tag c-reaches-d). Output: one line per (chain module, chain declaration, used constant,
defining module, tag). Generated by uses_gen.py from closure-modules.tsv. -/
open Lean Elab Command

def chainMods : Array Name := #[`AspisWeightedFirstRead, `AspisRows40Labels, `AspisRows40Protocol, `AspisRows40Decoder, `AspisRows40Starts, `AspisRec40Compiler, `AspisRows40Context, `AspisRows40Final, `AspisRows40FinalByte, `AspisRows40FinalStarts, `AspisRec40ChargePrefix, `AspisRec40Decision, `AspisRec40HitMass, `AspisRec40Frames, `AspisRec40CallBudget, `AspisRows40Literal, `AspisRec40CleanA, `AspisFinalSumcheckModel, `AspisPairResidualBridge, `AspisAcceptanceAlgebra, `AspisPairResidualDensity, `AspisAcceptanceLink, `AspisRowDensityGeneric, `AspisRowDensityQM31, `AspisRowDensityCaps, `AspisClassifier40, `AspisRowCharge, `AspisRowDensitySampler, `AspisRows40FinalDensity, `AspisCharge40, `AspisOneTxSummedLayout, `AspisOneTxMergedSlot, `AspisOneTxMergedBudget, `AspisOneTxMergedRecovery, `AspisOneTxDecision, `AspisRec40CleanStatement, `AspisRec40FinalShape, `AspisRec40CleanB, `AspisPairResidualObservation, `AspisOneTxChecks, `AspisRec40CleanTag, `AspisRec40CleanWords, `AspisRec40CleanRun, `AspisRec40CallBudgetAspis, `AspisRec40Clean, `AspisOneTxRun, `AspisOneTxCheckedAcceptance, `AspisRowStarts, `AspisRowStarts40, `AspisChargedWeight40, `AspisChargedHitMass40, `AspisAcceptanceLinkR40, `AspisFailureBound, `AspisRec40CleanJoin, `AspisFailureBoundJoined, `AspisNumeric, `AspisNumericBound, `AspisRec40FinalBridgeStatement, `AspisRec40FinalRun, `AspisRec40FinalBefore, `AspisRec40FollowStatement, `AspisRec40FinalContext, `AspisRec40FollowLists, `AspisRec40FollowPrefix, `AspisRec40FollowProof, `AspisRec40FinalSelect, `AspisRec40FinalAddr, `AspisRec40FinalLiteral, `AspisRec40FinalLegacy, `AspisRec40FinalBridge, `AspisRec40FinalWords, `AspisRec40FinalDecoding, `AspisFailureBoundModel]
def watchMods : Array (Name × String) := #[(`AspisR1AdapterReconstruct.Funs, "d"), (`AspisR1AdapterReconstruct.FunsExternal, "d"), (`AspisR1AdapterReconstruct.Types, "d"), (`AspisR1PublicSerializer.Funs, "d"), (`AspisR1PublicSerializer.Types, "d"), (`AspisR1WithdrawalValidation.Funs, "d"), (`AspisR1WithdrawalValidation.Types, "d"), (`DecoderInstanceBoundary, "d"), (`DecoderInstanceBoundaryBin, "d"), (`DecoderQueryAccounting, "d"), (`ExtractedAdapterReconstructSuccess, "d"), (`ExtractedAdapterStageBindingObligations, "d"), (`ExtractedAdapterTransferBindings, "d"), (`ExtractedPublicCheckedBridge432, "d"), (`HchecksPublicComposition, "d"), (`ImportUnionNamedDiscriminant, "d"), (`InitialTagDecision, "d"), (`OraclePortAdmission, "d"), (`OraclePortChecks, "d"), (`PublicExtractedRawBridge431, "d"), (`PublicSerializerFieldsRefinement431, "d"), (`PublicSerializerFrontier431, "d"), (`PublicSerializerSuccess431, "d"), (`PublicSerializerWhole431, "d"), (`QueryScanRow31SourcePlacement, "d"), (`R1FinalSoundness, "d"), (`R1FinalSoundnessBinPerQuery, "d"), (`R1FinalSoundnessBinPerQueryR18, "d"), (`R1FinalSoundnessBinPerQueryR19, "d"), (`R9DeployedBinaryExperiment, "d"), (`R9TwoTransactionExperiment, "d"), (`RawChecksAdaptiveFailureNoModelBin, "d"), (`RawDigestLogCarrier, "d"), (`RecordedBinaryExperimentBin, "d"), (`RWireCompletion, "d"), (`RWireCounterexamples, "d"), (`WithdrawalCarrierBridge431, "d"), (`WithdrawalValidationAmount431, "d")]

run_cmd do
  let env ← getEnv
  let chain : NameSet := chainMods.foldl (fun s n => s.insert n) {}
  let watch : NameMap String := watchMods.foldl (fun m (n, t) => m.insert n t) {}
  let mods := env.header.moduleNames
  let out := env.constants.fold (init := (#[] : Array String)) fun acc c ci =>
    match env.getModuleIdxFor? c with
    | some idx =>
      let m := mods[idx.toNat]!
      if chain.contains m then
        ci.getUsedConstantsAsSet.toList.foldl (init := acc) fun acc u =>
          match env.getModuleIdxFor? u with
          | some j =>
            let mu := mods[j.toNat]!
            match watch.find? mu with
            | some tag => acc.push s!"{m}\t{c}\t{u}\t{mu}\t{tag}"
            | none => acc
          | none => acc
      else acc
    | none => acc
  IO.FS.writeFile "uses_d_after.tsv" (String.intercalate "\n" out.toList ++ "\n")
  logInfo m!"lines {out.size}"
