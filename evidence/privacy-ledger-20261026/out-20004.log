  (sk salt : R0P.Digest K) (path : Fin 24 → Bool × R0P.Digest K) (pair : AspisPool.V7PairLeafOccupancy.PairLeaf K) :
  Prop
number of parameters: 8
fields:
  AspisR1.InputWitnessCore.Relation.valid : pair.Valid
  AspisR1.InputWitnessCore.Relation.spendable : pair.SelectedSlotIsSpendable (path 0).1
  AspisR1.InputWitnessCore.Relation.commitment : pair.selectedCommitment (path 0).1 =
      R0P.noteCommitment (R0P.ownerKey sk) value pub.assetId salt
  AspisR1.InputWitnessCore.Relation.sibling : (path 0).2 =
      if (path 0).1 = Bool.true then pair.firstCommitment else pair.secondCommitment
  AspisR1.InputWitnessCore.Relation.nullifier : pub.nullifier = R0P.nullifierHash sk salt
  AspisR1.InputWitnessCore.Relation.membership : pub.anchor =
      R0P.merkleRoot (R0P.noteCommitment (R0P.ownerKey sk) value pub.assetId salt) path
