def R1Z.ProverCommitObserverQueries19.real : {K CommitHandle Aux : Type} →
  [inst : Field K] →
    [Fintype K] →
      [DecidableEq K] →
        [Algebra (ZMod AspisCircleGroupOrder.P) K] →
          {F : Subfield K} →
            (W : R1Z.GamesR1.R1Wire K CommitHandle Aux) →
              R1Z.GamesR1PBin.R1ProverP K CommitHandle Aux F W →
                (N : ℕ) →
                  (R0Z.JointView.Challenges K → Prop) →
                    ((h : R0Z.JointView.HonestProver K) → R0Z.JointView.Challenges K → h.Instance → Prop) →
                      (h : R0Z.JointView.HonestProver K) →
                        R0P.PackBasis F →
                          (R0Z.JointView.Statement K CommitHandle → R0Z.JointView.Challenges K → Aux) →
                            R1Z.GamesR1.R1Adv K CommitHandle Aux →
                              R0Z.JointView.Statement K CommitHandle →
                                h.Instance →
                                  W.Tab × (Fin N → R1Z.GamesR1PBin.SecP) → List R1Z.ProverCommitSeedEvent19.Entry :=
fun {K CommitHandle Aux} [Field K] [Fintype K] [DecidableEq K] [Algebra (ZMod AspisCircleGroupOrder.P) K] {F} W Pr N P
    Vp h B outputs adv x w r =>
  have H := W.look r.1;
  have out := R1Z.GamesR1PBin.realOut W Pr h B outputs x w H r.2;
  match R0Z.FsAbort.firstGood (fun o => P o.ch ∧ Vp h o.ch w ∧ o.exh = Bool.false) out with
  | Option.none => R1Z.GamesR1.runLog (adv.prog W.failView []) H W.qmax
  | Option.some k => R1Z.GamesR1.runLog (adv.prog (out k).view (out k).log) H W.qmax
