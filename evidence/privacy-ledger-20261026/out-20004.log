  AspisR1.InputWitnessCore.Relation.mk {K : Type} [Field K] {pub : R0P.Public K} {value : K} {sk salt : R0P.Digest K}
    {path : Fin 24 → Bool × R0P.Digest K} {pair : AspisPool.V7PairLeafOccupancy.PairLeaf K} (valid : pair.Valid)
    (spendable : pair.SelectedSlotIsSpendable (path 0).1)
    (commitment : pair.selectedCommitment (path 0).1 = R0P.noteCommitment (R0P.ownerKey sk) value pub.assetId salt)
    (sibling : (path 0).2 = if (path 0).1 = Bool.true then pair.firstCommitment else pair.secondCommitment)
    (nullifier : pub.nullifier = R0P.nullifierHash sk salt)
    (membership : pub.anchor = R0P.merkleRoot (R0P.noteCommitment (R0P.ownerKey sk) value pub.assetId salt) path) :
    AspisR1.InputWitnessCore.Relation pub value sk salt path pair
def AspisR1.PublicOptionShape.canonical : {K : Type} → [Field K] → R0P.Public K → Prop :=
fun {K} [Field K] pub =>
  match pub.variant with
  | R0P.Variant.privateTransfer => pub.recipient.isSome = Bool.true ∧ pub.withdrawalAmount = Option.none
  | R0P.Variant.withdrawal =>
    pub.recipient.isNone = Bool.true ∧ pub.withdrawalAmount.isSome = Bool.true ∧ pub.withdrawalAmount ≠ Option.some 0
def AspisR1.SpendRelation.AppendBinding : {K : Type} → [Field K] → R0P.Public K → Prop :=
fun {K} [Field K] pub =>
  ∃ pair,
    AspisR1.SpendRelation.outputPair pub = Option.some pair ∧
      pub.nextRoot = AspisR1.AppendPath.pathPrefix pub pair 20 ∧
        ∀ (hc : R0P.digestCarry pub.nextPairIndex < 20),
          pub.nextFrontier ⟨R0P.digestCarry pub.nextPairIndex, hc⟩ =
            AspisR1.AppendPath.pathPrefix pub pair (R0P.digestCarry pub.nextPairIndex)
