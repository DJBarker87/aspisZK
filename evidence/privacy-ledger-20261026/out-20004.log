def R1Z.BuilderSpendRelation.RspendPlus : {K : Type} →
  [Field K] → R0P.Public K → AspisR1.SpendRelation.Witness K → Prop :=
fun {K} [Field K] pub w =>
  AspisR1.SpendRelation.Rspend pub w ∧ (pub.variant = R0P.Variant.privateTransfer → pub.change 7 ≠ 0)
def AspisR1.SpendRelation.Rspend : {K : Type} → [Field K] → R0P.Public K → AspisR1.SpendRelation.Witness K → Prop :=
fun {K} [Field K] pub w =>
  AspisR1.PublicOptionShape.canonical pub ∧
    AspisR1.InputWitnessCore.Relation pub (↑↑w.inputValue) w.sk w.salt w.path w.pair ∧
      ↑w.inputValue = ↑w.outputValue + ↑w.changeValue ∧
        pub.change = AspisR1.SpendRelation.changeCommitment pub w ∧
          AspisR1.SpendRelation.variantOutput pub w ∧ AspisR1.SpendRelation.AppendBinding pub
