def R0P.PublicBase : {K : Type} → [inst : Field K] → Subfield K → R0P.Public K → Prop :=
fun {K} [Field K] F pub =>
  (∀ (i : Fin 8), pub.anchor i ∈ F) ∧
    (∀ (i : Fin 8), pub.nullifier i ∈ F) ∧
      pub.assetId ∈ F ∧
        (∀ (r : R0P.Digest K), pub.recipient = Option.some r → ∀ (i : Fin 8), r i ∈ F) ∧
          (∀ (i : Fin 8), pub.change i ∈ F) ∧
            (∀ (a : K), pub.withdrawalAmount = Option.some a → a ∈ F) ∧
              (∀ (l : Fin 20) (i : Fin 8), pub.snapshotFrontier l i ∈ F) ∧
                (∀ (i : Fin 8), pub.nextRoot i ∈ F) ∧ ∀ (l : Fin 20) (i : Fin 8), pub.nextFrontier l i ∈ F
