def R1Z.ProverCommitSeedEvent19.seedGuess : List R1Z.ProverCommitSeedEvent19.Entry →
  R0Z.FsStatement.OracleAnswer → Prop :=
fun queries seed => ∃ entry ∈ queries, R1Z.ProverCommitSeedEvent19.seedPoint entry.1 seed
