theorem R1Z.ProverCommitFuelJoin22.test_bound : ∀ {R M V : Type} [inst : Fintype R] [inst_1 : Fintype M] [Nonempty M]
  {runtime : R → V} {model : M → V} {old : Fin 8 → M → Prop} {queries : M → List R1Z.ProverCommitSeedEvent19.Entry}
  (join : R1Z.ProverCommitFuelJoin22.RunJoin runtime model old queries) (test : V → ℚ),
  (∀ (v : V), 0 ≤ test v ∧ test v ≤ 1) →
    ∀ (q : ℕ),
      (∀ (m : M), (queries m).length ≤ q) →
        |(R0Z.mean fun r => test (runtime r)) - R0Z.mean fun m => test (model m)| ≤
          (R0Z.FsAbort.eventMass fun m => ∃ i, old i m) + R1Z.ProverCommitSeedEvent19.budget q +
            R1Z.ProverCommitFuelMass22.charge :=
fun {R M V} [Fintype R] [Fintype M] [Nonempty M] {runtime} {model} {old} {queries} join test bounded q bound =>
  have ht :=
    R0Z.FsAbort.until_bad (fun s => test (runtime (join.cp.toR s))) (fun s => test (model (join.cp.toM s).1.1))
      (fun s => bounded (runtime (join.cp.toR s))) (fun s => bounded (model (join.cp.toM s).1.1))
      (fun s => ∃ i, R1Z.ProverCommitFuelJoin22.bad old queries i (join.cp.toM s)) fun s hn =>
      congrArg test (join.agreement s hn);
  have hm := join.cp.meanM fun m => if ∃ i, R1Z.ProverCommitFuelJoin22.bad old queries i m then 1 else 0;
  have hmass :=
    id
      (Eq.mpr
        (eq_of_heq
          ((fun α a a' e'_2 a_1 a'_1 e'_3 =>
              let ⟨⟩ := a'
              e'_2)
            ℚ
            (R0Z.mean fun s =>
              if (fun s => ∃ i, R1Z.ProverCommitFuelJoin22.bad old queries i (join.cp.toM s)) s then 1 else 0)
            (R0Z.mean fun s => if ∃ i, R1Z.ProverCommitFuelJoin22.bad old queries i (join.cp.toM s) then 1 else 0)
            ((fun {R} [Fintype R] f f_1 e_f => e_f ▸ Eq.refl (R0Z.mean f))
              (fun s => if (fun s => ∃ i, R1Z.ProverCommitFuelJoin22.bad old queries i (join.cp.toM s)) s then 1 else 0)
              (fun s => if ∃ i, R1Z.ProverCommitFuelJoin22.bad old queries i (join.cp.toM s) then 1 else 0)
              (funext fun z =>
                if h : (fun s => ∃ i, R1Z.ProverCommitFuelJoin22.bad old queries i (join.cp.toM s)) z then
                  Eq.mpr (id (congr (congrArg Eq (if_pos h)) (if_pos h))) (Eq.refl 1)
                else Eq.mpr (id (congr (congrArg Eq (if_neg h)) (if_neg h))) (Eq.refl 0)))
            (R0Z.mean fun s => if (fun m => ∃ i, R1Z.ProverCommitFuelJoin22.bad old queries i m) s then 1 else 0)
            (R0Z.mean fun m => if ∃ i, R1Z.ProverCommitFuelJoin22.bad old queries i m then 1 else 0)
            ((fun {R} [Fintype R] f f_1 e_f => e_f ▸ Eq.refl (R0Z.mean f))
              (fun s => if (fun m => ∃ i, R1Z.ProverCommitFuelJoin22.bad old queries i m) s then 1 else 0)
              (fun m => if ∃ i, R1Z.ProverCommitFuelJoin22.bad old queries i m then 1 else 0)
              (funext fun z =>
                if h : (fun m => ∃ i, R1Z.ProverCommitFuelJoin22.bad old queries i m) z then
                  Eq.mpr (id (congr (congrArg Eq (if_pos h)) (if_pos h))) (Eq.refl 1)
                else Eq.mpr (id (congr (congrArg Eq (if_neg h)) (if_neg h))) (Eq.refl 0)))))
        hm);
  have hr := join.cp.meanR fun r => test (runtime r);
  have hi := join.cp.meanM fun m => test (model m.1.1);
  have hp :=
    Eq.trans (R1Z.CouplingR1PBin.mp_fst fun m => test (model m.1)) (R1Z.CouplingR1PBin.mp_fst fun m => test (model m));
  LE.le.trans
    (Eq.mp (congrArg (fun _a => |(R0Z.mean fun r => test (runtime r)) - R0Z.mean fun m => test (model m)| ≤ _a) hmass)
      (Eq.mp
        (congrArg
          (fun _a =>
