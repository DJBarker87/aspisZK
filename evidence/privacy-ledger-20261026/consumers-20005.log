theorem R1Z.ProverCommitModelCore16.real_bad_mass : ∀ {CommitHandle Aux : Type} {F : Subfield AspisWideTower.WideExact}
  (base : R1Z.GamesR1.R1Wire AspisWideTower.WideExact CommitHandle Aux)
  (h : R0Z.JointView.HonestProver AspisWideTower.WideExact) (B : R0P.PackBasis F)
  (outputs :
    R0Z.JointView.Statement AspisWideTower.WideExact CommitHandle →
      R0Z.JointView.Challenges AspisWideTower.WideExact → Aux)
  (x : R0Z.JointView.Statement AspisWideTower.WideExact CommitHandle)
  (seed :
    R1Z.GamesR1PBin.R1ProverP AspisWideTower.WideExact CommitHandle Aux F
      (R1Z.PhaseProtocolInstanceBin.wire base (base.pubBytes x).length h B outputs x).toWire),
  (R1Z.PhaseProtocolInstanceBin.prover base (base.pubBytes x).length h B outputs x seed).toProver.E₁ ≤ 2 ^ 64 →
    (R1Z.PhaseProtocolInstanceBin.prover base (base.pubBytes x).length h B outputs x seed).toProver.E₂ ≤ 2 ^ 64 →
      ∀ (w : h.Instance),
        (R0Z.FsAbort.eventMass fun r =>
            ∃ k,
              R1Z.QueryScanRealLazyBound.realBad
                (R1Z.PhaseProtocolInstanceBin.wire base (base.pubBytes x).length h B outputs x).toWire
                (R1Z.PhaseProtocolInstanceBin.prover base (base.pubBytes x).length h B outputs x seed).toProver 8 h B
                outputs x w k r) ≤
          R1Z.QueryScanRealLazyBound.lazyBudget
              (8 *
                R1Z.GamesR1PBin.n1
                  (R1Z.PhaseProtocolInstanceBin.wire base (base.pubBytes x).length h B outputs x).toWire
                  (R1Z.PhaseProtocolInstanceBin.prover base (base.pubBytes x).length h B outputs x seed).toProver) +
            8 * R1Z.QueryScanPrivacyFinal.scanProbability :=
fun {CommitHandle Aux} {F} base h B outputs x seed counter₁ counter₂ w =>
  let W := (R1Z.PhaseProtocolInstanceBin.wire base (base.pubBytes x).length h B outputs x).toWire;
  let Pr := (R1Z.PhaseProtocolInstanceBin.prover base (base.pubBytes x).length h B outputs x seed).toProver;
  let R :=
    R1Z.RomFiniteBin.rom (R1Z.PhaseProtocolInstanceBin.baseWire base)
      (R1Z.RomGrammarBin.bound (base.pubBytes x).length);
  have hin :=
    R1Z.RomGrammarBin.address_domain (R1Z.PhaseProtocolInstanceBin.baseWire base) (base.pubBytes x).length Pr h B
      outputs x
      (R1Z.PhaseProtocolCoverageBin.read_coverage base (base.pubBytes x).length h B outputs x seed
        (Nat.le_refl (base.pubBytes x).length))
      w;
  have hc :=
    (R1Z.PremisesR1PBin.causal_iff W Pr h B outputs x w).mpr
      (R1Z.PhaseProtocolInstanceBin.causal_premise base (base.pubBytes x).length h B outputs x seed w);
  have hb :=
    R1Z.PrivacyR1Final.commit_source W Pr
      (R1Z.PrivacyR1FinalProtocol.commitment_grammar base (base.pubBytes x).length h B outputs x seed);
  R1Z.QueryScanRealLazyBound.real_bad_union_mass W Pr R 8 (of_decide_eq_true (id (Eq.refl Bool.true))) h B outputs x w
    hin hc hb counter₁ counter₂
