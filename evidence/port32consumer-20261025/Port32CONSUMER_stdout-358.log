theorem Port32CONSUMER.eq_true_of_not_eq_false : ∀ {b : Bool}, b ≠ false → b = true :=
fun {b} h =>
  Bool.casesOn (motive := fun t => b = t → b = true) b
    (fun h_1 => Eq.ndrec (motive := fun {b} => b ≠ false → b = true) (fun h => False.elim (h rfl)) (Eq.symm h_1) h)
    (fun h_1 => Eq.ndrec (motive := fun {b} => b ≠ false → b = true) (fun h => Eq.refl true) (Eq.symm h_1) h)
    (Eq.refl b)
theorem Bool.eq_true_of_not_eq_false : ∀ (b : Bool), b ≠ false → b = true :=
fun b h => Port32CONSUMER.eq_true_of_not_eq_false h
'Port32CONSUMER.eq_true_of_not_eq_false' does not depend on any axioms
'Bool.eq_true_of_not_eq_false' does not depend on any axioms
