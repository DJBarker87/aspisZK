fun {K CommitHandle Aux} [Field K] [Fintype K] [DecidableEq K] [Algebra (ZMod AspisCircleGroupOrder.P) K] {F} h P V W Pr
    R N hN B outputs x {Adv World Coins} ab adv c {Event} signal =>
  PV_OptB_Factorization.IndependentOffBad h.public signal (union h P V W Pr R N hN B outputs x ab adv c)
