⊢ (match (prover secret after).1.2 with
    | Except.ok proof =>
      ({
          attempts :=
            [{ events := before ++ (prover secret after).1.1,
                result :=
                  match (prover secret after).1.2 with
                  | Except.ok p => Step.done p
                  | Except.error AspisR1SimControl21.verifier.Error.Rejected => Step.retry
                  | Except.error e => Step.stop e }],
          result := Step.done { proof := proof, attempts := index + 1 } },
        (prover secret after).2)
    | Except.error AspisR1SimControl21.verifier.Error.Rejected =>
      ({
          attempts :=
            { events := before ++ (prover secret after).1.1,
                result :=
                  match (prover secret after).1.2 with
                  | Except.ok p => Step.done p
                  | Except.error AspisR1SimControl21.verifier.Error.Rejected => Step.retry
                  | Except.error e => Step.stop e } ::
              (run (producer callback prover) fuel (index + 1) (prover secret after).2).1.attempts,
          result := (run (producer callback prover) fuel (index + 1) (prover secret after).2).1.result },
        (run (producer callback prover) fuel (index + 1) (prover secret after).2).2)
    | Except.error e =>
      ({
          attempts :=
            [{ events := before ++ (prover secret after).1.1,
                result :=
                  match (prover secret after).1.2 with
                  | Except.ok p => Step.done p
                  | Except.error AspisR1SimControl21.verifier.Error.Rejected => Step.retry
                  | Except.error e => Step.stop e }],
          result := Step.stop e },
        (prover secret after).2)) =
    match
      match (prover secret after).1.2 with
      | Except.ok p => Step.done p
      | Except.error AspisR1SimControl21.verifier.Error.Rejected => Step.retry
      | Except.error e => Step.stop e with
    | Step.done proof =>
      ({
          attempts :=
