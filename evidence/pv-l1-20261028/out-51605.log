                result :=
                  match (prover secret after).1.2 with
                  | Except.ok p => Step.done p
                  | Except.error AspisR1SimControl21.verifier.Error.Rejected => Step.retry
                  | Except.error e => Step.stop e }],
          result := Step.done { proof := proof, attempts := index + 1 } },
        (prover secret after).2)
    | Step.stop e =>
      ({
          attempts :=
            [{ events := before ++ (prover secret after).1.1,
