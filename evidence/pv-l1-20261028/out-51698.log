    (fun fuel ih index state =>
      id
        (let ⟨pair, after, h✝⟩ := callback index state
        Eq.ndrec (motive := fun x =>
          callback index state = x →
            (match x.1.2 with
              | Except.error e =>
                ({ attempts := [{ events := x.1.1, result := R1Z.ProverCommitRetry34.Step.stop e }],
                    result := R1Z.ProverCommitRetry34.Step.stop e },
                  x.2)
