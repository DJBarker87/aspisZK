fun {A F C} c hashv n1 n2 copy allocator id H saved =>
  (∀ (initial : AspisR1.CPP_BankState.Bank) (key : ℕ) (actions : List (AspisR1.CPP_BankState.Action A)),
      (AspisV8R19.MemoizedProgramLaw.eval H
              (AspisR1.CPS_BankRecorder.program c hashv n1 n2 copy allocator id
                (AspisR1.CPR_SourceBank.afterCopy initial key saved) actions)).2.2 =
        (AspisR1.CPP_BankHistory.run n1 n2 copy allocator id (AspisR1.CPR_SourceBank.afterCopy initial key saved)
            actions).2) ∧
    (∀ (initial : AspisR1.Hist_Store.Store) (code : AspisR1.CPP_Schedule.Schedule A (AspisR1.CPP_Atomic.Reply Unit)),
        AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.CPP_Atomic.program n1 copy allocator id c hashv initial code) =
          ((AspisV8R19.MemoizedProgramLaw.eval H
                (AspisR1.CPP_Schedule.program n1 copy allocator id c hashv initial code)).1,
            AspisR1.CPP_Atomic.run n1 n2 copy allocator id H initial code)) ∧
      ∀ (initial : AspisR1.CPP_BankState.Bank) (actions : List (AspisR1.CPP_BankState.Action A)),
        AspisR1.CPR_AtomicBank.run n1 n2 copy allocator id initial actions Bool.false =
          (initial, [AspisR1.S2X.AccountEvent.rollback])
def AspisR1.Rc2_Protection.Facts : {A F C : Type} →
  AspisR1.DrvC_Installation.Configuration F C →
    AspisR1.S2W_ExtractionBoundary.First →
      AspisR1.S2W_ExtractionBoundary.Second →
        (AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
            ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record)) →
          AspisR1.S2W_D189Wrappers.Allocator A → AspisR1.S2W_ExtractionBoundary.Program → Prop :=
fun {A F C} c n1 n2 copy allocator id =>
  (AspisR1.DrvC_Installation.sdk c).op36 = AspisR1.Hist_Authority.keyEq →
    ∀ (before : AspisR1.CPP_BankState.Bank) (actions : List (AspisR1.CPP_BankState.Action A)) (success : Bool),
      AspisR1.Hist_Store.byteLedger
            (AspisR1.CPR_AtomicBank.run n1 n2 copy allocator id before actions success).1.cells =
          AspisR1.S2X.history (AspisR1.Hist_Store.byteLedger before.cells)
            (AspisR1.CPR_AtomicBank.run n1 n2 copy allocator id before actions success).2 ∧
        ∀ (key : ℕ),
          (before.cells key).owner = id →
            AspisR1.Hist_Store.Initialized (before.cells key).data →
              0 < before.lamports key →
                (∀ event ∈ (AspisR1.CPR_AtomicBank.run n1 n2 copy allocator id before actions success).2,
                    AspisR1.S2X.Preserves key event) ∧
                  (AspisR1.CPR_AtomicBank.run n1 n2 copy allocator id before actions success).1.cells key =
                      before.cells key ∧
                    before.lamports key ≤
                      (AspisR1.CPR_AtomicBank.run n1 n2 copy allocator id before actions success).1.lamports key
def AspisR1.CPH_Protection.Facts : {Tx A : Type} →
  AspisR1.CPG_Projection.Observations Tx A →
    Tx → Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8 → AspisR1.S2W_ExtractionBoundary.Program → Prop :=
fun {Tx A} p t saved id =>
  have bank :=
    AspisR1.CPR_SourceBank.afterCopy (AspisR1.CPG_Projection.cached (p.bank t)) ((p.layout t).handles 2).1 saved;
  have key := ((p.layout t).handles 2).1;
  (bank.cells key).owner = id ∧
    AspisR1.Hist_Store.Initialized (bank.cells key).data ∧
      0 < bank.lamports key ∧
        (∀ event ∈ p.physicalEvents t, AspisR1.S2X.Preserves key event) ∧
          (p.parentTentative t).cells key = bank.cells key ∧ bank.lamports key ≤ (p.parentTentative t).lamports key
