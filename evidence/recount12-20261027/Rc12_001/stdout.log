fun {W F CoreError} L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps stageBase finishOps B claimsStd program data1
    data2 slot saved post1 post2 H f s outer pre middle fs ss run prior tx2 =>
  have port :=
    AspisR1.SdkD_Child.port adapterOps (AspisR1.Uni_Install.current ops reserved queryOps geoOps)
      (AspisR1.Op5T_Concrete.stage
        (AspisR1.Tx2N_Execution.control (AspisR1.AuS1_Install.base stageBase) reserved queryOps geoOps))
      finishOps (AspisR1.F3M_CircleSource.install B) claimsStd;
  have decode := AspisR1.CPhy_Header.decode;
  have nodes := AspisR1.CPhy_Ranges.nodes f.proof s.proof;
  have y1 := AspisR1.CPhy_Ranges.y1 f.proof;
  AspisR1.S2W_AuthenticatedInputs.P2Prime H f.proof f.pub s.proof s.pub →
    AspisR1.S2W_ChildJoins.FirstEntryVerifierConeJoin f.proof →
      ∃ parsed,
        AspisR1.S2W_LeadInterface.S2CallerFacts
            (AspisR1.S2W_InputSchedule.observation f s saved nodes y1 pre middle fs ss
              (AspisR1.S2W_D189Consolidation.before e1 e2) (AspisR1.S2W_D189Consolidation.after e1 e2 post1))
            (AspisR1.S2Z.Oracle.leadDigest
              (AspisR1.ClaimsUnrolledSdk.sdkOps
                (AspisR1.Tx2I_Install.install adapterOps
                  (AspisR1.Op5T_Concrete.stage
                    (AspisR1.Tx2N_Execution.control (AspisR1.AuS1_Install.base stageBase) reserved queryOps geoOps))
                  finishOps)
                (AspisR1.Uni_Install.current ops reserved queryOps geoOps) (AspisR1.F3M_CircleSource.install B)
                claimsStd))
            () H (AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof) (AspisR1.MultiproofConeCanonical.bytesOf ↑f.pub)
            (AspisR1.MultiproofConeCanonical.bytesOf ↑saved) parsed ∧
          (∀ (site : AspisR1.S2LeadInterface.Site),
              (AspisR1.S2W_InputSchedule.observation f s saved nodes y1 pre middle fs ss
                      (AspisR1.S2W_D189Consolidation.before e1 e2)
                      (AspisR1.S2W_D189Consolidation.after e1 e2 post1)).reached
                  site ↔
                AspisR1.S2W_SiteSchedule.Event.site site ∈ AspisR1.S2W_TraceSplice.projected port outer) ∧
            AspisR1.Rc5_Cont.Outcome adapterOps ops stageBase finishOps reserved queryOps geoOps B claimsStd prior H f s
              saved run tx2
def AspisR1.FIs_Cont.Outcome : {F C : Type} →
  (adapterOps : AdapterRw.Ops) →
    (ops : AspisR1CurrentCaller.Ops) →
      (stageBase : VTop_Stages.Ops) →
        (finishOps : AspisR1Stage2.Stage2Finish.FinishOps F) →
          (reserved : Bool) →
            (queryOps : AspisR1.Port3_NativeQueryBody.Ops) →
              (geoOps : AspisR1.Port3_NativeGeometryBody.Ops C) →
                (B : AspisR1PublicPreparation.FinishModel.Boundaries) →
                  (claimsStd : AspisR1.ClaimsUnrolledFinish.StdCalls) →
                    AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes
                        AspisV8R19.SourceDuplexStep.State Unit →
                      (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
                        (f : AspisR1.S2W_NativeConsolidation.FirstCut) →
                          AspisR1.S2W_NativeConsolidation.SecondCut →
                            (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8) →
                              AspisR1.Tx1Q_Execution.Run
                                  (AspisR1.Tx1Q_Execution.actual (AspisR1.Op5T_Concrete.current ops) reserved queryOps
                                    geoOps (AspisR1.F3M_CircleSource.install B) claimsStd)
                                  reserved queryOps geoOps
                                  (AspisR1.SdkD_PairBatches.current adapterOps ops stageBase finishOps reserved queryOps
                                    geoOps (AspisR1.F3M_CircleSource.install B) claimsStd)
                                  () (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.pub f.proof f.split saved →
                                AspisR1.Cons_Native.Witness → Prop :=
fun {F C} adapterOps ops stageBase finishOps reserved queryOps geoOps B claimsStd prior H f s saved run tx2 =>
  ∃ authParsed frame,
    AspisR1.OraclePortCompactDraft.parse (AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof) = Option.some authParsed ∧
      FS2.Duplex.Read
          ((AspisV8R19.MemoizedProgramLaw.eval H prior).1 ++
