  AspisR1.DrvC_Installation.Configuration F C → AspisR1.F3T_ByteCarrier.Submission → AspisR1.LiteralTranscript.Public :=
fun {F C} c s =>
  match AspisR1.Port1_Driver.asSlice s.publicBytes with
  | Option.none => AspisR1.F3T_ByteCarrier.publicOf []
  | Option.some pub =>
    match AspisR1.Port1_Driver.decodeSemantic (AspisR1.DrvC_Installation.sdk c) pub with
    | Aeneas.Std.Result.ok (Option.some v) =>
      match
        AspisR1PublicPreparation.pool_v1.pair_forest_semantic_terminal.r0.Public.public_bytes
          (AspisR1CurrentCaller.FirstComposition.toRetainedPublic (AspisS6CurrentVerifierCarrier.toPublic v)) with
      | Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok encoded) =>
        AspisR1.F3T_ByteCarrier.publicOf (AspisR1.MultiproofConeCanonical.bytesOf ↑encoded)
      | x => AspisR1.F3T_ByteCarrier.publicOf []
    | x => AspisR1.F3T_ByteCarrier.publicOf []
