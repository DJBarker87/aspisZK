    ∀ (physical : AspisR1.F3T_Runtime.Runtime),
      AspisR1.NIN_Observer.OuterTrace copy allocator base err r hashv a physical →
        AspisR1.NIN_Observer.AdmittedSupport L copy allocator base err r n1 n2 hashv a physical →
          AspisR1.NIN_Observer.NestedEvents copy allocator base err r hashv a physical →
            AspisR1.NIN_Observer.CanonicalInput copy allocator base err r hashv a physical →
              AspisR1.NIN_Observer.LiteralFlag copy allocator base err r hashv a physical →
                AspisR1.NHZ_EXPERIMENT.Realizes L copy allocator base err r n1 n2 hashv a physical :=
fun {W A C Tx} L copy allocator base err r n1 n2 hashv a extraction physical outer admission nested canonical flag =>
  AspisR1.NHZ_EXPERIMENT.realizes_from_fields L copy allocator base err r n1 n2 hashv a extraction physical outer
