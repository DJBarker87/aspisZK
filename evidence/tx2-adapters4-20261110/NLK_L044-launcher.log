  (child : Payload → core.result.Result A AdapterRw.solana_program_error.ProgramError),
  (NLK_ProgramBorrowScope.run p a fun b => ok (child b)) =
    have r := NLF_SnapshotEvents.step p a;
    { parent := r.1,
      result :=
