theorem NLK_PdaAbi.complete_input : ∀ (a b : Input), WindowEq a b → a = b :=
fun a b cut =>
  have seeds :=
    List.ext_getElem cut.left fun i ha hb =>
      List.ext_getElem (cut.right.left i ha hb).left fun j hja hjb => (cut.right.left i ha hb).right j hja hjb;
  have program := funext cut.right.right;
  let ⟨seeds✝, program✝, h✝⟩ := a
  Eq.ndrec (motive := fun a => WindowEq a b → a.seeds = b.seeds → a.program = b.program → a = b)
    (fun cut seeds program =>
      let ⟨seeds✝¹, program✝¹, h✝¹⟩ := b
      Eq.ndrec (motive := fun b =>
        WindowEq { seeds := seeds✝, program := program✝ } b →
          { seeds := seeds✝, program := program✝ }.seeds = b.seeds →
            { seeds := seeds✝, program := program✝ }.program = b.program → { seeds := seeds✝, program := program✝ } = b)
        (fun cut seeds program =>
          let ⟨⟩ := { seeds := seeds✝¹, program := program✝¹ }.seeds
          seeds)
        (Eq.symm h✝¹) cut seeds program)
    (Eq.symm h✝) cut seeds program
