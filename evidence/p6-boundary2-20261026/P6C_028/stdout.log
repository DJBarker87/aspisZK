        AspisR1.S2W_NativeConsolidation.FirstCut → AspisR1.S2W_NativeConsolidation.SecondCut → Prop :=
fun {F C} c hashv H f s =>
  ∃ p0 root0 p2 root2,
    AspisR1.P6C_Pair.Safe hashv H (AspisR1.SdkC_BatchSource.currentCode hashv f.proof p0 root0)
        (Aeneas.Std.core.result.Result.Ok ()) ∧
      AspisR1.P6C_Pair.Safe hashv H (AspisR1.SdkC_BatchSource.stageCode hashv s.proof p2 root2)
          (Aeneas.Std.core.result.Result.Ok ()) ∧
        AspisR1.SdkC_Source.run (AspisR1.P6C_Batches.extended hashv H)
              (AspisR1.SdkC_BatchSource.currentCode (AspisR1.P6C_Batches.extended hashv H) f.proof p0 root0) [] =
            AspisR1.SdkC_Source.run hashv (AspisR1.SdkC_BatchSource.currentCode hashv f.proof p0 root0) [] ∧
          AspisR1.SdkC_Source.run (AspisR1.P6C_Batches.extended hashv H)
              (AspisR1.SdkC_BatchSource.stageCode (AspisR1.P6C_Batches.extended hashv H) s.proof p2 root2) [] =
            AspisR1.SdkC_Source.run hashv (AspisR1.SdkC_BatchSource.stageCode hashv s.proof p2 root2) []
