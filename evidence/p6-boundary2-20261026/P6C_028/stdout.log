    MultiproofConeRef.aspis_core.digest.Digest32 Unit :=
fun hashv H =>
  { coremarkerCopyInst := { cloneInst := { clone := fun x => Aeneas.Std.Result.ok x } },
    digest := fun x parts => Aeneas.Std.Result.ok (AspisR1.P6C_Extension.total hashv H parts) }
def AspisR1.P6C_Pair.Safe : {A : Type} →
  (AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest) →
    (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) → AspisR1.SdkC_Source.Code A → A → Prop :=
fun {A} hashv H code value =>
  AspisR1.SdkC_BatchPair.Returning hashv H code value ∧
    (∀ q ∈ (AspisR1.SdkC_Source.run hashv code []).2,
        ∃ digest, q.returned = Aeneas.Std.Result.ok digest ∧ hashv q.parts = Aeneas.Std.Result.ok digest) ∧
      AspisR1.SdkC_Source.run (fun parts => Aeneas.Std.Result.ok (AspisR1.P6C_Extension.total hashv H parts)) code [] =
        AspisR1.SdkC_Source.run hashv code []
