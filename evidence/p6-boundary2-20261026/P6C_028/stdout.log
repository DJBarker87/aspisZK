    AspisR1.SdkC_Source.Parts → AspisR1.SdkC_Source.Digest :=
fun hashv H parts =>
  match hashv parts with
  | Aeneas.Std.Result.ok digest => digest
  | x => AspisR1.MultiproofConePhysicalTransport.rawOracle H parts
