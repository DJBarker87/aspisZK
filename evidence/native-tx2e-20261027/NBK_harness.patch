+use super::*;
+// Exact source store expression, specialized by position after NBH range gates.
+fn NBK_store<const N:usize,const START:usize>(out:&mut[u8;N],bytes:[u8;32]) {
+    out[START..START+32].copy_from_slice(&bytes);
+}
+#[kani::proof]
+fn NBK_store688_00() {
+ let mut out:[u8;688]=kani::any(); let old=out; let bytes:[u8;32]=kani::any();
+ let j:usize=kani::any();kani::assume(j<688);
+ NBK_store::<688,48>(&mut out,bytes);
+ assert_eq!(out[j],if j>=48 && j<80 {bytes[j-48]} else {old[j]});
+}
