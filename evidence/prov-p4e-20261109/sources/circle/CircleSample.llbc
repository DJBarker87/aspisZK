{"charon_version":"0.1.223","translated":{"crate_name":"r1_circle_sample_wrapper_extraction","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::sampler::circle_sample"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["core::option::Option","core::result::Result"],"opaque":["crate::sampler::qm31_sample","crate::circle::secure_ood_circle_point_from_parameter","crate::transcript::circle_fallback_point"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/r1-circle-sample-wrapper-extraction-v2/CircleSample.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"lib.rs"},"crate_name":"r1_circle_sample_wrapper_extraction","contents":"#![no_std]\nextern crate self as aspis_core;\n\npub mod field {\n/// M31 base field element, canonical representation in [0, P).\n#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]\npub struct M31(pub u32);\n/// CM31 = M31[i] / (i^2 + 1). Element a + b*i.\n#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]\npub struct CM31 {\n    pub a: M31,\n    pub b: M31,\n}\n/// QM31 = CM31[u] / (u^2 - (2 + i)). Element c0 + c1*u. (stwo parameterization)\n#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]\npub struct QM31 {\n    pub c0: CM31,\n    pub c1: CM31,\n}\n }\n\npub mod circle {\n    use crate::field::QM31;\n/// A point `(x, y)` on `x^2 + y^2 = 1` over QM31.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct SecureCirclePoint {\n    pub x: QM31,\n    pub y: QM31,\n}\n/// Rejection reasons for the rational parameterization.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum CirclePointError {\n    /// `1 + t^2 = 0`, so the rational map has no finite value.\n    SingularParameter,\n    /// OOD policy rejects the whole CM31 parameter subfield. This is stronger\n    /// than merely excluding the M31 circle domain and matches the existing\n    /// line-point policy of sampling from `QM31 \\ CM31`.\n    ParameterInCm31Subfield,\n}\n    pub fn secure_ood_circle_point_from_parameter(\n        _parameter: QM31,\n    ) -> Result<SecureCirclePoint, CirclePointError> {\n        unreachable!()\n    }\n}\n\npub mod r0_transcript {\n/// Selects the existing row fallback: parameter u for row 25, 1+u for 26.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum CircleRow {\n    First,\n    Second,\n}\n }\n\npub mod transcript {\n    use crate::circle::SecureCirclePoint;\n    pub fn circle_fallback_point(_sample: usize) -> SecureCirclePoint {\n        unreachable!()\n    }\n}\n\npub mod sampler {\n    use crate::circle::{secure_ood_circle_point_from_parameter, SecureCirclePoint};\n    use crate::field::QM31;\n    pub use crate::r0_transcript::CircleRow;\n    pub fn qm31_sample(_block: &[u8; 32]) -> QM31 {\n        unreachable!()\n    }\npub fn circle_sample(block: &[u8; 32], row: CircleRow) -> SecureCirclePoint {\n    secure_ood_circle_point_from_parameter(qm31_sample(block)).unwrap_or_else(|_| {\n        aspis_core::transcript::circle_fallback_point(match row {\n            CircleRow::First => 0,\n            CircleRow::Second => 1,\n        })\n    })\n}\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/ops/function.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ptr/mod.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["r1_circle_sample_wrapper_extraction",0]},{"Ident":["sampler",0]},{"Ident":["circle_sample",0]}]},{"key":{"Type":0},"value":[{"Ident":["r1_circle_sample_wrapper_extraction",0]},{"Ident":["r0_transcript",0]},{"Ident":["CircleRow",0]}]},{"key":{"Type":1},"value":[{"Ident":["r1_circle_sample_wrapper_extraction",0]},{"Ident":["circle",0]},{"Ident":["SecureCirclePoint",0]}]},{"key":{"Type":2},"value":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}]},{"key":{"Type":3},"value":[{"Ident":["r1_circle_sample_wrapper_extraction",0]},{"Ident":["circle",0]},{"Ident":["CirclePointError",0]}]},{"key":{"Type":4},"value":[{"Ident":["r1_circle_sample_wrapper_extraction",0]},{"Ident":["field",0]},{"Ident":["QM31",0]}]},{"key":{"Type":5},"value":[{"Ident":["r1_circle_sample_wrapper_extraction",0]},{"Ident":["sampler",0]},{"Ident":["circle_sample",0]},{"Ident":["closure",0]}]},{"key":{"TraitImpl":0},"value":[{"Ident":["r1_circle_sample_wrapper_extraction",0]},{"Ident":["sampler",0]},{"Ident":["circle_sample",0]},{"Impl":{"Trait":0}}]},{"key":{"Fun":1},"value":[{"Ident":["r1_circle_sample_wrapper_extraction",0]},{"Ident":["sampler",0]},{"Ident":["qm31_sample",0]}]},{"key"