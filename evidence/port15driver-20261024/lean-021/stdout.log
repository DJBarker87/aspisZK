def AspisR1.Port15DRIVER_Local.LocalBudgets : Implementation → (ℕ → ℕ) → Prop :=
fun rest w =>
  ∀ {A : Type} (op : Call A) (H : Bytes → State),
    operationId op ∈ delegatedIds → (eval H (rest op)).1.length ≤ w (operationId op)
def AspisR1.Port15DRIVER_Local.delegatedIds : List ℕ :=
[3, 4, 6, 7, 9, 10, 11, 12, 17, 19]
def AspisR1.Port15DRIVER_Driver.delegatedWeight : (ℕ → ℕ) → ℕ :=
fun w => 2 * w 3 + w 4 + 2 * w 6 + w 7 + 2 * w 9 + 2 * w 10 + 2 * w 11 + w 12 + w 17 + w 19
def AspisR1.Port15DRIVER_TX1.sites : (ℕ → ℕ) → List ℕ :=
fun w => [0, w 3, w 4, 0, 0, w 7, w 12, 0, 0, 0, 0, 477, 0, w 11, w 10, w 6, w 9, 3, 0]
def AspisR1.Port15DRIVER_Driver.sites : (ℕ → ℕ) → List ℕ :=
fun w => [w 3, 0, 3, 0, w 17, 0, 0, 0, 0, 0, 0, 0, 0, 563, 0, w 11, w 10, w 6, w 9, 0, 0, w 19]
def AspisR1.Port1_Driver.stages : Implementation →
  {Hash : Type} →
    aspis_core.digest.Digest32 Hash → Hash → Port1_Driver.Semantic → Slice U8 → Slice U8 → Program Bytes State Bool :=
fun impl {Hash} D hash semantic pub proof =>
  AspisV8R19.OracleProgramOps.bind
    (interpret (fun {A} => impl) (VTop_Flow.tx1 VTop_Flow.traceEffects D semantic pub proof 10#usize hash none))
    fun first =>
    match first with
    | ok (core.result.Result.Ok saved) =>
      AspisV8R19.OracleProgramOps.bind
        (interpret (fun {A} => impl)
          (VTop_Flow.tx2_authenticated VTop_Flow.traceEffects D pub proof saved.deref hash none))
        fun second => Program.done (Port1_Driver.verdict second)
    | x => Program.done false
def AspisR1.Port1_Driver.rust : AdapterRw.Ops →
  Implementation → {Hash : Type} → aspis_core.digest.Digest32 Hash → Hash → OraclePortRuntimeBindingC7.Verifier :=
fun adapter impl {Hash} D hash i =>
  match Port1_Driver.asSlice i.statement.pubBytes, Port1_Driver.asSlice i.stored with
  | some pub, some proof =>
    match Port1_Driver.decodeSemantic adapter pub with
    | ok (some semantic) => Port1_Driver.stages (fun {A} => impl) D hash semantic pub proof
    | x => Program.done false
  | x, x_1 => Program.done false
