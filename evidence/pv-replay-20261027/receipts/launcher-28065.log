          {F : Subfield K} →
            {Bat : Type} →
              [BatchedLayer K Bat] →
                (Challenges K → Prop) → HonestProver K → PackBasis F → Statement K CommitHandle → Prop :=
fun {K CommitHandle} [Field K] [Fintype K] [DecidableEq K] [Algebra (ZMod AspisCircleGroupOrder.P) K] {F} {Bat}
    [BatchedLayer K Bat] P h B x =>
  (∀ (ch : Challenges K),
      P ch →
        ∀ (w : h.Instance) (n : N K F), h.public w = x.1 → sRem h B x w ch n ∈ (A h.transport B ch ∘ₗ inlM).range) ∧
