theorem AspisR1.Rc10_Top.deployed : ∀ {W A CoreError Tx : Type} (L : S2Trust.Library W (ℕ → S2W_D189Entry.Record)),
  S2Trust.S2TrustedSdkBorrow L →
    ∀
      (copy :
        S2Trust.Heap (ℕ → S2W_D189Entry.Record) →
          ℕ → S2Trust.Payload → S2W_TrustedStd.Outcome (ℕ → S2W_D189Entry.Record)),
      S2W_TrustedStd.TrustedStd copy →
        ∀ (allocator : S2W_D189Wrappers.Allocator A) (e1 e2 : S2W_D189Entry.Entry) (w1 w2 : W),
          S2W_D189Consolidation.RuntimeEntrypointAdmission L e1 w1 3 →
            S2W_D189Consolidation.RuntimeEntrypointAdmission L e2 w2 7 →
              ∀ (c : DrvC_Installation.Configuration FIo_Install.W CoreError) (indexError : CoreError)
                (reservation : NP6_StdModel.Reservation) (native1 : S2W_ExtractionBoundary.First)
                (native2 : S2W_ExtractionBoundary.Second)
                (hashv : S2Z.Oracle.Parts → Aeneas.Std.Result S2Z.Oracle.Digest),
                S2W_DigestExtraction.AeneasExtraction
                    (DrvC_Installation.sdk (FIp_Install.configuration indexError c reservation)) native1 native2 hashv →
                  ∀ (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
                    S2W_ExtractionBoundary.P1 sha256 H →
                      S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
                        ∀ (data1 data2 : Aeneas.Std.Slice Aeneas.Std.U8) (slot : S2W_ExtractionBoundary.Slot)
                          (state1 state2 final1 final2 : A) (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
                          (post1 post2 : S2Trust.Heap (ℕ → S2W_D189Entry.Record)),
                          S2W_D189Wrappers.first native1 copy allocator e1 CPH_Program.verifier data1 state1 =
                              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post1, final1)) →
                            S2W_D189Wrappers.second native2 allocator e2 CPH_Program.verifier data2 slot state2 =
                                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (post2, final2)) →
                              ∀ (root : Aeneas.Std.Array Aeneas.Std.U8 32#usize) (length : Aeneas.Std.U32)
                                (prior :
                                  AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes
                                    AspisV8R19.SourceDuplexStep.State Unit)
                                (words : CanonicalCutEnrichedTranscript.Words) (p : CPG_Projection.Observations Tx A)
                                (t u : Tx) (actions : List (CPP_BankState.Action A)),
                                CPH_Game.DeployedPairExecution p t u e1 e2 saved actions native1 native2 copy allocator
                                    CPH_Program.verifier →
                                  CPR_DataPersistence.TwoTransactionLaw (CPG_Projection.adjacent p)
                                      (CPG_Projection.ordinary p (Hist_Nonvacuity.key 0#u8)) (CPG_Projection.before p)
                                      (CPG_Projection.tentative p) (CPG_Projection.success p)
                                      (CPG_Projection.loaded p) →
                                    ∀ (D : LiteralByteProtocol.Decoder) (P : F3T_ByteCarrier.ByteProver) (Q0 Q1 : ℕ),
                                      (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
                                          (AspisV8R19.MemoizedProgramLaw.eval H P).1.length ≤ Q0 + Q1) →
                                        ∀ (runtime : F3T_Runtime.Runtime),
                                          FIp_GlobalOwners.Owners (FIp_Install.configuration indexError c reservation)
                                              (Rc2_Install.configuration
                                                  (Rc5_Install.seed indexError (FIp_Install.select reservation c))
                                                  reservation).boundaries →
                                            F3T_Runtime.StoredCarrierBinding
                                                (FIp_Install.configuration indexError c reservation) D
                                                (F3T_Installed.source
                                                  (FIp_Install.configuration indexError c reservation) hashv)
                                                P runtime →
                                              have select := fun x =>
                                                P2P_NativeSelection.pair
                                                  (DrvC_Installation.sdk
                                                    (FIp_Install.configuration indexError c reservation))
                                                  CPH_Program.verifier e1 e2 data2 slot;
                                              MultiproofConeP6Frozen2Stage.P6Boundary (P6C_Extension.dictionary hashv H)
                                                  () H Op5T_P6.parent Op5T_P6.parent Op5T_P6.parent
                                                  MultiproofConeP6Batch.referenceLeaf ∧
                                                DrvC_Implementation.driver
                                                      (FIp_Install.configuration indexError c reservation) =
                                                    DrvC_SourceEntry.source
                                                      (FIp_Install.configuration indexError c reservation) hashv ∧
                                                  DrvC_Installation.sdk
                                                        (FIp_Install.configuration indexError c reservation) =
                                                      SdkD_PairBatches.dictionary
                                                        (FIp_Install.configuration indexError c reservation).adapter
                                                        (FIp_Install.configuration indexError c reservation).currentBase
                                                        (FIp_Install.configuration indexError c reservation).stageBase
                                                        (FIp_Install.configuration indexError c reservation).finish
                                                        (FIp_Install.configuration indexError c reservation).reserved
                                                        (FIp_Install.configuration indexError c reservation).query
                                                        (FIp_Install.configuration indexError c reservation).geometry
                                                        (FIp_Install.configuration indexError c reservation).boundaries
                                                        (FIp_Install.configuration indexError c reservation).std ∧
                                                    FIs_Result.Outcome L e1 e2 w1 w2
                                                        (FIp_Install.configuration indexError c reservation).adapter
                                                        (FIp_Install.configuration indexError c reservation).currentBase
                                                        (FIp_Install.configuration indexError c reservation).reserved
                                                        (FIp_Install.configuration indexError c reservation).query
                                                        (FIp_Install.configuration indexError c reservation).geometry
                                                        (FIp_Install.configuration indexError c reservation).stageBase
                                                        (FIp_Install.configuration indexError c reservation).finish
                                                        (FIp_Install.boundaries c.boundaries) reservation
                                                        CPH_Program.verifier data1 data2 slot saved post1 post2 H
                                                        (DrvC_Implementation.driver
                                                          (FIp_Install.configuration indexError c reservation))
                                                        prior (p.physicalEvents t) hashv
                                                        (BinRawByteCollisionTargets.event
                                                          SelectedTranscriptParams.params.iv (Q0 + Q1 + 2965)
                                                          (AspisV8R19.MemoizedProgramLaw.eval H
                                                            (Hiq_RecordedJoint.program
                                                              (F3X_Account.program
                                                                (FIp_Install.configuration indexError c reservation)
                                                                hashv P)
                                                              F3X_Projection.project select))) ∧
                                                      (F3X_ModelClaims.Claims
                                                            (FIp_Install.configuration indexError c reservation) D P
                                                            (Q0 + Q1) ∧
                                                          F3Y_SourceClaims.Claims
                                                              (FIp_Install.configuration indexError c reservation) D
                                                              hashv P (Q0 + Q1) select ∧
                                                            ⋯) ∧
                                                        (native1 CPH_Program.verifier e1.first data1 =
                                                              Aeneas.Std.Result.ok
                                                                (Aeneas.Std.core.result.Result.Ok saved) ∧
                                                            ⋯) ∧
                                                          ⋯ ∧ ⋯ :=
fun {W A CoreError Tx} L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 c indexError reservation native1
    native2 hashv extraction sha256 H p1 syscall data1 data2 slot state1 state2 final1 final2 saved post1 post2
    accepted1 accepted2 root length prior words p t u actions game RuntimePersistence D P Q0 Q1 queries runtime
    finishOwners binding =>
  let ⟨p6, right✝⟩ :=
    FIs_Top.deployed L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 c indexError reservation native1 native2
      hashv extraction sha256 H p1 syscall data1 data2 slot state1 state2 final1 final2 saved post1 post2 accepted1
      accepted2 root length prior words p t u actions game RuntimePersistence D P Q0 Q1 queries runtime finishOwners
      binding
  let ⟨driver, right✝¹⟩ := right✝
  let ⟨sdkEq, right✝²⟩ := right✝¹
  let ⟨result, right✝³⟩ := right✝²
  let ⟨security, right✝⁴⟩ := right✝³
  let ⟨copyFacts, right✝⁵⟩ := right✝⁴
  let ⟨events, right✝⁶⟩ := right✝⁵
  let ⟨protection, right✝⁷⟩ := right✝⁶
  let ⟨trace, right✝⁸⟩ := right✝⁷
  let ⟨recorder, s6⟩ := right✝⁸
  ⟨p6, ⟨driver, ⟨sdkEq, ⟨result, ⟨security, ⟨copyFacts, ⟨events, ⟨protection, ⟨trace, ⟨recorder, s6⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩
'AspisR1.Rc10_Top.deployed' depends on axioms: [propext, Classical.choice, Quot.sound]
