theorem NJI_PolicyCut.native_source : ∀ (b : Slice U8) (len : (↑b).length = 104) (log : Option P)
  (out : core.result.Result P F), Cut b (closedReply b len) log out → ok out = NJI_PolicyParser.raw b :=
fun b len log out cut =>
  Eq.mpr (id (congrArg (fun _a => ok out = _a) (NJI_PolicyParser.source b)))
    (Eq.mpr (id (congrArg (fun _a => ok out = _a) (body_closed b len)))
      (congrArg ok (cut_result b len (closedReply b len) log out cut)))
