+use super::*;
+include!(concat!(env!("CARGO_MANIFEST_DIR"),"/../../KMX_stubs.rs"));
+type F=PoolV1FormatError;
+fn read32(b:&[u8],a:usize)->[u8;32]{[b[a+0],b[a+1],b[a+2],b[a+3],b[a+4],b[a+5],b[a+6],b[a+7],b[a+8],b[a+9],b[a+10],b[a+11],b[a+12],b[a+13],b[a+14],b[a+15],b[a+16],b[a+17],b[a+18],b[a+19],b[a+20],b[a+21],b[a+22],b[a+23],b[a+24],b[a+25],b[a+26],b[a+27],b[a+28],b[a+29],b[a+30],b[a+31]]}
+
+pub(super) fn decode_ref(b:&[u8])->Result<VerifierPolicyV1,F>{
+ if b.len()!=104{return Err(F::WrongLength)}
+ if b[..4]!=POOL_V1_VERIFIER_POLICY_MAGIC{return Err(F::WrongMagic)}
+ if b[4]!=POOL_V1_VERIFIER_POLICY_VERSION{return Err(F::WrongVersion)}
+ if b[6..8]!=[0;2]{return Err(F::NonZeroReserved)}
+ let p=VerifierPolicyV1{flags:b[5],registry_program:read32(b,8),registry_authority:read32(b,40),policy_binding:read32(b,72)};
+ if p.flags & !3 !=0{return Err(F::UnsupportedFlags)}
+ if p.registry_program==[0;32]||p.policy_binding==[0;32]{return Err(F::ZeroRequiredBinding)}
+ let immutable=p.flags & 1 !=0;let deployment=p.flags & 2 !=0;
+ if deployment&&!immutable{return Err(F::InvalidAuthorityMode)}
+ if immutable!=(p.registry_authority==[0;32]){return Err(F::InvalidAuthorityMode)}
+ Ok(p)
+}
+#[kani::proof_for_contract(super::decode_verifier_policy_v1)]
+#[kani::unwind(35)]
+#[kani::stub(core::ptr::copy_nonoverlapping,KMX_copy_nonoverlapping)]
+fn decode_contract(){let b:[u8;104]=kani::any();let _=super::decode_verifier_policy_v1(&b);}
