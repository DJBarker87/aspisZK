+fn frontier_enumerate(){let nodes=[digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest()];let level:usize=kani::any();kani::assume(level<=20);let mut iter=nodes.iter().enumerate();if level>0{let _=iter.nth(level-1);}let next=iter.next();if level<20{let(count,node)=next.unwrap();assert!(count==level && core::ptr::eq(node,&nodes[level]),"actual frontier Enumerate count and node");assert!(iter.len()==19-level);}else{assert!(next.is_none()&&iter.len()==0);}}
