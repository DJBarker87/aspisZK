+fn encode_prefix(){let s=PoolV1PairLiveSnapshotV1{pool:kani::any(),deployment_domain:kani::any(),sequence:kani::any(),next_pair_index:kani::any(),current_root:digest(),frontier:[digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest()]};let length:usize=kani::any();let mut f=Frame{expected:&s,reply:if kani::any(){Ok(())}else{Err(any_error())},called:false,reached:false};let actual=prefix(&s,length,&mut f);let expected=if length!=800{Err(PoolV1PairLiveSnapshotErrorV1::WrongLength)}else{f.reply};assert!(actual==expected && f.called==(length==800) && f.reached==actual.is_ok(),"exact encoder rejection prefix and untouched-output continuation");}
