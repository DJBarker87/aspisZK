+use super::*;
+use aspis_core::field::M31;
+use crate::Digest;
+struct Frame<'a>{start:usize,end:usize,expected:&'a Digest,reply:bool,called:bool}
+fn child(d:&Digest,f:&mut Frame)->bool{assert!(!f.called&&core::ptr::eq(d,f.expected),"same actual frontier scanner argument");f.called=true;f.reply}
+fn step(s:&PoolV1PairLiveSnapshotV1,f:&mut Frame)->Result<(),PoolV1PairLiveSnapshotErrorV1>{
+ let mut level=f.start;
+ while level<s.frontier.len(){
+  if !child(&s.frontier[level],f){return Err(PoolV1PairLiveSnapshotErrorV1::NonCanonicalDigest);}
+  level+=1;f.end=level;return Ok(());
+ }
+ Ok(())
+}
+fn digest()->Digest{[M31(kani::any()),M31(kani::any()),M31(kani::any()),M31(kani::any()),M31(kani::any()),M31(kani::any()),M31(kani::any()),M31(kani::any())]}
+#[kani::proof]
+#[kani::unwind(2)]
+fn frontier_validator(){let s=PoolV1PairLiveSnapshotV1{pool:kani::any(),deployment_domain:kani::any(),sequence:kani::any(),next_pair_index:kani::any(),current_root:digest(),frontier:[digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest(),digest()]};let start:usize=kani::any();kani::assume(start<=20);let expected=&s.frontier[if start<20{(start+1)%20}else{0}];let mut f=Frame{start,end:start,expected,reply:kani::any(),called:false};let r=step(&s,&mut f);assert!(r==if start<20&&!f.reply{Err(PoolV1PairLiveSnapshotErrorV1::NonCanonicalDigest)}else{Ok(())},"full loop-step Result");assert!(f.called==(start<20) && f.end==if start<20&&f.reply{start+1}else{start},"same step cursor and ordered child count");}
