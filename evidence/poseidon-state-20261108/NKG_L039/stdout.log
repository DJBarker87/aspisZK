theorem AspisR1.NKG_PreparedRaw.source : ∀ (w : Three) (p : Prepared),
  FIq_Native.core.array.Array.map (BuiltinFnMut NQ NP) w field.PreparedQm31Multiplier.new = ok p → p = model w :=
fun w p run =>
  have rel :=
    FJa_MapRelation.value (BuiltinFnMut NQ NP) (fun x y => field.PreparedQm31Multiplier.new x = ok y) w
      field.PreparedQm31Multiplier.new p
      (fun x hx y last called =>
        id
          (fun called =>
            let ⟨z, h✝⟩ :=
              FIv_Map.bind_success (field.PreparedQm31Multiplier.new x)
                (fun z => ok (z, field.PreparedQm31Multiplier.new)) (y, last) called
            let ⟨rz, called⟩ := h✝
            let ⟨left✝, right✝⟩ := Prod.mk.inj (ok.inj called)
            Eq.ndrec (motive := fun y =>
              (do
                    let z ← field.PreparedQm31Multiplier.new x
                    ok (z, field.PreparedQm31Multiplier.new)) =
                  ok (y, last) →
                ok (z, field.PreparedQm31Multiplier.new) = ok (y, last) →
                  field.PreparedQm31Multiplier.new x = ok y ∧ last = field.PreparedQm31Multiplier.new)
              (fun called called_1 =>
                Eq.ndrec (motive := fun last =>
                  (do
                        let z ← field.PreparedQm31Multiplier.new x
                        ok (z, field.PreparedQm31Multiplier.new)) =
                      ok (z, last) →
                    ok (z, field.PreparedQm31Multiplier.new) = ok (z, last) →
                      field.PreparedQm31Multiplier.new x = ok z ∧ last = field.PreparedQm31Multiplier.new)
                  (fun called called_2 => ⟨rz, rfl⟩) right✝ called called_1)
              left✝ called called)
          called)
      run;
  Subtype.ext
    (List.ext_getElem
      (Eq.mpr (id (congrArg (fun _a => _a = (↑(model w)).length) p.property))
        (Eq.mpr (id (congrArg (fun _a => ↑3#usize = _a) (model w).property)) (Eq.refl ↑3#usize)))
      fun j hj hk =>
      have h3 := Eq.mp (congrArg (LT.lt j) p.property) hj;
      let i := ⟨j, h3⟩;
      have called := FJh_MapCells.get rel j (Eq.mpr (id (congrArg (LT.lt j) w.property)) h3) hj;
      Eq.mpr
        (id
          (congrArg (Eq (↑p)[j])
            (List.getElem_ofFn
              (id
                  (Eq.refl
                    (List.ofFn fun i =>
                      NKG_InternalChoices.get (field.PreparedQm31Multiplier.new (↑w)[↑i]) zeroPrepared)) ▸
                Eq.refl j ▸ hk))))
        (Eq.symm (get_ok (field.PreparedQm31Multiplier.new (cell w i)) zeroPrepared (cell p i) called)))
'AspisR1.NKG_PreparedRaw.source' depends on axioms: [propext, Classical.choice, Quot.sound]
