theorem AspisR1.NKG_HelperDomains.internal : ∀ (s l : State) (weights : Fin 2 → NKG_HelperCuts.Seven)
  (constants : Fin 2 → NKG_HelperCuts.Constants7) (dots : Fin 2 → NQ) (states replies : Fin 2 → State)
  (factors : Fin 2 → NQ) (out : State) (dotCalls roundCalls : ℕ),
  canonical l →
    NKG_HelperCuts.Internal s l weights constants dots states replies factors out dotCalls roundCalls →
      ∀ (c : Fin 2), canonical (weights c) ∧ ∀ (i : Fin ↑7#usize), ↑(cell (constants c) i) < P :=
fun s l weights constants dots states replies factors out dotCalls roundCalls hl cut c =>
  ⟨fun x hx =>
    let ⟨j, h✝⟩ := List.getElem_of_mem hx
    let ⟨hj, h✝¹⟩ := h✝
    Eq.ndrec (motive := fun x => x ∈ ↑(weights c) → Canon x)
      (fun hx =>
        have h7 := Eq.mp (congrArg (LT.lt j) (weights c).property) hj;
        id
          (Eq.mpr (id (congrArg (fun _a => Canon _a) (cut.weightArgs c ⟨j, h7⟩)))
            (hl
              (cell l
                ⟨↑⟨j, h7⟩ + 2,
                  have hi := ⟨j, h7⟩.isLt;
                  id
                    (Decidable.byContradiction fun a =>
                      NKG_HelperCuts.Internal._proof_1 dotCalls roundCalls ⟨j, h7⟩ hi a)⟩)
              (List.getElem_mem
                (cell._proof_1 l
                  ⟨↑⟨j, h7⟩ + 2,
                    have hi := ⟨j, h7⟩.isLt;
                    id
                      (Decidable.byContradiction fun a =>
                        NKG_HelperCuts.Internal._proof_1 dotCalls roundCalls ⟨j, h7⟩ hi a)⟩)))))
      h✝¹ hx,
    fun i =>
    Eq.mpr (id (congrArg (fun _a => ↑_a < P) (cut.constantArgs c i)))
      (FJh_InternalConstants.canonical
        ⟨2 * ↑i + ↑c,
          have hi := i.isLt;
          have hc := c.isLt;
          Decidable.byContradiction fun a => NKG_HelperCuts.Internal._proof_2 dotCalls roundCalls c i hi hc a⟩)⟩
'AspisR1.NKG_HelperDomains.internal' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NKG_HelperDomains.full : ∀ (s l : State) (weights : Fin 2 → Std.Array NQ 3#usize)
  (columns : Fin 2 → Fin 3 → Std.Array U32 16#usize) (replies states constants : Fin 2 → State) (middle : State)
  (packed out : NKG_HelperCuts.Packed) (columnCalls roundCalls : ℕ),
  canonical l →
    NKG_HelperCuts.Full s l weights columns replies states constants middle packed out columnCalls roundCalls →
      ∀ (c : Fin 2), canonical (weights c) ∧ ∀ (i : Fin 3) (k : Fin ↑16#usize), ↑(cell (columns c i) k) < P :=
fun s l weights columns replies states constants middle packed out columnCalls roundCalls hl cut c =>
  ⟨fun x hx =>
    let ⟨j, h✝⟩ := List.getElem_of_mem hx
    let ⟨hj, h✝¹⟩ := h✝
    Eq.ndrec (motive := fun x => x ∈ ↑(weights c) → Canon x)
      (fun hx =>
        have h3 := Eq.mp (congrArg (LT.lt j) (weights c).property) hj;
        id
          (Eq.mpr (id (congrArg (fun _a => Canon _a) (cut.weightArgs c ⟨j, h3⟩)))
            (hl
              (cell l
                (if ↑⟨j, h3⟩ = 0 then ⟨1, of_decide_eq_true (id (Eq.refl true))⟩
                else
                  if ↑⟨j, h3⟩ = 1 then ⟨9, of_decide_eq_true (id (Eq.refl true))⟩
                  else ⟨10, of_decide_eq_true (id (Eq.refl true))⟩))
              (List.getElem_mem
                (cell._proof_1 l
                  (if ↑⟨j, h3⟩ = 0 then ⟨1, of_decide_eq_true (id (Eq.refl true))⟩
                  else
                    if ↑⟨j, h3⟩ = 1 then ⟨9, of_decide_eq_true (id (Eq.refl true))⟩
                    else ⟨10, of_decide_eq_true (id (Eq.refl true))⟩))))))
      h✝¹ hx,
    fun i k =>
    Eq.mpr (id (congrArg (fun _a => ↑_a < P) (cut.constantArgs c i k)))
      (Decidable.casesOn (instDecidableEqNat (↑i) 0)
        (fun h =>
          Eq.mpr (id (congrFun' (congrArg LT.lt (congrArg UScalar.val (if_neg h))) P))
            (FJe_FinalConstants.bounded
              ⟨2 * (↑i - 1) + ↑c,
                have hi := i.isLt;
                have hc := c.isLt;
                Decidable.byContradiction fun a => NKG_HelperCuts.Full._proof_2 columnCalls roundCalls c i hi hc a⟩
              k))
        fun h =>
        Eq.mpr (id (congrFun' (congrArg LT.lt (congrArg UScalar.val (if_pos h))) P))
          (FJb_InitialConstants.bounded
            ⟨2 + ↑c,
              have this := c.isLt;
              Decidable.byContradiction fun a => NKG_HelperCuts.Full._proof_1 columnCalls roundCalls c this a⟩
            k))⟩
'AspisR1.NKG_HelperDomains.full' depends on axioms: [propext, Classical.choice, Quot.sound]
