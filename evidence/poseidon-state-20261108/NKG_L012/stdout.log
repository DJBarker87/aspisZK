theorem AspisR1.NKG_InternalMaps.row_member : ∀ x ∈ ↑rows, ∃ i, index i = x :=
fun x hx =>
  let ⟨j, h✝⟩ := List.getElem_of_mem hx
  let ⟨hj, eq⟩ := h✝
  Exists.intro
    ⟨j,
      Eq.mp
        (congrArg (LT.lt j)
          (Eq.trans rows.property
            (UScalar.ofNatCore_val_eq
              (UScalar.bound_suffices UScalarTy.Usize 7 (of_decide_eq_true (id (Eq.refl true)))))))
        hj⟩
    eq
'AspisR1.NKG_InternalMaps.row_member' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NKG_InternalMaps.weights : ∀ (l : State),
  canonical l → ∃ w, FIq_Native.core.array.Array.map callback rows l = ok w ∧ canonical w :=
fun l hl =>
  let ⟨w, h✝⟩ :=
    JGa_Map.source callback FIv_NativeValue.Canon rows l fun x hx =>
      let ⟨i, h✝¹⟩ := row_member x hx
      Eq.ndrec (motive := fun x => x ∈ ↑rows → ∃ y, callback.call_mut l x = ok (y, l) ∧ FIv_NativeValue.Canon y)
        (fun hx =>
          have hi :=
            Eq.mpr (id (congrArg (fun _a => _a < ↑16#usize) (FJh_InternalWeights.index_value i)))
              (have this := i.isLt;
              id (Decidable.byContradiction fun a => weights._proof_1 i this a));
          let q := cell l ⟨↑(index i), hi⟩;
          have rq := RawPoseidonExternalRowReads.array_index_usize_ok l (index i) hi;
          Exists.intro q
            ⟨id
                (Eq.mpr
                  (id
                    (congrArg
                      (fun _a =>
                        (do
                            let v ← _a
                            ok (v, l)) =
                          ok (q, l))
                      rq))
                  (Eq.mpr (id (congrArg (fun _a => _a = ok (q, l)) (bind_tc_ok q fun v => ok (v, l))))
                    (Eq.refl (ok (q, l))))),
              hl q (List.getElem_mem (cell._proof_1 l ⟨↑(index i), hi⟩))⟩)
        h✝¹ hx
  let ⟨run, cw⟩ := h✝
  Exists.intro w ⟨run, cw⟩
'AspisR1.NKG_InternalMaps.weights' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NKG_InternalMaps.constants_even : ∃ e,
  FIq_Native.core.array.Array.map FJh_InternalConstantCalls.even rows () = ok e ∧ ∀ x ∈ ↑e, ↑x < P :=
let ⟨e, h✝⟩ :=
  JGa_Map.source FJh_InternalConstantCalls.even (fun x => ↑x < P) rows () fun x hx =>
    let ⟨i, h✝¹⟩ := row_member x hx
    Eq.ndrec (motive := fun x => x ∈ ↑rows → ∃ y, FJh_InternalConstantCalls.even.call_mut () x = ok (y, ()) ∧ ↑y < P)
      (fun hx =>
        Exists.intro
          (FJh_InternalConstants.value
            ⟨2 * ↑i, Decidable.byContradiction fun a => FJh_InternalConstantCalls.even_call._proof_1 i a⟩)
          ⟨FJh_InternalConstantCalls.even_call i,
            FJh_InternalConstants.canonical
              ⟨2 * ↑i, Decidable.byContradiction fun a => FJh_InternalConstantCalls.even_call._proof_1 i a⟩⟩)
      h✝¹ hx
let ⟨run, ce⟩ := h✝
Exists.intro e ⟨run, ce⟩
'AspisR1.NKG_InternalMaps.constants_even' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NKG_InternalMaps.constants_odd : ∃ o,
  FIq_Native.core.array.Array.map FJh_InternalConstantCalls.odd rows () = ok o ∧ ∀ x ∈ ↑o, ↑x < P :=
let ⟨o, h✝⟩ :=
  JGa_Map.source FJh_InternalConstantCalls.odd (fun x => ↑x < P) rows () fun x hx =>
    let ⟨i, h✝¹⟩ := row_member x hx
    Eq.ndrec (motive := fun x => x ∈ ↑rows → ∃ y, FJh_InternalConstantCalls.odd.call_mut () x = ok (y, ()) ∧ ↑y < P)
      (fun hx =>
        Exists.intro
          (FJh_InternalConstants.value
            ⟨2 * ↑i + 1, Decidable.byContradiction fun a => FJh_InternalConstantCalls.odd_call._proof_1 i a⟩)
          ⟨FJh_InternalConstantCalls.odd_call i,
            FJh_InternalConstants.canonical
              ⟨2 * ↑i + 1, Decidable.byContradiction fun a => FJh_InternalConstantCalls.odd_call._proof_1 i a⟩⟩)
      h✝¹ hx
let ⟨run, co⟩ := h✝
Exists.intro o ⟨run, co⟩
'AspisR1.NKG_InternalMaps.constants_odd' depends on axioms: [propext, Classical.choice, Quot.sound]
