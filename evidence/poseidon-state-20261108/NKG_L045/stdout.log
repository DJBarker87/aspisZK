theorem AspisR1.NKG_BuilderRaw.reply_ok : ∀ (c : Capture) (g : Usize) (x : NQ) (last : Capture),
  call c g = ok (x, last) → reply c g = x :=
fun c g x last run =>
  id
    (Eq.mpr (id (congrArg (fun _a => (NKG_InternalChoices.get _a (field.QM31.ZERO, c)).1 = x) run))
      (Eq.refl (NKG_InternalChoices.get (ok (x, last)) (field.QM31.ZERO, c)).1))
'AspisR1.NKG_BuilderRaw.reply_ok' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NKG_BuilderRaw.source : ∀ (c : Capture) (out : Packed),
  array_from_fn_copy 4#usize field.QM31.Insts.CoreMarkerCopy FJh_ProjectedArrayValue.callback field.QM31.ZERO c =
      ok out →
    out = values c :=
fun c out run =>
  let ⟨o, snd✝, run⟩ := c
  let ⟨internal, snd✝¹, run⟩ := snd✝
  let ⟨block, snd✝², run⟩ := snd✝¹
  let ⟨p, snd✝³, run⟩ := snd✝²
  let ⟨lead, full, run⟩ := snd✝³
  let c := (o, internal, block, p, lead, full);
  let model := fun n => if h : n < 4 then reply c (NKG_GroupFrame.index ⟨n, h⟩) else field.QM31.ZERO;
  have built :=
    FIx_Builder.fromFn 4#usize FJh_ProjectedArrayValue.callback (fun x => True) id model c out
      (fun i hi x last called =>
        id
          (fun called =>
            have h4 := hi;
            have eq := UScalar.eq_of_val_eq rfl;
            let ⟨start, h✝⟩ := FJh_ProjectedCall.reached o internal block p lead full i x last called
            let ⟨stop, h✝¹⟩ := h✝
            let ⟨ts, h✝²⟩ := h✝¹
            let ⟨ins, h✝³⟩ := h✝²
            let ⟨target, h✝⁴⟩ := h✝³
            let ⟨ip, h✝⁵⟩ := h✝⁴
            let ⟨rs, right✝⟩ := h✝⁵
            let ⟨re, right✝¹⟩ := right✝
            let ⟨rts, right✝²⟩ := right✝¹
            let ⟨rt, right✝³⟩ := right✝²
            let ⟨rins, right✝⁴⟩ := right✝³
            let ⟨ri, right✝⁵⟩ := right✝⁴
            let ⟨ra, hlast⟩ := right✝⁵
            ⟨True.intro,
              ⟨id
                  (id
                    (Eq.mpr (id (congrArg (fun _a => x = _a) (dif_pos h4)))
                      (Eq.mpr (id (congrArg (fun _a => x = reply c _a) eq)) (Eq.symm (reply_ok c i x last called))))),
                hlast⟩⟩)
          called)
      run;
  Subtype.ext
    (id
      (have e := built.right;
      Eq.trans (Eq.mp (congrFun' (congrArg Eq (List.map_id ↑out)) (List.ofFn fun i => model ↑i)) e)
        (congrArg (fun f => List.ofFn f)
          (funext fun i =>
            id
              (Eq.mpr
                (id
                  (congrArg (fun _a => _a = reply c (NKG_GroupFrame.index ⟨↑i, i.isLt⟩))
                    (dif_pos
                      (have this := i.isLt;
                      this))))
                (Eq.refl
                  (reply c
                    (NKG_GroupFrame.index
                      ⟨↑i,
                        have this := i.isLt;
                        this⟩))))))))
'AspisR1.NKG_BuilderRaw.source' depends on axioms: [propext, Classical.choice, Quot.sound]
