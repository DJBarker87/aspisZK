info: [root]: lakefile.lean and lakefile.toml are both present; using lakefile.lean
theorem AspisR1.NKG_InternalChoices.get_ok : ∀ {A : Type} (r : Result A) (fallback x : A),
  r = ok x → get r fallback = x :=
fun {A} r fallback x run => Eq.mpr (id (congrArg (fun _a => get _a fallback = x) run)) (Eq.refl (get (ok x) fallback))
'AspisR1.NKG_InternalChoices.get_ok' depends on axioms: [propext]
theorem AspisR1.NKG_InternalChoices.value : ∀ (s l out : State),
  state_only_poseidon.interpolated_internal_pair s l = ok out → last s l = out :=
fun s l out run =>
  let ⟨w, h✝⟩ := FJh_InternalPairOrigins.reached s l out run
  let ⟨e, h✝¹⟩ := h✝
  let ⟨o, h✝²⟩ := h✝¹
  let ⟨ev, h✝³⟩ := h✝²
  let ⟨od, h✝⁴⟩ := h✝³
  let ⟨mid, h✝⁵⟩ := h✝⁴
  let ⟨rw, right✝⟩ := h✝⁵
  let ⟨re, right✝¹⟩ := right✝
  let ⟨ro, right✝²⟩ := right✝¹
  let ⟨rev, right✝³⟩ := right✝²
  let ⟨rod, right✝⁴⟩ := right✝³
  let ⟨rm, rf⟩ := right✝⁴
  have ww :=
    get_ok (FIq_Native.core.array.Array.map FJh_InternalWeights.callback FJh_InternalWeights.rows l)
      (Array.repeat 7#usize field.QM31.ZERO) w rw;
  have ee :=
    get_ok (FIq_Native.core.array.Array.map FJh_InternalConstantCalls.even FJh_InternalWeights.rows ())
      (Array.repeat 7#usize 0#u32) e re;
  have oo :=
    get_ok (FIq_Native.core.array.Array.map FJh_InternalConstantCalls.odd FJh_InternalWeights.rows ())
      (Array.repeat 7#usize 0#u32) o ro;
  have ve :=
    id
      (Eq.mpr (id (congrArg (fun _a => get (field.qm31_m31_dot _a.to_slice evens.to_slice) field.QM31.ZERO = ev) ww))
        (Eq.mpr (id (congrArg (fun _a => get (field.qm31_m31_dot w.to_slice _a.to_slice) field.QM31.ZERO = ev) ee))
          (get_ok (field.qm31_m31_dot w.to_slice e.to_slice) field.QM31.ZERO ev rev)));
  have vo :=
    id
      (Eq.mpr (id (congrArg (fun _a => get (field.qm31_m31_dot _a.to_slice odds.to_slice) field.QM31.ZERO = od) ww))
        (Eq.mpr (id (congrArg (fun _a => get (field.qm31_m31_dot w.to_slice _a.to_slice) field.QM31.ZERO = od) oo))
          (get_ok (field.qm31_m31_dot w.to_slice o.to_slice) field.QM31.ZERO od rod)));
  have vm :=
    id
      (Eq.mpr
        (id
          (congrArg
            (fun _a => get (state_only_poseidon.internal_round s _a) (Array.repeat 16#usize field.QM31.ZERO) = mid) ve))
        (get_ok (state_only_poseidon.internal_round s ev) (Array.repeat 16#usize field.QM31.ZERO) mid rm));
  id
    (Eq.mpr
      (id
        (congrArg
          (fun _a => get (state_only_poseidon.internal_round _a (odd l)) (Array.repeat 16#usize field.QM31.ZERO) = out)
          vm))
      (Eq.mpr
        (id
          (congrArg
            (fun _a => get (state_only_poseidon.internal_round mid _a) (Array.repeat 16#usize field.QM31.ZERO) = out)
            vo))
        (get_ok (state_only_poseidon.internal_round mid od) (Array.repeat 16#usize field.QM31.ZERO) out rf)))
'AspisR1.NKG_InternalChoices.value' depends on axioms: [propext, Classical.choice, Quot.sound]
