theorem AspisR1.NKG_FullSource.result : ∀ (s l : State),
  canonical s →
    canonical l →
      ∃ out,
        state_only_poseidon.interpolated_full_pair_packed s l = ok out ∧
          canonical out ∧
            decoded out = fun g =>
              R0P.poseidonPackingFormula ExtractedMaskQmPackBase4Arithmetic.iBasis
                ExtractedMaskQmPackBase4Arithmetic.uBasis fun j =>
                R0P.poseidonInterpolatedFullPair (decoded s) (decoded l) (FJe_ExternalAdjoint.lane g j) :=
fun s l hs hl =>
  let q0 := cell l ⟨1, of_decide_eq_true (id (Eq.refl true))⟩;
  let q1 := cell l ⟨9, of_decide_eq_true (id (Eq.refl true))⟩;
  let q2 := cell l ⟨10, of_decide_eq_true (id (Eq.refl true))⟩;
  have r0 := RawPoseidonExternalRowReads.array_index_usize_ok l 1#usize (of_decide_eq_true (id (Eq.refl true)));
  have r1 := RawPoseidonExternalRowReads.array_index_usize_ok l 9#usize (of_decide_eq_true (id (Eq.refl true)));
  have r2 := RawPoseidonExternalRowReads.array_index_usize_ok l 10#usize (of_decide_eq_true (id (Eq.refl true)));
  have hw := (FJe_FullWeights.value l q0 q1 q2 hl r0 r1 r2).left;
  let ⟨even, h✝⟩ :=
    NKG_ColumnLoop.source
      (Array.make 3#usize [q0, q1, q2]
        (of_eq_true
          (Eq.trans
            (congr (congrArg Eq (congrFun' (congrArg HAdd.hAdd (congrFun' (congrArg HAdd.hAdd (zero_add 1)) 1)) 1))
              (UScalar.ofNatCore_val_eq
                (UScalar.bound_suffices UScalarTy.Usize 3 (of_decide_eq_true (id (Eq.refl true))))))
            (eq_self 3))))
      (FJb_InitialConstants.row 2) (FJe_FinalConstants.row 0) (FJe_FinalConstants.row 2) hw
      (FJb_InitialConstants.bounded 2) (FJe_FinalConstants.bounded 0) (FJe_FinalConstants.bounded 2)
  let ⟨re, right✝⟩ := h✝
