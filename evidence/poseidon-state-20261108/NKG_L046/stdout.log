info: [root]: lakefile.lean and lakefile.toml are both present; using lakefile.lean
theorem AspisR1.NKG_PreludeFrame.result : ∀ (o : Openings) (s : Selectors) (n : Observation),
  canonical o.z →
    canonical o.xor12_z →
      canonical s.local →
        Canon s.block →
          Cut o s n →
            n.prepared = NKG_OracleChoices.prepared s ∧
              n.block = NKG_OracleChoices.block s ∧
                n.leading = NKG_OracleChoices.leading o ∧
                  n.full = NKG_OracleChoices.full o s ∧ n.internal = NKG_OracleChoices.internal o s :=
fun o s n hz hx hs hb cut =>
  have r0 :=
    Eq.mpr (id (congrArg (fun _a => s.local.index_usize 0#usize = ok _a) cut.leadingRead))
      (RawPoseidonExternalRowReads.array_index_usize_ok s.local 0#usize (of_decide_eq_true (id (Eq.refl true))));
  have v0 := get_ok (s.local.index_usize 0#usize) field.QM31.ZERO n.leadingLow r0;
  have vf :=
    get_ok (FJa_PoseidonOrigins.fullFold s) field.QM31.ZERO (n.fullStates 3)
      (NKG_LowFrame.full s n.fullStates hs cut.fullTrace).left;
  have vi :=
    get_ok (FJa_PoseidonOrigins.internalFold s) field.QM31.ZERO (n.internalStates 7)
      (NKG_LowFrame.internal s n.internalStates hs cut.internalTrace).left;
  have vw :=
    Eq.trans
      (congrArg₂
        (fun a b =>
          Array.make 3#usize [a, b, n.internalStates 7]
            (of_eq_true
              (Eq.trans
                (congr (congrArg Eq (congrFun' (congrArg HAdd.hAdd (congrFun' (congrArg HAdd.hAdd (zero_add 1)) 1)) 1))
                  (UScalar.ofNatCore_val_eq
                    (UScalar.bound_suffices UScalarTy.Usize 3 (of_decide_eq_true (id (Eq.refl true))))))
                (eq_self 3))))
        (Eq.symm v0) (Eq.symm vf))
      (congrArg
        (fun c =>
          Array.make 3#usize [NKG_OracleChoices.leadingLow s, NKG_OracleChoices.fullLow s, c]
            (of_eq_true
              (Eq.trans
                (congr (congrArg Eq (congrFun' (congrArg HAdd.hAdd (congrFun' (congrArg HAdd.hAdd (zero_add 1)) 1)) 1))
                  (UScalar.ofNatCore_val_eq
                    (UScalar.bound_suffices UScalarTy.Usize 3 (of_decide_eq_true (id (Eq.refl true))))))
                (eq_self 3))))
        (Eq.symm vi));
  have ready := NKG_OracleChoices.ready o s hz hx hs hb;
  have native :=
    NKG_PreparedRaw.native (weights n) s.block n.prepareArgs n.prepared n.block n.prepareCalls cut.prepares;
  have pmodel := NKG_PreparedRaw.source (NKG_OracleChoices.weights s) (NKG_OracleChoices.prepared s) ready.preparedCall;
  have pvalue := Eq.trans native.left (Eq.trans (congrArg NKG_PreparedRaw.model vw) (Eq.symm pmodel));
  ⟨pvalue, ⟨native.right, ⟨cut.branches.leadingReturn, ⟨cut.branches.fullReturn, cut.branches.internalReturn⟩⟩⟩⟩
'AspisR1.NKG_PreludeFrame.result' depends on axioms: [propext, Classical.choice, Quot.sound]
structure AspisR1.NKG_PreludeFrame.Cut (o : Openings) (s : Selectors) (n : Observation) : Prop
number of parameters: 3
fields:
  AspisR1.NKG_PreludeFrame.Cut.leadingRead : n.leadingLow = cell s.local ⟨0, ⋯⟩
  AspisR1.NKG_PreludeFrame.Cut.fullTrace : NKG_LowFrame.Trace s NKG_LowFrame.fullRows n.fullStates
  AspisR1.NKG_PreludeFrame.Cut.internalTrace : NKG_LowFrame.Trace s NKG_LowFrame.internalRows n.internalStates
  AspisR1.NKG_PreludeFrame.Cut.branches : NKG_OracleCuts.Prefix o s n.openingArg n.fullStateArg n.fullLocalArg
      n.internalStateArg n.internalLocalArg (NKG_OracleChoices.leading o) (NKG_OracleChoices.full o s) n.leading n.full
      (NKG_OracleChoices.internal o s) n.internal n.prefixCalls
  AspisR1.NKG_PreludeFrame.Cut.prepares : NKG_OracleCuts.Prepare (weights n) s.block n.prepareArgs
      (NKG_PreparedRaw.replies (weights n) s.block) n.prepared n.block n.prepareCalls
constructor:
  AspisR1.NKG_PreludeFrame.Cut.mk {o : Openings} {s : Selectors} {n : Observation}
    (leadingRead : n.leadingLow = cell s.local ⟨0, ⋯⟩)
    (fullTrace : NKG_LowFrame.Trace s NKG_LowFrame.fullRows n.fullStates)
    (internalTrace : NKG_LowFrame.Trace s NKG_LowFrame.internalRows n.internalStates)
    (branches :
      NKG_OracleCuts.Prefix o s n.openingArg n.fullStateArg n.fullLocalArg n.internalStateArg n.internalLocalArg
        (NKG_OracleChoices.leading o) (NKG_OracleChoices.full o s) n.leading n.full (NKG_OracleChoices.internal o s)
        n.internal n.prefixCalls)
    (prepares :
      NKG_OracleCuts.Prepare (weights n) s.block n.prepareArgs (NKG_PreparedRaw.replies (weights n) s.block) n.prepared
        n.block n.prepareCalls) :
    Cut o s n
