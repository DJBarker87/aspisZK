theorem AspisR1.NKG_LowFrame.full : ∀ (s : Selectors) (states : ℕ → NQ),
  canonical s.local → Trace s fullRows states → FJa_PoseidonOrigins.fullFold s = ok (states 3) ∧ Canon (states 3) :=
fun s states hs cut =>
  have h := loop 3#usize fullRows s states hs (Eq.symm cut.initial ▸ FIv_NativeValue.zero.left) cut.steps;
  ⟨id
      (Eq.mpr
        (id
          (congrFun'
            (congrArg Eq
              (bind_tc_ok ↑(Array.make 3#usize [1#usize, 9#usize, 10#usize] FJa_PoseidonOrigins.fullFold._proof_5)
                fun y =>
                core.array.iter.IntoIter.Insts.CoreIterTraitsIteratorIterator.fold
                  state_only_poseidon.evaluate_state_only_poseidon_oracle_projected.closure.Insts.CoreOpsFunctionFnMutPairQM31UsizeQM31
                  y field.QM31.ZERO s))
            (ok (states 3))))
        (Eq.mp
            (congrArg
              (fun _a =>
                core.array.iter.IntoIter.Insts.CoreIterTraitsIteratorIterator.fold FJa_LocalWeightFold.Callback
                      (List.map index fullRows) _a s =
                    ok (states fullRows.length) ∧
                  Canon (states fullRows.length))
              cut.initial)
            h).left),
    (Eq.mp
        (congrArg
          (fun _a =>
            core.array.iter.IntoIter.Insts.CoreIterTraitsIteratorIterator.fold FJa_LocalWeightFold.Callback
                  (List.map index fullRows) _a s =
                ok (states fullRows.length) ∧
              Canon (states fullRows.length))
          cut.initial)
        h).right⟩
