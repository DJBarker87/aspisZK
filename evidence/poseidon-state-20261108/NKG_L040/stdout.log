            (Eq.trans (lt_add_iff_pos_left._simp_1 0) (Eq.trans Order.lt_add_one_iff._simp_1 zero_le._simp_1)))
      let ⟨calls, head⟩ := h✝¹
      have same := Eq.trans head.returned valueStep;
      have cb :=
        id
          (Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  (do
                      let q ← _a
                      let q1 ← field.QM31.add (states 0) q
                      ok (q1, s)) =
                    ok (next, s))
                rr))
            (Eq.mpr
              (id
                (congrArg (fun _a => _a = ok (next, s))
                  (bind_tc_ok (cell s.local r) fun q => do
                    let q1 ← field.QM31.add (states 0) q
