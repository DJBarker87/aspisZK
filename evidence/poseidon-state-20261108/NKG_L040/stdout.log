      ⟨id
          (have cb' := cb;
          Eq.mpr
            (id
              (congrArg (fun _a => _a = ok (states (rows.length + 1)))
                (core.array.iter.IntoIter.Insts.CoreIterTraitsIteratorIterator.fold.eq_2 FJa_LocalWeightFold.Callback
                  (states 0) s (index r) (List.map index rows))))
            (Eq.mpr
