theorem AspisR1.NKG_ColumnsPacket.loop : ∀ (w : Weights) (c0 c1 c2 : Constants) (states : ℕ → State),
  NKG_ColumnCuts.Trace w c0 c1 c2 states →
    canonical w →
      Bounded c0 →
        Bounded c1 →
          Bounded c2 →
            ∀ (n : ℕ) (i : Usize),
              ↑i + n = 16 →
                state_only_poseidon.interpolate_three_constant_columns_loop w c0 c1 c2 (states ↑i) i = ok (states 16) :=
fun w c0 c1 c2 states cut hw h0 h1 h2 n i span =>
  Nat.recAux (motive := fun n =>
    ∀ (i : Usize),
      ↑i + n = 16 →
        state_only_poseidon.interpolate_three_constant_columns_loop w c0 c1 c2 (states ↑i) i = ok (states 16))
    (fun i span =>
      have stop := Eq.mpr (id (congrArg (fun _a => ¬i < _a) poseidon2.POSEIDON2_WIDTH.eq_1)) (loop._proof_1 i span);
      Eq.mpr (id (congrArg (fun _a => _a = ok (states 16)) (FJe_ThreeColumnStep.unfold_loop w c0 c1 c2 (states ↑i) i)))
        (Eq.mpr (id (congrArg (fun _a => _a = ok (states 16)) (if_neg stop)))
          (have eq := span;
          Eq.mpr (id (congrArg (fun _a => ok (states _a) = ok (states 16)) eq)) (Eq.refl (ok (states 16))))))
    (fun n ih i span =>
      have hi := Decidable.byContradiction fun a => loop._proof_2 n i span a;
      have guard := Eq.mpr (id (congrArg (fun _a => i < _a) poseidon2.POSEIDON2_WIDTH.eq_1)) (loop._proof_3 i hi);
      let ⟨next, h✝⟩ := cut.steps ⟨↑i, hi⟩
      let ⟨calls, h✝¹⟩ := h✝
      let ⟨args, stage⟩ := h✝¹
      have idx := UScalar.eq_of_val_eq rfl;
      have frame :=
        Eq.mp
          (congrArg (Eq (states (↑i + 1)))
            (congrFun' (congrArg (Std.Array.set (states ↑i)) idx) (NKG_ColumnReply.reply w c0 c1 c2 ⟨↑i, hi⟩)))
          stage.frame;
      let ⟨i1, h✝²⟩ := WP.spec_imp_exists (UScalar.add_spec (loop._proof_5 n i span guard))
      let ⟨ri1, vi1⟩ := h✝²
      id
        (fun vi1 =>
          have rest := ih i1 (Decidable.byContradiction fun a => loop._proof_6 n i span i1 vi1 a);
          Eq.mpr
            (id (congrArg (fun _a => _a = ok (states 16)) (FJe_ThreeColumnStep.unfold_loop w c0 c1 c2 (states ↑i) i)))
            (Eq.mpr (id (congrArg (fun _a => _a = ok (states 16)) (if_pos guard)))
              (Eq.mpr
                (id
                  (congrArg
                    (fun _a =>
                      (do
                          let next ← _a
                          let i1 ← i + 1#usize
                          state_only_poseidon.interpolate_three_constant_columns_loop w c0 c1 c2 next i1) =
                        ok (states 16))
                    (NKG_ColumnReply.step_reply w c0 c1 c2 (states ↑i) i hi hw h0 h1 h2)))
                (Eq.mpr
                  (id
                    (congrArg (fun _a => _a = ok (states 16))
                      (bind_tc_ok (Std.Array.set (states ↑i) i (NKG_ColumnReply.reply w c0 c1 c2 ⟨↑i, hi⟩)) fun next =>
                        do
                        let i1 ← i + 1#usize
                        state_only_poseidon.interpolate_three_constant_columns_loop w c0 c1 c2 next i1)))
                  (Eq.mpr
                    (id
                      (congrArg
                        (fun _a =>
                          (do
                              let i1 ← i + 1#usize
                              state_only_poseidon.interpolate_three_constant_columns_loop w c0 c1 c2 _a i1) =
                            ok (states 16))
                        (Eq.symm frame)))
                    (Eq.mpr
                      (id
                        (congrArg
                          (fun _a =>
                            (do
                                let i1 ← _a
                                state_only_poseidon.interpolate_three_constant_columns_loop w c0 c1 c2 (states (↑i + 1))
                                    i1) =
                              ok (states 16))
                          ri1))
                      (Eq.mpr
                        (id
                          (congrArg (fun _a => _a = ok (states 16))
                            (bind_tc_ok i1
                              (state_only_poseidon.interpolate_three_constant_columns_loop w c0 c1 c2
                                (states (↑i + 1))))))
                        (Eq.mp
                          (congrFun'
                            (congrArg Eq
                              (congrFun'
                                (congrArg (state_only_poseidon.interpolate_three_constant_columns_loop w c0 c1 c2)
                                  (congrArg states vi1))
                                i1))
                            (ok (states 16)))
                          rest))))))))
        vi1)
    n i span
'AspisR1.NKG_ColumnsPacket.loop' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NKG_ColumnsPacket.source : ∀ (w : Weights) (c0 c1 c2 : Constants) (states : ℕ → State),
  canonical w →
    Bounded c0 →
      Bounded c1 →
        Bounded c2 →
          NKG_ColumnCuts.Trace w c0 c1 c2 states →
            state_only_poseidon.interpolate_three_constant_columns w c0 c1 c2 = ok (states 16) ∧
              canonical (states 16) ∧ decoded (states 16) = model w c0 c1 c2 :=
fun w c0 c1 c2 states hw h0 h1 h2 cut =>
  have run := loop w c0 c1 c2 states cut hw h0 h1 h2 16 0#usize rfl;
  id
    (fun run =>
      ⟨Eq.mp
          (congrArg
            (fun _a =>
              state_only_poseidon.interpolate_three_constant_columns_loop w c0 c1 c2 _a 0#usize = ok (states 16))
            cut.initial)
          run,
        FJe_ThreeColumns.value w c0 c1 c2 (states 16) hw h0 h1 h2
          (Eq.mp
            (congrArg
              (fun _a =>
                state_only_poseidon.interpolate_three_constant_columns_loop w c0 c1 c2 _a 0#usize = ok (states 16))
              cut.initial)
            run)⟩)
    run
