theorem AspisR1.NKG_GroupFrame.result : ∀ (succ internal : State) (lead full : Packed) (p : Prepared) (block : NP)
  (g : Fin 4) (o : Observation),
  Frame succ internal lead full p block g o → o.out = model succ internal lead full p block g :=
fun succ internal lead full p block g o cut =>
  have target := cut.packs.targetReply;
  have ip := cut.packs.internalReply;
  id
    (fun target =>
      id
        (fun ip =>
          have ds := cut.subs.returned;
          have sm := cut.sums.returned;
          have out := cut.multiply.returned;
          Eq.mpr (id (congrArg (fun _a => _a = model succ internal lead full p block g) out))
            (Eq.mpr (id (congrArg (fun _a => mul block _a = model succ internal lead full p block g) sm))
              (Eq.mpr (id (congrArg (fun _a => mul block (sum p _a) = model succ internal lead full p block g) ds))
                (Eq.mpr
                  (id
                    (congrArg
                      (fun _a =>
                        mul block (sum p (differences _a o.ip lead full g)) = model succ internal lead full p block g)
                      target))
                  (Eq.mpr
                    (id
                      (congrArg
                        (fun _a =>
                          mul block (sum p (differences (pack succ g) _a lead full g)) =
                            model succ internal lead full p block g)
                        ip))
                    (Eq.refl (mul block (sum p (differences (pack succ g) (pack internal g) lead full g)))))))))
        ip)
    target
'AspisR1.NKG_GroupFrame.result' depends on axioms: [propext, Classical.choice, Quot.sound]
