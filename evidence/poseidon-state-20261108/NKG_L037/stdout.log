info: [root]: lakefile.lean and lakefile.toml are both present; using lakefile.lean
theorem AspisR1.NKG_OracleChoices.ready : ∀ (o : Openings) (s : Selectors),
  canonical o.z → canonical o.xor12_z → canonical s.local → Canon s.block → Ready o s :=
fun o s hz hx hs hb =>
  let ⟨l0, h✝⟩ := JFy_ArrayTotal.read s.local 0#usize (of_decide_eq_true (id (Eq.refl true))) hs
  let ⟨r0, c0⟩ := h✝
  let ⟨lf, h✝¹⟩ := NKG_LowTotal.full s hs
  let ⟨rf, cf⟩ := h✝¹
  let ⟨li, h✝²⟩ := NKG_LowTotal.internal s hs
  let ⟨ri, ci⟩ := h✝²
  have v0 := get_ok (s.local.index_usize 0#usize) field.QM31.ZERO l0 r0;
  have vf := get_ok (FJa_PoseidonOrigins.fullFold s) field.QM31.ZERO lf rf;
  have vi := get_ok (FJa_PoseidonOrigins.internalFold s) field.QM31.ZERO li ri;
  have cw :=
    id
      (Eq.mpr
        (id
          (congrArg (fun _a => canonical (Array.make 3#usize [_a, fullLow s, internalLow s] (weights._proof_1 s))) v0))
        (Eq.mpr
          (id (congrArg (fun _a => canonical (Array.make 3#usize [l0, _a, internalLow s] (weights._proof_1 s))) vf))
          (Eq.mpr (id (congrArg (fun _a => canonical (Array.make 3#usize [l0, lf, _a] (weights._proof_1 s))) vi))
            fun x hx =>
            Or.casesOn
              (Eq.mp
                (Eq.trans ready._simp_1
                  (congrArg (Or (x = l0))
                    (Eq.trans ready._simp_1
                      (congrArg (Or (x = lf))
                        (Eq.trans ready._simp_1
                          (Eq.trans (congrArg (Or (x = li)) ready._simp_2) (or_false (x = li))))))))
                hx)
              (fun h =>
                Eq.ndrec (motive := fun l0 =>
                  s.local.index_usize 0#usize = ok l0 → Canon l0 → leadingLow s = l0 → Canon x) (fun r0 c0 v0 => c0) h
                  r0 c0 v0)
              fun h =>
              Or.casesOn h
                (fun h =>
                  Eq.ndrec (motive := fun lf =>
                    FJa_PoseidonOrigins.fullFold s = ok lf → Canon lf → fullLow s = lf → Canon x) (fun rf cf vf => cf) h
                    rf cf vf)
                fun h =>
                Eq.ndrec (motive := fun li =>
                  FJa_PoseidonOrigins.internalFold s = ok li → Canon li → internalLow s = li → Canon x)
                  (fun ri ci vi => ci) h ri ci vi)));
  let ⟨lead, h✝³⟩ := NIH_Leading.result o hz hx
  let ⟨rl, right✝⟩ := h✝³
  let ⟨cl, right✝¹⟩ := right✝
  let ⟨f, h✝⁴⟩ := NKG_FullSource.result o.z s.local hz hs
  let ⟨rfull, right✝²⟩ := h✝⁴
  let ⟨cfull, right✝³⟩ := right✝²
  let ⟨i, h✝⁵⟩ := NKG_InternalSource.result o.z s.local hz hs
  let ⟨rinternal, right✝⁴⟩ := h✝⁵
  let ⟨cinternal, right✝⁵⟩ := right✝⁴
  have vl := get_ok (state_only_poseidon.leading_pair_packed o) (Array.repeat 4#usize field.QM31.ZERO) lead rl;
  have vfull :=
    get_ok (state_only_poseidon.interpolated_full_pair_packed o.z s.local) (Array.repeat 4#usize field.QM31.ZERO) f
      rfull;
  have vint :=
    get_ok (state_only_poseidon.interpolated_internal_pair o.z s.local) (Array.repeat 16#usize field.QM31.ZERO) i
      rinternal;
  let ⟨p, rp⟩ := NKG_PreparedMap.result (weights s) cw
  let ⟨b, h✝⁶⟩ := FIv_PreparedNewTotal.value s.block hb
  let ⟨rb, right✝⁶⟩ := h✝⁶
  have vp :=
    get_ok (FIq_Native.core.array.Array.map (BuiltinFnMut NQ NP) (weights s) field.PreparedQm31Multiplier.new)
      (Array.repeat 3#usize zeroPrepared) p rp;
  have vb := get_ok (field.PreparedQm31Multiplier.new s.block) zeroPrepared b rb;
  { leadingCanonical := Eq.symm vl ▸ cl, fullCanonical := Eq.symm vfull ▸ cfull,
    internalCanonical := Eq.symm vint ▸ cinternal, weightsCanonical := cw, preparedCall := Eq.symm vp ▸ rp,
    blockCall := Eq.symm vb ▸ rb }
'AspisR1.NKG_OracleChoices.ready' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NKG_OracleChoices.builder : ∀ (o : Openings) (s : Selectors) (out : Packed),
  state_only_poseidon.evaluate_state_only_poseidon_oracle_projected o s = ok out →
    array_from_fn_copy 4#usize field.QM31.Insts.CoreMarkerCopy FJh_ProjectedArrayValue.callback field.QM31.ZERO
        (capture o s) =
      ok out :=
fun o s out run =>
  let ⟨l0, h✝⟩ := FJa_PoseidonOrigins.reached o s out run
  let ⟨lf, h✝¹⟩ := h✝
  let ⟨li, h✝²⟩ := h✝¹
  let ⟨lead, h✝³⟩ := h✝²
  let ⟨f, h✝⁴⟩ := h✝³
  let ⟨i, h✝⁵⟩ := h✝⁴
  let ⟨p, h✝⁶⟩ := h✝⁵
  let ⟨b, h✝⁷⟩ := h✝⁶
  let ⟨r0, right✝⟩ := h✝⁷
  let ⟨rf, right✝¹⟩ := right✝
  let ⟨ri, right✝²⟩ := right✝¹
  let ⟨rl, right✝³⟩ := right✝²
  let ⟨rfull, right✝⁴⟩ := right✝³
  let ⟨rinternal, right✝⁵⟩ := right✝⁴
  let ⟨rp, right✝⁶⟩ := right✝⁵
  let ⟨rb, rarr⟩ := right✝⁶
  have v0 := get_ok (s.local.index_usize 0#usize) field.QM31.ZERO l0 r0;
  have vf := get_ok (FJa_PoseidonOrigins.fullFold s) field.QM31.ZERO lf rf;
  have vi := get_ok (FJa_PoseidonOrigins.internalFold s) field.QM31.ZERO li ri;
  have vl := get_ok (state_only_poseidon.leading_pair_packed o) (Array.repeat 4#usize field.QM31.ZERO) lead rl;
  have vfull :=
    get_ok (state_only_poseidon.interpolated_full_pair_packed o.z s.local) (Array.repeat 4#usize field.QM31.ZERO) f
      rfull;
  have vint :=
    get_ok (state_only_poseidon.interpolated_internal_pair o.z s.local) (Array.repeat 16#usize field.QM31.ZERO) i
      rinternal;
  have vw :=
    Eq.trans
      (congrArg₂
        (fun a b =>
          Array.make 3#usize [a, b, internalLow s]
            (of_eq_true
              (Eq.trans
                (congr (congrArg Eq (congrFun' (congrArg HAdd.hAdd (congrFun' (congrArg HAdd.hAdd (zero_add 1)) 1)) 1))
                  (UScalar.ofNatCore_val_eq
                    (UScalar.bound_suffices UScalarTy.Usize 3 (of_decide_eq_true (id (Eq.refl true))))))
                (eq_self 3))))
        v0 vf)
      (congrArg
        (fun c =>
          Array.make 3#usize [l0, lf, c]
            (of_eq_true
              (Eq.trans
                (congr (congrArg Eq (congrFun' (congrArg HAdd.hAdd (congrFun' (congrArg HAdd.hAdd (zero_add 1)) 1)) 1))
                  (UScalar.ofNatCore_val_eq
                    (UScalar.bound_suffices UScalarTy.Usize 3 (of_decide_eq_true (id (Eq.refl true))))))
                (eq_self 3))))
        vi);
  have vp :=
    id
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              NKG_InternalChoices.get
                  (FIq_Native.core.array.Array.map (BuiltinFnMut NQ NP) _a field.PreparedQm31Multiplier.new)
                  (Array.repeat 3#usize zeroPrepared) =
                p)
            vw))
        (get_ok
          (FIq_Native.core.array.Array.map (BuiltinFnMut NQ NP)
            (Array.make 3#usize [l0, lf, li]
              (of_eq_true
                (Eq.trans
                  (congr
                    (congrArg Eq (congrFun' (congrArg HAdd.hAdd (congrFun' (congrArg HAdd.hAdd (zero_add 1)) 1)) 1))
                    (UScalar.ofNatCore_val_eq
                      (UScalar.bound_suffices UScalarTy.Usize 3 (of_decide_eq_true (id (Eq.refl true))))))
                  (eq_self 3))))
            field.PreparedQm31Multiplier.new)
          (Array.repeat 3#usize zeroPrepared) p rp));
  have vb := get_ok (field.PreparedQm31Multiplier.new s.block) zeroPrepared b rb;
  Eq.mpr
    (id
      (congrFun'
        (congrArg Eq
          (congrArg
            (array_from_fn_copy 4#usize field.QM31.Insts.CoreMarkerCopy FJh_ProjectedArrayValue.callback
              field.QM31.ZERO)
            (congrArg (Prod.mk o)
              (congr (congrArg Prod.mk vint)
                (congr (congrArg Prod.mk vb) (congr (congrArg Prod.mk vp) (congr (congrArg Prod.mk vl) vfull)))))))
        (ok out)))
    rarr
'AspisR1.NKG_OracleChoices.builder' depends on axioms: [propext, Classical.choice, Quot.sound]
