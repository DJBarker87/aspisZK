'AspisR1.NMC_Terminal.actual_arguments' depends on axioms: [propext, Classical.choice, Quot.sound]
@AspisR1.NMC_Terminal.actual_arguments : ∀ {H : Type} (native : AspisR1.NJM_RoundsCut.Observations),
  AspisR1.NJM_RoundsCut.Cut native →
    ∀ (token frame : ℕ) (input : AspisR1.NLU.Input H),
      AspisR1.NLU.InputDomain input →
        ∀ (s : AspisR1.NLU.State H),
          AspisR1.NLU.Reachable input s →
            s.machine.next = AspisR1.NLC_Finish.Event.terminal →
              ∃ claims alpha,
                s.machine.locals.claims = some claims ∧
                  s.machine.locals.alpha = some alpha ∧
                    (∀
                        row ∈
                          ↑(AspisR1.FIq_Carriers.mapArray (AspisR1.FIq_Carriers.mapArray AspisR1.FIq_Carriers.toQ)
                              claims),
                        AspisR1.FIw_ArrayValue.canonical row) ∧
                      AspisR1.FIw_ArrayValue.canonical (AspisR1.FIq_Carriers.mapArray AspisR1.FIq_Carriers.toQ alpha) ∧
                        AspisR1.NLU_Terminal.nativeTerminal input.publicValue claims alpha input.challenges =
                          (AspisR1.IDa_Deployed.boundaries input.reservation).terminal input.publicValue claims alpha
                            input.challenges
'AspisR1.NMC_Terminal.installed' depends on axioms: [propext, Classical.choice, Quot.sound]
@AspisR1.NMC_Terminal.installed : ∀ {A : Type} (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (state : A)
  (heap : AspisR1.NMC_Parent.Heap) (identity : ℕ) (pub : AspisR1.FIq_Carriers.Public)
  (claims : AspisR1.NLC_Finish.Claims) (alpha : AspisR1.NLC_Finish.Alpha)
  (challenges : AspisR1PublicPreparation.r1_wire.Challenges),
  AspisR1.NLU_Terminal.InputDomain pub challenges →
    (∀ row ∈ ↑(AspisR1.FIq_Carriers.mapArray (AspisR1.FIq_Carriers.mapArray AspisR1.FIq_Carriers.toQ) claims),
        AspisR1.FIw_ArrayValue.canonical row) →
      AspisR1.FIw_ArrayValue.canonical (AspisR1.FIq_Carriers.mapArray AspisR1.FIq_Carriers.toQ alpha) →
        AspisR1.NMC_Exit.publicResult allocator state heap identity
            (AspisR1.NLU_Terminal.nativeTerminal pub claims alpha challenges) =
          AspisR1.NMC_Exit.publicResult allocator state heap identity
            (AspisR1.FIq_Terminal.terminal pub claims alpha challenges)
