theorem AspisR1.NMC_RootStages.wrong_length : ∀ {A : Type} (before : Context A) (payload : Slice U8),
  payload.length ≠ 32 →
    ∃ entered,
      tryStage before payload = ok entered ∧
        unwrapStage entered = UnwrapOutcome.aborted Error.panic entered ∧
