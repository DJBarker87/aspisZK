'AspisR1.NMC_Root.wrong_length' depends on axioms: [propext, Classical.choice, Quot.sound]
'AspisR1.NMC_Root.exact_length' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NMC_Root.wrong_length : ∀ (payload : Slice U8), payload.length ≠ 32 → copy payload = fail Error.panic :=
