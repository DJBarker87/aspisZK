'AspisR1.NMC_Claims.installed' depends on axioms: [propext, Classical.choice, Quot.sound]
'AspisR1.NMC_Claims.frame' depends on axioms: [propext, Classical.choice, Quot.sound]
'AspisR1.NMC_Claims.abort' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NMC_Claims.installed : ∀ {A H : Type} (input : NLU.Input H),
  NLU.InputDomain input →
    ∀ (allocator : S2W_D189Wrappers.Allocator A) (state : A) (rows : NKA_HeapCarrier.RowNative),
      NKA_HeapCarrier.RowCut rows →
        ∀ (box : NKA_HeapCarrier.BoxNative),
          NKA_HeapCarrier.BoxCut box →
            ∀ (identity : ℕ) (before : NKA_InitializedPrefix.Memory) (heap : Heap),
              ∃ value,
                NKA_ClaimsOwnership.AtAllocation (NKA_ClaimsEffects.allocate allocator state) input.reservation rows box
                    identity before value ∧
                  attach heap identity
                        (NKA_ClaimsEffects.native allocator state input.reservation rows box identity before value) =
                      attach heap identity (NKA_ClaimsEffects.cohort allocator state input.reservation input.prefix1) ∧
                    attach heap identity
                        (NKA_ClaimsEffects.native allocator state input.reservation rows box identity before value) =
                      attach heap identity
                        (NKA_ClaimsEffects.reference allocator state input.reservation input.prefix1) :=
⋯
