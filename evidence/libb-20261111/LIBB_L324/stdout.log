def RSL.Spec.Functional : {α : Type} → RSL.Spec α → Prop :=
fun {α} m => ∀ (env : RSL.Env), ∃ o, ∀ (o' : RSL.Obs α), m env o' ↔ o' = o
def LIBB_Tx2Auth.law : RSL.Bytes → RSL.Bytes → RSL.Bytes → RSL.Spec (Except LIBB_V2Carriers.VErr Unit) :=
fun pub proof ck =>
  if h : LIBB_Tx2Auth.Fits pub proof ck then
    LIBB_ObservationModel.law (LIB_Bytes.fromBytes pub ⋯) (LIB_Bytes.fromBytes proof ⋯) (LIB_Bytes.fromBytes ck ⋯)
  else RSL.Spec.panic
def LIBB_Tx2Auth.resolved : RSL.Bytes → RSL.Bytes → RSL.Bytes → RSL.Spec (Except LIBB_V2Carriers.VErr Unit) :=
fun pub proof ck =>
  if h : LIBB_Tx2Auth.Fits pub proof ck then
    LIBB_EnvValues.graph (LIB_Bytes.fromBytes pub ⋯) (LIB_Bytes.fromBytes proof ⋯) (LIB_Bytes.fromBytes ck ⋯)
  else RSL.Spec.panic
def LIBB_Tx2Auth.value : RSL.Bytes → RSL.Bytes → RSL.Bytes → RSL.Env → Except LIBB_V2Carriers.VErr Unit :=
fun pub proof ck env =>
  if h : LIBB_Tx2Auth.Fits pub proof ck then
    LIBB_EnvValues.evaluator env (LIB_Bytes.fromBytes pub ⋯) (LIB_Bytes.fromBytes proof ⋯) (LIB_Bytes.fromBytes ck ⋯)
  else Except.error AdapterRw.aspis_r1_cost_probe.verifier.Error.Checkpoint
theorem LIBB_Tx2Auth.native : ∀ {Ambient : Type} (env : RSL.Env) (pub proof ck : Aeneas.Std.Slice Aeneas.Std.U8)
  (world : NLM_PacketTypes.World Ambient),
  LIBB_Tx2Domain.domain (LIB_Carriers.bytes pub) (LIB_Carriers.bytes proof) (LIB_Carriers.bytes ck) →
    ∀
      (outcome :
        NLW_Full064.End (LIBB_PartitionEnv.H env)
          { digest := LIBB_PartitionEnv.digest env, publicBytes := pub, proof := proof, checkpoint := ck, hash := () })
      (events : List (NLW_Full064.Event Ambient Unit)),
      NMN_064.Native (LIBB_PartitionEnv.H env)
          {
            args :=
              { digest := LIBB_PartitionEnv.digest env, publicBytes := pub, proof := proof, checkpoint := ck,
                hash := () },
            world := world }
          outcome events →
        LIBB_ObservationFold.Bound064 env pub proof ck outcome →
          ∀ (trace : NNC_DigestTrace.Trace),
            NNC_ObservedWeak.TraceOf outcome trace →
              NLW_Full064.Law (LIBB_PartitionEnv.H env)
                  { digest := LIBB_PartitionEnv.digest env, publicBytes := pub, proof := proof, checkpoint := ck,
                    hash := () }
                  outcome ∧
                events =
                    NLW_Full064.chronology (LIBB_PartitionEnv.H env)
                      {
                        args :=
                          { digest := LIBB_PartitionEnv.digest env, publicBytes := pub, proof := proof,
                            checkpoint := ck, hash := () },
                        world := world }
                      outcome ∧
                  LIBB_Tx2Auth.law (LIB_Carriers.bytes pub) (LIB_Carriers.bytes proof) (LIB_Carriers.bytes ck) env
                    {
                      exit :=
                        NNC_WeakSpec.exit (LIBB_PartitionEnv.H env)
                          { digest := LIBB_PartitionEnv.digest env, publicBytes := pub, proof := proof,
                            checkpoint := ck, hash := () }
                          outcome,
                      events := NNC_DigestTrace.render trace } :=
