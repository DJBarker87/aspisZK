    NNC_ResumeEvents.parts (AspisR1.MultiproofConePhysicalDigest.parts left right)
LIBB_C04PartialPartition.recover (n : ℕ) (value salt : RSL.Bytes) (hv : List.length value ≤ n)
  (hs : List.length salt ≤ 32) (full : salt ≠ [] → List.length value = n) :
  [List.take n (value ++ salt), List.take 32 (List.drop n (value ++ salt))] = [value, salt]
LIBB_C04PartialPartition.leaf (tag : UInt8) (n : ℕ) (value salt : RSL.Bytes) (size : n = if tag = 113 then 480 else 128)
  (hv : List.length value ≤ n) (hs : List.length salt ≤ 32) (full : salt ≠ [] → List.length value = n) :
  LIBB_C04Partition.partition ([16, tag] ++ value ++ salt) = [[16, tag], value, salt]
LIBB_C04LeafPartition.parts (tag : Aeneas.Std.U8) (n : ℕ) (value salt : Aeneas.Std.Slice Aeneas.Std.U8)
  (size : n = if NNC_ByteCarriers.hostByte tag = 113 then 480 else 128) (hv : (↑value).length ≤ n)
  (hs : (↑salt).length ≤ 32) (full : ↑salt ≠ [] → (↑value).length = n) :
  LIBB_C04Partition.partition
      (LIBB_ProtocolBytes.host
        (AspisV8R19.SqueezeOracleBridge.flatten (AspisR1.Port4B_LeafCode.parts tag value salt))) =
    NNC_ResumeEvents.parts (AspisR1.Port4B_LeafCode.parts tag value salt)
LIBB_C04LeafPartition.windows (o : Aeneas.Std.Slice Aeneas.Std.U8) (vs ve ss se n : ℕ) (order : vs ≤ ve)
  (separated : ve ≤ ss) (saltWidth : se - ss = 32) (width : ve - vs = n) :
  have value := List.take n (List.drop vs ↑o);
  have salt := List.take 32 (List.drop ss ↑o);
  value.length ≤ n ∧ salt.length ≤ 32 ∧ (salt ≠ [] → value.length = n)
