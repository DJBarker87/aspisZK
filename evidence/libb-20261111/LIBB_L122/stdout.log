LIBB_PairReservation.slots (a b : AspisR1.NP6_StdModel.Reservation)
  (h : NJC_FilledClause.reserved a = NJC_FilledClause.reserved b) :
  AspisR1.IDa_Deployed.finish a = AspisR1.IDa_Deployed.finish b
LIBB_PairReservation.finish (a b : AspisR1.NP6_StdModel.Reservation)
  (h : NJC_FilledClause.reserved a = NJC_FilledClause.reserved b) : NLB_Parent.finish a = NLB_Parent.finish b
LIBB_CommonReservation.resume (a b : AspisR1.NP6_StdModel.Reservation)
  (h : NJC_FilledClause.reserved a = NJC_FilledClause.reserved b) : @NJJ_Common.resume a = @NJJ_Common.resume b
LIBB_CommonReservation.pending (a b : AspisR1.NP6_StdModel.Reservation)
  (h : NJC_FilledClause.reserved a = NJC_FilledClause.reserved b) : NJJ_Common.pending a = NJJ_Common.pending b
LIBB_CommonReservation.source (a a' b b' c c' : AspisR1.NP6_StdModel.Reservation) (merkle : NJJ_Common.Merkle)
  (ha : NJC_FilledClause.reserved a = NJC_FilledClause.reserved a')
  (hb : NJC_FilledClause.reserved b = NJC_FilledClause.reserved b')
  (hc : NJC_FilledClause.reserved c = NJC_FilledClause.reserved c') :
  @NJJ_Common.run a b (fun {H} => merkle) (NLB_Parent.finish c) =
    @NJJ_Common.run a' b' (fun {H} => merkle) (NLB_Parent.finish c')
LIBB_CommonReservation.observed (a a' b b' c c' : AspisR1.NP6_StdModel.Reservation) (merkle : NJJ_Common.Merkle)
  (ha : NJC_FilledClause.reserved a = NJC_FilledClause.reserved a')
  (hb : NJC_FilledClause.reserved b = NJC_FilledClause.reserved b')
  (hc : NJC_FilledClause.reserved c = NJC_FilledClause.reserved c') :
  @NJU_CommonObserved.run a b (fun {H} => merkle) (NLB_Parent.finish c) =
    @NJU_CommonObserved.run a' b' (fun {H} => merkle) (NLB_Parent.finish c')
LIBB_RecordReservation.compatible (r : AspisR1.NP6_StdModel.Reservation) (e : NJU_CommonObserved.Event)
  (input : NLT_NativeWindows.Input e) : NLT_NativeWindows.Compatible (LIBB_RecordReservation.frame r e input) e input
LIBB_RecordReservation.tags (r : AspisR1.NP6_StdModel.Reservation) (e : NJU_CommonObserved.Event)
  (input : NLT_NativeWindows.Input e) (bound : LIBB_RecordReservation.Bound r e input) :
  NJC_FilledClause.reserved (LIBB_RecordReservation.frame r e input).resume = NJC_FilledClause.reserved r ∧
    NJC_FilledClause.reserved (LIBB_RecordReservation.frame r e input).pending = NJC_FilledClause.reserved r ∧
      NJC_FilledClause.reserved (LIBB_RecordReservation.frame r e input).finish = NJC_FilledClause.reserved r
LIBB_RecordReservation.step (r : AspisR1.NP6_StdModel.Reservation)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) {X : Type}
  (d : VTop_Stages.aspis_core.digest.Digest32 X) (pub proof ck : Aeneas.Std.Slice Aeneas.Std.U8) (hash : X)
  (len : (↑proof).length = 57607) (e : NJU_CommonObserved.Event)
  (entered :
    e ∈
      (NJU_CommonObserved.run r r (fun {H_1} => NLP_NativeMerkle.action H) (NLB_Parent.finish r) d pub proof ck hash
          none).events)
  (recorded : NJU_CommonObserved.Event) (input : NLT_NativeWindows.Input recorded)
  (question : NLT_NativeWindows.question recorded = NLT_NativeWindows.question e)
  (bound : LIBB_RecordReservation.Bound r recorded input) : NLT_NativeWindows.window H d hash recorded input = e
LIBB_TagSource.erase {H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State} {X : Type}
  {d : VTop_Stages.aspis_core.digest.Digest32 X} {hash : X} {A : Type} (r : AspisR1.NP6_StdModel.Reservation)
  (p : NKE_Free.Program NJU_CommonObserved.Event A) (result : Aeneas.Std.Result A)
  (records : List (NLT_NativeInvocation.Occurrence H d hash))
  (invocation : NLT_NativeInvocation.Invocation H d hash p result records)
  (compatible : ∀ record ∈ records, LIBB_RecordReservation.Bound r record.entered record.input) :
  NLT_Continuation.Invocation (LIBB_TagSource.Local r H d hash) p result (List.map NLT_NativeInvocation.actual records)
LIBB_TagSource.source (r : AspisR1.NP6_StdModel.Reservation)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) {X : Type}
  (d : VTop_Stages.aspis_core.digest.Digest32 X) (pub proof ck : Aeneas.Std.Slice Aeneas.Std.U8) (hash : X)
  (len : (↑proof).length = 57607) (result : NJU_CommonObserved.R Unit)
  (records : List (NLT_NativeInvocation.Occurrence H d hash))
  (native : NLT_NativeInvocation.Invocation H d hash (NLT_NativeSource.skeleton H d pub proof ck hash) result records)
  (bound : ∀ record ∈ records, LIBB_RecordReservation.Bound r record.entered record.input) :
  result = NJJ_Common.run r r (fun {H_1} => NLP_NativeMerkle.action H) (NLB_Parent.finish r) d pub proof ck hash none ∧
    List.map NLT_NativeInvocation.actual records =
      (NJU_CommonObserved.run r r (fun {H_1} => NLP_NativeMerkle.action H) (NLB_Parent.finish r) d pub proof ck hash
          none).events
LIBB_TagStopPrefix.source {H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State} {X : Type}
  {d : VTop_Stages.aspis_core.digest.Digest32 X} {hash : X} {A : Type} (r : AspisR1.NP6_StdModel.Reservation)
  (p : NKE_Free.Program NJU_CommonObserved.Event A) (records : List (NLT_NativeInvocation.Occurrence H d hash))
  (cut : NLT_C04Stop.Cut H) (stopped : NLT_C04Stop.At H d hash p records cut)
  (compatible : ∀ record ∈ records, LIBB_RecordReservation.Bound r record.entered record.input)
  (cuts :
    ∀ e ∈ (NKE_Free.eval p).events,
      ∀ (observed : NJU_CommonObserved.Event), LIBB_TagSource.Local r H d hash e observed → observed = e) :
  ∃ e suffix,
    (NKE_Free.eval p).events = List.map NLT_NativeInvocation.actual records ++ e :: suffix ∧
      NLT_NativeWindows.question e = NLT_C04Stop.question cut
LIBB_TagStop.source_prefix (r : AspisR1.NP6_StdModel.Reservation)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) {X : Type}
  (d : VTop_Stages.aspis_core.digest.Digest32 X) (pub proof ck : Aeneas.Std.Slice Aeneas.Std.U8) (hash : X)
  (len : (↑proof).length = 57607) (records : List (NLT_NativeInvocation.Occurrence H d hash)) (cut : NLT_C04Stop.Cut H)
  (stopped : NLT_C04Stop.At H d hash (NLT_NativeSource.skeleton H d pub proof ck hash) records cut)
  (bound : ∀ record ∈ records, LIBB_RecordReservation.Bound r record.entered record.input) :
  ∃ reply suffix,
    (NJU_CommonObserved.run r r (fun {H_1} => NLP_NativeMerkle.action H) (NLB_Parent.finish r) d pub proof ck hash
          none).events =
      List.map NLT_NativeInvocation.actual records ++
        NJU_CommonObserved.Event.merkle cut.proof cut.prepared cut.folded reply :: suffix
LIBB_TagStop.installed (r : AspisR1.NP6_StdModel.Reservation)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) {X : Type}
  (d : VTop_Stages.aspis_core.digest.Digest32 X) (pub proof ck : Aeneas.Std.Slice Aeneas.Std.U8) (hash : X)
  (len : (↑proof).length = 57607) (root0 : NLP_InputDomain.Root0 ck proof)
  (records : List (NLT_NativeInvocation.Occurrence H d hash)) (cut : NLT_C04Stop.Cut H)
  (stopped : NLT_C04Stop.At H d hash (NLT_NativeSource.skeleton H d pub proof ck hash) records cut)
  (bound : ∀ record ∈ records, LIBB_RecordReservation.Bound r record.entered record.input) :
  NLL_Prefix.At
      (NLL_Parent.plan H cut.proof (NLP_RootCodec.parsed cut.proof (AspisR1.Port3_BatchStage.root1 cut.prepared))
        cut.prepared.queries 1#usize (NLL_Parent.sites (NLL_BatchSource.roots cut.prepared cut.folded))
        NKV_ParentSource.zeroI NKV_ParentSource.zeroV)
      (cut.inside ++ cut.pending.answered) cut.pending.parts ∧
    NLL_Prefix.At
      (NLL_ObservedCalls.calls H cut.proof
          (NLP_RootCodec.parsed cut.proof (AspisR1.Port3_BatchStage.root1 cut.prepared)) cut.prepared.queries 1#usize
          (NLL_Parent.sites (NLL_BatchSource.roots cut.prepared cut.folded)) NKV_ParentSource.zeroI
          NKV_ParentSource.zeroV).1
      (cut.inside ++ cut.pending.answered) cut.pending.parts
LIBB_PartitionEnv.digest_value (env : RSL.Env) (parts : Aeneas.Std.Slice (Aeneas.Std.Slice Aeneas.Std.U8)) :
  (LIBB_PartitionEnv.digest env).digest () parts =
    Aeneas.Std.Result.ok (LIB_Env.nativeKey (env.sha256 (NNC_ResumeEvents.parts parts)))
LIBB_PartitionEnv.partition_value (env : RSL.Env) (parts : Aeneas.Std.Slice (Aeneas.Std.Slice Aeneas.Std.U8))
  (partition :
    LIBB_C04Partition.partition (LIBB_ProtocolBytes.host (AspisV8R19.SqueezeOracleBridge.flatten parts)) =
      NNC_ResumeEvents.parts parts) :
  AspisV8R19.SqueezeOracleBridge.encodeState (LIBB_PartitionEnv.H env (AspisV8R19.SqueezeOracleBridge.flatten parts)) =
    LIB_Env.nativeKey (env.sha256 (NNC_ResumeEvents.parts parts))
LIBB_PartitionEnv.leaf_value (env : RSL.Env) (kind : Aeneas.Std.Usize) (opening : Aeneas.Std.Slice Aeneas.Std.U8) :
  AspisV8R19.SqueezeOracleBridge.encodeState
      (LIBB_PartitionEnv.H env (AspisV8R19.SqueezeOracleBridge.flatten (AspisR1.Port4B_LeafCode.input kind opening))) =
    LIB_Env.nativeKey (env.sha256 (NNC_ResumeEvents.parts (AspisR1.Port4B_LeafCode.input kind opening)))
LIBB_Tx2EnvCode.source_result (env : RSL.Env) (pub proof ck : Aeneas.Std.Slice Aeneas.Std.U8) :
  (LIBB_Tx2EnvCode.observed env pub proof ck).result = LIBB_Tx2EnvCode.common env pub proof ck
LIBB_Tx2EnvCode.parser (proof : Aeneas.Std.Slice Aeneas.Std.U8) :
  NLE_ParseInstall.parse proof =
    NJS_Parse.map NLE_ParseInstall.reply
      (NJS_Parse.map NJS_Parse.reply
        (NJS_Extract.verifier.candidate.parse_shape (fun {T U} {N} => Op3I_Std.ops.sliceNe)
          (fun {T U} {N} => Op3I_Std.ops.sliceEq) (fun {T F} => Op3I_Std.ops.iterAny) proof))
LIBB_Tx2EnvTrace.no_write_event (env : RSL.Env) (e : NJU_CommonObserved.Event) (cell : ℕ) (bytes : RSL.Bytes) :
  RSL.Event.write cell bytes ∉ LIBB_Tx2EnvTrace.event env e
LIBB_Tx2EnvTrace.no_write (env : RSL.Env) (pub proof ck : Aeneas.Std.Slice Aeneas.Std.U8) (cell : ℕ)
  (bytes : RSL.Bytes) : RSL.Event.write cell bytes ∉ LIBB_Tx2EnvTrace.events env pub proof ck
LIBB_EnvCommon.resolved (env : RSL.Env) (pub proof ck : Aeneas.Std.Slice Aeneas.Std.U8) (len : (↑proof).length = 57607)
  (result : NJU_CommonObserved.R Unit)
  (records : List (NLT_NativeInvocation.Occurrence (LIBB_PartitionEnv.H env) (LIBB_PartitionEnv.digest env) ()))
  (native :
    NLT_NativeInvocation.Invocation (LIBB_PartitionEnv.H env) (LIBB_PartitionEnv.digest env) ()
      (NLT_NativeSource.skeleton (LIBB_PartitionEnv.H env) (LIBB_PartitionEnv.digest env) pub proof ck ()) result
      records)
  (bound : LIBB_EnvCommon.Bound env records) :
  result = LIBB_Tx2EnvCode.common env pub proof ck ∧
    List.map NLT_NativeInvocation.actual records = (LIBB_Tx2EnvCode.observed env pub proof ck).events
LIBB_EnvCommon.stopped (env : RSL.Env) (pub proof ck : Aeneas.Std.Slice Aeneas.Std.U8) (len : (↑proof).length = 57607)
  (records : List (NLT_NativeInvocation.Occurrence (LIBB_PartitionEnv.H env) (LIBB_PartitionEnv.digest env) ()))
  (cut : NLT_C04Stop.Cut (LIBB_PartitionEnv.H env))
  (native :
    NLT_C04Stop.At (LIBB_PartitionEnv.H env) (LIBB_PartitionEnv.digest env) ()
      (NLT_NativeSource.skeleton (LIBB_PartitionEnv.H env) (LIBB_PartitionEnv.digest env) pub proof ck ()) records cut)
  (bound : LIBB_EnvCommon.Bound env records) :
  ∃ reply suffix,
    (LIBB_Tx2EnvCode.observed env pub proof ck).events =
      List.map NLT_NativeInvocation.actual records ++
        NJU_CommonObserved.Event.merkle cut.proof cut.prepared cut.folded reply :: suffix
LIBB_EnvCommon.stopped_query (env : RSL.Env) (pub proof ck : Aeneas.Std.Slice Aeneas.Std.U8)
  (len : (↑proof).length = 57607) (root0 : NLP_InputDomain.Root0 ck proof)
  (records : List (NLT_NativeInvocation.Occurrence (LIBB_PartitionEnv.H env) (LIBB_PartitionEnv.digest env) ()))
  (cut : NLT_C04Stop.Cut (LIBB_PartitionEnv.H env))
  (native :
    NLT_C04Stop.At (LIBB_PartitionEnv.H env) (LIBB_PartitionEnv.digest env) ()
      (NLT_NativeSource.skeleton (LIBB_PartitionEnv.H env) (LIBB_PartitionEnv.digest env) pub proof ck ()) records cut)
  (bound : LIBB_EnvCommon.Bound env records) :
  NLL_Prefix.At
    (NLL_Parent.plan (LIBB_PartitionEnv.H env) cut.proof
      (NLP_RootCodec.parsed cut.proof (AspisR1.Port3_BatchStage.root1 cut.prepared)) cut.prepared.queries 1#usize
      (NLL_Parent.sites (NLL_BatchSource.roots cut.prepared cut.folded)) NKV_ParentSource.zeroI NKV_ParentSource.zeroV)
    (cut.inside ++ cut.pending.answered) cut.pending.parts
LIBB_Tx2Domain.native (env : RSL.Env) (publicBytes proof checkpoint : Aeneas.Std.Slice Aeneas.Std.U8) :
  LIBB_Tx2Domain.domain (LIB_Carriers.bytes publicBytes) (LIB_Carriers.bytes proof) (LIB_Carriers.bytes checkpoint) ↔
    NMN_064.Domain
      { digest := LIBB_PartitionEnv.digest env, publicBytes := publicBytes, proof := proof, checkpoint := checkpoint,
        hash := () }
LIBB_RecordRender.one (env : RSL.Env) (record : LIBB_RecordRender.Record env) (trace : NNC_DigestTrace.Trace)
  (source : NNC_RecordTrace.FromRecord record trace)
  (bound : LIBB_RecordReservation.Bound (LIBB_Tx2Reservation.reservation env) record.entered record.input)
  (law : NLT_C04Installed.Law (LIBB_PartitionEnv.H env) record.detail) : LIBB_RecordRender.Law env record trace
LIBB_RecordRender.records (env : RSL.Env) (rs : List (LIBB_RecordRender.Record env)) (trace : NNC_DigestTrace.Trace)
  (source : NNC_RecordTrace.Records rs trace) (bound : LIBB_EnvCommon.Bound env rs)
  (laws : ∀ record ∈ rs, NLT_C04Installed.Law (LIBB_PartitionEnv.H env) record.detail) :
  ∃ pieces, trace = pieces.flatten ∧ List.Forall₂ (LIBB_RecordRender.Law env) rs pieces
LIBB_EnvDigestTrace.node (env : RSL.Env) (left right : Aeneas.Std.Array Aeneas.Std.U8 32#usize) :
  (LIBB_PartitionEnv.digest env).digest () (AspisR1.MultiproofConePhysicalDigest.parts left right) =
    Aeneas.Std.Result.ok
      (AspisV8R19.SqueezeOracleBridge.encodeState
        (LIBB_PartitionEnv.H env
          (AspisV8R19.SqueezeOracleBridge.flatten (AspisR1.MultiproofConePhysicalDigest.parts left right))))
LIBB_EnvDigestTrace.leaf (env : RSL.Env) (kind : Aeneas.Std.Usize) (opening : Aeneas.Std.Slice Aeneas.Std.U8) :
  (LIBB_PartitionEnv.digest env).digest () (AspisR1.Port4B_LeafCode.input kind opening) =
    Aeneas.Std.Result.ok
      (AspisV8R19.SqueezeOracleBridge.encodeState
        (LIBB_PartitionEnv.H env (AspisV8R19.SqueezeOracleBridge.flatten (AspisR1.Port4B_LeafCode.input kind opening))))
LIBB_EnvDigestTrace.event (env : RSL.Env) (parts : Aeneas.Std.Slice (Aeneas.Std.Slice Aeneas.Std.U8))
  (partition :
    LIBB_C04Partition.partition (LIBB_ProtocolBytes.host (AspisV8R19.SqueezeOracleBridge.flatten parts)) =
      NNC_ResumeEvents.parts parts) :
  LIBB_C04LogGraph.render
      [(AspisV8R19.SqueezeOracleBridge.flatten parts,
          LIBB_PartitionEnv.H env (AspisV8R19.SqueezeOracleBridge.flatten parts))] =
    [RSL.Event.digest (NNC_ResumeEvents.parts parts) (env.sha256 (NNC_ResumeEvents.parts parts))]
LIBB_EnvValues.functional (pub proof ck : Aeneas.Std.Slice Aeneas.Std.U8) :
  (LIBB_EnvValues.graph pub proof ck).Functional
LIBB_EnvValues.returns (pub proof ck : Aeneas.Std.Slice Aeneas.Std.U8) (env : RSL.Env) :
  NND_Returned.Returns (LIBB_EnvValues.graph pub proof ck) env (LIBB_EnvValues.evaluator env pub proof ck)
LIBB_ParserGraph.source (env : RSL.Env) (pub proof ck : Aeneas.Std.Slice Aeneas.Std.U8) :
  LIBB_Tx2EnvCode.code env pub proof ck =
    match NLE_ParseInstall.parse proof with
    | Aeneas.Std.Result.fail e => Aeneas.Std.Result.fail e
    | Aeneas.Std.Result.div => Aeneas.Std.Result.div
    | Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err e) =>
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err e)
    | Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok a) => LIBB_Tx2EnvCode.common env pub proof ck
