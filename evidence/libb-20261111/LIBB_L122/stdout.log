  (o : RSL.Obs B) :
  RSL.Spec.map f (RSL.Spec.alloc.bind fun x => RSL.Spec.alloc.bind fun x => NMS_R2N_Interpreted.liftResult code) env o ↔
    o = LIB_Carriers.resultObs f [] code ∨ o = { exit := RSL.Exit.abort, events := [] }
