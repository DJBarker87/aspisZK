  (outcome :
    NLW_Full064.End (LIBB_PartitionEnv.H env)
      { digest := LIBB_PartitionEnv.digest env, publicBytes := pub, proof := proof, checkpoint := ck, hash := () })
  (events : List (NLW_Full064.Event Ambient Unit))
  (invocation :
    NMN_064.Native (LIBB_PartitionEnv.H env)
      {
        args :=
          { digest := LIBB_PartitionEnv.digest env, publicBytes := pub, proof := proof, checkpoint := ck, hash := () },
        world := world }
      outcome events)
  (bound : LIBB_ObservationFold.Bound064 env pub proof ck outcome) (trace : NNC_DigestTrace.Trace)
  (source : NNC_ObservedWeak.TraceOf outcome trace) :
  NLW_Full064.Law (LIBB_PartitionEnv.H env)
      { digest := LIBB_PartitionEnv.digest env, publicBytes := pub, proof := proof, checkpoint := ck, hash := () }
      outcome ∧
    events =
        NLW_Full064.chronology (LIBB_PartitionEnv.H env)
          {
            args :=
              { digest := LIBB_PartitionEnv.digest env, publicBytes := pub, proof := proof, checkpoint := ck,
                hash := () },
            world := world }
          outcome ∧
      LIBB_Tx2Auth.law (LIB_Carriers.bytes pub) (LIB_Carriers.bytes proof) (LIB_Carriers.bytes ck) env
        {
          exit :=
            NNC_WeakSpec.exit (LIBB_PartitionEnv.H env)
              { digest := LIBB_PartitionEnv.digest env, publicBytes := pub, proof := proof, checkpoint := ck,
                hash := () }
              outcome,
          events := NNC_DigestTrace.render trace }
