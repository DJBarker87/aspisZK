def LIBB_ReturnFunctional.ReturnFunctional : {α : Type} → RSL.Spec α → Prop :=
fun {α} m =>
  ∀ (env : RSL.Env) (o₁ o₂ : RSL.Obs α) (r₁ r₂ : α),
    m env o₁ → m env o₂ → o₁.exit = RSL.Exit.ret r₁ → o₂.exit = RSL.Exit.ret r₂ → o₁ = o₂
