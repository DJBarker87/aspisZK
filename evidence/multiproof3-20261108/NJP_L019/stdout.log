theorem NJP_DigestCarrier.coordinate : ∀ (bytes : Digest) (j : Fin 32), decode (encode bytes) j = bytes j :=
fun bytes j =>
  of_eq_true
    (Eq.trans
      (congrFun'
        (congrArg Eq
          (List.getElem_ofFn (id (Eq.refl (List.ofFn bytes)) ▸ Eq.refl ↑j ▸ decode._proof_2 (encode bytes) j)))
        (bytes j))
      (eq_self
        (bytes
          ⟨↑j,
            List.getElem_ofFn._proof_1
              (id (Eq.refl (List.ofFn bytes)) ▸ Eq.refl ↑j ▸ decode._proof_2 (encode bytes) j)⟩)))
'NJP_DigestCarrier.coordinate' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem NJP_DigestCarrier.decode_encode : ∀ (bytes : Digest), decode (encode bytes) = bytes :=
fun bytes => funext (coordinate bytes)
'NJP_DigestCarrier.decode_encode' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem NJP_DigestCarrier.encode_decode : ∀ (bytes : RefDigest), encode (decode bytes) = bytes :=
fun bytes =>
  AspisR1.MultiproofConeNodeAdoption.array_ext (encode (decode bytes)) bytes fun j left right =>
    of_eq_true
      (Eq.trans
        (congrFun' (congrArg Eq (List.getElem_ofFn (id (Eq.refl (List.ofFn (decode bytes))) ▸ Eq.refl j ▸ left)))
          (↑bytes)[j])
        (eq_self (↑bytes)[j]))
'NJP_DigestCarrier.encode_decode' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem NJP_DigestCarrier.faithful : ∀ (left right : RefDigest), decode left = decode right → left = right :=
fun left right same =>
  Eq.mpr (id (congrArg (fun _a => _a = right) (Eq.symm (encode_decode left))))
    (Eq.mpr (id (congrArg (fun _a => encode (decode left) = _a) (Eq.symm (encode_decode right))))
      (Eq.mpr (id (congrArg (fun _a => encode _a = encode (decode right)) same)) (Eq.refl (encode (decode right)))))
'NJP_DigestCarrier.faithful' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem NJP_DigestCarrier.values_coordinate : ∀ (values : Fin 16 → Digest) (i : Fin 16),
  decodeValues (encodeValues values) i = values i :=
fun values i =>
  of_eq_true
    (Eq.trans
      (congrFun'
        (congrArg Eq
          (Eq.trans
            (congrArg decode
              (List.getElem_ofFn
                (id (Eq.refl (List.ofFn fun i => encode (values i))) ▸
                  Eq.refl ↑i ▸ decodeValues._proof_2 (encodeValues values) i)))
            (decode_encode
              (values
                ⟨↑i,
                  List.getElem_ofFn._proof_1
                    (id (Eq.refl (List.ofFn fun i => encode (values i))) ▸
                      Eq.refl ↑i ▸ decodeValues._proof_2 (encodeValues values) i)⟩))))
        (values i))
      (eq_self
        (values
          ⟨↑i,
            List.getElem_ofFn._proof_1
              (id (Eq.refl (List.ofFn fun i => encode (values i))) ▸
                Eq.refl ↑i ▸ decodeValues._proof_2 (encodeValues values) i)⟩)))
'NJP_DigestCarrier.values_coordinate' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem NJP_DigestCarrier.values_roundtrip : ∀ (values : Std.Array RefDigest 16#usize),
  encodeValues (decodeValues values) = values :=
fun values =>
  AspisR1.MultiproofConeNodeAdoption.array_ext (encodeValues (decodeValues values)) values fun j left right =>
    of_eq_true
      (Eq.trans
        (congrFun'
          (congrArg Eq
            (Eq.trans
              (GetElem.getElem.congr_simp (↑(encodeValues (decodeValues values))) (List.ofFn fun i => (↑values)[↑i])
                (congrArg Subtype.val
                  (Subtype.mk.congr_simp (List.ofFn fun i => encode (decodeValues values i))
                    (List.ofFn fun i => (↑values)[↑i])
                    (congrArg List.ofFn (funext fun i => encode_decode (↑values)[↑i]))
                    (encodeValues._proof_2 (decodeValues values))))
                j j (Eq.refl j) left)
              (List.getElem_ofFn
                (congrArg Subtype.val
                    (Subtype.mk.congr_simp (List.ofFn fun i => encode (decodeValues values i))
                      (List.ofFn fun i => (↑values)[↑i])
                      (congrArg List.ofFn (funext fun i => encode_decode (↑values)[↑i]))
                      (encodeValues._proof_2 (decodeValues values))) ▸
                  Eq.refl j ▸ left))))
          (↑values)[j])
        (eq_self (↑values)[j]))
'NJP_DigestCarrier.values_roundtrip' depends on axioms: [propext, Classical.choice, Quot.sound]
