theorem NJP_RowModel.exhausted_observation : ∀ (H : Request → Digest) (nodes : ℕ → U8) (length : ℕ) (s : Scratch)
  (i w : ℕ), s.n ≤ i → eval H (node nodes length s i w) = ([], ok (Row.next s i w)) :=
fun H nodes length s i w ended =>
  of_eq_true
    (Eq.trans
      (congrFun'
        (congrArg Eq
          (Eq.trans
            (congrArg (eval H)
              ((fun x_0 x_1 x_2 x_3 =>
                  (fun x_0 x_1 x_2 x_3 =>
                      if_neg
                        (have this := fun a => exhausted_observation._proof_1 s i ended a;
                        this))
                    x_0 x_1 x_2 x_3)
                (i.decLt s.n) Run
                (if paired s i then
                  Program.ask (occupiedRequest s i) fun reply =>
                    Program.done (ok (Row.next (write s i w s.cursor reply) (i + 2) (w + 1)))
                else
                  if s.cursor + 32 ≤ length then
                    Program.ask (siblingRequest s i nodes) fun reply =>
                      Program.done (ok (Row.next (write s i w (s.cursor + 32) reply) (i + 1) (w + 1)))
                  else Program.done (ok (Row.stop s)))
                (Program.done (ok (Row.next s i w)))))
            (eval.eq_1 H (ok (Row.next s i w)))))
        ([], ok (Row.next s i w)))
      (eq_self ([], ok (Row.next s i w))))
