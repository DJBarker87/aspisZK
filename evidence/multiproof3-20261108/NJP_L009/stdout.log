            ok (Row.next (write s i w (s.cursor + 32) (H (siblingRequest s i nodes))) (i + 1) (w + 1))) :=
fun H nodes length s i w active single available =>
  of_eq_true
    (Eq.trans
      (congrFun'
        (congrArg Eq
          (Eq.trans
            (congrArg (eval H)
              (Eq.trans
                (ite_congr (Eq.refl (i < s.n))
                  (fun a =>
                    Eq.trans
                      (ite_congr (Eq.refl (paired s i))
                        (fun a =>
                          Eq.refl
                            (Program.ask (occupiedRequest s i) fun reply =>
                              Program.done (ok (Row.next (write s i w s.cursor reply) (i + 2) (w + 1)))))
                        fun a =>
                        (fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_pos available) x_0 x_1 x_2 x_3)
                          ((s.cursor + 32).decLe length) Run
                          (Program.ask (siblingRequest s i nodes) fun reply =>
                            Program.done (ok (Row.next (write s i w (s.cursor + 32) reply) (i + 1) (w + 1))))
                          (Program.done (ok (Row.stop s))))
                      ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_neg single) x_0 x_1 x_2 x_3)
                        (instDecidablePaired s i) Run
                        (Program.ask (occupiedRequest s i) fun reply =>
                          Program.done (ok (Row.next (write s i w s.cursor reply) (i + 2) (w + 1))))
                        (Program.ask (siblingRequest s i nodes) fun reply =>
                          Program.done (ok (Row.next (write s i w (s.cursor + 32) reply) (i + 1) (w + 1))))))
                  fun a => Eq.refl (Program.done (ok (Row.next s i w))))
                ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_pos active) x_0 x_1 x_2 x_3) (i.decLt s.n) Run
                  (Program.ask (siblingRequest s i nodes) fun reply =>
                    Program.done (ok (Row.next (write s i w (s.cursor + 32) reply) (i + 1) (w + 1))))
                  (Program.done (ok (Row.next s i w))))))
            (eval.eq_2 H (siblingRequest s i nodes) fun reply =>
              Program.done (ok (Row.next (write s i w (s.cursor + 32) reply) (i + 1) (w + 1))))))
        ([(siblingRequest s i nodes, H (siblingRequest s i nodes))],
          ok (Row.next (write s i w (s.cursor + 32) (H (siblingRequest s i nodes))) (i + 1) (w + 1))))
      (eq_self
        ([(siblingRequest s i nodes, H (siblingRequest s i nodes))],
          ok (Row.next (write s i w (s.cursor + 32) (H (siblingRequest s i nodes))) (i + 1) (w + 1)))))
