theorem NJP_NativeStep.one : ∀ (H : Request → Digest) (nodes : ℕ → U8) (length : ℕ) (s : Scratch) (i w : ℕ)
  (after : Scratch) (ni nw : ℕ) (returned : Bool) (log : Log),
  Cut s i w length nodes (H (request log)) after ni nw returned log →
    eval H (node nodes length s i w) =
      (if log.calls = 0 then [] else [(request log, H (request log))],
        ok (if returned = true then Row.next after ni nw else Row.stop after)) :=
fun H nodes length s i w after ni nw returned log cut =>
  have post := state s i w length nodes (H (request log)) after ni nw returned log cut;
  if active : i < s.n then
    if both : paired s i then
      have entered := ⟨active, Or.inl both⟩;
      have args := arguments s i w length nodes (H (request log)) after ni nw returned log cut entered;
      Eq.mpr
        (id
          (congrArg
            (fun _a =>
              _a =
                (if log.calls = 0 then [] else [(request log, H (request log))],
                  ok (if returned = true then Row.next after ni nw else Row.stop after)))
            (occupied_observation H nodes length s i w active both)))
        (of_eq_true
          (Eq.trans
            (congrArg
              (Eq
                ([(occupiedRequest s i, H (occupiedRequest s i))],
                  ok (Row.next (write s i w s.cursor (H (occupiedRequest s i))) (i + 2) (w + 1))))
              (congr
                (congrArg Prod.mk
                  (Eq.trans
                    (ite_congr
                      (Eq.trans
                        (congrFun'
                          (congrArg Eq
                            (Eq.trans cut.count
                              ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_pos entered) x_0 x_1 x_2 x_3)
                                (instDecidableWrites s i length) ℕ 1 0)))
                          0)
                        (eq_false
                          (have this := of_decide_eq_true (id (Eq.refl true));
                          this)))
                      (fun a => Eq.refl []) fun a =>
                      congrFun'
                        (congrArg List.cons
                          (congr
                            (congrArg Prod.mk
