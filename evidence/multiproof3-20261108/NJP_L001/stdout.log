theorem NJP_ControllerTrace.chronology : ∀ (input : State) (states : Fin 23 → State),
  (NJE_RoundTrace.observed input states 0).input = input ∧
    ∀ (r : Fin 21),
      (NJE_RoundTrace.observed input states ⟨↑r + 1, ⋯⟩).input =
        (NJE_RoundTrace.observed input states ⟨↑r, ⋯⟩).output :=
fun input states => ⟨Eq.refl (NJE_RoundTrace.observed input states 0).input, sorry⟩
