NJP_BIT_OP Aeneas.Std.U64.xor_eq_zero_iff : ∀ (a b : Aeneas.Std.U64),
  a ^^^ b = 0#u64 ↔
    a =
      b value=fun a b =>
  Eq.mpr
    (id
      (congr
        (congrArg Iff
          (Eq.trans (Aeneas.Std.UScalar.eq_equiv_bv_eq._simp_1 (a ^^^ b) 0#u64)
            (congr
              (congrArg Eq
                (Eq.trans (Aeneas.Bvify.U64.UScalar_bv (a ^^^ b))
                  (Eq.trans (Aeneas.Std.UScalar.bv_xor a b)
                    (congr (congrArg HXor.hXor (Aeneas.Bvify.U64.UScalar_bv a)) (Aeneas.Bvify.U64.UScalar_bv b)))))
              (Eq.trans (Aeneas.Bvify.U64.UScalar_bv 0#u64)
                (Aeneas.Std.U64.ofNat_bv 0 (of_decide_eq_true (id (Eq.refl true))))))))
        (Eq.trans (Aeneas.Std.UScalar.eq_equiv_bv_eq._simp_1 a b)
          (congr (congrArg Eq (Aeneas.Bvify.U64.UScalar_bv a)) (Aeneas.Bvify.U64.UScalar_bv b)))))
    ((fun _ =>
        (fun _ =>
            (fun _ =>
                (fun _ =>
                    Decidable.byContradiction fun a_1 =>
                      False.elim
                        (Eq.mp
                          (Eq.trans
                            (congrArg Not
                              (Eq.trans
                                (Eq.trans
                                  (congr
                                    (congrArg Iff
                                      (Eq.trans (Std.Tactic.BVDecide.Normalize.BitVec.eq_to_beq (a.bv ^^^ b.bv) 0#64)
                                        (congrFun'
                                          (congrArg Eq
                                            (Std.Tactic.BVDecide.Frontend.Normalize.BitVec.xor_beq_zero_iff a.bv b.bv))
                                          true)))
                                    (Std.Tactic.BVDecide.Normalize.BitVec.eq_to_beq a.bv b.bv))
                                  (Std.Tactic.BVDecide.Normalize.Bool.iff_to_beq (a.bv == b.bv) (a.bv == b.bv)))
                                (Eq.trans
                                  (congrFun'
                                    (congrArg Eq (Std.Tactic.BVDecide.Normalize.Bool.beq_self_eq_true (a.bv == b.bv)))
                                    true)
                                  (eq_self true))))
                            not_true._simp_1)
                          a_1))
                  (Aeneas.Bvify.BitVec.iff_ofNat_eq' 64))
              (Aeneas.Bvify.BitVec.lt_pow_n_iff_ofNat_le 64))
          (Aeneas.Bvify.BitVec.lt_pow_lt_iff_ofNat_lt' 64))
      (Aeneas.Bvify.BitVec.lt_pow_le_iff_ofNat_le' 64))
NJP_BIT_OP Aeneas.Std.IScalar.and_spec : ∀ {ty : Aeneas.Std.IScalarTy} (x y : Aeneas.Std.IScalar ty),
  Aeneas.Std.WP.spec (Aeneas.Std.lift (x &&& y)) fun z =>
    ↑z = ↑(x &&& y) ∧
      z.bv =
        x.bv &&&
          y.bv value=fun {ty} x y =>
  Eq.mpr
    (id
      (Eq.trans (Aeneas.Std.WP.spec_ok._simp_1 (x &&& y))
        (Eq.trans (congrFun' (congrArg And (eq_self ↑(x &&& y))) ((x &&& y).bv = x.bv &&& y.bv))
          (true_and ((x &&& y).bv = x.bv &&& y.bv)))))
    (Eq.refl (x &&& y).bv)
