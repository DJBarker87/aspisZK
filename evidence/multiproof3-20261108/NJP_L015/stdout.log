theorem NJP_AbortPrefix.occupied_pending : ∀ (H : Request → Digest) (nodes : ℕ → U8) (length : ℕ) (s : Scratch)
  (i w : ℕ), i < s.n → paired s i → pending H 0 (node nodes length s i w) = some ([], occupiedRequest s i) :=
fun H nodes length s i w active both =>
  of_eq_true
    (Eq.trans
      (congrFun'
        (congrArg Eq
          (Eq.trans
            (congrArg (pending H 0)
              (Eq.trans
                (ite_congr (Eq.refl (i < s.n))
                  (fun a =>
                    (fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_pos both) x_0 x_1 x_2 x_3)
                      (instDecidablePaired s i) Run
                      (Program.ask (occupiedRequest s i) fun reply =>
                        Program.done (ok (Row.next (write s i w s.cursor reply) (i + 2) (w + 1))))
                      (if s.cursor + 32 ≤ length then
                        Program.ask (siblingRequest s i nodes) fun reply =>
                          Program.done (ok (Row.next (write s i w (s.cursor + 32) reply) (i + 1) (w + 1)))
                      else Program.done (ok (Row.stop s))))
                  fun a => Eq.refl (Program.done (ok (Row.next s i w))))
                ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_pos active) x_0 x_1 x_2 x_3) (i.decLt s.n) Run
                  (Program.ask (occupiedRequest s i) fun reply =>
                    Program.done (ok (Row.next (write s i w s.cursor reply) (i + 2) (w + 1))))
                  (Program.done (ok (Row.next s i w))))))
            (pending.eq_2 H (occupiedRequest s i) fun reply =>
              Program.done (ok (Row.next (write s i w s.cursor reply) (i + 2) (w + 1))))))
        (some ([], occupiedRequest s i)))
      (eq_self (some ([], occupiedRequest s i))))
