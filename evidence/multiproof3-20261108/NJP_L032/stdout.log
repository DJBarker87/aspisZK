theorem NJP_LevelsTotal.returning_carrier : ∀ (H : Request → Digest) (nodes : ℕ → U8) (length : ℕ) (root : Digest)
  (s : Scratch),
  0 < s.n → s.n ≤ 16 → length ≤ 9216 → ∃ accepted after, (eval H (run root nodes length s)).2 = ok (accepted, after) :=
fun H nodes length root s positive size bytes =>
  have domain := ⟨positive, ⟨size, ⟨Decidable.byContradiction fun a => sorry a, bytes⟩⟩⟩;
  let ⟨out, h✝⟩ :=
    levels_total H nodes length 18 { indices := s.indices, values := s.values, n := s.n, cursor := 0 } domain
  let ⟨result, right✝⟩ := h✝
  let history :=
    (eval H (levels nodes length 18 { indices := s.indices, values := s.values, n := s.n, cursor := 0 })).1;
  have observed := Prod.ext rfl result;
  id
    (Eq.mpr
      (id
        (congrArg (fun _a => ∃ accepted after, _a.2 = ok (accepted, after))
          (NJP_LoopBind.returned H
            (levels nodes length 18 { indices := s.indices, values := s.values, n := s.n, cursor := 0 })
            (fun result => Program.done (ok (finish root length result))) history out observed)))
      (Exists.intro (finish root length out).1 (Exists.intro (finish root length out).2 rfl)))
