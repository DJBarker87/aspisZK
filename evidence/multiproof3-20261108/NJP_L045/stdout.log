theorem NJP_NativeStep.one : ∀ (H : Request → Digest) (nodes : ℕ → U8) (length : ℕ) (s : Scratch) (i w : ℕ)
  (after : Scratch) (ni nw : ℕ) (returned : Bool) (log : Log),
  Cut s i w length nodes (H (request log)) after ni nw returned log →
    eval H (node nodes length s i w) =
      (if log.calls = 0 then [] else [(request log, H (request log))],
        ok (if returned = true then Row.next after ni nw else Row.stop after)) :=
fun H nodes length s i w after ni nw returned log cut =>
  have post := state s i w length nodes (H (request log)) after ni nw returned log cut;
  if active : i < s.n then sorry else if available : s.cursor + 32 ≤ length then sorry else sorry
'NJP_NativeStep.one' depends on axioms: [propext, sorryAx, Classical.choice, Quot.sound]
