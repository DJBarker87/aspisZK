theorem NJP_CheckedWords.add_one : ∀ (i : Usize), ↑i < 16 → ∃ next, i + 1#usize = ok next ∧ ↑next = ↑i + 1 :=
fun i bound =>
  have spec :=
    WP.spec_mono'
      (Usize.add_spec
        (Eq.mpr
          (id
            (congrFun'
              (congrArg LE.le
                (congrArg (HAdd.hAdd ↑i)
                  (UScalar.ofNatCore_val_eq
                    (UScalar.bound_suffices UScalarTy.Usize 1 (of_decide_eq_true (id (Eq.refl true)))))))
              Usize.max))
          (add_one._proof_1 i bound)))
      (Eq.mpr (id (add_one._simp_8 (fun z => ↑z = ↑i + ↑1#usize) fun next => ↑next = ↑i + 1))
        (id fun _x =>
          (fun _ next_post =>
              add_one._proof_12 i _x
                (Eq.mp
                  (congrArg (Eq ↑_x)
                    (congrArg (HAdd.hAdd ↑i)
                      (UScalar.ofNatCore_val_eq
                        (UScalar.bound_suffices UScalarTy.Usize 1 (of_decide_eq_true (id (Eq.refl true)))))))
                  next_post))
            (Step.eq_imp_prettyMonadEq (i + 1#usize) _x)));
  WP.spec_imp_exists spec
