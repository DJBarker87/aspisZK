theorem NJP_CohortRead.index : ∀ (s : reference.Scratch) (i : Usize),
  ↑i < 16 → NJP_RowModel.index (raw s) ↑i = ↑(↑s.idx)[↑i]! :=
fun s i bound =>
  have size := s.idx.property;
  of_eq_true
    (Eq.trans
      (congr
        (congrArg Eq
          (Eq.trans (dite_congr (Eq.refl (↑i < 16)) (fun h => Eq.refl ↑(↑s.idx)[↑i]) fun h => Eq.refl 0)
            ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => dif_pos bound) x_0 x_1 x_2 x_3) ((↑i).decLt 16) ℕ
              (fun h => ↑(↑s.idx)[↑i]) fun h => 0)))
        (congrArg UScalar.val
          (getElem!_pos (↑s.idx) (↑i) (Decidable.byContradiction fun a => index._proof_2 s i bound size a))))
      (eq_self ↑(↑s.idx)[↑i]))
'NJP_CohortRead.index' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem NJP_CohortRead.value : ∀ (s : reference.Scratch) (i : Usize),
  ↑i < 16 → NJP_RowModel.value (raw s) ↑i = decode (↑s.val)[↑i]! :=
fun s i bound =>
  have size := s.val.property;
  of_eq_true
    (Eq.trans
      (congr
        (congrArg Eq
          (Eq.trans
            (dite_congr (Eq.refl (↑i < 16)) (fun h => Eq.refl (decode (↑s.val)[↑i])) fun h => Eq.refl fun x => 0#u8)
            ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => dif_pos bound) x_0 x_1 x_2 x_3) ((↑i).decLt 16)
              NJP_RowModel.Digest (fun h => decode (↑s.val)[↑i]) fun h x => 0#u8)))
        (congrArg decode
          (getElem!_pos (↑s.val) (↑i) (Decidable.byContradiction fun a => value._proof_2 s i bound size a))))
      (eq_self (decode (↑s.val)[↑i])))
'NJP_CohortRead.value' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem NJP_CohortRead.xor_one : ∀ (x : U32), ↑(x ^^^ 1#u32) = (↑x).xor 1 :=
fun x => id (id (NJP_ScalarCarrier.sibling x))
'NJP_CohortRead.xor_one' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem NJP_CohortRead.parity : ∀ (x : U32), ↑(x &&& 1#u32) = ↑x % 2 :=
fun x => id (id (NJP_ScalarCarrier.parity x))
'NJP_CohortRead.parity' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem NJP_CohortRead.occupied_address : ∀ (s : reference.Scratch) (i next : Usize),
  ↑i < 16 →
    ↑next < 16 →
      ↑next = ↑i + 1 →
        NJP_RequestTransport.address (NJP_RowModel.occupiedRequest (raw s) ↑i) =
          AspisR1.MultiproofConePhysicalDigest.parts (↑s.val)[↑i]! (↑s.val)[↑next]! :=
fun s i next bound next_bound step =>
  id
    (id
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              AspisR1.MultiproofConePhysicalDigest.parts (encode (_a, NJP_RowModel.value (raw s) (↑i + 1)).1)
                  (encode (_a, NJP_RowModel.value (raw s) (↑i + 1)).2) =
                AspisR1.MultiproofConePhysicalDigest.parts (↑s.val)[↑i]! (↑s.val)[↑next]!)
            (value s i bound)))
        (Eq.mpr
          (id
            (congrArg
              (fun _a =>
                AspisR1.MultiproofConePhysicalDigest.parts
                    (encode (decode (↑s.val)[↑i]!, NJP_RowModel.value (raw s) _a).1)
                    (encode (decode (↑s.val)[↑i]!, NJP_RowModel.value (raw s) _a).2) =
                  AspisR1.MultiproofConePhysicalDigest.parts (↑s.val)[↑i]! (↑s.val)[↑next]!)
              (Eq.symm step)))
          (Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  AspisR1.MultiproofConePhysicalDigest.parts (encode (decode (↑s.val)[↑i]!, _a).1)
                      (encode (decode (↑s.val)[↑i]!, _a).2) =
                    AspisR1.MultiproofConePhysicalDigest.parts (↑s.val)[↑i]! (↑s.val)[↑next]!)
                (value s next next_bound)))
            (of_eq_true
              (Eq.trans
                (congrFun'
                  (congrArg Eq
                    (congr (congrArg AspisR1.MultiproofConePhysicalDigest.parts (encode_decode (↑s.val)[↑i]!))
                      (encode_decode (↑s.val)[↑next]!)))
                  (AspisR1.MultiproofConePhysicalDigest.parts (↑s.val)[↑i]! (↑s.val)[↑next]!))
                (eq_self (AspisR1.MultiproofConePhysicalDigest.parts (↑s.val)[↑i]! (↑s.val)[↑next]!))))))))
'NJP_CohortRead.occupied_address' depends on axioms: [propext, Classical.choice, Quot.sound]
