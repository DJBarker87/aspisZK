                              (Eq.mpr (id (congrArg (fun _a => _a = ↑0#u32) (NJP_CohortRead.parity (↑s.idx)[↑i]!)))
                                (Eq.mpr
                                  (id (congrArg (fun _a => _a % 2 = ↑0#u32) (Eq.symm (NJP_CohortRead.index s i ib))))
                                  (Eq.mpr (id (congrArg (fun _a => _a = ↑0#u32) h)) (Eq.refl 0)))) };
                      if even : NJP_RowModel.index (raw s) ↑i % 2 = 0 then sorry else sorry))))))))))
'NJP_CohortSupplied.available' depends on axioms: [propext, sorryAx, Classical.choice, Quot.sound]
