          (congrArg
            (fun _a =>
              Option.map
                  (fun x =>
                    match x with
                    | (events, last) => (history events, NJP_RequestTransport.address last))
                  _a =
                some (history events, NJP_RequestTransport.address last))
            aborted))
        (Eq.refl
          (Option.map
            (fun x =>
              match x with
