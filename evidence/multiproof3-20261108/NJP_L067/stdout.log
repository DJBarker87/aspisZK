    physicalPending H n (NJP_RequestTransport.transport p) = some (history events, NJP_RequestTransport.address last) ∧
      history events = List.take n (eval H (NJP_RequestTransport.transport p)).1 ∧ events.length = n :=
fun {α} H n p events last aborted =>
  ⟨Eq.mpr (id (congrArg (fun _a => _a = some (history events, NJP_RequestTransport.address last)) (same H n p)))
      (Eq.mpr
