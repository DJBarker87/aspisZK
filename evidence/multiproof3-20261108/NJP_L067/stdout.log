              (congrArg
                (fun _a =>
                  _a =
                    List.take n
                      (List.map (fun event => (NJP_RequestTransport.address event.1, encode event.2))
                        (eval (NJP_RequestTransport.hash H) p).1))
                (history.eq_1 events)))
            (Eq.mpr
              (id
                (congrArg
                  (fun _a =>
                    List.map (fun event => (NJP_RequestTransport.address event.1, encode event.2)) _a =
                      List.take n
                        (List.map (fun event => (NJP_RequestTransport.address event.1, encode event.2))
                          (eval (NJP_RequestTransport.hash H) p).1))
                  sameEvents))
              (Eq.mpr
