                            (NJP_RowModel.Row.next
                              (NJP_RowModel.write (raw s) (↑i) (↑w) (↑s.at + 32)
                                (decode (H (NJP_RequestTransport.address request))))
                              (↑i + 1) (↑w + 1)))) =
                        (List.map (fun event => (NJP_RequestTransport.address event.1, encode event.2)) _a.1, _a.2))
                    (NJP_RowModel.sibling_observation (NJP_RequestTransport.hash H) (fun n => (↑physical)[n]!)
                      (↑physical).length (raw s) (↑i) (↑w) active both enough)))
                (Eq.mpr
                  (id
                    (congrArg
                      (Eq
                        ([(NJP_RequestTransport.address
                                (NJP_RowModel.siblingRequest (raw s) ↑i fun n => (↑physical)[n]!),
                              H
                                (NJP_RequestTransport.address
                                  (NJP_RowModel.siblingRequest (raw s) ↑i fun n => (↑physical)[n]!)))],
