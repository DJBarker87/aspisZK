theorem NJP_CohortNode.observation : ∀ (H : Slice (Slice U8) → RefDigest) (s : reference.Scratch) (physical : Slice U8)
  (i w : Usize),
  AspisR1.MultiproofConeNodeDomain.RowDomain physical s i w →
    ↑i < ↑s.n →
      have typed := eval H (node s physical i w);
      (typed.1, mapResult projectRow typed.2) =
        eval H
          (NJP_RequestTransport.transport
            (NJP_RowModel.node (fun n => (↑physical)[n]!) (↑physical).length (raw s) ↑i ↑w)) :=
fun H s physical i w domain active =>
  if both : NJP_RowModel.paired (raw s) ↑i then NJP_CohortOccupied.occupied H s physical i w domain active both
  else
    have ib :=
      have this := domain.right.left;
      Decidable.byContradiction fun a => observation._proof_1 s i active this a;
    have wb :=
      have this := domain.right.right.right.left;
      Decidable.byContradiction fun a => observation._proof_2 s i w ib this a;
    let ⟨ni, h✝⟩ := NJP_CheckedWords.add_one i ib
    let ⟨addition, next_value⟩ := h✝
    id
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              ((eval H _a).1, mapResult projectRow (eval H _a).2) =
                eval H
                  (NJP_RequestTransport.transport
                    (NJP_RowModel.node (fun n => (↑physical)[n]!) (↑physical).length (raw s) ↑i ↑w)))
            (unpaired s physical i ni w active domain.right.left addition next_value both)))
        (if enough : ↑s.at + 32 ≤ (↑physical).length then
          Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  _a =
                    eval H
                      (NJP_RequestTransport.transport
                        (NJP_RowModel.node (fun n => (↑physical)[n]!) (↑physical).length (raw s) ↑i ↑w)))
                (NJP_CohortSupplied.available H s physical i ni w next_value ib wb enough)))
            (Eq.mpr
              (id
                (congrArg
                  (fun _a =>
                    (have request := NJP_RowModel.siblingRequest (raw s) ↑i fun n => (↑physical)[n]!;
                      ([(NJP_RequestTransport.address request, H (NJP_RequestTransport.address request))],
                        ok
                          (NJP_RowModel.Row.next
                            (NJP_RowModel.write (raw s) (↑i) (↑w) (↑s.at + 32)
                              (decode (H (NJP_RequestTransport.address request))))
                            (↑i + 1) (↑w + 1)))) =
                      _a)
                  (NJP_RequestTransport.observation H
