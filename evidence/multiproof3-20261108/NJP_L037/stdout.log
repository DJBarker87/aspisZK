theorem NJP_WriteCarrier.state_ext : ∀ (left right : Scratch),
  left.indices = right.indices →
    left.values = right.values → left.n = right.n → left.cursor = right.cursor → left = right :=
fun left right indices values count cursor =>
  let ⟨indices✝, values✝, n✝, cursor✝, h✝⟩ := left
  Eq.ndrec (motive := fun left =>
    left.indices = right.indices →
      left.values = right.values → left.n = right.n → left.cursor = right.cursor → left = right)
    (fun indices values count cursor =>
      let ⟨indices✝¹, values✝¹, n✝¹, cursor✝¹, h✝¹⟩ := right
      Eq.ndrec (motive := fun right =>
        { indices := indices✝, values := values✝, n := n✝, cursor := cursor✝ }.indices = right.indices →
          { indices := indices✝, values := values✝, n := n✝, cursor := cursor✝ }.values = right.values →
            { indices := indices✝, values := values✝, n := n✝, cursor := cursor✝ }.n = right.n →
              { indices := indices✝, values := values✝, n := n✝, cursor := cursor✝ }.cursor = right.cursor →
                { indices := indices✝, values := values✝, n := n✝, cursor := cursor✝ } = right)
        (fun indices values count cursor =>
          of_eq_true
            (Eq.trans
              (congrFun'
                (congrArg Eq
                  (congr (congr (congr (congrArg Scratch.mk (id (id indices))) (id (id values))) (id (id count)))
                    (id (id cursor))))
                { indices := indices✝¹, values := values✝¹, n := n✝¹, cursor := cursor✝¹ })
              (eq_self { indices := indices✝¹, values := values✝¹, n := n✝¹, cursor := cursor✝¹ })))
        (Eq.symm h✝¹) indices values count cursor)
    (Eq.symm h✝) indices values count cursor
