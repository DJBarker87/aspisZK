theorem NJP_ScalarCarrier.word_value : ∀ n < 2 ^ 32, ↑(word n) = n :=
fun n bound => id (Nat.mod_eq_of_lt bound)
'NJP_ScalarCarrier.word_value' depends on axioms: [propext]
theorem NJP_ScalarCarrier.word_roundtrip : ∀ (x : U32), word ↑x = x :=
fun x => UScalar.eq_of_val_eq (word_value (↑x) (BitVec.isLt x.bv))
'NJP_ScalarCarrier.word_roundtrip' depends on axioms: [propext]
theorem NJP_ScalarCarrier.size_value : ∀ n < 2 ^ System.Platform.numBits, ↑(size n) = n :=
fun n bound => id (Nat.mod_eq_of_lt bound)
'NJP_ScalarCarrier.size_value' depends on axioms: [propext]
theorem NJP_ScalarCarrier.size_roundtrip : ∀ (x : Usize), size ↑x = x :=
fun x => UScalar.eq_of_val_eq (size_value (↑x) (BitVec.isLt x.bv))
'NJP_ScalarCarrier.size_roundtrip' depends on axioms: [propext]
theorem NJP_ScalarCarrier.half : ∀ (x : U32), (x.bv >>> 1).toNat = ↑x / 2 :=
fun x =>
  Eq.mpr
    (id
      (congrFun'
        (congrArg Eq
          (Eq.trans (Nat.shiftRight_eq_div_pow x.bv.toNat 1) (congrArg (HDiv.hDiv x.bv.toNat) (Nat.pow_one 2))))
        (↑x / 2)))
    (Eq.refl (x.bv.toNat / 2))
'NJP_ScalarCarrier.half' depends on axioms: [propext]
theorem NJP_ScalarCarrier.parity : ∀ (x : U32), (x.bv &&& 1).toNat = ↑x % 2 :=
fun x => id (Nat.and_one_is_mod x.bv.toNat)
'NJP_ScalarCarrier.parity' depends on axioms: [propext, Quot.sound]
theorem NJP_ScalarCarrier.sibling : ∀ (x : U32), (x.bv ^^^ 1).toNat = (↑x).xor 1 :=
fun x => id (Eq.refl (x.bv.toNat ^^^ BitVec.toNat 1))
'NJP_ScalarCarrier.sibling' depends on axioms: [propext, Quot.sound]
