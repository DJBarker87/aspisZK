theorem NJP_PermutationPacket.model_domain : ∀ (input : State), NJE_RoundTrace.Canonical (model input) :=
fun input i => NJP_FieldEncoding.canonical (R0P.poseidonPermutation (NJE_RoundTrace.cast input) i)
