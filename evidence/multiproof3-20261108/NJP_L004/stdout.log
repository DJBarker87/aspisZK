theorem NJP_PermutationPacket.TX1_306 : ∀ (input : State) (states : Fin 23 → State)
  (control : Fin 22 → ℕ × NJA_Trace.Kind),
  NJP_ControllerTrace.Cut input states control →
    states (Fin.last 22) = model input ∧
      ok ((), states (Fin.last 22)) = ok ((), model input) ∧
        ∀ (r : Fin 22),
          ((NJE_RoundTrace.observed input states r).round, (NJE_RoundTrace.observed input states r).kind) = control r :=
fun input states control cut =>
  let ⟨canonical, right✝⟩ := NJP_ControllerTrace.result input states control cut
  let ⟨value, right✝¹⟩ := right✝
  let ⟨left✝, descriptors⟩ := right✝¹
  have raw :=
    funext fun i =>
      NJP_FieldEncoding.unique (states (Fin.last 22) i) (R0P.poseidonPermutation (NJE_RoundTrace.cast input) i)
        (canonical i) (congrFun value i);
  ⟨raw, ⟨congrArg (fun s => ok ((), s)) raw, descriptors⟩⟩
