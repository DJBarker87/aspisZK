          after = { raw := b.raw.set index updated, terms := b.terms } :=
fun arrayIntoIter b after index power basis run =>
  let ⟨row, h✝⟩ :=
    Port23PUSH.bind_ok✝
      (alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice (Std.Array U64 4#usize)) b.raw index)
      (fun x => do
        let updated ←
          Port23PUSH.verifier.update_residue_row arrayIntoIter x power basis (decide (b.terms &&& 3#usize = 3#usize))
        ok { raw := b.raw.set index updated, terms := b.terms })
      after
      (Eq.mp (congrArg (fun _a => _a = ok after) (Port23PUSH.push_complete arrayIntoIter b index power basis)) run)
  let ⟨hr, run⟩ := h✝
  let ⟨updated, h✝¹⟩ :=
    Port23PUSH.bind_ok✝
      (Port23PUSH.verifier.update_residue_row arrayIntoIter row power basis (decide (b.terms &&& 3#usize = 3#usize)))
      (fun x => ok { raw := b.raw.set index x, terms := b.terms }) after run
  let ⟨hu, run⟩ := h✝¹
  Exists.intro row (Exists.intro updated ⟨hr, ⟨hu, Eq.symm (ok.inj run)⟩⟩)
theorem Port23PUSH.push_terms_length : ∀ (arrayIntoIter : Port23PUSH.ArrayIntoIter)
  (b after : Port23PUSH.verifier.BatchedWeights) (index : Usize) (power : Port23PUSH.field.QM31)
