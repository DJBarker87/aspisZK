    after.terms = b.terms ∧ (↑after.raw).length = (↑b.raw).length :=
fun arrayIntoIter b after index power basis run =>
  let ⟨row, h✝⟩ := Port23PUSH.push_success_frame arrayIntoIter b after index power basis run
  let ⟨updated, h✝¹⟩ := h✝
  let ⟨hr, right✝⟩ := h✝¹
  let ⟨hu, frame⟩ := right✝
  Eq.ndrec (motive := fun after =>
    Port23PUSH.verifier.BatchedWeights.push arrayIntoIter b index power basis = ok after →
      after.terms = b.terms ∧ (↑after.raw).length = (↑b.raw).length)
    (fun run =>
      ⟨rfl, of_eq_true (Eq.trans (congrFun' (congrArg Eq List.length_set) (↑b.raw).length) (eq_self (↑b.raw).length))⟩)
    (Eq.symm frame) run
