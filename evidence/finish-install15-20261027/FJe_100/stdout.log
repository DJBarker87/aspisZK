    native2 hashv extraction sha256 H p1 syscall data1 data2 slot state1 state2 final1 final2 saved post1 post2
    accepted1 accepted2 root length prior words p t u actions game RuntimePersistence D P Q0 Q1 queries runtime
    finishOwners binding =>
  let ⟨p6, right✝⟩ :=
    AspisR1.FIs_Top.deployed L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 c indexError reservation native1
      native2 hashv extraction sha256 H p1 syscall data1 data2 slot state1 state2 final1 final2 saved post1 post2
      accepted1 accepted2 root length prior words p t u actions game RuntimePersistence D P Q0 Q1 queries runtime
      finishOwners binding
  let ⟨driver, right✝¹⟩ := right✝
  let ⟨sdkEq, right✝²⟩ := right✝¹
  let ⟨result, right✝³⟩ := right✝²
  let ⟨security, right✝⁴⟩ := right✝³
  let ⟨copyFacts, right✝⁵⟩ := right✝⁴
  let ⟨events, right✝⁶⟩ := right✝⁵
  let ⟨protection, right✝⁷⟩ := right✝⁶
  let ⟨trace, right✝⁸⟩ := right✝⁷
  let ⟨recorder, s6⟩ := right✝⁸
  ⟨p6, ⟨driver, ⟨sdkEq, ⟨result, ⟨security, ⟨copyFacts, ⟨events, ⟨protection, ⟨trace, ⟨recorder, s6⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩
