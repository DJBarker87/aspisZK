+fn child1_omit(p:&Pubkey,a:&[OwnedAccount],d:&[u8])->Result<Vec<u8>,ProgramError>{inspect_parent(p,a,d);parent_port(p).log.borrow_mut().calls-=1;parent_port(p).log.borrow_mut().reply.take().unwrap()}
+fn child2_omit(p:&Pubkey,a:&[OwnedAccount],d:&[u8],slot:Result<u64,ProgramError>)->ProgramResult{inspect_parent(p,a,d);let mut l=parent_port(p).log.borrow_mut();l.calls-=1;l.seen_slot=Some(slot);l.reply.take().unwrap().map(|_|())}
