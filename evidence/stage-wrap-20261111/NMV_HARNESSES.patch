+fn parent_stage1_direct<const MODE:u8,const ARM:u8,const PORT:usize>(){
+ let ports:[AccountPort;7]=core::array::from_fn(|_|AccountPort{key:Pubkey::new_from_array(kani::any()),log:UnsafeCell::new(Log::default())});
+ let owners:[Pubkey;7]=core::array::from_fn(|_|Pubkey::new_from_array(kani::any()));
+ let signs:[bool;7]=kani::any();let writes:[bool;7]=kani::any();let execs:[bool;7]=kani::any();
+ let mut money:[u64;7]=kani::any();let mut bytes:[[u8;1];7]=kani::any();let original=bytes;
+ let [m0,_,m2,_,_,_,_]=&mut money;let [b0,_,b2,_,_,_,_]=&mut bytes;
+ let a=AccountInfo::new(&ports[0].key,signs[0],writes[0],m0,b0,&owners[0],execs[0],0);
+ let c=AccountInfo::new(&ports[2].key,signs[2],writes[2],m2,b2,&owners[2],execs[2],0);
+ let mut accounts=core::mem::ManuallyDrop::new([a.clone(),a.clone(),c.clone(),a.clone(),a.clone(),a.clone(),a.clone()]);
+ for j in 0..7 {accounts[j].key=&ports[j].key;accounts[j].owner=&owners[j];accounts[j].is_signer=signs[j];accounts[j].is_writable=writes[j];accounts[j].executable=execs[j];}
+ let selected:usize=PORT;let byte:usize=kani::any();kani::assume(byte<32);
+ let data1=[3u8,if kani::any(){10}else{11}];let data2=[65u8,83,81,56];let data=if false{&data2[..]}else{&data1[..]};
+ let input:[u8;1]=kani::any();let error=ProgramError::Custom(kani::any());let expected_error=error.clone();let n:usize=if ARM==3{0}else{1};let mut checkpoint=Vec::new();for i in 0..n{checkpoint.push(input[i]);}
+ let reply=if ARM==1 {Err(error)}else{Ok(checkpoint)};
+ let p=ParentPort{key:Pubkey::new_from_array(kani::any()),log:UnsafeCell::new(ParentLog{expected:accounts.as_ptr().cast(),count:if false{7}else{3},data:data.as_ptr(),len:data.len(),payload_length:1,selected,byte,calls:0,seen_data:core::ptr::null(),seen_len:0,reply:Some(reply),seen_slot:None})};
+ let hold=if ARM==2 {Some(accounts[2].data.borrow())}else{None};
+ if MODE==2 {unsafe{&mut *p.log.get()}.expected=unsafe{accounts.as_ptr().add(1)}.cast();unsafe{&mut *p.log.get()}.selected=0;}
+ let result=stage1(&p.key,&accounts[..3],data);
+ let l=unsafe{&*p.log.get()};assert_eq!(l.calls,1);
+ assert_eq!(l.seen_data,data.as_ptr());assert_eq!(l.seen_len,data.len());
+ if ARM==1 {if MODE==1{assert!(result.is_ok());}else{assert_eq!(result,Err(expected_error));}}
+ else if ARM==2&&!false {assert_eq!(result,Err(ProgramError::AccountBorrowFailed));}
+ else {assert!(result.is_ok());}
+ let i:usize=kani::any();kani::assume(i<1);
+ let aidx:usize=kani::any();kani::assume(aidx<if false{7}else{3});
+ if !false&&ARM==0&&aidx==2 {assert_eq!(accounts[aidx].data.borrow()[i],input[i]);}
+ else {assert_eq!(accounts[aidx].data.borrow()[i],original[if aidx==2{2}else{0}][i]);}
+ for j in 0..if false{7}else{3} {
+  let expect=if false{match j{0=>(58295,58295),1=>(384,384),2=>(192,192),3=>(768,768),4=>(128,256),5=>(192,320),_=>(1768,1768)}}else{match j{0=>(58295,58295),1=>(1880,1880),_=>(1768,1768)}};
+  let log=unsafe{&*ports[j].log.get()};assert_eq!((log.first,log.second),expect);
+ }
+ drop(hold);
+}
