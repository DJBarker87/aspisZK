+// Parent-only oracle: original program-id reference points into this local
+// allocation; snapshots and child replies have independent full typed slots.
+#[repr(C)]
+struct ParentPort { key: Pubkey, log: RefCell<ParentLog> }
+struct ParentLog {
+ expected: *const AccountInfo<'static>, count:usize,
+ data:*const u8, len:usize, selected:usize, byte:usize,
+ calls:usize, seen_data:*const u8, seen_len:usize,
+ reply:Option<Result<Vec<u8>,ProgramError>>,
+ seen_slot:Option<Result<u64,ProgramError>>,
+}
+fn parent_port(p:&Pubkey)->&ParentPort{unsafe{&*(p as *const Pubkey as *const ParentPort)}}
+fn snapshot_log(a:&AccountInfo<'_>,l1:usize,l2:usize)->OwnedAccount{
+ {let mut l=port(a).log.borrow_mut();l.first=l1;l.second=l2;}
+ let (length,bytes)=match a.data.try_borrow(){
+  Ok(data)=>{let n=data.len();(Ok(n),if n==l1||n==l2 {Ok(data.to_vec())}else{Err(ProgramError::InvalidAccountData)})},
+  Err(_)=>(Err(ProgramError::AccountBorrowFailed),Err(ProgramError::AccountBorrowFailed)),
+ };
+ OwnedAccount{key:*a.key,owner:*a.owner,is_signer:a.is_signer,is_writable:a.is_writable,executable:a.executable,length,bytes}
+}
+fn inspect_parent(p:&Pubkey,a:&[OwnedAccount],d:&[u8]){
+ let mut log=parent_port(p).log.borrow_mut();log.calls+=1;log.seen_data=d.as_ptr();log.seen_len=d.len();
+ assert_eq!(a.len(),log.count);assert_eq!(d.as_ptr(),log.data);assert_eq!(d.len(),log.len);
+ let i=log.selected;let k=log.byte;let expected=unsafe{&*log.expected.add(i)};
+ assert_eq!(a[i].key.as_ref()[k],expected.key.as_ref()[k]);
+ assert_eq!(a[i].owner.as_ref()[k],expected.owner.as_ref()[k]);
+ assert_eq!(a[i].is_signer,expected.is_signer);assert_eq!(a[i].is_writable,expected.is_writable);assert_eq!(a[i].executable,expected.executable);
+ assert_eq!(a[i].length,Ok(4));
+ assert!(matches!(a[i].bytes,Err(ProgramError::InvalidAccountData)));
+}
+fn child1(p:&Pubkey,a:&[OwnedAccount],d:&[u8])->Result<Vec<u8>,ProgramError>{
+ inspect_parent(p,a,d);parent_port(p).log.borrow_mut().reply.take().unwrap()
+}
+fn child2(p:&Pubkey,a:&[OwnedAccount],d:&[u8],slot:Result<u64,ProgramError>)->ProgramResult{
+ inspect_parent(p,a,d);let mut l=parent_port(p).log.borrow_mut();l.seen_slot=Some(slot);
+ l.reply.take().unwrap().map(|_|())
+}
+fn clear(d:&[u8]){assert!(d.is_empty(),"empty return-data clear argument");}
+fn clock()->Result<Clock,ProgramError>{
+ if kani::any(){Ok(Clock{slot:kani::any(),epoch_start_timestamp:kani::any(),epoch:kani::any(),leader_schedule_epoch:kani::any(),unix_timestamp:kani::any()})}
+ else{Err(ProgramError::Custom(kani::any()))}
+}
+fn parent_test<const SECOND:bool,const MODE:u8,const ARM:u8>(){
+ let ports:[Port;7]=core::array::from_fn(|_|Port{key:Pubkey::new_from_array(kani::any()),log:RefCell::new(Log::default())});
+ let owners:[Pubkey;7]=core::array::from_fn(|_|Pubkey::new_from_array(kani::any()));
+ let signs:[bool;7]=kani::any();let writes:[bool;7]=kani::any();let execs:[bool;7]=kani::any();
+ let mut money:[u64;7]=kani::any();let mut bytes:[[u8;4];7]=kani::any();let original=bytes;
+ let [m0,m1,m2,m3,m4,m5,m6]=&mut money;let [b0,b1,b2,b3,b4,b5,b6]=&mut bytes;
+ let accounts=[
+ AccountInfo::new(&ports[0].key,signs[0],writes[0],m0,b0,&owners[0],execs[0],0),
+ AccountInfo::new(&ports[1].key,signs[1],writes[1],m1,b1,&owners[1],execs[1],0),
+ AccountInfo::new(&ports[2].key,signs[2],writes[2],m2,b2,&owners[2],execs[2],0),
+ AccountInfo::new(&ports[3].key,signs[3],writes[3],m3,b3,&owners[3],execs[3],0),
+ AccountInfo::new(&ports[4].key,signs[4],writes[4],m4,b4,&owners[4],execs[4],0),
+ AccountInfo::new(&ports[5].key,signs[5],writes[5],m5,b5,&owners[5],execs[5],0),
+ AccountInfo::new(&ports[6].key,signs[6],writes[6],m6,b6,&owners[6],execs[6],0)];
+ let selected:usize=kani::any();kani::assume(selected<if SECOND{7}else{3});let byte:usize=kani::any();kani::assume(byte<32);
+ let data1=[3u8,if kani::any(){10}else{11}];let data2=[65u8,83,81,56];let data=if SECOND{&data2[..]}else{&data1[..]};
+ let input:[u8;4]=kani::any();let code:u32=kani::any();let n:usize=if ARM==3{3}else{4};let mut checkpoint=Vec::new();for i in 0..n{checkpoint.push(input[i]);}
+ let reply=if ARM==1 {Err(ProgramError::Custom(code))}else{Ok(checkpoint)};
+ let p=ParentPort{key:Pubkey::new_from_array(kani::any()),log:RefCell::new(ParentLog{expected:accounts.as_ptr().cast(),count:if SECOND{7}else{3},data:data.as_ptr(),len:data.len(),selected,byte,calls:0,seen_data:core::ptr::null(),seen_len:0,reply:Some(reply),seen_slot:None})};
+ let hold=if ARM==2 {Some(accounts[2].data.borrow())}else{None};
+ if MODE==2 {p.log.borrow_mut().expected=unsafe{accounts.as_ptr().add(1)}.cast();p.log.borrow_mut().selected=0;}
+ let result=if SECOND{stage2(&p.key,&accounts,data)}else{stage1(&p.key,&accounts[..3],data)};
+ let l=p.log.borrow();assert_eq!(l.calls,1);
+ assert_eq!(l.seen_data,data.as_ptr());assert_eq!(l.seen_len,data.len());
+ if ARM==1 {assert_eq!(result,Err(ProgramError::Custom(if MODE==1{code^1}else{code})));}
+ else if ARM==2&&!SECOND {assert_eq!(result,Err(ProgramError::AccountBorrowFailed));}
+ else {assert!(result.is_ok());}
+ let i:usize=kani::any();kani::assume(i<4);
+ let aidx:usize=kani::any();kani::assume(aidx<if SECOND{7}else{3});
+ if !SECOND&&ARM==0&&aidx==2 {assert_eq!(accounts[aidx].data.borrow()[i],input[i]);}
+ else {assert_eq!(accounts[aidx].data.borrow()[i],original[aidx][i]);}
+ for j in 0..if SECOND{7}else{3} {
+  let expect=if SECOND{match j{0=>(58295,58295),1=>(384,384),2=>(192,192),3=>(768,768),4=>(128,256),5=>(192,320),_=>(1768,1768)}}else{match j{0=>(58295,58295),1=>(1880,1880),_=>(1768,1768)}};
+  let log=ports[j].log.borrow();assert_eq!((log.first,log.second),expect);
+ }
+ drop(hold);
+}
