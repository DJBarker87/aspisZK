+fn snapshot_one(a:&AccountInfo<'_>,l1:usize,l2:usize)->OwnedAccount{
+ {let mut l=unsafe{&mut *account_port(a).log.get()};l.first=l1;l.second=l2;}
+ // CLOSED snapshot boundary specialized to the small free/read-shared class.
+ // Every admitted source constant exceeds4, so the deferred bytes Err is exact;
+ // NLF supplies acquire/drop and universal byte laws in the Lean composition.
+ assert!(l1>1&&l2>1);
+ let length=Ok(1);let bytes=Err(ProgramError::InvalidAccountData);
+ OwnedAccount{key:*a.key,owner:*a.owner,is_signer:a.is_signer,is_writable:a.is_writable,executable:a.executable,length,bytes}
