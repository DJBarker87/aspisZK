+fn any_program_error()->ProgramError{
+ let tag:u8=kani::any();kani::assume(tag<26);
+ match tag{
+ 0=>ProgramError::Custom(kani::any()),
+ 1=>ProgramError::InvalidArgument,2=>ProgramError::InvalidInstructionData,3=>ProgramError::InvalidAccountData,
+ 4=>ProgramError::AccountDataTooSmall,5=>ProgramError::InsufficientFunds,6=>ProgramError::IncorrectProgramId,
+ 7=>ProgramError::MissingRequiredSignature,8=>ProgramError::AccountAlreadyInitialized,9=>ProgramError::UninitializedAccount,
+ 10=>ProgramError::NotEnoughAccountKeys,11=>ProgramError::AccountBorrowFailed,12=>ProgramError::MaxSeedLengthExceeded,
+ 13=>ProgramError::InvalidSeeds,14=>{let c:char=kani::any();ProgramError::BorshIoError(c.to_string())},
+ 15=>ProgramError::AccountNotRentExempt,16=>ProgramError::UnsupportedSysvar,17=>ProgramError::IllegalOwner,
+ 18=>ProgramError::MaxAccountsDataAllocationsExceeded,19=>ProgramError::InvalidRealloc,20=>ProgramError::MaxInstructionTraceLengthExceeded,
+ 21=>ProgramError::BuiltinProgramsMustConsumeComputeUnits,22=>ProgramError::InvalidAccountOwner,
+ 23=>ProgramError::ArithmeticOverflow,24=>ProgramError::Immutable,_=>ProgramError::IncorrectAuthority,
+ }
+}
+// Parent-only oracle: original program-id reference points into this local
+// allocation; snapshots and child replies have independent full typed slots.
+#[repr(C)]
+struct ParentPort { key: Pubkey, log: UnsafeCell<ParentLog> }
+#[repr(C)]
+struct AccountPort { key:Pubkey, log:UnsafeCell<Log> }
+fn account_port<'a>(a:&'a AccountInfo<'_>)->&'a AccountPort{unsafe{&*(a.key as *const Pubkey as *const AccountPort)}}
+fn exclusive_parent<'a,'info: 'info>(a:&'a AccountInfo<'info>)->Result<core::cell::RefMut<'a,&'info mut [u8]>,ProgramError>{
+ unsafe{(*account_port(a).log.get()).writes+=1;}
+ a.data.try_borrow_mut().map_err(|_|ProgramError::AccountBorrowFailed)
+}
+struct ParentLog {
+ expected: *const AccountInfo<'static>, count:usize,
+ data:*const u8, len:usize, payload_length:usize, selected:usize, byte:usize,
+ calls:usize, seen_data:*const u8, seen_len:usize,
+ reply:Option<Result<Vec<u8>,ProgramError>>,
+ seen_slot:Option<Result<u64,ProgramError>>,
+}
+fn parent_port(p:&Pubkey)->&ParentPort{unsafe{&*(p as *const Pubkey as *const ParentPort)}}
+fn snapshot_log(a:&AccountInfo<'_>,l1:usize,l2:usize)->OwnedAccount{
+ {let mut l=unsafe{&mut *account_port(a).log.get()};l.first=l1;l.second=l2;}
+ // CLOSED snapshot boundary specialized to the small free/read-shared class.
+ // Every admitted source constant exceeds4, so the deferred bytes Err is exact;
+ // NLF supplies acquire/drop and universal byte laws in the Lean composition.
+ assert!(l1>4&&l2>4);
+ let length=Ok(4);let bytes=Err(ProgramError::InvalidAccountData);
+ OwnedAccount{key:*a.key,owner:*a.owner,is_signer:a.is_signer,is_writable:a.is_writable,executable:a.executable,length,bytes}
+}
+fn inspect_parent(p:&Pubkey,a:&[OwnedAccount],d:&[u8]){
+ let mut log=unsafe{&mut *parent_port(p).log.get()};log.calls+=1;log.seen_data=d.as_ptr();log.seen_len=d.len();
+ assert_eq!(a.len(),log.count);assert_eq!(d.as_ptr(),log.data);assert_eq!(d.len(),log.len);
+ let i=log.selected;let k=log.byte;let expected=unsafe{&*log.expected.add(i)};
+ assert_eq!(a[i].key.as_ref()[k],expected.key.as_ref()[k]);
+ assert_eq!(a[i].owner.as_ref()[k],expected.owner.as_ref()[k]);
+ assert_eq!(a[i].is_signer,expected.is_signer);assert_eq!(a[i].is_writable,expected.is_writable);assert_eq!(a[i].executable,expected.executable);
+ assert_eq!(a[i].length,Ok(log.payload_length));
+ assert!(matches!(a[i].bytes,Err(ProgramError::InvalidAccountData)));
+}
+fn child1(p:&Pubkey,a:&[OwnedAccount],d:&[u8])->Result<Vec<u8>,ProgramError>{
+ inspect_parent(p,a,d);unsafe{&mut *parent_port(p).log.get()}.reply.take().unwrap()
+}
+fn child2(p:&Pubkey,a:&[OwnedAccount],d:&[u8],slot:Result<u64,ProgramError>)->ProgramResult{
+ inspect_parent(p,a,d);let mut l=unsafe{&mut *parent_port(p).log.get()};l.seen_slot=Some(slot);
+ l.reply.take().unwrap().map(|_|())
+}
+fn clear(d:&[u8]){assert!(d.is_empty(),"empty return-data clear argument");}
