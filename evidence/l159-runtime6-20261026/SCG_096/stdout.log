          frame →
        AspisR1.BinRawByteCutRecovery.cut
            (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.SCE_Experiment.account c hashv copy allocator id a)).1
            frame =
          AspisR1.BinRawByteCutRecovery.cut
            ((AspisV8R19.MemoizedProgramLaw.eval H a.first).1 ++
                (AspisV8R19.MemoizedProgramLaw.eval H
                    (AspisR1.SCE_Execution.firstCode c hashv copy allocator id
