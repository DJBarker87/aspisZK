              (AspisV8R19.MemoizedProgramLaw.eval H
                  (AspisR1.SCE_Execution.secondCode c hashv allocator id
                    (AspisV8R19.MemoizedProgramLaw.eval H
                        (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post final)).2)).1)
            frame
