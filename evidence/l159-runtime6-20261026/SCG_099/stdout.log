      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (id : AspisR1.S2W_ExtractionBoundary.Program)
  (a : AspisR1.SCE_Experiment.Adversary A) (Q0 Q1 : ℕ),
  (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      (AspisV8R19.MemoizedProgramLaw.eval H a.first).1.length ≤ Q0) →
    (∀ (i : AspisR1.GExq_AccountExperiment.FirstInputs A) (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
        (post : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record)) (final : A)
        (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
        (AspisV8R19.MemoizedProgramLaw.eval H (a.second i saved post final)).1.length ≤ Q1) →
      ∀
        (project :
          AspisR1.GExq_AccountExperiment.Outcome A → AspisR1.OraclePortCompactDraft.Parsed × (Fin 22 → Fin 262144))
        (select :
          AspisR1.GExq_AccountExperiment.Outcome A →
            AspisR1.R9PoolRuntimeBinding.Inputs × AspisR1.R9PoolRuntimeBinding.Inputs),
        (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
            (AspisV8R19.MemoizedProgramLaw.eval H
                    (AspisR1.SCE_Experiment.account c hashv copy allocator id a)).1.length ≤
              Q0 + Q1 + 1921) ∧
          (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
              FS.firstReads FS.emptyTable
                  (AspisV8R19.MemoizedProgramLaw.eval H
                      (AspisR1.Hiq_RecordedJoint.program (AspisR1.SCE_Experiment.account c hashv copy allocator id a)
                        project select)).1 ≤
                Q0 + Q1 + 2965) ∧
            AspisR1.F3T_AccountCharge.mass (AspisR1.SCE_Experiment.account c hashv copy allocator id a) project select
                (Q0 + Q1) ≤
              AspisR1.F3T_Numeric.accountLoss (Q0 + Q1)
AspisR1.SCF_Domination.pointwise_of_agreement : ∀ (left right : AspisR1.RawCutProverCompiler.RunView) (bad : Prop),
  (left.2.2 = Bool.true →
      ¬bad → right.2.2 = Bool.true ∧ AspisR1.OraclePortRefineJoin.RecoveredInputAgreement left right) →
    AspisR1.RawRecordedOracleExtractionMassBin.failureMass left ≤
      AspisR1.RawRecordedOracleExtractionMassBin.failureMass right + AspisV8R19.CausalFirstHitUnionBound.indicator bad
def AspisR1.F3T_Runtime.deployedFailure : AspisR1.F3T_Runtime.Runtime → ℚ :=
fun runtime => AspisV8R19.MemoizedProgramLaw.lazyMean runtime FS.emptyTable AspisR1.F3T_Runtime.runtimeMass
def AspisR1.F3T_Runtime.runtimeMass : AspisV8R19.MemoizedProgramLaw.View AspisV8R19.DuplexFrames.Bytes
    AspisV8R19.SourceDuplexStep.State (Option AspisR1.F3T_Experiment.RunView) →
  ℚ :=
fun v =>
  match v.2 with
  | Option.none => 0
  | Option.some run => AspisR1.RawRecordedOracleExtractionMassBin.failureMass (AspisR1.F3T_Experiment.view run)
