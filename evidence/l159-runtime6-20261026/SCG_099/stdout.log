def AspisR1.DrvC_PairProgram.source : {F C : Type} →
  AspisR1.DrvC_Installation.Configuration F C →
    (AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest) →
      AspisR1.Port1_Driver.Semantic →
        Aeneas.Std.Slice Aeneas.Std.U8 →
          Aeneas.Std.Slice Aeneas.Std.U8 →
            AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State
              Bool :=
fun {F C} c hashv semantic pub proof =>
  AspisV8R19.OracleProgramOps.bind
    (AspisR1.GExp_Experiment.first (AspisR1.GExp_FirstPair.base c.currentBase c.reserved c.query c.geometry)
      c.boundaries c.std hashv (AspisR1.DrvC_Installation.currentDigest c)
      { semantic := AspisS6CurrentVerifierCarrier.toPublic semantic, pub := pub, proof := proof, split := 10#usize })
    fun first =>
    match first with
    | Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok saved) =>
      AspisV8R19.OracleProgramOps.bind
        (AspisR1.GExp_Experiment.second (AspisR1.DrvC_Installation.stage c) c.reserved hashv
          (AspisR1.DrvC_Installation.digest c) { pub := pub, proof := proof, checkpoint := saved.deref })
        fun second => AspisV8R19.MemoizedProgramLaw.Program.done (AspisR1.Port1_Driver.verdict second)
    | x => AspisV8R19.MemoizedProgramLaw.Program.done Bool.false
def AspisR1.F3T_Installed.source : {F C : Type} →
  AspisR1.DrvC_Installation.Configuration F C →
    (AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest) → AspisR1.F3T_TwoPass.Verifier :=
fun {F C} c hashv i =>
  match AspisR1.Port1_Driver.asSlice i.physical.bytes, AspisR1.Port1_Driver.asSlice i.stored with
  | Option.some pub, Option.some proof =>
    match AspisR1.Port1_Driver.decodeSemantic (AspisR1.DrvC_Installation.sdk c) pub with
    | Aeneas.Std.Result.ok (Option.some semantic) => AspisR1.DrvC_PairProgram.source c hashv semantic pub proof
    | x => AspisV8R19.MemoizedProgramLaw.Program.done Bool.false
  | x, x_1 => AspisV8R19.MemoizedProgramLaw.Program.done Bool.false
