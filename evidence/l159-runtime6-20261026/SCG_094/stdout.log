@AspisR1.SCE_NativeAccepted.accepted : ∀ {A F C : Type} (c : AspisR1.DrvC_Installation.Configuration F C)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (id : AspisR1.S2W_ExtractionBoundary.Program)
  (native1 : AspisR1.S2W_ExtractionBoundary.First) (native2 : AspisR1.S2W_ExtractionBoundary.Second),
  AspisR1.S2W_DigestExtraction.AeneasExtraction
      (AspisR1.GExq_Caller.sdk c.adapter c.currentBase c.stageBase c.finish c.reserved c.query c.geometry c.boundaries
        c.std)
      native1 native2 hashv →
    ∀ (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      AspisR1.S2W_ExtractionBoundary.P1 sha256 H →
        AspisR1.S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
          ∀
            (copy :
              AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
                ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
            (a : AspisR1.SCE_Experiment.Adversary A) (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
            (post post2 : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record)) (final final2 : A),
            (have i := (AspisV8R19.MemoizedProgramLaw.eval H a.first).2;
              AspisR1.S2W_D189Wrappers.first native1 copy allocator i.entry id i.data i.state =
                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post, final))) →
              (have i :=
                  (AspisV8R19.MemoizedProgramLaw.eval H
                      (a.second (AspisV8R19.MemoizedProgramLaw.eval H a.first).2 saved post final)).2;
                AspisR1.S2W_D189Wrappers.second native2 allocator i.entry id i.data i.slot i.state =
                  Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (post2, final2))) →
                AspisR1.SCE_Experiment.accepted
                    (AspisV8R19.MemoizedProgramLaw.eval H
                        (AspisR1.SCE_Experiment.account c hashv copy allocator id a)).2 =
                  Bool.true
