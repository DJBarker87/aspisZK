AspisR1.SCG_PartialOracle.not_reverse : ∀ (parts : AspisR1.SdkC_Source.Parts)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.SdkC_Oracle.program (AspisR1.SCG_PartialOracle.code parts))).2 =
      Aeneas.Std.Result.ok Bool.true ∧
    (AspisR1.SdkC_Source.run AspisR1.SCG_PartialOracle.failingOracle (AspisR1.SCG_PartialOracle.code parts) []).1 =
        Aeneas.Std.Result.fail Aeneas.Std.Error.assertionFailure ∧
      AspisR1.S2W_ExtractionBoundary.RuntimeSyscall AspisR1.SCG_PartialOracle.failingOracle H
