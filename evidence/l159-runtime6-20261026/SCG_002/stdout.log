  (Q : ℕ)
  (queries :
    ∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      (AspisV8R19.MemoizedProgramLaw.eval H prior).1.length ≤ Q)
  (select : AspisR1.F3X_Projection.Output → AspisR1.R9PoolRuntimeBinding.Inputs × AspisR1.R9PoolRuntimeBinding.Inputs) :
  have c := AspisR1.F3V_Install.configuration base;
  AspisR1.WAdm_Domain.SessionAPrepare
      (AspisR1.Tx1Q_Execution.actual (AspisR1.Op5T_Concrete.current c.currentBase) c.reserved c.query c.geometry
        c.boundaries c.std) →
    AspisR1.Port5Q1_QueryPorts.SessionAPrimitives c.query →
      AspisR1.Port5Q1_GeometryCanonical.SessionAPrimitives c.geometry →
        AspisR1.Port5Q1_Domain.SessionADomain c.geometry →
          c.geometry.op9 = AspisR1Qm31ArithmeticProbe.field.M31.mul →
            c.geometry.op7 = Aeneas.Std.Result.ok 1#u32 →
              c.geometry.op11 = AspisR1.Port4C_InverseExecution.inverse_owned →
                AspisR1.F3X_PreparedAt.Owners c base.boundaries →
                  ∀ (s : AspisR1.F3T_ByteCarrier.Submission)
                    (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
                    (AspisV8R19.MemoizedProgramLaw.eval H
                            (AspisR1.F3T_Installed.source c hashv (AspisR1.F3T_ByteCarrier.input c s))).2 =
                        true →
                      AspisV8R19.MemoizedProgramLaw.eval H
                            (AspisR1.F3T_Installed.source c hashv (AspisR1.F3T_ByteCarrier.input c s)) =
                          AspisV8R19.MemoizedProgramLaw.eval H
                            (AspisR1.F3_Model.verifier D (AspisR1.F3T_ByteCarrier.input c s)) ∨
                        AspisR1.BinRawByteCollisionTargets.event AspisR1.SelectedTranscriptParams.params.iv (Q + 2965)
                          (AspisV8R19.MemoizedProgramLaw.eval H
                            (AspisR1.Hiq_RecordedJoint.program (AspisR1.F3X_AccountPrior.program c hashv prior s)
                              AspisR1.F3X_Projection.project select))
