def AspisR1.Hiq_ByteSelection.select : {A : Type} →
  AdapterRw.Ops →
    AspisR1.S2W_ExtractionBoundary.Program →
      AspisR1.GExq_AccountExperiment.Outcome A →
        AspisR1.R9PoolRuntimeBinding.Inputs × AspisR1.R9PoolRuntimeBinding.Inputs :=
fun {A} ops id out =>
  ({ proof := List.drop 688 (AspisR1.Hiq_ByteSelection.account ops out.1.entry.first 0#usize),
      pub := AspisR1.Hiq_ByteSelection.account ops out.1.entry.first 1#usize },
    match out.2.2 with
    | Option.none => { proof := [], pub := [] }
    | Option.some (next, snd) =>
      {
        proof :=
          List.drop 688
            (AspisR1.Hiq_ByteSelection.account ops (next.entry.second AspisR1.S2W_D189Wrappers.secondSizes) 0#usize),
        pub :=
          AspisR1.Hiq_ByteSelection.public2 ops id (next.entry.second AspisR1.S2W_D189Wrappers.secondSizes) next.data
            next.slot })
@AspisR1.SCG_Selection.actual : ∀ {A F C : Type} (c : AspisR1.DrvC_Installation.Configuration F C)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record))
  (allocator : AspisR1.S2W_D189Wrappers.Allocator A) (id : AspisR1.S2W_ExtractionBoundary.Program) (ops : AdapterRw.Ops)
  (a : AspisR1.SCE_Experiment.Adversary A) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8) (post : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record))
  (final : A),
  (AspisV8R19.MemoizedProgramLaw.eval H
          (AspisR1.SCE_Execution.firstCode c hashv copy allocator id
            (AspisV8R19.MemoizedProgramLaw.eval H a.first).2)).2 =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post, final)) →
    AspisR1.Hiq_ByteSelection.select ops id
        (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.SCE_Experiment.account c hashv copy allocator id a)).2 =
      have i := (AspisV8R19.MemoizedProgramLaw.eval H a.first).2;
      have next := (AspisV8R19.MemoizedProgramLaw.eval H (a.second i saved post final)).2;
      AspisR1.P2P_NativeSelection.pair ops id i.entry next.entry next.data next.slot
@AspisR1.SCG_Recorder.select_congr : ∀ {A : Type}
  (source : AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State A)
  (project : A → AspisR1.OraclePortCompactDraft.Parsed × (Fin 22 → Fin 262144))
  (left right : A → AspisR1.R9PoolRuntimeBinding.Inputs × AspisR1.R9PoolRuntimeBinding.Inputs)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  left (AspisV8R19.MemoizedProgramLaw.eval H source).2 = right (AspisV8R19.MemoizedProgramLaw.eval H source).2 →
    AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.Hiq_RecordedJoint.program source project left) =
      AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.Hiq_RecordedJoint.program source project right)
