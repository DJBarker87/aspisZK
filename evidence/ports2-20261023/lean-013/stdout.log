theorem AspisR1.CheckpointBytes5Join.success_conditioned_checkpoint_stage_join : ∀ {Hash : Type}
  (D : aspis_core.digest.Digest32 Hash) (hash : Hash)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) (reserved : Bool)
  (wp : CheckpointBytes5Writer.Prepared) (wa : CheckpointBytes5Writer.Accumulator) (proof public1 : Slice U8)
  (stored : AspisV8R19.DuplexFrames.Bytes) (parsed : OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144)
  (tr : RawCutTranscriptRun.ErasedPrefix) (i : RecordedBinaryExperimentBin.SourceInputs) (v : LiteralOpeningView.View),
  OraclePortStoredDecisionDraftC4.input parsed q tr = some i →
    OraclePortSelectedDraft.queries tr = some q →
      CheckpointBytes5Join.S2S10CallerBinding D hash H proof public1 stored tr.statement.pubBytes →
        CheckpointBytes5Join.S1S7S8StateProvenance wp wa
            (OraclePortCheckpointResumeC5.prepared (OraclePortAcceptedContextC6.context parsed i v) i.data
              (SelectedChallengeMap.rhoOf i.rho) q)
            (OraclePortCheckpointStateC3.write
                (OraclePortCheckpointResumeC5.model i.data (SelectedChallengeMap.rhoOf i.rho) q)).accumulator →
          ∀ (p : verifier.Prepared) (a : verifier.Accumulator) (after : CheckpointBytes5Effect.Log),
            CheckpointBytes5Effect.run D hash (CheckpointBytes5Join.stage reserved wp wa proof public1) [] =
                ok (core.result.Result.Ok (p, a), after) →
              (CheckpointBytes5Inputs.observe after, some (CheckpointBytes5Join.resumedSource i.data p a)) =
                AspisV8R19.MemoizedProgramLaw.eval H (OraclePortFrozen2.checkpoint stored parsed q tr i v) :=
fun {Hash} D hash H reserved wp wa proof public1 stored parsed q tr i v input query caller provenance p a after
    success =>
  have fields := (OraclePortStoredDecisionDraftC4.input_fields parsed q tr i input).left;
  have decoded :=
    Eq.mp
      (congrFun'
        (congrArg Eq
          (congrFun' (congrArg Bind.bind fields.right.left) fun __x =>
            match __x.2.1 with
            | TranscriptView.Value.queries (Except.ok bs) => LiteralQueryRead.decode bs
            | x => none))
        (some q))
      query;
  have unique := (LiteralQueryRead.decode_success i.queryBytes q decoded).right;
  Eq.trans
    (CheckpointBytes5Join.successful_stage D hash H reserved wp wa proof public1 stored tr.statement.pubBytes
      (OraclePortAcceptedContextC6.context parsed i v) i.data (SelectedChallengeMap.rhoOf i.rho) q caller provenance
      unique p a after success)
    (OraclePortCkptAbi5Stage.reached_stage H stored parsed q tr i v input query)
