def R0Z.FsGood.badMass : {K CommitHandle Aux : Type} →
  [inst : Field K] →
    {Bat Adv : Type} →
      (Challenges K → Prop) → ROMBridge K CommitHandle Aux Bat Adv → Adv → Statement K CommitHandle → ℚ :=
fun {K CommitHandle Aux} [Field K] {Bat Adv} P bridge adv x =>
  mean fun coin => if P (bridge.draw adv x coin) then 0 else 1
