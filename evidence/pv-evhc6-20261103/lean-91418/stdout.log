def R0Z.Shift.MaskImageOn : {K CommitHandle : Type} →
  [inst : Field K] →
    [Fintype K] →
      [DecidableEq K] →
        [Algebra (ZMod AspisCircleGroupOrder.P) K] →
          {F : Subfield K} →
            {Bat : Type} →
              [BatchedLayer K Bat] →
                (Challenges K → Prop) → HonestProver K → PackBasis F → Statement K CommitHandle → Prop :=
fun {K CommitHandle} [Field K] [Fintype K] [DecidableEq K] [Algebra (ZMod AspisCircleGroupOrder.P) K] {F} {Bat}
    [BatchedLayer K Bat] P h B x =>
  (∀ (ch : Challenges K),
      P ch →
        ∀ (w : h.Instance) (n : N K F), h.public w = x.1 → sRem h B x w ch n ∈ (A h.transport B ch ∘ₗ inlM).range) ∧
    ∀ (ch : Challenges K),
      P ch →
        ∀ (w w' : h.Instance),
          h.public w = x.1 → h.public w' = x.1 → cTilde h B x w ch - cTilde h B x w' ch ∈ (A h.transport B ch).range
def R0Z.Shift.HVZK_on : {K CommitHandle Aux : Type} →
  [inst : Field K] →
    [Fintype K] →
      [Algebra (ZMod AspisCircleGroupOrder.P) K] →
        {F : Subfield K} →
          {Bat : Type} →
            [BatchedLayer K Bat] →
              (Challenges K → Prop) →
                HonestProver K →
                  PackBasis F → (Statement K CommitHandle → Challenges K → Aux) → Statement K CommitHandle → Prop :=
fun {K CommitHandle Aux} [Field K] [Fintype K] [Algebra (ZMod AspisCircleGroupOrder.P) K] {F} {Bat} [BatchedLayer K Bat]
    P h B outputs x =>
  ∀ (hx : JointView.InLanguage h x) (w : h.Instance) (ch : Challenges K),
    P ch → h.public w = x.1 → EqualLaws (JointView.view h B outputs x w ch) (JointView.simulator h B outputs x hx ch)
