theorem AspisR1.NKA_OuterCut.queries_from_pairs : ∀ (word : NJT_QScan.Native),
  NJT_QScan.Cut word →
    ∀ (outer : Native),
      Cut outer →
        ∀ (blocks advances : Blocks),
          AspisR1Query31Transcript.queries_from_pairs_with_scan NGQ_SamplerPacket.Scan NGQ_SamplerPacket.initial blocks
              advances =
            walk word outer advances (↑advances)[7] (NKA_QueryPairs.inputs blocks) NGQ_SamplerPacket.initial :=
fun word wordCut outer outerCut blocks advances =>
