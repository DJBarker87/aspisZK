+extern crate alloc;
+use alloc::boxed::Box;
+use crate::field::{QM31 as Q,CM31 as C,M31 as M};
+include!(concat!(env!("CARGO_MANIFEST_DIR"),"/../../KMX_stubs.rs"));
+fn q(x:[u32;4])->Q{Q{c0:C{a:M(x[0]),b:M(x[1])},c1:C{a:M(x[2]),b:M(x[3])}}}
+fn words(x:Q)->[u32;4]{[x.c0.a.0,x.c0.b.0,x.c1.a.0,x.c1.b.0]}
+fn exercise(frame:bool){
+ let p:usize=56+usize::from(kani::any::<u8>()&7);
+ let limb:usize=kani::any();kani::assume(limb<4);
+ let layout=alloc::alloc::Layout::array::<Q>(64).unwrap();
+ let ptr=unsafe{alloc::alloc::alloc_zeroed(layout)} as *mut Q;
+ kani::assume(!ptr.is_null());
+ unsafe{ptr.add(p).write(q(kani::any()));}
+ let mut out=unsafe{Vec::from_raw_parts(ptr,p,64)};
+ out.resize(p+1,Q::ZERO);
+ if cfg!(NIG_corrupt){out[p]=q([1;4]);}
+ let k:usize=kani::any();kani::assume(k<=p);
+ assert!(words(out[k])[limb]==0);assert!(out.as_ptr()==ptr&&out.len()==p+1&&out.capacity()==64);
+ let _=frame;
+}
+macro_rules! gate{($name:ident,$f:expr)=>{#[kani::proof]#[kani::unwind(6)]
+#[kani::stub(core::ptr::copy_nonoverlapping,KMX_copy_nonoverlapping)]
+#[kani::stub(<[u8]>::copy_from_slice,KMX_copy_from_slice)]
+fn $name(){exercise($f)}};}
+gate!(prefix_frame,true);gate!(new_cell,false);
