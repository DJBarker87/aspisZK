+struct Common{lhs:K,rhs:K,reply:K,calls:usize}
+fn qm(a:K,b:K,l:&mut Common)->K{l.lhs=a;l.rhs=b;l.calls+=1;l.reply}
+fn common_cut(row2:&[K;4],row3:&[K;4],j:usize,cells:&mut [K;16],l:&mut Common){
+ cells[j]=qm(row2[j&3],row3[j>>2u32],l);
+}
+fn common_check(g:usize){
+ let row2=core::array::from_fn(|_|anyq());let row3=core::array::from_fn(|_|anyq());
+ let before=core::array::from_fn(|_|anyq());let mut cells=before;
+ let j:usize=kani::any();kani::assume(j<16);let k:usize=kani::any();kani::assume(k<16);
+ let limb:usize=kani::any();kani::assume(limb<4);
+ let mut l=Common{lhs:K::ZERO,rhs:K::ZERO,reply:anyq(),calls:0};
+ common_cut(&row2,&row3,j,&mut cells,&mut l);
+ if cfg!(NIG_corrupt){match g{0=>l.lhs=q([qw(row2[j&3])[0]^1;4]),1=>l.rhs=q([qw(row3[j>>2])[0]^1;4]),2=>l.calls+=1,_=>cells[k]=q([qw(if k==j{l.reply}else{before[k]})[0]^1;4])}}
