@@ -511,8 +521,20 @@ let update_loops (crate : crate) (f : fun_decl) : fun_decl =
 
                Note that doing this will raise an exception if we find a loop with
                an early return. *)
-            try ([ { st with kind = self#visit_Loop (depth + 1) loop } ], after)
+            (* PCWO patch A: the continuation of the loop (its own block
+               remainder followed by the continuation of the enclosing blocks) *)
+            let saved_outer = outer_after in
+            (* inside the loop body, the continuation of the enclosing blocks is
+               not reachable by falling out of the body *)
