    liftFun2, liftFun1, core.cmp.impls.PartialOrdUsize.lt, core.clone.impls.CloneUsize.clone] at h
  by_cases hlt : r.start.val < r.«end».val
  · rw [if_pos hlt] at h
    cases hf : core.iter.range.UScalarStep.forward_checked r.start 1#usize with
    | fail e => simp [hf] at h
    | div => simp [hf] at h
    | ok n =>
      cases n with
      | none => simp [hf] at h
      | some n =>
        simp [hf] at h
