/-- PCQH helper: successful `Range<usize>::next` returning `some d` has `d < end`. -/
theorem PRVEq.C13_F20.RPz7_FIo_NativeFuns_h2.range_next_usize_lt (r r1 : core.ops.range.Range Std.Usize) (d : Std.Usize)
