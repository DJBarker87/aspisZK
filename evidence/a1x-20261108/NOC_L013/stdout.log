    ∃ bytes proof split statement,
      AspisR1PublicPreparation.S6DecoderScopedReuseV1.decodeActual bytes =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok statement) ∧
        split = AspisR1CurrentCaller.compact.SPLIT ∧
