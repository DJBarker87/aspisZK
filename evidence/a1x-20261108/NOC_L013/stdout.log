THM AspisR1.Port3_NativeQueryBody.verifier.candidate.query_values.eq_1 : ∀ (ops : AspisR1.Port3_NativeQueryBody.Ops)
  (proof : Aeneas.Std.Slice Aeneas.Std.U8) (p : AspisR1Stage2.verifier.Prepared)
  (a : AspisR1Stage2.verifier.Accumulator)
  (g : Aeneas.Std.Array AspisR1Stage2.aspis_core.field.wide_exact.WideExact 29#usize)
  (obs : Option (AspisR1Stage2.verifier.Phase → Aeneas.Std.Result Unit))
  (geometry : AspisR1Stage2.verifier.QueryGeometry) (pending : AspisR1Stage2.verifier.BatchedWeights),
  AspisR1.Port3_NativeQueryBody.verifier.candidate.query_values ops proof p a g obs geometry pending = do
    let i ← p.queries.index_usize a.next
    let u ← Aeneas.Std.lift (Aeneas.Std.UScalar.cast Aeneas.Std.UScalarTy.Usize i)
    let q ← ops.op11 proof a.next
    let dots ← ops.op20 q g
    let i1 ← Aeneas.Std.lift (Aeneas.Std.Usize.wrapping_mul 4#usize a.next)
    let we ← dots.index_usize 0#usize
    ops.op15 9#u16 i1 we
    let i2 ← Aeneas.Std.lift (Aeneas.Std.Usize.wrapping_mul 4#usize a.next)
    let i3 ← Aeneas.Std.lift (i2.wrapping_add 1#usize)
    let we1 ← dots.index_usize 1#usize
    ops.op15 9#u16 i3 we1
    let i4 ← Aeneas.Std.lift (Aeneas.Std.Usize.wrapping_mul 4#usize a.next)
    let i5 ← Aeneas.Std.lift (i4.wrapping_add 2#usize)
    let we2 ← dots.index_usize 2#usize
    ops.op15 9#u16 i5 we2
    let i6 ← Aeneas.Std.lift (Aeneas.Std.Usize.wrapping_mul 4#usize a.next)
    let i7 ← Aeneas.Std.lift (i6.wrapping_add 3#usize)
    let we3 ← dots.index_usize 3#usize
    ops.op15 9#u16 i7 we3
    let inverse ← ops.op18 geometry a.next
    let we4 ← p.alpha.index_usize 0#usize
    let folded ← ops.op17 we4 dots inverse
    let i8 ← Aeneas.Std.lift (Aeneas.Std.Usize.wrapping_mul 2#usize a.next)
    ops.op15 10#u16 i8 folded
    let values ←
      ops.op0 4#usize
          (AspisR1.Port3_NativeQueryBody.verifier.candidate.query_values.closure.Insts.CoreOpsFunctionFnMutTupleUsizeWideExact
            ops)
          q
    let i9 ← u % 4#usize
    let we5 ← values.index_usize i9
    let b ← Aeneas.Std.core.cmp.PartialEq.ne.trait_default ops.widePartialEq folded we5
    if b = true then Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err AspisR1Stage2.verifier.Error.Query)
      else do
        let we6 ← p.alpha.index_usize 1#usize
        let folded1 ← ops.op16 we6 values inverse
        let i10 ← Aeneas.Std.lift (Aeneas.Std.Usize.wrapping_mul 2#usize a.next)
        let i11 ← Aeneas.Std.lift (i10.wrapping_add 1#usize)
        ops.op15 10#u16 i11 folded1
        let i12 ← Aeneas.Std.lift (a.next.wrapping_sub geometry.start)
        let z ←
          Aeneas.Std.alloc.vec.Vec.index
              (Aeneas.Std.core.slice.index.SliceIndexUsizeSlice AspisR1Stage2.aspis_core.field.M31) geometry.line_z i12
        let m ← ops.op7 z z
        let m1 ← ops.op8 m
        let m2 ← ops.op5
        let node ← ops.op6 m1 m2
        let (a1, pending1) ←
          AspisR1.Port3_NativeQueryBody.verifier.accumulate_batched_with_node ops p a node folded1 pending
        ops.op19 obs (AspisR1Stage2.verifier.Phase.Query a.next)
        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (a1, pending1))
THM AspisR1.Tx2N_Twelve.accepted : ∀ {CoreError W Hash : Type} (base : VTop_Stages.Ops)
  (finish : AspisR1Stage2.Stage2Finish.FinishOps W) (reserved : Bool) (queryOps : AspisR1.Port3_NativeQueryBody.Ops),
  AspisR1.Port5Q1_QueryPorts.SessionAPrimitives queryOps →
    ∀ (geoOps : AspisR1.Port3_NativeGeometryBody.Ops CoreError),
      AspisR1.Port5Q1_GeometryCanonical.SessionAPrimitives geoOps →
        AspisR1.Port5Q1_Domain.SessionADomain geoOps →
          geoOps.op9 = AspisR1Qm31ArithmeticProbe.field.M31.mul →
            geoOps.op7 = Aeneas.Std.Result.ok 1#u32 →
              geoOps.op11 = AspisR1.Port4C_InverseExecution.inverse_owned →
                ∀ (D : VTop_Stages.aspis_core.digest.Digest32 Hash) (hash : Hash)
                  (pub proof checkpoint : Aeneas.Std.Slice Aeneas.Std.U8)
                  (savedVec : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
                  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
                  (stored publicBytes : AspisV8R19.DuplexFrames.Bytes),
                  AspisR1.MultiproofConeCanonical.bytesOf ↑checkpoint =
                      AspisR1.MultiproofConeCanonical.bytesOf ↑savedVec →
                    VTop_Stages.verifier.candidate.tx2_authenticated
                          (AspisR1.Tx2I_Install.stage (AspisR1.Tx2N_Execution.control base reserved queryOps geoOps)
                            finish)
                          D pub proof checkpoint hash none =
                        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) →
                      ∃ p saved g geometry pending returned after flushed back v,
                        AspisR1.Port4A_ReaderInstall.reader reserved D checkpoint proof pub
                              AspisR1Stage2.transport.Variant.S2 hash =
                            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (p, saved)) ∧
                          AspisR1.Port3_QueryStage.query
                                (AspisR1.Port4C_RowStd.install (AspisR1.Port5Q1_QueryPorts.install queryOps)) proof p
                                saved g none geometry pending 22#usize =
                              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (returned, after)) ∧
                            returned.weights.deref_mut = (returned.weights.deref, back) ∧
                              AspisR1.Port3_FlushInstall.flush after returned.weights.deref =
                                  Aeneas.Std.Result.ok flushed ∧
                                AspisR1.Port4D_FinishInstall.finish finish v p
                                      { weights := back flushed, rhs := returned.rhs, power := returned.power,
                                        next := returned.next }
                                      none =
                                    Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) ∧
                                  ∀ (semantic : List AspisV8R19.DuplexFrames.Bytes) (q : Fin 22 → Fin 262144)
                                    (tr : AspisR1.RawCutTranscriptRun.ErasedPrefix)
                                    (data : AspisR1.MatchingSupport.Data AspisR1.OraclePortCheckpointAbiC5.E)
                                    (rho : AspisR1.OraclePortCheckpointAbiC5.K)
                                    (c : AspisR1.OraclePortCheckpointResumeC5.Context),
                                    AspisR1.LiteralMatchingData.read
                                          (AspisR1.OraclePortStoredDecisionDraftC4.typedRows
                                            { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof,
                                              semantic := semantic }
                                            q tr) =
                                        some data →
                                      ∀ (recovered : ℕ → Option AspisV8R19.DuplexFrames.Bytes),
                                        (∀ pos < 22,
                                            recovered (AspisR1.OraclePortSelectedDraft.index q 2 pos) =
                                              some
                                                (AspisR1.OraclePortPackedChoiceC4.payload
                                                  { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof,
                                                    semantic := semantic }
                                                  2 pos)) →
                                          savedVec =
                                              AspisR1.Tx2N_Reader.writer H stored publicBytes
                                                (AspisR1.OraclePortCheckpointResumeC5.prepared c data rho q)
                                                (AspisR1.OraclePortCheckpointStateC3.write
                                                    (AspisR1.OraclePortCheckpointResumeC5.model data rho
                                                      q)).accumulator →
                                            AspisR1.CheckpointBytes5Output.accumulator saved =
                                                (AspisR1.OraclePortCheckpointStateC3.write
                                                    (AspisR1.OraclePortCheckpointResumeC5.model data rho
                                                      q)).accumulator ∧
                                              AspisR1.CheckpointBytes5Output.accumulator
                                                  { weights := back flushed, rhs := returned.rhs,
                                                    power := returned.power, next := returned.next } =
                                                AspisR1.OraclePortCheckpointStateC3.advance
                                                  (AspisR1.OraclePortCheckpointResumeC5.model data rho q) 12
                                                  (AspisR1.CheckpointBytes5Output.accumulator saved)
THM AspisS2OwnedStage1.SdkReference.owned_acquire_checkpoint.eq_1 : ∀ (sdk : AspisS2OwnedStage1.SdkReference.OwnedSdk)
  (guards : AspisS2OwnedStage1.SdkReference.LiveGuards) (slot : Aeneas.Std.Usize),
  AspisS2OwnedStage1.SdkReference.owned_acquire_checkpoint sdk guards slot = do
    let odc ←
      Aeneas.Std.alloc.vec.Vec.index
          (Aeneas.Std.core.slice.index.SliceIndexUsizeSlice AspisS2OwnedStage1.SdkReference.OwnedDataCell)
          sdk.data_cells slot
    if (odc.borrowed != 0#isize) = true then
        Aeneas.Std.Result.ok
          (Aeneas.Std.core.result.Result.Err AspisS2OwnedStage1.solana_program_error.ProgramError.AccountBorrowFailed,
            sdk, guards)
      else do
        let (odc1, index_mut_back) ←
          Aeneas.Std.alloc.vec.Vec.index_mut
              (Aeneas.Std.core.slice.index.SliceIndexUsizeSlice AspisS2OwnedStage1.SdkReference.OwnedDataCell)
              sdk.data_cells slot
        have v : Aeneas.Std.alloc.vec.Vec AspisS2OwnedStage1.SdkReference.OwnedDataCell :=
          index_mut_back { bytes := odc1.bytes, borrowed := (-1)#isize, strong := odc1.strong, weak := odc1.weak }
        Aeneas.Std.Result.ok
            (Aeneas.Std.core.result.Result.Ok (),
              { accounts := sdk.accounts, data_cells := v, lamports_cells := sdk.lamports_cells },
              { checkpoint := some slot, «public» := guards.public, proof := guards.proof })
