                        ↑m0 = ↑x0 % AspisV8R17.RawReducer.P ∧
                          ↑m0 < AspisV8R17.RawReducer.P ∧
                            ↑m1 = ↑x1 % AspisV8R17.RawReducer.P ∧
                              ↑m1 < AspisV8R17.RawReducer.P ∧
                                ↑m2 = ↑x2 % AspisV8R17.RawReducer.P ∧
                                  ↑m2 < AspisV8R17.RawReducer.P ∧
                                    ↑m3 = ↑x3 % AspisV8R17.RawReducer.P ∧ ↑m3 < AspisV8R17.RawReducer.P
