                                      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (post2, final2)) →
                                    ∀ (p : FS2.Duplex.Params M Cv N) (root : Aeneas.Std.Array Aeneas.Std.U8 32#usize)
