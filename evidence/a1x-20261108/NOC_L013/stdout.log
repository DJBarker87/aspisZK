THM FIo_Native.weights.Weights.dense_point_pair_loop0_loop0.body.eq_1 : ∀ (width : Aeneas.Std.Usize)
  (p : FIo_Native.aspis_core.field.QM31)
  (iter : Aeneas.Std.core.iter.adapters.rev.Rev (Aeneas.Std.core.ops.range.Range Aeneas.Std.Usize))
  (rows : Aeneas.Std.alloc.vec.Vec FIo_Native.aspis_core.field.QM31),
  FIo_Native.weights.Weights.dense_point_pair_loop0_loop0.body width p iter rows = do
    let (o, iter1) ←
      Aeneas.Std.core.iter.adapters.rev.Rev.Insts.CoreIterTraitsIteratorIterator.next
          (Aeneas.Std.core.ops.range.Range.Insts.DoubleEndedIterator Aeneas.Std.core.iter.range.StepUsize) iter
    match o with
      | none => Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.done rows)
      | some j => do
        let x ←
          Aeneas.Std.alloc.vec.Vec.index
              (Aeneas.Std.core.slice.index.SliceIndexUsizeSlice FIo_Native.aspis_core.field.QM31) rows j
        let q ← x.mul p
        let i ← Aeneas.Std.lift (Aeneas.Std.Usize.wrapping_add j width)
        let (_, index_mut_back) ←
          Aeneas.Std.alloc.vec.Vec.index_mut
              (Aeneas.Std.core.slice.index.SliceIndexUsizeSlice FIo_Native.aspis_core.field.QM31) rows i
        let q1 ← FIo_Native.aspis_core.field.QM31.ONE.sub p
        let q2 ← x.mul q1
        have rows1 : Aeneas.Std.alloc.vec.Vec FIo_Native.aspis_core.field.QM31 := index_mut_back q
        let (_, index_mut_back1) ←
          Aeneas.Std.alloc.vec.Vec.index_mut
              (Aeneas.Std.core.slice.index.SliceIndexUsizeSlice FIo_Native.aspis_core.field.QM31) rows1 j
        have rows2 : Aeneas.Std.alloc.vec.Vec FIo_Native.aspis_core.field.QM31 := index_mut_back1 q2
        Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.cont (iter1, rows2))
