THM AspisS2OwnedStage1.SdkReference.owned_checkpoint_nonzero_loop.body.eq_1 : ∀
  (bytes : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8) (i : Aeneas.Std.Usize),
  AspisS2OwnedStage1.SdkReference.owned_checkpoint_nonzero_loop.body bytes i =
    if i < bytes.len then do
      let i2 ← Aeneas.Std.alloc.vec.Vec.index (Aeneas.Std.core.slice.index.SliceIndexUsizeSlice Aeneas.Std.U8) bytes i
      if (i2 != 0#u8) = true then Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.done (some true))
        else do
          let i3 ← i + 1#usize
          Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.cont i3)
    else Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.done none)
