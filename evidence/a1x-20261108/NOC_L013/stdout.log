THM S7Kani2AccumulatorLoop.accumulate_rows_owned.eq_def : ∀ (backend : S7Kani2AccumulatorLoop.Backend)
  (output_weights : Aeneas.Std.alloc.vec.Vec S7Kani2AccumulatorLoop.K) (weights : S7Kani2AccumulatorLoop.BatchedWeights)
  (basis : Aeneas.Std.Array Aeneas.Std.U32 256#usize) (power : S7Kani2AccumulatorLoop.K)
  (next width j : Aeneas.Std.Usize),
  S7Kani2AccumulatorLoop.accumulate_rows_owned backend output_weights weights basis power next width j =
    if j ≥ width then Aeneas.Std.Result.ok (output_weights, weights)
    else do
      let m ← basis.index_usize j
      let weights1 ← backend.push weights j power m
      let i ← next * width
      let i1 ← i + j
      let q ←
        Aeneas.Std.alloc.vec.Vec.index (Aeneas.Std.core.slice.index.SliceIndexUsizeSlice S7Kani2AccumulatorLoop.K)
            output_weights j
      let we ← backend.from_qm31 q
      backend.trace 12#u16 i1 we
      let i2 ← i + j
      let we1 ← backend.from_m31 m
      backend.trace 13#u16 i2 we1
      let i3 ← j + 1#usize
      S7Kani2AccumulatorLoop.accumulate_rows_owned backend output_weights weights1 basis power next width i3
