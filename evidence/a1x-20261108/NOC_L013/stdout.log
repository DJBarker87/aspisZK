                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok prepared, scratch) ∧
              prepared.roots = Aeneas.Std.Array.make 2#usize [root0, root1] ⋯ ∧
                ↑root0 = List.slice 16 48 ↑proof ∧
                  ↑root1 = List.slice 63 95 ↑proof ∧
                    AspisR1CurrentCaller.Tx1Reachability.afterPrepare
                          (AspisR1CurrentCaller.BorrowedClaimPrepared.NativeBuffers.install
                            (AspisS1ValuesOwnedInstallation.withValues ops) AspisS1ValuesOwnedInstallation.nativeValues
                            R B)
                          (AspisR1CurrentCaller.BorrowedClaimPrepared.NativeBuffers.callerDigest adapterOps
                            (AspisS1ValuesOwnedInstallation.withValues ops) AspisS1ValuesOwnedInstallation.nativeValues
                            R B)
                          bytes proof split () none prepared scratch =
                        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok out) ∧
                      ∃ stored initial semantic view sem,
                        Aeneas.Std.core.slice.index.Slice.index
                              (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8) proof
                              { start := 7031#usize, «end» := 7495#usize } =
                            Aeneas.Std.Result.ok stored ∧
                          AspisS1ValuesOwnedInstallation.expandValues stored initial =
                              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (), view.y1) ∧
                            stored.length = 464 ∧
                              initial.length = 928 ∧
                                view.y1.length = 928 ∧
                                  (∀ j < 928,
                                      (↑view.y1)[j]? =
                                        if j % 32 < 16 then (↑stored)[j / 32 * 16 + j % 32]? else some 0#u8) ∧
                                    AspisR1CurrentCaller.InstalledPreparation.sourceView proof semantic view.y1 =
                                        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok view) ∧
                                      (AspisR1CurrentCaller.BorrowedClaimPrepared.NativeBuffers.install
                                                (AspisS1ValuesOwnedInstallation.withValues ops)
                                                AspisS1ValuesOwnedInstallation.nativeValues R B).op9
                                            (AspisR1CurrentCaller.BorrowedClaimPrepared.NativeBuffers.callerDigest
                                              adapterOps (AspisS1ValuesOwnedInstallation.withValues ops)
                                              AspisS1ValuesOwnedInstallation.nativeValues R B)
                                            (AspisR1CurrentCaller.FirstComposition.toCurrentPublic
                                              (AspisR1PublicPreparation.PreparationBinding.preparationPublic statement))
                                            view.semantic () none =
                                          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok sem) ∧
                                        (AspisR1CurrentCaller.BorrowedClaimPrepared.NativeBuffers.install
                                                  (AspisS1ValuesOwnedInstallation.withValues ops)
                                                  AspisS1ValuesOwnedInstallation.nativeValues R B).op8
                                              (AspisR1CurrentCaller.BorrowedClaimPrepared.NativeBuffers.callerDigest
                                                adapterOps (AspisS1ValuesOwnedInstallation.withValues ops)
                                                AspisS1ValuesOwnedInstallation.nativeValues R B)
                                              sem view () (Aeneas.Std.Array.repeat 29#usize zero) =
                                            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok prepared, scratch) ∧
                                          ∀ (l : Aeneas.Std.Usize),
                                            ↑l < 29 →
                                              ∃ parsed,
                                                AspisR1CurrentPreparedClaim.ClaimParser.field view.y1 l =
                                                    Aeneas.Std.Result.ok parsed ∧
                                                  AspisR1CurrentPreparedClaim.Concrete.Canonical parsed
