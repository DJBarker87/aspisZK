  (raw : AspisR1BatchedWeightsValueActualV19.RawVec) (terms index : Aeneas.Std.Usize)
  (lane : Aeneas.Std.Array Aeneas.Std.U64 4#usize),
  Aeneas.Std.alloc.vec.Vec.index
        (Aeneas.Std.core.slice.index.SliceIndexUsizeSlice (Aeneas.Std.Array Aeneas.Std.U64 4#usize)) raw index =
      Aeneas.Std.Result.ok lane →
    ∃ x0 x1 x2 x3 m0 m1 m2 m3,
      lane.index_usize 0#usize = Aeneas.Std.Result.ok x0 ∧
        lane.index_usize 1#usize = Aeneas.Std.Result.ok x1 ∧
          lane.index_usize 2#usize = Aeneas.Std.Result.ok x2 ∧
            lane.index_usize 3#usize = Aeneas.Std.Result.ok x3 ∧
              AspisR1BatchedWeightsExtraction.aspis_core.field.M31.reduce_u64 x0 = Aeneas.Std.Result.ok m0 ∧
