THM AspisR1.NFP_TraceBack.run.eq_1 : ∀ (base : AspisR1.Port3_NativeQueryBody.Ops) (p : AspisR1Stage2.verifier.Prepared)
  (a : AspisR1Stage2.verifier.Accumulator) (geometry : AspisR1Stage2.verifier.QueryGeometry)
  (pending : AspisR1Stage2.verifier.BatchedWeights) (inverse : AspisR1.NFP_TraceTypes.Inverse)
  (values : AspisR1.NFP_QueryCuts.Dots),
  AspisR1.NFP_TraceBack.run base p a geometry pending inverse values = do
    let we6 ← AspisR1.NFP_TraceTypes.eval (p.alpha.index_usize 1#usize)
    AspisR1.NFP_TraceTypes.mark (AspisR1.NFP_TraceTypes.Event.line we6 values inverse)
    let folded1 ← AspisR1.NFP_TraceTypes.eval ((AspisR1.NFP_ObserverErasure.erase base).op16 we6 values inverse)
    let i10 ← AspisR1.NFP_TraceTypes.eval (Aeneas.Std.lift (Aeneas.Std.Usize.wrapping_mul 2#usize a.next))
    let i11 ← AspisR1.NFP_TraceTypes.eval (Aeneas.Std.lift (i10.wrapping_add 1#usize))
    AspisR1.NFP_TraceTypes.mark (AspisR1.NFP_TraceTypes.Event.trace 10#u16 i11 folded1)
    AspisR1.NFP_TraceTypes.eval ((AspisR1.NFP_ObserverErasure.erase base).op15 10#u16 i11 folded1)
    let i12 ← AspisR1.NFP_TraceTypes.eval (Aeneas.Std.lift (a.next.wrapping_sub geometry.start))
    let z ←
      AspisR1.NFP_TraceTypes.eval
          (Aeneas.Std.alloc.vec.Vec.index (Aeneas.Std.core.slice.index.SliceIndexUsizeSlice Aeneas.Std.U32)
            geometry.line_z i12)
    AspisR1.NFP_TraceTypes.mark (AspisR1.NFP_TraceTypes.Event.product z z)
    let product ← AspisR1.NFP_TraceTypes.eval ((AspisR1.NFP_ObserverErasure.erase base).op7 z z)
    AspisR1.NFP_TraceTypes.mark (AspisR1.NFP_TraceTypes.Event.double product)
    let doubled ← AspisR1.NFP_TraceTypes.eval ((AspisR1.NFP_ObserverErasure.erase base).op8 product)
    AspisR1.NFP_TraceTypes.mark AspisR1.NFP_TraceTypes.Event.one
    let one ← AspisR1.NFP_TraceTypes.eval (AspisR1.NFP_ObserverErasure.erase base).op5
    AspisR1.NFP_TraceTypes.mark (AspisR1.NFP_TraceTypes.Event.subtract doubled one)
    let node ← AspisR1.NFP_TraceTypes.eval ((AspisR1.NFP_ObserverErasure.erase base).op6 doubled one)
    AspisR1.NFP_TraceTypes.mark (AspisR1.NFP_TraceTypes.Event.accumulate p a node folded1 pending)
    let __x ←
      AspisR1.NFP_TraceTypes.eval
          (AspisR1.Port3_NativeQueryBody.verifier.accumulate_batched_with_node (AspisR1.NFP_ObserverErasure.erase base)
            p a node folded1 pending)
    match __x with
      | (a1, b1) => do
        AspisR1.NFP_TraceTypes.eval
            ((AspisR1.NFP_ObserverErasure.erase base).op19 none (AspisR1Stage2.verifier.Phase.Query a.next))
        pure (Aeneas.Std.core.result.Result.Ok (a1, b1))
