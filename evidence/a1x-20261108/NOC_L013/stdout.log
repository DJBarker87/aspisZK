THM AspisR1.VTop_Flow.tx1.eq_1 : ∀ {M : Type → Type v} [inst : Monad M] [inst_1 : MonadLiftT Aeneas.Std.Result M]
  (effects : AspisR1.VTop_Flow.Effects M) {H : Type}
  (aspis_coredigestDigest32Inst : VTop_Stages.aspis_core.digest.Digest32 H)
  (public1 : VTop_Stages.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public)
  (public_bytes proof : Aeneas.Std.Slice Aeneas.Std.U8) (k : Aeneas.Std.Usize) (hash : H)
  (obs : Option (VTop_Stages.verifier.Phase → Aeneas.Std.Result Unit)),
  AspisR1.VTop_Flow.tx1 effects aspis_coredigestDigest32Inst public1 public_bytes proof k hash obs = do
    let i ← effects.op16
    if (k != i) = true then pure (Aeneas.Std.core.result.Result.Err AdapterRw.aspis_r1_cost_probe.verifier.Error.Parse)
      else do
        let r ← effects.op3 proof
        let cf ← liftM (Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r)
        match cf with
          | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue a => do
            let r1 ← effects.op4 proof
            let cf1 ← liftM (Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r1)
            match cf1 with
              | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue a => do
                effects.op13 obs AdapterRw.aspis_r1_cost_probe.verifier.Phase.Parsed
                let we ← effects.op1
                have g : Aeneas.Std.Array VTop_Stages.aspis_core.field.wide_exact.WideExact 29#usize :=
                  Aeneas.Std.Array.repeat 29#usize we
                let __x ← effects.op7 aspis_coredigestDigest32Inst public1 proof hash obs g
                match __x with
                  | (r2, g1) => do
                    let cf2 ← liftM (Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r2)
                    match cf2 with
                      | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue val => do
                        let r3 ← effects.op12 AspisR1Stage2.transport.Variant.S2
                        let cf3 ← liftM (Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r3)
                        match cf3 with
                          | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue val1 => do
                            effects.op13 obs AdapterRw.aspis_r1_cost_probe.verifier.Phase.Prepare
                            let i1 ← effects.op15
                            let i2 ← effects.op14
                            let s ←
                              liftM
                                  (Aeneas.Std.core.slice.index.Slice.index
                                    (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8) proof
                                    { start := i1, «end» := i2 })
                            let r4 ←
                              liftM
                                  (Aeneas.Std.core.array.TryFromArrayCopySlice.try_from 32#usize
                                    Aeneas.Std.core.marker.CopyU8 s)
                            let folded_root ← effects.unwrap32 r4
                            let r5 ← effects.op5 aspis_coredigestDigest32Inst proof val folded_root 0#usize hash
                            let cf4 ← liftM (Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r5)
                            match cf4 with
                              | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue a => do
                                effects.op13 obs (AdapterRw.aspis_r1_cost_probe.verifier.Phase.Merkle 0#usize)
                                let r6 ← effects.op11 val.queries 0#usize k
                                let cf5 ← liftM (Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r6)
                                match cf5 with
                                  | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue val2 =>
                                    have s1 := val1.weights.deref;
                                    do
                                    let r7 ← effects.op10 s1
                                    let cf6 ← liftM (Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r7)
                                    match cf6 with
                                      | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue val3 => do
                                        let r8 ← effects.op6 proof val val1 g1 obs val2 val3 k
                                        let cf7 ← liftM (Aeneas.Std.core.result.Result.Insts.CoreOpsTry.branch r8)
                                        match cf7 with
                                          | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue val4 =>
                                            match val4 with
                                            | (a, pending) => do
                                              let __x ← liftM (Aeneas.Std.lift a.weights.deref_mut)
                                              match __x with
                                                | (s2, deref_mut_back) => do
                                                  let s3 ← effects.op9 pending s2
                                                  have v :
                                                    Aeneas.Std.alloc.vec.Vec AspisR1Stage2.aspis_core.field.QM31 :=
                                                    deref_mut_back s3
                                                  let bytes ←
                                                    effects.op8 aspis_coredigestDigest32Inst val
                                                        { weights := v, rhs := a.rhs, power := a.power, next := a.next }
                                                        proof public_bytes hash
                                                  effects.op13 obs
                                                      AdapterRw.aspis_r1_cost_probe.verifier.Phase.CheckpointWrite
                                                  pure (Aeneas.Std.core.result.Result.Ok bytes)
                                          | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual =>
                                            liftM
                                              (Aeneas.Std.core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
                                                (Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
                                                (Aeneas.Std.core.convert.FromSame VTop_Stages.verifier.Error) residual)
                                      | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual =>
                                        liftM
                                          (Aeneas.Std.core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
                                            (Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
                                            (Aeneas.Std.core.convert.FromSame VTop_Stages.verifier.Error) residual)
                                  | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual =>
                                    liftM
                                      (Aeneas.Std.core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
                                        (Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
                                        (Aeneas.Std.core.convert.FromSame VTop_Stages.verifier.Error) residual)
                              | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual =>
                                liftM
                                  (Aeneas.Std.core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
                                    (Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
                                    (Aeneas.Std.core.convert.FromSame VTop_Stages.verifier.Error) residual)
                          | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual =>
                            liftM
                              (Aeneas.Std.core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
                                (Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
                                (Aeneas.Std.core.convert.FromSame VTop_Stages.verifier.Error) residual)
                      | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual =>
                        liftM
                          (Aeneas.Std.core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
                            (Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
                            (Aeneas.Std.core.convert.FromSame VTop_Stages.verifier.Error) residual)
              | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual =>
                liftM
                  (Aeneas.Std.core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
                    (Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
                    (Aeneas.Std.core.convert.FromSame VTop_Stages.verifier.Error) residual)
          | Aeneas.Std.core.ops.control_flow.ControlFlow.Break residual =>
            liftM
              (Aeneas.Std.core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
                (Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8) (Aeneas.Std.core.convert.FromSame VTop_Stages.verifier.Error)
                residual)
THM AspisR1.Tx2N_Query.twelve : ∀ (ops : AspisR1.Port3_NativeQueryBody.Ops),
  AspisR1.Port5Q1_QueryPorts.SessionAPrimitives ops →
    ∀ (proof : Aeneas.Std.Slice Aeneas.Std.U8) (p : AspisR1Stage2.verifier.Prepared)
      (saved returned : AspisR1Stage2.verifier.Accumulator)
      (g : Aeneas.Std.Array AspisR1Stage2.aspis_core.field.wide_exact.WideExact 29#usize)
      (geometry : AspisR1Stage2.verifier.QueryGeometry) (pending after : AspisR1Stage2.verifier.BatchedWeights)
      (flushed : Aeneas.Std.Slice AspisR1Stage2.aspis_core.field.QM31)
      (back :
        Aeneas.Std.Slice AspisR1Stage2.aspis_core.field.QM31 →
          Aeneas.Std.alloc.vec.Vec AspisR1Stage2.aspis_core.field.QM31)
      (parsed : AspisR1.OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144)
      (tr : AspisR1.RawCutTranscriptRun.ErasedPrefix)
      (data : AspisR1.MatchingSupport.Data AspisR1.OraclePortCheckpointAbiC5.E)
      (rho : AspisR1.OraclePortCheckpointAbiC5.K) (c : AspisR1.OraclePortCheckpointResumeC5.Context)
      (am : AspisR1.QueryAccumulator.State AspisR1.OraclePortCheckpointAbiC5.K AspisR1.OraclePortCheckpointAbiC5.E),
      AspisR1.CheckpointBytes4SavedFields.BodyMatches p saved
          (AspisR1.OraclePortCheckpointResumeC5.prepared c data rho q) am →
        saved.next = 10#usize →
          AspisR1.LiteralMatchingData.read (AspisR1.OraclePortStoredDecisionDraftC4.typedRows parsed q tr) = some data →
            parsed.wire = AspisR1.MultiproofConeCanonical.bytesOf ↑proof →
              (↑proof).length = 57607 →
                ∀ (recovered : ℕ → Option AspisV8R19.DuplexFrames.Bytes),
                  (∀ pos < 22,
                      recovered (AspisR1.OraclePortSelectedDraft.index q 2 pos) =
                        some (AspisR1.OraclePortPackedChoiceC4.payload parsed 2 pos)) →
                    AspisR1.Port5Q1_GeometryBinding.Binding p.queries 10#usize 22#usize geometry →
                      ∀ (reserved : Bool),
                        AspisR1.Port3_NativePendingInstall.source reserved saved.weights.deref =
                            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok pending) →
                          AspisR1.Port3_QueryStage.query
                                (AspisR1.Port4C_RowStd.install (AspisR1.Port5Q1_QueryPorts.install ops)) proof p saved g
                                none geometry pending 22#usize =
                              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (returned, after)) →
                            returned.weights.deref_mut = (returned.weights.deref, back) →
                              AspisR1.Port3_FlushInstall.flush after returned.weights.deref =
                                  Aeneas.Std.Result.ok flushed →
                                AspisR1.CheckpointBytes5Output.accumulator
                                    { weights := back flushed, rhs := returned.rhs, power := returned.power,
                                      next := returned.next } =
                                  AspisR1.OraclePortCheckpointStateC3.advance
                                    (AspisR1.OraclePortCheckpointResumeC5.model data rho q) 12
                                    (AspisR1.CheckpointBytes5Output.accumulator saved)
THM AspisS2OwnedStage1.SdkReference.owned_acquire_shared.eq_1 : ∀ (sdk : AspisS2OwnedStage1.SdkReference.OwnedSdk)
  (slot : Aeneas.Std.Usize),
  AspisS2OwnedStage1.SdkReference.owned_acquire_shared sdk slot = do
    let odc ←
      Aeneas.Std.alloc.vec.Vec.index
          (Aeneas.Std.core.slice.index.SliceIndexUsizeSlice AspisS2OwnedStage1.SdkReference.OwnedDataCell)
          sdk.data_cells slot
    let b ← AspisS2OwnedStage1.SdkReference.shared_allowed odc.borrowed
    if b = true then do
        let o ← Aeneas.Std.lift (odc.borrowed.checked_add 1#isize)
        let i ← Aeneas.Std.core.option.Option.unwrap o
        let (odc1, index_mut_back) ←
          Aeneas.Std.alloc.vec.Vec.index_mut
              (Aeneas.Std.core.slice.index.SliceIndexUsizeSlice AspisS2OwnedStage1.SdkReference.OwnedDataCell)
              sdk.data_cells slot
        have v : Aeneas.Std.alloc.vec.Vec AspisS2OwnedStage1.SdkReference.OwnedDataCell :=
          index_mut_back { bytes := odc1.bytes, borrowed := i, strong := odc1.strong, weak := odc1.weak }
        Aeneas.Std.Result.ok
            (Aeneas.Std.core.result.Result.Ok (),
              { accounts := sdk.accounts, data_cells := v, lamports_cells := sdk.lamports_cells })
      else
