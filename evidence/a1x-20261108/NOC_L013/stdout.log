THM AspisS2OwnedStage1.SdkReference.GuardRelease.dropCheckpoint.eq_1 : ∀
  (sdk : AspisS2OwnedStage1.SdkReference.OwnedSdk) (slot : Aeneas.Std.Usize),
  AspisS2OwnedStage1.SdkReference.GuardRelease.dropCheckpoint sdk slot = do
    let cell ←
      Aeneas.Std.alloc.vec.Vec.index
          (Aeneas.Std.core.slice.index.SliceIndexUsizeSlice AspisS2OwnedStage1.SdkReference.OwnedDataCell)
          sdk.data_cells slot
    let option ← Aeneas.Std.lift (cell.borrowed.checked_add 1#isize)
    let next ← Aeneas.Std.core.option.Option.unwrap option
    let (old, back) ←
      Aeneas.Std.alloc.vec.Vec.index_mut
          (Aeneas.Std.core.slice.index.SliceIndexUsizeSlice AspisS2OwnedStage1.SdkReference.OwnedDataCell)
          sdk.data_cells slot
    Aeneas.Std.Result.ok
        { accounts := sdk.accounts,
          data_cells := back { bytes := old.bytes, borrowed := next, strong := old.strong, weak := old.weak },
          lamports_cells := sdk.lamports_cells }
