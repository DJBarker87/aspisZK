'PV_EVH_LiftLaws.bind_lift' depends on axioms: [Quot.sound]
def Aeneas.Std.Array.index_usize.{u} : {α : Type u} → {n : Usize} → Std.Array α n → Usize → Result α :=
fun {α} {n} v i =>
  match v[i]? with
  | none => Result.fail Error.arrayOutOfBounds
  | some x => Result.ok x
Aeneas.Std.Array.index_usize_spec.{u} {α : Type u} {n : Usize} (v : Std.Array α n) (i : Usize)
  (hbound : ↑i < v.length) : v.index_usize i ⦃ x => x = (↑v)[↑i] ⦄
def Aeneas.Std.Usize.wrapping_add : Usize → Usize → Usize :=
fun x y => UScalar.wrapping_add x y
@[reducible] def ProverRwFull.core.result.Result.map : [types : ProverRwFull.ExternalTypes] →
  [ext : ProverRwFull.ExternalFuns] →
