        (Aeneas.Std.Array Aeneas.Std.U32 22#usize × Aeneas.Std.Array Aeneas.Std.U8 32#usize)
        (Aeneas.Std.core.convert.FromSame AspisR1Query31Transcript.aspis_core.transcript.QuerySampleError) residual
