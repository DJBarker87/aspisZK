+    let expected = ((block[j] as u32) | ((block[j+1] as u32)<<8)
+       | ((block[j+2] as u32)<<16) | ((block[j+3] as u32)<<24)) & 262143;
+    let correct = out[k] == expected && out[k] < 262144;
+    #[cfg(not(NGQ_invert))] assert!(correct);
