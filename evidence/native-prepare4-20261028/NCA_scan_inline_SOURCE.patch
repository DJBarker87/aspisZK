+ let j:usize=kani::any();kani::assume(j<29);assert_eq!(g[j],E::ZERO);
+ kani::cover!(NCA_OBS,"source Parsed callback before prepare");kani::cover!(!NCA_OBS,"source None before prepare");kani::assume(false);Err(Error::Parse)
+}}
