+use super::*;
+use crate::poseidon2::Digest;
+use crate::atomic_statement::AtomicStatementError;
+use aspis_core::field::M31;
+#[path="NEC_live_value_reference.rs"]mod reference;
+static mut INPUT:usize=0;static mut INDEX:usize=0;static mut ROW:usize=0;
+static mut DIGESTS:[Digest;21]=[[M31(0);8];21];
+pub static mut NEXT:usize=0;
+static mut ERROR:PoolV1PairLiveSnapshotErrorV1=PoolV1PairLiveSnapshotErrorV1::WrongMagic;
+static mut FAIL_AT:usize=21;
+const GROUP:u8=0;
+const REJECT:bool=false;
+const DIGEST_REJECT:bool=false;
+fn digest(bytes:&[u8;32])->Result<Digest,AtomicStatementError>{
+ let slot=unsafe{NEXT};assert!(slot<21,"NEC_live_slot");
+ let base=unsafe{INPUT};assert_eq!(bytes.as_ptr() as usize,base+128+32*slot,"NEC_live_exact_digest_pointer");
+ unsafe{NEXT=slot+1;}
+ if DIGEST_REJECT && slot==unsafe{FAIL_AT}{Err(AtomicStatementError::NonCanonicalDigest)}else{Ok(unsafe{DIGESTS[slot]})}
+}
+fn word(x:&PoolV1PairLiveSnapshotV1)->u64{let(i,r)=unsafe{(INDEX,ROW)};match GROUP{0=>x.sequence,1=>x.next_pair_index,2=>x.pool[i] as u64,3=>x.deployment_domain[i] as u64,4=>x.current_root[i].0 as u64,_=>x.frontier[r][i].0 as u64}}
+fn expected()->u64{
+ let bytes=unsafe{core::slice::from_raw_parts(INPUT as *const u8,800)};let(i,r)=unsafe{(INDEX,ROW)};
+ match GROUP{0=>u64::from_le_bytes(bytes[112..120].try_into().unwrap()),1=>u64::from_le_bytes(bytes[120..128].try_into().unwrap()),2=>bytes[48+i] as u64,3=>bytes[80+i] as u64,4=>unsafe{DIGESTS[0][i].0 as u64},_=>unsafe{DIGESTS[r+1][i].0 as u64}}
+}
+fn validator(x:&PoolV1PairLiveSnapshotV1)->Result<(),PoolV1PairLiveSnapshotErrorV1>{
+ assert_eq!(unsafe{NEXT},21,"NEC_live_all_digest_calls");
+ assert_eq!(word(x),expected(),"NEC_live_validator_same_record");
+ if REJECT{Err(unsafe{ERROR})}else{Ok(())}
+}
+pub fn post(r:&Result<PoolV1PairLiveSnapshotV1,PoolV1PairLiveSnapshotErrorV1>)->bool{
+ let same=if DIGEST_REJECT{*r==Err(PoolV1PairLiveSnapshotErrorV1::NonCanonicalDigest) && unsafe{NEXT==FAIL_AT+1}}
+ else if REJECT{*r==Err(unsafe{ERROR}) && unsafe{NEXT==21}}
+ else{let rr=reference::reply_ref::<u64,PoolV1PairLiveSnapshotErrorV1>(Ok(expected()));match(r,rr){(Ok(x),Ok(v))=>word(x)==v && unsafe{NEXT==21},_=>false}};
+ same != false
+}
+fn make_bytes()->[u8;800]{let mut b:[u8;800]=kani::any();b[0]=65;b[1]=83;b[2]=80;b[3]=76;b[4]=73;b[5]=86;b[6]=69;b[7]=49;b[8]=1;b[9]=0;b[10]=0;b[11]=0;b[12]=0;b[13]=0;b[14]=0;b[15]=0;b[16]=65;b[17]=83;b[18]=80;b[19]=80;b[20]=65;b[21]=73;b[22]=82;b[23]=49;b[24]=1;b[25]=20;b[26]=21;b[27]=7;b[28]=1;b[29]=1;b[30]=1;b[31]=1;b[32]=0;b[33]=0;b[34]=0;b[35]=0;b[36]=0;b[37]=0;b[38]=0;b[39]=0;b[40]=0;b[41]=0;b[42]=0;b[43]=0;b[44]=0;b[45]=0;b[46]=0;b[47]=0; b}
+#[kani::proof_for_contract(super::decode_pool_v1_pair_live_snapshot_v1)]
+#[kani::stub(crate::atomic_statement::decode_digest_canonical,digest)]
+#[kani::stub(super::validate_pool_v1_pair_live_snapshot_v1,validator)]
+#[kani::stub(core::ptr::copy_nonoverlapping,crate::NEC_kmx::KMX_copy_nonoverlapping)]
+#[kani::unwind(34)]
+fn live_contract(){
+ let bytes=make_bytes();let i:usize=kani::any();let row:usize=kani::any();kani::assume(i<if GROUP==2||GROUP==3{32}else{8});kani::assume(row<20);
+ let fail:usize=kani::any();kani::assume(fail<21);
+ unsafe{INPUT=bytes.as_ptr() as usize;INDEX=i;ROW=row;NEXT=0;ERROR=kani::any();FAIL_AT=fail;DIGESTS=core::mem::transmute(kani::any::<[u8;672]>());}
