+use crate::poseidon2::Digest;
+use crate::atomic_statement::AtomicStatementError;
+static mut SOURCE:*const u8=core::ptr::null();
+static mut SLOT:usize=0;
+static mut BYTE:usize=0;
+static mut COUNT:usize=0;
+fn digest_window(bytes:&[u8;32])->Result<Digest,AtomicStatementError>{
+ let n=unsafe{COUNT};unsafe{COUNT=n+1;}
+ if n==unsafe{SLOT}{
+  let j=unsafe{BYTE};let expected=unsafe{SOURCE.add(128+32*n+j).read()};
+  let same=bytes[j]==expected;
+  kani::cover!(same);
+  assert_eq!(same,!true);
+  kani::assume(false);
+ }
+ let value:Digest=unsafe{core::mem::transmute(kani::any::<[u8;32]>())};Ok(value)
+}
+#[kani::proof]
+#[kani::stub(crate::atomic_statement::decode_digest_canonical,digest_window)]
+#[kani::stub(core::ptr::copy_nonoverlapping,crate::NEC_kmx::KMX_copy_nonoverlapping)]
+#[kani::unwind(34)]
+fn selected_window(){
+ let bytes:[u8;800]=kani::any();let slot:usize=kani::any();let byte:usize=kani::any();
+ kani::assume(slot<21 && byte<32);
+ unsafe{SOURCE=bytes.as_ptr();SLOT=slot;BYTE=byte;COUNT=0;}
+ let _=crate::pool_v1::decode_pool_v1_pair_live_snapshot_v1(&bytes);
+ // All accepted-header paths stop at their selected call before the large constructor.
+}
