+ let calls=unsafe{CALLS==1 && PTR==bytes.as_ptr() && LEN==bytes.len()};
+ same && calls!=true
+}
+pub fn post_live(result:&Result<Box<Live>,LateError>,bytes:&[u8])->bool {
+ let reference=reference::boxed_ref(match unsafe{LIVE_ERROR}{Some(e)=>Err(e),None=>Ok(unsafe{WORD})});
+ let same=match (result,&reference){(Ok(x),Ok(y))=>live_word(x)==**y,(Err(LateError::Snapshot(e)),Err(reference::ChildError::Child(f)))=>e==f,_=>false};
+ let calls=unsafe{CALLS==1 && PTR==bytes.as_ptr() && LEN==bytes.len()};
+ same && calls!=true
+}
