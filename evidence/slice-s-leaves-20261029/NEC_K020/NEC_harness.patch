+pub static mut WORD:u64=0;
+pub static mut AFTER_ERROR:Option<AfterError>=None;
+pub static mut LIVE_ERROR:Option<LiveError>=None;
+const GROUP:u8=0;
+fn after_word(x:&After)->u64 {let (i,r)=unsafe{(INDEX,ROW)};match GROUP {0=>x.next_pair_index,1=>x.next_root[i].0 as u64,_=>x.next_frontier[r][i].0 as u64}}
+fn live_word(x:&Live)->u64 {let (i,r)=unsafe{(INDEX,ROW)};match GROUP {0=>x.sequence,1=>x.next_pair_index,2=>x.pool[i] as u64,3=>x.deployment_domain[i] as u64,4=>x.current_root[i].0 as u64,_=>x.frontier[r][i].0 as u64}}
+fn after_child(bytes:&[u8])->Result<After,AfterError>{
+ unsafe{CALLS=CALLS.wrapping_add(1);PTR=bytes.as_ptr();LEN=bytes.len();}
+ if kani::any(){let x:After=kani::any();unsafe{WORD=after_word(&x);AFTER_ERROR=None;}Ok(x)}
+ else {let e:AfterError=kani::any();unsafe{AFTER_ERROR=Some(e);}Err(e)}
+}
+fn live_child(bytes:&[u8])->Result<Live,LiveError>{
+ unsafe{CALLS=CALLS.wrapping_add(1);PTR=bytes.as_ptr();LEN=bytes.len();}
+ if kani::any(){let x:Live=kani::any();unsafe{WORD=live_word(&x);LIVE_ERROR=None;}Ok(x)}
+ else {let e:LiveError=kani::any();unsafe{LIVE_ERROR=Some(e);}Err(e)}
+}
+fn prepare(limit:usize){let i:usize=kani::any();let row:usize=kani::any();kani::assume(i<limit && row<20);unsafe{INDEX=i;ROW=row;CALLS=0;PTR=core::ptr::null();LEN=0;WORD=0;AFTER_ERROR=None;LIVE_ERROR=None;}}
+pub fn post_after(result:&Result<Box<After>,LateError>,bytes:&[u8])->bool {
+ let reference=reference::boxed_ref(match unsafe{AFTER_ERROR}{Some(e)=>Err(e),None=>Ok(unsafe{WORD})});
