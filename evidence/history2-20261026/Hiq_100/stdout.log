theorem AspisR1.Hiq_StoredTransport.transport : ∀ {A : Type} (D : AspisR1.LiteralByteProtocol.Decoder)
  (rust : AspisR1.OraclePortRuntimeBindingC7.Verifier) (P : AspisR1.OraclePortStoredExperimentC4.Prover)
  (runtime : AspisR1.OraclePortRuntimeBindingC7.Runtime)
  (source : AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State A)
  (bad : AspisV8R19.MemoizedProgramLaw.View AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State A → Prop),
  (∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
      (run : AspisR1.OraclePortStoredExperimentC4.RunView),
      (AspisV8R19.MemoizedProgramLaw.eval H runtime).2 = some run →
        run.2.2 = true →
          run =
              AspisV8R19.MemoizedProgramLaw.eval H
                (AspisR1.OraclePortRuntimeBindingC7.annotatedWith D rust
                  (AspisR1.OraclePortStoredAdmissionC4.canon P)) ∨
            bad (AspisV8R19.MemoizedProgramLaw.eval H source)) →
    AspisR1.OraclePortRuntimeBindingC7.deployedFailure runtime ≤
      (AspisV8R19.MemoizedProgramLaw.lazyMean
          (AspisR1.OraclePortRuntimeBindingC7.annotatedWith D rust (AspisR1.OraclePortStoredAdmissionC4.canon P))
          FS.emptyTable fun v =>
          AspisR1.RawRecordedOracleExtractionMassBin.failureMass (AspisR1.OraclePortStoredExperimentC4.view v)) +
        AspisV8R19.MemoizedProgramLaw.lazyMean source FS.emptyTable fun v =>
          AspisV8R19.CausalFirstHitUnionBound.indicator (bad v) :=
⋯
theorem AspisR1.Hiq_RuntimeScope.carried_insufficient : ∀ {F C : Type} (c : AspisR1.DrvC_Installation.Configuration F C)
  (D : AspisR1.LiteralByteProtocol.Decoder) (P : AspisR1.OraclePortStoredExperimentC4.Prover)
  (pub proof : Aeneas.Std.Slice Aeneas.Std.U8) (state : AspisV8R19.SourceDuplexStep.State),
  ∃ runtime run,
    runtime = AspisV8R19.MemoizedProgramLaw.Program.done (some run) ∧
      run.2.1 = AspisR1.Hiq_CanonicalCarrier.input pub proof ∧
        run.2.2 = true ∧
          AspisR1.Port1_StoredCarrier.Carried run.2.1 ∧
            ¬AspisR1.OraclePortRuntimeBindingC7.StoredCarrierBinding D (AspisR1.DrvC_Implementation.driver c) P
                runtime :=
