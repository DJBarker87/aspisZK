PV_RJ4IDB.output_oracle_fail {P S T O : Type} (e : Aeneas.Std.Error) (observe : PV_RJ4IDB.ReturnedOutput P → O) :
  observe (PV_RJ4IDB.resultOutput (Aeneas.Std.Result.fail e)) =
    observe (PV_RJ4IDB.resultOutput (Aeneas.Std.Result.fail e))
PV_RJ4IDB.output_oracle_div {P S T O : Type} (observe : PV_RJ4IDB.ReturnedOutput P → O) :
  observe (PV_RJ4IDB.resultOutput Aeneas.Std.Result.div) = observe (PV_RJ4IDB.resultOutput Aeneas.Std.Result.div)
R1Z.PV_RJ4IDB_ByteWindow.word_window (l r : List Aeneas.Std.U8) (a b width off : ℕ)
  (h : List.take width (List.drop a l) = List.take width (List.drop b r)) (bound : off + 4 ≤ width) :
  AspisR1.PV_2TNV_PublicEncoding.word l (a + off) = AspisR1.PV_2TNV_PublicEncoding.word r (b + off)
R1Z.PV_RJ4IDB_ByteWindow.digest_window (l r : List Aeneas.Std.U8) (a b width off : ℕ)
  (h : List.take width (List.drop a l) = List.take width (List.drop b r)) (bound : off + 32 ≤ width) :
  AspisR1.PV_2TNV_PublicEncoding.digest l (a + off) = AspisR1.PV_2TNV_PublicEncoding.digest r (b + off)
R1Z.PV_RJ4IDB_CallerLive.live_index :
  AspisR1.PV_2TNV_ByteEncoding.littleEndian (List.take 8 (List.drop 88 ↑AspisR1.JHb_DataLane.value)) =
    AspisR1.PV_2TNV_PublicEncoding.nativePublic.nextPairIndex
R1Z.PV_RJ4IDB_CallerLive.live_frontier (i : Fin 20) :
  AspisR1.PV_2TNV_PublicEncoding.digest (↑AspisR1.JHb_DataLane.value) (128 + 32 * ↑i) =
    AspisR1.PV_2TNV_PublicEncoding.digest AspisR1.JFx_DataPublic00.bytes (336 + 32 * ↑i)
R1Z.PV_RJ4IDB_CallerLive.live_public_eq :
  R1Z.PV_RJ4IDB_CallerLive.livePublic = AspisR1.PV_2TNV_PublicEncoding.nativePublic
R1Z.PV_RJ4IDB_CallerLive.caller_to_transfer13 {CH : Type} (native_handle : CH) :
  R1Z.PV_RJ4IDB_CallerLive.callerStatement native_handle = AspisR1.PV_2TNV_PublicEncoding.x native_handle
R1Z.PV_RJ4IDB_CallerLive.caller_witness {CH : Type} (native_handle : CH) :
  ∃ w, R1Z.PV_RJDec_V047.H.public w = (R1Z.PV_RJ4IDB_CallerLive.callerStatement native_handle).1
R1Z.PV_RJ4IDB_StdIndex.source_equal {A : Type} {N : Aeneas.Std.Usize} (a : Aeneas.Std.Array A N)
  (i : Aeneas.Std.Usize) : R1Z.PV_RJ4IDB_StdIndex.indexMut a i = a.index_mut_usize i
R1Z.PV_RJ4IDB_StdIndex.in_bounds {A : Type} {N : Aeneas.Std.Usize} (a : Aeneas.Std.Array A N) (i : Aeneas.Std.Usize)
  (hi : ↑i < ↑N) : ∃ old, R1Z.PV_RJ4IDB_StdIndex.indexMut a i = Aeneas.Std.Result.ok (old, a.set i)
R1Z.PV_RJ4IDB_StdIndex.out_of_bounds {A : Type} {N : Aeneas.Std.Usize} (a : Aeneas.Std.Array A N) (i : Aeneas.Std.Usize)
  (hi : ↑N ≤ ↑i) : R1Z.PV_RJ4IDB_StdIndex.indexMut a i = Aeneas.Std.Result.fail Aeneas.Std.Error.arrayOutOfBounds
PV_RJ4IDB.diag_with_state_order {S A : Type} (expose : S → List (PV_RJ4IDB.Bytes × PV_RJ4IDB.Bytes))
  (x : PV_DIAG3.Execution S A) :
  (PV_RJ4IDB.decoder (PV_RJ4IDB.diagWithState expose x)).ordered =
    List.map PV_RJ4IDB.Event.diagnostic3 x.events ++
      List.map (fun p => PV_RJ4IDB.Event.retained p.1 p.2) (expose x.state)
PV_RJ4IDB.final_state_abort {S A : Type} (expose : S → List (PV_RJ4IDB.Bytes × PV_RJ4IDB.Bytes))
  (es : List PV_DIAG3.Event) (s : S) (c : PV_DIAG3.Crash) :
  PV_RJ4IDB.diagWithState expose { events := es, state := s, exit := PV_DIAG3.Exit.abort c } =
    {
      events :=
        List.map PV_RJ4IDB.Event.diagnostic3 es ++ List.map (fun p => PV_RJ4IDB.Event.retained p.1 p.2) (expose s),
      terminal := PV_RJ4IDB.Terminal.abort c }
PV_RJ4IDB.final_state_divergence {S A : Type} (expose : S → List (PV_RJ4IDB.Bytes × PV_RJ4IDB.Bytes))
  (es : List PV_DIAG3.Event) (s : S) :
  PV_RJ4IDB.diagWithState expose { events := es, state := s, exit := PV_DIAG3.Exit.diverge } =
    {
      events :=
        List.map PV_RJ4IDB.Event.diagnostic3 es ++ List.map (fun p => PV_RJ4IDB.Event.retained p.1 p.2) (expose s),
      terminal := PV_RJ4IDB.Terminal.diverge }
PV_RJ4IDB.native_normal_model {H S P : Type} (expose : H → List (PV_RJ4IDB.Bytes × PV_RJ4IDB.Bytes))
  (retry : PV_DIAG3.Op H (Aeneas.Std.Result (R1Z.ProverCommitRetry34.Step (R1Z.ProverCommitRetry34.Published P) × S)))
  (o : PV_DIAG3.ClientHandlers H S P) (a : R1Z.ProverCommitRetry34.Attempt S P) (n k : ℕ) (state : S) (s t : H)
  (es : List PV_DIAG3.Event)
  (leaf :
    retry s = { events := es, state := t, exit := PV_DIAG3.Exit.value (R1Z.ProverCommitRetry34.run a n k state) }) :
  PV_RJ4IDB.observedClient expose retry o s =
    PV_RJ4IDB.decoder (PV_RJ4IDB.diagWithState expose (PV_DIAG3.prepend es (PV_DIAG3.modelClient a n k state o t)))
