PV_RJ4IDB.all_prefixes {I A : Type} (family : I → PV_RJ4IDB.NativeTrace A) (i : I) :
  PV_RJ4IDB.nativeObservation (family i) = PV_RJ4IDB.decoder (PV_RJ4IDB.modelTrace (family i))
PV_RJ4IDB.resultOutput_map {P S T : Type} (project : S → T)
  (out : Aeneas.Std.Result (R1Z.ProverCommitRetry34.Step (R1Z.ProverCommitRetry34.Published P) × S)) :
  PV_RJ4IDB.resultOutput out =
    PV_RJ4IDB.resultOutput (R1Z.ProverCommitSemanticTransport26.mapR (fun p => (p.1, project p.2)) out)
PV_RJ4IDB.count_retained {P S : Type} (proof : P) (count : ℕ) (s : S) :
  PV_RJ4IDB.resultOutput
      (Aeneas.Std.Result.ok (R1Z.ProverCommitRetry34.Step.done { proof := proof, attempts := count }, s)) =
    PV_RJ4IDB.ReturnedOutput.done proof count
PV_RJ4IDB.returned_output_fibres {W C P : Type}
  (reachable :
    R1Z.PV_W_Threading.Run W C Aeneas.Std.Error (R1Z.ProverCommitRetry34.Step (R1Z.ProverCommitRetry34.Published P)) →
      Prop) :
  R1Z.PV_RJDec_Factor.Fibres reachable fun r => PV_RJ4IDB.resultOutput (R1Z.PV_RunJoin_WorldDecode33.returned r)
PV_RJ4IDB.output_disclosed_ok {P S T V : Type} (s : S) (project : S → T)
  (v : R1Z.ProverCommitRetry34.Step (R1Z.ProverCommitRetry34.Published P)) (disclose : PV_RJ4IDB.ReturnedOutput P → V) :
  disclose (PV_RJ4IDB.resultOutput (Aeneas.Std.Result.ok (v, s))) =
    disclose (PV_RJ4IDB.resultOutput (Aeneas.Std.Result.ok (v, project s)))
PV_RJ4IDB.output_disclosed_fail {P S T V : Type} (e : Aeneas.Std.Error) (disclose : PV_RJ4IDB.ReturnedOutput P → V) :
  disclose (PV_RJ4IDB.resultOutput (Aeneas.Std.Result.fail e)) =
    disclose (PV_RJ4IDB.resultOutput (Aeneas.Std.Result.fail e))
PV_RJ4IDB.output_disclosed_div {P S T V : Type} (disclose : PV_RJ4IDB.ReturnedOutput P → V) :
  disclose (PV_RJ4IDB.resultOutput Aeneas.Std.Result.div) = disclose (PV_RJ4IDB.resultOutput Aeneas.Std.Result.div)
PV_RJ4IDB.output_oracle_ok {P S T O : Type} (s : S) (project : S → T)
  (v : R1Z.ProverCommitRetry34.Step (R1Z.ProverCommitRetry34.Published P)) (observe : PV_RJ4IDB.ReturnedOutput P → O) :
  observe (PV_RJ4IDB.resultOutput (Aeneas.Std.Result.ok (v, s))) =
