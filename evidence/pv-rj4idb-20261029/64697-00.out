PV_RJ4IDB.diag2_recover (es : List PV_DIAG2.Effect) : PV_RJ4IDB.diagnostics2 (PV_RJ4IDB.diag2Events es) = es
PV_RJ4IDB.diag2_failure_recover (es : List PV_DIAG2.Effect) (err : PV_RJ4IDB.Bytes) :
  (PV_RJ4IDB.decoder { events := PV_RJ4IDB.diag2Events es, terminal := PV_RJ4IDB.Terminal.failure err }).errorsStderr2 =
    es
PV_RJ4IDB.diag2_divergence_recover (es : List PV_DIAG2.Effect) :
  (PV_RJ4IDB.decoder { events := PV_RJ4IDB.diag2Events es, terminal := PV_RJ4IDB.Terminal.diverge }).errorsStderr2 = es
PV_RJ4IDB.diag2_append (a b : List PV_DIAG2.Effect) :
  PV_RJ4IDB.diag2Events (a ++ b) = PV_RJ4IDB.diag2Events a ++ PV_RJ4IDB.diag2Events b
PV_RJ4IDB.proof_statement_order (p : PV_RJ4IDB.PublicationInput) :
  PV_RJ4IDB.files (PV_RJ4IDB.requestedPublication p) =
    [PV_RJ4IDB.FileOp.write p.proofPath (p.afterstate ++ p.publish_compact) [],
      PV_RJ4IDB.FileOp.write p.statementPath p.statement []]
PV_RJ4IDB.publication_append_prefix (p : PV_RJ4IDB.PublicationInput) (prior : List PV_RJ4IDB.Event) :
  PV_RJ4IDB.files (prior ++ PV_RJ4IDB.requestedPublication p) =
    PV_RJ4IDB.files prior ++
      [PV_RJ4IDB.FileOp.write p.proofPath (p.afterstate ++ p.publish_compact) [],
        PV_RJ4IDB.FileOp.write p.statementPath p.statement []]
PV_RJ4IDB.available_result_component {W A V : Type}
  (reachable : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A → Prop)
  (decode : Aeneas.Std.Result (A × W) → V) :
  R1Z.PV_RJDec_Factor.Fibres reachable fun r => decode (R1Z.PV_RunJoin_WorldDecode33.returned r)
PV_RJ4IDB.projection_law {W A V : Type} (reachable : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A → Prop)
  (project : List PV_RJ4IDB.Event → V) (h : PV_RJ4IDB.ChannelLaw reachable fun es => es) :
  PV_RJ4IDB.ChannelLaw reachable project
PV_RJ4IDB.product_law {W A V U : Type} (reachable : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A → Prop)
  (left : List PV_RJ4IDB.Event → V) (right : List PV_RJ4IDB.Event → U) :
  (PV_RJ4IDB.ChannelLaw reachable fun es => (left es, right es)) ↔
    PV_RJ4IDB.ChannelLaw reachable left ∧ PV_RJ4IDB.ChannelLaw reachable right
PV_RJ4IDB.result_decoder_exists_iff {W A V : Type} [Nonempty V]
  (reachable : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A → Prop)
  (component : List PV_RJ4IDB.Event → V) :
  (∃ decode,
      ∀ (r : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A),
        reachable r → decode (R1Z.PV_RunJoin_WorldDecode33.returned r) = component (List.map Prod.snd r.calls)) ↔
    PV_RJ4IDB.ChannelLaw reachable component
PV_RJ4IDB.component_cases {W A : Type} (reachable : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A → Prop)
  {U : Type} (component : List PV_RJ4IDB.Event → U) :
  PV_RJ4IDB.ChannelLaw reachable component ↔
    (∀ (l r : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A) (a : A),
        reachable l →
          reachable r →
            l.outcome = R1Z.PV_W_Threading.Outcome.ok a →
              r.outcome = R1Z.PV_W_Threading.Outcome.ok a →
                l.world = r.world → component (List.map Prod.snd l.calls) = component (List.map Prod.snd r.calls)) ∧
      (∀ (l r : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A) (e : Aeneas.Std.Error),
          reachable l →
            reachable r →
              l.outcome = R1Z.PV_W_Threading.Outcome.fail e →
                r.outcome = R1Z.PV_W_Threading.Outcome.fail e →
                  component (List.map Prod.snd l.calls) = component (List.map Prod.snd r.calls)) ∧
        ∀ (l r : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A),
          reachable l →
            reachable r →
              l.outcome = R1Z.PV_W_Threading.Outcome.div →
                r.outcome = R1Z.PV_W_Threading.Outcome.div →
                  component (List.map Prod.snd l.calls) = component (List.map Prod.snd r.calls)
R1Z.PV_RJ4IDB_PowersSafety.increment [ProverRwFull.ExternalTypes] {N : Aeneas.Std.Usize} (i : Aeneas.Std.Usize)
  (hi : ↑i < ↑N) : ↑(i.wrapping_add 1#usize) = ↑i + 1
R1Z.PV_RJ4IDB_PowersSafety.index_restore [ProverRwFull.ExternalTypes] {N : Aeneas.Std.Usize}
  (out : Aeneas.Std.Array R1Z.PV_RJ4IDB_PowersControl.W N) (i : Aeneas.Std.Usize) (hi : ↑i < ↑N) :
  ∃ old, out.index_mut_usize i = Aeneas.Std.Result.ok (old, out.set i)
R1Z.PV_RJ4IDB_PowersSafety.mul_total [ProverRwFull.ExternalTypes] (ops : ProverRwFull.ExternalFuns)
  (p x : R1Z.PV_RJ4IDB_PowersControl.W) :
  ∃ q, ProverRwFull.aspis_core.field.wide_exact.WideExact.mul p x = Aeneas.Std.Result.ok q
R1Z.PV_RJ4IDB_PowersSafety.finite_total [ProverRwFull.ExternalTypes] (ops : ProverRwFull.ExternalFuns)
  {N : Aeneas.Std.Usize} (x : R1Z.PV_RJ4IDB_PowersControl.W) (fuel : ℕ)
  (out : Aeneas.Std.Array R1Z.PV_RJ4IDB_PowersControl.W N) (p : R1Z.PV_RJ4IDB_PowersControl.W) (i : Aeneas.Std.Usize)
  (bound : ↑i + fuel = ↑N) : ∃ result, R1Z.PV_RJ4IDB_PowersControl.finite x fuel out p i = Aeneas.Std.Result.ok result
R1Z.PV_RJ4IDB_PowersTotal.complete [ProverRwFull.ExternalTypes] (ops : ProverRwFull.ExternalFuns) (N : Aeneas.Std.Usize)
  (x : R1Z.ProverRwDictionaryTower.W) : ∃ out, R1Z.PV_RJ4IDB_NativePowers.callback ops N x = Aeneas.Std.Result.ok out
R1Z.PV_RJ4IDB_PowersTotal.no_fail [ProverRwFull.ExternalTypes] (ops : ProverRwFull.ExternalFuns) (N : Aeneas.Std.Usize)
  (x : R1Z.ProverRwDictionaryTower.W) (e : Aeneas.Std.Error) :
  R1Z.PV_RJ4IDB_NativePowers.callback ops N x ≠ Aeneas.Std.Result.fail e
R1Z.PV_RJ4IDB_PowersTotal.no_diverge [ProverRwFull.ExternalTypes] (ops : ProverRwFull.ExternalFuns)
  (N : Aeneas.Std.Usize) (x : R1Z.ProverRwDictionaryTower.W) :
  R1Z.PV_RJ4IDB_NativePowers.callback ops N x ≠ Aeneas.Std.Result.div
