  PV_RJ4IDB.nativeObservation { events := es, terminal := PV_RJ4IDB.Terminal.success value } =
    PV_RJ4IDB.decoder (PV_RJ4IDB.modelTrace { events := es, terminal := PV_RJ4IDB.Terminal.success value })
