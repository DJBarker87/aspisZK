PV_RJ4IDB.bind_prepend {A B : Type} (es : List PV_RJ4IDB.Event) (t : PV_RJ4IDB.Trace A) (f : A → PV_RJ4IDB.Trace B) :
  PV_RJ4IDB.bind (PV_RJ4IDB.prepend es t) f = PV_RJ4IDB.prepend es (PV_RJ4IDB.bind t f)
PV_RJ4IDB.bind_assoc {A B C : Type} (t : PV_RJ4IDB.Trace A) (f : A → PV_RJ4IDB.Trace B) (g : B → PV_RJ4IDB.Trace C) :
  PV_RJ4IDB.bind (PV_RJ4IDB.bind t f) g = PV_RJ4IDB.bind t fun a => PV_RJ4IDB.bind (f a) g
PV_RJ4IDB.bind_failure {A B : Type} (es : List PV_RJ4IDB.Event) (e : PV_RJ4IDB.Bytes) (f : A → PV_RJ4IDB.Trace B) :
  PV_RJ4IDB.bind { events := es, terminal := PV_RJ4IDB.Terminal.failure e } f =
    { events := es, terminal := PV_RJ4IDB.Terminal.failure e }
PV_RJ4IDB.bind_divergence {A B : Type} (es : List PV_RJ4IDB.Event) (f : A → PV_RJ4IDB.Trace B) :
  PV_RJ4IDB.bind { events := es, terminal := PV_RJ4IDB.Terminal.diverge } f =
    { events := es, terminal := PV_RJ4IDB.Terminal.diverge }
PV_RJ4IDB.main_order (o : PV_RJ4IDB.ClientSuffix) :
  PV_RJ4IDB.mainSuffix o =
    PV_RJ4IDB.bind o.writeProof fun u =>
      PV_RJ4IDB.bind (o.writeStatement u) fun v => PV_RJ4IDB.bind (o.makeReturnedJSON v) o.printStdout
PV_RJ4IDB.statement_failure_preserves_proof (o : PV_RJ4IDB.ClientSuffix) (es fs : List PV_RJ4IDB.Event)
  (error : PV_RJ4IDB.Bytes) (hp : o.writeProof = { events := es, terminal := PV_RJ4IDB.Terminal.success () })
  (hs : o.writeStatement () = { events := fs, terminal := PV_RJ4IDB.Terminal.failure error }) :
  PV_RJ4IDB.mainSuffix o = { events := es ++ fs, terminal := PV_RJ4IDB.Terminal.failure error }
PV_RJ4IDB.json_divergence_preserves_files (o : PV_RJ4IDB.ClientSuffix) (a b c : List PV_RJ4IDB.Event)
  (hp : o.writeProof = { events := a, terminal := PV_RJ4IDB.Terminal.success () })
  (hs : o.writeStatement () = { events := b, terminal := PV_RJ4IDB.Terminal.success () })
  (hj : o.makeReturnedJSON () = { events := c, terminal := PV_RJ4IDB.Terminal.diverge }) :
  PV_RJ4IDB.mainSuffix o = { events := a ++ (b ++ c), terminal := PV_RJ4IDB.Terminal.diverge }
R1Z.PV_RJ4IDB_CallerPublic.request_public_eq :
  R1Z.PV_RJ4IDB_CallerPublic.requestPublic = AspisR1.PV_2TNV_PublicEncoding.nativePublic
R1Z.PV_RJ4IDB_CallerPublic.caller_statement_eq {CH : Type} (handle : CH) :
  R1Z.PV_RJ4IDB_CallerPublic.callerStatement handle = AspisR1.PV_2TNV_PublicEncoding.x handle
R1Z.PV_RJ4IDB_CallerPublic.caller_fibre {CH : Type} (handle : CH) :
  ∃ w, R1Z.PV_RJDec_V047.H.public w = (R1Z.PV_RJ4IDB_CallerPublic.callerStatement handle).1
PV_RJ4IDB.actual_factors {W A : Type} (render : Aeneas.Std.Error → PV_RJ4IDB.Bytes)
  (r : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A) :
  PV_RJ4IDB.actualObservation render r = PV_RJ4IDB.decoder (PV_RJ4IDB.sourceTrace render r)
PV_RJ4IDB.result_fibres_exact {W A : Type}
  (reachable : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A → Prop)
  (render : Aeneas.Std.Error → PV_RJ4IDB.Bytes) :
  R1Z.PV_RJDec_Factor.Fibres reachable (PV_RJ4IDB.actualObservation render) ↔
    (∀ (l r : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A) (a : A),
        reachable l →
          reachable r →
            l.outcome = R1Z.PV_W_Threading.Outcome.ok a →
              r.outcome = R1Z.PV_W_Threading.Outcome.ok a →
                l.world = r.world → List.map Prod.snd l.calls = List.map Prod.snd r.calls) ∧
      (∀ (l r : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A) (e : Aeneas.Std.Error),
          reachable l →
            reachable r →
              l.outcome = R1Z.PV_W_Threading.Outcome.fail e →
                r.outcome = R1Z.PV_W_Threading.Outcome.fail e → List.map Prod.snd l.calls = List.map Prod.snd r.calls) ∧
        ∀ (l r : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A),
          reachable l →
            reachable r →
              l.outcome = R1Z.PV_W_Threading.Outcome.div →
                r.outcome = R1Z.PV_W_Threading.Outcome.div → List.map Prod.snd l.calls = List.map Prod.snd r.calls
PV_RJ4IDB.returned_component {W C A V : Type} (reachable : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A → Prop)
  (decode : Aeneas.Std.Result (A × W) → V) :
  R1Z.PV_RJDec_Factor.Fibres reachable fun r => decode (R1Z.PV_RunJoin_WorldDecode33.returned r)
PV_RJ4IDB.returned_success {W C A V : Type} (decode : Aeneas.Std.Result (A × W) → V)
  (l r : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A) (a : A) (hl : l.outcome = R1Z.PV_W_Threading.Outcome.ok a)
  (hr : r.outcome = R1Z.PV_W_Threading.Outcome.ok a) (hw : l.world = r.world) :
  decode (R1Z.PV_RunJoin_WorldDecode33.returned l) = decode (R1Z.PV_RunJoin_WorldDecode33.returned r)
PV_RJ4IDB.returned_failure {W C A V : Type} (decode : Aeneas.Std.Result (A × W) → V)
  (l r : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A) (e : Aeneas.Std.Error)
  (hl : l.outcome = R1Z.PV_W_Threading.Outcome.fail e) (hr : r.outcome = R1Z.PV_W_Threading.Outcome.fail e) :
  decode (R1Z.PV_RunJoin_WorldDecode33.returned l) = decode (R1Z.PV_RunJoin_WorldDecode33.returned r)
PV_RJ4IDB.returned_divergence {W C A V : Type} (decode : Aeneas.Std.Result (A × W) → V)
  (l r : R1Z.PV_W_Threading.Run W C Aeneas.Std.Error A) (hl : l.outcome = R1Z.PV_W_Threading.Outcome.div)
  (hr : r.outcome = R1Z.PV_W_Threading.Outcome.div) :
  decode (R1Z.PV_RunJoin_WorldDecode33.returned l) = decode (R1Z.PV_RunJoin_WorldDecode33.returned r)
PV_RJ4IDB.trace_component_fibres {W A V : Type}
  (reachable : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A → Prop)
  (project : List PV_RJ4IDB.Event → V) :
  (R1Z.PV_RJDec_Factor.Fibres reachable fun r => project (List.map Prod.snd r.calls)) ↔
    (∀ (l r : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A) (a : A),
        reachable l →
          reachable r →
            l.outcome = R1Z.PV_W_Threading.Outcome.ok a →
              r.outcome = R1Z.PV_W_Threading.Outcome.ok a →
                l.world = r.world → project (List.map Prod.snd l.calls) = project (List.map Prod.snd r.calls)) ∧
      (∀ (l r : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A) (e : Aeneas.Std.Error),
          reachable l →
            reachable r →
              l.outcome = R1Z.PV_W_Threading.Outcome.fail e →
                r.outcome = R1Z.PV_W_Threading.Outcome.fail e →
                  project (List.map Prod.snd l.calls) = project (List.map Prod.snd r.calls)) ∧
        ∀ (l r : R1Z.PV_W_Threading.Run W PV_RJ4IDB.Event Aeneas.Std.Error A),
          reachable l →
            reachable r →
              l.outcome = R1Z.PV_W_Threading.Outcome.div →
                r.outcome = R1Z.PV_W_Threading.Outcome.div →
                  project (List.map Prod.snd l.calls) = project (List.map Prod.snd r.calls)
PV_RJ4IDB.disclosed_ok {A S T V : Type} (project : S → T) (decode : Aeneas.Std.Result (A × T) → V) (a : A) (s : S) :
  PV_RJ4IDB.pullResult (fun p => (p.1, project p.2)) decode (Aeneas.Std.Result.ok (a, s)) =
    decode (Aeneas.Std.Result.ok (a, project s))
PV_RJ4IDB.disclosed_fail {A S T V : Type} (project : S → T) (decode : Aeneas.Std.Result (A × T) → V)
  (e : Aeneas.Std.Error) :
  PV_RJ4IDB.pullResult (fun p => (p.1, project p.2)) decode (Aeneas.Std.Result.fail e) =
    decode (Aeneas.Std.Result.fail e)
PV_RJ4IDB.disclosed_div {A S T V : Type} (project : S → T) (decode : Aeneas.Std.Result (A × T) → V) :
  PV_RJ4IDB.pullResult (fun p => (p.1, project p.2)) decode Aeneas.Std.Result.div = decode Aeneas.Std.Result.div
PV_RJ4IDB.oracle_ok {A S T O : Type} (project : S → T) (decode : Aeneas.Std.Result (A × T) → O) (a : A) (s : S) :
  PV_RJ4IDB.pullResult (fun p => (p.1, project p.2)) decode (Aeneas.Std.Result.ok (a, s)) =
    decode (Aeneas.Std.Result.ok (a, project s))
PV_RJ4IDB.oracle_fail {A S T O : Type} (project : S → T) (decode : Aeneas.Std.Result (A × T) → O)
  (e : Aeneas.Std.Error) :
  PV_RJ4IDB.pullResult (fun p => (p.1, project p.2)) decode (Aeneas.Std.Result.fail e) =
    decode (Aeneas.Std.Result.fail e)
PV_RJ4IDB.oracle_div {A S T O : Type} (project : S → T) (decode : Aeneas.Std.Result (A × T) → O) :
  PV_RJ4IDB.pullResult (fun p => (p.1, project p.2)) decode Aeneas.Std.Result.div = decode Aeneas.Std.Result.div
