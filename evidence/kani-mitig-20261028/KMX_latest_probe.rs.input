#[kani::proof]
#[kani::unwind(8)]
fn KMX_latest_correct() {
    let mut input=[0u32;1];input[0]=512;
    let n:usize=kani::any();kani::assume(n==1);
    let mut level=[0u32;1];
    level[0..0+n].copy_from_slice(&input[..n]);
    assert_eq!(level[0],512);
}
#[kani::proof]
#[kani::unwind(8)]
fn KMX_latest_wrong() {
    let mut input=[0u32;1];input[0]=512;
    let n:usize=kani::any();kani::assume(n==1);
    let mut level=[0u32;1];
    level[0..0+n].copy_from_slice(&input[..n]);
    assert_eq!(level[0],0);
}
