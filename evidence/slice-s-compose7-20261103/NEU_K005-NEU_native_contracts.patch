+use super::*;
+struct Frame{ptr:*const u8,j:usize,before:u8,out:u8,calls:u8}
+fn output(bytes:&[u8],f:&mut Frame){assert!(bytes.len()==792);f.ptr=bytes.as_ptr();f.out=bytes[f.j];f.calls+=1;}
+fn suffix(encoded:[u8;792],f:&mut Frame)->ProgramResult{
+    if encoded.len() != POOL_V1_PAIR_FOREST_TERMINAL_RESULT_BYTES
+        || encoded[..4] != POOL_V1_PAIR_FOREST_TERMINAL_RESULT_MAGIC
+    {
+        return Err(ProgramError::InvalidInstructionData);
+    }
+    output(&encoded,f);
+    Ok(())
+}
+#[kani::proof]
+#[kani::stub(core::ptr::copy_nonoverlapping,crate::NEU_KMX::KMX_copy_nonoverlapping)]
+#[kani::stub(<[u8]>::copy_from_slice,crate::NEU_KMX::KMX_copy_from_slice)]
+fn suffix_slice(){let encoded:[u8;792]=kani::any();let j:usize=kani::any();kani::assume(j<792);let before:u8=kani::any();let mut f=Frame{ptr:core::ptr::null(),j,before,out:before,calls:0};let valid=encoded[0]==65&&encoded[1]==83&&encoded[2]==82&&encoded[3]==56;let r=suffix(encoded,&mut f);assert!(r==if valid{Ok(())}else{Err(ProgramError::InvalidInstructionData)});assert!(f.calls==if valid{1}else{0});assert!(f.out==if valid{encoded[j] }else{before});}
