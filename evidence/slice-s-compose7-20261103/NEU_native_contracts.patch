+use super::*;
+#[derive(Clone,Copy)] struct PublicView{asset_id:M31}
+#[derive(Clone,Copy)] enum PaymentView{PrivateTransfer(PublicView),Withdrawal(PublicView)}
+struct RequestView{public:PaymentView}
+struct IdentityView{asset_id:M31}
+struct MasterView{identity:IdentityView}
+struct LiveView{next_pair_index:u64}
+struct AuthView{master:MasterView,live_snapshot:LiveView}
+struct CandidateView{next_pair_index:u64}
+fn prefix(
+    request: &RequestView,
+    authenticated: &AuthView,
+    candidate_afterstate: &CandidateView,
+) -> ProgramResult {
+    if authenticated.live_snapshot.next_pair_index.checked_add(1)
+        != Some(candidate_afterstate.next_pair_index)
+    {
+        return Err(ProgramError::InvalidAccountData);
+    }
+    let requested_asset_id = match request.public {
+        PaymentView::PrivateTransfer(public) => public.asset_id,
+        PaymentView::Withdrawal(public) => public.asset_id,
+    };
+    if authenticated.master.identity.asset_id != requested_asset_id {
+        return Err(ProgramError::InvalidInstructionData);
+    }
+    Ok(())
+}
+
+#[kani::proof]
+fn reconstruction_slice(){let live:u64=kani::any();let next:u64=kani::any();let asset:u32=kani::any();let requested:u32=kani::any();let p=PublicView{asset_id:M31(requested)};let request=RequestView{public:if kani::any(){PaymentView::PrivateTransfer(p)}else{PaymentView::Withdrawal(p)}};let a=AuthView{master:MasterView{identity:IdentityView{asset_id:M31(asset)}},live_snapshot:LiveView{next_pair_index:live}};let c=CandidateView{next_pair_index:next};let expected=if live==u64::MAX||live.wrapping_add(1)!=next{Err(ProgramError::InvalidAccountData)}else if asset!=requested{Err(ProgramError::InvalidInstructionData)}else{Ok(())};assert!(prefix(&request,&a,&c)==expected);}
