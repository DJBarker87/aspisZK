+use super::*;
+fn prefix(length:usize,bytes:&[u8;8],bad_magic:bool)->Result<PoolV1TransitionKind,PoolV1PairForestTerminalFormatErrorV1> {
+    if length != POOL_V1_PAIR_FOREST_TERMINAL_REQUEST_BYTES {
+        return Err(PoolV1PairForestTerminalFormatErrorV1::WrongLength);
+    }
+    if bad_magic {
+        return Err(PoolV1PairForestTerminalFormatErrorV1::WrongMagic);
+    }
+    if bytes[4] != POOL_V1_PAIR_FOREST_TERMINAL_VERSION {
+        return Err(PoolV1PairForestTerminalFormatErrorV1::WrongVersion);
+    }
+    let kind = transition_kind(bytes[5])?;
+    if bytes[6] != POOL_V1_DIGEST_ENCODING_VERSION {
+        return Err(PoolV1PairForestTerminalFormatErrorV1::WrongDigestEncoding);
+    }
+    if bytes[7] != 0 {
+        return Err(PoolV1PairForestTerminalFormatErrorV1::NonZeroBinding);
+    }
+    Ok(kind)
+}
+fn reference(length:usize,b:&[u8;8],bad_magic:bool)->Result<PoolV1TransitionKind,PoolV1PairForestTerminalFormatErrorV1>{if length!=320{return Err(PoolV1PairForestTerminalFormatErrorV1::WrongLength)}if bad_magic{return Err(PoolV1PairForestTerminalFormatErrorV1::WrongMagic)}if b[4]!=1{return Err(PoolV1PairForestTerminalFormatErrorV1::WrongVersion)}let k=match b[5]{1=>PoolV1TransitionKind::PrivateTransfer,2=>PoolV1TransitionKind::Withdrawal,_=>return Err(PoolV1PairForestTerminalFormatErrorV1::InvalidTransitionKind)};if b[6]!=1{return Err(PoolV1PairForestTerminalFormatErrorV1::WrongDigestEncoding)}if b[7]!=0{return Err(PoolV1PairForestTerminalFormatErrorV1::NonZeroBinding)}Ok(k)}
+#[kani::proof]
+fn request_slice(){let bytes:[u8;8]=kani::any();let length:usize=kani::any();let bad_magic:bool=kani::any();assert!(prefix(length,&bytes,bad_magic)==reference(length,&bytes,bad_magic));}
