                                            (AspisR1.FIy_ValuePacked.rangeModel o s) 49 ↑j +
                                        AspisR1.FIx_SelectedMeaning.contribution
                                          (AspisR1.FIy_ValuePacked.conservation o s) 82 ↑j +
                                      AspisR1.FIx_SelectedMeaning.contribution
                                        (AspisR1.FIy_OccupancyMeaning.model (AspisR1.FIy_OccupancyPacked.input s)
                                          (AspisR1.FIy_OccupancyPacked.output s)
                                          (AspisR1.FIy_OccupancyRows.expected p.variant)
                                          (AspisR1.FIv_NativeArray.value o.z))
                                        0 ↑j +
                                    AspisR1.FIx_SelectedMeaning.contribution (AspisR1.FIy_PublicDigest.model p o s)
                                      ↑84#usize ↑j +
                                  AspisR1.FIx_SelectedMeaning.contribution (AspisR1.FIy_ScalarPacked.model p o s) 92
                                    ↑j =
                                AspisR1.FIy_NativeCoefficients.model p o s j)
                            (zero_add
                              (AspisR1.FIx_SelectedMeaning.contribution
                                (AspisR1.FIx_ScheduleModel.initial p.variant s o) 0 ↑j))))
                        (Eq.refl
                          (AspisR1.FIx_SelectedMeaning.contribution (AspisR1.FIx_ScheduleModel.initial p.variant s o) 0
                                          ↑j +
                                        AspisR1.FIx_SelectedMeaning.contribution
                                          (AspisR1.FIx_ScheduleModel.absorption p.variant s o) 16 ↑j +
                                      AspisR1.FIx_SelectedMeaning.contribution
                                        (AspisR1.FIx_PathMeaning.coefficients (AspisR1.FIx_PathPacked.selector s)
                                          (AspisR1.FIv_NativeArray.value o.z 0) (AspisR1.FIv_NativeArray.value o.z)
                                          (AspisR1.FIv_NativeArray.value o.succ_z))
                                        32 ↑j +
                                    AspisR1.FIx_SelectedMeaning.contribution (AspisR1.FIy_ValuePacked.rangeModel o s) 49
                                      ↑j +
                                  AspisR1.FIx_SelectedMeaning.contribution (AspisR1.FIy_ValuePacked.conservation o s) 82
                                    ↑j +
                                AspisR1.FIx_SelectedMeaning.contribution
                                  (AspisR1.FIy_OccupancyMeaning.model (AspisR1.FIy_OccupancyPacked.input s)
                                    (AspisR1.FIy_OccupancyPacked.output s)
                                    (AspisR1.FIy_OccupancyRows.expected p.variant) (AspisR1.FIv_NativeArray.value o.z))
                                  0 ↑j +
                              AspisR1.FIx_SelectedMeaning.contribution (AspisR1.FIy_PublicDigest.model p o s) ↑84#usize
                                ↑j +
                            AspisR1.FIx_SelectedMeaning.contribution (AspisR1.FIy_ScalarPacked.model p o s) 92
                              ↑j))))))))))⟩
theorem AspisR1.FIy_PartialRoot.on_run : ∀ (p : AspisR1.FIw_ScalarSuffix.Public)
  (claims : Aeneas.Std.Array AspisR1.FIv_NativeArithmetic.NQ 84#usize)
  (point : Aeneas.Std.Array AspisR1.FIv_NativeArithmetic.NQ 10#usize)
  (lambda chi theta comp g h active : AspisR1.FIv_NativeArithmetic.NQ)
  (c1 : Aeneas.Std.Array AspisR1.FIv_NativeArithmetic.NQ 16#usize)
  (mask : Aeneas.Std.Array AspisR1.FIv_NativeArithmetic.NQ 10#usize),
  AspisR1.FIw_ArrayValue.canonical claims →
    (∀ x ∈ ↑p.anchor, ↑x < AspisR1.FIw_ScalarArithmetic.P) →
      (∀ x ∈ ↑p.nullifier, ↑x < AspisR1.FIw_ScalarArithmetic.P) →
        (∀ (recipient : Aeneas.Std.Array FIq_Native.field.M31 8#usize),
            p.recipient = some recipient → ∀ x ∈ ↑recipient, ↑x < AspisR1.FIw_ScalarArithmetic.P) →
          (∀ x ∈ ↑p.change, ↑x < AspisR1.FIw_ScalarArithmetic.P) →
            (∀ row ∈ ↑p.transition.live_snapshot.frontier, ∀ x ∈ ↑row, ↑x < AspisR1.FIw_ScalarArithmetic.P) →
              (∀ x ∈ ↑p.transition.candidate_afterstate.next_root, ↑x < AspisR1.FIw_ScalarArithmetic.P) →
                (∀ row ∈ ↑p.transition.candidate_afterstate.next_frontier,
                    ∀ x ∈ ↑row, ↑x < AspisR1.FIw_ScalarArithmetic.P) →
                  ↑p.asset_id < AspisR1.FIw_ScalarArithmetic.P →
                    ↑(p.withdrawal_amount.getD 0#u32) < AspisR1.FIw_ScalarArithmetic.P →
                      FIq_Native.pool_v1.pair_forest_semantic_terminal.composition_parts p claims point lambda chi
                            theta =
                          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (comp, c1, mask, g, h, active)) →
                        ∃ a a1 a2 s semantic,
                          c1 = a ∧
                            AspisR1.FIw_ArrayValue.canonical a ∧
                              AspisR1.FIw_ArrayValue.canonical a1 ∧
                                AspisR1.FIw_ArrayValue.canonical a2 ∧
                                  FIq_Native.pool_v1.pair_forest_copy_terminal.Selectors.boxed_at_point point =
                                      Aeneas.Std.Result.ok s ∧
                                    FIq_Native.pool_v1.pair_forest_semantic_terminal.semantic_packed p
                                          { z := a, succ_z := a1, xor12_z := a2 } s =
                                        Aeneas.Std.Result.ok semantic ∧
                                      (AspisR1.FIw_ArrayValue.canonical s.high →
                                        AspisR1.FIw_ArrayValue.canonical s.low →
                                          AspisR1.FIw_ArrayValue.canonical semantic ∧
                                            AspisR1.FIw_ArrayValue.decoded semantic =
                                              AspisR1.FIy_NativeCoefficients.model p
                                                { z := a, succ_z := a1, xor12_z := a2 } s) :=
fun p claims point lambda chi theta comp g h active c1 mask hclaims ha hn hr hc hf hnr hnf hab haw success =>
  let ⟨a, h✝⟩ := AspisR1.FIw_CompositionOrigins.reached p claims point lambda chi theta comp g h active c1 mask success
  let ⟨a1, h✝¹⟩ := h✝
  let ⟨a2, h✝²⟩ := h✝¹
  let ⟨s, h✝³⟩ := h✝²
  let ⟨sops, h✝⁴⟩ := h✝³
  let ⟨variant, h✝⁵⟩ := h✝⁴
  let ⟨semantic, h✝⁶⟩ := h✝⁵
  let ⟨poseidon, h✝⁷⟩ := h✝⁶
  let ⟨prepared, h✝⁸⟩ := h✝⁷
  let ⟨middle, h✝⁹⟩ := h✝⁸
  let ⟨copy, h✝¹⁰⟩ := h✝⁹
  let ⟨iter, h✝¹¹⟩ := h✝¹⁰
  let ⟨iter1, h✝¹²⟩ := h✝¹¹
  let ⟨same, right✝⟩ := h✝¹²
  let ⟨ga, right✝¹⟩ := right✝
  let ⟨ga1, right✝²⟩ := right✝¹
  let ⟨ga2, right✝³⟩ := right✝²
  let ⟨hs, right✝⁴⟩ := right✝³
  let ⟨hsp, right✝⁵⟩ := right✝⁴
  let ⟨hp, right✝⁶⟩ := right✝⁵
  let ⟨hsem, right✝⁷⟩ := right✝⁶
  let ⟨hv, right✝⁸⟩ := right✝⁷
  let ⟨hcopy, right✝⁹⟩ := right✝⁸
  let ⟨hprep, right✝¹⁰⟩ := right✝⁹
  let ⟨hi, right✝¹¹⟩ := right✝¹⁰
  let ⟨hi1, right✝¹²⟩ := right✝¹¹
  let ⟨hmid, right✝¹³⟩ := right✝¹²
  let ⟨hfinal, hactive⟩ := right✝¹³
  have ca := AspisR1.FIw_OpeningCanonical.z claims a hclaims ga;
  have ca1 := AspisR1.FIw_OpeningCanonical.succ claims a1 hclaims ga1;
  have ca2 := AspisR1.FIw_OpeningCanonical.xor12 claims a2 hclaims ga2;
  Exists.intro a
    (Exists.intro a1
      (Exists.intro a2
        (Exists.intro s
          (Exists.intro semantic
            ⟨same,
              ⟨ca,
                ⟨ca1,
                  ⟨ca2,
                    ⟨hs,
                      ⟨hsem, fun hh hl =>
                        AspisR1.FIy_NativeCoefficients.value p { z := a, succ_z := a1, xor12_z := a2 } s semantic ca ca1
                          ca2 hh hl ha hn hr hc hf hnr hnf hab haw hsem⟩⟩⟩⟩⟩⟩))))
