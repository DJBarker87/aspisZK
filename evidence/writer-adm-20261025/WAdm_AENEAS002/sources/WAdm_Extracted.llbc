mment":" `AspisV8R19/SamplerFieldDecode.lean:decode4` (line 10)."},{"DocComment":" `WideTower.lean:qm31_wideU_not_isSquare` supplies the mathematical"},{"DocComment":" non-residue fact; `wideExact_card` gives `|E| = P^8`."},{"DocComment":" These references specify the arithmetic; they do not prove this Rust code."},{"DocComment":""},{"DocComment":" Coordinates are private to preserve canonicality. Algebraic constructors"},{"DocComment":" reduce raw QM31 representatives; wire/digit decoders reject noncanonical"},{"DocComment":" input. All operations are total except inversion, which returns `None` at"},{"DocComment":" zero. This reference implementation makes no constant-time claim."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":14,"beg":{"line":29,"col":4},"end":{"line":29,"col":12}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"c0","ty":{"Deduplicated":917}},{"span":{"data":{"file_id":14,"beg":{"line":30,"col":4},"end":{"line":30,"col":12}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"c1","ty":{"Deduplicated":917}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":32,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,16],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":9,"item_meta":{"name":[{"Ident":["aspis_core",0]},{"Ident":["field",0]},{"Ident":["QM31",0]}],"span":{"data":{"file_id":15,"beg":{"line":432,"col":0},"end":{"line":432,"col":15}},"generated_from_span":null},"source_text":null,"attr_info":{"attrib