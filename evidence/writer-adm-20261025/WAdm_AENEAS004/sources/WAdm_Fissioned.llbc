{"charon_version":"0.1.223","translated":{"crate_name":"wadm_native_fixture","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::WAdm_model::WAdm_checkpoint","crate::WAdm_model::WAdm_fields"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["crate::WAdm_model::WAdm_checkpoint","crate::WAdm_model::WAdm_fields","crate::WAdm_model::WAdm_roots","crate::WAdm_model::WAdm_early","crate::WAdm_model::WAdm_tail","crate::WAdm_model::WAdm_putK","crate::WAdm_model::WAdm_queries","crate::WAdm_model::WAdm_semantic","crate::WAdm_model::WAdm_coordinates","crate::WAdm_model::WAdm_weights","crate::WAdm_model::WAdm_Fields","aspis_r1_cost_probe::verifier::Prepared","aspis_r1_cost_probe::transport::Variant","aspis_core::field::M31","aspis_core::field::CM31","aspis_core::field::QM31","aspis_core::field::wide_exact::WideExact","aspis_core::circle::SecureCirclePoint"],"opaque":["crate","aspis_core","aspis_statement"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":"Initializers","unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-writer-adm-20261025/WAdm_Fissioned.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"WAdm_model.rs"},"crate_name":"wadm_native_fixture","contents":"#![allow(non_snake_case, non_camel_case_types)]\nuse aspis_core::{Digest32, field::{QM31 as K, WideExact as E}};\nuse aspis_r1_cost_probe::verifier::Prepared;\n\npub struct WAdm_Fields {\n    pub roots: [[u8; 32]; 2], pub state: [u8; 32], pub early: [E; 4],\n    pub rho: K, pub queries: [u32; 22], pub semantic: [K; 10], pub coordinates: [K; 4],\n    pub tail: [E; 2], pub power: K,\n}\npub fn WAdm_fields(p: &Prepared, rhs: E, power: K) -> WAdm_Fields {\n    WAdm_Fields { roots: p.roots, state: p.state, early: [p.gamma, p.kappa, p.alpha[0], p.alpha[1]],\n        rho: p.rho, queries: p.queries, semantic: p.semantic_alpha,\n        coordinates: [p.z[0].x, p.z[0].y, p.z[1].x, p.z[1].y], tail: [p.claim, rhs], power }\n}\n#[inline(never)]\npub fn WAdm_roots(mut out: Vec<u8>, roots: [[u8; 32]; 2]) -> Vec<u8> {\n    for root in roots { out.extend_from_slice(&root); } out\n}\n#[inline(never)]\npub fn WAdm_early(mut out: Vec<u8>, xs: [E; 4]) -> Vec<u8> {\n    for x in xs { out.extend_from_slice(&x.to_le_bytes()); } out\n}\n#[inline(never)]\npub fn WAdm_tail(mut out: Vec<u8>, xs: [E; 2]) -> Vec<u8> {\n    for x in xs { out.extend_from_slice(&x.to_le_bytes()); } out\n}\n#[inline(never)]\npub fn WAdm_putK(mut out: Vec<u8>, x: K) -> Vec<u8> {\n    let mut b = [0; 16]; x.write_le_bytes(&mut b); out.extend_from_slice(&b); out\n}\n#[inline(never)]\npub fn WAdm_queries(mut out: Vec<u8>, xs: [u32; 22]) -> Vec<u8> {\n    for x in xs { out.extend_from_slice(&x.to_le_bytes()); } out\n}\n#[inline(never)]\npub fn WAdm_semantic(mut out: Vec<u8>, xs: [K; 10]) -> Vec<u8> {\n    for x in xs { out = WAdm_putK(out, x); } out\n}\n#[inline(never)]\npub fn WAdm_coordinates(mut out: Vec<u8>, xs: [K; 4]) -> Vec<u8> {\n    for x in xs { out = WAdm_putK(out, x); } out\n}\n#[inline(never)]\npub fn WAdm_weights(mut out: Vec<u8>, xs: Vec<K>) -> Vec<u8> {\n    for x in xs { out = WAdm_putK(out, x); } out\n}\n// Bounded source model only: S2 / next10 / weights64 are established on the\n// same accepted run before native substitution, never inferred from this model.\n#[inline(never)]\npub fn WAdm_checkpoint<H: Digest32>(f: WAdm_Fields, weights: Vec<K>, proof: &[u8], public: &[u8], hash: H) -> Vec<u8> {\n    assert_eq!(weights.len(), 64);\n    let mut out = Vec::with_capacity(1768);\n    out.extend_from_slice(b\"R1P2CKP2\"); out.extend_from_slice(&[2, 10, 1, 0, 0, 0, 0, 0]);\n    out.extend_from_slice(&hash.digest(&[proof])); out.extend_from_slice(&hash.digest(&[public]));\n    out.extend_from_slice(&f.state);\n    out = WAdm_roots(out, f.roots); out = WAdm_early(out, f.early); out = WAdm_putK(out, f.rho);\n    out = WAdm_queries(out, f.queries); out = WAdm_semantic(out, f.semantic);\n    out = WAdm_coordinates(out, f.coordinates); out = WAdm_tail(out, f.tail); out = WAdm_putK(out, f.power);\n    out = WAdm_weights(out, weights);\n    let sum = hash.digest(&[b\"UNPROVED:R1:checkpoint\", &out]); out.extend_from_slice(&sum);\n    assert_eq!(out.len(), 1768); out\n}\n\n#[cfg(kani)]\nmod WAdm_proofs {\n    use super::*;\n    use aspis_core::{field::{M31, CM31}, circle::SecureCirclePoint};\n    use aspis_r1_cost_probe::{verifier::{self, Prepared, Accumulator}, transport::Variant};\n    use core::cell::Cell;\n    fn WAdm_anyK() -> K {\n        let x: [u32; 4] = kani::any();\n        K { c0: CM31 { a: M31(x[0]), b: M31(x[1]) }, c1: CM31 { a: M31(x[2]), b: M31(x[3]) } }\n    }\n    fn WAdm_anyE() -> E {\n        let x: [u32; 8] = kani::any(); for limb in x { kani::assume(limb < 0x7fffffff); }\n        E::from_limbs(x).unwrap()\n    }\n    #[derive(Clone, Copy)]\n    struct WAdm_Hash<'a> { step: &'a Cell<usize>, answers: [[u8; 32]; 3], proof: &'a [u8], public: &'a [u8],\n        index: usize, native_body: &'a Cell<u8>, model: bool }\n    impl Digest32 for WAdm_Hash<'_> {\n        fn digest(&self, parts: &[&[u8]]) -> [u8; 32] {\n            let n = self.step.get(); assert!(n < 3);\n            if n < 2 {\n                assert_eq!(parts.len(), 1); let expected = if n == 0 { self.proof } else { self.public };\n                assert_eq!(parts[0].as_ptr(), expected.as_ptr()); assert_eq!(parts[0].len(), expected.len());\n            } else {\n                assert_eq!(parts.len(), 2); assert_eq!(parts[0], b\"UNPROVED:R1:checkpoint\"); assert_eq!(parts[1].len(), 1736);\n                if self.model { assert_eq!(parts[1][self.index], self.native_body.get()); }\n                else { self.native_body.set(parts[1][self.index]); }\n            }\n            self.step.set(n + 1); self.answers[n]\n        }\n    }\n    #[kani::proof]\n    #[kani::unwind(70)]\n    fn WAdm_native_matches_fissioned_source() {\n        let p = Prepared { variant: Variant::S2, roots: kani::any(), state: kani::any(),\n            gamma: WAdm_anyE(), kappa: WAdm_anyE(), alpha: [WAdm_anyE(), WAdm_anyE()], rho: WAdm_anyK(),\n            queries: kani::any(), semantic_alpha: core::array::from_fn(|_| WAdm_anyK()),\n            z: core::array::from_fn(|_| SecureCirclePoint { x: WAdm_anyK(), y: WAdm_anyK() }), claim: WAdm_anyE() };\n        let a = Accumulator { weights: (0..64).map(|_| WAdm_anyK()).collect(), rhs: WAdm_anyE(), power: WAdm_anyK(), next: 10 };\n        let proof: [u8; 57607] = kani::any(); let public: [u8; 1880] = kani::any(); let answers = kani::any();\n        let i: usize = kani::any(); kani::assume(i < 1736); let j: usize = kani::any(); kani::assume(j < 1768);\n        let step = Cell::new(0); let native_body = Cell::new(0);\n        let hash = WAdm_Hash { step: &step, answers, proof: &proof, public: &public, index: i, native_body: &native_body, model: false };\n        let got = verifier::checkpoint(&p, &a, &proof, &public, hash); assert_eq!(step.get(), 3); step.set(0);\n        let want = WAdm_checkpoint(WAdm_fields(&p, a.rhs, a.power), a.weights.clone(), &proof, &public, WAdm_Hash { model: true, ..hash });\n        assert_eq!(step.get(), 3); assert_eq!(got.len(), 1768); assert_eq!(want.len(), 1768); assert_eq!(got[j], want[j]);\n    }\n}\n"},{"id":1,"name":{"Local":"WAdm_lib.rs"},"crate_name":"wadm_native_fixture","contents":"#[path = \"WAdm_model.rs\"]\npub mod WAdm_model;\n#[cfg(test)]\n#[allow(non_snake_case)]\nmod WAdm_tests {\n    use aspis_core::{Digest32, field::{QM31 as K, WideExact as E}, circle::SecureCirclePoint};\n    use aspis_r1_cost_probe::{verifier::{self, Prepared, Accumulator}, transport::Variant};\n    use core::cell::Cell;\n    #[derive(Clone, Copy)]\n    struct WAdm_Hash<'a> { step: &'a Cell<usize>, proof: &'a [u8], public: &'a [u8] }\n    impl Digest32 for WAdm_Hash<'_> {\n        fn digest(&self, parts: &[&[u8]]) -> [u8; 32] {\n            let n = self.step.get();\n            match n {\n                0 | 1 => {\n                    assert_eq!(parts.len(), 1);\n                    let expected = if n == 0 { self.proof } else { self.public };\n                    assert_eq!(parts[0].as_ptr(), expected.as_ptr());\n                    assert_eq!(parts[0].len(), expected.len());\n                },\n                2 => {\n                    assert_eq!(parts.len(), 2);\n                    assert_eq!(parts[0], b\"UNPROVED:R1:checkpoint\");\n                    assert_eq!(parts[1].len(), 1736);\n                    assert_eq!(&parts[1][..16], b\"R1P2CKP2\\x02\\x0a\\x01\\x00\\x00\\x00\\x00\\x00\");\n                    assert_eq!(&parts[1][16..48], &[0x41; 32]);\n                    assert_eq!(&parts[1][48..80], &[0x42; 32]);\n                    assert!(parts[1][80..].iter().all(|b| *b == 0));\n                },\n                _ => panic!(\"unexpected digest call\"),\n            }\n            self.step.set(n + 1);\n            [0x41 + n as u8; 32]\n        }\n    }\n    #[test]\n    fn WAdm_shipped_writer_domain_nonempty() {\n        let p = Prepared { variant: Variant::S2, roots: [[0; 32]; 2], gamma: E::ZERO,\n            kappa: E::ZERO, alpha: [E::ZERO; 2], rho: K::ZERO, queries: [0; 22],\n            semantic_alpha: [K::ZERO; 10], z: [SecureCirclePoint { x: K::ZERO, y: K::ZERO }; 2],\n            claim: E::ZERO, state: [0; 32] };\n        let a = Accumulator { weights: vec![K::ZERO; 64], rhs: E::ZERO, power: K::ZERO, next: 10 };\n        let proof = [0; 57607]; let public = [0; 1880]; let step = Cell::new(0);\n        let saved = verifier::checkpoint(&p, &a, &proof, &public, WAdm_Hash { step: &step, proof: &proof, public: &public });\n        assert_eq!(saved.len(), 1768); assert_eq!(step.get(), 3);\n        assert_eq!(&saved[1736..], &[0x43; 32]);\n    }\n}\n"},{"id":2,"name":{"Local":"/home/dombarker/project-offloads/codex-cx-writer-adm-20261025/src/crates/aspis-core/src/digest.rs"},"crate_name":"aspis_core","contents":null},{"id":3,"name":{"Local":"/home/dombarker/project-offloads/codex-cx-writer-adm-20261025/src/crates/aspis-core/src/lib.rs"},"crate_name":"aspis_core","contents":null},{"id":4,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":5,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":6,"name":{"Local":"/home/dombarker/project-offloads/codex-cx-writer-adm-20261025/src/crates/aspis-core/src/field.rs"},"crate_name":"aspis_core","contents":null},{"id":7,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/macros/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/panicking.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/fmt/mod.rs"},"