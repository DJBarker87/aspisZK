theorem AspisR1.S2W_EntryWriteHistory.entry_write_history : ∀ {W F : Type} (L : AspisR1.S2Trust.Library W F),
  AspisR1.S2Trust.S2TrustedSdkBorrow L →
    ∀ (encode : UInt8 → AspisV8R19.DuplexFrames.Byte) (savedState entryState : AspisR1.S2Trust.Heap F) (w : W)
      (writer reader writeToken writeOwner readToken readOwner : ℕ) (src : AspisR1.S2Trust.Payload),
      savedState.guards = [] →
        savedState.counter (savedState.accounts writer).1 = 0 →
          (savedState.payload (savedState.accounts writer).1).descriptor.length = 1768 →
            ∀ (keys : ℕ → List UInt8) (n : ℕ),
              AspisR1.AdapterRw.RuntimeEntrypointAdmission entryState keys n →
                reader < n →
                  L.related w entryState →
                    ∀
                      (version :
                        AspisR1.S2X.CheckpointVersionBinding
                          (AspisR1.S2W_EntryWriteHistory.payloadBytes encode
                            ((AspisR1.S2W_WrapperLaws.writeBracket savedState writer writeToken writeOwner src).payload
                              (savedState.accounts writer).1)
                            1768)
                          (AspisR1.S2W_EntryWriteHistory.payloadBytes encode
                            (entryState.payload (entryState.accounts reader).1) 1768)),
                      AspisR1.S2W_EntryWriteHistory.payloadBytes encode
                            (entryState.payload (entryState.accounts reader).1) 1768 =
                          AspisR1.S2W_EntryWriteHistory.payloadBytes encode src 1768 ∧
                        List.length (AspisR1.S2W_EntryWriteHistory.payloadBytes encode src 1768) = 1768 ∧
                          ∃ acquired read done,
                            L.run w (AspisR1.S2Trust.Op.shared reader readToken readOwner) =
                                (acquired, AspisR1.S2Trust.Reply.guard readToken) ∧
                              L.run acquired (AspisR1.S2Trust.Op.deref readToken) =
                                  (read,
                                    AspisR1.S2Trust.Reply.payload (entryState.payload (entryState.accounts reader).1)) ∧
                                L.run read (AspisR1.S2Trust.Op.drop readToken) = (done, AspisR1.S2Trust.Reply.unit) ∧
                                  L.related done entryState :=
fun {W F} L trust encode savedState entryState w writer reader writeToken writeOwner readToken readOwner src empty zero
    length keys n entry within related version =>
  ⟨Eq.trans
      (AspisR1.S2X.checkpoint_persistence
        (AspisR1.S2W_EntryWriteHistory.payloadBytes encode
          ((AspisR1.S2W_WrapperLaws.writeBracket savedState writer writeToken writeOwner src).payload
            (savedState.accounts writer).1)
          1768)
        (AspisR1.S2W_EntryWriteHistory.payloadBytes encode (entryState.payload (entryState.accounts reader).1) 1768)
        version)
      (AspisR1.S2W_EntryWriteHistory.written_bytes encode savedState writer writeToken writeOwner src empty zero
        length),
    ⟨List.length_ofFn,
      AspisR1.S2W_WrapperLaws.native_snapshot_protocol L trust w entryState keys n reader readToken readOwner entry
        within related⟩⟩
theorem AspisR1.S2W_WrapperLaws.native_snapshot_protocol : ∀ {W F : Type} (L : AspisR1.S2Trust.Library W F),
  AspisR1.S2Trust.S2TrustedSdkBorrow L →
    ∀ (w : W) (s : AspisR1.S2Trust.Heap F) (keys : ℕ → List UInt8) (n a t o : ℕ),
      AspisR1.AdapterRw.RuntimeEntrypointAdmission s keys n →
        a < n →
          L.related w s →
            ∃ acquired read done,
              L.run w (AspisR1.S2Trust.Op.shared a t o) = (acquired, AspisR1.S2Trust.Reply.guard t) ∧
                L.run acquired (AspisR1.S2Trust.Op.deref t) =
                    (read, AspisR1.S2Trust.Reply.payload (s.payload (s.accounts a).1)) ∧
                  L.run read (AspisR1.S2Trust.Op.drop t) = (done, AspisR1.S2Trust.Reply.unit) ∧ L.related done s :=
fun {W F} L trust w s keys n a t o runtime within related =>
  let ⟨acquired, h✝⟩ := AspisR1.AdapterRw.Snapshots.native_entry_shared L trust w s keys n a t o runtime within related
  let ⟨first, related1⟩ := h✝
  let ⟨read, h✝¹⟩ :=
    AspisR1.AdapterRw.Snapshots.native_entry_read L trust acquired s keys n a t o runtime within related1
  let ⟨second, related2⟩ := h✝¹
  let ⟨done, h✝²⟩ := AspisR1.AdapterRw.Snapshots.native_entry_drop L trust read s keys n a t o runtime within related2
  let ⟨third, related3⟩ := h✝²
  Exists.intro acquired (Exists.intro read (Exists.intro done ⟨first, ⟨second, ⟨third, related3⟩⟩⟩))
theorem AspisR1.S2W_WrapperLaws.trusted_write_protocol : ∀ {F : Type}
  (copy : AspisR1.S2Trust.Heap F → ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome F),
  AspisR1.S2W_TrustedStd.TrustedStd copy →
    ∀ (s : AspisR1.S2Trust.Heap F) (a t o : ℕ) (src : AspisR1.S2Trust.Payload),
      s.guards = [] →
        s.counter (s.accounts a).1 = 0 →
          (s.payload (s.accounts a).1).descriptor.length = src.descriptor.length →
            ∃ written,
              copy (AspisR1.S2Trust.acquire s (s.accounts a).1 t o AspisR1.S2Trust.Kind.exclusive) (s.accounts a).1
                    src =
                  AspisR1.S2W_TrustedStd.Outcome.returned written ∧
                AspisR1.S2Trust.release written (AspisR1.S2W_WrapperLaws.exclusiveGuard s a t o) =
                  AspisR1.S2W_TrustedStd.copyHeap s (s.accounts a).1 src :=
fun {F} copy std s a t o src empty zero lengths =>
  Exists.intro
    (AspisR1.S2W_TrustedStd.copyHeap (AspisR1.S2Trust.acquire s (s.accounts a).1 t o AspisR1.S2Trust.Kind.exclusive)
      (s.accounts a).1 src)
    ⟨AspisR1.S2W_TrustedStd.accepted_copy copy std
        (AspisR1.S2Trust.acquire s (s.accounts a).1 t o AspisR1.S2Trust.Kind.exclusive) (s.accounts a).1 src lengths,
      AspisR1.S2W_WrapperLaws.write_bracket s a t o src empty zero⟩
