def Aeneas.Std.alloc.vec.into_iter.IteratorIntoIter.next : {T : Type} →
  alloc.vec.into_iter.IntoIter T → Result (Option T × alloc.vec.into_iter.IntoIter T) :=
fun {T} it =>
  match it with
  | ⟨[], property⟩ => ok (none, it)
