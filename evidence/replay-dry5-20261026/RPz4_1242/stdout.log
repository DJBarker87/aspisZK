theorem AspisR1.S2W_D188Consolidation.accepted_run : ∀ {E : Type} (ops : AdapterRw.Ops)
  (native1 : S2W_ExtractionBoundary.First) (native2 : S2W_ExtractionBoundary.Second)
  (hashv : S2Z.Oracle.Parts → Result S2Z.Oracle.Digest),
  S2W_DigestExtraction.AeneasExtraction ops native1 native2 hashv →
    ∀ (sha256 H : Bytes → State),
      S2W_ExtractionBoundary.P1 sha256 H →
        S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
          ∀ (program : S2W_ExtractionBoundary.Program) (accounts1 accounts2 : S2W_ExtractionBoundary.Accounts)
            (data1 data2 : Slice U8) (slot : S2W_ExtractionBoundary.Slot) (saved : alloc.vec.Vec U8),
            native1 program accounts1 data1 = ok (core.result.Result.Ok saved) →
              native2 program accounts2 data2 slot = ok (core.result.Result.Ok ()) →
                ∃ f s firstLog finalLog suffix,
                  SourceCuts ops accounts1 accounts2 saved f s ∧
                    S2W_Trace.run ops (S2W_Outer.stage1_owned ops S2W_Outer.traceEffects program accounts1 data1) [] =
                        ok (core.result.Result.Ok saved, firstLog) ∧
                      S2W_Trace.run ops (S2W_Outer.stage2_owned ops S2W_Outer.traceEffects program accounts2 data2 slot)
                            firstLog =
                          ok (core.result.Result.Ok (), finalLog) ∧
                        S2W_Trace.run ops (S2W_Observation.two ops program accounts1 data1 accounts2 data2 slot) [] =
                            ok (core.result.Result.Ok saved, finalLog) ∧
                          finalLog = firstLog ++ suffix ∧
                            (∀ event ∈ finalLog, S2W_TraceFacts.ValidEvent ops event) ∧
                              ∀ (decode : HeaderDecode) (nodes : ℕ → ℕ → Slice U8) (y1 : Slice U8),
                                CheckpointWriterConeJoin ops decode H f.semantic f.pub f.proof f.split →
                                  CheckpointReaderConeJoin ops decode H s.pub s.proof s.checkpoint →
                                    ∀ (a : CheckpointVersionBinding (bytesOf ↑saved) (bytesOf ↑s.checkpoint)),
                                      P2Prime H f.proof f.pub s.proof s.pub →
                                        S2W_ChildJoins.FirstEntryVerifierConeJoin f.proof →
                                          S2W_ChildJoins.MultiproofConeJoin f.proof s.proof nodes →
                                            S2W_ChildJoins.S8StageConeJoin f.proof y1 →
                                              ∀
                                                (firstExecution :
                                                  ChildExecution E
                                                    (core.result.Result (alloc.vec.Vec U8) AdapterRw.Cuts.PE))
                                                (secondExecution :
                                                  ChildExecution E
                                                    (core.result.Result Unit
                                                      AdapterRw.aspis_r1_cost_probe.verifier.Error))
                                                (fs : S2W_SiteSchedule.FirstSegments E)
                                                (ss : S2W_SiteSchedule.SecondSegments E),
                                                FirstEntryEventConeJoin ops f firstExecution fs →
                                                  SecondEntryEventConeJoin ops s secondExecution ss →
                                                    ∀ (pre middle : List (S2W_SiteSchedule.Event E))
                                                      (before after :
                                                        S2LeadInterface.Site → ℕ → S2LeadInterface.Account),
                                                      ∃ parsed firstEvents secondEvents,
                                                        firstExecution = ok (core.result.Result.Ok saved, firstEvents) ∧
                                                          secondExecution =
                                                              ok (core.result.Result.Ok (), secondEvents) ∧
                                                            ⋯ ∧ ⋯ :=
fun {E} ops native1 native2 hashv extraction sha256 H p1 runtime program accounts1 accounts2 data1 data2 slot saved
    accepted1 accepted2 =>
  let boundary := S2W_DigestExtraction.sourceBoundary ops native1 native2 hashv extraction;
  let ⟨f, h✝⟩ :=
    accepted_native_observed_inputs ops native1 native2 hashv boundary sha256 H p1 runtime program accounts1 accounts2
      data1 data2 slot saved accepted1 accepted2
  let ⟨s, h✝¹⟩ := h✝
  let ⟨cuts, project⟩ := h✝¹
  let ⟨firstLog, h✝²⟩ :=
    S2W_ExtractionBoundary.accepted_native_observation ops native1 native2 hashv boundary program accounts1 accounts2
      data1 data2 slot saved accepted1 accepted2
  let ⟨finalLog, h✝³⟩ := h✝²
  let ⟨suffix, h✝⁴⟩ := h✝³
  let ⟨first, right✝⟩ := h✝⁴
  let ⟨second, right✝¹⟩ := right✝
  let ⟨both, right✝²⟩ := right✝¹
  let ⟨extension, valid⟩ := right✝²
  Exists.intro f
    (Exists.intro s
      (Exists.intro firstLog
        (Exists.intro finalLog (Exists.intro suffix ⟨cuts, ⟨first, ⟨second, ⟨both, ⟨extension, ⟨valid, project⟩⟩⟩⟩⟩⟩))))
