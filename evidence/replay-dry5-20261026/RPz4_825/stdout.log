def Aeneas.Std.core.num.U32.to_le_bytes : U32 → Std.Array U8 4#usize :=
fun x => ⟨List.map UScalar.mk x.bv.toLEBytes, ⋯⟩
def Aeneas.Std.core.slice.Slice.copy_from_slice : {T : Type} →
  core.marker.Copy T → Slice T → Slice T → Result (Slice T) :=
fun {T} x s src => if s.len = src.len then ok src else fail Error.panic
def Aeneas.Std.Array.to_slice_mut.{u} : {α : Type u} →
  {n : Usize} → Std.Array α n → Slice α × (Slice α → Std.Array α n) :=
fun {α} {n} a => (a.to_slice, a.from_slice)
