'AspisR1.SCE_PairAccepted.accepted_pair' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.SCE_PairAccepted.accepted_pair : ∀ {W A M Cv F CoreError : Type} {N : ℕ} (L : Library W (ℕ → Record)),
  S2TrustedSdkBorrow L →
    ∀ (copy : Heap (ℕ → Record) → ℕ → Payload → Outcome (ℕ → Record)),
      TrustedStd copy →
        ∀ (allocator : Allocator A) (adapterOps : AdapterRw.Ops) (ops : Ops) (reserved : Bool)
          (queryOps : Port3_NativeQueryBody.Ops) (geoOps : Port3_NativeGeometryBody.Ops CoreError)
          (stageBase : VTop_Stages.Ops) (finishOps : AspisR1Stage2.Stage2Finish.FinishOps F)
          (B : AspisR1PublicPreparation.FinishModel.Boundaries) (claimsStd : ClaimsUnrolledFinish.StdCalls)
          (native1 : S2W_ExtractionBoundary.First) (native2 : S2W_ExtractionBoundary.Second)
          (hashv : S2Z.Oracle.Parts → Result S2Z.Oracle.Digest),
          S2W_DigestExtraction.AeneasExtraction
              (sdkOps
                (Tx2I_Install.install adapterOps
                  (Op5T_Concrete.stage (Tx2N_Execution.control stageBase reserved queryOps geoOps)) finishOps)
                (Uni_Install.current ops reserved queryOps geoOps) B claimsStd)
              native1 native2 hashv →
            ∀ (experiment : SCE_Experiment.Adversary A) (sha256 H : Bytes → State),
              S2W_ExtractionBoundary.P1 sha256 H →
                S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
                  ∀ (program : S2W_ExtractionBoundary.Program) (saved : alloc.vec.Vec U8)
                    (post1 post2 : Heap (ℕ → Record)) (final1 final2 : A) (w1 w2 : W),
                    RuntimeEntrypointAdmission L (eval H experiment.first).2.entry w1 3 →
                      RuntimeEntrypointAdmission L
                          (eval H (experiment.second (eval H experiment.first).2 saved post1 final1)).2.entry w2 7 →
                        first native1 copy allocator (eval H experiment.first).2.entry program
                              (eval H experiment.first).2.data (eval H experiment.first).2.state =
                            ok (core.result.Result.Ok (saved, post1, final1)) →
                          second native2 allocator
                                (eval H (experiment.second (eval H experiment.first).2 saved post1 final1)).2.entry
                                program
                                (eval H (experiment.second (eval H experiment.first).2 saved post1 final1)).2.data
                                (eval H (experiment.second (eval H experiment.first).2 saved post1 final1)).2.slot
                                (eval H (experiment.second (eval H experiment.first).2 saved post1 final1)).2.state =
                              ok (core.result.Result.Ok (post2, final2)) →
                            ∀ (p : FS2.Duplex.Params M Cv N) (root : Std.Array U8 32#usize) (length : U32),
                              have port :=
                                SdkD_Child.port adapterOps (Uni_Install.current ops reserved queryOps geoOps)
                                  (Op5T_Concrete.stage (Tx2N_Execution.control stageBase reserved queryOps geoOps))
                                  finishOps B claimsStd;
                              ∃ f s outer pre middle fs ss,
                                SourceCuts
                                    (sdkOps
                                      (Tx2I_Install.install adapterOps
                                        (Op5T_Concrete.stage
                                          (Tx2N_Execution.control stageBase reserved queryOps geoOps))
                                        finishOps)
                                      (Uni_Install.current ops reserved queryOps geoOps) B claimsStd)
                                    (eval H experiment.first).2.entry.first
                                    ((eval H
                                              (experiment.second (eval H experiment.first).2 saved post1
                                                final1)).2.entry.second
                                      secondSizes)
                                    saved f s ∧
                                  ((SCE_Experiment.submitted (eval H experiment.first).2).publicBytes = bytesOf ↑f.pub ∧
                                      (SCE_Experiment.submitted (eval H experiment.first).2).stored =
                                        bytesOf ↑f.proof) ∧
                                    RawJ_RecordCuts.Recorded f s saved outer ∧
                                      (∀ (parsed : OraclePortCompactDraft.Parsed),
                                          OraclePortCompactDraft.parse (bytesOf ↑f.proof) = some parsed →
                                            ∀ (kind : Fin 3), ⋯) ∧
                                        eval H ⋯ =
                                            (⋯,
                                              ok
                                                (core.result.Result.Ok saved,
                                                  [GExq_OuterRecord.Event.first f.semantic f.pub f.proof f.split
                                                      (core.result.Result.Ok saved),
                                                    GExq_OuterRecord.Event.second s.pub s.proof s.checkpoint
                                                      (core.result.Result.Ok ())])) ∧
                                          ⋯ =
                                              (GExp_FixedPair.firstInput f, ok (core.result.Result.Ok saved),
                                                some (GExp_FixedPair.secondInput s, ok (core.result.Result.Ok ()))) ∧
                                            ⋯ ∧ ⋯ :=
fun {W A M Cv F CoreError} {N} L sdk copy std allocator adapterOps ops reserved queryOps geoOps stageBase finishOps B
    claimsStd native1 native2 hashv extraction experiment sha256 H p1 syscall program saved post1 post2 final1 final2 w1
    w2 admission1 admission2 accepted1 accepted2 p root length =>
  let ⟨f, h✝⟩ :=
    RawJ_FramedAccepted.accepted_pair_unified L sdk copy std allocator (eval H experiment.first).2.entry
      (eval H (experiment.second (eval H experiment.first).2 saved post1 final1)).2.entry w1 w2 admission1 admission2
      adapterOps ops reserved queryOps geoOps stageBase finishOps B claimsStd native1 native2 hashv extraction sha256 H
      p1 syscall program (eval H experiment.first).2.data
      (eval H (experiment.second (eval H experiment.first).2 saved post1 final1)).2.data
      (eval H (experiment.second (eval H experiment.first).2 saved post1 final1)).2.slot
      (eval H experiment.first).2.state
      (eval H (experiment.second (eval H experiment.first).2 saved post1 final1)).2.state final1 final2 saved post1
      post2 accepted1 accepted2 p root length
  let ⟨s, h✝¹⟩ := h✝
  let ⟨outer, h✝²⟩ := h✝¹
  let ⟨pre, h✝³⟩ := h✝²
  let ⟨middle, h✝⁴⟩ := h✝³
  let ⟨fs, h✝⁵⟩ := h✝⁴
  let ⟨ss, h✝⁶⟩ := h✝⁵
  let ⟨cuts, rest⟩ := h✝⁶
  Exists.intro f
    (Exists.intro s
      (Exists.intro outer
        (Exists.intro pre
          (Exists.intro middle
            (Exists.intro fs
              (Exists.intro ss
                ⟨cuts,
                  ⟨SCE_FirstCutBytes.submitted_cut (eval H experiment.first).2
                      (sdkOps
                        (Tx2I_Install.install adapterOps
                          (Op5T_Concrete.stage (Tx2N_Execution.control stageBase reserved queryOps geoOps)) finishOps)
                        (Uni_Install.current ops reserved queryOps geoOps) B claimsStd)
                      ((eval H (experiment.second (eval H experiment.first).2 saved post1 final1)).2.entry.second
                        secondSizes)
                      saved f s cuts,
                    rest⟩⟩))))))
