inductive Aeneas.Std.Error : Type
number of parameters: 0
constructors:
Aeneas.Std.Error.assertionFailure : Error
Aeneas.Std.Error.integerOverflow : Error
Aeneas.Std.Error.divisionByZero : Error
Aeneas.Std.Error.arrayOutOfBounds : Error
Aeneas.Std.Error.maximumSizeExceeded : Error
Aeneas.Std.Error.panic : Error
Aeneas.Std.Error.undef : Error
def Aeneas.Std.massert : (b : Prop) → [Decidable b] → Result Unit :=
fun b [Decidable b] => if b then ok () else fail Error.assertionFailure
def Aeneas.Std.Array.index_usize.{u} : {α : Type u} → {n : Usize} → Std.Array α n → Usize → Result α :=
fun {α} {n} v i =>
  match v[i]? with
  | none => fail Error.arrayOutOfBounds
  | some x => ok x
"Aeneas.Std.Error.assertionFailure"
"Aeneas.Std.Error.arrayOutOfBounds"
