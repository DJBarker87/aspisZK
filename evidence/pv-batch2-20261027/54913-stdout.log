def Aeneas.Std.UScalar.cast : {src_ty : Aeneas.Std.UScalarTy} →
  (tgt_ty : Aeneas.Std.UScalarTy) → Aeneas.Std.UScalar src_ty → Aeneas.Std.UScalar tgt_ty :=
fun {src_ty} tgt_ty x => BitVec.zeroExtend tgt_ty.numBits x.bv#uscalar
def Aeneas.Std.U32.wrapping_shl : Aeneas.Std.U32 → Aeneas.Std.U32 → Aeneas.Std.U32 :=
fun x s => Aeneas.Std.UScalar.wrapping_shl x s
def Aeneas.Std.core.num.U32.from_le_bytes : Aeneas.Std.Array Aeneas.Std.U8 4#usize → Aeneas.Std.U32 :=
fun a => BitVec.cast ⋯ (BitVec.fromLEBytes (List.map Aeneas.Std.U8.bv ↑a))#uscalar
