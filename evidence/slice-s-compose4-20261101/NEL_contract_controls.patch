+// Scratch fidelity probes only. No native implementation credit.
+use crate::pool_v1::PoolV1PaymentStatementFormatError as E;
+type Reply = Result<[u8;216],E>;
+impl kani::Arbitrary for E {
+ fn any()->Self {match kani::any::<u8>() {
+  0=>E::WrongLength,1=>E::WrongMagic,2=>E::WrongVersion,
+  3=>E::WrongTransitionKind,4=>E::WrongDigestEncoding,5=>E::NonZeroReserved,
+  6=>E::ZeroRequiredBinding,7=>E::InvalidAnchorSequence,
+  8=>E::NonCanonicalDigest,9=>E::NonCanonicalAssetId,
+  10=>E::InvalidWithdrawalAmount,11=>E::InvalidDestination,
+  12=>E::InvalidEnvelope,_=>E::EnvelopeMismatch}}
+}
+#[kani::ensures(|r| matches!(r,Ok(a) if a[0]==x))]
+fn exact(x:u8)->Reply {Ok([x;216])}
+#[kani::ensures(|r| matches!(r,Ok(a) if a[0]!=x))]
+fn inverted(x:u8)->Reply {Ok([x;216])}
+#[kani::ensures(|r| r.is_ok())]
+fn weak(x:u8)->Reply {Ok([x;216])}
+#[kani::modifies(&mut x[0])]
+#[kani::ensures(|r| r.is_ok())]
+fn frame_good(x:&mut[u8;2])->Reply {x[0]=x[0].wrapping_add(1);Ok([x[0];216])}
+#[kani::modifies(&mut x[0])]
+#[kani::ensures(|r| r.is_ok())]
+fn frame_bad(x:&mut[u8;2])->Reply {x[1]=x[1].wrapping_add(1);Ok([x[0];216])}
