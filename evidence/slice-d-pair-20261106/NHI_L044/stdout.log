AspisR1.NFW_PowersCohort.source (N : Aeneas.Std.Usize) (x : AspisR1.NFN_LPi_FieldValues.NE)
  (hx : AspisR1.NFN_LPi_FieldValues.canonE x) :
  ∃ out,
    FIo_Native.weights.powers N x = Aeneas.Std.Result.ok out ∧
      AspisR1ClaimPreparedBridge.powersPublic N (AspisR1.NFW_PowersCohort.toPublic x) =
          Aeneas.Std.Result.ok (AspisR1.NFW_PowersCohort.mapArray AspisR1.NFW_PowersCohort.toPublic out) ∧
        ∀ z ∈ ↑out, AspisR1.NFN_LPi_FieldValues.canonE z
'AspisR1.NFW_PowersCohort.source' depends on axioms: [propext, Classical.choice, Quot.sound]
NGH_QSquareRef.cohort (x : AspisR1.FIo_FieldBridge.NQ) (hx : NGA_NativeOps.Canon x) :
  ∃ out,
    NGH_QSquareRef.run x = Aeneas.Std.Result.ok out ∧
      NGA_NativeOps.Canon out ∧ NGA_NativeOps.decode out = NGA_NativeOps.decode x * NGA_NativeOps.decode x
'NGH_QSquareRef.cohort' depends on axioms: [propext, Classical.choice, Quot.sound]
