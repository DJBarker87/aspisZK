AspisR1.NBL_ViewNatural.source : ∀ (proof semantic y1 : Aeneas.Std.Slice Aeneas.Std.U8)
  (size : 10055 ≤ (↑proof).length),
  AspisR1SelectedWideViewV1.verifier.candidate.wide_view proof semantic y1 =
    Aeneas.Std.Result.ok
      (AspisR1.NBL_ViewProduct.product proof semantic y1 size (AspisR1.NBL_ViewNatural.decoded proof size))
AspisR1.NBL_ViewDomains.source : ∀ (proof semantic y1 : Aeneas.Std.Slice Aeneas.Std.U8),
  (↑proof).length = 57607 →
    ∀ (view : AspisR1SelectedWideViewV1.verifier.View),
      AspisR1SelectedWideViewV1.verifier.candidate.wide_view proof semantic y1 =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok view) →
        view.semantic = semantic ∧
          view.y1 = y1 ∧
            view.variant = AspisR1SelectedWideViewV1.transport.Variant.S2 ∧
              (↑view.round0).length = 224 ∧
                (↑view.round1).length = 224 ∧
                  (↑view.final_message).length = 2048 ∧
                    ∃ root, view.folded_root = Option.some root ∧ ↑root = List.take 32 (List.drop 7751 ↑proof)
AspisR1.NBL_PrepareHashTrace.source : ∀ (B : AspisR1PublicPreparation.FinishModel.Boundaries) {H : Type}
  (D : AspisR1PublicPreparation.aspis_core.Digest32 H)
  (pub : AspisR1PublicPreparation.pool_v1.pair_forest_semantic_terminal.r0.Public)
  (pre : AspisR1PublicPreparation.r1_wire.Prefix)
  (beforeSemantic : AspisR1PublicPreparation.r1_wire.SemanticTranscript H)
  (challenges : AspisR1PublicPreparation.r1_wire.Challenges)
  (obs : Option (AspisR1PublicPreparation.verifier.Phase → Aeneas.Std.Result Unit))
  (sem : AspisR1PublicPreparation.r1_semantic.Verified H),
  AspisR1PublicPreparation.FinishModel.finish AspisS1ExtractedRoundChildren.children
        { fromFn := @AspisR1PublicPreparation.FinishModel.Boundaries.fromFn B, mask := B.mask, add := B.add,
          mul := B.mul, terminal := B.terminal, circle := B.circle, unwrapRoot := B.unwrapRoot,
          claims :=
            AspisR1.ClaimsUnrolledFinish.claims (AspisR1.NP6_StdModel.calls (Aeneas.Std.core.result.Result.Ok ())) }
        D pub pre beforeSemantic challenges obs =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok sem) →
    ∀ (proof semantic compact before y1 : Aeneas.Std.Slice Aeneas.Std.U8)
      (view : AspisR1SelectedWideViewV1.verifier.View),
      AspisR1SelectedWideViewV1.verifier.candidate.wide_view proof semantic y1 =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok view) →
        (↑compact).length = 464 →
          (↑before).length = 928 →
            LPt_External.compact.check_values compact = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) →
              LPt_LPn.Expand.NativeTrace (↑compact) (↑before) 29 ↑y1 →
                ∀ (hash : H) (old : AspisR1.NBL_PrepareControl.Scratch)
                  (opening : AspisR1.NBL_OpeningTrace.Trace D sem (AspisR1SelectedWideViewV1.preparedView view) hash)
                  (queries : AspisR1.NBL_QueryTrace.Trace D opening.alpha1.block.after 31#u8 view.final_message)
                  (q : Aeneas.Std.Array Aeneas.Std.U32 22#usize) (state : AspisR1.NBL_BlockTrace.Bytes32),
                  queries.result = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (q, state)) →
                    ∀
                      (rhoBlock :
                        AspisR1.NBL_BlockTrace.Block D
                          (have __src := queries.afterAbsorb;
                          { state := state, hash := __src.hash })
                          32#u8 AspisR1PublicPreparation.PreparedScratchReachability.emptyPayload)
                      (digits : List ℕ) (last : List UInt32) (rho : AspisR1PublicPreparation.aspis_core.field.QM31),
                      LPk_Induction.Digits 4 (AspisR1.SamplerBytePass.digits rhoBlock.value) digits last →
                        AspisR1.NBA_Rho.coordinates rho = digits →
                          ∃ g claim,
                            FIo_Native.weights.powers 29#usize (AspisR1.NBA_Carriers.back opening.gamma.value) =
                                Aeneas.Std.Result.ok g ∧
                              AspisR1.LPq_PreparedTrace.Trace (AspisR1ClaimPreparedBridge.toClaimSem sem) view.y1
                                  (XRo_Join_Carriers.arr AspisR1.LPq_Powers.claim g)
                                  (AspisR1.NBA_Carriers.back (AspisR1SelectedWideViewV1.preparedView view).inactive)
                                  (AspisR1.NBA_Carriers.back opening.kappa.value) claim ∧
                                AspisR1.LPi_FieldValues.canonE claim ∧
                                  AspisR1PublicPreparation.PreparedHashCode.run
                                      (AspisR1.NBL_CohortCode.code D sem (AspisR1SelectedWideViewV1.preparedView view)
                                        hash old) =
                                    (AspisR1.NBL_HashReplay.events D hash
                                        (opening.log ++ AspisR1.NBL_QueryHashReplay.log queries ++ rhoBlock.log),
                                      Aeneas.Std.Result.ok
                                        (Aeneas.Std.core.result.Result.Ok
                                            (AspisR1PublicPreparation.PreparedScratchReachability.output sem
                                              (AspisR1SelectedWideViewV1.preparedView view) opening.gamma.value
                                              opening.kappa.value opening.output.alpha rho q
                                              (AspisR1.NBA_ClaimCallee.wide claim) rhoBlock.after),
                                          AspisR1ClaimPreparedBridge.mapArray AspisR1.NBA_ClaimCallee.wide g))
@AspisR1.NBL_PrepareHashReject.source : ∀ {H : Type} (D : AspisR1PublicPreparation.aspis_core.Digest32 H)
  (sem : AspisR1PublicPreparation.r1_semantic.Verified H) (v : AspisR1PublicPreparation.verifier.View) (hash : H)
  (old : AspisR1.NBL_PrepareControl.Scratch) (opening : AspisR1.NBL_OpeningTrace.Trace D sem v hash)
  (queries : AspisR1.NBL_QueryTrace.Trace D opening.alpha1.block.after 31#u8 v.final_message)
  (error : AspisR1Query31Transcript.aspis_core.transcript.QuerySampleError),
  queries.result = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Err error) →
    AspisR1PublicPreparation.PreparedHashCode.run (AspisR1.NBL_CohortCode.code D sem v hash old) =
      (AspisR1.NBL_HashReplay.events D hash (opening.log ++ AspisR1.NBL_QueryHashReplay.log queries),
        Aeneas.Std.Result.ok
          (Aeneas.Std.core.result.Result.Err AspisR1PublicPreparation.verifier.Error.Transcript, old))
