def AspisR1.CPP_Acceptance.Facts : (AspisR1.OraclePortStoredExperimentC4.Input →
    AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State Bool) →
  (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
