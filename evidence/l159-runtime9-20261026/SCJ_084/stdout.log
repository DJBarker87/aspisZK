fun driver H pub proof pub2 proof2 checkpoint written =>
  ∃ i,
    i.statement.pubBytes = AspisR1.MultiproofConeCanonical.bytesOf ↑pub ∧
      i.stored = AspisR1.MultiproofConeCanonical.bytesOf ↑proof ∧
        i.statement.tag = 2 ∧
          List.length i.statement.pubBytes = 1880 ∧
            75 + List.length i.statement.pubBytes ≤ AspisR1.SelectedTranscriptParams.L ∧
              (AspisR1.S2W_AuthenticatedInputs.P2Prime H proof pub proof2 pub2 →
                (AspisV8R19.MemoizedProgramLaw.eval H (driver i)).2 = Bool.true ∧
                  ¬∀ (j : AspisR1.OraclePortStoredExperimentC4.Input),
                      (AspisV8R19.MemoizedProgramLaw.eval H (driver j)).2 = Bool.false)
