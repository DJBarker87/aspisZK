@AspisR1.CPR_DataPersistence.TwoTransactionLaw : {Tx Key : Type} →
  (Tx → Tx → Prop) →
    (Tx → Key → Prop) →
      (Tx → Key → AspisR1.CPR_DataPersistence.Image) →
        (Tx → Key → AspisR1.CPR_DataPersistence.Image) →
          (Tx → Bool) → (Tx → Key → Option AspisV8R19.DuplexFrames.Bytes) → Prop
def AspisR1.CPR_DataPersistence.TwoTransactionLaw : {Tx Key : Type} →
  (Tx → Tx → Prop) →
    (Tx → Key → Prop) →
      (Tx → Key → AspisR1.CPR_DataPersistence.Image) →
        (Tx → Key → AspisR1.CPR_DataPersistence.Image) →
          (Tx → Bool) → (Tx → Key → Option AspisV8R19.DuplexFrames.Bytes) → Prop :=
fun {Tx Key} next ordinary before tentative success loaded =>
  ∀ (t u : Tx),
    next t u →
      ∀ (key : Key),
        ordinary t key →
          loaded u key =
            AspisR1.CPR_DataPersistence.visible (if success t = Bool.true then tentative t key else before t key)
'AspisR1.CPR_DataPersistence.TwoTransactionLaw' does not depend on any axioms
