                          ((p.layout t).handles 2).1 saved).lamports
                      ((p.layout t).handles 2).1 ≤
                    _a.1.lamports ((p.layout t).handles 2).1)
            (AspisR1.CPG_RuntimeTrace.result game.recorded.left.right.right))
          frame⟩⟩⟩
