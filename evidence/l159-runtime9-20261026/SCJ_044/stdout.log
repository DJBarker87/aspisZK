fun {Tx A F C} p t u e1 e2 saved actions c keyLaw n1 n2 hashv extraction copy std allocator id game data1 state1 final1
    post1 accepted1 =>
  have native :=
    (AspisR1.S2W_D189Wrappers.first_accepted n1 copy std allocator e1 id data1 state1 final1 saved post1
        accepted1).left;
  have source := Eq.trans (Eq.symm (extraction.stage1 id e1.first data1)) native;
  have owner :=
    AspisR1.CPR_SourceBank.copied_owner (AspisR1.DrvC_Installation.sdk c) keyLaw id
      (AspisR1.CPG_Projection.cached (p.bank t))
      (AspisR1.CPP_BankState.layout (AspisR1.CPG_Projection.cached (p.bank t)) (p.layout t)) data1 saved
      (Eq.mp
        (congrFun'
          (congrArg Eq
            (congrFun'
              (congrArg (AdapterRw.r1_pool_adapter.owned.stage1_owned (AspisR1.DrvC_Installation.sdk c) id)
                (congrArg AspisR1.S2W_D189Entry.Entry.first game.consecutive.right.left))
              data1))
          (Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok saved)))
        source);
  have marker :=
    AspisR1.CPR_SourceBank.copied_marker (AspisR1.CPG_Projection.cached (p.bank t)) ((p.layout t).handles 2).1 saved
      (AspisR1.Hiq_FirstShape.source c id e1.first data1 saved source).left;
  have positive :=
    AspisR1.CPG_Accepted.writer_positive p t u e1 e2 saved actions c n1 n2 hashv extraction copy std allocator id
      (AspisR1.CPH_Game.recordedInstance game) data1 state1 final1 post1 accepted1;
  have frame :=
    AspisR1.CPP_BankHistory.protection (AspisR1.DrvC_Installation.sdk c) keyLaw n1 n2
      (fun id accounts data => Eq.symm (extraction.stage1 id accounts data)) copy std allocator id
      (AspisR1.CPR_SourceBank.afterCopy (AspisR1.CPG_Projection.cached (p.bank t)) ((p.layout t).handles 2).1 saved)
      actions ((p.layout t).handles 2).1 owner marker positive;
  ⟨owner,
    ⟨marker,
      ⟨positive,
        Eq.mp
          (congrArg
            (fun _a =>
              (∀ event ∈ _a.2, AspisR1.S2X.Preserves ((p.layout t).handles 2).1 event) ∧
                _a.1.cells ((p.layout t).handles 2).1 =
                    (AspisR1.CPR_SourceBank.afterCopy (AspisR1.CPG_Projection.cached (p.bank t))
                          ((p.layout t).handles 2).1 saved).cells
                      ((p.layout t).handles 2).1 ∧
