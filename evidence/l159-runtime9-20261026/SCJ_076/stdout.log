theorem AspisR1.P2P_Forget.forget : ∀ {W F CoreError : Type}
  (L : AspisR1.S2Trust.Library W (ℕ → AspisR1.S2W_D189Entry.Record)) (e1 e2 : AspisR1.S2W_D189Entry.Entry) (w1 w2 : W)
  (adapterOps : AdapterRw.Ops) (ops : AspisR1CurrentCaller.Ops) (reserved : Bool)
  (queryOps : AspisR1.Port3_NativeQueryBody.Ops) (geoOps : AspisR1.Port3_NativeGeometryBody.Ops CoreError)
  (stageBase : VTop_Stages.Ops) (finishOps : AspisR1Stage2.Stage2Finish.FinishOps F)
  (B : AspisR1PublicPreparation.FinishModel.Boundaries) (reservation : AspisR1.NP6_StdModel.Reservation)
  (program : AspisR1.S2W_ExtractionBoundary.Program) (data1 data2 : Aeneas.Std.Slice Aeneas.Std.U8)
  (slot : AspisR1.S2W_ExtractionBoundary.Slot) (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
  (post1 post2 : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record))
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (driver :
    AspisR1.OraclePortStoredExperimentC4.Input →
      AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State Bool)
  (prior : AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State Unit)
  (events : List AspisR1.S2X.AccountEvent)
  (hashv : AspisR1.S2Z.Oracle.Parts → Aeneas.Std.Result AspisR1.S2Z.Oracle.Digest),
  AspisR1.P2P_GoodResult.Outcome L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps stageBase finishOps B reservation
      program data1 data2 slot saved post1 post2 H driver prior events hashv →
    AspisR1.Rc6_Result.Outcome L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps stageBase finishOps B reservation
      program data1 data2 slot saved post1 post2 H driver prior events hashv :=
fun {W F CoreError} L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps stageBase finishOps B reservation program
    data1 data2 slot saved post1 post2 H driver prior events hashv source =>
  let ⟨f, h✝⟩ := source
  let ⟨s, h✝¹⟩ := h✝
  let ⟨outer, h✝²⟩ := h✝¹
  let ⟨pre, h✝³⟩ := h✝²
  let ⟨middle, h✝⁴⟩ := h✝³
  let ⟨fs, h✝⁵⟩ := h✝⁴
  let ⟨ss, h✝⁶⟩ := h✝⁵
  let ⟨run, h✝⁷⟩ := h✝⁶
  let ⟨tx2, h✝⁸⟩ := h✝⁷
  let ⟨origin, right✝⟩ := h✝⁸
  let ⟨calls, right✝¹⟩ := right✝
  let ⟨encoding, right✝²⟩ := right✝¹
  let ⟨base, right✝³⟩ := right✝²
  let ⟨initial, right✝⁴⟩ := right✝³
  let ⟨selected, right✝⁵⟩ := right✝⁴
  let ⟨publicFacts, right✝⁶⟩ := right✝⁵
  let ⟨parser, right✝⁷⟩ := right✝⁶
  let ⟨version, h✝⁹⟩ := right✝⁷
  let ⟨writerKey, right✝⁸⟩ := h✝⁹
  let ⟨readerKey, right✝⁹⟩ := right✝⁸
  let ⟨physical, right✝¹⁰⟩ := right✝⁹
  let ⟨persistent, right✝¹¹⟩ := right✝¹⁰
  let ⟨packet, right✝¹²⟩ := right✝¹¹
  let ⟨safe, right✝¹³⟩ := right✝¹²
  let ⟨whole, right✝¹⁴⟩ := right✝¹³
  let ⟨acceptance, right✝¹⁵⟩ := right✝¹⁴
  let ⟨nonvacuity, caller⟩ := right✝¹⁵
  Exists.intro f
    (Exists.intro s
      (Exists.intro outer
        (Exists.intro pre
          (Exists.intro middle
            (Exists.intro fs
              (Exists.intro ss
                (Exists.intro run
                  (Exists.intro tx2
                    ⟨calls,
                      ⟨encoding,
                        ⟨base,
                          ⟨initial,
                            ⟨selected,
                              ⟨publicFacts,
                                ⟨parser,
                                  Exists.intro version
                                    ⟨writerKey,
                                      ⟨readerKey,
                                        ⟨physical,
                                          ⟨persistent,
                                            ⟨let ⟨i, h✝¹⁰⟩ := acceptance
                                              let ⟨pub, right✝¹⁶⟩ := h✝¹⁰
                                              let ⟨proof, right✝¹⁷⟩ := right✝¹⁶
                                              let ⟨tag, right✝¹⁸⟩ := right✝¹⁷
                                              let ⟨size, right✝¹⁹⟩ := right✝¹⁸
                                              let ⟨fit, yes⟩ := right✝¹⁹
                                              Exists.intro i ⟨pub, ⟨proof, ⟨tag, ⟨size, ⟨fit, fun x => yes⟩⟩⟩⟩⟩,
                                              ⟨fun x => nonvacuity,
                                                ⟨packet, ⟨safe, ⟨whole, fun x => caller⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩))))))))
