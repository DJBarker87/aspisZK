  let ⟨queries, right✝³⟩ := right✝²
  let ⟨found, right✝⁴⟩ := right✝³
  let ⟨read, right✝⁵⟩ := right✝⁴
  let ⟨opened, right✝⁶⟩ := right✝⁵
  let ⟨fields, right✝⁷⟩ := right✝⁶
  let ⟨numeric, right✝⁸⟩ := right✝⁷
  let ⟨prepare, right✝⁹⟩ := right✝⁸
  let ⟨prepared, right✝¹⁰⟩ := right✝⁹
  let ⟨source, h✝⁵⟩ := right✝¹⁰
  let ⟨output, right✝¹¹⟩ := h✝⁵
  let ⟨sourceNumeric, remaining⟩ := right✝¹¹
  Exists.intro rawModel
    (Exists.intro parsed
      (Exists.intro q
        (Exists.intro metadata
          (Exists.intro view
            ⟨physical,
              ⟨stored,
                ⟨parser,
                  ⟨queries,
                    ⟨found,
                      ⟨read,
                        ⟨opened,
                          ⟨fields,
                            ⟨numeric,
                              ⟨prepare,
                                ⟨prepared,
                                  Exists.intro source
                                    ⟨output,
                                      ⟨sourceNumeric,
                                        Or.casesOn remaining (fun collision => Or.inl collision) fun good =>
                                          Or.inr
                                            (let ⟨acc, right✝¹²⟩ := good
                                            let ⟨writer, right✝¹³⟩ := right✝¹²
                                            let ⟨len, right✝¹⁴⟩ := right✝¹³
                                            let ⟨next, right✝¹⁵⟩ := right✝¹⁴
                                            let ⟨savedEq, finishing⟩ := right✝¹⁵
                                            ⟨acc,
                                              ⟨writer,
                                                ⟨len,
                                                  ⟨next,
                                                    ⟨savedEq,
                                                      AspisR1.SAF_ForgetFinish.forget finish tx2.v2 tx2.p2
                                                        (have __src := tx2.returned2;
                                                        { weights := tx2.back2 tx2.flushed2, rhs := __src.rhs,
                                                          power := __src.power, next := __src.next })
