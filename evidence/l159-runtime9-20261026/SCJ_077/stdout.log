fun {CoreError} adapter ops reserved query geo stage {F} finish B std saved f s run H trace authParsed tx2 strong =>
  let ⟨rawModel, h✝⟩ := strong
  let ⟨parsed, h✝¹⟩ := h✝
  let ⟨q, h✝²⟩ := h✝¹
  let ⟨metadata, h✝³⟩ := h✝²
