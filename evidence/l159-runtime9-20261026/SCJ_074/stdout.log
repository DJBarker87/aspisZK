  let ⟨checkY, right✝⁵⟩ := right✝⁴
  let ⟨scan, right✝⁶⟩ := right✝⁵
  let ⟨tx1, right✝⁷⟩ := right✝⁶
  let ⟨batches, right✝⁸⟩ := right✝⁷
  let ⟨tx2, right✝⁹⟩ := right✝⁸
  let ⟨shape, right✝¹⁰⟩ := right✝⁹
  let ⟨expanded, right✝¹¹⟩ := right✝¹⁰
  let ⟨owned, right✝¹²⟩ := right✝¹¹
  let ⟨projectedRun, right✝¹³⟩ := right✝¹²
