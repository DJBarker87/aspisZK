def AspisR1.T2R_Parser.Facts : Aeneas.Std.Slice Aeneas.Std.U8 → Prop :=
fun proof =>
  ∃ expanded pre,
    AspisR1PublicPreparation.PrefixAdapter.parseAccepted expanded =
        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok pre) ∧
      AspisR1.OraclePortCompactDraft.semanticRows 27 0
            (AspisR1.OraclePortCompactDraft.slice (AspisR1.MultiproofConeCanonical.bytesOf ↑proof) 48 6983) =
          Option.some (List.map (fun s => AspisR1.MultiproofConeCanonical.bytesOf ↑s) ↑pre.records) ∧
        AspisR1.OraclePortCompactDraft.parse (AspisR1.MultiproofConeCanonical.bytesOf ↑proof) =
          Option.some
            { wire := AspisR1.MultiproofConeCanonical.bytesOf ↑proof,
              semantic := List.map (fun s => AspisR1.MultiproofConeCanonical.bytesOf ↑s) ↑pre.records }
