fun {W F CoreError} L e1 e2 w1 w2 adapterOps ops reserved queryOps geoOps stageBase finishOps B claimsStd program data1
    data2 slot saved post1 post2 H f s outer pre middle fs ss run prior tx2 cuts selected header canonical native1
    native2 hashv extraction sha256 p1 syscall old =>
  let words :=
    AspisR1.CanonicalCutEnrichedTranscript.wordsFromMaps (fun x => Option.none) (fun x => Option.none) fun x =>
      Option.none;
  let ⟨modelInput, h✝⟩ :=
    AspisR1.PFin_Attach.from_cut adapterOps ops reserved queryOps geoOps stageBase finishOps
      (AspisR1.F3M_CircleSource.install B) claimsStd e1.first (e2.second AspisR1.S2W_D189Wrappers.secondSizes) saved f s
      cuts selected run header H native1 native2 hashv extraction sha256 p1 syscall words canonical
  let ⟨p, h✝¹⟩ := h✝
  let ⟨q, h✝²⟩ := h✝¹
  let ⟨i, h✝³⟩ := h✝²
  let ⟨physical, right✝⟩ := h✝³
  let ⟨stored, right✝¹⟩ := right✝
  let ⟨reached, right✝²⟩ := right✝¹
  let ⟨aligned, right✝³⟩ := right✝²
  let ⟨queries, right✝⁴⟩ := right✝³
  let ⟨found, right✝⁵⟩ := right✝⁴
  let ⟨read, right✝⁶⟩ := right✝⁵
  let ⟨decoded, prepare⟩ := right✝⁶
  have entry :=
    {
      parsed :=
        Exists.intro
          (AspisR1.LiteralTranscript.erasePrefix
            (AspisV8R19.MemoizedProgramLaw.eval H
                (AspisR1.F3J_SamplerRun.program modelInput.proof 0 33 (FS.emptyPrefix modelInput.semantic.value))).2)
          (Exists.intro p reached) };
  fun p2prime =>
  let ⟨parsed, h✝⁴⟩ := old p2prime entry
  let ⟨facts, right✝⁷⟩ := h✝⁴
  let ⟨sites, cont⟩ := right✝⁷
  Exists.intro parsed ⟨facts, ⟨sites, cont⟩⟩
'AspisR1.Rc6_Caller.from_cut' depends on axioms: [propext, Classical.choice, Quot.sound]
@AspisR1.CPH_Recorder.Facts : {Tx A F C : Type} →
  AspisR1.DrvC_Installation.Configuration F C →
    (AspisR1.S2Z.Oracle.Parts → Aeneas.Std.Result AspisR1.S2Z.Oracle.Digest) →
      AspisR1.S2W_ExtractionBoundary.First →
        AspisR1.S2W_ExtractionBoundary.Second →
          (AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
              ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record)) →
            AspisR1.S2W_D189Wrappers.Allocator A →
              AspisR1.S2W_ExtractionBoundary.Program →
                (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
                  AspisR1.CPG_Projection.Observations Tx A → Tx → Tx → Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8 → Prop
def AspisR1.CPH_Recorder.Facts : {Tx A F C : Type} →
  AspisR1.DrvC_Installation.Configuration F C →
    (AspisR1.S2Z.Oracle.Parts → Aeneas.Std.Result AspisR1.S2Z.Oracle.Digest) →
      AspisR1.S2W_ExtractionBoundary.First →
        AspisR1.S2W_ExtractionBoundary.Second →
          (AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
              ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record)) →
            AspisR1.S2W_D189Wrappers.Allocator A →
              AspisR1.S2W_ExtractionBoundary.Program →
                (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
                  AspisR1.CPG_Projection.Observations Tx A → Tx → Tx → Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8 → Prop :=
fun {Tx A F C} c hashv n1 n2 copy allocator id H p t u saved =>
  (AspisV8R19.MemoizedProgramLaw.eval H
          (AspisR1.CPS_BankRecorder.program c hashv n1 n2 copy allocator id
            (AspisR1.CPR_SourceBank.afterCopy (AspisR1.CPG_Projection.cached (p.bank t)) ((p.layout t).handles 2).1
              saved)
            (p.actions t))).2 =
      (p.parentTentative t, p.physicalEvents t) ∧
    (AspisV8R19.MemoizedProgramLaw.eval H
          (AspisR1.CPS_BankRecorder.program c hashv n1 n2 copy allocator id (AspisR1.CPG_Projection.cached (p.bank u))
            (p.actions u))).2 =
      (p.parentTentative u, p.physicalEvents u)
'AspisR1.CPH_Recorder.Facts' depends on axioms: [propext, Classical.choice, Quot.sound]
