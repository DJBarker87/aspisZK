def AspisR1.CPH_Game.recordedInstance : ∀ {Tx A : Type} {p : AspisR1.CPG_Projection.Observations Tx A} {t u : Tx}
  {e1 e2 : AspisR1.S2W_D189Entry.Entry} {saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8}
  {actions : List (AspisR1.CPP_BankState.Action A)} {n1 : AspisR1.S2W_ExtractionBoundary.First}
  {n2 : AspisR1.S2W_ExtractionBoundary.Second}
  {copy :
    AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record) →
      ℕ → AspisR1.S2Trust.Payload → AspisR1.S2W_TrustedStd.Outcome (ℕ → AspisR1.S2W_D189Entry.Record)}
  {allocator : AspisR1.S2W_D189Wrappers.Allocator A} {id : AspisR1.S2W_ExtractionBoundary.Program},
  AspisR1.CPH_Game.DeployedPairExecution p t u e1 e2 saved actions n1 n2 copy allocator id →
    AspisR1.CPG_Game.DeployedPairExecution p t u e1 e2 saved actions n1 n2 copy allocator id :=
fun {Tx A} {p} {t u} {e1 e2} {saved} {actions} {n1} {n2} {copy} {allocator} {id} game =>
  { consecutive := game.consecutive, checkpoint := game.checkpoint, parent := game.parent,
    recorded := game.recorded.left }
'AspisR1.CPH_Game.recordedInstance' depends on axioms: [propext, Classical.choice, Quot.sound]
