fun {F C} base s H hashv accepted prior decoder owner ports canonical domain multiply one inverse =>
  id
    (let c := AspisR1.F3V_Install.configuration base;
    let w :=
      AspisR1.CanonicalCutEnrichedTranscript.wordsFromMaps (fun x => Option.none) (fun x => Option.none) fun x =>
        Option.none;
    let ⟨e, first⟩ := AspisR1.PFin_WorldRuns.accepted base hashv s H decoder w accepted
    let ⟨i, h✝⟩ :=
      AspisR1.PFin_WorldAcceptance.values base s H e hashv accepted first prior decoder owner ports canonical domain
        multiply one inverse
    let ⟨p, h✝¹⟩ := h✝
    let ⟨q, h✝²⟩ := h✝¹
    let ⟨data, h✝³⟩ := h✝²
    let ⟨t, h✝⁴⟩ := h✝³
    let ⟨physical, right✝⟩ := h✝⁴
    let ⟨stored, right✝¹⟩ := right✝
    let ⟨parser, right✝²⟩ := right✝¹
    let ⟨queries, right✝³⟩ := right✝²
    let ⟨found, right✝⁴⟩ := right✝³
    let ⟨calls, result⟩ := right✝⁴
    Exists.intro e
      (Exists.intro i
        (Exists.intro p
          (Exists.intro q
            (Exists.intro data
              (Exists.intro t
                ⟨physical,
                  ⟨stored,
                    ⟨parser,
                      ⟨queries,
                        ⟨found,
                          ⟨calls,
                            Or.casesOn result (fun bad => Or.inl bad) fun h =>
                              let ⟨logs, values⟩ := h
                              Or.inr
                                (let ⟨x, cont⟩ :=
                                  AspisR1.F3V_Leaves.actual c.finish t.v2 t.p2
                                    (have __src := t.returned2;
                                    { weights := t.back2 t.flushed2, rhs := __src.rhs, power := __src.power,
                                      next := __src.next })
                                    H
                                    (AspisR1.F3V_Checkpoint.trace (AspisR1.F3V_Install.configuration base)
                                      base.boundaries s H e prior)
                                    p q
                                    (AspisR1.LiteralTranscript.erasePrefix
                                      (AspisV8R19.MemoizedProgramLaw.eval H
                                          (AspisR1.F3J_SamplerRun.program i.proof 0 33
                                            (FS.emptyPrefix i.semantic.value))).2)
                                    data decoder i values
                                Exists.intro x fun leaves =>
                                  Or.casesOn (cont leaves) (fun bad => Or.inl bad) fun modelAccepted =>
                                    Or.inr
                                      (AspisR1.PFin_WorldCanonical.joined c base.boundaries s H e hashv accepted first
                                        decoder i physical stored logs modelAccepted))⟩⟩⟩⟩⟩⟩))))))
