                                            (AspisR1.SdkD_PairBatches.current adapter ops stage finish reserved query
                                              geo (AspisR1.F3M_CircleSource.install B) std))
                                          (AspisR1.Tx1Q_Carriers.prepared run.p)
                                          (AspisR1.Tx1Q_Carriers.accumulator
                                            (have __src := run.out;
                                            { weights := ⟨↑run.flushed, ⋯⟩, rhs := __src.rhs, power := __src.power,
                                              next := __src.next }))
                                          f.proof f.pub () =
                                        Aeneas.Std.Result.ok saved ∧
                                      (↑run.flushed).length = 64 ∧
                                        ↑run.out.next = 10 ∧
                                          saved =
                                              AspisR1.Tx2N_Reader.writer H
                                                (AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof)
                                                (AspisR1.MultiproofConeCanonical.bytesOf ↑f.pub)
                                                (AspisR1.OraclePortCheckpointResumeC5.prepared
                                                  (AspisR1.OraclePortAcceptedContextC6.context parsed i view) i.data
                                                  (AspisR1.SelectedChallengeMap.rhoOf i.rho) q)
                                                (AspisR1.OraclePortCheckpointStateC3.write
                                                    (AspisR1.OraclePortCheckpointResumeC5.model i.data
                                                      (AspisR1.SelectedChallengeMap.rhoOf i.rho) q)).accumulator ∧
                                            AspisR1.FJp_Finish.Outcome finish tx2.v2 tx2.p2
                                              (have __src := tx2.returned2;
