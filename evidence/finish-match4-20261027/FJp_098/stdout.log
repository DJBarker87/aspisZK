        (AspisV8R19.MemoizedProgramLaw.eval H
            (AspisR1.F3J_SamplerRun.program model.proof 0 33 (FS.emptyPrefix model.semantic.value))).2;
    have i := AspisR1.TxS_Carriers.source metadata (AspisR1.OraclePortStoredDecisionDraftC4.typedRows parsed q tr);
    model.physical.bytes = AspisR1.MultiproofConeCanonical.bytesOf ↑f.pub ∧
      model.stored = AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof ∧
        AspisR1.OraclePortStoredParserC4.parseReached model.stored tr = some parsed ∧
          AspisR1.OraclePortSelectedDraft.queries tr = some q ∧
            AspisR1.OraclePortStoredDecisionDraftC4.input parsed q tr = some i ∧
              AspisR1.LiteralMatchingData.read (AspisR1.OraclePortStoredDecisionDraftC4.typedRows parsed q tr) =
                  some i.data ∧
                AspisR1.LiteralOpeningView.read (AspisR1.OraclePortStoredDecisionDraftC4.typedRows parsed q tr) =
                    some view ∧
