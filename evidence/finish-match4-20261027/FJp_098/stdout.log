                          (AspisR1.SelectedChallengeMap.rhoOf i.rho) ∧
                        AspisR1.Port5Q2_Prepared.PreparedFields (AspisR1.Tx1Q_Carriers.prepared run.p) ∧
                          ∃ sourcePrepared,
                            AspisR1CurrentCaller.InstalledPreparation.currentPrepared sourcePrepared = run.p ∧
                              AspisR1.F3L_SourcePrepared.numeric sourcePrepared =
                                  AspisR1.OraclePortCheckpointResumeC5.prepared
                                    (AspisR1.OraclePortAcceptedContextC6.context parsed i view) i.data
                                    (AspisR1.SelectedChallengeMap.rhoOf i.rho) q ∧
                                (AspisR1.AuS1_Finish.Collision H trace authParsed q ∨
                                  AspisR1.CheckpointBytes5Output.accumulator
                                        (AspisR1.Tx1Q_Carriers.accumulator
                                          (have __src := run.out;
                                          { weights := ⟨↑run.flushed, ⋯⟩, rhs := __src.rhs, power := __src.power,
                                            next := __src.next })) =
