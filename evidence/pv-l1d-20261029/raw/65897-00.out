PV_L1D_CallbackSafe.callbacks_append (xs ys : List R1Z.SideChannelL1AttemptRecord.Event) :
  PV_L1D_CallbackSafe.callbacks (xs ++ ys) = PV_L1D_CallbackSafe.callbacks xs ++ PV_L1D_CallbackSafe.callbacks ys
PV_L1D_CallbackSafe.safe_bind {A B : Type} (x : PV_L1D_Logged.Logged A) (f : A → PV_L1D_Logged.Logged B)
  (hx : PV_L1D_CallbackSafe.Safe x) (hf : ∀ (a : A), PV_L1D_CallbackSafe.Safe (f a)) :
  PV_L1D_CallbackSafe.Safe (x >>= f)
PV_L1D_CallbackSafe.safe_lift {A : Type} (r : Aeneas.Std.Result A) : PV_L1D_CallbackSafe.Safe (PV_L1D_Logged.lift r)
PV_L1D_CallbackSafe.safe_pure {A : Type} (a : A) : PV_L1D_CallbackSafe.Safe (pure a)
PV_L1D_CallbackSafe.safe_observe {A : Type} (site : R1Z.SideChannelL1AttemptRecord.Call) (k : ℕ)
  (r : Aeneas.Std.Result A)
  (h : PV_L1D_CallbackSafe.callbacks [R1Z.SideChannelL1AttemptRecord.Event.call site k] = []) :
  PV_L1D_CallbackSafe.Safe (PV_L1D_Logged.observe site k r)
PV_L1D_CountSuccess.count_eq_entered {S P : Type} (owner : R1Z.SideChannelL1AttemptRecord.Owner S P) (fuel index : ℕ)
  (s : S) (p : R1Z.ProverCommitRetry34.Published P)
  (h : (R1Z.SideChannelL1AttemptRecord.run owner fuel index s).1.result = R1Z.ProverCommitRetry34.Step.done p) :
  p.attempts = index + (R1Z.SideChannelL1AttemptRecord.run owner fuel index s).1.attempts.length
PV_L1D_CountSuccess.count_bounds {S P : Type} (owner : R1Z.SideChannelL1AttemptRecord.Owner S P) (s : S)
  (p : R1Z.ProverCommitRetry34.Published P)
  (h : (R1Z.SideChannelL1AttemptRecord.run owner 8 0 s).1.result = R1Z.ProverCommitRetry34.Step.done p) :
  1 ≤ p.attempts ∧ p.attempts ≤ 8
PV_L1D_EraseControl.control {A B C : Type} (x : Aeneas.Std.core.ops.control_flow.ControlFlow A B)
  (f : B → PV_L1D_Logged.Logged C) (g : A → PV_L1D_Logged.Logged C) :
  PV_L1D_Logged.erase
      (match x with
      | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue b => f b
      | Aeneas.Std.core.ops.control_flow.ControlFlow.Break a => g a) =
    match x with
    | Aeneas.Std.core.ops.control_flow.ControlFlow.Continue b => PV_L1D_Logged.erase (f b)
    | Aeneas.Std.core.ops.control_flow.ControlFlow.Break a => PV_L1D_Logged.erase (g a)
PV_L1D_EraseIf.erase_if {A : Type} (p : Prop) [Decidable p] (a b : PV_L1D_Logged.Logged A) :
  PV_L1D_Logged.erase (if p then a else b) = if p then PV_L1D_Logged.erase a else PV_L1D_Logged.erase b
PV_L1D_FixedBind.bind_fixed {A B : Type} (x : PV_L1D_Logged.Logged A) (f : A → PV_L1D_Logged.Logged B)
  (xs ys : List R1Z.SideChannelL1AttemptRecord.Event) (hx : PV_L1D_FixedEvents.Fixed xs x)
  (hf : ∀ (a : A), PV_L1D_FixedEvents.Fixed ys (f a)) : PV_L1D_FixedEvents.Fixed (xs ++ ys) (x >>= f)
PV_L1D_FixedEvents.fixed_lift {α : Type} (r : Aeneas.Std.Result α) : PV_L1D_FixedEvents.Fixed [] (PV_L1D_Logged.lift r)
PV_L1D_FixedEvents.fixed_pure {α : Type} (a : α) : PV_L1D_FixedEvents.Fixed [] (pure a)
PV_L1D_FixedEvents.bind_lift {α β : Type} (r : Aeneas.Std.Result α) (f : α → PV_L1D_Logged.Logged β)
  (events : List R1Z.SideChannelL1AttemptRecord.Event) (h : ∀ (a : α), PV_L1D_FixedEvents.Fixed events (f a)) :
  PV_L1D_FixedEvents.Fixed events (PV_L1D_Logged.lift r >>= f)
PV_L1D_FixedEvents.bind_observe {α β : Type} (r : Aeneas.Std.Result α) (f : α → PV_L1D_Logged.Logged β)
  (site : R1Z.SideChannelL1AttemptRecord.Call) (index : ℕ) (events : List R1Z.SideChannelL1AttemptRecord.Event)
  (h : ∀ (a : α), PV_L1D_FixedEvents.Fixed events (f a)) :
  PV_L1D_FixedEvents.Fixed (R1Z.SideChannelL1AttemptRecord.Event.call site index :: events)
    (PV_L1D_Logged.observe site index r >>= f)
PV_L1D_Logged.erase_pure {α : Type} (a : α) : PV_L1D_Logged.erase (pure a) = Aeneas.Std.Result.ok a
PV_L1D_Logged.erase_lift {α : Type} (r : Aeneas.Std.Result α) : PV_L1D_Logged.erase (PV_L1D_Logged.lift r) = r
PV_L1D_Logged.erase_observe {α : Type} (site : R1Z.SideChannelL1AttemptRecord.Call) (index : ℕ)
  (r : Aeneas.Std.Result α) : PV_L1D_Logged.erase (PV_L1D_Logged.observe site index r) = r
PV_L1D_Logged.erase_bind {α β : Type} (x : PV_L1D_Logged.Logged α) (f : α → PV_L1D_Logged.Logged β) :
  PV_L1D_Logged.erase (x >>= f) = do
    let a ← PV_L1D_Logged.erase x
    PV_L1D_Logged.erase (f a)
PV_L1D_Projection.prod_case {A B C : Type} (p : A × B) (f : A → B → C) :
  (match p with
    | (a, b) => f a b) =
    f p.1 p.2
PV_L1D_QueryAbsorb.complete_result [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns] {H : Type}
  (aspis_coredigestDigest32Inst : ProverRwFull.aspis_core.digest.Digest32 H)
  (self : ProverRwFull.host_transcript.Transcript H) (row : Aeneas.Std.U8) (payload : Aeneas.Std.Slice Aeneas.Std.U8) :
  PV_L1D_Logged.erase (PV_L1D_QueryAbsorb.produce aspis_coredigestDigest32Inst self row payload) =
    ProverRwFull.host_transcript.Transcript.absorb aspis_coredigestDigest32Inst self row payload
PV_L1D_QueryAbsorb.completed_order [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns] {H : Type}
  (aspis_coredigestDigest32Inst : ProverRwFull.aspis_core.digest.Digest32 H)
  (self : ProverRwFull.host_transcript.Transcript H) (row : Aeneas.Std.U8) (payload : Aeneas.Std.Slice Aeneas.Std.U8) :
  PV_L1D_FixedEvents.Fixed PV_L1D_QueryAbsorb.readOrder
    (PV_L1D_QueryAbsorb.produce aspis_coredigestDigest32Inst self row payload)
PV_L1D_QueryProducer.complete_result [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns] {H : Type}
  (aspis_coredigestDigest32Inst : ProverRwFull.aspis_core.digest.Digest32 H)
  (self : ProverRwFull.host_transcript.Transcript H) (row : Aeneas.Std.U8) (payload : Aeneas.Std.Slice Aeneas.Std.U8) :
  PV_L1D_Logged.erase (PV_L1D_QueryProducer.produce aspis_coredigestDigest32Inst self row payload) =
    ProverRwFull.host_transcript.Transcript.queries aspis_coredigestDigest32Inst self row payload
PV_L1D_QueryProducer.completed_order [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns] {H : Type}
  (aspis_coredigestDigest32Inst : ProverRwFull.aspis_core.digest.Digest32 H)
  (self : ProverRwFull.host_transcript.Transcript H) (row : Aeneas.Std.U8) (payload : Aeneas.Std.Slice Aeneas.Std.U8) :
  PV_L1D_FixedEvents.Fixed PV_L1D_QueryProducer.readOrder
    (PV_L1D_QueryProducer.produce aspis_coredigestDigest32Inst self row payload)
PV_L1D_RejectionCount.success_rejections {S P : Type} (owner : R1Z.SideChannelL1AttemptRecord.Owner S P)
  (fuel index : ℕ) (s : S) (p : R1Z.ProverCommitRetry34.Published P)
  (h : (R1Z.SideChannelL1AttemptRecord.run owner fuel index s).1.result = R1Z.ProverCommitRetry34.Step.done p) :
  (List.filter PV_L1D_RejectionCount.retrying
          (R1Z.SideChannelL1AttemptRecord.run owner fuel index s).1.attempts).length +
      1 =
    (R1Z.SideChannelL1AttemptRecord.run owner fuel index s).1.attempts.length
PV_L1D_RejectionCount.original_count_pair {S P : Type} (owner : R1Z.SideChannelL1AttemptRecord.Owner S P) (s : S)
  (p : R1Z.ProverCommitRetry34.Published P)
  (h : (R1Z.SideChannelL1AttemptRecord.run owner 8 0 s).1.result = R1Z.ProverCommitRetry34.Step.done p) :
  ((R1Z.SideChannelL1AttemptRecord.run owner 8 0 s).1.attempts.length,
      (List.filter PV_L1D_RejectionCount.retrying (R1Z.SideChannelL1AttemptRecord.run owner 8 0 s).1.attempts).length) =
    (p.attempts, p.attempts - 1)
PV_L1D_Logged.erase_coe {α : Type} (r : Aeneas.Std.Result α) : PV_L1D_Logged.erase (PV_L1D_Logged.lift r) = r
PV_L1D_RetryCount.successful_callbacks {S P : Type} (a : PV_L1D_RetryFold.Attempt S P)
  (entries : ∀ (k : ℕ) (s : S), PV_L1D_CallbackSafe.callbacks (a k s).events = [k]) (n k : ℕ) (s after : S)
  (p : R1Z.ProverCommitRetry34.Published P)
  (h : (PV_L1D_RetryFold.run a n k s).result = Aeneas.Std.Result.ok (R1Z.ProverCommitRetry34.Step.done p, after)) :
  p.attempts = k + (PV_L1D_CallbackSafe.callbacks (PV_L1D_RetryFold.run a n k s).events).length
PV_L1D_RetryFold.erasure {S P : Type} (a : PV_L1D_RetryFold.Attempt S P) (n k : ℕ) (s : S) :
  PV_L1D_Logged.erase (PV_L1D_RetryFold.run a n k s) =
    R1Z.ProverCommitRetry34.run (fun j st => PV_L1D_Logged.erase (a j st)) n k s
PV_L1D_RetryFold.retry_events {S P : Type} (a : PV_L1D_RetryFold.Attempt S P) (n k : ℕ) (s after : S)
  (es : List R1Z.SideChannelL1AttemptRecord.Event)
  (h : a k s = { events := es, result := Aeneas.Std.Result.ok (R1Z.ProverCommitRetry34.Step.retry, after) }) :
  (PV_L1D_RetryFold.run a (n + 1) k s).events = es ++ (PV_L1D_RetryFold.run a n (k + 1) after).events
PV_L1D_RetryFold.failure_prefix {S P : Type} (a : PV_L1D_RetryFold.Attempt S P) (n k : ℕ) (s : S)
  (es : List R1Z.SideChannelL1AttemptRecord.Event) (e : Aeneas.Std.Error)
  (h : a k s = { events := es, result := Aeneas.Std.Result.fail e }) : (PV_L1D_RetryFold.run a (n + 1) k s).events = es
PV_L1D_SelectedCount.original_success {S P A : Type} (owner : R1Z.SideChannelL1AttemptRecord.Owner S P) (s : S)
  (p : R1Z.ProverCommitRetry34.Published P) (keys : Fin 8 → A)
  (h : (R1Z.SideChannelL1AttemptRecord.run owner 8 0 s).1.result = R1Z.ProverCommitRetry34.Step.done p) :
  ∃ k,
    ↑k = p.attempts - 1 ∧
      PV_L1D_SelectedCount.selected keys p.attempts (R1Z.SideChannelL1AttemptRecord.run owner 8 0 s).1.attempts.length =
        some (↑k, keys k)
