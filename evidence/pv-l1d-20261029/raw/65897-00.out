PV_L1D_UploadCounts.ceil_formula (n : ℕ) : PV_L1D_UploadCounts.uploads n = (n + 3762) / 3763
PV_L1D_UploadCounts.same_original_result {S Audit A : Type}
  (owner : R1Z.SideChannelL1AttemptRecord.Owner S (PV_L1D_UploadCounts.Proof Audit)) (s : S)
  (p : R1Z.ProverCommitRetry34.Published (PV_L1D_UploadCounts.Proof Audit)) (keys : Fin 8 → A)
  (h : (R1Z.SideChannelL1AttemptRecord.run owner 8 0 s).1.result = R1Z.ProverCommitRetry34.Step.done p) :
  ∃ k,
    ↑k = p.attempts - 1 ∧
      PV_L1D_SelectedCount.selected keys p.attempts (R1Z.SideChannelL1AttemptRecord.run owner 8 0 s).1.attempts.length =
          some (↑k, keys k) ∧
        ((R1Z.SideChannelL1AttemptRecord.run owner 8 0 s).1.attempts.length,
            (List.filter PV_L1D_RejectionCount.retrying
                (R1Z.SideChannelL1AttemptRecord.run owner 8 0 s).1.attempts).length,
            PV_L1D_UploadCounts.uploads p.proof.1.length, 1) =
          (p.attempts, p.attempts - 1, (p.proof.1.length + 3762) / 3763, 1)
PV_RJ4IDB.OpenInputs.L1_COUNT_TRACE {I A : Type} (actual : I → List ℕ × List ℕ) (native : I → PV_RJ4IDB.NativeTrace A) :
  Prop
PV_RJ4IDB.OpenInputs.L1_ORACLE_PREFIX {I A : Type} (actual : I → List (PV_RJ4IDB.Bytes × PV_RJ4IDB.Bytes))
  (native : I → PV_RJ4IDB.NativeTrace A) : Prop
PV_RJ4IDB.OpenInputs.L1_TIME_TRACE {I A : Type} (actual : I → List PV_RJ4IDB.Bytes)
  (native : I → PV_RJ4IDB.NativeTrace A) : Prop
PV_RJ4IDB.OpenInputs.L1_RETAINED_SIDECHANNELS {I A : Type} (actual : I → List (PV_RJ4IDB.Bytes × PV_RJ4IDB.Bytes))
  (native : I → PV_RJ4IDB.NativeTrace A) : Prop
'PV_L1D_UploadCounts.same_original_result' depends on axioms: [propext, Classical.choice, Quot.sound]
