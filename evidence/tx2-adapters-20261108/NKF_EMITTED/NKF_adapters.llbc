 base58 32-byte program id\");\n    }\n    let mut bytes = [0u8; 32];\n    let mut i = 0;\n    while i < input.len() {\n        let mut digit = 0;\n        while digit < ALPHABET.len() && ALPHABET[digit] != input[i] {\n            digit += 1;\n        }\n        if digit == ALPHABET.len() {\n            return Err(\"invalid base58 character\");\n        }\n        let mut carry = digit as u32;\n        let mut j = bytes.len();\n        while j > 0 {\n            j -= 1;\n            carry += bytes[j] as u32 * 58;\n            bytes[j] = carry as u8;\n            carry >>= 8;\n        }\n        if carry != 0 {\n            return Err(\"program id exceeds 32 bytes\");\n        }\n        i += 1;\n    }\n    let mut leading_ones = 0;\n    while leading_ones < input.len() && input[leading_ones] == b'1' {\n        leading_ones += 1;\n    }\n    let mut leading_zeros = 0;\n    while leading_zeros < bytes.len() && bytes[leading_zeros] == 0 {\n        leading_zeros += 1;\n    }\n    if leading_ones != leading_zeros {\n        return Err(\"program id must decode to exactly 32 bytes\");\n    }\n    Ok(bytes)\n}\n\npub(crate) const fn deployment_id(value: Option<&str>, default: [u8; 32]) -> [u8; 32] {\n    match value {\n        None => default,\n        Some(value) => match program_id(value) {\n            Ok(bytes) => bytes,\n            Err(error) => panic!(\"{}\", error),\n        },\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::{deployment_id, program_id};\n\n    #[test]\n    fn canonical_addresses_and_invalid_inputs() {\n        const DEFAULT: [u8; 32] = deployment_id(None, [0x41; 32]);\n        const ZERO: [u8; 32] = deployment_id(Some(\"11111111111111111111111111111111\"), [1; 32]);\n        assert_eq!(DEFAULT, [0x41; 32]);\n        assert_eq!(ZERO, [0; 32]);\n        assert_eq!(\n            program_id(\"5PjDJaGfSPJj4tFzMRCiuuAasKg5n8dJKXKenhuwZexx\"),\n            Ok([0x41; 32])\n        );\n        assert_eq!(\n            program_id(\"5bV6jUfhDHCQVA1WfKBUnXUsboJgoKgkzkKcxr3joew5\"),\n            Ok([0x44; 32])\n        );\n        for invalid in [\n            \"\",\n            \"0\",\n            \"111\",\n            \"111111111111111111111111111111111\",\n            \"zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\",\n        ] {\n            assert!(program_id(invalid).is_err(), \"{invalid}\");\n        }\n    }\n}\n"},{"id":90,"name":{"Local":"/rustc/library/core/src/panic.rs"},"crate_name":"core","contents":null},{"id":91,"name":{"Local":"/rustc/library/core/src/panicking.rs"},"crate_name":"core","contents":null},{"id":92,"name":{"Local":"/rustc/library/core/src/fmt/mod.rs"},"crate_name":"core","contents":null},{"id":93,"name":{"Local":"/rustc/library/core/src/str/mod.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["aspis_r1_cost_probe_program",0]},{"Ident":["r1_pool_adapter",0]},{"Ident":["decode_checkpoint_box",0]}]},{"key":{"Fun":1},"value":[{"Ident":["aspis_r1_cost_probe_program",0]},{"Ident":["r1_pool_adapter",0]},{"Ident":["decode_lane_from_pool_release",0]}]},{"key":{"Fun":2},"value":[{"Ident":["aspis_r1_cost_probe_program",0]},{"Ident":["r1_pool_adapter",0]},{"Ident":["decode_master_box",0]}]},{"key":{"Fun":3},"value":[{"Ident":["aspis_r1_cost_probe_program",0]},{"Ident":["r1_pool_adapter",0]},{"Ident":["owned",0]},{"Ident":["authenticate_asq8_accounts",0]}]},{"key":{"Fun":4},"value":[{"Ident":["aspis_r1_cost_probe_program",0]},{"Ident":["r1_pool_adapter",0]},{"Ident":["owned",0]},{"Ident":["authenticate_invariant_release_registry",0]}]},{"key":{"Fun":5},"value":[{"Ident":["aspis_r1_cost_probe_program",0]},{"Ident":["r1_pool_adapter",0]},{"Ident":["owned",0]},{"Ident":["validate_asq8",0]}]},{"key":{"Type":0},"value":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}]},{"key":{"Type":1},"value":[{"Ident":["aspis_statement",0]},{"Ident":["pool_v1",0]},{"Ident":["pair_forest_accounts",0]},{"Ident":["PoolV1PairForestCheckpointV1",0]}]},{"key