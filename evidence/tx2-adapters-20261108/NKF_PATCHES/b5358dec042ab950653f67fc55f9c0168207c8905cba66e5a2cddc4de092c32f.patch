+fn shape_oracle(_seed:u8,scratch:&mut u8)->Result<Box<PoolV1PairForestMasterV1>,ProgramError>{*scratch=kani::any();if kani::any(){Ok(Box::new(any_master()))}else{Err(ProgramError::InvalidAccountData)}}
