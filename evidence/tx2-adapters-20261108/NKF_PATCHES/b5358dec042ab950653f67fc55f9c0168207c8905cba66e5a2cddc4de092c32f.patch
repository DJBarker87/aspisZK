+
+#[kani::ensures(|out| true)]
+#[kani::modifies(scratch)]
+fn shape_probe(seed:u8,scratch:&mut u8)->Result<Box<PoolV1PairForestMasterV1>,ProgramError>{
+ *scratch=seed;
