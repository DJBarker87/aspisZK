                            AspisR1.OraclePortCompactDraft.Parsed → Prop :=
fun {CoreError H} {installed} {reserved} {query} {geo} {D} {hash} {semantic} {pub proof} {split} {saved} run H_1 trace
    parsed =>
  ∃ pm,
    saved =
        AspisR1.Tx2N_Reader.writer H_1 (AspisR1.MultiproofConeCanonical.bytesOf ↑proof)
          (AspisR1.MultiproofConeCanonical.bytesOf ↑pub) pm
          (AspisR1.CheckpointBytes5Output.accumulator
            (AspisR1.Tx1Q_Carriers.accumulator
              (have __src := run.out;
              { weights := ⟨↑run.flushed, ⋯⟩, rhs := __src.rhs, power := __src.power, next := __src.next }))) ∧
      (AspisR1.Port5Q1_QueryPorts.SessionAPrimitives query →
        ∀ (q : Fin 22 → Fin 262144) (raw : AspisR1.TxS_Carriers.Prefix) (rho : AspisR1.OraclePortCheckpointAbiC5.K),
          have tr := AspisR1.TxS_Carriers.toTyped raw;
          have data := AspisR1.TxS_Carriers.data (AspisR1.OraclePortStoredDecisionDraftC4.typedRows parsed q tr);
          AspisR1.Port5Q1_QueryPorts.SessionAPrepare (AspisR1.Tx1Q_Carriers.prepared run.p) data q rho →
            AspisR1.LiteralMatchingData.read (AspisR1.OraclePortStoredDecisionDraftC4.typedRows parsed q tr) =
                Option.some data →
              AspisR1.Port5Q1_GeometryCanonical.SessionAPrimitives geo →
                AspisR1.Port5Q1_Domain.SessionADomain geo →
                  geo.op9 = AspisR1Qm31ArithmeticProbe.field.M31.mul →
                    geo.op7 = Aeneas.Std.Result.ok 1#u32 →
                      geo.op11 = AspisR1.Port4C_InverseExecution.inverse_owned →
                        AspisR1.AuS1_Finish.Collision H_1 trace parsed q ∨
                          saved =
                            AspisR1.Tx2N_Reader.writer H_1 (AspisR1.MultiproofConeCanonical.bytesOf ↑proof)
                              (AspisR1.MultiproofConeCanonical.bytesOf ↑pub) pm
                              (AspisR1.OraclePortCheckpointStateC3.write
                                  (AspisR1.OraclePortCheckpointResumeC5.model data rho q)).accumulator)
