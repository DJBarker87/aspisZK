def AspisR1.TxS_Encoding.Facts : {CoreError H : Type} →
  {installed : AspisR1CurrentCaller.Ops} →
    {reserved : Bool} →
      {query : AspisR1.Port3_NativeQueryBody.Ops} →
        {geo : AspisR1.Port3_NativeGeometryBody.Ops CoreError} →
          {D : AspisR1CurrentCaller.aspis_core.digest.Digest32 H} →
            {hash : H} →
              {semantic : AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public} →
