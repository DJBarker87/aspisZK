                  {split : Aeneas.Std.Usize} →
                    {saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8} →
                      AspisR1.Tx1Q_Execution.Run installed reserved query geo D hash semantic pub proof split saved →
                        (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) → Prop :=
fun {CoreError H} {installed} {reserved} {query} {geo} {D} {hash} {semantic} {pub proof} {split} {saved} run H_1 =>
  ∃ pm,
    saved =
