AspisR1.TxS_RawPublic.of_typed : ∀ (pub proof : Aeneas.Std.Slice Aeneas.Std.U8),
  AspisR1.T2R_Public.Facts pub proof → AspisR1.TxS_RawPublic.Facts pub proof
'AspisR1.TxS_RawPublic.of_typed' depends on axioms: [propext, Classical.choice, Quot.sound]
def AspisR1.TxS_RawPublic.Facts : Aeneas.Std.Slice Aeneas.Std.U8 → Aeneas.Std.Slice Aeneas.Std.U8 → Prop :=
fun pub proof =>
  ∃ i,
    i.statement.pubBytes = AspisR1.MultiproofConeCanonical.bytesOf ↑pub ∧
      i.stored = AspisR1.MultiproofConeCanonical.bytesOf ↑proof ∧
        i.statement.tag = 2 ∧
          List.length i.statement.pubBytes = 1880 ∧
            75 + List.length i.statement.pubBytes ≤ AspisR1.SelectedTranscriptParams.L ∧
              ∀ (raw : AspisR1.TxS_Carriers.Prefix),
                raw.publicBytes = AspisR1.MultiproofConeCanonical.bytesOf ↑pub →
                  75 + List.length raw.publicBytes ≤ AspisR1.SelectedTranscriptParams.L
def AspisR1.T2R_Public.Facts : Aeneas.Std.Slice Aeneas.Std.U8 → Aeneas.Std.Slice Aeneas.Std.U8 → Prop :=
fun pub proof =>
  ∃ i,
    i.statement.pubBytes = AspisR1.MultiproofConeCanonical.bytesOf ↑pub ∧
      i.stored = AspisR1.MultiproofConeCanonical.bytesOf ↑proof ∧
        i.statement.tag = 2 ∧
          List.length i.statement.pubBytes = 1880 ∧
            75 + List.length i.statement.pubBytes ≤ AspisR1.SelectedTranscriptParams.L ∧
              ∀ (tr : AspisR1.RawCutTranscriptRun.ErasedPrefix),
                tr.statement.pubBytes = AspisR1.MultiproofConeCanonical.bytesOf ↑pub →
                  75 + List.length tr.statement.pubBytes ≤ AspisR1.SelectedTranscriptParams.L
