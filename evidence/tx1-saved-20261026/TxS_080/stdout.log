AspisR1.TxS_Nonvacuity.transcript_surjective : ∀ (tr : AspisR1.RawCutTranscriptRun.ErasedPrefix),
  ∃ raw,
    AspisR1.TxS_Carriers.toTyped raw = tr ∧
      raw.publicBytes = tr.statement.pubBytes ∧ raw.tag = tr.statement.tag ∧ raw.rounds = tr.rounds
'AspisR1.TxS_Nonvacuity.transcript_surjective' depends on axioms: [propext, Classical.choice, Quot.sound]
