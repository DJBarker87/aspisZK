AspisR1.TxS_Nonvacuity.matching_input_surjective : ∀ (rs : AspisR1.LiteralAcceptanceTerminal.TranscriptRounds)
  (i : AspisR1.R1FinalSoundness.SourceInputs),
  AspisR1.LiteralMatchingData.read rs = Option.some i.data → ∃ m, AspisR1.TxS_Carriers.source m rs = i
'AspisR1.TxS_Nonvacuity.matching_input_surjective' depends on axioms: [propext, Classical.choice, Quot.sound]
