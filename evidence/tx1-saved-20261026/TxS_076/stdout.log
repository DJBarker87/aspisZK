@AspisR1.TxS_LegacyCont.forget : ∀ {F C : Type} (adapterOps : AdapterRw.Ops) (ops : AspisR1CurrentCaller.Ops)
  (stageBase : VTop_Stages.Ops) (finishOps : AspisR1Stage2.Stage2Finish.FinishOps F) (reserved : Bool)
  (queryOps : AspisR1.Port3_NativeQueryBody.Ops) (geoOps : AspisR1.Port3_NativeGeometryBody.Ops C)
  (B : AspisR1PublicPreparation.FinishModel.Boundaries) (claimsStd : AspisR1.ClaimsUnrolledFinish.StdCalls)
  (prior : AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State Unit)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) (f : AspisR1.S2W_NativeConsolidation.FirstCut)
  (s : AspisR1.S2W_NativeConsolidation.SecondCut) (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
  (run :
    AspisR1.Tx1Q_Execution.Run
      (AspisR1.Tx1Q_Execution.actual (AspisR1.Op5T_Concrete.current ops) reserved queryOps geoOps B claimsStd) reserved
      queryOps geoOps
      (AspisR1.SdkD_PairBatches.current adapterOps ops stageBase finishOps reserved queryOps geoOps B claimsStd) ()
      (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.pub f.proof f.split saved)
  (tx2 : AspisR1.Cons_Native.Witness),
  AspisR1.TxS_ContSource.Outcome adapterOps ops stageBase finishOps reserved queryOps geoOps B claimsStd prior H f s
      saved run tx2 →
    AspisR1.T2R_ContSource.Outcome adapterOps ops stageBase finishOps reserved queryOps geoOps B claimsStd prior H f s
      saved run tx2
'AspisR1.TxS_LegacyCont.forget' depends on axioms: [propext, Classical.choice, Quot.sound]
def AspisR1.TxS_ContSource.Outcome : {F C : Type} →
  (adapterOps : AdapterRw.Ops) →
    (ops : AspisR1CurrentCaller.Ops) →
      (stageBase : VTop_Stages.Ops) →
        (finishOps : AspisR1Stage2.Stage2Finish.FinishOps F) →
          (reserved : Bool) →
            (queryOps : AspisR1.Port3_NativeQueryBody.Ops) →
              (geoOps : AspisR1.Port3_NativeGeometryBody.Ops C) →
                (B : AspisR1PublicPreparation.FinishModel.Boundaries) →
                  (claimsStd : AspisR1.ClaimsUnrolledFinish.StdCalls) →
                    AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes
                        AspisV8R19.SourceDuplexStep.State Unit →
                      (AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) →
                        (f : AspisR1.S2W_NativeConsolidation.FirstCut) →
                          AspisR1.S2W_NativeConsolidation.SecondCut →
                            (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8) →
                              AspisR1.Tx1Q_Execution.Run
                                  (AspisR1.Tx1Q_Execution.actual (AspisR1.Op5T_Concrete.current ops) reserved queryOps
                                    geoOps B claimsStd)
                                  reserved queryOps geoOps
                                  (AspisR1.SdkD_PairBatches.current adapterOps ops stageBase finishOps reserved queryOps
                                    geoOps B claimsStd)
                                  () (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.pub f.proof f.split saved →
                                AspisR1.Cons_Native.Witness → Prop :=
fun {F C} adapterOps ops stageBase finishOps reserved queryOps geoOps B claimsStd prior H f s saved run tx2 =>
  AspisR1.Port5Q1_QueryPorts.SessionAPrimitives queryOps →
    AspisR1.Port5Q1_GeometryCanonical.SessionAPrimitives geoOps →
      AspisR1.Port5Q1_Domain.SessionADomain geoOps →
        geoOps.op9 = AspisR1Qm31ArithmeticProbe.field.M31.mul →
          geoOps.op7 = Aeneas.Std.Result.ok 1#u32 →
            geoOps.op11 = AspisR1.Port4C_InverseExecution.inverse_owned →
              ∃ authParsed frame,
                AspisR1.OraclePortCompactDraft.parse (AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof) =
                    Option.some authParsed ∧
                  FS2.Duplex.Read
                      ((AspisV8R19.MemoizedProgramLaw.eval H prior).1 ++
                        AspisR1.AuS1_Recovery.log (AspisR1.Uni_Install.current ops reserved queryOps geoOps) B claimsStd
                          (AspisR1.SdkD_PairBatches.current adapterOps ops stageBase finishOps reserved queryOps geoOps
                            B claimsStd)
                          (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.proof ()
                          (Aeneas.Std.Array.repeat 29#usize run.zero))
                      frame ∧
                    AspisR1.BinRawByteCollisionTargets.pred 3 frame =
                        Option.some (AspisR1.OraclePortBatchDraft.committedRoot authParsed 2) ∧
                      AspisR1.TxS_RawTen.Outcome run H
                          ((AspisV8R19.MemoizedProgramLaw.eval H prior).1 ++
                            AspisR1.AuS1_Recovery.log (AspisR1.Uni_Install.current ops reserved queryOps geoOps) B
                              claimsStd
                              (AspisR1.SdkD_PairBatches.current adapterOps ops stageBase finishOps reserved queryOps
                                geoOps B claimsStd)
                              (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.proof ()
                              (Aeneas.Std.Array.repeat 29#usize run.zero))
                          authParsed ∧
                        AspisR1.TxS_Encoding.Model run H
                            ((AspisV8R19.MemoizedProgramLaw.eval H prior).1 ++
                              AspisR1.AuS1_Recovery.log (AspisR1.Uni_Install.current ops reserved queryOps geoOps) B
                                claimsStd
                                (AspisR1.SdkD_PairBatches.current adapterOps ops stageBase finishOps reserved queryOps
                                  geoOps B claimsStd)
                                (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.proof ()
                                (Aeneas.Std.Array.repeat 29#usize run.zero))
                            authParsed ∧
                          AspisR1.TxS_RawFinish.Outcome finishOps tx2.v2 tx2.p2
                            (have __src := tx2.returned2;
                            { weights := tx2.back2 tx2.flushed2, rhs := __src.rhs, power := __src.power,
                              next := __src.next })
                            s.proof saved H (AspisR1.MultiproofConeCanonical.bytesOf ↑f.proof)
                            (AspisR1.MultiproofConeCanonical.bytesOf ↑f.pub) run.p authParsed
                            ((AspisV8R19.MemoizedProgramLaw.eval H prior).1 ++
                              AspisR1.AuS1_Recovery.log (AspisR1.Uni_Install.current ops reserved queryOps geoOps) B
                                claimsStd
                                (AspisR1.SdkD_PairBatches.current adapterOps ops stageBase finishOps reserved queryOps
                                  geoOps B claimsStd)
                                (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.proof ()
                                (Aeneas.Std.Array.repeat 29#usize run.zero))
