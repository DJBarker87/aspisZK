+// Scratch-only native getter gate. All control fields and slots arbitrary.
+use super::*;
+#[kani::proof]
+fn NBD_registry_getters() {
+    let flags: u8 = kani::any();
+    let status_byte: u8 = kani::any();
+    let activation: u64 = kani::any();
+    let retirement: u64 = kani::any();
+    let slot: u64 = kani::any();
+    let parsed = VerifierEntryStatusV1::try_from(status_byte);
+    assert_eq!(parsed, match status_byte {
+        0 => Ok(VerifierEntryStatusV1::Pending),
+        1 => Ok(VerifierEntryStatusV1::Active),
+        2 => Ok(VerifierEntryStatusV1::Paused),
+        3 => Ok(VerifierEntryStatusV1::Retired),
+        _ => Err(PoolV1VerifierRegistryFormatError::InvalidStatus),
+    });
+    let status = match parsed { Ok(s) => s, Err(_) => return };
+    let v1 = VerifierRegistryV1 { flags, bump:kani::any(),pool:kani::any(),authority:kani::any(),policy_binding:kani::any(),generation:kani::any(),minimum_activation_delay_slots:kani::any() };
+    let v2 = VerifierRegistryV2 { flags,bump:kani::any(),pool:kani::any(),authority:kani::any(),policy_binding:kani::any(),generation:kani::any(),minimum_activation_delay_slots:kani::any(),registry_program:kani::any(),loader_program:kani::any(),programdata_address:kani::any(),programdata_bump:kani::any(),executable_hash:kani::any() };
+    assert_eq!(v1.is_paused(), flags % 2 == 1);
+    assert_eq!(v2.is_paused(), flags % 2 == 1);
+    assert_eq!(v1.is_immutable(), (flags / 2) % 2 == 1);
+    assert_eq!(v2.is_immutable(), (flags / 2) % 2 == 1);
+    let e1 = VerifierRegistryEntryV1 {status,statement_version:kani::any(),bump:kani::any(),pool:kani::any(),verifier_program:kani::any(),profile_binding:kani::any(),release_binding:kani::any(),activation_slot:activation,retirement_slot:retirement,policy_binding:kani::any()};
+    let e2 = VerifierRegistryEntryV2 {status,statement_version:kani::any(),bump:kani::any(),pool:kani::any(),verifier_program:kani::any(),profile_binding:kani::any(),release_binding:kani::any(),activation_slot:activation,retirement_slot:retirement,policy_binding:kani::any(),loader_program:kani::any(),programdata_address:kani::any(),programdata_bump:kani::any(),executable_hash:kani::any(),expected_upgrade_authority:kani::any()};
+    let no_retire = retirement == u64::MAX;
+    let active = status_byte == 1 && activation <= slot && (no_retire || slot < retirement);
+    assert_eq!(e1.has_no_retirement_slot(), no_retire);
+    assert_eq!(e2.has_no_retirement_slot(), no_retire);
+    assert_eq!(e1.is_active_at(slot), active);
+    assert_eq!(e2.is_active_at(slot), active);
+}
