'AspisR1.RawK_NativeDecision.accepted_pair' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.RawK_NativeDecision.accepted_pair : ∀ {F C : Type} (adapter : AdapterRw.Ops)
  (ops : AspisR1CurrentCaller.Ops) (stage : VTop_Stages.Ops) (finish : AspisR1Stage2.Stage2Finish.FinishOps F)
  (reserved : Bool) (query : Port3_NativeQueryBody.Ops) (geo : Port3_NativeGeometryBody.Ops C)
  (B : AspisR1PublicPreparation.FinishModel.Boundaries) (std : ClaimsUnrolledFinish.StdCalls)
  (native1 : S2W_ExtractionBoundary.First) (native2 : S2W_ExtractionBoundary.Second)
  (hashv : SdkC_Source.Parts → Result SdkC_Source.Digest),
  S2W_DigestExtraction.AeneasExtraction (GExq_Caller.sdk adapter ops stage finish reserved query geo B std) native1
      native2 hashv →
    ∀ (sha256 H : Bytes → State),
      S2W_ExtractionBoundary.P1 sha256 H →
        S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
          ∀ (id : S2W_ExtractionBoundary.Program) (accounts1 accounts2 : S2W_ExtractionBoundary.Accounts)
            (data1 data2 : Slice U8) (slot : S2W_ExtractionBoundary.Slot) (saved : alloc.vec.Vec U8),
            native1 id accounts1 data1 = ok (core.result.Result.Ok saved) →
              native2 id accounts2 data2 slot = ok (core.result.Result.Ok ()) →
                have sdk := GExq_Caller.sdk adapter ops stage finish reserved query geo B std;
                ∃ f s log,
                  S2W_NativeConsolidation.SourceCuts sdk accounts1 accounts2 saved f s ∧
                    RawJ_RecordCuts.Recorded f s saved log ∧
                      S2W_Trace.run sdk (S2W_Observation.two sdk id accounts1 data1 accounts2 data2 slot) [] =
                          ok (core.result.Result.Ok saved, log) ∧
                        ∃ sourceEntry,
                          (eval H
                                    (GExq_CallerRecord.program adapter ops stage finish reserved query geo B std hashv
                                      id accounts1 accounts2 data1 data2 slot)).1.head? =
                              some sourceEntry ∧
                            List.head? sourceEntry.1 = some 85 ∧
                              ∀ (stored : Bytes) (tr : RawCutTranscriptRun.ErasedPrefix)
                                (m : RawCutTranscriptRun.ErasedMessage),
                                (eval H (OraclePortFrozen2.dV_frozen2 stored tr m)).1.head? ≠ some sourceEntry ∧
                                  (eval H
                                        (GExq_CallerRecord.program adapter ops stage finish reserved query geo B std
                                          hashv id accounts1 accounts2 data1 data2 slot)).1 ≠
                                    (eval H (OraclePortFrozen2.dV_frozen2 stored tr m)).1 :=
fun {F C} adapter ops stage finish reserved query geo B std native1 native2 hashv extraction sha256 H p1 syscall id
    accounts1 accounts2 data1 data2 slot saved accepted1 accepted2 =>
  let ⟨f, h✝⟩ :=
    RawJ_RecordCuts.native (GExq_Caller.sdk adapter ops stage finish reserved query geo B std) native1 native2 hashv
      extraction id accounts1 accounts2 data1 data2 slot saved accepted1 accepted2
  let ⟨s, h✝¹⟩ := h✝
  let ⟨log, h✝²⟩ := h✝¹
  let ⟨cuts, right✝⟩ := h✝²
  let ⟨recorded, ran⟩ := right✝
  Exists.intro f
    (Exists.intro s
      (Exists.intro log
        ⟨cuts,
          ⟨recorded,
            ⟨ran,
              RawK_DecisionWitness.first_difference adapter ops stage finish reserved query geo B std hashv
                (S2W_DigestExtraction.native_binding (GExq_Caller.sdk adapter ops stage finish reserved query geo B std)
                  native1 native2 hashv extraction)
                sha256 H p1 syscall id accounts1 accounts2 data1 data2 slot saved f s log ran recorded⟩⟩⟩))
