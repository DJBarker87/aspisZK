AspisR1.RawK_NativeDecision.accepted_pair {F C : Type} (adapter : AdapterRw.Ops) (ops : AspisR1CurrentCaller.Ops)
  (stage : VTop_Stages.Ops) (finish : AspisR1Stage2.Stage2Finish.FinishOps F) (reserved : Bool)
  (query : AspisR1.Port3_NativeQueryBody.Ops) (geo : AspisR1.Port3_NativeGeometryBody.Ops C)
  (B : AspisR1PublicPreparation.FinishModel.Boundaries) (std : AspisR1.ClaimsUnrolledFinish.StdCalls)
  (native1 : AspisR1.S2W_ExtractionBoundary.First) (native2 : AspisR1.S2W_ExtractionBoundary.Second)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (extraction :
    AspisR1.S2W_DigestExtraction.AeneasExtraction
      (AspisR1.GExq_Caller.sdk adapter ops stage finish reserved query geo B std) native1 native2 hashv)
  (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (p1 : AspisR1.S2W_ExtractionBoundary.P1 sha256 H)
  (syscall : AspisR1.S2W_ExtractionBoundary.RuntimeSyscall hashv sha256) (id : AspisR1.S2W_ExtractionBoundary.Program)
  (accounts1 accounts2 : AspisR1.S2W_ExtractionBoundary.Accounts) (data1 data2 : Aeneas.Std.Slice Aeneas.Std.U8)
  (slot : AspisR1.S2W_ExtractionBoundary.Slot) (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
  (accepted1 : native1 id accounts1 data1 = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok saved))
  (accepted2 : native2 id accounts2 data2 slot = Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ())) :
  have sdk := AspisR1.GExq_Caller.sdk adapter ops stage finish reserved query geo B std;
  ∃ f s log,
    AspisR1.S2W_NativeConsolidation.SourceCuts sdk accounts1 accounts2 saved f s ∧
      AspisR1.RawJ_RecordCuts.Recorded f s saved log ∧
        AspisR1.S2W_Trace.run sdk (AspisR1.S2W_Observation.two sdk id accounts1 data1 accounts2 data2 slot) [] =
            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok saved, log) ∧
          ∃ sourceEntry,
            (AspisV8R19.MemoizedProgramLaw.eval H
                      (AspisR1.GExq_CallerRecord.program adapter ops stage finish reserved query geo B std hashv id
                        accounts1 accounts2 data1 data2 slot)).1.head? =
                some sourceEntry ∧
              List.head? sourceEntry.1 = some 85 ∧
                ∀ (stored : AspisV8R19.DuplexFrames.Bytes) (tr : AspisR1.RawCutTranscriptRun.ErasedPrefix)
                  (m : AspisR1.RawCutTranscriptRun.ErasedMessage),
                  (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.OraclePortFrozen2.dV_frozen2 stored tr m)).1.head? ≠
                      some sourceEntry ∧
                    (AspisV8R19.MemoizedProgramLaw.eval H
                          (AspisR1.GExq_CallerRecord.program adapter ops stage finish reserved query geo B std hashv id
                            accounts1 accounts2 data1 data2 slot)).1 ≠
                      (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.OraclePortFrozen2.dV_frozen2 stored tr m)).1
AspisR1.RawK_DecisionWitness.first_difference {F C : Type} (adapter : AdapterRw.Ops) (ops : AspisR1CurrentCaller.Ops)
  (stage : VTop_Stages.Ops) (finish : AspisR1Stage2.Stage2Finish.FinishOps F) (reserved : Bool)
  (query : AspisR1.Port3_NativeQueryBody.Ops) (geo : AspisR1.Port3_NativeGeometryBody.Ops C)
  (B : AspisR1PublicPreparation.FinishModel.Boundaries) (std : AspisR1.ClaimsUnrolledFinish.StdCalls)
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (law :
    AspisR1.S2Z.Oracle.NativeBinding (AspisR1.GExq_Caller.sdk adapter ops stage finish reserved query geo B std) hashv)
  (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (p1 : AspisR1.S2W_ExtractionBoundary.P1 sha256 H)
  (syscall : AspisR1.S2W_ExtractionBoundary.RuntimeSyscall hashv sha256) (id : AspisR1.S2W_ExtractionBoundary.Program)
  (accounts1 accounts2 : AspisR1.S2W_ExtractionBoundary.Accounts) (data1 data2 : Aeneas.Std.Slice Aeneas.Std.U8)
  (slot : AspisR1.S2W_ExtractionBoundary.Slot) (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
  (f : AspisR1.S2W_NativeConsolidation.FirstCut) (s : AspisR1.S2W_NativeConsolidation.SecondCut)
  (log : AspisR1.S2W_Trace.Log)
  (ran :
    AspisR1.S2W_Trace.run (AspisR1.GExq_Caller.sdk adapter ops stage finish reserved query geo B std)
        (AspisR1.S2W_Observation.two (AspisR1.GExq_Caller.sdk adapter ops stage finish reserved query geo B std) id
          accounts1 data1 accounts2 data2 slot)
        [] =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok saved, log))
  (recorded : AspisR1.RawJ_RecordCuts.Recorded f s saved log) :
  ∃ sourceEntry,
    (AspisV8R19.MemoizedProgramLaw.eval H
              (AspisR1.GExq_CallerRecord.program adapter ops stage finish reserved query geo B std hashv id accounts1
                accounts2 data1 data2 slot)).1.head? =
        some sourceEntry ∧
      List.head? sourceEntry.1 = some 85 ∧
        ∀ (stored : AspisV8R19.DuplexFrames.Bytes) (tr : AspisR1.RawCutTranscriptRun.ErasedPrefix)
          (m : AspisR1.RawCutTranscriptRun.ErasedMessage),
          (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.OraclePortFrozen2.dV_frozen2 stored tr m)).1.head? ≠
              some sourceEntry ∧
            (AspisV8R19.MemoizedProgramLaw.eval H
                  (AspisR1.GExq_CallerRecord.program adapter ops stage finish reserved query geo B std hashv id
                    accounts1 accounts2 data1 data2 slot)).1 ≠
              (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.OraclePortFrozen2.dV_frozen2 stored tr m)).1
AspisR1.RawJ_Numeric.zero_margin :
  1 / 2 ^ 100 - AspisR1.RawJ_Numeric.total 0 =
