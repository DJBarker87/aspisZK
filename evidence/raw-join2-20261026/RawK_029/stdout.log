'AspisR1.RawK_DecisionWitness.first_difference' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.RawK_DecisionWitness.first_difference : ∀ {F C : Type} (adapter : AdapterRw.Ops)
  (ops : AspisR1CurrentCaller.Ops) (stage : VTop_Stages.Ops) (finish : AspisR1Stage2.Stage2Finish.FinishOps F)
  (reserved : Bool) (query : Port3_NativeQueryBody.Ops) (geo : Port3_NativeGeometryBody.Ops C)
  (B : AspisR1PublicPreparation.FinishModel.Boundaries) (std : ClaimsUnrolledFinish.StdCalls)
  (hashv : SdkC_Source.Parts → Result SdkC_Source.Digest),
  S2Z.Oracle.NativeBinding (GExq_Caller.sdk adapter ops stage finish reserved query geo B std) hashv →
    ∀ (sha256 H : Bytes → State),
      S2W_ExtractionBoundary.P1 sha256 H →
        S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
          ∀ (id : S2W_ExtractionBoundary.Program) (accounts1 accounts2 : S2W_ExtractionBoundary.Accounts)
            (data1 data2 : Slice U8) (slot : S2W_ExtractionBoundary.Slot) (saved : alloc.vec.Vec U8)
            (f : S2W_NativeConsolidation.FirstCut) (s : S2W_NativeConsolidation.SecondCut) (log : S2W_Trace.Log),
            S2W_Trace.run (GExq_Caller.sdk adapter ops stage finish reserved query geo B std)
                  (S2W_Observation.two (GExq_Caller.sdk adapter ops stage finish reserved query geo B std) id accounts1
                    data1 accounts2 data2 slot)
                  [] =
                ok (core.result.Result.Ok saved, log) →
              RawJ_RecordCuts.Recorded f s saved log →
                ∃ sourceEntry,
                  (eval H
                            (GExq_CallerRecord.program adapter ops stage finish reserved query geo B std hashv id
                              accounts1 accounts2 data1 data2 slot)).1.head? =
                      some sourceEntry ∧
                    List.head? sourceEntry.1 = some 85 ∧
                      ∀ (stored : Bytes) (tr : RawCutTranscriptRun.ErasedPrefix)
                        (m : RawCutTranscriptRun.ErasedMessage),
                        (eval H (OraclePortFrozen2.dV_frozen2 stored tr m)).1.head? ≠ some sourceEntry ∧
                          (eval H
                                (GExq_CallerRecord.program adapter ops stage finish reserved query geo B std hashv id
                                  accounts1 accounts2 data1 data2 slot)).1 ≠
                            (eval H (OraclePortFrozen2.dV_frozen2 stored tr m)).1 :=
fun {F C} adapter ops stage finish reserved query geo B std hashv law sha256 H p1 syscall id accounts1 accounts2 data1
    data2 slot saved f s log ran recorded =>
  let ⟨entry, h✝⟩ :=
    RawK_ContainingHead.first adapter ops stage finish reserved query geo B std hashv law id accounts1 accounts2 data1
      data2 slot saved f s log ran recorded
  let ⟨h, tag⟩ := h✝
  have exactRun :=
    RawJ_OriginalAccepted.accepted adapter ops stage finish reserved query geo B std hashv law sha256 H p1 syscall id
      accounts1 accounts2 data1 data2 slot saved f s log ran recorded;
  have sourceHead := Eq.mpr (_root_.id (congrArg (fun _a => _a.1.head? = some entry) exactRun)) h;
  Exists.intro entry
    ⟨sourceHead,
      ⟨tag, fun stored tr m =>
        have diff := RawK_ModelAll.different H stored tr m entry tag;
        ⟨diff, fun equal => diff (Eq.trans (Eq.symm (congrArg List.head? equal)) sourceHead)⟩⟩⟩
