def Aeneas.Std.lift.{u} : {α : Type u} → α → Result α :=
fun {α} x => ok x
Aeneas.Std.Usize.wrapping_add (x y : Usize) : Usize
Aeneas.Std.Usize.wrapping_add (x y : Usize) : Usize
def AdapterRw.r1_pool_adapter.owned.require_zero_loop.body : Slice U8 →
  Usize → Result (ControlFlow Usize (Option (core.result.Result Unit AdapterRw.solana_program_error.ProgramError))) :=
fun bytes index =>
  have i := bytes.len;
  if index < i then do
    let i1 ← bytes.index_usize index
    if (i1 != 0#u8) = true then
        ok
          (ControlFlow.done
            (some (core.result.Result.Err AdapterRw.solana_program_error.ProgramError.AccountAlreadyInitialized)))
      else do
        let index1 ← lift (index.wrapping_add 1#usize)
        ok (ControlFlow.cont index1)
  else ok (ControlFlow.done none)
