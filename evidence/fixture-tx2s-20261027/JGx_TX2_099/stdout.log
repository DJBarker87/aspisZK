theorem AspisR1.JGx_TX2.accepted2 : ∀ {C : Type} (c : AspisR1.DrvC_Installation.Configuration AspisR1.FIo_Install.W C)
  (err : C) (headerBytes : Aeneas.Std.Array Aeneas.Std.U8 688#usize) (data : Aeneas.Std.Slice Aeneas.Std.U8)
  (slot : AspisR1.S2W_ExtractionBoundary.Slot),
  AspisR1.JGx_MagicGate.value
        (AspisR1.DrvC_Installation.sdk (AspisR1.JGx_Configuration.value (AspisR1.JGx_CallerSeed.value c) err)) data =
      Aeneas.Std.Result.ok false →
    AdapterRw.r1_pool_adapter.owned.validate_asq8
          (AspisR1.DrvC_Installation.sdk (AspisR1.JGx_Configuration.value (AspisR1.JGx_CallerSeed.value c) err))
          AspisR1.CPH_Program.verifier
          ((AspisR1.JFv_World.e2 (AspisR1.JGx_ProofAccount.value headerBytes)).second
            AspisR1.S2W_D189Wrappers.secondSizes)
          data slot =
        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok AspisR1.JGx_Validated.value) →
      (AspisR1.DrvC_Installation.sdk (AspisR1.JGx_Configuration.value (AspisR1.JGx_CallerSeed.value c) err)).op53
            AspisR1.JGx_RealStatement.value =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) →
        AspisR1.JFn_HashBoundary.Realizes AspisR1.JFp_SHADigest.digest →
          AspisR1.S2W_D189Wrappers.second (AspisR1.JGx_Natives.second (AspisR1.JGx_CallerSeed.value c) err)
              AspisR1.CPH_FixtureData.allocator (AspisR1.JFv_World.e2 (AspisR1.JGx_ProofAccount.value headerBytes))
              AspisR1.CPH_Program.verifier data slot () =
            Aeneas.Std.Result.ok
              (Aeneas.Std.core.result.Result.Ok
                ((AspisR1.JFv_World.e2 (AspisR1.JGx_ProofAccount.value headerBytes)).heap, ())) :=
fun {C} c err headerBytes data slot magic validation emitted realizes =>
  AspisR1.JGx_SecondWrapper.source (AspisR1.JGx_Natives.second (AspisR1.JGx_CallerSeed.value c) err)
    AspisR1.CPH_FixtureData.allocator (AspisR1.JFv_World.e2 (AspisR1.JGx_ProofAccount.value headerBytes))
    AspisR1.CPH_Program.verifier data slot () () ()
    (AspisR1.CPH_FixtureReserve.reserve_ok
      (AspisR1.S2W_D189Wrappers.admittedSizes (AspisR1.JFv_World.e2 (AspisR1.JGx_ProofAccount.value headerBytes)) 7
        AspisR1.S2W_D189Wrappers.secondSizes))
    (Eq.trans (AspisR1.JGx_RealNative.source c err headerBytes data slot magic validation realizes) emitted) rfl
theorem AspisR1.JGx_JointPair.source : ∀ {C : Type}
  (c : AspisR1.DrvC_Installation.Configuration AspisR1.FIo_Install.W C) (err : C)
  (headerBytes : Aeneas.Std.Array Aeneas.Std.U8 688#usize) (data1 data2 : Aeneas.Std.Slice Aeneas.Std.U8)
  (slot : AspisR1.S2W_ExtractionBoundary.Slot) (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
  (post1 : AspisR1.S2Trust.Heap (ℕ → AspisR1.S2W_D189Entry.Record)),
  AspisR1.S2W_D189Wrappers.first (AspisR1.JGx_Natives.first (AspisR1.JGx_CallerSeed.value c) err)
        AspisR1.CPH_FixtureData.copy AspisR1.CPH_FixtureData.allocator
        (AspisR1.JFv_World.e1 (AspisR1.JGx_ProofAccount.value headerBytes)) AspisR1.CPH_Program.verifier data1 () =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post1, ())) →
    ↑saved = ↑AspisR1.JFx_NativeBytes.checkpoint →
      AspisR1.JGx_MagicGate.value
            (AspisR1.DrvC_Installation.sdk (AspisR1.JGx_Configuration.value (AspisR1.JGx_CallerSeed.value c) err))
            data2 =
          Aeneas.Std.Result.ok false →
        AdapterRw.r1_pool_adapter.owned.validate_asq8
              (AspisR1.DrvC_Installation.sdk (AspisR1.JGx_Configuration.value (AspisR1.JGx_CallerSeed.value c) err))
              AspisR1.CPH_Program.verifier
              ((AspisR1.JFv_World.e2 (AspisR1.JGx_ProofAccount.value headerBytes)).second
                AspisR1.S2W_D189Wrappers.secondSizes)
              data2 slot =
            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok AspisR1.JGx_Validated.value) →
          (AspisR1.DrvC_Installation.sdk (AspisR1.JGx_Configuration.value (AspisR1.JGx_CallerSeed.value c) err)).op53
                AspisR1.JGx_RealStatement.value =
              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) →
            AspisR1.JFn_HashBoundary.Realizes AspisR1.JFp_SHADigest.digest →
              AspisR1.S2W_D189Wrappers.first (AspisR1.JGx_Natives.first (AspisR1.JGx_CallerSeed.value c) err)
                    AspisR1.CPH_FixtureData.copy AspisR1.CPH_FixtureData.allocator
                    (AspisR1.JFv_World.e1 (AspisR1.JGx_ProofAccount.value headerBytes)) AspisR1.CPH_Program.verifier
                    data1 () =
                  Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (saved, post1, ())) ∧
                ↑saved = ↑AspisR1.JFx_NativeBytes.checkpoint ∧
                  AspisR1.S2W_D189Wrappers.second (AspisR1.JGx_Natives.second (AspisR1.JGx_CallerSeed.value c) err)
                      AspisR1.CPH_FixtureData.allocator
                      (AspisR1.JFv_World.e2 (AspisR1.JGx_ProofAccount.value headerBytes)) AspisR1.CPH_Program.verifier
                      data2 slot () =
                    Aeneas.Std.Result.ok
                      (Aeneas.Std.core.result.Result.Ok
                        ((AspisR1.JFv_World.e2 (AspisR1.JGx_ProofAccount.value headerBytes)).heap, ())) :=
fun {C} c err headerBytes data1 data2 slot saved post1 accepted1 same magic validation emitted realizes =>
  ⟨accepted1, ⟨same, AspisR1.JGx_TX2.accepted2 c err headerBytes data2 slot magic validation emitted realizes⟩⟩
