"line":911,"col":4},"end":{"line":914,"col":36}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Create a valid [program derived address][pda] without searching for a bump seed."},{"DocComment":""},{"DocComment":" [pda]: https://solana.com/docs/core/cpi#program-derived-addresses"},{"DocComment":""},{"DocComment":" Because this function does not create a bump seed, it may unpredictably"},{"DocComment":" return an error for any given set of seeds and is not generally suitable"},{"DocComment":" for creating program derived addresses."},{"DocComment":""},{"DocComment":" However, it can be used for efficiently verifying that a set of seeds plus"},{"DocComment":" bump seed generated by [`find_program_address`] derives a particular"},{"DocComment":" address as expected. See the example for details."},{"DocComment":""},{"DocComment":" See the documentation for [`find_program_address`] for a full description"},{"DocComment":" of program derived addresses and bump seeds."},{"DocComment":""},{"DocComment":" [`find_program_address`]: Pubkey::find_program_address"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Creating a program derived address involves iteratively searching for a"},{"DocComment":" bump seed for which the derived [`Pubkey`] does not lie on the ed25519"},{"DocComment":" curve. This search process is generally performed off-chain, with the"},{"DocComment":" [`find_program_address`] function, after which the client passes the"},{"DocComment":" bump seed to the program as instruction data."},{"DocComment":""},{"DocComment":" Depending on the application requirements, a program may wish to verify"},{"DocComment":" that the set of seeds, plus the bump seed, do correctly generate an"},{"DocComment":" expected address."},{"DocComment":""},{"DocComment":" The verification is performed by appending to the other seeds one"},{"DocComment":" additional seed slice that contains the single `u8` bump seed, calling"},{"DocComment":" `create_program_address`, checking that the return value is `Ok`, and"},{"DocComment":" that the returned `Pubkey` has the expected value."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use solana_pubkey::Pubkey;"},{"DocComment":" # let program_id = Pubkey::new_unique();"},{"DocComment":" let (expected_pda, bump_seed) = Pubkey::find_program_address(&[b\"vault\"], &program_id);"},{"DocComment":" let actual_pda = Pubkey::create_program_address(&[b\"vault\", &[bump_seed]], &program_id)?;"},{"DocComment":" assert_eq!(expected_pda, actual_pda);"},{"DocComment":" # Ok::<(), anyhow::Error>(())"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[4946,{"Ref":[{"Var":{"Free":0}},{"HashConsedValue":[4945,{"Slice":{"HashConsedValue":[4944,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":1484},"Shared"]}]}}]},"Shared"]}]},{"HashConsedValue":[4947,{"Ref":[{"Var":{"Free":2}},{"Deduplicated":497},"Shared"]}]}],"output":{"Deduplicated":1529}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":18,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["impls",0]},{"Impl":{"Trait":25}},{"Ident":["ne",0]}],"span":{"data":{"file_id":17,"beg":{"line":2126,"col":8},"end":{"line":2126,"col":40}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"U