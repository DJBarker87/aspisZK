ed_from_span":null},"bound_body_regions":0,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":0,"beg":{"line":212,"col":16},"end":{"line":212,"col":16}},"generated_from_span":null},"ty":{"Deduplicated":1239}},{"index":1,"name":null,"span":{"data":{"file_id":0,"beg":{"line":212,"col":13},"end":{"line":212,"col":49}},"generated_from_span":null},"ty":{"Deduplicated":1942}},{"index":2,"name":"tupled_args","span":{"data":{"file_id":0,"beg":{"line":0,"col":0},"end":{"line":0,"col":0}},"generated_from_span":null},"ty":{"Deduplicated":2429}},{"index":3,"name":null,"span":{"data":{"file_id":0,"beg":{"line":212,"col":14},"end":{"line":212,"col":15}},"generated_from_span":null},"ty":{"Deduplicated":1528}}]},"body":{"span":{"data":{"file_id":0,"beg":{"line":212,"col":13},"end":{"line":212,"col":49}},"generated_from_span":null},"statements":[{"span":{"data":{"file_id":0,"beg":{"line":212,"col":13},"end":{"line":212,"col":49}},"generated_from_span":null},"id":11917,"kind":{"StorageLive":0},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":212,"col":13},"end":{"line":212,"col":49}},"generated_from_span":null},"id":11918,"kind":{"StorageLive":3},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":212,"col":13},"end":{"line":212,"col":49}},"generated_from_span":null},"id":11919,"kind":{"Assign":[{"kind":{"Local":3},"ty":{"Deduplicated":1528}},{"Use":[{"Move":{"kind":{"Projection":[{"kind":{"Local":2},"ty":{"Deduplicated":2429}},{"Field":[{"Tuple":1},0]}]},"ty":{"Deduplicated":1528}}},"No"]}]},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":212,"col":17},"end":{"line":212,"col":49}},"generated_from_span":null},"id":11920,"kind":{"Assign":[{"kind":{"Local":0},"ty":{"Deduplicated":1239}},{"Aggregate":[{"Adt":[{"id":{"Adt":4},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}},3,null]},[]]}]},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":212,"col":49},"end":{"line":212,"col":49}},"generated_from_span":null},"id":11921,"kind":{"StorageDead":3},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":212,"col":49},"end":{"line":212,"col":49}},"generated_from_span":null},"id":11922,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":212,"col":49},"end":{"line":212,"col":49}},"generated_from_span":null},"id":11923,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":212,"col":49},"end":{"line":212,"col":49}},"generated_from_span":null},"id":11924,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":38,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hint",0]},{"Ident":["black_box",0]}],"span":{"data":{"file_id":26,"beg":{"line":490,"col":0},"end":{"line":490,"col":40}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An identity function that *__hints__* to the compiler to be maximally pessimistic about what"},{"DocComment":" `black_box` could do."},{"DocComment":""},{"DocComment":" Unlike [`std::convert::identity`], a Rust compiler is encouraged to assume that `black_box` can"},{"DocComment":" use `dummy` in any possible valid way that Rust code is allowed to without introducing undefined"},{"DocComment":" behavior in the calling code. This property makes `black_box` useful for writing code in which"},{"DocComment":" certain optimizations are not desired, such as benchmarks."},{"DocComment":""},{"DocComment":" <div class=\"warning\">"},{"DocComment":""},{"DocComment":" Note however, that `black_box` is only (and can only be) provided on a \"best-effort\" basis. The"},{"DocComment":" extent to which it can block optimisations may vary depending upon the platform and code-gen"},{"DocComment":" backend used. Programs cannot rely on `black_box` for *correctness*, beyond it behaving as the"},{"DocComment":" identity function. As such, it **must not be relied upon to control critical program behavior.**"},{"DocComment":" This also means that this function does not offer any guarantees for cryptographic or security"},{"DocComment":" purposes."},{"DocComment":""},{"DocComment":" This limitation is not specific to `black_box`; there is no mechanism in the entire Rust"},{"DocComment":" language that can provide the guarantees required for constant-time cryptography."},{"DocComment":" (There is also no such mechanism in LLVM, so the same is true for every other LLVM-based compiler.)"},{"DocComment":""},{"DocComment":" </div>"},{"DocComment":""},{"DocComment":" [`std::convert::identity`]: crate::convert::identity"},{"DocComment":""},{"DocComment":" # When is this useful?"},{"DocComment":""},{"DocComment":" While not suitable in those mission-critical cases, `black_box`'s functionality can generally be"},{"DocComment":" relied upon for benchmarking, and should be used there. It will try to ensure that the"},{"DocComment":" compiler doesn't optimize away part of the intended test code based on context. For"},{"DocComment":" example:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn contains(haystack: &[&str], needle: &str) -> bool {"},{"DocComment":"     haystack.iter().any(|x| x == &needle)"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" pub fn benchmark() {"},{"DocComment":"     let haystack = vec![\"abc\", \"def\", \"ghi\", \"jkl\", \"mno\"];"},{"DocComment":"     let needle = \"ghi\";"},{"DocComment":"     for _ in 0..10 {"},{"DocComment":"         contains(&haystack, needle);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The compiler could theoretically make optimizations like the following:"},{"DocComment":""},{"DocComment":" - The `needle` and `haystack` do not change, move the call to `contains` outside the loop and"},{"DocComment":"   delete the loop"},{"DocComment":" - Inline `contains`"},{"DocComment":" - `needle` and `haystack` have values known at compile time, `contains` is always true. Remove"},{"DocComment":"   the call and replace with `true`"},{"DocComment":" - Nothing is done with the result of `contains`: delete this function call entirely"},{"DocComment":" - `benchmark` now has no purpose: delete this function"},{"DocComment":""},{"DocComment":" It is not likely that all of the above happens, but the compiler is definitely able to make some"},{"DocComment":" optimizations that could result in a very inaccurate benchmark. This is where `black_box` comes"},{"DocComment":" in:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::hint::black_box;"},{"DocComment":""},{"DocComment":" // Same `contains` function."},{"DocComment":" fn contains(haystack: &[&str], needle: &str) -> bool {"},{"DocComment":"     haystack.iter().any(|x| x == &needle)"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" pub fn benchmark() {"},{"DocComment":"     let haystack = vec![\"abc\", \"def\", \"ghi\", \"jkl\", \"mno\"];"},{"DocComment":"     let needle = \"ghi\";"},{"DocComment":"     for _ in 0..10 {"},{"DocComment":"         // Force the compiler to run `contains`, even though it is a pure function whose"},{"DocComment":"         // results are unused."},{"DocComment":"         black_box(contains("},{"DocComment":"             // Prevent the compiler from making assumptions about the input."},{"DocComment":"             black_box(&haystack),"},{"DocComment":"             black_box(needle),"},{"DocComment":"         ));"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This essentially tells the compiler to block optimizations across any calls to `black_box`. So,"},{"DocComment":" it now:"},{"DocComment":""},{"DocComment":" - Treats both arguments to `contains` as unpredictable: the body of `contains` can no longer be"},{"DocComment":"   optimized based on argument values"},{"DocComment":" - Treats the call to `contains` and its result as volatile: the body of `benchmark` cannot"},{"DocComment":"   optimize this away"},{"DocComment":""},{"DocComment":" This makes our benchmark much more realistic to how the function would actually be used, where"},{"DocComment":" arguments are usually not known at compile time and the result is used in some way."},{"DocComment":""},{"DocComment":" # How to use this"},{"DocComment":""},{"DocComment":" In practice, `black_box` serves two purposes:"},{"DocComment":""},{"DocComment":" 1. It prevents the compiler from making optimizations related to the value returned by `black_box`"},{"DocComment":" 2. It forces the value passed to `black_box` to be calculated, even if the return value of `black_box` is unused"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::hint::black_box;"},{"DocComment":""},{"DocComment":" let zero = 0;"},{"DocComment":" let five = 5;"},{"DocComment":""},{"DocComment":" // The compiler will see this and remove the `* five` call, because it knows that multiplying"},{"DocComment":" // any integer by 0 will result in 0."},{"DocComment":" let c = zero * five;"},{"DocComment":""},{"DocComment":" // Adding `black_box` here disables the compiler's ability to reason about the first operand in the multiplication."},{"DocComment":" // It is forced to assume that it can be any possible number, so it cannot remove the `* five`"},{"DocComment":" // operation."},{"DocComment":" let c = black_box(zero) * five;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" While most cases will not be as clear-cut as the above example, it still illustrates how"},{"DocComment":" `black_box` can be used. When benchmarking a function, you usually want to wrap its inputs in"},{"DocComment":" `black_box` so the compiler cannot make optimizations that would be unrealistic in real-life"},{"DocComment":" use."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::hint::black_box;"},{"DocComment":""},{"DocComment":" // This is a simple function that increments its input by 1. Note that it is pure, meaning it"},{"DocComment":" // has no side-effects. This function has no effect if its result is unused. (An example of a"},{"DocComment":" // function *with* side-effects is `println!()`.)"},{"DocComment":" fn increment(x: u8) -> u8 {"},{"DocComment":"     x + 1"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Here, we call `increment` but discard its result. The compiler, seeing this and knowing that"},{"DocComment":" // `increment` is pure, will eliminate this function call entirely. This may not be desired,"},{"DocComment":" // though, especially if we're trying to track how much time `increment` takes to execute."},{"DocComment":" let _ = increment(black_box(5));"},{"DocComment":""},{"DocComment":" // Here, we force `increment` to be executed. This is because the compiler treats `black_box`"},{"DocComment":" // as if it has side-effects, and thus must compute its input."},{"DocComment":" let _ = black_box(increment(black_box(5)));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There may be additional situations where you want to wrap the result of a function in"},{"DocComment":" `black_box` to force its execution. This is situational though, and may not have any effect"},{"DocComment":" (such as when the function returns a zero-sized type such as [`()` unit][unit])."},{"DocComment":""},{"DocComment":" Note that `black_box` has no effect on how its input is treated, only its output. As such,"},{"DocComment":" expressions passed to `black_box` may still be optimized:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::hint::black_box;"},{"DocComment":""},{"DocComment":" // The compiler sees this..."},{"DocComment":" let y = black_box(5 * 10);"},{"DocComment":""},{"DocComment":" // ...as this. As such, it will likely simplify `5 * 10` to just `50`."},{"DocComment":" let _0 = 5 * 10;"},{"DocComment":" let y = black_box(_0);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In the above example, the `5 * 10` expression is considered distinct from the `black_box` call,"},{"DocComment":" and thus is still optimized by the compiler. You can prevent this by moving the multiplication"},{"DocComment":" operation outside of `black_box`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::hint::black_box;"},{"DocComment":""},{"DocComment":" // No assumptions can be made about either operand, so the multiplication is not optimized out."},{"DocComment":" let y = black_box(5) * black_box(10);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" During constant evaluation, `black_box` is treated as a no-op."}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":4846}],"output":{"Deduplicated":4846}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":39,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["equality",0]},{"Impl":{"Trait":11}},{"Ident":["eq",0]}],"span":{"data":{"file_id":15,"beg":{"line":10,"col":4},"end":{"line":10,"col":40}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"},{"index":1,"name":"U"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":1256}}],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":15,"beg":{"line":7,"col":7},"end":{"line":7,"col":27}},"generated_from_span":null},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":4846},{"Deduplicated":4847}