erator::enumerate"},{"DocComment":" [`Iterator`]: trait.Iterator.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Enumerate"},"generics":{"regions":[],"types":[{"index":0,"name":"I"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":19,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["iter",0]},{"Ident":["IterMut",0]}],"span":{"data":{"file_id":13,"beg":{"line":192,"col":0},"end":{"line":192,"col":29}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Mutable slice iterator."},{"DocComment":""},{"DocComment":" This struct is created by the [`iter_mut`] method on [slices]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // First, we need a slice to call the `iter_mut` method on:"},{"DocComment":" let slice = &mut [1, 2, 3];"},{"DocComment":""},{"DocComment":" // Then we call `iter_mut` on the slice to get the `IterMut` iterator,"},{"DocComment":" // iterate over it and increment each element value:"},{"DocComment":" for element in slice.iter_mut() {"},{"DocComment":"     *element += 1;"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // We now have \"[2, 3, 4]\":"},{"DocComment":" println!(\"{slice:?}\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`iter_mut`]: slice::iter_mut"},{"DocComment":" [slices]: slice"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Mutable"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":8767},{"Var":{"Free":0}}]},{"regions":[],"skip_binder":[{"Dedu