4,"col":36}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Create a valid [program derived address][pda] without searching for a bump seed."},{"DocComment":""},{"DocComment":" [pda]: https://solana.com/docs/core/cpi#program-derived-addresses"},{"DocComment":""},{"DocComment":" Because this function does not create a bump seed, it may unpredictably"},{"DocComment":" return an error for any given set of seeds and is not generally suitable"},{"DocComment":" for creating program derived addresses."},{"DocComment":""},{"DocComment":" However, it can be used for efficiently verifying that a set of seeds plus"},{"DocComment":" bump seed generated by [`find_program_address`] derives a particular"},{"DocComment":" address as expected. See the example for details."},{"DocComment":""},{"DocComment":" See the documentation for [`find_program_address`] for a full description"},{"DocComment":" of program derived addresses and bump seeds."},{"DocComment":""},{"DocComment":" [`find_program_address`]: Pubkey::find_program_address"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Creating a program derived address involves iteratively searching for a"},{"DocComment":" bump seed for which the derived [`Pubkey`] does not lie on the ed25519"},{"DocComment":" curve. This search process is generally performed off-chain, with the"},{"DocComment":" [`find_program_address`] function, after which the client passes the"},{"DocComment":" bump seed to the program as instruction data."},{"DocComment":""},{"DocComment":" Depending on the application requirements, a program may wish to verify"},{"DocComment":" that the set of seeds, plus the bump seed, do correctly generate an"},{"DocComment":" expected address."},{"DocComment":""},{"DocComment":" The verification is performed by appending to the other seeds one"},{"DocComment":" additional seed slice that contains the single `u8` bump seed, calling"},{"DocComment":" `create_program_address`, checking that the return value is `Ok`, and"},{"DocComment":" that the returned `Pubkey` has the expected value."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use solana_pubkey::Pubkey;"},{"DocComment":" # let program_id = Pubkey::new_unique();"},{"DocComment":" let (expected_pda, bump_seed) = Pubkey::find_program_address(&[b\"vault\"], &program_id);"},{"DocComment":" let actual_pda = Pubkey::create_program_address(&[b\"vault\", &[bump_seed]], &program_id)?;"},{"DocComment":" assert_eq!(expected_pda, actual_pda);"},{"DocComment":" # Ok::<(), anyhow::Error>(())"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[4959,{"Ref":[{"Var":{"Free":0}},{"HashConsedValue":[4958,{"Slice":{"HashConsedValue":[4957,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":1463},"Shared"]}]}}]},"Shared"]}]},{"Deduplicated":4911}],"output":{"Deduplicated":1508}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":16,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["result",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"},{"index":1,"name":"E"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":2437},"kind":"InherentImplBlock"}}},{"Ident":["map_err",0]}],"span":{"data":{"file_id":4,"beg":{"line":962,"col":4},"end":{"line":964,"col":53}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Maps a `Result<T, E>` to `Result<T, F>` by applying a function to a"},{"DocComment":" contained [`Err`] value, leaving an [`Ok`] value untouched."},{"DocComment":""},{"DocComment":" This function can be used to pass through a successful result while handling"},{"DocComment":" an error."},{"DocComment":""},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn stringify(x: u32) -> String { format!(\"error code: {x}\") }"},{"DocComment":""},{"DocComment":" let x: Result<u32, u32> = Ok(2);"},{"DocComment":" assert_eq!(x.map_err(stringify), Ok(2));"},{"DocComment":""},{"DocComment":" let x: Result<u32, u32> = Err(13);"},{"DocComment":" assert_eq!(x.map_err(stringify), Err(\"error code: 13\".to_string()));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T"},{"index":1,"name":"E"},{"index":2,"name":"F"},{"index":3,"name":"O"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":4,"beg":{"line":964,"col":11},"end":{"line":964,"col":33}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"HashConsedValue":[4960,{"TypeVar":{"Free":3}}]},{"HashConsedValue":[4961,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":4873}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":4883}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":4,"beg":{"line":964,"col":36},"end":{"line":964,"col":52}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":4960}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":4877},{"Deduplicated":4960}],"output":{"Deduplicated":4884}},"src"