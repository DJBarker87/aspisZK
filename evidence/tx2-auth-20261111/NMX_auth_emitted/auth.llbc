al":"/rustc/library/core/src/ops/function.rs"},"crate_name":"core","contents":null},{"id":26,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":27,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":28,"name":{"Local":"crates/aspis-statement/src/pool_v1/incremental_merkle.rs"},"crate_name":"aspis_statement","contents":null},{"id":29,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":30,"name":{"Local":"/rustc/library/alloc/src/string.rs"},"crate_name":"alloc","contents":null},{"id":31,"name":{"Local":"/rustc/library/core/src/ops/try_trait.rs"},"crate_name":"core","contents":null},{"id":32,"name":{"Local":"crates/aspis-r1-cost-probe/src/transport.rs"},"crate_name":"aspis_r1_cost_probe","contents":null},{"id":33,"name":{"Local":"crates/aspis-r1-cost-probe/src/lib.rs"},"crate_name":"aspis_r1_cost_probe","contents":null},{"id":34,"name":{"Local":"crates/aspis-r1-cost-probe/src/verifier.rs"},"crate_name":"aspis_r1_cost_probe","contents":null},{"id":35,"name":{"Local":"/rustc/library/core/src/ptr/mod.rs"},"crate_name":"core","contents":null},{"id":36,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":37,"name":{"Local":"/rustc/library/core/src/ops/deref.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["aspis_r1_cost_probe_program",0]},{"Ident":["r1_pool_adapter",0]},{"Ident":["owned",0]},{"Ident":["authenticate_asq8_accounts",0]}]},{"key":{"Type":0},"value":[{"Ident":["solana_pubkey",0]},{"Ident":["Pubkey",0]}]},{"key":{"Type":1},"value":[{"Ident":["aspis_r1_cost_probe_program",0]},{"Ident":["r1_pool_adapter",0]},{"Ident":["owned",0]},{"Ident":["OwnedAccount",0]}]},{"key":{"Type":2},"value":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}]},{"key":{"Type":3},"value":[{"Ident":["aspis_r1_cost_probe_program",0]},{"Ident":["r