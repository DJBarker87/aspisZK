theorem R1Z.PV_OWNM_V239.restore : ∀ {K W : Type} [inst : Field K] (decode : R1Z.PV_OWNM_V239.Q → K)
  (zero : R1Z.PV_OWNM_V239.Q)
  (source222 : List R1Z.PV_OWNM_V239.Q → List R1Z.PV_OWNM_V239.Q → Aeneas.Std.Result (Option R1Z.PV_OWNM_V239.Q))
  (wirePoints : List R1Z.PV_OWNM_V239.Q → List (List R1Z.PV_OWNM_V239.Q)) (isBoolean : R1Z.PV_OWNM_V239.Q → Bool)
  (reconstruct879 reconstruct890 : R1Z.PV_OWNM_V239.Public → List R1Z.PV_OWNM_V239.Q)
  (native : R1Z.PV_OWNM_V239.Input → List R1Z.PV_OWNM_V239.Q → ℕ → R1Z.PV_OWNM_V239.Execution K W)
  (resource : R1Z.PV_OWNM_V239.Input → List R1Z.PV_OWNM_V239.Q → ℕ → R1Z.PV_OWNM_V239.ResourceExit W)
  (failures : List Bool) (left right : R1Z.PV_OWNM_V239.Input),
  R1Z.PV_OWNM_V239.PV_OWNM_Link_ActualInput wirePoints left →
    R1Z.PV_OWNM_V239.PV_OWNM_Link_ActualInput wirePoints right →
      R1Z.PV_OWNM_V239.PV_OWNM_Link_SourceDense decode zero source222 →
        R1Z.PV_OWNM_V239.PV_OWNM_Link_Transcript879 reconstruct879 left →
          R1Z.PV_OWNM_V239.PV_OWNM_Link_Transcript879 reconstruct879 right →
            R1Z.PV_OWNM_V239.PV_OWNM_Link_Transcript890 reconstruct890 left →
              R1Z.PV_OWNM_V239.PV_OWNM_Link_Transcript890 reconstruct890 right →
                R1Z.PV_OWNM_V239.PV_OWNM_Link_OwnedPublicPlan decode source222 wirePoints isBoolean native resource
                    failures left →
                  R1Z.PV_OWNM_V239.PV_OWNM_Link_OwnedPublicPlan decode source222 wirePoints isBoolean native resource
                      failures right →
                    left.pubData = right.pubData →
                      left.site = right.site →
                        List.map List.length left.columns = List.map List.length right.columns →
                          (∀ p ∈ wirePoints left.point,
                              ∀ (lane : ℕ) (c : List R1Z.PV_OWNM_V239.Q),
                                left.columns[lane]? = some c →
                                  native left p lane =
                                    R1Z.PV_OWNM_V239.attach (resource left p lane)
                                      (Aeneas.Std.Result.ok
                                        (if c.length ≠ 1024 then none
                                        else some (R1Z.PV_OWNM_V239.dense decode zero p c)))) ∧
                            (∀ p ∈ wirePoints right.point,
                                ∀ (lane : ℕ) (c : List R1Z.PV_OWNM_V239.Q),
                                  right.columns[lane]? = some c →
                                    native right p lane =
                                      R1Z.PV_OWNM_V239.attach (resource right p lane)
                                        (Aeneas.Std.Result.ok
                                          (if c.length ≠ 1024 then none
                                          else some (R1Z.PV_OWNM_V239.dense decode zero p c)))) ∧
                              ∀ pL ∈ wirePoints left.point,
                                ∀ pR ∈ wirePoints right.point,
                                  ∀ (laneL laneR : ℕ) (cL cR : List R1Z.PV_OWNM_V239.Q),
                                    left.columns[laneL]? = some cL →
                                      right.columns[laneR]? = some cR →
                                        (native left pL laneL).trace = (native right pR laneR).trace :=
⋯
