+pub fn valid_registry_ref(
+    registry: &VerifierRegistryV2,
+) -> Result<(), PoolV1VerifierRegistryFormatError> {
+    if registry.flags & !POOL_V1_VERIFIER_REGISTRY_FLAGS_MASK != 0 {
+        return Err(PoolV1VerifierRegistryFormatError::UnsupportedFlags);
+    }
+    if crate::NCX_reference::required_binding_is_zero(&registry.pool)
+        || crate::NCX_reference::required_binding_is_zero(&registry.policy_binding)
+        || crate::NCX_reference::required_binding_is_zero(&registry.registry_program)
+        || crate::NCX_reference::required_binding_is_zero(&registry.loader_program)
+        || crate::NCX_reference::required_binding_is_zero(&registry.programdata_address)
+        || crate::NCX_reference::required_binding_is_zero(&registry.executable_hash)
+    {
+        return Err(PoolV1VerifierRegistryFormatError::ZeroRequiredBinding);
+    }
+    if (registry.flags & 2 != 0) != crate::NCX_reference::required_binding_is_zero(&registry.authority) {
+        return Err(PoolV1VerifierRegistryFormatError::InvalidAuthorityMode);
+    }
+    if registry.minimum_activation_delay_slots == 0 {
+        return Err(PoolV1VerifierRegistryFormatError::InvalidActivationDelay);
+    }
+    Ok(())
+}
+
+pub fn valid_entry_ref(
+    entry: &VerifierRegistryEntryV2,
+) -> Result<(), PoolV1VerifierRegistryFormatError> {
+    if entry.statement_version == 0 {
+        return Err(PoolV1VerifierRegistryFormatError::InvalidStatementVersion);
+    }
+    if crate::NCX_reference::required_binding_is_zero(&entry.pool)
+        || crate::NCX_reference::required_binding_is_zero(&entry.verifier_program)
+        || crate::NCX_reference::required_binding_is_zero(&entry.profile_binding)
+        || crate::NCX_reference::required_binding_is_zero(&entry.release_binding)
+        || crate::NCX_reference::required_binding_is_zero(&entry.loader_program)
+        || crate::NCX_reference::required_binding_is_zero(&entry.programdata_address)
+        || crate::NCX_reference::required_binding_is_zero(&entry.executable_hash)
+        || crate::NCX_reference::required_binding_is_zero(&entry.policy_binding)
+    {
+        return Err(PoolV1VerifierRegistryFormatError::ZeroRequiredBinding);
+    }
+    if !crate::NCX_reference::required_binding_is_zero(&entry.expected_upgrade_authority) {
+        return Err(PoolV1VerifierRegistryFormatError::InvalidAuthorityMode);
+    }
+    if !(entry.retirement_slot == u64::MAX) && entry.retirement_slot <= entry.activation_slot {
+        return Err(PoolV1VerifierRegistryFormatError::InvalidRetirementSlot);
+    }
+    Ok(())
+}
