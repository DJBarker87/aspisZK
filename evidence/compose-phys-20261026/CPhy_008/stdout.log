                                                      ok (core.result.Result.Ok sem) ∧
                                                    AspisR1PublicPreparation.PrefixAdapter.parseAccepted v.semantic =
                                                        ok (core.result.Result.Ok claimsPrefix) ∧
                                                      ClaimsUnrolledFinish.reference claimsStd claimsPrefix =
                                                        ok (core.result.Result.Ok (retainedSem sem).claims)) ∧
                                        let decode := CPhy_Header.decode;
                                        let nodes := CPhy_Ranges.nodes f.proof s.proof;
                                        let y1 := CPhy_Ranges.y1 f.proof;
                                        ∀
                                          (a :
                                            S2X.CheckpointVersionBinding
                                              (payloadBytes encode (post1.payload (e1.heap.accounts 2).1) 1768)
                                              (bytesOf ↑s.checkpoint)),
                                          P2Prime H f.proof f.pub s.proof s.pub →
                                            S2W_ChildJoins.FirstEntryVerifierConeJoin f.proof →
                                              ∃ parsed,
                                                S2W_LeadInterface.S2CallerFacts
                                                    (observation f s saved nodes y1 pre middle fs ss (before e1 e2)
                                                      (after e1 e2 post1))
                                                    (S2Z.Oracle.leadDigest
                                                      (sdkOps
                                                        (Tx2I_Install.install adapterOps
                                                          (Op5T_Concrete.stage
                                                            (Tx2N_Execution.control stageBase reserved queryOps geoOps))
                                                          finishOps)
                                                        (Uni_Install.current ops reserved queryOps geoOps) B claimsStd))
                                                    () H (bytesOf ↑f.proof) (bytesOf ↑f.pub) (bytesOf ↑saved) parsed ∧
                                                  (∀ (site : Site),
                                                      (observation f s saved nodes y1 pre middle fs ss (before e1 e2)
                                                              (after e1 e2 post1)).reached
                                                          site ↔
                                                        S2W_SiteSchedule.Event.site site ∈ projected port outer) ∧
                                                    (Port5Q1_QueryPorts.SessionAPrimitives queryOps →
                                                      Port5Q1_GeometryCanonical.SessionAPrimitives geoOps →
                                                        Port5Q1_Domain.SessionADomain geoOps →
                                                          geoOps.op9 = AspisR1Qm31ArithmeticProbe.field.M31.mul →
                                                            geoOps.op7 = ok 1#u32 →
                                                              geoOps.op11 = Port4C_InverseExecution.inverse_owned →
                                                                Tx2N_Finish.Outcome finishOps reserved queryOps
                                                                  (AdapterRw.SolanaDigest.Insts.Aspis_coreDigestDigest32
                                                                    (sdkOps
                                                                      (Tx2I_Install.install adapterOps
                                                                        (Op5T_Concrete.stage
                                                                          (Tx2N_Execution.control stageBase reserved
                                                                            queryOps geoOps))
                                                                        finishOps)
                                                                      (Uni_Install.current ops reserved queryOps geoOps)
                                                                      B claimsStd))
                                                                  () s.pub s.proof s.checkpoint saved H
                                                                  (bytesOf ↑f.proof) (bytesOf ↑f.pub))
'AspisR1.CPhy_Physical.accepted_pair_unified' depends on axioms: [propext, sorryAx, Classical.choice, Quot.sound]
theorem AspisR1.CPhy_Physical.accepted_pair_unified : ∀ {W A M Cv F CoreError : Type} {N : ℕ}
  (L : Library W (ℕ → Record)),
  S2TrustedSdkBorrow L →
    ∀ (copy : Heap (ℕ → Record) → ℕ → Payload → Outcome (ℕ → Record)),
      TrustedStd copy →
        ∀ (allocator : Allocator A) (e1 e2 : Entry) (w1 w2 : W),
          RuntimeEntrypointAdmission L e1 w1 3 →
            RuntimeEntrypointAdmission L e2 w2 7 →
              ∀ (adapterOps : AdapterRw.Ops) (ops : Ops) (reserved : Bool) (queryOps : Port3_NativeQueryBody.Ops)
                (geoOps : Port3_NativeGeometryBody.Ops CoreError) (stageBase : VTop_Stages.Ops)
                (finishOps : AspisR1Stage2.Stage2Finish.FinishOps F)
                (B : AspisR1PublicPreparation.FinishModel.Boundaries) (claimsStd : ClaimsUnrolledFinish.StdCalls)
                (native1 : S2W_ExtractionBoundary.First) (native2 : S2W_ExtractionBoundary.Second),
                WAdm_Domain.SessionAPrepare
                    (Tx1Q_Execution.actual (Op5T_Concrete.current ops) reserved queryOps geoOps B claimsStd) →
                  Port5Q1_QueryPorts.SessionAPrimitives queryOps →
                    ∀ (hashv : S2Z.Oracle.Parts → Result S2Z.Oracle.Digest),
                      S2W_DigestExtraction.AeneasExtraction
                          (sdkOps
                            (Tx2I_Install.install adapterOps
                              (Op5T_Concrete.stage (Tx2N_Execution.control stageBase reserved queryOps geoOps))
                              finishOps)
                            (Uni_Install.current ops reserved queryOps geoOps) B claimsStd)
                          native1 native2 hashv →
                        ∀ (sha256 H : Bytes → State),
                          S2W_ExtractionBoundary.P1 sha256 H →
                            S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
                              ∀ (program : S2W_ExtractionBoundary.Program) (data1 data2 : Slice U8)
                                (slot : S2W_ExtractionBoundary.Slot) (state1 state2 final1 final2 : A)
                                (saved : alloc.vec.Vec U8) (post1 post2 : Heap (ℕ → Record)),
                                first native1 copy allocator e1 program data1 state1 =
                                    ok (core.result.Result.Ok (saved, post1, final1)) →
                                  second native2 allocator e2 program data2 slot state2 =
                                      ok (core.result.Result.Ok (post2, final2)) →
                                    ∀ (p : FS2.Duplex.Params M Cv N) (root : Std.Array U8 32#usize) (length : U32),
                                      have port :=
                                        SdkD_Child.port adapterOps (Uni_Install.current ops reserved queryOps geoOps)
                                          (Op5T_Concrete.stage
                                            (Tx2N_Execution.control stageBase reserved queryOps geoOps))
                                          finishOps B claimsStd;
                                      ∃ f s outer pre middle fs ss,
                                        SourceCuts
                                            (sdkOps
                                              (Tx2I_Install.install adapterOps
                                                (Op5T_Concrete.stage
                                                  (Tx2N_Execution.control stageBase reserved queryOps geoOps))
                                                finishOps)
                                              (Uni_Install.current ops reserved queryOps geoOps) B claimsStd)
                                            e1.first (e2.second secondSizes) saved f s ∧
                                          CheckpointWriterConeJoin ⋯ CPhy_Header.decode H f.semantic f.pub f.proof
                                              f.split ∧
                                            ⋯ ∧ ⋯ :=
fun {W A M Cv F CoreError} {N} L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 adapterOps ops reserved
    queryOps geoOps stageBase finishOps B claimsStd native1 native2 prepareOwner primitiveOwner hashv extraction sha256
    H p1 syscall program data1 data2 slot state1 state2 final1 final2 saved post1 post2 accepted1 accepted2 p root
    length =>
  let ⟨f, h✝⟩ :=
    CPhy_Accepted.accepted_pair_unified L sdk copy std allocator e1 e2 w1 w2 admission1 admission2 adapterOps ops
      reserved queryOps geoOps stageBase finishOps B claimsStd native1 native2 prepareOwner primitiveOwner hashv
      extraction sha256 H p1 syscall program data1 data2 slot state1 state2 final1 final2 saved post1 post2 accepted1
      accepted2 p root length
  let ⟨s, h✝¹⟩ := h✝
  let ⟨outer, h✝²⟩ := h✝¹
  let ⟨pre, h✝³⟩ := h✝²
  let ⟨middle, h✝⁴⟩ := h✝³
  let ⟨fs, h✝⁵⟩ := h✝⁴
  let ⟨ss, h✝⁶⟩ := h✝⁵
  let ⟨cuts, right✝⟩ := h✝⁶
  let ⟨scan, right✝¹⟩ := right✝
  let ⟨tx1, right✝²⟩ := right✝¹
  let ⟨batches, right✝³⟩ := right✝²
  let ⟨tx2, right✝⁴⟩ := right✝³
  let ⟨first, right✝⁵⟩ := right✝⁴
  let ⟨expanded, right✝⁶⟩ := right✝⁵
  let ⟨owned, right✝⁷⟩ := right✝⁶
  let ⟨layout, right✝⁸⟩ := right✝⁷
  let ⟨unchanged, right✝⁹⟩ := right✝⁸
  let ⟨before1, right✝¹⁰⟩ := right✝⁹
  let ⟨before2, right✝¹¹⟩ := right✝¹⁰
  let ⟨claims, caller⟩ := right✝¹¹
  have oracle :=
    S2W_DigestExtraction.native_oracle
      (sdkOps
        (Tx2I_Install.install adapterOps
          (Op5T_Concrete.stage (Tx2N_Execution.control stageBase reserved queryOps geoOps)) finishOps)
        (Uni_Install.current ops reserved queryOps geoOps) B claimsStd)
      native1 native2 hashv extraction sha256 H p1 syscall;
  let ⟨run, h✝⁷⟩ := tx1
  let ⟨r, right✝¹²⟩ := h✝⁷
  let ⟨sp, right✝¹³⟩ := right✝¹²
  let ⟨n, right✝¹⁴⟩ := right✝¹³
  let ⟨w, right✝¹⁵⟩ := right✝¹⁴
  let ⟨can, right✝¹⁶⟩ := right✝¹⁵
  let ⟨write, right✝¹⁷⟩ := right✝¹⁶
  let ⟨native, bound⟩ := right✝¹⁷
  have written :=
    CPhy_Header.writer
      (AdapterRw.SolanaDigest.Insts.Aspis_coreDigestDigest32
        (sdkOps
          (Tx2I_Install.install adapterOps
            (Op5T_Concrete.stage (Tx2N_Execution.control stageBase reserved queryOps geoOps)) finishOps)
          (Uni_Install.current ops reserved queryOps geoOps) B claimsStd))
      () H oracle (Tx1Q_Carriers.prepared run.p)
      (Tx1Q_Carriers.accumulator
        (have __src := run.out;
        { weights := ⟨↑run.flushed, run.flushed.property⟩, rhs := __src.rhs, power := __src.power,
          next := __src.next }))
      f.proof f.pub saved write;
  sorry
