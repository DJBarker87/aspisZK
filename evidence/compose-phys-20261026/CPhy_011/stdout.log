def AspisR1.S2Y_OwnedChildren.PhysicalRange : Slice U8 → Slice U8 → ℕ → Prop :=
fun proof actual slot =>
  ∃ start finish,
    ↑start = OraclePortSelectedDraft.slotStart slot ∧
      ↑finish = ↑start + 32 * OraclePortSelectedDraft.capacity slot ∧
        ↑finish ≤ (↑proof).length ∧
          core.slice.index.Slice.index (core.slice.index.SliceIndexRangeUsizeSlice U8) proof
              { start := start, «end» := finish } =
            ok actual
def AspisR1.S2Y_OwnedChildren.Y1Range : Slice U8 → Slice U8 → Prop :=
fun proof actual =>
  7495 ≤ (↑proof).length ∧
    core.slice.index.Slice.index (core.slice.index.SliceIndexRangeUsizeSlice U8) proof
        { start := 7031#usize, «end» := 7495#usize } =
      ok actual
