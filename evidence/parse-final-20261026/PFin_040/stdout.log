                                      (∀ x ∈ [r0.lhs, r0.rhs, r1.lhs, r1.rhs, pair, r1.value, dot, a.rhs],
                                          AspisR1.CheckpointBytes4ReaderFields.sourceE
                                              (AspisR1.CheckpointBytes5Output.ofE x) =
                                            x) →
                                        ∀ (c : AspisR1.OraclePortCheckpointResumeC5.Context),
                                          AspisR1.Port5Q1_QueryPorts.SessionAPrepare
                                              (AspisR1.Tx1Q_Carriers.prepared tx1p) i.data q
                                              (AspisR1.SelectedChallengeMap.rhoOf i.rho) →
                                            savedVec =
                                                AspisR1.Tx2N_Reader.writer H stored publicBytes
                                                  (AspisR1.OraclePortCheckpointResumeC5.prepared c i.data
                                                    (AspisR1.SelectedChallengeMap.rhoOf i.rho) q)
                                                  (AspisR1.OraclePortCheckpointStateC3.write
                                                      (AspisR1.OraclePortCheckpointResumeC5.model i.data
                                                        (AspisR1.SelectedChallengeMap.rhoOf i.rho) q)).accumulator →
                                              AspisR1.AuS1_Finish.Collision H trace parsed q ∨
                                                Decidable.decide
