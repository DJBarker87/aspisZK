+-- Validate every row once; record bytes remain demands, never hash authority.
+def fileIndex (rows : Array Json) : IO (Std.HashMap String (Nat × String)) := do
+  let mut index : Std.HashMap String (Nat × String) := {}
+  for row in rows do
+    let path ← str (← obj row "path")
+    let size ← nat (← obj row "bytes")
+    let sha ← str (← obj row "sha256")
+    if index.contains path then throw <| IO.userError "duplicate artifact pin path"
+    index := index.insert path (size, sha)
+  return index
+
