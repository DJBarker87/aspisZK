 -- Concrete same-invocation pipeline: core admission -> baseline -> raw DATA ->
 -- fresh prereqs -> strong -> Bridge -> remaining -> HPow -> publication -> Elab.
+-- Fixed, payload-free diagnostics only; no success or logical claim.
+def phase (label : String) : IO Unit := do
+  let err ← IO.getStderr
+  err.putStrLn ("PORT36_PHASE " ++ label)
+  err.flush
+
 def driver : Elab.Command.CommandElabM Unit := do
+  Elab.Command.liftIO <| phase "loadPlan:begin"
   let p ← Elab.Command.liftIO loadPlan
+  Elab.Command.liftIO <| phase "loadPlan:end"
+  Elab.Command.liftIO <| phase "baseline:begin"
   let (base,coreHeld) ← Elab.Command.liftIO <| Port36TRANSPORT.baseline p
+  Elab.Command.liftIO <| phase "baseline:end"
   let baselineOwner ← Elab.Command.liftIO <| IO.mkRef (base,coreHeld)
+  Elab.Command.liftIO <| phase "loadSelected:begin"
   let (selected,rawHeld) ← Elab.Command.liftIO <| loadSelected base
+  Elab.Command.liftIO <| phase "loadSelected:end"
+  Elab.Command.liftIO <| phase "loadDelta:begin"
   let (delta,deltaHeld) ← Elab.Command.liftIO loadDelta
+  Elab.Command.liftIO <| phase "loadDelta:end"
+  Elab.Command.liftIO <| phase "reconstruct:begin"
   let (k,added) ← Elab.Command.liftIO <| Port36TRANSPORT.reconstruct base selected delta
+  Elab.Command.liftIO <| phase "reconstruct:end"
+  Elab.Command.liftIO <| phase "widePow:begin"
   let k ← Elab.Command.liftIO <| Port36TRANSPORT_Recover.widePow k
+  Elab.Command.liftIO <| phase "widePow:end"
   let some power := k.find? `Port36TRANSPORT.widePow | throwError "missing checked power"
   let all := added.push power
+  Elab.Command.liftIO <| phase "exactKernel:begin"
   Elab.Command.liftIO <| Port36TRANSPORT.exactKernel base.toKernelEnv k all
+  Elab.Command.liftIO <| phase "exactKernel:end"
+  Elab.Command.liftIO <| phase "publish:begin"
   let (env,publicationHeld) ← Elab.Command.liftIO <| Port36TRANSPORT.publish p base coreHeld k all
+  Elab.Command.liftIO <| phase "publish:end"
   let publicationOwner ← Elab.Command.liftIO <| IO.mkRef (env,publicationHeld)
+  Elab.Command.liftIO <| phase "consumer:begin"
   Port36TRANSPORT.elaborateConsumer env
+  Elab.Command.liftIO <| phase "consumer:end"
   let (base,coreHeld) ← Elab.Command.liftIO baselineOwner.get
