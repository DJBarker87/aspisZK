rait_decl_ref":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":13692},{"Deduplicated":13717},{"Deduplicated":13714}],"const_generics":[],"trait_refs":[]}}}}]}]}},"trait_ref":{"id":12,"generics":{"regions":[],"types":[{"Deduplicated":13717},{"Deduplicated":13692},{"Deduplicated":13714}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":0},"reuses_default":true}},"is_global_initializer":null,"body":"Opaque"},{"def_id":8,"item_meta":{"name":[{"Ident":["aspis_r1_cost_probe",0]},{"Ident":["compact",0]},{"Ident":["expand_semantic",0]}],"span":{"data":{"file_id":21,"beg":{"line":148,"col":0},"end":{"line":172,"col":1}},"generated_from_span":null},"source_text":"pub fn expand_semantic(compact: &[u8], out: &mut [u8]) -> Result<(), CodecError> {\n    if compact.len() != COMPACT_SEMANTIC || out.len() != LOGICAL_SEMANTIC {\n        return Err(CodecError::Length);\n    }\n    out[..32].copy_from_slice(&compact[..32]);\n    let (mut src, mut dst) = (32, 32);\n    for row in 0..SEMANTIC_ROWS {\n        let size = row_shape(row).ok_or(CodecError::Length)?.1;\n        out[dst..dst + 5].copy_from_slice(&compact[src..src + 5]);\n        src += 5;\n        dst += 5;\n        if compact_row(row) {\n            expand_values(&compact[src..src + size / 2], &mut out[dst..dst + size])?;\n            src += size / 2;\n        } else {\n            out[dst..dst + size].copy_from_slice(&compact[src..src + size]);\n            src += size;\n        }\n        dst += size;\n    }\n    if src != compact.len() || dst != out.len() {\n        return Err(CodecError::Length);\n    }\n    Ok(())\n}","attr_info":{"attributes":[{"DocComment":" Decoder: compact semantic -> logical semantic (framing bytes copied;"},{"DocComment":" the shipped `Prefix::parse` then checks tag, length and every limb)."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Opaque","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknow