@FIn_Nonvacuity.witness_or_collision : ∀ {F C : Type} (base : DrvC_Installation.Configuration F C) (seed : FinishOps F),
  base.finish = FIn_Install.finishOps seed →
    base.stageBase.op22 = Aeneas.Std.Result.ok 7527#usize ∧
        base.stageBase.op21 = Aeneas.Std.Result.ok 8007#usize ∧ base.stageBase.op20 = Aeneas.Std.Result.ok 10055#usize →
      ∀ (hashv : SdkC_Source.Parts → Aeneas.Std.Result SdkC_Source.Digest) (s : F3T_ByteCarrier.Submission)
        (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
        (w : CanonicalCutEnrichedTranscript.Words)
        (prior :
          AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State Unit),
        have c := F3V_Install.configuration base;
        WAdm_Domain.SessionAPrepare
            (Tx1Q_Execution.actual (Op5T_Concrete.current c.currentBase) c.reserved c.query c.geometry c.boundaries
              c.std) →
          ∀ (decoder : LiteralByteProtocol.Decoder),
            Port5Q1_QueryPorts.SessionAPrimitives c.query →
              Port5Q1_GeometryCanonical.SessionAPrimitives c.geometry →
                Port5Q1_Domain.SessionADomain c.geometry →
                  c.geometry.op9 = AspisR1Qm31ArithmeticProbe.field.M31.mul →
                    c.geometry.op7 = Aeneas.Std.Result.ok 1#u32 →
                      c.geometry.op11 = Port4C_InverseExecution.inverse_owned →
                        (AspisV8R19.MemoizedProgramLaw.eval H
                                (F3T_Installed.source c hashv (F3T_ByteCarrier.input c s))).2 =
                            true →
                          ∃ e i p q data t,
                            have tr :=
                              LiteralTranscript.erasePrefix
                                (AspisV8R19.MemoizedProgramLaw.eval H
                                    (F3J_SamplerRun.program i.proof 0 33 (FS.emptyPrefix i.semantic.value))).2;
                            i.physical.bytes = MultiproofConeCanonical.bytesOf ↑e.pub ∧
                              i.stored = MultiproofConeCanonical.bytesOf ↑e.proof ∧
                                OraclePortStoredParserC4.parseReached i.stored tr = some p ∧
                                  OraclePortSelectedDraft.queries tr = some q ∧
                                    OraclePortStoredDecisionDraftC4.input p q tr = some data ∧
                                      Cons_Native.Calls (Op5T_Concrete.stage (AuS1_Install.base c.stageBase)) c.finish
                                          c.reserved c.query c.geometry (F3V_RunEvidence.D2 c H) () e.pub e.proof
                                          e.saved.deref t ∧
                                        Cons_NativeBuild.Aux c.reserved c.query c.geometry (F3V_RunEvidence.D2 c H) ()
                                            e.pub e.proof e.saved.deref t ∧
                                          SAG_NativeFull.Shape
                                              (Tx2N_Execution.control
                                                (Tx2I_Install.stage
                                                  (Op5T_Concrete.stage (AuS1_Install.base c.stageBase)) c.finish)
                                                c.reserved c.query c.geometry)
                                              e.proof t ∧
                                            F3Y_PreparedAt.At c base.boundaries s H e i p q data ∧
                                              (AuS1_Finish.Collision H
                                                  (F3V_Checkpoint.trace c base.boundaries s H e prior) p q ∨
                                                Nonempty
                                                  (F3S_FinishWitness.Primitives c.finish t.v2 t.p2
                                                    (have __src := t.returned2;
                                                    { weights := t.back2 t.flushed2, rhs := __src.rhs,
                                                      power := __src.power, next := __src.next })))
