def AspisR1.Cons_Native.Calls : {F CoreError Hash : Type} →
  VTop_Stages.Ops →
    AspisR1Stage2.Stage2Finish.FinishOps F →
      Bool →
        AspisR1.Port3_NativeQueryBody.Ops →
          AspisR1.Port3_NativeGeometryBody.Ops CoreError →
            VTop_Stages.aspis_core.digest.Digest32 Hash →
              Hash →
                Aeneas.Std.Slice Aeneas.Std.U8 →
                  Aeneas.Std.Slice Aeneas.Std.U8 →
                    Aeneas.Std.Slice Aeneas.Std.U8 → AspisR1.Cons_Native.Witness → Prop :=
fun {F CoreError Hash} base finishOps reserved queryOps geoOps D hash pub proof checkpoint t =>
  (AspisR1.Tx2N_Execution.control base reserved queryOps geoOps).op18 D checkpoint proof pub
        AspisR1Stage2.transport.Variant.S2 hash =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (t.p2, t.saved2)) ∧
    AspisR1.T2Nat_ReaderJoin.reader reserved D checkpoint proof pub AspisR1Stage2.transport.Variant.S2 hash =
        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (t.p2, t.saved2)) ∧
      (↑checkpoint).length = 1768 ∧
        reserved = Bool.true ∧
          AspisR1.T2Nat_ReaderEffects.OnRun reserved D hash checkpoint proof pub t.p2 t.saved2 ∧
            (AspisR1.Tx2N_Execution.control base reserved queryOps geoOps).op6 proof t.p2 t.saved2 t.g2 Option.none
                  t.geometry2 t.pending2 22#usize =
                Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (t.returned2, t.after2)) ∧
              t.returned2.weights.deref_mut = (t.returned2.weights.deref, t.back2) ∧
                (AspisR1.Tx2N_Execution.control base reserved queryOps geoOps).op9 t.after2 t.returned2.weights.deref =
                    Aeneas.Std.Result.ok t.flushed2 ∧
                  have a :=
                    have __src := t.returned2;
                    { weights := t.back2 t.flushed2, rhs := __src.rhs, power := __src.power, next := __src.next };
                  (AspisR1.Tx2I_Install.stage
                            (AspisR1.Op5T_Concrete.stage (AspisR1.Tx2N_Execution.control base reserved queryOps geoOps))
                            finishOps).op19
                        t.v2 t.p2 a Option.none =
                      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) ∧
                    AspisR1.Port4D_FinishInstall.finish finishOps t.v2 t.p2 a Option.none =
                        Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok ()) ∧
                      ∀ {Hash : Type} (D : AspisR1Stage2.aspis_core.digest.Digest32 Hash) (hash : Hash)
                        (before : AspisR1.CheckpointBytes5Effect.Log),
                        AspisR1.CheckpointBytes5Effect.run D hash
                            (AspisR1.T2Nat_Silent.code (AspisR1.T2Nat_FinishResult.installed finishOps t.v2 t.p2 a))
                            before =
                          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (), before)
def AspisR1.Cons_NativeBuild.Aux : {CoreError Hash : Type} →
  Bool →
    AspisR1.Port3_NativeQueryBody.Ops →
      AspisR1.Port3_NativeGeometryBody.Ops CoreError →
        VTop_Stages.aspis_core.digest.Digest32 Hash →
          Hash →
            Aeneas.Std.Slice Aeneas.Std.U8 →
              Aeneas.Std.Slice Aeneas.Std.U8 → Aeneas.Std.Slice Aeneas.Std.U8 → AspisR1.Cons_Native.Witness → Prop :=
fun {CoreError Hash} reserved query geo D hash pub proof checkpoint t =>
  AspisR1.Port4A_ReaderInstall.reader reserved D checkpoint proof pub AspisR1Stage2.transport.Variant.S2 hash =
      Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (t.p2, t.saved2)) ∧
    t.saved2.next = 10#usize ∧
      AspisR1.Port3_GeometryStage.geometry (AspisR1.Port5Q1_GeometryTerminal.install geo) t.p2.queries t.saved2.next
            22#usize =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok t.geometry2) ∧
        AspisR1.Port3_NativePendingInstall.source reserved t.saved2.weights.deref =
            Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok t.pending2) ∧
          AspisR1.Port3_QueryStage.query (AspisR1.Port4C_RowStd.install (AspisR1.Port5Q1_QueryPorts.install query))
                proof t.p2 t.saved2 t.g2 Option.none t.geometry2 t.pending2 22#usize =
              Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (t.returned2, t.after2)) ∧
            t.returned2.weights.deref_mut = (t.returned2.weights.deref, t.back2) ∧
              AspisR1.Port3_FlushInstall.flush t.after2 t.returned2.weights.deref = Aeneas.Std.Result.ok t.flushed2
def AspisR1.SAG_NativeFull.Shape : VTop_Stages.Ops →
  Aeneas.Std.Slice Aeneas.Std.U8 → AspisR1.Cons_Native.Witness → Prop :=
fun ops proof t =>
  ∃ round0 folded round1 finalStart queryStart,
    ops.op22 = Aeneas.Std.Result.ok round0 ∧
      ops.op15 = Aeneas.Std.Result.ok folded ∧
        ops.op14 = Aeneas.Std.Result.ok round1 ∧
          ops.op21 = Aeneas.Std.Result.ok finalStart ∧
            ops.op20 = Aeneas.Std.Result.ok queryStart ∧
              Aeneas.Std.core.slice.index.Slice.index
                    (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8) proof
                    { start := round0, «end» := folded } =
                  Aeneas.Std.Result.ok t.v2.round0 ∧
                Aeneas.Std.core.slice.index.Slice.index
                      (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8) proof
                      { start := round1, «end» := finalStart } =
                    Aeneas.Std.Result.ok t.v2.round1 ∧
                  Aeneas.Std.core.slice.index.Slice.index
                      (Aeneas.Std.core.slice.index.SliceIndexRangeUsizeSlice Aeneas.Std.U8) proof
                      { start := finalStart, «end» := queryStart } =
                    Aeneas.Std.Result.ok t.v2.final_message
