{"charon_version":"0.1.223","translated":{"crate_name":"fin_pair_extraction","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::FIn_pair"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["crate::weights","crate::fast_pairing","crate::transport","crate::trace","crate::verifier","core::result::Result"],"opaque":["crate","aspis_core"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-sound-int2-20261025/FIn_Pair.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"fin_pair_extraction","contents":"#![allow(non_snake_case,dead_code,unexpected_cfgs)]\nextern crate alloc;\n#[path=\"FIn_weights.rs\"] pub mod weights;\n#[path=\"FIn_fast_pairing.rs\"] pub mod fast_pairing;\n#[path=\"FIn_transport.rs\"] pub mod transport;\n#[path=\"FIn_verifier.rs\"] pub mod verifier;\n#[path=\"FIn_trace.rs\"] pub mod trace;\npub fn FIn_pair(w:&weights::Weights,alpha:&[aspis_core::field::WideExact],f:&[u8],kappa:aspis_core::field::WideExact)->Result<aspis_core::field::WideExact,verifier::Error> {w.pair(alpha,f,kappa)}\n"},{"id":1,"name":{"Local":"src/FIn_weights.rs"},"crate_name":"fin_pair_extraction","contents":"//! UNPROVED COST PROBE. Seven coefficient functionals and their dual folds.\nuse alloc::{boxed::Box,vec::Vec};\nuse aspis_core::{field::{QM31 as K,WideExact as E,M31},circle::SecureCirclePoint};\nuse crate::{transport::{Variant,TAU},verifier::Error};\npub const QUARTER:M31=M31(536870912);\npub const PERM:[usize;4]=[0,3,2,1];\npub fn powers<const N:usize>(x:E)->[E;N]{\n let mut out=[E::ZERO;N];\n let mut p=E::ONE;\n let mut i=0usize;\n while i<N {\n  out[i]=p;\n  i+=1;\n  if i==N { return out; }\n  p=p.mul(x);\n }\n out\n}\npub fn kpowers<const N:usize>(x:K)->[K;N]{\n let mut out=[K::ZERO;N]; let mut p=K::ONE;\n for i in 0..N { out[i]=p; p=p.mul(x); }\n out\n}\npub fn double(x:K)->K { x.mul(x).add(x.mul(x)).sub(K::ONE) }\npub fn field(bytes:&[u8],i:usize)->E { E::from_le_bytes(&bytes[i*32..(i+1)*32]).unwrap() }\n\n// Exact S2 coefficient-to-row inactive classification, in first-occurrence order.\n// Exhaustive table correspondence is checked against Variant::row and raw(0, _).\nconst S2_INACTIVE_GROUPS:[u8;64]=[0,1,2,3,4,5,5,6,4,5,5,5,7,7,7,7,7,7,7,4,4,5,5,6,4,5,5,5,7,7,7,4,7,7,7,7,4,5,5,5,4,5,5,5,8,9,10,8,11,2,2,10,4,5,5,6,4,5,5,6,7,7,7,7];\nconst S2_INACTIVE_MASKS:[u16;12]=[32769,49217,49280,16448,32767,16383,49151,65535,49152,57344,49216,33024];\n\n#[inline(never)]\nfn s2_grouped_inactive_pair(f:&[u8],low:&[E;16])->E {\n    let mut coefficients=[E::ZERO;12];\n    for j in 0..64 {\n        let group=S2_INACTIVE_GROUPS[j] as usize;\n        coefficients[group]=coefficients[group].add(field(f,j));\n    }\n    let mut pair=E::ZERO;\n    for group in 0..12 {\n        let mut weight=E::ZERO;\n        for bit in 0..16 {\n            let challenge=low[bit];\n            if S2_INACTIVE_MASKS[group]&(1<<bit)!=0 {weight=weight.add(challenge);}\n        }\n        pair=pair.add(coefficients[group].mul(weight));\n    }\n    pair\n}\n\n/// Contract the inactive row after combining coefficients with the same\n/// sixteen-entry inactive mask. The zero mask is retained as a group; its\n/// subset weight is zero, matching the ungrouped sum.\n#[inline(never)]\nfn grouped_inactive_pair(weights:&Weights,f:&[u8],low:&[E;16])->E {\n    if weights.variant==Variant::S2 && f.len()==64*32 {return s2_grouped_inactive_pair(f,low);}\n    let mut group_masks=[0u16;64];\n    let mut group_coefficients=[E::ZERO;64];\n    let mut groups=0;\n    for j in 0..f.len()/32 {\n        let mut mask=0u16;\n        for s in 0..16 {if weights.raw(0,16*j+s)==K::ONE {mask|=1<<s;}}\n        let coefficient=field(f,j);\n        let mut group=0;\n        while group<groups && group_masks[group]!=mask {group+=1;}\n        if group==groups {group_masks[group]=mask;groups+=1;}\n        group_coefficients[group]=group_coefficients[group].add(coefficient);\n    }\n    let mut pair=E::ZERO;\n    for group in 0..groups {\n        let mask=group_masks[group];\n        let mut weight=E::ZERO;\n        for s in 0..16 {\n            let challenge=low[s];\n            if mask&(1<<s)!=0 {weight=weight.add(challenge);}\n        }\n        pair=pair.add(group_coefficients[group].mul(weight));\n    }\n    pair\n}\n\n/// Build the four two-fold Libra dual weights without per-cell exponentiation.\n#[inline(never)]\nfn twofold_libra_weights(low:&[E;16],extra:[K;2])->[E;4] {\n    let mut powers=[[K::ZERO;28];2];\n    for side in 0..2 {\n        let mut power=K::ONE;\n        for index in 0..28 { powers[side][index]=power; power=power.mul(extra[side]); }\n    }\n    let mut out=[E::ZERO;4];\n    for j in 0..4 {\n        let mut weight=E::ZERO;\n        for s in 0..16 {\n            let index=16*j+s;\n            if index<56 { weight=weight.add(low[s].mul_qm31(powers[index/28][index%28])); }\n        }\n        out[j]=weight;\n    }\n    out\n}\n\n/// Exact factorization of the existing 56-entry Libra row into two 28-entry\n/// geometric runs. The 16-entry low tensor is a product of two four-entry\n/// tensors; the only cut blocks have lengths 12 and 4 (28 = 16 + 12).\n#[inline(never)]\nfn factored_s2_libra_weights(ap0:&[E;4],ap1:&[E;4],extra:[K;2])->[E;4] {\n    let mut weights=[E::ZERO;4];\n    for side in 0..2 {\n        let q0=K::ONE;\n        let q1=q0.mul(extra[side]);\n        let q2=q1.mul(extra[side]);\n        let q3=q2.mul(extra[side]);\n        let _q4=q3.mul(extra[side]);\n        let q=[q0,q1,q2,q3];\n        let q4=q[2].square();let q8=q4.square();let q12=q8.mul(q4);let q16=q8.square();\n        let low=Weights::scalar_factor(&q,ap0);\n        let high_powers=[K::ONE,q4,q8,q12];\n        let term0=ap1[PERM[0]].mul_qm31(high_powers[0]).mul_m31(QUARTER);\n        let term1=ap1[PERM[1]].mul_qm31(high_powers[1]).mul_m31(QUARTER);\n        let term2=ap1[PERM[2]].mul_qm31(high_powers[2]).mul_m31(QUARTER);\n        let term3=ap1[PERM[3]].mul_qm31(high_powers[3]).mul_m31(QUARTER);\n        let terms=[term0,term1,term2,term3];\n        let first2=terms[0].add(terms[1]);let first3=first2.add(terms[2]);let all=first3.add(terms[3]);\n        if side==0 {\n            weights[0]=low.mul(all);\n            weights[1]=low.mul(first3).mul_qm31(q16);\n        } else {\n            weights[1]=weights[1].add(low.mul(ap1[PERM[3]].mul_m31(QUARTER)));\n            weights[2]=low.mul(all).mul_qm31(q4);\n            weights[3]=low.mul(first2).mul_qm31(q16.mul(q4));\n        }\n    }\n    weights\n}\n\nfn shared_two_point_guard(w:&Weights,folds:usize)->bool {\n    w.variant==Variant::S2 && folds==2 && w.factors[0][2]==w.factors[2][2] && w.factors[0][3]==w.factors[2][3]\n }\nfn push_byte_products(pair:&mut crate::fast_pairing::EbyKDot,f:&[u8],scratch:&[K],n:usize)->Result<(),Error>{\n  for j in 0..n { match pair.push(field(f,j),scratch[j]) { Ok(()) => {}, Err(_) => return Err(Error::Parse) } }\n  Ok(())\n }\nfn partial_dot(f:&[u8],common:&[K;16],s:usize)->Result<E,Error>{\n  let mut dot=crate::fast_pairing::EbyKDot::new();\n  for j in 0..16 { match dot.push(field(f,16*s+j),common[j]) { Ok(()) => {}, Err(_) => return Err(Error::Parse) } }\n  Ok(dot.finish())\n }\nfn high_dot(partials:&[E;4],coeffs:&[K;4])->Result<E,Error>{\n  let mut high=crate::fast_pairing::EbyKDot::new();\n  for s in 0..4 { match high.push(partials[s],coeffs[s]) { Ok(()) => {}, Err(_) => return Err(Error::Parse) } }\n  Ok(high.finish())\n }\nfn process_regular_kinds(w:&Weights,shared_two_point:bool,alpha:&[E],f:&[u8],folds:usize,n:usize,\n     ap0:&[E;4],ap1:&[E;4],scratch:&mut Vec<K>,parts:&mut [E;7])->Result<(),Error>{\n  if !shared_two_point { process_kind(w,1,alpha,f,folds,n,ap0,ap1,scratch,parts)?; }\n  process_kind(w,2,alpha,f,folds,n,ap0,ap1,scratch,parts)?;\n  if !shared_two_point { process_kind(w,3,alpha,f,folds,n,ap0,ap1,scratch,parts)?; }\n  process_kind(w,5,alpha,f,folds,n,ap0,ap1,scratch,parts)?;\n  process_kind(w,6,alpha,f,folds,n,ap0,ap1,scratch,parts)?;\n  Ok(())\n }\nfn shared_partials(f:&[u8],common:&[K;16])->Result<[E;4],Error>{\n  let mut partials=[E::ZERO;4];\n  for s in 0..4 { partials[s]=partial_dot(f,common,s)?; }\n  Ok(partials)\n }\nfn shared_high(partials:&[E;4],w:&Weights,ap0:&[E;4],ap1:&[E;4],parts:&mut [E;7])->Result<(),Error>{\n  let high0=high_dot(partials,&w.factors[0][4])?;\n  let scale0=Weights::scalar_factor(&w.factors[0][0],ap0)\n    .mul(Weights::scalar_factor(&w.factors[0][1],ap1));\n  parts[1]=scale0.mul(high0);\n  let high2=high_dot(partials,&w.factors[2][4])?;\n  let scale2=Weights::scalar_factor(&w.factors[2][0],ap0)\n    .mul(Weights::scalar_factor(&w.factors[2][1],ap1));\n  parts[3]=scale2.mul(high2);\n  Ok(())\n }\nfn process_kind(w:&Weights,kind:usize,alpha:&[E],f:&[u8],folds:usize,n:usize,\n     ap0:&[E;4],ap1:&[E;4],scratch:&mut Vec<K>,parts:&mut [E;7])->Result<(),Error>{\n  if w.variant==Variant::D && kind<4 {\n   parts[kind]=w.dense_point_pair(kind,alpha,f)?;\n  } else {\n   let k=if kind<4 {kind-1}else{kind-2};\n   w.tensor(k,folds,scratch);\n   let mut scale=Weights::scalar_factor(&w.factors[k][0],ap0);\n   if folds==2 {scale=scale.mul(Weights::scalar_factor(&w.factors[k][1],ap1));}\n   let mut pair=crate::fast_pairing::EbyKDot::new();\n   push_byte_products(&mut pair,f,scratch,n)?;\n   parts[kind]=scale.mul(pair.finish());\n  }\n  Ok(())\n }\n\npub struct Weights {\n    pub variant:Variant,\n    pub factors:[[[K;4];5];5],\n    pub points:[[K;10];3],\n    pub extra:[K;2],\n}\nimpl Weights {\n    #[inline(never)]\n    fn box_from_parts(variant:Variant,factors:[[[K;4];5];5],points:[[K;10];3],extra:[K;2])->Box<Self> {\n        Box::new(Self { variant, factors, points, extra })\n    }\n    #[inline(never)]\n    pub fn new(variant:Variant,alpha:&[K;10],z:&[SecureCirclePoint;2])->Result<Box<Self>,Error> {\n        let points=aspis_core::state_only_prefix::r0::statement_points(alpha);\n        let extra=[alpha[8],alpha[9]];\n        let mut factors=[[[K::ZERO;4];5];5];\n        for k in 0..3 { for d in 0..5 {\n            let a=points[k][9-2*TAU[d]]; let b=points[k][8-2*TAU[d]];\n            factors[k][d]=[K::ONE.sub(a).mul(K::ONE.sub(b)),a.mul(K::ONE.sub(b)),K::ONE.sub(a).mul(b),a.mul(b)];\n        }}\n        for k in 0..2 {\n            factors[3+k][0]=[K::ONE,z[k].y,z[k].x,z[k].x.mul(z[k].y)];\n            let mut x=double(z[k].x);\n            for d in 1..5 {\n                let y=double(x); factors[3+k][d]=[K::ONE,x,y,x.mul(y)]; x=double(y);\n            }\n        }\n        Ok(Self::box_from_parts(variant, factors, points, extra))\n    }\n    pub fn raw(&self,kind:usize,j:usize)->K {\n        match kind {\n            0=>if aspis_core::r0::opening::inactive(self.variant.row(j)).unwrap() {K::ONE} else {K::ZERO},\n            4=>if j<56 { self.extra[j/28].pow((j%28) as u64) } else {K::ZERO},\n            1..=3 if self.variant==Variant::D => {\n                let r=self.variant.row(j);\n                (0..10).fold(K::ONE,|v,b|v.mul(if r&(1<<b)==0 {K::ONE.sub(self.points[kind-1][9-b])}else{self.points[kind-1][9-b]}))\n            },\n            _=> {\n                let k=if kind<4 {kind-1}else{kind-2};\n                (0..5).fold(K::ONE,|v,d|v.mul(self.factors[k][d][(j>>(2*d))&3]))\n            }\n        }\n    }\n    fn scalar_factor(f:&[K;4],p:&[E;4])->E {\n        (0..4).fold(E::ZERO,|v,s|v.add(p[PERM[s]].mul_qm31(f[s]))).mul_m31(QUARTER)\n    }\n    fn tensor(&self,k:usize,folds:usize,output:&mut[K]) {\n        output[0]=K::ONE;let mut n=1;\n        for d in folds..5 {\n            for j in (0..n).rev() {\n                let x=output[j];\n                output[j+0*n]=x.mul(self.factors[k][d][0]);\n                output[j+1*n]=x.mul(self.factors[k][d][1]);\n                output[j+2*n]=x.mul(self.factors[k][d][2]);\n                output[j+3*n]=x.mul(self.factors[k][d][3]);\n            }\n            n*=4;\n        }\n    }\n    pub fn dual_raw(&self,kind:usize,j:usize,alpha:&[E])->E {\n        let p0=powers::<4>(alpha[0]);\n        let p1=if alpha.len()==2 {powers::<4>(alpha[1])}else{[E::ONE;4]};\n        let width=1<<(2*alpha.len());\n        let mut sum=E::ZERO;\n        for s in 0..width {\n            let p=p0[PERM[s%4]].mul(p1[PERM[s/4]]);\n            sum=sum.add(p.mul_qm31(self.raw(kind,width*j+s)));\n        }\n        for _ in alpha { sum=sum.mul_m31(QUARTER); }\n        sum\n    }\n    /// Product rows keep a K tensor after their low digits have been folded.\n    /// Only the contracted scalar is in E. Sparse rows are handled separately.\n    #[inline(never)]\n    pub fn pair(&self,alpha:&[E],f:&[u8],kappa:E)->Result<E,Error> {\n        let n=f.len()/32; let folds=alpha.len();\n        let mut expected_n=1024usize; for _ in 0..folds { expected_n=expected_n>>2u32; } if n!=expected_n {return Err(Error::Parse);}\n        let ap0=powers::<4>(alpha[0]);\n        let ap1=if folds==2 {powers::<4>(alpha[1])}else{[E::ONE;4]};\n        let mut scratch=match aspis_core::r0::heap::filled(n,K::ZERO) { Ok(v) => v, Err(_) => return Err(Error::Allocation) };\n        let mut parts=[E::ZERO;7];\n        // On S2's two-fold path the high tensor factors for point rows 0 and\n        // 2 are identical. Keep the equality guard so arbitrary constructed\n        // `Weights` values retain the original per-row fallback.\n        let shared_two_point=shared_two_point_guard(self,folds);\n        process_regular_kinds(self,shared_two_point,alpha,f,folds,n,&ap0,&ap1,&mut scratch,&mut parts)?;\n        if shared_two_point {\n            // The two point rows share the d2/d3 coefficients. Preserve the\n            // tensor's least-significant-first order: d2 is j mod 4 and d3\n            // is j / 4. Each d4 slice then contracts one 16-term EbyKDot.\n            let mut common=[K::ZERO;16];\n            for j in 0..16 { common[j]=self.factors[0][2][j&3].mul(self.factors[0][3][j>>2u32]); }\n            let partials=shared_partials(f,&common)?;\n            shared_high(&partials,self,&ap0,&ap1,&mut parts)?;\n        }\n        if folds==1 {\n            let mut dual=[E::ZERO;16];\n            for mask in 0..16 {\n                let mut weight=E::ZERO;\n                for s in 0..4 { if mask&(1usize<<(s as u32))!=0 { weight=weight.add(ap0[PERM[s]]); } }\n                dual[mask]=weight.mul_m31(QUARTER);\n            }\n            let mut groups=[E::ZERO;16];\n            for j in 0..n {\n                let mut mask=0;\n                for s in 0..4 {if self.raw(0,4*j+s)==K::ONE {mask|=1usize<<(s as u32);}}\n                groups[mask]=groups[mask].add(field(f,j));\n            }\n            for m in 1..16 {parts[0]=parts[0].add(groups[m].mul(dual[m]));}\n            for side in 0..2 {\n                let p=kpowers::<5>(self.extra[side]);\n                let scale=Self::scalar_factor(&[p[0],p[1],p[2],p[3]],&ap0);\n                let mut power=K::ONE; let mut pair=E::ZERO;\n                for j in 0..7 {pair=pair.add(field(f,j+7*side).mul_qm31(power));power=power.mul(p[4]);}\n                parts[4]=parts[4].add(pair.mul(scale));\n            }\n        } else {\n            // Two-fold 0/1 row: compute the sixteen challenge products once.\n            // Coefficients with the same inactive mask share one subset sum.\n            let mut low=[E::ZERO;16];\n            for s in 0..16 { low[s]=ap0[PERM[s%4]].mul(ap1[PERM[s/4]]).mul_m31(QUARTER.mul(QUARTER)); }\n            parts[0]=grouped_inactive_pair(self,f,&low);\n            let libra=if self.variant==Variant::S2 {factored_s2_libra_weights(&ap0,&ap1,self.extra)}else{twofold_libra_weights(&low,self.extra)};\n            for j in 0..4 {parts[4]=parts[4].add(field(f,j).mul(libra[j]));}\n        }\n        #[cfg(feature=\"prover\")]\n        for kind in 0..7 {\n            for j in 0..1024 {crate::trace::value(6,kind*1024+j,E::from_qm31(self.raw(kind,j)));}\n            for j in 0..n {crate::trace::value(7,kind*n+j,self.dual_raw(kind,j,alpha));}\n        }\n        let k=powers::<7>(kappa);let mut sum=E::ZERO;\n        for kind in 0..7 {crate::trace::value(8,kind,parts[kind]);sum=sum.add(k[kind].mul(parts[kind]));}\n        Ok(sum)\n    }\n    #[inline(never)]\n    fn dense_point_pair(&self,kind:usize,alpha:&[E],f:&[u8])->Result<E,Error> {\n        // D keeps the full eq tensor. Hoist the sixteen shared E products\n        // before combining its K entries; no tensor factorization is assumed.\n        let mut rows=match aspis_core::r0::heap::filled(1024,K::ZERO) { Ok(v) => v, Err(_) => return Err(Error::Allocation) };\n        rows[0]=K::ONE;let mut width=1;\n        for b in 0..10 {\n            let p=self.points[kind-1][9-b];\n            for j in (0..width).rev() {let x=rows[j];rows[j+width]=x.mul(p);rows[j]=x.mul(K::ONE.sub(p));}\n            width*=2;\n        }\n        let a=powers::<4>(alpha[0]);let b=powers::<4>(alpha[1]);\n        let mut low=[E::ZERO;16];\n        for s in 0..16 { low[s]=a[PERM[s%4]].mul(b[PERM[s/4]]).mul_m31(QUARTER.mul(QUARTER)); }\n        let mut pair=E::ZERO;\n        for j in 0..64 {\n            let mut w=E::ZERO;\n            for s in 0..16 {w=w.add(low[s].mul_qm31(rows[self.variant.row(16*j+s)]));}\n            pair=pair.add(field(f,j).mul(w));\n        }\n        Ok(pair)\n    }\n    pub fn materialize(&self,kappa:E)->Result<Vec<E>,Error> {\n        let kp=powers::<7>(kappa);\n        let mut w=match aspis_core::r0::heap::filled(1024,E::ZERO) { Ok(v) => v, Err(_) => return Err(Error::Allocation) };\n        for (j,v) in w.iter_mut().enumerate() {for kind in 0..7 {*v=v.add(kp[kind].mul_qm31(self.raw(kind,j)));}}\n        Ok(w)\n    }\n}\n\n#[cfg(test)]\nmod s2_inactive_table_tests {\n    use super::*;\n    #[test]\n    fn all_s2_inactive_table_entries_match_reference() {\n        for j in 0..64 {\n            let group=S2_INACTIVE_GROUPS[j] as usize;\n            assert!(group<S2_INACTIVE_MASKS.len());\n            for bit in 0..16 {\n                assert_eq!((S2_INACTIVE_MASKS[group]>>bit)&1!=0,\n                    aspis_core::r0::opening::inactive(Variant::S2.row(16*j+bit)).unwrap());\n            }\n        }\n        // Equality of each coefficient's scalar factor establishes the\n        // regrouping identity independently of particular message values.\n        for bit in 0..16 {\n            let low=core::array::from_fn(|i|if i==bit {E::ONE}else{E::ZERO});\n            for j in 0..64 {\n                let mut f=alloc::vec![0u8;64*32];f[j*32..(j+1)*32].copy_from_slice(&E::ONE.to_le_bytes());\n                let expected=if aspis_core::r0::opening::inactive(Variant::S2.row(16*j+bit)).unwrap(){E::ONE}else{E::ZERO};\n                assert_eq!(s2_grouped_inactive_pair(&f,&low),expected);\n            }\n        }\n    }\n}\n\n#[cfg(test)]\nmod libra_factor_tests {\n    use super::*;\n    #[test]\n    fn factored_libra_matches_all_four_original_weights() {\n        let mut state=0x13198a2e03707344u64;\n        let mut field=|| {state=state.wrapping_mul(6364136223846793005).wrapping_add(1);(state%u64::from(aspis_core::field::P)) as u32};\n        for case in 0..512 {\n            let mut value=||E::from_limbs(core::array::from_fn(|_|match case {0=>0,1=>1,2=>aspis_core::field::P-1,_=>field()})).unwrap();\n            let ap0=core::array::from_fn(|_|value());let ap1=core::array::from_fn(|_|value());\n            let extra=[value().c0(),value().c0()];\n            let low=core::array::from_fn(|s|ap0[PERM[s%4]].mul(ap1[PERM[s/4]]).mul_m31(QUARTER.mul(QUARTER)));\n            assert_eq!(factored_s2_libra_weights(&ap0,&ap1,extra),twofold_libra_weights(&low,extra),\"case {case}\");\n        }\n    }\n}\n"},{"id":2,"name":{"Local":"/home/dombarker/project-offloads/codex-cx-op4-install-20261025/src/crates/aspis-core/src/field/wide_exact.rs"},"crate_name":"aspis_core","contents":null},{"id":3,"name":{"Local":"/home/dombarker/project-offloads/codex-cx-op4-install-20261025/src/crates/aspis-core/src/field.rs"},"crate_name":"aspis_core","contents":null},{"id":4,"name":{"Local":"/home/dombarker/project-offloads/codex-cx-op4-install-20261025/src/crates/aspis-core/src/lib.rs"},"crate_name":"aspis_core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"src/FIn_verifier.rs"},"crate_name":"fin_pair_extraction","contents":"#[derive(Debug,Clone,Copy,PartialEq,Eq)]\npub enum Error { Parse,Semantic,Transcript,Relation,Merkle,Query,Checkpoint,Allocation,\n    /// Host prover only (LOG D38.3): this attempt's challenges fail the public\n    /// P_R1 check. Carries no challenge and no conjunct.\n    #[cfg(feature=\"prover\")] Rejected,\n    /// Host prover only (D38.3): all N = 8 attempts were rejected; nothing is published.\n    #[cfg(feature=\"prover\")] AttemptsExhausted,\n    /// Host prover only: the operating-system entropy source failed.\n    #[cfg(feature=\"prover\")] Entropy }\n"},{"id":8,"name":{"Local":"src/FIn_transport.rs"},"crate_name":"fin_pair_extraction","contents":"//! UNPROVED COST PROBE. S uses the D18 digit permutation; D uses retained D13.\n#[derive(Clone,Copy,Debug,PartialEq,Eq)]\npub enum Variant { S1, S2, D }\npub const TAU: [usize; 5] = [3, 4, 2, 0, 1];\nimpl Variant {\n    pub fn tag(self) -> u8 { match self { Self::S1=>1,Self::S2=>2,Self::D=>3 } }\n    pub fn from_tag(tag:u8) -> Option<Self> { match tag {1=>Some(Self::S1),2=>Some(Self::S2),3=>Some(Self::D),_=>None} }\n    pub fn folds(self) -> usize { if self == Self::S1 { 1 } else { 2 } }\n    pub fn final_len(self) -> usize { 1024 >> (2*self.folds()) }\n    pub fn row(self, j:usize) -> usize {\n        if self == Self::D { return aspis_core::r0::transport::COEFFICIENT_TO_ROW[j] as usize; }\n        let mut out=0;\n        for d in 0..5 { out |= ((j>>(2*d))&3) << (2*TAU[d]); }\n        out\n    }\n    pub fn coefficients<T:Copy>(self, rows: &[T;1024]) -> [T;1024] {\n        core::array::from_fn(|j|rows[self.row(j)])\n    }\n    pub fn rows<T:Copy>(self, coefficients: &[T;1024]) -> [T;1024] {\n        let mut out=*coefficients;\n        for j in 0..1024 { out[self.row(j)]=coefficients[j]; }\n        out\n    }\n}\n"}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["fin_pair_extraction",0]},{"Ident":["FIn_pair",0]}]},{"key":{"Type":0},"value":[{"Ident":["fin_pair_extraction",0]},{"Ident":["weights",0]},{"Ident":["Weights",0]}]},{"key":{"Type":1},"value":[{"Ident":["aspis_core",0]},{"Ident":["field",0]},{"Ident":["wide_exact",0]},{"Ident":["WideExact",0]}]},{"key":{"Type":2},"value":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}]},{"key":{"Type":3},"value":[{"Ident":["fin_pair_extraction",0]},{"Ident":["verifier",0]},{"Ident":["Error",0]}]},{"key":{"Type":4},"value":[{"Ident":["fin_pair_extraction",0]},{"Ident":["transport",0]},{"Ident":["Variant",0]}]},{"key":{"Type":5},"value":[{"Ident":["aspis_core",0]},{"Ident":["field",0]},{"Ident":["QM31",0]}]}],"assoc_item_names":[],"short_names":[{"key":{"Type":4},"value":[{"Ident":["Variant",0]}]},{"key":{"Type":5},"value":[{"Ident":["QM31",0]}]},{"key":{"Type":3},"value":[{"Ident":["Error",0]}]},{"key":{"Type":2},"value":[{"Ident":["Result",0]}]},{"key":{"Fun":0},"value":[{"Ident":["FIn_pair",0]}]},{"key":{"Type":0},"value":[{"Ident":["Weights",0]}]},{"key":{"Type":1},"value":[{"Ident":["WideExact",0]}]}],"type_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["fin_pair_extraction",0]},{"Ident":["weights",0]},{"Ident":["Weights",0]}],"span":{"data":{"file_id":1,"beg":{"line":194,"col":0},"end":{"line":199,"col":1}},"generated_from_span":null},"source_text":"pub struct Weights {\n    pub variant:Variant,\n    pub factors:[[[K;4];5];5],\n    pub points:[[K;10];3],\n    pub extra:[K;2],\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":1,"beg":{"line":195,"col":4},"end":{"line":195,"col":23}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"variant","ty":{"HashConsedValue":[681,{"Adt":{"id":{"Adt":4},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}},{"span":{"data":{"file_id":1,"beg":{"line":196,"col":4},"end":{"line":196,"col":29}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"factors","ty":{"HashConsedValue":[684,{"Array":[{"HashConsedValue":[683,{"Array":[{"HashConsedValue":[682,{"Array":[{"HashConsedValue":[507,{"Adt":{"id":{"Adt":5},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]},{"kind":{"Literal":{"Scalar":{"Unsigned":["Usize","4"]}}},"ty":{"HashConsedValue":[508,{"Literal":{"UInt":"Usize"}}]}}]}]},{"kind":{"Literal":{"Scalar":{"Unsigned":["Usize","5"]}}},"ty":{"Deduplicated":508}}]}]},{"kind":{"Literal":{"Scalar":{"Unsigned":["Usize","5"]}}},"ty":{"Deduplicated":508}}]}]}},{"span":{"data":{"file_id":1,"beg":{"line":197,"col":4},"end":{"line":197,"col":25}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"points","ty":{"HashConsedValue":[686,{"Array":[{"HashConsedValue":[685,{"Array":[{"Deduplicated":507},{"kind":{"Literal":{"Scalar":{"Unsigned":["Usize","10"]}}},"ty":{"Deduplicated":508}}]}]},{"kind":{"Literal":{"Scalar":{"Unsigned":["Usize","3"]}}},"ty":{"Deduplicated":508}}]}]}},{"span":{"data":{"file_id":1,"beg":{"line":198,"col":4},"end":{"line":198,"col":19}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"extra","ty":{"HashConsedValue":[687,{"Array":[{"Deduplicated":507},{"kind":{"Literal":{"Scalar":{"Unsigned":["Usize","2"]}}},"ty":{"Deduplicated":508}}]}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":2116,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[2112,0,1600,2080],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":1,"item_meta":{"name":[{"Ident":["aspis_core",0]},{"Ident":["field",0]},{"Ident":["wide_exact",0]},{"Ident":["WideExact",0]}],"span":{"data":{"file_id":2,"beg":{"line":28,"col":0},"end":{"line":28,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `E = QM31[v]/(v² - u)`, where `u² = 2+i` and `i² = -1`."},{"DocComment":""},{"DocComment":" Exactly two QM31 coordinates, `c0 + c1*v`, or eight canonical M31 limbs."},{"DocComment":" For digits `d[0..8]` in `[0, P)`, the exact decode formula is"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" decode4(a,b,c,d) = (a + b*i) + (c + d*i)*u"},{"DocComment":" decode8(d) = decode4(d0,d1,d2,d3) + decode4(d4,d5,d6,d7)*v"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Thus limb order is `(c0.c0.a, c0.c0.b, c0.c1.a, c0.c1.b,"},{"DocComment":" c1.c0.a, c1.c0.b, c1.c1.a, c1.c1.b)`, matching"},{"DocComment":" `R0C/ModuloField.lean:digitsField_apply` (lines 38–40) and"},{"DocComment":" `AspisV8R19/SamplerFieldDecode.lean:decode4` (line 10)."},{"DocComment":" `WideTower.lean:qm31_wideU_not_isSquare` supplies the mathematical"},{"DocComment":" non-residue fact; `wideExact_card` gives `|E| = P^8`."},{"DocComment":" These references specify the arithmetic; they do not prove this Rust code."},{"DocComment":""},{"DocComment":" Coordinates are private to preserve canonicality. Algebraic constructors"},{"DocComment":" reduce raw QM31 representatives; wire/digit decoders reject noncanonical"},{"DocComment":" input. All operations are total except inversion, which returns `None` at"},{"DocComment":" zero. This reference implementation makes no constant-time claim."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Opaque","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":32,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,16],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":2,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}],"span":{"data":{"file_id":5,"beg":{"line":557,"col":0},"end":{"line":557,"col":21}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Result` is a type that represents either success ([`Ok`]) or failure 