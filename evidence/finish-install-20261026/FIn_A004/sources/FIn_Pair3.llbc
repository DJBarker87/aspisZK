{"charon_version":"0.1.223","translated":{"crate_name":"fin_pair_extraction","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::FIn_pair"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["crate::weights","crate::fast_pairing","crate::transport","crate::trace","crate::verifier","crate::FIn_pair","core::result::Result"],"opaque":["crate","aspis_core"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-sound-int2-20261025/FIn_Pair3.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"fin_pair_extraction","contents":"#![allow(non_snake_case,dead_code,unexpected_cfgs)]\nextern crate alloc;\n#[path=\"FIn_weights.rs\"] pub mod weights;\n#[path=\"FIn_fast_pairing.rs\"] pub mod fast_pairing;\n#[path=\"FIn_transport.rs\"] pub mod transport;\n#[path=\"FIn_verifier.rs\"] pub mod verifier;\n#[path=\"FIn_trace.rs\"] pub mod trace;\npub fn FIn_pair(w:&weights::Weights,alpha:&[aspis_core::field::WideExact],f:&[u8],kappa:aspis_core::field::WideExact)->Result<aspis_core::field::WideExact,verifier::Error> {w.pair(alpha,f,kappa)}\n"},{"id":1,"name":{"Local":"src/FIn_weights.rs"},"crate_name":"fin_pair_extraction","contents":"//! UNPROVED COST PROBE. Seven coefficient functionals and their dual folds.\nuse alloc::{boxed::Box,vec::Vec};\nuse aspis_core::{field::{QM31 as K,WideExact as E,M31},circle::SecureCirclePoint};\nuse crate::{transport::{Variant,TAU},verifier::Error};\npub const QUARTER:M31=M31(536870912);\npub const PERM:[usize;4]=[0,3,2,1];\npub fn powers<const N:usize>(x:E)->[E;N]{\n let mut out=[E::ZERO;N];\n let mut p=E::ONE;\n let mut i=0usize;\n while i<N {\n  out[i]=p;\n  i+=1;\n  if i==N { return out; }\n  p=p.mul(x);\n }\n out\n}\npub fn kpowers<const N:usize>(x:K)->[K;N]{\n let mut out=[K::ZERO;N]; let mut p=K::ONE;\n for i in 0..N { out[i]=p; p=p.mul(x); }\n out\n}\npub fn double(x:K)->K { x.mul(x).add(x.mul(x)).sub(K::ONE) }\npub fn field(bytes:&[u8],i:usize)->E { E::from_le_bytes(&bytes[i*32..(i+1)*32]).unwrap() }\n\n// Exact S2 coefficient-to-row inactive classification, in first-occurrence order.\n// Exhaustive table correspondence is checked against Variant::row and raw(0, _).\nconst S2_INACTIVE_GROUPS:[u8;64]=[0,1,2,3,4,5,5,6,4,5,5,5,7,7,7,7,7,7,7,4,4,5,5,6,4,5,5,5,7,7,7,4,7,7,7,7,4,5,5,5,4,5,5,5,8,9,10,8,11,2,2,10,4,5,5,6,4,5,5,6,7,7,7,7];\nconst S2_INACTIVE_MASKS:[u16;12]=[32769,49217,49280,16448,32767,16383,49151,65535,49152,57344,49216,33024];\n\n#[inline(never)]\nfn s2_grouped_inactive_pair(f:&[u8],low:&[E;16])->E {\n    let mut coefficients=[E::ZERO;12];\n    for j in 0..64 {\n        let group=S2_INACTIVE_GROUPS[j] as usize;\n        coefficients[group]=coefficients[group].add(field(f,j));\n    }\n    let mut pair=E::ZERO;\n    for group in 0..12 {\n        let mut weight=E::ZERO;\n        for bit in 0..16 {\n            let challenge=low[bit];\n            if S2_INACTIVE_MASKS[group]&(1<<bit)!=0 {weight=weight.add(challenge);}\n        }\n        pair=pair.add(coefficients[group].mul(weight));\n    }\n    pair\n}\n\n/// Contract the inactive row after combining coefficients with the same\n/// sixteen-entry inactive mask. The zero mask is retained as a group; its\n/// subset weight is zero, matching the ungrouped sum.\n#[inline(never)]\nfn grouped_inactive_pair(weights:&Weights,f:&[u8],low:&[E;16])->E {\n    if weights.variant==Variant::S2 && f.len()==64*32 {return s2_grouped_inactive_pair(f,low);}\n    let mut group_masks=[0u16;64];\n    let mut group_coefficients=[E::ZERO;64];\n    let mut groups=0;\n    for j in 0..f.len()/32 {\n        let mut mask=0u16;\n        for s in 0..16 {if weights.raw(0,16*j+s)==K::ONE {mask|=1<<s;}}\n        let coefficient=field(f,j);\n        let mut group=0;\n        while group<groups && group_masks[group]!=mask {group+=1;}\n        if group==groups {group_masks[group]=mask;groups+=1;}\n        group_coefficients[group]=group_coefficients[group].add(coefficient);\n    }\n    let mut pair=E::ZERO;\n    for group in 0..groups {\n        let mask=group_masks[group];\n        let mut weight=E::ZERO;\n        for s in 0..16 {\n            let challenge=low[s];\n            if mask&(1<<s)!=0 {weight=weight.add(challenge);}\n        }\n        pair=pair.add(group_coefficients[group].mul(weight));\n    }\n    pair\n}\n\n/// Build the four two-fold Libra dual weights without per-cell exponentiation.\n#[inline(never)]\nfn twofold_libra_weights(low:&[E;16],extra:[K;2])->[E;4] {\n    let mut powers=[[K::ZERO;28];2];\n    for side in 0..2 {\n        let mut power=K::ONE;\n        for index in 0..28 { powers[side][index]=power; power=power.mul(extra[side]); }\n    }\n    let mut out=[E::ZERO;4];\n    for j in 0..4 {\n        let mut weight=E::ZERO;\n        for s in 0..16 {\n            let index=16*j+s;\n            if index<56 { weight=weight.add(low[s].mul_qm31(powers[index/28][index%28])); }\n        }\n        out[j]=weight;\n    }\n    out\n}\n\n/// Exact factorization of the existing 56-entry Libra row into two 28-entry\n/// geometric runs. The 16-entry low tensor is a product of two four-entry\n/// tensors; the only cut blocks have lengths 12 and 4 (28 = 16 + 12).\n#[inline(never)]\nfn factored_s2_libra_weights(ap0:&[E;4],ap1:&[E;4],extra:[K;2])->[E;4] {\n    let mut weights=[E::ZERO;4];\n    for side in 0..2 {\n        let q0=K::ONE;\n        let q1=q0.mul(extra[side]);\n        let q2=q1.mul(extra[side]);\n        let q3=q2.mul(extra[side]);\n        let _q4=q3.mul(extra[side]);\n        let q=[q0,q1,q2,q3];\n        let q4=q[2].square();let q8=q4.square();let q12=q8.mul(q4);let q16=q8.square();\n        let low=Weights::scalar_factor(&q,ap0);\n        let high_powers=[K::ONE,q4,q8,q12];\n        let term0=ap1[PERM[0]].mul_qm31(high_powers[0]).mul_m31(QUARTER);\n        let term1=ap1[PERM[1]].mul_qm31(high_powers[1]).mul_m31(QUARTER);\n        let term2=ap1[PERM[2]].mul_qm31(high_powers[2]).mul_m31(QUARTER);\n        let term3=ap1[PERM[3]].mul_qm31(high_powers[3]).mul_m31(QUARTER);\n        let terms=[term0,term1,term2,term3];\n        let first2=terms[0].add(terms[1]);let first3=first2.add(terms[2]);let all=first3.add(terms[3]);\n        if side==0 {\n            weights[0]=low.mul(all);\n            weights[1]=low.mul(first3).mul_qm31(q16);\n        } else {\n            weights[1]=weights[1].add(low.mul(ap1[PERM[3]].mul_m31(QUARTER)));\n            weights[2]=low.mul(all).mul_qm31(q4);\n            weights[3]=low.mul(first2).mul_qm31(q16.mul(q4));\n        }\n    }\n    weights\n}\n\nfn shared_two_point_guard(w:&Weights,folds:usize)->bool {\n    w.variant==Variant::S2 && folds==2 && w.factors[0][2]==w.factors[2][2] && w.factors[0][3]==w.factors[2][3]\n }\nfn push_byte_products(pair:&mut crate::fast_pairing::EbyKDot,f:&[u8],scratch:&[K],n:usize)->Result<(),Error>{\n  for j in 0..n { match pair.push(field(f,j),scratch[j]) { Ok(()) => {}, Err(_) => return Err(Error::Parse) } }\n  Ok(())\n }\nfn partial_dot(f:&[u8],common:&[K;16],s:usize)->Result<E,Error>{\n  let mut dot=crate::fast_pairing::EbyKDot::new();\n  for j in 0..16 { match dot.push(field(f,16*s+j),common[j]) { Ok(()) => {}, Err(_) => return Err(Error::Parse) } }\n  Ok(dot.finish())\n }\nfn high_dot(partials:&[E;4],coeffs:&[K;4])->Result<E,Error>{\n  let mut high=crate::fast_pairing::EbyKDot::new();\n  for s in 0..4 { match high.push(partials[s],coeffs[s]) { Ok(()) => {}, Err(_) => return Err(Error::Parse) } }\n  Ok(high.finish())\n }\nfn process_regular_kinds(w:&Weights,shared_two_point:bool,alpha:&[E],f:&[u8],folds:usize,n:usize,\n     ap0:&[E;4],ap1:&[E;4],scratch:&mut Vec<K>,parts:&mut [E;7])->Result<(),Error>{\n  if !shared_two_point { process_kind(w,1,alpha,f,folds,n,ap0,ap1,scratch,parts)?; }\n  process_kind(w,2,alpha,f,folds,n,ap0,ap1,scratch,parts)?;\n  if !shared_two_point { process_kind(w,3,alpha,f,folds,n,ap0,ap1,scratch,parts)?; }\n  process_kind(w,5,alpha,f,folds,n,ap0,ap1,scratch,parts)?;\n  process_kind(w,6,alpha,f,folds,n,ap0,ap1,scratch,parts)?;\n  Ok(())\n }\nfn shared_partials(f:&[u8],common:&[K;16])->Result<[E;4],Error>{\n  let mut partials=[E::ZERO;4];\n  for s in 0..4 { partials[s]=partial_dot(f,common,s)?; }\n  Ok(partials)\n }\nfn shared_high(partials:&[E;4],w:&Weights,ap0:&[E;4],ap1:&[E;4],parts:&mut [E;7])->Result<(),Error>{\n  let high0=high_dot(partials,&w.factors[0][4])?;\n  let scale0=Weights::scalar_factor(&w.factors[0][0],ap0)\n    .mul(Weights::scalar_factor(&w.factors[0][1],ap1));\n  parts[1]=scale0.mul(high0);\n  let high2=high_dot(partials,&w.factors[2][4])?;\n  let scale2=Weights::scalar_factor(&w.factors[2][0],ap0)\n    .mul(Weights::scalar_factor(&w.factors[2][1],ap1));\n  parts[3]=scale2.mul(high2);\n  Ok(())\n }\nfn process_kind(w:&Weights,kind:usize,alpha:&[E],f:&[u8],folds:usize,n:usize,\n     ap0:&[E;4],ap1:&[E;4],scratch:&mut Vec<K>,parts:&mut [E;7])->Result<(),Error>{\n  if w.variant==Variant::D && kind<4 {\n   parts[kind]=w.dense_point_pair(kind,alpha,f)?;\n  } else {\n   let k=if kind<4 {kind-1}else{kind-2};\n   w.tensor(k,folds,scratch);\n   let mut scale=Weights::scalar_factor(&w.factors[k][0],ap0);\n   if folds==2 {scale=scale.mul(Weights::scalar_factor(&w.factors[k][1],ap1));}\n   let mut pair=crate::fast_pairing::EbyKDot::new();\n   push_byte_products(&mut pair,f,scratch,n)?;\n   parts[kind]=scale.mul(pair.finish());\n  }\n  Ok(())\n }\n\npub struct Weights {\n    pub variant:Variant,\n    pub factors:[[[K;4];5];5],\n    pub points:[[K;10];3],\n    pub extra:[K;2],\n}\nimpl Weights {\n    #[inline(never)]\n    fn box_from_parts(variant:Variant,factors:[[[K;4];5];5],points:[[K;10];3],extra:[K;2])->Box<Self> {\n        Box::new(Self { variant, factors, points, extra })\n    }\n    #[inline(never)]\n    pub fn new(variant:Variant,alpha:&[K;10],z:&[SecureCirclePoint;2])->Result<Box<Self>,Error> {\n        let points=aspis_core::state_only_prefix::r0::statement_points(alpha);\n        let extra=[alpha[8],alpha[9]];\n        let mut factors=[[[K::ZERO;4];5];5];\n        for k in 0..3 { for d in 0..5 {\n            let a=points[k][9-2*TAU[d]]; let b=points[k][8-2*TAU[d]];\n            factors[k][d]=[K::ONE.sub(a).mul(K::ONE.sub(b)),a.mul(K::ONE.sub(b)),K::ONE.sub(a).mul(b),a.mul(b)];\n        }}\n        for k in 0..2 {\n            factors[3+k][0]=[K::ONE,z[k].y,z[k].x,z[k].x.mul(z[k].y)];\n            let mut x=double(z[k].x);\n            for d in 1..5 {\n                let y=double(x); factors[3+k][d]=[K::ONE,x,y,x.mul(y)]; x=double(y);\n            }\n        }\n        Ok(Self::box_from_parts(variant, factors, points, extra))\n    }\n    pub fn raw(&self,kind:usize,j:usize)->K {\n        match kind {\n            0=>if aspis_core::r0::opening::inactive(self.variant.row(j)).unwrap() {K::ONE} else {K::ZERO},\n            4=>if j<56 { self.extra[j/28].pow((j%28) as u64) } else {K::ZERO},\n            1..=3 if self.variant==Variant::D => {\n                let r=self.variant.row(j);\n                (0..10).fold(K::ONE,|v,b|v.mul(if r&(1<<b)==0 {K::ONE.sub(self.points[kind-1][9-b])}else{self.points[kind-1][9-b]}))\n            },\n            _=> {\n                let k=if kind<4 {kind-1}else{kind-2};\n                (0..5).fold(K::ONE,|v,d|v.mul(self.factors[k][d][(j>>(2*d))&3]))\n            }\n        }\n    }\n    fn scalar_factor(f:&[K;4],p:&[E;4])->E {\n        (0..4).fold(E::ZERO,|v,s|v.add(p[PERM[s]].mul_qm31(f[s]))).mul_m31(QUARTER)\n    }\n    fn tensor(&self,k:usize,folds:usize,output:&mut[K]) {\n        output[0]=K::ONE;let mut n=1;\n        for d in folds..5 {\n            for j in (0..n).rev() {\n                let x=output[j];\n                output[j+0*n]=x.mul(self.factors[k][d][0]);\n                output[j+1*n]=x.mul(self.factors[k][d][1]);\n                output[j+2*n]=x.mul(self.factors[k][d][2]);\n                output[j+3*n]=x.mul(self.factors[k][d][3]);\n            }\n            n*=4;\n        }\n    }\n    pub fn dual_raw(&self,kind:usize,j:usize,alpha:&[E])->E {\n        let p0=powers::<4>(alpha[0]);\n        let p1=if alpha.len()==2 {powers::<4>(alpha[1])}else{[E::ONE;4]};\n        let width=1<<(2*alpha.len());\n        let mut sum=E::ZERO;\n        for s in 0..width {\n            let p=p0[PERM[s%4]].mul(p1[PERM[s/4]]);\n            sum=sum.add(p.mul_qm31(self.raw(kind,width*j+s)));\n        }\n        for _ in alpha { sum=sum.mul_m31(QUARTER); }\n        sum\n    }\n    /// Product rows keep a K tensor after their low digits have been folded.\n    /// Only the contracted scalar is in E. Sparse rows are handled separately.\n    #[inline(never)]\n    pub fn pair(&self,alpha:&[E],f:&[u8],kappa:E)->Result<E,Error> {\n        let n=f.len()/32; let folds=alpha.len();\n        let mut expected_n=1024usize; for _ in 0..folds { expected_n=expected_n>>2u32; } if n!=expected_n {return Err(Error::Parse);}\n        let ap0=powers::<4>(alpha[0]);\n        let ap1=if folds==2 {powers::<4>(alpha[1])}else{[E::ONE;4]};\n        let mut scratch=match aspis_core::r0::heap::filled(n,K::ZERO) { Ok(v) => v, Err(_) => return Err(Error::Allocation) };\n        let mut parts=[E::ZERO;7];\n        // On S2's two-fold path the high tensor factors for point rows 0 and\n        // 2 are identical. Keep the equality guard so arbitrary constructed\n        // `Weights` values retain the original per-row fallback.\n        let shared_two_point=shared_two_point_guard(self,folds);\n        process_regular_kinds(self,shared_two_point,alpha,f,folds,n,&ap0,&ap1,&mut scratch,&mut parts)?;\n        if shared_two_point {\n            // The two point rows share the d2/d3 coefficients. Preserve the\n            // tensor's least-significant-first order: d2 is j mod 4 and d3\n            // is j / 4. Each d4 slice then contracts one 16-term EbyKDot.\n            let mut common=[K::ZERO;16];\n            for j in 0..16 { common[j]=self.factors[0][2][j&3].mul(self.factors[0][3][j>>2u32]); }\n            let partials=shared_partials(f,&common)?;\n            shared_high(&partials,self,&ap0,&ap1,&mut parts)?;\n        }\n        if folds==1 {\n            let mut dual=[E::ZERO;16];\n            for mask in 0..16 {\n                let mut weight=E::ZERO;\n                for s in 0..4 { if mask&(1usize<<(s as u32))!=0 { weight=weight.add(ap0[PERM[s]]); } }\n                dual[mask]=weight.mul_m31(QUARTER);\n            }\n            let mut groups=[E::ZERO;16];\n            for j in 0..n {\n                let mut mask=0;\n                for s in 0..4 {if self.raw(0,4*j+s)==K::ONE {mask|=1usize<<(s as u32);}}\n                groups[mask]=groups[mask].add(field(f,j));\n            }\n            for m in 1..16 {parts[0]=parts[0].add(groups[m].mul(dual[m]));}\n            for side in 0..2 {\n                let p=kpowers::<5>(self.extra[side]);\n                let scale=Self::scalar_factor(&[p[0],p[1],p[2],p[3]],&ap0);\n                let mut power=K::ONE; let mut pair=E::ZERO;\n                for j in 0..7 {pair=pair.add(field(f,j+7*side).mul_qm31(power));power=power.mul(p[4]);}\n                parts[4]=parts[4].add(pair.mul(scale));\n            }\n        } else {\n            // Two-fold 0/1 row: compute the sixteen challenge products once.\n            // Coefficients with the same inactive mask share one subset sum.\n            let mut low=[E::ZERO;16];\n            for s in 0..16 { low[s]=ap0[PERM[s%4]].mul(ap1[PERM[s/4]]).mul_m31(QUARTER.mul(QUARTER)); }\n            parts[0]=grouped_inactive_pair(self,f,&low);\n            let libra=if self.variant==Variant::S2 {factored_s2_libra_weights(&ap0,&ap1,self.extra)}else{twofold_libra_weights(&low,self.extra)};\n            for j in 0..4 {parts[4]=parts[4].add(field(f,j).mul(libra[j]));}\n        }\n        #[cfg(feature=\"prover\")]\n        for kind in 0..7 {\n            for j in 0..1024 {crate::trace::value(6,kind*1024+j,E::from_qm31(self.raw(kind,j)));}\n            for j in 0..n {crate::trace::value(7,kind*n+j,self.dual_raw(kind,j,alpha));}\n        }\n        let k=powers::<7>(kappa);let mut sum=E::ZERO;\n        for kind in 0..7 {crate::trace::value(8,kind,parts[kind]);sum=sum.add(k[kind].mul(parts[kind]));}\n        Ok(sum)\n    }\n    #[inline(never)]\n    fn dense_point_pair(&self,kind:usize,alpha:&[E],f:&[u8])->Result<E,Error> {\n        // D keeps the full eq tensor. Hoist the sixteen shared E products\n        // before combining its K entries; no tensor factorization is assumed.\n        let mut rows=match aspis_core::r0::heap::filled(1024,K::ZERO) { Ok(v) => v, Err(_) => return Err(Error::Allocation) };\n        rows[0]=K::ONE;let mut width=1;\n        for b in 0..10 {\n            let p=self.points[kind-1][9-b];\n            for j in (0..width).rev() {let x=rows[j];rows[j+width]=x.mul(p);rows[j]=x.mul(K::ONE.sub(p));}\n            width*=2;\n        }\n        let a=powers::<4>(alpha[0]);let b=powers::<4>(alpha[1]);\n        let mut low=[E::ZERO;16];\n        for s in 0..16 { low[s]=a[PERM[s%4]].mul(b[PERM[s/4]]).mul_m31(QUARTER.mul(QUARTER)); }\n        let mut pair=E::ZERO;\n        for j in 0..64 {\n            let mut w=E::ZERO;\n            for s in 0..16 {w=w.add(low[s].mul_qm31(rows[self.variant.row(16*j+s)]));}\n            pair=pair.add(field(f,j).mul(w));\n        }\n        Ok(pair)\n    }\n    pub fn materialize(&self,kappa:E)->Result<Vec<E>,Error> {\n        let kp=powers::<7>(kappa);\n        let mut w=match aspis_core::r0::heap::filled(1024,E::ZERO) { Ok(v) => v, Err(_) => return Err(Error::Allocation) };\n        for (j,v) in w.iter_mut().enumerate() {for kind in 0..7 {*v=v.add(kp[kind].mul_qm31(self.raw(kind,j)));}}\n        Ok(w)\n    }\n}\n\n#[cfg(test)]\nmod s2_inactive_table_tests {\n    use super::*;\n    #[test]\n    fn all_s2_inactive_table_entries_match_reference() {\n        for j in 0..64 {\n            let group=S2_INACTIVE_GROUPS[j] as usize;\n            assert!(group<S2_INACTIVE_MASKS.len());\n            for bit in 0..16 {\n                assert_eq!((S2_INACTIVE_MASKS[group]>>bit)&1!=0,\n                    aspis_core::r0::opening::inactive(Variant::S2.row(16*j+bit)).unwrap());\n            }\n        }\n        // Equality of each coefficient's scalar factor establishes the\n        // regrouping identity independently of particular message values.\n        for bit in 0..16 {\n            let low=core::array::from_fn(|i|if i==bit {E::ONE}else{E::ZERO});\n            for j in 0..64 {\n                let mut f=alloc::vec![0u8;64*32];f[j*32..(j+1)*32].copy_from_slice(&E::ONE.to_le_bytes());\n                let expected=if aspis_core::r0::opening::inactive(Variant::S2.row(16*j+bit)).unwrap(){E::ONE}else{E::ZERO};\n                assert_eq!(s2_grouped_inactive_pair(&f,&low),expected);\n            }\n        }\n    }\n}\n\n#[cfg(test)]\nmod libra_factor_tests {\n    use super::*;\n    #[test]\n    fn factored_libra_matches_all_four_original_weights() {\n        let mut state=0x13198a2e03707344u64;\n        let mut field=|| {state=state.wrapping_mul(6364136223846793005).wrapping_add(1);(state%u64::from(aspis_core::field::P)) as u32};\n        for case in 0..512 {\n            let mut value=||E::from_limbs(core::array::from_fn(|_|match case {0=>0,1=>1,2=>aspis_core::field::P-1,_=>field()})).unwrap();\n            let ap0=core::array::from_fn(|_|value());let ap1=core::array::from_fn(|_|value());\n            let extra=[value().c0(),value().c0()];\n            let low=core::array::from_fn(|s|ap0[PERM[s%4]].mul(ap1[PERM[s/4]]).mul_m31(QUARTER.mul(QUARTER)));\n            assert_eq!(factored_s2_libra_weights(&ap0,&ap1,extra),twofold_libra_weights(&low,extra),\"case {case}\");\n        }\n    }\n}\n"},{"id":2,"name":{"Local":"/home/dombarker/project-offloads/codex-cx-op4-install-20261025/src/crates/aspis-core/src/field/wide_exact.rs"},"crate_name":"aspis_core","contents":null},{"id":3,"name":{"Local":"/home/dombarker/project-offloads/codex-cx-op4-install-20261025/src/crates/aspis-core/src/field.rs"},"crate_name":"aspis_core","contents":null},{"id":4,"name":{"Local":"/home/dombarker/project-offloads/codex-cx-op4-install-20261025/src/crates/aspis-core/src/lib.rs"},"crate_name":"aspis_core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"src/FIn_verifier.rs"},"crate_name":"fin_pair_extraction","contents":"#[derive(Debug,Clone,Copy,PartialEq,Eq)]\npub enum Error { Parse,Semantic,Transcript,Relation,Merkle,Query,Checkpoint,Allocation,\n    /// Host prover only (LOG D38.3): this attempt's challenges fail the public\n    /// P_R1 check. Carries no challenge and no conjunct.\n    #[cfg(feature=\"prover\")] Rejected,\n    /// Host prover only (D38.3): all N = 8 attempts were rejected; nothing is published.\n    #[cfg(feature=\"prover\")] AttemptsExhausted,\n    /// Host prover only: the operating-system entropy source failed.\n    #[cfg(feature=\"prover\")] Entropy }\n"},{"id":8,"name":{"Local":"src/FIn_transport.rs"},"crate_name":"fin_pair_extraction","contents":"//! UNPROVED COST PROBE. S uses the D18 digit permutation; D uses retained D13.\n#[derive(Clone,Copy,Debug,PartialEq,Eq)]\npub enum Variant { S1, S2, D }\npub const TAU: [usize; 5] = [3, 4, 2, 0, 1];\nimpl Variant {\n    pub fn tag(self) -> u8 { match self { Self::S1=>1,Self::S2=>2,Self::D=>3 } }\n    pub fn from_tag(tag:u8) -> Option<Self> { match tag {1=>Some(Self::S1),2=>Some(Self::S2),3=>Some(Self::D),_=>None} }\n    pub fn folds(self) -> usize { if self == Self::S1 { 1 } else { 2 } }\n    pub fn final_len(self) -> usize { 1024 >> (2*self.folds()) }\n    pub fn row(self, j:usize) -> usize {\n        if self == Self::D { return aspis_core::r0::transport::COEFFICIENT_TO_ROW[j] as usize; }\n        let mut out=0;\n        for d in 0..5 { out |= ((j>>(2*d))&3) << (2*TAU[d]); }\n        out\n    }\n    pub fn coefficients<T:Copy>(self, rows: &[T;1024]) -> [T;1024] {\n        core::array::from_fn(|j|rows[self.row(j)])\n    }\n    pub fn rows<T:Copy>(self, coefficients: &[T;1024]) -> [T;1024] {\n        let mut out=*coefficients;\n        for j in 0..1024 { out[self.row(j)]=coefficients[j]; }\n        out\n    }\n}\n"},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":13,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":14,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":15,"name":{"Local":"/home/dombarker/project-offloads/codex-cx-op4-install-20261025/src/crates/aspis-core/src/r0/mod.rs"},"crate_name":"aspis_core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":19,"name":{"Local":"/rustc/library/core/src/iter/traits/collect.rs"},"crate_name":"core","contents":null},{"id":20,"name":{"Local":"/rustc/library/core/src/iter/traits/mod.rs"},"crate_name":"core","contents":null},{"id":21,"name":{"Local":"/rustc/library/core/src/iter/mod.rs"},"crate_name":"core","contents":null},{"id":22,"name":{"Local":"/rustc/library/core/src/iter/traits/iterator.rs"},"crate_name":"core","contents":null},{"id":23,"name":{"Local":"/rustc/library/core/src/iter/range.rs"},"crate_name":"core","contents":null},{"id":24,"name":{"Local":"/home/dombarker/project-offloads/codex-cx-op4-install-20261025/src/crates/aspis-core/src/r0/heap.rs"},"crate_name":"aspis_core","contents":null},{"id":25,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":26,"name":{"Local":"src/FIn_trace.rs"},"crate_name":"fin_pair_extraction","contents":"//! UNPROVED COST PROBE. Native byte traces; compiled out of SBF.\nuse aspis_core::field::WideExact as E;\n#[cfg(feature=\"prover\")]\nstd::thread_local! { static VALUES: std::cell::RefCell<alloc::vec::Vec<(u16,usize,[u8;32])>> = const { std::cell::RefCell::new(alloc::vec::Vec::new()) }; }\n#[inline(always)]\npub fn value(tag: u16, index: usize, x: E) {\n    #[cfg(feature=\"prover\")]\n    VALUES.with(|v| v.borrow_mut().push((tag,index,x.to_le_bytes())));\n    #[cfg(not(feature=\"prover\"))]\n    let _ = (tag,index,x);\n}\n#[cfg(feature=\"prover\")]\npub fn take() -> alloc::vec::Vec<(u16,usize,[u8;32])> {\n    VALUES.with(|v| core::mem::take(&mut *v.borrow_mut()))\n}\n"},{"id":27,"name":{"Local":"/rustc/library/core/src/array/iter.rs"},"crate_name":"core","contents":null},{"id":28,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":29,"name":{"Local":"/rustc/library/core/src/num/nonzero.rs"},"crate_name":"core","contents":null},{"id":30,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":31,"name":{"Local":"/rustc/library/core/src/iter/adapters/step_by.rs"},"crate_name":"core","contents":null},{"id":32,"name":{"Local":"/rustc/library/core/src/iter/adapters/mod.rs"},"crate_name":"core","contents":null},{"id":33,"name":{"Local":"/rustc/library/core/src/iter/adapters/chain.rs"},"crate_name":"core","contents":null},{"id":34,"name":{"Local":"/rustc/library/core/src/iter/adapters/zip.rs"},"crate_name":"core","contents":null},{"id":35,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":36,"name":{"Local":"/rustc/library/core/src/iter/adapters/intersperse.rs"},"crate_name":"core","contents":null},{"id":37,"name":{"Local":"/rustc/library/core/src/ops/function.rs"},"crate_name":"core","contents":null},{"id":38,"name":{"Local":"/rustc/library/core/src/iter/adapters/map.rs"},"crate_name":"core","contents":null},{"id":39,"name":{"Local":"/rustc/library/core/src/iter/adapters/filter.rs"},"crate_name":"core","contents":null},{"id":40,"name":{"Local":"/rustc/library/core/src/iter/adapters/filter_map.rs"},"crate_name":"core","contents":null},{"id":41,"name":{"Local":"/rustc/library/core/src/iter/adapters/enumerate.rs"},"crate_name":"core","contents":null},{"id":42,"name":{"Local":"/rustc/library/core/src/iter/adapters/peekable.rs"},"crate_name":"core","contents":null},{"id":43,"name":{"Local":"/rustc/library/core/src/iter/adapters/skip_while.rs"},"crate_name":"core","contents":null},{"id":44,"name":{"Local":"/rustc/library/core/src/iter/adapters/take_while.rs"},"crate_name":"core","contents":null},{"id":45,"name":{"Local":"/rustc/library/core/src/iter/adapters/map_while.rs"},"crate_name":"core","contents":null},{"id":46,"name":{"Local":"/rustc/library/core/src/iter/adapters/skip.rs"},"crate_name":"core","contents":null},{"id":47,"name":{"Local":"/rustc/library/core/src/iter/adapters/take.rs"},"crate_name":"core","contents":null},{"id":48,"name":{"Local":"/rustc/library/core/src/iter/adapters/scan.rs"},"crate_name":"core","contents":null},{"id":49,"name":{"Local":"/rustc/library/core/src/iter/adapters/flatten.rs"},"crate_name":"core","contents":null},{"id":50,"name":{"Local":"/rustc/library/core/src/iter/adapters/map_windows.rs"},"crate_name":"core","contents":null},{"id":51,"name":{"Local":"/rustc/library/core/src/iter/adapters/fuse.rs"},"crate_name":"core","contents":null},{"id":52,"name":{"Local":"/rustc/library/core/src/iter/adapters/inspect.rs"},"crate_name":"core","contents":null},{"id":53,"name":{"Local":"/rustc/library/core/src/ops/try_trait.rs"},"crate_name":"core","contents":null},{"id":54,"name":{"Local":"/rustc/library/core/src/default.rs"},"crate_name":"core","contents":null},{"id":55,"name":{"Local":"/rustc/library/core/src/iter/traits/double_ended.rs"},"crate_name":"core","contents":null},{"id":56,"name":{"Local":"/rustc/library/core/src/iter/traits/exact_size.rs"},"crate_name":"core","contents":null},{"id":57,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":58,"name":{"Local":"/rustc/library/core/src/iter/adapters/rev.rs"},"crate_name":"core","contents":null},{"id":59,"name":{"Local":"/rustc/library/core/src/iter/adapters/copied.rs"},"crate_name":"core","contents":null},{"id":60,"name":{"Local":"/rustc/library/core/src/iter/adapters/cloned.rs"},"crate_name":"core","contents":null},{"id":61,"name":{"Local":"/rustc/library/core/src/iter/adapters/cycle.rs"},"crate_name":"core","contents":null},{"id":62,"name":{"Local":"/rustc/library/core/src/iter/adapters/array_chunks.rs"},"crate_name":"core","contents":null},{"id":63,"name":{"Local":"/rustc/library/core/src/iter/traits/accum.rs"},"crate_name":"core","contents":null},{"id":64,"name":{"Local":"/rustc/library/core/src/array/equality.rs"},"crate_name":"core","contents":null},{"id":65,"name":{"Local":"/rustc/library/core/src/intrinsics/mod.rs"},"crate_name":"core","contents":null},{"id":66,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":67,"name":{"Local":"/home/dombarker/project-offloads/codex-cx-op4-install-20261025/src/crates/aspis-core/src/r0/opening.rs"},"crate_name":"aspis_core","contents":null},{"id":68,"name":{"Local":"/rustc/library/core/src/fmt/mod.rs"},"crate_name":"core","contents":null},{"id":69,"name":{"Local":"/rustc/library/core/src/num/niche_types.rs"},"crate_name":"core","contents":null},{"id":70,"name":{"Local":"/rustc/library/core/src/ptr/mod.rs"},"crate_name":"core","contents":null},{"id":71,"name":{"Local":"src/FIn_fast_pairing.rs"},"crate_name":"fin_pair_extraction","contents":"//! Exact-field dot accumulator candidates; arithmetic-only equivalence code.\nmod canonical {\n    //! Private canonical representation: validate at the boundary, preserve internally.\n    //! No public unchecked constructor. This does NOT change aspis_core::M31.\n    pub const P:u32=0x7fff_ffff;\n    const MASK:u64=0x7fff_ffff_7fff_ffff;\n    const ONES:u64=0x0000_0001_0000_0001;\n    #[derive(Clone,Copy,Debug,PartialEq,Eq,Default)]\n    pub struct Q([u32;4]);\n    #[inline(always)] pub(crate) fn reduce(mut x:u64)->u32 {\n        x=(x & u64::from(P))+(x>>31u32);\n        x=(x & u64::from(P))+(x>>31u32);\n        if x>=u64::from(P) {(x-u64::from(P)) as u32}else{x as u32}\n    }\n    #[inline(always)] pub(crate) fn add(a:u32,b:u32)->u32 {\n        let s=a.wrapping_add(b);if s>=P{s-P}else{s}\n    }\n    #[inline(always)] fn pair(a:u32,b:u32)->u64 {u64::from(a)|(u64::from(b)<<32)}\n    #[inline(always)] fn reduce_pair(s:u64)->u64 {\n        (s.wrapping_add(((s.wrapping_add(ONES))>>31u32)&ONES))&MASK\n    }\n    impl Q {\n        pub const ZERO:Self=Self([0;4]);pub const ONE:Self=Self([1,0,0,0]);\n        pub fn from_limbs(x:[u32;4])->Option<Self>{\n            let [a,b,c,d]=x;\n            if a<P && b<P && c<P && d<P {Some(Self([a,b,c,d]))}else{None}\n        }\n        pub fn from_m31(x:u32)->Option<Self>{if x<P{Some(Self([x,0,0,0]))}else{None}}\n        pub const fn limbs(self)->[u32;4]{self.0}\n        /// WideExact owns private, canonical coordinates; this constructor\n        /// accepts only that validated type, never raw QM31 limbs or bytes.\n        #[inline(always)]\n        pub(super) fn from_wide(value:super::E)->[Self;2] {\n            let [a,b,c,d,e,f,g,h]=value.to_limbs();\n            [Self([a,b,c,d]),Self([e,f,g,h])]\n        }\n        #[inline(always)] pub fn add(self,rhs:Self)->Self {\n            let a=reduce_pair(pair(self.0[0],self.0[1]).wrapping_add(pair(rhs.0[0],rhs.0[1])));\n            let b=reduce_pair(pair(self.0[2],self.0[3]).wrapping_add(pair(rhs.0[2],rhs.0[3])));\n            Self([a as u32,(a>>32) as u32,b as u32,(b>>32) as u32])\n        }\n        #[inline(always)] pub fn sub(self,rhs:Self)->Self {\n            let a=reduce_pair(pair(self.0[0],self.0[1]).wrapping_add(MASK).wrapping_sub(pair(rhs.0[0],rhs.0[1])));\n            let b=reduce_pair(pair(self.0[2],self.0[3]).wrapping_add(MASK).wrapping_sub(pair(rhs.0[2],rhs.0[3])));\n            Self([a as u32,(a>>32) as u32,b as u32,(b>>32) as u32])\n        }\n        #[inline(always)] pub fn half(self)->Self {\n            let h=|x:u32|(x>>1)|((x&1)<<30);\n            let mut out=[0u32;4]; for i in 0..4 {out[i]=h(self.0[i]);} Self(out)\n        }\n        pub fn half_pow(self,n:u8)->Option<Self>{\n            if n>30{return None}if n==0{return Some(self)}\n            let mut out=[0u32;4];\n            for i in 0..4 {let x=self.0[i];out[i]=(x>>n)|((x&((1u32<<n)-1))<<(31-n));}\n            Some(Self(out))\n        }\n        #[inline(always)] pub fn mul_m31(self,rhs:u32)->Option<Self>{\n            if rhs>=P{return None}\n            let mut out=[0u32;4]; for i in 0..4 {out[i]=reduce(u64::from(self.0[i])*u64::from(rhs));}\n            Some(Self(out))\n        }\n        /// Benchmark candidate, not an assertion of superiority over staged R19.\n        /// All intermediates are nonnegative and strictly below 2^64.\n        #[inline(always)] pub fn mul(self,rhs:Self)->Self {\n            let [a,b,c,d]=[u64::from(self.0[0]),u64::from(self.0[1]),u64::from(self.0[2]),u64::from(self.0[3])];\n            let [e,f,g,h]=[u64::from(rhs.0[0]),u64::from(rhs.0[1]),u64::from(rhs.0[2]),u64::from(rhs.0[3])];\n            const PP:u64=(P as u64)*(P as u64);\n            let partial=|x:u64|(x&u64::from(P)).wrapping_add(x>>31u32);\n            let u=partial((c*g).wrapping_add(PP).wrapping_sub(d*h));\n            let v=partial((c*h).wrapping_add(d*g));\n            Self([reduce((a*e).wrapping_add(PP).wrapping_sub(b*f).wrapping_add(2*u).wrapping_add(3*u64::from(P)).wrapping_sub(v)),\n                reduce((a*f).wrapping_add(b*e).wrapping_add(u).wrapping_add(2*v)),\n                reduce((a*g).wrapping_add(c*e).wrapping_add(2*PP).wrapping_sub(b*h).wrapping_sub(d*f)),\n                reduce((a*h).wrapping_add(b*g).wrapping_add(c*f).wrapping_add(d*e))])\n        }\n    }\n\n    // Appended to the retained private Q module. Only Q can reach the raw path:\n    // its limbs are private, constructors validate, and operations preserve <P.\n    impl Q {\n        #[inline(always)]\n        fn raw(self,rhs:Self)->[u64;4] {\n            let [a,b,c,d]=[u64::from(self.0[0]),u64::from(self.0[1]),u64::from(self.0[2]),u64::from(self.0[3])];\n            let [e,f,g,h]=[u64::from(rhs.0[0]),u64::from(rhs.0[1]),u64::from(rhs.0[2]),u64::from(rhs.0[3])];\n            const PP:u64=(P as u64)*(P as u64);\n            let partial=|x:u64|(x&u64::from(P)).wrapping_add(x>>31u32);\n            let u=partial((c*g).wrapping_add(PP).wrapping_sub(d*h));\n            let v=partial((c*h).wrapping_add(d*g));\n            [(a*e).wrapping_add(PP).wrapping_sub(b*f).wrapping_add(2*u).wrapping_add(3*u64::from(P)).wrapping_sub(v),\n             (a*f).wrapping_add(b*e).wrapping_add(u).wrapping_add(2*v),\n             (a*g).wrapping_add(c*e).wrapping_add(2*PP).wrapping_sub(b*h).wrapping_sub(d*f),\n             (a*h).wrapping_add(b*g).wrapping_add(c*f).wrapping_add(d*e)]\n        }\n        #[inline(always)]\n        pub fn dot<const N:usize>(left:[Self;N],right:[Self;N])->Self {\n            assert!(N<=4);let mut sums=[0u64;4];\n            for i in 0..N {\n                let raw=left[i].raw(right[i]);\n                for j in 0..4 {sums[j]=sums[j].wrapping_add((raw[j]&u64::from(P)).wrapping_add(raw[j]>>31u32));}\n            }\n            // Retained R59 bounds: each folded raw value <2^34, N<=4.\n            Self([reduce(sums[0]),reduce(sums[1]),reduce(sums[2]),reduce(sums[3])])\n        }\n        #[inline(always)] pub fn neg(self)->Self {Self::ZERO.sub(self)}\n        #[inline(always)] pub fn square(self)->Self {self.mul(self)}\n    }\n\n    // Private canonical operands; bounded raw representatives, canonical result.\n    // At most 4096 partial folds, each <2^34, sum <2^46. No u64 wrap.\n    pub struct Dot { sums:[u64;4] }\n    impl Dot {\n        pub fn new()->Self {Self{sums:[0;4]}}\n        #[inline(always)]\n        pub fn push(&mut self,a:Q,b:Q) {\n            // Both enclosing public accumulators check the 4096-term bound.\n            // This private accumulator cannot be reached by raw callers.\n            let raw=a.raw(b);\n            for j in 0..4 {\n                self.sums[j]=self.sums[j].wrapping_add(\n                    (raw[j]&u64::from(P)).wrapping_add(raw[j]>>31u32));\n            }\n        }\n        pub fn finish(self)->Q {Q([reduce(self.sums[0]),reduce(self.sums[1]),reduce(self.sums[2]),reduce(self.sums[3])])}\n    }\n}\n\n\nuse aspis_core::field::{CM31, QM31, WideExact as E};\n\nconst MAX_TERMS: usize = 4096;\n\n#[inline(always)]\nfn limbs_of(k: QM31) -> [u32; 4] {\n    [k.c0.a.0, k.c0.b.0, k.c1.a.0, k.c1.b.0]\n}\n\n#[inline(always)]\nfn checked_q(k: QM31) -> Result<canonical::Q, ()> {\n    match canonical::Q::from_limbs(limbs_of(k)) { Some(q) => Ok(q), None => Err(()) }\n}\n\n#[inline(always)]\nfn qm31_of(q: canonical::Q) -> QM31 {\n    let [a, b, c, d] = q.limbs();\n    QM31 {\n        c0: CM31 { a: aspis_core::field::M31(a), b: aspis_core::field::M31(b) },\n        c1: CM31 { a: aspis_core::field::M31(c), b: aspis_core::field::M31(d) },\n    }\n}\n\n/// Candidate exact accumulator for sums of `WideExact * QM31`.\n/// Canonical QM31 coordinates and the 4096-term limit are checked at push.\npub struct EbyKDot {\n    c0: canonical::Dot,\n    c1: canonical::Dot,\n    count: usize,\n}\n\nimpl EbyKDot {\n    pub fn new() -> Self {\n        Self { c0: canonical::Dot::new(), c1: canonical::Dot::new(), count: 0 }\n    }\n\n    #[inline(always)]\n    pub fn push(&mut self, value: E, scalar: QM31) -> Result<(), ()> {\n        if self.count >= MAX_TERMS { return Err(()); }\n        let [value_c0,value_c1] = canonical::Q::from_wide(value);\n        let scalar = checked_q(scalar)?;\n        self.c0.push(value_c0, scalar);\n        self.c1.push(value_c1, scalar);\n        self.count += 1;\n        Ok(())\n    }\n\n    #[inline(always)]\n    pub fn finish(self) -> E {\n        let [a,b,c,d]=self.c0.finish().limbs();\n        let [e,f,g,h]=self.c1.finish().limbs();\n        // The private accumulator produces canonical coordinates already.\n        E::from_limbs([a,b,c,d,e,f,g,h]).unwrap()\n    }\n}\n\n/// Candidate exact accumulator for sums of `WideExact * WideExact`.\n/// Four canonical QM31 dot accumulators implement the outer quadratic tower.\npub struct EbyEDot {\n    ac: canonical::Dot,\n    bd: canonical::Dot,\n    ad: canonical::Dot,\n    bc: canonical::Dot,\n    count: usize,\n}\n\nimpl EbyEDot {\n    pub fn new() -> Self {\n        Self {\n            ac: canonical::Dot::new(), bd: canonical::Dot::new(),\n            ad: canonical::Dot::new(), bc: canonical::Dot::new(), count: 0,\n        }\n    }\n\n    #[inline(always)]\n    pub fn push(&mut self, left: E, right: E) -> Result<(), ()> {\n        if self.count >= MAX_TERMS { return Err(()); }\n        let [a,b] = canonical::Q::from_wide(left);\n        let [c,d] = canonical::Q::from_wide(right);\n        self.ac.push(a, c);\n        self.bd.push(b, d);\n        self.ad.push(a, d);\n        self.bc.push(b, c);\n        self.count += 1;\n        Ok(())\n    }\n\n    #[inline(always)]\n    pub fn finish(self) -> E {\n        let ac = qm31_of(self.ac.finish());\n        let bd = qm31_of(self.bd.finish());\n        let ad = qm31_of(self.ad.finish());\n        let bc = qm31_of(self.bc.finish());\n        // v^2 = u, where WideExact::U embeds the QM31 generator in the base.\n        E::new(ac.add(bd.mul(E::U)), ad.add(bc))\n    }\n}\n"},{"id":72,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":73,"name":{"Local":"/home/dombarker/project-offloads/codex-cx-op4-install-20261025/src/crates/aspis-core/src/r0/transport.rs"},"crate_name":"aspis_core","contents":null},{"id":74,"name":{"Local":"/rustc/library/core/src/ops/deref.rs"},"crate_name":"core","contents":null},{"id":75,"name":{"Local":"/rustc/library/core/src/hash/mod.rs"},"crate_name":"core","contents":null},{"id":76,"name":{"Local":"/rustc/library/core/src/convert/num.rs"},"crate_name":"core","contents":null},{"id":77,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["fin_pair_extraction",0]},{"Ident":["FIn_pair",0]}]},{"key":{"Type":0},"value":[{"Ident":["fin_pair_extraction",0]},{"Ident":["weights",0]},{"Ident":["Weights",0]}]},{"key":{"Type":1},"value":[{"Ident":["aspis_core",0]},{"Ident":["field",0]},{"Ident":["wide_exact",0]},{"Ident":["WideExact",0]}]},{"key":{"Type":2},"value":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}]},{"k