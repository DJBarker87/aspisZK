theorem Aeneas.Std.Array.update_spec.{u} : ∀ {α : Type u} {n : Usize} (v : Std.Array α n) (i : Usize) (x : α),
  ↑i < v.length → v.update i x ⦃ nv => nv = v.set i x ⦄ :=
fun {α} {n} v i x hbound =>
  id
    (Eq.mpr
      (id
        (congrFun'
          (congrArg WP.spec
            (congrArg
              (fun x_1 =>
                match x_1 with
                | none => fail Error.arrayOutOfBounds
                | some val => ok ⟨(↑v).set (↑i) x, Array.set._proof_1 v i x⟩)
              (Array.getElem?_Usize_eq v i)))
          fun nv => nv = ⟨(↑v).set (↑i) x, Array.set._proof_1 v i x⟩))
      (Aeneas.Std.Array.index_usize.match_1.splitter✝
        (fun x_1 =>
          (↑v)[↑i]? = x_1 →
            (match (↑v)[↑i]? with
              | none => fail Error.arrayOutOfBounds
              | some val => ok ⟨(↑v).set (↑i) x, Array.set._proof_1 v i x⟩) ⦃
              nv => nv = ⟨(↑v).set (↑i) x, Array.set._proof_1 v i x⟩ ⦄)
        (↑v)[↑i]?
        (fun _ h =>
          Eq.ndrec (motive := fun x_1 =>
            (↑v)[↑i]? = x_1 →
              (match x_1 with
                | none => fail Error.arrayOutOfBounds
                | some val => ok ⟨(↑v).set (↑i) x, Array.set._proof_1 v i x⟩) ⦃
                nv => nv = ⟨(↑v).set (↑i) x, Array.set._proof_1 v i x⟩ ⦄)
            (fun heq =>
              id
                (False.elim
                  (Eq.mp
                    (Eq.trans
                      (congrFun'
                        (congrArg Eq
                          (getElem?_pos (↑v) (↑i)
                            (of_eq_true
                              (Eq.trans (congrArg (LT.lt ↑i) (List.Vector.length_val v))
                                (eq_true (Eq.mp (congrArg (LT.lt ↑i) (List.Vector.length_val v)) hbound))))))
                        none)
                      (eq_false' fun h => False.elim (noConfusion_of_Nat Option.ctorIdx h)))
                    heq)))
            (Eq.symm h) (Eq.refl (↑v)[↑i]?))
        (fun x_1 h =>
          Eq.ndrec (motive := fun x_2 =>
            (↑v)[↑i]? = x_2 →
              (match x_2 with
                | none => fail Error.arrayOutOfBounds
                | some val => ok ⟨(↑v).set (↑i) x, Array.set._proof_1 v i x⟩) ⦃
                nv => nv = ⟨(↑v).set (↑i) x, Array.set._proof_1 v i x⟩ ⦄)
            (fun heq =>
              id
                (of_eq_true
                  (Eq.trans (WP.spec_ok._simp_1 ⟨(↑v).set (↑i) x, Array.set._proof_1 v i x⟩)
                    (eq_self ⟨(↑v).set (↑i) x, Array.set._proof_1 v i x⟩))))
            (Eq.symm h) (Eq.refl (↑v)[↑i]?))
        (Eq.refl (↑v)[↑i]?)))
def Aeneas.Std.Array.update.{u} : {α : Type u} → {n : Usize} → Std.Array α n → Usize → α → Result (Std.Array α n) :=
fun {α} {n} v i x =>
  match v[i]? with
  | none => fail Error.arrayOutOfBounds
  | some val => ok ⟨(↑v).set (↑i) x, ⋯⟩
def Array.set.{u_1} : {α : Type u_1} →
  (xs : _root_.Array α) → (i : ℕ) → α → autoParam (i < xs.size) Array.set._auto_1 → _root_.Array α :=
fun {α} xs i v h => { toList := xs.toList.set i v }
List.mem_set.{u_1} {α : Type u_1} {l : List α} {i : ℕ} (h : i < l.length) (a : α) : a ∈ l.set i a
List.getElem_set.{u_1} {α : Type u_1} {l : List α} {i j : ℕ} {a : α} (h : j < (l.set i a).length) :
  (l.set i a)[j] = if i = j then a else l[j]
