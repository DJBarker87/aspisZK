]; 2]], masks: &[u16; 64], chi: QM31) -> bool {\n    let mut clear = true;\n    let mut row = 0usize;\n    while row < values.len() {\n        let active = masks[row >> 4] & (1 << (row & 15)) != 0;\n        let mut side = 0usize;\n        while side < 2 {\n            let mut slot = 0usize;\n            while slot < 2 {\n                clear = keep_clear(clear, active, chi, values[row][side][slot]);\n                slot += 1;\n            }\n            side += 1;\n        }\n        row += 1;\n    }\n    clear\n}\n"},{"id":1,"name":{"Local":"/home/dombarker/project-offloads/codex-pv-batch1-20261027/candidate/src/crates/aspis-core/src/field.rs"},"crate_name":"aspis_core","contents":null},{"id":2,"name":{"Local":"/home/dombarker/project-offloads/codex-pv-batch1-20261027/candidate/src/crates/aspis-core/src/lib.rs"},"crate_name":"aspis_core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["pv_b1_probe",0]},{"Ident":["all_slots_clear",0]}]},{"key":{"Type":0},"value":[{"Ident":["aspis_core",0]},{"Ident":["field",0]},{"Ident":["QM31",0]}]},{"key":{"Fun":1},"value":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"HashConsedValue":[593,{"Slice":{"HashConsedValue":[592,{"TypeVar":{"Bound":[0,0]}}]}}]},"kind":"InherentImplBlock"}}},{"Ident":["len",0]}]},{"key":{"Fun":2},"value":[{"Ident":["pv_b1_probe",0]},{"Ident":["keep_clear",0]}]},{"key":{"Type":1},"value":[{"Ident":["aspis_core",0]},{"Ident":["field",0]},{"Ident":["CM31",0]}]},{"key":{"Fun":3},"value":[{"Ident":["pv_b1_probe",0]},{"Ident":["equal",0]}]},{"key":{"Type":2},"value":[{"Ident":["aspis_core",0]},{"Ident":["fie