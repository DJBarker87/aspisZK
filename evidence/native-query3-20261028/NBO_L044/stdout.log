        (AspisR1.Port3_NativeQueryBody.verifier.candidate.query_values.closure.Insts.CoreOpsFunctionFnMutTupleUsizeWideExact
          (NBO_QueryAssociation.sourceOps ops))
        q,
    ne := Aeneas.Std.core.cmp.PartialEq.ne.trait_default (NBO_QueryAssociation.sourceOps ops).widePartialEq,
    line := (NBO_QueryAssociation.sourceOps ops).op16, mulM := (NBO_QueryAssociation.sourceOps ops).op7,
    doubleM := (NBO_QueryAssociation.sourceOps ops).op8, oneM := (NBO_QueryAssociation.sourceOps ops).op5,
    subM := (NBO_QueryAssociation.sourceOps ops).op6, mark := (NBO_QueryAssociation.sourceOps ops).op19,
    trace := (NBO_QueryAssociation.sourceOps ops).op15 }
