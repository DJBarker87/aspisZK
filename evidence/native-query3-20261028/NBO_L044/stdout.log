    NBO_Entry.Prelude base reserved D hash semantic proof split p g initial pending geometry ∧
      NBO_Composite.source ops proof p initial g geometry pending =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (a, after)) ∧
        NBO_Composite.reference ops proof p initial g geometry pending =
          Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (a, after))
