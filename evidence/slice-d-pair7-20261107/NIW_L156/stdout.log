def AspisR1.NIW_AlignNativeObligations.PairWitness : NP6_StdModel.Reservation → Context → Result NR → Prop :=
fun r c native => NIT_AllocatorChain.Trace c r native
def AspisR1.NIW_AlignNativeObligations.FinishProjection : NP6_StdModel.Reservation →
  NIW_AlignFinishComposed.Locations →
    AspisR1Stage2.verifier.View →
      AspisR1Stage2.verifier.Prepared →
        AspisR1Stage2.verifier.Accumulator → List NIW_AlignFinishExecution.Event → Prop :=
fun r loc v p a nativeEvents => nativeEvents = (NIW_AlignFinishComposed.run r loc v p a).2.1
AspisR1.NIW_AlignComposedRoot.source (r : NP6_StdModel.Reservation) (loc : NIW_AlignFinishComposed.Locations)
  (proof : Slice U8) (v : AspisR1Stage2.verifier.View) (p : AspisR1Stage2.verifier.Prepared)
  (a : AspisR1Stage2.verifier.Accumulator) (domain : NIG_FinishInput.Domain proof v p a) (port : PairPort)
  (afterOwner : ℕ) (cut : NIW_AlignFinishPort.Cut p port afterOwner (NIW_AlignFinishComposed.run r loc v p a).2.2) :
  have execution := NIW_AlignFinishComposed.run r loc v p a;
  Port3_NativeFinishBody.verifier.finish_relation (NIG_Slots.installed r) v p a none = execution.1 ∧
    (∀ event ∈ execution.2.1, NIW_AlignFinishInvocation.Clause r event) ∧
      (∀ event ∈ execution.2.1, NIW_AlignFinishDomains.Inputs p v a event) ∧
        NIW_AlignFinishPrefix.Prefix execution.2.1 ∧
          NIW_AlignFinishPairCertificate.Bound r execution.2.2 ∧
            NIW_AlignFinishInfoEvent.HasPair execution ∧
              NIW_AlignFinishInfoNew.HasNew p execution ∧ NIW_AlignFinishPort.Bound r port execution.2.2
AspisR1.NIW_AlignPairInstalled.source (r : NP6_StdModel.Reservation) (w : Ref FIo_Install.W)
  (alpha : Ref (Std.Array FE 2#usize)) (f : Ref (Slice U8)) (kappa : FE) (ap0 ap1 common low scratch parts : ℕ)
  (domain :
    NIT_PairDomain.Domain (FIo_Install.toWeights w.value) (NFW_PowersCohort.mapArray FIo_Install.toE alpha.value)
      f.value (FIo_Install.toE kappa)) :
  FIo_Install.pair r w.value alpha.value.to_slice f.value kappa =
      NIT_ErrorTransport.full (NIW_AlignPairInstalled.observed r w alpha f kappa ap0 ap1 common low scratch parts).1 ∧
    NIT_ResultCanonical.Canonical (NIW_AlignPairInstalled.observed r w alpha f kappa ap0 ap1 common low scratch parts).1
AspisR1.NIW_AlignFinishPort.source (r : NP6_StdModel.Reservation) (loc : NIW_AlignFinishComposed.Locations)
  (proof : Slice U8) (v : AspisR1Stage2.verifier.View) (p : AspisR1Stage2.verifier.Prepared)
  (a : AspisR1Stage2.verifier.Accumulator) (domain : NIG_FinishInput.Domain proof v p a) (log : PairPort)
  (afterOwner : ℕ) (cut : NIW_AlignFinishPort.Cut p log afterOwner (NIW_AlignFinishComposed.run r loc v p a).2.2) :
  NIW_AlignFinishPort.Bound r log (NIW_AlignFinishComposed.run r loc v p a).2.2
def AspisR1.NIW_AlignFinishPort.Cut : AspisR1Stage2.verifier.Prepared →
  PairPort → ℕ → Option NIW_AlignFinishComposed.PairInfo → Prop :=
fun p log afterOwner x =>
  match x with
  | none => True
  | some info =>
    match info.native.1 with
    | fail e => True
    | div => True
    | ok reply =>
      cutPairPort info.owner.address info.alpha.address info.message.address p log (NIT_ErrorTransport.reply reply)
        afterOwner
def AspisR1.NIW_AlignFinishPort.Bound : NP6_StdModel.Reservation →
  PairPort → Option NIW_AlignFinishComposed.PairInfo → Prop :=
fun r log x =>
  match x with
  | none => True
  | some info =>
    have call := FIo_Install.pair r info.owner.value info.alpha.value.to_slice info.message.value info.kappa;
    match info.native.1 with
    | fail err => call = fail err
    | div => call = div
    | ok reply => log.reply = NIT_ErrorTransport.reply reply ∧ call = ok log.reply ∧ replyCanonical log.reply
def AspisR1.NIW_AlignPairPhase.Certificate : NP6_StdModel.Reservation →
  NIW_AlignPairPhase.Input → Result NR × NIW_AlignPairPhase.Log → Prop :=
fun r i observed =>
  match observed.2.powers0, observed.2.powers1 with
  | ok ap0, some (ok ap1) =>
    FIo_Native.weights.powers 4#usize (epick i.alpha.value 0) = ok ap0 ∧
      FIo_Native.weights.powers 4#usize (epick i.alpha.value 1) = ok ap1 ∧
        canonical ap0 ∧ canonical ap1 ∧ NIT_AllocatorChain.Trace (NIW_AlignPairPhase.context i ap0 ap1) r observed.1
  | x, x_1 => False
