def AspisR1.NIW_AlignRegularNativeView.project : [FIo_Native.Allocation] →
  Context → Scratch → Option NIW_AlignRegularNativeView.View :=
fun [FIo_Native.Allocation] c before =>
  match (NIW_AlignRegularPhase.run c before).2.outcome with
  | fail e => none
  | div => none
  | ok (core.result.Result.Err err, after, parts) =>
    some (NIW_AlignRegularNativeView.returning c (core.result.Result.Err err) after parts)
  | ok (core.result.Result.Ok PUnit.unit, after, parts) =>
    if NGM_GuardExact.guard c.w.value 2#usize = true then none
    else some (NIW_AlignRegularNativeView.returning c (core.result.Result.Ok ()) after parts)
