import NIT_FinishComposition
set_option autoImplicit false
noncomputable section
namespace AspisR1.NIW_AlignReachedBind
open Aeneas Aeneas.Std Result NIT_Cuts NIT_FinishComposition

/-- Congruence only on actually entered continuations. The successful-call
fact is generated by splitting this actual Result; it is not a root premise. -/
theorem congr {A B : Type} (call : Result (Reply A)) (f g : A → Result (Reply B))
 (reached : ∀ value,call=ok (.Ok value) → f value=g value) : fullBind call f=fullBind call g := by
 cases call with
 | fail err => rfl
 | div => rfl
 | ok reply =>
  cases reply with
  | Err err => rfl
  | Ok value => exact reached value rfl

#print axioms congr
end AspisR1.NIW_AlignReachedBind
