theorem AspisR1.NIW_AlignComposedRoot.source : ∀ (r : NP6_StdModel.Reservation) (loc : Locations) (proof : Slice U8)
  (v : verifier.View) (p : verifier.Prepared) (a : verifier.Accumulator),
  NIG_FinishInput.Domain proof v p a →
    ∀ (port : PairPort) (afterOwner : ℕ),
      NIW_AlignFinishPort.Cut p port afterOwner (run r loc v p a).2.2 →
        have execution := run r loc v p a;
        Port3_NativeFinishBody.verifier.finish_relation (NIG_Slots.installed r) v p a none = execution.1 ∧
          (∀ event ∈ execution.2.1, NIW_AlignFinishInvocation.Clause r event) ∧
            (∀ event ∈ execution.2.1, NIW_AlignFinishDomains.Inputs p v a event) ∧
              NIW_AlignFinishPrefix.Prefix execution.2.1 ∧
                NIW_AlignFinishPairCertificate.Bound r execution.2.2 ∧
                  NIW_AlignFinishInfoEvent.HasPair execution ∧
                    NIW_AlignFinishInfoNew.HasNew p execution ∧ NIW_AlignFinishPort.Bound r port execution.2.2 :=
fun r loc proof v p a domain port afterOwner cut =>
  have history := NIW_AlignFinishPrefix.source r v p a;
  ⟨NIW_AlignFinishComposedSource.source r loc proof v p a domain,
    ⟨NIW_AlignFinishMatched.clauses r loc proof v p a domain,
      ⟨NIW_AlignFinishMatched.domains r loc proof v p a domain,
        ⟨Eq.mp
            (congrArg (fun _a => NIW_AlignFinishPrefix.Prefix _a)
              (Eq.symm (NIW_AlignFinishMatched.events r loc proof v p a domain)))
            history,
          ⟨NIW_AlignFinishPairCertificate.source r loc proof v p a domain,
            ⟨NIW_AlignFinishInfoEvent.source r loc v p a,
              ⟨NIW_AlignFinishInfoNew.source r loc v p a,
                NIW_AlignFinishPort.source r loc proof v p a domain port afterOwner cut⟩⟩⟩⟩⟩⟩⟩
'AspisR1.NIW_AlignComposedRoot.source' depends on axioms: [propext, Classical.choice, Quot.sound]
