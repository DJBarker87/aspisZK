+fn q(x:[u32;4])->K{K{c0:aspis_core::field::CM31{a:M31(x[0]),b:M31(x[1])},c1:aspis_core::field::CM31{a:M31(x[2]),b:M31(x[3])}}}
+fn qw(x:K)->[u32;4]{[x.c0.a.0,x.c0.b.0,x.c1.a.0,x.c1.b.0]}
+fn anye()->E{let v:[u32;8]=kani::any();for x in v{kani::assume(x<0x7fffffff);}E::from_limbs(v).unwrap()}
+fn err(i:u8)->Error{match i%8{0=>Error::Parse,1=>Error::Transcript,2=>Error::Semantic,3=>Error::Relation,4=>Error::Merkle,5=>Error::Query,6=>Error::Checkpoint,_=>Error::Allocation}}
+fn code(e:Error)->u8{match e{Error::Parse=>0,Error::Transcript=>1,Error::Semantic=>2,Error::Relation=>3,Error::Merkle=>4,Error::Query=>5,Error::Checkpoint=>6,Error::Allocation=>7}}
+fn unit()->Result<(),Error>{if kani::any(){Ok(())}else{Err(err(kani::any()))}}
+struct Log{regular:Result<(),Error>,partial:Result<[E;4],Error>,high:Result<(),Error>,
+ scratch:Option<Vec<K>>,parts:[E;7],common:[K;16],high_parts:[E;7],
+ events:[u8;4],count:usize,partial_common:K,high_before:E,high_partial:E,high_ptr:*const E}
+fn event(l:&mut Log,e:u8){l.events[l.count]=e;l.count+=1;}
+fn regular(scratch:&mut Vec<K>,parts:&mut[E;7],l:&mut Log)->Result<(),Error>{event(l,0);*scratch=l.scratch.take().unwrap();*parts=l.parts;l.regular}
+fn common(l:&mut Log)->[K;16]{event(l,1);l.common}
+fn partial(common:&[K;16],i:usize,l:&mut Log)->Result<[E;4],Error>{event(l,2);l.partial_common=common[i];l.partial}
+fn high(partials:&[E;4],parts:&mut[E;7],slot:usize,power:usize,l:&mut Log)->Result<(),Error>{event(l,3);l.high_ptr=parts.as_ptr();l.high_before=parts[slot];l.high_partial=partials[power];*parts=l.high_parts;l.high}
+// Frozen weights.rs:279-288; the common loop has its own CLOSED one-step/induction packet.
+// Each outlined callee is opaque here. In particular regular may return Err after writes.
+fn boundary(shared:bool,scratch:&mut Vec<K>,parts:&mut[E;7],i:usize,slot:usize,power:usize,l:&mut Log)->Result<(),Error>{
+ regular(scratch,parts,l)?;
+ if shared{let common=common(l);let partials=partial(&common,i,l)?;high(&partials,parts,slot,power,l)?;}
+ Ok(())
+}
