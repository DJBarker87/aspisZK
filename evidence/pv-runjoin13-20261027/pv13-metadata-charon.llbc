f this non-fused iterator were to be interspersed with a `separator` closure"},{"DocComment":" that returns `0` repeatedly, the interspersed iterator will produce:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" Some(1) -> Some(0) -> Some(2) -> None -> Some(0) -> Some(3) -> Some(0) ->"},{"DocComment":" Some(4) -> ..."},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The `separator` closure will be called exactly once each time an item"},{"DocComment":" is placed between two adjacent items from the underlying iterator;"},{"DocComment":" specifically, the closure is not called if the underlying iterator yields"},{"DocComment":" less than two items and after the last item is yielded."},{"DocComment":""},{"DocComment":" If the iterator's item implements [`Clone`], it may be easier to use"},{"DocComment":" [`intersperse`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_intersperse)]"},{"DocComment":""},{"DocComment":" #[derive(PartialEq, Debug)]"},{"DocComment":" struct NotClone(usize);"},{"DocComment":""},{"DocComment":" let v = [NotClone(0), NotClone(1), NotClone(2)];"},{"DocComment":" let mut it = v.into_iter().intersperse_with(|| NotClone(99));"},{"DocComment":""},{"DocComment":" assert_eq!(it.next(), Some(NotClone(0)));  // The first element from `v`."},{"DocComment":" assert_eq!(it.next(), Some(NotClone(99))); // The separator."},{"DocComment":" assert_eq!(it.next(), Some(NotClone(1)));  // The next element from `v`."},{"DocComment":" assert_eq!(it.next(), Some(NotClone(99))); // The separator."},{"DocComment":" assert_eq!(it.next(), Some(NotClone(2)));  // The last element from `v`."},{"DocComment":" assert_eq!(it.next(), None);               // The iterator is finished."},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `intersperse_with` can be used in situations where the separator needs"},{"DocComment":" to be computed:"},{"DocComment":" ```"},{"DocComment":" #![feature(iter_intersperse)]"},{"DocComment":""},{"DocComment":" let src = [\"Hello\", \"to\", \"all\", \"people\", \"!!\"].iter().copied();"},{"DocComment":""},{"DocComment":" // The closure mutably borrows its context to generate an item."},{"DocComment":" let mut happy_emojis = [\" ❤️ \", \" 😀 \"].into_iter();"},{"DocComment":" let separator = || happy_emojis.next().unwrap_or(\" 🦀 \");"},{"DocComment":""},{"DocComment":" let result = src.intersperse_with(separator).collect::<String>();"},{"DocComment":" assert_eq!(result, \"Hello ❤️ to 😀 all 🦀 people 🦀 !!\");"},{"DocComment":" ```"},{"DocComment":" [`Clone`]: crate::clone::Clone"},{"DocComment":" [`intersperse`]: Iterator::intersperse"},{"DocComment":" [`intersperse_with`]: Iterator::intersperse_with"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"G"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31706}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":17,"beg":{"line":775,"col":11},"end":{"line":775,"col":32}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":31699},{"Deduplicated":2165},{"Deduplicated":31706}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":31699}],"const_generics"