DocComment":" println!(\"{sum}\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will print:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" 6"},{"DocComment":" about to filter: 1"},{"DocComment":" about to filter: 4"},{"DocComment":" made it through filter: 4"},{"DocComment":" about to filter: 2"},{"DocComment":" made it through filter: 2"},{"DocComment":" about to filter: 3"},{"DocComment":" 6"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Logging errors before discarding them:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let lines = [\"1\", \"2\", \"a\"];"},{"DocComment":""},{"DocComment":" let sum: i32 = lines"},{"DocComment":"     .iter()"},{"DocComment":"     .map(|line| line.parse::<i32>())"},{"DocComment":"     .inspect(|num| {"},{"DocComment":"         if let Err(ref e) = *num {"},{"DocComment":"             println!(\"Parsing error: {e}\");"},{"DocComment":"         }"},{"DocComment":"     })"},{"DocComment":"     .filter_map(Result::ok)"},{"DocComment":"     .sum();"},{"DocComment":""},{"DocComment":" println!(\"Sum: {sum}\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will print:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" Parsing error: invalid digit found in string"},{"DocComment":" Sum: 3"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"F"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31706}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":17,"beg":{"line":1920,"col":11},"end":{"line":192