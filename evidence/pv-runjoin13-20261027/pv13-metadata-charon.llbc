omment":" reserving space for the elements of the iterator, but must not be"},{"DocComment":" trusted to e.g., omit bounds checks in unsafe code. An incorrect"},{"DocComment":" implementation of `size_hint()` should not lead to memory safety"},{"DocComment":" violations."},{"DocComment":""},{"DocComment":" That said, the implementation should provide a correct estimation,"},{"DocComment":" because otherwise it would be a violation of the trait's protocol."},{"DocComment":""},{"DocComment":" The default implementation returns <code>(0, [None])</code> which is correct for any"},{"DocComment":" iterator."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let mut iter = a.iter();"},{"DocComment":""},{"DocComment":" assert_eq!((3, Some(3)), iter.size_hint());"},{"DocComment":" let _ = iter.next();"},{"DocComment":" assert_eq!((2, Some(2)), iter.size_hint());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A more complex example:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // The even numbers in the range of zero to nine."},{"DocComment":" let iter = (0..10).filter(|x| x % 2 == 0);"},{"DocComment":""},{"DocComment":" // We might iterate from zero to ten times. Knowing that it's five"},{"DocComment":" // exactly wouldn't be possible without executing filter()."},{"DocComment":" assert_eq!((0, Some(10)), iter.size_hint());"},{"DocComment":""},{"DocComment":" // Let's add five more numbers with chain()"},{"DocComment":" let iter = (0..10).filter(|x| x % 2 == 0).chain(15..20);"},{"DocComment":""},{"DocComment":" // now both bounds are increased by five"},{"DocComment":" assert_eq!((5, Some(15)), iter.size_hint());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Returning `None` for an upper bound:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // an infinite iterator has no upper bound"},{"DocComment":" // and the maximum possible lower bound"},{"DocComment":" let iter = 0..;"},{"DocComment":""},{"DocComment":" assert_eq!((usize::MAX, None), iter.size_hint());"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[32241,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":31698},"Shared"]}]}],"output":{"HashConsedValue":[29006,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":1670},{"Deduplicated":29005}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitDecl":{"trait_ref":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":2}}},"is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":17,"beg":{"line":189,"col":4},"end":{"line":191,"col":5}},"generated_from_span":null},"bound_body_regions":2,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":17,"beg":{"line":189,"col":27},"end":{"line":189,"col":49}},"generated_from_span":null},"ty":{"Deduplicated":29006}},{"index":1,"name":"self","span":{"data":{"file_id":17,"beg":{"line":189,"col":17},"end":{"line":189,"col":22}},"generated_from_span":null},"ty":{"HashConsedValue":[32518,{"Ref":[{"Body":1},{"Deduplicated":31698},"Shared"]}]}},{"index":2,"name":null,"span":{"data":{"file_id":0,"beg":{"line":0,"col":0},"end":{"line":0,"col":0}},"generated_from_span":null},"ty":{"Deduplicated":29005}}]},"body":{"span":{"data":{"file_id":17,"beg":{"line":190,"col":8},"end":{"line":191,"col":5}},"generated_from_span":null},"statements":[{"span":{"data":{"f