 original iterator."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().take(2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `take()` is often used with an infinite iterator, to make it finite:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut iter = (0..).take(3);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If less than `n` elements are available,"},{"DocComment":" `take` will limit itself to the size of the underlying iterator:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = [1, 2];"},{"DocComment":" let mut iter = v.into_iter().take(5);"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Use [`by_ref`] to take from the iterator without consuming it, and then"},{"DocComment":" continue using the original iterator:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut words = [\"hello\", \"world\", \"of\", \"Rust\"].into_iter();"},{"DocComment":""},{"DocComment":" // Take the first two words."},{"DocComment":" let hello_world: Vec<_> = words.by_ref().take(2).collect();"},{"DocComment":" assert_eq!(hello_world, vec![\"hello\", \"world\"]);"},{"DocComment":""},{"DocComment":" // Collect the rest of the words."},{"DocComment":" // We can only do this because we used `by_ref` earlier."},{"DocComment":" let of_rust: Vec<_> = words.collect();"},{"DocComment":" assert_eq!(of_rust, vec![\"of\", \"Rust\"]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`by_ref`]: Iterator::by_ref"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":1670}],"output":{"HashConsedValue":[32453,{"Adt":{"id":{"Adt":29},"generics":{"regions":[],"types":[{"Deduplicated":31698}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitDecl":{"trait_ref":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":22}}},"is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":17,"beg":{"line":1447,"col":4},"end":{"line":1452,"col":5}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":17,"beg":{"line":1447,"col":31},"end":{"line":1447,"col":41}},"generated_from_span":null},"ty":{"Deduplicated":32453}},{"index":1,"name":"self","span":{"data":{"file_id":17,"beg":{"line":1447,"col":12},"end":{"line":1447,"col":16}},"generated_from_span":null},"ty":{"Deduplicated":31698}},{"index":2,"name":"n","span":{"data":{"file_id":17,"beg":{"line":1447,"col":18},"end":{"line":1447,"col":19}},"generated_from_span":null