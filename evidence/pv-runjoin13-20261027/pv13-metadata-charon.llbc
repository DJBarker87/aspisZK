:" This can also be thought of as the fallible form of [`for_each()`]"},{"DocComment":" or as the stateless version of [`try_fold()`]."},{"DocComment":""},{"DocComment":" [`for_each()`]: Iterator::for_each"},{"DocComment":" [`try_fold()`]: Iterator::try_fold"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fs::rename;"},{"DocComment":" use std::io::{stdout, Write};"},{"DocComment":" use std::path::Path;"},{"DocComment":""},{"DocComment":" let data = [\"no_tea.txt\", \"stale_bread.json\", \"torrential_rain.png\"];"},{"DocComment":""},{"DocComment":" let res = data.iter().try_for_each(|x| writeln!(stdout(), \"{x}\"));"},{"DocComment":" assert!(res.is_ok());"},{"DocComment":""},{"DocComment":" let mut it = data.iter().cloned();"},{"DocComment":" let res = it.try_for_each(|x| rename(x, Path::new(x).with_extension(\"old\")));"},{"DocComment":" assert!(res.is_err());"},{"DocComment":" // It short-circuited, so the remaining items are still in the iterator:"},{"DocComment":" assert_eq!(it.next(), Some(\"stale_bread.json\"));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The [`ControlFlow`] type can be used with this method for the situations"},{"DocComment":" in which you'd use `break` and `continue` in a normal loop:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let r = (2..100).try_for_each(|x| {"},{"DocComment":"     if 323 % x == 0 {"},{"DocComment":"         return ControlFlow::Break(x)"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     ControlFlow::Continue(())"},{"DocComment":" });"},{"DocComment":" assert_eq!(r, ControlFlow::Break(17));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"F"},{"index":2,"n