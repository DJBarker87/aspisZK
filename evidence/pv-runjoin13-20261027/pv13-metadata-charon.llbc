,"ty":{"Deduplicated":31726}}},"on_unwind":{"span":{"data":{"file_id":45,"beg":{"line":190,"col":4},"end":{"line":192,"col":5}},"generated_from_span":null},"statements":[{"span":{"data":{"file_id":45,"beg":{"line":190,"col":4},"end":{"line":192,"col":5}},"generated_from_span":{"file_id":45,"beg":{"line":370,"col":30},"end":{"line":370,"col":41}}},"id":1048,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":45,"beg":{"line":190,"col":4},"end":{"line":192,"col":5}},"generated_from_span":{"file_id":45,"beg":{"line":370,"col":30},"end":{"line":370,"col":41}}},"id":1049,"kind":"UnwindResume","comments_before":[]}]}}},"comments_before":[]},{"span":{"data":{"file_id":45,"beg":{"line":190,"col":4},"end":{"line":192,"col":5}},"generated_from_span":{"file_id":45,"beg":{"line":370,"col":54},"end":{"line":370,"col":58}}},"id":1051,"kind":{"StorageLive":4},"comments_before":[]},{"span":{"data":{"file_id":45,"beg":{"line":190,"col":4},"end":{"line":192,"col":5}},"generated_from_span":{"file_id":45,"beg":{"line":370,"col":54},"end":{"line":370,"col":58}}},"id":1052,"kind":{"Assign":[{"kind":{"Local":4},"ty":{"Deduplicated":32487}},{"Aggregate":[{"Adt":[{"id":{"Adt":1},"generics":{"regions":[],"types":[{"Deduplicated":31712}],"const_generics":[],"trait_refs":[]}},0,null]},[]]}]},"comments_before":[]},{"span":{"data":{"file_id":45,"beg":{"line":190,"col":4},"end":{"line":192,"col":5}},"generated_from_span":{"file_id":45,"beg":{"line":370,"col":8},"end":{"line":370,"col":76}}},"id":1053,"kind":{"Assign":[{"kind":{"Local":2},"ty":{"Deduplicated":31713}},{"Aggregate":[{"Adt":[{"id":{"Adt":52},"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31712}],"const_generics":[],"trait_refs":[]}},null,null]},[{"Move":{"kind":{"Local":3},"ty":{"Deduplicated":31726}}},{"Copy":{"kind":{"Local":4},"ty":{"Deduplicated":32487}}},{"Copy":{"kind":{"Local":4},"ty":{"Deduplicated":32487}}}]]}]},"comments_before":[]},{"span":{"data":{"file_id":45,"beg":{"line":190,"col":4},"end":{"line":192,"col":5}},"generated_from_span":{"file_id":45,"beg":{"line":370,"col":75},"end":{"line":370,"col":76}}},"id":1054,"kind":{"StorageDead":4},"comments_before":[]},{"span":{"data":{"file_id":45,"beg":{"line":190,"col":4},"end":{"line":192,"col":5}},"generated_from_span":{"file_id":45,"beg":{"line":370,"col":75},"end":{"line":370,"col":76}}},"id":1055,"kind":{"StorageDead":3},"comments_before":[]},{"span":{"data":{"file_id":45,"beg":{"line":191,"col":8},"end":{"line":191,"col":51}},"generated_from_span":null},"id":1056,"kind":{"Assign":[{"kind":{"Local":0},"ty":{"Deduplicated":32556}},{"Aggregate":[{"Adt":[{"id":{"Adt":32},"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699},{"Deduplicated":31706},{"Deduplicated":31712}],"const_generics":[],"trait_refs":[]}},null,null]},[{"Move":{"kind":{"Local":2},"ty":{"Deduplicated":31713}}}]]}]},"comments_before":[]},{"span":{"data":{"file_id":45,"beg":{"line":191,"col":50},"end":{"line":191,"col":51}},"generated_from_span":null},"id":1057,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"data":{"file_id":17,"beg":{"line":1623,"col":5},"end":{"line":1623,"col":5}},"generated_from_span":null},"id":1058,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":17,"beg":{"line":1623,"col":5},"end":{"line":1623,"col":5}},"generated_from_span":null},"id":1059,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":32,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["map_windows",0]}],"span":{"data":{"file_id":17,"beg":{"line":1771,"col":4},"end":{"line":1774,"col":40}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Calls the given function `f` for each contiguous window of size `N` over"},{"DocComment":" `self` and returns an iterator over the outputs of `f`. Like [`slice::windows()`],"},{"DocComment":" the windows during mapping overlap as well."},{"DocComment":""},{"DocComment":" In the following example, the closure is called three times with the"},{"DocComment":" arguments `&['a', 'b']`, `&['b', 'c']` and `&['c', 'd']` respectively."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" let strings = \"abcd\".chars()"},{"DocComment":"     .map_windows(|[x, y]| format!(\"{}+{}\", x, y))"},{"DocComment":"     .collect::<Vec<String>>();"},{"DocComment":""},{"DocComment":" assert_eq!(strings, vec![\"a+b\", \"b+c\", \"c+d\"]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that the const parameter `N` is usually inferred by the"},{"DocComment":" destructured argument in the closure."},{"DocComment":""},{"DocComment":" The returned iterator yields 𝑘 − `N` + 1 items (where 𝑘 is the number of"},{"DocComment":" items yielded by `self`). If 𝑘 is less than `N`, this method yields an"},{"DocComment":" empty iterator."},{"DocComment":""},{"DocComment":" [`slice::windows()`]: slice::windows"},{"DocComment":" [`FusedIterator`]: crate::iter::FusedIterator"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `N` is zero. This check will most probably get changed to a"},{"DocComment":" compile time error before this method gets stabilized."},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" let iter = std::iter::repeat(0).map_windows(|&[]| ());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Building the sums of neighboring numbers."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" let mut it = [1, 3, 8, 1].iter().map_windows(|&[a, b]| a + b);"},{"DocComment":" assert_eq!(it.next(), Some(4));  // 1 + 3"},{"DocComment":" assert_eq!(it.next(), Some(11)); // 3 + 8"},{"DocComment":" assert_eq!(it.next(), Some(9));  // 8 + 1"},{"DocComment":" assert_eq!(it.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since the elements in the following example implement `Copy`, we can"},{"DocComment":" just copy the array and get an iterator over the windows."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" let mut it = \"ferris\".chars().map_windows(|w: &[_; 3]| *w);"},{"DocComment":" assert_eq!(it.next(), Some(['f', 'e', 'r']));"},{"DocComment":" assert_eq!(it.next(), Some(['e', 'r', 'r']));"},{"DocComment":" assert_eq!(it.next(), Some(['r', 'r', 'i']));"},{"DocComment":" assert_eq!(it.next(), Some(['r', 'i', 's']));"},{"DocComment":" assert_eq!(it.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also use this function to check the sortedness of an iterator."},{"DocComment":" For the simple case, rather use [`Iterator::is_sorted`]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" let mut it = [0.5, 1.0, 3.5, 3.0, 8.5, 8.5, f32::NAN].iter()"},{"DocComment":"     .map_windows(|[a, b]| a <= b);"},{"DocComment":""},{"DocComment":" assert_eq!(it.next(), Some(true));  // 0.5 <= 1.0"},{"DocComment":" assert_eq!(it.next(), Some(true));  // 1.0 <= 3.5"},{"DocComment":" assert_eq!(it.next(), Some(false)); // 3.5 <= 3.0"},{"DocComment":" assert_eq!(it.next(), Some(true));  // 3.0 <= 8.5"},{"DocComment":" assert_eq!(it.next(), Some(true));  // 8.5 <= 8.5"},{"DocComment":" assert_eq!(it.next(), Some(false)); // 8.5 <= NAN"},{"DocComment":" assert_eq!(it.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" For non-fused iterators, the window is reset after `None` is yielded."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" #[derive(Default)]"},{"DocComment":" struct NonFusedIterator {"},{"DocComment":"     state: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Iterator for NonFusedIterator {"},{"DocComment":"     type Item = i32;"},{"DocComment":""},{"DocComment":"     fn next(&mut self) -> Option<i32> {"},{"DocComment":"         let val = self.state;"},{"DocComment":"         self.state = self.state + 1;"},{"DocComment":""},{"DocComment":"         // Skip every 5th number"},{"DocComment":"         if (val + 1) % 5 == 0 {"},{"DocComment":"             None"},{"DocComment":"         } else {"},{"DocComment":"             Some(val)"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":""},{"DocComment":" let mut iter = NonFusedIterator::default();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), Some(5));"},{"DocComment":" assert_eq!(iter.next(), Some(6));"},{"DocComment":" assert_eq!(iter.next(), Some(7));"},{"DocComment":" assert_eq!(iter.next(), Some(8));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), Some(10));"},{"DocComment":" assert_eq!(iter.next(), Some(11));"},{"DocComment":""},{"DocComment":" let mut iter = NonFusedIterator::default()"},{"DocComment":"     .map_windows(|arr: &[_; 2]| *arr);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some([0, 1]));"},{"DocComment":" assert_eq!(iter.next(), Some([1, 2]));"},{"DocComment":" assert_eq!(iter.next(), Some([2, 3]));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some([5, 6]));"},{"DocComment":" assert_eq!(iter.next(), Some([6, 7]));"},{"DocComment":" assert_eq!(iter.next(), Some([7, 8]));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some([10, 11]));"},{"DocComment":" assert_eq!(iter.next(), Some([11, 12]));"},{"DocComment":" assert_eq!(iter.next(), Some([12, 13]));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"F"},{"index":2,"name":"R"},{"index":3,"name":"Clause0_Item"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":1670}}],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31712}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":17,"beg":{"line":1774,"col":11},"end":{"line":1774,"col":39}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":31699},{"HashConsedValue":[32559,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"HashConsedValue":[32558,{"Ref":[{"Var":{"Bound":[0,0]}},{"HashConsedValue":[32557,{"Array":[{"Deduplicated":31712},{"kind":{"Var":{"Free":0}},"ty":{"Deduplicated":1670}}]}]},"Shared"]}]}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":31706}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":