" state, and a closure with two arguments, the first being a mutable"},{"DocComment":" reference to the internal state and the second an iterator element."},{"DocComment":" The closure can assign to the internal state to share state between"},{"DocComment":" iterations."},{"DocComment":""},{"DocComment":" On iteration, the closure will be applied to each element of the"},{"DocComment":" iterator and the return value from the closure, an [`Option`], is"},{"DocComment":" returned by the `next` method. Thus the closure can return"},{"DocComment":" `Some(value)` to yield `value`, or `None` to end the iteration."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3, 4];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().scan(1, |state, x| {"},{"DocComment":"     // each iteration, we'll multiply the state by the element ..."},{"DocComment":"     *state = *state * x;"},{"DocComment":""},{"DocComment":"     // ... and terminate if the state exceeds 6"},{"DocComment":"     if *state > 6 {"},{"DocComment":"         return None;"},{"DocComment":"     }"},{"DocComment":"     // ... else yield the negation of the state"},{"DocComment":"     Some(-*state)"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(-1));"},{"DocComment":" assert_eq!(iter.next(), Some(-2));"},{"DocComment":" assert_eq!(iter.next(), Some(-6));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"St"},{"index":2,"name":"B"},{"index":3,"name":"F"},{"index":4,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binde