ies;"},{"DocComment":""},{"DocComment":" fn do_something_with<T>() {"},{"DocComment":"     if T::IS_ZST {"},{"DocComment":"         // ... special approach ..."},{"DocComment":"     } else {"},{"DocComment":"         // ... the normal thing ..."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" struct MyUnit;"},{"DocComment":" assert!(MyUnit::IS_ZST);"},{"DocComment":""},{"DocComment":" // For negative checks, consider using UFCS to emphasize the negation"},{"DocComment":" assert!(!<i32>::IS_ZST);"},{"DocComment":" // As it can sometimes hide in the type otherwise"},{"DocComment":" assert!(!String::IS_ZST);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"ty":{"Deduplicated":1672},"default":{"id":14,"generics":{"regions":[],"types":[{"Deduplicated":31698}],"const_generics":[],"trait_refs":[{"Deduplicated":32489}]}}},{"name":"LAYOUT","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"ty":{"Deduplicated":14485},"default":{"id":27,"generics":{"regions":[],"types":[{"Deduplicated":31698}],"const_generics":[],"trait_refs":[{"Deduplicated":32489}]}}},{"name":"MAX_SLICE_LEN","attr_info":{"attributes":[{"DocComment":" The largest safe length for a `[Self]`."},{"DocComment":""},{"DocComment":" Anything larger than this would make `size_of_val` overflow `isize::MAX`,"},{"DocComment":" which is never allowed for a single object."}],"inline":null,"rename":null,"public":true},"ty":{"Deduplicated":1670},"default":{"id":28,"generics":{"regions":[],"types":[{"Deduplicated":31698}],"const_generics":[],"trait_refs":[{"Deduplicated":32489}]}}}],"types":[],"methods":[],"vtable":null},{"def_id":32,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["collect",0]},{"Ident":["default_extend",0]},{"Ident":["SpecExtend",0]}],"span":{"data":{"file_id":14,"beg":{"line":550,"col":4},"end":{"line":550,"col":23}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes