 'm']);         // N is inferred as 3"},{"DocComment":" assert_eq!(iter.next_chunk::<4>().unwrap_err().as_slice(), &[]); // N is explicitly 4"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Split a string and get the first three items."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_next_chunk)]"},{"DocComment":""},{"DocComment":" let quote = \"not all those who wander are lost\";"},{"DocComment":" let [first, second, third] = quote.split_whitespace().next_chunk().unwrap();"},{"DocComment":" assert_eq!(first, \"not\");"},{"DocComment":" assert_eq!(second, \"all\");"},{"DocComment":" assert_eq!(third, \"those\");"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Item"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":1670}}],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31730}],"output":{"HashConsedValue":[32486,{"Adt":{"id":{"Adt":12},"generics":{"regions":[],"types":[{"HashConsedValue":[32485,{"Array":[{"Deduplicated":31699},{"kind":{"Var":{"Free":0}},"ty":{"Deduplicated":1670}}]}]},{"Deduplicated":31715}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitDecl":{"trait_ref":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":1}}},"is_global_initializer":null,"body":{"Structured"