lue`s for which the supplied"},{"DocComment":" closure returns `Some(value)`."},{"DocComment":""},{"DocComment":" `filter_map` can be used to make chains of [`filter`] and [`map`] more"},{"DocComment":" concise. The example below shows how a `map().filter().map()` can be"},{"DocComment":" shortened to a single call to `filter_map`."},{"DocComment":""},{"DocComment":" [`filter`]: Iterator::filter"},{"DocComment":" [`map`]: Iterator::map"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [\"1\", \"two\", \"NaN\", \"four\", \"5\"];"},{"DocComment":""},{"DocComment":" let mut iter = a.iter().filter_map(|s| s.parse().ok());"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(5));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Here's the same example, but with [`filter`] and [`map`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [\"1\", \"two\", \"NaN\", \"four\", \"5\"];"},{"DocComment":" let mut iter = a.iter().map(|s| s.parse()).filter(|s| s.is_ok()).map(|s| s.unwrap());"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(5));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"B"},{"index":2,"name":"F"},{"index":3,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31712}],"const_generics":[],"trait_refs