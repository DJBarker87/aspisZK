"line":78,"col":45}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Advances the iterator and returns the next value."},{"DocComment":""},{"DocComment":" Returns [`None`] when iteration is finished. Individual iterator"},{"DocComment":" implementations may choose to resume iteration, and so calling `next()`"},{"DocComment":" again may or may not eventually start returning [`Some(Item)`] again at some"},{"DocComment":" point."},{"DocComment":""},{"DocComment":" [`Some(Item)`]: Some"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" // A call to next() returns the next value..."},{"DocComment":" assert_eq!(Some(1), iter.next());"},{"DocComment":" assert_eq!(Some(2), iter.next());"},{"DocComment":" assert_eq!(Some(3), iter.next());"},{"DocComment":""},{"DocComment":" // ... and then None once it's over."},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":""},{"DocComment":" // More calls may or may not return `None`. Here, they always will."},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"next"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":32433}],"output":{"Deduplicated":31705}},"default":null},"kind":{"TraitMethod":[1,0]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":1670}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"next_chunk","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["next_chunk",0]}],"span":{"data":{"file_id":17,"beg":{"line":112,"col":4},"end":{"line":116,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Advances the iterator and returns an array containing the next `N` values."},{"DocComment":""},{"DocComment":" If there are not enough elements to fill the array then `Err` is returned"},{"DocComment":" containing an iterator over the remaining elements."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_next_chunk)]"},{"DocComment":""},{"DocComment":" let mut iter = \"lorem\".chars();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next_chunk().unwrap(), ['l', 'o']);              // N is inferred as 2"},{"DocComment":" assert_eq!(iter.next_chunk().unwrap(), ['r', 'e', 'm']);         // N is inferred as 3"},{"DocComment":" assert_eq!(iter.next_chunk::<4>().unwrap_err().as_slice(), &[]); // N is explicitly 4"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Split a string and get the first three items."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_next_chunk)]"},{"DocComment":""},{"DocComment":" let quote = \"not all those who wander are lost\";"},{"DocComment":" let [first, second, third] = quote.split_whitespace().next_chunk().unwrap();"},{"DocComment":" assert_eq!(first, \"not\");"},{"DocComment":" assert_eq!(second, \"all\");"},{"DocComment":" assert_eq!(third, \"those\");"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":32433}],"output":{"HashConsedValue":[32436,{"Adt":{"id":{"Adt":12},"generics":{"regions":[],"types":[{"HashConsedValue":[32434,{"Array":[{"Deduplicated":31699},{"kind":{"Var":{"Bound":[0,0]}},"ty":{"Deduplicated":1670}}]}]},{"HashConsedValue":[32435,{"Adt":{"id":{"Adt":13},"generics":{"regions":[],"types":[{"Deduplicated":31699}],"const_generics":[{"kind":{"Var":{"Bound":[0,0]}},"ty":{"Deduplicated":1670}}],"trait_refs":[]}}}]}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":7,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[{"kind":{"Var":{"Bound":[0,0]}},"ty":{"Deduplicated":1670}}],"trait_refs":[{"HashConsedValue":[32437,{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[1,1]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"size_hint","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["size_hint",0]}],"span":{"data":{"file_id":17,"beg":{"line":189,"col":4},"end":{"line":189,"col":49}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the bounds on the remaining length of the iterator."},{"DocComment":""},{"DocComment":" Specifically, `size_hint()` returns a tuple where the first element"},{"DocComment":" is the lower bound, and the second element is the upper bound."},{"DocComment":""},{"DocComment":" The second half of the tuple that is returned is an <code>[Option]<[usize]></code>."},{"DocComment":" A [`None`] here means that either there is no known upper bound, or the"},{"DocComment":" upper bound is larger than [`usize`]."},{"DocComment":""},{"DocComment":" # Implementation notes"},{"DocComment":""},{"DocComment":" It is not enforced that an iterator implementation yields the declared"},{"DocComment":" number of elements. A buggy iterator may yield less than the lower bound"},{"DocComment":" or more than the upper bound of elements."},{"DocComment":""},{"DocComment":" `size_hint()` is primarily intended to be used for optimizations such as"},{"DocComment":" reserving space for the elements of the iterator, but must not be"},{"DocComment":" trusted to e.g., omit bounds checks in unsafe code. An incorrect"},{"DocComment":" implementation of `size_hint()` should not lead to memory safety"},{"DocComment":" violations."},{"DocComment":""},{"DocComment":" That said, the implementation should provide a correct estimation,"},{"DocComment":" because otherwise it would be a violation of the trait's protocol."},{"DocComment":""},{"DocComment":" The default implementation returns <code>(0, [None])</code> which is correct for any"},{"DocComment":" iterator."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let mut iter = a.iter();"},{"DocComment":""},{"DocComment":" assert_eq!((3, Some(3)), iter.size_hint());"},{"DocComment":" let _ = iter.next();"},{"DocComment":" assert_eq!((2, Some(2)), iter.size_hint());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A more complex example:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // The even numbers in the range of zero to nine."},{"DocComment":" let iter = (0..10).filter(|x| x % 2 == 0);"},{"DocComment":""},{"DocComment":" // We might iterate from zero to ten times. Knowing that it's five"},{"DocComment":" // exactly wouldn't be possible without executing filter()."},{"DocComment":" assert_eq!((0, Some(10)), iter.size_hint());"},{"DocComment":""},{"DocComment":" // Let's add five more numbers with chain()"},{"DocComment":" let iter = (0..10).filter(|x| x % 2 == 0).chain(15..20);"},{"DocComment":""},{"DocComment":" // now both bounds are increased by five"},{"DocComment":" assert_eq!((5, Some(15)), iter.size_hint());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Returning `None` for an upper bound:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // an infinite iterator has no upper bound"},{"DocComment":" // and the maximum possible lower bound"},{"DocComment":" let iter = 0..;"},{"DocComment":""},{"DocComment":" assert_eq!((usize::MAX, None), iter.size_hint());"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31747}],"output":{"Deduplicated":29006}},"default":{"id":8,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}},"kind":{"TraitMethod":[1,2]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":226,"col":22},"end":{"line":226,"col":38}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":31698}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":17,"beg":{"line":227,"col":20},"end":{"line":227,"col":36}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"count","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["count",0]}],"span":{"data":{"file_id":17,"beg":{"line":224,"col":4},"end":{"line":227,"col":37}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Consumes the iterator, counting the number of iterations and returning it."},{"DocComment":""},{"DocComment":" This method will call [`next`] repeatedly until [`None`] is encountered,"},{"DocComment":" returning the number of times it saw [`Some`]. Note that [`next`] has to be"},{"DocComment":" called at least once even if the iterator does not have any elements."},{"DocComment":""},{"DocComment":" [`next`]: Iterator::next"},{"DocComment":""},{"DocComment":" # Overflow Behavior"},{"DocComment":""},{"DocComment":" The method does no guarding against overflows, so counting elements of"},{"DocComment":" an iterator with more than [`usize::MAX`] elements either produces the"},{"DocComment":" wrong result or panics. If overflow checks are enabled, a panic is"},{"DocComment":" guaranteed."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" This function might panic if the iterator has more than [`usize::MAX`]"},{"DocComment":" elements."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" assert_eq!(a.iter().count(), 3);"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3, 4, 5];"},{"DocComment":" assert_eq!(a.iter().count(), 5);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698}],"output":{"Deduplicated":1670}},"default":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[32438,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":31698}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[31988,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[1,3]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":259,"col":22},"end":{"line":259,"col":38}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":31698}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":17,"beg":{"line":260,"col":20},"end":{"line":260,"col":36}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"last","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["last",0]}],"span":{"data":{"file_id":17,"beg":{"line":257,"col":4},"end":{"line":260,"col":37}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Consumes the iterator, returning the last element."},{"DocComment":""},{"DocComment":" This method will evaluate the iterator until it returns [`None`]. While"},{"DocComment":" doing so, it keeps track of the current element. After [`None`] is"},{"DocComment":" returned, `last()` will then return the last element it saw."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" This function might panic if the iterator is infinite."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" assert_eq!(a.into_iter().last(), Some(3));"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3, 4, 5];"},{"DocComment":" assert_eq!(a.into_iter().last(), Some(5));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698}],"output":{"Deduplicated":31705}},"default":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"Deduplicated":32438},{"Deduplicated":31988}]}}},"kind":{"TraitMethod":[1,4]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"advance_by","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["advance_by",0]}],"span":{"data":{"file_id":17,"beg":{"line":310,"col":4},"end":{"line":310,"col":68}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Advances the iterator by `n` elements."},{"DocComment":""},{"DocComment":" This method will eagerly skip `n` elements by calling [`next`] up to `n`"},{"DocComment":" times until [`None`] is encountered."},{"DocComment":""},{"DocComment":" `advance_by(n)` will return `Ok(())` if the iterator successfully advances by"},{"DocComment":" `n` elements, or a `Err(NonZero<usize>)` with value `k` if [`None`] is encountered,"},{"DocComment":" where `k` is remaining number of steps that could not be advanced because the iterator ran out."},{"DocComment":" If `self` is empty and `n` is non-zero, then this returns `Err(n)`."},{"DocComment":" Otherwise, `k` is always less than `n`."},{"DocComment":""},{"DocComment":" Calling `advance_by(0)` can do meaningful work, for example [`Flatten`]"},{"DocComment":" can advance its outer iterator until it finds an inner iterator that is not empty, which"},{"DocComment":" then often allows it to return a more accurate `size_hint()` than in its initial state."},{"DocComment":""},{"DocComment":" [`Flatten`]: crate::iter::Flatten"},{"DocComment":" [`next`]: Iterator::next"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_advance_by)]"},{"DocComment":""},{"DocComment":" use std::num::NonZero;"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3, 4];"},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.advance_by(2), Ok(()));"},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" assert_eq!(iter.advance_by(0), Ok(()));"},{"DocComment":" assert_eq!(iter.advance_by(100), Err(NonZero::new(99).unwrap())); // only `4` was skipped"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":32433},{"Deduplicated":1670}],"output":{"Deduplicated":29008}},"default":{"id":11,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437}]}}},"kind":{"TraitMethod":[1,5]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"nth","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["nth",0]}],"span":{"data":{"file_id":17,"beg":{"line":388,"col":4},"end":{"line":388,"col":53}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the `n`th element of the iterator."},{"DocComment":""},{"DocComment":" Like most indexing operations, the count starts from zero, so `nth(0)`"},{"DocComment":" returns the first value, `nth(1)` the second, and so on."},{"DocComment":""},{"DocComment":" Note that all preceding elements, as well as the returned element, will be"},{"DocComment":" consumed from the iterator. That means that the preceding elements will be"},{"DocComment":" discarded, and also that calling `nth(0)` multiple times on the same iterator"},{"DocComment":" will return different elements."},{"DocComment":""},{"DocComment":" `nth()` will return [`None`] if `n` is greater than or equal to the length of the"},{"DocComment":" iterator."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" assert_eq!(a.into_iter().nth(1), Some(2));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Calling `nth()` multiple times doesn't rewind the iterator:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.nth(1), Some(2));"},{"DocComment":" assert_eq!(iter.nth(1), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Returning `None` if there are less than `n + 1` elements:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" assert_eq!(a.into_iter().nth(10), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":32433},{"Deduplicated":1670}],"output":{"Deduplicated":31705}},"default":{"id":12,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437}]}}},"kind":{"TraitMethod":[1,6]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"step_by","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["step_by",0]}],"span":{"data":{"file_id":17,"beg":{"line":439,"col":4},"end":{"line":441,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator starting at the same point, but stepping by"},{"DocComment":" the given amount at each iteration."},{"DocComment":""},{"DocComment":" Note 1: The first element of the iterator will always be returned,"},{"DocComment":" regardless of the step given."},{"DocComment":""},{"DocComment":" Note 2: The time at which ignored elements are pulled is not fixed."},{"DocComment":" `StepBy` behaves like the sequence `self.next()`, `self.nth(step-1)`,"},{"DocComment":" `self.nth(step-1)`, …, but is also free to behave like the sequence"},{"DocComment":" `advance_n_and_return_first(&mut self, step)`,"},{"DocComment":" `advance_n_and_return_first(&mut self, step)`, …"},{"DocComment":" Which way is used may change for some iterators for performance reasons."},{"DocComment":" The second way will advance the iterator earlier and may consume more items."},{"DocComment":""},{"DocComment":" `advance_n_and_return_first` is the equivalent of:"},{"DocComment":" ```"},{"DocComment":" fn advance_n_and_return_first<I>(iter: &mut I, n: usize) -> Option<I::Item>"},{"DocComment":" where"},{"DocComment":"     I: Iterator,"},{"DocComment":" {"},{"DocComment":"     let next = iter.next();"},{"DocComment":"     if n > 1 {"},{"DocComment":"         iter.nth(n - 2);"},{"DocComment":"     }"},{"DocComment":"     next"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" The method will panic if the given step is `0`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [0, 1, 2, 3, 4, 5];"},{"DocComment":" let mut iter = a.into_iter().step_by(2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":1670}],"output":{"Deduplicated":32439}},"default":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437}]}}},"kind":{"TraitMethod":[1,7]}},{"params":{"regions":[],"types":[{"index":0,"name":"U"},{"index":1,"name":"Clause0_IntoIter"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":513,"col":11},"end":{"line":513,"col":50}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":31699},{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"chain","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["chain",0]}],"span":{"data":{"file_id":17,"beg":{"line":510,"col":4},"end":{"line":513,"col":51}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Takes two iterators and creates a new iterator over both in sequence."},{"DocComment":""},{"DocComment":" `chain()` will return a new iterator which will first iterate over"},{"DocComment":" values from the first iterator and then over values from the second"},{"DocComment":" iterator."},{"DocComment":""},{"DocComment":" In other words, it links two iterators together, in a chain. 🔗"},{"DocComment":""},{"DocComment":" [`once`] is commonly used to adapt a single value into a chain of"},{"DocComment":" other kinds of iteration."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s1 = \"abc\".chars();"},{"DocComment":" let s2 = \"def\".chars();"},{"DocComment":""},{"DocComment":" let mut iter = s1.chain(s2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some('a'));"},{"DocComment":" assert_eq!(iter.next(), Some('b'));"},{"DocComment":" assert_eq!(iter.next(), Some('c'));"},{"DocComment":" assert_eq!(iter.next(), Some('d'));"},{"DocComment":" assert_eq!(iter.next(), Some('e'));"},{"DocComment":" assert_eq!(iter.next(), Some('f'));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since the argument to `chain()` uses [`IntoIterator`], we can pass"},{"DocComment":" anything that can be converted into an [`Iterator`], not just an"},{"DocComment":" [`Iterator`] itself. For example, arrays (`[T]`) implement"},{"DocComment":" [`IntoIterator`], and so can be passed to `chain()` directly:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a1 = [1, 2, 3];"},{"DocComment":" let a2 = [4, 5, 6];"},{"DocComment":""},{"DocComment":" let mut iter = a1.into_iter().chain(a2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), Some(5));"},{"DocComment":" assert_eq!(iter.next(), Some(6));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you work with Windows API, you may wish to convert [`OsStr`] to `Vec<u16>`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[cfg(windows)]"},{"DocComment":" fn os_str_to_utf16(s: &std::ffi::OsStr) -> Vec<u16> {"},{"DocComment":"     use std::os::windows::ffi::OsStrExt;"},{"DocComment":"     s.encode_wide().chain(std::iter::once(0)).collect()"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`once`]: crate::iter::once"},{"DocComment":" [`OsStr`]: ../../std/ffi/struct.OsStr.html"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":2273}],"output":{"HashConsedValue":[32440,{"Adt":{"id":{"Adt":16},"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2886}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":14,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":31699},{"Deduplicated":2886}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[31989,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":31699},{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":2346}]}}},"kind":{"TraitMethod":[1,8]}},{"params":{"regions":[],"types":[{"index":0,"name":"U"},{"index":1,"name":"Clause0_Item"},{"index":2,"name":"Clause0_IntoIter"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":632,"col":11},"end":{"line":632,"col":23}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":2876},{"Deduplicated":3259}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"zip","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["zip",0]}],"span":{"data":{"file_id":17,"beg":{"line":629,"col":4},"end":{"line":632,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" 'Zips up' two iterators into a single iterator of pairs."},{"DocComment":""},{"DocComment":" `zip()` returns a new iterator that will iterate over two other"},{"DocComment":" iterators, returning a tuple where the first element comes from the"},{"DocComment":" first iterator, and the second element comes from the second iterator."},{"DocComment":""},{"DocComment":" In other words, it zips two iterators together, into a single one."},{"DocComment":""},{"DocComment":" If either iterator returns [`None`], [`next`] from the zipped iterator"},{"DocComment":" will return [`None`]."},{"DocComment":" If the zipped iterator has no more elements to return then each further attempt to advance"},{"DocComment":" it will first try to advance the first iterator at most one time and if it still yielded an item"},{"DocComment":" try to advance the second iterator at most one time."},{"DocComment":""},{"DocComment":" To 'undo' the result of zipping up two iterators, see [`unzip`]."},{"DocComment":""},{"DocComment":" [`unzip`]: Iterator::unzip"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s1 = \"abc\".chars();"},{"DocComment":" let s2 = \"def\".chars();"},{"DocComment":""},{"DocComment":" let mut iter = s1.zip(s2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(('a', 'd')));"},{"DocComment":" assert_eq!(iter.next(), Some(('b', 'e')));"},{"DocComment":" assert_eq!(iter.next(), Some(('c', 'f')));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since the argument to `zip()` uses [`IntoIterator`], we can pass"},{"DocComment":" anything that can be converted into an [`Iterator`], not just an"},{"DocComment":" [`Iterator`] itself. For example, arrays (`[T]`) implement"},{"DocComment":" [`IntoIterator`], and so can be passed to `zip()` directly:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a1 = [1, 2, 3];"},{"DocComment":" let a2 = [4, 5, 6];"},{"DocComment":""},{"DocComment":" let mut iter = a1.into_iter().zip(a2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some((1, 4)));"},{"DocComment":" assert_eq!(iter.next(), Some((2, 5)));"},{"DocComment":" assert_eq!(iter.next(), Some((3, 6)));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `zip()` is often used to zip an infinite iterator to a finite one."},{"DocComment":" This works because the finite iterator will eventually return [`None`],"},{"DocComment":" ending the zipper. Zipping with `(0..)` can look a lot like [`enumerate`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let enumerate: Vec<_> = \"foo\".chars().enumerate().collect();"},{"DocComment":""},{"DocComment":" let zipper: Vec<_> = (0..).zip(\"foo\".chars()).collect();"},{"DocComment":""},{"DocComment":" assert_eq!((0, 'f'), enumerate[0]);"},{"DocComment":" assert_eq!((0, 'f'), zipper[0]);"},{"DocComment":""},{"DocComment":" assert_eq!((1, 'o'), enumerate[1]);"},{"DocComment":" assert_eq!((1, 'o'), zipper[1]);"},{"DocComment":""},{"DocComment":" assert_eq!((2, 'o'), enumerate[2]);"},{"DocComment":" assert_eq!((2, 'o'), zipper[2]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If both iterators have roughly equivalent syntax, it may be more readable to use [`zip`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::iter::zip;"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let b = [2, 3, 4];"},{"DocComment":""},{"DocComment":" let mut zipped = zip("},{"DocComment":"     a.into_iter().map(|x| x * 2).skip(1),"},{"DocComment":"     b.into_iter().map(|x| x * 2).skip(1),"},{"DocComment":" );"},{"DocComment":""},{"DocComment":" assert_eq!(zipped.next(), Some((4, 6)));"},{"DocComment":" assert_eq!(zipped.next(), Some((6, 8)));"},{"DocComment":" assert_eq!(zipped.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" compared to:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # let a = [1, 2, 3];"},{"DocComment":" # let b = [2, 3, 4];"},{"DocComment":" #"},{"DocComment":" let mut zipped = a"},{"DocComment":"     .into_iter()"},{"DocComment":"     .map(|x| x * 2)"},{"DocComment":"     .skip(1)"},{"DocComment":"     .zip(b.into_iter().map(|x| x * 2).skip(1));"},{"DocComment":" #"},{"DocComment":" # assert_eq!(zipped.next(), Some((4, 6)));"},{"DocComment":" # assert_eq!(zipped.next(), Some((6, 8)));"},{"DocComment":" # assert_eq!(zipped.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`enumerate`]: Iterator::enumerate"},{"DocComment":" [`next`]: Iterator::next"},{"DocComment":" [`zip`]: crate::iter::zip"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":2273}],"output":{"HashConsedValue":[32441,{"Adt":{"id":{"Adt":17},"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":3272}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":15,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":31699},{"Deduplicated":2886},{"Deduplicated":3272}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[24873,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":2876},{"Deduplicated":3259}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":2346}]}}},"kind":{"TraitMethod":[1,9]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":696,"col":20},"end":{"line":696,"col":25}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"intersperse","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["intersperse",0]}],"span":{"data":{"file_id":17,"beg":{"line":693,"col":4},"end":{"line":696,"col":26}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates a new iterator which places a copy of `separator` between items"},{"DocComment":" of the original iterator."},{"DocComment":""},{"DocComment":" Specifically on fused iterators, it is guaranteed that the new iterator"},{"DocComment":" places a copy of `separator` between *adjacent* `Some(_)` items. For non-fused iterators,"},{"DocComment":" it is guaranteed that [`intersperse`] will create a new iterator that places a copy"},{"DocComment":" of `separator` between `Some(_)` items, particularly just right before the subsequent"},{"DocComment":" `Some(_)` item."},{"DocComment":""},{"DocComment":" For example, consider the following non-fused iterator:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" Some(1) -> Some(2) -> None -> Some(3) -> Some(4) -> ..."},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If this non-fused iterator were to be interspersed with `0`,"},{"DocComment":" then the interspersed iterator will produce:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" Some(1) -> Some(0) -> Some(2) -> None -> Some(0) -> Some(3) -> Some(0) ->"},{"DocComment":" Some(4) -> ..."},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In case `separator` does not implement [`Clone`] or needs to be"},{"DocComment":" computed every time, use [`intersperse_with`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_intersperse)]"},{"DocComment":""},{"DocComment":" let mut a = [0, 1, 2].into_iter().intersperse(100);"},{"DocComment":" assert_eq!(a.next(), Some(0));   // The first element from `a`."},{"DocComment":" assert_eq!(a.next(), Some(100)); // The separator."},{"DocComment":" assert_eq!(a.next(), Some(1));   // The next element from `a`."},{"DocComment":" assert_eq!(a.next(), Some(100)); // The separator."},{"DocComment":" assert_eq!(a.next(), Some(2));   // The last element from `a`."},{"DocComment":" assert_eq!(a.next(), None);       // The iterator is finished."},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `intersperse` can be very useful to join an iterator's items using a common element:"},{"DocComment":" ```"},{"DocComment":" #![feature(iter_intersperse)]"},{"DocComment":""},{"DocComment":" let words = [\"Hello\", \"World\", \"!\"];"},{"DocComment":" let hello: String = words.into_iter().intersperse(\" \").collect();"},{"DocComment":" assert_eq!(hello, \"Hello World !\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Clone`]: crate::clone::Clone"},{"DocComment":" [`intersperse`]: Iterator::intersperse"},{"DocComment":" [`intersperse_with`]: Iterator::intersperse_with"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":31699}],"output":{"Deduplicated":32442}},"default":{"id":16,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[31990,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[1,10]}},{"params":{"regions":[],"types":[{"index":0,"name":"G"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":775,"col":11},"end":{"line":775,"col":32}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":2165},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"intersperse_with","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["intersperse_with",0]}],"span":{"data":{"file_id":17,"beg":{"line":772,"col":4},"end":{"line":775,"col":33}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates a new iterator which places an item generated by `separator`"},{"DocComment":" between items of the original iterator."},{"DocComment":""},{"DocComment":" Specifically on fused iterators, it is guaranteed that the new iterator"},{"DocComment":" places an item generated by `separator` between adjacent `Some(_)` items."},{"DocComment":" For non-fused iterators, it is guaranteed that [`intersperse_with`] will"},{"DocComment":" create a new iterator that places an item generated by `separator` between `Some(_)`"},{"DocComment":" items, particularly just right before the subsequent `Some(_)` item."},{"DocComment":""},{"DocComment":" For example, consider the following non-fused iterator:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" Some(1) -> Some(2) -> None -> Some(3) -> Some(4) -> ..."},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If this non-fused iterator were to be interspersed with a `separator` closure"},{"DocComment":" that returns `0` repeatedly, the interspersed iterator will produce:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" Some(1) -> Some(0) -> Some(2) -> None -> Some(0) -> Some(3) -> Some(0) ->"},{"DocComment":" Some(4) -> ..."},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The `separator` closure will be called exactly once each time an item"},{"DocComment":" is placed between two adjacent items from the underlying iterator;"},{"DocComment":" specifically, the closure is not called if the underlying iterator yields"},{"DocComment":" less than two items and after the last item is yielded."},{"DocComment":""},{"DocComment":" If the iterator's item implements [`Clone`], it may be easier to use"},{"DocComment":" [`intersperse`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_intersperse)]"},{"DocComment":""},{"DocComment":" #[derive(PartialEq, Debug)]"},{"DocComment":" struct NotClone(usize);"},{"DocComment":""},{"DocComment":" let v = [NotClone(0), NotClone(1), NotClone(2)];"},{"DocComment":" let mut it = v.into_iter().intersperse_with(|| NotClone(99));"},{"DocComment":""},{"DocComment":" assert_eq!(it.next(), Some(NotClone(0)));  // The first element from `v`."},{"DocComment":" assert_eq!(it.next(), Some(NotClone(99))); // The separator."},{"DocComment":" assert_eq!(it.next(), Some(NotClone(1)));  // The next element from `v`."},{"DocComment":" assert_eq!(it.next(), Some(NotClone(99))); // The separator."},{"DocComment":" assert_eq!(it.next(), Some(NotClone(2)));  // The last element from `v`."},{"DocComment":" assert_eq!(it.next(), None);               // The iterator is finished."},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `intersperse_with` can be used in situations where the separator needs"},{"DocComment":" to be computed:"},{"DocComment":" ```"},{"DocComment":" #![feature(iter_intersperse)]"},{"DocComment":""},{"DocComment":" let src = [\"Hello\", \"to\", \"all\", \"people\", \"!!\"].iter().copied();"},{"DocComment":""},{"DocComment":" // The closure mutably borrows its context to generate an item."},{"DocComment":" let mut happy_emojis = [\" ❤️ \", \" 😀 \"].into_iter();"},{"DocComment":" let separator = || happy_emojis.next().unwrap_or(\" 🦀 \");"},{"DocComment":""},{"DocComment":" let result = src.intersperse_with(separator).collect::<String>();"},{"DocComment":" assert_eq!(result, \"Hello ❤️ to 😀 all 🦀 people 🦀 !!\");"},{"DocComment":" ```"},{"DocComment":" [`Clone`]: crate::clone::Clone"},{"DocComment":" [`intersperse`]: Iterator::intersperse"},{"DocComment":" [`intersperse_with`]: Iterator::intersperse_with"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":2273}],"output":{"HashConsedValue":[32443,{"Adt":{"id":{"Adt":19},"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[31991,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":2165},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":2346}]}}},"kind":{"TraitMethod":[1,11]}},{"params":{"regions":[],"types":[{"index":0,"name":"B"},{"index":1,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":834,"col":11},"end":{"line":834,"col":33}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2876},{"Deduplicated":31992},{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"map","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["map",0]}],"span":{"data":{"file_id":17,"beg":{"line":831,"col":4},"end":{"line":834,"col":34}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Takes a closure and creates an iterator which calls that closure on each"},{"DocComment":" element."},{"DocComment":""},{"DocComment":" `map()` transforms one iterator into another, by means of its argument:"},{"DocComment":" something that implements [`FnMut`]. It produces a new iterator which"},{"DocComment":" calls this closure on each element of the original iterator."},{"DocComment":""},{"DocComment":" If you are good at thinking in types, you can think of `map()` like this:"},{"DocComment":" If you have an iterator that gives you elements of some type `A`, and"},{"DocComment":" you want an iterator of some other type `B`, you can use `map()`,"},{"DocComment":" passing a closure that takes an `A` and returns a `B`."},{"DocComment":""},{"DocComment":" `map()` is conceptually similar to a [`for`] loop. However, as `map()` is"},{"DocComment":" lazy, it is best used when you're already working with other iterators."},{"DocComment":" If you're doing some sort of looping for a side effect, it's considered"},{"DocComment":" more idiomatic to use [`for`] than `map()`."},{"DocComment":""},{"DocComment":" [`for`]: ../../book/ch03-05-control-flow.html#looping-through-a-collection-with-for"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.iter().map(|x| 2 * x);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), Some(6));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you're doing some sort of side effect, prefer [`for`] to `map()`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(unused_must_use)]"},{"DocComment":" // don't do this:"},{"DocComment":" (0..5).map(|x| println!(\"{x}\"));"},{"DocComment":""},{"DocComment":" // it won't even execute, as it is lazy. Rust will warn you about this."},{"DocComment":""},{"DocComment":" // Instead, use a for-loop:"},{"DocComment":" for x in 0..5 {"},{"DocComment":"     println!(\"{x}\");"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"IteratorMap"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":2886}],"output":{"HashConsedValue":[32444,{"Adt":{"id":{"Adt":20},"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2886}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":18,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":2886},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[31993,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2876},{"Deduplicated":31992},{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":2346},{"Deduplicated":2911}]}}},"kind":{"TraitMethod":[1,12]}},{"params":{"regions":[],"types":[{"index":0,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":880,"col":11},"end":{"line":880,"col":28}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":31992},{"Deduplicated":2165}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"for_each","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["for_each",0]}],"span":{"data":{"file_id":17,"beg":{"line":877,"col":4},"end":{"line":880,"col":29}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Calls a closure on each element of an iterator."},{"DocComment":""},{"DocComment":" This is equivalent to using a [`for`] loop on the iterator, although"},{"DocComment":" `break` and `continue` are not possible from a closure. It's generally"},{"DocComment":" more idiomatic to use a `for` loop, but `for_each` may be more legible"},{"DocComment":" when processing items at the end of longer iterator chains. In some"},{"DocComment":" cases `for_each` may also be faster than a loop, because it will use"},{"DocComment":" internal iteration on adapters like `Chain`."},{"DocComment":""},{"DocComment":" [`for`]: ../../book/ch03-05-control-flow.html#looping-through-a-collection-with-for"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::mpsc::channel;"},{"DocComment":""},{"DocComment":" let (tx, rx) = channel();"},{"DocComment":" (0..5).map(|x| x * 2 + 1)"},{"DocComment":"       .for_each(move |x| tx.send(x).unwrap());"},{"DocComment":""},{"DocComment":" let v: Vec<_> = rx.iter().collect();"},{"DocComment":" assert_eq!(v, vec![1, 3, 5, 7, 9]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" For such a small example, a `for` loop may be cleaner, but `for_each`"},{"DocComment":" might be preferable to keep a functional style with longer iterators:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" (0..5).flat_map(|x| (x * 100)..(x * 110))"},{"DocComment":"       .enumerate()"},{"DocComment":"       .filter(|&(i, x)| (i + x) % 3 == 0)"},{"DocComment":"       .for_each(|(i, x)| println!(\"{i}:{x}\"));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":2273}],"output":{"Deduplicated":2165}},"default":{"id":19,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[31994,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":31992},{"Deduplicated":2165}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":2346}]}}},"kind":{"TraitMethod":[1,13]}},{"params":{"regions":[],"types":[{"index":0,"name":"P"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":955,"col":11},"end":{"line":955,"col":37}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":31995},{"Deduplicated":1672}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"filter","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["filter",0]}],"span":{"data":{"file_id":17,"beg":{"line":952,"col":4},"end":{"line":955,"col":38}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator which uses a closure to determine if an element"},{"DocComment":" should be yielded."},{"DocComment":""},{"DocComment":" Given an element the closure must return `true` or `false`. The returned"},{"DocComment":" iterator will yield only the elements for which the closure returns"},{"DocComment":" `true`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [0i32, 1, 2];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().filter(|x| x.is_positive());"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because the closure passed to `filter()` takes a reference, and many"},{"DocComment":" iterators iterate over references, this leads to a possibly confusing"},{"DocComment":" situation, where the type of the closure is a double reference:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s = &[0, 1, 2];"},{"DocComment":""},{"DocComment":" let mut iter = s.iter().filter(|x| **x > 1); // needs two *s!"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(&2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It's common to instead use destructuring on the argument to strip away one:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s = &[0, 1, 2];"},{"DocComment":""},{"DocComment":" let mut iter = s.iter().filter(|&x| *x > 1); // both & and *"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(&2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" or both:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s = &[0, 1, 2];"},{"DocComment":""},{"DocComment":" let mut iter = s.iter().filter(|&&x| x > 1); // two &s"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(&2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" of these layers."},{"DocComment":""},{"DocComment":" Note that `iter.filter(f).next()` is equivalent to `iter.find(f)`."}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"iter_filter"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":2273}],"output":{"HashConsedValue":[32445,{"Adt":{"id":{"Adt":21},"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":20,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[31996,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":31995},{"Deduplicated":1672}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":2346}]}}},"kind":{"TraitMethod":[1,14]}},{"params":{"regions":[],"types":[{"index":0,"name":"B"},{"index":1,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":1000,"col":11},"end":{"line":1000,"col":41}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2876},{"Deduplicated":31992},{"HashConsedValue":[28833,{"Adt":{"id":{"Adt":1},"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}]}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"filter_map","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["filter_map",0]}],"span":{"data":{"file_id":17,"beg":{"line":997,"col":4},"end":{"line":1000,"col":42}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that both filters and maps."},{"DocComment":""},{"DocComment":" The returned iterator yields only the `value`s for which the supplied"},{"DocComment":" closure returns `Some(value)`."},{"DocComment":""},{"DocComment":" `filter_map` can be used to make chains of [`filter`] and [`map`] more"},{"DocComment":" concise. The example below shows how a `map().filter().map()` can be"},{"DocComment":" shortened to a single call to `filter_map`."},{"DocComment":""},{"DocComment":" [`filter`]: Iterator::filter"},{"DocComment":" [`map`]: Iterator::map"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [\"1\", \"two\", \"NaN\", \"four\", \"5\"];"},{"DocComment":""},{"DocComment":" let mut iter = a.iter().filter_map(|s| s.parse().ok());"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(5));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Here's the same example, but with [`filter`] and [`map`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [\"1\", \"two\", \"NaN\", \"four\", \"5\"];"},{"DocComment":" let mut iter = a.iter().map(|s| s.parse()).filter(|s| s.is_ok()).map(|s| s.unwrap());"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(5));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":2886}],"output":{"HashConsedValue":[32446,{"Adt":{"id":{"Adt":22},"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2886}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":21,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":2886},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[31997,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2876},{"Deduplicated":31992},{"Deduplicated":28833}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":2346},{"Deduplicated":2911}]}}},"kind":{"TraitMethod":[1,15]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"enumerate","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["enumerate",0]}],"span":{"data":{"file_id":17,"beg":{"line":1044,"col":4},"end":{"line":1046,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator which gives the current iteration count as well as"},{"DocComment":" the next value."},{"DocComment":""},{"DocComment":" The iterator returned yields pairs `(i, val)`, where `i` is the"},{"DocComment":" current index of iteration and `val` is the value returned by the"},{"DocComment":" iterator."},{"DocComment":""},{"DocComment":" `enumerate()` keeps its count as a [`usize`]. If you want to count by a"},{"DocComment":" different sized integer, the [`zip`] function provides similar"},{"DocComment":" functionality."},{"DocComment":""},{"DocComment":" # Overflow Behavior"},{"DocComment":""},{"DocComment":" The method does no guarding against overflows, so enumerating more than"},{"DocComment":" [`usize::MAX`] elements either produces the wrong result or panics. If"},{"DocComment":" overflow checks are enabled, a panic is guaranteed."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" The returned iterator might panic if the to-be-returned index would"},{"DocComment":" overflow a [`usize`]."},{"DocComment":""},{"DocComment":" [`zip`]: Iterator::zip"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = ['a', 'b', 'c'];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().enumerate();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some((0, 'a')));"},{"DocComment":" assert_eq!(iter.next(), Some((1, 'b')));"},{"DocComment":" assert_eq!(iter.next(), Some((2, 'c')));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"enumerate_method"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698}],"output":{"Deduplicated":32447}},"default":{"id":22,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437}]}}},"kind":{"TraitMethod":[1,16]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"peekable","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["peekable",0]}],"span":{"data":{"file_id":17,"beg":{"line":1115,"col":4},"end":{"line":1117,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator which can use the [`peek`] and [`peek_mut`] methods"},{"DocComment":" to look at the next element of the iterator without consuming it. See"},{"DocComment":" their documentation for more information."},{"DocComment":""},{"DocComment":" Note that the underlying iterator is still advanced when [`peek`] or"},{"DocComment":" [`peek_mut`] are called for the first time: In order to retrieve the"},{"DocComment":" next element, [`next`] is called on the underlying iterator, hence any"},{"DocComment":" side effects (i.e. anything other than fetching the next value) of"},{"DocComment":" the [`next`] method will occur."},{"DocComment":""},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let xs = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = xs.into_iter().peekable();"},{"DocComment":""},{"DocComment":" // peek() lets us see into the future"},{"DocComment":" assert_eq!(iter.peek(), Some(&1));"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":""},{"DocComment":" // we can peek() multiple times, the iterator won't advance"},{"DocComment":" assert_eq!(iter.peek(), Some(&3));"},{"DocComment":" assert_eq!(iter.peek(), Some(&3));"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":""},{"DocComment":" // after the iterator is finished, so is peek()"},{"DocComment":" assert_eq!(iter.peek(), None);"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using [`peek_mut`] to mutate the next item without advancing the"},{"DocComment":" iterator:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let xs = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = xs.into_iter().peekable();"},{"DocComment":""},{"DocComment":" // `peek_mut()` lets us see into the future"},{"DocComment":" assert_eq!(iter.peek_mut(), Some(&mut 1));"},{"DocComment":" assert_eq!(iter.peek_mut(), Some(&mut 1));"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":""},{"DocComment":" if let Some(p) = iter.peek_mut() {"},{"DocComment":"     assert_eq!(*p, 2);"},{"DocComment":"     // put a value into the iterator"},{"DocComment":"     *p = 1000;"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // The value reappears as the iterator continues"},{"DocComment":" assert_eq!(iter.collect::<Vec<_>>(), vec![1000, 3]);"},{"DocComment":" ```"},{"DocComment":" [`peek`]: Peekable::peek"},{"DocComment":" [`peek_mut`]: Peekable::peek_mut"},{"DocComment":" [`next`]: Iterator::next"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698}],"output":{"Deduplicated":32448}},"default":{"id":23,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437}]}}},"kind":{"TraitMethod":[1,17]}},{"params":{"regions":[],"types":[{"index":0,"name":"P"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":1183,"col":11},"end":{"line":1183,"col":37}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":31995},{"Deduplicated":1672}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"skip_while","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["skip_while",0]}],"span":{"data":{"file_id":17,"beg":{"line":1180,"col":4},"end":{"line":1183,"col":38}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that [`skip`]s elements based on a predicate."},{"DocComment":""},{"DocComment":" [`skip`]: Iterator::skip"},{"DocComment":""},{"DocComment":" `skip_while()` takes a closure as an argument. It will call this"},{"DocComment":" closure on each element of the iterator, and ignore elements"},{"DocComment":" until it returns `false`."},{"DocComment":""},{"DocComment":" After `false` is returned, `skip_while()`'s job is over, and the"},{"DocComment":" rest of the elements are yielded."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1i32, 0, 1];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().skip_while(|x| x.is_negative());"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because the closure passed to `skip_while()` takes a reference, and many"},{"DocComment":" iterators iterate over references, this leads to a possibly confusing"},{"DocComment":" situation, where the type of the closure argument is a double reference:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s = &[-1, 0, 1];"},{"DocComment":""},{"DocComment":" let mut iter = s.iter().skip_while(|x| **x < 0); // need two *s!"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(&0));"},{"DocComment":" assert_eq!(iter.next(), Some(&1));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping after an initial `false`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1, 0, 1, -2];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().skip_while(|&x| x < 0);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":""},{"DocComment":" // while this would have been false, since we already got a false,"},{"DocComment":" // skip_while() isn't used any more"},{"DocComment":" assert_eq!(iter.next(), Some(-2));"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":2273}],"output":{"HashConsedValue":[32449,{"Adt":{"id":{"Adt":25},"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":24,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"Deduplicated":31996},{"Deduplicated":2346}]}}},"kind":{"TraitMethod":[1,18]}},{"params":{"regions":[],"types":[{"index":0,"name":"P"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":1261,"col":11},"end":{"line":1261,"col":37}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":31995},{"Deduplicated":1672}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"take_while","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["take_while",0]}],"span":{"data":{"file_id":17,"beg":{"line":1258,"col":4},"end":{"line":1261,"col":38}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that yields elements based on a predicate."},{"DocComment":""},{"DocComment":" `take_while()` takes a closure as an argument. It will call this"},{"DocComment":" closure on each element of the iterator, and yield elements"},{"DocComment":" while it returns `true`."},{"DocComment":""},{"DocComment":" After `false` is returned, `take_while()`'s job is over, and the"},{"DocComment":" rest of the elements are ignored."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1i32, 0, 1];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().take_while(|x| x.is_negative());"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(-1));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because the closure passed to `take_while()` takes a reference, and many"},{"DocComment":" iterators iterate over references, this leads to a possibly confusing"},{"DocComment":" situation, where the type of the closure is a double reference:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s = &[-1, 0, 1];"},{"DocComment":""},{"DocComment":" let mut iter = s.iter().take_while(|x| **x < 0); // need two *s!"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(&-1));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping after an initial `false`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1, 0, 1, -2];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().take_while(|&x| x < 0);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(-1));"},{"DocComment":""},{"DocComment":" // We have more elements that are less than zero, but since we already"},{"DocComment":" // got a false, take_while() ignores the remaining elements."},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because `take_while()` needs to look at the value in order to see if it"},{"DocComment":" should be included or not, consuming iterators will see that it is"},{"DocComment":" removed:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3, 4];"},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" let result: Vec<i32> = iter.by_ref().take_while(|&n| n != 3).collect();"},{"DocComment":""},{"DocComment":" assert_eq!(result, [1, 2]);"},{"DocComment":""},{"DocComment":" let result: Vec<i32> = iter.collect();"},{"DocComment":""},{"DocComment":" assert_eq!(result, [4]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The `3` is no longer there, because it was consumed in order to see if"},{"DocComment":" the iteration should stop, but wasn't placed back into the iterator."}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":2273}],"output":{"HashConsedValue":[32450,{"Adt":{"id":{"Adt":26},"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":25,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"Deduplicated":31996},{"Deduplicated":2346}]}}},"kind":{"TraitMethod":[1,19]}},{"params":{"regions":[],"types":[{"index":0,"name":"B"},{"index":1,"name":"P"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":1349,"col":11},"end":{"line":1349,"col":41}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2876},{"Deduplicated":31992},{"Deduplicated":28833}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"map_while","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["map_while",0]}],"span":{"data":{"file_id":17,"beg":{"line":1346,"col":4},"end":{"line":1349,"col":42}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that both yields elements based on a predicate and maps."},{"DocComment":""},{"DocComment":" `map_while()` takes a closure as an argument. It will call this"},{"DocComment":" closure on each element of the iterator, and yield elements"},{"DocComment":" while it returns [`Some(_)`][`Some`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1i32, 4, 0, 1];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().map_while(|x| 16i32.checked_div(x));"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(-16));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Here's the same example, but with [`take_while`] and [`map`]:"},{"DocComment":""},{"DocComment":" [`take_while`]: Iterator::take_while"},{"DocComment":" [`map`]: Iterator::map"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1i32, 4, 0, 1];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter()"},{"DocComment":"                 .map(|x| 16i32.checked_div(x))"},{"DocComment":"                 .take_while(|x| x.is_some())"},{"DocComment":"                 .map(|x| x.unwrap());"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(-16));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping after an initial [`None`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [0, 1, 2, -3, 4, 5, -6];"},{"DocComment":""},{"DocComment":" let iter = a.into_iter().map_while(|x| u32::try_from(x).ok());"},{"DocComment":" let vec: Vec<_> = iter.collect();"},{"DocComment":""},{"DocComment":" // We have more elements that could fit in u32 (such as 4, 5), but `map_while` returned `None` for `-3`"},{"DocComment":" // (as the `predicate` returned `None`) and `collect` stops at the first `None` encountered."},{"DocComment":" assert_eq!(vec, [0, 1, 2]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because `map_while()` needs to look at the value in order to see if it"},{"DocComment":" should be included or not, consuming iterators will see that it is"},{"DocComment":" removed:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, -3, 4];"},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" let result: Vec<u32> = iter.by_ref()"},{"DocComment":"                            .map_while(|n| u32::try_from(n).ok())"},{"DocComment":"                            .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(result, [1, 2]);"},{"DocComment":""},{"DocComment":" let result: Vec<i32> = iter.collect();"},{"DocComment":""},{"DocComment":" assert_eq!(result, [4]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The `-3` is no longer there, because it was consumed in order to see if"},{"DocComment":" the iteration should stop, but wasn't placed back into the iterator."},{"DocComment":""},{"DocComment":" Note that unlike [`take_while`] this iterator is **not** fused."},{"DocComment":" It is also not specified what this iterator returns after the first [`None`] is returned."},{"DocComment":" If you need a fused iterator, use [`fuse`]."},{"DocComment":""},{"DocComment":" [`fuse`]: Iterator::fuse"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":2886}],"output":{"HashConsedValue":[32451,{"Adt":{"id":{"Adt":27},"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2886}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":26,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":2886},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"Deduplicated":31997},{"Deduplicated":2346},{"Deduplicated":2911}]}}},"kind":{"TraitMethod":[1,20]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"skip","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["skip",0]}],"span":{"data":{"file_id":17,"beg":{"line":1375,"col":4},"end":{"line":1377,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that skips the first `n` elements."},{"DocComment":""},{"DocComment":" `skip(n)` skips elements until `n` elements are skipped or the end of the"},{"DocComment":" iterator is reached (whichever happens first). After that, all the remaining"},{"DocComment":" elements are yielded. In particular, if the original iterator is too short,"},{"DocComment":" then the returned iterator is empty."},{"DocComment":""},{"DocComment":" Rather than overriding this method directly, instead override the `nth` method."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().skip(2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":1670}],"output":{"Deduplicated":32452}},"default":{"id":27,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437}]}}},"kind":{"TraitMethod":[1,21]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"take","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["take",0]}],"span":{"data":{"file_id":17,"beg":{"line":1447,"col":4},"end":{"line":1449,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that yields the first `n` elements, or fewer"},{"DocComment":" if the underlying iterator ends sooner."},{"DocComment":""},{"DocComment":" `take(n)` yields elements until `n` elements are yielded or the end of"},{"DocComment":" the iterator is reached (whichever happens first)."},{"DocComment":" The returned iterator is a prefix of length `n` if the original iterator"},{"DocComment":" contains at least `n` elements, otherwise it contains all of the"},{"DocComment":" (fewer than `n`) elements of the original iterator."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().take(2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `take()` is often used with an infinite iterator, to make it finite:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut iter = (0..).take(3);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If less than `n` elements are available,"},{"DocComment":" `take` will limit itself to the size of the underlying iterator:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = [1, 2];"},{"DocComment":" let mut iter = v.into_iter().take(5);"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Use [`by_ref`] to take from the iterator without consuming it, and then"},{"DocComment":" continue using the original iterator:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut words = [\"hello\", \"world\", \"of\", \"Rust\"].into_iter();"},{"DocComment":""},{"DocComment":" // Take the first two words."},{"DocComment":" let hello_world: Vec<_> = words.by_ref().take(2).collect();"},{"DocComment":" assert_eq!(hello_world, vec![\"hello\", \"world\"]);"},{"DocComment":""},{"DocComment":" // Collect the rest of the words."},{"DocComment":" // We can only do this because we used `by_ref` earlier."},{"DocComment":" let of_rust: Vec<_> = words.collect();"},{"DocComment":" assert_eq!(of_rust, vec![\"of\", \"Rust\"]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`by_ref`]: Iterator::by_ref"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":1670}],"output":{"Deduplicated":32453}},"default":{"id":28,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437}]}}},"kind":{"TraitMethod":[1,22]}},{"params":{"regions":[],"types":[{"index":0,"name":"St"},{"index":1,"name":"B"},{"index":2,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":1497,"col":11},"end":{"line":1497,"col":50}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":3259},{"HashConsedValue":[31998,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"HashConsedValue":[2295,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":2272},"Mut"]}]},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}]},{"HashConsedValue":[29001,{"Adt":{"id":{"Adt":1},"generics":{"regions":[],"types":[{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}]}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":3259}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"scan","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["scan",0]}],"span":{"data":{"file_id":17,"beg":{"line":1494,"col":4},"end":{"line":1497,"col":51}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator adapter which, like [`fold`], holds internal state, but"},{"DocComment":" unlike [`fold`], produces a new iterator."},{"DocComment":""},{"DocComment":" [`fold`]: Iterator::fold"},{"DocComment":""},{"DocComment":" `scan()` takes two arguments: an initial value which seeds the internal"},{"DocComment":" state, and a closure with two arguments, the first being a mutable"},{"DocComment":" reference to the internal state and the second an iterator element."},{"DocComment":" The closure can assign to the internal state to share state between"},{"DocComment":" iterations."},{"DocComment":""},{"DocComment":" On iteration, the closure will be applied to each element of the"},{"DocComment":" iterator and the return value from the closure, an [`Option`], is"},{"DocComment":" returned by the `next` method. Thus the closure can return"},{"DocComment":" `Some(value)` to yield `value`, or `None` to end the iteration."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3, 4];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().scan(1, |state, x| {"},{"DocComment":"     // each iteration, we'll multiply the state by the element ..."},{"DocComment":"     *state = *state * x;"},{"DocComment":""},{"DocComment":"     // ... and terminate if the state exceeds 6"},{"DocComment":"     if *state > 6 {"},{"DocComment":"         return None;"},{"DocComment":"     }"},{"DocComment":"     // ... else yield the negation of the state"},{"DocComment":"     Some(-*state)"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(-1));"},{"DocComment":" assert_eq!(iter.next(), Some(-2));"},{"DocComment":" assert_eq!(iter.next(), Some(-6));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":3272}],"output":{"HashConsedValue":[32454,{"Adt":{"id":{"Adt":30},"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":3272}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":29,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":2886},{"Deduplicated":3272},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[31999,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":3259},{"Deduplicated":31998},{"Deduplicated":29001}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":2346},{"Deduplicated":2911},{"HashConsedValue":[3299,{"kind":{"Clause":{"Bound":[0,3]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":3259}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[1,23]}},{"params":{"regions":[],"types":[{"index":0,"name":"U"},{"index":1,"name":"F"},{"index":2,"name":"Clause0_Item"},{"index":3,"name":"Clause0_IntoIter"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":1536,"col":11},"end":{"line":1536,"col":23}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":3259},{"Deduplicated":4373}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":17,"beg":{"line":1537,"col":11},"end":{"line":1537,"col":33}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2876},{"Deduplicated":31992},{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"flat_map","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["flat_map",0]}],"span":{"data":{"file_id":17,"beg":{"line":1533,"col":4},"end":{"line":1537,"col":34}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that works like map, but flattens nested structure."},{"DocComment":""},{"DocComment":" The [`map`] adapter is very useful, but only when the closure"},{"DocComment":" argument produces values. If it produces an iterator instead, there's"},{"DocComment":" an extra layer of indirection. `flat_map()` will remove this extra layer"},{"DocComment":" on its own."},{"DocComment":""},{"DocComment":" You can think of `flat_map(f)` as the semantic equivalent"},{"DocComment":" of [`map`]ping, and then [`flatten`]ing as in `map(f).flatten()`."},{"DocComment":""},{"DocComment":" Another way of thinking about `flat_map()`: [`map`]'s closure returns"},{"DocComment":" one item for each element, and `flat_map()`'s closure returns an"},{"DocComment":" iterator for each element."},{"DocComment":""},{"DocComment":" [`map`]: Iterator::map"},{"DocComment":" [`flatten`]: Iterator::flatten"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let words = [\"alpha\", \"beta\", \"gamma\"];"},{"DocComment":""},{"DocComment":" // chars() returns an iterator"},{"DocComment":" let merged: String = words.iter()"},{"DocComment":"                           .flat_map(|s| s.chars())"},{"DocComment":"                           .collect();"},{"DocComment":" assert_eq!(merged, \"alphabetagamma\");"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":2886}],"output":{"HashConsedValue":[32455,{"Adt":{"id":{"Adt":31},"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":2886},{"Deduplicated":3272},{"HashConsedValue":[4376,{"TypeVar":{"Bound":[0,3]}}]}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":30,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":2886},{"Deduplicated":31699},{"Deduplicated":3272},{"Deduplicated":4376}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[24903,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":3259},{"Deduplicated":4373}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[32000,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2876},{"Deduplicated":31992},{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":3359},{"Deduplicated":3360}]}}},"kind":{"TraitMethod":[1,24]}},{"params":{"regions":[],"types":[{"index":0,"name":"Clause0_Item"},{"index":1,"name":"Clause0_IntoIter"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":1620,"col":20},"end":{"line":1620,"col":32}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":31699},{"Deduplicated":2272},{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"flatten","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["flatten",0]}],"span":{"data":{"file_id":17,"beg":{"line":1617,"col":4},"end":{"line":1620,"col":33}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that flattens nested structure."},{"DocComment":""},{"DocComment":" This is useful when you have an iterator of iterators or an iterator of"},{"DocComment":" things that can be turned into iterators and you want to remove one"},{"DocComment":" level of indirection."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let data = vec![vec![1, 2, 3, 4], vec![5, 6]];"},{"DocComment":" let flattened: Vec<_> = data.into_iter().flatten().collect();"},{"DocComment":" assert_eq!(flattened, [1, 2, 3, 4, 5, 6]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Mapping and then flattening:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let words = [\"alpha\", \"beta\", \"gamma\"];"},{"DocComment":""},{"DocComment":" // chars() returns an iterator"},{"DocComment":" let merged: String = words.iter()"},{"DocComment":"                           .map(|s| s.chars())"},{"DocComment":"                           .flatten()"},{"DocComment":"                           .collect();"},{"DocComment":" assert_eq!(merged, \"alphabetagamma\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also rewrite this in terms of [`flat_map()`], which is preferable"},{"DocComment":" in this case since it conveys intent more clearly:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let words = [\"alpha\", \"beta\", \"gamma\"];"},{"DocComment":""},{"DocComment":" // chars() returns an iterator"},{"DocComment":" let merged: String = words.iter()"},{"DocComment":"                           .flat_map(|s| s.chars())"},{"DocComment":"                           .collect();"},{"DocComment":" assert_eq!(merged, \"alphabetagamma\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Flattening works on any `IntoIterator` type, including `Option` and `Result`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let options = vec![Some(123), Some(321), None, Some(231)];"},{"DocComment":" let flattened_options: Vec<_> = options.into_iter().flatten().collect();"},{"DocComment":" assert_eq!(flattened_options, [123, 321, 231]);"},{"DocComment":""},{"DocComment":" let results = vec![Ok(123), Ok(321), Err(456), Ok(231)];"},{"DocComment":" let flattened_results: Vec<_> = results.into_iter().flatten().collect();"},{"DocComment":" assert_eq!(flattened_results, [123, 321, 231]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Flattening only removes one level of nesting at a time:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let d3 = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]];"},{"DocComment":""},{"DocComment":" let d2: Vec<_> = d3.into_iter().flatten().collect();"},{"DocComment":" assert_eq!(d2, [[1, 2], [3, 4], [5, 6], [7, 8]]);"},{"DocComment":""},{"DocComment":" let d1: Vec<_> = d3.into_iter().flatten().flatten().collect();"},{"DocComment":" assert_eq!(d1, [1, 2, 3, 4, 5, 6, 7, 8]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Here we see that `flatten()` does not perform a \"deep\" flatten."},{"DocComment":" Instead, only one level of nesting is removed. That is, if you"},{"DocComment":" `flatten()` a three-dimensional array, the result will be"},{"DocComment":" two-dimensional and not one-dimensional. To get a one-dimensional"},{"DocComment":" structure, you have to `flatten()` again."},{"DocComment":""},{"DocComment":" [`flat_map()`]: Iterator::flat_map"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698}],"output":{"HashConsedValue":[32456,{"Adt":{"id":{"Adt":32},"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699},{"Deduplicated":2273},{"Deduplicated":2886}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":31,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699},{"Deduplicated":2273},{"Deduplicated":2886}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[32001,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":31699},{"Deduplicated":2272},{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[1,25]}},{"params":{"regions":[],"types":[{"index":0,"name":"F"},{"index":1,"name":"R"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":1670}}],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":1774,"col":11},"end":{"line":1774,"col":39}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"HashConsedValue":[32004,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"HashConsedValue":[32003,{"Ref":[{"Var":{"Bound":[0,0]}},{"HashConsedValue":[32002,{"Array":[{"Deduplicated":31699},{"kind":{"Var":{"Bound":[1,0]}},"ty":{"Deduplicated":1670}}]}]},"Shared"]}]}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"map_windows","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["map_windows",0]}],"span":{"data":{"file_id":17,"beg":{"line":1771,"col":4},"end":{"line":1774,"col":40}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Calls the given function `f` for each contiguous window of size `N` over"},{"DocComment":" `self` and returns an iterator over the outputs of `f`. Like [`slice::windows()`],"},{"DocComment":" the windows during mapping overlap as well."},{"DocComment":""},{"DocComment":" In the following example, the closure is called three times with the"},{"DocComment":" arguments `&['a', 'b']`, `&['b', 'c']` and `&['c', 'd']` respectively."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" let strings = \"abcd\".chars()"},{"DocComment":"     .map_windows(|[x, y]| format!(\"{}+{}\", x, y))"},{"DocComment":"     .collect::<Vec<String>>();"},{"DocComment":""},{"DocComment":" assert_eq!(strings, vec![\"a+b\", \"b+c\", \"c+d\"]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that the const parameter `N` is usually inferred by the"},{"DocComment":" destructured argument in the closure."},{"DocComment":""},{"DocComment":" The returned iterator yields 𝑘 − `N` + 1 items (where 𝑘 is the number of"},{"DocComment":" items yielded by `self`). If 𝑘 is less than `N`, this method yields an"},{"DocComment":" empty iterator."},{"DocComment":""},{"DocComment":" [`slice::windows()`]: slice::windows"},{"DocComment":" [`FusedIterator`]: crate::iter::FusedIterator"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `N` is zero. This check will most probably get changed to a"},{"DocComment":" compile time error before this method gets stabilized."},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" let iter = std::iter::repeat(0).map_windows(|&[]| ());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Building the sums of neighboring numbers."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" let mut it = [1, 3, 8, 1].iter().map_windows(|&[a, b]| a + b);"},{"DocComment":" assert_eq!(it.next(), Some(4));  // 1 + 3"},{"DocComment":" assert_eq!(it.next(), Some(11)); // 3 + 8"},{"DocComment":" assert_eq!(it.next(), Some(9));  // 8 + 1"},{"DocComment":" assert_eq!(it.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since the elements in the following example implement `Copy`, we can"},{"DocComment":" just copy the array and get an iterator over the windows."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" let mut it = \"ferris\".chars().map_windows(|w: &[_; 3]| *w);"},{"DocComment":" assert_eq!(it.next(), Some(['f', 'e', 'r']));"},{"DocComment":" assert_eq!(it.next(), Some(['e', 'r', 'r']));"},{"DocComment":" assert_eq!(it.next(), Some(['r', 'r', 'i']));"},{"DocComment":" assert_eq!(it.next(), Some(['r', 'i', 's']));"},{"DocComment":" assert_eq!(it.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also use this function to check the sortedness of an iterator."},{"DocComment":" For the simple case, rather use [`Iterator::is_sorted`]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" let mut it = [0.5, 1.0, 3.5, 3.0, 8.5, 8.5, f32::NAN].iter()"},{"DocComment":"     .map_windows(|[a, b]| a <= b);"},{"DocComment":""},{"DocComment":" assert_eq!(it.next(), Some(true));  // 0.5 <= 1.0"},{"DocComment":" assert_eq!(it.next(), Some(true));  // 1.0 <= 3.5"},{"DocComment":" assert_eq!(it.next(), Some(false)); // 3.5 <= 3.0"},{"DocComment":" assert_eq!(it.next(), Some(true));  // 3.0 <= 8.5"},{"DocComment":" assert_eq!(it.next(), Some(true));  // 8.5 <= 8.5"},{"DocComment":" assert_eq!(it.next(), Some(false)); // 8.5 <= NAN"},{"DocComment":" assert_eq!(it.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" For non-fused iterators, the window is reset after `None` is yielded."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_map_windows)]"},{"DocComment":""},{"DocComment":" #[derive(Default)]"},{"DocComment":" struct NonFusedIterator {"},{"DocComment":"     state: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Iterator for NonFusedIterator {"},{"DocComment":"     type Item = i32;"},{"DocComment":""},{"DocComment":"     fn next(&mut self) -> Option<i32> {"},{"DocComment":"         let val = self.state;"},{"DocComment":"         self.state = self.state + 1;"},{"DocComment":""},{"DocComment":"         // Skip every 5th number"},{"DocComment":"         if (val + 1) % 5 == 0 {"},{"DocComment":"             None"},{"DocComment":"         } else {"},{"DocComment":"             Some(val)"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":""},{"DocComment":" let mut iter = NonFusedIterator::default();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), Some(5));"},{"DocComment":" assert_eq!(iter.next(), Some(6));"},{"DocComment":" assert_eq!(iter.next(), Some(7));"},{"DocComment":" assert_eq!(iter.next(), Some(8));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), Some(10));"},{"DocComment":" assert_eq!(iter.next(), Some(11));"},{"DocComment":""},{"DocComment":" let mut iter = NonFusedIterator::default()"},{"DocComment":"     .map_windows(|arr: &[_; 2]| *arr);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some([0, 1]));"},{"DocComment":" assert_eq!(iter.next(), Some([1, 2]));"},{"DocComment":" assert_eq!(iter.next(), Some([2, 3]));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some([5, 6]));"},{"DocComment":" assert_eq!(iter.next(), Some([6, 7]));"},{"DocComment":" assert_eq!(iter.next(), Some([7, 8]));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some([10, 11]));"},{"DocComment":" assert_eq!(iter.next(), Some([11, 12]));"},{"DocComment":" assert_eq!(iter.next(), Some([12, 13]));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":2273}],"output":{"HashConsedValue":[32457,{"Adt":{"id":{"Adt":33},"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":31699}],"const_generics":[{"kind":{"Var":{"Bound":[0,0]}},"ty":{"Deduplicated":1670}}],"trait_refs":[]}}}]}},"default":{"id":32,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":2886},{"Deduplicated":31699}],"const_generics":[{"kind":{"Var":{"Bound":[0,0]}},"ty":{"Deduplicated":1670}}],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[32005,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":32004},{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":2346},{"Deduplicated":2911}]}}},"kind":{"TraitMethod":[1,26]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"fuse","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["fuse",0]}],"span":{"data":{"file_id":17,"beg":{"line":1833,"col":4},"end":{"line":1835,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator which ends after the first [`None`]."},{"DocComment":""},{"DocComment":" After an iterator returns [`None`], future calls may or may not yield"},{"DocComment":" [`Some(T)`] again. `fuse()` adapts an iterator, ensuring that after a"},{"DocComment":" [`None`] is given, it will always return [`None`] forever."},{"DocComment":""},{"DocComment":" Note that the [`Fuse`] wrapper is a no-op on iterators that implement"},{"DocComment":" the [`FusedIterator`] trait. `fuse()` may therefore behave incorrectly"},{"DocComment":" if the [`FusedIterator`] trait is improperly implemented."},{"DocComment":""},{"DocComment":" [`Some(T)`]: Some"},{"DocComment":" [`FusedIterator`]: crate::iter::FusedIterator"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // an iterator which alternates between Some and None"},{"DocComment":" struct Alternate {"},{"DocComment":"     state: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Iterator for Alternate {"},{"DocComment":"     type Item = i32;"},{"DocComment":""},{"DocComment":"     fn next(&mut self) -> Option<i32> {"},{"DocComment":"         let val = self.state;"},{"DocComment":"         self.state = self.state + 1;"},{"DocComment":""},{"DocComment":"         // if it's even, Some(i32), else None"},{"DocComment":"         (val % 2 == 0).then_some(val)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut iter = Alternate { state: 0 };"},{"DocComment":""},{"DocComment":" // we can see our iterator going back and forth"},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":""},{"DocComment":" // however, once we fuse it..."},{"DocComment":" let mut iter = iter.fuse();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":""},{"DocComment":" // it will always return `None` after the first time."},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698}],"output":{"Deduplicated":31726}},"default":{"id":33,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437}]}}},"kind":{"TraitMethod":[1,27]}},{"params":{"regions":[],"types":[{"index":0,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":1920,"col":11},"end":{"line":1920,"col":29}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":31995},{"Deduplicated":2165}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"inspect","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["inspect",0]}],"span":{"data":{"file_id":17,"beg":{"line":1917,"col":4},"end":{"line":1920,"col":30}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Does something with each element of an iterator, passing the value on."},{"DocComment":""},{"DocComment":" When using iterators, you'll often chain several of them together."},{"DocComment":" While working on such code, you might want to check out what's"},{"DocComment":" happening at various parts in the pipeline. To do that, insert"},{"DocComment":" a call to `inspect()`."},{"DocComment":""},{"DocComment":" It's more common for `inspect()` to be used as a debugging tool than to"},{"DocComment":" exist in your final code, but applications may find it useful in certain"},{"DocComment":" situations when errors need to be logged before being discarded."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 4, 2, 3];"},{"DocComment":""},{"DocComment":" // this iterator sequence is complex."},{"DocComment":" let sum = a.iter()"},{"DocComment":"     .cloned()"},{"DocComment":"     .filter(|x| x % 2 == 0)"},{"DocComment":"     .fold(0, |sum, i| sum + i);"},{"DocComment":""},{"DocComment":" println!(\"{sum}\");"},{"DocComment":""},{"DocComment":" // let's add some inspect() calls to investigate what's happening"},{"DocComment":" let sum = a.iter()"},{"DocComment":"     .cloned()"},{"DocComment":"     .inspect(|x| println!(\"about to filter: {x}\"))"},{"DocComment":"     .filter(|x| x % 2 == 0)"},{"DocComment":"     .inspect(|x| println!(\"made it through filter: {x}\"))"},{"DocComment":"     .fold(0, |sum, i| sum + i);"},{"DocComment":""},{"DocComment":" println!(\"{sum}\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will print:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" 6"},{"DocComment":" about to filter: 1"},{"DocComment":" about to filter: 4"},{"DocComment":" made it through filter: 4"},{"DocComment":" about to filter: 2"},{"DocComment":" made it through filter: 2"},{"DocComment":" about to filter: 3"},{"DocComment":" 6"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Logging errors before discarding them:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let lines = [\"1\", \"2\", \"a\"];"},{"DocComment":""},{"DocComment":" let sum: i32 = lines"},{"DocComment":"     .iter()"},{"DocComment":"     .map(|line| line.parse::<i32>())"},{"DocComment":"     .inspect(|num| {"},{"DocComment":"         if let Err(ref e) = *num {"},{"DocComment":"             println!(\"Parsing error: {e}\");"},{"DocComment":"         }"},{"DocComment":"     })"},{"DocComment":"     .filter_map(Result::ok)"},{"DocComment":"     .sum();"},{"DocComment":""},{"DocComment":" println!(\"Sum: {sum}\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will print:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" Parsing error: invalid digit found in string"},{"DocComment":" Sum: 3"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":2273}],"output":{"HashConsedValue":[32458,{"Adt":{"id":{"Adt":35},"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":34,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[32006,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":31995},{"Deduplicated":2165}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":2346}]}}},"kind":{"TraitMethod":[1,28]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"by_ref","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["by_ref",0]}],"span":{"data":{"file_id":17,"beg":{"line":1954,"col":4},"end":{"line":1956,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates a \"by reference\" adapter for this instance of `Iterator`."},{"DocComment":""},{"DocComment":" Consuming method calls (direct or indirect calls to `next`)"},{"DocComment":" on the \"by reference\" adapter will consume the original iterator,"},{"DocComment":" but ownership-taking methods (those with a `self` parameter)"},{"DocComment":" only take ownership of the \"by reference\" iterator."},{"DocComment":""},{"DocComment":" This is useful for applying ownership-taking methods"},{"DocComment":" (such as `take` in the example below)"},{"DocComment":" without giving up ownership of the original iterator,"},{"DocComment":" so you can use the original iterator afterwards."},{"DocComment":""},{"DocComment":" Uses [`impl<I: Iterator + ?Sized> Iterator for &mut I { type Item = I::Item; ...}`](Iterator#impl-Iterator-for-%26mut+I)."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut words = [\"hello\", \"world\", \"of\", \"Rust\"].into_iter();"},{"DocComment":""},{"DocComment":" // Take the first two words."},{"DocComment":" let hello_world: Vec<_> = words.by_ref().take(2).collect();"},{"DocComment":" assert_eq!(hello_world, vec![\"hello\", \"world\"]);"},{"DocComment":""},{"DocComment":" // Collect the rest of the words."},{"DocComment":" // We can only do this because we used `by_ref` earlier."},{"DocComment":" let of_rust: Vec<_> = words.collect();"},{"DocComment":" assert_eq!(of_rust, vec![\"of\", \"Rust\"]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":32433}],"output":{"Deduplicated":32433}},"default":{"id":35,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}},"kind":{"TraitMethod":[1,29]}},{"params":{"regions":[],"types":[{"index":0,"name":"B"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":2077,"col":18},"end":{"line":2077,"col":42}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"collect","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["collect",0]}],"span":{"data":{"file_id":17,"beg":{"line":2077,"col":4},"end":{"line":2079,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Transforms an iterator into a collection."},{"DocComment":""},{"DocComment":" `collect()` takes ownership of an iterator and produces whichever"},{"DocComment":" collection type you request. The iterator itself carries no knowledge of"},{"DocComment":" the eventual container; the target collection is chosen entirely by the"},{"DocComment":" type you ask `collect()` to return. This makes `collect()` one of the"},{"DocComment":" more powerful methods in the standard library, and it shows up in a wide"},{"DocComment":" variety of contexts."},{"DocComment":""},{"DocComment":" The most basic pattern in which `collect()` is used is to turn one"},{"DocComment":" collection into another. You take a collection, call [`iter`] on it,"},{"DocComment":" do a bunch of transformations, and then `collect()` at the end."},{"DocComment":""},{"DocComment":" `collect()` can also create instances of types that are not typical"},{"DocComment":" collections. For example, a [`String`] can be built from [`char`]s,"},{"DocComment":" and an iterator of [`Result<T, E>`][`Result`] items can be collected"},{"DocComment":" into `Result<Collection<T>, E>`. See the examples below for more."},{"DocComment":""},{"DocComment":" Because `collect()` is so general, it can cause problems with type"},{"DocComment":" inference. As such, `collect()` is one of the few times you'll see"},{"DocComment":" the syntax affectionately known as the 'turbofish': `::<>`. This"},{"DocComment":" helps the inference algorithm understand specifically which collection"},{"DocComment":" you're trying to collect into."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled: Vec<i32> = a.iter()"},{"DocComment":"                          .map(|x| x * 2)"},{"DocComment":"                          .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that we needed the `: Vec<i32>` on the left-hand side. This is because"},{"DocComment":" we could collect into, for example, a [`VecDeque<T>`] instead:"},{"DocComment":""},{"DocComment":" [`VecDeque<T>`]: ../../std/collections/struct.VecDeque.html"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::VecDeque;"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled: VecDeque<i32> = a.iter().map(|x| x * 2).collect();"},{"DocComment":""},{"DocComment":" assert_eq!(2, doubled[0]);"},{"DocComment":" assert_eq!(4, doubled[1]);"},{"DocComment":" assert_eq!(6, doubled[2]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using the 'turbofish' instead of annotating `doubled`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled = a.iter().map(|x| x * 2).collect::<Vec<i32>>();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because `collect()` only cares about what you're collecting into, you can"},{"DocComment":" still use a partial type hint, `_`, with the turbofish:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled = a.iter().map(|x| x * 2).collect::<Vec<_>>();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using `collect()` to make a [`String`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let chars = ['g', 'd', 'k', 'k', 'n'];"},{"DocComment":""},{"DocComment":" let hello: String = chars.into_iter()"},{"DocComment":"     .map(|x| x as u8)"},{"DocComment":"     .map(|x| (x + 1) as char)"},{"DocComment":"     .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(\"hello\", hello);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you have a list of [`Result<T, E>`][`Result`]s, you can use `collect()` to"},{"DocComment":" see if any of them failed:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let results = [Ok(1), Err(\"nope\"), Ok(3), Err(\"bad\")];"},{"DocComment":""},{"DocComment":" let result: Result<Vec<_>, &str> = results.into_iter().collect();"},{"DocComment":""},{"DocComment":" // gives us the first error"},{"DocComment":" assert_eq!(Err(\"nope\"), result);"},{"DocComment":""},{"DocComment":" let results = [Ok(1), Ok(3)];"},{"DocComment":""},{"DocComment":" let result: Result<Vec<_>, &str> = results.into_iter().collect();"},{"DocComment":""},{"DocComment":" // gives us the list of answers"},{"DocComment":" assert_eq!(Ok(vec![1, 3]), result);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`iter`]: Iterator::next"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":" [`char`]: type@char"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"iterator_collect_fn"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698}],"output":{"Deduplicated":2273}},"default":{"id":36,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[32007,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":2346}]}}},"kind":{"TraitMethod":[1,30]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"B"},{"index":1,"name":"Clause1_TryType"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":2168,"col":20},"end":{"line":2168,"col":46}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":17,"beg":{"line":2168,"col":34},"end":{"line":2168,"col":45}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"HashConsedValue":[32009,{"TraitType":[{"HashConsedValue":[32008,{"kind":{"Clause":{"Bound":[1,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}}]},1,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}]},{"Deduplicated":2272},{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":17,"beg":{"line":2169,"col":11},"end":{"line":2169,"col":52}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"HashConsedValue":[32010,{"TraitType":[{"Deduplicated":32008},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}]}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"try_collect","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["try_collect",0]}],"span":{"data":{"file_id":17,"beg":{"line":2165,"col":4},"end":{"line":2169,"col":53}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Fallibly transforms an iterator into a collection, short circuiting if"},{"DocComment":" a failure is encountered."},{"DocComment":""},{"DocComment":" `try_collect()` is a variation of [`collect()`][`collect`] that allows fallible"},{"DocComment":" conversions during collection. Its main use case is simplifying conversions from"},{"DocComment":" iterators yielding [`Option<T>`][`Option`] into `Option<Collection<T>>`, or similarly for other [`Try`]"},{"DocComment":" types (e.g. [`Result`])."},{"DocComment":""},{"DocComment":" Importantly, `try_collect()` doesn't require that the outer [`Try`] type also implements [`FromIterator`];"},{"DocComment":" only the inner type produced on `Try::Output` must implement it. Concretely,"},{"DocComment":" this means that collecting into `ControlFlow<_, Vec<i32>>` is valid because `Vec<i32>` implements"},{"DocComment":" [`FromIterator`], even though [`ControlFlow`] doesn't."},{"DocComment":""},{"DocComment":" Also, if a failure is encountered during `try_collect()`, the iterator is still valid and"},{"DocComment":" may continue to be used, in which case it will continue iterating starting after the element that"},{"DocComment":" triggered the failure. See the last example below for an example of how this works."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":" Successfully collecting an iterator of `Option<i32>` into `Option<Vec<i32>>`:"},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_collect)]"},{"DocComment":""},{"DocComment":" let u = vec![Some(1), Some(2), Some(3)];"},{"DocComment":" let v = u.into_iter().try_collect::<Vec<i32>>();"},{"DocComment":" assert_eq!(v, Some(vec![1, 2, 3]));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Failing to collect in the same way:"},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_collect)]"},{"DocComment":""},{"DocComment":" let u = vec![Some(1), Some(2), None, Some(3)];"},{"DocComment":" let v = u.into_iter().try_collect::<Vec<i32>>();"},{"DocComment":" assert_eq!(v, None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A similar example, but with `Result`:"},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_collect)]"},{"DocComment":""},{"DocComment":" let u: Vec<Result<i32, ()>> = vec![Ok(1), Ok(2), Ok(3)];"},{"DocComment":" let v = u.into_iter().try_collect::<Vec<i32>>();"},{"DocComment":" assert_eq!(v, Ok(vec![1, 2, 3]));"},{"DocComment":""},{"DocComment":" let u = vec![Ok(1), Ok(2), Err(()), Ok(3)];"},{"DocComment":" let v = u.into_iter().try_collect::<Vec<i32>>();"},{"DocComment":" assert_eq!(v, Err(()));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Finally, even [`ControlFlow`] works, despite the fact that it"},{"DocComment":" doesn't implement [`FromIterator`]. Note also that the iterator can"},{"DocComment":" continue to be used, even if a failure is encountered:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_collect)]"},{"DocComment":""},{"DocComment":" use core::ops::ControlFlow::{Break, Continue};"},{"DocComment":""},{"DocComment":" let u = [Continue(1), Continue(2), Break(3), Continue(4), Continue(5)];"},{"DocComment":" let mut it = u.into_iter();"},{"DocComment":""},{"DocComment":" let v = it.try_collect::<Vec<_>>();"},{"DocComment":" assert_eq!(v, Break(3));"},{"DocComment":""},{"DocComment":" let v = it.try_collect::<Vec<_>>();"},{"DocComment":" assert_eq!(v, Continue(vec![4, 5]));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`collect`]: Iterator::collect"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":32433}],"output":{"Deduplicated":2886}},"default":{"id":37,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":31699},{"Deduplicated":2886}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[32011,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[32012,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":32009},{"Deduplicated":2272},{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[32013,{"kind":{"Clause":{"Bound":[0,2]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":32010}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[3603,{"kind":{"Clause":{"Bound":[0,3]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[1,31]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"E"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":2238,"col":23},"end":{"line":2238,"col":41}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":11,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"collect_into","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["collect_into",0]}],"span":{"data":{"file_id":17,"beg":{"line":2238,"col":4},"end":{"line":2240,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Collects all the items from an iterator into a collection."},{"DocComment":""},{"DocComment":" This method consumes the iterator and adds all its items to the"},{"DocComment":" passed collection. The collection is then returned, so the call chain"},{"DocComment":" can be continued."},{"DocComment":""},{"DocComment":" This is useful when you already have a collection and want to add"},{"DocComment":" the iterator items to it."},{"DocComment":""},{"DocComment":" This method is a convenience method to call [Extend::extend](trait.Extend.html),"},{"DocComment":" but instead of being called on a collection, it's called on an iterator."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_collect_into)]"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let mut vec: Vec::<i32> = vec![0, 1];"},{"DocComment":""},{"DocComment":" a.iter().map(|x| x * 2).collect_into(&mut vec);"},{"DocComment":" a.iter().map(|x| x * 10).collect_into(&mut vec);"},{"DocComment":""},{"DocComment":" assert_eq!(vec, vec![0, 1, 2, 4, 6, 10, 20, 30]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `Vec` can have a manual set capacity to avoid reallocating it:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_collect_into)]"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let mut vec: Vec::<i32> = Vec::with_capacity(6);"},{"DocComment":""},{"DocComment":" a.iter().map(|x| x * 2).collect_into(&mut vec);"},{"DocComment":" a.iter().map(|x| x * 10).collect_into(&mut vec);"},{"DocComment":""},{"DocComment":" assert_eq!(6, vec.capacity());"},{"DocComment":" assert_eq!(vec, vec![2, 4, 6, 10, 20, 30]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The returned mutable reference can be used to continue the call chain:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_collect_into)]"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let mut vec: Vec::<i32> = Vec::with_capacity(6);"},{"DocComment":""},{"DocComment":" let count = a.iter().collect_into(&mut vec).iter().count();"},{"DocComment":""},{"DocComment":" assert_eq!(count, vec.len());"},{"DocComment":" assert_eq!(vec, vec![1, 2, 3]);"},{"DocComment":""},{"DocComment":" let count = a.iter().collect_into(&mut vec).iter().count();"},{"DocComment":""},{"DocComment":" assert_eq!(count, vec.len());"},{"DocComment":" assert_eq!(vec, vec![1, 2, 3, 1, 2, 3]);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"HashConsedValue":[3621,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":2273},"Mut"]}]}],"output":{"Deduplicated":3621}},"default":{"id":38,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[32014,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":11,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":2346}]}}},"kind":{"TraitMeth