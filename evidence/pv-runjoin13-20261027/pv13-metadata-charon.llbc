This is useful for applying ownership-taking methods"},{"DocComment":" (such as `take` in the example below)"},{"DocComment":" without giving up ownership of the original iterator,"},{"DocComment":" so you can use the original iterator afterwards."},{"DocComment":""},{"DocComment":" Uses [`impl<I: Iterator + ?Sized> Iterator for &mut I { type Item = I::Item; ...}`](Iterator#impl-Iterator-for-%26mut+I)."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut words = [\"hello\", \"world\", \"of\", \"Rust\"].into_iter();"},{"DocComment":""},{"DocComment":" // Take the first two words."},{"DocComment":" let hello_world: Vec<_> = words.by_ref().take(2).collect();"},{"DocComment":" assert_eq!(hello_world, vec![\"hello\", \"world\"]);"},{"DocComment":""},{"DocComment":" // Collect the rest of the words."},{"DocComment":" // We can only do this because we used `by_ref` earlier."},{"DocComment":" let of_rust: Vec<_> = words.collect();"},{"DocComment":" assert_eq!(of_rust, vec![\"of\", \"Rust\"]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31730}],"output":{"Deduplicated":31730}},"src":{"TraitDecl":{"trait_ref":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":29}}},"is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":17,"beg":{"line":1954,"col":4},"end":{"line":1959,"col":5}},"generated_from_span":null},"bound_body_regions":3,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":17,"beg":{"line":1954,"col":28},"end":{"line":1954,"col":37}},"generated_from_span":null},"ty":{"Deduplicated":32516}},{"index":1,"name":"self","span":{"data":{"file_id":17,"beg":{"line":1954,"col":14},"end":{"line":1954,"col":23}},"generated_from_span":null},"ty":{"HashConsedValue":[32563,{"Ref":[{"Body":2},{"Deduplicated":31698},"Mut"]}]}}]},"body":{"span":{"data":{"file_id":17,"beg":{"line":1958,"col":8},"end":{"line":1959,"col":5}},"generated_from_span":null},"statements":[{"span":{"data":{"file_id":17,"beg":{"line":1958,"col":8},"end":{"line":1958,"col":12}},"generated_from_span":null},"id":1080,"kind":{"StorageLive":0},"comments_before":[]},{"span":{"data":{"file_id":17,"beg":{"line":1958,"col":8},"end":{"line":1958,"col":12}},"generated_from_span":null},"id":1081,"kind":{"Assign":[{"kind":{"Local":0},"ty":{"Deduplicated":32516}},{"Use":[{"Copy":{"kind":{"Local":1},"ty":{"Deduplicated":32563}}},"Yes"]}]},"comments_before":[]},{"span":{"data":{"file_id":17,"beg":{"line":1959,"col":5},"end":{"line":1959,"col":5}},"generated_from_span":null},"id":1082,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":17,"beg":{"line":1959,"col":5},"end":{"line":1959,"col":5}},"generated_from_span":null},"id":1083,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":36,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["collect",0]}],"span":{"data":{"file_id":17,"beg":{"line":2077,"col":4},"end":{"line":2079,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Transforms an iterator into a collection."},{"DocComment":""},{"DocComment":" `collect()` takes ownership of an iterator and produces whichever"},{"DocComment":" collection type you request. The iterator itself carries no knowledge of"},{"DocComment":" the eventual container; the target collection is chosen entirely by the"},{"DocComment":" type you ask `collect()` to return. This makes `collect()` one of the"},{"DocComment":" more powerful methods in the standard library, and it shows up in a wide"},{"DocComment":" variety of contexts."},{"DocComment":""},{"DocComment":" The most basic pattern in which `collect()` is used is to turn one"},{"DocComment":" collection into another. You take a collection, call [`iter`] on it,"},{"DocComment":" do a bunch of transformations, and then `collect()` at the end."},{"DocComment":""},{"DocComment":" `collect()` can also create instances of types that are not typical"},{"DocComment":" collections. For example, a [`String`] can be built from [`char`]s,"},{"DocComment":" and an iterator of [`Result<T, E>`][`Result`] items can be collected"},{"DocComment":" into `Result<Collection<T>, E>`. See the examples below for more."},{"DocComment":""},{"DocComment":" Because `collect()` is so general, it can cause problems with type"},{"DocComment":" inference. As such, `collect()` is one of the few times you'll see"},{"DocComment":" the syntax affectionately known as the 'turbofish': `::<>`. This"},{"DocComment":" helps the inference algorithm understand specifically which collection"},{"DocComment":" you're trying to collect into."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled: Vec<i32> = a.iter()"},{"DocComment":"                          .map(|x| x * 2)"},{"DocComment":"                          .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that we needed the `: Vec<i32>` on the left-hand side. This is because"},{"DocComment":" we could collect into, for example, a [`VecDeque<T>`] instead:"},{"DocComment":""},{"DocComment":" [`VecDeque<T>`]: ../../std/collections/struct.VecDeque.html"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::VecDeque;"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled: VecDeque<i32> = a.iter().map(|x| x * 2).collect();"},{"DocComment":""},{"DocComment":" assert_eq!(2, doubled[0]);"},{"DocComment":" assert_eq!(4, doubled[1]);"},{"DocComment":" assert_eq!(6, doubled[2]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using the 'turbofish' instead of annotating `doubled`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled = a.iter().map(|x| x * 2).collect::<Vec<i32>>();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because `collect()` only cares about what you're collecting into, you can"},{"DocComment":" still use a partial type hint, `_`, with the turbofish:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled = a.iter().map(|x| x * 2).collect::<Vec<_>>();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using `collect()` to make a [`String`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let chars = ['g', 'd', 'k', 'k', 'n'];"},{"DocComment":""},{"DocComment":" let hello: String = chars.into_iter()"},{"DocComment":"     .map(|x| x as u8)"},{"DocComment":"     .map(|x| (x + 1) as char)"},{"DocComment":"     .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(\"hello\", hello);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you have a list of [`Result<T, E>`][`Result`]s, you can use `collect()` to"},{"DocComment":" see if any of them failed:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let results = [Ok(1), Err(\"nope\"), Ok(3), Err(\"bad\")];"},{"DocComment":""},{"DocComment":" let result: Result<Vec<_>, &str> = results.into_iter().collect();"},{"DocComment":""},{"DocComment":" // gives us the first error"},{"DocComment":" assert_eq!(Err(\"nope\"), result);"},{"DocComment":""},{"DocComment":" let results = [Ok(1), Ok(3)];"},{"DocComment":""},{"DocComment":" let result: Result<Vec<_>, &str> = results.into_iter().collect();"},{"DocComment":""},{"DocComment":" // gives us the list of answers"},{"DocComment":" assert_eq!(Ok(vec![1, 3]), result);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`iter`]: Iterator::next"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":" [`char`]: type@char"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"iterator_collect_fn"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"B"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31706}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":17,"beg":{"line":2077,"col":18},"end":{"line":2077,"col":42}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":31699},{"Deduplicated":31706}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698}],"output":{"Deduplicated":31699}},"src":{"TraitDecl":{"trait_ref":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31706}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":30}}},"is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":17,"beg":{"line":2077,"col":4},"end":{"line":2091,"col":5}},"generated_from_span":null},"bound_body_regions":15,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":17,"beg":{"line":2077,"col":53},"end":{"line":2077,"col":54}},"generated_from_span":null},"ty":{"Deduplicated":31699}},{"index":1,"name":"self","span":{"data":{"file_id":17,"beg":{"line":2077,"col":44},"end":{"line":2077,"col":48}},"generated_from_span":null},"ty":{"Deduplicated":31698}}]},"body":{"span":{"data":{"file_id":17,"beg":{"line":2090,"col":8},"end":{"line":2091,"col":5}},"generated_from_span":null},"statements":[{"span":{"data":{"file_id":17,"beg":{"line":2090,"col":8},"end":{"line":2090,"col":37}},"generated_from_span":null},"id":1084,"kind":{"StorageLive":0},"comments_before":[]},{"span":{"data":{"file_id":17,"beg":{"line":2090,"col":8},"end":{"line":2090,"col":37}},"generated_from_span":null},"id":1087,"kind":{"Call":{"call":{"func":{"Regular":{"kind":{"Trait":[{"HashConsedValue":[32564,{"kind":{"Clause":{"Free":1}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":31699},{"Deduplicated":31706}],"const_generics":[],"trait_refs":[]}}}}]},0]},"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31698}],"const_generics":[],"trait_refs":[{"HashConsedValue":[32565,{"kind":{"TraitImpl":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31706}],"const_generics":[],"trait_refs":[{"Deduplicated":31734},{"Deduplicated":31978}]}}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31706},{"Deduplicated":31698}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":31978}]}}},"args":[{"Move":{"kind":{"Local":1},"ty":{"Deduplicated":31698}}}],"dest":{"kind":{"Local":0},"ty":{"Deduplicated":31699}}},"on_unwind":{"span":{"data":{"file_id":17,"beg":{"line":2090,"col":8},"end":{"line":2090,"col":37}},"generated_from_span":null},"statements":[{"span":{"data":{"file_id":17,"beg":{"line":2090,"col":8},"end":{"line":2090,"col":37}},"generated_from_span":null},"id":1085,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":17,"beg":{"line":2090,"col":8},"end":{"line":2090,"col":37}},"generated_from_span":null},"id":1086,"kind":"UnwindResume","comments_before":[]}]}}},"comments_before":[]},{"span":{"data":{"file_id":17,"beg":{"line":2091,"col":5},"end":{"line":2091,"col":5}},"generated_from_span":null},"id":1088,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":17,"beg":{"line":2091,"col":5},"end":{"line":2091,"col":5}},"generated_from_span":null},"id":1089,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":37,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["try_collect",0]}],"span":{"data":{"file_id":17,"beg":{"line":2165,"col":4},"end":{"line":2169,"col":53}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Fallibly transforms an iterator into a collection, short circuiting if"},{"DocComment":" a failure is encountered."},{"DocComment":""},{"DocComment":" `try_collect()` is a variation of [`collect()`][`collect`] that allows fallible"},{"DocComment":" conversions during collection. Its main use case is simplifying conversions from"},{"DocComment":" iterators yielding [`Option<T>`][`Option`] into `Option<Collection<T>>`, or similarly for other [`Try`]"},{"DocComment":" types (e.g. [`Result`])."},{"DocComment":""},{"DocComment":" Importantly, `try_collect()` doesn't require that the outer [`Try`] type also implements [`FromIterator`];"},{"DocComment":" only the inner type produced on `Try::Output` must implement it. Concretely,"},{"DocComment":" this means that collecting into `ControlFlow<_, Vec<i32>>` is valid because `Vec<i32>` implements"},{"DocComment":" [`FromIterator`], even though [`ControlFlow`] doesn't."},{"DocComment":""},{"DocComment":" Also, if a failure is encountered during `try_collect()`, the iterator is still valid and"},{"DocComment":" may continue to be used, in which case it will continue iterating starting after the element that"},{"DocComment":" triggered the failure. See the last example below for an example of how this works."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":" Successfully collecting an iterator of `Option<i32>` into `Option<Vec<i32>>`:"},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_collect)]"},{"DocComment":""},{"DocComment":" let u = vec![Some(1), Some(2), Some(3)];"},{"DocComment":" let v = u.into_iter().try_collect::<Vec<i32>>();"},{"DocComment":" assert_eq!(v, Some(vec![1, 2, 3]));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Failing to collect in the same way:"},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_collect)]"},{"DocComment":""},{"DocComment":" let u = vec![Some(1), Some(2), None, Some(3)];"},{"DocComment":" let v = u.into_iter().try_collect::<Vec<i32>>();"},{"DocComment":" assert_eq!(v, None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A similar example, but with `Result`:"},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_collect)]"},{"DocComment":""},{"DocComment":" let u: Vec<Result<i32, ()>> = vec![Ok(1), Ok(2), Ok(3)];"},{"DocComment":" let v = u.into_iter().try_collect::<Vec<i32>>();"},{"DocComment":" assert_eq!(v, Ok(vec![1, 2, 3]));"},{"DocComment":""},{"DocComment":" let u = vec![Ok(1), Ok(2), Err(()), Ok(3)];"},{"DocComment":" let v = u.into_iter().try_collect::<Vec<i32>>();"},{"DocComment":" assert_eq!(v, Err(()));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Finally, even [`ControlFlow`] works, despite the fact that it"},{"DocComment":" doesn't implement [`FromIterator`]. Note also that the iterator can"},{"DocComment":" continue to be used, even if a failure is encountered:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_collect)]"},{"DocComment":""},{"DocComment":" use core::ops::ControlFlow::{Break, Continue};"},{"DocComment":""},{"DocComment":" let u = [Continue(1), Continue(2), Break(3), Continue(4), Continue(5)];"},{"DocComment":" let mut it = u.into_iter();"},{"DocComment":""},{"DocComment":" let v = it.try_collect::<Vec<_>>();"},{"DocComment":" assert_eq!(v, Break(3));"},{"DocComment":""},{"DocComment":" let v = it.try_collect::<Vec<_>>();"},{"DocComment":" assert_eq!(v, Continue(vec![4, 5]));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`collect`]: Iterator::collect"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"B"},{"index":2,"name":"Clause0_Item"},{"index":3,"name":"Clause2_TryType"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31706}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":17,"beg":{"line":2168,"col":20},"end":{"line":2168,"col":46}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":31706}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":17,"beg"