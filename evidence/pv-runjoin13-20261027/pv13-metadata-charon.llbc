"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":""},{"DocComment":" // after the iterator is finished, so is peek()"},{"DocComment":" assert_eq!(iter.peek(), None);"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using [`peek_mut`] to mutate the next item without advancing the"},{"DocComment":" iterator:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let xs = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = xs.into_iter().peekable();"},{"DocComment":""},{"DocComment":" // `peek_mut()` lets us see into the future"},{"DocComment":" assert_eq!(iter.peek_mut(), Some(&mut 1));"},{"DocComment":" assert_eq!(iter.peek_mut(), Some(&mut 1));"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":""},{"DocComment":" if let Some(p) = iter.peek_mut() {"},{"DocComment":"     assert_eq!(*p, 2);"},{"DocComment":"     // put a value into the iterator"},{"DocComment":"     *p = 1000;"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // The value reappears as the iterator continues"},{"DocComment":" assert_eq!(iter.collect::<Vec<_>>(), vec![1000, 3]);"},{"DocComment":" ```"},{"DocComment":" [`peek`]: Peekable::peek"},{"DocComment":" [`peek_mut`]: Peekable::peek_mut"},{"DocComment":" [`next`]: Iterator::next"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"