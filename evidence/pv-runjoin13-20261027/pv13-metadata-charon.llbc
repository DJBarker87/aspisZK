cated":2272}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[{"regions":[],"skip_binder":{"trait_ref":{"HashConsedValue":[3811,{"kind":{"Clause":{"Bound":[1,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"HashConsedValue":[2880,{"TypeVar":{"Bound":[2,1]}}]}],"const_generics":[],"trait_refs":[]}}}}]},"type_id":0,"ty":{"Deduplicated":2165}}}]},"skip_binder":{"name":"try_for_each","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["try_for_each",0]}],"span":{"data":{"file_id":17,"beg":{"line":2545,"col":4},"end":{"line":2549,"col":28}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator method that applies a fallible function to each item in the"},{"DocComment":" iterator, stopping at the first error and returning that error."},{"DocComment":""},{"DocComment":" This can also be thought of as the fallible form of [`for_each()`]"},{"DocComment":" or as the stateless version of [`try_fold()`]."},{"DocComment":""},{"DocComment":" [`for_each()`]: Iterator::for_each"},{"DocComment":" [`try_fold()`]: Iterator::try_fold"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fs::rename;"},{"DocComment":" use std::io::{stdout, Write};"},{"DocComment":" use std::path::Path;"},{"DocComment":""},{"DocComment":" let data = [\"no_tea.txt\", \"stale_bread.json\", \"torrential_rain.png\"];"},{"DocComment":""},{"DocComment":" let res = data.iter().try_for_each(|x| writeln!(stdout(), \"{x}\"));"},{"DocComment":" assert!(res.is_ok());"},{"DocComment":""},{"DocComment":" let mut it = data.iter().cloned();"},{"DocComment":" let res = it.try_for_each(|x| rename(x, Path::new(x).with_extension(\"old\")));"},{"DocComment":" assert!(res.is_err());"},{"DocComment":" // It short-circuited, so the remaining items are still in the iterator:"},{"DocComment":" assert_eq!(it.next(), Some(\"stale_bread.json\"));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The [`ControlFlow`] type can be used with this method for the situations"},{"DocComment":" in which you'd use `break` and `continue` in a normal loop:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let r = (2..100).try_for_each(|x| {"},{"DocComment":"     if 323 % x == 0 {"},{"DocComment":"         return ControlFlow::Break(x)"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     ControlFlow::Continue(())"},{"DocComment":" });"},{"DocComment":" assert_eq!(r, ControlFlow::Break(17));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":32433},{"Deduplicated":2273}],"output":{"Deduplicated":2886}},"default":{"id":43,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":2886},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[32021,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":31992},{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[3812,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":3359},{"Deduplicated":3360}]}}},"kind":{"TraitMethod":[1,37]}},{"params":{"regions":[],"types":[{"index":0,"name":"B"},{"index":1,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":2666,"col":22},"end":{"line":2666,"col":38}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":31698}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":17,"beg":{"line":2667,"col":11},"end":{"line":2667,"col":44}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2876},{"Deduplicated":32019},{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":17,"beg":{"line":2667,"col":47},"end":{"line":2667,"col":63}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":4,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"fold","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["fold",0]}],"span":{"data":{"file_id":17,"beg":{"line":2664,"col":4},"end":{"line":2667,"col":64}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Folds every element into an accumulator by applying an operation,"},{"DocComment":" returning the final result."},{"DocComment":""},{"DocComment":" `fold()` takes two arguments: an initial value, and a closure with two"},{"DocComment":" arguments: an 'accumulator', and an element. The closure returns the value that"},{"DocComment":" the accumulator should have for the next iteration."},{"DocComment":""},{"DocComment":" The initial value is the value the accumulator will have on the first"},{"DocComment":" call."},{"DocComment":""},{"DocComment":" After applying this closure to every element of the iterator, `fold()`"},{"DocComment":" returns the accumulator."},{"DocComment":""},{"DocComment":" This operation is sometimes called 'reduce' or 'inject'."},{"DocComment":""},{"DocComment":" Folding is useful whenever you have a collection of something, and want"},{"DocComment":" to produce a single value from it."},{"DocComment":""},{"DocComment":" Note: `fold()`, and similar methods that traverse the entire iterator,"},{"DocComment":" might not terminate for infinite iterators, even on traits for which a"},{"DocComment":" result is determinable in finite time."},{"DocComment":""},{"DocComment":" Note: [`reduce()`] can be used to use the first element as the initial"},{"DocComment":" value, if the accumulator type and item type is the same."},{"DocComment":""},{"DocComment":" Note: `fold()` combines elements in a *left-associative* fashion. For associative"},{"DocComment":" operators like `+`, the order the elements are combined in is not important, but for non-associative"},{"DocComment":" operators like `-` the order will affect the final result."},{"DocComment":" For a *right-associative* version of `fold()`, see [`DoubleEndedIterator::rfold()`]."},{"DocComment":""},{"DocComment":" # Note to Implementors"},{"DocComment":""},{"DocComment":" Several of the other (forward) methods have default implementations in"},{"DocComment":" terms of this one, so try to implement this explicitly if it can"},{"DocComment":" do something better than the default `for` loop implementation."},{"DocComment":""},{"DocComment":" In particular, try to have this call `fold()` on the internal parts"},{"DocComment":" from which this iterator is composed."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" // the sum of all of the elements of the array"},{"DocComment":" let sum = a.iter().fold(0, |acc, x| acc + x);"},{"DocComment":""},{"DocComment":" assert_eq!(sum, 6);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Let's walk through each step of the iteration here:"},{"DocComment":""},{"DocComment":" | element | acc | x | result |"},{"DocComment":" |---------|-----|---|--------|"},{"DocComment":" |         | 0   |   |        |"},{"DocComment":" | 1       | 0   | 1 | 1      |"},{"DocComment":" | 2       | 1   | 2 | 3      |"},{"DocComment":" | 3       | 3   | 3 | 6      |"},{"DocComment":""},{"DocComment":" And so, our final result, `6`."},{"DocComment":""},{"DocComment":" This example demonstrates the left-associative nature of `fold()`:"},{"DocComment":" it builds a string, starting with an initial value"},{"DocComment":" and continuing with each element from the front until the back:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let numbers = [1, 2, 3, 4, 5];"},{"DocComment":""},{"DocComment":" let zero = \"0\".to_string();"},{"DocComment":""},{"DocComment":" let result = numbers.iter().fold(zero, |acc, &x| {"},{"DocComment":"     format!(\"({acc} + {x})\")"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" assert_eq!(result, \"(((((0 + 1) + 2) + 3) + 4) + 5)\");"},{"DocComment":" ```"},{"DocComment":" It's common for people who haven't used iterators a lot to"},{"DocComment":" use a `for` loop with a list of things to build up a result. Those"},{"DocComment":" can be turned into `fold()`s:"},{"DocComment":""},{"DocComment":" [`for`]: ../../book/ch03-05-control-flow.html#looping-through-a-collection-with-for"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let numbers = [1, 2, 3, 4, 5];"},{"DocComment":""},{"DocComment":" let mut result = 0;"},{"DocComment":""},{"DocComment":" // for loop:"},{"DocComment":" for i in &numbers {"},{"DocComment":"     result = result + i;"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // fold:"},{"DocComment":" let result2 = numbers.iter().fold(0, |acc, &x| acc + x);"},{"DocComment":""},{"DocComment":" // they're the same"},{"DocComment":" assert_eq!(result, result2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`reduce()`]: Iterator::reduce"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":2886}],"output":{"Deduplicated":2273}},"default":{"id":44,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":2886},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"Deduplicated":32438},{"HashConsedValue":[32022,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2876},{"Deduplicated":32019},{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":2911},{"Deduplicated":3603},{"Deduplicated":3672}]}}},"kind":{"TraitMethod":[1,38]}},{"params":{"regions":[],"types":[{"index":0,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":2703,"col":22},"end":{"line":2703,"col":38}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":31698}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":17,"beg":{"line":2704,"col":11},"end":{"line":2704,"col":62}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":32023},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":17,"beg":{"line":2704,"col":65},"end":{"line":2704,"col":81}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"reduce","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["reduce",0]}],"span":{"data":{"file_id":17,"beg":{"line":2701,"col":4},"end":{"line":2704,"col":82}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Reduces the elements to a single one, by repeatedly applying a reducing"},{"DocComment":" operation."},{"DocComment":""},{"DocComment":" If the iterator is empty, returns [`None`]; otherwise, returns the"},{"DocComment":" result of the reduction."},{"DocComment":""},{"DocComment":" The reducing function is a closure with two arguments: an 'accumulator', and an element."},{"DocComment":" For iterators with at least one element, this is the same as [`fold()`]"},{"DocComment":" with the first element of the iterator as the initial accumulator value, folding"},{"DocComment":" every subsequent element into it."},{"DocComment":""},{"DocComment":" [`fold()`]: Iterator::fold"},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let reduced: i32 = (1..10).reduce(|acc, e| acc + e).unwrap_or(0);"},{"DocComment":" assert_eq!(reduced, 45);"},{"DocComment":""},{"DocComment":" // Which is equivalent to doing it with `fold`:"},{"DocComment":" let folded: i32 = (1..10).fold(0, |acc, e| acc + e);"},{"DocComment":" assert_eq!(reduced, folded);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":2273}],"output":{"Deduplicated":31705}},"default":{"id":45,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"Deduplicated":32438},{"HashConsedValue":[32024,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":32023},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":3359},{"Deduplicated":3603}]}}},"kind":{"TraitMethod":[1,39]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"R"},{"index":1,"name":"T2"},{"index":2,"name":"Clause1_TryType"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":2778,"col":11},"end":{"line":2778,"col":91}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":17,"beg":{"line":2778,"col":54},"end":{"line":2778,"col":90}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"HashConsedValue":[3914,{"TraitType":[{"HashConsedValue":[3913,{"kind":{"Clause":{"Bound":[1,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"HashConsedValue":[2349,{"TypeVar":{"Bound":[2,0]}}]}],"const_generics":[],"trait_refs":[]}}}}]},1,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}]},{"Deduplicated":31705},{"Deduplicated":3259}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":17,"beg":{"line":2774,"col":16},"end":{"line":2774,"col":58}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2876},{"Deduplicated":32023},{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"data":{"file_id":17,"beg":{"line":2774,"col":61},"end":{"line":2774,"col":77}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":4,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":5,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[{"regions":[],"skip_binder":{"trait_ref":{"Deduplicated":3913},"type_id":0,"ty":{"Deduplicated":31699}}}]},"skip_binder":{"name":"try_reduce","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["try_reduce",0]}],"span":{"data":{"file_id":17,"beg":{"line":2772,"col":4},"end":{"line":2778,"col":92}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Reduces the elements to a single one by repeatedly applying a reducing operation. If the"},{"DocComment":" closure returns a failure, the failure is propagated back to the caller immediately."},{"DocComment":""},{"DocComment":" The return type of this method depends on the return type of the closure. If the closure"},{"DocComment":" returns `Result<Self::Item, E>`, then this function will return `Result<Option<Self::Item>,"},{"DocComment":" E>`. If the closure returns `Option<Self::Item>`, then this function will return"},{"DocComment":" `Option<Option<Self::Item>>`."},{"DocComment":""},{"DocComment":" When called on an empty iterator, this function will return either `Some(None)` or"},{"DocComment":" `Ok(None)` depending on the type of the provided closure."},{"DocComment":""},{"DocComment":" For iterators with at least one element, this is essentially the same as calling"},{"DocComment":" [`try_fold()`] with the first element of the iterator as the initial accumulator value."},{"DocComment":""},{"DocComment":" [`try_fold()`]: Iterator::try_fold"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Safely calculate the sum of a series of numbers:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_reduce)]"},{"DocComment":""},{"DocComment":" let numbers: Vec<usize> = vec![10, 20, 5, 23, 0];"},{"DocComment":" let sum = numbers.into_iter().try_reduce(|x, y| x.checked_add(y));"},{"DocComment":" assert_eq!(sum, Some(Some(58)));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Determine when a reduction short circuited:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_reduce)]"},{"DocComment":""},{"DocComment":" let numbers = vec![1, 2, 3, usize::MAX, 4, 5];"},{"DocComment":" let sum = numbers.into_iter().try_reduce(|x, y| x.checked_add(y));"},{"DocComment":" assert_eq!(sum, None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Determine when a reduction was not performed because there are no elements:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_reduce)]"},{"DocComment":""},{"DocComment":" let numbers: Vec<usize> = Vec::new();"},{"DocComment":" let sum = numbers.into_iter().try_reduce(|x, y| x.checked_add(y));"},{"DocComment":" assert_eq!(sum, Some(None));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Use a [`Result`] instead of an [`Option`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_reduce)]"},{"DocComment":""},{"DocComment":" let numbers = vec![\"1\", \"2\", \"3\", \"4\", \"5\"];"},{"DocComment":" let max: Result<Option<_>, <usize as std::str::FromStr>::Err> ="},{"DocComment":"     numbers.into_iter().try_reduce(|x, y| {"},{"DocComment":"         if x.parse::<usize>()? > y.parse::<usize>()? { Ok(x) } else { Ok(y) }"},{"DocComment":"     });"},{"DocComment":" assert_eq!(max, Ok(Some(\"5\")));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":32433},{"Deduplicated":2886}],"output":{"Deduplicated":3272}},"default":{"id":46,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":2886},{"Deduplicated":31699},{"Deduplicated":3272}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[3920,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[32025,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":3914},{"Deduplicated":31705},{"Deduplicated":3259}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[32026,{"kind":{"Clause":{"Bound":[0,2]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2876},{"Deduplicated":32023},{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":3360},{"HashConsedValue":[3922,{"kind":{"Clause":{"Bound":[0,4]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[3923,{"kind":{"Clause":{"Bound":[0,5]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2876}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[1,40]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":2834,"col":11},"end":{"line":2834,"col":36}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":31992},{"Deduplicated":1672}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"all","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["all",0]}],"span":{"data":{"file_id":17,"beg":{"line":2831,"col":4},"end":{"line":2834,"col":37}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Tests if every element of the iterator matches a predicate."},{"DocComment":""},{"DocComment":" `all()` takes a closure that returns `true` or `false`. It applies"},{"DocComment":" this closure to each element of the iterator, and if they all return"},{"DocComment":" `true`, then so does `all()`. If any of them return `false`, it"},{"DocComment":" returns `false`."},{"DocComment":""},{"DocComment":" `all()` is short-circuiting; in other words, it will stop processing"},{"DocComment":" as soon as it finds a `false`, given that no matter what else happens,"},{"DocComment":" the result will also be `false`."},{"DocComment":""},{"DocComment":" An empty iterator returns `true`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert!(a.into_iter().all(|x| x > 0));"},{"DocComment":""},{"DocComment":" assert!(!a.into_iter().all(|x| x > 2));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `false`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert!(!iter.all(|x| x != 2));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":32433},{"Deduplicated":2273}],"output":{"Deduplicated":1672}},"default":{"id":47,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"Deduplicated":32018},{"Deduplicated":2346}]}}},"kind":{"TraitMethod":[1,41]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":2888,"col":11},"end":{"line":2888,"col":36}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplicated":31992},{"Deduplicated":1672}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2272}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"any","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["any",0]}],"span":{"data":{"file_id":17,"beg":{"line":2885,"col":4},"end":{"line":2888,"col":37}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Tests if any element of the iterator matches a predicate."},{"DocComment":""},{"DocComment":" `any()` takes a closure that returns `true` or `false`. It applies"},{"DocComment":" this closure to each element of the iterator, and if any of them return"},{"DocComment":" `true`, then so does `any()`. If they all return `false`, it"},{"DocComment":" returns `false`."},{"DocComment":""},{"DocComment":" `any()` is short-circuiting; in other words, it will stop processing"},{"DocComment":" as soon as it finds a `true`, given that no matter what else happens,"},{"DocComment":" the result will also be `true`."},{"DocComment":""},{"DocComment":" An empty iterator returns `false`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert!(a.into_iter().any(|x| x > 0));"},{"DocComment":""},{"DocComment":" assert!(!a.into_iter().any(|x| x > 5));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `true`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert!(iter.any(|x| x != 2));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":32433},{"Deduplicated":2273}],"output":{"Deduplicated":1672}},"default":{"id":48,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":31699}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"Deduplicated":32018},{"Deduplicated":2346}]}}},"kind":{"TraitMethod":[1,42]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"P"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":2962,"col":11},"end":{"line":2962,"col":37}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2272},{"Deduplica