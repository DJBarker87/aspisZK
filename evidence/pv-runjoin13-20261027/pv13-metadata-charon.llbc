mment":" [`is_partitioned()`]: Iterator::is_partitioned"},{"DocComment":" [`partition()`]: Iterator::partition"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_partition_in_place)]"},{"DocComment":""},{"DocComment":" let mut a = [1, 2, 3, 4, 5, 6, 7];"},{"DocComment":""},{"DocComment":" // Partition in-place between evens and odds"},{"DocComment":" let i = a.iter_mut().partition_in_place(|n| n % 2 == 0);"},{"DocComment":""},{"DocComment":" assert_eq!(i, 3);"},{"DocComment":" assert!(a[..i].iter().all(|n| n % 2 == 0)); // evens"},{"DocComment":" assert!(a[i..].iter().all(|n| n % 2 == 1)); // odds"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":31698},{"Deduplicated":2886}],"output":{"Deduplicated":1670}},"default":{"id":40,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":31698},{"Deduplicated":2273},{"Deduplicated":2886},{"Deduplicated":3272}],"const_generics":[],"trait_refs":[{"Deduplicated":32437},{"HashConsedValue":[32459,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":31698},{"Deduplicated":3259}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[24939,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2876},{"Deduplicated":3715},{"Deduplicated":1672}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":3359},{"Deduplicated":3360}]}}},"kind":{"TraitMethod":[1,34]}},{"params":{"regions":[],"types":[{"index":0,"name":"P"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":17,"beg":{"line":2395,"col":11},"end":{"line":2395,"col":36}},"genera