},{"DocComment":" The return type of this method depends on the return type of the closure."},{"DocComment":" If you return `Result<bool, E>` from the closure, you'll get a `Result<Option<Self::Item>, E>`."},{"DocComment":" If you return `Option<bool>` from the closure, you'll get an `Option<Option<Self::Item>>`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(try_find)]"},{"DocComment":""},{"DocComment":" let a = [\"1\", \"2\", \"lol\", \"NaN\", \"5\"];"},{"DocComment":""},{"DocComment":" let is_my_num = |s: &str, search: i32| -> Result<bool, std::num::ParseIntError> {"},{"DocComment":"     Ok(s.parse::<i32>()? == search)"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" let result = a.into_iter().try_find(|&s| is_my_num(s, 2));"},{"DocComment":" assert_eq!(result, Ok(Some(\"2\")));"},{"DocComment":""},{"DocComment":" let result = a.into_iter().try_find(|&s| is_my_num(s, 5));"},{"DocComment":" assert!(result.is_err());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This also supports other types which implement [`Try`], not just [`Result`]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(try_find)]"},{"DocComment":""},{"DocComment":" use std::num::NonZero;"},{"DocComment":""},{"DocComment":" let a = [3, 5, 7, 4, 9, 0, 11u32];"},{"DocComment":" let result = a.into_iter().try_find(|&x| NonZero::new(x).map(|y| y.is_power_of_two()));"},{"DocComment":" assert_eq!(result, Some(Some(4)));"},{"DocComment":" let result = a.into_iter().take(3).try_find(|&x| NonZero::new(x).map(|y| y.is_power_of_two()));"},{"DocComment":" assert_eq!(result, Some(None));"},{"DocComment":" let result = a.into_iter().rev().try_find(|&x| NonZero::new(x).map(|y| y.is_power_of_two()));"},{"DocComment":" assert_eq!(result, None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"nam