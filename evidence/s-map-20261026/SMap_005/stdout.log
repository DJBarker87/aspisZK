@AspisR1.SAP_SaveOnRun.saved : ∀ {C Hash : Type} (ops : AspisR1CurrentCaller.Ops) (reserved : Bool)
  (query : AspisR1.Port3_NativeQueryBody.Ops) (geo : AspisR1.Port3_NativeGeometryBody.Ops C)
  (B : AspisR1PublicPreparation.FinishModel.Boundaries) (std : AspisR1.ClaimsUnrolledFinish.StdCalls)
  (D : AspisR1CurrentCaller.aspis_core.digest.Digest32 Hash) (hash : Hash)
  (semantic : AspisR1CurrentCaller.aspis_statement.pool_v1.pair_forest_semantic_terminal.r0.Public)
  (pub proof : Aeneas.Std.Slice Aeneas.Std.U8) (split : Aeneas.Std.Usize)
  (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
  (run :
    AspisR1.Tx1Q_Execution.Run
      (AspisR1.Tx1Q_Execution.actual ops reserved query geo (AspisR1.F3M_CircleSource.install B) std) reserved query geo
      D hash semantic pub proof split saved),
  AspisR1.Port5Q1_QueryPorts.SessionAPrimitives query →
    ∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      AspisR1.CheckpointBytes5Inputs.Oracle (AspisR1.VTop_Checkpoint.digest (AspisR1.Tx1Q_Install.digest D)) hash H →
        ∀ (out : AspisR1PublicPreparation.verifier.Prepared),
          AspisR1CurrentCaller.InstalledPreparation.currentPrepared out = run.p →
            saved =
              AspisR1.Tx2N_Reader.writer H (AspisR1.MultiproofConeCanonical.bytesOf ↑proof)
                (AspisR1.MultiproofConeCanonical.bytesOf ↑pub) (AspisR1.F3L_SourcePrepared.numeric out)
                (AspisR1.CheckpointBytes5Output.accumulator
                  (AspisR1.Tx1Q_Carriers.accumulator
                    (have __src := run.out;
                    { weights := ⟨↑run.flushed, ⋯⟩, rhs := __src.rhs, power := __src.power, next := __src.next })))
'AspisR1.SAP_SaveOnRun.saved' depends on axioms: [propext, Classical.choice, Quot.sound]
