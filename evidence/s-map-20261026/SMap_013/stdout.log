AspisR1.P6C_Extension.boundary : ∀ (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (sha256 H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  AspisR1.S2W_ExtractionBoundary.P1 sha256 H →
    AspisR1.S2W_ExtractionBoundary.RuntimeSyscall hashv sha256 →
      AspisR1.MultiproofConeP6Frozen2Stage.P6Boundary (AspisR1.P6C_Extension.dictionary hashv H) () H
        AspisR1.Op5T_P6.parent AspisR1.Op5T_P6.parent AspisR1.Op5T_P6.parent AspisR1.MultiproofConeP6Batch.referenceLeaf
'AspisR1.P6C_Extension.boundary' depends on axioms: [propext, Classical.choice, Quot.sound]
AspisR1.P6C_Extension.source_preserved : ∀
  (hashv : AspisR1.SdkC_Source.Parts → Aeneas.Std.Result AspisR1.SdkC_Source.Digest)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) {A : Type} (code : AspisR1.SdkC_Source.Code A)
  (before : AspisR1.SdkC_Source.Log) (value : A),
  (AspisR1.SdkC_Source.run hashv code before).1 = Aeneas.Std.Result.ok value →
    AspisR1.SdkC_Source.run (fun parts => Aeneas.Std.Result.ok (AspisR1.P6C_Extension.total hashv H parts)) code
        before =
      AspisR1.SdkC_Source.run hashv code before
'AspisR1.P6C_Extension.source_preserved' depends on axioms: [propext, Classical.choice, Quot.sound]
