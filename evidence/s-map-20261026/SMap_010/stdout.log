@AspisR1.Rc4_Cont.strengthen : ∀ {F C : Type} (adapterOps : AdapterRw.Ops) (ops : AspisR1CurrentCaller.Ops)
  (stageBase : VTop_Stages.Ops) (finishOps : AspisR1Stage2.Stage2Finish.FinishOps F) (reserved : Bool)
  (queryOps : AspisR1.Port3_NativeQueryBody.Ops) (geoOps : AspisR1.Port3_NativeGeometryBody.Ops C)
  (B : AspisR1PublicPreparation.FinishModel.Boundaries) (claimsStd : AspisR1.ClaimsUnrolledFinish.StdCalls)
  (prior : AspisV8R19.MemoizedProgramLaw.Program AspisV8R19.DuplexFrames.Bytes AspisV8R19.SourceDuplexStep.State Unit)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State) (f : AspisR1.S2W_NativeConsolidation.FirstCut)
  (s : AspisR1.S2W_NativeConsolidation.SecondCut) (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8)
  (run :
    AspisR1.Tx1Q_Execution.Run
      (AspisR1.Tx1Q_Execution.actual (AspisR1.Op5T_Concrete.current ops) reserved queryOps geoOps
        (AspisR1.F3M_CircleSource.install B) claimsStd)
      reserved queryOps geoOps
      (AspisR1.SdkD_PairBatches.current adapterOps ops stageBase finishOps reserved queryOps geoOps
        (AspisR1.F3M_CircleSource.install B) claimsStd)
      () (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.pub f.proof f.split saved)
  (tx2 : AspisR1.Cons_Native.Witness) (indexError : C) (queryBase : AspisR1.Port3_NativeQueryBody.Ops)
  (geoBase : AspisR1.Port3_NativeGeometryBody.Ops C),
  queryOps = AspisR1.SAQ_Decoder.install queryBase →
    geoOps = AspisR1.SAQ_Constructor.install indexError geoBase →
      AspisR1.SAP_LiteralCont.Outcome adapterOps ops stageBase finishOps reserved queryOps geoOps B claimsStd prior H f
          s saved run tx2 →
        AspisR1.Rc4_Cont.Outcome adapterOps ops stageBase finishOps reserved queryOps geoOps B claimsStd prior H f s
          saved run tx2
'AspisR1.Rc4_Cont.strengthen' depends on axioms: [propext, Classical.choice, Quot.sound]
@AspisR1.Rc4_Literal.strengthen : ∀ {CoreError : Type} (adapter : AdapterRw.Ops) (ops : AspisR1CurrentCaller.Ops)
  (reserved : Bool) (query : AspisR1.Port3_NativeQueryBody.Ops) (geo : AspisR1.Port3_NativeGeometryBody.Ops CoreError)
  (stage : VTop_Stages.Ops) {F : Type} (finish : AspisR1Stage2.Stage2Finish.FinishOps F)
  (B : AspisR1PublicPreparation.FinishModel.Boundaries) (std : AspisR1.ClaimsUnrolledFinish.StdCalls)
  (saved : Aeneas.Std.alloc.vec.Vec Aeneas.Std.U8) (f : AspisR1.S2W_NativeConsolidation.FirstCut)
  (s : AspisR1.S2W_NativeConsolidation.SecondCut)
  (run :
    AspisR1.Tx1Q_Execution.Run
      (AspisR1.Tx1Q_Execution.actual (AspisR1.Op5T_Concrete.current ops) reserved query geo
        (AspisR1.F3M_CircleSource.install B) std)
      reserved query geo
      (AspisR1.SdkD_PairBatches.current adapter ops stage finish reserved query geo (AspisR1.F3M_CircleSource.install B)
        std)
      () (AspisS6CurrentVerifierCarrier.toPublic f.semantic) f.pub f.proof f.split saved)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (trace : List (AspisV8R19.DuplexFrames.Bytes × AspisV8R19.SourceDuplexStep.State))
  (authParsed : AspisR1.OraclePortCompactDraft.Parsed) (tx2 : AspisR1.Cons_Native.Witness) (indexError : CoreError)
