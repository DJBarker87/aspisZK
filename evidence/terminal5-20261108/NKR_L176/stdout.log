theorem AspisR1.NKR_SumCopyAssociation.source : ∀ (lookup : Lookups),
  Keys →
    ∀ (domain : NKR_SumTagPermutation.Domain),
      NKR_SumTagPermutation.Cut →
        NKR_SumTagAssociation.Cut domain →
          ∀ (s : Selectors) (terms : Std.Array NQ 14#usize) (append : U64)
            (variant : PoolV1PairForestCompiledVariantV1),
            FIw_ArrayValue.canonical s.high →
              FIw_ArrayValue.canonical s.low →
                FIw_ArrayValue.canonical terms →
                  ∃ scratch outValues outWeights,
                    NJB_StateUpdates.run (fun i state => NKR_SumCopyCollect.step lookup append variant s i state)
                          (List.finRange 136) NKR_SumCopyInvocation.zero =
                        ok scratch ∧
                      NKR_SumFinishInvocation.reference (NJB_ArrayCarrier.array scratch) s terms =
                          ok (outValues, outWeights) ∧
                        FIw_ArrayValue.canonical outValues ∧
                          FIw_ArrayValue.canonical outWeights ∧
                            (∀ (g : Fin ↑4#usize),
                                decode (NJB_ArrayCarrier.cell outValues g) =
                                  NKR_SumLegacyRows.values (FJk_CopyFullFold.model s terms append variant) g) ∧
                              ∀ (g : Fin ↑4#usize),
                                decode (NJB_ArrayCarrier.cell outWeights g) =
                                  NKR_SumLegacyRows.weights (FJk_CopyFullFold.model s terms append variant) g :=
fun lookup keys domain permutation metadata s terms append variant hh hl ht =>
  let ⟨scratch, h✝⟩ :=
    NKR_SumScratchCoordinates.source lookup append variant s (List.finRange 136) NKR_SumCopyInvocation.zero hh fun x =>
      FIv_NativeValue.zero.left
  let ⟨call, right✝⟩ := h✝
  let ⟨cs, right✝¹⟩ := right✝
  let ⟨weightCoordinates, patternCoordinates⟩ := right✝¹
  have hw := fun c =>
    have h := weightCoordinates c;
    id
      (fun h =>
        Eq.mpr
          (id
            (congrArg (Eq (decode (scratch (NJL_EndpointIndices.weight c))))
              (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                congr
                  (congrArg HAdd.hAdd
                    (ite_congr legacy_values._simp_5
                      (fun a =>
                        Eq.refl
                          (decode (NJL_EndpointLookup.high s x false (lookup x false)) *
                            NKR_SumCollectMeaning.weight x append variant))
                      fun a => Eq.refl 0))
                  (ite_congr legacy_values._simp_5
                    (fun a =>
                      Eq.refl
                        (decode (NJL_EndpointLookup.high s x true (lookup x true)) *
                          NKR_SumCollectMeaning.weight x append variant))
                    fun a => Eq.refl 0))))
          (Eq.mp
            (congrArg (fun _a => decode (scratch (NJL_EndpointIndices.weight c)) = _a)
              (sum_finRange fun i =>
                (if c = NJL_EndpointLookup.groupIndex i false (lookup i false) then
                    decode (NJL_EndpointLookup.high s i false (lookup i false)) *
                      NKR_SumCollectMeaning.weight i append variant
                  else 0) +
                  if c = NJL_EndpointLookup.groupIndex i true (lookup i true) then
                    decode (NJL_EndpointLookup.high s i true (lookup i true)) *
                      NKR_SumCollectMeaning.weight i append variant
                  else 0))
            (Eq.mp
              (congrArg (fun _a => decode (scratch (NJL_EndpointIndices.weight c)) = _a)
                (zero_add
                  (List.map
                      (fun i =>
                        (if c = NJL_EndpointLookup.groupIndex i false (lookup i false) then
                            decode (NJL_EndpointLookup.high s i false (lookup i false)) *
                              NKR_SumCollectMeaning.weight i append variant
                          else 0) +
                          if c = NJL_EndpointLookup.groupIndex i true (lookup i true) then
                            decode (NJL_EndpointLookup.high s i true (lookup i true)) *
                              NKR_SumCollectMeaning.weight i append variant
                          else 0)
                      (List.finRange 136)).sum))
              (Eq.mp
                (congrArg
                  (fun _a =>
                    decode (scratch (NJL_EndpointIndices.weight c)) =
                      _a +
                        (List.map
                            (fun i =>
                              (if c = NJL_EndpointLookup.groupIndex i false (lookup i false) then
                                  decode (NJL_EndpointLookup.high s i false (lookup i false)) *
                                    NKR_SumCollectMeaning.weight i append variant
                                else 0) +
                                if c = NJL_EndpointLookup.groupIndex i true (lookup i true) then
                                  decode (NJL_EndpointLookup.high s i true (lookup i true)) *
                                    NKR_SumCollectMeaning.weight i append variant
                                else 0)
                            (List.finRange 136)).sum)
                  FIv_NativeValue.zero.right)
                h))))
      h;
  have hp := fun c =>
    have h := patternCoordinates c;
    id
      (fun h =>
        Eq.mpr
          (id
            (congrArg (Eq (decode (scratch (NJL_EndpointIndices.pattern c))))
              (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                congr
                  (congrArg HAdd.hAdd
                    (ite_congr legacy_values._simp_5
                      (fun a => Eq.refl (decode (NJL_EndpointLookup.high s x false (lookup x false)))) fun a =>
                      Eq.refl 0))
                  (ite_congr legacy_values._simp_5
                    (fun a => Eq.refl (decode (NJL_EndpointLookup.high s x true (lookup x true)))) fun a =>
                    Eq.refl 0))))
          (Eq.mp
            (congrArg (fun _a => decode (scratch (NJL_EndpointIndices.pattern c)) = _a)
              (sum_finRange fun i =>
                (if c = NJL_EndpointLookup.patternIndex i false (lookup i false) then
