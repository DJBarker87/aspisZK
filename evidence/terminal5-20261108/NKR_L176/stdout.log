                  else 0) +
                  if c = NJL_EndpointLookup.patternIndex i true (lookup i true) then
                    decode (NJL_EndpointLookup.high s i true (lookup i true))
                  else 0))
            (Eq.mp
              (congrArg (fun _a => decode (scratch (NJL_EndpointIndices.pattern c)) = _a)
                (zero_add
                  (List.map
                      (fun i =>
                        (if c = NJL_EndpointLookup.patternIndex i false (lookup i false) then
                            decode (NJL_EndpointLookup.high s i false (lookup i false))
                          else 0) +
                          if c = NJL_EndpointLookup.patternIndex i true (lookup i true) then
                            decode (NJL_EndpointLookup.high s i true (lookup i true))
                          else 0)
                      (List.finRange 136)).sum))
              (Eq.mp
                (congrArg
                  (fun _a =>
                    decode (scratch (NJL_EndpointIndices.pattern c)) =
                      _a +
                        (List.map
                            (fun i =>
                              (if c = NJL_EndpointLookup.patternIndex i false (lookup i false) then
                                  decode (NJL_EndpointLookup.high s i false (lookup i false))
                                else 0) +
                                if c = NJL_EndpointLookup.patternIndex i true (lookup i true) then
                                  decode (NJL_EndpointLookup.high s i true (lookup i true))
                                else 0)
                            (List.finRange 136)).sum)
                  FIv_NativeValue.zero.right)
                h))))
      h;
  let ⟨values, h✝¹⟩ :=
    NKR_SumFinishCohort.source (NJB_ArrayCarrier.array scratch) s terms (NJB_ArrayCarrier.canonical_array scratch cs) hh
      hl ht
  let ⟨weights, h✝²⟩ := h✝¹
  let ⟨finishCall, right✝²⟩ := h✝²
  let ⟨cv, right✝³⟩ := right✝²
  let ⟨cw, right✝⁴⟩ := right✝³
  let ⟨vv, vw⟩ := right✝⁴
  have eq := rows lookup keys domain permutation metadata s scratch terms append variant hw hp;
  Exists.intro scratch
    (Exists.intro values
      (Exists.intro weights
        ⟨call,
          ⟨finishCall, ⟨cv, ⟨cw, ⟨fun g => Eq.trans (vv g) (eq.left g), fun g => Eq.trans (vw g) (eq.right g)⟩⟩⟩⟩⟩))
