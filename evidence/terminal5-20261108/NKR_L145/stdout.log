theorem AspisR1.NKR_SumCopyTail.source : ∀ (s : Selectors) (values weights : Std.Array NQ 4#usize) (helper chi : NQ),
  FIw_ArrayValue.canonical s.high →
    FIw_ArrayValue.canonical s.low →
      FIw_ArrayValue.canonical values →
        FIw_ArrayValue.canonical weights →
          Canon helper →
            Canon chi →
              ∃ active residual scaled,
                s.active = ok active ∧
                  Canon active ∧
                    copy_residual (row values weights) helper chi = ok residual ∧
                      Canon residual ∧
                        active.mul residual = ok scaled ∧
                          Canon scaled ∧
                            reference s values weights helper chi = ok { residual := scaled, active := active } ∧
                              decode residual =
                                  FIw_CopyMeaning.residual (row values weights) (decode helper) (decode chi) ∧
                                decode scaled =
                                  decode active *
                                    FIw_CopyMeaning.residual (row values weights) (decode helper) (decode chi) :=
fun s values weights helper chi hh hl hv hw hhelper hchi =>
  let ⟨w✝, h✝⟩ := NJL_ActiveInvocation.source s hh hl
  let ⟨active, h✝¹⟩ := h✝
  let ⟨left✝, right✝⟩ := h✝¹
  let ⟨left✝¹, right✝¹⟩ := right✝
  let ⟨ca, right✝²⟩ := right✝¹
  let ⟨left✝², acall⟩ := right✝²
  let ⟨cpv, right✝³⟩ := row_canonical values weights hv hw
  let ⟨cpw, right✝⁴⟩ := right✝³
  let ⟨ccv, ccw⟩ := right✝⁴
  let ⟨residual, h✝²⟩ := NJB_CopyResidual.result (row values weights) helper chi cpv ccv cpw ccw hhelper hchi
  let ⟨rcall, right✝⁵⟩ := h✝²
  let ⟨cr, vr⟩ := right✝⁵
  let ⟨scaled, h✝³⟩ := NJB_StubLaws.qm_mul active residual ca cr
  let ⟨mcall, right✝⁶⟩ := h✝³
  let ⟨cs, vs⟩ := right✝⁶
  Exists.intro active
    (Exists.intro residual
      (Exists.intro scaled
        ⟨acall,
          ⟨ca,
            ⟨rcall,
              ⟨cr,
                ⟨mcall,
                  ⟨cs,
                    ⟨of_eq_true
                        (Eq.trans
                          (congrFun'
                            (congrArg Eq
                              (Eq.trans
                                (Eq.trans
                                  (congr (congrArg Bind.bind acall)
                                    (funext fun active =>
                                      Eq.trans
                                        (congrFun' (congrArg Bind.bind rcall) fun residual => do
                                          let scaled ← active.mul residual
                                          ok { residual := scaled, active := active })
                                        (bind_tc_ok residual fun y => do
                                          let scaled ← active.mul y
                                          ok { residual := scaled, active := active })))
                                  (bind_tc_ok active fun y => do
                                    let scaled ← y.mul residual
                                    ok { residual := scaled, active := y }))
                                (Eq.trans
                                  (congrFun' (congrArg Bind.bind mcall) fun scaled =>
                                    ok { residual := scaled, active := active })
                                  (bind_tc_ok scaled fun y => ok { residual := y, active := active }))))
                            (ok { residual := scaled, active := active }))
                          (eq_self (ok { residual := scaled, active := active }))),
                      ⟨vr,
                        Eq.mpr
                          (id
                            (congrArg
                              (fun _a =>
                                _a =
                                  decode active *
                                    FIw_CopyMeaning.residual (row values weights) (decode helper) (decode chi))
                              vs))
                          (Eq.mpr
                            (id
                              (congrArg
                                (fun _a =>
                                  decode active * _a =
                                    decode active *
                                      FIw_CopyMeaning.residual (row values weights) (decode helper) (decode chi))
                                vr))
                            (Eq.refl
                              (decode active *
                                FIw_CopyMeaning.residual (row values weights) (decode helper) (decode chi))))⟩⟩⟩⟩⟩⟩⟩⟩))
