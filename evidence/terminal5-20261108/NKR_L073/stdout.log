                    (Eq.mpr (id (congrArg (fun _a => ⋯ = ⋯) oc))
                      (Eq.mpr (id (congrArg (fun _a => ⋯) (bind_tc_ok occupancy.after ⋯)))
                        (Eq.mpr (id (congrArg ⋯ dc)) (Eq.mpr (id ⋯) (Eq.mpr ⋯ ⋯)))))))))))))
