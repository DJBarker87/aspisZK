theorem AspisR1.NKR_SumCopyInvocation.source : ∀ (lookup : Lookups) (s : Selectors) (openings : Std.Array NQ 16#usize)
  (helper lambda chi : NQ) (append : U64) (variant : PoolV1PairForestCompiledVariantV1),
  FIw_ArrayValue.canonical s.high →
    FIw_ArrayValue.canonical s.low →
      FIw_ArrayValue.canonical openings →
        Canon helper →
          Canon lambda →
            Canon chi →
              ∃ patterns scratch values weights active residual scaled,
                pattern_values openings lambda = ok patterns ∧
                  NJB_StateUpdates.run (fun i state => NKR_SumCopyCollect.step lookup append variant s i state)
                        (List.finRange 136) zero =
                      ok scratch ∧
                    NKR_SumCopyCollect.Trace lookup append variant s (List.finRange 136) zero scratch ∧
                      NKR_SumFinishInvocation.reference (NJB_ArrayCarrier.array scratch) s patterns =
                          ok (values, weights) ∧
                        NKR_SumCopyTail.reference s values weights helper chi =
                            ok { residual := scaled, active := active } ∧
                          reference lookup s openings helper lambda chi append variant =
                              ok { residual := scaled, active := active } ∧
                            Canon active ∧
                              Canon residual ∧
                                Canon scaled ∧
                                  copy_residual (NKR_SumCopyTail.row values weights) helper chi = ok residual ∧
                                    decode scaled =
                                      decode active *
                                        FIw_CopyMeaning.residual (NKR_SumCopyTail.row values weights) (decode helper)
                                          (decode chi) :=
fun lookup s openings helper lambda chi append variant hh hl ho hhelper hlambda hchi =>
  let ⟨w✝, h✝⟩ := NJX_PatternRoot.source lambda openings hlambda ho
  let ⟨w✝¹, h✝¹⟩ := h✝
  let ⟨patterns, h✝²⟩ := h✝¹
  let ⟨left✝, right✝⟩ := h✝²
  let ⟨left✝¹, right✝¹⟩ := right✝
  let ⟨left✝², right✝²⟩ := right✝¹
  let ⟨left✝³, right✝³⟩ := right✝²
  let ⟨left✝⁴, right✝⁴⟩ := right✝³
  let ⟨cp, patternCall⟩ := right✝⁴
  let ⟨scratch, h✝³⟩ :=
    NKR_SumCopyCollect.source lookup append variant s (List.finRange 136) zero hh fun x => FIv_NativeValue.zero.left
  let ⟨scratchCall, right✝⁵⟩ := h✝³
  let ⟨scratchTrace, cs⟩ := right✝⁵
  let ⟨dot, h✝⁴⟩ :=
    NKR_SumFinishInvocation.source (NJB_ArrayCarrier.array scratch) s patterns
      (NJB_ArrayCarrier.canonical_array scratch cs) hh hl cp
  let ⟨coefficients, h✝⁵⟩ := h✝⁴
  let ⟨finished, h✝⁶⟩ := h✝⁵
  let ⟨left✝⁵, right✝⁶⟩ := h✝⁶
  let ⟨left✝⁶, right✝⁷⟩ := right✝⁶
  let ⟨left✝⁷, right✝⁸⟩ := right✝⁷
  let ⟨left✝⁸, right✝⁹⟩ := right✝⁸
  let ⟨left✝⁹, right✝¹⁰⟩ := right✝⁹
  let ⟨left✝¹⁰, right✝¹¹⟩ := right✝¹⁰
  let ⟨left✝¹¹, right✝¹²⟩ := right✝¹¹
  let ⟨finishCall, right✝¹³⟩ := right✝¹²
  let ⟨left✝¹², right✝¹⁴⟩ := right✝¹³
  let ⟨left✝¹³, right✝¹⁵⟩ := right✝¹⁴
  let ⟨left✝¹⁴, right✝¹⁶⟩ := right✝¹⁵
  let ⟨cf, right✝¹⁷⟩ := right✝¹⁶
  let ⟨cw, right✝¹⁸⟩ := right✝¹⁷
  let values := NJB_ArrayCarrier.array finished;
  let weights := NJB_ArrayCarrier.array dot.2;
  let ⟨active, h✝⁷⟩ :=
    NKR_SumCopyTail.source s values weights helper chi hh hl (NJB_ArrayCarrier.canonical_array finished cf)
      (NJB_ArrayCarrier.canonical_array dot.2 cw) hhelper hchi
  let ⟨residual, h✝⁸⟩ := h✝⁷
  let ⟨scaled, h✝⁹⟩ := h✝⁸
  let ⟨acall, right✝¹⁹⟩ := h✝⁹
  let ⟨ca, right✝²⁰⟩ := right✝¹⁹
  let ⟨rcall, right✝²¹⟩ := right✝²⁰
  let ⟨cr, right✝²²⟩ := right✝²¹
  let ⟨mcall, right✝²³⟩ := right✝²²
  let ⟨cm, right✝²⁴⟩ := right✝²³
  let ⟨tailCall, right✝²⁵⟩ := right✝²⁴
  let ⟨vr, vs⟩ := right✝²⁵
  Exists.intro patterns
    (Exists.intro scratch
      (Exists.intro values
        (Exists.intro weights
          (Exists.intro active (Exists.intro residual (Exists.intro scaled ⟨patternCall, ⟨scratchCall, ⋯⟩⟩))))))
'AspisR1.NKR_SumCopyInvocation.source' depends on axioms: [propext, Classical.choice, Quot.sound]
