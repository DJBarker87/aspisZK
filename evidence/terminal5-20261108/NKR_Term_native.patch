+fn NKR_terminal_error_prefix_cut(){
+ let which:bool=kani::any();let error=if which{PoolV1PairForestSemanticTerminalErrorV1::InvalidPublicAmount}else{PoolV1PairForestSemanticTerminalErrorV1::InvalidAppendTransition};
+ let mut l=NKR_TermLog{calls:0,seek:0,kind:255,left:QM31::ZERO,right:QM31::ZERO,eq_pick:0,eq_limb:0,eq_left:0,eq_right:0,replies:[QM31::ZERO;9]};
+ let out=NKR_term_suffix(Err(error),&[QM31::ZERO;10],&[QM31::ZERO;10],QM31::ZERO,&mut l);
+ assert_eq!(l.calls,0);match out{Err(actual)=>assert_eq!(actual,if cfg!(NKR_invert){if which{PoolV1PairForestSemanticTerminalErrorV1::InvalidAppendTransition}else{PoolV1PairForestSemanticTerminalErrorV1::InvalidPublicAmount}}else{error}),Ok(_)=>assert!(false)}
