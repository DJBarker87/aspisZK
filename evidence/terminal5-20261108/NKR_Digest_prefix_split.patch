+fn NKR_Digest_pstep_words(q:QM31)->[u32;4]{[q.c0.a.0,q.c0.b.0,q.c1.a.0,q.c1.b.0]}
+struct NKR_Digest_pstep_Log{calls:usize,di:usize,oi:usize,kind:u8,high:QM31,opened:[u32;4],present:bool,digest:u32,reply:[QM31;2],adds:[QM31;2],kinds:[u8;2],left:[QM31;2],right:[QM31;2]}
