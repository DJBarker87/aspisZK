+fn NKR_Digest_pstep_recipient(d:Option<Digest>,o:[QM31;16],high:QM31,l:&mut NKR_Digest_pstep_Log)->[QM31;2]{l.calls+=1;l.kind=12;l.high=high;l.opened=NKR_Digest_pstep_words(o[l.oi]);l.present=d.is_some();l.digest=d.map_or(0,|x|x[l.di].0);l.reply}
+fn NKR_Digest_pstep_add(a:QM31,b:QM31,l:&mut NKR_Digest_pstep_Log)->QM31{let i=l.calls-1;l.kinds[i]=1;l.left[i]=a;l.right[i]=b;l.calls+=1;l.adds[i]}
+fn NKR_Digest_prefix_step(public:SemanticPublic<'_>,openings:&StateOnlyPoseidonOpenings,selectors:&Selectors,which:usize,mut local_sums:[[QM31;2];3],l:&mut NKR_Digest_pstep_Log)->[[QM31;2];3]{
+ let child=match which{
+ 0=>NKR_Digest_pstep_left(selectors.high[56],openings.z,public.anchor,l),
+ 1=>NKR_Digest_pstep_left(selectors.high[26],openings.z,public.nullifier,l),
+ 2=>NKR_Digest_pstep_recipient(public.recipient,openings.z,selectors.high[29],l),
+ _=>NKR_Digest_pstep_left(selectors.high[32],openings.z,public.change,l)
+ };
+ local_sums[1][0]=NKR_Digest_pstep_add(local_sums[1][0],child[0],l);
+ local_sums[1][1]=NKR_Digest_pstep_add(local_sums[1][1],child[1],l);
+ local_sums
+}
