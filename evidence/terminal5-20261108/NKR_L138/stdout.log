theorem AspisR1.NKR_TermScalarInvocation.source : ∀ (pub : Public) (o : Openings) (s : Selectors) (before : Packed),
  canonical o.z →
    canonical s.high →
      canonical s.low →
        canonical before →
          ↑pub.asset_id < 2147483647 →
            ↑(amount pub) < 2147483647 → ∃ p, FIw_ScalarSuffix.run pub o s before = ok p.out :=
fun pub o s before hz hh hl hb ha hm =>
  have az := FIw_ScalarArithmetic.lift_value pub.asset_id ha;
  sorry az
