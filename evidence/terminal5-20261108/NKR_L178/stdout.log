  let ⟨patternCall, right✝¹⟩ := h✝¹
  let ⟨cp, right✝²⟩ := right✝¹
  let ⟨oldActiveCall, right✝³⟩ := right✝²
  let ⟨left✝, right✝⁴⟩ := right✝³
  let ⟨left✝¹, oldValue⟩ := right✝⁴
  let ⟨scratch, h✝²⟩ :=
    NKR_SumCopyAssociation.source lookup keys domain permutation metadata s patterns append variant hh hl cp
  let ⟨values, h✝³⟩ := h✝²
  let ⟨weights, h✝⁴⟩ := h✝³
  let ⟨collectCall, right✝⁵⟩ := h✝⁴
  let ⟨finishCall, right✝⁶⟩ := right✝⁵
  let ⟨cv, right✝⁷⟩ := right✝⁶
  let ⟨cw, right✝⁸⟩ := right✝⁷
  let ⟨veq, weq⟩ := right✝⁸
  let ⟨active, h✝⁵⟩ := NKR_SumCopyTail.source s values weights helper chi hh hl cv cw hhelper hchi
  let ⟨residual, h✝⁶⟩ := h✝⁵
  let ⟨scaled, h✝⁷⟩ := h✝⁶
  let ⟨activeCall, right✝⁹⟩ := h✝⁷
  let ⟨ca, right✝¹⁰⟩ := right✝⁹
  let ⟨residualCall, right✝¹¹⟩ := right✝¹⁰
  let ⟨cr, right✝¹²⟩ := right✝¹¹
  let ⟨mulCall, right✝¹³⟩ := right✝¹²
  let ⟨cs, right✝¹⁴⟩ := right✝¹³
  let ⟨tailCall, right✝¹⁵⟩ := right✝¹⁴
  let ⟨residualValue, scaledValue⟩ := right✝¹⁵
  have sameRow := row values weights (FJk_CopyFullFold.model s patterns append variant) veq weq;
  have sameActive := ok.inj (Eq.trans (Eq.symm activeCall) oldActiveCall);
  have sameResidualValue :=
    Eq.mpr (id (congrArg (fun _a => _a = decode old.residual) scaledValue))
      (Eq.mpr
        (id
          (congrArg (fun _a => decode active * _a = decode old.residual)
            (FIw_CopyTransport.value_exact (NKR_SumCopyTail.row values weights) (decode helper) (decode chi))))
        (Eq.mpr
          (id
            (congrArg (fun _a => decode active * R0P.copyResidual _a (decode helper) (decode chi) = decode old.residual)
              sameRow))
          (Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  decode _a *
                      R0P.copyResidual (FJk_CopyFullFold.model s patterns append variant) (decode helper) (decode chi) =
                    decode old.residual)
                sameActive))
            (Eq.symm oldValue))));
  have sameResidual := NJB_DecodeInjective.qm scaled old.residual cs oldResCanon sameResidualValue;
  have sameOut :=
    let ⟨residual✝, active✝, h✝⁸⟩ := old
    Eq.ndrec (motive := fun old =>
      evaluate_with_selectors openings helper s lambda chi append variant = ok old →
        Canon old.residual →
          Canon old.active →
            s.active = ok old.active →
              Canon old.active →
                Canon old.residual →
                  decode old.residual =
                      decode old.active *
                        R0P.copyResidual (FJk_CopyFullFold.model s patterns append variant) (decode helper)
                          (decode chi) →
                    active = old.active →
                      decode scaled = decode old.residual →
                        scaled = old.residual → { residual := scaled, active := active } = old)
      (fun oldCall oldResCanon oldActiveCanon oldActiveCall left left_1 oldValue sameActive sameResidualValue
          sameResidual =>
        let ⟨⟩ := active✝
        sameActive)
      (Eq.symm h✝⁸) oldCall oldResCanon oldActiveCanon oldActiveCall left✝ left✝¹ oldValue sameActive sameResidualValue
      sameResidual;
  have refCall :=
    Eq.mpr
      (id
        (congrFun'
          (congrArg Eq
            (Eq.trans
              (Eq.trans
                (congr (congrArg Bind.bind patternCall)
                  (funext fun patterns =>
                    Eq.trans
                      (congrFun' (congrArg Bind.bind collectCall) fun scratch => do
                        let (values, weights) ←
                          NKR_SumFinishInvocation.reference (NJB_ArrayCarrier.array scratch) s patterns
