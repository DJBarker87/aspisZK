                Canon lambda →
                  Canon chi →
                    FIw_ArrayValue.canonical s.high →
                      FIw_ArrayValue.canonical s.low →
                        NKR_SumCopyInvocation.reference lookup s openings helper lambda chi append variant =
                          evaluate_with_selectors openings helper s lambda chi append variant :=
fun lookup keys domain permutation metadata s openings helper lambda chi append variant ho hhelper hlambda hchi hh hl =>
  let ⟨old, h✝⟩ := JGa_Copy.source openings helper s lambda chi append variant ho hhelper hh hl hlambda hchi
  let ⟨oldCall, right✝⟩ := h✝
  let ⟨oldResCanon, oldActiveCanon⟩ := right✝
  let ⟨patterns, h✝¹⟩ :=
