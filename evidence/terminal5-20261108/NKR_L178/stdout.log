                  else 0))
            (Eq.mp
              (congrArg (fun _a => decode (scratch (NJL_EndpointIndices.pattern c)) = _a)
                (zero_add
                  (List.map
                      (fun i =>
                        (if c = NJL_EndpointLookup.patternIndex i false (lookup i false) then
                            decode (NJL_EndpointLookup.high s i false (lookup i false))
                          else 0) +
                          if c = NJL_EndpointLookup.patternIndex i true (lookup i true) then
                            decode (NJL_EndpointLookup.high s i true (lookup i true))
