+ 5=>a[6].is_writable=true,
+ 6=>{a[6].length=Err(ProgramError::AccountBorrowFailed);a[6].bytes=Err(ProgramError::AccountBorrowFailed);expected=ProgramError::AccountBorrowFailed;},
