theorem AspisR1.NIS_SdkReads.three_then_exclusive : ∀ {W : Type}
  (L : AspisR1.S2Trust.Library W (ℕ → AspisR1.S2W_D189Entry.Record)),
  AspisR1.S2Trust.S2TrustedSdkBorrow L →
    ∀ (e : AspisR1.S2W_D189Entry.Entry) (w : W),
      AspisR1.S2W_D189Consolidation.RuntimeEntrypointAdmission L e w 3 →
        ∃ next,
          AspisR1.NIS_SdkReads.Reads L e w (List.range 3) next ∧
            AspisR1.S2Trust.Matches L next (AspisR1.S2Trust.Op.exclusive 2 0 0)
              (AspisR1.S2Trust.acquire e.heap (e.heap.accounts 2).1 0 0 AspisR1.S2Trust.Kind.exclusive,
                AspisR1.S2Trust.Reply.guard 0) :=
fun {W} L sdk e w admission =>
  let ⟨next, h✝⟩ :=
    AspisR1.NIS_SdkReads.sequence L sdk e 3 (List.range 3) (fun a member => List.mem_range.mp member) w admission
  let ⟨reads, ready⟩ := h✝
  Exists.intro next
    ⟨reads,
      AspisR1.NIS_AdmissionSdk.exclusive L sdk e next 3 2 0 0 ready
