+        }
+        Some("fail") => {
+            let first: u8 = args.get(2).expect(usage).parse().expect("first seed");
+            let count: u8 = args.get(3).expect(usage).parse().expect("count");
+            println!("PV_BYTES_GATE fail first={first} count={count} r1p_check={}", cfg!(feature = "r1p-check"));
