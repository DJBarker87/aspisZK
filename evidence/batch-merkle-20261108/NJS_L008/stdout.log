NJS_DigestLeaves.leaf {H : Type} (D : NDH_TranscriptReference.NDH_DigestRef H) (hash : H)
  (oracle : List (Fin 256) → Result (Std.Array U8 32#usize))
  (runtime : ∀ (parts : Slice (Slice U8)), D.digest hash parts = oracle (NDH_HashBridge.input parts)) (tag : U8)
  (value : Slice U8) (salt : Std.Array U8 32#usize) :
  NDH_TranscriptReference.leaf_ref D hash tag value salt =
    oracle
      (AspisR1.Merkle32Leaf.leafInput (NDH_MerkleGrammar.byte tag) (List.map NDH_MerkleGrammar.byte ↑value)
        (List.map NDH_MerkleGrammar.byte ↑salt))
NJS_DigestLeaves.parent {H : Type} (D : NDH_TranscriptReference.NDH_DigestRef H) (hash : H)
  (oracle : List (Fin 256) → Result (Std.Array U8 32#usize))
  (runtime : ∀ (parts : Slice (Slice U8)), D.digest hash parts = oracle (NDH_HashBridge.input parts))
  (children : Std.Array (Std.Array U8 32#usize) 8#usize) :
  NDH_TranscriptReference.parent_ref D hash children =
    oracle (AspisR1.Merkle32Path.nodeInput (NDH_MerkleGrammar.children children))
'NJS_DigestLeaves.leaf' depends on axioms: [propext, Classical.choice, Quot.sound]
'NJS_DigestLeaves.parent' depends on axioms: [propext, Classical.choice, Quot.sound]
