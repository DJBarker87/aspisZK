NJS_BatchLeaf.copied (s : Slice U8) (size : (↑s).length = 32) :
  (do
      let r ← core.array.TryFromArrayCopySlice.try_from 32#usize core.marker.CopyU8 s
      core.result.Result.unwrap core.fmt.DebugTryFromSliceError r) =
    ok ⟨↑s, size⟩
NJS_BatchLeaf.source {H : Type} (d : NJS_Extract.aspis_core.digest.Digest32 H) (hash : H) (kind : Usize) (q : Slice U8)
  (len : (↑q).length = 832) :
  NJS_Extract.verifier.candidate.batch_leaf (ok 113#u8) (ok 241#u8) (fun {H} => privateLeaf) d hash kind q =
    Port4B_LeafCode.native (modelDigest d) hash kind q
'NJS_BatchLeaf.copied' depends on axioms: [propext, Classical.choice, Quot.sound]
'NJS_BatchLeaf.source' depends on axioms: [propext, Classical.choice, Quot.sound]
