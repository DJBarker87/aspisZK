NJS_Keys.source (raw : Std.Array U32 22#usize) (lo n tree : Usize)
  (split : lo = 0#usize ∧ n = 10#usize ∨ lo = 10#usize ∧ n = 12#usize) (kind : ↑tree < 3)
  (canonical : ∀ k < 22, ↑(↑raw)[k]! < 262144) :
  NJS_Extract.verifier.candidate.batch_keys raw lo n tree = Port4B_KeyInstall.build raw lo n tree
'NJS_Keys.loop' depends on axioms: [propext, Classical.choice, Quot.sound]
'NJS_Keys.source' depends on axioms: [propext, Classical.choice, Quot.sound]
