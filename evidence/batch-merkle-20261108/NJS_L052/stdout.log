NJS_RuntimeDigest.leaf (H : Bytes → State) (tag : U8) (value : Slice U8) (salt : Std.Array U8 32#usize)
  (_width : (↑value).length ≤ 480) :
  NDH_TranscriptReference.leaf_ref (reference H) () tag value salt =
    ok
      (AspisV8R19.SqueezeOracleBridge.encodeState
        (H
          (Merkle32Leaf.leafInput (NDH_MerkleGrammar.byte tag) (List.map NDH_MerkleGrammar.byte ↑value)
            (List.map NDH_MerkleGrammar.byte ↑salt))))
NJS_RuntimeDigest.parent (H : Bytes → State) (children : Std.Array (Std.Array U8 32#usize) 8#usize) :
  NDH_TranscriptReference.parent_ref (reference H) () children =
    ok (AspisV8R19.SqueezeOracleBridge.encodeState (H (Merkle32Path.nodeInput (NDH_MerkleGrammar.children children))))
AspisR1.NGC_DigestBridge.forwarding (hashv : Slice (Slice U8) → Std.Array U8 32#usize) (parts : Slice (Slice U8)) :
  (NGC_DigestBridge.backend hashv).digest () parts = ok (hashv parts)
