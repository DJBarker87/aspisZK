def Aeneas.Std.UScalar.add : {ty : Aeneas.Std.UScalarTy} →
  Aeneas.Std.UScalar ty → Aeneas.Std.UScalar ty → Aeneas.Std.Result (Aeneas.Std.UScalar ty) :=
fun {ty} x y => Aeneas.Std.UScalar.tryMk ty (↑x + ↑y)
def Aeneas.Std.UScalar.mul : {ty : Aeneas.Std.UScalarTy} →
  Aeneas.Std.UScalar ty → Aeneas.Std.UScalar ty → Aeneas.Std.Result (Aeneas.Std.UScalar ty) :=
fun {ty} x y => Aeneas.Std.UScalar.tryMk ty (↑x * ↑y)
def Aeneas.Std.Usize.checked_mul : Aeneas.Std.Usize → Aeneas.Std.Usize → Option Aeneas.Std.Usize :=
fun x y => Aeneas.Std.core.num.checked_mul_UScalar x y
def Aeneas.Std.lift.{u} : {α : Type u} → α → Aeneas.Std.Result α :=
fun {α} x => Aeneas.Std.Result.ok x
def Aeneas.Std.UScalar.tryMk : (ty : Aeneas.Std.UScalarTy) → ℕ → Aeneas.Std.Result (Aeneas.Std.UScalar ty) :=
fun ty x => Aeneas.Std.Result.ofOption (Aeneas.Std.UScalar.tryMkOpt ty x) Aeneas.Std.Error.integerOverflow
Aeneas.Std.UScalar.add_spec {ty : Aeneas.Std.UScalarTy} {x y : Aeneas.Std.UScalar ty}
  (hmax : ↑x + ↑y ≤ Aeneas.Std.UScalar.max ty) : Aeneas.Std.WP.spec (x + y) fun z => ↑z = ↑x + ↑y
Aeneas.Std.UScalar.mul_spec {ty : Aeneas.Std.UScalarTy} {x y : Aeneas.Std.UScalar ty}
  (hmax : ↑x * ↑y ≤ Aeneas.Std.UScalar.max ty) : Aeneas.Std.WP.spec (x * y) fun z => ↑z = ↑x * ↑y
