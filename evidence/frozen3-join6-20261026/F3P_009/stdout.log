          AspisS1ExtractedRoundChildren.MainError) :=
fun n r offset =>
  AspisS1ExtractedRoundChildren.decoderResultToMain n
    (AspisR1DecodeKFullV10.r1_wire.ValidatedRecord.decode_k n (AspisS1ExtractedRoundChildren.recordToDecoder r) offset)
