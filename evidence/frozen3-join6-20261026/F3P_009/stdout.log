  let ⟨begin, finish⟩ := right✝¹
  let ⟨payload, h✝⁴⟩ :=
    AspisR1PublicPreparation.S1SemanticRootCopy.finish_roots R B
      (AspisR1CurrentCaller.InstalledPreparation.retainedDigest D)
      (AspisR1CurrentCaller.FirstComposition.toRetainedPublic pub) pre after challenges
      (AspisR1CurrentCaller.InstalledPreparation.retainedSem sem) finish
  let ⟨root2, h✝⁵⟩ := h✝⁴
  let ⟨hpayload, right✝²⟩ := h✝⁵
  let ⟨hcopy, right✝³⟩ := right✝²
  let ⟨hbytes, hroots⟩ := right✝³
  Exists.intro pre
    (Exists.intro initial
      (Exists.intro after
        (Exists.intro challenges
          (Exists.intro payload
            (Exists.intro root2 ⟨parsed, ⟨publicInit, ⟨begin, ⟨finish, ⟨hpayload, ⟨hcopy, ⟨hbytes, hroots⟩⟩⟩⟩⟩⟩⟩)))))
def AspisR1.CircleRecordCodec.decode : (row : Fin 2) →
  List AspisR1.CircleRecordCodec.Byte → Option (AspisR1.CircleRecordCodec.Payload row) :=
fun row bytes =>
  (AspisR1.RecordFrameCodec.parse (AspisR1.CircleRecordCodec.tag row) (AspisR1.CircleRecordCodec.count row * 32)
        bytes).bind
    (AspisR1.SelectedFieldSequenceCodec.decodeLow (AspisR1.CircleRecordCodec.count row))
def AspisR1.LiteralOpeningStages.readGamma : List
    (AspisR1.LiteralTranscript.Message × AspisR1.LiteralTranscript.Challenge) →
  Option AspisR1.LiteralOpeningStages.Gamma :=
fun rs => do
  let row25 ← AspisR1.LiteralOpeningStages.readAt rs 25 (AspisR1.CircleRecordCodec.decode 0)
  let row26 ← AspisR1.LiteralOpeningStages.readAt rs 26 (AspisR1.CircleRecordCodec.decode 1)
  let row27 ←
    AspisR1.LiteralOpeningStages.readAt rs 27 (AspisR1.OpeningRecordCodec.decode AspisR1.OpeningRecordCodec.Row.gamma)
  pure { row25 := row25, row26 := row26, row27 := row27 }
def AspisR1.ClaimsUnrolledFinish.install : AspisR1.ClaimsUnrolledFinish.StdCalls →
  AspisR1PublicPreparation.FinishModel.Boundaries → AspisR1PublicPreparation.FinishModel.Boundaries :=
fun std B =>
  { fromFn := @AspisR1PublicPreparation.FinishModel.Boundaries.fromFn B, mask := B.mask, add := B.add, mul := B.mul,
    terminal := B.terminal, circle := B.circle, unwrapRoot := B.unwrapRoot,
    claims := AspisR1.ClaimsUnrolledFinish.claims std }
