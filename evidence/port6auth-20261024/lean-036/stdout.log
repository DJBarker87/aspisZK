def AspisR1.RawRecordedOracleExtractionMassBin.CleanAcceptedModel : AspisR1.LiteralByteProtocol.Decoder →
  AspisR1.RawRecordedOracleExtractionMassBin.Experiment → (AspisR1.RawCutProverCompiler.RunView → Prop) → Prop :=
fun decoder exp hit =>
  ∀ (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
    have run := AspisV8R19.MemoizedProgramLaw.eval H exp;
    run.2.2 = true →
      ¬hit run →
        ∃ _checks,
          ¬AspisR1.GenericNoHit.hitFrom AspisR1.LiteralClassifier.bad run.2.1.1 []
              ((AspisR1.LiteralByteProtocol.protocol decoder).transcript H run.2.1.1
                  (AspisR1.RawCutTranscriptRun.proof (AspisR1.RawCutWordsFromRunExecutableBin.wordsFromRun run)
                    run.2.1.2)
                  33).rounds
