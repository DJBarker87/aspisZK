'AspisR1.NLC_Finish.step_record25a' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLC_Finish.step_record25a : ∀ {H : Type} (s : State H),
  s.next = Event.record25a → step s = window_record25a s :=
fun {H} s atSite =>
  let ⟨i, l, next, atSite⟩ := s
  let ⟨⟩ := Event.record25a
  atSite
