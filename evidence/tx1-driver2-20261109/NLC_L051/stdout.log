'AspisR1.NLC_Finish.step_verified' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLC_Finish.step_verified : ∀ {H : Type} (s : State H),
  s.next = Event.verified → step s = window_verified s :=
fun {H} s atSite =>
  let ⟨i, l, next, atSite⟩ := s
  let ⟨⟩ := Event.verified
  atSite
