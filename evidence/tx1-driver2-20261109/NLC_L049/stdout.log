'AspisR1.NLC_Finish.step_payload2' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLC_Finish.step_payload2 : ∀ {H : Type} (s : State H),
  s.next = Event.payload2 → step s = window_payload2 s :=
fun {H} s atSite =>
  let ⟨i, l, next, atSite⟩ := s
  let ⟨⟩ := Event.payload2
  atSite
