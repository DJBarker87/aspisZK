'AspisR1.NLC_Finish.step_decode26' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLC_Finish.step_decode26 : ∀ {H : Type} (s : State H),
  s.next = Event.decode26 → step s = window_decode26 s :=
fun {H} s atSite =>
  let ⟨i, l, next, atSite⟩ := s
  let ⟨⟩ := Event.decode26
  atSite
