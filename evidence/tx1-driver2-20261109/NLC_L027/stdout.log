'AspisR1.NLC_Finish.step_lowArray' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLC_Finish.step_lowArray : ∀ {H : Type} (s : State H),
  s.next = Event.lowArray → step s = window_lowArray s :=
fun {H} s atSite =>
  let ⟨i, l, next, atSite⟩ := s
  let ⟨⟩ := Event.lowArray
  atSite
