'AspisR1.NLC_Finish.step_decode25' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLC_Finish.step_decode25 : ∀ {H : Type} (s : State H),
  s.next = Event.decode25 → step s = window_decode25 s :=
fun {H} s atSite =>
  let ⟨i, l, next, atSite⟩ := s
  let ⟨⟩ := Event.decode25
  atSite
