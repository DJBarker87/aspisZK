'AspisR1.NLC_Finish.step_addExtra' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLC_Finish.step_addExtra : ∀ {H : Type} (s : State H),
  s.next = Event.addExtra → step s = window_addExtra s :=
fun {H} s atSite =>
  let ⟨i, l, next, atSite⟩ := s
  let ⟨⟩ := Event.addExtra
  atSite
