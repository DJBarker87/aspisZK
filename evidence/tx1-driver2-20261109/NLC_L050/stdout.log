'AspisR1.NLC_Finish.step_rootCopy' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLC_Finish.step_rootCopy : ∀ {H : Type} (s : State H),
  s.next = Event.rootCopy → step s = window_rootCopy s :=
fun {H} s atSite =>
  let ⟨i, l, next, atSite⟩ := s
  let ⟨⟩ := Event.rootCopy
  atSite
