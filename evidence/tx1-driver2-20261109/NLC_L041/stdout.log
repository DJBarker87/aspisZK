'AspisR1.NLC_Finish.step_record25b' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLC_Finish.step_record25b : ∀ {H : Type} (s : State H),
  s.next = Event.record25b → step s = window_record25b s :=
fun {H} s atSite =>
  let ⟨i, l, next, atSite⟩ := s
  let ⟨⟩ := Event.record25b
  atSite
