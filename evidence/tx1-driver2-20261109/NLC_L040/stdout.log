'AspisR1.NLC_Finish.step_stateBefore' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLC_Finish.step_stateBefore : ∀ {H : Type} (s : State H),
  s.next = Event.stateBefore → step s = window_stateBefore s :=
fun {H} s atSite =>
  let ⟨i, l, next, atSite⟩ := s
  let ⟨⟩ := Event.stateBefore
  atSite
