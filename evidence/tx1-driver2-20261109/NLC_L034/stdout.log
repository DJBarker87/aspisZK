'AspisR1.NLC_Finish.step_multiply' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLC_Finish.step_multiply : ∀ {H : Type} (s : State H),
  s.next = Event.multiply → step s = window_multiply s :=
fun {H} s atSite =>
  let ⟨i, l, next, atSite⟩ := s
  let ⟨⟩ := Event.multiply
  atSite
