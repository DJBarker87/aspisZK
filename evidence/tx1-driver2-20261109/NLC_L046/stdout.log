'AspisR1.NLC_Finish.step_circle1' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLC_Finish.step_circle1 : ∀ {H : Type} (s : State H),
  s.next = Event.circle1 → step s = window_circle1 s :=
fun {H} s atSite =>
  let ⟨i, l, next, atSite⟩ := s
  let ⟨⟩ := Event.circle1
  atSite
