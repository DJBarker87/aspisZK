'AspisR1.NLC_Finish.step_highArray' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLC_Finish.step_highArray : ∀ {H : Type} (s : State H),
  s.next = Event.highArray → step s = window_highArray s :=
fun {H} s atSite =>
  let ⟨i, l, next, atSite⟩ := s
  let ⟨⟩ := Event.highArray
  atSite
