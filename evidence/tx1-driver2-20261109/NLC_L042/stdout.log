'AspisR1.NLC_Finish.step_circle0' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLC_Finish.step_circle0 : ∀ {H : Type} (s : State H),
  s.next = Event.circle0 → step s = window_circle0 s :=
fun {H} s atSite =>
  let ⟨i, l, next, atSite⟩ := s
  let ⟨⟩ := Event.circle0
  atSite
