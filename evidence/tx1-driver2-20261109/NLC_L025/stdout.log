'AspisR1.NLC_Finish.step_mapPublic' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLC_Finish.step_mapPublic : ∀ {H : Type} (s : State H),
  s.next = Event.mapPublic → step s = window_mapPublic s :=
fun {H} s atSite =>
  let ⟨i, l, next, atSite⟩ := s
  let ⟨⟩ := Event.mapPublic
  atSite
