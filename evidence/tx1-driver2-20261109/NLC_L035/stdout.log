'AspisR1.NLC_Finish.step_addMask' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLC_Finish.step_addMask : ∀ {H : Type} (s : State H),
  s.next = Event.addMask → step s = window_addMask s :=
fun {H} s atSite =>
  let ⟨i, l, next, atSite⟩ := s
  let ⟨⟩ := Event.addMask
  atSite
