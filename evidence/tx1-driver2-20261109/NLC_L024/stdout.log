'AspisR1.NLC_Finish.step_terminal' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem AspisR1.NLC_Finish.step_terminal : ∀ {H : Type} (s : State H),
  s.next = Event.terminal → step s = window_terminal s :=
fun {H} s atSite =>
  let ⟨i, l, next, atSite⟩ := s
  let ⟨⟩ := Event.terminal
  atSite
