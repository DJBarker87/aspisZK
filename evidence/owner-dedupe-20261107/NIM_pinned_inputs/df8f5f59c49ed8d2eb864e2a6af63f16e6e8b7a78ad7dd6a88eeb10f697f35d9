macro_rules! fidelity_inputs{($sem:ident,$y:ident,$g:ident,$pre:ident,$post:ident,$reply:ident)=>{
 let $sem=sem();let $y:[u8;928]=kani::any();let $g:[E;29]=unsafe{core::mem::transmute(kani::any::<[u32;232]>())};let $pre:State=kani::any();let $post:State=kani::any();let $reply:bool=kani::any();
}}
macro_rules! fidelity_copy{($name:ident,$body:block)=>{
 #[kani::proof]#[kani::unwind(1000)]
