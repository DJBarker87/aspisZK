+pub(super) fn live_word(&self,x:&Live)->u64{let(i,r)=unsafe{(self.INDEX,self.ROW)};match GROUP{0=>x.sequence,1=>x.next_pair_index,2=>x.pool[i] as u64,3=>x.deployment_domain[i] as u64,4=>x.current_root[i].0 as u64,_=>x.frontier[r][i].0 as u64}}
