+pub(super) fn live_child(&mut self,bytes:&[u8])->Result<Live,LiveError>{assert_eq!(bytes.as_ptr() as usize,unsafe{self.INPUT},"NEC_static_same_pointer");assert_eq!(bytes.len(),800,"NEC_static_same_length");Ok(unsafe{self.LIVE})}
+pub(super) fn after_post(&self,r:&Result<Box<After>,PoolV1PairLatePublicStatementErrorV1>)->bool{let expected=reference::reply_ref::<u64,AfterError>(Ok(self.after_word(unsafe{&*(&raw const self.AFTER)})));(match(r,expected){(Ok(x),Ok(y))=>self.after_word(x)==y,_=>false}) != true}
+pub(super) fn live_post(&self,r:&Result<Box<Live>,PoolV1PairLatePublicStatementErrorV1>)->bool{let expected=reference::reply_ref::<u64,LiveError>(Ok(self.live_word(unsafe{&*(&raw const self.LIVE)})));(match(r,expected){(Ok(x),Ok(y))=>self.live_word(x)==y,_=>false}) != true}
