+const GROUP:u8=0;
+pub(super) struct NEK_Context{pub(super) INDEX:usize,pub(super) ROW:usize,pub(super) CALLS:u8,pub(super) PTR:*const u8,pub(super) LEN:usize,pub(super) WORD:u64,pub(super) AFTER_ERROR:Option<AfterError>,pub(super) LIVE_ERROR:Option<LiveError>}
+impl NEK_Context{pub(super) fn new()->Self{Self{INDEX:0,ROW:0,CALLS:0,PTR:core::ptr::null(),LEN:0,WORD:0,AFTER_ERROR:None,LIVE_ERROR:None}}
+pub(super) fn after_word(&self,x:&After)->u64 {let (i,r)=unsafe{(self.INDEX,self.ROW)};match GROUP {0=>x.next_pair_index,1=>x.next_root[i].0 as u64,_=>x.next_frontier[r][i].0 as u64}}
+pub(super) fn live_word(&self,x:&Live)->u64 {let (i,r)=unsafe{(self.INDEX,self.ROW)};match GROUP {0=>x.sequence,1=>x.next_pair_index,2=>x.pool[i] as u64,3=>x.deployment_domain[i] as u64,4=>x.current_root[i].0 as u64,_=>x.frontier[r][i].0 as u64}}
+pub(super) fn after_child(&mut self,bytes:&[u8])->Result<After,AfterError>{
+ unsafe{self.CALLS=self.CALLS.wrapping_add(1);self.PTR=bytes.as_ptr();self.LEN=bytes.len();}
+ if kani::any(){let x:After=unsafe{core::mem::transmute(kani::any::<[u8;core::mem::size_of::<After>()]>())};unsafe{self.WORD=self.after_word(&x);self.AFTER_ERROR=None;}Ok(x)}
+ else {let e:AfterError=kani::any();unsafe{self.AFTER_ERROR=Some(e);}Err(e)}
+}
+pub(super) fn live_child(&mut self,bytes:&[u8])->Result<Live,LiveError>{
+ unsafe{self.CALLS=self.CALLS.wrapping_add(1);self.PTR=bytes.as_ptr();self.LEN=bytes.len();}
+ if kani::any(){let x:Live=unsafe{core::mem::transmute(kani::any::<[u8;core::mem::size_of::<Live>()]>())};unsafe{self.WORD=self.live_word(&x);self.LIVE_ERROR=None;}Ok(x)}
+ else {let e:LiveError=kani::any();unsafe{self.LIVE_ERROR=Some(e);}Err(e)}
+}
+pub(super) fn prepare(&mut self,limit:usize){let i:usize=kani::any();let row:usize=kani::any();kani::assume(i<limit && row<20);unsafe{self.INDEX=i;self.ROW=row;self.CALLS=0;self.PTR=core::ptr::null();self.LEN=0;self.WORD=0;self.AFTER_ERROR=None;self.LIVE_ERROR=None;}}
+pub(super) fn post_after(&self,result:&Result<Box<After>,LateError>,bytes:&[u8])->bool {
+ let reference=reference::boxed_ref(match unsafe{self.AFTER_ERROR}{Some(e)=>Err(e),None=>Ok(unsafe{self.WORD})});
+ let same=match (result,&reference){(Ok(x),Ok(y))=>self.after_word(x)==**y,(Err(LateError::Afterstate(e)),Err(reference::ChildError::Child(f)))=>e==f,_=>false};
+ let calls=unsafe{self.CALLS==1 && self.PTR==bytes.as_ptr() && self.LEN==bytes.len()};
+ calls!=true
+}
+pub(super) fn post_live(&self,result:&Result<Box<Live>,LateError>,bytes:&[u8])->bool {
+ let reference=reference::boxed_ref(match unsafe{self.LIVE_ERROR}{Some(e)=>Err(e),None=>Ok(unsafe{self.WORD})});
+ let same=match (result,&reference){(Ok(x),Ok(y))=>self.live_word(x)==**y,(Err(LateError::Snapshot(e)),Err(reference::ChildError::Child(f)))=>e==f,_=>false};
+ let calls=unsafe{self.CALLS==1 && self.PTR==bytes.as_ptr() && self.LEN==bytes.len()};
+ calls!=true
+}
+}
