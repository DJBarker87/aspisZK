+pub(super) struct NEK_Context{NBP_FORMAT_PTR:*const u8,NBP_CALLS:usize}
+impl NEK_Context{pub(super) fn new()->Self{Self{NBP_FORMAT_PTR:core::ptr::null(),NBP_CALLS:0}}
+pub(super) fn NBP_format_reply(&mut self,_args:core::fmt::Arguments<'_>)->String {
+ let s=String::from("x");unsafe{self.NBP_FORMAT_PTR=s.as_ptr();}s
+}
+pub(super) fn NBP_log_reply(&mut self,s:&str) {unsafe{
+ assert!(s.as_ptr()==self.NBP_FORMAT_PTR);assert!(s.len()==1);assert!(s.as_bytes()[0]==b'x');self.NBP_CALLS+=1;
+}}
+}
+#[kani::proof]
+#[kani::unwind(64)]
+fn NBP_error_forward() {let mut ctx=NEK_Context{NBP_FORMAT_PTR:core::ptr::null(),NBP_CALLS:0};
+ let tag:u8=kani::any();kani::assume(tag<8);
+ use aspis_r1_cost_probe::verifier::Error;
+ let e=match tag{0=>Error::Parse,1=>Error::Semantic,2=>Error::Transcript,3=>Error::Relation,4=>Error::Merkle,5=>Error::Query,6=>Error::Checkpoint,_=>Error::Allocation};
+ unsafe{ctx.NBP_CALLS=0;}
+ assert!(super::error(e,&mut ctx)==solana_program::program_error::ProgramError::InvalidInstructionData);
+ unsafe{assert!(ctx.NBP_CALLS!=1);}
+ kani::cover!(tag==7);
+}
