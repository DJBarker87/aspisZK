+struct NEK_Context{NBG_PRODUCT:u32,NBG_MUL_CALLS:usize}
+impl NEK_Context{
+fn NBG_product(&mut self,x:super::M31,y:super::M31)->super::M31{
+ let r:u32=kani::any();
+ kani::assume(r<super::P);
+ kani::assume((r as u64)==((x.0 as u64)*(y.0 as u64))%(super::P as u64));
+ self.NBG_PRODUCT=r;self.NBG_MUL_CALLS+=1;
+ super::M31(r)
+}
+}
+#[kani::proof]
+fn NBG_square_iteration(){
+ let mut ctx=NEK_Context{NBG_PRODUCT:0,NBG_MUL_CALLS:0};
+ let start:usize=kani::any();let end:usize=kani::any();let mut iter=start..end;
+ let mut value=super::M31(kani::any());
+ ctx.NBG_MUL_CALLS=0;
+ let next=iter.next();
+ if start<end{
+  assert!(next==Some(start));assert!(iter.start==start+1&&iter.end==end);
+  value=ctx.NBG_product(value,value);
+  assert!(value.0==ctx.NBG_PRODUCT);assert!(ctx.NBG_MUL_CALLS==1);
+  assert!(value.0<super::P);
+ }else{assert!(next.is_none());assert!(iter.start==start&&iter.end==end);assert!(ctx.NBG_MUL_CALLS==0);}
+ kani::cover!(start==0&&end==1&&value.0==0);
+}
