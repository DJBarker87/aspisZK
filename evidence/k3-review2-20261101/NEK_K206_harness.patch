+ let association=ctx.point.count==1 && ctx.point.left==[a.0,a.1] && ctx.point.right==[b.0,b.1];
+ let reference=NEA_point_reference::point_ref(i,&TABLE_A,&TABLE_B,ctx.point.reply);
+ let returned=r.x.0==reference[4] && r.y.0==reference[5] && ctx.point.left==[reference[0],reference[1]] && ctx.point.right==[reference[2],reference[3]];
+ association && ctx.point.reply[0]<2147483647 && ctx.point.reply[1]<2147483647 && if cfg!(NEA_wrong_point){!returned}else{returned}
+}}
