theorem AspisR1.Port1_Annotation.backward : ∀ (adapter : AdapterRw.Ops) (impl : VTop_OracleCode.Implementation)
  {Hash : Type} (D : VTop_Stages.aspis_core.digest.Digest32 Hash) (hash : Hash)
  (words : CanonicalCutEnrichedTranscript.Words) (i : OraclePortStoredExperimentC4.Input)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
  (AspisV8R19.MemoizedProgramLaw.eval H
          (Port1_Driver.rust adapter (fun {A} => impl) D hash (OraclePortStoredExperimentC4.enrich words i))).2 =
      true →
    (AspisV8R19.MemoizedProgramLaw.eval H (Port1_Driver.rust adapter (fun {A} => impl) D hash i)).2 = true :=
fun adapter impl {Hash} D hash words i H accepted =>
  Eq.mp
    (congrArg (fun _a => (AspisV8R19.MemoizedProgramLaw.eval H _a).2 = true)
      (Port1_Annotation.source_enrich adapter impl D hash words i))
    accepted
AspisR1.VTop_Annotation.two_pass (D : LiteralByteProtocol.Decoder) (rust : OraclePortRuntimeBindingC7.Verifier)
  (raw :
    OraclePortFrozen2Join.AcceptedVerifierJoin rust
      (OraclePortStoredExperimentC4.verifier D OraclePortFrozen2.dV_frozen2))
  (backward :
    ∀ (w : CanonicalCutEnrichedTranscript.Words) (i : OraclePortStoredExperimentC4.Input)
      (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State),
      (AspisV8R19.MemoizedProgramLaw.eval H (rust (OraclePortStoredExperimentC4.enrich w i))).2 = true →
        (AspisV8R19.MemoizedProgramLaw.eval H (rust i)).2 = true) :
  OraclePortFrozen2Join.AcceptedRunJoin D rust
