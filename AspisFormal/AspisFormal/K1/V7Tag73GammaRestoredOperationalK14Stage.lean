import AspisFormal.K1.V7Tag73GammaRestoredK14Scope

/-!
# K1.4 classifier for the canonical gamma-restored child

The restoration-wide K1.3 classifier may choose the accepted root or any
stored child.  Its K1.4 error therefore cannot be bounded by the probability
law of the canonical root-gamma restoration fork without an additional scope
proof.  This leaf makes that scope part of the dependent type: both the
certificate and the error are indexed by an
`ExactGammaRestoredOperationalK13Certificate`.

No probability statement is proved here.  The result is the deterministic
classifier/event layer consumed by the correctly scoped gamma probability
theorem.
-/

set_option autoImplicit false
set_option maxRecDepth 1000000

namespace AspisK1.V7Tag73GammaRestoredOperationalK14Stage

open AspisK1.V7FsAokExperiment
open AspisK1.V7Tag73ExactClientKnowledgeComposition
open AspisK1.V7Tag73ExactCompilerResources
open AspisK1.V7Tag73ExactFixedK12MerkleClassifier
open AspisK1.V7Tag73ExactPlainRomRun
open AspisK1.V7Tag73ExactSourceAcceptanceModel
open AspisK1.V7Tag73GammaRestoredK14Scope
open AspisK1.V7Tag73ParsedK13K14Classifier
open AspisK1.V7Tag73RestoredDerivedK13View
open AspisPool.AlgorithmicCircleDecoderV7
open AspisPool.V7C1SubfieldRecovery
open AspisV5ComponentCQM31TowerExact

noncomputable section

/-- Coherent-chain certificate for exactly the child produced by the
canonical block-zero root-gamma restoration request. -/
structure ExactGammaRestoredOperationalK14Certificate
    {HiddenTape TapeIdentity Observation Statement Payload Witness : Type}
    {parameters : ExactCompilerResourceParameters}
    {transitionFuel : Nat}
    {configuration : ExactPlainRomWitnessConfiguration HiddenTape TapeIdentity
      Observation Statement Tag73K12ParsedProof Payload Witness parameters}
    {projection : AcceptedTapeProjection Statement Tag73K12ParsedProof Payload}
    {fixedInstance : PublicInstance Statement}
    {sample : ExactCompilerSample HiddenTape parameters}
    (decoder : ExactDecoderInstantiation QM31Exact)
    (binding : InitialProjectionBinding decoder)
    (input : ExactK12OperationalInput transitionFuel configuration projection
      fixedInstance sample)
    (k13 : ExactGammaRestoredOperationalK13Certificate decoder input) where
  classified : ParsedK14Certificate decoder binding
    k13.certificate.classified.k12.words
    (restoredOperationalK13View k13.certificate.data)

/-- The sole coherent-chain error on that same scoped child. -/
structure ExactGammaRestoredOperationalK14Error
    {HiddenTape TapeIdentity Observation Statement Payload Witness : Type}
    {parameters : ExactCompilerResourceParameters}
    {transitionFuel : Nat}
    {configuration : ExactPlainRomWitnessConfiguration HiddenTape TapeIdentity
      Observation Statement Tag73K12ParsedProof Payload Witness parameters}
    {projection : AcceptedTapeProjection Statement Tag73K12ParsedProof Payload}
    {fixedInstance : PublicInstance Statement}
    {sample : ExactCompilerSample HiddenTape parameters}
    (decoder : ExactDecoderInstantiation QM31Exact)
    (input : ExactK12OperationalInput transitionFuel configuration projection
      fixedInstance sample)
    (k13 : ExactGammaRestoredOperationalK13Certificate decoder input) where
  classified : ParsedK14Error decoder
    k13.certificate.classified.k12.words
    (restoredOperationalK13View k13.certificate.data)

/-- Total K1.4 decision on the canonical gamma-restored child. -/
noncomputable def classifyExactGammaRestoredOperationalK14
    {HiddenTape TapeIdentity Observation Statement Payload Witness : Type}
    {parameters : ExactCompilerResourceParameters}
    {transitionFuel : Nat}
    {configuration : ExactPlainRomWitnessConfiguration HiddenTape TapeIdentity
      Observation Statement Tag73K12ParsedProof Payload Witness parameters}
    {projection : AcceptedTapeProjection Statement Tag73K12ParsedProof Payload}
    {fixedInstance : PublicInstance Statement}
    {sample : ExactCompilerSample HiddenTape parameters}
    (decoder : ExactDecoderInstantiation QM31Exact)
    (binding : InitialProjectionBinding decoder)
    (input : ExactK12OperationalInput transitionFuel configuration projection
      fixedInstance sample)
    (k13 : ExactGammaRestoredOperationalK13Certificate decoder input) :
    ExactGammaRestoredOperationalK14Certificate decoder binding input k13 ⊕
      ExactGammaRestoredOperationalK14Error decoder input k13 :=
  match classifyParsedK14 decoder binding
      k13.certificate.classified.k12.words
      (restoredOperationalK13View k13.certificate.data)
      k13.certificate.classified.k13 with
  | .inl certificate => .inl ⟨certificate⟩
  | .inr error => .inr ⟨error⟩

/-- Literal event generated by the scoped error family. -/
def exactTag73GammaRestoredOperationalK14FailureEvent
    {HiddenTape TapeIdentity Observation Statement Payload Witness : Type}
    {parameters : ExactCompilerResourceParameters}
    (transitionFuel : Nat)
    (configuration : ExactPlainRomWitnessConfiguration HiddenTape TapeIdentity
      Observation Statement Tag73K12ParsedProof Payload Witness parameters)
    (projection : AcceptedTapeProjection Statement Tag73K12ParsedProof Payload)
    (fixedInstance : PublicInstance Statement)
    (decoder : ExactDecoderInstantiation QM31Exact) :
    Set (ExactCompilerSample HiddenTape parameters) :=
  {sample | ∃
      (input : ExactK12OperationalInput transitionFuel configuration projection
        fixedInstance sample)
      (k13 : ExactGammaRestoredOperationalK13Certificate decoder input),
    Nonempty (ExactGammaRestoredOperationalK14Error decoder input k13)}

/-- The scoped error family is exactly the scoped width-29 failure event.
This equality is deterministic; the probabilistic bound remains in
`V7Tag73GammaRestoredK14Probability`. -/
theorem exact_gamma_restored_operational_k14_failure_event_eq_width29
    {HiddenTape TapeIdentity Observation Statement Payload Witness : Type}
    {parameters : ExactCompilerResourceParameters}
    {transitionFuel : Nat}
    {configuration : ExactPlainRomWitnessConfiguration HiddenTape TapeIdentity
      Observation Statement Tag73K12ParsedProof Payload Witness parameters}
    {projection : AcceptedTapeProjection Statement Tag73K12ParsedProof Payload}
    {fixedInstance : PublicInstance Statement}
    {decoder : ExactDecoderInstantiation QM31Exact} :
    exactTag73GammaRestoredOperationalK14FailureEvent transitionFuel
        configuration projection fixedInstance decoder =
      exactTag73GammaRestoredOperationalK14Width29Event transitionFuel
        configuration projection fixedInstance decoder := by
  ext sample
  constructor
  · rintro ⟨input, k13, ⟨failure⟩⟩
    cases failure.classified with
    | width29 widthFailure => exact ⟨input, k13, widthFailure⟩
  · rintro ⟨input, k13, widthFailure⟩
    exact ⟨input, k13, ⟨⟨.width29 widthFailure⟩⟩⟩

#print axioms classifyExactGammaRestoredOperationalK14
#print axioms exactTag73GammaRestoredOperationalK14FailureEvent
#print axioms exact_gamma_restored_operational_k14_failure_event_eq_width29

end
end AspisK1.V7Tag73GammaRestoredOperationalK14Stage
