DocComment":" The M31 `asset_id` is the value already committed inside every note.  The"},{"DocComment":" mint and token-program bytes pin the external asset represented by that"},{"DocComment":" field element.  The pool address and deployment domain prevent the same"},{"DocComment":" identity payload from being replayed into a sibling pool or deployment."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":21,"beg":{"line":109,"col":4},"end":{"line":109,"col":22}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"pool","ty":{"Deduplicated":1760}},{"span":{"data":{"file_id":21,"beg":{"line":110,"col":4},"end":{"line":110,"col":28}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"asset_mint","ty":{"Deduplicated":1760}},{"span":{"data":{"file_id":21,"beg":{"line":111,"col":4},"end":{"line":111,"col":31}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"token_program","ty":{"Deduplicated":1760}},{"span":{"data":{"file_id":21,"beg":{"line":112,"col":4},"end":{"line":112,"col":21}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"asset_id","ty":{"Deduplicated":1255}},{"span":{"data":{"file_id":21,"beg":{"line":113,"col":4},"end":{"line":113,"col":35}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"deployment_domain","ty":{"Deduplicated":1760}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":132,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,32,64,128,96],"uninhabi