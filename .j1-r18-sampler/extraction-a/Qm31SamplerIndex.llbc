{"charon_version":"0.1.223","translated":{"crate_name":"aspis_r1_qm31_index_sampler_extract","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::sampler::qm31_sample"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/aspis-r1-r18-sampler-20261016/extraction-a/Qm31SamplerIndex.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"lib.rs"},"crate_name":"aspis_r1_qm31_index_sampler_extract","contents":"// Exact source cuts. cfg(test) adds the pinned production tests only.\npub mod field {\n/// The Mersenne prime 2^31 - 1.\npub const P: u32 = 0x7fff_ffff;\n/// M31 base field element, canonical representation in [0, P).\n#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]\npub struct M31(pub u32);\n/// CM31 = M31[i] / (i^2 + 1). Element a + b*i.\n#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]\npub struct CM31 {\n    pub a: M31,\n    pub b: M31,\n}\nimpl CM31 {\n    #[inline(always)]\n    pub fn new(a: M31, b: M31) -> CM31 {\n        CM31 { a, b }\n    }\n}\n/// QM31 = CM31[u] / (u^2 - (2 + i)). Element c0 + c1*u. (stwo parameterization)\n#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]\npub struct QM31 {\n    pub c0: CM31,\n    pub c1: CM31,\n}\n}\npub mod sampler {\nuse crate::field::{CM31, M31, P, QM31};\n/// Divide a little-endian word array by P, retaining every quotient word.\n/// Dividends are below P * 2^32, so every division fits in u64.\nfn qm31_div_pass(mut rank: [u32; 8]) -> ([u32; 8], u32) {\n    let mut remainder = 0u64;\n    let mut j = 8usize;\n    while j > 0 {\n        j -= 1;\n        let dividend = (remainder << 32) | u64::from(rank[j]);\n        rank[j] = (dividend / u64::from(P)) as u32;\n        remainder = dividend % u64::from(P);\n    }\n    (rank, remainder as u32)\n}\n/// The low four base-P digits already represent rank modulo P^4.\nfn qm31_digits(block: &[u8; 32]) -> [u32; 4] {\n    let mut rank = [0u32; 8];\n    let mut i = 0usize;\n    while i < 8 {\n        let start = 4 * i;\n        rank[i] = u32::from_le_bytes([\n            block[start],\n            block[start + 1],\n            block[start + 2],\n            block[start + 3],\n        ]);\n        i += 1;\n    }\n    let mut digits = [0u32; 4];\n    let mut i = 0usize;\n    while i < 4 {\n        let (quotient, digit) = qm31_div_pass(rank);\n        rank = quotient;\n        digits[i] = digit;\n        i += 1;\n    }\n    digits\n}\npub fn qm31_sample(block: &[u8; 32]) -> QM31 {\n    let digits = qm31_digits(block);\n    QM31 {\n        c0: CM31::new(M31(digits[0]), M31(digits[1])),\n        c1: CM31::new(M31(digits[2]), M31(digits[3])),\n    }\n}\n#[cfg(test)]\nmod qm31_index_tests {\n    use super::*;\n\n    // Preserve the complete pre-refactor implementation as a differential oracle.\n    fn old_sample(block: &[u8; 32]) -> QM31 {\n        let mut rank: [u32; 8] =\n            core::array::from_fn(|i| u32::from_le_bytes(block[4 * i..4 * i + 4].try_into().unwrap()));\n        let digits: [u32; 4] = core::array::from_fn(|_| {\n            let mut remainder = 0u64;\n            for limb in rank.iter_mut().rev() {\n                let dividend = (remainder << 32) | u64::from(*limb);\n                *limb = (dividend / u64::from(P)) as u32;\n                remainder = dividend % u64::from(P);\n            }\n            remainder as u32\n        });\n        QM31 {\n            c0: CM31::new(M31(digits[0]), M31(digits[1])),\n            c1: CM31::new(M31(digits[2]), M31(digits[3])),\n        }\n    }\n\n    fn old_pass(mut rank: [u32; 8]) -> ([u32; 8], u32) {\n        let mut remainder = 0u64;\n        for limb in rank.iter_mut().rev() {\n            let dividend = (remainder << 32) | u64::from(*limb);\n            *limb = (dividend / u64::from(P)) as u32;\n            remainder = dividend % u64::from(P);\n        }\n        (rank, remainder as u32)\n    }\n\n    fn check(block: &[u8; 32]) {\n        assert_eq!(qm31_sample(block), old_sample(block));\n        let digits = qm31_digits(block);\n        assert!(digits.iter().all(|&d| d < P));\n        let q = qm31_sample(block);\n        assert_eq!([q.c0.a.0, q.c0.b.0, q.c1.a.0, q.c1.b.0], digits);\n        let mut rank = core::array::from_fn(|i| {\n            u32::from_le_bytes(block[4 * i..4 * i + 4].try_into().unwrap())\n        });\n        for _ in 0..4 {\n            let actual = qm31_div_pass(rank);\n            assert_eq!(actual, old_pass(rank), \"complete quotient and remainder\");\n            rank = actual.0;\n        }\n    }\n\n    #[test]\n    fn quotient_writeback_and_sampler_match_at_word_boundaries() {\n        check(&[0; 32]);\n        check(&[0xff; 32]);\n        for i in 0..8 {\n            for word in [0, 1, P - 1, P, P + 1, u32::MAX] {\n                let mut block = [0; 32];\n                block[4 * i..4 * i + 4].copy_from_slice(&word.to_le_bytes());\n                check(&block);\n            }\n        }\n        for bit in 0..256 {\n            let mut block = [0; 32];\n            block[bit / 8] = 1 << (bit % 8);\n            check(&block);\n        }\n    }\n\n    #[test]\n    fn sampler_matches_independent_u128_base_p_digits() {\n        let p = u128::from(P);\n        for rank in [0, 1, p - 1, p, p + 1, p * p - 1, p * p, p.pow(4) - 1, p.pow(4)] {\n            let mut block = [0; 32];\n            block[..16].copy_from_slice(&rank.to_le_bytes());\n            let mut remainder = rank;\n            let expected = core::array::from_fn(|_| {\n                let digit = (remainder % p) as u32;\n                remainder /= p;\n                digit\n            });\n            assert_eq!(qm31_digits(&block), expected);\n            check(&block);\n        }\n    }\n\n    #[test]\n    fn quotient_writeback_and_sampler_match_deterministic_blocks() {\n        let mut state = 0x9e37_79b9_7f4a_7c15u64;\n        for _ in 0..4096 {\n            let mut block = [0; 32];\n            for chunk in block.chunks_exact_mut(8) {\n                state = state.wrapping_add(0x9e37_79b9_7f4a_7c15);\n                let mut z = state;\n                z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);\n                z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);\n                z ^= z >> 31;\n                chunk.copy_from_slice(&z.to_le_bytes());\n            }\n            check(&block);\n        }\n    }\n}\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/convert/num.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","conte