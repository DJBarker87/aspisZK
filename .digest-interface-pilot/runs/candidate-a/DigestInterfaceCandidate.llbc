{"charon_version":"0.1.223","translated":{"crate_name":"aspis_r1_digest_interface_candidate","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::r1_wire::SemanticTranscript::sample_block_validated","crate::digest::Digest32"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["core::result::Result"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/aspis-r1-digest-interface-pilot-20261016/runs/candidate-a/DigestInterfaceCandidate.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"lib.rs"},"crate_name":"aspis_r1_digest_interface_candidate","contents":"// CANDIDATE SOURCE: interface feasibility only; not unchanged release Rust.\n#![no_std]\n#![allow(dead_code)]\npub mod digest {\npub trait Digest32: Copy {\n    fn digest(&self, parts: &[&[u8]]) -> [u8; 32];\n}\n}\n\npub mod r1_wire {\nuse crate::digest::Digest32;\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Error {\n    Allocation,\n    RowOrder { expected: u8, actual: u8 },\n    InvalidRow,\n    Tag { row: u8 },\n    Length { row: u8 },\n    NonCanonical { row: u8, value: usize },\n    Boundary { round: usize },\n    Terminal,\n    EqualCirclePoints,\n    TrailingBytes,\n    Public,\n}\n\n/// Fresh R0 state, separate from Transcript's legacy all-zero IV. The\n/// C1-time binding is exactly SPEC §9: public bytes and the C1 root in one\n/// hash, with no profile/basis/nonce/registry pre-absorbs. Row 0 is empty.\n#[derive(Clone)]\npub struct SemanticTranscript<H: Digest32> {\n    state: [u8; 32],\n    hash: H,\n    next_row: u8,\n}\n\nimpl<H: Digest32> SemanticTranscript<H> {\n    fn sample_block_validated(&mut self, row: u8, framed: &[u8]) -> Result<[u8; 32], Error> {\n        if row != self.next_row {\n            return Err(Error::RowOrder {\n                expected: self.next_row,\n                actual: row,\n            });\n        }\n        // Exactly one absorb, one squeeze and one advance. Both reads\n        // use s_abs; advancing from the challenge block would be wrong.\n        let absorbed = self.hash.digest(&[&self.state, &[0, 0xa0 + row], framed]);\n        let block = self.hash.digest(&[&absorbed, &[1]]);\n        self.state = self.hash.digest(&[&absorbed, &[2]]);\n        self.next_row += 1;\n        Ok(block)\n    }\n}\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"TraitDecl":0},"value":[{"Ident":["aspis_r1_digest_interface_candidate",0]},{"Ident":["digest",0]},{"Ident":["Digest32",0]}]},{"key":{"Type":0},"value":[{"Ident":["aspis_r1_digest_interface_candidate",0]},