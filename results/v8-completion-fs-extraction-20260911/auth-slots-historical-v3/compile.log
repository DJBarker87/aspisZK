theorem AspisV8.SameBodyAuthenticatedSlots.same_body_authenticated_slots_or_failure : ∀
  (view : RawHashInput → Digest208) (body : List Byte) (query : Fin 22 → Position)
  (merkle : SuccessfulMerkleRun view query body) (c1Prefix c2Prefix : AnswerPrefix) (fullLog : OrderedRawQueryLog),
  (∀ record ∈ c1Prefix, view record.1 = record.2) →
    (∀ record ∈ c2Prefix, view record.1 = record.2) →
      TraceIncludedInLog (rawPrefix c1Prefix) fullLog →
        TraceIncludedInLog (rawPrefix c2Prefix) fullLog →
          TraceIncludedInLog (MinimalMultiproofPaths.leafLog query (wireRecords merkle.wire) ++ merkle.trace) fullLog →
            (parseRecords merkle.wire).isSome = true →
              ∀ (gamma : K),
                AuthenticationFailure view c1Prefix c2Prefix (wireRoots merkle.wire) fullLog query ∨
                  ∃ decoded,
                    parseRecords merkle.wire = some decoded ∧
                      (∀ (i : Fin 22), merkle.wire.record i = bodyRecord body i) ∧
                        ∀ (i : Fin 22) (slot : Fin 4),
                          prefixBatch c1Prefix c2Prefix merkle.wire gamma (childIndex (query i) slot) =
                              combined gamma (decoded i) slot ∧
                            prefixBatch c1Prefix c2Prefix merkle.wire gamma (childIndex (query i) slot) =
                              rawCombined gamma (merkle.wire.record i) slot :=
fun view body query merkle c1Prefix c2Prefix fullLog c1Answers c2Answers c1Included c2Included callsIncluded canonical
    gamma =>
  Option.casesOn (motive := fun t =>
    parseRecords merkle.wire = t →
      AuthenticationFailure view c1Prefix c2Prefix (wireRoots merkle.wire) fullLog query ∨
        ∃ decoded,
          parseRecords merkle.wire = some decoded ∧
            (∀ (i : Fin 22), merkle.wire.record i = bodyRecord body i) ∧
              ∀ (i : Fin 22) (slot : Fin 4),
                prefixBatch c1Prefix c2Prefix merkle.wire gamma (childIndex (query i) slot) =
                    combined gamma (decoded i) slot ∧
                  prefixBatch c1Prefix c2Prefix merkle.wire gamma (childIndex (query i) slot) =
                    rawCombined gamma (merkle.wire.record i) slot)
    (parseRecords merkle.wire)
    (fun h =>
      Eq.ndrec (motive := fun x =>
        parseRecords merkle.wire = x →
          AuthenticationFailure view c1Prefix c2Prefix (wireRoots merkle.wire) fullLog query ∨
            ∃ decoded,
              x = some decoded ∧
                (∀ (i : Fin 22), merkle.wire.record i = bodyRecord body i) ∧
                  ∀ (i : Fin 22) (slot : Fin 4),
                    prefixBatch c1Prefix c2Prefix merkle.wire gamma (childIndex (query i) slot) =
                        combined gamma (decoded i) slot ∧
                      prefixBatch c1Prefix c2Prefix merkle.wire gamma (childIndex (query i) slot) =
                        rawCombined gamma (merkle.wire.record i) slot)
        (fun hd =>
          False.elim
            (Eq.mp (Eq.trans (congrFun' (congrArg Eq (congrArg Option.isSome hd)) true) Bool.false_eq_true) canonical))
        (Eq.symm h) (Eq.refl (parseRecords merkle.wire)))
    (fun decoded h =>
      Eq.ndrec (motive := fun x =>
        parseRecords merkle.wire = x →
          AuthenticationFailure view c1Prefix c2Prefix (wireRoots merkle.wire) fullLog query ∨
            ∃ decoded,
              x = some decoded ∧
                (∀ (i : Fin 22), merkle.wire.record i = bodyRecord body i) ∧
                  ∀ (i : Fin 22) (slot : Fin 4),
                    prefixBatch c1Prefix c2Prefix merkle.wire gamma (childIndex (query i) slot) =
                        combined gamma (decoded i) slot ∧
                      prefixBatch c1Prefix c2Prefix merkle.wire gamma (childIndex (query i) slot) =
                        rawCombined gamma (merkle.wire.record i) slot)
        (fun hd =>
          have parsed := parseRecords_success merkle.wire decoded hd;
          have accepted := successful_constructs_accepted view query body merkle;
          Or.casesOn
            (accepted_all_projections_or_shared_failure view (wireRoots merkle.wire) c1Prefix c2Prefix fullLog query
              (wireRecords merkle.wire)
              (RustShapedMinimalMultiproof.frontierPairs (merkle.wire.frontiers 0) (merkle.wire.frontiers 1))
              merkle.trace c1Answers c2Answers c1Included c2Included callsIncluded accepted)
            (fun collision => Or.inl (Or.inl collision)) fun h =>
            Or.casesOn h (fun late1 => Or.inl (Or.inr (Or.inl late1))) fun h =>
              Or.casesOn h (fun late2 => Or.inl (Or.inr (Or.inr late2))) fun projections =>
                Or.inr
                  (Exists.intro decoded
                    ⟨rfl,
                      ⟨successful_record_is_body_record view query body merkle, fun i slot =>
                        have projection := wire_paired_projection c1Prefix c2Prefix merkle.wire query i (projections i);
                        ⟨batch_slots_of_paired_projection (prefixWords c1Prefix (merkle.wire.roots 0))
                            (prefixWords c2Prefix (merkle.wire.roots 1)) (query i) (merkle.wire.record i) (decoded i)
                            (parsed i) projection gamma slot,
                          raw_slots_of_paired_projection (prefixWords c1Prefix (merkle.wire.roots 0))
                            (prefixWords c2Prefix (merkle.wire.roots 1)) (query i) (merkle.wire.record i) (decoded i)
                            (parsed i) projection gamma slot⟩⟩⟩))
        (Eq.symm h) (Eq.refl (parseRecords merkle.wire)))
    (Eq.refl (parseRecords merkle.wire))
