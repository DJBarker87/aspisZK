theorem AspisV8.SameBodyAuthenticatedFold.same_body_authenticated_fold_or_failure : ∀ (view : RawHashInput → Digest208)
  (body : List Byte) (query : Fin 22 → Position) (merkle : SuccessfulMerkleRun view query body)
  (c1Prefix c2Prefix : AnswerPrefix) (fullLog : OrderedRawQueryLog),
  (∀ record ∈ c1Prefix, view record.1 = record.2) →
    (∀ record ∈ c2Prefix, view record.1 = record.2) →
      TraceIncludedInLog (rawPrefix c1Prefix) fullLog →
        TraceIncludedInLog (rawPrefix c2Prefix) fullLog →
          TraceIncludedInLog (MinimalMultiproofPaths.leafLog query (wireRecords merkle.wire) ++ merkle.trace) fullLog →
            (parseRecords merkle.wire).isSome = true →
              ∀ (d : Data) (out : List K × List M31Exact),
                LineNormBuffer.inverseLines d.a d.b d.c (SelectedQueryBuffer.points query) = some out →
                  ∀ (alpha : K),
                    AuthenticationFailure view c1Prefix c2Prefix (wireRoots merkle.wire) fullLog query ∨
                      ∃ decoded,
                        parseRecords merkle.wire = some decoded ∧
                          (∀ (i : Fin 22), merkle.wire.record i = bodyRecord body i) ∧
                            ∀ (i : Fin 22),
                              SelectedPackedQueryBridge.recordFold d decoded query out alpha i =
                                (SelectedReceivedOracle.oracle 0
                                      (SelectedQuotientOriginal.virtual d
                                        (prefixBatch c1Prefix c2Prefix merkle.wire d.gamma))).folded
                                  alpha (storedPoint (query i)) :=
fun view body query merkle c1Prefix c2Prefix fullLog c1Answers c2Answers c1Included c2Included callsIncluded canonical d
    out inverse alpha =>
  Or.casesOn
    (same_body_authenticated_slots_or_failure view body query merkle c1Prefix c2Prefix fullLog c1Answers c2Answers
      c1Included c2Included callsIncluded canonical d.gamma)
    (fun bad => Or.inl bad) fun good =>
    Exists.casesOn good fun decoded h =>
      And.casesOn h fun parsedAll right =>
        And.casesOn right fun bodyRecords slots =>
          have parsed := parseRecords_success merkle.wire decoded parsedAll;
          have checked := Eq.trans (Eq.symm (SelectedQueryBuffer.inverse_eq d query)) inverse;
          Or.inr
            (Exists.intro decoded
              ⟨parsedAll,
                ⟨bodyRecords, fun i =>
                  have actualToSource :=
                    SelectedPackedQueryBridge.matching_fold d (fun j => merkle.wire.record j) decoded parsed query out
                      (prefixBatch c1Prefix c2Prefix merkle.wire d.gamma) (fun j slot => (slots j slot).right) alpha i;
                  have sourceToQuotient :=
                    QueriedResidual.success_fold d (prefixBatch c1Prefix c2Prefix merkle.wire d.gamma) query out checked
                      alpha i;
                  Eq.trans actualToSource sourceToQuotient⟩⟩)
