theorem AspisV8.SameBodyOpenedRun.run_authenticated_opened_or_failure : ∀ (view : RawHashInput → Digest208)
  (body : List Byte) (query : Fin 22 → Position) (d : Data) (result : Output),
  run view body query d = some result →
    ∀ (c1Prefix c2Prefix : AnswerPrefix) (fullLog : OrderedRawQueryLog),
      (∀ record ∈ c1Prefix, view record.1 = record.2) →
        (∀ record ∈ c2Prefix, view record.1 = record.2) →
          TraceIncludedInLog (rawPrefix c1Prefix) fullLog →
            TraceIncludedInLog (rawPrefix c2Prefix) fullLog →
              TraceIncludedInLog (MinimalMultiproofPaths.leafLog query (wireRecords result.wire) ++ result.trace)
                  fullLog →
                ∀ (alpha : K),
                  AuthenticationFailure view c1Prefix c2Prefix (wireRoots result.wire) fullLog query ∨
                    ∀ (i : Fin 22),
                      opened result d query alpha i =
                        (SelectedReceivedOracle.oracle 0
                              (SelectedQuotientOriginal.virtual d
                                (prefixBatch c1Prefix c2Prefix result.wire d.gamma))).folded
                          alpha sorry :=
fun view body query d result success c1Prefix c2Prefix fullLog c1Answers c2Answers c1Included c2Included callsIncluded
    alpha =>
  have checks := run_checks view body query d result success;
  have canonical :=
    Eq.mpr (id (congrArg (fun _a => _a.isSome = true) checks.right.left)) (Eq.refl (some result.decoded).isSome);
  Or.casesOn
    (same_body_authenticated_fold_or_failure view body query (merkleRun view body query d result success) c1Prefix
      c2Prefix fullLog c1Answers c2Answers c1Included c2Included callsIncluded canonical d result.inverses
      checks.right.right.left alpha)
    (fun bad => Or.inl bad) fun good => sorry
