def AspisV8Completion.FSQuerySchedule.from_success : (tape : Tape) →
  (s : Transcript) → (returned : List Nat) → (reference tape 8 s [] 0).fst = some returned → Schedule :=
fun tape s returned success =>
  have facts := ⋯;
  scheduleOf returned ⋯ ⋯
