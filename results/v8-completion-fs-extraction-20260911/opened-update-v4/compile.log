theorem AspisV8.SameBodyOpenedQueryUpdate.successful_opened_query_update_or_failure : ∀
  (view : RawHashInput → Digest208) (body : List Byte) (query : Fin 22 → Position) (d : Data) (result : Output),
  run view body query d = some result →
    ∀ (c1Prefix c2Prefix : AnswerPrefix) (fullLog : OrderedRawQueryLog),
      (∀ record ∈ c1Prefix, view record.1 = record.2) →
        (∀ record ∈ c2Prefix, view record.1 = record.2) →
          TraceIncludedInLog (rawPrefix c1Prefix) fullLog →
            TraceIncludedInLog (rawPrefix c2Prefix) fullLog →
              TraceIncludedInLog (MinimalMultiproofPaths.leafLog query (wireRecords result.wire) ++ result.trace)
                  fullLog →
                ∀ (alpha prior rho : K),
                  AuthenticationFailure view c1Prefix c2Prefix (wireRoots result.wire) fullLog query ∨
                    positiveUpdate result d query alpha prior rho -
                        ∑ i, rho ^ (↑i + 1) * exactFinalLinear (finalFromWire result) (query i) =
                      prior -
                        rho *
                          ∑ i,
                            PostQueryFunctional.residual (finalFromWire result) (fun j => storedPoint (query j))
                                (fixedReceived result d c1Prefix c2Prefix alpha) i *
                              rho ^ ↑i :=
fun view body query d result success c1Prefix c2Prefix fullLog c1Answers c2Answers c1Included c2Included callsIncluded
    alpha prior rho =>
  Or.casesOn
    (run_authenticated_opened_or_failure view body query d result success c1Prefix c2Prefix fullLog c1Answers c2Answers
      c1Included c2Included callsIncluded alpha)
    (fun bad => Or.inl bad) fun values =>
    Or.inr
      (have sums :=
        Finset.sum_congr rfl fun i a =>
          have sameResidual :=
            Eq.mpr
              (id
                (congrArg
                  (fun _a =>
                    exactFinalLinear (finalFromWire result) (query i) - _a =
                      PostQueryFunctional.residual (finalFromWire result) (fun j => storedPoint (query j))
                        (fixedReceived result d c1Prefix c2Prefix alpha) i)
                  (values i)))
              (of_eq_true
                (eq_self
                  (exactFinalLinear (finalFromWire result) (query i) -
                    (SelectedReceivedOracle.oracle 0
                          (SelectedQuotientOriginal.virtual d
                            (prefixBatch c1Prefix c2Prefix result.wire d.gamma))).folded
                      alpha (storedPoint (query i)))));
          congrArg (fun x => x * rho ^ ↑i) sameResidual;
      id
        (Eq.mpr
          (id
            (congrArg
              (fun _a =>
                _a =
                  prior -
                    rho *
                      ∑ i,
                        PostQueryFunctional.residual (finalFromWire result) (fun j => storedPoint (query j))
                            (fixedReceived result d c1Prefix c2Prefix alpha) i *
                          rho ^ ↑i)
              (injectClaim_discrepancy (1 / 4) prior rho (opened result d query alpha) fun i =>
                exactFinalLinear (finalFromWire result) (query i))))
          (congrArg (fun s => prior - rho * s) sums)))
