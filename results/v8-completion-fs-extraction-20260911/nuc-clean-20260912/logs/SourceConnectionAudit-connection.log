      out.publicPair = AspisV8Completion.SameBodyPublicCorrection.pair ops z kappa out.prepared.useX ∧
        out.claim =
          ops.sub (ops.sub out.prepared.uncorrectedClaim (ops.mul out.prepared.intercept out.publicPair.fst))
            (ops.mul out.prepared.slope out.publicPair.snd) :=
fun {K} [DecidableEq K] ops w gamma kappa p0 p1 z out success =>
  Option.casesOn (motive := fun t =>
    AspisV8Completion.SameBodyOrdinary.prepare ops w gamma kappa p0 p1 = t →
      AspisV8Completion.SameBodyOrdinary.prepare ops w gamma kappa p0 p1 = some out.prepared ∧
        out.publicPair = AspisV8Completion.SameBodyPublicCorrection.pair ops z kappa out.prepared.useX ∧
          out.claim =
            ops.sub (ops.sub out.prepared.uncorrectedClaim (ops.mul out.prepared.intercept out.publicPair.fst))
              (ops.mul out.prepared.slope out.publicPair.snd))
    (AspisV8Completion.SameBodyOrdinary.prepare ops w gamma kappa p0 p1)
    (fun h =>
      Eq.ndrec (motive := fun x =>
        AspisV8Completion.SameBodyOrdinary.prepare ops w gamma kappa p0 p1 = x →
          x = some out.prepared ∧
            out.publicPair = AspisV8Completion.SameBodyPublicCorrection.pair ops z kappa out.prepared.useX ∧
              out.claim =
                ops.sub (ops.sub out.prepared.uncorrectedClaim (ops.mul out.prepared.intercept out.publicPair.fst))
                  (ops.mul out.prepared.slope out.publicPair.snd))
        (fun h =>
          False.elim
            (Eq.mp
              (Eq.trans
                (congrFun'
                  (congrArg Eq
                    (congrArg
                      (Option.map fun prepared =>
                        { prepared := prepared,
                          publicPair := AspisV8Completion.SameBodyPublicCorrection.pair ops z kappa prepared.useX,
                          claim :=
                            ops.sub
                              (ops.sub prepared.uncorrectedClaim
                                (ops.mul prepared.intercept
                                  (AspisV8Completion.SameBodyPublicCorrection.pair ops z kappa prepared.useX).fst))
                              (ops.mul prepared.slope
                                (AspisV8Completion.SameBodyPublicCorrection.pair ops z kappa prepared.useX).snd) })
                      h))
                  (some out))
                (eq_false' fun h => False.elim (noConfusion_of_Nat Option.ctorIdx h)))
              success))
        (Eq.symm h) (Eq.refl (AspisV8Completion.SameBodyOrdinary.prepare ops w gamma kappa p0 p1)))
    (fun p h =>
      Eq.ndrec (motive := fun x =>
        AspisV8Completion.SameBodyOrdinary.prepare ops w gamma kappa p0 p1 = x →
          x = some out.prepared ∧
            out.publicPair = AspisV8Completion.SameBodyPublicCorrection.pair ops z kappa out.prepared.useX ∧
              out.claim =
                ops.sub (ops.sub out.prepared.uncorrectedClaim (ops.mul out.prepared.intercept out.publicPair.fst))
                  (ops.mul out.prepared.slope out.publicPair.snd))
        (fun h =>
          Eq.mp
              (Eq.trans
                (congrFun'
                  (congrArg Eq
                    (congrArg
                      (Option.map fun prepared =>
                        { prepared := prepared,
                          publicPair := AspisV8Completion.SameBodyPublicCorrection.pair ops z kappa prepared.useX,
                          claim :=
                            ops.sub
                              (ops.sub prepared.uncorrectedClaim
                                (ops.mul prepared.intercept
                                  (AspisV8Completion.SameBodyPublicCorrection.pair ops z kappa prepared.useX).fst))
                              (ops.mul prepared.slope
                                (AspisV8Completion.SameBodyPublicCorrection.pair ops z kappa prepared.useX).snd) })
                      h))
                  (some out))
                (Option.some.injEq
                  { prepared := p, publicPair := AspisV8Completion.SameBodyPublicCorrection.pair ops z kappa p.useX,
                    claim :=
                      ops.sub
                        (ops.sub p.uncorrectedClaim
                          (ops.mul p.intercept
                            (AspisV8Completion.SameBodyPublicCorrection.pair ops z kappa p.useX).fst))
                        (ops.mul p.slope (AspisV8Completion.SameBodyPublicCorrection.pair ops z kappa p.useX).snd) }
                  out))
              success ▸
            ⟨rfl, ⟨rfl, rfl⟩⟩)
        (Eq.symm h) (Eq.refl (AspisV8Completion.SameBodyOrdinary.prepare ops w gamma kappa p0 p1)))
    (Eq.refl (AspisV8Completion.SameBodyOrdinary.prepare ops w gamma kappa p0 p1))
