theorem AspisV8Completion.FSV7PrefixBridge.chronological_old_prefixes : ∀ {A : Type} {n m q : ℕ} (tape : Tape)
  (digest : Block) (producerC1 : Transcript → Script (List UInt8) Block Root n)
  (producerC2 : Oracle → List ℕ → List ℕ → Script (List UInt8) Block Root m)
  (suffix : RootCuts → Script (List UInt8) Block A q) (out : RootCuts) (outcome : Option A),
  (continueRun tape { digest := digest, oracle := FSFirstFresh.empty } producerC1 producerC2 suffix).1 =
      some (out, outcome) →
    have final := (continueRun tape { digest := digest, oracle := FSFirstFresh.empty } producerC1 producerC2 suffix).2;
    (∀ record ∈ oldRecords (c1Records out), oldView final record.1 = record.2) ∧
      (∀ record ∈ oldRecords (c2Records out), oldView final record.1 = record.2) ∧
        TraceIncludedInLog (rawPrefix (oldRecords (c1Records out))) (oldLog final) ∧
          TraceIncludedInLog (rawPrefix (oldRecords (c2Records out))) (oldLog final) ∧
            rawPrefix (oldRecords (c1Records out)) = List.take out.c1Cut.log.length (oldLog final) ∧
              rawPrefix (oldRecords (c2Records out)) = List.take out.c2Cut.log.length (oldLog final) :=
fun {A} {n m q} tape digest producerC1 producerC2 suffix out outcome success =>
  And.casesOn (continued_prefix_answers tape digest producerC1 producerC2 suffix out outcome success) fun left right =>
    And.casesOn right fun c1Take right =>
      And.casesOn right fun c2Take right =>
        And.casesOn right fun c1Answers c2Answers =>
          have p1 :=
            raw_prefix_transport
              (continueRun tape { digest := digest, oracle := FSFirstFresh.empty } producerC1 producerC2 suffix).2
              (c1Records out) out.c1Cut.log.length c1Take;
          have p2 :=
            raw_prefix_transport
              (continueRun tape { digest := digest, oracle := FSFirstFresh.empty } producerC1 producerC2 suffix).2
              (c2Records out) out.c2Cut.log.length c2Take;
          ⟨record_transport
              (continueRun tape { digest := digest, oracle := FSFirstFresh.empty } producerC1 producerC2 suffix).2
              (c1Records out) c1Answers,
            ⟨record_transport
                (continueRun tape { digest := digest, oracle := FSFirstFresh.empty } producerC1 producerC2 suffix).2
                (c2Records out) c2Answers,
              ⟨fun input member => List.mem_of_mem_take (Eq.mp (congrArg (fun _a => input ∈ _a) p1) member),
                ⟨fun input member => List.mem_of_mem_take (Eq.mp (congrArg (fun _a => input ∈ _a) p2) member),
                  ⟨p1, p2⟩⟩⟩⟩⟩
