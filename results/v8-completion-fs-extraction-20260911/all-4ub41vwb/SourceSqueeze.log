theorem AspisV8Completion.SourceSqueeze.realised_execution : ∀ (hash : List UInt8 → Block) (s : Block),
  execute (program s) (realisedCoins hash s) =
    [(squeezeInput s, (functional hash s).fst), (advanceInput s, (functional hash s).snd)] :=
fun hash s => Eq.refl (execute (program s) (realisedCoins hash s))
theorem AspisV8Completion.SourceSqueeze.requests_fixed : ∀ (s : Block) (coins : Fin 2 → Block),
  List.map Prod.fst (execute (program s) coins) = [squeezeInput s, advanceInput s] :=
fun s coins => Eq.refl (List.map Prod.fst (execute (program s) coins))
