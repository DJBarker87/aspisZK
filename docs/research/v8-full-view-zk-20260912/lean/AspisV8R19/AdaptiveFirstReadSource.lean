import AspisV8R19.AdaptiveFirstReadLaw
import AspisV8R19.SourceOraclePrograms

/-! Byte-frame bridge for the adaptive first-read law.

The existing source `Fresh` predicate is converted into `FreshFrom` for one
actual duplex squeeze relative to the memo table generated by the complete
prior trace.  This is a local source lemma, not a claim that every squeeze in
the protocol is fresh. -/
set_option autoImplicit false
namespace AspisV8R19.AdaptiveFirstReadSource
open AspisV8PairedCommitment
open DuplexFrames SourceDuplexStep SourceOraclePrograms
open MemoizedProgramLaw AdaptiveFirstReadLaw OracleResampling
noncomputable section

def traceCache : Table Bytes State → List (Bytes × State) → Table Bytes State
  | t, [] => t
  | t, (i,a)::rest => traceCache (put t i a) rest

theorem traceCache_missing_iff (calls : List (Bytes × State))
    (t : Table Bytes State) (i : Bytes) :
    traceCache t calls i = none ↔ t i = none ∧ ∀ p ∈ calls, p.1 ≠ i := by
  induction calls generalizing t with
  | nil => simp [traceCache]
  | cons p calls ih =>
      simp only [traceCache, ih, List.mem_cons]
      by_cases hi : p.1=i
      · subst i; simp [put]
      · have hni : i ≠ p.1 := Ne.symm hi
        simp [put, hni, ne_comm]

theorem absorbProgram_fresh_iff (s : State) (label : Byte) (data : Bytes)
    (t : Table Bytes State) :
    FreshFrom (absorbProgram s label data) t ↔
      t (absorb (bytes s) label data) = none := by
  simp [absorbProgram, FreshFrom]

theorem squeezeProgram_fresh_iff (s : State) (t : Table Bytes State) :
    FreshFrom (squeezeProgram s) t ↔
    t (squeeze (bytes s)) = none ∧ t (advance (bytes s)) = none := by
  have hne : advance (bytes s) ≠ squeeze (bytes s) :=
    (cross_disjoint (bytes s) (bytes s)).symm
  simp [squeezeProgram, FreshFrom, put, hne]

theorem squeezeProgram_fresh_after_trace (tr : List (Bytes × State)) (s : State)
    (fresh : Fresh (tr.map Prod.fst) (bytes s)) :
    FreshFrom (squeezeProgram s) (traceCache (fun _ => none) tr) := by
  rw [squeezeProgram_fresh_iff]
  constructor
  · apply (traceCache_missing_iff tr (fun _ => none) (squeeze (bytes s))).mpr
    exact ⟨rfl,unread_squeeze tr s fresh⟩
  · apply (traceCache_missing_iff tr (fun _ => none) (advance (bytes s))).mpr
    exact ⟨rfl,unread_advance tr s fresh⟩

theorem fresh_squeeze_lazy_law (tr : List (Bytes × State)) (s : State)
    (fresh : Fresh (tr.map Prod.fst) (bytes s))
    (observe : View Bytes State (State × State) → ℚ) :
    lazyMean (squeezeProgram s) (traceCache (fun _ => none) tr) observe =
      independentMean (squeezeProgram s) observe :=
  lazyMean_eq_independentMean (squeezeProgram s) (traceCache (fun _ => none) tr)
    (squeezeProgram_fresh_after_trace tr s fresh) observe

#print axioms absorbProgram_fresh_iff
#print axioms traceCache_missing_iff
#print axioms squeezeProgram_fresh_iff
#print axioms squeezeProgram_fresh_after_trace
#print axioms fresh_squeeze_lazy_law
end
end AspisV8R19.AdaptiveFirstReadSource
