"},{"DocComment":""},{"DocComment":" This suffers the same restrictions and reasoning as implementing"},{"DocComment":" [`Into`], see there for details."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"TryInto"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":null}],"trait_impls":[{"def_id":0,"item_meta":{"name":[{"Ident":["aspis_v8_performance_host",0]},{"Ident":["r105_parse",0]},{"Ident":["fields",0]},{"Impl":{"Trait":0}}],"span":{"data":{"file_id":0,"beg":{"line":19,"col":31},"end":{"line":19,"col":77}},"generated_from_span":null},"source_text":"|x|K::from_le_bytes(x).ok_or(Error::Canonical)","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"impl_trait":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":915},{"Deduplicated":1848}],"const_generics":[],"trait_refs":[]}},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[],"methods":[],"vtable":null},{"def_id":1,"item_meta":{"name":[{"Ident":["aspis_v8_performance_host",0]},{"Ident":["r105_parse",0]},{"Ident":["fields",0]},{"Impl":{"Trait":1}}],"span":{"data":{"file_id":0,"beg":{"line":19,"col":31},"end":{"line":19,"col":77}},"generated_from_span":null},"source_text":"|x|K::from_le_bytes(x).ok_or(Error::Canonical)","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"impl_trait":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":915},{"Deduplicated":1848}],"const_generics":[],"trait_refs":[]}},"generics":{"regio