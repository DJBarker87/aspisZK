"StorageDead":35},"comments_before":[]},{"span":{"data":{"file_id":10,"beg":{"line":4534,"col":5},"end":{"line":4534,"col":5}},"generated_from_span":null},"id":1990,"kind":{"StorageDead":34},"comments_before":[]},{"span":{"data":{"file_id":10,"beg":{"line":4534,"col":5},"end":{"line":4534,"col":5}},"generated_from_span":null},"id":1010,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":3,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":406},"kind":"InherentImplBlock"}}},{"Ident":["is_empty",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":405}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":10,"beg":{"line":136,"col":4},"end":{"line":136,"col":40}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns `true` if the slice has a length of 0."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" assert!(!a.is_empty());"},{"DocComment":""},{"DocComment":" let b: &[i32] = &[];"},{"DocComment":" assert!(b.is_empty());"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":2888}],"output":{"Deduplicated":594}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":4,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":406},"kind":"InherentImplBlock"}}},{"Ident":["chunks_exact",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":405}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":10,"beg":{"line":1243,"col":4},"end":{"line":1243,"col":77}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns an iterator over `chunk_size` elements of the slice at a time, starting at the"},{"DocComment":" beginning of the slice."},{"DocComment":""},{"DocComment":" The chunks are slices and do not overlap. If `chunk_size` does not divide the length of the"},{"DocComment":" slice, then the last up to `chunk_size-1` elements will be omitted and can be retrieved"},{"DocComment":" from the `remainder` function of the iterator."},{"DocComment":""},{"DocComment":" Due to each chunk having exactly `chunk_size` elements, the compiler can often optimize the"},{"DocComment":" resulting code better than in the case of [`chunks`]."},{"DocComment":""},{"DocComment":" See [`chunks`] for a variant of this iterator that also returns the remainder as a smaller"},{"DocComment":" chunk, and [`rchunks_exact`] for the same iterator but starting at the end of the slice."},{"DocComment":""},{"DocComment":" If your `chunk_size` is a constant, consider using [`as_chunks`] instead, which will"},{"DocComment":" give references to arrays of exactly that length, rather than slices."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `chunk_size` is zero."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let slice = ['l', 'o', 'r', 'e', 'm'];"},{"DocComment":" let mut iter = slice.chunks_exact(2);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['l', 'o']);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['r', 'e']);"},{"DocComment":" assert!(iter.next().is_none());"},{"DocComment":" assert_eq!(iter.remainder(), &['m']);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`chunks`]: slice::chunks"},{"DocComment":" [`rchunks_exact`]: slice::rchunks_exact"},{"DocComment":" [`as_chunks`]: slice::as_chunks"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":2888},{"Deduplicated":595}],"output":{"Deduplicated":888}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":5,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["map",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":888},{"Deduplicated":914},{"Deduplicated":915}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":15,"beg":{"line":831,"col":4},"end":{"line":834,"col":34}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Takes a closure and creates an iterator which calls that closure on each"},{"DocComment":" element."},{"DocComment":""},{"DocComment":" `map()` transforms one iterator into another, by means of its argument:"},{"DocComment":" something that implements [`FnMut`]. It produces a new iterator which"},{"DocComment":" calls this closure on each element of the original iterator."},{"DocComment":""},{"DocComment":" If you are good at thinking in types, you can think of `map()` like this:"},{"DocComment":" If you have an iterator that gives you elements of some type `A`, and"},{"DocComment":" you want an iterator of some other type `B`, you can use `map()`,"},{"DocComment":" passing a closure that takes an `A` and returns a `B`."},{"DocComment":""},{"DocComment":" `map()` is conceptually similar to a [`for`] loop. However, as `map()` is"},{"DocComment":" lazy, it is best used when you're already working with other iterators."},{"DocComment":" If you're doing some sort of looping for a side effect, it's considered"},{"DocComment":" more idiomatic to use [`for`] than `map()`."},{"DocComment":""},{"DocComment":" [`for`]: ../../book/ch03-05-control-flow.html#looping-through-a-collection-with-for"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.iter().map(|x| 2 * x);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), Some(6));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you're doing some sort of side effect, prefer [`for`] to `map()`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(unused_must_use)]"},{"DocComment":" // don't do this:"},{"DocComment":" (0..5).map(|x| println!(\"{x}\"));"},{"DocComment":""},{"DocComment":" // it won't even execute, as it is lazy. Rust will warn you about this."},{"DocComment":""},{"DocComment":" // Instead, use a for-loop:"},{"DocComment":" for x in 0..5 {"},{"DocComment":"     println!(\"{x}\");"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"IteratorMap"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":888},{"Deduplicated":915}],"output":{"Deduplicated":916}},"src":{"TraitDecl":{"trait_ref":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":888}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":12}}},"is_global_initializer":null,"body":"Opaque"},{"def_id":6,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["collect",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":916},{"Deduplicated":585}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":15,"beg":{"line":2077,"col":4},"end":{"line":2079,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Transforms an iterator into a collection."},{"DocComment":""},{"DocComment":" `collect()` takes ownership of an iterator and produces whichever"},{"DocComment":" collection type you request. The iterator itself carries no knowledge of"},{"DocComment":" the eventual container; the target collection is chosen entirely by the"},{"DocComment":" type you ask `collect()` to return. This makes `collect()` one of the"},{"DocComment":" more powerful methods in the standard library, and it shows up in a wide"},{"DocComment":" variety of contexts."},{"DocComment":""},{"DocComment":" The most basic pattern in which `collect()` is used is to turn one"},{"DocComment":" collection into another. You take a collection, call [`iter`] on it,"},{"DocComment":" do a bunch of transformations, and then `collect()` at the end."},{"DocComment":""},{"DocComment":" `collect()` can also create instances of types that are not typical"},{"DocComment":" collections. For example, a [`String`] can be built from [`char`]s,"},{"DocComment":" and an iterator of [`Result<T, E>`][`Result`] items can be collected"},{"DocComment":" into `Result<Collection<T>, E>`. See the examples below for more."},{"DocComment":""},{"DocComment":" Because `collect()` is so general, it can cause problems with type"},{"DocComment":" inference. As such, `collect()` is one of the few times you'll see"},{"DocComment":" the syntax affectionately known as the 'turbofish': `::<>`. This"},{"DocComment":" helps the inference algorithm understand specifically which collection"},{"DocComment":" you're trying to collect into."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled: Vec<i32> = a.iter()"},{"DocComment":"                          .map(|x| x * 2)"},{"DocComment":"                          .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that we needed the `: Vec<i32>` on the left-hand side. This is because"},{"DocComment":" we could collect into, for example, a [`VecDeque<T>`] instead:"},{"DocComment":""},{"DocComment":" [`VecDeque<T>`]: ../../std/collections/struct.VecDeque.html"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::VecDeque;"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled: VecDeque<i32> = a.iter().map(|x| x * 2).collect();"},{"DocComment":""},{"DocComment":" assert_eq!(2, doubled[0]);"},{"DocComment":" assert_eq!(4, doubled[1]);"},{"DocComment":" assert_eq!(6, doubled[2]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using the 'turbofish' instead of annotating `doubled`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled = a.iter().map(|x| x * 2).collect::<Vec<i32>>();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because `collect()` only cares about what you're collecting into, you can"},{"DocComment":" still use a partial type hint, `_`, with the turbofish:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled = a.iter().map(|x| x * 2).collect::<Vec<_>>();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using `collect()` to make a [`String`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let chars = ['g', 'd', 'k', 'k', 'n'];"},{"DocComment":""},{"DocComment":" let hello: String = chars.into_iter()"},{"DocComment":"     .map(|x| x as u8)"},{"DocComment":"     .map(|x| (x + 1) as char)"},{"DocComment":"     .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(\"hello\", hello);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you have a list of [`Result<T, E>`][`Result`]s, you can use `collect()` to"},{"DocComment":" see if any of them failed:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let results = [Ok(1), Err(\"nope\"), Ok(3), Err(\"bad\")];"},{"DocComment":""},{"DocComment":" let result: Result<Vec<_>, &str> = results.into_iter().collect();"},{"DocComment":""},{"DocComment":" // gives us the first error"},{"DocComment":" assert_eq!(Err(\"nope\"), result);"},{"DocComment":""},{"DocComment":" let results = [Ok(1), Ok(3)];"},{"DocComment":""},{"DocComment":" let result: Result<Vec<_>, &str> = results.into_iter().collect();"},{"DocComment":""},{"DocComment":" // gives us the list of answers"},{"DocComment":" assert_eq!(Ok(vec![1, 3]), result);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`iter`]: Iterator::next"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":" [`char`]: type@char"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"iterator_collect_fn"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":916}],"output":{"Deduplicated":585}},"src":{"TraitDecl":{"trait_ref":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":916}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":30}}},"is_global_initializer":null,"body":"Opaque"},{"def_id":7,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":568},"kind":"InherentImplBlock"}}},{"Ident":["with_capacity",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":548}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":4,"beg":{"line":523,"col":4},"end":{"line":523,"col":55}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Constructs a new, empty `Vec<T>` with at least the specified capacity."},{"DocComment":""},{"DocComment":" The vector will be able to hold at least `capacity` elements without"},{"DocComment":" reallocating. This method is allowed to allocate for more elements than"},{"DocComment":" `capacity`. If `capacity` is zero, the vector will not allocate."},{"DocComment":""},{"DocComment":" It is important to note that although the returned vector has the"},{"DocComment":" minimum *capacity* specified, the vector will have a zero *length*. For"},{"DocComment":" an explanation of the difference between length and capacity, see"},{"DocComment":" *[Capacity and reallocation]*."},{"DocComment":""},{"DocComment":" If it is important to know the exact allocated capacity of a `Vec`,"},{"DocComment":" always use the [`capacity`] method after construction."},{"DocComment":""},{"DocComment":" For `Vec<T>` where `T` is a zero-sized type, there will be no allocation"},{"DocComment":" and the capacity will always be `usize::MAX`."},{"DocComment":""},{"DocComment":" [Capacity and reallocation]: #capacity-and-reallocation"},{"DocComment":" [`capacity`]: Vec::capacity"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if the new capacity exceeds `isize::MAX` _bytes_."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut vec = Vec::with_capacity(10);"},{"DocComment":""},{"DocComment":" // The vector contains no items, even though it has capacity for more"},{"DocComment":" assert_eq!(vec.len(), 0);"},{"DocComment":" assert!(vec.capacity() >= 10);"},{"DocComment":""},{"DocComment":" // These are all done without reallocating..."},{"DocComment":" for i in 0..10 {"},{"DocComment":"     vec.push(i);"},{"DocComment":" }"},{"DocComment":" assert_eq!(vec.len(), 10);"},{"DocComment":" assert!(vec.capacity() >= 10);"},{"DocComment":""},{"DocComment":" // ...but this may make the vector reallocate"},{"DocComment":" vec.push(11);"},{"DocComment":" assert_eq!(vec.len(), 11);"},{"DocComment":" assert!(vec.capacity() >= 11);"},{"DocComment":""},{"DocComment":" // A vector of a zero-sized type will always over-allocate, since no"},{"DocComment":" // allocation is necessary"},{"DocComment":" let vec_units = Vec::<()>::with_capacity(10);"},{"DocComment":" assert_eq!(vec_units.capacity(), usize::MAX);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"vec_with_capacity"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":595}],"output":{"Deduplicated":568}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":8,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":605},"kind":"InherentImplBlock"}}},{"Ident":["chunks_exact",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":604}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":10,"beg":{"line":1243,"col":4},"end":{"line":1243,"col":77}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns an iterator over `chunk_size` elements of the slice at a time, starting at the"},{"DocComment":" beginning of the slice."},{"DocComment":""},{"DocComment":" The chunks are slices and do not overlap. If `chunk_size` does not divide the length of the"},{"DocComment":" slice, then the last up to `chunk_size-1` elements will be omitted and can be retrieved"},{"DocComment":" from the `remainder` function of the iterator."},{"DocComment":""},{"DocComment":" Due to each chunk having exactly `chunk_size` elements, the compiler can often optimize the"},{"DocComment":" resulting code better than in the case of [`chunks`]."},{"DocComment":""},{"DocComment":" See [`chunks`] for a variant of this iterator that also returns the remainder as a s