+    // In mono mode, visit function bodies with the known-trait-impl resolver before
+    // restoring the empty exported method maps required by mono validation.
+    if options.monomorphize {
+        let pass = charon_lib::transform::normalize::skip_trait_refs_when_known::Transform;
+        let fun_ids = ctx.translated.fun_decls.all_indices().collect::<Vec<_>>();
+        for id in fun_ids {
+            if let Some(mut decl) = ctx.translated.fun_decls.get(id).cloned() {
+                charon_lib::transform::ctx::UllbcPass::transform_item(
+                    &pass,
+                    &mut ctx,
+                    charon_lib::ast::ItemRefMut::Fun(&mut decl),
+                );
+                if let Some(slot) = ctx.translated.fun_decls.get_mut(id) {
+                    *slot = decl;
+                }
+            }
+        }
+        let fn_trait_ids = ctx
+            .translated
+            .trait_decls
+            .iter()
+            .filter_map(|trait_decl| match trait_decl.item_meta.lang_item.as_deref() {
+                Some("fn") | Some("fn_mut") | Some("fn_once") => Some(trait_decl.def_id),
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        for timpl in ctx.translated.trait_impls.iter_mut() {
+            if fn_trait_ids.contains(&timpl.impl_trait.id) {
+                timpl.methods.clear();
+            }
+        }
+    }
