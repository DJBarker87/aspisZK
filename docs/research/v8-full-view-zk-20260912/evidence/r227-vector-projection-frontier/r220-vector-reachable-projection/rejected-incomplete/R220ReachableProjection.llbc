            }
          ],
          "span": {
            "data": {
              "file_id": 50,
              "beg": {
                "line": 35,
                "col": 0
              },
              "end": {
                "line": 35,
                "col": 34
              }
            },
            "generated_from_span": null
          },
          "source_text": null,
          "attr_info": {
            "attributes": [
              {
                "DocComment": " A wrapper around a raw non-null `*mut T` that indicates that the possessor"
              },
              {
                "DocComment": " of this wrapper owns the referent. Useful for building abstractions like"
              },
              {
                "DocComment": " `Box<T>`, `Vec<T>`, `String`, and `HashMap<K, V>`."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " Unlike `*mut T`, `Unique<T>` behaves \"as if\" it were an instance of `T`."
              },
              {
                "DocComment": " It implements `Send`/`Sync` if `T` is `Send`/`Sync`. It also implies"
              },
              {
                "DocComment": " the kind of strong aliasing guarantees an instance of `T` can expect:"
              },
              {
                "DocComment": " the referent of the pointer should not be modified without a unique path to"
              },
              {
                "DocComment": " its owning Unique."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " If you're uncertain of whether it's correct to use `Unique` for your purposes,"
              },
              {
                "DocComment": " consider using `NonNull`, which has weaker semantics."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " Unlike `*mut T`, the pointer must always be non-null, even if the pointer"
              },
              {
                "DocComment": " is never dereferenced. This is so that enums may use this forbidden value"
              },
              {
                "DocComment": " as a discriminant -- `Option<Unique<T>>` has the same size as `Unique<T>`."
              },
              {
                "DocComment": " However the pointer may still dangle if it isn't dereferenced."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " Unlike `*mut T`, `Unique<T>` is covariant over `T`. This should always be correct"
              },
              {
                "DocComment": " for any type which upholds Unique's aliasing requirements."
              }
            ],
            "inline": null,
            "rename": null,
            "public": true
          },
          "is_local": false,
          "opacity": "Foreign",
          "lang_item": null
        },
        "generics": {
