          "source_text": null,
          "attr_info": {
            "attributes": [
              {
                "DocComment": " Calculates the offset from a pointer, potentially wrapping."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " This is implemented as an intrinsic to avoid converting to and from an"
              },
              {
                "DocComment": " integer, since the conversion inhibits certain optimizations."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Safety"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " Unlike the `offset` intrinsic, this intrinsic does not restrict the"
              },
              {
                "DocComment": " resulting pointer to point into or at the end of an allocated"
              },
              {
                "DocComment": " object, and it wraps with two's complement arithmetic. The resulting"
              },
              {
                "DocComment": " value is not necessarily valid to be used to actually access memory."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " The stabilized version of this intrinsic is [`pointer::wrapping_offset`]."
              }
            ],
            "inline": null,
            "rename": null,
            "public": true
          },
          "is_local": false,
          "opacity": "Foreign",
          "lang_item": null
        },
