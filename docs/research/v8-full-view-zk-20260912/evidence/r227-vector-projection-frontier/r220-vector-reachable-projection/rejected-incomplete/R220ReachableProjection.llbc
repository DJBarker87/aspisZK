              ]
            },
            {
              "Ident": [
                "ManuallyDrop",
                0
              ]
            },
            {
              "Instantiated": {
                "params": {
                  "regions": [],
                  "types": [],
                  "const_generics": [],
                  "trait_clauses": [],
                  "regions_outlive": [],
                  "types_outlive": [],
                  "trait_type_constraints": []
                },
                "skip_binder": {
                  "regions": [],
