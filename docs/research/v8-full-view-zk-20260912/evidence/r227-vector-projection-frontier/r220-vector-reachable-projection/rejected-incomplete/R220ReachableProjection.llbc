          "attr_info": {
            "attributes": [
              {
                "DocComment": " Returns the remaining items of this iterator as a slice."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Examples"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": " let vec = vec!['a', 'b', 'c'];"
              },
              {
                "DocComment": " let mut into_iter = vec.into_iter();"
