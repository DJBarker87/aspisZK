},"crate_name":"core","contents":null},{"id":65,"name":{"Local":"../r117_affine.rs"},"crate_name":"aspis_v8_performance_host","contents":"// Same bounded partial-product affine kernel, on private canonical operands.\nimpl Q{\n    #[inline(always)]\n    pub fn affine3(constant:Self,left:&[Self;3],right:[Self;3])->Self{\n        let mut sums=constant.0.map(u64::from);\n        for i in 0..3{\n            let raw=left[i].raw(right[i]);\n            for j in 0..4{sums[j]=sums[j].wrapping_add((raw[j]&u64::from(P)).wrapping_add(raw[j]>>31));}\n        }\n        // Three partials <2^34 each plus a canonical constant: no u64 wrap.\n        Self(sums.map(reduce))\n    }\n}\n"},{"id":66,"name":{"Local":"/rustc/library/core/src/slice/iter.rs"},"crate_name":"core","contents":null},{"id":67,"name":{"Local":"/rustc/library/core/src/slice/iter/macros.rs"},"crate_name":"core","contents":null},{"id":68,"name":{"Local":"/home/dombarker/project-offloads/aspis-r20-r117-primal-20260930-a/crates/aspis-core/src/r24_guarded_qm.rs"},"crate_name":"aspis_core","contents":null},{"id":69,"name":{"Local":"/rustc/library/core/src/num/niche_types.rs"},"crate_name":"core","contents":null},{"id":70,"name":{"Local":"/rustc/library/core/src/ptr/mod.rs"},"crate_name":"core","contents":null},{"id":71,"name":{"Local":"/home/dombarker/project-offloads/aspis-r20-r117-primal-20260930-a/crates/aspis-core/src/r23_width.rs"},"crate_name":"aspis_core","contents":null},{"id":72,"name":{"Local":"/home/dombarker/project-offloads/aspis-r20-r117-primal-20260930-a/crates/aspis-core/src/r25_checked_dot.rs"},"crate_name":"aspis_core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["aspis_v8_performance_host",0]},{"Ident":["r17_host_relation",0]},{"Ident":["owned_primal",0]},{"Ident":["fold",0]}]},{"key":{"Type":0},"value":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Ident":["Vec",0]}]},{"key":{"Type":1},"value":[{"Ident":["aspis_core",0]},{"Ident":["field",0]},{"Ident":["QM31",0]}]},{"key":{"Type":