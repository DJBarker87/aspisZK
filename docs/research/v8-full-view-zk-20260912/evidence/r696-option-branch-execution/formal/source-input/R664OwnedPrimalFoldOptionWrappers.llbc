Comment":" `true`, then so does `all()`. If any of them return `false`, it"},{"DocComment":" returns `false`."},{"DocComment":""},{"DocComment":" `all()` is short-circuiting; in other words, it will stop processing"},{"DocComment":" as soon as it finds a `false`, given that no matter what else happens,"},{"DocComment":" the result will also be `false`."},{"DocComment":""},{"DocComment":" An empty iterator returns `true`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert!(a.into_iter().all(|x| x > 0));"},{"DocComment":""},{"DocComment":" assert!(!a.into_iter().all(|x| x > 2));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `false`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert!(!iter.all(|x| x != 2));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":8474},{"Deduplicated":866}],"output":{"Deduplicated":647}},"default":{"id":65,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":8414},{"Deduplicated":866},{"Deduplicated":8417}],"const_generics":[],"trait_refs":[{"Deduplicated":8477},{"HashConsedValue":[8480,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":1574},{"Deduplicated":8479},{"Deduplicated":647}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[1,41]}},{"params":{"regions":[{"index":0,"name":null,