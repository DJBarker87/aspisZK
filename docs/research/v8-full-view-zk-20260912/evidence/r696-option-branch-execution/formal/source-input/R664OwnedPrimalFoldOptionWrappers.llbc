()` uses [`IntoIterator`], we can pass"},{"DocComment":" anything that can be converted into an [`Iterator`], not just an"},{"DocComment":" [`Iterator`] itself. For example, arrays (`[T]`) implement"},{"DocComment":" [`IntoIterator`], and so can be passed to `chain()` directly:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a1 = [1, 2, 3];"},{"DocComment":" let a2 = [4, 5, 6];"},{"DocComment":""},{"DocComment":" let mut iter = a1.into_iter().chain(a2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), Some(5));"},{"DocComment":" assert_eq!(iter.next(), Some(6));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you work with Windows API, you may wish to convert [`OsStr`] to `Vec<u16>`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[cfg(windows)]"},{"DocComment":" fn os_str_to_utf16(s: &std::ffi::OsStr) -> Vec<u16> {"},{"DocComment":"     use std::os::windows::ffi::OsStrExt;"},{"DocComment":"     s.encode_wide().chain(std::iter::once(0)).collect()"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`once`]: crate::iter::once"},{"DocComment":" [`OsStr`]: ../../std/ffi/struct.OsStr.html"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":8414},{"Deduplicated":866}],"output":{"HashConsedValue":[8476,{"Adt":{"id":{"Adt":16},"generics":{"regions":[],"types":[{"Deduplicated":8414},{"HashConsedValue":[867,{"TypeVar":{"Bound":[0,1]}}]}],"const_generics":[],"trait_refs":[]}}}]}},"default":{"id":32,"generics":{"regions":[],"types":[{"Deduplicated":8414},{"Deduplicated":866},{"Deduplicated":8417},{"Deduplicated":