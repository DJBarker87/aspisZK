          "attr_info": {
            "attributes": [
              {
                "DocComment": " Division by two in canonical form. For odd x, `(x + P) / 2` is the"
              },
              {
                "DocComment": " unique field element whose double is x. Since `P = 2^31 - 1`, this is"
              },
              {
                "DocComment": " exactly a one-bit rotate within the low 31 bits, avoiding both a field"
              },
              {
                "DocComment": " multiply and an input-dependent branch."
              }
            ],
            "inline": "Always",
            "rename": null,
            "public": true
          },
