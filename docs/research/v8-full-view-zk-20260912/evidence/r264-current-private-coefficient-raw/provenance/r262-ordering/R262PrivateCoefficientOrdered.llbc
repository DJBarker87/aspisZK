            "generated_from_span": null
          },
          "source_text": "fn mul(self,r:Self)->Self{\n        // Canonical products, not arbitrary integers below 2^62: a single\n        // fold followed by one subtraction is canonical for this bound.\n        let x=u64::from(self.0)*u64::from(r.0);let s=(x&u64::from(P110))+(x>>31);\n        Self(if s>=u64::from(P110){(s-u64::from(P110))as u32}else{s as u32})\n    }",
          "attr_info": {
            "attributes": [],
            "inline": "Always",
