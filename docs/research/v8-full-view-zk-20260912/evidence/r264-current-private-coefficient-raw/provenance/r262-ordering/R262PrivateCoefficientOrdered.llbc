          },
          "source_text": "fn square(self)->Self {\n        let a=u64::from(self.0.0);let b=u64::from(self.1.0);\n        Self(B::reduce((a+b)*(a+u64::from(P110)-b)),self.0.mul(self.1).add(self.0.mul(self.1)))\n    }",
