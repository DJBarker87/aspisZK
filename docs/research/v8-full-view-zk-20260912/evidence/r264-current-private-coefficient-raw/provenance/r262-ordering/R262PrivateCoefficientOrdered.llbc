          },
          "source_text": "fn four(&self,x:B,y:B,t:B)->[C;4]{\n        let c=&self.0;let even=c[0].add(c[1].mul_m(t));\n        let odd_x=c[2].mul_m(x);let odd_y=c[3].mul_m(y);let cross=c[4].mul_m(x.mul(y));\n        let positive=even.add(odd_x);let negative=even.sub(odd_x);\n        let plus=odd_y.add(cross);let minus=odd_y.sub(cross);\n        [positive.add(plus),positive.sub(plus),negative.sub(minus),negative.add(minus)]\n    }",
          "attr_info": {
            "attributes": [],
            "inline": "Always",
            "rename": null,
            "public": false
