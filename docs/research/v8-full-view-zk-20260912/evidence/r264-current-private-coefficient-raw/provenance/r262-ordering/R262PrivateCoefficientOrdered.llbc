            "generated_from_span": null
          },
          "source_text": "fn new([a,b,c]:[K;3])->Option<Self>{\n        let a=[C::input(a.c0)?,C::input(a.c1)?];let b=[C::input(b.c0)?,C::input(b.c1)?];let c=[C::input(c.c0)?,C::input(c.c1)?];\n        let norm=|x:[C;2]|x[0].square().sub(x[1].square().times_r());\n        let polar=|x:[C;2],y:[C;2]|x[0].mul(y[0]).sub(x[1].mul(y[1]).times_r()).double();\n        let nc=norm(c);let half=norm(b).sub(nc).half();\n        Some(Self([norm(a).add(nc).add(half),half,polar(a,b),polar(a,c),polar(b,c)]))\n    }",
          "attr_info": {
            "attributes": [],
            "inline": null,
            "rename": null,
            "public": false
          },
