            "generated_from_span": null
          },
          "source_text": "fn mul(self,r:Self)->Self {\n        const PP:u64=(P110 as u64)*(P110 as u64);\n        let (a,b,c,d)=(u64::from(self.0.0),u64::from(self.1.0),u64::from(r.0.0),u64::from(r.1.0));\n        // PP dominates b*d; both representatives are below 2*PP < 2^63.\n        Self(B::reduce((a*c).wrapping_add(PP).wrapping_sub(b*d)),B::reduce((a*d).wrapping_add(b*c)))\n    }",
          "attr_info": {
            "attributes": [],
            "inline": "Always",
            "rename": null,
            "public": false
