               word_index += 1;\n                let masked = word & crate::field::P;\n                if masked != crate::field::P {\n                    *limb = M31(masked);\n                    accepted = true;\n                    break;\n                }\n            }\n            if !accepted {\n                return Err(ChallengeSampleExhausted);\n            }\n        }\n        Ok(QM31 {\n            c0: crate::field::CM31 {\n                a: limbs[0],\n                b: limbs[1],\n            },\n            c1: crate::field::CM31 {\n                a: limbs[2],\n                b: limbs[3],\n            },\n        })\n    }","attr_info":{"attributes":[{"DocComment":" Sample a QM31 challenge by per-limb rejection sampling (exactly"},{"DocComment":" uniform; soundness-note §3 T9)."},{"DocComment":""},{"DocComment":" Each limb draw takes 31 bits of a LE u32 and REJECTS the single"},{"DocComment":" non-canonical value P, redrawing from fresh transcript bytes: retries"},{"DocComment":" consume the next word of the block stream, and a spent block is"},{"DocComment":" replaced via `squeeze_block`, which advances the duplex state — no"},{"DocComment":" input is ever re-hashed, so retries cannot repeat a rejected value"},{"DocComment":" deterministically. The retry loop is bounded (`CHALLENGE_RETRY_LIMIT`)"},{"DocComment":" and exhaustion is an error the verifier surfaces as proof rejection:"},{"DocComment":" per-limb exhaustion probability is (2^-31)^8 = 2^-248, a completeness"},{"DocComment":" event (soundness-note §6), the correct trade on a CU-metered chain"},{"DocComment":" versus an unmetered loop."},{"DocComment":""},{"DocComment":" In the non-rejecting case (all real transcripts, whp) this consumes"},{"DocComment":" exactly one block and produces the same limbs as the pre-fix sampler"},{"DocComment":" except on a P-hit, where the old code folded P to 0 (the ~2^-31"},{"DocComment":" per-limb bias this fix removes)."}],"inline":null,"rename":null,"pu