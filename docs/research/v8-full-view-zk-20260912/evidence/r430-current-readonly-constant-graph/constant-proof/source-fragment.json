            {
              "DocComment": " `false` if its [size](size_of) is greater than zero."
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " # Examples"
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " ```"
            },
            {
              "DocComment": " #![feature(sized_type_properties)]"
            },
            {
              "DocComment": " use core::mem::SizedTypeProperties;"
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " fn do_something_with<T>() {"
            },
            {
              "DocComment": "     if T::IS_ZST {"
            },
            {
              "DocComment": "         // ... special approach ..."
            },
            {
              "DocComment": "     } else {"
            },
            {
              "DocComment": "         // ... the normal thing ..."
            },
            {
              "DocComment": "     }"
            },
            {
              "DocComment": " }"
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " struct MyUnit;"
            },
            {
              "DocComment": " assert!(MyUnit::IS_ZST);"
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " // For negative checks, consider using UFCS to emphasize the negation"
