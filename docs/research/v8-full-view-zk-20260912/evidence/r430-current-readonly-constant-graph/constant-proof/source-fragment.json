        "attr_info": {
          "attributes": [
            {
              "DocComment": " The size of a type in bytes."
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " Note that, unlike most intrinsics, this is safe to call;"
            },
            {
              "DocComment": " it does not require an `unsafe` block."
            },
            {
              "DocComment": " Therefore, implementations must not require the user to uphold"
            },
            {
              "DocComment": " any safety invariants."
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " More specifically, this is the offset in bytes between successive"
            },
            {
              "DocComment": " items of the same type, including alignment padding."
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " Note that, unlike most intrinsics, this can only be called at compile-time"
            },
            {
              "DocComment": " as backends do not have an implementation for it. The only caller (its"
            },
            {
              "DocComment": " stable counterpart) wraps this intrinsic call in a `const` block so that"
            },
            {
              "DocComment": " backends only see an evaluated constant."
            },
            {
              "DocComment": ""
            },
            {
              "DocComment": " The stabilized version of this intrinsic is [`core::mem::size_of`]."
            }
          ],
          "inline": null,
          "rename": null,
          "public": true
        },
        "is_local": false,
        "opacity": "Foreign",
        "lang_item": null
