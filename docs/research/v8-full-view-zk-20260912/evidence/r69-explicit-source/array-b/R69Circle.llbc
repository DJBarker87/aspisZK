e`."},{"DocComment":""},{"DocComment":" An empty iterator returns `false`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert!(a.into_iter().any(|x| x > 0));"},{"DocComment":""},{"DocComment":" assert!(!a.into_iter().any(|x| x > 5));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `true`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert!(iter.any(|x| x != 2));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"F"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":9610},{"Deduplicated":9616}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":21,"beg":{"line":2888,"col":11},"end":{"line":2888,"col":36}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":9611},{"HashConsedValue":[9655,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":9616}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":571}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[9741,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":9610},"Mut"]}]},{"Deduplicated":9611}],"output":{"Deduplicated":571}},"src":{"TraitDecl":{"trait_ref":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":9610},{"Deduplicated":9616}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":42}}},"is_global_initializer":null,"body":"Opaque"},{"def_id":43,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":1080}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":2097},"kind":"InherentImplBlock"}}},{"Ident":["map",0]}],"span":{"data":{"file_id":26,"beg":{"line":592,"col":4},"end":{"line":596,"col":28}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns an array of the same size as `self`, with function `f` applied to each element"},{"DocComment":" in order."},{"DocComment":""},{"DocComment":" If you don't necessarily need a new fixed-size array, consider using"},{"DocComment":" [`Iterator::map`] instead."},{"DocComment":""},{"DocComment":""},{"DocComment":" # Note on performance and stack usage"},{"DocComment":""},{"DocComment":" Note that this method is *eager*.  It evaluates `f` all `N` times before"},{"DocComment":" returning the new array."},{"DocComment":""},{"DocComment":" That means that `arr.map(f).map(g)` is, in general, *not* equivalent to"},{"DocComment":" `array.map(|x| g(f(x)))`, as the former calls `f` 4 times then `g` 4 times,"},{"DocComment":" whereas the latter interleaves the calls (`fgfgfgfg`)."},{"DocComment":""},{"DocComment":" A consequence of this is that it can have fairly-high stack usage, especially"},{"DocComment":" in debug mode or for long arrays.  The backend may be able to optimize it"},{"DocComment":" away, but especially for complicated mappings it might not be able to."},{"DocComment":""},{"DocComment":" If you're doing a one-step `map` and really want an array as the result,"},{"DocComment":" then absolutely use this method.  Its implementation uses a bunch of tricks"},{"DocComment":" to help the optimizer handle it well.  Particularly for simple arrays,"},{"DocComment":" like `[u8; 3]` or `[f32; 4]`, there's nothing to be concerned about."},{"DocComment":""},{"DocComment":" However, if you don't actually need an *array* of the results specifically,"},{"DocComment":" just to process them, then you likely want [`Iterator::map`] instead."},{"DocComment":""},{"DocComment":" For example, rather than doing an array-to-array map of all the elements"},{"DocComment":" in the array up-front and only iterating after that completes,"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # let my_array = [1, 2, 3];"},{"DocComment":" # let f = |x: i32| x + 1;"},{"DocComment":" for x in my_array.map(f) {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It's often better to use an iterator along the lines of"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # let my_array = [1, 2, 3];"},{"DocComment":" # let f = |x: i32| x + 1;"},{"DocComment":" for x in my_array.into_iter().map(f) {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" as that's more likely to avoid large temporaries."},{"DocComment":""},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = [1, 2, 3];"},{"DocComment":" let y = x.map(|v| v + 1);"},{"DocComment":" assert_eq!(y, [2, 3, 4]);"},{"DocComment":""},{"DocComment":" let x = [1, 2, 3];"},{"DocComment":" let mut temp = 0;"},{"DocComment":" let y = x.map(|v| { temp += 1; v * temp });"},{"DocComment":" assert_eq!(y, [1, 4, 9]);"},{"DocComment":""},{"DocComment":" let x = [\"Ferris\", \"Bueller's\", \"Day\", \"Off\"];"},{"DocComment":" let y = x.map(|v| v.len());"},{"DocComment":" assert_eq!(y, [6, 9, 3, 3]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T"},{"index":1,"name":"F"},{"index":2,"name":"U"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":1080}}],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":26,"beg":{"line":594,"col":11},"end":{"line":594,"col":32}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":9611},{"HashConsedValue":[9673,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":9610}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":9616}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":26,"beg":{"line":594,"col":35},"end":{"line":594,"col":51}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":9611}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":26,"beg":{"line":595,"col":11},"end":{"line":595,"col":27}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":9616}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"data":{"file_id":26,"beg":{"line":596,"col":11},"end":{"line":596,"col":27}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":9610}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[966