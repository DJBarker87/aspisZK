text":"pub fn secure_circle_point_from_parameter(\n    parameter: QM31,\n) -> Result<SecureCirclePoint, CirclePointError> {\n    let square = parameter.square();\n    let inverse_denominator = QM31::ONE\n        .add(square)\n        .try_inv()\n        .ok_or(CirclePointError::SingularParameter)?;\n    Ok(SecureCirclePoint {\n        x: QM31::ONE.sub(square).mul(inverse_denominator),\n        y: parameter.add(parameter).mul(inverse_denominator),\n    })\n}","attr_info":{"attributes":[{"DocComment":" Apply the rational circle parameterization"},{"DocComment":""},{"DocComment":" `x = (1 - t^2)/(1 + t^2), y = 2t/(1 + t^2)`."},{"DocComment":""},{"DocComment":" This pure algebra helper accepts parameters from any subfield, but returns"},{"DocComment":" an explicit error when the denominator is zero. It never calls the"},{"DocComment":" panicking inverse API."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":348}],"output":{"Deduplicated":403}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":4,"beg":{"line":34,"col":0},"end":{"line":46,"col":1}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":4,"beg":{"line":36,"col":5},"end":{"line":36,"col":48}},"generated_from_span":null},"ty":{"Deduplicated":403}},{"index":1,"name":"parameter","span":{"data":{"file_id":4,"beg":{"line":35,"col":4},"end":{"line":35,"col":13}},"generated_from_span":null},"ty":{"Deduplicated":348}},{"index":2,"name":"square","span":{"data":{"file_id":4,"beg":{"line":37,"col":8},"end":{"line":37,"col":14}},"generated_from_span":null},"ty":{"Deduplicated":348}},{"index":3,"name":null,"span":{"d