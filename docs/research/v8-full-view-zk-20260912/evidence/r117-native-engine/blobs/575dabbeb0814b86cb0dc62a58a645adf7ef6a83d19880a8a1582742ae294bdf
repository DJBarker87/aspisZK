//! Same exact folded inverse, with canonical arithmetic across coefficient work.
use super::*;
#[path="r81_canonical_basis.rs"] mod private;
use private::Q as CQ;
fn input(v:K)->Option<CQ>{CQ::from_limbs([v.c0.a.0,v.c0.b.0,v.c1.a.0,v.c1.b.0])}
fn output(v:CQ)->K{let [a,b,c,d]=v.limbs();K{c0:CM31::new(M31(a),M31(b)),c1:CM31::new(M31(c),M31(d))}}
fn conjugate(v:K)->K{K{c0:v.c0,c1:v.c1.neg()}}
struct Prepared {even:CQ,x:[CQ;2],y:[CQ;2],cross:[CQ;2]}
impl Prepared {
    fn new(abc:[K;3],alpha:K)->Option<Self>{
        let [a,b,c]=abc;let a=input(conjugate(a))?;let b=input(conjugate(b))?;let c=input(conjugate(c))?;
        let alpha=input(alpha)?;let a2=alpha.square();let a3=a2.mul(alpha);let ca2=c.mul(a2);
        Some(Self{even:a.add(b.mul(a2)).add(c.mul(alpha)).half().half(),
            x:[a.mul(a2).add(c.mul(a3)),b],y:[a.mul(alpha).add(b.mul(a3)),c],
            cross:[a.mul(a3).add(ca2),b.mul(alpha).sub(ca2)]})
    }
    fn four(&self,x:M31,y:M31,ix:M31,iy:M31)->Option<[CQ;4]>{
        let cx=self.x[0].mul_m31(ix.half().0)?.add(self.x[1].mul_m31(x.half().half().0)?);
        let cy=self.y[0].mul_m31(iy.half().0)?.add(self.y[1].mul_m31(y.half().half().0)?);
        let cross=self.cross[0].mul_m31(ix.mul(iy).0)?
            .add(self.cross[1].mul_m31(x.mul(iy).half().0)?);
        let positive=self.even.add(cx);let negative=self.even.sub(cx);
        let plus=cy.add(cross);let minus=cy.sub(cross);
        Some([positive.add(plus),positive.sub(plus),negative.sub(minus),negative.add(minus)])
    }
}
pub(super) fn inverse(selected:&Selected,values:&[K],abc:[K;3],base:&[M31],lines:&[M31],alpha:K)->Result<Vec<K>,Error>{
    let (norms,base_inv)=super::norm_inverse(selected,values,abc,base,lines)?;
    let coeff=Prepared::new(abc,alpha).ok_or(Error::Domain)?;
    let mut out=Vec::with_capacity(values.len());
    for (i,p) in selected.points().iter().enumerate(){
        let weights=coeff.four(p.x,p.y,base_inv[2*i],base_inv[2*i+1]).ok_or(Error::Domain)?;
        for (j,v) in weights.into_iter().enumerate(){
            let ni=norms[4*i+j];out.push(output(v.mul_complex(ni.a.0,ni.b.0).ok_or(Error::Domain)?));
        }
    }
    Ok(out)
}
