 the"},{"DocComment":" calculation would result in an overflow."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let items = vec![0_u16, 1, 2];"},{"DocComment":""},{"DocComment":" let res: Option<Vec<u16>> = items"},{"DocComment":"     .iter()"},{"DocComment":"     .map(|x| x.checked_add(1))"},{"DocComment":"     .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(res, Some(vec![1, 2, 3]));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" As you can see, this will return the expected, valid items."},{"DocComment":""},{"DocComment":" Here is another example that tries to subtract one from another list"},{"DocComment":" of integers, this time checking for underflow:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let items = vec![2_u16, 1, 0];"},{"DocComment":""},{"DocComment":" let res: Option<Vec<u16>> = items"},{"DocComment":"     .iter()"},{"DocComment":"     .map(|x| x.checked_sub(1))"},{"DocComment":"     .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(res, None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since the last element is zero, it would underflow. Thus, the resulting"},{"DocComment":" value is `None`."},{"DocComment":""},{"DocComment":" Here is a variation on the previous example, showing that no"},{"DocComment":" further elements are taken from `iter` after the first `None`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let items = vec![3_u16, 2, 1, 10];"},{"DocComment":""},{"DocComment":" let mut shared = 0;"},{"DocComment":""},{"DocComment":" let res: Option<Vec<u16>> = items"},{"DocComment":"     .iter()"},{"DocComment":"     .map(|x| { shared += x; x.checked_sub(2) })"},{"DocComment":"     .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(res, None);"},{"DocComment":" assert_eq!(shared, 6);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since the third element caused an underflow, no further elements were taken,"},{"DocComment":" so the final value of `shared` is 6 (= `3 + 2 + 1`), not 16."}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"A"},{"index":1,"name":"V"},{"index":2,"name":"I"},{"index":3,"name":"Clause1_IntoIter"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":19,"beg":{"line":2700,"col":11},"end":{"line":2700,"col":26}},"generated_from_span":null},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":12787},{"Deduplicated":12786}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":2762,"col":20},"end":{"line":2762,"col":50}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":12788},{"Deduplicated":12791},{"Deduplicated":12789}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":12788}],"output":{"Deduplicated":12882}},"src":{"TraitImpl":{"impl_ref":{"id":35,"generics":{"regions":[],"types":[{"Deduplicated":12786},{"Deduplicated":12787}],"const_generics":[],"trait_refs":[{"HashConsedValue":[12883,{"kind":{"Clause":{"Free":0}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":12787},{"Deduplicated":12786}],"const_generics":[],"trait_refs":[]}}}}]}]}},"trait_ref":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":12882},{"Deduplicated":12791}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":0},"reuses_default":true}},"is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":19,"beg":{"line":2762,"col":4},"end":{"line":2764,"col":5}},"generated_from_span":null},"bound_body_regions":2,"locals":{"arg_count":1,"locals":[{"index