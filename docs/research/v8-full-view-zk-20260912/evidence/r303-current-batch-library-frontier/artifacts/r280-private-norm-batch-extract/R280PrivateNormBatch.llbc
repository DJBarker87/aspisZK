ult will also be `true`."},{"DocComment":""},{"DocComment":" An empty iterator returns `false`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert!(a.into_iter().any(|x| x > 0));"},{"DocComment":""},{"DocComment":" assert!(!a.into_iter().any(|x| x > 5));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `true`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert!(iter.any(|x| x != 2));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"F"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":4,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":12786},{"Deduplicated":12788}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":21,"beg":{"line":2888,"col":11},"end":{"line":2888,"col":36}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":12787},{"HashConsedValue":[12815,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":12788}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":775}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outliv