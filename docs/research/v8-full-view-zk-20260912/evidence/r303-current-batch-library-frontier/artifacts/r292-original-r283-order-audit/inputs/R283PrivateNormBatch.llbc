tor yields all items from start to end."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = &[1, 2, 4];"},{"DocComment":" let mut iterator = x.iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iterator.next(), Some(&1));"},{"DocComment":" assert_eq!(iterator.next(), Some(&2));"},{"DocComment":" assert_eq!(iterator.next(), Some(&4));"},{"DocComment":" assert_eq!(iterator.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"slice_iter"},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":7512}],"output":{"HashConsedValue":[7504,{"Adt":{"id":{"Adt":6},"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":7501}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":3,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["chain",0]}],"span":{"data":{"file_id":19,"beg":{"line":510,"col":4},"end":{"line":513,"col":51}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Takes two iterators and creates a new iterator over both in sequence."},{"DocComment":""},{"DocComment":" `chain()` will return a new iterator which will first iterate over"},{"DocComment":" values from the first iterator and then over values from the second"},{"DocComment":" iterator."},{"DocComment":""},{"DocComment":" In other words, it links two iterators together, in a chain. 🔗"},{"DocComment":""},{"DocComment":" [`once`] is commonly used to adapt a single value into a chain of"},{"DocComment":" other kinds of iteration."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s1 = \"abc\".chars();"},{"DocComment":" let s2 = \"def\".chars();"},{"DocComment":""},{"DocComment":" let mut iter = s1.chain(s2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some('a'));"},{"DocComment":" assert_eq!(iter.next(), Some('b'));"},{"DocComment":" assert_eq!(iter.next(), Some('c'));"},{"DocComment":" assert_eq!(iter.next(), Some('d'));"},{"DocComment":" assert_eq!(iter.next(), Some('e'));"},{"DocComment":" assert_eq!(iter.next(), Some('f'));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since the argument to `chain()` uses [`IntoIterator`], we can pass"},{"DocComment":" anything that can be converted into an [`Iterator`], not just an"},{"DocComment":" [`Iterator`] itself. For example, arrays (`[T]`) implement"},{"DocComment":" [`IntoIterator`], and so can be passed to `chain()` directly:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a1 = [1, 2, 3];"},{"DocComment":" let a2 = [4, 5, 6];"},{"DocComment":""},{"DocComment":" let mut iter = a1.into_iter().chain(a2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), Some(5));"},{"DocComment":" assert_eq!(iter.next(), Some(6));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you work with Windows API, you may wish to convert [`OsStr`] to `Vec<u16>`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[cfg(windows)]"},{"DocComment":" fn os_str_to_utf16(s: &std::ffi::OsStr) -> Vec<u16> {"},{"DocComment":"     use std::os::windows::ffi::OsStrExt;"},{"DocComment":"     s.encode_wide().chain(std::iter::once(0)).collect()"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`once`]: crate::iter::once"},{"DocComment":" [`OsStr`]: ../../std/ffi/struct.OsStr.html"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"U"},{"index":2,"name":"Clause0_Item"},{"index":3,"name":"Clause1_IntoIter"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":4,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":7501},{"HashConsedValue":[7516,{"TypeVar":{"Free":2}}]}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":513,"col":11},"end":{"line":513,"col":50}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":7502},{"Deduplicated":7516},{"HashConsedValue":[7543,{"TypeVar":{"Free":3}}]}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":7501},{"Deduplicated":7502}],"output":{"HashConsedValue":[7594,{"Adt":{"id":{"Adt":5},"generics":{"regions":[],"types":[{"Deduplicated":7501},{"Deduplicated":7543}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitDecl":{"trait_ref":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":7501},{"Deduplicated":7516}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":8}}},"is_global_initializer":null,"body":"Opaque"},{"def_id":4,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["any",0]}],"span":{"data":{"file_id":19,"beg":{"line":2885,"col":4},"end":{"line":2888,"col":37}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Tests if any element of the iterator matches a predicate."},{"DocComment":""},{"DocComment":" `any()` takes a closure that returns `true` or `false`. It applies"},{"DocComment":" this closure to each element of the iterator, and if any of them return"},{"DocComment":" `true`, then so does `any()`. If they all return `false`, it"},{"DocComment":" returns `false`."},{"DocComment":""},{"DocComment":" `any()` is short-circuiting; in other words, it will stop processing"},{"DocComment":" as soon as it finds a `true`, given that no matter what else happens,"},{"DocComment":" the result will also be `true`."},{"DocComment":""},{"DocComment":" An empty iterator returns `false`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert!(a.into_iter().any(|x| x > 0));"},{"DocComment":""},{"DocComment":" assert!(!a.into_iter().any(|x| x > 5));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `true`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert!(iter.any(|x| x != 2));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"F"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":4,"beg":{"line":1,"col":0},"end":{"