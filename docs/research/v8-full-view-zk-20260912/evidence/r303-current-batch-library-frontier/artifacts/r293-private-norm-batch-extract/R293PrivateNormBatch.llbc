},{"DocComment":""},{"DocComment":" assert_eq!(first_number, Some(2));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":14181},{"Deduplicated":1766}],"output":{"Deduplicated":1969}},"default":{"id":65,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":14142},{"Deduplicated":1193},{"Deduplicated":1766},{"Deduplicated":14143}],"const_generics":[],"trait_refs":[{"Deduplicated":14320},{"HashConsedValue":[14268,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":1765},{"Deduplicated":14259},{"Deduplicated":2952}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[0,44]}},null,{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"P"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":19,"beg":{"line":3137,"col":11},"end":{"line":3137,"col":36}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":2403},{"Deduplicated":14259},{"Deduplicated":596}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"position","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["position",0]}],"span":{"data":{"file_id":19,"beg":{"line":3134,"col":4},"end":{"line":3137,"col":37}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Searches for an element in an iterator, returning its index."},{"DocComment":""},{"DocComment":" `position()` takes a closure that returns `true` or `false`. It applies"},{"DocComment":" this closure to each element of the iterator, and if one of them"},{"DocComment":" returns `true`, then `position()` returns [`Some(index)`]. If all of"},{"DocComment":" them return `false`, it returns [`None`]."},{"DocComment":""},{"DocComment":" `position()` is short-circuiting; in other words, it will stop"},{"DocComment":" processing as soon as it finds a `true`."},{"DocComment":""},{"DocComment":" # Overflow Behavior"},{"DocComment":""},{"DocComment":" The method does no guarding against overflows, so if there are more"},{"DocComment":" than [`usize::MAX`] non-matching elements, it either produces the wrong"},{"DocComment":" result or panics. If overflow checks are enabled, a panic is"},{"DocComment":" guaranteed."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" This function might panic if the iterator has more than `usize::MAX`"},{"DocComment":" non-matching elements."},{"DocComment":""},{"DocComment":" [`Some(index)`]: Some"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert_eq!(a.into_iter().position(|x| x == 2), Some(1));"},{"DocComment":""},{"DocComment":" assert_eq!(a.into_iter().position(|x| x == 5), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `true`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3, 4];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.position(|x| x >= 2), Some(1));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":""},{"DocComment":" // The returned index depends on iterator state"},{"DocComment":" assert_eq!(iter.position(|x| x == 4), Some(0));"},{"DocComment":""},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":14181},{"Deduplicated":1193}],"output":{"Deduplicated":1038}},"default":{"id":67,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":14142},{"Deduplicated":1193},{"Deduplicated":14143}],"const_generics":[],"trait_refs":[{"Deduplicated":14320},{"Deduplicated":14264}]}}},"kind":{"TraitMethod":[0,46]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"P"},{"index":1,"name":"Clause1_Clause0_Item"},{"index":2,"name":"Clause2_Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":19,"beg":{"line":3202,"col":11},"end":{"line":3202,"col":36}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":2403},{"Deduplicated":14259},{"Deduplicated":596}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":3203,"col":22},"end":{"line":3203,"col":39}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":15,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":1765}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":19,"beg":{"line":3203,"col":42},"end":{"line":3203,"col":61}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":3129}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"rposition","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["rposition",0]}],"span":{"data":{"file_id":19,"beg":{"line":3200,"col":4},"end":{"line":3203,"col":62}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Searches for an element in an iterator from the right, returning its"},{"DocComment":" index."},{"DocComment":""},{"DocComment":" `rposition()` takes a closure that returns `true` or `false`. It applies"},{"DocComment":" this closure to each element of the iterator, starting from the end,"},{"DocComment":" and if one of them returns `true`, then `rposition()` returns"},{"DocComment":" [`Some(index)`]. If all of them return `false`, it returns [`None`]."},{"DocComment":""},{"DocComment":" `rposition()` is short-circuiting; in other words, it will stop"},{"DocComment":" processing as soon as it finds a `true`."},{"DocComment":""},{"DocComment":" [`Some(index)`]: Some"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert_eq!(a.into_iter().rposition(|x| x == 3), Some(2));"},{"DocComment":""},{"DocComment":" assert_eq!(a.into_iter().rposition(|x| x == 5), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `true`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1, 2, 3, 4];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.rposition(|x| x >= 2), Some(3));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(-1));"},{"DocComment":" assert_eq!(iter.next_back(), Some(3));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":14181},{"Deduplicated":1193}],"output":{"Deduplicated":1038}},"default":{"id":68,"generi