le_id":19,"beg":{"line":260,"col":20},"end":{"line":260,"col":36}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":14143}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":14142}],"output":{"Deduplicated":14145}},"src":{"TraitDecl":{"trait_ref":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":14143}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":4}}},"is_global_initializer":null,"body":"Opaque"},{"def_id":28,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["advance_by",0]}],"span":{"data":{"file_id":19,"beg":{"line":310,"col":4},"end":{"line":310,"col":68}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Advances the iterator by `n` elements."},{"DocComment":""},{"DocComment":" This method will eagerly skip `n` elements by calling [`next`] up to `n`"},{"DocComment":" times until [`None`] is encountered."},{"DocComment":""},{"DocComment":" `advance_by(n)` will return `Ok(())` if the iterator successfully advances by"},{"DocComment":" `n` elements, or a `Err(NonZero<usize>)` with value `k` if [`None`] is encountered,"},{"DocComment":" where `k` is remaining number of steps that could not be advanced because the iterator ran out."},{"DocComment":" If `self` is empty and `n` is non-zero, then this returns `Err(n)`."},{"DocComment":" Otherwise, `k` is always less than `n`."},{"DocComment":""},{"DocComment":" Calling `advance_by(0)` can do meaningful work, for example [`Flatten`]"},{"DocComment":" can advance its outer iterator until it finds an inner iterator that is not empty, which"},{"DocComment":" then often allows it to return a more accurate `size_hint()` than in its initial state."},{"DocComment":""},{"DocComment":" [`Flatten`]: crate::iter::Flatten"},{"DocComment":" [`next`]: Iterator::next"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_advance_by)]"},{"DocComment":""},{"DocComment":" use std::num::NonZero;"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3, 4];"},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.advance_by(2), Ok(()));"},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" assert_eq!(iter.advance_by(0), Ok(()));"},{"DocComment":" assert_eq!(iter.advance_by(100), Err(NonZero::new(99).unwrap())); // only `4` was skipped"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":4,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":14143}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":14154},{"Deduplicated":854}],"output":{"HashConsedValue":[13053,{"Adt":{"id":{"Adt":1},"generics":{"regions":[],"types":[{"Deduplicated":594},{"HashConsedValue":[13052,{"Adt":{"id":{"Adt":16},"generics":{"regions":[],"types":[{"Deduplicated":854},{"HashConsedValue":[6403,{"Adt":{"id":{"Adt":50},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}],"const_generics":[],"trait_refs":[]}}}]}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitDecl":{"trait_ref":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":14143}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":5}}},"is_global_initializer":null,"body":"Opaque"},{"def_id":29,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["nth",0]}],"span":{"data":{"file_id":19,"beg":{"line":388,"col":4},"end":{"line":388,"col":53}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the `n`th element of the iterator."},{"DocComment":""},{"DocComment":" Like most indexing operations, the count starts from zero, so `nth(0)`"},{"DocComment":" returns the first value, `nth(1)` the second, and so on."},{"DocComment":""},{"DocComment":" Note that all preceding elements, as well as the returned element, will be"},{"DocComment":" consumed from the iterator. That means that the preceding elements will be"},{"DocComment":" discarded, and also that calling `nth(0)` multiple times on the same iterator"},{"DocComment":" will return different elements."},{"DocComment":""},{"DocComment":" `nth()` will return [`None`] if `n` is greater than or equal to the length of the"},{"DocComment":" iterator."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" assert_eq!(a.into_iter().nth(1), Some(2));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Calling `nth()` multiple times doesn't rewind the iterator:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.nth(1), Some(2));"},{"DocComment":" assert_eq!(iter.nth(1), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Returning `None` if there are less than `n + 1` elements:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" assert_eq!(a.into_iter().nth(10), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":4,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":14143}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":14154},{"Deduplicated":854}],"output":{"Deduplicated":14145}},"src":{"TraitDecl":{"trait_ref":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":14143}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":6}}},"is_global_initializer":null,"body":"Opaque"},null,null,null,null,null,{"def_id":35,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["for_each",0]}],"span":{"data":{"file_id":19,"beg":{"line":877,"col":4},"end":{"line":880,"col":29}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Calls a closure on each element of an iterator."},{"DocComment":""},{"DocComment":" This is equivalent to using a [`for`] loop on the iterator, although"},{"DocComment":" `break` and `continue` are not possible from a closure. It's generally"},{"DocComment":" more idiomatic to use a `for` loop, but `for_each` may be more legible"},{"DocComment":" when processing items at the end of longer iterator chains. In some"},{"DocComment":" cases `for_each` may also be faster than a loop, because it will use"},{"DocComment":" internal iteration on adapters like `Chain`."},{"DocComment":""},{"DocComment":" [`for`]: ../../book/ch03-05-control-flow.html#looping-through-a-collection-with-for"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::mpsc::channel;"},{"DocComment":""},{"DocComment":" let (tx, rx) = channel();"},{"DocComment":" (0..5).map(|x| x * 2 + 1)"},{"DocComment":"       .for_each(move |x| tx.send(x).unwrap());"},{"DocComment":""},{"DocComment":" let v: Vec<_> = rx.iter().collect();"},{"DocComment":" assert_eq!(v, vec![1, 3, 5, 7, 9]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" For such a small example, a `for` loop may be cleaner, but `for_each`"},{"DocComment":" might be preferable to keep a functional style with longer iterators:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" (0..5).flat_map(|x| (x * 100)..(x * 110))"},{"DocComment":"       .enumerate()"},{"DocComment":"       .filter(|&(i, x)| (i + x) % 3 == 0)"},{"DocComment":"       .for_each(|(i, x)| println!(\"{i}:{x}\"));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"F"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":4,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":14167}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":880,"col":11},"end":{"line":880,"col":28}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":14143},{"Deduplicated":14213},{"Deduplicated":594}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":14142},{"Deduplicated":14143}],"output":{"Deduplicated":594}},"src":{"TraitDecl":{"trait_ref":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":14167}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":13}}},"is_global_initializer":null,"body":"Opaque"},null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,{"def_id":58,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["try_fold",0]}],"span":{"data":{"file_id":19,"beg":{"line":2486,"col":4},"end":{"line":2490,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator method that applies a function as long as it returns"},{"DocComment":" successfully, producing a single, final value."},{"DocComment":""},{"DocComment":" `try_fold()` takes two arguments: an initial value, and a closure with"},{"DocComment":" two arguments: an 'accumulator', and an element. The closure either"},{"DocComment":" returns successfully, with the value that the accumulator should have"},{"DocComment":" for the next iteration, or it returns failure, with an error value that"},{"DocComment":" is propagated back to the caller immediately (short-circuiting)."},{"DocComment":""},{"DocComment":" The initial value is the value the accumulator will have on the first"},{"DocComment":" call. If applying the closure succeeded against every element of the"},{"DocComment":" iterator, `try_fold()` returns the final accumulator as success."},{"DocComment":""},{"DocComment":" Folding is useful whenever you have a collection of something, and want"},{"DocComment":" to produce a single value from it."},{"DocComment":""},{"DocComment":" # Note to Implementors"},{"DocComment":""},{"DocComment":" Several of the other (forward) methods have default implementations in"},{"DocComment":" terms of this one, so try to implement this explicitly if it can"},{"DocComment":" do something better than the default `for` loop implementation."},{"DocComment":""},{"DocComment":" In particular, try to have this call `try_fold()` on the internal parts"},{"DocComment":" from which this iterator is composed. If multiple calls are needed,"},{"DocComment":" the `?` operator may be convenient for chaining the accumulator value"},{"DocComment":" along, but beware any invariants that need to be upheld before those"},{"DocComment":" early returns. This is a `&mut self` method, so iteration needs to be"},{"DocComment":" resumable after hitting an error here."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" // the checked sum of all of the elements of the array"},{"DocComment":" let sum = a.into_iter().try_fold(0i8, |acc, x| acc.checked_add(x));"},{"DocComment":""},{"DocComment":" assert_eq!(sum, Some(6));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Short-circuiting:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [10, 20, 30, 100, 40, 50];"},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" // This sum overflows when adding the 100 element"},{"DocComment":" let sum = iter.try_fold(0i8, |acc, x| acc.checked_add(x));"},{"DocComment":" assert_eq!(sum, None);"},{"DocComment":""},{"DocComment":" // Because it short-circuited, the remaining elements are still"},{"DocComment":" // available through the iterator."},{"DocComment":" assert_eq!(iter.len(), 2);"},{"DocComment":" assert_eq!(iter.next(), Some(40));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" While you cannot `break` from a closure, the [`ControlFlow`] type allows"},{"DocComment":" a similar idea:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let triangular = (1..30).try_fold(0_i8, |prev, x| {"},{"DocComment":"     if let Some(next) = prev.checked_add(x) {"},{"DocComment":"         ControlFlow::Continue(next)"},{"DocComment":"     } else {"},{"DocComment":"         ControlFlow::Break(prev)"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(triangular, ControlFlow::Break(120));"},{"DocComment":""},{"DocComment":" let triangular = (1..30).try_fold(0_u64, |prev, x| {"},{"DocComment":"     if let Some(next) = prev.checked_add(x) {"},{"DocComment":"         ControlFlow::Continue(next)"},{"DocComment":"     } else {"},{"DocComment":"         ControlFlow::Break(prev)"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(triangular, ControlFlow::Continue(435));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"B"},{"index":2,"name":"F"},{"index":3,"name":"R"},{"index":4,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":4,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"HashConsedValue":[14409,{"TypeVar":{"Free":4}}]}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":2489,"col":11},"end":{"line":2489,"col":44}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":14167},{"HashConsedValue":[14410,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":14143},{"Deduplicated":14409}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":14172}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":19,"beg":{"line":2489,"col":47},"end":{"line":2489,"col":63}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":14167}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"data":{"file_id":19,"beg":{"line":2490,"col":11},"end":{"line":2490,"col":34}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":11,"generics":{"regions":[],"types":[{"Deduplicated":14172}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[{"regions":[],"skip_binder":{"trait_ref":{"HashConsedValue":[14411,{"kind":{"Clause":{"Free":3}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":11,"generics":{"regions":[],"types":[{"Deduplicated":14172}],"const_generics":[],"trait_refs":[]}}}}]},"type_id":0,"ty":{"Deduplicated":14143}}}]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":14154},{"Deduplicated":14143},{"Deduplicated":14167}],"output":{"Deduplicated":14172}},"src":{"TraitDecl":{"trait_ref":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":14409}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":36}}},"is_global_initializer":null,"body":"Opaque"},null,{"def_id":60,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["fold",0]}],"span":{"data":{"file_id":19,"beg":{"line":2664,"col":4},"end":{"line":2667,"col":64}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Folds every element into an accumulator by applying an operation,"},{"DocComment":" returning the final result."},{"DocComment":""},{"DocComment":" `fold()` takes two arguments: an initial value, and a closure with two"},{"DocComment":" arguments: an 'accumulator', and an element. The closure returns the value that"},{"DocComment":" the accumulator should have for the next iteration."},{"DocComment":""},{"DocComment":" The initial value is the value the accumulator will have on the first"},{"DocComment":" call."},{"DocComment":""},{"DocComment":" After applying this closure to every element of the iterator, `fold()`"},{"DocComment":" returns the accumulator."},{"DocComment":""},{"DocComment":" This operation is sometimes called 'reduce' or 'inject'."},{"DocComment":""},{"DocComment":" Folding is useful whenever you have a collection of something, and want"},{"DocComment":" to produce a single value from it."},{"DocComment":""},{"DocComment":" Note: `fold()`, and similar methods that traverse the entire iterator,"},{"DocComment":" might not terminate for infinite iterators, even on traits for which a"},{"DocComment":" result is determinable in finite time."},{"DocComment":""},{"DocComment":" Note: [`reduce()`] can be used to use the first element as the initial"},{"DocComment":" value, if the accumulator type and item type is the same."},{"DocComment":""},{"DocComment":" Note: `fold()` combines elements in a *left-associative* fashion. For associative"},{"DocComment":" operators like `+`, the order the elements are combined in is not important, but for non-associative"},{"DocComment":" operators like `-` the order will affect the final result."},{"DocComment":" For a *right-associative* version of `fold()`, see [`DoubleEndedIterator::rfold()`]."},{"DocComment":""},{"DocComment":" # Note to Implementors"},{"DocComment":""},{"DocComment":" Several of the other (forward) methods have default implementations in"},{"DocComment":" terms of this one, so try to implement this explicitly if it can"},{"DocComment":" do something better than the default `for` loop implementation."},{"DocComment":""},{"DocComment":" In particular, try to have this call `fold()` on the internal parts"},{"DocComment":" from which this iterator is composed."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" // the sum of all of the elements of the array"},{"DocComment":" let sum = a.iter().fold(0, |acc, x| acc + x);"},{"DocComment":""},{"DocComment":" assert_eq!(sum, 6);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Let's walk through each step of the iteration here:"},{"DocComment":""},{"DocComment":" | element | acc | x | result |"},{"DocComment":" |---------|-----|---|--------|"},{"DocComment":" |         | 0   |   |        |"},{"DocComment":" | 1       | 0   | 1 | 1      |"},{"DocComment":" | 2       | 1   | 2 | 3      |"},{"DocComment":" | 3       | 3   | 3 | 6      |"},{"DocComment":""},{"DocComment":" And so, our final result, `6`."},{"DocComment":""},{"DocComment":" This example demonstrates the left-associative nature of `fold()`:"},{"DocComment":" it builds a string, starting with an initial value"},{"DocComment":" and continuing with each element from the front until the back:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let numbers = [1, 2, 3, 4, 5];"},{"DocComment":""},{"DocComment":" let zero = \"0\".to_string();"},{"DocComment":""},{"DocComment":" let result = numbers.iter().fold(zero, |acc, &x| {"},{"DocComment":"     format!(\"({acc} + {x})\")"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" assert_eq!(result, \"(((((0 + 1) + 2) + 3) + 4) + 5)\");"},{"DocComment":" ```"},{"DocComment":" It's common for people who haven't used iterators a lot to"},{"DocComment":" use a `for` loop with a list of things to build up a result. Those"},{"DocComment":" can be turned into `fold()`s:"},{"DocComment":""},{"DocComment":" [`for`]: ../../book/ch03-05-control-flow.html#looping-through-a-collection-with-for"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let numbers = [1, 2, 3, 4, 5];"},{"DocComment":""},{"DocComment":" let mut result = 0;"},{"DocComment":""},{"DocComment":" // for loop:"},{"DocComment":" for i in &numbers {"},{"DocComment":"     result = result + i;"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // fold:"},{"DocComment":" let result2 = numbers.iter().fold(0, |acc, &x| acc + x);"},{"DocComment":""},{"DocComment":" // they're the same"},{"DocComment":" assert_eq!(result, result2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`reduce()`]: Iterator::reduce"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"B"},{"index":2,"name":"F"},{"index":3,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":4,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":14172}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":2666,"col":22},"end":{"line":2666,"col":38}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":14142}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":19,"beg":{"line":2667,"col":11},"end":{"line":2667,"col":44}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":14167},{"HashConsedValue":[14412,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Dedu