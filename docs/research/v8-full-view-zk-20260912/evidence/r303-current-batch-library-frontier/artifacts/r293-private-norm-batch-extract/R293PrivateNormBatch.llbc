d as 3"},{"DocComment":" assert_eq!(iter.next_chunk::<4>().unwrap_err().as_slice(), &[]); // N is explicitly 4"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Split a string and get the first three items."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_next_chunk)]"},{"DocComment":""},{"DocComment":" let quote = \"not all those who wander are lost\";"},{"DocComment":" let [first, second, third] = quote.split_whitespace().next_chunk().unwrap();"},{"DocComment":" assert_eq!(first, \"not\");"},{"DocComment":" assert_eq!(second, \"all\");"},{"DocComment":" assert_eq!(third, \"those\");"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Item"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":854}}],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":4,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":14143}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":14154}],"output":{"HashConsedValue":[14347,{"Adt":{"id":{"Adt":1},"generics":{"regions":[],"types":[{"HashConsedValue":[14345,{"Array":[{"Deduplicated":14143},{"kind":{"Var":{"Free":0}},"ty":{"Deduplicated":854}}]}]},{"HashConsedValue":[14346,{"Adt":{"id":{"Adt":15},"generics":{"regions":[],"types":[{"Deduplicated":14143}],"const_generics":[{"kind":{"Var":{"Free":0}},"ty":{"Deduplicated":854}}],"trait_refs":[]}}}]}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitDecl":{"trait_ref":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":14143}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":1}}},"is_global_initializer":null,"body":"Opaque"},{"def_id":25,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["size_hint",0]}],"span":{"data":{"file_id":19,"beg":{"line":189,"col":4},"end":{"line":189,"col":49}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the bounds on the remaining length of the iterator."},{"DocComment":""},{"DocComment":" Specifically, `size_hint()` returns a tuple where the first element"},{"DocComment":" is the lower bound, and the second element is the upper bound."},{"DocComment":""},{"DocComment":" The second half of the tuple that is returned is an <code>[Option]<[usize]></code>."},{"DocComment":" A [`None`] here means that either there is no known upper bound, or the"},{"DocComment":" upper bound is larger than [`usize`]."},{"DocComment":""},{"DocComment":" # Implementation notes"},{"DocComment":""},{"DocComment":" It is not enforced that an iterator implementation yields the declared"},{"DocComment":" number of elements. A buggy iterator may yield less than the lower bound"},{"DocComment":" or more than the upper bound of elements."},{"DocComment":""},{"DocComment":" `size_hint()` is primarily intended to be used for optimizations such as"},{"DocComment":" reserving space for the elements of the iterator, but must not be"},{"DocComment":" trusted to e.g., omit bounds checks in unsafe code. An incorrect"},{"DocComment":" implementation of `size_hint()` should not lead to memory safety"},{"DocComment":" violations."},{"DocComment":""},{"DocComment":" That said, the implementation should provide a correct estimation,"},{"DocComment":" because otherwise it would be a violation of the trait's protocol."},{"DocComment":""},{"DocComment":" The default implementation returns <code>(0, [None])</code> which is correct for any"},{"DocComment":" iterator."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let mut iter = a.iter();"},{"DocComment":""},{"DocComment":" assert_eq!((3, Some(3)), iter.size_hint());"},{"DocComment":" let _ = iter.next();"},{"DocComment":" assert_eq!((2, Some(2)), iter.size_hint());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A more complex example:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // The even numbers in the range of zero to nine."},{"DocComment":" let iter = (0..10).filter(|x| x % 2 == 0);"},{"DocComment":""},{"DocComment":" // We might iterate from zero to ten times. Knowing that it's five"},{"DocComment":" // exactly wouldn't be possible without executing filter()."},{"DocComment":" assert_eq!((0, Some(10)), iter.size_hint());"},{"DocComment":""},{"DocComment":" // Let's add five more numbers with chain()"},{"DocComment":" let iter = (0..10).filter(|x| x % 2 == 0).chain(15..20);"},{"DocComment":""},{"DocComment":" // now both bounds are increased by five"},{"DocComment":" assert_eq!((5, Some(15)), iter.size_hint());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Returning `None` for an upper bound:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // an infinite iterator has no upper bound"},{"DocComment":" // and the maximum possible lower bound"},{"DocComment":" let iter = 0..;"},{"DocComment":""},{"DocComment":" assert_eq!((usize::MAX, None), iter.size_hint());"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":4,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},