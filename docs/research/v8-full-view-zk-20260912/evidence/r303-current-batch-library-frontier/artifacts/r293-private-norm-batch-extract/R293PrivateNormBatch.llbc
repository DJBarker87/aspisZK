ue"},null,null,{"def_id":159,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["double_ended",0]},{"Ident":["DoubleEndedIterator",0]},{"Ident":["advance_back_by",0]}],"span":{"data":{"file_id":29,"beg":{"line":141,"col":4},"end":{"line":141,"col":73}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Advances the iterator from the back by `n` elements."},{"DocComment":""},{"DocComment":" `advance_back_by` is the reverse version of [`advance_by`]. This method will"},{"DocComment":" eagerly skip `n` elements starting from the back by calling [`next_back`] up"},{"DocComment":" to `n` times until [`None`] is encountered."},{"DocComment":""},{"DocComment":" `advance_back_by(n)` will return `Ok(())` if the iterator successfully advances by"},{"DocComment":" `n` elements, or a `Err(NonZero<usize>)` with value `k` if [`None`] is encountered, where `k`"},{"DocComment":" is remaining number of steps that could not be advanced because the iterator ran out."},{"DocComment":" If `self` is empty and `n` is non-zero, then this returns `Err(n)`."},{"DocComment":" Otherwise, `k` is always less than `n`."},{"DocComment":""},{"DocComment":" Calling `advance_back_by(0)` can do meaningful work, for example [`Flatten`] can advance its"},{"DocComment":" outer iterator until it finds an inner iterator that is not empty, which then often"},{"DocComment":" allows it to return a more accurate `size_hint()` than in its initial state."},{"DocComment":""},{"DocComment":" [`advance_by`]: Iterator::advance_by"},{"DocComment":" [`Flatten`]: crate::iter::Flatten"},{"DocComment":" [`next_back`]: DoubleEndedIterator::next_back"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_advance_by)]"},{"DocComment":""},{"DocComment":" use std::num::NonZero;"},{"DocComment":""},{"DocComment":" let a = [3, 4, 5, 6];"},{"DocComment":" let mut iter = a.iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.advance_back_by(2), Ok(()));"},{"DocComment":" assert_eq!(iter.next_back(), Some(&4));"},{"DocComment":" assert_eq!(iter.advance_back_by(0), Ok(()));"},{"DocComment":" assert_eq!(iter.advance_back_by(100), Err(NonZero::new(99).unwrap())); // only `&3` was skipped"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Ok(())`]: Ok"},{"DocComment":" [`Err(k)`]: Err"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":4,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":14143}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":14154},{"Deduplicated":854}],"output":{"Deduplicated":13053}},"src":{"TraitDecl":{"trait_ref":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":14143}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":1}}},"is_global_initializer":null,"body":"Opaque"},{"def_id":160,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["double_ended",0]},{"Ident":["DoubleEndedIterator",0]},{"Ident":["nth_back",0]}],"span":{"data":{"file_id":29,"beg":{"line":195,"col":4},"end":{"line":195,"col":58}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the `n`th element from the end of the iterator."},{"DocComment":""},{"DocComment":" This is essentially the reversed version of [`Iterator::nth()`]."},{"DocComment":" Although like most indexing operations, the count starts from zero, so"},{"DocComment":" `nth_back(0)` returns the first value from the end, `nth_back(1)` the"},{"DocComment":" second, and so on."},{"DocComment":""},{"DocComment":" Note that all elements between the end and the returned element will be"},{"DocComment":" consumed, including the returned element. This also means that calling"},{"DocComment":" `nth_back(0)` multiple times on the same iterator will return different"},{"DocComment":" elements."},{"DocComment":""},{"DocComment":" `nth_back()` will return [`None`] if `n` is greater than or equal to the"},{"DocComment":" length of the iterator."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" assert_eq!(a.iter().nth_back(2), Some(&1));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Calling `nth_back()` multiple times doesn't rewind the iterator:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.nth_back(1), Some(&2));"},{"DocComment":" assert_eq!(iter.nth_back(1), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Returning `None` if there are less than `n + 1` elements:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" assert_eq!(a.iter().nth_back(10), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":4,"beg":{"line":1,"col":0},"end":{"line":1,"co