eferences:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" // `iter()` yields references i.e. `&i32` and `find()` takes a"},{"DocComment":" // reference to each element."},{"DocComment":" assert_eq!(a.iter().find(|&&x| x == 2), Some(&2));"},{"DocComment":" assert_eq!(a.iter().find(|&&x| x == 5), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `true`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.find(|&x| x == 2), Some(2));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that `iter.find(f)` is equivalent to `iter.filter(f).next()`."}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"P"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":4,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":14167}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":19,"beg":{"line":2962,"col":11},"end":{"line":2962,"col":37}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":14143},{"HashConsedValue":[14220,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"HashConsedValue":[14219,{"Ref":[{"Var":{"Bound":