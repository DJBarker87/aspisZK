Iterator`]s."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().rev();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":14142}],"output":{"Deduplicated":14253}},"default":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":14143},{"Deduplicated":1193}],"const_generics":[],"trait_refs":[{"Deduplicated":14320},{"HashConsedValue":[14325,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":2403}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[0,54]}},null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,{"params":{"regions":[],"types":[{"index":0,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":19,"beg":{"line":4081,"col":11},"end":{"line":4081,"col":50}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":2403},{"HashConsedValue":[14273,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":14265},{"HashConsedValue":[14272,{"Ref":[{"Var":{"Bound":[0,1]}},{"Deduplicated":14143},"Shared"]}]}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":596}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"is_sorted_by","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["is_sorted_by",0]}],"span":{"data":{"file_id":19,"beg":{"line":4078,"col":4},"end":{"line":4081,"col":51}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Checks if the elements of this iterator are sorted using the given comparator function."},{"DocComment":""},{"DocComment":" Instead of using `PartialOrd::partial_cmp`, this function uses the given `compare`"},{"DocComment":" function to determine whether two elements are to be considered in sorted order."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert!([1, 2, 2, 9].iter().is_sorted_by(|a, b| a <= b));"},{"DocComment":" assert!(![1, 2, 2, 9].iter().is_sorted_by(|a, b| a < b));"},{"DocComment":""},{"DocComment":" assert!([0].iter().is_sorted_by(|a, b| true));"},{"DocComment":" assert!([0].iter().is_sorted_by(|a, b| false));"},{"DocComment":""},{"DocComment":" assert!(std::iter::empty::<i32>().is_sorted_by(|a, b| false));"},{"DocComment":" assert!(std::iter::empty::<i32>().is_sorted_by(|a, b| true));"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":14142},{"Deduplicated":1193}],"output":{"Deduplicated":596}},"default":{"id":94,"generics":{"regions":[],"types":[{"Deduplicated":14142},{"Deduplicated":1193},{"Deduplicated":14143}],"const_generics":[],"trait_refs":[{"Deduplicated":14320},{"HashConsedValue":[14274,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":2,"generics":{"regio