fs":[]}}},"fn_mut_impl":null,"fn_impl":null,"signature":{"regions":[],"skip_binder":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":724}],"output":{"Deduplicated":597}}}}}},"kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":14,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Ident":["Vec",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":798}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":10,"beg":{"line":438,"col":0},"end":{"line":438,"col":96}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A contiguous growable array type, written as `Vec<T>`, short for 'vector'."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut vec = Vec::new();"},{"DocComment":" vec.push(1);"},{"DocComment":" vec.push(2);"},{"DocComment":""},{"DocComment":" assert_eq!(vec.len(), 2);"},{"DocComment":" assert_eq!(vec[0], 1);"},{"DocComment":""},{"DocComment":" assert_eq!(vec.pop(), Some(2));"},{"DocComment":" assert_eq!(vec.len(), 1);"},{"DocComment":""},{"DocComment":" vec[0] = 7;"},{"DocComment":" assert_eq!(vec[0], 7);"},{"DocComment":""},{"DocComment":" vec.extend([1, 2, 3]);"},{"DocComment":""},{"DocComment":" for x in &vec {"},{"DocComment":"     println!(\"{x}\");"},{"DocComment":" }"},{"DocComment":" assert_eq!(vec, [7, 1, 2, 3]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The [`vec!`] macro is provided for convenient initialization:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut vec1 = vec![1, 2, 3];"},{"DocComment":" vec1.push(4);"},{"DocComment":" let vec2 = Vec::from([1, 2, 3, 4]);"},{"DocComment":" assert_eq!(vec1, vec2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It can also initialize each element of a `Vec<T>` with a given value."},{"DocComment":" This may be more efficient than performing allocation and initialization"},{"DocComment":" in separate steps, especially when initializing a vector of zeros:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let vec = vec![0; 5];"},{"DocComment":" assert_eq!(vec, [0, 0, 0, 0, 0]);"},{"DocComment":""},{"DocComment":" // The following is equivalent, but potentially slower:"},{"DocComment":" let mut vec = Vec::with_capacity(5);"},{"DocComment":" vec.resize(5, 0);"},{"DocComment":" assert_eq!(vec, [0, 0, 0, 0, 0]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" For more information, see"},{"DocComment":" [Capacity and Reallocation](#capacity-and-reallocation)."},{"DocComment":""},{"DocComment":" Use a `Vec<T>` as an efficient stack:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut stack = Vec::new();"},{"DocComment":""},{"DocComment":" stack.push(1);"},{"DocComment":" stack.push(2);"},{"DocComment":" stack.push(3);"},{"DocComment":""},{"DocComment":" while let Some(top) = stack.pop() {"},{"DocComment":"     // Prints 3, 2, 1"},{"DocComment":"     println!(\"{top}\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Indexing"},{"DocComment":""},{"DocComment":" The `Vec` type allows access to values by index, because it implements the"},{"DocComment":" [`Index`] trait. An example will be more explicit:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = vec![0, 2, 4, 6];"},{"DocComment":" println!(\"{}\", v[1]); // it will display '2'"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However be careful: if you try to access an index which isn't in the `Vec`,"},{"DocComment":" your software will panic! You cannot do this:"},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" let v = vec![0, 2, 4, 6];"},{"DocComment":" println!(\"{}\", v[6]); // it will panic!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Use [`get`] and [`get_mut`] if you want to check whether the index is in"},{"DocComment":" the `Vec`."},{"DocComment":""},{"DocComment":" # Slicing"},{"DocComment":""},{"DocComment":" A `Vec` can be mutable. On the other hand, slices are read-only objects."},{"DocComment":" To get a [slice][prim@slice], use [`&`]. Example:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn read_slice(slice: &[usize]) {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let v = vec![0, 1];"},{"DocComment":" read_slice(&v);"},{"DocComment":""},{"DocComment":" // ... and that's all!"},{"DocComment":" // you can also do it like this:"},{"DocComment":" let u: &[usize] = &v;"},{"DocComment":" // or like this:"},{"DocComment":" let u: &[_] = &v;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In Rust, it's more common to pass slices as arguments rather than vectors"},{"DocComment":" when you just want to provide read access. The same goes for [`String`] and"},{"DocComment":" [`&str`]."},{"DocComment":""},{"DocComment":" # Capacity and reallocation"},{"DocComment":""},{"DocComment":" The capacity of a vector is the amount of space allocated for any future"},{"DocComment":" elements that will be added onto the vector. This is not to be confused with"},{"DocComment":" the *length* of a vector, which specifies the number of actual elements"},{"DocComment":" within the vector. If a vector's length exceeds its capacity, its capacity"},{"DocComment":" will automatically be increased, but its elements will have to be"},{"DocComment":" reallocated."},{"DocComment":""},{"DocComment":" For example, a vector with capacity 10 and length 0 would be an empty vector"},{"DocComment":" with space for 10 more elements. Pushing 10 or fewer elements onto the"},{"DocComment":" vector will not change its capacity or cause reallocation to occur. However,"},{"DocComment":" if the vector's length is increased to 11, it will have to reallocate, which"},{"DocComment":" can be slow. For this reason, it is recommended to use [`Vec::with_capacity`]"},{"DocComment":" whenever possible to specify how big the vector is expected to get."},{"DocComment":""},{"DocComment":" # Guarantees"},{"DocComment":""},{"DocComment":" Due to its incredibly fundamental nature, `Vec` makes a lot of guarantees"},{"DocComment":" about its design. This ensures that it's as low-overhead as possible in"},{"DocComment":" the general case, and can be correctly manipulated in primitive ways"},{"DocComment":" by unsafe code. Note that these guarantees refer to an unqualified `Vec<T>`."},{"DocComment":" If additional type parameters are added (e.g., to support custom allocators),"},{"DocComment":" overriding their defaults may change the behavior."},{"DocComment":""},{"DocComment":" Most fundamentally, `Vec` is and always will be a (pointer, capacity, length)"},{"DocComment":" triplet. No more, no less. The order of these fields is completely"},{"DocComment":" unspecified, and you should use the appropriate methods to modify these."},{"DocComment":" The pointer will never be null, so this type is null-pointer-optimized."},{"DocComment":""},{"DocComment":" However, the pointer might not actually point to allocated memory. In particular,"},{"DocComment":" if you construct a `Vec` with capacity 0 via [`Vec::new`], [`vec![]`][`vec!`],"},{"DocComment":" [`Vec::with_capacity(0)`][`Vec::with_capacity`], or by calling [`shrink_to_fit`]"},{"DocComment":" on an empty Vec, it will not allocate memory. Similarly, if you store zero-sized"},{"DocComment":" types inside a `Vec`, it will not allocate space for them. *Note that in this case"},{"DocComment":" the `Vec` might not report a [`capacity`] of 0*. `Vec` will allocate if and only"},{"DocComment":" if <code>[size_of::\\<T>]\\() * [capacity]\\() > 0</code>. In general, `Vec`'s allocation"},{"DocComment":" details are very subtle --- if you intend to allocate memory using a `Vec`"},{"DocComment":" and use it for something else (either to pass to unsafe code, or to build your"},{"DocComment":" own memory-backed collection), be sure to deallocate this memory by using"},{"DocComment":" `from_raw_parts` to recover the `Vec` and then dropping it."},{"DocComment":""},{"DocComment":" If a `Vec` *has* allocated memory, then the memory it points to is on the heap"},{"DocComment":" (as defined by the allocator Rust is configured to use by default), and its"},{"DocComment":" pointer points to [`len`] initialized, contiguous elements in order (what"},{"DocComment":" you would see if you coerced it to a slice), followed by <code>[capacity] - [len]</code>"},{"DocComment":" logically uninitialized, contiguous elements."},{"DocComment":""},{"DocComment":" A vector containing the elements `'a'` and `'b'` with capacity 4 can be"},{"DocComment":" visualized as below. The top part is the `Vec` struct, it contains a"},{"DocComment":" pointer to the head of the allocation in the heap, length and capacity."},{"DocComment":" The bottom part is the allocation on the heap, a contiguous memory block."},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":"             ptr      len  capacity"},{"DocComment":"        +--------+--------+--------+"},{"DocComment":"        | 0x0123 |      2 |      4 |"},{"DocComment":"        +--------+--------+--------+"},{"DocComment":"             |"},{"DocComment":"             v"},{"DocComment":" Heap   +--------+--------+--------+--------+"},{"DocComment":"        |    'a' |    'b' | uninit | uninit |"},{"DocComment":"        +--------+--------+--------+--------+"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" - **uninit** represents memory that is not initialized, see [`MaybeUninit`]."},{"DocComment":" - Note: the ABI is not stable and `Vec` makes no guarantees about its memory"},{"DocComment":"   layout (including the order of fields)."},{"DocComment":""},{"DocComment":" `Vec` will never perform a \"small optimization\" where elements are actually"},{"DocComment":" stored on the stack for two reasons:"},{"DocComment":""},{"DocComment":" * It would make it more difficult for unsafe code to correctly manipulate"},{"DocComment":"   a `Vec`. The contents of a `Vec` wouldn't have a stable address if it were"},{"DocComment":"   only moved, and it would be more difficult to determine if a `Vec` had"},{"DocComment":"   actually allocated memory."},{"DocComment":""},{"DocComment":" * It would penalize the general case, incurring an additional branch"},{"DocComment":"   on every access."},{"DocComment":""},{"DocComment":" `Vec` will never automatically shrink itself, even if completely empty. This"},{"DocComment":" ensures no unnecessary allocations or deallocations occur. Emptying a `Vec`"},{"DocComment":" and then filling it back up to the same [`len`] should incur no calls to"},{"DocComment":" the allocator. If you wish to free up unused memory, use"},{"DocComment":" [`shrink_to_fit`] or [`shrink_to`]."},{"DocComment":""},{"DocComment":" [`push`] and [`insert`] will never (re)allocate if the reported capacity is"},{"DocComment":" sufficient. [`push`] and [`insert`] *will* (re)allocate if"},{"DocComment":" <code>[len] == [capacity]</code>. That is, the reported capacity is completely"},{"DocComment":" accurate, and can be relied on. It can even be used to manually free the memory"},{"DocComment":" allocated by a `Vec` if desired. Bulk insertion methods *may* reallocate, even"},{"DocComment":" when not necessary."},{"DocComment":""},{"DocComment":" `Vec` does not guarantee any particular growth strategy when reallocating"},{"DocComment":" when full, nor when [`reserve`] is called. The current strategy is basic"},{"DocComment":" and it may prove desirable to use a non-constant growth factor. Whatever"},{"DocComment":" strategy is used will of course guarantee *O*(1) amortized [`push`]."},{"DocComment":""},{"DocComment":" It is guaranteed, in order to respect the intentions of the programmer, that"},{"DocComment":" all of `vec![e_1, e_2, ..., e_n]`, `vec![x; n]`, and [`Vec::with_capacity(n)`] produce a `Vec`"},{"DocComment":" that requests an allocation of the exact size needed for precisely `n` elements from the allocator,"},{"DocComment":" and no other size (such as, for example: a size rounded up to the nearest power of 2)."},{"DocComment":" The allocator will return an allocation that is at least as large as requested, but it may be larger."},{"DocComment":""},{"DocComment":" It is guaranteed that the [`Vec::capacity`] method returns a value that is at least the requested capacity"},{"DocComment":" and not more than the allocated capacity."},{"DocComment":""},{"DocComment":" The method [`Vec::shrink_to_fit`] will attempt to discard excess capacity an allocator has given to a `Vec`."},{"DocComment":" If <code>[len] == [capacity]</code>, then a `Vec<T>` can be converted"},{"DocComment":" to and from a [`Box<[T]>`][owned slice] without reallocating or moving the elements."},{"DocComment":" `Vec` exploits this fact as much as reasonable when implementing common conversions"},{"DocComment":" such as [`into_boxed_slice`]."},{"DocComment":""},{"DocComment":" `Vec` will not specifically overwrite any data that is removed from it,"},{"DocComment":" but also won't specifically preserve it. Its uninitialized memory is"},{"DocComment":" scratch space that it may use however it wants. It will generally just do"},{"DocComment":" whatever is most efficient or otherwise easy to implement. Do not rely on"},{"DocComment":" removed data to be erased for security purposes. Even if you drop a `Vec`, its"},{"DocComment":" buffer may simply be reused by another allocation. Even if you zero a `Vec`'s memory"},{"DocComment":" first, that might not actually happen because the optimizer does not consider"},{"DocComment":" this a side-effect that must be preserved. There is one case which we will"},{"DocComment":" not break, however: using `unsafe` code to write to the excess capacity,"},{"DocComment":" and then increasing the length to match, is always valid."},{"DocComment":""},{"DocComment":" Currently, `Vec` does not guarantee the order in which elements are dropped."},{"DocComment":" The order has changed in the past and may change again."},{"DocComment":""},{"DocComment":" [`get`]: slice::get"},{"DocComment":" [`get_mut`]: slice::get_mut"},{"DocComment":" [`String`]: crate::string::String"},{"DocComment":" [`&str`]: type@str"},{"DocComment":" [`shrink_to_fit`]: Vec::shrink_to_fit"},{"DocComment":" [`shrink_to`]: Vec::shrink_to"},{"DocComment":" [capacity]: Vec::capacity"},{"DocComment":" [`capacity`]: Vec::capacity"},{"DocComment":" [`Vec::capacity`]: Vec::capacity"},{"DocComment":" [size_of::\\<T>]: size_of"},{"DocComment":" [len]: Vec::len"},{"DocComment":" [`len`]: Vec::len"},{"DocComment":" [`push`]: Vec::push"},{"DocComment":" [`insert`]: Vec::insert"},{"DocComment":" [`reserve`]: Vec::reserve"},{"DocComment":" [`Vec::with_capacity(n)`]: Vec::with_capacity"},{"DocComment":" [`MaybeUninit`]: core::mem::MaybeUninit"},{"DocComment":" [owned slice]: Box"},{"DocComment":" [`into_boxed_slice`]: Vec::into_boxed_slice"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Vec"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,16],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":15,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Ident":["Global",0]}],"span":{"data":{"file_id":12,"beg":{"line":58,"col":0},"end":{"line":58,"col":17}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The global memory allocator."},{"DocComment":""},{"DocComment":" This type implements the [`Allocator`] trait by forwarding calls"},{"DocComment":" to the allocator registered with the `#[global_allocator]` attribute"},{"DocComment":" if there is one, or the `std` crate’s default."},{"DocComment":""},{"DocComment":" Note: while this type is unstable, the functionality it provides can be"},{"DocComment":" accessed through the [free functions in `alloc`](self#functions)."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"global_alloc_ty"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":16,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_uninit",0]},{"Ident":["MaybeUninit",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":888}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":15,"beg":{"line":355,"col":0},"end":{"line":355,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper type to construct uninitialized instances of `T`."},{"DocComment":""},{"DocComment":" # Initialization invariant"},{"DocComment":""},{"DocComment":" The compiler, in general, assumes that a variable is [properly initialized or \"valid\"][validity]"},{"DocComment":" according to the requirements of the variable's type. For example, a variable of"},{"DocComment":" reference type must be aligned and non-null. This is an invariant that must"},{"DocComment":" *always* be upheld, even in unsafe code. As a consequence, zero-initializing a"},{"DocComment":" variable of reference type causes instantaneous undefined behavior,"},{"DocComment":" no matter whether that reference ever gets used to access memory:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let x: &i32 = unsafe { mem::zeroed() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<&i32>`:"},{"DocComment":" let x: &i32 = unsafe { MaybeUninit::zeroed().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This is exploited by the compiler for various optimizations, such as eliding"},{"DocComment":" run-time checks and optimizing `enum` layout."},{"DocComment":""},{"DocComment":" Similarly, entirely uninitialized memory may have any content, while a `bool` must"},{"DocComment":" always be `true` or `false`. Hence, creating an uninitialized `bool` is undefined behavior:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let b: bool = unsafe { mem::uninitialized() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<bool>`:"},{"DocComment":" let b: bool = unsafe { MaybeUninit::uninit().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Moreover, uninitialized memory is special in that it does not have a fixed value (\"fixed\""},{"DocComment":" meaning \"it won't change without being written to\"). Reading the same uninitialized byte"},{"DocComment":" multiple times can give different results. This makes it undefined behavior to have"},{"DocComment":" uninitialized data in a variable even if that variable has an integer type, which otherwise can"},{"DocComment":" hold any *fixed* bit pattern:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let x: i32 = unsafe { mem::uninitialized() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<i32>`:"},{"DocComment":" let x: i32 = unsafe { MaybeUninit::uninit().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Conversely, sometimes it is okay to not initialize *all* bytes of a `MaybeUninit`"},{"DocComment":" before calling `assume_init`. For instance, padding bytes do not have to be initialized."},{"DocComment":" See the field-by-field struct initialization example below for a case of that."},{"DocComment":""},{"DocComment":" On top of that, remember that most types have additional invariants beyond merely"},{"DocComment":" being considered initialized at the type level. For example, a `1`-initialized [`Vec<T>`]"},{"DocComment":" is considered initialized (under the current implementation; this does not constitute"},{"DocComment":" a stable guarantee) because the only requirement the compiler knows about it"},{"DocComment":" is that the data pointer must be non-null. Creating such a `Vec<T>` does not cause"},{"DocComment":" *immediate* undefined behavior, but will cause undefined behavior with most"},{"DocComment":" safe operations (including dropping it)."},{"DocComment":""},{"DocComment":" [`Vec<T>`]: ../../std/vec/struct.Vec.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` serves to enable unsafe code to deal with uninitialized data."},{"DocComment":" It is a signal to the compiler indicating that the data here might *not*"},{"DocComment":" be initialized:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" // Create an explicitly uninitialized reference. The compiler knows that data inside"},{"DocComment":" // a `MaybeUninit<T>` may be invalid, and hence this is not UB:"},{"DocComment":" let mut x = MaybeUninit::<&i32>::uninit();"},{"DocComment":" // Set it to a valid value."},{"DocComment":" x.write(&0);"},{"DocComment":" // Extract the initialized data -- this is only allowed *after* properly"},{"DocComment":" // initializing `x`!"},{"DocComment":" let x = unsafe { x.assume_init() };"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The compiler then knows to not make any incorrect assumptions or optimizations on this code."},{"DocComment":""},{"DocComment":" You can think of `MaybeUninit<T>` as being a bit like `Option<T>` but without"},{"DocComment":" any of the run-time tracking and without any of the safety checks."},{"DocComment":""},{"DocComment":" ## out-pointers"},{"DocComment":""},{"DocComment":" You can use `MaybeUninit<T>` to implement \"out-pointers\": instead of returning data"},{"DocComment":" from a function, pass it a pointer to some (uninitialized) memory to put the"},{"DocComment":" result into. This can be useful when it is important for the caller to control"},{"DocComment":" how the memory the result is stored in gets allocated, and you want to avoid"},{"DocComment":" unnecessary moves."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" unsafe fn make_vec(out: *mut Vec<i32>) {"},{"DocComment":"     // `write` does not drop the old contents, which is important."},{"DocComment":"     unsafe { out.write(vec![1, 2, 3]); }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut v = MaybeUninit::uninit();"},{"DocComment":" unsafe { make_vec(v.as_mut_ptr()); }"},{"DocComment":" // Now we know `v` is initialized! This also makes sure the vector gets"},{"DocComment":" // properly dropped."},{"DocComment":" let v = unsafe { v.assume_init() };"},{"DocComment":" assert_eq!(&v, &[1, 2, 3]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Initializing an array element-by-element"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` can be used to initialize a large array element-by-element:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let data = {"},{"DocComment":"     // Create an uninitialized array of `MaybeUninit`."},{"DocComment":"     let mut data: [MaybeUninit<Vec<u32>>; 1000] = [const { MaybeUninit::uninit() }; 1000];"},{"DocComment":""},{"DocComment":"     // Dropping a `MaybeUninit` does nothing, so if there is a panic during this loop,"},{"DocComment":"     // we have a memory leak, but there is no memory safety issue."},{"DocComment":"     for elem in &mut data[..] {"},{"DocComment":"         elem.write(vec![42]);"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     // Everything is initialized. Transmute the array to the"},{"DocComment":"     // initialized type."},{"DocComment":"     unsafe { mem::transmute::<_, [Vec<u32>; 1000]>(data) }"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" assert_eq!(&data[0], &[42]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also work with partially initialized arrays, which could"},{"DocComment":" be found in low-level datastructures."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" // Create an uninitialized array of `MaybeUninit`."},{"DocComment":" let mut data: [MaybeUninit<String>; 1000] = [const { MaybeUninit::uninit() }; 1000];"},{"DocComment":" // Count the number of elements we have assigned."},{"DocComment":" let mut data_len: usize = 0;"},{"DocComment":""},{"DocComment":" for elem in &mut data[0..500] {"},{"DocComment":"     elem.write(String::from(\"hello\"));"},{"DocComment":"     data_len += 1;"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // For each item in the array, drop if we allocated it."},{"DocComment":" for elem in &mut data[0..data_len] {"},{"DocComment":"     unsafe { elem.assume_init_drop(); }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Initializing a struct field-by-field"},{"DocComment":""},{"DocComment":" You can use `MaybeUninit<T>` and the [`&raw mut`] syntax to initialize structs field by field:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" pub struct Foo {"},{"DocComment":"     name: String,"},{"DocComment":"     list: Vec<u8>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let foo = {"},{"DocComment":"     let mut uninit: MaybeUninit<Foo> = MaybeUninit::uninit();"},{"DocComment":"     let ptr = uninit.as_mut_ptr();"},{"DocComment":""},{"DocComment":"     // Initializing the `name` field"},{"DocComment":"     // Using `write` instead of assignment via `=` to not call `drop` on the"},{"DocComment":"     // old, uninitialized value."},{"DocComment":"     unsafe { (&raw mut (*ptr).name).write(\"Bob\".to_string()); }"},{"DocComment":""},{"DocComment":"     // Initializing the `list` field"},{"DocComment":"     // If there is a panic here, then the `String` in the `name` field leaks."},{"DocComment":"     unsafe { (&raw mut (*ptr).list).write(vec![0, 1, 2]); }"},{"DocComment":""},{"DocComment":"     // All the fields are initialized, so we call `assume_init` to get an initialized Foo."},{"DocComment":"     unsafe { uninit.assume_init() }"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     foo,"},{"DocComment":"     Foo {"},{"DocComment":"         name: \"Bob\".to_string(),"},{"DocComment":"         list: vec![0, 1, 2]"},{"DocComment":"     }"},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":" [`&raw mut`]: https://doc.rust-lang.org/reference/types/pointer.html#r-type.pointer.raw.constructor"},{"DocComment":" [validity]: ../../reference/behavior-considered-undefined.html#r-undefined.validity"},{"DocComment":""},{"DocComment":" Note that we have not initialized the padding, but that's fine -- it does not have to be"},{"DocComment":" initialized. In fact, even if we had initialized the padding in `uninit`, those bytes would be"},{"DocComment":" lost when copying the result: no matter the contents of the padding bytes in `uninit`, they will"},{"DocComment":" always be uninitialized in `foo`."},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` is guaranteed to have the same size, alignment, and ABI as `T`:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":" assert_eq!(size_of::<MaybeUninit<u64>>(), size_of::<u64>());"},{"DocComment":" assert_eq!(align_of::<MaybeUninit<u64>>(), align_of::<u64>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However remember that a type *containing* a `MaybeUninit<T>` is not necessarily the same"},{"DocComment":" layout; Rust does not in general guarantee that the fields of a `Foo<T>` have the same order as"},{"DocComment":" a `Foo<U>` even if `T` and `U` have the same size and alignment. Furthermore because any bit"},{"DocComment":" value is valid for a `MaybeUninit<T>` the compiler can't apply non-zero/niche-filling"},{"DocComment":" optimizations, potentially resulting in a larger size:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" # use std::mem::MaybeUninit;"},{"DocComment":" assert_eq!(size_of::<Option<bool>>(), 1);"},{"DocComment":" assert_eq!(size_of::<Option<MaybeUninit<bool>>>(), 2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If `T` is FFI-safe, then so is `MaybeUninit<T>`."},{"DocComment":""},{"DocComment":" While `MaybeUninit` is `#[repr(transparent)]` (indicating it guarantees the same size,"},{"DocComment":" alignment, and ABI as `T`), this does *not* change any of the previous caveats. `Option<T>` and"},{"DocComment":" `Option<MaybeUninit<T>>` may still have different sizes, and types containing a field of type"},{"DocComment":" `T` may be laid out (and sized) differently than if that field were `MaybeUninit<T>`."},{"DocComment":" `MaybeUninit` is a union type, and `#[repr(transparent)]` on unions is unstable (see [the"},{"DocComment":" tracking issue](https://github.com/rust-lang/rust/issues/60405)). Over time, the exact"},{"DocComment":" guarantees of `#[repr(transparent)]` on unions may evolve, and `MaybeUninit` may or may not"},{"DocComment":" remain `#[repr(transparent)]`. That said, `MaybeUninit<T>` will *always* guarantee that it has"},{"DocComment":" the same size, alignment, and ABI as `T`; it's just that the way `MaybeUninit` implements that"},{"DocComment":" guarantee may evolve."},{"DocComment":""},{"DocComment":" Note that even though `T` and `MaybeUninit<T>` are ABI compatible it is still unsound to"},{"DocComment":" transmute `&mut T` to `&mut MaybeUninit<T>` and expose that to safe code because it would allow"},{"DocComment":" safe code to access uninitialized memory:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use core::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" fn unsound_transmute<T>(val: &mut T) -> &mut MaybeUninit<T> {"},{"DocComment":"     unsafe { core::mem::transmute(val) }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let mut code = 0;"},{"DocComment":"     let code = &mut code;"},{"DocComment":"     let code2 = unsound_transmute(code);"},{"DocComment":"     *code2 = MaybeUninit::uninit();"},{"DocComment":"     std::process::exit(*code); // UB! Accessing uninitialized memory."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Validity"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` has no validity requirements – any sequence of [bytes] of"},{"DocComment":" the appropriate length, initialized or uninitialized, are a valid"},{"DocComment":" representation."},{"DocComment":""},{"DocComment":" Moving or copying a value of type `MaybeUninit<T>` (i.e., performing a"},{"DocComment":" \"typed copy\") will exactly preserve the contents, including the"},{"DocComment":" [provenance], of all non-padding bytes of type `T` in the value's"},{"DocComment":" representation."},{"DocComment":""},{"DocComment":" Therefore `MaybeUninit` can be used to perform a round trip of a value from"},{"DocComment":" type `T` to type `MaybeUninit<U>` then back to type `T`, while preserving"},{"DocComment":" the original value, if two conditions are met. One, type `U` must have the"},{"DocComment":" same size as type `T`. Two, for all byte offsets where type `U` has padding,"},{"DocComment":" the corresponding bytes in the representation of the value must be"},{"DocComment":" uninitialized."},{"DocComment":""},{"DocComment":" For example, due to the fact that the type `[u8; size_of::<T>]` has no"},{"DocComment":" padding, the following is sound for any type `T` and will return the"},{"DocComment":" original value:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" # struct T;"},{"DocComment":" fn identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         let u: MaybeUninit<[u8; size_of::<T>()]> = transmute(t);"},{"DocComment":"         transmute(u) // OK."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note: Copying a value that contains references may implicitly reborrow them"},{"DocComment":" causing the provenance of the returned value to differ from that of the"},{"DocComment":" original. This applies equally to the trivial identity function:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" fn trivial_identity<T>(t: T) -> T { t }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note: Moving or copying a value whose representation has initialized bytes"},{"DocComment":" at byte offsets where the type has padding may lose the value of those"},{"DocComment":" bytes, so while the original value will be preserved, the original"},{"DocComment":" *representation* of that value as bytes may not be. Again, this applies"},{"DocComment":" equally to `trivial_identity`."},{"DocComment":""},{"DocComment":" Note: Performing this round trip when type `U` has padding at byte offsets"},{"DocComment":" where the representation of the original value has initialized bytes may"},{"DocComment":" produce undefined behavior or a different value. For example, the following"},{"DocComment":" is unsound since `T` requires all bytes to be initialized:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" #[repr(C)] struct T([u8; 4]);"},{"DocComment":" #[repr(C)] struct U(u8, u16);"},{"DocComment":" fn unsound_identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         let u: MaybeUninit<U> = transmute(t);"},{"DocComment":"         transmute(u) // UB."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Conversely, the following is sound since `T` allows uninitialized bytes in"},{"DocComment":" the representation of a value, but the round trip may alter the value:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" #[repr(C)] struct T(MaybeUninit<[u8; 4]>);"},{"DocComment":" #[repr(C)] struct U(u8, u16);"},{"DocComment":" fn non_identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         // May lose an initialized byte."},{"DocComment":"         let u: MaybeUninit<U> = transmute(t);"},{"DocComment":"         transmute(u)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [bytes]: ../../reference/memory-model.html#bytes"},{"DocComment":" [provenance]: crate::ptr#provenance"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"maybe_uninit"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":1,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":17,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["vec",0]},{"Ident":["Vec",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":544}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":10,"beg":{"line":438,"col":0},"end":{"line":438,"col":96}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A contiguous growable array type, written as `Vec<T>`, short for 'vector'."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut vec = Vec::new();"},{"DocComment":" vec.push(1);"},{"DocComment":" vec.push(2);"},{"DocComment":""},{"DocComment":" assert_eq!(vec.len(), 2);"},{"DocComment":" assert_eq!(vec[0], 1);"},{"DocComment":""},{"DocComment":" assert_eq!(vec.pop(), Some(2));"},{"DocComment":" assert_eq!(vec.len(), 1);"},{"DocComment":""},{"DocComment":" vec[0] = 7;"},{"DocComment":" assert_eq!(vec[0], 7);"},{"DocComment":""},{"DocComment":" vec.extend([1, 2, 3]);"},{"DocComment":""},{"DocComment":" for x in &vec {"},{"DocComment":"     println!(\"{x}\");"},{"DocComment":" }"},{"DocComment":" assert_eq!(vec, [7, 1, 2, 3]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The [`vec!`] macro is provided for convenient initialization:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut vec1 = vec![1, 2, 3];"},{"DocComment":" vec1.push(4);"},{"DocComment":" let vec2 = Vec::from([1, 2, 3, 4]);"},{"DocComment":" assert_eq!(vec1, vec2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It can also initialize each element of a `Vec<T>` with a given value."},{"DocComment":" This may be more efficient than performing allocation and initialization"},{"DocComment":" in separate steps, especially when initializing a vector of zeros:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let vec = vec![0; 5];"},{"DocComment":" assert_eq!(vec, [0, 0, 0, 0, 0]);"},{"DocComment":""},{"DocComment":" // The following is equivalent, but potentially slower:"},{"DocComment":" let mut vec = Vec::with_capacity(5);"},{"DocComment":" vec.resize(5, 0);"},{"DocComment":" assert_eq!(vec, [0, 0, 0, 0, 0]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" For more information, see"},{"DocComment":" [Capacity and Reallocation](#capacity-and-reallocation)."},{"DocComment":""},{"DocComment":" Use a `Vec<T>` as an efficient stack:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut stack = Vec::new();"},{"DocComment":""},{"DocComment":" stack.push(1);"},{"DocComment":" stack.push(2);"},{"DocComment":" stack.push(3);"},{"DocComment":""},{"DocComment":" while let Some(top) = stack.pop() {"},{"DocComment":"     // Prints 3, 2, 1"},{"DocComment":"     println!(\"{top}\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Indexing"},{"DocComment":""},{"DocComment":" The `Vec` type allows access to values by index, because it implements the"},{"DocComment":" [`Index`] trait. An example will be more explicit:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = vec![0, 2, 4, 6];"},{"DocComment":" println!(\"{}\", v[1]); // it will display '2'"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However be careful: if you try to access an index which isn't in the `Vec`,"},{"DocComment":" your software will panic! You cannot do this:"},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" let v = vec![0, 2, 4, 6];"},{"DocComment":" println!(\"{}\", v[6]); // it will panic!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Use [`get`] and [`get_mut`] if you want to check whether the index is in"},{"DocComment":" the `Vec`."},{"DocComment":""},{"DocComment":" # Slicing"},{"DocComment":""},{"DocComment":" A `Vec` can be mutable. On the other hand, slices are read-only objects."},{"DocComment":" To get a [slice][prim@slice], use [`&`]. Example:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn read_slice(slice: &[usize]) {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let v = vec![0, 1];"},{"DocComment":" read_slice(&v);"},{"DocComment":""},{"DocComment":" // ... and that's all!"},{"DocComment":" // you can also do it like this:"},{"DocComment":" let u: &[usize] = &v;"},{"DocComment":" // or like this:"},{"DocComment":" let u: &[_] = &v;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In Rust, it's more common to pass slices as arguments rather than vectors"},{"DocComment":" when you just want to provide read access. The same goes for [`String`] and"},{"DocComment":" [`&str`]."},{"DocComment":""},{"DocComment":" # Capacity and reallocation"},{"DocComment":""},{"DocComment":" The capacity of a vector is the amount of space allocated for any future"},{"DocComment":" elements that will be added onto the vector. This is not to be confused with"},{"DocComment":" the *length* of a vector, which specifies the number of actual elements"},{"DocComment":" within the vector. If a vector's length exceeds its capacity, its capacity"},{"DocComment":" will automatically be increased, but its elements will have to be"},{"DocComment":" reallocated."},{"DocComment":""},{"DocComment":" For example, a vector with capacity 10 and length 0 would be an empty vector"},{"DocComment":" with space for 10 more elements. Pushing 10 or fewer elements onto the"},{"DocComment":" vector will not change its capacity or cause reallocation to occur. However,"},{"DocComment":" if the vector's length is increased to 11, it will have to reallocate, which"},{"DocComment":" can be slow. For this reason, it is recommended to use [`Vec::with_capacity`]"},{"DocComment":" whenever possible to specify how big the vector is expected to get."},{"DocComment":""},{"DocComment":" # Guarantees"},{"DocComment":""},{"DocComment":" Due to its incredibly fundamental nature, `Vec` makes a lot of guarantees"},{"DocComment":" about its design. This ensures that it's as low-overhead as possible in"},{"DocComment":" the general case, and can be correctly manipulated in primitive ways"},{"DocComment":" by unsafe code. Note that these guarantees refer to an unqualified `Vec<T>`."},{"DocComment":" If additional type parameters are added (e.g., to support custom allocators),"},{"DocComment":" overriding their defaults may change the behavior."},{"DocComment":""},{"DocComment":" Most fundamentally, `Vec` is and always will be a (pointer, capacity, length)"},{"DocComment":" triplet. No more, no less. The order of these fields is completely"},{"DocComment":" unspecified, and you should use the appropriate methods to modify these."},{"DocComment":" The pointer will never be null, so this type is null-pointer-optimized."},{"DocComment":""},{"DocComment":" However, the pointer might not actually point to allocated memory. In particular,"},{"DocComment":" if you construct a `Vec` with capacity 0 via [`Vec::new`], [`vec![]`][`vec!`],"},{"DocComment":" [`Vec::with_capacity(0)`][`Vec::with_capacity`], or by calling [`shrink_to_fit`]"},{"DocComment":" on an empty Vec, it will not allocate memory. Similarly, if you store zero-sized"},{"DocComment":" types inside a `Vec`, it will not allocate space for them. *Note that in this case"},{"DocComment":" the `Vec` might not report a [`capacity`] of 0*. `Vec` will allocate if and only"},{"DocComment":" if <code>[size_of::\\<T>]\\() * [capacity]\\() > 0</code>. In general, `Vec`'s allocation"},{"DocComment":" details are very subtle --- if you intend to allocate memory using a `Vec`"},{"DocComment":" and use it for something else (either to pass to unsafe code, or to build your"},{"DocComment":" own memory-backed collection), be sure to deallocate this memory by using"},{"DocComment":" `from_raw_parts` to recover the `Vec` and then dropping it."},{"DocComment":""},{"DocComment":" If a `Vec` *has* allocated memory, then the memory it points to is on the heap"},{"DocComment":" (as defined by the allocator Rust is configured to use by default), and its"},{"DocComment":" pointer points to [`len`] initialized, contiguous elements in order (what"},{"DocComment":" you would see if you coerced it to a slice), followed by <code>[capacity] - [len]</code>"},{"DocComment":" logically uninitialized, contiguous elements."},{"DocComment":""},{"DocComment":" A vector containing the elements `'a'` and `'b'` with capacity 4 can be"},{"DocComment":" visualized as below. The top part is the `Vec` struct, it contains a"},{"DocComment":" pointer to the head of the allocation in the heap, length and capacity."},{"DocComment":" The bottom part is the allocation on the heap, a contiguous memory block."},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":"             ptr      len  capacity"},{"DocComment":"        +--------+--------+--------+"},{"DocComment":"        | 0x0123 |      2 |      4 |"},{"DocComment":"        +--------+--------+--------+"},{"DocComment":"             |"},{"DocComment":"             v"},{"DocComment":" Heap   +--------+--------+--------+--------+"},{"DocComment":"        |    'a' |    'b' | uninit | uninit |"},{"DocComment":"        +--------+--------+--------+--------+"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" - **uninit** represents memory that is not initialized, see [`MaybeUninit`]."},{"DocComment":" - Note: the ABI is not stable and `Vec` makes no guarantees about its memory"},{"DocComment":"   layout (including the order of fields)."},{"DocComment":""},{"DocComment":" `Vec` will never perform a \"small optimization\" where elements are actually"},{"DocComment":" stored on the stack for two reasons:"},{"DocComment":""},{"DocComment":" * It would make it more difficult for unsafe code to correctly manipulate"},{"DocComment":"   a `Vec`. The contents of a `Vec` wouldn't have a stable address if it were"},{"DocComment":"   only moved, and it would be more difficult to determine if a `Vec` had"},{"DocComment":"   actually allocated memory."},{"DocComment":""},{"DocComment":" * It would penalize the general case, incurring an additional branch"},{"DocComment":"   on every access."},{"DocComment":""},{"DocComment":" `Vec` will never automatically shrink itself, even if completely empty. This"},{"DocComment":" ensures no unnecessary allocations or deallocations occur. Emptying a `Vec`"},{"DocComment":" and then filling it back up to the same [`len`] should incur no calls to"},{"DocComment":" the allocator. If you wish to free up unused memory, use"},{"DocComment":" [`shrink_to_fit`] or [`shrink_to`]."},{"DocComment":""},{"DocComment":" [`push`] and [`insert`] will never (re)allocate if the reported capacity is"},{"DocComment":" sufficient. [`push`] and [`insert`] *will* (re)allocate if"},{"DocComment":" <code>[len] == [capacity]</code>. That is, the reported capacity is completely"},{"DocComment":" accurate, and can be relied on. It can even be used to manually free the memory"},{"DocComment":" allocated by a `Vec` if desired. Bulk insertion methods *may* reallocate, even"},{"DocComment":" when not necessary."},{"DocComment":""},{"DocComment":" `Vec` does not guarantee any particular growth strategy when reallocating"},{"DocComment":" when full, nor when [`reserve`] is called. The current strategy is basic"},{"DocComment":" and it may prove desirable to use a non-constant growth factor. Whatever"},{"DocComment":" strategy is used will of course guarantee *O*(1) amortized [`push`]."},{"DocComment":""},{"DocComment":" It is guaranteed, in order to respect the intentions of the programmer, that"},{"DocComment":" all of `vec![e_1, e_2, ..., e_n]`, `vec![x; n]`, and [`Vec::with_capacity(n)`] produce a `Vec`"},{"DocComment":" that requests an allocation of the exact size needed for precisely `n` elements from the allocator,"},{"DocComment":" and no other size (such as, for example: a size rounded up to the nearest power of 2)."},{"DocComment":" The allocator will return an allocation that is at least as large as requested, but it may be larger."},{"DocComment":""},{"DocComment":" It is guaranteed that the [`Vec::capacity`] method returns a value that is at least the requested capacity"},{"DocComment":" and not more than the allocated capacity."},{"DocComment":""},{"DocComment":" The method [`Vec::shrink_to_fit`] will attempt to discard excess capacity an allocator has given to a `Vec`."},{"DocComment":" If <code>[len] == [capacity]</code>, then a `Vec<T>` can be converted"},{"DocComment":" to and from a [`Box<[T]>`][owned slice] without reallocating or moving the elements."},{"DocComment":" `Vec` exploits this fact as much as reasonable when implementing common conversions"},{"DocComment":" such as [`into_boxed_slice`]."},{"DocComment":""},{"DocComment":" `Vec` will not specifically overwrite any data that is removed from it,"},{"DocComment":" but also won't specifically preserve it. Its uninitialized memory is"},{"DocComment":" scratch space that it may use however it wants. It will generally just do"},{"DocComment":" whatever is most efficient or otherwise easy to implement. Do not rely on"},{"DocComment":" removed data to be erased for security purposes. Even if you drop a `Vec`, its"},{"DocComment":" buffer may simply be reused by another allocation. Even if you zero a `Vec`'s memory"},{"DocComment":" first, that might not actually happen because the optimizer does not consider"},{"DocComment":" this a side-effect that must be preserved. There is one case which we will"},{"DocComment":" not break, however: using `unsafe` code to write to the excess capacity,"},{"DocComment":" and then increasing the length to match, is always valid."},{"DocComment":""},{"DocComment":" Currently, `Vec` does not guarantee the order in which elements are dropped."},{"DocComment":" The order has changed in the past and may change again."},{"DocComment":""},{"DocComment":" [`get`]: slice::get"},{"DocComment":" [`get_mut`]: slice::get_mut"},{"DocComment":" [`String`]: crate::string::String"},{"DocComment":" [`&str`]: type@str"},{"DocComment":" [`shrink_to_fit`]: Vec::shrink_to_fit"},{"DocComment":" [`shrink_to`]: Vec::shrink_to"},{"DocComment":" [capacity]: Vec::capacity"},{"DocComment":" [`capacity`]: Vec::capacity"},{"DocComment":" [`Vec::capacity`]: Vec::capacity"},{"DocComment":" [size_of::\\<T>]: size_of"},{"DocComment":" [len]: Vec::len"},{"DocComment":" [`len`]: Vec::len"},{"DocComment":" [`push`]: Vec::push"},{"DocComment":" [`insert`]: Vec::insert"},{"DocComment":" [`reserve`]: Vec::reserve"},{"DocComment":" [`Vec::with_capacity(n)`]: Vec::with_capacity"},{"DocComment":" [`MaybeUninit`]: core::mem::MaybeUninit"},{"DocComment":" [owned slice]: Box"},{"DocComment":" [`into_boxed_slice`]: Vec::into_boxed_slice"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Vec"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,16],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":18,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["Range",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":887}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":17,"beg":{"line":82,"col":0},"end":{"line":82,"col":21}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A (half-open) range bounded inclusively below and exclusively above"},{"DocComment":" (`start..end`)."},{"DocComment":""},{"DocComment":" The range `start..end` contains all values with `start <= x < end`."},{"DocComment":" It is empty if `start >= end`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `start..end` syntax is a `Range`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((3..5), std::ops::Range { start: 3, end: 5 });"},{"DocComment":" assert_eq!(3 + 4 + 5, (3..6).sum());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]);"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{