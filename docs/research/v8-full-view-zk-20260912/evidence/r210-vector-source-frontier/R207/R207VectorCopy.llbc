d":false,"tagger":[[0,{"Unsigned":["U8","1"]}]]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":26,"item_meta":{"name":[{"Ident":["aspis_v8_performance_host",0]},{"Ident":["freeze",0]},{"Ident":["closure",2]}],"span":{"data":{"file_id":0,"beg":{"line":134,"col":14},"end":{"line":134,"col":110}},"generated_from_span":null},"source_text":"|v:&[K]|{let mut g=K::ONE;v.iter().fold(K::ZERO,|a,v|{let r=a.add(g.mul(*v));g=g.mul(gamma);r})}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":{"Closure":{"info":{"kind":"Fn","fn_once_impl":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":2,"generics":{"regions":[{"Var":{"Free":0}},{"Var":{"Bound":[0,0]}}],"types":[],"const_generics":[],"trait_refs":[]}}},"fn_mut_impl":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":3,"generics":{"regions":[{"Var":{"Free":0}},{"Var":{"Bound":[0,0]}}],"types":[],"const_generics":[],"trait_refs":[]}}},"fn_impl":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":4,"generics":{"regions":[{"Var":{"Free":0}},{"Var":{"Bound":[0,0]}}],"types":[],"const_generics":[],"trait_refs":[]}}},"signature":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[1060,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":545},"Shared"]}]}],"output":{"Deduplicated":544}}}}}},"kind":{"Struct":[{"span":{"data":{"file_id":0,"beg":{"line":134,"col":14},"end":{"line":134,"col":110}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"n