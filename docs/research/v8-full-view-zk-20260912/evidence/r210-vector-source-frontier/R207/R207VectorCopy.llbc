_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":544}}],"discriminant":{"Scalar":{"Signed":["Isize","1"]}}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":20,"align":4,"discriminator":{"Branch":{"offset":0,"int_ty":{"Unsigned":"U32"},"children":[[{"start":{"Unsigned":["U32","0"]},"end":{"Unsigned":["U32","0"]}},{"Known":0}],[{"start":{"Unsigned":["U32","1"]},"end":{"Unsigned":["U32","1"]}},{"Known":1}]],"fallback":"Invalid"}},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U32","0"]}]]},{"field_offsets":[4],"uninhabited":false,"tagger":[[0,{"Unsigned":["U32","1"]}]]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":28,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["manually_drop",0]},{"Ident":["ManuallyDrop",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":888}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":19,"beg":{"line":161,"col":0},"end":{"line":161,"col":34}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper to inhibit the compiler from automatically calling `T`’s"},{"DocComment":" destructor. This wrapper is 0-cost."},{"DocComment":""},{"DocComment":" `ManuallyDrop<T>` is guaranteed to have the same layout and bit validity as"},{"DocComment":" `T`, and is subject to the same layout optimizations as `T`. As a"},{"DocComment":" consequence, it has *no effect* on the assumptions that the compiler makes"},{"DocComment":" about its contents. For example, initializing a `ManuallyDrop<&mut T>` with"},{"DocComment":" [`mem::zeroed`] is undefined behavior. If you need to handle uninitialized"},{"DocComment":" data, use [`MaybeUninit<T>`] instead."},{"DocComment":""},{"DocComment":" Note that accessing the value inside a `ManuallyDrop<T>` is safe. This means"},{"DocComment":" that a `ManuallyDrop<T>` whose content has been dropped must not be exposed"},{"DocComment":" through a public safe API. Correspondingly, `ManuallyDrop::drop` is unsafe."},{"DocComment":""},{"DocComment":" # `ManuallyDrop` and drop order"},{"DocComment":""},{"DocComment":" Rust has a well-defined [drop order] of values. To make sure that fields or"},{"DocComment":" locals are dropped in a specific order, reorder the declarations such that"},{"DocComment":" the implicit drop order is the correct one."},{"DocComment":""},{"DocComment":" It is possible to use `ManuallyDrop` to control the drop order, but this"},{"DocComment":" requires unsafe code and is hard to do correctly in the presence of"},{"DocComment":" unwinding."},{"DocComment":""},{"DocComment":" For example, if you want to make sure that a specific field is dropped after"},{"DocComment":" the others, make it the last field of a struct:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct Context;"},{"DocComment":""},{"DocComment":" struct Widget {"},{"DocComment":"     children: Vec<Widget>,"},{"DocComment":"     // `context` will be dropped after `children`."},{"DocComment":"     // Rust guarantees that fields are dropped in the order of declaration."},{"DocComment":"     context: Context,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Interaction with `Box`"},{"DocComment":""},{"DocComment":" Currently, if you have a `ManuallyDrop<T>`, where the type `T` is a `Box` or"},{"DocComment":" contains a `Box` inside, then dropping the `T` followed by moving the"},{"DocComment":" `ManuallyDrop<T>` is [considered to be undefined"},{"DocComment":" behavior](https://github.com/rust-lang/unsafe-code-guidelines/issues/245)."},{"DocComment":" That is, the following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" let mut x = ManuallyDrop::new(Box::new(42));"},{"DocComment":" unsafe {"},{"DocComment":"     ManuallyDrop::drop(&mut x);"},{"DocComment":" }"},{"DocComment":" let y = x; // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This is [likely to change in the"},{"DocComment":" future](https://rust-lang.github.io/rfcs/3336-maybe-dangling.html). In the"},{"DocComment":" meantime, consider using [`MaybeUninit`] instead."},{"DocComment":""},{"DocComment":" # Safety hazards when storing `ManuallyDrop` in a struct or an enum."},{"DocComment":""},{"DocComment":" Special care is needed when all of the conditions below are met:"},{"DocComment":" * A struct or enum contains a `ManuallyDrop`."},{"DocComment":" * The `ManuallyDrop` is not inside a `union`."},{"DocComment":" * The struct or enum is part of public API, or is stored in a struct or an"},{"DocComment":"   enum that is part of public API."},{"DocComment":" * There is code that drops the contents of the `ManuallyDrop` field, and"},{"DocComment":"   this code is outside the struct or enum's `Drop` implementation."},{"DocComment":""},{"DocComment":" In particular, the following hazards may occur:"},{"DocComment":""},{"DocComment":" #### Storing generic types"},{"DocComment":""},{"DocComment":" If the `ManuallyDrop` contains a client-supplied generic type, the client"},{"DocComment":" might provide a `Box` as that type. This would cause undefined behavior when"},{"DocComment":" the struct or enum is later moved, as mentioned in the previous section. For"},{"DocComment":" example, the following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" pub struct BadOption<T> {"},{"DocComment":"     // Invariant: Has been dropped if `is_some` is false."},{"DocComment":"     value: ManuallyDrop<T>,"},{"DocComment":"     is_some: bool,"},{"DocComment":" }"},{"DocComment":" impl<T> BadOption<T> {"},{"DocComment":"     pub fn new(value: T) -> Self {"},{"DocComment":"         Self { value: ManuallyDrop::new(value), is_some: true }"},{"DocComment":"     }"},{"DocComment":"     pub fn change_to_none(&mut self) {"},{"DocComment":"         if self.is_some {"},{"DocComment":"             self.is_some = false;"},{"DocComment":"             unsafe {"},{"DocComment":"                 // SAFETY: `value` hasn't been dropped yet, as per the invariant"},{"DocComment":"                 // (This is actually unsound!)"},{"DocComment":"                 ManuallyDrop::drop(&mut self.value);"},{"DocComment":"             }"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let mut option = BadOption::new(Box::new(42));"},{"DocComment":" option.change_to_none();"},{"DocComment":" let option2 = option; // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" #### Deriving traits"},{"DocComment":""},{"DocComment":" Deriving `Debug`, `Clone`, `PartialEq`, `PartialOrd`, `Ord`, or `Hash` on"},{"DocComment":" the struct or enum could be unsound, since the derived implementations of"},{"DocComment":" these traits would access the `ManuallyDrop` field. For example, the"},{"DocComment":" following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" // This derive is unsound in combination with the `ManuallyDrop::drop` call."},{"DocComment":" #[derive(Debug)]"},{"DocComment":" pub struct Foo {"},{"DocComment":"     value: ManuallyDrop<String>,"},{"DocComment":" }"},{"DocComment":" impl Foo {"},{"DocComment":"     pub fn new() -> Self {"},{"DocComment":"         let mut temp = Self {"},{"DocComment":"             value: ManuallyDrop::new(String::from(\"Unsafe rust is hard.\"))"},{"DocComment":"         };"},{"DocComment":"         unsafe {"},{"DocComment":"             // SAFETY: `value` hasn't been dropped yet."},{"DocComment":"             ManuallyDrop::drop(&mut temp.value);"},{"DocComment":"         }"},{"DocComment":"         temp"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let foo = Foo::new();"},{"DocComment":" println!(\"{:?}\", foo); // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [drop order]: https://doc.rust-lang.org/reference/destructors.html"},{"DocComment":" [`mem::zeroed`]: crate::mem::zeroed"},{"DocComment":" [`MaybeUninit<T>`]: crate::mem::MaybeUninit"},{"DocComment":" [`MaybeUninit`]: crate::mem::MaybeUninit"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"manually_drop"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":1,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":29,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_dangling",0]},{"Ident":["MaybeDangling",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":888}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":20,"beg":{"line":74,"col":0},"end":{"line":74,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Allows wrapped [references] and [boxes] to dangle."},{"DocComment":""},{"DocComment":" That is, if a reference (or a `Box`) is wrapped in `MaybeDangling` (including when in a"},{"DocComment":" (nested) field of a compound type wrapped in `MaybeDangling`), it does not have to follow"},{"DocComment":" pointer aliasing rules or be dereferenceable."},{"DocComment":""},{"DocComment":" This can be useful when the value can become dangling while the function holding it is still"},{"DocComment":" executing (particularly in concurrent code). As a somewhat absurd example, consider this code:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" #![feature(box_as_ptr)]"},{"DocComment":" # use std::alloc::{dealloc, Layout};"},{"DocComment":" # use std::mem;"},{"DocComment":""},{"DocComment":" let mut boxed = Box::new(0_u32);"},{"DocComment":" let ptr = Box::as_mut_ptr(&mut boxed);"},{"DocComment":""},{"DocComment":" // Safety: the pointer comes from a box and thus was allocated before; `box` is not used afterwards"},{"DocComment":" unsafe { dealloc(ptr.cast(), Layout::new::<u32>()) };"},{"DocComment":""},{"DocComment":" mem::forget(boxed); // <-- this is UB!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Even though the `Box`'s destructor is not run (and thus we don't have a double free bug), this"},{"DocComment":" code is still UB. This is because when moving `boxed` into `forget`, its validity invariants"},{"DocComment":" are asserted, causing UB since the `Box` is dangling. The safety comment is as such wrong, as"},{"DocComment":" moving the `boxed` variable as part of the `forget` call *is* a use."},{"DocComment":""},{"DocComment":" To fix this we could use `MaybeDangling`:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" #![feature(maybe_dangling, box_as_ptr)]"},{"DocComment":" # use std::alloc::{dealloc, Layout};"},{"DocComment":" # use std::mem::{self, MaybeDangling};"},{"DocComment":""},{"DocComment":" let mut boxed = MaybeDangling::new(Box::new(0_u32));"},{"DocComment":" let ptr = Box::as_mut_ptr(boxed.as_mut());"},{"DocComment":""},{"DocComment":" // Safety: the pointer comes from a box and thus was allocated before; `box` is not used afterwards"},{"DocComment":" unsafe { dealloc(ptr.cast(), Layout::new::<u32>()) };"},{"DocComment":""},{"DocComment":" mem::forget(boxed); // <-- this is OK!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that the bit pattern must still be valid for the wrapped type. That is, [references]"},{"DocComment":" (and [boxes]) still must be aligned and non-null."},{"DocComment":""},{"DocComment":" Additionally note that safe code can still assume that the inner value in a `MaybeDangling` is"},{"DocComment":" **not** dangling -- functions like [`as_ref`] and [`into_inner`] are safe. It is not sound to"},{"DocComment":" return a dangling reference in a `MaybeDangling` to safe code. However, it *is* sound"},{"DocComment":" to hold such values internally inside your code -- and there's no way to do that without"},{"DocComment":" this type. Note that other types can use this type and thus get the same effect; in particular,"},{"DocComment":" [`ManuallyDrop`] will use `MaybeDangling`."},{"DocComment":""},{"DocComment":" Note that `MaybeDangling` doesn't prevent drops from being run, which can lead to UB if the"},{"DocComment":" drop observes a dangling value. If you need to prevent drops from being run use [`ManuallyDrop`]"},{"DocComment":" instead."},{"DocComment":""},{"DocComment":" [references]: prim@reference"},{"DocComment":" [boxes]: ../../std/boxed/struct.Box.html"},{"DocComment":" [`into_inner`]: MaybeDangling::into_inner"},{"DocComment":" [`as_ref`]: MaybeDangling::as_ref"},{"DocComment":" [`ManuallyDrop`]: crate::mem::ManuallyDrop"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"maybe_dangling"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses