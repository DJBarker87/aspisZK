          "attr_info": {
            "attributes": [
              {
                "DocComment": " Sample a secure layer-zero circle OOD point through an exact-uniform"
              },
              {
                "DocComment": " QM31 parameter `t` and the rational map. The bounded policy rejects"
              },
              {
                "DocComment": " `t in CM31` and `1+t^2=0`; the pure map reports those reasons in"
              },
              {
                "DocComment": " [`crate::circle::CirclePointError`], while this transcript API exposes"
              },
              {
                "DocComment": " one bounded-candidate exhaustion result. No inversion path panics."
              }
            ],
