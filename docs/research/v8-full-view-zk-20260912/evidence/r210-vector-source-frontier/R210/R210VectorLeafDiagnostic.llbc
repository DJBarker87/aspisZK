            "generated_from_span": null
          },
          "source_text": null,
          "attr_info": {
            "attributes": [
              {
                "DocComment": " Apply the same rational map under Aspis's layer-zero OOD policy."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " The finite rational map is injective with inverse `t = y/(1+x)` and never"
              },
              {
                "DocComment": " reaches `x = -1`. Rejecting `t in CM31` therefore guarantees that the"
              },
              {
                "DocComment": " resulting point cannot have both coordinates in CM31. In particular it is"
              },
              {
                "DocComment": " outside the M31 circle evaluation domain. Later line layers do not use"
              },
              {
                "DocComment": " this map; they retain the exact-uniform `QM31 \\ CM31` scalar sampler."
              }
            ],
            "inline": null,
            "rename": null,
            "public": true
          },
          "is_local": false,
          "opacity": "Foreign",
          "lang_item": null
        },
