              {
                "DocComment": ""
              },
              {
                "DocComment": " # Examples"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": " let vec = vec!['a', 'b', 'c'];"
              },
              {
                "DocComment": " let mut into_iter = vec.into_iter();"
              },
              {
                "DocComment": " assert_eq!(into_iter.as_slice(), &['a', 'b', 'c']);"
