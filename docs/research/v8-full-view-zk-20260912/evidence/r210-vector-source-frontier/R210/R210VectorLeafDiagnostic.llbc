          },
          "source_text": null,
          "attr_info": {
            "attributes": [
              {
                "DocComment": " An attempted conversion that consumes `self`, which may or may not be"
              },
              {
                "DocComment": " expensive."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " Library authors should usually not directly implement this trait,"
              },
              {
                "DocComment": " but should prefer implementing the [`TryFrom`] trait, which offers"
              },
              {
                "DocComment": " greater flexibility and provides an equivalent `TryInto`"
              },
              {
                "DocComment": " implementation for free, thanks to a blanket implementation in the"
              },
              {
                "DocComment": " standard library. For more information on this, see the"
              },
              {
                "DocComment": " documentation for [`Into`]."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " Prefer using [`TryInto`] over [`TryFrom`] when specifying trait bounds on a generic function"
              },
              {
                "DocComment": " to ensure that types that only implement [`TryInto`] can be used as well."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Implementing `TryInto`"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " This suffers the same restrictions and reasoning as implementing"
              },
              {
                "DocComment": " [`Into`], see there for details."
              }
            ],
            "inline": null,
            "rename": null,
            "public": true
          },
          "is_local": false,
          "opacity": "Foreign",
          "lang_item": "TryInto"
        },
