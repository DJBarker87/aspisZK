          "source_text": null,
          "attr_info": {
            "attributes": [
              {
                "DocComment": " Creates a native endian integer value from its representation"
              },
              {
                "DocComment": " as a byte array in little endian."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Examples"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": "let value = u32::from_le_bytes([0x78, 0x56, 0x34, 0x12]);"
              },
              {
                "DocComment": "assert_eq!(value, 0x12345678);"
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " When starting from a slice rather than an array, fallible conversion APIs can be used:"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": "fn read_le_u32(input: &mut &[u8]) -> u32 {"
              },
              {
                "DocComment": "    let (int_bytes, rest) = input.split_at(size_of::<u32>());"
              },
              {
                "DocComment": "     *input = rest;"
              },
              {
                "DocComment": "    u32::from_le_bytes(int_bytes.try_into().unwrap())"
              },
              {
                "DocComment": " }"
              },
              {
                "DocComment": " ```"
              }
            ],
            "inline": "Hint",
            "rename": null,
            "public": true
          },
          "is_local": false,
          "opacity": "Foreign",
