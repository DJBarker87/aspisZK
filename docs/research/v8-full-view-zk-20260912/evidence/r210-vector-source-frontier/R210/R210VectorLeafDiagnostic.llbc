          "source_text": null,
          "attr_info": {
            "attributes": [
              {
                "DocComment": " A range only bounded exclusively above (`..end`)."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " The `RangeTo` `..end` contains all values with `x < end`."
              },
              {
                "DocComment": " It cannot serve as an [`Iterator`] because it doesn't have a starting point."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Examples"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " The `..end` syntax is a `RangeTo`:"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": " assert_eq!((..5), std::ops::RangeTo { end: 5 });"
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " It does not have an [`IntoIterator`] implementation, so you can't use it in"
              },
              {
                "DocComment": " a `for` loop directly. This won't compile:"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```compile_fail,E0277"
              },
              {
                "DocComment": " // error[E0277]: the trait bound `std::ops::RangeTo<{integer}>:"
              },
              {
                "DocComment": " // std::iter::Iterator` is not satisfied"
              },
              {
                "DocComment": " for i in ..5 {"
              },
              {
                "DocComment": "     // ..."
              },
              {
                "DocComment": " }"
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " When used as a [slicing index], `RangeTo` produces a slice of all array"
              },
              {
                "DocComment": " elements before the index indicated by `end`."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": " let arr = [0, 1, 2, 3, 4];"
              },
              {
                "DocComment": " assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"
              },
              {
                "DocComment": " assert_eq!(arr[ .. 3], [0, 1, 2      ]); // This is a `RangeTo`"
              },
              {
                "DocComment": " assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"
              },
              {
                "DocComment": " assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"
              },
              {
                "DocComment": " assert_eq!(arr[1.. 3], [   1, 2      ]);"
              },
              {
                "DocComment": " assert_eq!(arr[1..=3], [   1, 2, 3   ]);"
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " [slicing index]: crate::slice::SliceIndex"
              }
            ],
            "inline": null,
            "rename": null,
            "public": true
          },
          "is_local": false,
          "opacity": "Foreign",
          "lang_item": "RangeTo"
