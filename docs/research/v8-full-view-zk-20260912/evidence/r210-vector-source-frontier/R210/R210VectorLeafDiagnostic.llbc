          "attr_info": {
            "attributes": [
              {
                "DocComment": " Mutable slice iterator."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " This struct is created by the [`iter_mut`] method on [slices]."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Examples"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " Basic usage:"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": " // First, we need a slice to call the `iter_mut` method on:"
              },
              {
                "DocComment": " let slice = &mut [1, 2, 3];"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " // Then we call `iter_mut` on the slice to get the `IterMut` iterator,"
              },
              {
                "DocComment": " // iterate over it and increment each element value:"
              },
              {
                "DocComment": " for element in slice.iter_mut() {"
              },
              {
                "DocComment": "     *element += 1;"
              },
              {
                "DocComment": " }"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " // We now have \"[2, 3, 4]\":"
              },
              {
                "DocComment": " println!(\"{slice:?}\");"
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " [`iter_mut`]: slice::iter_mut"
              },
              {
                "DocComment": " [slices]: slice"
              }
            ],
            "inline": null,
            "rename": null,
            "public": true
          },
          "is_local": false,
          "opacity": "Foreign",
          "lang_item": null
