          "attr_info": {
            "attributes": [
              {
                "DocComment": " Returns an iterator over the slice."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " The iterator yields all items from start to end."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Examples"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": " let x = &[1, 2, 4];"
              },
              {
                "DocComment": " let mut iterator = x.iter();"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " assert_eq!(iterator.next(), Some(&1));"
              },
              {
                "DocComment": " assert_eq!(iterator.next(), Some(&2));"
              },
              {
                "DocComment": " assert_eq!(iterator.next(), Some(&4));"
              },
              {
                "DocComment": " assert_eq!(iterator.next(), None);"
              },
              {
                "DocComment": " ```"
              }
            ],
            "inline": "Hint",
            "rename": null,
            "public": true
          },
