          "attr_info": {
            "attributes": [
              {
                "DocComment": " Maps a `Result<T, E>` to `Result<T, F>` by applying a function to a"
              },
              {
                "DocComment": " contained [`Err`] value, leaving an [`Ok`] value untouched."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " This function can be used to pass through a successful result while handling"
              },
              {
                "DocComment": " an error."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Examples"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": " fn stringify(x: u32) -> String { format!(\"error code: {x}\") }"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " let x: Result<u32, u32> = Ok(2);"
              },
              {
                "DocComment": " assert_eq!(x.map_err(stringify), Ok(2));"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " let x: Result<u32, u32> = Err(13);"
              },
              {
                "DocComment": " assert_eq!(x.map_err(stringify), Err(\"error code: 13\".to_string()));"
              },
              {
                "DocComment": " ```"
              }
            ],
            "inline": "Hint",
