              }
            },
            "generated_from_span": null
          },
          "source_text": null,
          "attr_info": {
            "attributes": [
              {
                "DocComment": " Provides associated constants for various useful properties of types,"
              },
              {
                "DocComment": " to give them a canonical form in our code and make them easier to read."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " This is here only to simplify all the ZST checks we need in the library."
              },
              {
                "DocComment": " It's not on a stabilization track right now."
              }
            ],
            "inline": null,
            "rename": null,
            "public": true
          },
          "is_local": false,
          "opacity": "Foreign",
          "lang_item": null
        },
