          "attr_info": {
            "attributes": [
              {
                "DocComment": " Maps a `Result<T, E>` to `Result<T, F>` by applying a function to a"
              },
              {
                "DocComment": " contained [`Err`] value, leaving an [`Ok`] value untouched."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " This function can be used to pass through a successful result while handling"
