          "source_text": null,
          "attr_info": {
            "attributes": [
              {
                "DocComment": " Creates a consuming iterator, that is, one that moves each value out of"
              },
              {
                "DocComment": " the vector (from start to end). The vector cannot be used after calling"
              },
              {
                "DocComment": " this."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Examples"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": " let v = vec![\"a\".to_string(), \"b\".to_string()];"
              },
              {
                "DocComment": " let mut v_iter = v.into_iter();"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " let first_element: Option<String> = v_iter.next();"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " assert_eq!(first_element, Some(\"a\".to_string()));"
              },
              {
                "DocComment": " assert_eq!(v_iter.next(), Some(\"b\".to_string()));"
              },
              {
                "DocComment": " assert_eq!(v_iter.next(), None);"
              },
              {
                "DocComment": " ```"
              }
            ],
            "inline": "Hint",
            "rename": null,
            "public": true
          },
          "is_local": false,
          "opacity": "Transparent",
          "lang_item": null
