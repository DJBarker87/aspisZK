              "Ident": [
                "unique",
                0
              ]
            },
            {
              "Ident": [
                "Unique",
                0
              ]
            },
            {
              "Instantiated": {
                "params": {
                  "regions": [],
                  "types": [],
                  "const_generics": [],
                  "trait_clauses": [],
                  "regions_outlive": [],
                  "types_outlive": [],
