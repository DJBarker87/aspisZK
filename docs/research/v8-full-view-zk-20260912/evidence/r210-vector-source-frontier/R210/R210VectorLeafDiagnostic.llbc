          "attr_info": {
            "attributes": [
              {
                "DocComment": " # Overflow Behavior"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " The method does no guarding against overflows, so enumerating more than"
              },
              {
                "DocComment": " `usize::MAX` elements either produces the wrong result or panics. If"
              },
              {
                "DocComment": " overflow checks are enabled, a panic is guaranteed."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Panics"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " Might panic if the index of the element overflows a `usize`."
              }
            ],
            "inline": "Hint",
