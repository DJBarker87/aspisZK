          "attr_info": {
            "attributes": [
              {
                "DocComment": " Converts to `Box<T, A>`."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Safety"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " As with [`MaybeUninit::assume_init`],"
              },
              {
                "DocComment": " it is up to the caller to guarantee that the value"
              },
              {
                "DocComment": " really is in an initialized state."
              },
              {
                "DocComment": " Calling this when the content is not yet fully initialized"
              },
              {
                "DocComment": " causes immediate undefined behavior."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " [`MaybeUninit::assume_init`]: mem::MaybeUninit::assume_init"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Examples"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": " let mut five = Box::<u32>::new_uninit();"
              },
              {
                "DocComment": " // Deferred initialization:"
              },
              {
                "DocComment": " five.write(5);"
              },
              {
                "DocComment": " let five: Box<u32> = unsafe { five.assume_init() };"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " assert_eq!(*five, 5)"
              },
              {
                "DocComment": " ```"
              }
            ],
            "inline": "Always",
            "rename": null,
            "public": true
          },
