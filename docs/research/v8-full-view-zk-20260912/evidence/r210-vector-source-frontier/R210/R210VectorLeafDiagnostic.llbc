                    {
                      "Deduplicated": 798
                    }
                  ],
                  "const_generics": [],
                  "trait_refs": []
                },
                "kind": "Other"
              }
            }
          ],
          "span": {
            "data": {
              "file_id": 28,
              "beg": {
                "line": 4321,
                "col": 4
              },
              "end": {
                "line": 4323,
                "col": 16
              }
            },
            "generated_from_span": null
          },
          "source_text": null,
          "attr_info": {
            "attributes": [
              {
                "DocComment": " Copies all elements from `src` into `self`, using a memcpy."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " The length of `src` must be the same as `self`."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " If `T` does not implement `Copy`, use [`clone_from_slice`]."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Panics"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " This function will panic if the two slices have different lengths."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Examples"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " Copying two elements from a slice into another:"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": " let src = [1, 2, 3, 4];"
              },
              {
                "DocComment": " let mut dst = [0, 0];"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " // Because the slices have to be the same length,"
              },
              {
                "DocComment": " // we slice the source slice from four elements"
              },
              {
                "DocComment": " // to two. It will panic if we don't do this."
              },
              {
                "DocComment": " dst.copy_from_slice(&src[2..]);"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " assert_eq!(src, [1, 2, 3, 4]);"
              },
              {
                "DocComment": " assert_eq!(dst, [3, 4]);"
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " Rust enforces that there can only be one mutable reference with no"
              },
              {
                "DocComment": " immutable references to a particular piece of data in a particular"
              },
              {
                "DocComment": " scope. Because of this, attempting to use `copy_from_slice` on a"
              },
              {
                "DocComment": " single slice will result in a compile failure:"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```compile_fail"
              },
              {
                "DocComment": " let mut slice = [1, 2, 3, 4, 5];"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " slice[..2].copy_from_slice(&slice[3..]); // compile fail!"
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " To work around this, we can use [`split_at_mut`] to create two distinct"
              },
              {
                "DocComment": " sub-slices from a slice:"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": " let mut slice = [1, 2, 3, 4, 5];"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " {"
              },
              {
                "DocComment": "     let (left, right) = slice.split_at_mut(2);"
              },
              {
                "DocComment": "     left.copy_from_slice(&right[1..]);"
              },
              {
                "DocComment": " }"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " assert_eq!(slice, [4, 5, 3, 4, 5]);"
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " [`clone_from_slice`]: slice::clone_from_slice"
              },
              {
                "DocComment": " [`split_at_mut`]: slice::split_at_mut"
              }
            ],
            "inline": "Hint",
            "rename": null,
            "public": true
          },
          "is_local": false,
          "opacity": "Foreign",
          "lang_item": null
        },
