                "challenge_qm31",
                0
              ]
            }
          ],
          "span": {
            "data": {
              "file_id": 1,
              "beg": {
                "line": 378,
                "col": 4
              },
              "end": {
                "line": 378,
                "col": 78
              }
            },
            "generated_from_span": null
          },
          "source_text": null,
          "attr_info": {
            "attributes": [
              {
                "DocComment": " Sample a QM31 challenge by per-limb rejection sampling (exactly"
              },
              {
                "DocComment": " uniform; soundness-note §3 T9)."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " Each limb draw takes 31 bits of a LE u32 and REJECTS the single"
              },
              {
                "DocComment": " non-canonical value P, redrawing from fresh transcript bytes: retries"
              },
              {
                "DocComment": " consume the next word of the block stream, and a spent block is"
              },
              {
                "DocComment": " replaced via `squeeze_block`, which advances the duplex state — no"
              },
              {
                "DocComment": " input is ever re-hashed, so retries cannot repeat a rejected value"
              },
              {
                "DocComment": " deterministically. The retry loop is bounded (`CHALLENGE_RETRY_LIMIT`)"
              },
              {
                "DocComment": " and exhaustion is an error the verifier surfaces as proof rejection:"
              },
              {
                "DocComment": " per-limb exhaustion probability is (2^-31)^8 = 2^-248, a completeness"
              },
              {
                "DocComment": " event (soundness-note §6), the correct trade on a CU-metered chain"
              },
              {
                "DocComment": " versus an unmetered loop."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " In the non-rejecting case (all real transcripts, whp) this consumes"
              },
              {
                "DocComment": " exactly one block and produces the same limbs as the pre-fix sampler"
              },
              {
                "DocComment": " except on a P-hit, where the old code folded P to 0 (the ~2^-31"
              },
              {
                "DocComment": " per-limb bias this fix removes)."
              }
            ],
            "inline": null,
            "rename": null,
            "public": true
          },
          "is_local": false,
          "opacity": "Foreign",
          "lang_item": null
        },
        "generics": {
