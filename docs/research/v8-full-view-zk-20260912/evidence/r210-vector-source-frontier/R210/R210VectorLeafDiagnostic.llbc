          "attr_info": {
            "attributes": [
              {
                "DocComment": " Apply the rational circle parameterization"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " `x = (1 - t^2)/(1 + t^2), y = 2t/(1 + t^2)`."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " This pure algebra helper accepts parameters from any subfield, but returns"
              },
              {
                "DocComment": " an explicit error when the denominator is zero. It never calls the"
              },
              {
                "DocComment": " panicking inverse API."
              }
            ],
            "inline": null,
            "rename": null,
            "public": true
          },
