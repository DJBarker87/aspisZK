          "source_text": null,
          "attr_info": {
            "attributes": [
              {
                "DocComment": " Transforms the `Option<T>` into a [`Result<T, E>`], mapping [`Some(v)`] to"
              },
              {
                "DocComment": " [`Ok(v)`] and [`None`] to [`Err(err)`]."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " Arguments passed to `ok_or` are eagerly evaluated; if you are passing the"
              },
              {
                "DocComment": " result of a function call, it is recommended to use [`ok_or_else`], which is"
              },
              {
                "DocComment": " lazily evaluated."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " [`Ok(v)`]: Ok"
              },
              {
                "DocComment": " [`Err(err)`]: Err"
              },
              {
                "DocComment": " [`Some(v)`]: Some"
              },
              {
                "DocComment": " [`ok_or_else`]: Option::ok_or_else"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Examples"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": " let x = Some(\"foo\");"
              },
              {
                "DocComment": " assert_eq!(x.ok_or(0), Ok(\"foo\"));"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " let x: Option<&str> = None;"
              },
              {
                "DocComment": " assert_eq!(x.ok_or(0), Err(0));"
              },
              {
                "DocComment": " ```"
              }
            ],
            "inline": "Hint",
            "rename": null,
            "public": true
          },
