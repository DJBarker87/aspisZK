            "generated_from_span": null
          },
          "source_text": null,
          "attr_info": {
            "attributes": [
              {
                "DocComment": " Reserves capacity for at least `additional` more elements to be inserted"
              },
              {
                "DocComment": " in the given `Vec<T>`. The collection may reserve more space to"
              },
              {
                "DocComment": " speculatively avoid frequent reallocations. After calling `reserve`,"
              },
              {
                "DocComment": " capacity will be greater than or equal to `self.len() + additional`."
              },
              {
                "DocComment": " Does nothing if capacity is already sufficient."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Panics"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " Panics if the new capacity exceeds `isize::MAX` _bytes_."
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " # Examples"
              },
              {
                "DocComment": ""
              },
              {
                "DocComment": " ```"
              },
              {
                "DocComment": " let mut vec = vec![1];"
              },
              {
                "DocComment": " vec.reserve(10);"
              },
              {
                "DocComment": " assert!(vec.capacity() >= 11);"
              },
              {
                "DocComment": " ```"
              }
            ],
            "inline": null,
            "rename": null,
            "public": true
          },
          "is_local": false,
          "opacity": "Foreign",
          "lang_item": "vec_reserve"
        },
