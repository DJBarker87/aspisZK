+(** Recognize only a scalar integer NamedConst whose initializer is one of the
+    two exact compiler-emitted bodies below. Any other shape falls back to the
+    ordinary symbolic-global path. *)
+let eval_named_const_scalar_initializer (span : Meta.span)
+    (gref : global_decl_ref) (global : global_decl) (ctx : eval_ctx) : tvalue option =
+  let integer_literal_to_value (lit : literal) : tvalue option =
+    match (global.ty, lit) with
+    | TLiteral (TInt expected as lit_ty),
+      VScalar (SignedScalar (actual, _) as scalar)
+      when expected = actual ->
+        Some (literal_to_tvalue span lit_ty (VScalar scalar) ctx)
+    | TLiteral (TUInt expected as lit_ty),
+      VScalar (UnsignedScalar (actual, _) as scalar)
+      when expected = actual ->
+        Some (literal_to_tvalue span lit_ty (VScalar scalar) ctx)
+    | _ -> None
+  in
+  let constant_integer_literal = function
+    | Constant { kind = CLiteral lit; ty } when ty = global.ty ->
+        integer_literal_to_value lit
+    | _ -> None
+  in
+  let is_local_id n id = id = LocalId.of_int n in
+  if
+    global.global_kind <> NamedConst
+    || global.generics <> empty_generic_params
+    || gref.generics <> empty_generic_args
+    || global.value.ty <> global.ty
+  then None
+  else
+    match global.value.kind with
+    | CCall
+        ({ kind = FunId (FRegular fid); generics }, [])
+      when generics = empty_generic_args ->
+        (match FunDeclId.Map.find_opt fid ctx.crate.fun_decls with
+        | None -> None
+        | Some fdef ->
+            if
+              fdef.is_global_initializer <> Some global.def_id
+              || fdef.generics <> empty_generic_params
+              || fdef.signature.inputs <> []
+              || fdef.signature.output <> global.ty
+            then None
+            else
+              match body_as_body fdef.body with
+              | None -> None
+              | Some body
+                when body.bound_body_regions = 0
+                     && body.locals.arg_count = 0 ->
+                  (match body.body.statements with
+                  | [
+                   { kind = StorageLive ret_id; _ };
+                   {
+                     kind =
+                       Assign
+                         ( { kind = PlaceLocal dest_id; ty = dest_ty },
+                           Use
+                             ( Constant { kind = CLiteral lit; ty = const_ty },
+                               (NoRetag | YesRetag) ) );
+                     _;
+                   };
+                   { kind = Return; _ };
+                  ]
+                    when is_local_id 0 ret_id
+                         && is_local_id 0 dest_id
+                         && dest_ty = global.ty
+                         && const_ty = global.ty ->
+                      (match body.locals.locals with
+                      | [ret]
+                        when is_local_id 0 ret.index
+                             && ret.local_ty = global.ty ->
+                          integer_literal_to_value lit
+                      | _ -> None)
+                  | [
+                   { kind = StorageLive ret_id; _ };
+                   { kind = StorageLive tmp_id; _ };
+                   {
+                     kind =
+                       Assign
+                         ( { kind = PlaceLocal tmp_dest; ty = tmp_dest_ty },
+                           BinaryOp (Add OPanic, op1, op2) );
+                     _;
+                   };
+                   {
+                     kind =
+                       Assign
+                         ( { kind = PlaceLocal ret_dest; ty = ret_dest_ty },
+                           Use
+                             ( Move { kind = PlaceLocal moved_tmp; ty = moved_ty },
+                               (NoRetag | YesRetag) ) );
+                     _;
+                   };
+                   { kind = Return; _ };
+                  ]
+                    when is_local_id 0 ret_id
+                         && is_local_id 1 tmp_id
+                         && is_local_id 1 tmp_dest
+                         && tmp_dest_ty = global.ty
+                         && is_local_id 0 ret_dest
+                         && ret_dest_ty = global.ty
+                         && is_local_id 1 moved_tmp
+                         && moved_ty = global.ty ->
+                      (match body.locals.locals with
+                      | [ ret; tmp ]
+                        when is_local_id 0 ret.index
+                             && ret.local_ty = global.ty
+                             && is_local_id 1 tmp.index
+                             && tmp.local_ty = global.ty ->
+                          (match (constant_integer_literal op1,
+                                  constant_integer_literal op2) with
+                          | Some v1, Some v2 ->
+                              (match
+                                 eval_binary_op_concrete_compute span
+                                   (Add OPanic) v1 v2 ctx
+                               with
+                              | Ok value when value.ty = global.ty -> Some value
+                              | Ok _ | Error _ -> None)
+                          | _ -> None)
+                      | _ -> None)
+                  | _ -> None)
+              | Some _ -> None)
+    | _ -> None
+
