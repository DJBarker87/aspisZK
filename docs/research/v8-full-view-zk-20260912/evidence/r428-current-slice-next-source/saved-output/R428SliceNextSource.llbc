ageDead":5},"comments_before":[]},{"span":{"data":{"file_id":19,"beg":{"line":2894,"col":13},"end":{"line":2894,"col":13}},"generated_from_span":null},"id":5506,"kind":{"StorageDead":4},"comments_before":[]},{"span":{"data":{"file_id":19,"beg":{"line":2894,"col":13},"end":{"line":2894,"col":13}},"generated_from_span":null},"id":5507,"kind":{"StorageDead":3},"comments_before":[]},{"span":{"data":{"file_id":19,"beg":{"line":2894,"col":13},"end":{"line":2894,"col":13}},"generated_from_span":null},"id":5508,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"data":{"file_id":19,"beg":{"line":2894,"col":13},"end":{"line":2894,"col":13}},"generated_from_span":null},"id":5509,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":19,"beg":{"line":2894,"col":13},"end":{"line":2894,"col":13}},"generated_from_span":null},"id":7436,"kind":{"StorageDead":9},"comments_before":[]},{"span":{"data":{"file_id":19,"beg":{"line":2894,"col":13},"end":{"line":2894,"col":13}},"generated_from_span":null},"id":7437,"kind":{"StorageDead":8},"comments_before":[]},{"span":{"data":{"file_id":19,"beg":{"line":2894,"col":13},"end":{"line":2894,"col":13}},"generated_from_span":null},"id":5510,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":37,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["try_fold",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":787},{"Deduplicated":587},{"Deduplicated":2755},{"Deduplicated":1944}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"data":{"file_id":19,"beg":{"line":2486,"col":4},"end":{"line":2490,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator method that applies a function as long as it returns"},{"DocComment":" successfully, producing a single, final value."},{"DocComment":""},{"DocComment":" `try_fold()` takes two arguments: an initial value, and a closure with"},{"DocComment":" two arguments: an 'accumulator', and an element. The closure either"},{"DocComment":" returns successfully, with the value that the accumulator should have"},{"DocComment":" for the next iteration, or it returns failure, with an error value that"},{"DocComment":" is propagated back to the caller immediately (short-circuiting)."},{"DocComment":""},{"DocComment":" The initial value is the value the accumulator will have on the first"},{"DocComment":" call. If applying the closure succeeded against every element of the"},{"DocComment":" iterator, `try_fold()` returns the final accumulator as success."},{"DocComment":""},{"DocComment":" Folding is useful whenever you have a collection of something, and want"},{"DocComment":" to produce a single value from it."},{"DocComment":""},{"DocComment":" # Note to Implementors"},{"DocComment":""},{"DocComment":" Several of the other (forward) methods have default implementations in"},{"DocComment":" terms of this one, so try to implement this explicitly if it can"},{"DocComment":" do something better than the default `for` loop implementation."},{"DocComment":""},{"DocComment":" In particular, try to have this call `try_fold()` on the internal parts"},{"DocComment":" from which this iterator is composed. If multiple calls are needed,"},{"DocComment":" the `?` operator may be convenient for chaining the accumulator value"},{"DocComment":" along, but beware any invariants that need to be upheld before those"},{"DocComment":" early returns. This is a `&mut self` method, so iteration needs to be"},{"DocComment":" resumable after hitting an error here."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" // the checked sum of all of the elements of the array"},{"DocComment":" let sum = a.into_iter().try_fold(0i8, |acc, x| acc.checked_add(x));"},{"DocComment":""},{"DocComment":" assert_eq!(sum, Some(6));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Short-circuiting:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [10, 20, 30, 100, 40, 50];"},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" // This sum overflows when adding the 100 element"},{"DocComment":" let sum = iter.try_fold(0i8, |acc, x| acc.checked_add(x));"},{"DocComment":" assert_eq!(sum, None);"},{"DocComment":""},{"DocComment":" // Because it short-circuited, the remaining elements are still"},{"DocComment":" // available through the iterator."},{"DocComment":" assert_eq!(iter.len(), 2);"},{"DocComment":" assert_eq!(iter.next(), Some(40));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" While you cannot `break` from a closure, the [`ControlFlow`] type allows"},{"DocComment":" a similar idea:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let triangular = (1..30).try_fold(0_i8, |prev, x| {"},{"DocComment":"     if let Some(next) = prev.checked_add(x) {"},{"DocComment":"         ControlFlow::Continue(next)"},{"DocComment":"     } else {"},{"DocComment":"         ControlFlow::Break(prev)"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(triangular, ControlFlow::Break(120));"},{"DocComment":""},{"DocComment":" let triangular = (1..30).try_fold(0_u64, |prev, x| {"},{"DocComment":"     if let Some(next) = prev.checked_add(x) {"},{"DocComment":"         ControlFlow::Continue(next)"},{"DocComment":"     } else {"},{"DocComment":"         ControlFlow::Break(prev)"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(triangular, ControlFlow::Continue(435));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":3656},{"Deduplicated":587},{"Deduplicated":2755}],"output":{"Deduplicated":1944}},"src":{"TraitDecl":{"trait_ref":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":787}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":36}}},"is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":19,"beg":{"line":2486,"col":4},"end":{"line":2497,"col":5}},"generated_from_span":null},"bound_body_regions":26,"locals":{"arg_count":3,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":19,"beg":{"line":2486,"col":58},"end":{"line":2486,"col":59}},"generated_from_span":null},"ty":{"Deduplicated":1944}},{"index":1,"name":"self","span":{"data":{"file_id":19,"beg":{"line":2486,"col":25},"end":{"line":2486,"col":34}},"generated_from_span":null},"ty":{"Deduplicated":2152}},{"index":2,"name":"init","span":{"data":{"file_id":19,"beg":{"line":2486,"col":36},"end":{"line":2486,"col":40}},"generated_from_span":null},"ty":{"Deduplicated":587}},{"index":3,"name":"f","span":{"data":{"file_id":19,"beg":{"line":2486,"col":45},"end":{"line":2486,"col":50}},"generated_from_span":null},"ty":{"Deduplicated":2964}},{"index":4,"name":null,"span":{"data":{"file_id":19,"beg":{"line":2493,"col":28},"end":{"line":2493,"col":39}},"generated_from_span":null},"ty":{"Deduplicated":925}},{"index":5,"name":"x","span":{"data":{"file_id":19,"beg":{"line":2493,"col":23},"end":{"line":2493,"col":24}},"generated_from_span":null},"ty":{"Deduplicated":2669}},{"index":6,"name":null,"span":{"data":{"file_id":19,"beg":{"line":2494,"col":20},"end":{"line":2494,"col":32}},"generated_from_span":null},"ty":{"Deduplicated":2742}},