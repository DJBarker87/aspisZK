+    #[test]
+    fn rewritten_pattern_values_windowed_equals_pinned_form() {
+        let mut seed = 0x5450_325f_5057_494eu64;
+        let mut case = 0u32;
+        while case < 120_000 {
+            let edge = case % 4 == 0;
+            let mut openings = [QM31::ZERO; POSEIDON2_WIDTH];
+            let mut lane = 0usize;
+            while lane < POSEIDON2_WIDTH {
+                openings[lane] = element(&mut seed, edge);
+                lane += 1;
+            }
+            let lambda = match case {
+                0 => QM31::ZERO,
+                1 => QM31::ONE,
+                _ => element(&mut seed, edge),
+            };
+            assert!(
+                pattern_values_windowed(&openings, lambda)
+                    == pattern_values_windowed_old(&openings, lambda),
+                "case {case}"
+            );
+            case += 1;
+        }
