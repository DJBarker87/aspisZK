+#[cfg(test)]
+mod tp2_pattern_values_windowed_oracle {
+    use super::*;
+
+    fn pattern_values_windowed_old(
+        openings: &[QM31; POSEIDON2_WIDTH],
+        lambda: QM31,
+    ) -> [QM31; POOL_V1_PAIR_FOREST_COPY_TERMINAL_PATTERNS_V1] {
+        let mut powers = [QM31::ZERO; 8];
