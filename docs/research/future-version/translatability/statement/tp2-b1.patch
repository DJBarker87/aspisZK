+
+    fn element(state: &mut u64, edge: bool) -> QM31 {
+        let p = aspis_core::field::P;
+        let mut limbs = [0u32; 4];
+        let mut k = 0usize;
+        while k < 4 {
+            let r = next(state);
+            limbs[k] = if edge {
+                let choices = [0u32, 1, 2, p - 1, p - 2, p / 2];
+                choices[(r % choices.len() as u64) as usize]
+            } else {
+                (r % u64::from(p)) as u32
+            };
+            k += 1;
+        }
+        QM31 {
+            c0: CM31::new(M31(limbs[0]), M31(limbs[1])),
+            c1: CM31::new(M31(limbs[2]), M31(limbs[3])),
+        }
+    }
