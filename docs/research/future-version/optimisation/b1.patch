+/// The periodic fold of every accumulator, eight per step (same operation on each entry as a
+/// one-entry loop; the loop overhead is paid once per eight).
 #[inline(always)]
 fn base_fold(acc: &mut [u64; 416]) {
     let mut t = 0;
-    while t < 416 {
