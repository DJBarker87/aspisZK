open Lean Elab Command
run_cmd do
  let env ← getEnv
  for (mod, data) in env.header.modules.zip env.header.moduleData do
    logInfo m!"PV_IMPORT {mod.module} {mod.hasData}"
    for dep in data.imports do
      logInfo m!"PV_EDGE {mod.module} {dep.module}"
