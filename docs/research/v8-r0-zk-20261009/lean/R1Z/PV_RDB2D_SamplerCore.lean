    unfold sample
    rw [hlow]
    change ((q + 1#u32 : Result U32) >>= _) = ok out
    rw [hn]
    change (ops.add ds n >>= _) = ok out
    rw [hadd]
    change ((do let pair ← ops.add ds1 1#u32; ok pair.2) >>= ops.decode) = ok out
