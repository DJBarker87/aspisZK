    obtain ⟨wrapped2,ds2,hsecond⟩ := H.add ds1 1#u32 hc1 (by decide)
    obtain ⟨hsecondValue,_⟩ := R.add ds1 1#u32 wrapped2 ds2 hc1 (by decide) hsecond
    have hc2 : Canonical ds2 := by
