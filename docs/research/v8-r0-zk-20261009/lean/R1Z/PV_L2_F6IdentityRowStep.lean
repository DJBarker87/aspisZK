import R1Z.PV_L2_F6FlagLoop

/-! Source-shaped id_row_ok: retain every checked arithmetic/index prefix.
Generated by make-checker-records.py; erasure checks the actual extraction. -/
set_option autoImplicit false
namespace R1Z.PV_L2_F6IdentityRowStep
open Aeneas Aeneas.Std Result R1CertCheck R1Z.CertCheck R1Z.PV_L2_Record

def step 
  (c : Slice Std.U32) (co : Std.Usize) (i : Std.Usize) (w : Std.Usize) (ok1 : Bool) (j : Usize) : Result (Bool × Usize) := do
  let i1 ← i * w
  let i2 ← co + i1
  let i3 ← i2 + j
  let i4 ← Slice.index_usize c i3
  let i5 ← lift (UScalar.cast .U64 i4)
  let i6 ← lift (UScalar.cast_fromBool .U64 (i = j))
  let j1 ← j + 1#usize
  ok (ok1 && (i5 = i6),j1)

def recorded 
  (c : Slice Std.U32) (co : Std.Usize) (i : Std.Usize) (w : Std.Usize) (ok1 : Bool) (j : Usize) : Recorded (Bool × Usize) := do
  let i1 ← operation (.mul i.val w.val) (i * w)
  let i2 ← operation (.add co.val i1.val) (co + i1)
  let i3 ← operation (.add i2.val j.val) (i2 + j)
  let i4 ← operation (.index 0 i3.val) (Slice.index_usize c i3)
  let i5 := UScalar.cast .U64 i4
  let i6 ← operation (.guard 10 0 0 (i = j)) (ok (UScalar.cast_fromBool .U64 (i = j)))
  let j1 ← operation (.add j.val (1#usize).val) (j + 1#usize)
  operation (.guard 10 0 0 (i5 = i6)) (ok (ok1 && (i5 = i6),j1))

theorem recorded_erases 
  (c : Slice Std.U32) (co : Std.Usize) (i : Std.Usize) (w : Std.Usize) (ok1 : Bool) (j : Usize) :
    (recorded c co i w ok1 j).value = step c co i w ok1 j := by
  simp only [recorded,step,operation_bind_value,operation_value,lift,bind_tc_ok]

theorem unroll 
  (c : Slice Std.U32) (co : Std.Usize) (i : Std.Usize) (w : Std.Usize) (ok1 : Bool) (j : Usize) :
    id_row_ok_loop c co i w ok1 j =
      if j<w then (do
        let (flag1,index1) ← step c co i w ok1 j
        id_row_ok_loop c co i w flag1 index1) else ok ok1 := by
  rw [id_row_ok_loop]
  split
  · simp only [step,bind_assoc_eq,bind_tc_ok]
  · rfl

theorem increment 
  (c : Slice Std.U32) (co : Std.Usize) (i : Std.Usize) (w : Std.Usize) (ok1 : Bool) (j : Usize) (after : Bool × Usize)
    (success : step c co i w ok1 j = ok after) : after.2.val=j.val+1 := by
  unfold step at success
  obtain ⟨i1,hi1,success⟩ := bind_eq_ok success
  obtain ⟨i2,hi2,success⟩ := bind_eq_ok success
  obtain ⟨i3,hi3,success⟩ := bind_eq_ok success
  obtain ⟨i4,hi4,success⟩ := bind_eq_ok success
  obtain ⟨i5,hi5,success⟩ := bind_eq_ok success
  obtain ⟨i6,hi6,success⟩ := bind_eq_ok success
  obtain ⟨j1,hj1,success⟩ := bind_eq_ok success
  have he := ok_inj success
  rw [←he]
  simpa only [show (1#usize).val=1 from rfl] using add_ok hj1

#print axioms recorded_erases
