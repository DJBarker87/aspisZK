  let s := alloc.vec.Vec.deref pb.a9
  let s1 := alloc.vec.Vec.deref c.hinv
  let h ← half_ok s s1
  let s2 := alloc.vec.Vec.deref pb.lo
  let s3 := alloc.vec.Vec.deref c.lu
