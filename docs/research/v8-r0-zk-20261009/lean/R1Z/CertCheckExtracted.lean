  let i7 ← i6 + P
  let i8 ← mm x3 y3
  let i9 ← i7 - i8
  let p ← i9 % P
  let i10 ← mm x2 y3
  let i11 ← mm x3 y2
  let i12 ← i10 + i11
  let q ← i12 % P
  let i13 ← mm x01 y0
  let i14 ← i13 + P
  let i15 ← mm x1 y1
  let i16 ← i14 - i15
  let i17 ← 2#u64 * p
  let i18 ← i16 + i17
  let i19 ← i18 + P
  let i20 ← i19 - q
  let r0 ← i20 % P
  let i21 ← mm x01 y1
  let i22 ← mm x1 y0
  let i23 ← i21 + i22
  let i24 ← i23 + p
  let i25 ← 2#u64 * q
  let i26 ← i24 + i25
  let r1 ← i26 % P
  let i27 ← mm x01 y2
  let i28 ← i27 + P
  let i29 ← mm x1 y3
  let i30 ← i28 - i29
  let i31 ← mm x2 y0
  let i32 ← i30 + i31
  let i33 ← i32 + P
  let i34 ← mm x3 y1
  let i35 ← i33 - i34
  let r2 ← i35 % P
  let i36 ← mm x01 y3
  let i37 ← mm x1 y2
  let i38 ← i36 + i37
  let i39 ← mm x2 y1
  let i40 ← i38 + i39
  let i41 ← mm x3 y0
  let i42 ← i40 + i41
  let r3 ← i42 % P
