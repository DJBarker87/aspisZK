  let s5 := alloc.vec.Vec.deref pb.lw
  let s6 := alloc.vec.Vec.deref pb.loff
  let i ← lift (UScalar.cast .Usize pb.nl)
  let li ← lifts_ok s2 s3 s4 s5 s6 i
  let qp ← check_qprime pb c
  let bc ← check_bcond pb c
  if h
  then
    if pb.nq <= 22#u32
