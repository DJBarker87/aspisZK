import R1Z.PV_L2_F6FlagLoop

/-! Source-shaped perm_left_ok: retain every checked arithmetic/index prefix.
Generated by make-checker-records.py; erasure checks the actual extraction. -/
set_option autoImplicit false
namespace R1Z.PV_L2_F6PermutationLeftStep
open Aeneas Aeneas.Std Result R1CertCheck R1Z.CertCheck R1Z.PV_L2_Record

def step 
  (lst : Slice Std.U32) (tag : Slice Std.U32) (n : Std.Usize) (ok1 : Bool) (x : Usize) : Result (Bool × Usize) := do
  let i ← Slice.index_usize lst x
  let i1 ← lift (UScalar.cast .Usize i)
  let i2 ← Slice.index_usize tag i1
  let i3 ← lift (UScalar.cast .U64 i2)
  let i4 ← lift (UScalar.cast .U64 x)
  let x1 ← x + 1#usize
  ok (ok1 && (i3 = i4),x1)

def recorded 
  (lst : Slice Std.U32) (tag : Slice Std.U32) (n : Std.Usize) (ok1 : Bool) (x : Usize) : Recorded (Bool × Usize) := do
  let i ← operation (.index 0 x.val) (Slice.index_usize lst x)
  let i1 := UScalar.cast .Usize i
  let i2 ← operation (.index 1 i1.val) (Slice.index_usize tag i1)
  let i3 := UScalar.cast .U64 i2
  let i4 := UScalar.cast .U64 x
  let x1 ← operation (.add x.val (1#usize).val) (x + 1#usize)
  operation (.guard 12 0 0 (i3 = i4)) (ok (ok1 && (i3 = i4),x1))

theorem recorded_erases 
  (lst : Slice Std.U32) (tag : Slice Std.U32) (n : Std.Usize) (ok1 : Bool) (x : Usize) :
    (recorded lst tag n ok1 x).value = step lst tag n ok1 x := by
  simp only [recorded,step,operation_bind_value,operation_value,lift,bind_tc_ok]

theorem unroll 
  (lst : Slice Std.U32) (tag : Slice Std.U32) (n : Std.Usize) (ok1 : Bool) (x : Usize) :
    perm_left_ok_loop lst tag n ok1 x =
      if x<n then (do
        let (flag1,index1) ← step lst tag n ok1 x
        perm_left_ok_loop lst tag n flag1 index1) else ok ok1 := by
  rw [perm_left_ok_loop]
  split
  · simp only [step,bind_assoc_eq,bind_tc_ok]
  · rfl

theorem increment 
  (lst : Slice Std.U32) (tag : Slice Std.U32) (n : Std.Usize) (ok1 : Bool) (x : Usize) (after : Bool × Usize)
    (success : step lst tag n ok1 x = ok after) : after.2.val=x.val+1 := by
  unfold step at success
  obtain ⟨i,hi,success⟩ := bind_eq_ok success
  obtain ⟨i1,hi1,success⟩ := bind_eq_ok success
  obtain ⟨i2,hi2,success⟩ := bind_eq_ok success
  obtain ⟨i3,hi3,success⟩ := bind_eq_ok success
  obtain ⟨i4,hi4,success⟩ := bind_eq_ok success
  obtain ⟨x1,hx1,success⟩ := bind_eq_ok success
  have he := ok_inj success
  rw [←he]
  simpa only [show (1#usize).val=1 from rfl] using add_ok hx1

#print axioms recorded_erases
