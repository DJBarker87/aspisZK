+impl M31 {
+    pub const ZERO: M31 = M31(0);
+    pub const ONE: M31 = M31(1);
+
+    #[inline(always)]
+    pub fn add(self, rhs: M31) -> M31 {
+        #[cfg(not(v8_range_m31))] let s = self.0 + rhs.0;
+        #[cfg(v8_range_m31)] let s = self.0.wrapping_add(rhs.0);
+        #[cfg(not(v8_range_m31))] { M31(if s >= P { s - P } else { s }) }
+        #[cfg(v8_range_m31)] { M31(if s >= P { s.wrapping_sub(P) } else { s }) }
+    }
+
+    #[inline(always)]
+    pub fn sub(self, rhs: M31) -> M31 {
+        #[cfg(not(v8_range_m31))] let s = self.0 + P - rhs.0;
+        #[cfg(v8_range_m31)] let s = self.0.wrapping_add(P).wrapping_sub(rhs.0);
+        #[cfg(not(v8_range_m31))] { M31(if s >= P { s - P } else { s }) }
+        #[cfg(v8_range_m31)] { M31(if s >= P { s.wrapping_sub(P) } else { s }) }
+    }
+
+    #[inline(always)]
+    pub fn neg(self) -> M31 {
+        if self.0 == 0 {
+            M31(0)
+        } else {
+            #[cfg(not(v8_range_m31))] { M31(P - self.0) }
+            #[cfg(v8_range_m31)] { M31(P.wrapping_sub(self.0)) }
+        }
+    }
+
+    #[inline(always)]
+    pub fn mul(self, rhs: M31) -> M31 {
