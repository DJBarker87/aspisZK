+#[cfg(all(test,v8_query_affine))]
+mod query_affine_tests {
+    use super::*;
+    #[test]
+    fn wide_constant_and_packed_queries_match(){
+        use corelib::field::{PreparedQm31Multiplier as P,research_qm31_add_raw_sum_products3_prepared as affine};
+        let mut rng=0x7261_772d_4331_4332u64;
+        fn m(r:&mut u64)->M31{*r^=*r<<13;*r^=*r>>7;*r^=*r<<17;M31((*r%u64::from(corelib::field::P)) as u32)}
