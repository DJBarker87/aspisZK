+        let max=K{c0:CM31::new(M31(corelib::field::P-1),M31(corelib::field::P-1)),c1:CM31::new(M31(corelib::field::P-1),M31(corelib::field::P-1))};
+        let cap=7*(5*u64::from(corelib::field::P)+3);
+        for case in 0..4096 {
+            let mut raw=core::array::from_fn(|_|{let _=m(&mut rng);rng%(cap+1)});
+            let mut l=core::array::from_fn(|_|k(&mut rng));let mut r=core::array::from_fn(|_|k(&mut rng));
+            if case==0{raw=[cap;4];l=[max;3];r=[max;3];}
+            if case==1{raw=[0;4];l=[K::ZERO;3];r=[K::ZERO;3];}
+            let c=raw.map(M31::reduce_u64);let c=K{c0:CM31::new(c[0],c[1]),c1:CM31::new(c[2],c[3])};
+            assert_eq!(affine(raw,&l.map(P::new),&r),c.add(corelib::field::qm31_sum_products3_prepared(&l.map(P::new),&r)));
+            assert_eq!(affine(raw,&l.map(P::new),&r),(0..3).fold(c,|s,i|s.add(l[i].mul(r[i]))));
+        }
+        for case in 0..1024 {
+            let mut v=core::array::from_fn(|_|m(&mut rng).0);
+            let mut p=core::array::from_fn(|_|core::array::from_fn(|_|m(&mut rng).0));
+            if case==0{v=[corelib::field::P-1;26];p=[[corelib::field::P-1;4];26];}
+            if case==1{v=[0;26];p=[[0;4];26];}
+            let raw=[fixed_raw::<0>(&v,&p),fixed_raw::<1>(&v,&p),fixed_raw::<2>(&v,&p),fixed_raw::<3>(&v,&p)];
+            for i in 0..4 {
+                assert!(raw[i]<=cap);
+                let expected=(0..26).map(|j|u128::from(v[j])*u128::from(p[j][i])).sum::<u128>()%u128::from(corelib::field::P);
+                assert_eq!(u128::from(M31::reduce_u64(raw[i]).0),expected);
+            }
+        }
+        controls();
+        println!("QUERY_AFFINE wide_constants=4096 fixed_raw_profiles=1024 maximum_seed=true unchanged_packed_rejections=true");
+    }
