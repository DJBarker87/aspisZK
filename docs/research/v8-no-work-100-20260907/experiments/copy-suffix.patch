+// Research-only common-suffix evaluation. No division, including at lambda=0.
+#[cfg(any(test, v8_copy_suffix))]
+#[inline(never)]
+fn pattern_values_suffix(openings: &[QM31; 16], lambda: QM31) -> [QM31; 14] {
+    let prepared = PreparedQm31Multiplier::new(lambda);
+    let l2 = lambda.square();
+    let l4 = l2.square();
+    let l6 = PreparedQm31Multiplier::new(l4.mul(l2));
+    let l8_value = l4.square();
+    let l8 = PreparedQm31Multiplier::new(l8_value);
+    let mut suffix = [QM31::ZERO; 17];
+    for j in (0..16).rev() {
+        suffix[j] = prepared.mul(openings[j].add(suffix[j+1]));
+    }
+    let s0 = prepared.mul(openings[0]);
+    let s1 = prepared.mul(openings[1]);
+    [
+        suffix[0],
+        suffix[0].sub(l8.mul(suffix[8])),
+        suffix[2].sub(l6.mul(suffix[8])),
+        suffix[0].sub(l6.mul(suffix[6])),
+        s0.add(prepared.mul(s1)),
+        prepared.mul(openings[6].add(prepared.mul(openings[7]))),
+        s0,
+        prepared.mul(openings[10]),
+        s1,
+        prepared.mul(openings[2]),
+        suffix[8].add(l8_value.mul_m31(M31(1_051_521_018))),
+        suffix[2].sub(l8.mul(suffix[10])),
+        suffix[1].sub(l8.mul(suffix[9])),
+        suffix[8],
+    ]
+}
