+#[cfg(all(test,v8_gamma_one))]
+mod one_tests{
+    use super::*;
+    #[test]
+    fn guarded_identity_and_arbitrary_table_fallback(){
+        let mut rng=0x6761_6d6d_616f_6e65u64;
+        let mut next=||{rng^=rng<<13;rng^=rng>>7;rng^=rng<<17;(rng%u64::from(corelib::field::P)) as u32};
+        let mut baseline=StateOnlySpendQueryPowers::new(K::ONE);
+        for case in 0..2048{
+            let mut v=core::array::from_fn(|_|next());
+            let mut p=core::array::from_fn(|_|core::array::from_fn(|_|next()));
+            if case==0{v=[0;26];p=[[0;4];26];}
+            if case==1{v=[corelib::field::P-1;26];p=[[corelib::field::P-1;4];26];}
+            if case%2==0{p[0]=[1,0,0,0];}
+            baseline.base.c1_limbs=p;
+            let kernel=GammaKernel::new(&baseline);let one=kernel.first_one;
+            assert_eq!(one,p[0]==[1,0,0,0]);
+            let expected=core::array::from_fn(|l|M31(((0..26).map(|i|u128::from(v[i])*u128::from(p[i][l])).sum::<u128>()%u128::from(corelib::field::P)) as u32));
+            let actual=[guarded_dot::<0>(&v,&p,one),guarded_dot::<1>(&v,&p,one),guarded_dot::<2>(&v,&p,one),guarded_dot::<3>(&v,&p,one)];
+            let old=[fixed_dot::<0>(&v,&p),fixed_dot::<1>(&v,&p),fixed_dot::<2>(&v,&p),fixed_dot::<3>(&v,&p)];
+            assert_eq!(actual,expected);assert_eq!(actual,old);
+        }
+        // Near misses in EACH head limb must take the generic path.
+        for limb in 0..4{for value in [0,1,2,corelib::field::P-1]{
+            baseline.base.c1_limbs[0]=[1,0,0,0];baseline.base.c1_limbs[0][limb]=value;
+            let one=GammaKernel::new(&baseline).first_one;
+            assert_eq!(one,value==if limb==0{1}else{0});
+        }}
+        let mut v=[0u32;26];v[0]=1;let p=[[2u32;4];26];
+        assert_ne!(guarded_dot::<0>(&v,&p,true),fixed_dot::<0>(&v,&p));
+        controls();
+        println!("GAMMA_ONE arbitrary_profiles=2048 head_near_misses=16 generic_fallback=true guard_per_table=1");
+    }
+}
