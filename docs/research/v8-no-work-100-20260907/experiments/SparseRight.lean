import Mathlib.Tactic.Ring
/-! Frozen-profile right contraction, after clearing the common denominator 64.
Each theorem is a commutative-ring identity in arbitrary normal and carry values
and arbitrary high-basis coefficients. The Rust guarded fast path checks both
the 64 groups and seven masks. This is not a Rust translation. -/
namespace AspisV8.SparseRight

theorem terminal_0 {K : Type*} [CommRing K] (n : Fin 7 → K) (c : Fin 3 → K) (h : Fin 16 → K) :
    h 0 * (64 * n 0 + (64 * ((c 0 + c 1 + c 2)))) +
    h 1 * (64 * n 0 + (32 * ((c 0 + c 1 + c 2)) + 32 * ((c 1 + c 2)))) +
    h 2 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 3 * (64 * n 1 + (32 * ((c 1 + c 2)) + 16 * ((c 0 + c 1 + c 2)) + 16 * ((c 1 + c 2)))) +
    h 4 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 5 * (64 * n 1 + (32 * ((c 1 + c 2)) + 32 * ((c 1 + c 2)))) +
    h 6 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 7 * (64 * n 1 + (32 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)) + 8 * ((c 0 + c 1 + c 2)) + 8 * ((c 1 + c 2)))) +
    h 8 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 9 * (64 * n 1 + (32 * ((c 1 + c 2)) + 32 * ((c 1 + c 2)))) +
    h 10 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 11 * (64 * n 1 + (32 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)))) +
    h 12 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 13 * (64 * n 1 + (32 * ((c 1 + c 2)) + 32 * ((c 1 + c 2)))) +
    h 14 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 15 * (64 * n 1 + (32 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)) + 8 * ((c 1 + c 2)) + 4 * ((c 0 + c 1 + c 2)) + 4 * ((c 1 + c 2)))) =
    64 * (n 1 + c 1 + c 2) * (h 0 + h 1 + h 2 + h 3 + h 4 + h 5 + h 6 + h 7 + h 8 + h 9 + h 10 + h 11 + h 12 + h 13 + h 14 + h 15) +
    64 * (n 0 - n 1) * (h 0 + h 1) +
    (c 0) * (64 * h 0 + 32 * h 1 + 16 * h 3 + 8 * h 7 + 4 * h 15) := by ring
#print axioms terminal_0

theorem terminal_1 {K : Type*} [CommRing K] (n : Fin 7 → K) (c : Fin 3 → K) (h : Fin 16 → K) :
    h 0 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 1 * (64 * n 1 + (32 * ((c 1 + c 2)) + 32 * ((c 1 + c 2)))) +
    h 2 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 3 * (64 * n 1 + (32 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)))) +
    h 4 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 5 * (64 * n 1 + (32 * ((c 1 + c 2)) + 32 * ((c 1 + c 2)))) +
    h 6 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 7 * (64 * n 1 + (32 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)) + 8 * ((c 1 + c 2)) + 8 * ((c 1 + c 2)))) +
    h 8 * (64 * n 1 + (64 * ((c 0 + c 1 + c 2)))) +
    h 9 * (64 * n 0 + (32 * ((c 1 + c 2)) + 32 * ((c 1 + c 2)))) +
    h 10 * (64 * n 2 + (64 * ((c 0 + c 1 + c 2)))) +
    h 11 * (64 * n 3 + (32 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)))) +
    h 12 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 13 * (64 * n 4 + (32 * ((c 1 + c 2)) + 32 * ((c 0 + c 1 + c 2)))) +
    h 14 * (64 * n 3 + (64 * ((c 1 + c 2)))) +
    h 15 * (64 * n 1 + (32 * ((c 0 + c 1 + c 2)) + 16 * ((c 1 + c 2)) + 8 * ((c 1 + c 2)) + 4 * ((c 1 + c 2)) + 2 * ((c 0 + c 1 + c 2)) + 2 * ((c 1 + c 2)))) =
    64 * (n 1 + c 1 + c 2) * (h 0 + h 1 + h 2 + h 3 + h 4 + h 5 + h 6 + h 7 + h 8 + h 9 + h 10 + h 11 + h 12 + h 13 + h 14 + h 15) +
    64 * (n 0 - n 1) * (h 9) +
    64 * (n 2 - n 1) * (h 10) +
    64 * (n 3 - n 1) * (h 11 + h 14) +
    64 * (n 4 - n 1) * (h 13) +
    (c 0) * (64 * h 8 + 64 * h 10 + 32 * h 13 + 34 * h 15) := by ring
#print axioms terminal_1

theorem terminal_2 {K : Type*} [CommRing K] (n : Fin 7 → K) (c : Fin 3 → K) (h : Fin 16 → K) :
    h 0 * (64 * n 4 + (64 * ((c 1 + c 2)))) +
    h 1 * (64 * n 1 + (32 * ((c 1 + c 2)) + 32 * ((c 1 + c 2)))) +
    h 2 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 3 * (64 * n 1 + (32 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)))) +
    h 4 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 5 * (64 * n 1 + (32 * ((c 1 + c 2)) + 32 * ((c 1 + c 2)))) +
    h 6 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 7 * (64 * n 1 + (32 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)) + 8 * ((c 1 + c 2)) + 8 * ((c 1 + c 2)))) +
    h 8 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 9 * (64 * n 1 + (32 * ((c 1 + c 2)) + 32 * ((c 1 + c 2)))) +
    h 10 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 11 * (64 * n 1 + (32 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)))) +
    h 12 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 13 * (64 * n 1 + (32 * ((c 1 + c 2)) + 32 * ((c 1 + c 2)))) +
    h 14 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 15 * (64 * n 1 + (32 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)) + 8 * ((c 1 + c 2)) + 4 * ((c 1 + c 2)) + 4 * ((c 1 + c 2)))) =
    64 * (n 1 + c 1 + c 2) * (h 0 + h 1 + h 2 + h 3 + h 4 + h 5 + h 6 + h 7 + h 8 + h 9 + h 10 + h 11 + h 12 + h 13 + h 14 + h 15) +
    64 * (n 4 - n 1) * (h 0) := by ring
#print axioms terminal_2

theorem terminal_3 {K : Type*} [CommRing K] (n : Fin 7 → K) (c : Fin 3 → K) (h : Fin 16 → K) :
    h 0 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 1 * (64 * n 1 + (32 * ((c 1 + c 2)) + 32 * ((c 1 + c 2)))) +
    h 2 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 3 * (64 * n 1 + (32 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)))) +
    h 4 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 5 * (64 * n 2 + (32 * ((c 1 + c 2)) + 32 * ((c 1 + c 2)))) +
    h 6 * (64 * n 1 + (64 * ((c 1 + c 2)))) +
    h 7 * (64 * n 1 + (32 * ((c 1 + c 2)) + 16 * ((c 1 + c 2)) + 8 * ((c 1 + c 2)) + 8 * ((c 1 + c 2)))) +
    h 8 * (64 * n 2 + (64 * (c 0))) +
    h 9 * (64 * n 5 + (32 * ((c 1 + c 2)) + 32 * (c 0))) +
    h 10 * (64 * n 5 + (64 * (c 0))) +
    h 11 * (64 * n 5 + (32 * (c 0) + 16 * ((c 1 + c 2)) + 16 * (c 0))) +
    h 12 * (64 * n 5 + (64 * (c 0))) +
    h 13 * (64 * n 5 + (32 * (c 0) + 32 * (c 0))) +
    h 14 * (64 * n 5 + (64 * (c 1))) +
    h 15 * (64 * n 6 + (32 * (c 0) + 16 * (c 0) + 8 * ((c 1 + c 2)) + 4 * ((c 1 + c 2)) + 2 * ((c 1 + c 2)) + 1 * ((c 0 + c 1 + c 2)))) =
    64 * (n 1 + c 1 + c 2) * (h 0 + h 1 + h 2 + h 3 + h 4 + h 5 + h 6 + h 7 + h 8 + h 9 + h 10 + h 11 + h 12 + h 13 + h 14 + h 15) +
    64 * (n 2 - n 1) * (h 5 + h 8) +
    64 * (n 5 - n 1) * (h 9 + h 10 + h 11 + h 12 + h 13 + h 14) +
    64 * (n 6 - n 1) * (h 15) +
    (c 0) * (1 * h 15) +
    (c 0 - (c 1 + c 2)) * (64 * h 8 + 32 * h 9 + 64 * h 10 + 48 * h 11 + 64 * h 12 + 64 * h 13 + 48 * h 15) +
    (-c 2) * (64 * h 14) +
    -(c 1 + c 2) * h 15 := by ring
#print axioms terminal_3
end AspisV8.SparseRight
