+// Each call below is in a fresh group of at most four canonical products.
+// Affine constants have the separate 3*(P-1)^2+4*(P-1) bound.
+#[inline(always)]
+fn qm31_bounded_mac(sum: u64, a: u64, b: u64) -> u64 {
+    #[cfg(v8_range_dots)]
+    { sum.wrapping_add(a.wrapping_mul(b)) }
+    #[cfg(not(v8_range_dots))]
+    { sum + a * b }
+}
+
+#[inline(always)]
+fn qm31_bounded_add(sum: u64, value: u64) -> u64 {
+    #[cfg(v8_range_dots)]
+    { sum.wrapping_add(value) }
+    #[cfg(not(v8_range_dots))]
+    { sum + value }
+}
+
+#[inline(always)]
+fn qm31_accumulate_product_channels(
     mut sums: [[u64; 3]; 3],
     left: QM31,
