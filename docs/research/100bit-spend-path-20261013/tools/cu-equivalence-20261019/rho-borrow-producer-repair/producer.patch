--- a/src/interp/InterpExpressions.ml
+++ b/src/interp/InterpExpressions.ml
@@ -197 +197,10 @@
-      | VMutBorrow (_, _) -> [%craise] span "Can't copy a mutable borrow"
+      | VMutBorrow (bid, child) ->
+          (* Optimized MIR may express a mutable reborrow as Copy. Preserve
+             exclusivity: the original reference contains the fresh loan,
+             and the result owns the corresponding fresh borrow. Never clone
+             the mutable borrow id or the referent value. *)
+          let reborrow = ctx.fresh_borrow_id () in
+          let loan = { child with value = VLoan (VMutLoan reborrow) } in
+          ( { v with value = VBorrow (VMutBorrow (bid, loan)) },
+            { v with value = VBorrow (VMutBorrow (reborrow, child)) },
+            ctx, fun e -> e )
