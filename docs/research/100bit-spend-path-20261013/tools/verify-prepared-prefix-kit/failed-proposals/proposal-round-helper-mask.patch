+fn polynomial_boundary(polynomial:&[QM31;28])->QM31 {
+    polynomial.iter().copied().fold(polynomial[0], QM31::add)
+}
+
+fn polynomial_value(polynomial:&[QM31;28], alpha:QM31)->QM31 {
+    polynomial
+            .iter()
+            .rev()
+            .fold(QM31::ZERO, |a, &c| a.mul(alpha).add(c))
+}
+
+fn verify_round<H:Digest32>(prefix:&Prefix<'_>, transcript:&mut SemanticTranscript<H>, round:usize, running:QM31)->Result<(QM31,QM31,QM31),Error> {
+        let row = 15 + round as u8;
+        let polynomial = prefix.validated_record(row)?.decode_k::<28>(0)?;
+        let boundary = polynomial_boundary(&polynomial);
+        if boundary != running {
+            return Err(Error::Boundary { round });
+        }
+        let alpha = transcript.semantic_validated(prefix.validated_record(row)?)?;
+        let value = polynomial_value(&polynomial, alpha);
+        Ok((alpha,boundary,value))
+}
+
+fn selected_mask(claims:&[[QM31;29];3], alpha:&[QM31;10])->QM31 {
+    aspis_core::state_only_hiding::state_only_selected_mask_value(
+        &core::array::from_fn(|i| claims[0][i]),
+        &core::array::from_fn(|i| claims[0][16 + i]),
+        claims[0][27],
+        alpha,
+    )
+}
