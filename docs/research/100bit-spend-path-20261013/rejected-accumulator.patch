+/// Checked canonical QM31 accumulation of `power * basis` into `weight`.
+/// This mirrors `weight.add(power.mul_m31(basis))` while using the private
+/// canonical arithmetic representation and rejecting noncanonical inputs.
+#[inline(always)]
+pub fn accumulate_k_m31(weight:QM31,power:QM31,basis:M31)->Result<QM31,()> {
+    let weight=checked_q(weight)?;
+    let power=checked_q(power)?;
+    if basis.0>=aspis_core::field::P {return Err(());}
+    let product=power.mul_m31(basis.0).ok_or(())?;
+    Ok(qm31_of(weight.add(product)))
 }
 
