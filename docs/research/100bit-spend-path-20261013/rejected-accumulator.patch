+#[test]
+fn canonical_k_m31_accumulation_matches_core_arithmetic() {
+    let mut state=0xbb67_ae85_84ca_a73b;
+    for case in 0..4096 {
+        let mode=case%4;
+        let weight=if mode<3 {edge_k(mode)} else {random_qm31(&mut state)};
+        let power=if mode<3 {edge_k((mode+1)%3)} else {random_qm31(&mut state)};
+        let basis=match mode {
+            0=>M31::ZERO,
+            1=>M31::ONE,
+            2=>M31(P-1),
+            _=>random_m31(&mut state),
+        };
+        let expected=weight.add(power.mul_m31(basis));
+        assert_eq!(accumulate_k_m31(weight,power,basis),Ok(expected),"case {case}");
+    }
+}
+
+#[test]
+fn canonical_k_m31_accumulation_rejects_noncanonical_inputs() {
+    let invalid=QM31{c0:CM31{a:M31(P),b:M31::ZERO},c1:CM31::ZERO};
+    assert_eq!(accumulate_k_m31(invalid,QM31::ZERO,M31::ZERO),Err(()));
+    assert_eq!(accumulate_k_m31(QM31::ZERO,invalid,M31::ZERO),Err(()));
+    assert_eq!(accumulate_k_m31(QM31::ZERO,QM31::ZERO,M31(P)),Err(()));
+}
