+/// Materializes the two row-31 outputs from one source state. The caller
+/// advances to the returned second component before generating the next pair.
+fn query_squeeze_advance(hash: HashFn, state: &[u8; 32]) -> ([u8; 32], [u8; 32]) {
+    let squeeze = hash(&[state, &[1]]);
+    let advance = hash(&[state, &[2]]);
+    (squeeze, advance)
+}
