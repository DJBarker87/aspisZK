  "publication_preparation_base_revision": "60f256a4bf63e47ab3400158ea284b5a1147c9f2",
  "revision": "candidate-only owned Option branch split; based on c8 frozen function, no production adoption",
  "root_targets": [
    "crate::verifier::accumulate_with_node"
  ],
  "scope": "Focused candidate extraction of actual accumulate_with_node with pending Option branch selected once, isolating the mutable Some loop from Option::as_deref_mut callback",
  "selected_source": "fn accumulate_with_node(\n    p: &Prepared,\n    a: &mut Accumulator,\n    mut node: M31,\n    value: E,\n    pending: Option<&mut BatchedWeights>,\n) {\n    let mut basis = [M31::ZERO; 256];\n    basis[0] = M31::ONE;\n    let mut n = 1;\n    while n < a.weights.len() {\n        for j in 0..n {\n            basis[n + j] = basis[j].mul(node);\n        }\n        node = node.mul(node).double().sub(M31::ONE);\n        n *= 2;\n    }\n\n    match pending {\n        Some(weights) => {\n            for j in 0..a.weights.len() {\n                weights.push(j, a.power, basis[j]);\n                #[cfg(feature = \"prover\")]\n                {\n                    a.weights[j] = weights.value(j);\n                }\n                crate::trace::value(12, a.next * a.weights.len() + j, E::from_qm31(a.weights[j]));\n                crate::trace::value(13, a.next * a.weights.len() + j, E::from_m31(basis[j]));\n            }\n            weights.terms += 1;\n        }\n        None => {\n            for j in 0..a.weights.len() {\n                a.weights[j] = a.weights[j].add(a.power.mul_m31(basis[j]));\n                crate::trace::value(12, a.next * a.weights.len() + j, E::from_qm31(a.weights[j]));\n                crate::trace::value(13, a.next * a.weights.len() + j, E::from_m31(basis[j]));\n            }\n        }\n    }\n\n    a.rhs = a.rhs.add(value.mul_qm31(a.power));\n    crate::trace::value(11, a.next, a.rhs);\n    a.power = a.power.mul(p.rho);\n    a.next += 1;\n}\n",
  "selected_source_sha256": "a8e8fb07bcba091f6d4c8a2b28e7d33c6b330c494d67a7087903e650d3c382e5"
}
