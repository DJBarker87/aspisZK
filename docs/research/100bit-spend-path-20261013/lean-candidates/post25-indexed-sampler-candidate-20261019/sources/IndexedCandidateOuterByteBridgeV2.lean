/-! Candidate-only outer source bridge.  This connects the generated byte-word
loop and the generated indexed eight-pass loop to the checked byteWords and
Nat digit/quotient models.  It is not production equivalence. -/
set_option autoImplicit false

namespace AspisR1.ExtractedQM31SamplerIndexedOuterBridgeV2
open Aeneas Aeneas.Std Result ControlFlow WP
open AspisR1Post25Sampler
open AspisR1.ExtractedQM31SamplerIndexedGeneratedBridge
open AspisR1.ExtractedQM31SamplerBytes
open AspisR1.ExtractedQM31SamplerPassLoop
open AspisR1.ExtractedQM31SamplerIndexedCandidate
open AspisR1.SamplerMachineBounds
open AspisR1.SamplerRepeatedPass
open AspisR1.SourceSamplerByteRank

private theorem low_loop0_body_eq (block : Array U8 32#usize)
    (rank : Array U32 8#usize) (i : Usize) :
    sampler.low_base_p_digits_loop0.body block rank i =
      AspisR1Qm31SamplerIndex.sampler.qm31_digits_loop0.body block rank i := by
  rfl

theorem low_loop0_eq (block : Array U8 32#usize)
    (rank : Array U32 8#usize) (i : Usize) :
    sampler.low_base_p_digits_loop0 block rank i =
      AspisR1Qm31SamplerIndex.sampler.qm31_digits_loop0 block rank i := by
  rfl

theorem low_loop0_total (block : Array U8 32#usize) :
    sampler.low_base_p_digits_loop0 block (Array.repeat 8#usize 0#u32) 0#usize =
      ok (byteWords block) := by
  rw [low_loop0_eq]
  exact AspisR1.ExtractedQM31SamplerBytes.assemble_total block

private theorem index_word (rank : Array U32 8#usize) (i : Usize)
    (hi : i.val < 8) :
    Array.index_usize rank i = ok (wordAt rank ⟨i.val, hi⟩) := by
  have hb : i.val < rank.length := by
    have hr := rank.property
    change rank.val.length = 8 at hr
    change i.val < rank.val.length
    omega
  obtain ⟨x, hx, hval⟩ := WP.spec_imp_exists (Array.index_usize_spec rank i hb)
  simpa only [wordAt] using hx.trans (congrArg Result.ok hval)

/-- Actual candidate function output: the byte loop assembles the same words
as `byteWords`; the indexed loop yields the low P^8 digits and a full quotient
array whose interpreted value is the high quotient.  The returned u32 is its
low word. -/
theorem low_base_p_digits_candidate (block : Array U8 32#usize) :
    ∃ outRank : Array U32 8#usize, ∃ outDigits : Array U32 8#usize,
      ∃ highWord : U32,
        sampler.low_base_p_digits block = ok (outDigits, highWord) ∧
        values outDigits = SamplerNatModel.ordinaryDigits (rank block) ∧
        wordValue ((words outRank).reverse) = rank block / P^8 ∧
        highWord.val = (wordAt outRank 0).val := by
  obtain ⟨outRank, outDigits, hloop1, hvalues, hwords⟩ :=
    low_base_p_digits_loop1_eight_indexed (byteWords block)
  have hidx := indexedPasses_eight_bytes block
  have hremaining : wordValue ((words outRank).reverse) = rank block / P^8 := by
    have h := congrArg (fun ws => wordValue ws) hwords
    exact h.trans hidx.2
  have hdigits : values outDigits = SamplerNatModel.ordinaryDigits (rank block) :=
    hvalues.trans hidx.1
  have hword := index_word outRank 0#usize (by decide)
  refine ⟨outRank, outDigits, wordAt outRank 0, ?_, hdigits, hremaining, rfl⟩
  simp only [sampler.low_base_p_digits, low_loop0_total, hloop1, bind_tc_ok]
  rw [hword]

