" Note 2: The time at which ignored elements are pulled is not fixed."},{"DocComment":" `StepBy` behaves like the sequence `self.next()`, `self.nth(step-1)`,"},{"DocComment":" `self.nth(step-1)`, …, but is also free to behave like the sequence"},{"DocComment":" `advance_n_and_return_first(&mut self, step)`,"},{"DocComment":" `advance_n_and_return_first(&mut self, step)`, …"},{"DocComment":" Which way is used may change for some iterators for performance reasons."},{"DocComment":" The second way will advance the iterator earlier and may consume more items."},{"DocComment":""},{"DocComment":" `advance_n_and_return_first` is the equivalent of:"},{"DocComment":" ```"},{"DocComment":" fn advance_n_and_return_first<I>(iter: &mut I, n: usize) -> Option<I::Item>"},{"DocComment":" where"},{"DocComment":"     I: Iterator,"},{"DocComment":" {"},{"DocComment":"     let next = iter.next();"},{"DocComment":"     if n > 1 {"},{"DocComment":"         iter.nth(n - 2);"},{"DocComment":"     }"},{"DocComment":"     next"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" The method will panic if the given step is `0`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [0, 1, 2, 3, 4, 5];"},{"DocComment":" let mut iter = a.into_iter().step_by(2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSel