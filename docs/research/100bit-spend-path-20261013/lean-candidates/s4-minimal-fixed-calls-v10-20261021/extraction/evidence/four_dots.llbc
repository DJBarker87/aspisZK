{"charon_version":"0.1.223","translated":{"crate_name":"aspis_r1_cost_probe","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::fast_dots::four_dots"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["core::option::Option","core::result::Result","core::result::_::map_err"],"opaque":["crate::fast_pairing","crate::aspis_core::field"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/s4-minimal-fixed-calls-v10-extraction-20261021/four_dots.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"crates/aspis-r1-cost-probe/src/fast_dots.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! Exact four-slot dot products with a partially reduced base-field prefix.\nuse aspis_core::field::{M31, QM31, WideExact};\nuse crate::fast_pairing::EbyKDot;\n\n/// Compute the verifier's four dot products while postponing canonical M31\n/// reductions across groups of at most four base-field products.\n///\n/// Each limb product is at most `(P - 1)^2`; four products therefore sum to\n/// less than `2^64`, since `4 * (P - 1)^2 < 2^64`. One Mersenne fold\n/// `(sum & P) + (sum >> 31)` preserves its residue and is below `2^34`.\n/// Seven folded batches sum to less than `2^37`; canonicalize each limb once\n/// after all 26 products. Every byte decoder and its order are unchanged.\n// Candidate entry delegates to the pinned fixed-call implementation.\n// Candidate-only extracted single-slot helper.\nfn four_dots_one(q: &[u8; 608], g: &[WideExact; 29], slot: usize) -> WideExact {\n        let mut limbs = [0u64; WideExact::LIMB_COUNT];\n        for start in (0..26).step_by(4) {\n            let mut sums = [0u64; WideExact::LIMB_COUNT];\n            for term in start..core::cmp::min(start + 4, 26) {\n                let scalar = M31::from_le_bytes(\n                    q[slot * 120 + term * 4..slot * 120 + term * 4 + 4]\n                        .try_into()\n                        .unwrap(),\n                )\n                .unwrap();\n                let coefficient = g[term].to_limbs();\n                sums[0] += u64::from(coefficient[0]) * u64::from(scalar.0);\n                sums[1] += u64::from(coefficient[1]) * u64::from(scalar.0);\n                sums[2] += u64::from(coefficient[2]) * u64::from(scalar.0);\n                sums[3] += u64::from(coefficient[3]) * u64::from(scalar.0);\n                sums[4] += u64::from(coefficient[4]) * u64::from(scalar.0);\n                sums[5] += u64::from(coefficient[5]) * u64::from(scalar.0);\n                sums[6] += u64::from(coefficient[6]) * u64::from(scalar.0);\n                sums[7] += u64::from(coefficient[7]) * u64::from(scalar.0);\n            }\n            limbs[0] += (sums[0] & 0x7fff_ffff) + (sums[0] >> 31);\n            limbs[1] += (sums[1] & 0x7fff_ffff) + (sums[1] >> 31);\n            limbs[2] += (sums[2] & 0x7fff_ffff) + (sums[2] >> 31);\n            limbs[3] += (sums[3] & 0x7fff_ffff) + (sums[3] >> 31);\n            limbs[4] += (sums[4] & 0x7fff_ffff) + (sums[4] >> 31);\n            limbs[5] += (sums[5] & 0x7fff_ffff) + (sums[5] >> 31);\n            limbs[6] += (sums[6] & 0x7fff_ffff) + (sums[6] >> 31);\n            limbs[7] += (sums[7] & 0x7fff_ffff) + (sums[7] >> 31);\n        }\n\n        let mut value = WideExact::from_limbs([\n            M31::reduce_u64(limbs[0]).0,\n            M31::reduce_u64(limbs[1]).0,\n            M31::reduce_u64(limbs[2]).0,\n            M31::reduce_u64(limbs[3]).0,\n            M31::reduce_u64(limbs[4]).0,\n            M31::reduce_u64(limbs[5]).0,\n            M31::reduce_u64(limbs[6]).0,\n            M31::reduce_u64(limbs[7]).0\n        ]).unwrap();\n        let mut tail=EbyKDot::new();\n        tail.push(g[28],QM31::from_le_bytes(&q[slot*120+104..slot*120+120]).unwrap()).unwrap();\n        let offset0 = 480 + slot * 32 + 0 * 16;\n                tail.push(g[0 + 26], QM31::from_le_bytes(&q[offset0..offset0 + 16]).unwrap()).unwrap();\n                let offset1 = 480 + slot * 32 + 1 * 16;\n                tail.push(g[1 + 26], QM31::from_le_bytes(&q[offset1..offset1 + 16]).unwrap()).unwrap();\n        value.add(tail.finish())\n    \n}\n\n// Candidate-only explicit four-call version, preserving the callback order.\npub fn four_dots(q: &[u8], g: &[WideExact; 29]) -> [WideExact; 4] {\n    let q: &[u8; 608] = q[..608].try_into().unwrap();\n    [\n        four_dots_one(q, g, 0),\n        four_dots_one(q, g, 1),\n        four_dots_one(q, g, 2),\n        four_dots_one(q, g, 3),\n    ]\n}\n"},{"id":1,"name":{"Local":"crates/aspis-r1-cost-probe/src/lib.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! UNPROVED R1 COST PROBE. P2 only; no production entrypoint.\n#![no_std]\nextern crate alloc;\npub mod sampler;\npub mod semantic_wire;\npub mod semantic;\npub mod fast_domain;\npub mod fast_dots;\npub mod fast_pairing;\n\n#[cfg(feature = \"prover\")]\nextern crate std;\npub mod r1_wire;\npub mod r1_semantic;\npub mod trace;\npub mod transport;\npub mod weights;\npub mod transcript;\npub mod verifier;\n#[cfg(feature = \"prover\")]\npub mod prover;\n#[cfg(feature = \"prover\")]\npub mod dense;\n/// G-sim (LOG D44.3): the explicit R1 simulator simE in the ideal game.\n#[cfg(feature = \"r1p-check\")]\npub mod sim;\n\n#[cfg(feature=\"prover\")] mod host_sumcheck;\n#[cfg(feature=\"prover\")] mod host_semantic;\n#[cfg(feature=\"prover\")] mod host_commitment;\n\n// Adopted R1 proof format (PREREG-PROOF-SIZE-2, 2026-10-19): compact QM31\n// storage and binary multiproofs. UNPROVED: see PROOF-SIZE-OBLIGATIONS.\npub mod multiproof;\npub mod compact;\n\n#[cfg(not(feature=\"private-leaf-salts\"))]\ncompile_error!(\"the adopted R1 proof format is defined over private leaf salts; enable `private-leaf-salts` (a default feature)\");\n#[cfg(all(feature=\"audit-eight-way\",feature=\"prover\"))]\ncompile_error!(\"`audit-eight-way` is audit-only: it is never combined with the prover (PREREG-PROOF-SIZE-2 item 4)\");\n#[cfg(all(feature=\"audit-eight-way\",any(target_os=\"solana\",feature=\"program-build\")))]\ncompile_error!(\"`audit-eight-way` is audit-only: it is never built for a program (PREREG-PROOF-SIZE-2 item 4)\");\n"},{"id":2,"name":{"Local":"crates/aspis-core/src/field/wide_exact.rs"},"crate_name":"aspis_core","contents":null},{"id":3,"name":{"Local":"crates/aspis-core/src/field.rs"},"crate_name":"aspis_core","contents":null},{"id":4,"name":{"Local":"crates/aspis-core/src/lib.rs"},"crate_name":"aspis_core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/fmt/mod.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/iter/adapters/step_by.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/iter/adapters/mod.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"/rustc/library/core/src/iter/mod.rs"},"crate_name":"core","contents":null},{"id":19,"name":{"Local":"crates/aspis-r1-cost-probe/src/fast_pairing.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! Exact-field dot accumulator candidates; arithmetic-only equivalence code.\nmod canonical {\n    //! Private canonical representation: validate at the boundary, preserve internally.\n    //! No public unchecked constructor. This does NOT change aspis_core::M31.\n    pub const P:u32=0x7fff_ffff;\n    const MASK:u64=0x7fff_ffff_7fff_ffff;\n    const ONES:u64=0x0000_0001_0000_0001;\n    #[derive(Clone,Copy,Debug,PartialEq,Eq,Default)]\n    pub struct Q([u32;4]);\n    #[inline(always)] pub(crate) fn reduce(mut x:u64)->u32 {\n        x=(x & u64::from(P))+(x>>31);\n        x=(x & u64::from(P))+(x>>31);\n        if x>=u64::from(P) {(x-u64::from(P)) as u32}else{x as u32}\n    }\n    #[inline(always)] pub(crate) fn add(a:u32,b:u32)->u32 {\n        let s=a.wrapping_add(b);if s>=P{s-P}else{s}\n    }\n    #[inline(always)] fn pair(a:u32,b:u32)->u64 {u64::from(a)|(u64::from(b)<<32)}\n    #[inline(always)] fn reduce_pair(s:u64)->u64 {\n        (s.wrapping_add(((s.wrapping_add(ONES))>>31)&ONES))&MASK\n    }\n    impl Q {\n        pub const ZERO:Self=Self([0;4]);pub const ONE:Self=Self([1,0,0,0]);\n        pub fn from_limbs(x:[u32;4])->Option<Self>{if x.iter().all(|&v|v<P){Some(Self(x))}else{None}}\n        pub fn from_m31(x:u32)->Option<Self>{if x<P{Some(Self([x,0,0,0]))}else{None}}\n        pub const fn limbs(self)->[u32;4]{self.0}\n        /// WideExact owns private, canonical coordinates; this constructor\n        /// accepts only that validated type, never raw QM31 limbs or bytes.\n        #[inline(always)]\n        pub(super) fn from_wide(value:super::E)->[Self;2] {\n            let [a,b,c,d,e,f,g,h]=value.to_limbs();\n            [Self([a,b,c,d]),Self([e,f,g,h])]\n        }\n        #[inline(always)] pub fn add(self,rhs:Self)->Self {\n            let a=reduce_pair(pair(self.0[0],self.0[1]).wrapping_add(pair(rhs.0[0],rhs.0[1])));\n            let b=reduce_pair(pair(self.0[2],self.0[3]).wrapping_add(pair(rhs.0[2],rhs.0[3])));\n            Self([a as u32,(a>>32) as u32,b as u32,(b>>32) as u32])\n        }\n        #[inline(always)] pub fn sub(self,rhs:Self)->Self {\n            let a=reduce_pair(pair(self.0[0],self.0[1]).wrapping_add(MASK).wrapping_sub(pair(rhs.0[0],rhs.0[1])));\n            let b=reduce_pair(pair(self.0[2],self.0[3]).wrapping_add(MASK).wrapping_sub(pair(rhs.0[2],rhs.0[3])));\n            Self([a as u32,(a>>32) as u32,b as u32,(b>>32) as u32])\n        }\n        #[inline(always)] pub fn half(self)->Self {\n            let h=|x:u32|(x>>1)|((x&1)<<30);Self(self.0.map(h))\n        }\n        pub fn half_pow(self,n:u8)->Option<Self>{\n            if n>30{return None}if n==0{return Some(self)}\n            Some(Self(self.0.map(|x|(x>>n)|((x&((1u32<<n)-1))<<(31-n)))))\n        }\n        #[inline(always)] pub fn mul_m31(self,rhs:u32)->Option<Self>{\n            if rhs>=P{return None}Some(Self(self.0.map(|x|reduce(u64::from(x)*u64::from(rhs)))))\n        }\n        /// Benchmark candidate, not an assertion of superiority over staged R19.\n        /// All intermediates are nonnegative and strictly below 2^64.\n        #[inline(always)] pub fn mul(self,rhs:Self)->Self {\n            let [a,b,c,d]=self.0.map(u64::from);let [e,f,g,h]=rhs.0.map(u64::from);\n            const PP:u64=(P as u64)*(P as u64);\n            let partial=|x:u64|(x&u64::from(P)).wrapping_add(x>>31);\n            let u=partial((c*g).wrapping_add(PP).wrapping_sub(d*h));\n            let v=partial((c*h).wrapping_add(d*g));\n            Self([reduce((a*e).wrapping_add(PP).wrapping_sub(b*f).wrapping_add(2*u).wrapping_add(3*u64::from(P)).wrapping_sub(v)),\n                reduce((a*f).wrapping_add(b*e).wrapping_add(u).wrapping_add(2*v)),\n                reduce((a*g).wrapping_add(c*e).wrapping_add(2*PP).wrapping_sub(b*h).wrapping_sub(d*f)),\n                reduce((a*h).wrapping_add(b*g).wrapping_add(c*f).wrapping_add(d*e))])\n        }\n    }\n\n    // Appended to the retained private Q module. Only Q can reach the raw path:\n    // its limbs are private, constructors validate, and operations preserve <P.\n    impl Q {\n        #[inline(always)]\n        fn raw(self,rhs:Self)->[u64;4] {\n            let [a,b,c,d]=self.0.map(u64::from);let [e,f,g,h]=rhs.0.map(u64::from);\n            const PP:u64=(P as u64)*(P as u64);\n            let partial=|x:u64|(x&u64::from(P)).wrapping_add(x>>31);\n            let u=partial((c*g).wrapping_add(PP).wrapping_sub(d*h));\n            let v=partial((c*h).wrapping_add(d*g));\n            [(a*e).wrapping_add(PP).wrapping_sub(b*f).wrapping_add(2*u).wrapping_add(3*u64::from(P)).wrapping_sub(v),\n             (a*f).wrapping_add(b*e).wrapping_add(u).wrapping_add(2*v),\n             (a*g).wrapping_add(c*e).wrapping_add(2*PP).wrapping_sub(b*h).wrapping_sub(d*f),\n             (a*h).wrapping_add(b*g).wrapping_add(c*f).wrapping_add(d*e)]\n        }\n        #[inline(always)]\n        pub fn dot<const N:usize>(left:[Self;N],right:[Self;N])->Self {\n            assert!(N<=4);let mut sums=[0u64;4];\n            for i in 0..N {\n                let raw=left[i].raw(right[i]);\n                for j in 0..4 {sums[j]=sums[j].wrapping_add((raw[j]&u64::from(P)).wrapping_add(raw[j]>>31));}\n            }\n            // Retained R59 bounds: each folded raw value <2^34, N<=4.\n            Self(sums.map(reduce))\n        }\n        #[inline(always)] pub fn neg(self)->Self {Self::ZERO.sub(self)}\n        #[inline(always)] pub fn square(self)->Self {self.mul(self)}\n    }\n\n    // Private canonical operands; bounded raw representatives, canonical result.\n    // At most 4096 partial folds, each <2^34, sum <2^46. No u64 wrap.\n    pub struct Dot { sums:[u64;4] }\n    impl Dot {\n        pub fn new()->Self {Self{sums:[0;4]}}\n        #[inline(always)]\n        pub fn push(&mut self,a:Q,b:Q) {\n            // Both enclosing public accumulators check the 4096-term bound.\n            // This private accumulator cannot be reached by raw callers.\n            let raw=a.raw(b);\n            for j in 0..4 {\n                self.sums[j]=self.sums[j].wrapping_add(\n                    (raw[j]&u64::from(P)).wrapping_add(raw[j]>>31));\n            }\n        }\n        pub fn finish(self)->Q {Q(self.sums.map(reduce))}\n    }\n}\n\n\nuse aspis_core::field::{CM31, QM31, WideExact as E};\n\nconst MAX_TERMS: usize = 4096;\n\n#[inline(always)]\nfn limbs_of(k: QM31) -> [u32; 4] {\n    [k.c0.a.0, k.c0.b.0, k.c1.a.0, k.c1.b.0]\n}\n\n#[inline(always)]\nfn checked_q(k: QM31) -> Result<canonical::Q, ()> {\n    canonical::Q::from_limbs(limbs_of(k)).ok_or(())\n}\n\n#[inline(always)]\nfn qm31_of(q: canonical::Q) -> QM31 {\n    let [a, b, c, d] = q.limbs();\n    QM31 {\n        c0: CM31 { a: aspis_core::field::M31(a), b: aspis_core::field::M31(b) },\n        c1: CM31 { a: aspis_core::field::M31(c), b: aspis_core::field::M31(d) },\n    }\n}\n\n/// Candidate exact accumulator for sums of `WideExact * QM31`.\n/// Canonical QM31 coordinates and the 4096-term limit are checked at push.\npub struct EbyKDot {\n    c0: canonical::Dot,\n    c1: canonical::Dot,\n    count: usize,\n}\n\nimpl EbyKDot {\n    pub fn new() -> Self {\n        Self { c0: canonical::Dot::new(), c1: canonical::Dot::new(), count: 0 }\n    }\n\n    #[inline(always)]\n    pub fn push(&mut self, value: E, scalar: QM31) -> Result<(), ()> {\n        if self.count >= MAX_TERMS { return Err(()); }\n        let [value_c0,value_c1] = canonical::Q::from_wide(value);\n        let scalar = checked_q(scalar)?;\n        self.c0.push(value_c0, scalar);\n        self.c1.push(value_c1, scalar);\n        self.count += 1;\n        Ok(())\n    }\n\n    #[inline(always)]\n    pub fn finish(self) -> E {\n        let [a,b,c,d]=self.c0.finish().limbs();\n        let [e,f,g,h]=self.c1.finish().limbs();\n        // The private accumulator produces canonical coordinates already.\n        E::from_limbs([a,b,c,d,e,f,g,h]).unwrap()\n    }\n}\n\n/// Candidate exact accumulator for sums of `WideExact * WideExact`.\n/// Four canonical QM31 dot accumulators implement the outer quadratic tower.\npub struct EbyEDot {\n    ac: canonical::Dot,\n    bd: canonical::Dot,\n    ad: canonical::Dot,\n    bc: canonical::Dot,\n    count: usize,\n}\n\nimpl EbyEDot {\n    pub fn new() -> Self {\n        Self {\n            ac: canonical::Dot::new(), bd: canonical::Dot::new(),\n            ad: canonical::Dot::new(), bc: canonical::Dot::new(), count: 0,\n        }\n    }\n\n    #[inline(always)]\n    pub fn push(&mut self, left: E, right: E) -> Result<(), ()> {\n        if self.count >= MAX_TERMS { return Err(()); }\n        let [a,b] = canonical::Q::from_wide(left);\n        let [c,d] = canonical::Q::from_wide(right);\n        self.ac.push(a, c);\n        self.bd.push(b, d);\n        self.ad.push(a, d);\n        self.bc.push(b, c);\n        self.count += 1;\n        Ok(())\n    }\n\n    #[inline(always)]\n    pub fn finish(self) -> E {\n        let ac = qm31_of(self.ac.finish());\n        let bd = qm31_of(self.bd.finish());\n        let ad = qm31_of(self.ad.finish());\n        let bc = qm31_of(self.bc.finish());\n        // v^2 = u, where WideExact::U embeds the QM31 generator in the base.\n        E::new(ac.add(bd.mul(E::U)), ad.add(bc))\n    }\n}\n"},{"id":20,"name":{"Local":"/rustc/library/core/src/iter/traits/iterator.rs"},"crate_name":"core","contents":null},{"id":21,"name":{"Local":"/rustc/library/core/src/iter/traits/mod.rs"},"crate_name":"core","contents":null},{"id":22,"name":{"Local":"/rustc/library/core/src/iter/range.rs"},"crate_name":"core","contents":null},{"id":23,"name":{"Local":"/rustc/library/core/src/iter/traits/collect.rs"},"crate_name":"core","contents":null},{"id":24,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":25,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":26,"name":{"Local":"/rustc/library/core/src/convert/num.rs"},"crate_name":"core","contents":null},{"id":27,"name":{"Local":"/rustc/library/core/src/array/iter.rs"},"crate_name":"core","contents":null},{"id":28,"name":{"Local":"/rustc/library/core/src/num/nonzero.rs"},"crate_name":"core","contents":null},{"id":29,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":30,"name":{"Local":"/rustc/library/core/src/iter/adapters/chain.rs"},"crate_name":"core","contents":null},{"id":31,"name":{"Local":"/rustc/library/core/src/iter/adapters/zip.rs"},"crate_name":"core","contents":null},{"id":32,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":33,"name":{"Local":"/rustc/library/core/src/iter/adapters/intersperse.rs"},"crate_name":"core","contents":null},{"id":34,"name":{"Local":"/rustc/library/core/src/ops/function.rs"},"crate_name":"core","contents":null},{"id":35,"name":{"Local":"/rustc/library/core/src/iter/adapters/map.rs"},"crate_name":"core","contents":null},{"id":36,"name":{"Local":"/ru