{"charon_version":"0.1.223","translated":{"crate_name":"aspis_r1_cost_probe","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::fast_pairing::canonical::_::raw"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/pair-h5-raw-source-extraction-v1-20261023/runs/charon/actual-raw.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"crates/aspis-r1-cost-probe/src/fast_pairing.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! Exact-field dot accumulator candidates; arithmetic-only equivalence code.\nmod canonical {\n    //! Private canonical representation: validate at the boundary, preserve internally.\n    //! No public unchecked constructor. This does NOT change aspis_core::M31.\n    pub const P:u32=0x7fff_ffff;\n    const MASK:u64=0x7fff_ffff_7fff_ffff;\n    const ONES:u64=0x0000_0001_0000_0001;\n    #[derive(Clone,Copy,Debug,PartialEq,Eq,Default)]\n    pub struct Q([u32;4]);\n    #[inline(always)] pub(crate) fn reduce(mut x:u64)->u32 {\n        x=(x & u64::from(P))+(x>>31u32);\n        x=(x & u64::from(P))+(x>>31u32);\n        if x>=u64::from(P) {(x-u64::from(P)) as u32}else{x as u32}\n    }\n    #[inline(always)] pub(crate) fn add(a:u32,b:u32)->u32 {\n        let s=a.wrapping_add(b);if s>=P{s-P}else{s}\n    }\n    #[inline(always)] fn pair(a:u32,b:u32)->u64 {u64::from(a)|(u64::from(b)<<32)}\n    #[inline(always)] fn reduce_pair(s:u64)->u64 {\n        (s.wrapping_add(((s.wrapping_add(ONES))>>31u32)&ONES))&MASK\n    }\n    impl Q {\n        pub const ZERO:Self=Self([0;4]);pub const ONE:Self=Self([1,0,0,0]);\n        pub fn from_limbs(x:[u32;4])->Option<Self>{\n            let [a,b,c,d]=x;\n            if a<P && b<P && c<P && d<P {Some(Self([a,b,c,d]))}else{None}\n        }\n        pub fn from_m31(x:u32)->Option<Self>{if x<P{Some(Self([x,0,0,0]))}else{None}}\n        pub const fn limbs(self)->[u32;4]{self.0}\n        /// WideExact owns private, canonical coordinates; this constructor\n        /// accepts only that validated type, never raw QM31 limbs or bytes.\n        #[inline(always)]\n        pub(super) fn from_wide(value:super::E)->[Self;2] {\n            let [a,b,c,d,e,f,g,h]=value.to_limbs();\n            [Self([a,b,c,d]),Self([e,f,g,h])]\n        }\n        #[inline(always)] pub fn add(self,rhs:Self)->Self {\n            let a=reduce_pair(pair(self.0[0],self.0[1]).wrapping_add(pair(rhs.0[0],rhs.0[1])));\n            let b=reduce_pair(pair(self.0[2],self.0[3]).wrapping_add(pair(rhs.0[2],rhs.0[3])));\n            Self([a as u32,(a>>32) as u32,b as u32,(b>>32) as u32])\n        }\n        #[inline(always)] pub fn sub(self,rhs:Self)->Self {\n            let a=reduce_pair(pair(self.0[0],self.0[1]).wrapping_add(MASK).wrapping_sub(pair(rhs.0[0],rhs.0[1])));\n            let b=reduce_pair(pair(self.0[2],self.0[3]).wrapping_add(MASK).wrapping_sub(pair(rhs.0[2],rhs.0[3])));\n            Self([a as u32,(a>>32) as u32,b as u32,(b>>32) as u32])\n        }\n        #[inline(always)] pub fn half(self)->Self {\n            let h=|x:u32|(x>>1)|((x&1)<<30);\n            let mut out=[0u32;4]; for i in 0..4 {out[i]=h(self.0[i]);} Self(out)\n        }\n        pub fn half_pow(self,n:u8)->Option<Self>{\n            if n>30{return None}if n==0{return Some(self)}\n            let mut out=[0u32;4];\n            for i in 0..4 {let x=self.0[i];out[i]=(x>>n)|((x&((1u32<<n)-1))<<(31-n));}\n            Some(Self(out))\n        }\n        #[inline(always)] pub fn mul_m31(self,rhs:u32)->Option<Self>{\n            if rhs>=P{return None}\n            let mut out=[0u32;4]; for i in 0..4 {out[i]=reduce(u64::from(self.0[i])*u64::from(rhs));}\n            Some(Self(out))\n        }\n        /// Benchmark candidate, not an assertion of superiority over staged R19.\n        /// All intermediates are nonnegative and strictly below 2^64.\n        #[inline(always)] pub fn mul(self,rhs:Self)->Self {\n            let [a,b,c,d]=[u64::from(self.0[0]),u64::from(self.0[1]),u64::from(self.0[2]),u64::from(self.0[3])];\n            let [e,f,g,h]=[u64::from(rhs.0[0]),u64::from(rhs.0[1]),u64::from(rhs.0[2]),u64::from(rhs.0[3])];\n            const PP:u64=(P as u64)*(P as u64);\n            let partial=|x:u64|(x&u64::from(P)).wrapping_add(x>>31u32);\n            let u=partial((c*g).wrapping_add(PP).wrapping_sub(d*h));\n            let v=partial((c*h).wrapping_add(d*g));\n            Self([reduce((a*e).wrapping_add(PP).wrapping_sub(b*f).wrapping_add(2*u).wrapping_add(3*u64::from(P)).wrapping_sub(v)),\n                reduce((a*f).wrapping_add(b*e).wrapping_add(u).wrapping_add(2*v)),\n                reduce((a*g).wrapping_add(c*e).wrapping_add(2*PP).wrapping_sub(b*h).wrapping_sub(d*f)),\n                reduce((a*h).wrapping_add(b*g).wrapping_add(c*f).wrapping_add(d*e))])\n        }\n    }\n\n    // Appended to the retained private Q module. Only Q can reach the raw path:\n    // its limbs are private, constructors validate, and operations preserve <P.\n    impl Q {\n        #[inline(always)]\n        fn raw(self,rhs:Self)->[u64;4] {\n            let [a,b,c,d]=[u64::from(self.0[0]),u64::from(self.0[1]),u64::from(self.0[2]),u64::from(self.0[3])];\n            let [e,f,g,h]=[u64::from(rhs.0[0]),u64::from(rhs.0[1]),u64::from(rhs.0[2]),u64::from(rhs.0[3])];\n            const PP:u64=(P as u64)*(P as u64);\n            let partial=|x:u64|(x&u64::from(P)).wrapping_add(x>>31u32);\n            let u=partial((c*g).wrapping_add(PP).wrapping_sub(d*h));\n            let v=partial((c*h).wrapping_add(d*g));\n            [(a*e).wrapping_add(PP).wrapping_sub(b*f).wrapping_add(2*u).wrapping_add(3*u64::from(P)).wrapping_sub(v),\n             (a*f).wrapping_add(b*e).wrapping_add(u).wrapping_add(2*v),\n             (a*g).wrapping_add(c*e).wrapping_add(2*PP).wrapping_sub(b*h).wrapping_sub(d*f),\n             (a*h).wrapping_add(b*g).wrapping_add(c*f).wrapping_add(d*e)]\n        }\n        #[inline(always)]\n        pub fn dot<const N:usize>(left:[Self;N],right:[Self;N])->Self {\n            assert!(N<=4);let mut sums=[0u64;4];\n            for i in 0..N {\n                let raw=left[i].raw(right[i]);\n                for j in 0..4 {sums[j]=sums[j].wrapping_add((raw[j]&u64::from(P)).wrapping_add(raw[j]>>31u32));}\n            }\n            // Retained R59 bounds: each folded raw value <2^34, N<=4.\n            Self([reduce(sums[0]),reduce(sums[1]),reduce(sums[2]),reduce(sums[3])])\n        }\n        #[inline(always)] pub fn neg(self)->Self {Self::ZERO.sub(self)}\n        #[inline(always)] pub fn square(self)->Self {self.mul(self)}\n    }\n\n    // Private canonical operands; bounded raw representatives, canonical result.\n    // At most 4096 partial folds, each <2^34, sum <2^46. No u64 wrap.\n    pub struct Dot { sums:[u64;4] }\n    impl Dot {\n        pub fn new()->Self {Self{sums:[0;4]}}\n        #[inline(always)]\n        pub fn push(&mut self,a:Q,b:Q) {\n            // Both enclosing public accumulators check the 4096-term bound.\n            // This private accumulator cannot be reached by raw callers.\n            let raw=a.raw(b);\n            for j in 0..4 {\n                self.sums[j]=self.sums[j].wrapping_add(\n                    (raw[j]&u64::from(P)).wrapping_add(raw[j]>>31u32));\n            }\n        }\n        pub fn finish(self)->Q {Q([reduce(self.sums[0]),reduce(self.sums[1]),reduce(self.sums[2]),reduce(self.sums[3])])}\n    }\n}\n\n\nuse aspis_core::field::{CM31, QM31, WideExact as E};\n\nconst MAX_TERMS: usize = 4096;\n\n#[inline(always)]\nfn limbs_of(k: QM31) -> [u32; 4] {\n    [k.c0.a.0, k.c0.b.0, k.c1.a.0, k.c1.b.0]\n}\n\n#[inline(always)]\nfn checked_q(k: QM31) -> Result<canonical::Q, ()> {\n    match canonical::Q::from_limbs(limbs_of(k)) { Some(q) => Ok(q), None => Err(()) }\n}\n\n#[inline(always)]\nfn qm31_of(q: canonical::Q) -> QM31 {\n    let [a, b, c, d] = q.limbs();\n    QM31 {\n        c0: CM31 { a: aspis_core::field::M31(a), b: aspis_core::field::M31(b) },\n        c1: CM31 { a: aspis_core::field::M31(c), b: aspis_core::field::M31(d) },\n    }\n}\n\n/// Candidate exact accumulator for sums of `WideExact * QM31`.\n/// Canonical QM31 coordinates and the 4096-term limit are checked at push.\npub struct EbyKDot {\n    c0: canonical::Dot,\n    c1: canonical::Dot,\n    count: usize,\n}\n\nimpl EbyKDot {\n    pub fn new() -> Self {\n        Self { c0: canonical::Dot::new(), c1: canonical::Dot::new(), count: 0 }\n    }\n\n    #[inline(always)]\n    pub fn push(&mut self, value: E, scalar: QM31) -> Result<(), ()> {\n        if self.count >= MAX_TERMS { return Err(()); }\n        let [value_c0,value_c1] = canonical::Q::from_wide(value);\n        let scalar = checked_q(scalar)?;\n        self.c0.push(value_c0, scalar);\n        self.c1.push(value_c1, scalar);\n        self.count += 1;\n        Ok(())\n    }\n\n    #[inline(always)]\n    pub fn finish(self) -> E {\n        let [a,b,c,d]=self.c0.finish().limbs();\n        let [e,f,g,h]=self.c1.finish().limbs();\n        // The private accumulator produces canonical coordinates already.\n        E::from_limbs([a,b,c,d,e,f,g,h]).unwrap()\n    }\n}\n\n/// Candidate exact accumulator for sums of `WideExact * WideExact`.\n/// Four canonical QM31 dot accumulators implement the outer quadratic tower.\npub struct EbyEDot {\n    ac: canonical::Dot,\n    bd: canonical::Dot,\n    ad: canonical::Dot,\n    bc: canonical::Dot,\n    count: usize,\n}\n\nimpl EbyEDot {\n    pub fn new() -> Self {\n        Self {\n            ac: canonical::Dot::new(), bd: canonical::Dot::new(),\n            ad: canonical::Dot::new(), bc: canonical::Dot::new(), count: 0,\n        }\n    }\n\n    #[inline(always)]\n    pub fn push(&mut self, left: E, right: E) -> Result<(), ()> {\n        if self.count >= MAX_TERMS { return Err(()); }\n        let [a,b] = canonical::Q::from_wide(left);\n        let [c,d] = canonical::Q::from_wide(right);\n        self.ac.push(a, c);\n        self.bd.push(b, d);\n        self.ad.push(a, d);\n        self.bc.push(b, c);\n        self.count += 1;\n        Ok(())\n    }\n\n    #[inline(always)]\n    pub fn finish(self) -> E {\n        let ac = qm31_of(self.ac.finish());\n        let bd = qm31_of(self.bd.finish());\n        let ad = qm31_of(self.ad.finish());\n        let bc = qm31_of(self.bc.finish());\n        // v^2 = u, where WideExact::U embeds the QM31 generator in the base.\n        E::new(ac.add(bd.mul(E::U)), ad.add(bc))\n    }\n}\n"},{"id":1,"name":{"Local":"crates/aspis-r1-cost-probe/src/lib.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! UNPROVED R1 COST PROBE. P2 only; no production entrypoint.\n#![no_std]\nextern crate alloc;\npub mod sampler;\npub mod semantic_wire;\npub mod semantic;\npub mod fast_domain;\npub mod fast_dots;\npub mod fast_pairing;\n\n#[cfg(feature = \"prover\")]\nextern crate std;\npub mod r1_wire;\npub mod r1_semantic;\npub mod trace;\npub mod transport;\npub mod weights;\npub mod transcript;\npub mod verifier;\n#[cfg(feature = \"prover\")]\npub mod prover;\n#[cfg(feature = \"prover\")]\npub mod dense;\n/// G-sim (LOG D44.3): the explicit R1 simulator simE in the ideal game.\n#[cfg(feature = \"r1p-check\")]\npub mod sim;\n\n#[cfg(feature=\"prover\")] mod host_sumcheck;\n#[cfg(feature=\"prover\")] mod host_semantic;\n#[cfg(feature=\"prover\")] mod host_commitment;\n\n// Adopted R1 proof format (PREREG-PROOF-SIZE-2, 2026-10-19): compact QM31\n// storage and binary multiproofs. UNPROVED: see PROOF-SIZE-OBLIGATIONS.\npub mod multiproof;\npub mod compact;\n\n#[cfg(not(feature=\"private-leaf-salts\"))]\ncompile_error!(\"the adopted R1 proof format is defined over private leaf salts; enable `private-leaf-salts` (a default feature)\");\n#[cfg(all(feature=\"audit-eight-way\",feature=\"prover\"))]\ncompile_error!(\"`audit-eight-way` is audit-only: it is never combined with the prover (PREREG-PROOF-SIZE-2 item 4)\");\n#[cfg(all(feature=\"audit-eight-way\",any(target_os=\"solana\",feature=\"program-build\")))]\ncompile_error!(\"`audit-eight-way` is audit-only: it is never built for a program (PREREG-PROOF-SIZE-2 item 4)\");\n"},{"id":2,"name":{"Local":"/rustc/library/core/src/convert/num.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/function.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":10,"na