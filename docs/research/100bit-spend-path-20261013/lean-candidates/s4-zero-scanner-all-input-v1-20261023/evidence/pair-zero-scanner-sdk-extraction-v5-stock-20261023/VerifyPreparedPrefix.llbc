nsigned":["U64","9223372036854775825"]},"end":{"Unsigned":["U64","9223372036854775825"]}},{"Known":17}],[{"start":{"Unsigned":["U64","9223372036854775826"]},"end":{"Unsigned":["U64","9223372036854775826"]}},{"Known":18}],[{"start":{"Unsigned":["U64","9223372036854775827"]},"end":{"Unsigned":["U64","9223372036854775827"]}},{"Known":19}],[{"start":{"Unsigned":["U64","9223372036854775828"]},"end":{"Unsigned":["U64","9223372036854775828"]}},{"Known":20}],[{"start":{"Unsigned":["U64","9223372036854775829"]},"end":{"Unsigned":["U64","9223372036854775829"]}},{"Known":21}],[{"start":{"Unsigned":["U64","9223372036854775830"]},"end":{"Unsigned":["U64","9223372036854775830"]}},{"Known":22}],[{"start":{"Unsigned":["U64","9223372036854775831"]},"end":{"Unsigned":["U64","9223372036854775831"]}},{"Known":23}],[{"start":{"Unsigned":["U64","9223372036854775832"]},"end":{"Unsigned":["U64","9223372036854775832"]}},{"Known":24}],[{"start":{"Unsigned":["U64","9223372036854775833"]},"end":{"Unsigned":["U64","9223372036854775833"]}},{"Known":25}]],"fallback":"Invalid"}}]],"fallback":{"Known":14}}},"uninhabited":false,"variant_layouts":[{"field_offsets":[8],"uninhabited":false,"tagger":[[0,{"Unsigned":["U64","9223372036854775808"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U64","9223372036854775809"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U64","9223372036854775810"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U64","9223372036854775811"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U64","9223372036854775812"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U64","9223372036854775813"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U64","9223372036854775814"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U64","9223372036854775815"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U64","922