     index += 1;\n    }\n    Ok(())\n}\npub fn entry(bytes: &[u8]) -> ProgramResult { require_zero(bytes) }\n}\npub mod tail {\nuse solana_program_error::{ProgramError, ProgramResult};\nfn require_zero(mut remaining: &[u8]) -> ProgramResult {\n    while !remaining.is_empty() {\n        if remaining[0] != 0 { return Err(ProgramError::AccountAlreadyInitialized); }\n        remaining = &remaining[1..];\n    }\n    Ok(())\n}\npub fn entry(bytes: &[u8]) -> ProgramResult { require_zero(bytes) }\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/solana-program-error-2.2.2/src/lib.rs"},"crate_name":"solana_program_error","contents":null},{"id":4,"name":{"Local":"/rustc/library/alloc/src/string.rs"},"crate_name":"alloc","contents":null},{"id":5,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/ptr/mod.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["aspis_r1_readonly_account",0]},{"Ident":["indexed",0]},{"Ident":["entry",0]}]},{"k