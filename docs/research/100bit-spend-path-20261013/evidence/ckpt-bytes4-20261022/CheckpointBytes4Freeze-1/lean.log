  AspisV8R19.MemoizedProgramLaw.eval H
      (AspisR1.OraclePortCkptAbi5Stage.strictStage stored tr.statement.pubBytes
        (AspisR1.OraclePortAcceptedContextC6.context p i v) i.data (AspisR1.SelectedChallengeMap.rhoOf i.rho) q) =
    AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.OraclePortFrozen2.checkpoint stored p q tr i v)
