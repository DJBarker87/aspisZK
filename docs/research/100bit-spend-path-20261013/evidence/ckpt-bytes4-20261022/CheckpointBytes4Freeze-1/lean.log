AspisR1.OraclePortCkptAbi5Stage.reached_stage (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (stored : AspisV8R19.DuplexFrames.Bytes) (p : AspisR1.OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144)
  (tr : AspisR1.RawCutTranscriptRun.ErasedPrefix) (i : AspisR1.RecordedBinaryExperimentBin.SourceInputs)
  (v : AspisR1.LiteralOpeningView.View) (input : AspisR1.OraclePortStoredDecisionDraftC4.input p q tr = some i)
