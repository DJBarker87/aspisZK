        "source_text": "fn semantic_rounds<H: Digest32>(prefix: &Prefix<'_>, mut transcript: SemanticTranscript<H>) -> Result<(QM31, [QM31; 10], SemanticTranscript<H>), Error> {\n    let mut running = prefix.validated_record(14)?.decode_k::<1>(0)?[0];\n    let mut alpha = [QM31::ZERO; 10];\n    #[cfg(feature = \"prover\")]\n    let mut round_checks = [[QM31::ZERO; 3]; 10];\n    {\n        let round = 0usize;\n        (running, alpha, transcript) = semantic_round(prefix, transcript, alpha, running, round)?;\n    }\n    {\n        let round = 1usize;\n        (running, alpha, transcript) = semantic_round(prefix, transcript, alpha, running, round)?;\n    }\n    {\n        let round = 2usize;\n        (running, alpha, transcript) = semantic_round(prefix, transcript, alpha, running, round)?;\n    }\n    {\n        let round = 3usize;\n        (running, alpha, transcript) = semantic_round(prefix, transcript, alpha, running, round)?;\n    }\n    {\n        let round = 4usize;\n        (running, alpha, transcript) = semantic_round(prefix, transcript, alpha, running, round)?;\n    }\n    {\n        let round = 5usize;\n        (running, alpha, transcript) = semantic_round(prefix, transcript, alpha, running, round)?;\n    }\n    {\n        let round = 6usize;\n        (running, alpha, transcript) = semantic_round(prefix, transcript, alpha, running, round)?;\n    }\n    {\n        let round = 7usize;\n        (running, alpha, transcript) = semantic_round(prefix, transcript, alpha, running, round)?;\n    }\n    {\n        let round = 8usize;\n        (running, alpha, transcript) = semantic_round(prefix, transcript, alpha, running, round)?;\n    }\n    {\n        let round = 9usize;\n        (running, alpha, transcript) = semantic_round(prefix, transcript, alpha, running, round)?;\n    }\n    Ok((running, alpha, transcript))\n}",
