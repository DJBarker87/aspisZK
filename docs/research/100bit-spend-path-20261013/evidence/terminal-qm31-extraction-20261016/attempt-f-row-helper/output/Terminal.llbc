rray::from_fn(|output| {\n        core::array::from_fn(|limb| {\n            let a = u64::from(input[0][limb]);\n            let b = u64::from(input[1][limb]);\n            let c = u64::from(input[2][limb]);\n            let d = u64::from(input[3][limb]);\n            match output {\n                0 => 2 * a + 3 * b + c + d,\n                1 => a + 2 * b + 3 * c + d,\n                2 => a + b + 2 * c + 3 * d,\n                3 => 3 * a + b + c + 2 * d,\n                _ => unreachable!(),\n            }\n        })\n    });\n    let mut all_local_limbs_bounded = true;\n    let mut output = 0usize;\n    while output < 4 {\n        let mut limb = 0usize;\n        while limb < 4 {\n            all_local_limbs_bounded &= local[output][limb] < EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n            limb += 1;\n        }\n        output += 1;\n    }\n    debug_assert!(all_local_limbs_bounded);\n\n    let bound = EXTERNAL_LOCAL_LIMB_MODULUS_BOUND;\n    let packed = [\n        local[0][0] + 5 * bound - local[1][1] + 2 * local[2][2]\n            - local[2][3]\n            - local[3][2]\n            - 2 * local[3][3],\n        local[0][1] + local[1][0] + local[2][2] + 2 * local[2][3] + 2 * local[3][2] + bound\n            - local[3][3],\n        local[0][2] + 2 * bound - local[1][3] + local[2][0] - local[3][1],\n        local[0][3] + local[1][2] + local[2][1] + local[3][0],\n    ];\n    debug_assert!(packed[0] < 8 * bound);\n    debug_assert!(packed[1] < 8 * bound);\n    debug_assert!(packed[2] < 4 * bound);\n    debug_assert!(packed[3] < 4 * bound);\n    packed\n}","attr_info":{"attributes":[{"DocComment":" Apply the local external matrix and the tower-basis packing functional in"},{"DocComment":" one raw-limb pass."},{"DocComment":""},{"DocComment":" If `t[r,l] = sum_j B[r,j] * input[j,l]`, packing the four local outputs"},{"DocComment":" against `(1, i, u, i*u)` gives exactly"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" c0.a = t[0,a] - t[1,b] + 2t[2,c] - t[2,d] - t[3,c] - 2t[3,d]"},{"DocComment":" c0.b = t[0,b] + t[1,a] + t[2,c] + 2t[2,d] + 2t[3,c] - t[3,d]"},{"DocComment":" c1.a = t[0,c] - t[1,d] + t[2,a] - t[3,b]"},{"DocComment":" c1.b = t[0,d] + t[1,c] + t[2,b] + t[3,a]"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The signed offsets below are multiples of P and do not change the field"},{"DocComment":" value. The first two raw outputs are below `56P`; the last two are below"},{"DocComment":" `28P`. Thus one final reduction per output limb is sufficient."}],"inline":"Always","rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":3485}],"output":{"Deduplicated":11194}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":19,"beg":{"line":221,"col":0},"end":{"line":266,"col":1}},"generated_from_span":null},"bound_body_regions":13,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":19,"beg":{"line":221,"col":50},"end":{"line":221,"col":58}},"generated_from_span":null},"ty":{"Deduplicated":11194}},{"index":1,"name":"input","span":{"data":{"file_id":19,"beg":{"line":221,"col":29},"end":{"line":221,"col":34}},"generated_from_span":null},"ty":{"Deduplicated":3485}},{"index":2,"name":"input","span":{"data":{"file_id":19,"beg":{"line":222,"col":8},"end":{"line":222,"col":13}},"generated_from_span":null},"ty":{"Deduplicated":11189}},{"index":3,"name":null,"span":{"data":{"file_id":19,"beg":{"line":222,"col":16},"end":{"line":222,"col":21}},"generated_from_span":null},"ty":{"Deduplicated":3485}},{"index":4,"name":"local","span":{"data":{"file_id":19,"beg":{"line":223,"col":8},"end":{"line":223,"col":13}},"generated_from_span":null},"ty":{"Deduplicated":11195}},{"index":5,"name":nu