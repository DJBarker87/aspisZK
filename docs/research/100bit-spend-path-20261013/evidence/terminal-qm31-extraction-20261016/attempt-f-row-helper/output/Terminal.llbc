ng the same four limbs again.  Poseidon constant interpolation\n    // uses this fixed 3/4-term shape heavily.\n    if weights.len() <= 4 {\n        let mut raw = [0u64; 4];\n        let mut index = 0usize;\n        while index < weights.len() {\n            let weight = weights[index];\n            let value = u64::from(values[index].0);\n            raw[0] += u64::from(weight.c0.a.0) * value;\n            raw[1] += u64::from(weight.c0.b.0) * value;\n            raw[2] += u64::from(weight.c1.a.0) * value;\n            raw[3] += u64::from(weight.c1.b.0) * value;\n            index += 1;\n        }\n        return QM31 {\n            c0: CM31::new(M31::reduce_u64(raw[0]), M31::reduce_u64(raw[1])),\n            c1: CM31::new(M31::reduce_u64(raw[2]), M31::reduce_u64(raw[3])),\n        };\n    }\n    let mut sums = [0u64; 4];\n    for start in (0..weights.len()).step_by(4) {\n        let end = core::cmp::min(start + 4, weights.len());\n        let mut raw = [0u64; 4];\n        for index in start..end {\n            let value = values[index].0 as u64;\n            let weight = weights[index];\n            raw[0] += weight.c0.a.0 as u64 * value;\n            raw[1] += weight.c0.b.0 as u64 * value;\n            raw[2] += weight.c1.a.0 as u64 * value;\n            raw[3] += weight.c1.b.0 as u64 * value;\n        }\n        for index in 0..4 {\n            sums[index] += M31::reduce_u64(raw[index]).0 as u64;\n        }\n    }\n    QM31 {\n        c0: CM31::new(M31::reduce_u64(sums[0]), M31::reduce_u64(sums[1])),\n        c1: CM31::new(M31::reduce_u64(sums[2]), M31::reduce_u64(sums[3])),\n    }\n}","attr_info":{"attributes":[{"DocComment":" Dot product between QM31 weights and raw M31 trace columns. Four scalar"},{"DocComment":" products are fused per inner reduction; those canonical block results are"},{"DocComment":" then accumulated in u64 and reduced once per output limb."},{"DocComment":""},{"DocComment":" For an 80-column opening each outer accumulator is below `20 * P`, so this"},{"DocComment":" removes 76 canonical additions without widening the hot product loop."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":17972},{"HashConsedValue":[17999,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":9490},"Shared"]}]}],"output":{"Deduplicated":1620}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":4,"beg":{"line":1447,"col":0},"end":{"line":1490,"col":1}},"generated_from_span":null},"bound_body_regions":55,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":4,"beg":{"line":1447,"col":57},"end":{"line":1447,"col":61}},"generated_from_span":null},"ty":{"Deduplicated":1620}},{"index":1,"name":"weights","span":{"data":{"file_id":4,"beg":{"line":1447,"col":20},"end":{"line":1447,"col":27}},"generated_from_span":null},"ty":{"Deduplicated":10727}},{"index":2,"name":"values","span":{"data":{"file_id":4,"beg":{"line":1447,"col":38},"end":{"line":1447,"col":44}},"generated_from_span":null},"ty":{"HashConsedValue":[11315,{"Ref":[{"Body":3},{"Deduplicated":9490},"Shared"]}]}},{"index":3,"name":null,"span":{"data":{"file_id":76,"beg":{"line":44,"col":14},"end":{"line":44,"col":31}},"generated_from_span":null},"ty":{"HashConsedValue":[11324,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"HashConsedValue":[11322,{"Ref":[{"Body":7},{"Deduplicated":1621},"Shared"]}]},{"HashConsedValue":[11323,{"Ref":[{"Body":8},{"Deduplicated":1621},"Shared"]}]}],"const_generics":[],"trait_refs":[]}}}]}},{"index":4,"name":null,"span":{"data":{"file_id":76,"beg":{"line":44,"col":15},"end":{"line":44,"col":21}},"genera