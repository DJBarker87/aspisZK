for MyCollection<T> {"},{"DocComment":"     fn hash<H: Hasher>(&self, state: &mut H) {"},{"DocComment":"         state.write_length_prefix(self.len());"},{"DocComment":"         for elt in self {"},{"DocComment":"             elt.hash(state);"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Note to Implementers"},{"DocComment":""},{"DocComment":" If you've decided that your `Hasher` is willing to be susceptible to"},{"DocComment":" Hash-DoS attacks, then you might consider skipping hashing some or all"},{"DocComment":" of the `len` provided in the name of increased performance."}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":58,"generics":{"regions":[],"types":[{"Deduplicated":49597}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49653},{"Deduplicated":1522}],"output":{"Deduplicated":1764}},"src":{"TraitDecl":{"trait_ref":{"id":58,"generics":{"regions":[],"types":[{"Deduplicated":49597}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":14}}},"is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":114,"beg":{"line":483,"col":4},"end":{"line":485,"col":5}},"generated_from_span":null},"bound_body_regions":3,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":114,"beg":{"line":483,"col":49},"end":{"line":483,"col":49}},"generated_from_span":null},"ty":{"Deduplicated":1764}},{"index":1,"name":"sel