from_span":{"file_id":69,"beg":{"line":370,"col":75},"end":{"line":370,"col":76}}},"id":9727,"kind":{"StorageDead":5},"comments_before":[]},{"span":{"data":{"file_id":69,"beg":{"line":23,"col":55},"end":{"line":23,"col":56}},"generated_from_span":null},"id":9728,"kind":{"StorageDead":4},"comments_before":[]},{"span":{"data":{"file_id":69,"beg":{"line":23,"col":8},"end":{"line":23,"col":58}},"generated_from_span":null},"id":9729,"kind":{"Assign":[{"kind":{"Local":0},"ty":{"Deduplicated":50982}},{"Aggregate":[{"Adt":[{"id":{"Adt":74},"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598},{"Deduplicated":49600},{"Deduplicated":49627},{"Deduplicated":49778}],"const_generics":[],"trait_refs":[]}},null,null]},[{"Move":{"kind":{"Local":3},"ty":{"Deduplicated":50983}}}]]}]},"comments_before":[]},{"span":{"data":{"file_id":69,"beg":{"line":23,"col":57},"end":{"line":23,"col":58}},"generated_from_span":null},"id":9730,"kind":{"StorageDead":3},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1540,"col":5},"end":{"line":1540,"col":5}},"generated_from_span":null},"id":9731,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1540,"col":5},"end":{"line":1540,"col":5}},"generated_from_span":null},"id":9732,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1540,"col":5},"end":{"line":1540,"col":5}},"generated_from_span":null},"id":9733,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":133,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["flatten",0]}],"span":{"data":{"file_id":33,"beg":{"line":1617,"col":4},"end":{"line":1620,"col":33}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that flattens nested structure."},{"DocComment":""},{"DocComment":" This is useful when you have an iterator of iterators or an iterator of"},{"DocComment":" things that can be turned into iterators and you want to remove one"},{"DocComment":" level of indirection."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let data = vec![vec![1, 2, 3, 4], vec![5, 6]];"},{"DocComment":" let flattened: Vec<_> = data.into_iter().flatten().collect();"},{"DocComment":" assert_eq!(flattened, [1, 2, 3, 4, 5, 6]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Mapping and then flattening:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let words = [\"alpha\", \"beta\", \"gamma\"];"},{"DocComment":""},{"DocComment":" // chars() returns an iterator"},{"DocComment":" let merged: String = words.iter()"},{"DocComment":"                           .map(|s| s.chars())"},{"DocComment":"                           .flatten()"},{"DocComment":"                           .collect();"},{"DocComment":" assert_eq!(merged, \"alphabetagamma\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also rewrite this in terms of [`flat_map()`], which is preferable"},{"DocComment":" in this case since it conveys intent more clearly:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let words = [\"alpha\", \"beta\", \"gamma\"];"},{"DocComment":""},{"DocComment":" // chars() returns an iterator"},{"DocComment":" let merged: String = words.iter()"},{"DocComment":"                           .flat_map(|s| s.chars())"},{"DocComment":"                           .collect();"},{"DocComment":" assert_eq!(merged, \"alphabetagamma\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Flattening works on any `IntoIterator` type, including `Option` and `Result`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let options = vec![Some(123), Some(321), None, Some(231)];"},{"DocComment":" let flattened_options: Vec<_> = options.into_iter().flatten().collect();"},{"DocComment":" assert_eq!(flattened_options, [123, 321, 231]);"},{"DocComment":""},{"DocComment":" let results = vec![Ok(123), Ok(321), Err(456), Ok(231)];"},{"DocComment":" let flattened_results: Vec<_> = results.into_iter().flatten().collect();"},{"DocComment":" assert_eq!(flattened_results, [123, 321, 231]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Flattening only removes one level of nesting at a time:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let d3 = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]];"},{"DocComment":""},{"DocComment":" let d2: Vec<_> = d3.into_iter().flatten().collect();"},{"DocComment":" assert_eq!(d2, [[1, 2], [3, 4], [5, 6], [7, 8]]);"},{"DocComment":""},{"DocComment":" let d1: Vec<_> = d3.into_iter().flatten().flatten().collect();"},{"DocComment":" assert_eq!(d1, [1, 2, 3, 4, 5, 6, 7, 8]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Here we see that `flatten()` does not perform a \"deep\" flatten."},{"DocComment":" Instead, only one level of nesting is removed. That is, if you"},{"DocComment":" `flatten()` a three-dimensional array, the result will be"},{"DocComment":" two-dimensional and not one-dimensional. To get a one-dimensional"},{"DocComment":" structure, you have to `flatten()` again."},{"DocComment":""},{"DocComment":" [`flat_map()`]: Iterator::flat_map"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Item"},{"index":2,"name":"Clause1_Item"},{"index":3,"name":"Clause1_IntoIter"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id