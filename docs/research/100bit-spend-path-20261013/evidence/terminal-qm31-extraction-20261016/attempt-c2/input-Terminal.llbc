"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let v_copied: Vec<_> = a.iter().copied().collect();"},{"DocComment":""},{"DocComment":" // copied is the same as .map(|&x| x)"},{"DocComment":" let v_map: Vec<_> = a.iter().map(|&x| x).collect();"},{"DocComment":""},{"DocComment":" assert_eq!(v_copied, [1, 2, 3]);"},{"DocComment":" assert_eq!(v_map, [1, 2, 3]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"iter_copied"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597}],"output":{"Deduplicated":50712}},"default":{"id":163,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":49597},{"Deduplicated":2162},{"Deduplicated":2165}],"const_generics":[],"trait_refs":[{"HashConsedValue":[8160,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":21,"generics":{"regions":[],"types":[{"Deduplicated":2723}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[50713,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":2724}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[7,56]}},{"params":{"regions":[{"index":0,"name":"'a","mutability":"Unknown"}],"types":[{"index":0,"name":"T"},{"index":1,"name":"Clause1_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":3561,"col":11},"end":{"line":3561,"col":16}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":16,"generics":{"regions":[],"types":[{"Deduplicated":2723}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":33,"beg":{"line":3562,"col":22},"end":{"line":3562,"col":44}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"reg