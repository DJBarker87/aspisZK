nt":" // don't do this:"},{"DocComment":" let slower: Vec<_> = a.iter().cloned().filter(|s| s.len() == 1).collect();"},{"DocComment":" assert_eq!(&[vec![23]], &slower[..]);"},{"DocComment":" // instead call `cloned` late"},{"DocComment":" let faster: Vec<_> = a.iter().filter(|s| s.len() == 1).cloned().collect();"},{"DocComment":" assert_eq!(&[vec![23]], &faster[..]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"iter_cloned"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597}],"output":{"Deduplicated":50714}},"default":{"id":164,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":49597},{"Deduplicated":2162},{"Deduplicated":2165}],"const_generics":[],"trait_refs":[{"HashConsedValue":[8182,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":16,"generics":{"regions":[],"types":[{"Deduplicated":2723}],"const_generics":[],"trait_refs":[]}}}}]},{"Deduplicated":50713}]}}},"kind":{"TraitMethod":[7,57]}},{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":3592,"col":22},"end":{"line":3592,"col":35}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":16,"generics":{"regions":[],"types":[{"Deduplicated":49597}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"cycle","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["cycle",0]}],"span":{"data":{"file_id":33,"beg":{"line":3590,"col":4},"end":{"line":3592,"col":36}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Repeats an iterator endlessly."},{"DocComment":""},{"DocComment":" Instead of stopping at [`None`], the iterator will instead start again,"},{"DocComment":" from the beginning. After iterating again, it will start at the"},{"DocComment":" beginning again. And again. And again. Forever. Note that in case the"},{"DocComment":" original iterator is empty, the resulting iterator will also be empty."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().cycle();"},{"DocComment":""},{"DocComment":" loop {"},{"DocComment":"     assert_eq!(iter.next(), Some(1));"},{"DocComment":"     assert_eq!(iter.next(), Some(2));"},{"DocComment":"     assert_eq!(iter.next(), Some(3));"},{"DocComment":" #   break;"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597}],"output":{"Deduplicated":50715}},"default":{"id":165,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[{"HashConsedValue":[49835,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":16,"generics":{"regions":[],"types":[{"Deduplicated":49597}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[7,58]}},{"params":{"regions":[],"types":[],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":1522}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"array_chunks","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["array_chunks",0]}],"span":{"data":{"file_id":33,"beg":{"line":3633,"col":4},"end":{"line":3635,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns an iterator over `N` elements of the iterator at a time."},{"DocComment":""},{"DocComment":" The chunks do not overlap. If `N` does not divide the length of the"},{"DocComment":" iterator, then the last up to `N-1` elements will be omitted and can be"},{"DocComment":" retrieved from the [`.into_remainder()`][ArrayChunks::into_remainder]"},{"DocComment":" function of the iterator."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `N` is zero."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_array_chunks)]"},{"DocComment":""},{"DocComment":" let mut iter = \"lorem\".chars().array_chunks();"},{"DocComment":" assert_eq!(iter.next(), Some(['l', 'o']));"},{"DocComment":" assert_eq!(iter.next(), Some(['r', 'e']));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.into_remainder().as_slice(), &['m']);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_array_chunks)]"},{"DocComment":""},{"DocComment":" let data = [1, 1, 2, -2, 6, 0, 3, 1];"},{"DocComment":" //          ^-----^  ^------^"},{"DocComment":" for [x, y, z] in data.iter().array_chunks() {"},{"DocComment":"     assert_eq!(x + y + z, 4);"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597}],"output":{"HashConsedValue":[50716,{"Adt":{"id":{"Adt":83},"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598}],"const_generics":[{"kind":{"Var":{"Bound":[0,0]}},"ty":{"Deduplicated":1522}}],"trait_refs":[]}}}]}},"default":{"id":166,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598}],"const_generics":[{"kind":{"Var":{"Bound":[0,0]}},"ty":{"Deduplicated":1522}}],"trait_refs