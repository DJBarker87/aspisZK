,"end":{"line":1377,"col":32}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `x` formatting."},{"DocComment":""},{"DocComment":" The `LowerHex` trait should format its output as a number in hexadecimal, with `a` through `f`"},{"DocComment":" in lower case."},{"DocComment":""},{"DocComment":" For primitive signed integers (`i8` to `i128`, and `isize`),"},{"DocComment":" negative values are formatted as the two’s complement representation."},{"DocComment":""},{"DocComment":" The alternate flag, `#`, adds a `0x` in front of the output."},{"DocComment":""},{"DocComment":" For more information on formatters, see [the module-level documentation][module]."},{"DocComment":""},{"DocComment":" [module]: ../../std/fmt/index.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage with `i32`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let y = 42; // 42 is '2a' in hex"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"{y:x}\"), \"2a\");"},{"DocComment":" assert_eq!(format!(\"{y:#x}\"), \"0x2a\");"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"{:x}\", -16), \"fffffff0\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Implementing `LowerHex` on a type:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Length(i32);"},{"DocComment":""},{"DocComment":" impl fmt::LowerHex for Length {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         let val = self.0;"},{"DocComment":""},{"DocComment":"         fmt::LowerHex::fmt(&val, f) // delegate to i32's implementation"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let l = Length(9);"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"l as hex is: {l:x}\"), \"l as hex is: 9\");"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"l as hex is: {l:#010x}\"), \"l as hex is: 0x00000009\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"fmt","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["LowerHex",0]},{"Ident":["fmt",0]}],"span":{"data":{"file_id":81,"beg":{"line":1380,"col":4},"end":{"line":1380,"col":51}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":"Formats the value using the given formatter.\n\n# Errors\n\nThis function should return [`Err`] if, and only if, the provided [`Formatter`] returns [`Err`].\nString formatting is considered an infallible operation; this function only\nreturns a [`Result`] because writing to the underlying stream might fail and it must\nprovide a way to propagate the fact that an error has occurred back up the stack.\n"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49681},{"Deduplicated":15701}],"output":{"Deduplicated":15693}},"default":null},"kind":{"TraitMethod":[49,0]}}],"vtable":{"id":{"Adt":190},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":50,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["UpperHex",0]}],"span":{"data":{"file_id":81,"beg":{"line":1432,"col":0},"end":{"line":1432,"col":32}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `X` formatting."},{"DocComment":""},{"DocComment":" The `UpperHex` trait should format its output as a number in hexadecimal, with `A` through `F`"},{"DocComment":" in upper case."},{"DocComment":""},{"DocComment":" For primitive signed integers (`i8` to `i128`, and `isize`),"},{"DocComment":" negative values are formatted as the two’s complement representation."},{"DocComment":""},{"DocComment":" The alternate flag, `#`, adds a `0x` in front of the output."},{"DocComment":""},{"DocComment":" For more information on formatters, see [the module-level documentation][module]."},{"DocComment":""},{"DocComment":" [module]: ../../std/fmt/index.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage with `i32`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let y = 42; // 42 is '2A' in hex"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"{y:X}\"), \"2A\");"},{"DocComment":" assert_eq!(format!(\"{y:#X}\"), \"0x2A\");"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"{:X}\", -16), \"FFFFFFF0\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Implementing `UpperHex` on a type:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Length(i32);"},{"DocComment":""},{"DocComment":" impl fmt::UpperHex for Length {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         let val = self.0;"},{"DocComment":""},{"DocComment":"         fmt::UpperHex::fmt(&val, f) // delegate to i32's implementation"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let l = Length(i32::MAX);"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"l as hex is: {l:X}\"), \"l as hex is: 7FFFFFFF\");"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"l as hex is: {l:#010X}\"), \"l as hex is: 0x7FFFFFFF\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"fmt","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["UpperHex",0]},{"Ident":["fmt",0]}],"span":{"data":{"file_id":81,"beg":{"line":1435,"col":4},"end":{"line":1435,"col":51}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":"Formats the value using the given formatter.\n\n# Errors\n\nThis function should return [`Err`] if, and only if, the provided [`Formatter`] returns [`Err`].\nString formatting is considered an infallible operation; this function only\nreturns a [`Result`] because writing to the underlying stream might fail and it must\nprovide a way to propagate the fact that an error has occurred back up the stack.\n"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49681},{"Deduplicated":15701}],"output":{"Deduplicated":15693}},"default":null},"kind":{"TraitMethod":[50,0]}}],"vtable":{"id":{"Adt":191},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":51,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["step_by",0]},{"Ident":["StepByImpl",0]}],"span":{"data":{"file_id":53,"beg":{"line":167,"col":0},"end":{"line":167,"col":26}},"generated_fr