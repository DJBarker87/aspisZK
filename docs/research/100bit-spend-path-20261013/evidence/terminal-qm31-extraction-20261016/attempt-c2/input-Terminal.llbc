e":2497,"col":5}},"generated_from_span":null},"id":10446,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":2497,"col":5},"end":{"line":2497,"col":5}},"generated_from_span":null},"id":10447,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":2497,"col":5},"end":{"line":2497,"col":5}},"generated_from_span":null},"id":10448,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":145,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["try_for_each",0]}],"span":{"data":{"file_id":33,"beg":{"line":2545,"col":4},"end":{"line":2549,"col":28}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator method that applies a fallible function to each item in the"},{"DocComment":" iterator, stopping at the first error and returning that error."},{"DocComment":""},{"DocComment":" This can also be thought of as the fallible form of [`for_each()`]"},{"DocComment":" or as the stateless version of [`try_fold()`]."},{"DocComment":""},{"DocComment":" [`for_each()`]: Iterator::for_each"},{"DocComment":" [`try_fold()`]: Iterator::try_fold"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fs::rename;"},{"DocComment":" use std::io::{stdout, Write};"},{"DocComment":" use std::path::Path;"},{"DocComment":""},{"DocComment":" let data = [\"no_tea.txt\", \"stale_bread.json\", \"torrential_rain.png\"];"},{"DocComment":""},{"DocComment":" let res = data.iter().try_for_each(|x| writeln!(stdout(), \"{x}\"));"},{"DocComment":" assert!(res.is_ok());"},{"DocComment":""},{"DocComment":" let mut it = data.iter().cloned();"},{"DocComment":" let res = it.try_for_each(|x| rename(x, Path::new(x).with_extension(\"old\")));"},{"DocComment":" assert!(res.is_err());"},{"DocComment":" // It short-circuited, so the remaining items are still in the iterator:"},{"DocComment":" assert_eq!(it.next(), Some(\"stale_bread.json\"));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The [`ControlFlow`] type can be used with this method for the situations"},{"DocComment":" in which you'd use `break` and `continue` in a normal loop:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let r = (2..100).try_for_each(|x| {"},{"DocComment":"     if 323 % x == 0 {"},{"DocComment":"         return ControlFlow::Break(x)"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     ControlFlow::Continue(())"},{"DocComment":" });"},{"DocComment":" assert_eq!(r, ControlFlow::Break(17));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"F"},{"index":2,"name":"R"},{"index":3,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49629}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":33,"beg":{"line":2548,"col":11},"end":{"line":2548,"col":33}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":49598},{"Deduplicated":50275},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":33,"beg":{"line":2549,"col":11},"end":{"line":2549,"col":27}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":49600