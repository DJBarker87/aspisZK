},{"DocComment":" let a = [vec![0_u8, 1, 2], vec![3, 4], vec![23]];"},{"DocComment":" // don't do this:"},{"DocComment":" let slower: Vec<_> = a.iter().cloned().filter(|s| s.len() == 1).collect();"},{"DocComment":" assert_eq!(&[vec![23]], &slower[..]);"},{"DocComment":" // instead call `cloned` late"},{"DocComment":" let faster: Vec<_> = a.iter().filter(|s| s.len() == 1).cloned().collect();"},{"DocComment":" assert_eq!(&[vec![23]], &faster[..]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"iter_cloned"},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"T"},{"index":2,"name":"Clause2_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":3561,"col":11},"end":{"line":3561,"col":16}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":16,"generics":{"regions":[],"types":[{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":33,"beg":{"line":3562,"col":22},"end":{"line":3562,"col":44}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":49598},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597}],"output":{"HashConsedValue":[50714,{"Adt":{"id":{"Adt":81},"generics":{"regions":[],"types":[{"Deduplicated":49597}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitDecl":{"trait_ref":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":51168}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":57}}},"is