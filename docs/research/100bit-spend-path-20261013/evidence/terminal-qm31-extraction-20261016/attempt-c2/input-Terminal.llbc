 Right,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" enum Weight {"},{"DocComment":"     Kilogram(f32),"},{"DocComment":"     Pound(f32),"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" struct Balance {"},{"DocComment":"     pub left: Weight,"},{"DocComment":"     pub right: Weight,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Index<Side> for Balance {"},{"DocComment":"     type Output = Weight;"},{"DocComment":""},{"DocComment":"     fn index(&self, index: Side) -> &Self::Output {"},{"DocComment":"         println!(\"Accessing {index:?}-side of balance immutably\");"},{"DocComment":"         match index {"},{"DocComment":"             Side::Left => &self.left,"},{"DocComment":"             Side::Right => &self.right,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl IndexMut<Side> for Balance {"},{"DocComment":"     fn index_mut(&mut self, index: Side) -> &mut Self::Output {"},{"DocComment":"         println!(\"Accessing {index:?}-side of balance mutably\");"},{"DocComment":"         match index {"},{"DocComment":"             Side::Left => &mut self.left,"},{"DocComment":"             Side::Right => &mut self.right,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut balance = Balance {"},{"DocComment":"     right: Weight::Kilogram(2.5),"},{"DocComment":"     left: Weight::Pound(1.5),"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" // In this case, `balance[Side::Right]` is sugar for"},{"DocComment":" // `*balance.index(Side::Right)`, since we are only *reading*"},{"DocComment":" // `balance[Side::Right]`, not writing it."},{"DocComment":" assert_eq!(balance[Side::Right], Weight::Kilogram(2.5));"},{"DocComment":""},{"DocComment":" // However, in this case `balance[Side::Left]` is sugar for"},{"DocComment":" // `*balance.index_mut(Side::Left)`, since we are writing"},{"DocComment":" // `balance[Side::Left]`."},{"DocComment":" balance[Side::Left] = Weight::Kilogram(3.0);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"index_mut"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Idx"},{"index":2,"name":"Self_Clause0_Output"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"data":{"file_id":87,"beg":{"line":170,"col":39},"end":{"line":170,"col":57}},"generated_from_span":null},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":29,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"index_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["index",0]},{"Ident":["IndexMut",0]},{"Ident":["index_mut",0]}],"span":{"data":{"file_id":87,"beg":{"line":179,"col":4},"end":{"line":179,"col":61}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the mutable indexing (`container[index]`) operation."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" May panic if the index is out of bounds."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":50677},{"Deduplicated":49598}],"output":{"Deduplicated":50730}},"default":null},"kind":{"TraitMethod":[36,0]}}],"vtable":{"id":{"Adt":175},"generics":{"regions":[],"types":[{"Deduplicated":49598