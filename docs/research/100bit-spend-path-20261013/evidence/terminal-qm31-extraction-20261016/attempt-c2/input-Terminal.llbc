straints":[{"regions":[],"skip_binder":{"trait_ref":{"Deduplicated":16651},"type_id":0,"ty":{"Deduplicated":2723}}}]},"skip_binder":{"name":"spec_try_fold","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["step_by",0]},{"Ident":["StepByImpl",0]},{"Ident":["spec_try_fold",0]}],"span":{"data":{"file_id":53,"beg":{"line":176,"col":4},"end":{"line":179,"col":29}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":50677},{"Deduplicated":2162},{"Deduplicated":2165}],"output":{"Deduplicated":2783}},"default":null},"kind":{"TraitMethod":[51,3]}},{"params":{"regions":[],"types":[{"index":0,"name":"Acc"},{"index":1,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":53,"beg":{"line":183,"col":11},"end":{"line":183,"col":40}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2724},{"Deduplicated":50747},{"Deduplicated":2723}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"spec_fold","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["step_by",0]},{"Ident":["StepByImpl",0]},{"Ident":["spec_fold",0]}],"span":{"data":{"file_id":53,"beg":{"line":181,"col":4},"end":{"line":183,"col":41}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597},{"Deduplicated":2162},{"Deduplicated":2165}],"output":{"Deduplicated":2162}},"default":null},"kind":{"TraitMethod":[51,4]}}],"vtable":null},{"def_id":52,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hash",0]},{"Ident":["Hash",0]}],"span":{"data":{"file_id":114,"beg":{"line":185,"col":0},"end":{"line":185,"col":36}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A hashable type."},{"DocComment":""},{"DocComment":" Types implementing `Hash` are able to be [`hash`]ed with an instance of"},{"DocComment":" [`Hasher`]."},{"DocComment":""},{"DocComment":" ## Implementing `Hash`"},{"DocComment":""},{"DocComment":" You can derive `Hash` with `#[derive(Hash)]` if all fields implement `Hash`."},{"DocComment":" The resulting hash will be the combination of the values from calling"},{"DocComment":" [`hash`] on each field."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Hash)]"},{"DocComment":" struct Rustacean {"},{"DocComment":"     name: String,"},{"DocComment":"     country: String,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you need more control over how a value is hashed, you can of course"},{"DocComment":" implement the `Hash` trait yourself:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::hash::{Hash, Hasher};"},{"DocComment":""},{"DocComment":" struct Person {"},{"DocComment":"     id: u32,"},{"DocComment":"     name: String,"},{"DocComment":"     phone: u64,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Hash for Person {"},{"DocComment":"     fn hash<H: Hasher>(&self, state: &mut H) {"},{"DocComment":"         self.id.hash(state);"},{"DocComment":"         self.phone.hash(state);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## `Hash` and `Eq`"},{"DocComment":""},{"DocComment":" When implementing both `Hash` and [`Eq`], it is important that the following"},{"DocComment":" property holds:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" k1 == k2 -> hash(k1) == hash(k2)"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In other words, if two keys are equal, their hashes must also be equal."},{"DocComment":" [`HashMap`] and [`HashSet`] both rely on this behavior."},{"DocComment":""},{"DocComment":" Thankfully, you won't need to worry about upholding this property when"},{"DocComment":" deriving both [`Eq`] and `Hash` with `#[derive(PartialEq, Eq, Hash)]`."},{"DocComment":""},{"DocComment":" Violating this property is a logic error. The behavior resulting from a logic error is not"},{"DocComment":" specified, but users of the trait must ensure that such logic errors do *not* result in"},{"DocComment":" undefined behavior. This means that `unsafe` code **must not** rely on the correctness of these"},{"DocComment":" methods."},{"DocComment":""},{"DocComment":" ## Prefix collisions"},{"DocComment":""},{"DocComment":" Implementations of `hash` should ensure that the data they"},{"DocComment":" pass to the `Hasher` are prefix-free. That is,"},{"DocComment":" values which are not equal should cause two different sequences of values to be written,"},{"DocComment":" and neither of the two sequences should be a prefix of the other."},{"DocComment":""},{"DocComment":" For example, the standard implementation of [`Hash` for `&str`][impl] passes an extra"},{"DocComment":" `0xFF` byte to the `Hasher` so that the values `(\"ab\", \"c\")` and `(\"a\","},{"DocComment":" \"bc\")` hash differently."},{"DocComment":""},{"DocComment":" ## Portability"},{"DocComment":""},{"DocComment":" Due to differences in endianness and type sizes, data fed by `Hash` to a `Hasher`"},{"DocComment":" should not be considered portable across platforms. Additionally the data passed by most"},{"DocComment":" standard library types should not be considered stable between compiler versions."},{"DocComment":""},{"DocComment":" This means tests shouldn't probe hard-coded hash values or data fed to a `Hasher` and"},{"DocComment":" instead should check consistency with `Eq`."},{"DocComment":""},{"DocComment":" Serialization formats intended to be portable between platforms or compiler versions should"},{"DocComment":" either avoid encoding hashes or only rely on `Hash` and `Hasher` implementations that"},{"DocComment":" provide additional guarantees."},{"DocComment":""},{"DocComment":" [`HashMap`]: ../../std/collections/struct.HashMap.html"},{"DocComment":" [`HashSet`]: ../../std/collections/struct.HashSet.html"},{"DocComment":" [`hash`]: Hash::hash"},{"DocComment":" [impl]: ../../std/primitive.str.html#impl-Hash-for-str"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"Hash"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"H"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":114,"beg":{"line":198,"col":15},"end":{"line":198,"col":21}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":58,"generics":{"regions":[],"types":[{"Deduplicated":2723}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"hash","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hash",0]},{"Ident":["Hash",0]},{"Ident":["hash",0]}],"span":{"data":{"file_id":114,"beg":{"line":198,"col":4},"end":{"line":198,"col":45}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Feeds this value into the given [`Hasher`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::hash::{DefaultHasher, Hash, Hasher};"},{"DocComment":""},{"DocComment":" let mut hasher = DefaultHasher::new();"},{"DocComment":" 7920.hash(&mut hasher);"},{"DocComment":" println!(\"Hash is {:x}!\", hasher.finish());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49681},{"HashConsedValue":[14887,{"Ref":[{"Var":{"Bound":[0,1]}},{"Deduplicated":2162},"Mut"]}]}],"output":{"Deduplicated":1764}},"default":null},"kind":{"TraitMethod":[52,0]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"H"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":114,"beg":{"line":234,"col":21},"end":{"line":234,"col":27}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":58,"generics":{"regions":[],"types":[{"Deduplicated":2723}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"hash_slice","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hash",0]},{"Ident":["Hash",0]},{"Ident":["hash_slice",0]}],"span":{"data":{"file_id":114,"beg":{"line":234,"col":4},"end":{"line":236,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Feeds a slice of this type into the given [`Hasher`]."},{"DocComment":""},{"DocComment":" This method is meant as a convenience, but its implementation is"},{"DocComment":" also explicitly left unspecified. It isn't guaranteed to be"},{"DocComment":" equivalent to repeated calls of [`hash`] and implementations of"},{"DocComment":" [`Hash`] should keep that in mind and call [`hash`] themselves"},{"DocComment":" if the slice isn't treated as a whole unit in the [`PartialEq`]"},{"DocComment":" implementation."},{"DocComment":""},{"DocComment":" For example, a [`VecDeque`] implementation might naïvely call"},{"DocComment":" [`as_slices`] and then [`hash_slice`] on each slice, but this"},{"DocComment":" is wrong since the two slices can change with a call to"},{"DocComment":" [`make_contiguous`] without affecting the [`PartialEq`]"},{"DocComment":" result. Since these slices aren't treated as singular"},{"DocComment":" units, and instead part of a larger deque, this method cannot"},{"DocComment":" be used."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::hash::{DefaultHasher, Hash, Hasher};"},{"DocComment":""},{"DocComment":" let mut hasher = DefaultHasher::new();"},{"DocComment":" let numbers = [6, 28, 496, 8128];"},{"DocComment":" Hash::hash_slice(&numbers, &mut hasher);"},{"DocComment":" println!(\"Hash is {:x}!\", hasher.finish());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`VecDeque`]: ../../std/collections/struct.VecDeque.html"},{"DocComment":" [`as_slices`]: ../../std/collections/struct.VecDeque.html#method.as_slices"},{"DocComment":" [`make_contiguous`]: ../../std/collections/struct.VecDeque.html#method.make_contiguous"},{"DocComment":" [`hash`]: Hash::hash"},{"DocComment":" [`hash_slice`]: Hash::hash_slice"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[50748,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":49744},"Shared"]}]},{"Deduplicated":14887}],"output":{"Deduplicated":1764}},"default":{"id":847,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}}],"types":[{"Deduplicated":49597},{"Deduplicated":2162}],"const_generics":[],"trait_refs":[{"HashConsedValue":[50749,{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":52,"generics":{"regions":[],"types":[{"Deduplicated":49597}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[27375,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":58,"generics":{"regions":[],"types":[{"Deduplicated":2723}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[52,1]}}],"vtable":null},{"def_id":53,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Send",0]}],"span":{"data":{"file_id":12,"beg":{"line":92,"col":0},"end":{"line":92,"col":26}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types that can be transferred across thread boundaries."},{"DocComment":""},{"DocComment":" This trait is automatically implemented when the compiler determines it's"},{"DocComment":" appropriate."},{"DocComment":""},{"DocComment":" An example of a non-`Send` type is the reference-counting pointer"},{"DocComment":" [`rc::Rc`][`Rc`]. If two threads attempt to clone [`Rc`]s that point to the same"},{"DocComment":" reference-counted value, they might try to update the reference count at the"},{"DocComment":" same time, which is [undefined behavior][ub] because [`Rc`] doesn't use atomic"},{"DocComment":" operations. Its cousin [`sync::Arc`][arc] does use atomic operations (incurring"},{"DocComment":" some overhead) and thus is `Send`."},{"DocComment":""},{"DocComment":" See [the Nomicon](../../nomicon/send-and-sync.html) and the [`Sync`] trait for more details."},{"DocComment":""},{"DocComment":" [`Rc`]: ../../std/rc/struct.Rc.html"},{"DocComment":" [arc]: ../../std/sync/struct.Arc.html"},{"DocComment":" [ub]: ../../reference/behavior-considered-undefined.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"Send"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":{"Adt":198},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":54,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Sync",0]}],"span":{"data":{"file_id":12,"beg":{"line":657,"col":0},"end":{"line":657,"col":26}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types for which it is safe to share references between threads."},{"DocComment":""},{"DocComment":" This trait is automatically implemented when the compiler determines"},{"DocComment":" it's appropriate."},{"DocComment":""},{"DocComment":" The precise definition is: a type `T` is [`Sync`] if and only if `&T` is"},{"DocComment":" [`Send`]. In other words, if there is no possibility of"},{"DocComment":" [undefined behavior][ub] (including data races) when passing"},{"DocComment":" `&T` references between threads."},{"DocComment":""},{"DocComment":" As one would expect, primitive types like [`u8`] and [`f64`]"},{"DocComment":" are all [`Sync`], and so are simple aggregate types containing them,"},{"DocComment":" like tuples, structs and enums. More examples of basic [`Sync`]"},{"DocComment":" types include \"immutable\" types like `&T`, and those with simple"},{"DocComment":" inherited mutability, such as [`Box<T>`][box], [`Vec<T>`][vec] and"},{"DocComment":" most other collection types. (Generic parameters need to be [`Sync`]"},{"DocComment":" for their container to be [`Sync`].)"},{"DocComment":""},{"DocComment":" A somewhat surprising consequence of the definition is that `&mut T`"},{"DocComment":" is `Sync` (if `T` is `Sync`) even though it seems like that might"},{"DocComment":" provide unsynchronized mutation. The trick is that a mutable"},{"DocComment":" reference behind a shared reference (that is, `& &mut T`)"},{"DocComment":" becomes read-only, as if it were a `& &T`. Hence there is no risk"},{"DocComment":" of a data race."},{"DocComment":""},{"DocComment":" A shorter overview of how [`Sync`] and [`Send`] relate to referencing:"},{"DocComment":" * `&T` is [`Send`] if and only if `T` is [`Sync`]"},{"DocComment":" * `&mut T` is [`Send`] if and only if `T` is [`Send`]"},{"DocComment":" * `&T` and `&mut T` are [`Sync`] if and only if `T` is [`Sync`]"},{"DocComment":""},{"DocComment":" Types that are not `Sync` are those that have \"interior"},{"DocComment":" mutability\" in a non-thread-safe form, such as [`Cell`][cell]"},{"DocComment":" and [`RefCell`][refcell]. These types allow for mutation of"},{"DocComment":" their contents even through an immutable, shared reference. For"},{"DocComment":" example the `set` method on [`Cell<T>`][cell] takes `&self`, so it requires"},{"DocComment":" only a shared reference [`&Cell<T>`][cell]. The method performs no"},{"DocComment":" synchronization, thus [`Cell`][cell] cannot be `Sync`."},{"DocComment":""},{"DocComment":" Another example of a non-`Sync` type is the reference-counting"},{"DocComment":" pointer [`Rc`][rc]. Given any reference [`&Rc<T>`][rc], you can clone"},{"DocComment":" a new [`Rc<T>`][rc], modifying the reference counts in a non-atomic way."},{"DocComment":""},{"DocComment":" For cases when one does need thread-safe interior mutability,"},{"DocComment":" Rust provides [atomic data types], as well as explicit locking via"},{"DocComment":" [`sync::Mutex`][mutex] and [`sync::RwLock`][rwlock]. These types"},{"DocComment":" ensure that any mutation cannot cause data races, hence the types"},{"DocComment":" are `Sync`. Likewise, [`sync::Arc`][arc] provides a thread-safe"},{"DocComment":" analogue of [`Rc`][rc]."},{"DocComment":""},{"DocComment":" Any types with interior mutability must also use the"},{"DocComment":" [`cell::UnsafeCell`][unsafecell] wrapper around the value(s) which"},{"DocComment":" can be mutated through a shared reference. Failing to doing this is"},{"DocComment":" [undefined behavior][ub]. For example, [`transmute`][transmute]-ing"},{"DocComment":" from `&T` to `&mut T` is invalid."},{"DocComment":""},{"DocComment":" See [the Nomicon][nomicon-send-and-sync] for more details about `Sync`."},{"DocComment":""},{"DocComment":" [box]: ../../std/boxed/struct.Box.html"},{"DocComment":" [vec]: ../../std/vec/struct.Vec.html"},{"DocComment":" [cell]: crate::cell::Cell"},{"DocComment":" [refcell]: crate::cell::RefCell"},{"DocComment":" [rc]: ../../std/rc/struct.Rc.html"},{"DocComment":" [arc]: ../../std/sync/struct.Arc.html"},{"DocComment":" [atomic data types]: crate::sync::atomic"},{"DocComment":" [mutex]: ../../std/sync/struct.Mutex.html"},{"DocComment":" [rwlock]: ../../std/sync/struct.RwLock.html"},{"DocComment":" [unsafecell]: crate::cell::UnsafeCell"},{"DocComment":" [ub]: ../../reference/behavior-considered-undefined.html"},{"DocComment":" [transmute]: crate::mem::transmute"},{"DocComment":" [nomicon-send-and-sync]: ../../nomicon/send-and-sync.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"sync"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":{"Adt":199},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":55,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Unpin",0]}],"span":{"data":{"file_id":12,"beg":{"line":1014,"col":0},"end":{"line":1014,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types that do not require any pinning guarantees."},{"DocComment":""},{"DocComment":" For information on what \"pinning\" is, see the [`pin` module] documentation."},{"DocComment":""},{"DocComment":" Implementing the `Unpin` trait for `T` expresses the fact that `T` is pinning-agnostic:"},{"DocComment":" it shall not expose nor rely on any pinning guarantees. This, in turn, means that a"},{"DocComment":" `Pin`-wrapped pointer to such a type can feature a *fully unrestricted* API."},{"DocComment":" In other words, if `T: Unpin`, a value of type `T` will *not* be bound by the invariants"},{"DocComment":" which pinning otherwise offers, even when \"pinned\" by a [`Pin<Ptr>`] pointing at it."},{"DocComment":" When a value of type `T` is pointed at by a [`Pin<Ptr>`], [`Pin`] will not restrict access"},{"DocComment":" to the pointee value like it normally would, thus allowing the user to do anything that they"},{"DocComment":" normally could with a non-[`Pin`]-wrapped `Ptr` to that value."},{"DocComment":""},{"DocComment":" The idea of this trait is to alleviate the reduced ergonomics of APIs that require the use"},{"DocComment":" of [`Pin`] for soundness for some types, but which also want to be used by other types that"},{"DocComment":" don't care about pinning. The prime example of such an API is [`Future::poll`]. There are many"},{"DocComment":" [`Future`] types that don't care about pinning. These futures can implement `Unpin` and"},{"DocComment":" therefore get around the pinning related restrictions in the API, while still allowing the"},{"DocComment":" subset of [`Future`]s which *do* require pinning to be implemented soundly."},{"DocComment":""},{"DocComment":" For more discussion on the consequences of [`Unpin`] within the wider scope of the pinning"},{"DocComment":" system, see the [section about `Unpin`] in the [`pin` module]."},{"DocComment":""},{"DocComment":" `Unpin` has no consequence at all for non-pinned data. In particular, [`mem::replace`] happily"},{"DocComment":" moves `!Unpin` data, which would be immovable when pinned ([`mem::replace`] works for any"},{"DocComment":" `&mut T`, not just when `T: Unpin`)."},{"DocComment":""},{"DocComment":" *However*, you cannot use [`mem::replace`] on `!Unpin` data which is *pinned* by being wrapped"},{"DocComment":" inside a [`Pin<Ptr>`] pointing at it. This is because you cannot (safely) use a"},{"DocComment":" [`Pin<Ptr>`] to get a `&mut T` to its pointee value, which you would need to call"},{"DocComment":" [`mem::replace`], and *that* is what makes this system work."},{"DocComment":""},{"DocComment":" So this, for example, can only be done on types implementing `Unpin`:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" # #![allow(unused_must_use)]"},{"DocComment":" use std::mem;"},{"DocComment":" use std::pin::Pin;"},{"DocComment":""},{"DocComment":" let mut string = \"this\".to_string();"},{"DocComment":" let mut pinned_string = Pin::new(&mut string);"},{"DocComment":""},{"DocComment":" // We need a mutable reference to call `mem::replace`."},{"DocComment":" // We can obtain such a reference by (implicitly) invoking `Pin::deref_mut`,"},{"DocComment":" // but that is only possible because `String` implements `Unpin`."},{"DocComment":" mem::replace(&mut *pinned_string, \"other\".to_string());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This trait is automatically implemented for almost every type. The compiler is free"},{"DocComment":" to take the conservative stance of marking types as [`Unpin`] so long as all of the types that"},{"DocComment":" compose its fields are also [`Unpin`]. This is because if a type implements [`Unpin`], then it"},{"DocComment":" is unsound for that type's implementation to rely on pinning-related guarantees for soundness,"},{"DocComment":" *even* when viewed through a \"pinning\" pointer! It is the responsibility of the implementor of"},{"DocComment":" a type that relies upon pinning for soundness to ensure that type is *not* marked as [`Unpin`]"},{"DocComment":" by adding [`PhantomPinned`] field. For more details, see the [`pin` module] docs."},{"DocComment":""},{"DocComment":" [`mem::replace`]: crate::mem::replace \"mem replace\""},{"DocComment":" [`Future`]: crate::future::Future \"Future\""},{"DocComment":" [`Future::poll`]: crate::future::Future::poll \"Future poll\""},{"DocComment":" [`Pin`]: crate::pin::Pin \"Pin\""},{"DocComment":" [`Pin<Ptr>`]: crate::pin::Pin \"Pin\""},{"DocComment":" [`pin` module]: crate::pin \"pin module\""},{"DocComment":" [section about `Unpin`]: crate::pin#unpin \"pin module docs about unpin\""},{"DocComment":" [`unsafe`]: ../../std/keyword.unsafe.html \"keyword unsafe\""}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"unpin"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":{"Adt":200},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":56,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["zip",0]},{"Ident":["SpecFold",0]}],"span":{"data":{"file_id":55,"beg":{"line":627,"col":0},"end":{"line":627,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Self_Clause0_Item"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"data":{"file_id":55,"beg":{"line":627,"col":16},"end":{"line":627,"col":24}},"generated_from_span":null},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[],"types":[{"index":0,"name":"B"},{"index":1,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":55,"beg":{"line":631,"col":11},"end":{"line":631,"col":36}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2724},{"Deduplicated":49928},{"Deduplicated":2723}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"spec_fold","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["zip",0]},{"Ident":["SpecFold",0]},{"Ident":["spec_fold",0]}],"span":{"data":{"file_id":55,"beg":{"line":628,"col":4},"end":{"line":631,"col":37}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597},{"Deduplicated":2162},{"Deduplicated":2165}],"output":{"Deduplicated":2162}},"default":null},"kind":{"TraitMethod":[56,0]}}],"vtable":{"id":{"Adt":201},"generics":{"regions":[],"types":[{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}}},{"def_id":57,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["zip",0]},{"Ident":["SpecTrustedRandomAccess",0]}],"span":{"data":{"file_id":55,"beg":{"line":606,"col":0},"end":{"line":606,"col":46}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Self_Clause0_Item"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"data":{"file_id":55,"beg":{"line":606,"col":38},"end":{"line":606,"col":46}},"generated_from_span":null},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"try_get_unchecked","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["zip",0]},{"Ident":["SpecTrustedRandomAccess",0]},{"Ident":["try_get_unchecked",0]}],"span":{"data":{"file_id":55,"beg":{"line":609,"col":4},"end":{"line":609,"col":71}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":50677},{"Deduplicated":1522}],"output":{"Deduplicated":49598}},"default":null},"kind":{"TraitMethod":[57,0]}}],"vtable":{"id":{"Adt":203},"generics":{"regions":[],"types":[{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}}},{"def_id":58,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hash",0]},{"Ident":["Hasher",0]}],"span":{"data":{"file_id":114,"beg":{"line":312,"col":0},"end":{"line":312,"col":16}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A trait for hashing an arbitrary stream of bytes."},{"DocComment":""},{"DocComment":" Instances of `Hasher` usually represent state that is changed while hashing"},{"DocComment":" data."},{"DocComment":""},{"DocComment":" `Hasher` provides a fairly basic interface for retrieving the generated hash"},{"DocComment":" (with [`finish`]), and writing integers as well as slices of bytes into an"},{"DocComment":" instance (with [`write`] and [`write_u8`] etc.). Most of the time, `Hasher`"},{"DocComment":" instances are used in conjunction with the [`Hash`] trait."},{"DocComment":""},{"DocComment":" This trait provides no guarantees about how the various `write_*` methods are"},{"DocComment":" defined and implementations of [`Hash`] should not assume that they work one"},{"DocComment":" way or another. You cannot assume, for example, that a [`write_u32`] call is"},{"DocComment":" equivalent to four calls of [`write_u8`].  Nor can you assume that adjacent"},{"DocComment":" `write` calls are merged, so it's possible, for example, that"},{"DocComment":" ```"},{"DocComment":" # fn foo(hasher: &mut impl std::hash::Hasher) {"},{"DocComment":" hasher.write(&[1, 2]);"},{"DocComment":" hasher.write(&[3, 4, 5, 6]);"},{"DocComment":" # }"},{"DocComment":" ```"},{"DocComment":" and"},{"DocComment":" ```"},{"DocComment":" # fn foo(hasher: &mut impl std::hash::Hasher) {"},{"DocComment":" hasher.write(&[1, 2, 3, 4]);"},{"DocComment":" hasher.write(&[5, 6]);"},{"DocComment":" # }"},{"DocComment":" ```"},{"DocComment":" end up producing different hashes."},{"DocComment":""},{"DocComment":" Thus to produce the same hash value, [`Hash`] implementations must ensure"},{"DocComment":" for equivalent items that exactly the same sequence of calls is made -- the"},{"DocComment":" same methods with the same parameters in the same order."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::hash::{DefaultHasher, Hasher};"},{"DocComment":""},{"DocComment":" let mut hasher = DefaultHasher::new();"},{"DocComment":""},{"DocComment":" hasher.write_u32(1989);"},{"DocComment":" hasher.write_u8(11);"},{"DocComment":" hasher.write_u8(9);"},{"DocComment":" hasher.write(b\"Huh?\");"},{"DocComment":""},{"DocComment":" println!(\"Hash is {:x}!\", hasher.finish());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`finish`]: Hasher::finish"},{"DocComment":" [`write`]: Hasher::write"},{"DocComment":" [`write_u8`]: Hasher::write_u8"},{"DocComment":" [`write_u32`]: Hasher::write_u32"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"finish","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hash",0]},{"Ident":["Hasher",0]},{"Ident":["finish",0]}],"span":{"data":{"file_id":114,"beg":{"line":334,"col":4},"end":{"line":334,"col":28}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the hash value for the values written so far."},{"DocComment":""},{"DocComment":" Despite its name, the method does not reset the hasher’s internal"},{"DocComment":" state. Additional [`write`]s will continue from the current value."},{"DocComment":" If you need to start a fresh hash value, you will have to create"},{"DocComment":" a new hasher."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::hash::{DefaultHasher, Hasher};"},{"DocComment":""},{"DocComment":" let mut hasher = DefaultHasher::new();"},{"DocComment":" hasher.write(b\"Cool!\");"},{"DocComment":""},{"DocComment":" println!(\"Hash is {:x}!\", hasher.finish());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`write`]: Hasher::write"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49681}],"output":{"Deduplicated":2531}},"default":null},"kind":{"TraitMethod":[58,0]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"write","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hash",0]},{"Ident":["Hasher",0]},{"Ident":["write",0]}],"span":{"data":{"file_id":114,"beg":{"line":357,"col":4},"end":{"line":357,"col":38}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Writes some data into this `Hasher`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::hash::{DefaultHasher, Hasher};"},{"DocComment":""},{"DocComment":" let mut hasher = DefaultHasher::new();"},{"DocComment":" let data = [0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef];"},{"DocComment":""},{"DocComment":" hasher.write(&data);"},{"DocComment":""},{"DocComment":" println!(\"Hash is {:x}!\", hasher.finish());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Note to Implementers"},{"DocComment":""},{"DocComment":" You generally should not do length-prefixing as part of implementing"},{"DocComment":" this method.  It's up to the [`Hash`] implementation to call"},{"DocComment":" [`Hasher::write_length_prefix`] before sequences that need it."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":50677},{"HashConsedValue":[50750,{"Ref":[{"Var":{"Bound":[0,1]}},{"Deduplicated":9293},"Shared"]}]}],"output":{"Deduplicated":1764}},"default":null},"kind":{"TraitMethod":[58,1]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"write_u8","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hash",0]},{"Ident":["Hasher",0]},{"Ident":["write_u8",0]}],"span":{"data":{"file_id":114,"beg":{"line":362,"col":4},"end":{"line":362,"col":33}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Writes a single `u8` into this hasher."}],"inline"