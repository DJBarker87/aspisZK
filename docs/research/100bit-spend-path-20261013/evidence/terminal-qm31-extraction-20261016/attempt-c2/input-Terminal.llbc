l":5}},"generated_from_span":null},"id":9702,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1452,"col":5},"end":{"line":1452,"col":5}},"generated_from_span":null},"id":9703,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1452,"col":5},"end":{"line":1452,"col":5}},"generated_from_span":null},"id":9704,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":131,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["scan",0]}],"span":{"data":{"file_id":33,"beg":{"line":1494,"col":4},"end":{"line":1497,"col":51}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator adapter which, like [`fold`], holds internal state, but"},{"DocComment":" unlike [`fold`], produces a new iterator."},{"DocComment":""},{"DocComment":" [`fold`]: Iterator::fold"},{"DocComment":""},{"DocComment":" `scan()` takes two arguments: an initial value which seeds the internal"},{"DocComment":" state, and a closure with two arguments, the first being a mutable"},{"DocComment":" reference to the internal state and the second an iterator element."},{"DocComment":" The closure can assign to the internal state to share state between"},{"DocComment":" iterations."},{"DocComment":""},{"DocComment":" On iteration, the closure will be applied to each element of the"},{"DocComment":" iterator and the return value from the closure, an [`Option`], is"},{"DocComment":" returned by the `next` method. Thus the closure can return"},{"DocComment":" `Some(value)` to yield `value`, or `None` to end the iteration."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3, 4];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().scan(1, |state, x| {"},{"DocComment":"     // each iteration, we'll multiply the state by the element ..."},{"DocComment":"     *state = *state * x;"},{"DocComment":""},{"DocComment":"     // ... and terminate if the state exceeds 6"},{"DocComment":"     if *state > 6 {"},{"DocComment":"         return None;"},{"DocComment":"     }"},{"DocComment":"     // ... else yield the negation of the state"},{"DocComment":"     Some(-*state)"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(-1));"},{"DocComment":" assert_eq!(iter.next(), Some(-2));"},{"DocComment":" assert_eq!(iter.next(), Some(-6));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"St"},{"index":2,"name":"B"},{"index":3,"name":"F"},{"index":4,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":1497,"col":11},"end":{"line":1497,"col":50}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":49629},{"HashConsedValue":[50980,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"HashConsedValue":[50729,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":49598},"Mut"]}]},{"Deduplicated":49627}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":49624}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597},{"Deduplicated":49598},{"Deduplicated":49629}],"output":{"HashConsedValue":[50981,{"Adt":{"id":{"Adt":73},"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598},{"Deduplicated":49629}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitDecl":{"trait_ref":{"id":7,"gen