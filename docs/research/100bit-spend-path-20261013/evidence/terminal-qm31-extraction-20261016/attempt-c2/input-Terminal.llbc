ws, so if there are more"},{"DocComment":" than [`usize::MAX`] non-matching elements, it either produces the wrong"},{"DocComment":" result or panics. If overflow checks are enabled, a panic is"},{"DocComment":" guaranteed."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" This function might panic if the iterator has more than `usize::MAX`"},{"DocComment":" non-matching elements."},{"DocComment":""},{"DocComment":" [`Some(index)`]: Some"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert_eq!(a.into_iter().position(|x| x == 2), Some(1));"},{"DocComment":""},{"DocComment":" assert_eq!(a.into_iter().position(|x| x == 5), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `true`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3, 4];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.position(|x| x >= 2), Some(1));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":""},{"DocComment":" // The returned index depends on iterator state"},{"DocComment":" assert_eq!(iter.position(|x| x == 4), Some(0));"},{"DocComment":""},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":50677},{"Deduplicated":2162}],"output":{"Deduplicated":5624}},"default":{"id":154,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":49597},{"Deduplicated":2162},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[{"Deduplicated":50688},{"Deduplicated":49927}]}}},"kind":{"TraitMethod":[7,46]}}