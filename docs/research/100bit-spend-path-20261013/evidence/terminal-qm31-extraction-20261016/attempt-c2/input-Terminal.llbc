duplicated":3160}},"default":{"id":143,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":2162},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[{"Deduplicated":50688},{"HashConsedValue":[49927,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2723},{"Deduplicated":49601},{"Deduplicated":3160}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[7,35]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"B"},{"index":1,"name":"F"},{"index":2,"name":"R"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":2489,"col":11},"end":{"line":2489,"col":44}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2724},{"HashConsedValue":[49928,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":2723},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":2777}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":33,"beg":{"line":2489,"col":47},"end":{"line":2489,"col":63}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2724}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":33,"beg":{"line":2490,"col":11},"end":{"line":2490,"col":34}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":2777}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[{"regions":[],"skip_binder":{"trait_ref":{"HashConsedValue":[7670,{"kind":{"Clause":{"Bound":[1,2]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"HashConsedValue":[2779,{"TypeVar":{"Bound":[2,2]}}]}],"const_generics":[],"trait_refs":[]}}}}]},"type_id":0,"ty":{"Deduplicated":2723}}}]},"skip_binder":{"name":"try_fold","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["try_fold",0]}],"span":{"data":{"file_id":33,"beg":{"line":2486,"col":4},"end":{"line":2490,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator method that applies a function as long as it returns"},{"DocComment":" successfully, producing a single, final value."},{"DocComment":""},{"DocComment":" `try_fold()` takes two arguments: an initial value, and a closure with"},{"DocComment":" two arguments: an 'accumulator', and an element. The closure either"},{"DocComment":" returns successfully, with the value that the accumulator should have"},{"DocComment":" for the next iteration, or it returns failure, with an error value that"},{"DocComment":" is propagated back to the caller immediately (short-circuiting)."},{"DocComment":""},{"DocComment":" The initial value is the value the accumulator will have on the first"},{"DocComment":" call. If applying the closure succeeded against every element of the"},{"DocComment":" iterator, `try_fold()` returns the final accumulator as success."},{"DocComment":""},{"DocComment":" Folding is useful whenever you have a collection of something, and want"},{"DocComment":" to produce a single value from it."},{"DocComment":""},{"DocComment":" # Note to Implementors"},{"DocComment":""},{"DocComment":" Several of the other (forward) methods have default implementations in"},{"DocComment":" terms of this one, so try to implement this explicitly if it can"},{"DocComment":" do something better than the default `for` loop implementation."},{"DocComment":""},{"DocComment":" In particular, try to have this call `try_fold()` on the internal parts"},{"DocComment":" from which this iterator is composed. If multiple calls are needed,"},{"DocComment":" the `?` operator may be convenient for chaining the accumulator value"},{"DocComment":" along, but beware any invariants that need to be upheld before those"},{"DocComment":" early returns. This is a `&mut self` method, so iteration needs to be"},{"DocComment":" resumable after hitting an error here."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" // the checked sum of all of the elements of the array"},{"DocComment":" let sum = a.into_iter().try_fold(0i8, |acc, x| acc.checked_add(x));"},{"DocComment":""},{"DocComment":" assert_eq!(sum, Some(6));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Short-circuiting:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [10, 20, 30, 100, 40, 50];"},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" // This sum overflows when adding the 100 element"},{"DocComment":" let sum = iter.try_fold(0i8, |acc, x| acc.checked_add(x));"},{"DocComment":" assert_eq!(sum, None);"},{"DocComment":""},{"DocComment":" // Because it short-circuited, the remaining elements are still"},{"DocComment":" // available through the iterator."},{"DocComment":" assert_eq!(iter.len(), 2);"},{"DocComment":" assert_eq!(iter.next(), Some(40));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" While you cannot `break` from a closure, the [`ControlFlow`] type allows"},{"DocComment":" a similar idea:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let triangular = (1..30).try_fold(0_i8, |prev, x| {"},{"DocComment":"     if let Some(next) = prev.checked_add(x) {"},{"DocComment":"         ControlFlow::Continue(next)"},{"DocComment":"     } else {"},{"DocComment":"         ControlFlow::Break(prev)"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(triangular, ControlFlow::Break(120));"},{"DocComment":""},{"DocComment":" let triangular = (1..30).try_fold(0_u64, |prev, x| {"},{"DocComment":"     if let Some(next) = prev.checked_add(x) {"},{"DocComment":"         ControlFlow::Continue(next)"},{"DocComment":"     } else {"},{"DocComment":"         ControlFlow::Break(prev)"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(triangular, ControlFlow::Continue(435));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":50677},{"Deduplicated":2162},{"Deduplicated":2165}],"output":{"Deduplicated":2783}},"default":{"id":144,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":49597},{"Deduplicated":2162},{"Deduplicated":2165},{"Deduplicated":2783},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[{"Deduplicated":50688},{"HashConsedValue":[49929,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2724},{"Deduplicated":49928},{"Deduplicated":2777}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[5590,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2724}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[7672,{"kind":{"Clause":{"Bound":[0,2]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":2777}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[7,36]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"F"},{"index":1,"name":"R"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":2548,"col":11},"end":{"line":2548,"col":33}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2723},{"Deduplicated":49601},{"Deduplicated":2724}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":33,"beg":{"line":2549,"col":11},"end":{"line":2549,"col":27}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":2724}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[{"regions":[],"skip_binder":{"trait_ref":{"HashConsedValue":[7694,{"kind":{"Clause":{"Bound":[1,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"HashConsedValue":[2725,{"TypeVar":{"Bound":[2,1]}}]}],"const_generics":[],"trait_refs":[]}}}}]},"type_id":0,"ty":{"Deduplicated":1764}}}]},"skip_binder":{"name":"try_for_each","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["try_for_each",0]}],"span":{"data":{"file_id":33,"beg":{"line":2545,"col":4},"end":{"line":2549,"col":28}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator method that applies a fallible function to each item in the"},{"DocComment":" iterator, stopping at the first error and returning that error."},{"DocComment":""},{"DocComment":" This can also be thought of as the fallible form of [`for_each()`]"},{"DocComment":" or as the stateless version of [`try_fold()`]."},{"DocComment":""},{"DocComment":" [`for_each()`]: Iterator::for_each"},{"DocComment":" [`try_fold()`]: Iterator::try_fold"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fs::rename;"},{"DocComment":" use std::io::{stdout, Write};"},{"DocComment":" use std::path::Path;"},{"DocComment":""},{"DocComment":" let data = [\"no_tea.txt\", \"stale_bread.json\", \"torrential_rain.png\"];"},{"DocComment":""},{"DocComment":" let res = data.iter().try_for_each(|x| writeln!(stdout(), \"{x}\"));"},{"DocComment":" assert!(res.is_ok());"},{"DocComment":""},{"DocComment":" let mut it = data.iter().cloned();"},{"DocComment":" let res = it.try_for_each(|x| rename(x, Path::new(x).with_extension(\"old\")));"},{"DocComment":" assert!(res.is_err());"},{"DocComment":" // It short-circuited, so the remaining items are still in the iterator:"},{"DocComment":" assert_eq!(it.next(), Some(\"stale_bread.json\"));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The [`ControlFlow`] type can be used with this method for the situations"},{"DocComment":" in which you'd use `break` and `continue` in a normal loop:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let r = (2..100).try_for_each(|x| {"},{"DocComment":"     if 323 % x == 0 {"},{"DocComment":"         return ControlFlow::Break(x)"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     ControlFlow::Continue(())"},{"DocComment":" });"},{"DocComment":" assert_eq!(r, ControlFlow::Break(17));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":50677},{"Deduplicated":2162}],"output":{"Deduplicated":2165}},"default":{"id":145,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":49597},{"Deduplicated":2162},{"Deduplicated":2165},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[{"Deduplicated":50688},{"HashConsedValue":[49930,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2723},{"Deduplicated":49601},{"Deduplicated":2724}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[7695,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":2724}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[7,37]}},{"params":{"regions":[],"types":[{"index":0,"name":"B"},{"index":1,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":2666,"col":22},"end":{"line":2666,"col":38}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":49597}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":33,"beg":{"line":2667,"col":11},"end":{"line":2667,"col":44}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2724},{"Deduplicated":49928},{"Deduplicated":2723}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":33,"beg":{"line":2667,"col":47},"end":{"line":2667,"col":63}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2724}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"fold","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["fold",0]}],"span":{"data":{"file_id":33,"beg":{"line":2664,"col":4},"end":{"line":2667,"col":64}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Folds every element into an accumulator by applying an operation,"},{"DocComment":" returning the final result."},{"DocComment":""},{"DocComment":" `fold()` takes two arguments: an initial value, and a closure with two"},{"DocComment":" arguments: an 'accumulator', and an element. The closure returns the value that"},{"DocComment":" the accumulator should have for the next iteration."},{"DocComment":""},{"DocComment":" The initial value is the value the accumulator will have on the first"},{"DocComment":" call."},{"DocComment":""},{"DocComment":" After applying this closure to every element of the iterator, `fold()`"},{"DocComment":" returns the accumulator."},{"DocComment":""},{"DocComment":" This operation is sometimes called 'reduce' or 'inject'."},{"DocComment":""},{"DocComment":" Folding is useful whenever you have a collection of something, and want"},{"DocComment":" to produce a single value from it."},{"DocComment":""},{"DocComment":" Note: `fold()`, and similar methods that traverse the entire iterator,"},{"DocComment":" might not terminate for infinite iterators, even on traits for which a"},{"DocComment":" result is determinable in finite time."},{"DocComment":""},{"DocComment":" Note: [`reduce()`] can be used to use the first element as the initial"},{"DocComment":" value, if the accumulator type and item type is the same."},{"DocComment":""},{"DocComment":" Note: `fold()` combines elements in a *left-associative* fashion. For associative"},{"DocComment":" operators like `+`, the order the elements are combined in is not important, but for non-associative"},{"DocComment":" operators like `-` the order will affect the final result."},{"DocComment":" For a *right-associative* version of `fold()`, see [`DoubleEndedIterator::rfold()`]."},{"DocComment":""},{"DocComment":" # Note to Implementors"},{"DocComment":""},{"DocComment":" Several of the other (forward) methods have default implementations in"},{"DocComment":" terms of this one, so try to implement this explicitly if it can"},{"DocComment":" do something better than the default `for` loop implementation."},{"DocComment":""},{"DocComment":" In particular, try to have this call `fold()` on the internal parts"},{"DocComment":" from which this iterator is composed."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" // the sum of all of the elements of the array"},{"DocComment":" let sum = a.iter().fold(0, |acc, x| acc + x);"},{"DocComment":""},{"DocComment":" assert_eq!(sum, 6);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Let's walk through each step of the iteration here:"},{"DocComment":""},{"DocComment":" | element | acc | x | result |"},{"DocComment":" |---------|-----|---|--------|"},{"DocComment":" |         | 0   |   |        |"},{"DocComment":" | 1       | 0   | 1 | 1      |"},{"DocComment":" | 2       | 1   | 2 | 3      |"},{"DocComment":" | 3       | 3   | 3 | 6      |"},{"DocComment":""},{"DocComment":" And so, our final result, `6`."},{"DocComment":""},{"DocComment":" This example demonstrates the left-associative nature of `fold()`:"},{"DocComment":" it builds a string, starting with an initial value"},{"DocComment":" and continuing with each element from the front until the back:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let numbers = [1, 2, 3, 4, 5];"},{"DocComment":""},{"DocComment":" let zero = \"0\".to_string();"},{"DocComment":""},{"DocComment":" let result = numbers.iter().fold(zero, |acc, &x| {"},{"DocComment":"     format!(\"({acc} + {x})\")"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" assert_eq!(result, \"(((((0 + 1) + 2) + 3) + 4) + 5)\");"},{"DocComment":" ```"},{"DocComment":" It's common for people who haven't used iterators a lot to"},{"DocComment":" use a `for` loop with a list of things to build up a result. Those"},{"DocComment":" can be turned into `fold()`s:"},{"DocComment":""},{"DocComment":" [`for`]: ../../book/ch03-05-control-flow.html#looping-through-a-collection-with-for"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let numbers = [1, 2, 3, 4, 5];"},{"DocComment":""},{"DocComment":" let mut result = 0;"},{"DocComment":""},{"DocComment":" // for loop:"},{"DocComment":" for i in &numbers {"},{"DocComment":"     result = result + i;"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // fold:"},{"DocComment":" let result2 = numbers.iter().fold(0, |acc, &x| acc + x);"},{"DocComment":""},{"DocComment":" // they're the same"},{"DocComment":" assert_eq!(result, result2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`reduce()`]: Iterator::reduce"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597},{"Deduplicated":2162},{"Deduplicated":2165}],"output":{"Deduplicated":2162}},"default":{"id":146,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":2162},{"Deduplicated":2165},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[{"Deduplicated":50688},{"Deduplicated":50689},{"HashConsedValue":[49931,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2724},{"Deduplicated":49928},{"Deduplicated":2723}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[2776,{"kind":{"Clause":{"Bound":[0,2]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2724}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[7,38]}},{"params":{"regions":[],"types":[{"index":0,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":2703,"col":22},"end":{"line":2703,"col":38}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":49597}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":33,"beg":{"line":2704,"col":11},"end":{"line":2704,"col":62}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2723},{"Deduplicated":49932},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":33,"beg":{"line":2704,"col":65},"end":{"line":2704,"col":81}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2723}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"reduce","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["reduce",0]}],"span":{"data":{"file_id":33,"beg":{"line":2701,"col":4},"end":{"line":2704,"col":82}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Reduces the elements to a single one, by repeatedly applying a reducing"},{"DocComment":" operation."},{"DocComment":""},{"DocComment":" If the iterator is empty, returns [`None`]; otherwise, returns the"},{"DocComment":" result of the reduction."},{"DocComment":""},{"DocComment":" The reducing function is a closure with two arguments: an 'accumulator', and an element."},{"DocComment":" For iterators with at least one element, this is the same as [`fold()`]"},{"DocComment":" with the first element of the iterator as the initial accumulator value, folding"},{"DocComment":" every subsequent element into it."},{"DocComment":""},{"DocComment":" [`fold()`]: Iterator::fold"},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let reduced: i32 = (1..10).reduce(|acc, e| acc + e).unwrap_or(0);"},{"DocComment":" assert_eq!(reduced, 45);"},{"DocComment":""},{"DocComment":" // Which is equivalent to doing it with `fold`:"},{"DocComment":" let folded: i32 = (1..10).fold(0, |acc, e| acc + e);"},{"DocComment":" assert_eq!(reduced, folded);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597},{"Deduplicated":2162}],"output":{"Deduplicated":49623}},"default":{"id":147,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":2162},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[{"Deduplicated":50688},{"Deduplicated":50689},{"HashConsedValue":[49933,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2723},{"Deduplicated":49932},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[7745,{"kind":{"Clause":{"Bound":[0,2]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2723}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[7,39]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"R"},{"index":1,"name":"T2"},{"index":2,"name":"Clause1_TryType"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":2778,"col":11},"end":{"line":2778,"col":91}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":2723}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":33,"beg":{"line":2778,"col":54},"end":{"line":2778,"col":90}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"HashConsedValue":[3179,{"TraitType":[{"HashConsedValue":[3175,{"kind":{"Clause":{"Bound":[1,0]}},"trait_decl_ref":{"region