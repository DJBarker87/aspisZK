]},{"Ident":["write_length_prefix",0]}],"span":{"data":{"file_id":114,"beg":{"line":483,"col":4},"end":{"line":483,"col":49}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Writes a length prefix into this hasher, as part of being prefix-free."},{"DocComment":""},{"DocComment":" If you're implementing [`Hash`] for a custom collection, call this before"},{"DocComment":" writing its contents to this `Hasher`.  That way"},{"DocComment":" `(collection![1, 2, 3], collection![4, 5])` and"},{"DocComment":" `(collection![1, 2], collection![3, 4, 5])` will provide different"},{"DocComment":" sequences of values to the `Hasher`"},{"DocComment":""},{"DocComment":" The `impl<T> Hash for [T]` includes a call to this method, so if you're"},{"DocComment":" hashing a slice (or array or vector) via its `Hash::hash` method,"},{"DocComment":" you should **not** call this yourself."},{"DocComment":""},{"DocComment":" This method is only for providing domain separation.  If you want to"},{"DocComment":" hash a `usize` that represents part of the *data*, then it's important"},{"DocComment":" that you pass it to [`Hasher::write_usize`] instead of to this method."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(hasher_prefixfree_extras)]"},{"DocComment":" # // Stubs to make the `impl` below pass the compiler"},{"DocComment":" # #![allow(non_local_definitions)]"},{"DocComment":" # struct MyCollection<T>(Option<T>);"},{"DocComment":" # impl<T> MyCollection<T> {"},{"DocComment":" #     fn len(&self) -> usize { todo!() }"},{"DocComment":" # }"},{"DocComment":" # impl<'a, T> IntoIterator for &'a MyCollection<T> {"},{"DocComment":" #     type Item = T;"},{"DocComment":" #     type IntoIter = std::iter::Empty<T>;"},{"DocComment":" #     fn into_iter(self) -> Self::IntoIter { todo!() }"},{"DocComment":" # }"},{"DocComment":""},{"DocComment":" use std::hash::{Hash, Hasher};"},{"DocComment":" impl<T: Hash> Hash for MyCollection<T> {"},{"DocComment":"     fn hash<H: Hasher>(&self, state: &mut H) {"},{"DocComment":"         state.write_length_prefix(self.len());"},{"DocComment":"         for elt in self {"},{"DocComment":"             elt.hash(state);"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Note to Implementers"},{"DocComment":""},{"DocComment":" If you've decided that your `Hasher` is willing to be susceptible to"},{"DocComment":" Hash-DoS attacks, then you might consider skipping hashing some or all"},{"DocComment":" of the `len` provided in the name of increased performance."}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":50677},{"Deduplicated":1522}],"output":{"Deduplicated":1764}},"default":{"id":902,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":49597}],"const_generics":[],"trait_refs":[{"Deduplicated":50751}]}}},"kind":{"TraitMethod":[58,14]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"write_str","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hash",0]},{"Ident":["Hasher",0]},{"Ident":["write_str",0]}],"span":{"data":{"file_id":114,"beg":{"line":550,"col":4},"end":{"line":550,"col":36}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Writes a single `str` into this hasher."},{"DocComment":""},{"DocComment":" If you're implementing [`Hash`], you generally do not need to call this,"},{"DocComment":" as the `impl Hash for str` does, so you should prefer that instead."},{"DocComment":""},{"DocComment":" This includes the domain separator for prefix-freedom, so you should"},{"DocComment":" **not** call `Self::write_length_prefix` before calling this."},{"DocComment":""},{"DocComment":" # Note to Implementers"},{"DocComment":""},{"DocComment":" There are at least two reasonable default ways to implement this."},{"DocComment":" Which one will be the default is not yet decided, so for now"},{"DocComment":" you probably want to override it specifically."},{"DocComment":""},{"DocComment":" ## The general answer"},{"DocComment":""},{"DocComment":" It's always correct to implement this with a length prefix:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![feature(hasher_prefixfree_extras)]"},{"DocComment":" # struct Foo;"},{"DocComment":" # impl std::hash::Hasher for Foo {"},{"DocComment":" # fn finish(&self) -> u64 { unimplemented!() }"},{"DocComment":" # fn write(&mut self, _bytes: &[u8]) { unimplemented!() }"},{"DocComment":" fn write_str(&mut self, s: &str) {"},{"DocComment":"     self.write_length_prefix(s.len());"},{"DocComment":"     self.write(s.as_bytes());"},{"DocComment":" }"},{"DocComment":" # }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" And, if your `Hasher` works in `usize` chunks, this is likely a very"},{"DocComment":" efficient way to do it, as anything more complicated may well end up"},{"DocComment":" slower than just running the round with the length."},{"DocComment":""},{"DocComment":" ## If your `Hasher` works byte-wise"},{"DocComment":""},{"DocComment":" One nice thing about `str` being UTF-8 is that the `b'\\xFF'` byte"},{"DocComment":" never happens.  That means that you can append that to the byte stream"},{"DocComment":" being hashed and maintain prefix-freedom:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![feature(hasher_prefixfree_extras)]"},{"DocComment":" # struct Foo;"},{"DocComment":" # impl std::hash::Hasher for Foo {"},{"DocComment":" # fn finish(&self) -> u64 { unimplemented!() }"},{"DocComment":" # fn write(&mut self, 