"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::mpsc::channel;"},{"DocComment":""},{"DocComment":" let (tx, rx) = channel();"},{"DocComment":" (0..5).map(|x| x * 2 + 1)"},{"DocComment":"       .for_each(move |x| tx.send(x).unwrap());"},{"DocComment":""},{"DocComment":" let v: Vec<_> = rx.iter().collect();"},{"DocComment":" assert_eq!(v, vec![1, 3, 5, 7, 9]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" For such a small example, a `for` loop may be cleaner, but `for_each`"},{"DocComment":" might be preferable to keep a functional style with longer iterators:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" (0..5).flat_map(|x| (x * 100)..(x * 110))"},{"DocComment":"       .enumerate()"},{"DocComment":"       .filter(|&(i, x)| (i + x) % 3 == 0)"},{"DocComment":"       .for_each(|(i, x)| println!(\"{i}:{x}\"));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"F"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":33,"beg":{"line":880,"col":11},"end":{"line":880,"col":28}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":49598},{"HashConsedValue":[50968,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":1764}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"si