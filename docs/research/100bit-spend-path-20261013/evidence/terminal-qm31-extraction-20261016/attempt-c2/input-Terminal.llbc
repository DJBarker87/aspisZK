, 2, 2, 9].iter().is_sorted());"},{"DocComment":" assert!(![1, 3, 2, 4].iter().is_sorted());"},{"DocComment":" assert!([0].iter().is_sorted());"},{"DocComment":" assert!(std::iter::empty::<i32>().is_sorted());"},{"DocComment":" assert!(![0.0, 1.0, f32::NAN].iter().is_sorted());"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597}],"output":{"Deduplicated":3160}},"default":{"id":180,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[{"Deduplicated":50688},{"HashConsedValue":[49956,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":24,"generics":{"regions":[],"types":[{"Deduplicated":49598},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[7,73]}},{"params":{"regions":[],"types":[{"index":0,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":4081,"col":11},"end":{"line":4081,"col":50}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2723},{"Deduplicated":49941},{"Deduplicated":3160}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"is_sorted_by","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["is_sorted_by",0]}],"span":{"data":{"file_id":33,"beg":{"line":4078,"col":4},"end":{"line":4081,"col":51}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Checks if the elements of this iterator are sorted using the given comparator function."},{"DocComment":""},{"DocComment":" Instead of using `PartialOrd::partial_cmp`, this function uses the given `compare`"},{"DocComment":" function to determine whether two elements are to be considered in sorted order."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert!([1, 2, 2, 9].iter().is_sorted_by(|a, b| a <= b));"},{"DocComment":" assert!(![1, 2, 2, 9].iter().is_sorted_by(|a, b| a < b));"},{"DocComment":""},{"DocComment":" assert!([0].iter().is_sorted_by(|a, b| true));"},{"DocComment":" assert!([0].iter().is_sorted_by(|a, b| false));"},{"DocComment":""},{"DocComment":" assert!(std::iter::empty::<i32>().is_sorted_by(|a, b| false));"},{"DocComment":" assert!(std::iter::empty::<i32>().is_sorted_by(|a, b| true));"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597},{"Deduplicated":2162}],"output":{"Deduplicated":3160}},"default":{"id":181,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":2162},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[{"Deduplicated":50688},{"HashConsedValue":[49957,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2723},{"Deduplicated":49941},{"Deduplicated":3160}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[7,74]}},{"params":{"regions":[],"types":[{"index":0,"name":"F"},{"index":1,"name":"K"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":4126,"col":11},"end":{"line":4126,"col":33}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":