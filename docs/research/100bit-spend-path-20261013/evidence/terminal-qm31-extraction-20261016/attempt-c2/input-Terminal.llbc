licated":49597},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}},null,null]},[{"Copy":{"kind":{"Local":1},"ty":{"Deduplicated":49597}}},{"Const":{"kind":{"Literal":{"Bool":false}},"ty":{"Deduplicated":3160}}},{"Copy":{"kind":{"Local":2},"ty":{"Deduplicated":49598}}}]]}]},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1186,"col":5},"end":{"line":1186,"col":5}},"generated_from_span":null},"id":9682,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1186,"col":5},"end":{"line":1186,"col":5}},"generated_from_span":null},"id":9683,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1186,"col":5},"end":{"line":1186,"col":5}},"generated_from_span":null},"id":9684,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":127,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["take_while",0]}],"span":{"data":{"file_id":33,"beg":{"line":1258,"col":4},"end":{"line":1261,"col":38}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that yields elements based on a predicate."},{"DocComment":""},{"DocComment":" `take_while()` takes a closure as an argument. It will call this"},{"DocComment":" closure on each element of the iterator, and yield elements"},{"DocComment":" while it returns `true`."},{"DocComment":""},{"DocComment":" After `false` is returned, `take_while()`'s job is over, and the"},{"DocComment":" rest of the elements are ignored."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1i32, 0, 1];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().take_while(|x| x.is_negative());"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(-1));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because the closure passed to `take_while()` takes a reference, and many"},{"DocComment":" iterators iterate over references, this leads to a possibly confusing"},{"DocComment":" situation, where the type of the closure is a double reference:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s = &[-1, 0, 1];"},{"DocComment":""},{"DocComment":" let mut iter = s.iter().take_while(|x| **x < 0); // need two *s!"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(&-1));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping after an initial `false`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1, 0, 1, -2];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().take_while(|&x| x < 0);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(-1));"},{"DocComment":""},{"DocComment":" // We have more elements that are less than zero, but since we already"},{"DocComment":" // got a false, take_while() ignores the remaining elements."},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because `take_while()` needs to look at the value in order to see if it"},{"DocComment":" should be included or not, consuming iterators will see that it is"},{"DocComment":" removed:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3, 4];"},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" let result: Vec<i32> = iter.by_ref().take_while(|&n| n != 3).collect();"},{"DocComment":""},{"DocComment":" assert_eq!(result, [1, 2]);"},{"DocComment":""},{"DocComment":" let result: Vec<i32> = iter.collect();"},{"DocComment":""},{"DocComment":" assert_eq!(result, [4]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The `3` is no longer there, because it was consumed in order to see if"},{"DocComment":" the iteration should stop, but wasn't placed back into the iterator."}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"P"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":1261,"col":11},"end":{"line":1261,"col":37}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":49598},{"Deduplicated":50974},{"Deduplicated":3160}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597},{"Deduplicated":49598}],"output":{"HashConsedValue":[50978,{"Adt":{"id":{"Adt":69},"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitDecl":{"trait_ref":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":19}}},"is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":33,"beg":{"line":1258,"col":4},"end":{"line":1264,"col":5}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":33,"beg":{"line":1258,"col":44},"end":{"line":1258,"col":62}},"generated_from_span":null},"ty":{"Deduplicated":50978}},{"index":1,"name":"self","span":{"data":{"file_id":33,"beg":{"line":1258,"col":21},"end":{"line":1258,"col":25}},"generated_from_span":null},"ty":{"Deduplicated":49597}},{"index":2,"name":"predicate","span":{"data":{"file_id":33,"beg":{"line":1258,"col":27},"end":{"line":1258,"col":36}},"generated_from_span":n