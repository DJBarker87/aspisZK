eDead":2},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":888,"col":5},"end":{"line":888,"col":5}},"generated_from_span":null},"id":9657,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":888,"col":5},"end":{"line":888,"col":5}},"generated_from_span":null},"id":9658,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":122,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["filter",0]}],"span":{"data":{"file_id":33,"beg":{"line":952,"col":4},"end":{"line":955,"col":38}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator which uses a closure to determine if an element"},{"DocComment":" should be yielded."},{"DocComment":""},{"DocComment":" Given an element the closure must return `true` or `false`. The returned"},{"DocComment":" iterator will yield only the elements for which the closure returns"},{"DocComment":" `true`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [0i32, 1, 2];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().filter(|x| x.is_positive());"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because the closure passed to `filter()` takes a reference, and many"},{"DocComment":" iterators iterate over references, this leads to a possibly confusing"},{"DocComment":" situation, where the type of the closure is a double reference:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s = &[0, 1, 2];"},{"DocComment":""},{"DocComment":" let mut iter = s.iter().filter(|x| **x > 1); // needs two *s!"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(&2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It's common to instead use destructuring on the argument to strip away one:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s = &[0, 1, 2];"},{"DocComment":""},{"DocComment":" let mut iter = s.iter().filter(|&x| *x > 1); // both & and *"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(&2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" or both:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s = &[0, 1, 2];"},{"DocComment":""},{"DocComment":" let mut iter = s.iter().filter(|&&x| x > 1); // two &s"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(&2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" of these layers."},{"DocComment":""},{"DocComment":" Note that `iter.filter(f).next()` is equivalent to `iter.find(f)`."}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"iter_filter"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"P"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":955,"col":11},"end":{"line":955,"col":37}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":49598},{"HashConsedValue":[50974,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"HashConsedValue":[50727,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":49600},"Shared"]}]}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":3160}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsa