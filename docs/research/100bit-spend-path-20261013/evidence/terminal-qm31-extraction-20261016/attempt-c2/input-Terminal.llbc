t":" operation."},{"DocComment":""},{"DocComment":" If the iterator is empty, returns [`None`]; otherwise, returns the"},{"DocComment":" result of the reduction."},{"DocComment":""},{"DocComment":" The reducing function is a closure with two arguments: an 'accumulator', and an element."},{"DocComment":" For iterators with at least one element, this is the same as [`fold()`]"},{"DocComment":" with the first element of the iterator as the initial accumulator value, folding"},{"DocComment":" every subsequent element into it."},{"DocComment":""},{"DocComment":" [`fold()`]: Iterator::fold"},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let reduced: i32 = (1..10).reduce(|acc, e| acc + e).unwrap_or(0);"},{"DocComment":" assert_eq!(reduced, 45);"},{"DocComment":""},{"DocComment":" // Which is equivalent to doing it with `fold`:"},{"DocComment":" let folded: i32 = (1..10).fold(0, |acc, e| acc + e);"},{"DocComment":" assert_eq!(reduced, folded);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"F"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":33,"beg":{"line":2703,"col":22},"end":{"line":2703,"col":38}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":49597}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":33,"beg":{"line":2704,"col":11},"end":{"line":2704,"col":62