" ```"},{"DocComment":""},{"DocComment":" Split a string and get the first three items."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_next_chunk)]"},{"DocComment":""},{"DocComment":" let quote = \"not all those who wander are lost\";"},{"DocComment":" let [first, second, third] = quote.split_whitespace().next_chunk().unwrap();"},{"DocComment":" assert_eq!(first, \"not\");"},{"DocComment":" assert_eq!(second, \"all\");"},{"DocComment":" assert_eq!(third, \"those\");"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Item"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":1522}}],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49653}],"output":{"HashConsedValue":[50741,{"Adt":{"id":{"Adt":3},"generics":{"regions":[],"types":[{"Deduplicated":49964},{"Deduplicated":49632}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitDecl":{"trait_ref":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":1}}},"is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":33,"beg":{"line":112,"col":4},"end":{"line":119,"col":5}},"generated_from_span":null},"bound_body_regions":4,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":33,"beg":{"line":114,"col":9},"end"