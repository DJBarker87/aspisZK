{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(try_find)]"},{"DocComment":""},{"DocComment":" let a = [\"1\", \"2\", \"lol\", \"NaN\", \"5\"];"},{"DocComment":""},{"DocComment":" let is_my_num = |s: &str, search: i32| -> Result<bool, std::num::ParseIntError> {"},{"DocComment":"     Ok(s.parse::<i32>()? == search)"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" let result = a.into_iter().try_find(|&s| is_my_num(s, 2));"},{"DocComment":" assert_eq!(result, Ok(Some(\"2\")));"},{"DocComment":""},{"DocComment":" let result = a.into_iter().try_find(|&s| is_my_num(s, 5));"},{"DocComment":" assert!(result.is_err());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This also supports other types which implement [`Try`], not just [`Result`]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(try_find)]"},{"DocComment":""},{"DocComment":" use std::num::NonZero;"},{"DocComment":""},{"DocComment":" let a = [3, 5, 7, 4, 9, 0, 11u32];"},{"DocComment":" let result = a.into_iter().try_find(|&x| NonZero::new(x).map(|y| y.is_power_of_two()));"},{"DocComment":" assert_eq!(result, Some(Some(4)));"},{"DocComment":" let result = a.into_iter().take(3).try_find(|&x| NonZero::new(x).map(|y| y.is_power_of_two()));"},{"DocComment":" assert_eq!(result, Some(None));"},{"DocComment":" let result = a.into_iter().rev().try_find(|&x| NonZero::new(x).map(|y| y.is_power_of_two()));"},{"DocComment":" assert_eq!(result, None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":50677},{"Deduplicated":2165}],"output":{"Deduplicated":2783}},"default":{"id":153,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":49597},{"Deduplicated":2162},{"Deduplicated":2165},{"Deduplicated":49598},{"Deduplicated":2783}],"const_generics":[],"trait_refs":[{"Deduplicated":50688},{"D