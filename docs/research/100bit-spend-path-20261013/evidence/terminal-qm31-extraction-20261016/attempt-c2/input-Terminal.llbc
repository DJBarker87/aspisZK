ert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because the closure passed to `skip_while()` takes a reference, and many"},{"DocComment":" iterators iterate over references, this leads to a possibly confusing"},{"DocComment":" situation, where the type of the closure argument is a double reference:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s = &[-1, 0, 1];"},{"DocComment":""},{"DocComment":" let mut iter = s.iter().skip_while(|x| **x < 0); // need two *s!"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(&0));"},{"DocComment":" assert_eq!(iter.next(), Some(&1));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping after an initial `false`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1, 0, 1, -2];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().skip_while(|&x| x < 0);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":""},{"DocComment":" // while this would have been false, since we already got a false,"},{"DocComment":" // skip_while() isn't used any more"},{"DocComment":" assert_eq!(iter.next(), Some(-2));"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"P"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":1183,"col":11},"end":{"line":1183,"col":37}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":1,"generics