pointer (e.g. `*mut String`)."},{"DocComment":" Any other argument types *may* cause a compiler error."},{"DocComment":""},{"DocComment":" ## Pointers"},{"DocComment":""},{"DocComment":" When the input is a pointer, only the pointer itself is"},{"DocComment":" ever considered. The pointee has no effect. Currently, these functions"},{"DocComment":" behave identically:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(core_intrinsics)]"},{"DocComment":" # #![allow(internal_features)]"},{"DocComment":" use std::intrinsics::is_val_statically_known;"},{"DocComment":""},{"DocComment":" fn foo(x: &i32) -> bool {"},{"DocComment":"     is_val_statically_known(x)"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn bar(x: &i32) -> bool {"},{"DocComment":"     is_val_statically_known("},{"DocComment":"         (x as *const i32).addr()"},{"DocComment":"     )"},{"DocComment":" }"},{"DocComment":" # _ = foo(&5_i32);"},{"DocComment":" # _ = bar(&5_i32);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":22,"beg":{"line":2541,"col":40},"end":{"line":2541,"col":44}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":21,"generics":{"regions":[],"types":[{"Deduplicated":49597}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597}],"output":{"Deduplicated":3160}},"src":"TopLevel","is_global_initializer":null,"body":{"Intrinsic":{"name":"is_val_statically_known","arg_names":["_arg"]}}},{"def_id":910,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Impl":{"Trait":361}},{"Ident":["write_str",0]}],"span":{"data":{"file_id":81,"beg":{"line":247,