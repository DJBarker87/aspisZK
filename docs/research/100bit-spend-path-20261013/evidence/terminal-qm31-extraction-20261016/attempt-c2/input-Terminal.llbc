ments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1380,"col":5},"end":{"line":1380,"col":5}},"generated_from_span":null},"id":9697,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1380,"col":5},"end":{"line":1380,"col":5}},"generated_from_span":null},"id":9698,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1380,"col":5},"end":{"line":1380,"col":5}},"generated_from_span":null},"id":9699,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":130,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["take",0]}],"span":{"data":{"file_id":33,"beg":{"line":1447,"col":4},"end":{"line":1449,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that yields the first `n` elements, or fewer"},{"DocComment":" if the underlying iterator ends sooner."},{"DocComment":""},{"DocComment":" `take(n)` yields elements until `n` elements are yielded or the end of"},{"DocComment":" the iterator is reached (whichever happens first)."},{"DocComment":" The returned iterator is a prefix of length `n` if the original iterator"},{"DocComment":" contains at least `n` elements, otherwise it contains all of the"},{"DocComment":" (fewer than `n`) elements of the original iterator."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().take(2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `take()` is often used with an infinite iterator, to make it finite:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut iter = (0..).take(3);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If less than `n` elements are available,"},{"DocComment":" `take` will limit itself to the size of the underlying iterator:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = [1, 2];"},{"DocComment":" let mut iter = v.into_iter().take(5);"},{"DocComment":" assert_eq!(iter.next(), Some(1));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Use [`by_ref`] to take from the iterator without consuming it, and then"},{"DocComment":" continue using the original iterator:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut words = [\"hello\", \"world\", \"of\", \"Rust\"].into_iter();"},{"DocComment":""},{"DocComment":" // Take the first two words."},{"DocComment":" let hello_world: Vec<_> = words.by_ref().take(2).collect();"},{"DocComment":" assert_eq!(hello_world, vec![\"hello\", \"world\"]);"},{"DocComment":""},{"DocComment":" // Collect the rest of the words."},{"DocComment":" // We can only do this because we used `by_ref` earlier."},{"DocComment":" let of_rust: Vec<_> = words.collect();"},{"DocComment":" assert_eq!(of_rust, vec![\"of\", \"Rust\"]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`by_ref`]: Iterator::by_ref"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_varia