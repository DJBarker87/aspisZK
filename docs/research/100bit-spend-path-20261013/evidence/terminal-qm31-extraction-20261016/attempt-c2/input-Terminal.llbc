an":null},"id":61670,"kind":{"StorageDead":3},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":2172,"col":5},"end":{"line":2172,"col":5}},"generated_from_span":null},"id":9789,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":140,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["collect_into",0]}],"span":{"data":{"file_id":33,"beg":{"line":2238,"col":4},"end":{"line":2240,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Collects all the items from an iterator into a collection."},{"DocComment":""},{"DocComment":" This method consumes the iterator and adds all its items to the"},{"DocComment":" passed collection. The collection is then returned, so the call chain"},{"DocComment":" can be continued."},{"DocComment":""},{"DocComment":" This is useful when you already have a collection and want to add"},{"DocComment":" the iterator items to it."},{"DocComment":""},{"DocComment":" This method is a convenience method to call [Extend::extend](trait.Extend.html),"},{"DocComment":" but instead of being called on a collection, it's called on an iterator."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_collect_into)]"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let mut vec: Vec::<i32> = vec![0, 1];"},{"DocComment":""},{"DocComment":" a.iter().map(|x| x * 2).collect_into(&mut vec);"},{"DocComment":" a.iter().map(|x| x * 10).collect_into(&mut vec);"},{"DocComment":""},{"DocComment":" assert_eq!(vec, vec![0, 1, 2, 4, 6, 10, 20, 30]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `Vec` can have a manual set capacity to avoid reallocating it:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_collect_into)]"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let mut vec: Vec::<i32> = Vec::with_capacity(6);"},{"DocComment":""},{"DocComment":" a.iter().map(|x| x * 2).collect_into(&mut vec);"},{"DocComment":" a.iter().map(|x| x * 10).collect_into(&mut vec);"},{"DocComment":""},{"DocComment":" assert_eq!(6, vec.capacity());"},{"DocComment":" assert_eq!(vec, vec![2, 4, 6, 10, 20, 30]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The returned mutable reference can be used to continue the call chain:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_collect_into)]"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let mut vec: Vec::<i32> = Vec::with_capacity(6);"},{"DocComment":""},{"DocComment":" let count = a.iter().collect_into(&mut vec).iter().count();"},{"DocComment":""},{"DocComment":" assert_eq!(count, vec.len());"},{"DocComment":" assert_eq!(vec, vec![1, 2, 3]);"},{"DocComment":""},{"DocComment":" let count = a.iter().collect_into(&mut vec).iter().count();"},{"DocComment":""},{"DocComment":" assert_eq!(count, vec.len());"},{"DocComment":" assert_eq!(vec, vec![1, 2, 3, 1, 2, 3]);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"E"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":33,"beg":{"line":2238,"col":23},"end":{"line":2238,"col":41}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id