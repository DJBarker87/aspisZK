"col":47},"end":{"line":1771,"col":48}},"generated_from_span":null},"ty":{"Deduplicated":49598}}]},"body":{"span":{"data":{"file_id":33,"beg":{"line":1776,"col":8},"end":{"line":1777,"col":5}},"generated_from_span":null},"statements":[{"span":{"data":{"file_id":33,"beg":{"line":1776,"col":8},"end":{"line":1776,"col":32}},"generated_from_span":null},"id":9749,"kind":{"StorageLive":0},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1776,"col":8},"end":{"line":1776,"col":32}},"generated_from_span":null},"id":9753,"kind":{"Call":{"call":{"func":{"Regular":{"kind":{"Fun":{"Regular":336}},"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598},{"Deduplicated":49629}],"const_generics":[{"kind":{"Var":{"Free":0}},"ty":{"Deduplicated":1522}}],"trait_refs":[{"Deduplicated":50987}]}}},"args":[{"Move":{"kind":{"Local":1},"ty":{"Deduplicated":49597}}},{"Move":{"kind":{"Local":2},"ty":{"Deduplicated":49598}}}],"dest":{"kind":{"Local":0},"ty":{"Deduplicated":50993}}},"on_unwind":{"span":{"data":{"file_id":33,"beg":{"line":1776,"col":8},"end":{"line":1776,"col":32}},"generated_from_span":null},"statements":[{"span":{"data":{"file_id":33,"beg":{"line":1776,"col":8},"end":{"line":1776,"col":32}},"generated_from_span":null},"id":9750,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1776,"col":8},"end":{"line":1776,"col":32}},"generated_from_span":null},"id":9751,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1776,"col":8},"end":{"line":1776,"col":32}},"generated_from_span":null},"id":9752,"kind":"UnwindResume","comments_before":[]}]}}},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1777,"col":5},"end":{"line":1777,"col":5}},"generated_from_span":null},"id":9754,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1777,"col":5},"end":{"line":1777,"col":5}},"generated_from_span":null},"id":9755,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1777,"col":5},"end":{"line":1777,"col":5}},"generated_from_span":null},"id":9756,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":135,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["fuse",0]}],"span":{"data":{"file_id":33,"beg":{"line":1833,"col":4},"end":{"line":1835,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator which ends after the first [`None`]."},{"DocComment":""},{"DocComment":" After an iterator returns [`None`], future calls may or may not yield"},{"DocComment":" [`Some(T)`] again. `fuse()` adapts an iterator, ensuring that after a"},{"DocComment":" [`None`] is given, it will always return [`None`] forever."},{"DocComment":""},{"DocComment":" Note that the [`Fuse`] wrapper is a no-op on iterators that implement"},{"DocComment":" the [`FusedIterator`] trait. `fuse()` may therefore behave incorrectly"},{"DocComment":" if the [`FusedIterator`] trait is improperly implemented."},{"DocComment":""},{"DocComment":" [`Some(T)`]: Some"},{"DocComment":" [`FusedIterator`]: crate::iter::FusedIterator"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // an iterator which alternates between Some and None"},{"DocComment":" struct Alternate {"},{"DocComment":"     state: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Iterator for Alternate {"},{"DocComment":"     type Item = i32;"},{"DocComment":""},{"DocComment":"     fn next(&mut self) -> Option<i32> {"},{"DocComment":"         let val = self.state;"},{"DocComment":"         self.state = self.state + 1;"},{"DocComment":""},{"DocComment":"         // if it's even, Some(i32), else None"},{"DocComment":"         (val % 2 == 0).then_some(val)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut iter = Alternate { state: 0 };"},{"DocComment":""},{"DocComment":" // we can see our iterator going back and forth"},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":""},{"DocComment":" // however, once we fuse it..."},{"DocComment":" let mut iter = iter.fuse();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":""},{"DocComment":" // it will always return `None` after the first time."},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597}],"output":{"Deduplicated":49665}},"src":{"TraitDecl":{"trait_ref":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":27}}},"is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":33,"beg":{"line":1833,"col":4},"end":{"line":1838,"col":5}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":33,"beg":{"line":1833,"col":21},"end":{"line":1833,"col":31}},"generated_from_span":null},"ty":{"Deduplicated":49665}},{"index":1,"name":"self","span":{"data":{"file_id":33,"beg":{"line":1833,"col":12},"end":{"line":1833,"col":16}},"generated_from_span":null},"ty":{"Deduplicated":49597}},{"index":2,"name":null,"span":{"data":{"file_id":71,"beg":{"line":25,"col":21},"end":{"line":25,"col":31}},"generated_from_span":null},"ty":{"Deduplicated":49622}}]},"body":{"span":{"data":{"file_id":71,"beg":{"line":25,"col":8},"end":{"line":25,"col":33}},"generated_from_span":null},"statements":[{"span":{"data":{"file_id":71,"beg":{"line":25,"col":21},"end":{"line":25,"col":31}},"generated_from_span":null},"id":9757,"kind":{"StorageLive":0},"comments_before":[]},{"span":{"data":{"file_id":71,"beg":{"line":25,"col":21},"end":{"line":25,"col":31}},"generated_from_span":null},"id":9758,"kind":{"StorageLive":2},"comments_before":[]},{"span":{"data":{"file_id":71,"beg":{"line":25,"col":21},"end":{"line":25,"col":31}},"generated_from_span":null},"id":9759,"kind":{"Assign":[{"kind":{"Local":2},"ty":{"Deduplicated":49622}},{"Aggregate":[{"Adt":[{"id":{"Adt":18},"generics":{"regions":[],"types":[{"Deduplicated":49597}],"const_generics":[],"trait_refs":[]}},1,null]},[{"Copy":{"kind":{"Local":1},"ty":{"Deduplicated":49597}}}]]}]},"comments_before":[]},{"span":{"data":{"file_id":71,"beg":{"line":25,"col":8},"end":{"line":25,"col":33}},"generated_from_span":null},"id":9760,"kind":{"Assign":[{"kind":{"Local":0},"ty":{"Deduplicated":49665}},{"Aggregate":[{"Adt":[{"id":{"Adt":77},"generics":{"regions":[],"types":[{"Deduplicated":49597}],"const_generics":[],"trait_refs":[]}},null,null]},[{"Move":{"kind":{"Local":2},"ty":{"Deduplicated":49622}}}]]}]},"comments_before":[]},{"span":{"data":{"file_id":71,"beg":{"line":25,"col":32},"end":{"line":25,"col":33}},"generated_from_span":null},"id":9761,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1838,"col":5},"end":{"line":1838,"col":5}},"generated_from_span":null},"id":9762,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1838,"col":5},"end":{"line":1838,"col":5}},"generated_from_span":null},"id":9763,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":136,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["inspect",0]}],"span":{"data":{"file_id":33,"beg":{"line":1917,"col":4},"end":{"line":1920,"col":30}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Does something with each element of an iterator, passing the value on."},{"DocComment":""},{"DocComment":" When using iterators, you'll often chain several of them together."},{"DocComment":" While working on such code, you might want to check out what's"},{"DocComment":" happening at various parts in the pipeline. To do that, insert"},{"DocComment":" a call to `inspect()`."},{"DocComment":""},{"DocComment":" It's more common for `inspect()` to be used as a debugging tool than to"},{"DocComment":" exist in your final code, but applications may find it useful in certain"},{"DocComment":" situations when errors need to be logged before being discarded."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 4, 2, 3];"},{"DocComment":""},{"DocComment":" // this iterator sequence is complex."},{"DocComment":" let sum = a.iter()"},{"DocComment":"     .cloned()"},{"DocComment":"     .filter(|x| x % 2 == 0)"},{"DocComment":"     .fold(0, |sum, i| sum + i);"},{"DocComment":""},{"DocComment":" println!(\"{sum}\");"},{"DocComment":""},{"DocComment":" // let's add some inspect() calls to investigate what's happening"},{"DocComment":" let sum = a.iter()"},{"DocComment":"     .cloned()"},{"DocComment":"     .inspect(|x| println!(\"about to filter: {x}\"))"},{"DocComment":"     .filter(|x| x % 2 == 0)"},{"DocComment":"     .inspect(|x| println!(\"made it through filter: {x}\"))"},{"DocComment":"     .fold(0, |sum, i| sum + i);"},{"DocComment":""},{"DocComment":" println!(\"{sum}\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will print:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" 6"},{"DocComment":" about to filter: 1"},{"DocComment":" about to filter: 4"},{"DocComment":" made it through filter: 4"},{"DocComment":" about to filter: 2"},{"DocComment":" made it through filter: 2"},{"DocComment":" about to filter: 3"},{"DocComment":" 6"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Logging errors before discarding them:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let lines = [\"1\", \"2\", \"a\"];"},{"DocComment":""},{"DocComment":" let sum: i32 = lines"},{"DocComment":"     .iter()"},{"DocComment":"     .map(|line| line.parse::<i32>())"},{"DocComment":"     .inspect(|num| {"},{"DocComment":"         if let Err(ref e) = *num {"},{"DocComment":"             println!(\"Parsing error: {e}\");"},{"DocComment":"         }"},{"DocComment":"     })"},{"DocComment":"     .filter_map(Result::ok)"},{"DocComment":"     .sum();"},{"DocComment":""},{"DocComment":" println!(\"Sum: {sum}\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will print:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" Parsing error: invalid digit found in string"},{"DocComment":" Sum: 3"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"F"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":1920,"col":11},"end":{"line":1920,"col":29}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":49598},{"Deduplicated":50974},{"Deduplicated":1764}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597},{"Deduplicated":49598}],"output":{"HashConsedValue":[50994,{"Adt":{"id":{"Adt":78},"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitDecl":{"trait_ref":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":28}}},"is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":33,"beg":{"line":1917,"col":4},"end":{"line":1923,"col":5}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":33,"beg":{"line":1917,"col":33},"end":{"line":1917,"col":49}},"generated_from_span":null},"ty":{"Deduplicated":50994}},{"index":1,"name":"self","span":{"data":{"file_id":33,"beg":{"line":1917,"col":18},"end":{"line":1917,"col":22}},"generated_from_span":null},"ty":{"Deduplicated":49597}},{"index":2,"name":"f","span":{"data":{"file_id":33,"beg":{"line":1917,"col":24},"end":{"line":1917,"col":25}},"generated_from_span":null},"ty":{"Deduplicated":49598}}]},"body":{"span":{"data":{"file_id":72,"beg":{"line":24,"col":8},"end":{"line":24,"col":27}},"generated_from_span":null},"statements":[{"span":{"data":{"file_id":72,"beg":{"line":24,"col":8},"end":{"line":24,"col":27}},"generated_from_span":null},"id":9764,"kind":{"StorageLive":0},"comments_before":[]},{"span":{"data":{"file_id":72,"beg":{"line":24,"col":8},"end":{"line":24,"col":27}},"generated_from_span":null},"id":9765,"kind":{"Assign":[{"kind":{"Local":0},"ty":{"Deduplicated":50994}},{"Aggregate":[{"Adt":[{"id":{"Adt":78},"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}},null,null]},[{"Copy":{"kind":{"Local":1},"ty":{"Deduplicated":49597}}},{"Copy":{"kind":{"Local":2},"ty":{"Deduplicated":49598}}}]]}]},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1923,"col":5},"end":{"line":1923,"col":5}},"generated_from_span":null},"id":9766,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1923,"col":5},"end":{"line":1923,"col":5}},"generated_from_span":null},"id":9767,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1923,"col":5},"end":{"line":1923,"col":5}},"generated_from_span":null},"id":9768,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":137,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["by_ref",0]}],"span":{"data":{"file_id":33,"beg":{"line":1954,"col":4},"end":{"line":1956,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates a \"by reference\" adapter for this instance of `Iterator`."},{"DocComment":""},{"DocComment":" Consuming method calls (direct or indirect calls to `next`)"},{"DocComment":" on the \"by reference\" adapter will consume the original iterator,"},{"DocComment":" but ownership-taking methods (those with a `self` parameter)"},{"DocComment":" only take ownership of the \"by reference\" iterator."},{"DocComment":""},{"DocComment":" This is useful for applying ownership-taking methods"},{"DocComment":" (such as `take` in the example below)"},{"DocComment":" without giving up ownership of the original iterator,"},{"DocComment":" so you can use the original iterator afterwards."},{"DocComment":""},{"DocComment":" Uses [`impl<I: Iterator + ?Sized> Iterator for &mut I { type Item = I::Item; ...}`](Iterator#impl-Iterator-for-%26mut+I)."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut words = [\"hello\", \"world\", \"of\", \"Rust\"].into_iter();"},{"DocComment":""},{"DocComment":" // Take the first two words."},{"DocComment":" let hello_world: Vec<_> = words.by_ref().take(2).collect();"},{"DocComment":" assert_eq!(hello_world, vec![\"hello\", \"world\"]);"},{"DocComment":""},{"DocComment":" // Collect the rest of the words."},{"DocComment":" // We can only do this because we used `by_ref` earlier."},{"DocComment":" let of_rust: Vec<_> = words.collect();"},{"DocComment":" assert_eq!(of_rust, vec![\"of\", \"Rust\"]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49653}],"output":{"Deduplicated":49653}},"src":{"TraitDecl":{"trait_ref":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":29}}},"is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":33,"beg":{"line":1954,"col":4},"end":{"line":1959,"col":5}},"generated_from_span":null},"bound_body_regions":3,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":33,"beg":{"line":1954,"col":28},"end":{"line":1954,"col":37}},"generated_from_span":null},"ty":{"Deduplicated":50955}},{"index":1,"name":"self","span":{"data":{"file_id":33,"beg":{"line":1954,"col":14},"end":{"line":1954,"col":23}},"generated_from_span":null},"ty":{"HashConsedValue":[50995,{"Ref":[{"Body":2},{"Deduplicated":49597},"Mut"]}]}}]},"body":{"span":{"data":{"file_id":33,"beg":{"line":1958,"col":8},"end":{"line":1959,"col":5}},"generated_from_span":null},"statements":[{"span":{"data":{"file_id":33,"beg":{"line":1958,"col":8},"end":{"line":1958,"col":12}},"generated_from_span":null},"id":9769,"kind":{"StorageLive":0},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1958,"col":8},"end":{"line":1958,"col":12}},"generated_from_span":null},"id":9770,"kind":{"Assign":[{"kind":{"Local":0},"ty":{"Deduplicated":50955}},{"Use":[{"Copy":{"kind":{"Local":1},"ty":{"Deduplicated":50995}}},"Yes"]}]},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1959,"col":5},"end":{"line":1959,"col":5}},"generated_from_span":null},"id":9771,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":1959,"col":5},"end":{"line":1959,"col":5}},"generated_from_span":null},"id":9772,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":138,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["collect",0]}],"span":{"data":{"file_id":33,"beg":{"line":2077,"col":4},"end":{"line":2079,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Transforms an iterator into a collection."},{"DocComment":""},{"DocComment":" `collect()` takes ownership of an iterator and produces whichever"},{"DocComment":" collection type you request. The iterator itself carries no knowledge of"},{"DocComment":" the eventual container; the target collection is chosen entirely by the"},{"DocComment":" type you ask `collect()` to return. This makes `collect()` one of the"},{"DocComment":" more powerful methods in the standard library, and it shows up in a wide"},{"DocComment":" variety of contexts."},{"DocComment":""},{"DocComment":" The most basic pattern in which `collect()` is used is to turn one"},{"DocComment":" collection into another. You take a collection, call [`iter`] on it,"},{"DocComment":" do a bunch of transformations, and then `collect()` at the end."},{"DocComment":""},{"DocComment":" `collect()` can also create instances of types that are not typical"},{"DocComment":" collections. For example, a [`String`] can be built from [`char`]s,"},{"DocComment":" and an iterator of [`Result<T, E>`][`Result`] items can be collected"},{"DocComment":" into `Result<Collection<T>, E>`. See the examples below for more."},{"DocComment":""},{"DocComment":" Because `collect()` is so general, it can cause problems with type"},{"DocComment":" inference. As such, `collect()` is one of the few times you'll see"},{"DocComment":" the syntax affectionately known as the 'turbofish': `::<>`. This"},{"DocComment":" helps the inference algorithm understand specifically which collection"},{"DocComment":" you're trying to collect into."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled: Vec<i32> = a.iter()"},{"DocComment":"                          .map(|x| x * 2)"},{"DocComment":"                          .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that we needed the `: Vec<i32>` on the left-hand side. This is because"},{"DocComment":" we could collect into, for example, a [`VecDeque<T>`] instead:"},{"DocComment":""},{"DocComment":" [`VecDeque<T>`]: ../../std/collections/struct.VecDeque.html"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::VecDeque;"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled: VecDeque<i32> = a.iter().map(|x| x * 2).collect();"},{"DocComment":""},{"DocComment":" assert_eq!(2, doubled[0]);"},{"DocComment":" assert_eq!(4, doubled[1]);"},{"DocComment":" assert_eq!(6, doubled[2]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using the 'turbofish' instead of annotating `doubled`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled = a.iter().map(|x| x * 2).collect::<Vec<i32>>();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because `collect()` only cares about what you're collecting into, you can"},{"DocComment":" still use a partial type hint, `_`, with the turbofish:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let doubled = a.iter().map(|x| x * 2).collect::<Vec<_>>();"},{"DocComment":""},{"DocComment":" assert_eq!(vec![2, 4, 6], doubled);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using `collect()` to make a [`String`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let chars = ['g', 'd', 'k', 'k', 'n'];"},{"DocComment":""},{"DocComment":" let hello: String = chars.into_iter()"},{"DocComment":"     .map(|x| x as u8)"},{"DocComment":"     .map(|x| (x + 1) as char)"},{"DocComment":"     .collect();"},{"DocComment":""},{"DocComment":" assert_eq!(\"hello\", hello);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you have a list of [`Result<T, E>`][`Result`]s, you can use `collect()` to"},{"DocComment":" see if any of them failed:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let results = [Ok(1), Err(\"nope\"), Ok(3), Err(\"bad\")];"},{"DocComment":""},{"DocComment":" let result: Result<Vec<_>, &str> = results.into_iter().collect();"},{"DocComment":""},{"DocComment":" // gives us the first error"},{"DocComment":" assert_eq!(Err(\"nope\"), result);"},{"DocComment":""},{"DocComment":" let results = [Ok(1), Ok(3)];"},{"DocComment":""},{"DocComment":" let result: Result<Vec<_>, &str> = results.into_iter().collect();"},{"DocComment":""},{"DocComment":" // gives us the list of answers"},{"DocComment":" assert_eq!(Ok(vec![1, 3]), result);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`iter`]: Iterator::next"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":" [`char`]: type@char"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"iterator_collect_fn"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"B"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":33,"beg":{"line":2077,"col":18},"end":{"line":2077,"col":42}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":49598},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597}],"output":{"Deduplicated":49598}},"src":{"TraitDecl":{"trait_ref":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":30}}},"is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":33,"beg":{"line":2077,"col":4},"end":{"line":2091,"col":5}},"generated_from_span":null},"bound_body_regions":15,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":33,"beg":{"line":2077,"col":53},"end":{"line":2077,"col":54}},"generated_from_span":null},"ty":{"Deduplicated":49598}},{"index":1,"name":"self","span":{"data":{"file_id":33,"beg":{"line":2077,"col":44},"end":{"line":2077,"col":48}},"generated_from_span":null},"ty":{"Deduplicated":49597}}]},"body":{"span":{"data":{"file_id":33,"beg":{"line":2090,"col":8},"end":{"line":2091,"col":5}},"generated_from_span":null},"statements":[{"span":{"data":{"file_id":33,"beg":{"line":2090,"col":8},"end":{"line":2090,"col":37}},"generated_from_span":null},"id":9773,"kind":{"StorageLive":0},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":2090,"col":8},"end":{"line":2090,"col":37}},"generated_from_span":null},"id":9776,"kind":{"Call":{"call":{"func":{"Regular":{"kind":{"Trait":[{"HashConsedValue":[50996,{"kind":{"Clause":{"Free":1}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":49598},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}}}}]},0]},"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49597}],"const_generics":[],"trait_refs":[{"HashConsedValue":[50997,{"kind":{"TraitImpl":{"id":37,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[{"Deduplicated":49671}]}}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":14,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49600},{"Deduplicated":49597}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"args":[{"Move":{"kind":{"Local":1},"ty":{"Deduplicated":49597}}}],"dest":{"kind":{"Local":0},"ty":{"Deduplicated":49598}}},"on_unwind":{"span":{"data":{"file_id":33,"beg":{"line":2090,"col":8},"end":{"line":2090,"col":37}},"generated_from_span":null},"statements":[{"span":{"data":{"file_id":33,"beg":{"line":2090,"col":8},"end":{"line":2090,"col":37}},"generated_from_span":null},"id":9774,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":2090,"col":8},"end":{"line":2090,"col":37}},"generated_from_span":null},"id":9775,"kind":"UnwindResume","comments_before":[]}]}}},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":2091,"col":5},"end":{"line":2091,"col":5}},"generated_from_span":null},"id":9777,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":2091,"col":5},"end":{"line":2091,"col":5}},"generated_from_span":null},"id":9778,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":139,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["try_collect",0]}],"span":{"data":{"file_id":33,"beg":{"line":2165,"col":4},"end":{"line":2169,"col":53}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Fallibly transforms an iterator into a collection, short circuiting if"},{"DocComment":" a failure is encountered."},{"DocComment":""},{"DocComment":" `try_collect()` is a variation of [`collect()`][`collect`] that allows fallible"},{"DocComment":" conversions during collection. Its main use case is simplifying conversions from"},{"DocComment":" iterators yielding [`Option<T>`][`Option`] into `Option<Collection<T>>`, or similarly for other [`Try`]"},{"DocComment":" types (e.g. [`Result`])."},{"DocComment":""},{"DocComment":" Importantly, `try_collect()` doesn't require that the outer [`Try`] type also implements [`FromIterator`];"},{"DocComment":" only the inner type produced on `Try::Output` must implement it. Concretely,"},{"DocComment":" this means that collecting into `ControlFlow<_, Vec<i32>>` is valid because `Vec<i32>` implements"},{"DocComment":" [`FromIterator`], even though [`ControlFlow`] doesn't."},{"DocComment":""},{"DocComment":" Also, if a failure is encountered during `try_collect()`, the iterator is still valid and"},{"DocComment":" may continue to be used, in which case it will continue iterating starting after the element that"},{"DocComment":" triggered the failure. See the last example below for an example of how this works."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":" Successfully collecting an iterator of `Option<i32>` into `Option<Vec<i32>>`:"},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_collect)]"},{"DocComment":""},{"DocComment":" let u = vec![Some(1), Some(2), Some(3)];"},{"DocComment":" let v = u.into_iter().try_collect::<Vec<i32>>();"},{"DocComment":" assert_eq!(v, Some(vec![1, 2, 3]));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Failing to collect in the same way:"},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_collect)]"},{"DocComment":""},{"DocComment":" let u = vec![Some(1), Some(2), None, Some(3)];"},{"DocComment":" let v = u.into_iter().try_collect::<Vec<i32>>();"},{"DocComment":" assert_eq!(v, None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A similar example, but with `Result`:"},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_collect)]"},{"DocComment":""},{"DocComment":" let u: Vec<Result<i32, ()>> = vec![Ok(1), Ok(2), Ok(3)];"},{"DocComment":" let v = u.into_iter().try_collect::<Vec<i32>>();"},{"DocComment":" assert_eq!(v, Ok(vec![1, 2, 3]));"},{"DocComment":""},{"DocComment":" let u = vec![Ok(1), Ok(2), Err(()), Ok(3)];"},{"DocComment":" let v = u.into_iter().try_collect::<Vec<i32>>();"},{"DocComment":" assert_eq!(v, Err(()));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Finally, even [`ControlFlow`] works, despite the fact that it"},{"DocComment":" doesn't implement [`FromIterator`]. Note also that the iterator can"},{"DocComment":" continue to be used, even if a failure is encountered:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_collect)]"},{"DocComment":""},{"DocComment":" use core::ops::ControlFlow::{Break, Continue};"},{"DocComment":""},{"DocComment":" let u = [Continue(1), Continue(2), Break(3), Continue(4), Continue(5)];"},{"DocComment":" let mut it = u.into_iter();"},{"DocComment":""},{"DocComment":" let v = it.try_collect::<Vec<_>>();"},{"DocComment":" assert_eq!(v, Break(3));"},{"DocComment":""},{"DocComment":" let v = it.try_collect::<Vec<_>>();"},{"DocComment":" assert_eq!(v, Continue(vec![4, 5]));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`collect`]: Iterator::collect"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"B"},{"index":2,"name":"Clause0_Item"},{"index":3,"name":"Clause2_TryType"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":33,"beg":{"line":2168,"col":20},"end":{"line":2168,"col":46}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":33,"beg":{"line":2168,"col":34},"end":{"line":2168,"col":45}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":49669},{"Deduplicated":49598},{"Deduplicated":49629}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"data":{"file_id":33,"beg":{"line":2169,"col":11},"end":{"line":2169,"col":52}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":49598},{"Deduplicated":49670}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49653}],"output":{"Deduplicated":49629}},"src":{"TraitDecl":{"trait_ref":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49600}],"const_generics":[],"trait_