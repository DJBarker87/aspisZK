628,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":699,"col":5},"end":{"line":699,"col":5}},"generated_from_span":null},"id":9629,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":33,"beg":{"line":699,"col":5},"end":{"line":699,"col":5}},"generated_from_span":null},"id":9630,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":119,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["intersperse_with",0]}],"span":{"data":{"file_id":33,"beg":{"line":772,"col":4},"end":{"line":775,"col":33}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates a new iterator which places an item generated by `separator`"},{"DocComment":" between items of the original iterator."},{"DocComment":""},{"DocComment":" Specifically on fused iterators, it is guaranteed that the new iterator"},{"DocComment":" places an item generated by `separator` between adjacent `Some(_)` items."},{"DocComment":" For non-fused iterators, it is guaranteed that [`intersperse_with`] will"},{"DocComment":" create a new iterator that places an item generated by `separator` between `Some(_)`"},{"DocComment":" items, particularly just right before the subsequent `Some(_)` item."},{"DocComment":""},{"DocComment":" For example, consider the following non-fused iterator:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" Some(1) -> Some(2) -> None -> Some(3) -> Some(4) -> ..."},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If this non-fused iterator were to be interspersed with a `separator` closure"},{"DocComment":" that returns `0` repeatedly, the interspersed iterator will produce:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" Some(1) -> Some(0) -> Some(2) -> None -> Some(0) -> Some(3) -> Some(0) ->"},{"DocComment":" Some(4) -> ..."},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The `separator` closure will be called exactly once each time an item"},{"DocComment":" is placed between two adjacent items from the underlying iterator;"},{"DocComment":" specifically, the closure is not called if the underlying iterator yields"},{"DocComment":" less than two items and after the last item is yielded."},{"DocComment":""},{"DocComment":" If the iterator's item implements [`Clone`], it may be easier to use"},{"DocComment":" [`intersperse`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_intersperse)]"},{"DocComment":""},{"DocComment":" #[derive(PartialEq, Debug)]"},{"DocComment":" struct NotClone(usize);"},{"DocComment":""},{"DocComment":" let v = [NotClone(0), NotClone(1), NotClone(2)];"},{"DocComment":" let mut it = v.into_iter().intersperse_with(|| NotClone(99));"},{"DocComment":""},{"DocComment":" assert_eq!(it.next(), Some(NotClone(0)));  // The first element from `v`."},{"DocComment":" assert_eq!(it.next(), Some(NotClone(99))); // The separator."},{"DocComment":" assert_eq!(it.next(), Some(NotClone(1)));  // The next element from `v`."},{"DocComment":" assert_eq!(it.next(), Some(NotClone(99))); // The separator."},{"DocComment":" assert_eq!(it.next(), Some(NotClone(2)));  // The last element from `v`."},{"DocComment":" assert_eq!(it.next(), None);               // The iterator is finished."},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `intersperse_with` can be used in situations where the separator needs"},{"DocComment":" to be computed:"},{"DocComment":" ```"},{"DocComment":" #![feature(iter_intersperse)]"},{"DocComment":""},{"DocComment":" let src = [\"Hello\", \"to\", \"all\", \"people\", \"!!\"].iter().copied();"},{"DocComment":""},{"DocComment":" // The closure mutably borrows its context to generate an item."},{"DocComment":" let mut happy_emojis = [\" ❤️ \", \" 😀 \"].into_iter();"},{"DocComment":" let separator = || happy_emojis.next().unwrap_or(\" 🦀 \");"},{"DocComment":""},{"DocComment":" let result = src.intersperse_with(separator).collect::<String>();"},{"DocComment":" assert_eq!(result, \"Hello ❤️ to 😀 all 🦀 people 🦀 !!\");"},{"DocComment":" ```"},{"DocComment":" [`Clone`]: crate::clone::Clone"},{"DocComment":" [`intersperse`]: Iterator::intersperse"},{"DocComment":" [`intersperse_with`]: Iterator::intersperse_with"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"G"},{"index":2,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":33,"beg":{"line":775,"col":11},"end":{"line":775,"col":32}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":49598},{"Deduplicated":1764},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597},{"Deduplicated":49598}],"output":{"HashConsedValue":[50967,{"Adt":{"id":{"Adt":62},"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49598},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitDecl":{"trait_ref":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49600}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":11}}},"is_global_initializer":null,"body":{"Structured":{"