et numbers = vec![1, 2, 3, usize::MAX, 4, 5];"},{"DocComment":" let sum = numbers.into_iter().try_reduce(|x, y| x.checked_add(y));"},{"DocComment":" assert_eq!(sum, None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Determine when a reduction was not performed because there are no elements:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_reduce)]"},{"DocComment":""},{"DocComment":" let numbers: Vec<usize> = Vec::new();"},{"DocComment":" let sum = numbers.into_iter().try_reduce(|x, y| x.checked_add(y));"},{"DocComment":" assert_eq!(sum, Some(None));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Use a [`Result`] instead of an [`Option`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_reduce)]"},{"DocComment":""},{"DocComment":" let numbers = vec![\"1\", \"2\", \"3\", \"4\", \"5\"];"},{"DocComment":" let max: Result<Option<_>, <usize as std::str::FromStr>::Err> ="},{"DocComment":"     numbers.into_iter().try_reduce(|x, y| {"},{"DocComment":"         if x.parse::<usize>()? > y.parse::<usize>()? { Ok(x) } else { Ok(y) }"},{"DocComment":"     });"},{"DocComment":" assert_eq!(max, Ok(Some(\"5\")));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"},{"index":1,"name":"R"},{"index":2,"name":"T2"},{"index":3,"name":"Clause0_Item"},{"index":4,"name":"Clause2_TryType"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49629}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":33,"beg":{"line":2778,"col":11},"end":{"line":2778,"col