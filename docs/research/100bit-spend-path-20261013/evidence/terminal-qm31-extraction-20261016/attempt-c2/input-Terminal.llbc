= [\"alpha\", \"beta\", \"gamma\"];"},{"DocComment":""},{"DocComment":" // chars() returns an iterator"},{"DocComment":" let merged: String = words.iter()"},{"DocComment":"                           .flat_map(|s| s.chars())"},{"DocComment":"                           .collect();"},{"DocComment":" assert_eq!(merged, \"alphabetagamma\");"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"U"},{"index":2,"name":"F"},{"index":3,"name":"Clause0_Item"},{"index":4,"name":"Clause1_Item"},{"index":5,"name":"Clause1_IntoIter"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":49597},{"Deduplicated":49629}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":33,"beg":{"line":1536,"col":11},"end":{"line":1536,"col":23}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":14,"generics":{"regions":[],"types":[{"Deduplicated":49598},{"Deduplicated":49627},{"Deduplicated":49778}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":33,"beg":{"line":1537,"col":11},"end":{"line":1537,"col":33}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":49600},{"Deduplicated":50275},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49597},{"Deduplicated":49600}],"output":{"HashConsedValue":[50982,{"Adt":{"id":{"Adt":74},"generics":{"regions":[],"typ