>`, then this function will return"},{"DocComment":" `Option<Option<Self::Item>>`."},{"DocComment":""},{"DocComment":" When called on an empty iterator, this function will return either `Some(None)` or"},{"DocComment":" `Ok(None)` depending on the type of the provided closure."},{"DocComment":""},{"DocComment":" For iterators with at least one element, this is essentially the same as calling"},{"DocComment":" [`try_fold()`] with the first element of the iterator as the initial accumulator value."},{"DocComment":""},{"DocComment":" [`try_fold()`]: Iterator::try_fold"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Safely calculate the sum of a series of numbers:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_reduce)]"},{"DocComment":""},{"DocComment":" let numbers: Vec<usize> = vec![10, 20, 5, 23, 0];"},{"DocComment":" let sum = numbers.into_iter().try_reduce(|x, y| x.checked_add(y));"},{"DocComment":" assert_eq!(sum, Some(Some(58)));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Determine when a reduction short circuited:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_reduce)]"},{"DocComment":""},{"DocComment":" let numbers = vec![1, 2, 3, usize::MAX, 4, 5];"},{"DocComment":" let sum = numbers.into_iter().try_reduce(|x, y| x.checked_add(y));"},{"DocComment":" assert_eq!(sum, None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Determine when a reduction was not performed because there are no elements:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_reduce)]"},{"DocComment":""},{"DocComment":" let numbers: Vec<usize> = Vec::new();"},{"DocComment":" let sum = numbers.into_iter().try_reduce(|x, y| x.checked_add(y));"},{"DocComment":" assert_eq!(sum, Some(None));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Use a [`Result`] instead of an [`Option`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iterator_try_reduce)]"},{"DocComment":""},{"DocComment":" let numbers = vec![\"1\", \"2\", \"3\", \"4\", \"5\"];"},{"DocComment":" let max: Result<Option<_>, <usize as std::str::FromStr>::Err> ="},{"DocComment":"     numbers.into_iter().try_reduce(|x, y| {"},{"DocComment":"         if x.parse::<usize>()? > y.parse::<usize>()? { Ok(x) } else { Ok(y) }"},{"DocComment":"     });"},{"DocComment":" assert_eq!(max, Ok(Some(\"5\")));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":50677},{"Deduplicated":2165}],"output":{"Deduplicated":2783}},"default":{"id":148,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":49597},{"Deduplicated":2162},{"Deduplicated":2165},{"Deduplicated":49598},{"Deduplicated":2783}],"const_generics":[],"trait_refs":[{"Deduplicated":50688},{"HashConsedValue":[3253,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":2723}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[49934,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":3179},{"Deduplicated":49623},{"Deduplicated":2777}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[49935,{"kind":{"Clause":{"Bound":[0,2]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2724},{"Deduplicated":49932},{"Deduplicated":2723}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[5182,{"kind":{"Clause":{"Bound":[0,3]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":2724}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[7,40]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":2834,"col":11},"end":{"line":2834,"col":36}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2723},{"Deduplicated":49601},{"Deduplicated":3160}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"all","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["all",0]}],"span":{"data":{"file_id":33,"beg":{"line":2831,"col":4},"end":{"line":2834,"col":37}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Tests if every element of the iterator matches a predicate."},{"DocComment":""},{"DocComment":" `all()` takes a closure that returns `true` or `false`. It applies"},{"DocComment":" this closure to each element of the iterator, and if they all return"},{"DocComment":" `true`, then so does `all()`. If any of them return `false`, it"},{"DocComment":" returns `false`."},{"DocComment":""},{"DocComment":" `all()` is short-circuiting; in other words, it will stop processing"},{"DocComment":" as soon as it finds a `false`, given that no matter what else happens,"},{"DocComment":" the result will also be `false`."},{"DocComment":""},{"DocComment":" An empty iterator returns `true`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert!(a.into_iter().all(|x| x > 0));"},{"DocComment":""},{"DocComment":" assert!(!a.into_iter().all(|x| x > 2));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `false`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert!(!iter.all(|x| x != 2));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":50677},{"Deduplicated":2162}],"output":{"Deduplicated":3160}},"default":{"id":149,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":49597},{"Deduplicated":2162},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[{"Deduplicated":50688},{"Deduplicated":49927}]}}},"kind":{"TraitMethod":[7,41]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":2888,"col":11},"end":{"line":2888,"col":36}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2723},{"Deduplicated":49601},{"Deduplicated":3160}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"any","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["any",0]}],"span":{"data":{"file_id":33,"beg":{"line":2885,"col":4},"end":{"line":2888,"col":37}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Tests if any element of the iterator matches a predicate."},{"DocComment":""},{"DocComment":" `any()` takes a closure that returns `true` or `false`. It applies"},{"DocComment":" this closure to each element of the iterator, and if any of them return"},{"DocComment":" `true`, then so does `any()`. If they all return `false`, it"},{"DocComment":" returns `false`."},{"DocComment":""},{"DocComment":" `any()` is short-circuiting; in other words, it will stop processing"},{"DocComment":" as soon as it finds a `true`, given that no matter what else happens,"},{"DocComment":" the result will also be `true`."},{"DocComment":""},{"DocComment":" An empty iterator returns `false`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert!(a.into_iter().any(|x| x > 0));"},{"DocComment":""},{"DocComment":" assert!(!a.into_iter().any(|x| x > 5));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `true`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert!(iter.any(|x| x != 2));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":50677},{"Deduplicated":2162}],"output":{"Deduplicated":3160}},"default":{"id":150,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":49597},{"Deduplicated":2162},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[{"Deduplicated":50688},{"Deduplicated":49927}]}}},"kind":{"TraitMethod":[7,42]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"P"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":2962,"col":11},"end":{"line":2962,"col":37}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":2723},{"Deduplicated":49904},{"Deduplicated":3160}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"find","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["find",0]}],"span":{"data":{"file_id":33,"beg":{"line":2959,"col":4},"end":{"line":2962,"col":38}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Searches for an element of an iterator that satisfies a predicate."},{"DocComment":""},{"DocComment":" `find()` takes a closure that returns `true` or `false`. It applies"},{"DocComment":" this closure to each element of the iterator, and if any of them return"},{"DocComment":" `true`, then `find()` returns [`Some(element)`]. If they all return"},{"DocComment":" `false`, it returns [`None`]."},{"DocComment":""},{"DocComment":" `find()` is short-circuiting; in other words, it will stop processing"},{"DocComment":" as soon as the closure returns `true`."},{"DocComment":""},{"DocComment":" Because `find()` takes a reference, and many iterators iterate over"},{"DocComment":" references, this leads to a possibly confusing situation where the"},{"DocComment":" argument is a double reference. You can see this effect in the"},{"DocComment":" examples below, with `&&x`."},{"DocComment":""},{"DocComment":" If you need the index of the element, see [`position()`]."},{"DocComment":""},{"DocComment":" [`Some(element)`]: Some"},{"DocComment":" [`position()`]: Iterator::position"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" assert_eq!(a.into_iter().find(|&x| x == 2), Some(2));"},{"DocComment":" assert_eq!(a.into_iter().find(|&x| x == 5), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Iterating over references:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" // `iter()` yields references i.e. `&i32` and `find()` takes a"},{"DocComment":" // reference to each element."},{"DocComment":" assert_eq!(a.iter().find(|&&x| x == 2), Some(&2));"},{"DocComment":" assert_eq!(a.iter().find(|&&x| x == 5), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping at the first `true`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.find(|&x| x == 2), Some(2));"},{"DocComment":""},{"DocComment":" // we can still use `iter`, as there are more elements."},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that `iter.find(f)` is equivalent to `iter.filter(f).next()`."}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":50677},{"Deduplicated":2162}],"output":{"Deduplicated":49623}},"default":{"id":151,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":49597},{"Deduplicated":2162},{"Deduplicated":49598}],"const_generics":[],"trait_refs":[{"Deduplicated":50688},{"Deduplicated":49905}]}}},"kind":{"TraitMethod":[7,43]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"B"},{"index":1,"name":"F"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":33,"beg":{"line":2994,"col":11},"end":{"line":2994,"col":41}},"generated_from_span":null},"origin":"WhereC