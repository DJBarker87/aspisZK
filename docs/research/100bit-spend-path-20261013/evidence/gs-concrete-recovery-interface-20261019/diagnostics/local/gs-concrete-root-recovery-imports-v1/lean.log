AspisR1.GSConcreteInterpolation.initial_state_contract {K : Type} [Field K] [BEq K] [LawfulBEq K] [DecidableEq K]
  (points : Array (K × K)) (hs : points.size = 1048576) (Q : CompPoly.CBivariate K)
  (hrun : AspisR1.GSConcreteInterpolation.initial points = some Q) :
  AspisR1.RRConcreteState.model (AspisR1.GSConcreteInterpolation.initialState Q) = Q.toPoly ∧
    (∀ i ≤ (AspisR1.GSConcreteInterpolation.initialState Q).maxX,
        (RRVectorRowPolynomialBridge.inputPolynomial (AspisR1.GSConcreteInterpolation.initialState Q).rows
              i).natDegree ≤
          112) ∧
      AspisR1.RRConcreteState.model (AspisR1.GSConcreteInterpolation.initialState Q) ≠ 0
