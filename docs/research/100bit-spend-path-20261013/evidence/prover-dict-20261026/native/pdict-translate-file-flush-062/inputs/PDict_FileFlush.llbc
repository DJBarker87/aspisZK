\n}\n#[cfg(kani)]\npub fn error_kind_eq(a: std::io::ErrorKind, b: std::io::ErrorKind) -> bool { a == b }\n#[cfg(kani)]\npub fn digest_update(state: &mut sha2::Sha256, data: &[u8]) {\n    use sha2::Digest;\n    state.update(data)\n}\n#[cfg(kani)]\npub fn digest_finalize(state: sha2::Sha256) -> [u8; 32] {\n    use sha2::Digest;\n    state.finalize().into()\n}\n#[cfg(kani)]\npub fn file_flush(file: &mut std::fs::File) -> std::io::Result<()> {\n    use std::io::Write;\n    file.flush()\n}\n"},{"id":1,"name":{"Local":"/rustc/library/std/src/fs.rs"},"crate_name":"std","contents":null},{"id":2,"name":{"Local":"/rustc/library/std/src/lib.rs"},"crate_name":"std","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/std/src/io/error.rs"},"crate_name":"std","contents":null},{"id":6,"name":{"Local":"/rustc/library/std/src/io/mod.rs"},"crate_name":"std","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/io/io_slice.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/io/mod.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/fmt/mod.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/std/src/sys/fs/unix.rs"},"crate_name":"std","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["pdict_native_readonly",0]},{"Ident":["file_flush",0]}]},{"key":{"Type":0},"value":[{"Ident":["std",0]},{"Ident":["fs",0]},{"Ident":["File",0]}]},{"key":{"Type":1},"value":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}]},{"key":{"Type":2},"value":[{"Ident":["std",0]},{"Ident":["io",0]},{"Ident":["error",0]},{"Ident":["Error",0]}]},{"key":{"TraitImpl":0},"value":[{"Ident":["std",0]},{"Ident":["fs",0]},{"Impl":{"Trait":0}}]},{"key":{"Fun":1},"value":[{"Ident