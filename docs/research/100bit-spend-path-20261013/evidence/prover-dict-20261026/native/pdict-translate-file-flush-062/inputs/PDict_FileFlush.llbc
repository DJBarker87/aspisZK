unbuffered reads and writes are required."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Creates a new file and write bytes to it (you can also use [`write`]):"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::fs::File;"},{"DocComment":" use std::io::prelude::*;"},{"DocComment":""},{"DocComment":" fn main() -> std::io::Result<()> {"},{"DocComment":"     let mut file = File::create(\"foo.txt\")?;"},{"DocComment":"     file.write_all(b\"Hello, world!\")?;"},{"DocComment":"     Ok(())"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Reads the contents of a file into a [`String`] (you can also use [`read`]):"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::fs::File;"},{"DocComment":" use std::io::prelude::*;"},{"DocComment":""},{"DocComment":" fn main() -> std::io::Result<()> {"},{"DocComment":"     let mut file = File::open(\"foo.txt\")?;"},{"DocComment":"     let mut contents = String::new();"},{"DocComment":"     file.read_to_string(&mut contents)?;"},{"DocComment":"     assert_eq!(contents, \"Hello, world!\");"},{"DocComment":"     Ok(())"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using a buffered [`Read`]er:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::fs::File;"},{"DocComment":" use std::io::BufReader;"},{"DocComment":" use std::io::prelude::*;"},{"DocComment":""},{"DocComment":" fn main() -> std::io::Result<()> {"},{"DocComment":"     let file = File::open(\"foo.txt\")?;"},{"DocComment":"     let mut buf_reader = BufReader::new(file);"},{"DocComment":"     let mut contents = String::new();"},{"DocComment":"     buf_reader.read_to_string(&mut contents)?;"},{"DocComment":"     assert_eq!(contents, \"Hello, world!\");"},{"DocComment":"     Ok(())"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that, although read and write methods require a `&mut File`, because"},{"DocComment":" of the interfaces for [`Read`] and [`Write`], the holder of a `&File` can"},{"DocComment":" still modify the file, either through methods that take `&File` or by"},{"DocComment":" retrieving the underlying OS object and modifying the file that way."},{"DocComment":" Additionally, many operating systems allow concurrent modification of files"},{"DocComment":" by different processes. Avoid assuming that holding a `&File` means that the"},{"DocComment":" file will not change."},{"DocComment":""},{"DocComment":" # Platform-specific behavior"},{"DocComment":""},{"DocComment":" On Windows, the implementation of [`Read`] and [`Write`] traits for `File`"},{"DocComment":" perform synchronous I/O operations. Therefore the underlying file must not"},{"DocComment":" have been opened for asynchronous I/O (e.g. by using `FILE_FLAG_OVERLAPPED`)."},{"DocComment":""},{"DocComment":" [`BufReader`]: io::BufReader"},{"DocComment":" [`BufWriter`]: io::BufWriter"},{"DocComment":" [`sync_all`]: File::sync_all"},{"DocComment":" [`write`]: File::write"},{"DocComment":" [`read`]: File::read"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"File"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":4,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":1,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}],"span":{"data":{"file_id":3,"beg":{"line":557,"col":0},"end":{"line":557,"col":21}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Result` is a type that repr