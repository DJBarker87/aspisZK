null],"trait_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["io",0]},{"Ident":["Write",0]}],"span":{"data":{"file_id":6,"beg":{"line":1384,"col":0},"end":{"line":1384,"col":15}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A trait for objects which are byte-oriented sinks."},{"DocComment":""},{"DocComment":" Implementors of the `Write` trait are sometimes called 'writers'."},{"DocComment":""},{"DocComment":" Writers are defined by two required methods, [`write`] and [`flush`]:"},{"DocComment":""},{"DocComment":" * The [`write`] method will attempt to write some data into the object,"},{"DocComment":"   returning how many bytes were successfully written."},{"DocComment":""},{"DocComment":" * The [`flush`] method is useful for adapters and explicit buffers"},{"DocComment":"   themselves for ensuring that all buffered data has been pushed out to the"},{"DocComment":"   'true sink'."},{"DocComment":""},{"DocComment":" Writers are intended to be composable with one another. Many implementors"},{"DocComment":" throughout [`std::io`] take and provide types which implement the `Write`"},{"DocComment":" trait."},{"DocComment":""},{"DocComment":" [`write`]: Write::write"},{"DocComment":" [`flush`]: Write::flush"},{"DocComment":" [`std::io`]: self"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::io::prelude::*;"},{"DocComment":" use std::fs::File;"},{"DocComment":""},{"DocComment":" fn main() -> std::io::Result<()> {"},{"DocComment":"     let data = b\"some bytes\";"},{"DocComment":""},{"DocComment":"     let mut pos = 0;"},{"DocComment":"     let mut buffer = File::create(\"foo.txt\")?;"},{"DocComment":""},{"DocComment":"     while pos < data.len() {"},{"DocComment":"         let bytes_written = buffer.write(&data[pos..])?;"},{"DocComment":"         pos += bytes_written;"},{"DocComment":"     }"},{"DocComment":"     Ok(())"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The trait also provides convenience methods like [`write_all`], which calls"},{"DocComment":" `write` in a loop until its entire input has been written."},{"DocComment":""},{"DocComment":" [`write_all`]: Write::write_all"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"IoWrite"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"write","item_meta":{"name":[{"Ident":["std",0]},{"Ident":["io",0]},{"Ident":["Write",0]},{"Ident":["write",0]}],"span":{"data":{"file_id":6,"beg":{"line":1431,"col":4},"end":{"line":1431,"col":53}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Writes a buffer into this writer, returning how many bytes were written."},{"DocComment":""},{"DocComment":" This function will attempt to write the entire contents of `buf`, but"},{"DocComment":" the entire write might not succeed, or the write may also generate an"},{"DocComment":" error. Typically, a call to `write` represents one attempt to write to"},{"DocComment":" any wrapped object."},{"DocComment":""},{"DocComment":" Calls to `write` are not guaranteed to block waiting for data to be"},{"DocComment":" written, and a write which would otherwise block can be indicated through"},{"DocComment":" an [`Err`] variant."},{"DocComment":""},{"DocComment":" If this method consumed `n > 0` bytes of `buf` it must return [`Ok(n)`]."},{"DocComment":" If the return value is `Ok(n)` then `n` must satisfy `n <= buf.len()`."},{"DocComment":" A return value of `Ok(0)` typically means that the underlying object is"},{"DocComment":" no longer able to accept bytes and will likely not be able to in the"},{"DocComment":" future as well, or that the buffer provided is empty."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" Each call to `write` may generate an I/O error indicating that the"},{"DocComment":" operation could not be completed. If an error is returned then no bytes"},{"DocComment":" in the buffer were written to this writer."},{"DocComment":""},{"DocComment":" It is **not** considered an error if the entire buffer could not be"},{"DocComment":" written to this writer."},{"DocComment":""},{"DocComment":" An error of the [`ErrorKind::Interrupted`] kind is non-fatal and the"},{"DocComment":" write operation should be retried if there is nothing else to do."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::io::prelude::*;"},{"DocComment":" use std::fs::File;"},{"DocComment":""},{"DocComment":" fn main() -> std::io::Result<()> {"},{"DocComment":"     let mut buffer = File::create(\"foo.txt\")?;"},{"DocComment":""},{"DocComment":"     // Writes some prefix of the byte string, not necessarily all of it."},{"DocComment":"     buffer.write(b\"some bytes\")?;"},{"DocComment":"     Ok(())"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Ok(n)`]: Ok"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[756,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":754},"Mut"]}]},{"HashConsedValue":[594,{"Ref":[{"Var":{"Bound":[0,1]}},{"Deduplicated":593},"Shared"]}]}],"output":{"Deduplicated":596}},"default":null},"kind":{"TraitMethod":[0,0]}},null,null,{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generic