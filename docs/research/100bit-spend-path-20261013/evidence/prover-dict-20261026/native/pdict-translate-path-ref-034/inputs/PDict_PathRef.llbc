l":0},"end":{"line":2357,"col":15}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A slice of a path (akin to [`str`])."},{"DocComment":""},{"DocComment":" This type supports a number of operations for inspecting a path, including"},{"DocComment":" breaking the path into its components (separated by `/` on Unix and by either"},{"DocComment":" `/` or `\\` on Windows), extracting the file name, determining whether the path"},{"DocComment":" is absolute, and so on."},{"DocComment":""},{"DocComment":" This is an *unsized* type, meaning that it must always be used behind a"},{"DocComment":" pointer like `&` or [`Box`]. For an owned version of this type,"},{"DocComment":" see [`PathBuf`]."},{"DocComment":""},{"DocComment":" More details about the overall approach can be found in"},{"DocComment":" the [module documentation](self)."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::path::Path;"},{"DocComment":" use std::ffi::OsStr;"},{"DocComment":""},{"DocComment":" // Note: this example does work on Windows"},{"DocComment":" let path = Path::new(\"./foo/bar.txt\");"},{"DocComment":""},{"DocComment":" let parent = path.parent();"},{"DocComment":" assert_eq!(parent, Some(Path::new(\"./foo\")));"},{"DocComment":""},{"DocComment":" let file_stem = path.file_stem();"},{"DocComment":" assert_eq!(file_stem, Some(OsStr::new(\"bar\")));"},{"DocComment":""},{"DocComment":" let extension = path.extension();"},{"DocComment":" assert_eq!(extension, Some(OsStr::new(\"txt\")));"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"Path"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":1,"beg":{"line":2358,"col":4},"end":{"line":2358,"col":16}},"generated_from_s