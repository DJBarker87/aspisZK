"Ident":["Digest",0]},{"Ident":["output_size",0]}],"span":{"data":{"file_id":14,"beg":{"line":51,"col":4},"end":{"line":51,"col":30}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Get output size of the hasher"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[],"output":{"Deduplicated":2175}},"default":null},"kind":{"TraitMethod":[25,9]}},{"params":{"regions":[],"types":[{"index":0,"name":"T1"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":14,"beg":{"line":54,"col":25},"end":{"line":54,"col":36}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":26,"generics":{"regions":[],"types":[{"Deduplicated":2080},{"Deduplicated":2893}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"digest","item_meta":{"name":[{"Ident":["digest",0]},{"Ident":["digest",0]},{"Ident":["Digest",0]},{"Ident":["digest",0]}],"span":{"data":{"file_id":14,"beg":{"line":54,"col":4},"end":{"line":54,"col":54}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Compute hash of `data`."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":2135}],"output":{"Deduplicated":8820}},"default":null},"kind":{"TraitMethod":[25,10]}}],"vtable":null},{"def_id":26,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["AsRef",0]}],"span":{"data":{"file_id":22,"beg":{"line":219,"col":0},"end":{"line":219,"col":52}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to do a cheap reference-to-reference conversion."},{"DocComment":""},{"DocComment":" This trait is similar to [`AsMut`] which is used for converting between mutable references."},{"DocComment":" If you need to do a costly conversion it is better to implement [`From`] with type"},{"DocComment":" `&T` or write a custom function."},{"DocComment":""},{"DocComment":" # Relation to `Borrow`"},{"DocComment":""},{"DocComment":" `AsRef` has the same signature as [`Borrow`], but [`Borrow`] is different in a few aspects:"},{"DocComment":""},{"DocComment":" - Unlike `AsRef`, [`Borrow`] has a blanket impl for any `T`, and can be used to accept either"},{"DocComment":"   a reference or a value. (See also note on `AsRef`'s reflexibility below.)"},{"DocComment":" - [`Borrow`] also requires that [`Hash`], [`Eq`] and [`Ord`] for a borrowed value are"},{"DocComment":"   equivalent to those of the owned value. For this reason, if you want to"},{"DocComment":"   borrow only a single field of a struct you can implement `AsRef`, but not [`Borrow`]."},{"DocComment":""},{"DocComment":" **Note: This trait must not fail**. If the conversion can fail, use a"},{"DocComment":" dedicated method which returns an [`Option<T>`] or a [`Result<T, E>`]."},{"DocComment":""},{"DocComment":" # Generic Implementations"},{"DocComment":""},{"DocComment":" `AsRef` auto-dereferences if the inner type is a reference or a mutable reference"},{"DocComment":" (e.g.: `foo.as_ref()` will work the same if `foo` has type `&mut Foo` or `&&mut Foo`)."},{"DocComment":""},{"DocComment":" Note that due to historic reasons, the above currently does not hold generally for all"},{"DocComment":" [dereferenceable types], e.g. `foo.as_ref()` will *not* work the same as"},{"DocComment":" `Box::new(foo).as_ref()`. Instead, many smart pointers provide an `as_ref` implementation which"},{"DocComment":" simply returns a reference to the [pointed-to value] (but do not perform a cheap"},{"DocComment":" reference-to-reference conversion for that value). However, [`AsRef::as_ref`] should not be"},{"DocComment":" used for the sole purpose of dereferencing; instead ['`Deref` coercion'] can be used:"},{"DocComment":""},{"DocComment":" [dereferenceable types]: core::ops::Deref"},{"DocComment":" [pointed-to value]: core::ops::Deref::Target"},{"DocComment":" ['`Deref` coercion']: core::ops::Deref#deref-coercion"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = Box::new(5i32);"},{"DocComment":" // Avoid this:"},{"DocComment":" // let y: &i32 = x.as_ref();"},{"DocComment":" // Better just write:"},{"DocComment":" let y: &i32 = &x;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Types which implement [`Deref`] should consider implementing `AsRef<T>` as follows:"},{"DocComment":""},{"DocComment":" [`Deref`]: core::ops::Deref"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use core::ops::Deref;"},{"DocComment":" # struct SomeType;"},{"DocComment":" # impl Deref for SomeType {"},{"DocComment":" #     type Target = [u8];"},{"DocComment":" #     fn deref(&self) -> &[u8] {"},{"DocComment":" #         &[]"},{"DocComment":" #     }"},{"DocComment":" # }"},{"DocComment":" impl<T> AsRef<T> for SomeType"},{"DocComment":" where"},{"DocComment":"     T: ?Sized,"},{"DocComment":"     <SomeType as Deref>::Target: AsRef<T>,"},{"DocComment":" {"},{"DocComment":"     fn as_ref(&self) -> &T {"},{"DocComment":"         self.deref().as_ref()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Reflexivity"},{"DocComment":""},{"DocComment":" Ideally, `AsRef` would be reflexive, i.e. there would be an `impl<T: ?Sized> AsRef<T> for T`"},{"DocComment":" with [`as_ref`] simply returning its argument unchanged."},{"DocComment":" Such a blanket implementation is currently *not* provided due to technical restrictions of"},{"DocComment":" Rust's type system (it would be overlapping with another existing blanket implementation for"},{"DocComment":" `&T where T: AsRef<U>` which allows `AsRef` to auto-dereference, see \"Generic Implementations\""},{"DocComment":" above)."},{"DocComment":""},{"DocComment":" [`as_ref`]: AsRef::as_ref"},{"DocComment":""},{"DocComment":" A trivial implementation of `AsRef<T> for T` must be added explicitly for a particular type `T`"},{"DocComment":" where needed or desired. Note, however, that not all types from `std` contain such an"},{"DocComment":" implementation, and those cannot be added by external code due to orphan rules."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" By using trait bounds we can accept arguments of different types as long as they can be"},{"DocComment":" converted to the specified type `T`."},{"DocComment":""},{"DocComment":" For example: By creating a generic function that takes an `AsRef<str>` we express that we"},{"DocComment":" want to accept all references that can be converted to [`&str`] as an argument."},{"DocComment":" Since both [`String`] and [`&str`] implement `AsRef<str>` we can accept both as input argument."},{"DocComment":""},{"DocComment":" [`&str`]: primitive@str"},{"DocComment":" [`Borrow`]: crate::borrow::Borrow"},{"DocComment":" [`Eq`]: crate::cmp::Eq"},{"DocComment":" [`Ord`]: crate::cmp::Ord"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn is_hello<T: AsRef<str>>(s: T) {"},{"DocComment":"    assert_eq!(\"hello\", s.as_ref());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let s = \"hello\";"},{"DocComment":" is_hello(s);"},{"DocComment":""},{"DocComment":" let s = \"hello\".to_string();"},{"DocComment":" is_hello(s);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"AsRef"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"region