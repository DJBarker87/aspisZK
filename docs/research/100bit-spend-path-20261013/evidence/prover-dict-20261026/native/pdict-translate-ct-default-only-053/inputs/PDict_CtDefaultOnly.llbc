st;\n    sha2::Sha256::new()\n}\n#[cfg(kani)]\npub fn error_kind_eq(a: std::io::ErrorKind, b: std::io::ErrorKind) -> bool { a == b }\n#[cfg(kani)]\npub fn digest_update(state: &mut sha2::Sha256, data: &[u8]) {\n    use sha2::Digest;\n    state.update(data)\n}\n#[cfg(kani)]\npub fn digest_finalize(state: sha2::Sha256) -> [u8; 32] {\n    use sha2::Digest;\n    state.finalize().into()\n}\n"},{"id":1,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/digest-0.10.7/src/core_api/wrapper.rs"},"crate_name":"digest","contents":null},{"id":2,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/digest-0.10.7/src/core_api.rs"},"crate_name":"digest","contents":null},{"id":3,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/digest-0.10.7/src/lib.rs"},"crate_name":"digest","contents":null},{"id":4,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/digest-0.10.7/src/core_api/ct_variable.rs"},"crate_name":"digest","contents":null},{"id":5,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/sha2-0.10.9/src/core_api.rs"},"crate_name":"sha2","contents":null},{"id":6,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/sha2-0.10.9/src/lib.rs"},"crate_name":"sha2","contents":null},{"id":7,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/typenum-1.20.1/src/uint.rs"},"crate_name":"typenum","contents":null},{"id":8,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/typenum-1.20.1/src/lib.rs"},"crate_name":"typenum","contents":null},{"id":9,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/typenum-1.20.1/src/bit.rs"},"crate_name":"typenum","contents":null},{"id":10,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/generic-array-0.14.7/src/lib.rs"},"crate_name":"generic_array","contents":null},{"id":11,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/typenum-1.20.1/src/type_operators.r