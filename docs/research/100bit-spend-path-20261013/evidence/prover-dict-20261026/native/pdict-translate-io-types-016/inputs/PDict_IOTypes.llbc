",0]}]},{"key":{"Type":11},"value":[{"Ident":["NonZero",0]}]},{"key":{"Type":12},"value":[{"Ident":["FileDesc",0]}]},{"key":{"TraitDecl":1},"value":[{"Ident":["Copy",0]}]},{"key":{"Type":14},"value":[{"Ident":["Buf",0]}]}],"type_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["fs",0]},{"Ident":["File",0]}],"span":{"data":{"file_id":0,"beg":{"line":135,"col":0},"end":{"line":135,"col":15}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An object providing access to an open file on the filesystem."},{"DocComment":""},{"DocComment":" An instance of a `File` can be read and/or written depending on what options"},{"DocComment":" it was opened with. Files also implement [`Seek`] to alter the logical cursor"},{"DocComment":" that the file contains internally."},{"DocComment":""},{"DocComment":" Files are automatically closed when they go out of scope.  Errors detected"},{"DocComment":" on closing are ignored by the implementation of `Drop`.  Use the method"},{"DocComment":" [`sync_all`] if these errors must be manually handled."},{"DocComment":""},{"DocComment":" `File` does not buffer reads and writes. For efficiency, consider wrapping the"},{"DocComment":" file in a [`BufReader`] or [`BufWriter`] when performing many small [`read`]"},{"DocComment":" or [`write`] calls, unless unbuffered reads and writes are required."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Creates a new file and write bytes to it (you can also use [`write`]):"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::fs::File;"},{"DocComment":" use std::io::prelude::*;"},{"DocComment":""},{"DocComment":" fn main() -> std::io::Result<()> {"},{"DocComment":"     let mut file = File::create(\"foo.txt\")?;"},{"DocComment":"     file.write_all(b\"Hello, world!\")?;"},{"DocComment":"     Ok(())"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Reads the contents of a file into a [`String`] (you can also use [`read`]):"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::fs::File;"},{"DocComment":" use std::io::prelude::*;"},{"DocComment":""},{"DocComment":" fn main() -> std::io::Result<()> {"},{"DocComment":"     let mut file = File::open(\"foo.txt\")?;"},{"DocComment":"     let mut contents = String::new();"},{"DocComment":"     file.read_to_string(&mut contents)?;"},{"DocComment":"     assert_eq!(contents, \"Hello, world!\");"},{"DocComment":"     Ok(())"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Using a buffered [`Read`]er:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::fs::File;"},{"DocComment":" use std::io::BufReader;"},{"DocComment":" use std::io::prelude::*;"},{"DocComment":""},{"DocComment":" fn main() -> std::io::Result<()> {"},{"DocComment":"     let file = File::open(\"foo.txt\")?;"},{"DocComment":"     let mut buf_reader = BufReader::new(file);"},{"DocComment":"     let mut contents = String::new();"},{"DocComment":"     buf_reader.read_to_string(&mut contents)?;"},{"DocComment":"     assert_eq!(contents, \"Hello, world!\");"},{"DocComment":"     Ok(())"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that, although read and write methods require a `&mut File`, because"},{"DocComment":" of the interfaces for [`Read`] and [`Write`], the holder of a `&File` can"},{"DocComment":" still modify the file, either through methods that take `&File` or by"},{"DocComment":" retrieving the underlying OS object and modifying the file that way."},{"DocComment":" Additionally, many operating systems allow concurrent modification of files"},{"DocComment":" by different processes. Avoid assuming that holding a `&File` means that the"},{"DocComment":" file will not change."},{"DocComment":""},{"DocComment":" # Platform-specific behavior"},{"DocComment":""},{"DocComment":" On Windows, the implementation of [`Read`] and [`Write`] traits for `File`"},{"DocComment":" perform synchronous I/O operations. Therefore the underlying file must not"},{"DocComment":" have been opened for asynchronous I/O (e.g. by using `FILE_FLAG_OVERLAPPED`)."},{"DocComment":""},{"DocComment":" [`BufReader`]: io::BufReader"},{"DocComment":" [`BufWriter`]: io::BufWriter"},{"DocComment":" [`sync_all`]: File::sync_all"},{"DocComment":" [`write`]: File::write"},{"DocComment":" [`read`]: File::read"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"File"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":0,"beg":{"line":136,"col":4},"end":{"line":136,"col":23}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"inner","ty":{"HashConsedValue":[1537,{"Adt":{"id":{"Adt":6},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":4,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":1,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["fs",0]},{"Ident":["OpenOptions",0]}],"span":{"data":{"file_id":0,"beg":{"line":275,"col":0},"end":{"line":275,"col":22}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Options and flags which can be used to configure how a file is opened."},{"DocComment":""},{"DocComment":" This builder exposes the ability to configure how a [`File`] is opened and"},{"DocComment":" what operations are permitted on the open file. The [`File::open`] and"},{"DocComment":" [`File::create`] methods are aliases for commonly used options using this"},{"DocComment":" builder."},{"DocComment":""},{"DocComment":" Generally speaking, when using `OpenOptions`, you'll first call"},{"DocComment":" [`OpenOptions::new`], then chain calls to methods to set each option, then"},{"DocComment":" call [`OpenOptions::open`], passing the path of the file you're trying to"},{"DocComment":" open. This will give you a [`io::Result`] with a [`File`] inside that you"},{"DocComment":" can further operate on."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Opening a file to read:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::fs::OpenOptions;"},{"DocComment":""},{"DocComment":" let file = OpenOptions::new().read(true).open(\"foo.txt\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Opening a file for both reading and writing, as well as creating it if it"},{"DocComment":" doesn't exist:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::fs::OpenOptions;"},{"DocComment":""},{"DocComment":" let file = OpenOptions::new()"},{"DocComment":"             .read(true)"},{"DocComment":"             .write(true)"},{"DocComment":"             .create(true)"},{"DocComment":"             .open(\"foo.txt\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"FsOpenOptions"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":0,"beg":{"line":275,"col":23},"end":{"line":275,"col":42}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":null,"ty":{"HashConsedValue":[1538,{"Adt":{"id":{"Adt":7},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":16,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":2,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["path",0]},{"Ident":["Path",0]}],"span":{"data":{"file_id":2,"beg":{"line":2357,"col":0},"end":{"line":2357,"col":15}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A slice of a path (akin to [`str`])."},{"DocComment":""},{"DocComment":" This type supports a number of operations for inspecting a path, including"},{"DocComment":" breaking the path into its components (separated by `/` on Unix and by either"},{"DocComment":" `/` or `\\` on Windows), extracting the file name, determining whether the path"},{"DocComment":" is absolute, and so on."},{"DocComment":""},{"DocComment":" This is an *unsized* type, meaning that it must always be used behind a"},{"DocComment":" pointer like `&` or [`Box`]. For an owned version of this type,"},{"DocComment":" see [`PathBuf`]."},{"DocComment":""},{"DocComment":" More details about the overall approach can be found in"},{"DocComment":" the [module documentation](self)."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::path::Path;"},{"DocComment":" use std::ffi::OsStr;"},{"DocComment":""},{"DocComment":" // Note: this example does work on Windows"},{"DocComment":" let path = Path::new(\"./foo/bar.txt\");"},{"DocComment":""},{"DocComment":" let parent = path.parent();"},{"DocComment":" assert_eq!(parent, Some(Path::new(\"./foo\")));"},{"DocComment":""},{"DocComment":" let file_stem = path.file_stem();"},{"DocComment":" assert_eq!(file_stem, Some(OsStr::new(\"bar\")));"},{"DocComment":""},{"DocComment":" let extension = path.extension();"},{"DocComment":" assert_eq!(extension, Some(OsStr::new(\"txt\")));"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"Path"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":2,"beg":{"line":2358,"col":4},"end":{"line":2358,"col":16}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"inner","ty":{"HashConsedValue":[1539,{"Adt":{"id":{"Adt":8},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":null,"align":null,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":3,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["path",0]},{"Ident":["PathBuf",0]}],"span":{"data":{"file_id":2,"beg":{"line":1214,"col":0},"end":{"line":1214,"col":18}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An owned, mutable path (akin to [`String`])."},{"DocComment":""},{"DocComment":" This type provides methods like [`push`] and [`set_extension`] that mutate"},{"DocComment":" the path in place. It also implements [`Deref`] to [`Path`], meaning that"},{"DocComment":" all methods on [`Path`] slices are available on `PathBuf` values as well."},{"DocComment":""},{"DocComment":" [`push`]: PathBuf::push"},{"DocComment":" [`set_extension`]: PathBuf::set_extension"},{"DocComment":""},{"DocComment":" More details about the overall approach can be found in"},{"DocComment":" the [module documentation](self)."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" You can use [`push`] to build up a `PathBuf` from"},{"DocComment":" components:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::path::PathBuf;"},{"DocComment":""},{"DocComment":" let mut path = PathBuf::new();"},{"DocComment":""},{"DocComment":" path.push(r\"C:\\\");"},{"DocComment":" path.push(\"windows\");"},{"DocComment":" path.push(\"system32\");"},{"DocComment":""},{"DocComment":" path.set_extension(\"dll\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However, [`push`] is best used for dynamic situations. This is a better way"},{"DocComment":" to do this when you know all of the components ahead of time:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::path::PathBuf;"},{"DocComment":""},{"DocComment":" let path: PathBuf = [r\"C:\\\", \"windows\", \"system32.dll\"].iter().collect();"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" We can still do better than this! Since these are all strings, we can use"},{"DocComment":" `From::from`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::path::PathBuf;"},{"DocComment":""},{"DocComment":" let path = PathBuf::from(r\"C:\\windows\\system32.dll\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Which method works best depends on what kind of situation you're in."},{"DocComment":""},{"DocComment":" Note that `PathBuf` does not always sanitize arguments, for example"},{"DocComment":" [`push`] allows paths built from strings which include separators:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::path::PathBuf;"},{"DocComment":""},{"DocComment":" let mut path = PathBuf::new();"},{"DocComment":""},{"DocComment":" path.push(r\"C:\\\");"},{"DocComment":" path.push(\"windows\");"},{"DocComment":" path.push(r\"..\\otherdir\");"},{"DocComment":" path.push(\"system32\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The behavior of `PathBuf` may be changed to a panic on such inputs"},{"DocComment":" in the future. [`Extend::extend`] should be used to add multi-part paths."}],"inline":null,"rename":null,"public":