},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":null,"align":null,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":9,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["ffi",0]},{"Ident":["os_str",0]},{"Ident":["OsString",0]}],"span":{"data":{"file_id":10,"beg":{"line":93,"col":0},"end":{"line":93,"col":19}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A type that can represent owned, mutable platform-native strings, but is"},{"DocComment":" cheaply inter-convertible with Rust strings."},{"DocComment":""},{"DocComment":" The need for this type arises from the fact that:"},{"DocComment":""},{"DocComment":" * On Unix systems, strings are often arbitrary sequences of non-zero"},{"DocComment":"   bytes, in many cases interpreted as UTF-8."},{"DocComment":""},{"DocComment":" * On Windows, strings are often arbitrary sequences of non-zero 16-bit"},{"DocComment":"   values, interpreted as UTF-16 when it is valid to do so."},{"DocComment":""},{"DocComment":" * In Rust, strings are always valid UTF-8, which may contain zeros."},{"DocComment":""},{"DocComment":" `OsString` and [`OsStr`] bridge this gap by simultaneously representing Rust"},{"DocComment":" and platform-native string values, and in particular allowing a Rust string"},{"DocComment":" to be converted into an \"OS\" string with no cost if possible. A consequence"},{"DocComment":" of this is that `OsString` instances are *not* `NUL` terminated; in order"},{"DocComment":" to pass to e.g., Unix system call, you should create a [`CStr`]."},{"DocComment":""},{"DocComment":" `OsString` is to <code>&[OsStr]</code> as [`String`] is to <code>&[str]</code>: the former"},{"DocComment":" in each pair are owned strings; the latter are borrowed"},{"DocComment":" references."},{"DocComment":""},{"DocComment":" Note, `OsString` and [`OsStr`] internally do not necessarily hold strings in"},{"DocComment":" the form native to the platform; While on Unix, strings are stored as a"},{"DocComment":" sequence of 8-bit values, on Windows, where strings are 16-bit value based"},{"DocComment":" as just discussed, strings are also actually stored as a sequence of 8-bit"},{"DocComment":" values, encoded in a less-strict variant of UTF-8. This is useful to"},{"DocComment":" understand when handling capacity and length values."},{"DocComment":""},{"DocComment":" # Capacity of `OsString`"},{"DocComment":""},{"DocComment":" Capacity uses units of UTF-8 bytes for OS strings which were created from valid unicode, and"},{"DocComment":" uses units of bytes in an unspecified encoding for other contents. On a given target, all"},{"DocComment":" `OsString` and `OsStr` values use the same units for capacity, so the following will work:"},{"DocComment":" ```"},{"DocComment":" use std::ffi::{OsStr, OsString};"},{"DocComment":""},{"DocComment":" fn concat_os_strings(a: &OsStr, b: &OsStr) -> OsString {"},{"DocComment":"     let mut ret = OsString::with_capacity(a.len() + b.len()); // This will allocate"},{"DocComment":"     ret.push(a); // This will not allocate further"},{"DocComment":"     ret.push(b); // This will not allocate further"},{"DocComment":"     ret"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Creating an `OsString`"},{"DocComment":""},{"DocComment":" **From a Rust string**: `OsString` implements"},{"DocComment":" <code>[From]<[String]></code>, so you can use <code>my_string.[into]\\()</code> to"},{"DocComment":" create an `OsString` from a normal Rust string."},{"DocComment":""},{"DocComment":" **From slices:** Just like you can start with an empty Rust"},{"DocComment":" [`String`] and then [`String::push_str`] some <code>&[str]</code>"},{"DocComment":" sub-string slices into it, you can create an empty `OsString` with"},{"DocComment":" the [`OsString::new`] method and then push string slices into it with the"},{"DocComment":" [`OsString::push`] method."},{"DocComment":""},{"DocComment":" # Extracting a borrowed reference to the whole OS string"},{"DocComment":""},{"DocComment":" You can use the [`OsString::as_os_str`] method to get an <code>&[OsStr]</code> from"},{"DocComment":" an `OsString`; this is effectively a borrowed reference to the"},{"DocComment":" whole string."},{"DocComment":""},{"DocComment":" # Conversions"},{"DocComment":""},{"DocComment":" See the [module's toplevel documentation about conversions][conversions] for a discussion on"},{"DocComment":" the traits which `OsString` implements for [conversions] from/to native representations."},{"DocComment":""},{"DocComment":" [`CStr`]: crate::ffi::CStr"},{"DocComment":" [conversions]: super#conversions"},{"DocComment":" [into]: Into::into"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"OsString"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":10,"beg":{"line":94,"col":4},"end":{"line":94,"col":14}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"inner","ty":{"HashConsedValue":[1546,{"Adt":{"id":{"Adt":14},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":10,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["collections",0]},{"Ident":["TryReserveErrorKind",0]}],"span":{"data":{"file_id":3,"beg