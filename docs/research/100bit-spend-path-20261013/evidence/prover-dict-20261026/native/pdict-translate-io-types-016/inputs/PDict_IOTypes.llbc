lloc/mod.rs"},"crate_name":"core","contents":null},{"id":21,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":22,"name":{"Local":"/rustc/library/core/src/num/niche_types.rs"},"crate_name":"core","contents":null},{"id":23,"name":{"Local":"/rustc/library/std/src/os/fd/owned.rs"},"crate_name":"std","contents":null},{"id":24,"name":{"Local":"/rustc/library/std/src/os/fd/mod.rs"},"crate_name":"std","contents":null},{"id":25,"name":{"Local":"/rustc/library/std/src/os/mod.rs"},"crate_name":"std","contents":null},{"id":26,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":27,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":28,"name":{"Local":"/rustc/library/core/src/mem/alignment.rs"},"crate_name":"core","contents":null},{"id":29,"name":{"Local":"/rustc/library/core/src/mem/mod.rs"},"crate_name":"core","contents":null},{"id":30,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":31,"name":{"Local":"crates/aspis-r1-cost-probe/src/lib.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! UNPROVED R1 COST PROBE. P2 only; no production entrypoint.\n#![no_std]\nextern crate alloc;\npub mod sampler;\npub mod semantic_wire;\npub mod semantic;\npub mod fast_domain;\npub mod fast_dots;\npub mod fast_pairing;\n\n#[cfg(feature = \"prover\")]\nextern crate std;\npub mod r1_wire;\npub mod r1_semantic;\npub mod trace;\npub mod transport;\npub mod weights;\npub mod transcript;\npub mod verifier;\n#[cfg(feature = \"prover\")]\npub mod prover;\n/// Host client for the selected public proof-account nonce route (D162).\n#[cfg(feature = \"r1p-check\")]\n#[allow(non_snake_case)]\npub mod RealR1_client;\n#[cfg(feature = \"prover\")]\npub mod dense;\n/// G-sim (LOG D44.3): the explicit R1 simulator simE in the ideal game.\n#[cfg(feature = \"r1p-check\")]\npub mod sim;\n\n#[cfg(feature=\"prover\")] mod host_sumcheck;\n#[cfg(feature=\"prover\")] mod host_semantic;\n#[cfg(feature=\"prover\")] mod host_commitment;\n#[cfg(feature=\"prover\")] mod host_tree;\n#[cfg(feature=\"prover\")] mod host_transcript;\n#[cfg(feature=\"prover\")] mod host_wire;\n#[cfg(feature=\"prover\")] mod host_compact;\n\n// Adopted R1 proof format (PREREG-PROOF-SIZE-2, 2026-10-19): compact QM31\n// storage and binary multiproofs. UNPROVED: see PROOF-SIZE-OBLIGATIONS.\npub mod multiproof;\npub mod compact;\n\n#[cfg(not(feature=\"private-leaf-salts\"))]\ncompile_error!(\"the adopted R1 proof format is defined over private leaf salts; enable `private-leaf-salts` (a default feature)\");\n#[cfg(all(feature=\"audit-eight-way\",feature=\"prover\"))]\ncompile_error!(\"`audit-eight-way` is audit-only: it is never combined with the prover (PREREG-PROOF-SIZE-2 item 4)\");\n#[cfg(all(feature=\"audit-eight-way\",any(target_os=\"solana\",feature=\"program-build\")))]\ncompile_error!(\"`audit-eight-way` is audit-only: it is never built for a program (PREREG-PROOF-SIZE-2 item 4)\");\n\n#[cfg(all(feature = \"ct-host-prover\", feature = \"program-build\"))]\ncompile_error!(\"ct-host-prover is host-prover only, incompatible with program-build\");\n\n#[cfg(feature = \"ct-host-prover\")]\nmod ct_pole;\n\n// Fixed public-shape scheduling for the host CT adoption candidate.\n#[cfg(feature=\"ct-host-prover\")]\npub mod host_work;\n"}],"item_names":[{"key":{"Type":0},"value":[{"Ident":["std",0]},{"Ident":["fs",0]},{"Ident":["File",0]}]},{"key":{"Type":1},"value":[{"Ident":["std",0]},{"Ident":["fs",0]},{"Ident":["OpenOptions",0]}]},{"key":{"Type":2},"value":[{"Ident":["std",0]},{"Ident":["path",0]},{"Ident":["Path",0]}]},{"key":{"Type":3},"value":[{"Ident":["std",0]},{"Ident":["path",0]},{"Ident":["PathBuf",0]}]},{"key":{"Type":4},"value":[{"Ident":["alloc",0]},{"Ident":["collections",0]},{"Ident":["TryReserveError",0]}]},{"key":{"Type":5},"value":[{"Ident":["getrandom",0]},{"Ident":["error",0]},{"Ident":["Error",0]}]},{"key":{"T