,{"span":{"data":{"file_id":10,"beg":{"line":205,"col":5},"end":{"line":205,"col":5}},"generated_from_span":null},"id":1828,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":10,"beg":{"line":205,"col":5},"end":{"line":205,"col":5}},"generated_from_span":null},"id":1829,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":72,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":4202},"kind":"InherentImplBlock"}}},{"Ident":["chunks_exact_mut",0]}],"span":{"data":{"file_id":29,"beg":{"line":1291,"col":4},"end":{"line":1291,"col":88}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns an iterator over `chunk_size` elements of the slice at a time, starting at the"},{"DocComment":" beginning of the slice."},{"DocComment":""},{"DocComment":" The chunks are mutable slices, and do not overlap. If `chunk_size` does not divide the"},{"DocComment":" length of the slice, then the last up to `chunk_size-1` elements will be omitted and can be"},{"DocComment":" retrieved from the `into_remainder` function of the iterator."},{"DocComment":""},{"DocComment":" Due to each chunk having exactly `chunk_size` elements, the compiler can often optimize the"},{"DocComment":" resulting code better than in the case of [`chunks_mut`]."},{"DocComment":""},{"DocComment":" See [`chunks_mut`] for a variant of this iterator that also returns the remainder as a"},{"DocComment":" smaller chunk, and [`rchunks_exact_mut`] for the same iterator but starting at the end of"},{"DocComment":" the slice."},{"DocComment":""},{"DocComment":" If your `chunk_size` is a constant, consider using [`as_chunks_mut`] instead, which will"},{"DocComment":" give references to arrays of exactly that length, rather than slices."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `chunk_size` is zero."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = &mut [0, 0, 0, 0, 0];"},{"DocComment":" let mut count = 1;"},{"DocComment":""},{"DocComment":" for chunk in v.chunks_exact_mut(2) {"},{"DocComment":"     for elem in chunk.iter_mut() {"},{"DocComment":"         *elem += count;"},{"DocComment":"     }"},{"DocComment":"     count += 1;"},{"DocComment":" }"},{"DocComment":" assert_eq!(v, &[1, 1, 2, 2, 0]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`chunks_mut`]: slice::chunks_mut"},{"DocComment":" [`rchunks_exact_mut`]: slice::rchunks_exact_mut"},{"DocComment":" [`as_chunks_mut`]: slice::as_chunks_mut"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":29567},{"Deduplicated":2181}],"output":{"HashConsedValue":[29566,{"Adt":{"id":{"Adt":31},"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":29317}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":73,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":4202},"kind":"InherentImplBlock"}}},{"Ident":["iter",0]}],"span":{"data":{"file_id":29,"beg":{"line":1041,"col":4},"end":{"line":1041,"col":43}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns an iterator over the slice."},{"DocComment":""},{"DocComment":" The iterator yields all items from start to end."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = &[1, 2, 4];"},{"DocComment":" let mut iterator = x.iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iterator.next(), Some(&1));"},{"DocComment":" assert_eq!(iterator.next(), Some(&2));"},{"DocComment":" assert_eq!(iterator.next(), Some(&4));"},{"DocComment":" assert_eq!(iterator.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"slice_iter"},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[29967,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":29564},"Shared"]}]}],"output":{"HashConsedValue":[29576,{"Adt":{"id":{"Adt":32},"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":29317}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":74,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["zip",0]}],"span":{"data":{"file_id":33,"beg":{"line":629,"col":4},"end":{"line":632,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" 'Zips up' two iterators into a single iterator of pairs."},{"DocComment":""},{"DocComment":" `zip()` returns a new iterator that will iterate over two other"},{"DocComment":" iterators, returning a tuple where the first element comes from the"},{"DocComment":" first iterator, and the second element comes from the second iterator."},{"DocComment":""},{"DocComment":" In other words, it zips two iterators together, into a single one."},{"DocComment":""},{"DocComment":" If either iterator returns [`None`], [`next`] from the zipped iterator"},{"DocComment":" will return [`None`]."},{"DocComment":" If the zipped iterator has no more elements to return then each further attempt to advance"},{"DocComment":" it will first try to advance the first iterator at most one time and if it still yielded an item"},{"DocComment":" try to advance the second iterator at most one time."},{"DocComment":""},{"DocComment":" To 'undo' the result of zipping up two iterators, see [`unzip`]."},{"DocComment":""},{"DocComment":" [`unzip`]: Iterator::unzip"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s1 = \"abc\".chars();"},{"DocComment":" let s2 = \"def\".chars();"},{"DocComment":""},{"DocComment":" let mut iter = s1.zip(s2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(('a', 'd')));"},{"DocComment":" assert_eq!(iter.next(), Some(('b', 'e')));"},{"DocComment":" assert_eq!(iter.next(), Some(('c', 'f')));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since the argument to `zip()` uses [`IntoIterator`], we can pass"},{"DocComment":" anything that can be converted into an [`Iterator`], not just an"},{"DocComment":" [`Iterator`] itself. For example, arrays (`[T]`) implement"},{"DocComment":" [`IntoIterator`], and so can be passed to `zip()` directly:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a1 = [1, 2, 3];"},{"DocComment":" let a2 = [4, 5, 6];"},{"DocComment":""},{"DocComment":" let mut iter = a1.into_iter().zip(a2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some((1, 4)));"},{"DocComment":" assert_eq!(iter.next(), Some((2, 5)));"},{"DocComment":" assert_eq!(iter.next(), Some((3, 6)));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `zip()` is often used to zip an infinite iterator to a finite one."},{"DocComment":" This works because the finite iterator will eventually return [`None`],"},{"DocComment":" ending the zipper. Zipping with `(0..)` can look a lot like [`enumerate`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let enumerate: Vec<_> = \"foo\".chars().enumerate().collect();"},{"DocComment":""},{"DocComment":" let zipper: Vec<_> = (0..).zip(\"foo\".chars()).collect();"},{"DocComment":""},{"DocComment":" assert_eq!((0, 'f'), enumerate[0]);"},{"DocComment":" assert_eq!((0, 'f'), zipper[0]);"},{"DocComment":""},{"DocComment":" assert_eq!((1, 'o'), enumerate[1]);"},{"DocComment":" assert_eq!((1, 'o'), zipper[1]);"},{"DocComment":""},{"DocComment":" assert_eq!((2, 'o'), enumerate[2]);"},{"DocComment":" assert_eq!((2, 'o'), zipper[2]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If both iterators have roughly equivalent syntax, it may be more readable to use [`zip`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::iter::zip;"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":" let b = [2, 3, 4];"},{"DocComment":""},{"DocComment":" let mut zipped = zip("},{"DocComment":"     a.into_iter().map(|x| x * 2).skip(1),"},{"DocComment":"     b.into_iter().map(|x| x * 2).skip(1),"},{"DocComment":" );"},{"DocComment":""},{"DocComment":" assert_eq!(zipped.next(), Some((4, 6)));"},{"DocComment":" assert_eq!(zipped.next(), Some((6, 8)));"},{"DocComment":" assert_eq!(zipped.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" compared to:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # let a = [1, 2, 3];"},{"DocComment":" # let b = [2, 3, 4];"},{"DocComment":" #"},{"DocComment":" let mut zipped = a"},{"DocComment":"     .into_iter()"},{"DocComment":"     .map(|x| x * 2)"},{"DocComment":"     .skip(1)"},{"DocComment":"     .zip(b.into_iter().map(|x| x * 2).skip(1));"},{"DocComment":" #"},{"DocComment":" # assert_eq!(zipped.next(), Some((4, 6)));"},{"DocComment":" # assert_eq!(zipped.next(), Some((6, 8)));"},{"DocComment":" # assert_eq!(zipped.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`enumerate`]: Iterator::enumerate"},{"DocComment":" [`next`]: Iterator::next"},{"DocComment":" [`zip`]: crate::iter::zip"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"U"},{"index":2,"name":"Clause0_Item"},{"index":3,"name":"Clause1_Item"},{"index":4,"name":"Clause1_IntoIter"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":31,"generics":{"regions":[],"types":[{"Deduplicated":29317},{"Deduplicated":29318}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":33,"beg":{"line":632,"col":11},"end":{"line":632,"col":23}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":32,"generics":{"regions":[],"types":[{"Deduplicated":29319},{"Deduplicated":29320},{"Deduplicated":29321}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":29317},{"Deduplicated":29319}],"output":{"HashConsedValue":[29968,{"Adt":{"id":{"Adt":30},"generics":{"regions":[],"types":[{"Deduplicated":29317},{"Deduplicated":29321}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitDecl":{"trait_ref":{"id":31,"generics":{"regions":[],"types":[{"Deduplicated":29317},{"Deduplicated":29318}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":9}}},"is_global_initializer":null,"body":"Opaque"},{"def_id":75,"item_meta":{"n