},"generated_from_span":null},"id":3686,"kind":{"Drop":{"place":{"kind":{"Projection":[{"kind":{"Projection":[{"kind":{"Local":1},"ty":{"Deduplicated":30117}},"Deref"]},"ty":{"Deduplicated":29528}},{"Field":[{"Adt":[0,null]},1]}]},"ty":{"Deduplicated":29322}},"fn_ptr":{"kind":{"Fun":{"Regular":346}},"generics":{"regions":[{"Body":3}],"types":[{"Deduplicated":29318},{"Deduplicated":29319},{"Deduplicated":29320},{"Deduplicated":29321}],"const_generics":[],"trait_refs":[{"Deduplicated":29939},{"Deduplicated":29600},{"Deduplicated":29601},{"Deduplicated":29940}]}},"kind":"Precise","on_unwind":{"span":{"data":{"file_id":88,"beg":{"line":825,"col":0},"end":{"line":827,"col":24}},"generated_from_span":null},"statements":[{"span":{"data":{"file_id":88,"beg":{"line":825,"col":0},"end":{"line":827,"col":24}},"generated_from_span":null},"id":3684,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":88,"beg":{"line":825,"col":0},"end":{"line":827,"col":24}},"generated_from_span":null},"id":3685,"kind":"UnwindResume","comments_before":[]}]}}},"comments_before":[]},{"span":{"data":{"file_id":88,"beg":{"line":825,"col":0},"end":{"line":827,"col":24}},"generated_from_span":null},"id":3687,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":88,"beg":{"line":825,"col":0},"end":{"line":827,"col":24}},"generated_from_span":null},"id":3688,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":238,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["raw",0]},{"Ident":["from_raw_parts",0]}],"span":{"data":{"file_id":50,"beg":{"line":124,"col":0},"end":{"line":124,"col":80}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Forms a slice from a pointer and a length."},{"DocComment":""},{"DocComment":" The `len` argument is the number of **elements**, not the number of bytes."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Behavior is undefined if any of the following conditions are violated:"},{"DocComment":""},{"DocComment":" * `data` must be non-null, [valid] for reads for `len * size_of::<T>()` many bytes,"},{"DocComment":"   and it must be properly aligned. This means in particular:"},{"DocComment":""},{"DocComment":"     * The entire memory range of this slice must be contained within a single allocation!"},{"DocComment":"       Slices can never span across multiple allocations. See [below](#incorrect-usage)"},{"DocComment":"       for an example incorrectly not taking this into account."},{"DocComment":"     * `data` must be non-null and aligned even for zero-length slices or slices of ZSTs. One"},{"DocComment":"       reason for this is that enum layout optimizations may rely on references"},{"DocComment":"       (including slices of any length) being aligned and non-null to distinguish"},{"DocComment":"       them from other data. You can obtain a pointer that is usable as `data`"},{"DocComment":"       for zero-length slices using [`NonNull::dangling()`]."},{"DocComment":""},{"DocComment":" * `data` must point to `len` consecutive properly initialized values of type `T`."},{"DocComment":""},{"DocComment":" * The memory referenced by the returned slice must not be mutated for the duration"},{"DocComment":"   of lifetime `'a`, except inside an `UnsafeCell`."},{"DocComment":""},{"DocComment":" * The total size `len * size_of::<T>()` of the slice must be no larger than `isize::MAX`,"},{"DocComment":"   and adding that size to `data` must not \"wrap around\" the address space."},{"DocComment":"   See the safety documentation of [`pointer::offset`]."},{"DocComment":""},{"DocComment":" # Caveat"},{"DocComment":""},{"DocComment":" The lifetime for the returned slice is inferred from its usage. To"},{"DocComment":" prevent accidental misuse, it's suggested to tie the lifetime to whichever"},{"DocComment":" source lifetime is safe in the context, such as by providing a helper"},{"DocComment":" function taking the lifetime of a host value for the slice, or by explicit"},{"DocComment":" annotation."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::slice;"},{"DocComment":""},{"DocComment":" // manifest a slice for a single element"},{"DocComment":" let x = 42;"},{"DocComment":" let ptr = &x as *const _;"},{"DocComment":" let slice = unsafe { slice::from_raw_parts(ptr, 1) };"},{"DocComment":" assert_eq!(slice[0], 42);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ### Incorrect usage"},{"DocComment":""},{"DocComment":" The following `join_slices` function is **unsound** ⚠️"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use std::slice;"},{"DocComment":""},{"DocComment":" fn join_slices<'a, T>(fst: &'a [T], snd: &'a [T]) -> &'a [T] {"},{"DocComment":"     let fst_end = fst.as_ptr().wrapping_add(fst.len());"},{"DocComment":"     let snd_start = snd.as_ptr();"},{"DocComment":"     assert_eq!(fst_end, snd_start, \"Slices must be contiguous!\");"},{"DocComment":"     unsafe {"},{"DocComment":"         // The assertion above ensures `fst` and `snd` are contiguous, but they might"},{"DocComment":"         // still be contained within _different allocations_, in which case"},{"DocComment":"         // creating this slice is undefined behavior."},{"DocComment":"         slice::from_raw_parts(fst.as_ptr(), fst.len() + snd.len())"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     // `a` and `b` are different allocations..."},{"DocComment":"     let a = 42;"},{"DocComment":"     let b = 27;"},{"DocComment":"     // ... which may nevertheless be laid out contiguously in memory: | a | b |"},{"DocComment":"     let _ = join_slices(slice::from_ref(&a), slice::from_ref(&b)); // UB"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ### FFI: Handling null pointers"},{"DocComment":""},{"DocComment":" In languages such as C++, pointers to empty collections are not guaranteed to be non-null."},{"DocComment":" When accepting such pointers, they have to be checked for null-ness to avoid undefined"},{"DocComment":" behavior."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::slice;"},{"DocComment":""},{"DocComment":" /// Sum the elements of an FFI slice."},{"DocComment":" ///"},{"DocComment":" /// # Safety"},{"DocComment":" ///"},{"DocComment":" /// If ptr is not NULL, it must be correctly aligned and"},{"DocComment":" /// point to `len` initialized items of type `f32`."},{"DocComment":" unsafe extern \"C\" fn sum_slice(ptr: *const f32, len: usize) -> f32 {"},{"DocComment":"     let data = if ptr.is_null() {"},{"DocComment":"         // `len` is assumed to be 0."},{"DocComment":"         &[]"},{"DocComment":"     } else {"},{"DocComment":"         // SAFETY: see function docstring."},{"DocComment":"         unsafe { slice::from_raw_parts(ptr, len) }"},{"DocComment":"     };"},{"DocComment":"     data.into_iter().sum()"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // This could be the result of C++'s std::vector::data():"},{"DocComment":" let ptr = std::ptr::null();"},{"DocComment":" // And this could be std::vector::size():"},{"DocComment":" let len = 0;"},{"DocComment":" assert_eq!(unsafe { sum_slice(ptr, len) }, 0.0);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [valid]: ptr#safety"},{"DocComment":" [`NonNull::dangling()`]: ptr::NonNull::dangling"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"slice_from_raw_parts"},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":29983},{"Deduplicated":2181}],"output":{"Deduplicated":29967}},"src":"T