},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[30156,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":29651},"Mut"]}]}],"output":{"HashConsedValue":[30157,{"Adt":{"id":{"Adt":33},"generics":{"regions":[],"types":[{"Deduplicated":29650}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitImpl":{"impl_ref":{"id":99,"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":29317}],"const_generics":[],"trait_refs":[]}},"trait_ref":{"id":31,"generics":{"regions":[],"types":[{"Deduplicated":29651},{"Deduplicated":29650}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":0},"reuses_default":true}},"is_global_initializer":null,"body":"Opaque"},null,null,null,null,null,null,{"def_id":270,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["double_ended",0]},{"Ident":["DoubleEndedIterator",0]},{"Ident":["rfold",0]}],"span":{"data":{"file_id":73,"beg":{"line":305,"col":4},"end":{"line":308,"col":64}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator method that reduces the iterator's elements to a single,"},{"DocComment":" final value, starting from the back."},{"DocComment":""},{"DocComment":" This is the reverse version of [`Iterator::fold()`]: it takes elements"},{"DocComment":" starting from the back of the iterator."},{"DocComment":""},{"DocComment":" `rfold()` takes two arguments: an initial value, and a closure with two"},{"DocComment":" arguments: an 'accumulator', and an element. The closure returns the value that"},{"DocComment":" the accumulator should have for the next iteration."},{"DocComment":""},{"DocComment":" The initial value is the value the accumulator will have on the first"},{"DocComment":" call."},{"DocComment":""},{"DocComment":" After applying this closure to every element of the iterator, `rfold()`"},{"DocComment":" returns the accumulator."},{"DocComment":""},{"DocComment":" This operation is sometimes called 'reduce' or 'inject'."},{"DocComment":""},{"DocComment":" Folding is useful whenever you have a collection of something, and want"},{"DocComment":" to produce a single value from it."},{"DocComment":""},{"DocComment":" Note: `rfold()` combines elements in a *right-associative* fashion. For associative"},{"DocComment":" operators like `+`, the order the elements are combined in is not important, but for non-associative"},{"DocComment":" operators like `-` the order will affect the final result."},{"DocComment":" For a *left-associative* version of `rfold()`, see [`Iterator::fold()`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" // the sum of all of the elements of a"},{"DocComment":" let sum = a.iter()"},{"DocComment":"            .rfold(0, |acc, &x| acc + x);"},{"DocComment":""},{"DocComment":" assert_eq!(sum, 6);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This example demonstrates the right-associative nature of `rfold()`:"},{"DocComment":" it builds a string, starting with an initial value"},{"DocComment":" and continuing with each element from the back until the front:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let numbers = [1, 2, 3, 4, 5];"},{"DocComment":""},{"DocComment":" let zero = \"0\".to_string();"},{"DocComment":""},{"DocComment":" let result = numbers.iter().rfold(zero, |acc, &x| {"},{"DocComment":"     format!(\"({x} + {acc})\")"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" assert_eq!(result, \"(1 + (2 + (3 + (4 + (5 + 0)))))\");"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"B"},{"index":2,"name":"F"},{"index":3,"name":"Clause0_Clause0_Item"}],"const_generics":[],"trait_claus