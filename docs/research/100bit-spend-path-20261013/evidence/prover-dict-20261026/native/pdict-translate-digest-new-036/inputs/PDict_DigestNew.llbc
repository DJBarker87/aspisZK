"DocComment":" ```"},{"DocComment":" use std::cmp;"},{"DocComment":""},{"DocComment":" assert_eq!(cmp::min(1, 2), 1);"},{"DocComment":" assert_eq!(cmp::min(2, 2), 2);"},{"DocComment":" ```"},{"DocComment":" ```"},{"DocComment":" use std::cmp::{self, Ordering};"},{"DocComment":""},{"DocComment":" #[derive(Eq)]"},{"DocComment":" struct Equal(&'static str);"},{"DocComment":""},{"DocComment":" impl PartialEq for Equal {"},{"DocComment":"     fn eq(&self, other: &Self) -> bool { true }"},{"DocComment":" }"},{"DocComment":" impl PartialOrd for Equal {"},{"DocComment":"     fn partial_cmp(&self, other: &Self) -> Option<Ordering> { Some(Ordering::Equal) }"},{"DocComment":" }"},{"DocComment":" impl Ord for Equal {"},{"DocComment":"     fn cmp(&self, other: &Self) -> Ordering { Ordering::Equal }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(cmp::min(Equal(\"v1\"), Equal(\"v2\")).0, \"v1\");"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"cmp_min"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":21,"beg":{"line":1574,"col":20},"end":{"line":1574,"col":31}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":47,"generics":{"regions":[],"types":[{"Deduplicated":29317}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":21,"beg":{"line":1574,"col":34},"end":{"line":1574,"col":50}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":33,"generics":{"regions":[],"types":[{"Deduplicated":29317}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":29317},{"Deduplicated":29317}],"output":{"Deduplicated":29317}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":370,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["manually_drop",0]},{"Impl":{"Trait":135}},{"Ident":["deref_mut",0]}],"span":{"data":{"file_id":92,"beg":{"line":285,"col":4},"end":{"line":285,"col":37}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":"Always","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[30547,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":29715},"Mut"]}]}],"output":{"Deduplicated":29650}},"src":{"TraitImpl":{"impl_ref":{"id":135,"generics":{"regions":[],"types":[{"Deduplicated":29317}],"const_generics":[],"trait_refs":[]}},"trait_ref":{"id":38,"generics":{"regions":[],"types":[{"Deduplicated":29715},{"Deduplicated":29317}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":0},"reuses_default":true}},"is_global_initializer":null,"body":"Opaque"},{"def_id":371,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["drop_in_place",0]}],"span":{"data":{"file_id":88,"beg":{"line":808,"col":0},"end":{"line":810,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Executes the destructor (if any) of the pointed-to value."},{"DocComment":""},{"DocComment":" This is almost the same as calling [`ptr::read`] and discarding"},{"DocComment":" the result, but has the following advantages:"},{"DocComment":""},{"DocComment":" * It is *required* to use `drop_in_place` to drop unsized types like"},{"DocComment":"   trait objects, because they can't be read out onto the stack and"},{"DocComment":"   dropped normally."},{"DocComment":""},{"DocComment":" * It is friendlier to the optimizer to do this over [`ptr::read`] when"},{"DocComment":"   dropping manually allocated memory (e.g., in the implementations of"},{"DocComment":"   `Box`/`Rc`/`Vec`), as the compiler doesn't need to prove that it's"},{"DocComment":"   sound to elide the copy."},{"DocComment":""},{"DocComment":" * It can be used to drop [pinned] data when `T` is not `repr(packed)`"},{"DocComment":"   (pinned data must not be moved before it is dropped)."},{"DocComment":""},{"DocComment":" Unaligned values cannot be dropped in place, they must be copied to an aligned"},{"DocComment":" location first using [`ptr::read_unaligned`]. For packed structs, this move is"},{"DocComment":" done automatically by the compiler. This means the fields of packed structs"},{"DocComment":" are not dropped in-place."},{"DocComment":""},{"DocComment":" [`ptr::read`]: self::read"},{"DocComment":" [`ptr::read_unaligned`]: self::read_unaligned"},{"DocComment":" [pinned]: crate::pin"},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Behavior is undefined if any of the following conditions are violated:"},{"DocComment":""},{"DocComment":" * `to_drop` must be [valid] for both reads and writes."},{"DocComment":""},{"DocComment":" * `to_drop` must be properly aligned, even if `T` has size 0."},{"DocComment":""},{"DocComment":" * `to_drop` must be nonnull, even if `T` has size 0."},{"DocComment":""},{"DocComment":" * The value `to_drop` points to must be valid for dropping, which may mean"},{"DocComment":"   it must uphold additional invariants. These invariants depend on the type"},{"DocComment":"   of the value being dropped. For instance, when dropping a Box, the box's"},{"DocComment":"   pointer to the heap must be valid."},{"DocComment":""},{"DocComment":" * While `drop_in_place` is executing, the only way to access parts of"},{"DocComment":"   `to_drop` is through the `&mut self` references supplied to the"},{"DocComment":"   `Drop::drop` methods that `drop_in_place` invokes."},{"DocComment":""},{"DocComment":" Additionally, if `T` is not [`Copy`], using the pointed-to value after"},{"DocComment":" calling `drop_in_place` can cause undefined behavior. Note that `*to_drop ="},{"DocComment":" foo` counts as a use because it will cause the value to be dropped"},{"DocComment":" again. [`write()`] can be used to overwrite data without causing it to be"},{"DocComment":" dropped."},{"DocComment":""},{"DocComment":" [valid]: self#safety"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Manually remove the last item from a vector:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ptr;"},{"DocComment":" use std::rc::Rc;"},{"DocComment":""},{"DocComment":" let last = Rc::new(1);"},{"DocComment":" let weak = Rc::downgrade(&last);"},{"DocComment":""},{"DocComment":" let mut v = vec![Rc::new(0), last];"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     // Get a raw pointer to the last element in `v`."},{"DocComment":"     let ptr = &mut v[1] as *mut _;"},{"DocComment":"     // Shorten `v` to prevent the last item from being dropped. We do that first,"},{"DocComment":"     // to prevent issues if the `drop_in_place` below panics."},{"DocComment":"     v.set_len(1);"},{"DocComment":"     // Without a call `drop_in_place`, the last item would never be dropped,"},{"DocComment":"     // and the memory it manages would be leaked."},{"DocComment":"     ptr::drop_in_place(ptr);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(v, &[0.into()]);"},{"DocComment":""},{"DocComment":" // Ensure that the last item was dropped."},{"DocComment":" assert!(weak.upgrade().is_none());"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"ptr_drop_in_place"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":88,"beg":{"line":810,"col":7},"end":{"line":810,"col":23}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":33,"generics":{"regions":[],"types":[{"Deduplicated":29317}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":29965}],"output":{"Deduplicated":2336}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":372,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["drop",0]}],"span":{"data":{"file_id":91,"beg":{"line":1000,"col":0},"end":{"line":1002,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Disposes of a value."},{"DocComment":""},{"DocComment":" This effectively does nothing for types which implement `Copy`, e.g."},{"DocComment":" integers. Such values are copied and _then_ moved into the function, so the"},{"DocComment":" value persists after this function call."},{"DocComment":""},{"DocComment":" This function is not magic; it is literally defined as"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" pub fn drop<T>(_x: T) {}"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because `_x` is moved into the function, it is automatically [dropped][drop] before"},{"DocComment":" the function returns."},{"DocComment":""},{"DocComment":" [drop]: Drop"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = vec![1, 2, 3];"},{"DocComment":""},{"DocComment":" drop(v); // explicitly drop the vector"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Since [`RefCell`] enforces the borrow rules at runtime, `drop` can"},{"DocComment":" release a [`RefCell`] borrow:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::cell::RefCell;"},{"DocComment":""},{"DocComment":" let x = RefCell::new(1);"},{"DocComment":""},{"DocComment":" let mut mutable_borrow = x.borrow_mut();"},{"DocComment":" *mutable_borrow = 1;"},{"DocComment":""},{"DocComment":" drop(mutable_borrow); // relinquish the mutable borrow on this slot"},{"DocComment":""},{"DocComment":" let borrow = x.borrow();"},{"DocComment":" println!(\"{}\", *borrow);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Integers and other types implementing [`Copy`] are unaffected by `drop`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dropping_copy_types)]"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct Foo(u8);"},{"DocComment":""},{"DocComment":" let x = 1;"},{"DocComment":" let y = Foo(2);"},{"DocComment":" drop(x); // a copy of `x` is moved and dropped"},{"DocComment":" drop(y); // a copy of `y` is moved and dropped"},{"DocComment":""},{"DocComment":" println!(\"x: {}, y: {}\", x, y.0); // still available"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`RefCell`]: crate::cell::RefCell"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"mem_drop"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":91,"beg":{"line":1002,"col":7},"end":{"line":1002,"col":23}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":33,"generics":{"regions":[],"types":[{"Deduplicated":29317}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":29317}],"output":{"Deduplicated":2336}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":373,"item_meta":{"name":[{"Ident":["generic_array",0]},{"Ident":["sequence",0]},{"Ident":["GenericSequence",0]},{"Ident":["inverted_zip",0]},{"Impl":{"Trait":120}},{"I