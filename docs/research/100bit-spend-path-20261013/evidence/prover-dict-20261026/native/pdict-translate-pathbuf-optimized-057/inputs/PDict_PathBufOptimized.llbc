{"charon_version":"0.1.223","translated":{"crate_name":"pdict_native_readonly","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Optimized","rustc_args":["--cfg=kani"],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::pathbuf_as_path"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["std::path"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"PDict_PathBufOptimized.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"lib.rs"},"crate_name":"pdict_native_readonly","contents":"#[cfg(kani)]\npub fn sha_new(size:usize)->Result<sha2::Sha256VarCore,sha2::digest::InvalidOutputSize> {\n    use sha2::digest::core_api::VariableOutputCore;\n    sha2::Sha256VarCore::new(size)\n}\n#[cfg(kani)]\npub fn path_as_ref(path:&std::path::Path)->&std::path::Path { path.as_ref() }\n#[cfg(kani)]\npub fn pathbuf_as_path(path:&std::path::PathBuf)->&std::path::Path { path.as_path() }\n#[cfg(kani)]\npub fn digest_new() -> sha2::Sha256 {\n    use sha2::Digest;\n    sha2::Sha256::new()\n}\n#[cfg(kani)]\npub fn error_kind_eq(a: std::io::ErrorKind, b: std::io::ErrorKind) -> bool { a == b }\n#[cfg(kani)]\npub fn digest_update(state: &mut sha2::Sha256, data: &[u8]) {\n    use sha2::Digest;\n    state.update(data)\n}\n#[cfg(kani)]\npub fn digest_finalize(state: sha2::Sha256) -> [u8; 32] {\n    use sha2::Digest;\n    state.finalize().into()\n}\n"},{"id":1,"name":{"Local":"/rustc/library/std/src/path.rs"},"crate_name":"std","contents":null},{"id":2,"name":{"Local":"/rustc/library/std/src/lib.rs"},"crate_name":"std","contents":null},{"id":3,"name":{"Local":"/rustc/library/std/src/ffi/os_str.rs"},"crate_name":"std","contents":null},{"id":4,"name":{"Local":"/rustc/library/std/src/ffi/mod.rs"},"crate_name":"std","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["pdict_native_readonly",0]},{"Ident":["pathbuf_as_path",0]}]},{"key":{"Type":0},"value":[{"Ident":["std",0]},{"Ident":["path",0]},{"Ident":["PathBuf",0]}]},{"key":{"Type":1},"value":[{"Ident":["std",0]},{"Ident":["path",0]},{"Ident":["Path",0]}]},{"key":{"Fun":1},"value":[{"Ident":["std",0]},{"Ident":["path",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"HashConsedValue":[298,{"Adt":{"id":{"Adt":0},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]},"kind":"InherentImplBlock"}}},{"Ident":["as_path",0]}]},{"key":{"Type":2},"value":[{"Ident":["std",0]},{"Ident":["ffi",0]},{"Ident":["os_str",0]},{"Ident":["OsString",0]}]},{"key":{"Type":