e [`push`] and [`set_extension`] that mutate"},{"DocComment":" the path in place. It also implements [`Deref`] to [`Path`], meaning that"},{"DocComment":" all methods on [`Path`] slices are available on `PathBuf` values as well."},{"DocComment":""},{"DocComment":" [`push`]: PathBuf::push"},{"DocComment":" [`set_extension`]: PathBuf::set_extension"},{"DocComment":""},{"DocComment":" More details about the overall approach can be found in"},{"DocComment":" the [module documentation](self)."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" You can use [`push`] to build up a `PathBuf` from"},{"DocComment":" components:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::path::PathBuf;"},{"DocComment":""},{"DocComment":" let mut path = PathBuf::new();"},{"DocComment":""},{"DocComment":" path.push(r\"C:\\\");"},{"DocComment":" path.push(\"windows\");"},{"DocComment":" path.push(\"system32\");"},{"DocComment":""},{"DocComment":" path.set_extension(\"dll\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However, [`push`] is best used for dynamic situations. This is a better way"},{"DocComment":" to do this when you know all of the components ahead of time:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::path::PathBuf;"},{"DocComment":""},{"DocComment":" let path: PathBuf = [r\"C:\\\", \"windows\", \"system32.dll\"].iter().collect();"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" We can still do better than this! Since these are all strings, we can use"},{"DocComment":" `From::from`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::path::PathBuf;"},{"DocComment":""},{"DocComment":" let path = PathBuf::from(r\"C:\\windows\\system32.dll\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Which method works best depends on what kind of situation you're in."},{"DocComment":""},{"DocComment":" Note that `PathBuf` does not always sanitize arguments, for example"},{"DocComment":" [`push`] allows paths built from strings which include separators:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::path::PathBuf;"},{"DocComment":""},{"DocComment":" let mut path = PathBuf::new();"},{"DocComment":""},{"DocComment":" path.push(r\"C:\\\");"},{"DocComment":" path.push(\"windows\");"},{"DocComment":" path.push(r\"..\\otherdir\");"},{"DocComment":" path.push(\"system32\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The behavior of `PathBuf` may be changed to a panic on such inputs"},{"DocComment":" in the future. [`Extend::extend`] should be used to add multi-part paths."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"PathBuf"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":1,"beg":{"line":1215,"col":4},"end":{"line":1215,"col":19}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"inner","ty":{"HashConsedValue":[391,{"Adt":{"id":{"Adt":2},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":1,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["path",0]},{"Ident":["Path",0]}],"span":{"data":{"file_id":1,"beg":{"line":2357,"col":0},"end":{"line":2357,"col":15}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A slice of a path (akin to [`str`])."},{"DocComment":""},{"DocComment":" This type supports a number of operations for inspecting a path, including"},{"DocComment":" breaking the path into its components (separated by `/` on Unix and by either"},{"DocComment":" `/` or `\\` on Windows), extracting the file name, determining whether the path"},{"DocComment":" is absolute, and so on."},{"DocComment":""},{"DocComment":" This is an *unsized* type, meaning that it must always be used behind a"},{"DocComment":" pointer like `&` or [`Box`]. For an owned version of this type,"},{"DocComment":" see [`PathBuf`]."},{"DocComment":""},{"DocComment":" More details about the overall approach can be found in"},{"DocComment":" the [module documentation](self)."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::path::Path;"},{"DocComment":" use std::ffi::OsStr;"},{"DocComment":""},{"DocComment":" // Note: this example does work on Windows"},{"DocComment":" let path = Path::new(\"./foo/bar.txt\");"},{"DocComment":""},{"DocComment":" let parent = path.parent();"},{"DocComment":" assert_eq!(parent, Some(Path::new(\"./foo\")));"},{"DocComment":""},{"DocComment":" let file_stem = path.file_stem();"},{"DocComment":" assert_eq!(file_stem, Some(OsStr::new(\"bar\")));"},{"DocComment":""},{"DocComment":" let extension = path.extension();"},{"DocComment":" assert_eq!(extension, Some(OsStr::new(\"txt\")));"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"Path"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":1,"beg":{"line":2358,"col":4},"end":{"line":2358,"col":16}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"inner","ty":{"HashConsedValue":[399,{"Adt":{"id":{"Adt":3},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":null,"align":null,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":2,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["ffi",0]},{"Ident":["os_str",0]},{"Ident":["OsString",0]}],"span":{"data":{"file_id":3,"beg":{"line":93,"col":0},"end":{"line":93,"col":19}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A type that can represent owned, mutable platform-native strings, but is"},{"DocComment":" cheaply inter-convertible with Rust strings."},{"DocComment":""},{"DocComment":" The need for this type arises from the fact that:"},{"DocComment":""},{"DocComment":" * On Unix systems, strings are often arbitrary sequences of non-zero"},{"DocComment":"   bytes, in many cases interpreted as UTF-8."},{"DocComment":""},{"DocComment":" * On Windows, strings are often arbitrary sequences of non-zero 16-bit"},{"DocComment":"   values, interpreted as UTF-16 when it is valid to do so."},{"DocComment":""},{"DocComment":" * In Rust, strings are always valid UTF-8, which may contain zeros."},{"DocComment":""},{"DocComment":" `OsString` and [`OsStr`] bridge this gap by simultaneously representing Rust"},{"DocComment":" and platform-native string values, and in particular allowing a Rust string"},{"DocComment":" to be converted into an \"OS\" string with no cost if possible. A consequence"},{"DocComment":" of this is that `OsString` instances are *not* `NUL` terminated; in order"},{"DocComment":" to pass to e.g., Unix system call, you should create a [`CStr`]."},{"DocComment":""},{"DocComment":" `OsString` is to <code>&[OsStr]</code> as [`String`] is to <code>&[str]</code>: the former"},{"DocComment":" in each pair are owned strings; the latter are borrowed"},{"DocComment":" references."},{"DocComment":""},{"DocComment":" Note, `OsString` and [`OsStr`] internally do not necessarily hold strings in"},{"DocComment":" the form native to the platform; While on Unix, strings are stored as a"},{"DocComment":" sequence of 8-bit values, on Windows, where strings are 16-bit value based"},{"DocComment":" as just discussed, strings are also actually stored as a sequence of 8-bit"},{"DocComment":" values, encoded in a less-strict variant of UTF-8. This is useful to"},{"DocComment":" understand when handling capacity and length values."},{"DocComment":""},{"DocComment":" # Capacity of `OsString`"},{"DocComment":""},{"DocComment":" Capacity uses units of UTF-8 bytes for OS strings which were created from valid unicode, and"},{"DocComment":" uses units of bytes in an unspecified encoding for other contents. On a given target, all"},{"DocComment":" `OsString` and `OsStr` values use the same units for capacity, so the following will work:"},{"DocComment":" ```"},{"DocComment":" use std::ffi::{OsStr, OsString};"},{"DocComment":""},{"DocComment":" fn concat_os_strings(a: &OsStr, b: &OsStr) -> OsString {"},{"DocComment":"     let mut ret = OsString::with_capacity(a.len() + b.len()); // This will allocate"},{"DocComment":"     ret.push(a); // This will not allocate further"},{"DocComment":"     ret.push(b); // This will not allocate further"},{"DocComment":"     ret"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Creating an `OsString`"},{"DocComment":""},{"DocComment":" **From a Rust string**: `OsString` implements"},{"DocComment":" <code>[From]<[String]></code>, so you can use <code>my_string.[into]\\()</code> to"},{"DocComment":" create an `OsString` from a normal Rust string."},{"DocComment":""},{"DocComment":" **From slices:** Just like you can start with an empty Rust"},{"DocComment":" [`String`] and then [`String::push_str`] some <code>&[str]</code>"},{"DocComment":" sub-string slices into it, you can create an empty `OsString` with"},{"DocComment":" the [`OsString::new`] method and then push string slices into it with the"},{"DocComment":" [`OsString::push`] method."},{"DocComment":""},{"DocComment":" # Extracting a borrowed reference to the whole OS string"},{"DocComment":""},{"DocComment":" You can use the [`OsString::as_os_str`] method to get an <code>&[OsStr]</code> from"},{"DocComment":" an `OsString`; this is effectively a borrowed reference to the"},{"DocComment":" whole string."},{"DocComment":""},{"DocComment":" # Conversions"},{"DocComment":""},{"DocComment":" See the [module's toplevel documentation about conversions][conversions] for a discussion on"},{"DocComment":" the traits which `OsString` implements for [conversions] from/to native representations."},{"DocComment":""},{"DocComment":" [`CStr`]: crate::ffi::CStr"},{"DocComment":" [conversions]: super#conversions"},{"DocComment":" [into]: Into::into"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"OsString"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":3,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["ffi",0]},{"Ident":["os_str",0]},{"Ident":["OsStr",0]}],"span":{"data":{"file_id":3,"beg":{"line":119,"col":0},"end":{"line":119,"col":16}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Borrowed reference to an OS string (see [`OsString`])."},{"DocComment":""},{"DocComment":" This type represents a borrowed reference to a string in the operating system's preferred"},{"DocComment":" representation."},{"DocComment":""},{"DocComment":" `&OsStr` is to [`OsString`] as <code>&[str]</code> is to [`String`]: the"},{"DocComment":" former in each pair are borrowed references; the latter are owned strings."},{"DocComment":""},{"DocComment":" See the [module's toplevel documentation about conversions][conversions] for a discussion on"},{"DocComment":" the traits which `OsStr` implements for [conversions] from/to native representations."},{"DocComment":""},{"DocComment":" [conversions]: super#conversions"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"OsStr"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":null,"align":null,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":4,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["RangeFull",0]}],"span":{"data":{"file_id":5,"beg":{"line":44,"col":0},"end":{"line":44,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An unbounded range (`..`)."},{"DocComment":""},{"DocComment":" `RangeFull` is primarily used as a [slicing index], its shorthand is `..`."},{"DocComment":" It cannot serve as an [`Iterator`] because it doesn't have a starting point."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `..` syntax is a `RangeFull`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!(.., std::ops::RangeFull);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It does not have an [`IntoIterator`] implementation, so you can't use it in"},{"DocComment":" a `for` loop directly. This won't c