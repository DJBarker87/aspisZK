"crate_name":"crypto_common","contents":null},{"id":16,"name":{"Local":"crates/aspis-r1-cost-probe/src/lib.rs"},"crate_name":"aspis_r1_cost_probe","contents":"//! UNPROVED R1 COST PROBE. P2 only; no production entrypoint.\n#![no_std]\nextern crate alloc;\npub mod sampler;\npub mod semantic_wire;\npub mod semantic;\npub mod fast_domain;\npub mod fast_dots;\npub mod fast_pairing;\n\n#[cfg(feature = \"prover\")]\nextern crate std;\npub mod r1_wire;\npub mod r1_semantic;\npub mod trace;\npub mod transport;\npub mod weights;\npub mod transcript;\npub mod verifier;\n#[cfg(feature = \"prover\")]\npub mod prover;\n/// Host client for the selected public proof-account nonce route (D162).\n#[cfg(feature = \"r1p-check\")]\n#[allow(non_snake_case)]\npub mod RealR1_client;\n#[cfg(feature = \"prover\")]\npub mod dense;\n/// G-sim (LOG D44.3): the explicit R1 simulator simE in the ideal game.\n#[cfg(feature = \"r1p-check\")]\npub mod sim;\n\n#[cfg(feature=\"prover\")] mod host_sumcheck;\n#[cfg(feature=\"prover\")] mod host_semantic;\n#[cfg(feature=\"prover\")] mod host_commitment;\n#[cfg(feature=\"prover\")] mod host_tree;\n#[cfg(feature=\"prover\")] mod host_transcript;\n#[cfg(feature=\"prover\")] mod host_wire;\n#[cfg(feature=\"prover\")] mod host_compact;\n\n// Adopted R1 proof format (PREREG-PROOF-SIZE-2, 2026-10-19): compact QM31\n// storage and binary multiproofs. UNPROVED: see PROOF-SIZE-OBLIGATIONS.\npub mod multiproof;\npub mod compact;\n\n#[cfg(not(feature=\"private-leaf-salts\"))]\ncompile_error!(\"the adopted R1 proof format is defined over private leaf salts; enable `private-leaf-salts` (a default feature)\");\n#[cfg(all(feature=\"audit-eight-way\",feature=\"prover\"))]\ncompile_error!(\"`audit-eight-way` is audit-only: it is never combined with the prover (PREREG-PROOF-SIZE-2 item 4)\");\n#[cfg(all(feature=\"audit-eight-way\",any(target_os=\"solana\",feature=\"program-build\")))]\ncompile_error!(\"`audit-eight-way` is audit-only: it is never built for a program (PREREG-PROOF-SIZE-2 item 4)\");\n\n#[cfg(all(feature = \"ct-host-prover\", feature = \"program-build\"))]\ncompile_error!(\"ct-host-prover is host-prover only, incompatible with program-build\");\n\n#[cfg(feature = \"ct-host-prover\")]\nmod ct_pole;\n\n// Fixed public-shape scheduling for the host CT adoption candidate.\n#[cfg(feature=\"ct-host-prover\")]\npub mod host_work;\n"},{"id":17,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/block-buffer-0.10.4/src/sealed.rs"},"crate_name":"block_buffer","contents":null},{"id":18,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":19,"name":{"Local":"/rustc/library/core/src/default.rs"},"crate_name":"core","contents":null},{"id":20,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Ident":["sha2",0]},{"Ident":["core_api",0]},{"Ident":["Sha256VarCore",0]}]},{"key":{"Type":1},"value":[{"Ident":["generic_array",0]},{"Ident":["GenericArray",0]}]},{"key":{"Type":2},"value":[{"Ident":["generic_array",0]},{"Ident":["GenericArrayImplOdd",0]}]},{"key":{"Type":3},"value":[{"Ident":["generic_array",0]},{"Ident":["GenericArrayImplEven",0]}]},{"key":{"Type":4},"value":[{"Ident":["block_buffer",0]},{"Ident":["BlockBuffer",0]}]},{"key":{"Type":5},"value":[{"Ident":["digest",0]},{"Ident":["core_api",0]},{"Ident":["wrapper",0]},{"Ident":["CoreWrapper",0]}]},{"key":{"Type":6},"value":[{"Ident":["digest",0]},{"Ident":["core_api",0]},{"Ident":["ct_variable",0]},{"Ident":["CtVariableCoreWrapper",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["generic_array",0]},{"Ident":["ArrayLength",0]}]},{"key":{"Type":7},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["PhantomData",0]}]},{"key":{"TraitDecl":1},"value":[{"Ident":["typenum",0]},{"Ident":["type_operators",0]},{"Ident":["IsLess",0]}]},{"key":{"Type":8},"value":[{"Ident":["typenum",0]},{"Ident":["uint",0]},{"Ident":["UInt",0]}]},{"key":{