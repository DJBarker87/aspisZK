{"Type":4},"value":[{"Ident":["OsStr",0]}]},{"key":{"Type":2},"value":[{"Ident":["PathBuf",0]}]},{"key":{"Type":9},"value":[{"Ident":["Global",0]}]},{"key":{"Type":6},"value":[{"Ident":["Slice",0]}]},{"key":{"Type":1},"value":[{"Ident":["Path",0]}]},{"key":{"Type":5},"value":[{"Ident":["OsString",0]}]},{"key":{"Type":8},"value":[{"Ident":["Vec",0]}]},{"key":{"Type":7},"value":[{"Ident":["Buf",0]}]}],"type_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["fs",0]},{"Ident":["OpenOptions",0]}],"span":{"data":{"file_id":0,"beg":{"line":275,"col":0},"end":{"line":275,"col":22}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Options and flags which can be used to configure how a file is opened."},{"DocComment":""},{"DocComment":" This builder exposes the ability to configure how a [`File`] is opened and"},{"DocComment":" what operations are permitted on the open file. The [`File::open`] and"},{"DocComment":" [`File::create`] methods are aliases for commonly used options using this"},{"DocComment":" builder."},{"DocComment":""},{"DocComment":" Generally speaking, when using `OpenOptions`, you'll first call"},{"DocComment":" [`OpenOptions::new`], then chain calls to methods to set each option, then"},{"DocComment":" call [`OpenOptions::open`], passing the path of the file you're trying to"},{"DocComment":" open. This will give you a [`io::Result`] with a [`File`] inside that you"},{"DocComment":" can further operate on."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Opening a file to read:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::fs::OpenOptions;"},{"DocComment":""},{"DocComment":" let file = OpenOptions::new().read(true).open(\"foo.txt\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Opening a file for both reading and writing, as well as creating it if it"},{"DocComment":" doesn't exist:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::fs::OpenOptions;"},{"DocComment":""},{"DocComment":" let file = OpenOptions::new()"},{"DocComment":"             .read(true)"},{"DocComment":"             .write(true)"},{"DocComment":"             .create(true)"},{"DocComment":"             .open(\"foo.txt\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"FsOpenOptions"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":0,"beg":{"line":275,"col":23},"end":{"line":275,"col":42}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":null,"ty":{"HashConsedValue":[922,{"Adt":{"id":{"Adt":3},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":16,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":1,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["path",0]},{"Ident":["Path",0]}],"span":{"data":{"file_id":2,"beg":{"line":2357,"col":0},"end":{"line":2357,"col":15}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A slice of a path (akin to [`str`])."},{"DocComment":""},{"DocComment":" This type supports a number of operations for inspecting a path, including"},{"DocComment":" breaking the path into its components (separated by `/` on Unix and by either"},{"DocComment":" `/` or `\\` on Windows), extracting the file name, determining whether the path"},{"DocComment":" is absolute, and so on."},{"DocComment":""},{"DocComment":" This is an *unsized* type, meaning that it must always be used behind a"},{"DocComment":" pointer like `&` or [`Box`]. For an owned version of this type,"},{"DocComment":" see [`PathBuf`]."},{"DocComment":""},{"DocComment":" More details about the overall approach can be found in"},{"DocComment":" the [module documentation](self)."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::path::Path;"},{"DocComment":" use std::ffi::OsStr;"},{"DocComment":""},{"DocComment":" // Note: this example does work on Windows"},{"DocComment":" let path = Path::new(\"./foo/bar.txt\");"},{"DocComment":""},{"DocComment":" let parent = path.parent();"},{"DocComment":" assert_eq!(parent, Some(Path::new(\"./foo\")));"},{"DocComment":""},{"DocComment":" let file_stem = path.file_stem();"},{"DocComment":" assert_eq!(file_stem, Some(OsStr::new(\"bar\")));"},{"DocComment":""},{"DocComment":" let extension = path.extension();"},{"DocComment":" assert_eq!(extension, Some(OsStr::new(\"txt\")));"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"Path"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":2,"beg":{"line":2358,"col":4},"end":{"line":2358,"col":16}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"inner","ty":{"HashConsedValue":[923,{"Adt":{"id":{"Adt":4},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":null,"align":null,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":2,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["path",0]},{"Ident":["PathBuf",0]}],"span":{"data":{"file_id":2,"beg":{"line":1214,"col":0},"end":{"line":1214,"col":18}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An owned, mutable path (akin to [`String`])."},{"DocComment":""},{"DocComment":" This type provides methods like [`push`] and [`set_extension`] that mutate"},{"DocComment":" the path in place. It also implements [`Deref`] to [`Path`], meaning that"},{"DocComment":" all methods on [`Path`] slices are available on `PathBuf` values as well."},{"DocComment":""},{"DocComment":" [`push`]: PathBuf::push"},{"DocComment":" [`set_extension`]: PathBuf::set_extension"},{"DocComment":""},{"DocComment":" More details about the overall approach can be found in"},{"DocComment":" the [module documentation](self)."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" You can use [`push`] to build up a `PathBuf` from"},{"DocComment":" components:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::path::PathBuf;"},{"DocComment":""},{"DocComment":" let mut path = PathBuf::new();"},{"DocComment":""},{"DocComment":" path.push(r\"C:\\\");"},{"DocComment":" path.push(\"windows\");"},{"DocComment":" path.push(\"system32\");"},{"DocComment":""},{"DocComment":" path.set_extension(\"dll\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However, [`push`] is best used for dynamic situations. This is a better way"},{"DocComment":" to do this when you know all of the components ahead of time:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::path::PathBuf;"},{"DocComment":""},{"DocComment":" let path: PathBuf = [r\"C:\\\", \"windows\", \"system32.dll\"].iter().collect();"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" We can still do better than this! Since these are all strings, we can use"},{"DocComment":" `From::from`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::path::PathBuf;"},{"DocComment":""},{"DocComment":" let path = PathBuf::from(r\"C:\\windows\\system32.dll\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Which method works best depends on what kind of situation you're in."},{"DocComment":""},{"DocComment":" Note that `PathBuf` does not always sanitize arguments, for example"},{"DocComment":" [`push`] allows paths built from strings which include separators:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::path::PathBuf;"},{"DocComment":""},{"DocComment":" let mut path = PathBuf::new();"},{"DocComment":""},{"DocComment":" path.push(r\"C:\\\");"},{"DocComment":" path.push(\"windows\");"},{"DocComment":" path.push(r\"..\\otherdir\");"},{"DocComment":" path.push(\"system32\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The behavior of `PathBuf` may be changed to a panic on such inputs"},{"DocComment":" in the future. [`Extend::extend`] should be used to add multi-part paths."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"PathBuf"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":2,"beg":{"line":1215,"col":4},"end":{"line":1215,"col":19}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"inner","ty":{"HashConsedValue":[924,{"Adt":{"id":{"Adt":5},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":3,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["sys",0]},{"Ident