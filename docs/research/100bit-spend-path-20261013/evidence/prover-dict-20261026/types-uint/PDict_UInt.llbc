em_meta":{"name":[{"Ident":["typenum",0]},{"Ident":["uint",0]},{"Ident":["UInt",0]}],"span":{"data":{"file_id":0,"beg":{"line":148,"col":0},"end":{"line":148,"col":21}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `UInt` is defined recursively, where `B` is the least significant bit and `U` is the rest"},{"DocComment":" of the number. Conceptually, `U` should be bound by the trait `Unsigned` and `B` should"},{"DocComment":" be bound by the trait `Bit`, but enforcing these bounds causes linear instead of"},{"DocComment":" logrithmic scaling in some places, so they are left off for now. They may be enforced in"},{"DocComment":" future."},{"DocComment":""},{"DocComment":" In order to keep numbers unique, leading zeros are not allowed, so `UInt<UTerm, B0>` is"},{"DocComment":" forbidden."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":" ```rust"},{"DocComment":" use typenum::{UInt, UTerm, B0, B1};"},{"DocComment":""},{"DocComment":" # #[allow(dead_code)]"},{"DocComment":" type U6 = UInt<UInt<UInt<UTerm, B1>, B1>, B0>;"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"U"},{"index":1,"name":"B"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":0,"beg":{"line":150,"col":4},"end":{"line":150,"col":21}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"msb","ty":{"HashConsedValue":[3849,{"TypeVar":{"Free":0}}]}},{"span":{"data":{"file_id":0,"beg":{"line":152,"col":4},"end":{"line":152,"col":21}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"lsb","ty":{"HashConsedValue":[3850,{"TypeVar":{"Free":1}}]}}]},"layout":[],"ptr_metadata":"None"}],"fun_decls":