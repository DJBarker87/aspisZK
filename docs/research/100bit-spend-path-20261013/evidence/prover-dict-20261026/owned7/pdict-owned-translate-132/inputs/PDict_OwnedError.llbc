h"},{"DocComment":" `_` as the correct case. This seems counterintuitive, but it will make your"},{"DocComment":" tests more robust. In particular, if you want to verify that your code does"},{"DocComment":" produce an unrecognized error kind, the robust solution is to check for all"},{"DocComment":" the recognized error kinds and fail in those cases."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"io_errorkind"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":4,"beg":{"line":48,"col":4},"end":{"line":48,"col":12}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" An entity was not found, often a file."}],"inline":null,"rename":null,"public":true},"name":"NotFound","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","0"]}}},{"id":1,"span":{"data":{"file_id":4,"beg":{"line":51,"col":4},"end":{"line":51,"col":20}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" The operation lacked the necessary privileges to complete."}],"inline":null,"rename":null,"public":true},"name":"PermissionDenied","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","1"]}}},{"id":2,"span":{"data":{"file_id":4,"beg":{"line":54,"col":4},"end":{"line":54,"col":21}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" The connection was refused by the remote server."}],"inline":null,"rename":null,"public":true},"name":"ConnectionRefused","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","2"]}}},{"id":3,"span":{"data":{"file_id":4,"beg":{"line":57,"col":4},"end":{"line":57,"col":19}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" The connection was reset by the remote server."}],"inline":null,"rename":null,"public":true},"name":"ConnectionReset","fields":[],"discriminant":{"Scalar":{"Signe