{"charon_version":"0.1.223","translated":{"crate_name":"pdict_offpath","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Optimized","rustc_args":["--cfg=kani","--cfg=pdict_extract"],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::owned_error_observe","crate::owned_error_open"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["crate::owned_error::OwnedError","crate::owned_error::Observation","crate::owned_error::owned_observe","crate::owned_error::owned_open_error","core::io::error"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"PDict_OwnedError.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"lib.rs"},"crate_name":"pdict_offpath","contents":"#[cfg(kani)]\npub fn zero_as_mut<T,Z:zeroize::Zeroize+AsMut<T>>(z:&mut zeroize::Zeroizing<Z>)->&mut T { z.as_mut() }\n#[cfg(kani)]\npub fn zero_deref_mut<Z:zeroize::Zeroize>(z:&mut zeroize::Zeroizing<Z>)->&mut Z { &mut *z }\n#[cfg(kani)]\npub fn ct_update(z:&mut sha2::digest::core_api::CtVariableCoreWrapper<sha2::Sha256VarCore,sha2::digest::typenum::U32>,blocks:&[sha2::digest::core_api::Block<sha2::Sha256VarCore>]) {\n    use sha2::digest::core_api::UpdateCore;\n    z.update_blocks(blocks)\n}\n#[cfg(kani)]\npub fn string_new(n:usize)->String { String::with_capacity(n) }\n#[cfg(kani)]\npub fn string_push(s:&mut String,t:&str) { s.push_str(t); }\n#[cfg(kani)]\npub fn string_path(s:&String)->&std::path::Path { s.as_ref() }\n#[cfg(kani)]\npub fn file_flush(file:&mut std::fs::File)->std::io::Result<()> {\n    use std::io::Write;\n    file.flush()\n}\n\n#[cfg(all(kani,not(pdict_extract)))]\n#[kani::proof]\nfn zeroizing_mutable_adapters_full_frame() {\n    #[derive(Clone)]\n    struct State { before:u64, cell:u64, after:u64 }\n    impl zeroize::Zeroize for State {\n        fn zeroize(&mut self) { self.cell=0; }\n    }\n    impl AsMut<u64> for State {\n        fn as_mut(&mut self)->&mut u64 { &mut self.cell }\n    }\n    let before:u64=kani::any(); let cell:u64=kani::any(); let after:u64=kani::any();\n    let replacement:u64=kani::any();\n    let mut z=zeroize::Zeroizing::new(State{before,cell,after});\n    assert!(*zero_as_mut(&mut z)==cell);\n    *zero_as_mut(&mut z)=replacement;\n    assert!(zero_deref_mut(&mut z).cell==replacement);\n    assert!(z.before==before && z.after==after);\n    let next:u64=kani::any();\n    zero_deref_mut(&mut z).cell=next;\n    assert!(*zero_as_mut(&mut z)==next);\n    assert!(z.before==before && z.after==after);\n}\n#[cfg(kani)]\npub fn ct_default()->sha2::digest::core_api::CtVariableCoreWrapper<sha2::Sha256VarCore,sha2::digest::typenum::U32> { Default::default() }\n#[cfg(kani)]\npub fn wrapper_default()->sha2::Sha256 { Default::default() }\n#[cfg(kani)]\npub fn wrapper_update(state:&mut sha2::Sha256,data:&[u8]) {\n    use sha2::digest::Update;\n    Update::update(state,data);\n}\n#[cfg(kani)]\npub fn wrapper_finalize(state:sha2::Sha256,out:&mut sha2::digest::Output<sha2::Sha256>) {\n    use sha2::digest::FixedOutput;\n    state.finalize_into(out);\n}\n#[cfg(kani)]\npub fn io_kind(error:&std::io::Error)->std::io::ErrorKind { error.kind() }\n#[cfg(kani)]\npub fn option_some_and(value:Option<u64>,f:impl FnOnce(u64)->bool)->bool { value.is_some_and(f) }\n#[cfg(kani)]\npub fn option_ref(value:&Option<u64>)->Option<&u64> { value.as_ref() }\n#[cfg(kani)]\npub fn option_or(value:Option<u64>,error:u32)->Result<u64,u32> { value.ok_or(error) }\n#[cfg(kani)]\npub fn option_eq(left:Option<u64>,right:Option<u64>)->bool { left==right }\n#[cfg(kani)]\npub fn option_try(value:Option<u64>)->Option<u64> { Some(value?) }\n#[cfg(kani)]\npub fn result_map(value:Result<u64,u32>,f:impl FnOnce(u64)->u64)->Result<u64,u32> { value.map(f) }\n\n#[cfg(kani)]\n#[path=\"../proof-std-native/owned_error.rs\"]\npub mod owned_error;\n#[cfg(kani)]\npub fn owned_error_observe(r:Result<bool,owned_error::OwnedError>)->owned_error::Observation {\n    owned_error::owned_observe(r)\n}\n#[cfg(kani)]\npub fn owned_error_open(e:owned_error::OwnedError)->Result<bool,owned_error::OwnedError> {\n    owned_error::owned_open_error(e)\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"../proof-std-native/owned_error.rs"},"crate_name":"pdict_offpath","contents":"//! Owned error observation reference. Only the fields consumed by reserve are\n//! represented here; this does not give a representation of arbitrary dyn Error.\nuse std::io::{Error, ErrorKind};\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct OwnedError { pub kind: ErrorKind }\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct Observation { pub reserved: bool, pub last_error: Option<ErrorKind> }\npub fn owned_observe(result: Result<bool, OwnedError>) -> Observation {\n    match result {\n        Ok(reserved) => Observation { reserved, last_error: None },\n        Err(error) => Observation { reserved: false, last_error: Some(error.kind) },\n    }\n}\npub fn native_observe(result: Result<bool, Error>) -> Observation {\n    match result {\n        Ok(reserved) => Observation { reserved, last_error: None },\n        Err(error) => Observation { reserved: false, last_error: Some(error.kind()) },\n    }\n}\npub fn owned_open_error(error: OwnedError) -> Result<bool, OwnedError> {\n    if error.kind == ErrorKind::AlreadyExists { Ok(false) } else { Err(error) }\n}\npub fn native_open_error(error: Error) -> Result<bool, Error> {\n    if error.kind() == ErrorKind::AlreadyExists { Ok(false) } else { Err(error) }\n}\n"},{"id":4,"name":{"Local":"/rustc/library/core/src/io/error.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/io/mod.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["pdict_offpath",0]},{"Ident":["owned_error_observe",0]}]},{"key":{"Fun":1},"value":[{"Ident":["pdict_offpath",0]},{"Ident":["owned_error_open",0]}]},{"key":{"Type":0},"value":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}]},{"key":{"Type":1},"value":[{"Ident":["pdict_offpath",0]},{"Ident":["owned_error",0]},{"Ident":["OwnedError",0]}]},{"key":{"Type":2},"value":[{"Ident":["pdict_offpath",0]},{"Ident":["owned_error",0]},{"Ident":["Observation",0]}]},{"key":{"Fun":2},"value":[{"Ident":["pdict_offpath",0]},{"Ident":["owned_error",0]},{"Ident":["owned_observe",0]}]},{"key":{"Fun":3},"value":[{"Ident":["pdict_offpath",0]},{"Ident":["owned_error",0]},{"Ident":["owned_open_error",0]}]},{"key":{"Type":3},"value":[{"Ident":["core",0]},{"Ident":["io",0]},{"Ident":["error",0]},{"Ident":["ErrorKind",0]}]},{"key":{"Type":4},"value":[{"Ident":["core",0]},{"Ident":["option",0]},{"Ident":["Option",0]}]},{"key":{"Global":0},"v