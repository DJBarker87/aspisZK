n":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A list specifying general categories of I/O error."},{"DocComment":""},{"DocComment":" This list is intended to grow over time and it is not recommended to"},{"DocComment":" exhaustively match against it."},{"DocComment":""},{"DocComment":" It is used with the [`io::Error`][error] type."},{"DocComment":""},{"DocComment":" [error]: ../../std/io/struct.Error.html"},{"DocComment":""},{"DocComment":" # Handling errors and matching on `ErrorKind`"},{"DocComment":""},{"DocComment":" In application code, use `match` for the `ErrorKind` values you are"},{"DocComment":" expecting; use `_` to match \"all other errors\"."},{"DocComment":""},{"DocComment":" In comprehensive and thorough tests that want to verify that a test doesn't"},{"DocComment":" return any known incorrect error kind, you may want to cut-and-paste the"},{"DocComment":" current full list of errors from here into your test code, and then match"},{"DocComment":" `_` as the correct case. This seems counterintuitive, but it will make your"},{"DocComment":" tests more robust. In particular, if you want to verify that your code does"},{"DocComment":" produce an unrecognized error kind, the robust solution is to check for all"},{"DocComment":" the recognized error kinds and fail in those cases."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"io_errorkind"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":4,"beg":{"line":48,"col":4},"end":{"line":48,"col":12}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" An entity was not found, often a file."}],"inline":null,"rename":null,"public":true},"name":"NotFound","fields":[],"discriminant":{"Scalar":{"Signed":["Isize","0"]}}},{"id":1,"span":{"data":{"file_id":4,"beg":{"line