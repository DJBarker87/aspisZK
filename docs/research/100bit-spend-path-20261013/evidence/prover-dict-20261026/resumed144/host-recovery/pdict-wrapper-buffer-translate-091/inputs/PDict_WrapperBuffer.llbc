DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"slice_len_fn"},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[21290,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":20967},"Shared"]}]}],"output":{"Deduplicated":1837}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":98,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":4411},"kind":"InherentImplBlock"}}},{"Ident":["as_ptr",0]}],"span":{"data":{"file_id":35,"beg":{"line":726,"col":4},"end":{"line":726,"col":42}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a raw pointer to the slice's buffer."},{"DocComment":""},{"DocComment":" The caller must ensure that the slice outlives the pointer this"},{"DocComment":" function returns, or else it will end up dangling."},{"DocComment":""},{"DocComment":" The caller must also ensure that the memory the pointer (non-transitively) points to"},{"DocComment":" is never written to (except inside an `UnsafeCell`) using this pointer or any pointer"},{"DocComment":" derived from it. If you need to mutate the contents of the slice, use [`as_mut_ptr`]."},{"DocComment":""},{"DocComment":" Modifying the container referenced by this slice may cause its buffer"},{"DocComment":" to be reallocated, which would also make any pointers to it invalid."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = &[1, 2, 4];"},{"DocComment":" let x_ptr = x.as_ptr();"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     for i in 0..x.len() {"},{"DocComment":"         assert_eq!(x.get_unchecked(i), &*x_ptr.add(i));"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`as_mut_ptr`]: slice::as_mut_ptr"}],"inline":"Always","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":21290}],"output":{"HashConsedValue":[21291,{"RawPtr":[{"Deduplicated":20677},"Shared"]}]}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":99,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["const_ptr",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":4512},"kind":"InherentImplBlock"}}},{"Ident":["add",0]}],"span":{"data":{"file_id":40,"beg":{"line":829,"col":4},"end":{"line":831,"col":17}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":"Adds an unsigned offset to a pointer.\n\nThis can only move the pointer forward (or not move it). If you need to move forward or\nbackward depending on the value, then you might want [`offset`](#method.offset) instead\nwhich takes a signed offset.\n\n`count` is in units of T; e.g., a `count` of 3 represents a pointer\noffset of `3 * size_of::<T>()` bytes.\n\n# Safety\n\nIf any of the following conditions are violated, the result is Undefined Behavior:\n\n* The offset in bytes, `count * size_of::<T>()`, computed on mathematical integers (without\n\"wrapping around\"), must fit in an `isize`.\n\n* If the computed offset is non-zero, then `self` must be [derived from][crate::ptr#provenance] a pointer to some\n[allocation], and the entire memory range between `self` and the result must be in\nbounds of that allocation. In particular, this range must not \"wrap around\" the edge\nof the address space.\n\nAllocations can never be larger than `isize::MAX` bytes, so if the computed offset\nstays in bounds of the allocation, it is guaranteed to satisfy the first requirement.\nThis implies, for instance, that `vec.as_ptr().add(vec.len())` (for `vec: Vec<T>`) is always\nsafe.\n\nConsider using [`wrapping_add`] instead if these constraints are\ndifficult to satisfy. The only advantage of this method is that it\nenables more aggressive compiler optimizations.\n\n[`wrapping_add`]: #method.wrapping_add\n[allocation]: crate::ptr#allocation\n"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s: &str = \"123\";"},{"DocComment":" let ptr: *const u8 = s.as_ptr();"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     assert_eq!(*ptr.add(1), b'2');"},{"DocComment":"     assert_eq!(*ptr.add(2), b'3');"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":21291},{"Deduplicated":1837}],"output":{"Deduplicated":21291}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":100,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["raw",0]},{"Ident":["from_raw_parts",0]}],"span":{"data":{"file_id":42,"beg":{"line":124,"col":0},"end":{"line":124,"col":80}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Forms a slice from a pointer and a length."},{"DocComment":""},{"DocComment":" The `len` argument is the number of **elements**, not the number of bytes."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Behavior is undefined if any of the following conditions are violated:"},{"DocComment":""},{"DocComment":" * `data` must be non-null, [valid] for reads for `len * size_of::<T>()` many bytes,"},{"DocComment":"   and it must be properly aligned. This means in particular:"},{"DocComment":""},{"DocComment":"     * The entire memory range of this slice must be contained within a single allocation!"},{"DocComment":"       Slices can never span across multiple allocations. See [below](#incorrect-usage)"},{"DocComment":"       for an example incorrectly not taking this into account."},{"DocComment":"     * `data` must be non-null and aligned even for zero-length slices or slices of ZSTs. One"},{"DocComment":"       reason for this is that enum layout optimizations may rely on references"},{"DocComment":"       (including slices of any length) being aligned and non-null to distinguish"},{"DocComment":"       them from other data. You can obtain a pointer that is usable as `data`"},{"DocComment":"       for zero-length slices using [`NonNull::dangling()`]."},{"DocComment":""},{"DocComment":" * `data` must point to `len` consecutive properly initialized values of type `T`."},{"DocComment":""},{"DocComment":" * The memory referenced by the returned slice must not be mutated for the duration"},{"DocComment":"   of lifetime `'a`, except inside an `UnsafeCell`."},{"DocComment":""},{"DocComment":" * The total size `len * size_of::<T>()` of the slice must be no larger than `isize::MAX`,"},{"DocComment":"   and adding that size to `data` must not \"wrap around\" the address space."},{"DocComment":"   See the safety documentation of [`pointer::offset`]."},{"DocComment":""},{"DocComment":" # Caveat"},{"DocComment":""},{"DocComment":" The lifetime for the returned slice is inferred from its usage. To"},{"DocComment":" prevent accidental misuse, it's suggested to tie the lifetime to whichever"},{"DocComment":" source lifetime is safe in the context, such as by providing a helper"},{"DocComment":" function taking the lifetime of a host value for the slice, or by explicit"},{"DocComment":" annotation."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::slice;"},{"DocComment":""},{"DocComment":" // manifest a slice for a single element"},{"DocComment":" let x = 42;"},{"DocComment":" let ptr = &x as *const _;"},{"DocComment":" let slice = unsafe { slice::from_raw_parts(ptr, 1) };"},{"DocComment":" assert_eq!(slice[0], 42);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ### Incorrect usage"},{"DocComment":""},{"DocComment":" The following `join_slices` function is **unsound** ⚠️"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use std::slice;"},{"DocComment":""},{"DocComment":" fn join_slices<'a, T>(fst: &'a [T], snd: &'a [T]) -> &'a [T] {"},{"DocComment":"     let fst_end = fst.as_ptr().wrapping_add(fst.len());"},{"DocComment":"     let snd_start = snd.as_ptr();"},{"DocComment":"     assert_eq!(fst_end, snd_start, \"Slices must be contiguous!\");"},{"DocComment":"     unsafe {"},{"DocComment":"         // The assertion above ensures `fst` and `snd` are contiguous, but they might"},{"DocComment":"         // still be contained within _different allocations_, in which case"},{"DocComment":"         // creating this slice is undefined behavior."},{"DocComment":"         slice::from_raw_parts(fst.as_ptr(), fst.len() + snd.len())"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     // `a` and `b` are different allocations..."},{"DocComment":"     let a = 42;"},{"DocComment":"     let b = 27;"},{"DocComment":"     // ... which may nevertheless be laid out contiguously in memory: | a | b |"},{"DocComment":"     let _ = join_slices(slice::from_ref(&a), slice::from_ref(&b)); // UB"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ### FFI: Handling null pointers"},{"DocComment":""},{"DocComment":" In languages such as C++, pointers to empty collections are not guaranteed to be non-null."},{"DocComment":" When accepting such pointers, they have to be checked for null-ness to avoid undefined"},{"DocComment":" behavior."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::slice;"},{"DocComment":""},{"DocComment":" /// Sum the elements of an FFI slice."},{"DocComment":" ///"},{"DocComment":" /// # Safety"},{"DocComment":" ///"},{"DocComment":" /// If ptr is not NULL, it must be correctly aligned and"},{"DocComment":" /// point to `len` initialized items of type `f32`."},{"DocComment":" unsafe extern \"C\" fn sum_slice(ptr: *const f32, len: usize) -> f32 {"},{"DocComment":"     let data = if ptr.is_null() {"},{"DocComment":"         // `len` is assumed to be 0."},{"DocComment":"         &[]"},{"DocComment":"     } else {"},{"DocComment":"         // SAFETY: see function docstring."},{"DocComment":"         unsafe { slice::from_raw_parts(ptr, len) }"},{"DocComment":"     };"},{"DocComment":"     data.into_iter().sum()"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // This could be the result of C++'s std::vector::data():"},{"DocComment":" let ptr = std::ptr::null();"},{"DocComment":" // And this could be std::vector::size():"},{"DocComment":" let len = 0;"},{"DocComment":" assert_eq!(unsafe { sum_slice(ptr, len) }, 0.0);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [valid]: ptr#safety"},{"DocComment":" [`NonNull::dangling()`]: ptr::NonNull::dangling"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"slice_from_raw_parts"},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Unknown"}],"types"