62}},{"Ident":["fold",0]}],"span":{"data":{"file_id":36,"beg":{"line":129,"col":4},"end":{"line":131,"col":44}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"I"},{"index":1,"name":"Acc"},{"index":2,"name":"Fold"},{"index":3,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":36,"beg":{"line":64,"col":7},"end":{"line":64,"col":15}},"generated_from_span":null},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":30,"generics":{"regions":[],"types":[{"Deduplicated":20677},{"Deduplicated":20680}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":36,"beg":{"line":131,"col":14},"end":{"line":131,"col":43}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":25,"generics":{"regions":[],"types":[{"Deduplicated":20678},{"HashConsedValue":[21430,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":20679},{"HashConsedValue":[21429,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":1837},{"Deduplicated":20680}],"const_generics":[],"trait_refs":[]}}}]}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":20679}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":20914},{"Deduplicated":20679},{"Deduplicated":20678}],"output":{"Deduplicated":20679}},"src":{"TraitImpl":{"impl_ref":{"id":62,"generics":{"regions":[],"types":[{"Deduplicated":20677},{"Deduplicated":20680}],"const_generics":[],"trait_refs":[{"HashConsedValue":[21431,{"kind":{"Clause":{"Free":0}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":30,"generics":{"regions":[],"types":[{"Deduplicated":20677},{"Deduplicated":20680}],"const_generics":[],"trait_refs":[]}}}}]}]}},"trait_ref":{"id":30,"generics":{"regions":[],"types":[{"Deduplicated":20914},{"Deduplicated":21429}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":38},"reuses_default":false}},"is_global_initializer":null,"body":"Opaque"},null,{"def_id":211,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["read",0]}],"span":{"data":{"file_id":41,"beg":{"line":1694,"col":0},"end":{"line":1694,"col":47}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Reads the value from `src` without moving it. This leaves the"},{"DocComment":" memory in `src` unchanged."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Behavior is undefined if any of the following conditions are violated:"},{"DocComment":""},{"DocComment":" * `src` must be [valid] for reads or `T` must be a ZST."},{"DocComment":""},{"DocComment":" * `src` must be properly aligned. Use [`read_unaligned`] if this is not the"},{"DocComment":"   case."},{"DocComment":""},{"DocComment":" * `src` must point to a properly initialized value of type `T`."},{"DocComment":""},{"DocComment":" Note that even if `T` has size `0`, the pointer must be properly aligned."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = 12;"},{"DocComment":" let y = &x as *const i32;"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     assert_eq!(std::ptr::read(y), 12);"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Manually implement [`mem::swap`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ptr;"},{"DocComment":""},{"DocComment":" fn swap<T>(a: &mut T, b: &mut T) {"},{"DocComment":"     unsafe {"},{"DocComment":"         // Create a bitwise copy of the value at `a` in `tmp`."},{"DocComment":"         let tmp = ptr::read(a);"},{"DocComment":""},{"DocComment":"         // Exiting at this point (either by explicitly returning or by"},{"DocComment":"         // calling a function which panics) would cause the value in `tmp` to"},{"DocComment":"         // be dropped while the same value is still referenced by `a`. This"},{"DocComment":"         // could trigger undefined behavior if `T` is not `Copy`."},{"DocComment":""},{"DocComment":"         // Create a bitwise copy of the value at `b` in `a`."},{"DocComment":"         // This is safe because mutable references cannot alias."},{"DocComment":"         ptr::copy_nonoverlapping(b, a, 1);"},{"DocComment":""},{"DocComment":"         // As above, exiting here could trigger undefined behavior because"},{"DocComment":"         // the same value is referenced by `a` and `b`."},{"DocComment":""},{"DocComment":"         // Move `tmp` into `b`."},{"DocComment":"         ptr::write(b, tmp);"},{"DocComment":""},{"DocComment":"         // `tmp` has been moved (`write` takes ownership of its second argument),"},{"DocComment":"         // so nothing is dropped implicitly here."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut foo = \"foo\".to_owned();"},{"DocComment":" let mut bar = \"bar\".to_owned();"},{"DocComment":""},{"DocComment":" swap(&mut foo, &mut bar);"},{"DocComment":""},{"DocComment":" assert_eq!(foo, \"bar\");"},{"DocComment":" assert_eq!(bar, \"foo\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Ownership of the Returned Value"},{"DocComment":""},{"DocComment":" `read` creates a bitwise copy of `T`, regardless of whether `T` is [`Copy`]."},{"DocComment":" If `T` is not [`Copy`], using both the returned value and the value at"},{"DocComment":" `*src` can violate memory safety. Note that assigning to `*src` counts as a"},{"DocComment":" use because it will attempt to drop the value at `*src`."},{"DocComment":""},{"DocComment":" [`write()`] can be used to overwrite data without causing it to be dropped."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ptr;"},{"DocComment":""},{"DocComment":" let mut s = String::from(\"foo\");"},{"DocComment":" unsafe {"},{"DocComment":"     // `s2` now points to the same underlying memory as `s`."},{"DocComment":"     let mut s2: String = ptr::read(&s);"},{"DocComment":""},{"DocComment":"     assert_eq!(s2, \"foo\");"},{"DocComment":""},{"DocComment":"     // Assigning to `s2` causes its original value to be dropped. Beyond"},{"DocComment":"     // this point, `s` must no longer be used, as the underlying memory has"},{"DocComment":"     // been freed."},{"DocComment":"     s2 = String::default();"},{"DocComment":"     assert_eq!(s2, \"\");"},{"DocComment":""},{"DocComment":"     // Assigning to `s` would cause the old value to be dropped again,"},{"DocComment":"     // resulting in undefined behavior."},{"DocComment":"     // s = String::from(\"bar\"); // ERROR"},{"DocComment":""},{"DocComment":"     // `ptr::write` can be used to overwrite a value without dropping it."},{"DocComment":"     ptr::write(&mut s, String::from(\"bar\"));"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(s, \"bar\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [valid]: self#safety"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"ptr_read"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":21291}],"output":{"Deduplicated":20677}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":212,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["forget",0]}],"span":{"data":{"file_id":46,"beg":{"line":189,"col":0},"end":{"line":189,"col":28}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Takes ownership and \"forgets\" about the value **without running its destructor**."},{"DocComment":""},{"DocComment":" Any resources the value manages, such as heap memory or a file handle, will linger"},{"DocComment":" forever in an unreachable state. However, it does not guarantee that pointers"},{"DocComment":" to this memory will remain valid."},{"DocComment":""},{"DocComment":" * If you want to leak memory, see [`Box::leak`]."},{"DocComment":" * If you want to obtain a raw pointer to the memory, see [`Box::into_raw`]."},{"DocComment":" * If you want to dispose of a value properly, running its destructor, see"},{"DocComment":"   [`mem::drop`]."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" `forget` is not marked as `unsafe`, because Rust's safety guarantees"},{"DocComment":" do not include a guarantee that destructors will always run. For example,"},{"DocComment":" a program can create a reference cycle using [`Rc`][rc], or call"},{"DocComment":" [`process::exit`][exit] to exit without running destructors. Thus, allowing"},{"DocComment":" `mem::forget` from safe code does not fundamentally change Rust's safety"},{"DocComment":" guarantees."},{"DocComment":""},{"DocComment":" That said, leaking resources such as memory or I/O objects is usually undesirable."},{"DocComment":" The need comes up in some specialized use cases for FFI or unsafe code, but even"},{"DocComment":" then, [`ManuallyDrop`] is typically preferred."},{"DocComment":""},{"DocComment":" Because forgetting a value is allowed, any `unsafe` code you write must"},{"DocComment":" allow for this possibility. You cannot return a value and expect that the"},{"DocComment":" caller will necessarily run the value's destructor."},{"DocComment":""},{"DocComment":" [rc]: ../../std/rc/struct.Rc.html"},{"DocComment":" [exit]: ../../std/process/fn.exit.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The canonical safe use of `mem::forget` is to circumvent a value's destructor"},{"DocComment":" implemented by the `Drop` trait. For example, this will leak a `File`, i.e. reclaim"},{"DocComment":" the space taken by the variable but never close the underlying system resource:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem;"},{"DocComment":" use std::fs::File;"},{"DocComment":""},{"DocComment":" let file = File::open(\"foo.txt\").unwrap();"},{"DocComment":" mem::forget(file);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This is useful when the ownership of the underlying resource was previously"},{"DocComment":" transferred to code outside of Rust, for example by transmitting the raw"},{"DocComment":" file descriptor to C code."},{"DocComment":""},{"DocComment":" # Relationship with `ManuallyDrop`"},{"DocComment":""},{"DocComment":" While `mem::forget` can also be used to transfer *memory* ownership, doing so is error-prone."},{"DocComment":" [`ManuallyDrop`] should be used instead. Consider, for example, this code:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem;"},{"DocComment":""},{"DocComment":" let mut v = vec![65, 122];"},{"DocComment":" // Build a `String` using the contents of `v`"},{"DocComment":" let s = unsafe { String::from_raw_parts(v.as_mut_ptr(), v.len(), v.capacity()) };"},{"DocComment":" // leak `v` because its memory is now managed by `s`"},{"DocComment":" mem::forget(v);  // ERROR - v is invalid and must not be passed to a function"},{"DocComment":" assert_eq!(s, \"Az\");"},{"DocComment":" // `s` is implicitly dropped and its memory deallocated."},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There are two issues with the above example:"},{"DocComment":""},{"DocComment":" * If more code were added between the construction of `String` and the invocation of"},{"DocComment":"   `mem::forget()`, a panic within it would cause a double free because the same memory"},{"DocComment":"   is handled by both `v` and `s`."},{"DocComment":" * After calling `v.as_mut_ptr()` and transmitting the ownership of the data to `s`,"},{"DocComment":"   the `v` value is invalid. Even when a value is just moved to `mem::forget` (which won't"},{"DocComment":"   inspect it), some types have strict requirements on their values that"},{"DocComment":"   make them invalid when dangling or no longer owned. Using invalid values in any"},{"DocComment":"   way, including passing them to or returning them from functions, constitutes"},{"DocComment":"   undefined behavior and may break the assumptions made by the compiler."},{"DocComment":""},{"DocComment":" Switching to `ManuallyDrop` avoids both issues:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" let v = vec![65, 122];"},{"DocComment":" // Before we disassemble `v` into its raw parts, make sure it"},{"DocComment":" // does not get dropped!"},{"DocComment":" let mut v = ManuallyDrop::new(v);"},{"DocComment":" // Now disassemble `v`. These operations cannot panic, so there cannot be a leak."},{"DocComment":" let (ptr, len, cap) = (v.as_mut_ptr(), v.len(), v.capacity());"},{"DocComment":" // Finally, build a `String`."},{"DocComment":" let s = unsafe { String::from_raw_parts(ptr, len, cap) };"},{"DocComment":" assert_eq!(s, \"Az\");"},{"DocComment":" // `s` is implicitly dropped and its memory deallocated."},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `ManuallyDrop` robustly prevents double-free because we disable `v`'s destructor"},{"DocComment":" before doing anything else. `mem::forget()` doesn't allow this because it consumes its"},{"DocComment":" argument, forcing us to call it only after extracting anything we need from `v`. Even"},{"DocComment":" if a panic were introduced between construction of `ManuallyDrop` and building the"},{"DocComment":" string (which cannot happen in the code as shown), it would result in a leak and not a"},{"DocComment":" double free. In other words, `ManuallyDrop` errs on the side of leaking instead of"},{"DocComment":" erring on the side of (double-)dropping."},{"DocComment":""},{"DocComment":" Also, `ManuallyDrop` prevents us from having to \"touch\" `v` after transferring the"},{"DocComment":" ownership to `s` — the final step of interacting with `v` to dispose of it without"},{"DocComment":" running its destructor is entirely avoided."},{"DocComment":""},{"DocComment":" [`Box`]: ../../std/boxed/struct.Box.html"},{"DocComment":" [`Box::leak`]: ../../std/boxed/struct.Box.html#method.leak"},{"DocComment":" [`Box::into_raw`]: ../../std/boxed/struct.Box.html#method.into_raw"},{"DocComment":" [`mem::drop`]: drop"},{"DocComment":" [ub]: ../../reference/behavior-considered-undefined.html"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"mem_forget"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":20677}],"output":{"Deduplicated":1938}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":213,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_uninit",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":6003},"kind":"InherentImplBlock"}}},{"Ident":["assume_init",0]}],"span":{"data":{"file_id":45,"beg":{"line":721,"col":4},"end":{"line":721,"col":46}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Extracts the value from the `MaybeUninit<T>` container. This is a great way"},{"DocComment":" to ensure that the data will get dropped, because the resulting `T` is"},{"DocComment":" subject to the usual drop handling."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" It is up to the caller to guarantee that the `MaybeUninit<T>` really is in an initialized"},{"DocComment":" state, i.e., a state that is considered [\"valid\" for type `T`][validity]. Calling this when"},{"DocComment":" the content is not yet fully initialized causes immediate undefined behavior. The"},{"DocComment":" [type-level documentation][inv] contains more information about this initialization"},{"DocComment":" invariant."},{"DocComment":""},{"DocComment":" It is a common mistake to assume that this function is safe to call on integers because they"},{"DocComment":" can hold all bit patterns. It is also a common mistake to think that calling this function"},{"DocComment":" is UB if any byte is uninitialized. Both of these assumptions are wrong. If that is"},{"DocComment":" surprising to you, please read the [type-level documentation][inv]."},{"DocComment":""},{"DocComment":" [inv]: #initialization-invariant"},{"DocComment":" [validity]: ../../reference/behavior-considered-undefined.html#r-undefined.validity"},{"DocComment":""},{"DocComment":" On top of that, remember that most types have additional invariants beyond merely"},{"DocComment":" being considered initialized at the type level. For example, a `1`-initialized [`Vec<T>`]"},{"DocComment":" is considered initialized (under the current implementation; this does not constitute"},{"DocComment":" a stable guarantee) because the only requirement the compiler knows about it"},{"DocComment":" is that the data pointer must be non-null. Creating such a `Vec<T>` does not cause"},{"DocComment":" *immediate* undefined behavior, but will cause undefined behavior with most"},{"DocComment":" safe operations (including dropping it)."},{"DocComment":""},{"DocComment":" [`Vec<T>`]: ../../std/vec/struct.Vec.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Correct usage of this method:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" let mut x = MaybeUninit::<bool>::uninit();"},{"DocComment":" x.write(true);"},{"DocComment":" let x_init = unsafe { x.assume_init() };"},{"DocComment":" assert_eq!(x_init, true);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" *Incorrect* usage of this method:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" let x: i32 = unsafe { MaybeUninit::uninit().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" See the [type-level documentation][#examples] for more examples."}],"inline":"Always","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"assume_init"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":21411}],"output":{"Deduplicated":20677}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":214,"item_meta":{"name":[{"Ident":["generic_array",0]},{"Ident":["iter",0]},{"Impl":{"Trait":63}},{"Ident":["next",0]}],"span":{"data":{"file_id":29,"beg":{"line":124,"col":4},"end":{"line":124,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"},{"index":1,"name":"N"},{"index":2,"name":"Clause0_ArrayType"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":29,"beg":{"line":119,"col":7},"end":{"line":119,"col":21}},"generated_from_span":null},"or