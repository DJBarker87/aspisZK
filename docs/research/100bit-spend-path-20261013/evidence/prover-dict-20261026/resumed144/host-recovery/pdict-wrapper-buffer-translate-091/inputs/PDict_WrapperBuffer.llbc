5,"col":21}},"generated_from_span":null},"id":2860,"kind":{"StorageDead":14},"comments_before":[]},{"span":{"data":{"file_id":10,"beg":{"line":455,"col":21},"end":{"line":455,"col":21}},"generated_from_span":null},"id":2861,"kind":{"StorageDead":13},"comments_before":[]},{"span":{"data":{"file_id":10,"beg":{"line":455,"col":21},"end":{"line":455,"col":21}},"generated_from_span":null},"id":2862,"kind":{"StorageDead":12},"comments_before":[]},{"span":{"data":{"file_id":10,"beg":{"line":455,"col":21},"end":{"line":455,"col":21}},"generated_from_span":null},"id":2863,"kind":{"StorageDead":3},"comments_before":[]},{"span":{"data":{"file_id":10,"beg":{"line":455,"col":21},"end":{"line":455,"col":21}},"generated_from_span":null},"id":2864,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"data":{"file_id":10,"beg":{"line":455,"col":21},"end":{"line":455,"col":21}},"generated_from_span":null},"id":2865,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"data":{"file_id":10,"beg":{"line":455,"col":21},"end":{"line":455,"col":21}},"generated_from_span":null},"id":2866,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":260,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["write",0]}],"span":{"data":{"file_id":41,"beg":{"line":1910,"col":0},"end":{"line":1910,"col":49}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Overwrites a memory location with the given value without reading or"},{"DocComment":" dropping the old value."},{"DocComment":""},{"DocComment":" `write` does not drop the contents of `dst`. This is safe, but it could leak"},{"DocComment":" allocations or resources, so care should be taken not to overwrite an object"},{"DocComment":" that should be dropped."},{"DocComment":""},{"DocComment":" Additionally, it does not drop `src`. Semantically, `src` is moved into the"},{"DocComment":" location pointed to by `dst`."},{"DocComment":""},{"DocComment":" This is appropriate for initializing uninitialized memory, or overwriting"},{"DocComment":" memory that has previously been [`read`] from."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Behavior is undefined if any of the following conditions are violated:"},{"DocComment":""},{"DocComment":" * `dst` must be [valid] for writes or `T` must be a ZST."},{"DocComment":""},{"DocComment":" * `dst` must be properly aligned. Use [`write_unaligned`] if this is not the"},{"DocComment":"   case."},{"DocComment":""},{"DocComment":" Note that even if `T` has size `0`, the pointer must be properly aligned."},{"DocComment":""},{"DocComment":" [valid]: self#safety"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut x = 0;"},{"DocComment":" let y = &mut x as *mut i32;"},{"DocComment":" let z = 12;"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     std::ptr::write(y, z);"},{"DocComment":"     assert_eq!(std::ptr::read(y), 12);"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Manually implement [`mem::swap`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ptr;"},{"DocComment":""},{"DocComment":" fn swap<T>(a: &mut T, b: &mut T) {"},{"DocComment":"     unsafe {"},{"DocComment":"         // Create a bitwise copy of the value at `a` in `tmp`."},{"DocComment":"         let tmp = ptr::read(a);"},{"DocComment":""},{"DocComment":"         // Exiting at this point (either by explicitly returning or by"},{"DocComment":"         // calling a function which panics) would cause the value in `tmp` to"},{"DocComment":"         // be dropped while the same value is still referenced by `a`. This"},{"DocComment":"         // could trigger undefined behavior if `T` is not `Copy`."},{"DocComment":""},{"DocComment":"         // Create a bitwise copy of the value at `b` in `a`."},{"DocComment":"         // This is safe because mutable references cannot alias."},{"DocComment":"         ptr::copy_nonoverlapping(b, a, 1);"},{"DocComment":""},{"DocComment":"         // As above, exiting here could trigger undefined behavior because"},{"DocComment":"         // the same value is referenced by `a` and `b`."},{"DocComment":""},{"DocComment":"         // Move `tmp` into `b`."},{"DocComment":"         ptr::write(b, tmp);"},{"DocComment":""},{"DocComment":"         // `tmp` has been moved (`write` takes ownership of its second argument),"},{"DocComment":"         // so nothing is dropped implicitly here."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut foo = \"foo\".to_owned();"},{"DocComment":" let mut bar = \"bar\".to_owned();"},{"DocComment":""},{"DocComment":" swap(&mut foo, &mut bar);"},{"DocComment":""},{"DocComment":" assert_eq!(foo, \"bar\");"},{"DocComment":" assert_eq!(bar, \"foo\");"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"ptr_write"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":21403},{"Deduplicated":20677}],"output":{"Deduplicated":1938}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":261,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["raw",0]},{"Ident":["from_raw_parts_mut",0]}],"span":{"data":{"file_id":42,"beg":{"line":179,"col":0},"end":{"line":179,"col":86}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the same functionality as [`from_raw_parts`], except that a"},{"DocComment":" mutable slice is returned."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Behavior is undefined if any of the following conditions are violated:"},{"DocComment":""},{"DocComment":" * `data` must be non-null, [valid] for both reads and writes for `len * size_of::<T>()` many bytes,"},{"DocComment":"   and it must be properly aligned. This means in particular:"},{"DocComment":""},{"DocComment":"     * The entire memory range of this slice must be contained within a single allocation!"},{"DocComment":"       Slices can never span across multiple allocations."},{"DocComment":"     * `data` must be non-null and aligned even for zero-length slices or slices of ZSTs. One"},{"DocComment":"       reason for this is that enum layout optimizations may rely on references"},{"DocComment":"       (including slices of any length) being aligned and non-null to distinguish"},{"DocComment":"       them from other data. You can obtain a pointer that is usable as `data`"},{"DocComment":"       for zero-length slices using [`NonNull::dangling()`]."},{"DocComment":""},{"DocComment":" * `data` must point to `len` consecutive properly initialized values of type `T`."},{"DocComment":""},{"DocComment":" * The memory referenced by the returned slice must not be accessed through any other pointer"},{"DocComment":"   (not derived from the return value) for the duration of lifetime `'a`."},{"DocComment":"   Both read and write accesses are forbidden."},{"DocComment":""},{"DocComment":" * The total size `len * size_of::<T>()` of the slice must be no larger than `isize::MAX`,"},{"DocComment":"   and adding that size to `data` must not \"wrap around\" the address space."},{"DocComment":"   See the safety documentation of [`pointer::offset`]."},{"DocComment":""},{"DocComment":" [valid]: ptr#safety"},{"DocComment":" [`NonNull::dangling()`]: ptr::NonNull::dangling"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"slice_from_raw_parts_mut"},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":21403},{"Deduplicated":1837}],"output":{"Deduplicated":20997}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},null,null,null,null,null,null,{"def_id":268,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["double_ended",0]},{"Ident":["DoubleEndedIterator",0]},{"Ident":["rfold",0]}],"span":{"data":{"file_id":69,"beg":{"line":305,"col":4},"end":{"line":308,"col":64}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator method that reduces the iterator's elements to a single,"},{"DocComment":" final value, starting from the back."},{"DocComment":""},{"DocComment":" This is the reverse version of [`Iterator::fold()`]: it takes elements"},{"DocComment":" starting from the back of the iterator."},{"DocComment":""},{"DocComment":" `rfold()` takes two arguments: an initial value, and a closure with two"},{"DocComment":" arguments: an 'accumulator', and an element. The closure returns the value that"},{"DocComment":" the accumulator should have for the next iteration."},{"DocComment":""},{"DocComment":" The initial value is the value the accumulator will have on the first"},{"DocComment":" call."},{"DocComment":""},{"DocComment":" After applying this closure to every element of the iterator, `rfold()`"},{"DocComment":" returns the accumulator."},{"DocComment":""},{"DocComment":" This operation is sometimes called 'reduce' or 'inject'."},{"DocComment":""},{"DocComment":" Folding is useful whenever you have a collection of something, and want"},{"DocComment":" to produce a single value from it."},{"DocComment":""},{"DocComment":" Note: `rfold()` combines elements in a *right-associative* fashion. For associative"},{"DocComment":" operators like `+`, the order the elements are combined in is not important, but for non-associative"},{"DocComment":" operators like `-` the order will affect the final result."},{"DocComment":" For a *left-associative* version of `rfold()`, see [`Iterator::fold()`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" // the sum of all of the elements of a"},{"DocComment":" let sum = a.iter()"},{"DocComment":"            .rfold(0, |acc, &x| acc + x);"},{"DocComment":""},{"DocComment":" assert_eq!(sum, 6);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This example demonstrates the right-associative nature of `rfold()`:"},{"DocComment":" it builds a string, starting with an initial value"},{"DocComment":" and continuing with each element from the back until the front:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let numbers = [1, 2, 3, 4, 5];"},{"DocComment":""},{"DocComment":" let zero = \"0\".to_string();"},{"DocComment":""},{"DocComment":" let result = numbers.iter().rfold(zero, |acc, &x| {"},{"DocComment":"     format!(\"({x} + {acc})\")"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" assert_eq!(result, \"(1 + (2 + (3 + (4 + (5 + 0)))))\");"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"B"},{"index":2,"name":"F"},{"index":3,"name":"Clause0_Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":35,"generics":{"regions":[],"types":[{"Deduplicated":20677},{"Deduplicated":20680}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":69,"beg":{"line":307,"col":22},"end":{"line":307,"col":38}},"generated_from_span":