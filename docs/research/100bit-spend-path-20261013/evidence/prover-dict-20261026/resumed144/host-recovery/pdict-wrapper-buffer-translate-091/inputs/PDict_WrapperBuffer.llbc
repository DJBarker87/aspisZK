`"},{"DocComment":""},{"DocComment":" Integers and other types implementing [`Copy`] are unaffected by `drop`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dropping_copy_types)]"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct Foo(u8);"},{"DocComment":""},{"DocComment":" let x = 1;"},{"DocComment":" let y = Foo(2);"},{"DocComment":" drop(x); // a copy of `x` is moved and dropped"},{"DocComment":" drop(y); // a copy of `y` is moved and dropped"},{"DocComment":""},{"DocComment":" println!(\"x: {}, y: {}\", x, y.0); // still available"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`RefCell`]: crate::cell::RefCell"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"mem_drop"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":46,"beg":{"line":1002,"col":7},"end":{"line":1002,"col":23}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":21,"generics":{"regions":[],"types":[{"Deduplicated":20677}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":20677}],"output":{"Deduplicated":1938}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":297,"item_meta":{"name":[{"Ident":["generic_array",0]},{"Ident":["sequence",0]},{"Ident":["GenericSequence",0]},{"Ident":["inverted_zip",0]},{"Impl":{"Trait":77}},{"Ident":["call_once",0]}],"span":{"data":{"file_id":32,"beg":{"line":46,"col":16},"end":{"line":46,"col":34}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"muta