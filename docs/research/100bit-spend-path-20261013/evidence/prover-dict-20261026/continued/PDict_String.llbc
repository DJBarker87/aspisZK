":""},{"DocComment":" Panics if the capacity exceeds `isize::MAX` _bytes_."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut s = String::with_capacity(10);"},{"DocComment":""},{"DocComment":" // The String contains no chars, even though it has capacity for more"},{"DocComment":" assert_eq!(s.len(), 0);"},{"DocComment":""},{"DocComment":" // These are all done without reallocating..."},{"DocComment":" let cap = s.capacity();"},{"DocComment":" for _ in 0..10 {"},{"DocComment":"     s.push('a');"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(s.capacity(), cap);"},{"DocComment":""},{"DocComment":" // ...but this may make the string reallocate"},{"DocComment":" s.push('a');"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":299}],"output":{"Deduplicated":344}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":1,"beg":{"line":493,"col":4},"end":{"line":495,"col":5}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":1,"beg":{"line":493,"col":45},"end":{"line":493,"col":51}},"generated_from_span":null},"ty":{"Deduplicated":344}},{"index":1,"name":"capacity","span":{"data":{"file_id":1,"beg":{"line":493,"col":25},"end":{"line":493,"col":33}},"generated_from_span":null},"ty":{"Deduplicated":299}},{"index":2,"name":null,"span":{"data":{"file_id":1,"beg":{"line":494,"col":22},"end":{"line":494,"col":50}},"generated_from_span":null},"ty":{"Deduplicated":1410}},{"index":3,"name":null,"span":{"data":{"file_id":5,"beg":{"line":977,"col":19},"end":{"line":977,"col":60}}