},{"Ident":["Zeroize",0]}],"span":{"data":{"file_id":1,"beg":{"line":272,"col":0},"end":{"line":272,"col":17}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Trait for securely erasing values from memory."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"zeroize","item_meta":{"name":[{"Ident":["zeroize",0]},{"Ident":["Zeroize",0]},{"Ident":["zeroize",0]}],"span":{"data":{"file_id":1,"beg":{"line":275,"col":4},"end":{"line":275,"col":26}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Zero out this object from memory using Rust intrinsics which ensure the"},{"DocComment":" zeroization operation is not \"optimized away\" by the compiler."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[5183,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":5088},"Mut"]}]}],"output":{"Deduplicated":570}},"default":null},"kind":{"TraitMethod":[0,0]}}],"vtable":{"id":{"Adt":12},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":1,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["AsMut",0]}],"span":{"data":{"file_id":2,"beg":{"line":371,"col":0},"end":{"line":371,"col":52}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to do a cheap mutable-to-mutable reference conversion."},{"DocComment":""},{"DocComment":" This trait is similar to [`AsRef`] but used for converting between mutable"},{"DocComment":" references. If you need to do a costly conversion it is better to"},{"DocComment":" implement [`From`] with type `&mut T` or write a custom function."},{"DocComment":""},{"DocComment":" **Note: This trait must not fail**. If the conversion can fail, use a"},{"DocComment":" dedicated method which returns an [`Option<T>`] or a [`Result<T, E>`]."},{"DocComment":""},{"DocComment":" # Generic Implementations"},{"DocComment":""},{"DocComment":" `AsMut` auto-dereferences if the inner type is a mutable reference"},{"DocComment":" (e.g.: `foo.as_mut()` will work the same if `foo` has type `&mut Foo` or `&mut &mut Foo`)."},{"DocComment":""},{"DocComment":" Note that due to historic reasons, the above currently does not hold generally for all"},{"DocComment":" [mutably dereferenceable types], e.g. `foo.as_mut()` will *not* work the same as"},{"DocComment":" `Box::new(foo).as_mut()`. Instead, many smart pointers provide an `as_mut` implementation which"},{"DocComment":" simply returns a reference to the [pointed-to value] (but do not perform a cheap"},{"DocComment":" reference-to-reference conversion for that value). However, [`AsMut::as_mut`] should not be"},{"DocComment":" used for the sole purpose of mutable dereferencing; instead ['`Deref` coercion'] can be used:"},{"DocComment":""},{"DocComment":" [mutably dereferenceable types]: core::ops::DerefMut"},{"DocComment":" [pointed-to value]: core::ops::Deref::Target"},{"DocComment":" ['`Deref` coercion']: core::ops::DerefMut#mutable-deref-coercion"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut x = Box::new(5i32);"},{"DocComment":" // Avoid this:"},{"DocComment":" // let y: &mut i32 = x.as_mut();"},{"DocComment":" // Better just write:"},{"DocComment":" let y: &mut i32 = &mut x;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Types which implement [`DerefMut`] should consider to add an implementation of `AsMut<T>` as"},{"DocComment":" follows:"},{"DocComment":""},{"DocComment":" [`DerefMut`]: core::ops::DerefMut"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use core::ops::{Deref, DerefMut};"},{"DocComment":" # struct SomeType;"},{"DocComment":" # impl Deref for SomeType {"},{"DocComment":" #     type Target = [u8];"},{"DocComment":" #     fn deref(&self) -> &[u8] {"},{"DocComment":" #         &[]"},{"DocComment":" #     }"},{"DocComment":" # }"},{"DocComment":" # impl DerefMut for SomeType {"},{"DocComment":" #     fn deref_mut(&mut self) -> &mut [u8] {"},{"DocComment":" #         &mut []"},{"DocComment":" #     }"},{"DocComment":" # }"},{"DocComment":" impl<T> AsMut<T> for SomeType"},{"DocComment":" where"},{"DocComment":"     <SomeType as Deref>::Target: AsMut<T>,"},{"DocComment":" {"},{"DocComment":"     fn as_mut(&mut self) -> &mut T {"},{"DocComment":"         self.deref_mut().as_mut()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Reflexivity"},{"DocComment":""},{"DocComment":" Ideally, `AsMut` would be reflexive, i.e. there would be an `impl<T: ?Sized> AsMut<T> for T`"},{"DocComment":" with [`as_mut`] simply returning its argument unchanged."},{"DocComment":" Such a blanket implementation is currently *not* provided due to technical restrictions of"},{"DocComment":" Rust's type system (it would be overlapping with another existing blanket implementation for"},{"DocComment":" `&mut T where T: AsMut<U>` which allows `AsMut` to auto-dereference, see \"Generic"},{"DocComment":" Implementations\" above)."},{"DocComment":""},{"DocComment":" [`as_mut`]: AsMut::as_mut"},{"DocComment":""},{"DocComment":" A trivial implementation of `AsMut<T> for T` must be added explicitly for a particular type `T`"},{"DocComment":" where needed or desired. Note, however, that not all types from `std` contain such an"},{"DocComment":" implementation, and those cannot be added by external code due to orphan rules."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Using `AsMut` as trait bound for a generic function, we can accept all mutable references that"},{"DocComment":" can be converted to type `&mut T`. Unlike [dereference], which has a single [target type],"},{"DocComment":" there can be multiple implementations of `AsMut` for a type. In particular, `Vec<T>` implements"},{"DocComment":" both `AsMut<Vec<T>>` and `AsMut<[T]>`."},{"DocComment":""},{"DocComment":" In the following, the example functions `caesar` and `null_terminate` provide a generic"},{"DocComment":" interface which works with any type that can be converted by cheap mutable-to-mutable conversion"},{"DocComment":" into a byte slice (`[u8]`) or a byte vector (`Vec<u8>`), respectively."},{"DocComment":""},{"DocComment":" [dereference]: core::ops::DerefMut"},{"DocComment":" [target type]: core::ops::Deref::Target"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct Document {"},{"DocComment":"     info: String,"},{"DocComment":"     content: Vec<u8>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T: ?Sized> AsMut<T> for Document"},{"DocComment":" where"},{"DocComment":"     Vec<u8>: AsMut<T>,"},{"DocComment":" {"},{"DocComment":"     fn as_mut(&mut self) -> &mut T {"},{"DocComment":"         self.content.as_mut()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn caesar<T: AsMut<[u8]>>(data: &mut T, key: u8) {"},{"DocComment":"     for byte in data.as_mut() {"},{"DocComment":"         *byte = byte.wrapping_add(key);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn null_terminate<T: AsMut<Vec<u8>>>(data: &mut T) {"},{"DocComment":"     // Using a non-generic inner function, which contains most of the"},{"DocComment":"     // functionality, helps to minimize monomorphization overhead."},{"DocComment":"     fn doit(data: &mut Vec<u8>) {"},{"DocComment":"         let len = data.len();"},{"DocComment":"         if len == 0 || data[len-1] != 0 {"},{"DocComment":"             data.push(0);"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":"     doit(data.as_mut());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let mut v: Vec<u8> = vec![1, 2, 3];"},{"DocComment":"     caesar(&mut v, 5);"},{"DocComment":"     assert_eq!(v, [6, 7, 8]);"},{"DocComment":"     null_terminate(&mut v);"},{"DocComment":"     assert_eq!(v, [6, 7, 8, 0]);"},{"DocComment":"     let mut doc = Document {"},{"DocComment":"         info: String::from(\"Example\"),"},{"DocComment":"         content: vec![17, 19, 8],"},{"DocComment":"     };"},{"DocComment":"     caesar(&mut doc, 1);"},{"DocComment":"     assert_eq!(doc.content, [18, 20, 9]);"},{"DocComment":"     null_terminate(&mut doc);"},{"DocComment":"     assert_eq!(doc.content, [18, 20, 9, 0]);"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note, however, that APIs don't need to be generic. In many cases taking a `&mut [u8]` or"},{"DocComment":" `&mut Vec<u8>`, for example, is the better choice (callers need to pass the correct type then)."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"AsMut"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"as_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["AsMut",0]},{"Ident":["as_mut",0]}],"span":{"data":{"file_id":2,"beg":{"line":374,"col":4},"end":{"line":374,"col":35}},"generated_from