15,"beg":{"line":394,"col":0},"end":{"line":394,"col":33}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Rhs"},{"index":2,"name":"Cmp"},{"index":3,"name":"Self_Output"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"data":{"file_id":15,"beg":{"line":395,"col":17},"end":{"line":395,"col":20}},"generated_from_span":null},"origin":{"TraitItem":0},"trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":5111}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"is_less_private","item_meta":{"name":[{"Ident":["typenum",0]},{"Ident":["private",0]},{"Ident":["IsLessPrivate",0]},{"Ident":["is_less_private",0]}],"span":{"data":{"file_id":15,"beg":{"line":398,"col":4},"end":{"line":398,"col":61}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":5088},{"Deduplicated":5089},{"Deduplicated":5090}],"output":{"Deduplicated":5111}},"default":null},"kind":{"TraitMethod":[13,0]}}],"vtable":{"id":{"Adt":27},"generics":{"regions":[],"types":[{"Deduplicated":5089},{"Deduplicated":5090},{"Deduplicated":5111}],"const_generics":[],"trait_refs":[]}}},{"def_id":14,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["deref",0]},{"Ident":["DerefMut",0]}],"span":{"data":{"file_id":16,"beg":{"line":270,"col":0},"end":{"line":270,"col":54}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used for mutable dereferencing operations, like in `*v = 1;`."},{"DocComment":""},{"DocComment":" In addition to being used for explicit dereferencing operations with the"},{"DocComment":" (unary) `*` operator in mutable contexts, `DerefMut` is also used implicitly"},{"DocComment":" by the compiler in many circumstances. This mechanism is called"},{"DocComment":" [\"mutable deref coercion\"][coercion]. In immutable contexts, [`Deref`] is used."},{"DocComment":""},{"DocComment":" **Warning:** Deref coercion is a powerful language feature which has"},{"DocComment":" far-reaching implications for every type that implements `DerefMut`. The"},{"DocComment":" compiler will silently insert calls to `DerefMut::deref_mut`. For this"},{"DocComment":" reason, one should be careful about implementing `DerefMut` and only do so"},{"DocComment":" when mutable deref coercion is desirable. See [the `Deref` docs][implementing]"},{"DocComment":" for advice on when this is typically desirable or undesirable."},{"DocComment":""},{"DocComment":" Types that implement `DerefMut` or `Deref` are often called \"smart"},{"DocComment":" pointers\" and the mechanism of deref coercion has been specifically designed"},{"DocComment":" to facilitate the pointer-like behavior that name suggests. Often, the"},{"DocComment":" purpose of a \"smart pointer\" type is to change the ownership semantics"},{"DocComment":" of a contained value (for example, [`Rc`][rc] or [`Cow`][cow]) or the"},{"DocComment":" storage semantics of a contained value (for example, [`Box`][box])."},{"DocComment":""},{"DocComment":" # Mutable deref coercion"},{"DocComment":""},{"DocComment":" If `T` implements `DerefMut<Target = U>`, and `v` is a value of type `T`,"},{"DocComment":" then:"},{"DocComment":""},{"DocComment":" * In mutable contexts, `*v` (where `T` is neither a reference nor a raw pointer)"},{"DocComment":"   is equivalent to `*DerefMut::deref_mut(&mut v)`."},{"DocComment":" * Values of type `&mut T` are coerced to values of type `&mut U`"},{"DocComment":" * `T` implicitly implements all the (mutable) methods of the type `U`."},{"DocComment":""},{"DocComment":" For more details, visit [the chapter in *The Rust Programming Language*][book]"},{"DocComment":" as well as the reference sections on [the dereference operator][ref-deref-op],"},{"DocComment":" [method resolution] and [type coercions]."},{"DocComment":""},{"DocComment":" # Fallibility"},{"DocComment":""},{"DocComment":" **This trait's method should never unexpectedly fail**. Deref coercion means"},{"DocComment":" the compiler will often insert calls to `DerefMut::deref_mut` implicitly."},{"DocComment":" Failure during dereferencing can be extremely confusing when `DerefMut` is"},{"DocComment":" invoked implicitly. In the majority of uses it should be infallible, though"},{"DocComment":" it may be acceptable to panic if the type is misused through programmer"},{"DocComment":" error, for example."},{"DocComment":""},{"DocComment":" However, infallibility is not enforced and therefore not guaranteed."},{"DocComment":" As such, `unsafe` code should not rely on infallibility in general for"},{"DocComment":" soundness."},{"DocComment":""},{"DocComment":" [book]: ../../book/ch15-02-deref.html"},{"DocComment":" [coercion]: #mutable-deref-coercion"},{"DocComment":" [implementing]: Deref#when-to-implement-deref-or-derefmut"},{"DocComment":" [ref-deref-op]: ../../reference/expressions/operator-expr.html#the-dereference-operator"},{"DocComment":" [method resolution]: ../../reference/expressions/method-call-expr.html"},{"DocComment":" [type coercions]: ../../reference/type-coercions.html"},{"DocComment":" [box]: ../../alloc/boxed/struct.Box.html"},{"DocComment":" [string]: ../../alloc/string/struct.String.html"},{"DocComment":" [rc]: ../../alloc/rc/struct.Rc.html"},{"DocComment":" [cow]: ../../alloc/borrow/enum.Cow.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" A struct with a single field which is modifiable by dereferencing the"},{"DocComment":" struct."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::{Deref, DerefMut};"},{"DocComment":""},{"DocComment":" struct DerefMutExample<T> {"},{"DocComment":"     value: T"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> Deref for DerefMutExample<T> {"},{"DocComment":"     type Target = T;"},{"DocComment":""},{"DocComment":"     fn deref(&self) -> &Self::Target {"},{"DocComment":"         &self.value"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> DerefMut for DerefMutExample<T> {"},{"DocComment":"     fn deref_mut(&mut self) -> &mut Self::Target {"},{"DocComment":"         &mut self.value"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut x = DerefMutExample { value: 'a' };"},{"DocComment":" *x = 'b';"},{"DocComment":" assert_eq!('b', x.value);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"deref_mut"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Self_Clause0_Target"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"data":{"file_id":16,"beg":{"line":270,"col":26},"end":{"line":270,"col":39}},"generated_from_span":null},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":15,"generics":{"regions":[],"types":[{"Deduplicated":5088},{"Deduplicated":5089}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"deref_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["deref",0]},{"Ident":["DerefMut",0]},{"Ident":["deref_mut",0]}],"span":{"data":{"file_id":16,"beg":{"line":274,"col":4},"end":{"line":274,"col":49}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Mutably dereferences the value."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"deref_mut_method"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":5183}],"output":{"Deduplicated":5184}},"default":null},"kind":{"TraitMethod":[14,0]}}],"vtable":{"id":{"Adt":28},"generics":{"regions":[],"types":[{"Deduplicated":5089}],"const_generics":[],"trait_refs":[]}}},{"def_id":15,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["deref",0]},{"Ident":["Deref",0]}],"span":{"data":{"file_id":16,"beg":{"line":139,"col":0},"end":{"line":139,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used for immutable dereferencing operations, like `*v`."},{"DocComment":""},{"DocComment":" In addition to being used for explicit dereferencing operations with the"},{"DocComment":" (unary) `*` operator in immutable contexts, `Deref` is also used implicitly"},{"DocComment":" by the compiler in many circumstances. This mechanism is called"},{"DocComment":" [\"`Deref` coercion\"][coercion]. In mutable contexts, [`DerefMut`] is used and"},{"DocComment":" mutable deref coercion similarly occurs."},{"DocComment":""},{"DocComment":" **Warning:** Deref coercion is a powerful language feature which has"},{"DocComment":" far-reaching implications for every type that implements `Deref`. The"},{"DocComment":" compiler will silently insert calls to `Deref::deref`. For this reason, one"},{"DocComment":" should be careful about implementing `Deref` and only do so when deref"},{"DocComment":" coercion is desirable. See [below][implementing] for advice on when this is"},{"DocComment":" typically desirable or undesirable."},{"DocComment":""},{"DocComment":" Types that implement `Deref` or `DerefMut` are often called \"smart"},{"DocComment":" pointers\" and the mechanism of deref coercion has been specifically designed"},{"DocComment":" to facilitate the pointer-like behavior that name suggests. Often, the"},{"DocComment":" purpose of a \"smart pointer\" type is to change the ownership semantics"},{"DocComment":" of a contained value (for example, [`Rc`][rc] or [`Cow`][cow]) or the"},{"DocComment":" storage semantics of a contained value (for example, [`Box`][box])."},{"DocComment":""},{"DocComment":" # Deref coercion"},{"DocComment":""},{"DocComment":" If `T` implements `Deref<Target = U>`, and `v` is a value of type `T`, then:"},{"DocComment":""},{"DocComment":" * In immutable contexts, `*v` (where `T` is neither a reference nor a raw"},{"DocComment":"   pointer) is equivalent to `*Deref::deref(&v)`."},{"DocComment":" * Values of type `&T` are coerced to values of type `&U`"},{"DocComment":" * `T` implicitly implements all the methods of the type `U` which take the"},{"DocComment":"   `&self` receiver."},{"DocComment":""},{"DocComment":" For more details, visit [the chapter in *The Rust Programming Language*][book]"},{"DocComment":" as well as the reference sections on [the dereference operator][ref-deref-op],"},{"DocComment":" [method resolution], and [type coercions]."},{"DocComment":""},{"DocComment":" # When to implement `Deref` or `DerefMut`"},{"DocComment":""},{"DocComment":" The same advice applies to both deref traits. In general, deref traits"},{"DocComment":" **should** be implemented if:"},{"DocComment":""},{"DocComment":" 1. a value of the type transparently behaves like a value of the target"},{"DocComment":"    type;"},{"DocComment":" 1. the implementation of the deref function is cheap; and"},{"DocComment":" 1. users of the type will not be surprised by any deref coercion behavior."},{"DocComment":""},{"DocComment":" In general, deref traits **should not** be implemented if:"},{"DocComment":""},{"DocComment":" 1. the deref implementations could fail unexpectedly; or"},{"DocComment":" 1. the type has methods that are likely to collide with methods on the"},{"DocComment":"    target type; or"},{"DocComment":" 1. committing to deref coercion as part of the public API is not desirable."},{"DocComment":""},{"DocComment":" Note that there's a large difference between implementing deref traits"},{"DocComment":" generically over many target types, and doing so only for specific target"},{"DocComment":" types."},{"DocComment":""},{"DocComment":" Generic implementations, such as for [`Box<T>`][box] (which is generic over"},{"DocComment":" every type and dereferences to `T`) should be careful to provide few or no"},{"DocComment":" methods, since the target type is unknown and therefore every method could"},{"DocComment":" collide with one on the target type, causing confusion for users."},{"DocComment":" `impl<T> Box<T>` has no methods (though several associated functions),"},{"DocComment":" partly for this reason."},{"DocComment":""},{"DocComment":" Specific implementations, such as for [`String`][string] (whose `Deref`"},{"DocComment":" implementation has `Target = str`) can have many methods, since avoiding"},{"DocComment":" collision is much easier. `String` and `str` both have many methods, and"},{"DocComment":" `String` additionally behaves as if it has every method of `str` because of"},{"DocComment":" deref coercion. The implementing type may also be generic while the"},{"DocComment":" implementation is still specific in this sense; for example, [`Vec<T>`][vec]"},{"DocComment":" dereferences to `[T]`, so methods of `T` are not applicable."},{"DocComment":""},{"DocComment":" Consider also that deref coercion means that deref traits are a much larger"},{"DocComment":" part of a type's public API than any other trait as it is implicitly called"},{"DocComment":" by the compiler. Therefore, it is advisable to consider whether this is"},{"DocComment":" something you are comfortable supporting as a public API."},{"DocComment":""},{"DocComment":" The [`AsRef`] and [`Borrow`][core::borrow::Borrow] traits have very similar"},{"DocComment":" signatures to `Deref`. It may be desirable to implement either or both of"},{"DocComment":" these, whether in addition to or rather than deref traits. See their"},{"DocComment":" documentation for details."},{"DocComment":""},{"DocComment":" # Fallibility"},{"DocComment":""},{"DocComment":" **This trait's method should never unexpectedly fail**. Deref coercion means"},{"DocComment":" the compiler will often insert calls to `Deref::deref` implicitly. Failure"},{"DocComment":" during dereferencing can be extremely confusing when `Deref` is invoked"},{"DocComment":" implicitly. In the majority of uses it should be infallible, though it may"},{"DocComment":" be acceptable to panic if the type is misused through programmer error, for"},{"DocComment":" example."},{"DocComment":""},{"DocComment":" However, infallibility is not enforced and therefore not guaranteed."},{"DocComment":" As such, `unsafe` code should not rely on infallibility in general for"},{"DocComment":" soundness."},{"DocComment":""},{"DocComment":" [book]: ../../book/ch15-02-deref.html"},{"DocComment":" [coercion]: #deref-coercion"},{"DocComment":" [implementing]: #when-to-implement-deref-or-derefmut"},{"DocComment":" [ref-deref-op]: ../../reference/expressions/operator-expr.html#the-dereference-operator"},{"DocComment":" [method resolution]: ../../reference/expressions/method-call-expr.html"},{"DocComment":" [type coercions]: ../../reference/type-coercions.html"},{"DocComment":" [box]: ../../alloc/boxed/struct.Box.html"},{"DocComment":" [string]: ../../alloc/string/struct.String.html"},{"DocComment":" [vec]: ../../alloc/vec/struct.Vec.html"},{"DocComment":" [rc]: ../../alloc/rc/struct.Rc.html"},{"DocComment":" [cow]: ../../alloc/borrow/enum.Cow.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" A struct with a single field which is accessible by dereferencing the"},{"DocComment":" struct."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::Deref;"},{"DocComment":""},{"DocComment":" struct DerefExample<T> {"},{"DocComment":"     value: T"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> Deref for DerefExample<T> {"},{"DocComment":"     type Target = T;"},{"DocComment":""},{"DocComment":"     fn deref(&self) -> &Self::Target {"},{"DocComment":"         &self.value"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let x = DerefExample { value: 'a' };"},{"DocComment":" assert_eq!('a', *x);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"deref"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Self_Target"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"deref","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["deref",0]},{"Ident":["Deref",0]},{"Ident":["deref",0]}],"span":{"data":{"file_id":16,"beg":{"line":150,"col":4},"end":{"line":150,"col":37}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Dereferences the value."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"deref_method"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":5190}],"output":{"HashConsedValue":[5192,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":5089},"Shared"]}]}},"default":null},"kind":