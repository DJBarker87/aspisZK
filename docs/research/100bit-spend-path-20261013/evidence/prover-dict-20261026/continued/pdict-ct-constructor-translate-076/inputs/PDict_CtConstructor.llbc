{"charon_version":"0.1.223","translated":{"crate_name":"pdict_offpath","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":["--cfg=kani","--cfg=pdict_extract"],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::ct_default"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["digest::core_api::ct_variable::CtVariableCoreWrapper","digest::core_api::ct_variable::_::default"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"PDict_CtConstructor.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"lib.rs"},"crate_name":"pdict_offpath","contents":"#[cfg(kani)]\npub fn zero_as_mut<T,Z:zeroize::Zeroize+AsMut<T>>(z:&mut zeroize::Zeroizing<Z>)->&mut T { z.as_mut() }\n#[cfg(kani)]\npub fn zero_deref_mut<Z:zeroize::Zeroize>(z:&mut zeroize::Zeroizing<Z>)->&mut Z { &mut *z }\n#[cfg(kani)]\npub fn ct_update(z:&mut sha2::digest::core_api::CtVariableCoreWrapper<sha2::Sha256VarCore,sha2::digest::typenum::U32>,blocks:&[sha2::digest::core_api::Block<sha2::Sha256VarCore>]) {\n    use sha2::digest::core_api::UpdateCore;\n    z.update_blocks(blocks)\n}\n#[cfg(kani)]\npub fn string_new(n:usize)->String { String::with_capacity(n) }\n#[cfg(kani)]\npub fn string_push(s:&mut String,t:&str) { s.push_str(t); }\n#[cfg(kani)]\npub fn string_path(s:&String)->&std::path::Path { s.as_ref() }\n#[cfg(kani)]\npub fn file_flush(file:&mut std::fs::File)->std::io::Result<()> {\n    use std::io::Write;\n    file.flush()\n}\n\n#[cfg(all(kani,not(pdict_extract)))]\n#[kani::proof]\nfn zeroizing_mutable_adapters_full_frame() {\n    #[derive(Clone)]\n    struct State { before:u64, cell:u64, after:u64 }\n    impl zeroize::Zeroize for State {\n        fn zeroize(&mut self) { self.cell=0; }\n    }\n    impl AsMut<u64> for State {\n        fn as_mut(&mut self)->&mut u64 { &mut self.cell }\n    }\n    let before:u64=kani::any(); let cell:u64=kani::any(); let after:u64=kani::any();\n    let replacement:u64=kani::any();\n    let mut z=zeroize::Zeroizing::new(State{before,cell,after});\n    assert!(*zero_as_mut(&mut z)==cell);\n    *zero_as_mut(&mut z)=replacement;\n    assert!(zero_deref_mut(&mut z).cell==replacement);\n    assert!(z.before==before && z.after==after);\n    let next:u64=kani::any();\n    zero_deref_mut(&mut z).cell=next;\n    assert!(*zero_as_mut(&mut z)==next);\n    assert!(z.before==before && z.after==after);\n}\n#[cfg(kani)]\npub fn ct_default()->sha2::digest::core_api::CtVariableCoreWrapper<sha2::Sha256VarCore,sha2::digest::typenum::U32> { Default::default() }\n"},{"id":1,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/digest-0.10.7/src/core_api/ct_variable.rs"},"crate_name":"digest","contents":null},{"id":2,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/digest-0.10.7/src/core_api.rs"},"crate_name":"digest","contents":null},{"id":3,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/digest-0.10.7/src/lib.rs"},"crate_name":"digest","contents":null},{"id":4,"name":{"Loc