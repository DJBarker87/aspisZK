    "text": "    pub fn to_le_bytes(self) -> [u8; Self::BYTE_LEN] {\n        let mut bytes = [0; Self::BYTE_LEN];\n        for (chunk, limb) in bytes.chunks_exact_mut(4).zip(self.to_limbs()) {\n            chunk.copy_from_slice(&limb.to_le_bytes());\n        }\n        bytes\n    }"
