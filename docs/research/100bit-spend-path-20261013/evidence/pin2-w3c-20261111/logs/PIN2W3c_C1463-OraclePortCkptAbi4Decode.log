def Aeneas.Std.Array.index_usize.{u} : {α : Type u} → {n : Usize} → Std.Array α n → Usize → Result α :=
fun {α} {n} v i =>
  match v[i]? with
  | none => fail Error.arrayOutOfBounds
  | some x => ok x
