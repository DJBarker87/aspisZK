{"charon_version":"0.1.223","translated":{"crate_name":"aspis_r1_parse_record_extract","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::r1_wire"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["core::option::Option","core::result::Result"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/Users/dominic/ZK/.worktrees/r1-j1-r12-pool-20261015/.j1-b-local-extraction/parse-record-d-helper-20261015/RecordParser.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"aarch64-apple-darwin","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"lib.rs"},"crate_name":"aspis_r1_parse_record_extract","contents":"#![no_std]\n#![allow(dead_code)]\nextern crate self as aspis_core;\npub mod field {\n/// The Mersenne prime 2^31 - 1.\npub const P: u32 = 0x7fff_ffff;\n/// M31 base field element, canonical representation in [0, P).\n#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]\npub struct M31(pub u32);\n/// CM31 = M31[i] / (i^2 + 1). Element a + b*i.\n#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]\npub struct CM31 {\n    pub a: M31,\n    pub b: M31,\n}\n/// QM31 = CM31[u] / (u^2 - (2 + i)). Element c0 + c1*u. (stwo parameterization)\n#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]\npub struct QM31 {\n    pub c0: CM31,\n    pub c1: CM31,\n}\n    impl QM31 {\n    pub const ZERO: QM31 = QM31 {\n        c0: CM31 {\n            a: M31(0),\n            b: M31(0),\n        },\n        c1: CM31 {\n            a: M31(0),\n            b: M31(0),\n        },\n    };\n    }\n    mod wide_exact {\n        use super::{CM31, M31, P, QM31};\n/// `E = QM31[v]/(v² - u)`, where `u² = 2+i` and `i² = -1`.\n///\n/// Exactly two QM31 coordinates, `c0 + c1*v`, or eight canonical M31 limbs.\n/// For digits `d[0..8]` in `[0, P)`, the exact decode formula is\n///\n/// ```text\n/// decode4(a,b,c,d) = (a + b*i) + (c + d*i)*u\n/// decode8(d) = decode4(d0,d1,d2,d3) + decode4(d4,d5,d6,d7)*v\n/// ```\n///\n/// Thus limb order is `(c0.c0.a, c0.c0.b, c0.c1.a, c0.c1.b,\n/// c1.c0.a, c1.c0.b, c1.c1.a, c1.c1.b)`, matching\n/// `R0C/ModuloField.lean:digitsField_apply` (lines 38–40) and\n/// `AspisV8R19/SamplerFieldDecode.lean:decode4` (line 10).\n/// `WideTower.lean:qm31_wideU_not_isSquare` supplies the mathematical\n/// non-residue fact; `wideExact_card` gives `|E| = P^8`.\n/// These references specify the arithmetic; they do not prove this Rust code.\n///\n/// Coordinates are private to preserve canonicality. Algebraic constructors\n/// reduce raw QM31 representatives; wire/digit decoders reject noncanonical\n/// input. All operations are total except inversion, which returns `None` at\n/// zero. This reference implementation makes no constant-time claim.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub struct WideExact {\n    c0: QM31,\n    c1: QM31,\n}\n        impl WideExact {\n    pub const LIMB_COUNT: usize = 8;\n    pub const BYTE_LEN: usize = 32;\n    #[inline(always)]\n    pub const fn c1(self) -> QM31 {\n        self.c1\n    }\n    /// Decode eight base-P digits without reduction; rejects any digit >= P.\n    /// This is `digitsField`, not the natural-number cast of a base-P rank.\n    #[inline(always)]\n    pub fn from_limbs(limbs: [u32; Self::LIMB_COUNT]) -> Option<Self> {\n        if limbs[0] >= P || limbs[1] >= P || limbs[2] >= P || limbs[3] >= P\n            || limbs[4] >= P || limbs[5] >= P || limbs[6] >= P || limbs[7] >= P {\n            return None;\n        }\n        let [a, b, c, d, e, f, g, h] = limbs;\n        Some(Self {\n            c0: QM31 {\n                c0: CM31 {\n                    a: M31(a),\n                    b: M31(b),\n                },\n                c1: CM31 {\n                    a: M31(c),\n                    b: M31(d),\n                },\n            },\n            c1: QM31 {\n                c0: CM31 {\n                    a: M31(e),\n                    b: M31(f),\n                },\n                c1: CM31 {\n                    a: M31(g),\n                    b: M31(h),\n                },\n            },\n        })\n    }\n    /// Exactly 32 bytes: eight little-endian u32 limbs in `digitsField` order.\n    /// Rejects both wrong lengths and noncanonical limbs, without slicing an\n    /// unvalidated input. This is a field encoding, not the R-B block sampler.\n    #[inline(always)]\n    pub fn from_le_bytes(bytes: &[u8]) -> Option<Self> {\n        if bytes.len() != Self::BYTE_LEN {\n            return None;\n        }\n        let limbs = [\n            u32::from_le_bytes([bytes[0], bytes[1], bytes[2], bytes[3]]),\n            u32::from_le_bytes([bytes[4], bytes[5], bytes[6], bytes[7]]),\n            u32::from_le_bytes([bytes[8], bytes[9], bytes[10], bytes[11]]),\n            u32::from_le_bytes([bytes[12], bytes[13], bytes[14], bytes[15]]),\n            u32::from_le_bytes([bytes[16], bytes[17], bytes[18], bytes[19]]),\n            u32::from_le_bytes([bytes[20], bytes[21], bytes[22], bytes[23]]),\n            u32::from_le_bytes([bytes[24], bytes[25], bytes[26], bytes[27]]),\n            u32::from_le_bytes([bytes[28], bytes[29], bytes[30], bytes[31]]),\n        ];\n        Self::from_limbs(limbs)\n    }\n        }\n    }\n    pub use wide_exact::WideExact;\n}\npub mod r1_wire {\n    use aspis_core::field::{QM31, WideExact};\npub const LANES: usize = 29;\npub const POINTS: usize = 3;\npub const CLAIMS: usize = POINTS * LANES;\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Error {\n    Allocation,\n    RowOrder { expected: u8, actual: u8 },\n    InvalidRow,\n    Tag { row: u8 },\n    Length { row: u8 },\n    NonCanonical { row: u8, value: usize },\n    Boundary { round: usize },\n    Terminal,\n    EqualCirclePoints,\n    TrailingBytes,\n    Public,\n}\n/// P1 tag and exact payload length, including the message-free rows.\npub const fn row_shape(row: u8) -> Option<(u8, usize)> {\n    match row {\n        0 | 1 | 3..=13 => Some((0, 0)),\n        2 => Some((1, 32)),\n        14 => Some((3, 32)),\n        15..=24 => Some((2, 28 * 32)),\n        25 => Some((4, (CLAIMS + LANES) * 32)),\n        26 => Some((5, LANES * 32)),\n        _ => None,\n    }\n}\nfn validate_record_fields(row: u8, payload: &[u8]) -> Result<(), Error> {\n    for (value, bytes) in payload.chunks_exact(32).enumerate() {\n        let x = WideExact::from_le_bytes(bytes).ok_or(Error::NonCanonical { row, value })?;\n        if x.c1() != QM31::ZERO {\n            return Err(Error::NonCanonical { row, value });\n        }\n    }\n    Ok(())\n}\n/// Reject malformed framing and every noncanonical E limb before hashing.\n/// UNPROVED P2 subset: reject any nonzero E high component at parse.\npub fn parse_record(row: u8, record: &[u8]) -> Result<&[u8], Error> {\n    let (tag, size) = row_shape(row).ok_or(Error::InvalidRow)?;\n    if record.len() != 5 + size {\n        return Err(Error::Length { row });\n    }\n    if record[0] != tag {\n        return Err(Error::Tag { row });\n    }\n    if u32::from_le_bytes(record[1..5].try_into().unwrap()) as usize != size {\n        return Err(Error::Length { row });\n    }\n    let payload = &record[5..];\n    if row >= 14 {\n        validate_record_fields(row, payload)?;\n    }\n    Ok(payload)\n}\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/fmt/mod.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/iter/adapters/enumerate.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/iter/adapters/mod.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/iter/mod.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/slice/iter.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/convert/mod.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/iter/traits/iterator.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/iter/traits/mod.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"/rustc/library/core/src/ite