4), (531874659, 2093948690), (274337143, 1881376116), (1734948438, 924408729),\n    (875099799, 1659345298), (1568619121, 824042977), (936298450, 1105042578), (1577684276, 2022021752),\n    (404074859, 398369746), (931704942, 1582955093), (18011247, 565274326), (931164423, 2037669329),\n    (1309629376, 2080668066), (1286492231, 1508399759), (1807661853, 544066780), (1942053500, 1814876063),\n];\n\n#[inline]\nfn table_value(value: (u32, u32)) -> CM31 {\n    CM31::new(M31(value.0), M31(value.1))\n}\n\n/// Return exactly the core R0 fibre point for this checked index.\n#[inline]\npub fn fibre_point(u: FibreIndex) -> Point<M31> {\n    let index = u.get();\n    let left = table_value(TABLE_A[index & 511]);\n    let right = table_value(TABLE_B[index >> 9]);\n    let point = left.mul(right);\n    Point {\n        x: point.a,\n        y: point.b,\n    }\n}\n\n/// Return the R0 line node `2*x^2 - 1` for this checked fibre index.\n#[inline]\npub fn line_node(u: FibreIndex) -> M31 {\n    let x = fibre_point(u).x;\n    let square = x.mul(x);\n    square.double().sub(M31::ONE)\n}\n\n}\npub mod verifier {\n    use alloc::vec::Vec;\n    use crate::{domain, fast_domain, Error, field::M31};\n/// The five base-field denominators used to fold one sampled query: circle\n/// x/y, followed by line x/y/z. Their inverses are batch-computed once per\n/// transaction so each query avoids five independent field inversions.\npub struct QueryGeometry { start:usize, inverses:Vec<[M31;5]>, line_z:Vec<M31> }\nimpl QueryGeometry {\n    fn for_range(queries:&[u32;22],start:usize,end:usize)->Result<Self,Error> {\n        if start>end||end>queries.len(){return Err(Error::Query);}\n        let mut line_z_values=Vec::with_capacity(end-start);\n        let mut flat=Vec::with_capacity((end-start)*5);\n        for &query in &queries[start..end] {\n            let u=query as usize;\n            let fibre=domain::FibreIndex::new(u).map_err(|_|Error::Query)?;\n            let point=crate::fast_domain::fibre_point(fibre);\n            let line_x=crate::fast_domain::line_node(domain::FibreIndex::new(u/4*4).map_err(|_|Error::Query)?);\n            let line_y=crate::fast_domain::line_node(domain::FibreIndex::new(u/4*4+3).map_err(|_|Error::Query)?);\n            let line_z=line_x.mul(line_x).double().sub(M31::ONE);\n            let values=[point.x,point.y,line_x,line_y,line_z];\n            if values.iter().any(|x|*x==M31::ZERO){return Err(Error::Query);}\n            flat.extend_from_slice(&values);\n            line_z_values.push(line_z);\n        }\n        if flat.is_empty(){return Ok(Self{start,inverses:Vec::new(),line_z:line_z_values});}\n        // Standard prefix-product/backward batch inversion. The only `inv`\n        // in this routine is applied to the product of all nonzero entries.\n        let mut prefixes=Vec::with_capacity(flat.len());\n        let mut product=M31::ONE;\n        for &value in &flat {prefixes.push(product);product=product.mul(value);}\n        let mut suffix_inverse=product.inv();\n        let mut flat_inverse=Vec::with_capacity(flat.len());\n        flat_inverse.resize(flat.len(),M31::ZERO);\n        for i in (0..flat.len()).rev() {\n            flat_inverse[i]=suffix_inverse.mul(prefixes[i]);\n            suffix_inverse=suffix_inverse.mul(flat[i]);\n        }\n        let inverses=(0..line_z_values.len()).map(|i|core::array::from_fn(|j|flat_inverse[5*i+j])).collect();\n        Ok(Self{start,inverses,line_z:line_z_values})\n    }\n}\n/// Public extraction root for the exact private source method. This wrapper is\n/// confined to the extraction kit and does not modify the adopted Rust source.\npub fn for_range_entry(queries: &[u32; 22], start: usize, end: usize) -> Result<QueryGeometry, Error> {\n    QueryGeometry::for_range(queries, start, end)\n}\n}\n"}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["r17_querygeo_extraction",0]},{"Ident":["fast_domain",0]},{"Ident":["fibre_point",0]}]},{"key":{"Type":0},"value":[{"Ident":["r17_querygeo