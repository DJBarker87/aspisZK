       pub fn mul(self, _: Self) -> Self { panic!() }\n        pub fn double(self) -> Self { panic!() }\n        pub fn sub(self, _: Self) -> Self { panic!() }\n        pub fn inv(self) -> Self { panic!() }\n    }\n    #[derive(Clone, Copy)]\n    pub struct CM31 { pub a: M31, pub b: M31 }\n    impl CM31 {\n        pub fn new(a: M31, b: M31) -> Self { Self { a, b } }\n        pub fn mul(self, _: Self) -> Self { panic!() }\n    }\n}\npub mod domain {\n    use crate::{Error, field::M31};\n    #[derive(Clone, Copy)]\n    pub struct FibreIndex(usize);\n    impl FibreIndex {\n        pub fn new(i: usize) -> Result<Self, Error> { if i < 262144 { Ok(Self(i)) } else { Err(Error::IndexOutOfRange) } }\n        pub const fn get(self) -> usize { self.0 }\n    }\n    #[derive(Clone, Copy)]\n    pub struct Point<E> { pub x: E, pub y: E }\n}\n#[derive(Clone, Copy)]\npub enum Error { Query, IndexOutOfRange }\npub mod fast_domain {\n//! Exact, factored evaluation of the checked R0 fibre domain.\n//!\n//! For u = 512*hi + lo, reversing its 18 bits gives\n//! `rev18(u) = (reverse9(lo) << 9) + reverse9(hi)`. Therefore the specified\n//! point `g^(1024 + 4096*rev18(u))` is exactly the product of the A and B\n//! table entries below. These generated constants only replace exponentiation\n//! with two indexed loads and one CM31 multiplication; the domain, generator,\n//! index map, and protocol behavior are unchanged.\n\nuse crate::field::{CM31, M31};\nuse crate::domain::{FibreIndex, Point};\n\nconst TABLE_A: [(u32, u32); 512] = [\n    (1022251061, 788094511), (788094511, 1125232586), (1462922215, 117240331), (117240331, 684561432),\n    (479936188, 217587789), (217587789, 1667547459), (797223315, 1892184156), (1892184156, 1350260332),\n    (1601663285, 2022005567), (2022005567, 545820362), (1715132412, 1963268365), (1963268365, 432351235),\n    (1329069890, 1640136239), (1640136239, 818413757), (1052324090, 1064735370), (1064735370, 1095159557),\n    (119109612, 1742172267), (1742172267, 