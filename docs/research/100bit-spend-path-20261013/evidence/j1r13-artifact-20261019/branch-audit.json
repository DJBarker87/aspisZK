  "audit_script_source": "import hashlib,json,pathlib,re,subprocess,sys,time,resource\nstart=time.monotonic();root=pathlib.Path.cwd()\nbase='f59a21fc15dcad23fcad412afe42b83ee319ed50'\ngit=lambda *a:subprocess.check_output(['git',*a])\nhead=git('rev-parse','HEAD').decode().strip()\nassert git('branch','--show-current').decode().strip()=='codex/r1-checkpoint-recut-20261018'\nassert git('status','--porcelain')==b''\nassert subprocess.run(['git','merge-base','--is-ancestor',base,head]).returncode==0\nprefix='docs/research/100bit-spend-path-20261013/evidence/'\nallowed=('j1r13-artifact-20261019/','readonly-runtime-1h-20261019/','decision1h-rollover-measurements-20261019/','lean-module-hygiene-inventory-20261019/','prepared-arithmetic-proposals-20261019/')\ncommits=git('rev-list','--reverse',base+'..'+head).decode().splitlines();trees=[]\nfor c in commits:\n changed=git('diff-tree','--no-commit-id','--name-only','-r','-z',c).decode().rstrip('\\0').split('\\0')\n for n in changed:\n  assert any(n.startswith(prefix+x) for x in allowed),n\n  assert n.endswith(('.json','.log')) or pathlib.PurePosixPath(n).name=='SHA256SUMS',n\n msg=git('show','-s','--format=%B',c).decode()\n assert not re.search(r'(?im)^co-authored-by:.*(openai|chatgpt|codex|claude|copilot|assistant)',msg)\n files=[]\n for row in git('ls-tree','-r','-l','-z',c).split(b'\\0'):\n  if not row:continue\n  info,path=row.split(b'\\t',1);mode,typ,obj,size=info.split()\n  if typ==b'blob':\n   assert int(size)<=90000000,(c,path,size)\n   files.append({'path':path.decode(),'bytes':int(size),'blob':obj.decode()})\n trees.append({'commit':c,'file_count':len(files),'largest_file':max(files,key=lambda x:x['bytes']),'changed_paths':changed})\nassert git('diff','--name-only',base,head,'--','crates','programs','tools','Cargo.toml','Cargo.lock','*.lean')==b''\nreach=git('rev-list','--objects',head).decode().splitlines();old='de8869cff836ba49cda1b66c473b885f11d410e2'\nassert all(x.split(' ',1)[0]!=old for x in reach)\nverifier_