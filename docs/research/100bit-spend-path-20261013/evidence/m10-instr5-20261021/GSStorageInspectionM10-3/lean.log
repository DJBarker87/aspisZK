def RRVectorNormalizedRows.rowsThrough.{u_1} : {K : Type u_1} → [Field K] → List (List K) → K → ℕ → ℕ → List (List K) :=
fun {K} [Field K] gs a M B => List.ofFn fun n => RRVectorRowPolynomialBridge.row gs a M ↑n
def RRVectorActualScanner.rowsUpTo.{u_1} : {K : Type u_1} → [Field K] → List (List K) → K → ℕ → ℕ → List (List K) :=
fun {K} [Field K] gs a M L => List.ofFn fun i => RRVectorRowPolynomialBridge.row gs a M ↑i
def RRVectorRowPolynomialBridge.row.{u_1} : {K : Type u_1} → [Field K] → List (List K) → K → ℕ → ℕ → List K :=
fun {K} [Field K] gs a M n => List.ofFn fun j => RRVectorRowPolynomialBridge.rowValue gs a M n ↑j
def RRDenseCoeffVector.coeffAt.{u_1} : {K : Type u_1} → [Field K] → List K → ℕ → K :=
fun {K} [Field K] cs i => cs[i]?.getD 0
def RRDenseCoeffVector.toPolynomial.{u_1} : {K : Type u_1} → [inst : Field K] → List K → Polynomial K :=
fun {K} [Field K] cs => ∑ i ∈ Finset.range cs.length, (Polynomial.monomial i) (RRDenseCoeffVector.coeffAt cs i)
def RRVectorRowPolynomialBridge.rowValue.{u_1} : {K : Type u_1} → [Field K] → List (List K) → K → ℕ → ℕ → ℕ → K :=
fun {K} [Field K] gs a M n j =>
  if j ≤ n then
    if n - j ≤ M then RRDenseCoeffVector.taylorCoeffVector (RRVectorRowPolynomialBridge.vectorAt gs (n - j)) a j else 0
  else 0
def RRVectorRowPolynomialBridge.row.{u_1} : {K : Type u_1} → [Field K] → List (List K) → K → Nat → Nat → List K :=
fun {K} [inst : Field K] gs a M n =>
  @List.ofFn K
    (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) n (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))
    fun j =>
    @RRVectorRowPolynomialBridge.rowValue K inst gs a M n
      (@Fin.val
        (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) n (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))
        j)
def RRVectorRowPolynomialBridge.vectorAt.{u_1} : {K : Type u_1} → List (List K) → ℕ → List K :=
fun {K} gs i => gs[i]?.getD []
def CompPoly.GuruswamiSudan.denseInterpolateWithBasisAndKernel.{u_1} : {F : Type u_1} →
  [inst : Field F] →
    [inst_1 : BEq F] →
      [inst_2 : LawfulBEq F] →
        [DecidableEq F] →
          CompPoly.GuruswamiSudan.LinearKernelContext F →
            Array CompPoly.CBivariate.Monomial →
              Array (F × F) → CompPoly.GuruswamiSudan.GSInterpParams → Option (CompPoly.CBivariate F) :=
fun {F} [Field F] [BEq F] [LawfulBEq F] [DecidableEq F] kernelContext basis points params =>
  have matrix := CompPoly.GuruswamiSudan.interpolationMatrixOnBasis basis points params;
  CompPoly.GuruswamiSudan.normalizeInterpolationPolynomialOnBasis? basis =<< kernelContext.homogeneousWitness matrix
def CompPoly.GuruswamiSudan.denseLinearKernelContext.{u_1} : (F : Type u_1) →
  [inst : Field F] → [inst_1 : BEq F] → [inst_2 : LawfulBEq F] → CompPoly.GuruswamiSudan.LinearKernelContext F :=
fun F [Field F] [BEq F] [LawfulBEq F] =>
  { homogeneousWitness := CompPoly.DenseMatrix.homogeneousWitnessInPlace, witness_width := ⋯, witness_sound := ⋯,
    witness_nonzero := ⋯, witness_complete := ⋯ }
def CompPoly.GuruswamiSudan.interpolationMatrixOnBasis.{u_1} : {F : Type u_1} →
  [inst : Semiring F] →
    Array CompPoly.CBivariate.Monomial →
      Array (F × F) → CompPoly.GuruswamiSudan.GSInterpParams → CompPoly.DenseMatrix F :=
fun {F} [Semiring F] basis points params =>
  CompPoly.GuruswamiSudan.interpolationConstraintMatrixOnBasis basis
    (CompPoly.GuruswamiSudan.interpolationConstraints points params.multiplicity)
def CompPoly.GuruswamiSudan.normalizeInterpolationPolynomialOnBasis?.{u_1} : {F : Type u_1} →
  [inst : Field F] →
    [inst_1 : BEq F] →
      [LawfulBEq F] → [DecidableEq F] → Array CompPoly.CBivariate.Monomial → Array F → Option (CompPoly.CBivariate F) :=
fun {F} [Field F] [BEq F] [LawfulBEq F] [DecidableEq F] basis coeffs =>
  match CompPoly.GuruswamiSudan.normalizeVector? coeffs with
  | none => none
  | some normalized => some (CompPoly.GuruswamiSudan.interpolationPolynomialOnBasis basis normalized)
def CompPoly.DenseMatrix.homogeneousWitnessInPlace.{u_1} : {F : Type u_1} →
  [inst : Field F] → [BEq F] → CompPoly.DenseMatrix F → Option (Array F) :=
fun {F} [Field F] [BEq F] M =>
  have basis := M.homogeneousKernelBasisInPlace;
  if basis.size = 0 then none else some (basis.getD 0 #[])
