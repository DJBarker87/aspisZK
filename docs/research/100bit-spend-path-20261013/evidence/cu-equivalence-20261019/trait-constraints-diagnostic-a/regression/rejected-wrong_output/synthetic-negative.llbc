:"Always","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Adt":{"id":{"Adt":23},"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Free":0}}}],"const_generics":[],"trait_refs":[]}}}},"Mut"]}},{"Untagged":{"TypeVar":{"Free":0}}}],"output":{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"TypeVar":{"Free":0}}},"Mut"]}}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":214,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Untagged":{"Literal":{"UInt":"Usize"}}},"kind":"InherentImplBlock"}}},{"Ident":["unchecked_add",0]}],"span":{"data":{"file_id":65,"beg":{"line":959,"col":8},"end":{"line":959,"col":66}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Unchecked integer addition. Computes `self + rhs`, assuming overflow"},{"DocComment":" cannot occur."},{"DocComment":""},{"DocComment":" Calling `x.unchecked_add(y)` is semantically equivalent to calling"},{"DocComment":" `x.`[`checked_add`]`(y).`[`unwrap_unchecked`]`()`."},{"DocComment":""},{"DocComment":" If you're just trying to avoid the panic in debug mode, then **do not**"},{"DocComment":" use this.  Instead, you're looking for [`wrapping_add`]."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" This results in undefined behavior when"},{"DocComment":"`self + rhs > usize::MAX`,"},{"DocComment":" i.e. when [`checked_add`] would return `None`."},{"DocComment":""},