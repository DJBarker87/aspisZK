mment":" The error type for errors that can never happen."},{"DocComment":""},{"DocComment":" Since this enum has no variant, a value of this type can never actually exist."},{"DocComment":" This can be useful for generic APIs that use [`Result`] and parameterize the error type,"},{"DocComment":" to indicate that the result is always [`Ok`]."},{"DocComment":""},{"DocComment":" For example, the [`TryFrom`] trait (conversion that returns a [`Result`])"},{"DocComment":" has a blanket implementation for all types where a reverse [`Into`] implementation exists."},{"DocComment":""},{"DocComment":" ```ignore (illustrates std code, duplicating the impl in a doctest would be an error)"},{"DocComment":" impl<T, U> TryFrom<U> for T where U: Into<T> {"},{"DocComment":"     type Error = Infallible;"},{"DocComment":""},{"DocComment":"     fn try_from(value: U) -> Result<Self, Infallible> {"},{"DocComment":"         Ok(U::into(value))  // Never returns `Err`"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Future compatibility"},{"DocComment":""},{"DocComment":" This enum has the same role as [the `!` \u201cnever\u201d type][never],"},{"DocComment":" which is unstable in this version of Rust."},{"DocComment":" When `!` is stabilized, we plan to make `Infallible` a type alias to it:"},{"DocComment":""},{"DocComment":" ```ignore (illustrates future std change)"},{"DocComment":" pub type Infallible = !;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" \u2026 and eventually deprecate `Infallible`."},{"DocComment":""},{"DocComment":" However there is one case where `!` syntax can be used"},{"DocComment":" before `!` is stabilized as a full-fledged type: in the position of a function\u2019s return type."},{"DocComment":" Specifically, it is possible to have implementations for two different function pointer types:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" trait MyTrait {}"},{"DocComment":" impl MyTrait for fn() -> ! {}"},{"DocComment":" impl MyTrait for fn() -> std::convert::Infallible {}"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" With `Infallible` being an enum, this code is valid."},{"DocComment":" However when `Infallible` becomes an alias for the never type,"},{"DocComment":" the two `impl`s will start to overlap"},{"DocComment":" and therefore will be disallowed by the language\u2019s trait coherence rules."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":null,"uninhabited":true,"variant_layouts":[],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":60,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Ident":["niche_types",0]},{"Ident":["NonZeroUsizeInner",0]}],"span":{"data":{"file_id":64,"beg":{"line":20,"col":8},"end":{"line":20,"col":55}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":8,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},null,null,null,null,null,null],"fun_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["aspis_r1_cu_dots",0]},{"Ident":["old_dots",0]},{"Ident":["four_dots",0]}],"span":{"data":{"file_id":0,"beg":{"line":13,"col":0},"end":{"line":44,"col":1}},"generated_from_span":null},"source_text":"pub fn four_dots(q: &[u8], g: &[WideExact; 29]) -> [WideExact; 4] {\n    core::array::from_fn(|slot| {\n        let mut limbs = [0u64; WideExact::LIMB_COUNT];\n        for start in (0..26).step_by(4) {\n            let mut sums = [0u64; WideExact::LIMB_COUNT];\n            for term in start..core::cmp::min(start + 4, 26) {\n                let scalar = M31::from_le_bytes(\n                    q[slot * 120 + term * 4..slot * 120 + term * 4 + 4]\n                        .try_into()\n                        .unwrap(),\n                )\n                .unwrap();\n                let coefficient = g[term].to_limbs();\n                for limb in 0..WideExact::LIMB_COUNT {\n                    sums[limb] += u64::from(coefficient[limb]) * u64::from(scalar.0);\n                }\n            }\n            for limb in 0..WideExact::LIMB_COUNT {\n                limbs[limb] += (sums[limb] & 0x7fff_ffff) + (sums[limb] >> 31);\n            }\n        }\n\n        let mut value = WideExact::from_limbs(core::array::from_fn(|i| M31::reduce_u64(limbs[i]).0)).unwrap();\n        let mut tail=EbyKDot::new();\n        tail.push(g[28],QM31::from_le_bytes(&q[slot*120+104..slot*120+120]).unwrap()).unwrap();\n        for term in 0..2 {\n            let offset = 480 + slot * 32 + term * 16;\n            tail.push(g[term+26],QM31::from_le_bytes(&q[offset..offset+16]).unwrap()).unwrap();\n        }\n        value.add(tail.finish())\n    })\n}","attr_info":{"attributes":[{"DocComment":" Compute the verifier's four dot products while postponing canonical M31"},{"DocComment":" reductions across groups of at most four base-field products."},{"DocComment":""},{"DocComment":" Each limb product is at most `(P - 1)^2`; four products therefore sum to"},{"DocComment":" less than `2^64`, since `4 * (P - 1)^2 < 2^64`. One Mersenne fold"},{"DocComment":" `(sum & P) + (sum >> 31)` preserves its residue and is below `2^34`."},{"DocComment":" Seven folded batches sum to less than `2^37`; canonicalize each limb once"},{"DocComment":" after all 26 products. Every byte decoder and its order are unchanged."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Free":0}},{"Untagged":{"Slice":{"Untagged":{"Literal":{"UInt":"U8"}}}}},"Shared"]}},{"Untagged":{"Ref":[{"Var":{"Free":1}},{"Untagged":{"Array":[{"Untagged":{"Adt":{"id":{"Adt":0},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}},{"kind":{"Literal":{"Scalar":{"Unsigned":["Usize","29"]}}},"ty":{"Untagged":{"Literal":{"UInt":"Usize"}}}}]}},"Shared"]}}],"output":{"Untagged":{"Array":[{"Untagged":{"Adt":{"id":{"Adt":0},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}},{"kind":{"Literal":{"Scalar":{"Unsigned":["Usize","4"]}}},"ty":{"Untagged":{"Literal":{"UInt":"Usize"}}}}]}}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":0,"beg":{"line":13,"col":0},"end":{"line":44,"col":1}},"generated_from_span":null},"bound_body_regions":28,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":0,"beg":{"line":13,"col":51},"end":{"line":13,"col":65}},"generated_from_span":null},"ty":{"Untagged":{"Array":[{"Untagged":{"Adt":{"id":{"Adt":0},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}},{"kind":{"Literal":{"Scalar":{"Unsigned":["Usize","4"]}}},"ty":{"Untagged":{"Literal":{"UInt":"Usize"}}}}]}}},{"index":1,"name":"q","span":{"data":{"file_id":0,"beg":{"line":13,"col"