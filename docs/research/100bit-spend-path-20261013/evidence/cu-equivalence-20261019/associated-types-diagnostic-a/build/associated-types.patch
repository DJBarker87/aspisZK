@@ -320,6 +320,13 @@
         "Arrays with different lengths";
       TArray (match_rec ty0 ty1, len0)
   | TSlice ty0, TSlice ty1 -> TSlice (match_rec ty0 ty1)
+  | TTraitType _, TTraitType _
+    when Sys.getenv_opt "AENEAS_IDENTICAL_ASSOCIATED_TYPES" = Some "1"
