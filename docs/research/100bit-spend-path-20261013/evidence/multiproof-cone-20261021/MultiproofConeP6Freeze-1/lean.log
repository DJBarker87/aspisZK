AspisR1.MultiproofConeP6Verify.verify_in_place_owned {X : Type} (D : MultiproofConeRef.aspis_core.digest.Digest32 X)
  (hash : X) (H : AspisR1.MultiproofConePhysicalProgram.Address → AspisR1.MultiproofConePhysicalProgram.Digest)
  (law :
    ∀ (input : Aeneas.Std.Slice (Aeneas.Std.Slice Aeneas.Std.U8)), D.digest hash input = Aeneas.Std.Result.ok (H input))
  (source : AspisR1.MultiproofConeP6Composition.Node) (gate : AspisR1.MultiproofConeP6Composition.NodeGate H source)
  (root : AspisR1.MultiproofConePhysicalProgram.Digest) (s : MultiproofConeRef.reference.Scratch)
  (physical : Aeneas.Std.Slice Aeneas.Std.U8) (size : (↑physical).length ≤ 5504) :
  AspisR1.MultiproofConeP6Verify.wrapper
      (fun state =>
        (AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.MultiproofConeP6Composition.levels source 18 state physical)).2)
      root s physical =
    MultiproofConeRef.reference.verify_owned D hash root s physical
AspisR1.MultiproofConeP6Batch.batch_tree_owned {X : Type} (D : MultiproofConeRef.aspis_core.digest.Digest32 X)
  (hash : X) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (law :
