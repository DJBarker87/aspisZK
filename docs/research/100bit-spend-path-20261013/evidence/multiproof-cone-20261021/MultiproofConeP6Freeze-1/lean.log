      D.digest hash input = Aeneas.Std.Result.ok (AspisR1.MultiproofConePhysicalTransport.rawOracle H input))
  (nodeSource : AspisR1.MultiproofConeP6Composition.Node)
  (nodeGate :
    AspisR1.MultiproofConeP6Composition.NodeGate (AspisR1.MultiproofConePhysicalTransport.rawOracle H) nodeSource)
  (leafSource : AspisR1.MultiproofConeP6Batch.Leaf) (leafGate : AspisR1.MultiproofConeP6Batch.LeafGate H leafSource)
  (p : AspisR1.OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144) (batch kind : ℕ)
  (nodes : Aeneas.Std.Slice Aeneas.Std.U8) (size : (↑nodes).length ≤ 5504) (s : MultiproofConeRef.reference.Scratch) :
  AspisV8R19.MemoizedProgramLaw.eval H
      (AspisR1.MultiproofConeP6Batch.batch_tree nodeSource leafSource p q batch kind nodes s) =
    AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.MultiproofConeSlotState.slotState p q batch kind nodes s)
AspisR1.MultiproofConeP6Frozen2Stage.function_certificates {X : Type}
  (D : MultiproofConeRef.aspis_core.digest.Digest32 X) (hash : X)
  (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (binary occupied sibling : AspisR1.MultiproofConeP6Callbacks.Parent) (leafSource : AspisR1.MultiproofConeP6Batch.Leaf)
  (p6 : AspisR1.MultiproofConeP6Frozen2Stage.P6Boundary D hash H binary occupied sibling leafSource) :
  (∀ (root : AspisR1.MultiproofConePhysicalProgram.Digest) (s : MultiproofConeRef.reference.Scratch)
      (physical : Aeneas.Std.Slice Aeneas.Std.U8),
      (↑physical).length ≤ 5504 →
        AspisR1.MultiproofConeP6Verify.wrapper
            (fun state =>
              (AspisV8R19.MemoizedProgramLaw.eval (AspisR1.MultiproofConePhysicalTransport.rawOracle H)
                  (AspisR1.MultiproofConeP6Composition.levels
                    (AspisR1.MultiproofConeP6Callbacks.nodeWith occupied sibling) 18 state physical)).2)
            root s physical =
          MultiproofConeRef.reference.verify_owned D hash root s physical) ∧
    ∀ (p : AspisR1.OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144) (batch kind : ℕ)
      (nodes : Aeneas.Std.Slice Aeneas.Std.U8),
      (↑nodes).length ≤ 5504 →
        ∀ (s : MultiproofConeRef.reference.Scratch),
          AspisV8R19.MemoizedProgramLaw.eval H
              (AspisR1.MultiproofConeP6Batch.batch_tree (AspisR1.MultiproofConeP6Callbacks.nodeWith occupied sibling)
                leafSource p q batch kind nodes s) =
            AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.MultiproofConeSlotState.slotState p q batch kind nodes s)
AspisR1.MultiproofConeP6Frozen2Stage.both_batches {X : Type} (D : MultiproofConeRef.aspis_core.digest.Digest32 X)
  (hash : X) (H : AspisV8R19.DuplexFrames.Bytes → AspisV8R19.SourceDuplexStep.State)
  (binary occupied sibling : AspisR1.MultiproofConeP6Callbacks.Parent) (leafSource : AspisR1.MultiproofConeP6Batch.Leaf)
  (p6 : AspisR1.MultiproofConeP6Frozen2Stage.P6Boundary D hash H binary occupied sibling leafSource)
  (p : AspisR1.OraclePortCompactDraft.Parsed) (q : Fin 22 → Fin 262144) (nodes : ℕ → ℕ → Aeneas.Std.Slice Aeneas.Std.U8)
  (views :
    ∀ (b k : ℕ),
      b < 2 →
        k < 3 →
          AspisR1.MultiproofConeCanonical.bytesOf ↑(nodes b k) =
            AspisR1.OraclePortCompactDraft.slice p.wire (AspisR1.OraclePortSelectedDraft.slotStart (3 * b + k))
              (32 * AspisR1.OraclePortSelectedDraft.capacity (3 * b + k))) :
  (∀ (s : MultiproofConeRef.reference.Scratch),
      (AspisV8R19.MemoizedProgramLaw.eval H
              (AspisR1.MultiproofConeP6Frozen2Stage.sourceBatch occupied sibling leafSource p q nodes 0 s)).2 =
          true →
        AspisV8R19.MemoizedProgramLaw.eval H
            (AspisR1.MultiproofConeP6Frozen2Stage.sourceBatch occupied sibling leafSource p q nodes 0 s) =
          AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.OraclePortFrozen2.batch p q AspisR1.OraclePortFrozen2.batch0)) ∧
    ∀ (s : MultiproofConeRef.reference.Scratch),
      (AspisV8R19.MemoizedProgramLaw.eval H
              (AspisR1.MultiproofConeP6Frozen2Stage.sourceBatch occupied sibling leafSource p q nodes 1 s)).2 =
          true →
        AspisV8R19.MemoizedProgramLaw.eval H
            (AspisR1.MultiproofConeP6Frozen2Stage.sourceBatch occupied sibling leafSource p q nodes 1 s) =
          AspisV8R19.MemoizedProgramLaw.eval H (AspisR1.OraclePortFrozen2.batch p q AspisR1.OraclePortFrozen2.batch1)
