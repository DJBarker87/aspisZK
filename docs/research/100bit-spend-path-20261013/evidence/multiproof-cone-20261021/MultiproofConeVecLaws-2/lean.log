def Aeneas.Std.alloc.vec.Vec.{u} : Type u → Type (max 0 u) :=
fun α => { l // l.length ≤ Usize.max }
def Aeneas.Std.alloc.vec.Vec.extend_from_slice : {T : Type} →
  core.clone.Clone T → alloc.vec.Vec T → Slice T → Result (alloc.vec.Vec T) :=
fun {T} cloneInst v s =>
  if h : v.length + s.length ≤ Usize.max then
    match h' : Slice.clone cloneInst.clone s with
    | ok s' => ok ⟨↑v ++ ↑s', ⋯⟩
    | fail e => fail e
    | div => div
  else fail Error.panic
def Aeneas.Std.alloc.slice.Slice.to_vec : {T : Type} → core.clone.Clone T → Slice T → Result (alloc.vec.Vec T) :=
fun {T} cloneInst s => Slice.clone cloneInst.clone s
@[irreducible] def Aeneas.Std.alloc.vec.Vec.push.{u} : {α : Type u} → alloc.vec.Vec α → α → Result (alloc.vec.Vec α) :=
fun {α} v x =>
  let nlen := (↑v).length + 1;
  if h : (decide (nlen ≤ U32.max) || decide (nlen ≤ Usize.max)) = true then ok ⟨(↑v).concat x, ⋯⟩
  else fail Error.maximumSizeExceeded
