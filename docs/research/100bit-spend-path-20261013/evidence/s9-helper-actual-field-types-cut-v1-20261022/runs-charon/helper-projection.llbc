ple, this is how [`std::io::Write::write_fmt()`] propagates IO errors"},{"DocComment":" during writing.)"},{"DocComment":""},{"DocComment":" This type, `fmt::Error`, should not be"},{"DocComment":" confused with [`std::io::Error`] or [`std::error::Error`], which you may also"},{"DocComment":" have in scope."},{"DocComment":""},{"DocComment":" [`std::io::Error`]: ../../std/io/struct.Error.html"},{"DocComment":" [`std::io::Write::write_fmt()`]: ../../std/io/trait.Write.html#method.write_fmt"},{"DocComment":" [`std::error::Error`]: ../../std/error/trait.Error.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::fmt::{self, write};"},{"DocComment":""},{"DocComment":" let mut output = String::new();"},{"DocComment":" if let Err(fmt::Error) = write(&mut output, format_args!(\"Hello {}!\", \"world\")) {"},{"DocComment":"     panic!(\"An error occurred\");"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},null,null,null,null],"fun_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["s9_helper_actual_field_types_cut",0]},{"Ident":["weights",0]},{"Ident":["factored_s2_libra_weights",0]}],"span":{"data":{"file_id":0,"beg":{"line":35,"col":0},"end":{"line":63,"col":1}},"generated_from_span":null},"source_text":"fn factored_s2_libra_weights(ap0:&[E;4],ap1:&[E;4],extra:[K;2])->[E;4] {\n    let mut weights=[E::ZERO;4];\n    for side in 0..2 {\n        let q0=K::ONE;\n        let q1=q0.mul(extra[side]);\n        let q2=q1.mul(extra[side]);\n        let q3=q2.mul(extra[side]);\n        let _q4=q3.mul(extra[side]);\n        let q=[q0,q1,q2,q3];\n        let q4=q[2].square();let q8=q4.square();let q12=q8.mul(q4);let q16=q8.square();\n        let low=Weights::scalar_factor(&q,ap0);\n        let high_powers=[K::ONE,q4,q8,q12];\n        let term0=ap1[PERM[0]].mul_qm31(high_powers[0]).mul_m31(QUARTER);\n        let term1=ap1[PERM[1]].mul_qm31(high_powers[1]).mul_m31(QUARTER);\n        let term2=ap1[PERM[2]].mul_qm31(high_powers[2]).mul_m31(QUARTER);\n        let term3=ap1[PERM[3]].mul_qm31(high_powers[3]).mul_m31(QUARTER);\n        let terms=[term0,term1,term2,term3];\n        let first2=terms[0].add(terms[1]);let first3=first2.add(terms[2]);let all=first3.add(terms[3]);\n        if side==0 {\n            weights[0]=low.mul(all);\n            weights[1]=low.mul(first3).mul_qm31(q16);\n        } else {\n            weights[1]=weights[1].add(low.mul(ap1[PERM[3]].mul_m31(QUARTER)));\n            weights[2]=low.mul(all).mul_qm31(q4);\n            weights[3]=low.mul(first2).mul_qm31(q16.mul(q4));\n        }\n    }\n    weights\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":6096},{"HashConsedValue":[6153,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":481},"Shared"]}]},{"Deduplicated":490}],"output":{"Deduplicated":481}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":0,"beg":{"line":35,"col":0},"end":{"line":63,"col":1}},"generated_from_span":null},"bound_body_r