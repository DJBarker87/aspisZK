_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":401},{"Deduplicated":449}],"output":{"Deduplicated":401}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":16,"item_meta":{"name":[{"Ident":["aspis_r1_weights_pair_cut",0]},{"Ident":["field",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":401},"kind":"InherentImplBlock"}}},{"Ident":["mul_m31",0]}],"span":{"data":{"file_id":0,"beg":{"line":12,"col":261},"end":{"line":12,"col":310}},"generated_from_span":null},"source_text":"pub fn mul_m31(self,_r:M31)->Self{unreachable!()}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Opaque","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":401},{"Deduplicated":1357}],"output":{"Deduplicated":401}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,{"def_id":54,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["fold",0]}],"span":{"data":{"file_id":8,"beg":{"line":2664,"col":4},"end":{"line":2667,"col":64}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Folds every element into an accumulator by applying an operation,"},{"DocComment":" returning the final result."},{"DocComment":""},{"DocComment":" `fold()` takes two arguments: an initial value, and a closure with two"},{"DocComment":" arguments: an 'accumulator', and an element. The closure returns the value that"},{"DocComment":" the accumulator should have for the next iteration."},{"DocComment":""},{"DocComment":" The initial value is the value the accumulator will have on the first"},{"DocComment":" call."},{"DocComment":""},{"DocComment":" After applying this closure to every element of the iterator, `fold()`"},{"DocComment":" returns the accumulator."},{"DocComment":""},{"DocComment":" This operation is sometimes called 'reduce' or 'inject'."},{"DocComment":""},{"DocComment":" Folding is useful whenever you have a collection of something, and want"},{"DocComment":" to produce a single value from it."},{"DocComment":""},{"DocComment":" Note: `fold()`, and similar methods that traverse the entire iterator,"},{"DocComment":" might not terminate for infinite iterators, even on traits for which a"},{"DocComment":" result is determinable in finite time."},{"DocComment":""},{"DocComment":" Note: [`reduce()`] can be used to use the first element as the initial"},{"DocComment":" value, if the accumulator type and item type is the same."},{"DocComment":""},{"DocComment":" Note: `fold()` combines elements in a *left-associative* fashion. For associative"},{"DocComment":" operators like `+`, the order the elements are combined in is not important, but for non-associative"},{"DocComment":" operators like `-` the order will affect the final result."},{"DocComment":" For a *right-associative* version of `fold()`, see [`DoubleEndedIterator::rfold()`]."},{"DocComment":""},{"DocComment":" # Note to Implementors"},{"DocComment":""},{"DocComment":" Several of the other (forward) methods have default implementations in"},{"DocComment":" terms of this one, so try to implement this explicitly if it can"},{"DocComment":" do something better than the default `for` loop implementation."},{"DocComment":""},{"DocComment":" In particular, try to have this call `fold()` on the internal parts"},{"DocComment":" from which this iterator is composed."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" // the sum of all of the elements of the array"},{"DocComment":" let sum = a.iter().fold(0, |acc, x| acc + x);"},{"DocComment":""},{"DocComment":" assert_eq!(sum, 6);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Let's walk through each step of the iteration here:"},{"DocComment":""},{"DocComment":" | element | acc | x | result |"},{"DocComment":" |---------|-----|---|--------|"},{"DocComment":" |         | 0   |   |        |"},{"DocComment":" | 1       | 0   | 1 | 1      |"},{"DocComment":" | 2       | 1   | 2 | 3      |"},{"DocComment":" | 3       | 3   | 3 | 6      |"},{"DocComment":""},{"DocComment":" And so, our final result, `6`."},{"DocComment":""},{"DocComment":" This example demonstrates the left-associative nature of `fold()`:"},{"DocComment":" it builds a string, starting with an initial value"},{"DocComment":" and continuing with each element from the front until the back:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let numbers = [1, 2, 3, 4, 5];"},{"DocComment":""},{"DocComment":" let zero = \"0\".to_string();"},{"DocComment":""},{"DocComment":" let result = numbers.iter().fold(zero, |acc, &x| {"},{"DocComment":"     format!(\"({acc} + {x})\")"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" assert_eq!(result, \"(((((0 + 1) + 2) + 3) + 4) + 5)\");"},{"DocComment":" ```"},{"DocComment":" It's common for people who haven't used iterators a lot to"},{"DocComment":" use a `for` loop with a list of things to build up a result. Those"},{"DocComment":" can be turned into `fold()`s:"},{"DocComment":""},{"DocComment":" [`for`]: ../../book/ch03-05-control-flow.html#looping-through-a-collection-with-for"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let numbers = [1, 2, 3, 4, 5];"},{"DocComment":""},{"DocComment":" let mut result = 0;"},{"DocComment":""},{"DocComment":" // for loop:"},{"DocComment":" for i in &numbers {"},{"DocComment":"     result = result + i;"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // fold:"},{"DocComment":" let result2 = numbers.iter().fold(0, |acc, &x| acc + x);"},{"DocComment":""},{"DocComment":" // they're the same"},{"DocComment":" assert_eq!(result, result2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`reduce()`]: Iterator::reduce"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"B"},{"index":2,"name":"F"},{"index":3,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":5245},{"HashConsedValue":[5305,{"TypeVar":{"Free":3}}]}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":8,"beg":{"line":2666,"col":22},"end":{"line":2666,"col":38}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":5245}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":8,"beg":{"line":2667,"col":11},"end":{"line":2667,"col":44}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"HashConsedValue":[5274,{"TypeVar":{"Free":2}}]},{"HashConsedValue":[5306,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":5246},{"Deduplicated":5305}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":5246}],"const_