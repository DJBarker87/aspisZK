{"charon_version":"0.1.223","translated":{"crate_name":"aspis_r1_weights_pair_cut","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::weights::pair_step_root"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["core::iter::traits::iterator::Iterator::fold","core::option::Option","core::result::Result"],"opaque":["crate::field::_::mul","crate::field::_::square","crate::field::_::add","crate::field::_::mul_m31","crate::field::_::mul_qm31","crate::weights::field","crate::weights::twofold_libra_weights"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/s9-pair-caller-step-extract-v1-20261022/attempt1/runs/charon/pair-caller-step.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"lib.rs"},"crate_name":"aspis_r1_weights_pair_cut","contents":"#![allow(dead_code,unused_imports,unused_variables,non_snake_case)]\nextern crate self as aspis_core;\nuse alloc::vec::Vec;\nextern crate alloc;\npub mod field {\n #[derive(Clone,Copy,Debug,Default,PartialEq,Eq)] pub struct M31(pub u32);\n #[derive(Clone,Copy,Debug,Default,PartialEq,Eq)] pub struct CM31 {pub a:M31,pub b:M31}\n #[derive(Clone,Copy,Debug,Default,PartialEq,Eq)] pub struct QM31 {pub c0:CM31,pub c1:CM31}\n #[derive(Clone,Copy,Debug,Default,PartialEq,Eq)] pub struct WideExact {pub c0:QM31,pub c1:QM31}\n impl M31 {pub const ZERO:Self=Self(0);pub fn mul(self,_r:Self)->Self{unreachable!()}}\n impl QM31 {pub const ZERO:Self=Self{c0:CM31{a:M31(0),b:M31(0)},c1:CM31{a:M31(0),b:M31(0)}};pub const ONE:Self=Self{c0:CM31{a:M31(1),b:M31(0)},c1:CM31{a:M31(0),b:M31(0)}}; pub fn mul(self,_r:Self)->Self{unreachable!()} pub fn pow(self,_n:u64)->Self{unreachable!()} pub fn square(self)->Self{unreachable!()} }\n impl WideExact {pub const ZERO:Self=Self{c0:QM31::ZERO,c1:QM31::ZERO};pub const ONE:Self=Self{c0:QM31::ONE,c1:QM31::ZERO};pub fn add(self,_r:Self)->Self{unreachable!()}pub fn mul(self,_r:Self)->Self{unreachable!()}pub fn sub(self,_r:Self)->Self{unreachable!()}pub fn mul_m31(self,_r:M31)->Self{unreachable!()}pub fn mul_qm31(self,_r:QM31)->Self{unreachable!()} }\n}\npub mod transport {#[derive(Clone,Copy,Debug,PartialEq,Eq)]pub enum Variant{S1,S2,D}}\npub mod verifier {#[derive(Clone,Copy,Debug,PartialEq,Eq)]pub enum Error{Parse,Allocation}}\npub mod fast_pairing {use crate::{field::{WideExact,QM31},verifier::Error};pub struct EbyKDot;impl EbyKDot{pub fn new()->Self{Self}pub fn push(&mut self,_a:WideExact,_b:QM31)->Result<(),()>{unreachable!()}pub fn finish(self)->WideExact{unreachable!()}}}\npub mod r0 {pub mod heap {use alloc::vec::Vec;use crate::verifier::Error;pub fn filled<T:Copy>(n:usize,v:T)->Result<Vec<T>,Error>{Ok(alloc::vec![v;n])}}}\n#[path=\"trace.rs\"] pub mod trace;\npub mod weights {\n use alloc::vec::Vec;use crate::{field::{QM31 as K,WideExact as E,M31},transport::Variant,verifier::Error};\n const QUARTER:M31=M31(536870912);const PERM:[usize;4]=[0,3,2,1];\n pub fn powers<const N:usize>(x:E)->[E;N] { let mut p=E::ONE;core::array::from_fn(|_| {let a=p;p=p.mul(x);a}) } pub fn kpowers<const N:usize>(x:K)->[K;N] { let mut p=K::ONE;core::array::from_fn(|_| {let a=p;p=p.mul(x);a}) } pub fn field(_bytes:&[u8],_i:usize)->E{unreachable!()}\n pub fn grouped_inactive_pair(_w:&Weights,_f:&[u8],_low:&[E;16])->E{unreachable!()} pub fn twofold_libra_weights(_low:&[E;16],_extra:[K;2])->[E;4]{unreachable!()}  fn factored_s2_libra_weights(ap0:&[E;4],ap1:&[E;4],extra:[K;2])->[E;4] {\n     let mut weights=[E::ZERO;4];\n     for side in 0..2 {\n         let q0=K::ONE;\n         let q1=q0.mul(extra[side]);\n         let q2=q1.mul(extra[side]);\n         let q3=q2.mul(extra[side]);\n         let _q4=q3.mul(extra[side]);\n         let q=[q0,q1,q2,q3];\n         let q4=q[2].square();let q8=q4.square();let q12=q8.mul(q4);let q16=q8.square();\n         let low=Weights::scalar_factor(&q,ap0);\n         let high_powers=[K::ONE,q4,q8,q12];\n         let term0=ap1[PERM[0]].mul_qm31(high_powers[0]).mul_m31(QUARTER);\n         let term1=ap1[PERM[1]].mul_qm31(high_powers[1]).mul_m31(QUARTER);\n         let term2=ap1[PERM[2]].mul_qm31(high_powers[2]).mul_m31(QUARTER);\n         let term3=ap1[PERM[3]].mul_qm31(high_powers[3]).mul_m31(QUARTER);\n         let terms=[term0,term1,term2,term3];\n         let first2=terms[0].add(terms[1]);let first3=first2.add(terms[2]);let all=first3.add(terms[3]);\n         if side==0 {\n             weights[0]=low.mul(all);\n             weights[1]=low.mul(first3).mul_qm31(q16);\n         } else {\n             weights[1]=weights[1].add(low.mul(ap1[PERM[3]].mul_m31(QUARTER)));\n             weights[2]=low.mul(all).mul_qm31(q4);\n             weights[3]=low.mul(first2).mul_qm31(q16.mul(q4));\n         }\n     }\n     weights\n }\n // Candidate normalization: isolate each fallible inner scan so its `?` is\n // in a single Rust loop frame; retain every Result/error branch.\n fn push_byte_products(pair:&mut crate::fast_pairing::EbyKDot,f:&[u8],scratch:&[K],n:usize)->Result<(),Error>{\n  for j in 0..n { pair.push(field(f,j),scratch[j]).map_err(|_|Error::Parse)?; }\n  Ok(())\n }\n fn partial_dot(f:&[u8],common:&[K;16],s:usize)->Result<E,Error>{\n  let mut dot=crate::fast_pairing::EbyKDot::new();\n  for j in 0..16 { dot.push(field(f,16*s+j),common[j]).map_err(|_|Error::Parse)?; }\n  Ok(dot.finish())\n }\n fn high_dot(partials:&[E;4],coeffs:&[K;4])->Result<E,Error>{\n  let mut high=crate::fast_pairing::EbyKDot::new();\n  for s in 0..4 { high.push(partials[s],coeffs[s]).map_err(|_|Error::Parse)?; }\n  Ok(high.finish())\n }\n fn eq_k(a:K,b:K)->bool{\n  a.c0.a.0==b.c0.a.0 && a.c0.b.0==b.c0.b.0\n   && a.c1.a.0==b.c1.a.0 && a.c1.b.0==b.c1.b.0\n }\n fn eq4(a:&[K;4],b:&[K;4])->bool{\n  eq_k(a[0],b[0]) && eq_k(a[1],b[1]) && eq_k(a[2],b[2]) && eq_k(a[3],b[3])\n }\n pub struct Weights {pub variant:Variant,pub factors:[[[K;4];5];5],pub points:[[K;10];3],pub extra:[K;2]}\n\n // Candidate normalization: one source row's fallible work is isolated from\n // its caller so the caller can preserve first-error order without a loop.\n fn process_kind(w:&Weights,kind:usize,alpha:&[E],f:&[u8],folds:usize,n:usize,\n     ap0:&[E;4],ap1:&[E;4],scratch:&mut Vec<K>,parts:&mut [E;7])->Result<(),Error>{\n  if w.variant==Variant::D && kind<4 {\n   parts[kind]=w.dense_point_pair(kind,alpha,f)?;\n  } else {\n   let k=if kind<4 {kind-1}else{kind-2};\n   w.tensor(k,folds,scratch);\n   let mut scale=Weights::scalar_factor(&w.factors[k][0],ap0);\n   if folds==2 {scale=scale.mul(Weights::scalar_factor(&w.factors[k][1],ap1));}\n   let mut pair=crate::fast_pairing::EbyKDot::new();\n   push_byte_products(&mut pair,f,scratch,n)?;\n   parts[kind]=scale.mul(pair.finish());\n  }\n  Ok(())\n }\n impl Weights {pub fn raw(&self,_kind:usize,_j:usize)->K{unreachable!()}pub fn tensor(&self,_k:usize,_folds:usize,_out:&mut[K]){unreachable!()}fn scalar_factor(f:&[K;4],p:&[E;4])->E {\n        (0..4).fold(E::ZERO,|v,s|v.add(p[PERM[s]].mul_qm31(f[s]))).mul_m31(QUARTER)\n    }pub fn dense_point_pair(&self,_kind:usize,_alpha:&[E],_f:&[u8])->Result<E,Error>{unreachable!()}\n    pub fn pair_s2_libra_parts_projection(\n        &self, f: &[u8], ap0: [E; 4], ap1: [E; 4], low: [E; 16], mut parts: [E; 7],\n    ) -> [E; 7] {\n        let libra=if self.variant==Variant::S2 {factored_s2_libra_weights(&ap0,&ap1,self.extra)}else{twofold_libra_weights(&low,self.extra)};\n        for j in 0..4 {parts[4]=parts[4].add(field(f,j).mul(libra[j]));}\n        parts\n    }\n    #[inline(never)]\n    pub fn pair(&self,alpha:&[E],f:&[u8],kappa:E)->Result<E,Error> {\n        let n=f.len()/32; let folds=alpha.len();\n        if n!=1024>>(2*folds) {return Err(Error::Parse);}\n        let ap0=powers::<4>(alpha[0]);\n        let ap1=if folds==2 {powers::<4>(alpha[1])}else{[E::ONE;4]};\n        let mut scratch=aspis_core::r0::heap::filled(n,K::ZERO).map_err(|_|Error::Allocation)?;\n        let mut parts=[E::ZERO;7];\n        // On S2's two-fold path the high tensor factors for point rows 0 and\n        // 2 are identical. Keep the equality guard so arbitrary constructed\n        // `Weights` values retain the original per-row fallback.\n        let shared_two_point = self.variant==Variant::S2 && folds==2\n            && eq4(&self.factors[0][2],&self.factors[2][2])\n            && eq4(&self.factors[0][3],&self.factors[2][3]);\n        // Preserve the original finite row order while moving every `?` out\n        // of the row iterator. The shared-row skip remains at kinds 1 and 3.\n        if !shared_two_point { process_kind(self,1,alpha,f,folds,n,&ap0,&ap1,&mut scratch,&mut parts)?; }\n        process_kind(self,2,alpha,f,folds,n,&ap0,&ap1,&mut scratch,&mut parts)?;\n        if !shared_two_point { process_kind(self,3,alpha,f,folds,n,&ap0,&ap1,&mut scratch,&mut parts)?; }\n        process_kind(self,5,alpha,f,folds,n,&ap0,&ap1,&mut scratch,&mut parts)?;\n        process_kind(self,6,alpha,f,folds,n,&ap0,&ap1,&mut scratch,&mut parts)?;\n        if shared_two_point {\n            // The two point rows share the d2/d3 coefficients. Preserve the\n            // tensor's least-significant-first order: d2 is j mod 4 and d3\n            // is j / 4. Each d4 slice then contracts one 16-term EbyKDot.\n            let common:[K;16]=core::array::from_fn(|j|\n                self.factors[0][2][j&3].mul(self.factors[0][3][j>>2]));\n            let mut partials=[E::ZERO;4];\n            partials[0]=partial_dot(f,&common,0)?;\n            partials[1]=partial_dot(f,&common,1)?;\n            partials[2]=partial_dot(f,&common,2)?;\n            partials[3]=partial_dot(f,&common,3)?;\n            let high0=high_dot(&partials,&self.factors[0][4])?;\n            let scale0=Self::scalar_factor(&self.factors[0][0],&ap0)\n                .mul(Self::scalar_factor(&self.factors[0][1],&ap1));\n            parts[1]=scale0.mul(high0);\n            let high2=high_dot(&partials,&self.factors[2][4])?;\n            let scale2=Self::scalar_factor(&self.factors[2][0],&ap0)\n                .mul(Self::scalar_factor(&self.factors[2][1],&ap1));\n            parts[3]=scale2.mul(high2);\n        }\n        if folds==1 {\n            let dual:[E;16]=core::array::from_fn(|mask|(0..4).filter(|&s|mask&(1<<s)!=0).fold(E::ZERO,|v,s|v.add(ap0[PERM[s]])).mul_m31(QUARTER));\n            let mut groups=[E::ZERO;16];\n            for j in 0..n {\n                let mut mask=0;\n                for s in 0..4 {if self.raw(0,4*j+s)==K::ONE {mask|=1<<s;}}\n                groups[mask]=groups[mask].add(field(f,j));\n            }\n            for m in 1..16 {parts[0]=parts[0].add(groups[m].mul(dual[m]));}\n            for side in 0..2 {\n                let p=kpowers::<5>(self.extra[side]);\n                let scale=Self::scalar_factor(&[p[0],p[1],p[2],p[3]],&ap0);\n                let mut power=K::ONE; let mut pair=E::ZERO;\n                for j in 0..7 {pair=pair.add(field(f,j+7*side).mul_qm31(power));power=power.mul(p[4]);}\n                parts[4]=parts[4].add(pair.mul(scale));\n            }\n        } else {\n            // Two-fold 0/1 row: compute the sixteen challenge products once.\n            // Coefficients with the same inactive mask share one subset sum.\n            let low:[E;16]=core::array::from_fn(|s|ap0[PERM[s%4]].mul(ap1[PERM[s/4]]).mul_m31(QUARTER.mul(QUARTER)));\n            parts[0]=grouped_inactive_pair(self,f,&low);\n            let libra=if self.variant==Variant::S2 {factored_s2_libra_weights(&ap0,&ap1,self.extra)}else{twofold_libra_weights(&low,self.extra)};\n            for j in 0..4 {parts[4]=parts[4].add(field(f,j).mul(libra[j]));}\n        }\n        #[cfg(feature=\"prover\")]\n        for kind in 0..7 {\n            for j in 0..1024 {crate::trace::value(6,kind*1024+j,E::from_qm31(self.raw(kind,j)));}\n            for j in 0..n {crate::trace::value(7,kind*n+j,self.dual_raw(kind,j,alpha));}\n        }\n        let k=powers::<7>(kappa);let mut sum=E::ZERO;\n        for kind in 0..7 {crate::trace::value(8,kind,parts[kind]);sum=sum.add(k[kind].mul(parts[kind]));}\n        Ok(sum)\n    }\n }\n // Extraction-only caller-step root; this exposes exactly the local helper\n // call and four-cell `parts[4]` consumer, not the enclosing pair function.\n pub fn pair_step_root(w:&Weights,f:&[u8],ap0:[E;4],ap1:[E;4],low:[E;16],parts:[E;7])->[E;7]{\n  w.pair_s2_libra_parts_projection(f,ap0,ap1,low,parts)\n }\n // Extraction-only root shim: Charon cannot use an inherent method as --start-from.\n pub fn pair_root(w:&Weights,alpha:&[E],f:&[u8],kappa:E)->Result<E,Error>{\n  w.pair(alpha,f,kappa)\n }\n\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/iter/traits/collect.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/iter/traits/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/iter/mod.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/iter/traits/iterator.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/iter/range.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/intrinsics/mod.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/array/iter.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/num/nonzero.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"/rustc/library/core/src/iter/adapters/step_by.rs"},"crate_name":"core","contents":null},{"id":19,"name":{"Local":"/rustc/library/core/src/iter/adapters/mod.rs"},"crate_name":"core","contents":null},{"id":20,"name":{"Local":"/rustc/library/core/src/iter/adapters/chain.rs"},"crate_name":"core","contents":null},{"id":21,"name":{"Local":"/rustc/library/core/src/iter/adapters/zip.rs"},"crate_name":"core","contents":null},{"id":22,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":23,"name":{"Local":"/rustc/library/core/src/iter/adapters/intersperse.rs"},"crate_name":"core","contents":null},{"id":24,"name":{"Local"