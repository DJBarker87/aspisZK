{"charon_version":"0.1.223","translated":{"crate_name":"aspis_bounded_control_probe","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::bounded_carry","crate::invalid_amount"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/tmp/aspis-bounded-control-20261017/charon-built-b/bounded-control.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"aspis_bounded_control_probe","contents":"#![no_std]\n\n/// The protocol only observes trailing ones below the 20-level tree bound.\n/// This candidate replaces `(index.trailing_ones() as usize).min(20)` using\n/// the same primitive operations already covered by the source proofs.\npub fn bounded_carry(mut index: u64) -> usize {\n    let mut carry = 0usize;\n    while carry < 20 {\n        if index & 1 == 0 {\n            return carry;\n        }\n        index >>= 1;\n        carry += 1;\n    }\n    carry\n}\n\n/// Candidate explicit-match form of the existing public-amount guard.\npub fn invalid_amount(amount: Option<u32>) -> bool {\n    match amount {\n        None => false,\n        Some(value) => value == 0 || value >= (1 << 30),\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::{bounded_carry, invalid_amount};\n\n    #[test]\n    fn carry_matches_intrinsic_for_all_twenty_low_bits() {\n        let low_mask = (1u64 << 20) - 1;\n        let upper_patterns = [0, 1u64 << 20, 1u64 << 63, !low_mask];\n        for low in 0..=low_mask {\n            for upper in upper_patterns {\n                let index = upper | low;\n                assert_eq!(\n                    bounded_carry(index),\n                    (index.trailing_ones() as usize).min(20),\n                    \"index={index}\"\n                );\n            }\n        }\n    }\n\n    #[test]\n    fn explicit_amount_guard_matches_option_method() {\n        assert!(!invalid_amount(None));\n        let boundaries = [0, 1, (1 << 30) - 1, 1 << 30, (1 << 31) - 1, u32::MAX];\n        for value in boundaries {\n            assert_eq!(invalid_amount(Some(value)), Some(value).is_some_and(|a| a == 0 || a >= (1 << 30)));\n        }\n        let mut state = 0x8f3a_92d1u32;\n        for _ in 0..65536 {\n            state ^= state << 13;\n            state ^= state >> 17;\n            state ^= state << 5;\n            assert_eq!(invalid_amount(Some(state)), Some(state).is_some_and(|a| a == 0 || a >= (1 << 30)));\n        }\n    }\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["aspis_bounded_control_probe",0]},{"Ident":["bounded_carry",0]}]},{"key":{"Fun":1},"value":[{"Ident":["aspis_bounded_control_probe",0]},{"Ident":["invalid_amount",0]}]},{"key":{"Type":0},"value":[{"I