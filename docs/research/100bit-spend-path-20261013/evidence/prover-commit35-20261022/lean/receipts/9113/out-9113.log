                                  | owner.Kind.Create => Kind.create
                                  | owner.Kind.WriteMagic => Kind.writeMagic
                                  | owner.Kind.WriteDigest => Kind.writeDigest
                                  | owner.Kind.WriteNonce => Kind.writeNonce
                                  | owner.Kind.FileSync => Kind.fileSync
                                  | owner.Kind.DirectoryOpen => Kind.directoryOpen
                                  | owner.Kind.DirectorySync => Kind.directorySync)
                                  s).2.history,
                          cursor :=
                            (ask schedule
                                  (match k with
                                  | owner.Kind.Create => Kind.create
                                  | owner.Kind.WriteMagic => Kind.writeMagic
                                  | owner.Kind.WriteDigest => Kind.writeDigest
                                  | owner.Kind.WriteNonce => Kind.writeNonce
                                  | owner.Kind.FileSync => Kind.fileSync
                                  | owner.Kind.DirectoryOpen => Kind.directoryOpen
                                  | owner.Kind.DirectorySync => Kind.directorySync)
                                  s).2.cursor,
                          burned :=
                            nonce ::
                              (ask schedule
                                    (match k with
                                    | owner.Kind.Create => Kind.create
                                    | owner.Kind.WriteMagic => Kind.writeMagic
                                    | owner.Kind.WriteDigest => Kind.writeDigest
                                    | owner.Kind.WriteNonce => Kind.writeNonce
                                    | owner.Kind.FileSync => Kind.fileSync
                                    | owner.Kind.DirectoryOpen => Kind.directoryOpen
                                    | owner.Kind.DirectorySync => Kind.directorySync)
                                    s).2.burned }
                      | x, x_1 =>
                        (ask schedule
                            (match k with
                            | owner.Kind.Create => Kind.create
                            | owner.Kind.WriteMagic => Kind.writeMagic
                            | owner.Kind.WriteDigest => Kind.writeDigest
                            | owner.Kind.WriteNonce => Kind.writeNonce
                            | owner.Kind.FileSync => Kind.fileSync
                            | owner.Kind.DirectoryOpen => Kind.directoryOpen
                            | owner.Kind.DirectorySync => Kind.directorySync)
                            s).2),
                duplicate := fun e =>
                  ok
                    (match e with
                    | IOError.alreadyExists => true
                    | IOError.other a => false) }
              0#u8 unix after
          | core.result.Result.Err e =>
            if
                (match e with
                  | IOError.alreadyExists => true
                  | IOError.other a => false) =
                  true then
              ok { result := core.result.Result.Err owner.Error.Duplicate, state := after, created := false }
            else ok { result := core.result.Result.Err (owner.Error.Io e), state := after, created := false }
      ok (unpack out)) =
    ok (reserve schedule unix nonce s)
