  (old fresh : Path),
  fresh ≠ old →
    ∀ (history : R1Z.ProverCommitEnvironment35.History),
      ¬∃ schedule,
          ∀ (path : Path),
            schedule (List.length history) R1Z.ProverCommitEnvironment35.Kind.create history =
              R1Z.ProverCommitLedgerBoundary35.createStatus [old] path :=
fun {Path} [inst : DecidableEq Path] old fresh distinct history a =>
  let ⟨schedule, law⟩ := a
  have a := law old;
  have b := law fresh;
  have same := Eq.trans (Eq.symm a) b;
  let ⟨⟩ := Except.ok ()
  Eq.mp
    (congr
      (congrArg Eq
        (ite_congr (Eq.trans R1Z.ProverCommitLedgerBoundary35.no_status_only_create_law._simp_2 (eq_self old))
          (fun a => Eq.refl (Except.error R1Z.ProverCommitEnvironment35.IOError.alreadyExists)) fun a =>
          Eq.refl (Except.ok ())))
      (Eq.trans
        (ite_congr R1Z.ProverCommitLedgerBoundary35.no_status_only_create_law._simp_2
          (fun a => Eq.refl (Except.error R1Z.ProverCommitEnvironment35.IOError.alreadyExists)) fun a =>
          Eq.refl (Except.ok ()))
        ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_neg distinct) x_0 x_1 x_2 x_3) (inst fresh old)
          R1Z.ProverCommitEnvironment35.Outcome (Except.error R1Z.ProverCommitEnvironment35.IOError.alreadyExists)
          (Except.ok ()))))
    same
