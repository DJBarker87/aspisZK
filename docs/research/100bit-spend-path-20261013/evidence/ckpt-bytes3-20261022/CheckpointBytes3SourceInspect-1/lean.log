def Aeneas.Std.core.slice.iter.IteratorIterMut.next : {T : Type} →
  Aeneas.Std.core.slice.iter.IterMut T →
    Aeneas.Std.Result
      (Option T ×
        Aeneas.Std.core.slice.iter.IterMut T ×
          (Aeneas.Std.core.slice.iter.IterMut T → Option T → Aeneas.Std.core.slice.iter.IterMut T)) :=
fun {T} it =>
  if h : it.i < ↑it.slice.len then
    have x := it.slice[it.i];
    have i := it.i;
    have it := { slice := it.slice, i := i + 1 };
    have back := fun it' x =>
      match x with
      | none => it'
      | some x => { slice := it'.slice.setAtNat i x, i := it'.i };
    Aeneas.Std.Result.ok (some x, it, back)
  else Aeneas.Std.Result.ok (none, it, fun it x => it)
