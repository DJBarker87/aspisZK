  "audit_script_source": "import hashlib\nimport json\nimport pathlib\nimport re\nimport subprocess\nimport sys\n\nroot = pathlib.Path.cwd()\nlead = '30a6c06c41e0a0e4e74a4db9c4fb62dec89232dc'\nsource = '32559d2696b89cdbd75304c1f7624f94dfe125ae'\nproduction = 'crates/aspis-r1-cost-probe/src/verifier.rs'\nevidence = 'docs/research/100bit-spend-path-20261013/evidence/decision1h'\nold_blob = 'de8869cff836ba49cda1b66c473b885f11d410e2'\nlimit = 90000000\n\ndef git(*args):\n    return subprocess.check_output(['git', *args])\n\nhead = git('rev-parse','HEAD').decode().strip()\nassert git('branch','--show-current').decode().strip() == 'codex/r1-checkpoint-recut-20261018'\nassert git('status','--porcelain') == b''\nassert subprocess.run(['git','merge-base','--is-ancestor',lead,head]).returncode == 0\nold_remote = git('rev-parse','2d38f0977').decode().strip()\nassert subprocess.run(['git','merge-base','--is-ancestor',old_remote,head]).returncode == 0\nassert subprocess.run(['git','merge-base','--is-ancestor','6dd9028e9',head],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode != 0\n\ncommits = git('rev-list','--reverse',lead+'..'+head).decode().splitlines()\ntrees = []\nall_changed = set()\nfor c in commits:\n    entries = []\n    for row in git('ls-tree','-r','-l','-z',c).split(b'\\0'):\n        if not row:\n            continue\n        info,path = row.split(b'\\t',1)\n        mode,kind,oid,size = info.split()\n        if kind == b'blob':\n            item = {'path':path.decode(),'blob':oid.decode(),'bytes':int(size)}\n            assert item['bytes'] <= limit, (c,item)\n            entries.append(item)\n    changed = git('diff-tree','--no-commit-id','--name-only','-r','-z',c).decode().rstrip('\\0').split('\\0')\n    all_changed.update(changed)\n    trees.append({'commit':c,'blob_files':len(entries),'largest_file':max(entries,key=lambda x:x['bytes'])})\n    msg=git('show','-s','--format=%B',c).decode()\n    assert not re.search(r'(?im)^co-authored-by:.*(openai|chatgpt|codex|claude|copilot|assistant)',msg)\n\nnames = git('diff','--name-only','-z',lead,head).decode().rstrip('\\0').split('\\0')\nassert production in names\nfor p in all_changed:\n    assert p == production or p.startswith(evidence), p\n    if p != production:\n        assert p.endswith(('.json','.log')) or pathlib.PurePosixPath(p).name == 'SHA256SUMS', p\n        assert not p.endswith(('.so','.elf','.key','.bin','.tar.gz')), p\n\nverifier = git('show',head+':'+production)\nassert hashlib.sha256(verifier).hexdigest() == '2babda97eabb9e84204204f016dc37562ec7b762e7c66abbce0f6a5c17b1d6d9'\nassert git('show',source+':'+production)==verifier\nassert git('diff','--name-only',source,head,'--','crates','programs','tools','Cargo.toml','Cargo.lock') == b''\nsrc_record = json.loads((root/(evidence+'-20261019/source-change.json')).read_text())\nassert hashlib.sha256(src_record['approved_patch'].encode()).hexdigest()==src_record['approved_patch_sha256']\nbase_verifier = git('show',lead+':'+production)\ncheckdir=pathlib.Path('/tmp/r1-decision1h-approved-patch-audit')\ntarget=checkdir/production\ntarget.parent.mkdir(parents=True,exist_ok=True)\ntarget.write_bytes(base_verifier)\nsubprocess.run(['git','apply','--unsafe-paths','-'],input=src_record['approved_patch'].encode(),cwd=checkdir,check=True)\nassert target.read_bytes()==verifier\nreachable=git('rev-list','--objects',head).decode().splitlines()\nassert all(line.split(' ',1)[0] != old_blob for line in reachable)\nmax_file=max((t['largest_file'] for t in trees),key=lambda x:x['bytes'])\n\nreport={\n    'status':'PASS_DECISION1H_BRANCH_SOURCE_AND_HISTORY_AUDIT',\n    'audited_head':head,'lead_base':lead,'producing_source_revision':source,\n    'own_branch':'codex/r1-checkpoint-recut-20261018',\n    'prior_own_remote_head_is_ancestor':old_remote,\n    'no_force_push_needed':True,'clean_worktree':True,\n    'commit_count':len(commits),'every_commit_tree':trees,\n    'maximum_file_bytes':limit,'largest_file_in_range':max_file,\n    'oversized_rejected_blob':old_blob,'rejected_blob_reachable':False,'rejected_6dd9028e9_is_ancestor':False,\n    'only_production_change':production,\n    'exact_approved_patch_sha256':src_record['approved_patch_sha256'],\n    'verifier_sha256':hashlib.sha256(verifier).hexdigest(),\n    'all_production_and_Cargo_paths_equal_frozen_source':True,\n    'changed_paths_count':len(names),'all_commit_changed_paths_count':len(all_changed),\n    'changed_paths':names,\n    'output_policy':'Exact approved verifier.rs patch. Every other changed path in every new commit is Decision1h evidence JSON, log or SHA256SUMS. No ELF/.so/key/archive.',\n    'commands':['git rev-list --reverse BASE..HEAD','git ls-tree -r -l -z COMMIT (each)','git diff-tree --no-commit-id --name-only -r -z COMMIT (each)','git rev-list --objects HEAD','git show REV:crates/aspis-r1-cost-probe/src/verifier.rs','git apply exact approved patch in temporary audit directory','git diff --name-only SOURCE HEAD -- crates programs tools Cargo.toml Cargo.lock'],\n    'compiler_or_runtime_jobs_started':0,\n    'audit_script_sha256':hashlib.sha256(pathlib.Path(__file__).read_bytes()).hexdigest(),\n}\nout=pathlib.Path(sys.argv[1]);out.write_text(json.dumps(report,indent=2,sort_keys=True)+'\\n')\nprint(json.dumps({k:report[k] for k in ['status','audited_head','commit_count','largest_file_in_range','changed_paths_count','verifier_sha256']}))\n",
