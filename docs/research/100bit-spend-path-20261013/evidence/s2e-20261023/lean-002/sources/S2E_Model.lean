def S2E_Reference.stage2_proof (ops : Ops)
  {C : Type} {Clause0_State : Type} (ChildrenInst : S2E_Reference.Children C
  Clause0_State) (state : Clause0_State) (sdk : S2E_Reference.OwnedSdk)
  (validated : S2E_Reference.Validated) :
  Result ((core.result.Result Unit solana_program_error.ProgramError) ×
    Clause0_State × S2E_Reference.OwnedSdk)
  := do
  let oa ←
    alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
      S2E_Reference.OwnedAccount) sdk.accounts 0#usize
  let (r, sdk1) ← S2E_Reference.owned_acquire_shared sdk oa.data_slot
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue _ =>
    let (result, state1, sdk2) ←
      (S2E_Reference.stage2_checkpoint ops) ChildrenInst state sdk1 validated
        oa.data_slot
    let odc ←
      alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
        S2E_Reference.OwnedDataCell) sdk2.data_cells oa.data_slot
    let o ← lift (Isize.checked_sub odc.borrowed 1#isize)
    let i ← core.option.Option.unwrap o
    let (odc1, index_mut_back) ←
      alloc.vec.Vec.index_mut (core.slice.index.SliceIndexUsizeSlice
        S2E_Reference.OwnedDataCell) sdk2.data_cells oa.data_slot
    let v := index_mut_back { odc1 with borrowed := i }
    ok (result, state1, { sdk2 with data_cells := v })
  | core.ops.control_flow.ControlFlow.Break residual =>
    let result ←
      core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
        Unit (core.convert.FromSame solana_program_error.ProgramError) residual
    ok (result, state, sdk1)

/-- [s2e_reference::S2E_Reference::stage2]:
    Source: 'src/S2E_Reference.rs', lines 197:0-206:1
    Visibility: public -/
def S2E_Reference.stage2 (ops : Ops)
  {C : Type} {Clause0_State : Type} (ChildrenInst : S2E_Reference.Children C
  Clause0_State) (state : Clause0_State) (sdk : S2E_Reference.OwnedSdk)
  (program : Array Std.U8 32#usize) (data : Slice Std.U8) :
  Result ((core.result.Result Unit solana_program_error.ProgramError) ×
    Clause0_State × S2E_Reference.OwnedSdk)
  := do
  let i := alloc.vec.Vec.len sdk.accounts
  if i != 7#usize
  then
    ok (core.result.Result.Err
      solana_program_error.ProgramError.InvalidInstructionData, state, sdk)
  else
    let o ←
      core.slice.Slice.get (core.slice.index.SliceIndexRangeToUsizeSlice
        Std.U8) data { «end» := 4#usize }
    let a ←
      ops.op13
    let s ←
      core.array.Array.index (core.ops.index.IndexSlice
        ((core.ops.range.RangeFull.Insts.CoreSliceIndexSliceIndexSliceSlice ops)
        Std.U8)) a ()
    let b ←
      core.cmp.PartialEq.ne.trait_default
        ((core.option.Option.Insts.CoreCmpPartialEqOption ops)
        (core.cmp.PartialEqShared (Slice.Insts.CoreCmpPartialEqSlice
        core.cmp.PartialEqU8))) o (some s)
    if b
    then
      ok (core.result.Result.Err
        solana_program_error.ProgramError.InvalidInstructionData, state, sdk)
    else
      let state1 ← ChildrenInst.clear_return_data state
      let (r, state2) ← ChildrenInst.validate_asq8 state1 program sdk data
      let cf ← core.result.Result.Insts.CoreOpsTry.branch r
      match cf with
      | core.ops.control_flow.ControlFlow.Continue val =>
        let (result, state3, sdk1) ←
          (S2E_Reference.stage2_proof ops) ChildrenInst state2 sdk val
        let state4 ← ChildrenInst.drop_statement state3 val.statement
        ok (result, state4, sdk1)
      | core.ops.control_flow.ControlFlow.Break residual =>
        let result ←
          core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
            Unit (core.convert.FromSame solana_program_error.ProgramError)
            residual
        ok (result, state2, sdk)

