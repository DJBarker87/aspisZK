ocComment":" Returns a mutable reference to an element or subslice, without doing"},{"DocComment":" bounds checking."},{"DocComment":""},{"DocComment":" For a safe alternative see [`get_mut`]."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Calling this method with an out-of-bounds index is *[undefined behavior]*"},{"DocComment":" even if the resulting reference is not used."},{"DocComment":""},{"DocComment":" You can think of this like `.get_mut(index).unwrap_unchecked()`.  It's"},{"DocComment":" UB to call `.get_unchecked_mut(len)`, even if you immediately convert"},{"DocComment":" to a pointer.  And it's UB to call `.get_unchecked_mut(..len + 1)`,"},{"DocComment":" `.get_unchecked_mut(..=len)`, or similar."},{"DocComment":""},{"DocComment":" [`get_mut`]: slice::get_mut"},{"DocComment":" [undefined behavior]: https://doc.rust-lang.org/reference/behavior-considered-undefined.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = &mut [1, 2, 4];"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     let elem = x.get_unchecked_mut(1);"},{"DocComment":"     *elem = 13;"},{"DocComment":" }"},{"DocComment":" assert_eq!(x, &[1, 13, 4]);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"},{"index":1,"name":"I"},{"index":2,"name":"Clause0_Output"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":15,"beg":{"line":686,"col":11},"end":{"line":686,"col":35}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":2979},{"Deduplicated":3005},{"Deduplicated":2980}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"sign