Self::assume_init"},{"DocComment":" [`assume_init_drop`]: Self::assume_init_drop"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Correct usage of this method:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" let mut x = MaybeUninit::<Vec<u8>>::uninit();"},{"DocComment":""},{"DocComment":" {"},{"DocComment":"     let hello = x.write((&b\"Hello, world!\").to_vec());"},{"DocComment":"     // Setting hello does not leak prior allocations, but drops them"},{"DocComment":"     *hello = (&b\"Hello\").to_vec();"},{"DocComment":"     hello[0] = 'h' as u8;"},{"DocComment":" }"},{"DocComment":" // x is initialized now:"},{"DocComment":" let s = unsafe { x.assume_init() };"},{"DocComment":" assert_eq!(b\"hello\", s.as_slice());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This usage of the method causes a leak:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" let mut x = MaybeUninit::<String>::uninit();"},{"DocComment":""},{"DocComment":" x.write(\"Hello\".to_string());"},{"DocComment":" # // FIXME(https://github.com/rust-lang/miri/issues/3670):"},{"DocComment":" # // use -Zmiri-disable-leak-check instead of unleaking in tests meant to leak."},{"DocComment":" # unsafe { MaybeUninit::assume_init_drop(&mut x); }"},{"DocComment":" // This leaks the contained string:"},{"DocComment":" x.write(\"hello\".to_string());"},{"DocComment":" // x is initialized now:"},{"DocComment":" let s = unsafe { x.assume_init() };"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This method can be used to avoid unsafe in some cases. The example below"},{"DocComment":" shows a part of an implementation of a fixed sized arena that lends out"},{"DocComment":" pinned references."},{"DocComment":" With `write`, we can avoid the need to write through a raw pointer:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use core::pin::Pin;"},{"DocComment":" use core::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" struct PinArena<T> {"},{"DocComment":"     memory: Box<[MaybeUninit<T>]>,"},{"DocComment":"     len: usize,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl <T> PinArena<T> {"},{"DocComment":"     pub fn capacity(&self) -> usize {"},{"DocComment":"         self.memory.len()"},{"DocComment":"     }"},{"DocComment":"     pub fn push(&mut self, val: T) -> Pin<&mut T> {"},{"DocComment":"         if self.len >= self.capacity() {"},{"DocComment":"             panic!(\"Attempted to push to a full pin arena!\");"},{"DocComment":"         }"},{"DocComment":"         let ref_ = self.memory[self.len].write(val);"},{"DocComment":"         self.len += 1;"},{"DocComment":"         unsafe { Pin::new_unchecked(ref_) }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"HashConsedValue":[3108,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":2986},"Mut"]}]},{"Deduplicated":2978}],"output":{"Deduplicated":3103}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":31,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":286},"kind":"InherentImplBlock"}}},{"Ident":["unchecked_add",0]}],"span":{"data":{"file_id":8,"beg":{"line":959,"col":8},"end":{"line":959,"col":66}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"Do