                              (fun k => embed (FIw_PublicModel.selector s k)) (4 * ↑j + ↑i) :=
fun pub o point hd hz hs hx hp asset amount =>
  let ⟨s, h✝⟩ := NIH_AtPoint.boxed point hp
  let ⟨sc, right✝⟩ := h✝
  let ⟨ch, right✝¹⟩ := right✝
  let ⟨cl, right✝²⟩ := right✝¹
  let ⟨p, call⟩ :=
    NKR_TermSemanticSource.source (PIN2P.SemanticPublic.dropDestination pub) o s hd hz hs hx ch cl asset amount
  have value :=
    FJk_SemanticWideOnRun.value pub o s point p.out hz hs hx hp
      (bounds (PIN2P.SemanticPublic.dropDestination pub) hd asset amount) sc call;
  Exists.intro s ⟨sc, Exists.intro p ⟨call, value.right⟩⟩
