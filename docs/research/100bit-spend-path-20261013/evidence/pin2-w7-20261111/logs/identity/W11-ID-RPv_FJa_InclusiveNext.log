def Aeneas.Std.core.ops.range.RangeInclusive.is_empty : {Idx : Type} →
  core.cmp.PartialOrd Idx Idx → core.ops.range.RangeInclusive Idx → Result Bool :=
fun {Idx} inst self =>
  if self.exhausted = true then ok true
  else do
    let startLeEnd ← inst.le self.start self.end
    pure !startLeEnd
