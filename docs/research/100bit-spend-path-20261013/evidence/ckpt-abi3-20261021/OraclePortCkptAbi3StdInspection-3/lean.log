def Aeneas.Std.alloc.vec.Vec.with_capacity : (T : Type) → Aeneas.Std.Usize → Aeneas.Std.alloc.vec.Vec T :=
fun T x => Aeneas.Std.alloc.vec.Vec.new T
def Aeneas.Std.alloc.vec.into_iter.IntoIter : Type → Type :=
fun T => Aeneas.Std.alloc.vec.Vec T
def Aeneas.Std.alloc.vec.Vec.extend_from_slice : {T : Type} →
  Aeneas.Std.core.clone.Clone T →
    Aeneas.Std.alloc.vec.Vec T → Aeneas.Std.Slice T → Aeneas.Std.Result (Aeneas.Std.alloc.vec.Vec T) :=
fun {T} cloneInst v s =>
  if h : v.length + s.length ≤ Aeneas.Std.Usize.max then
    match h' : Aeneas.Std.Slice.clone cloneInst.clone s with
    | Aeneas.Std.Result.ok s' => Aeneas.Std.Result.ok ⟨↑v ++ ↑s', ⋯⟩
    | Aeneas.Std.Result.fail e => Aeneas.Std.Result.fail e
    | Aeneas.Std.Result.div => Aeneas.Std.Result.div
  else Aeneas.Std.Result.fail Aeneas.Std.Error.panic
