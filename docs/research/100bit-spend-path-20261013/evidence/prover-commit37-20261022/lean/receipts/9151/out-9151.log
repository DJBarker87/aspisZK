def R1Z.ProverCommitSeedEvent19.seedPoint : List UInt8 → R0Z.FsStatement.OracleAnswer → Prop :=
fun a seed =>
  List.take ((List.map R1Z.ProverCommitSaltBytes.byte ↑R1Z.ProverCommitSimulatorCoin18.domain).length + 32) a =
    List.map R1Z.ProverCommitSaltBytes.byte ↑R1Z.ProverCommitSimulatorCoin18.domain ++ List.ofFn seed
def R1Z.ProverCommitReservationRom37.reservationQueried : List R1Z.ProverCommitSeedEvent19.Entry →
  R0Z.FsStatement.OracleAnswer → Prop :=
fun queries nonce => ∃ entry ∈ queries, entry.1 = R1Z.ProverCommitReservationRom37.reservationInput nonce
theorem R1Z.ProverCommitReservationNonzero37.retry_query_not_covered : ∀ (secret : R1Z.GamesR1PBin.SecP)
  (seed : R0Z.FsStatement.OracleAnswer),
  ∀ rejects < 16,
    R1Z.ProverCommitEntropy18.generate (R1Z.ProverCommitReservationNonzero37.countdownNext secret) rejects =
        (Except.ok secret, 0) ∧
      ↑(secret 0) ≠ 0 ∧
        R1Z.ProverCommitReservationRom37.reservationQueried
            [(R1Z.ProverCommitReservationRom37.reservationInput ↑(secret 0), 0)] ↑(secret 0) ∧
          ¬R1Z.ProverCommitSeedEvent19.seedGuess [(R1Z.ProverCommitReservationRom37.reservationInput ↑(secret 0), 0)]
              seed :=
fun secret seed rejects bound =>
  ⟨id
      (have fuel :=
        Decidable.byContradiction fun a =>
          R1Z.ProverCommitReservationNonzero37.retry_query_not_covered._proof_1 rejects bound a;
      Eq.mpr
        (id
          (congrArg
            (fun _a =>
              R1Z.ProverCommitEntropy18.run (R1Z.ProverCommitReservationNonzero37.countdownNext secret) _a rejects =
                (Except.ok secret, 0))
            fuel))
        (R1Z.ProverCommitReservationNonzero37.rejected_prefix_success secret rejects (15 - rejects))),
    ⟨(secret 0).property, R1Z.ProverCommitReservationRom37.queried_not_seedGuess (↑(secret 0)) seed⟩⟩
exit=0
