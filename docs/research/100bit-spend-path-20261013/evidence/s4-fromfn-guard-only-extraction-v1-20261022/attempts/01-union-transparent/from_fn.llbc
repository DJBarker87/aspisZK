t_refs":[{"HashConsedValue":[3725,{"kind":{"BuiltinOrAuto":{"builtin_data":"RemovedAdtClause","parent_trait_refs":[{"HashConsedValue":[3724,{"kind":{"BuiltinOrAuto":{"builtin_data":"RemovedAdtClause","parent_trait_refs":[],"types":[]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":3722},{"HashConsedValue":[3723,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":3721}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":3720}],"const_generics":[],"trait_refs":[]}}}}]}],"types":[]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":3722},{"Deduplicated":3723},{"Deduplicated":3720}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[3726,{"kind":{"BuiltinOrAuto":{"builtin_data":"RemovedAdtClause","parent_trait_refs":[],"types":[]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":3722}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"fn_mut_impl":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":3720},{"Deduplicated":3721},{"Deduplicated":3722}],"const_generics":[],"trait_refs":[{"Deduplicated":3725},{"Deduplicated":3726}]}}},"fn_impl":null,"signature":{"regions":[],"skip_binder":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":3721}],"output":{"HashConsedValue":[3727,{"Adt":{"id":{"Adt":2},"generics":{"regions":[],"types":[{"Deduplicated":3720}],"const_generics":[],"trait_refs":[]}}}]}}}}}},"kind":{"Struct":[{"span":{"data":{"file_id":7,"beg":{"line":415,"col":8},"end":{"line":415,"col":22}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":null,"ty":{"Deduplicated":3722}}]},"layout":[],"ptr_metadata":"None"},{"def_id":4,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["try_trait",0]},{"Ident":["NeverShortCircuitResidual",0]}],"span":{"data":{"file_id":7,"beg":{"line":430,"col":0},"end":{"line":430,"col":41}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":null,"uninhabited":true,"variant_layouts":[],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},null,null,{"def_id":7,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["maybe_uninit",0]},{"Ident":["MaybeUninit",0]}],"span":{"data":{"file_id":10,"beg":{"line":355,"col":0},"end":{"line":355,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper type to construct uninitialized instances of `T`."},{"DocComment":""},{"DocComment":" # Initialization invariant"},{"DocComment":""},{"DocComment":" The compiler, in general, assumes that a variable is [properly initialized or \"valid\"][validity]"},{"DocComment":" according to the requirements of the variable's type. For example, a variable of"},{"DocComment":" reference type must be aligned and non-null. This is an invariant that must"},{"DocComment":" *always* be upheld, even in unsafe code. As a consequence, zero-initializing a"},{"DocComment":" variable of reference type causes instantaneous undefined behavior,"},{"DocComment":" no matter whether that reference ever gets used to access memory:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let x: &i32 = unsafe { mem::zeroed() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<&i32>`:"},{"DocComment":" let x: &i32 = unsafe { MaybeUninit::zeroed().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This is exploited by the compiler for various optimizations, such as eliding"},{"DocComment":" run-time checks and optimizing `enum` layout."},{"DocComment":""},{"DocComment":" Similarly, entirely uninitialized memory may have any content, while a `bool` must"},{"DocComment":" always be `true` or `false`. Hence, creating an uninitialized `bool` is undefined behavior:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let b: bool = unsafe { mem::uninitialized() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<bool>`:"},{"DocComment":" let b: bool = unsafe { MaybeUninit::uninit().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Moreover, uninitialized memory is special in that it does not have a fixed value (\"fixed\""},{"DocComment":" meaning \"it won't change without being written to\"). Reading the same uninitialized byte"},{"DocComment":" multiple times can give different results. This makes it undefined behavior to have"},{"DocComment":" uninitialized data in a variable even if that variable has an integer type, which otherwise can"},{"DocComment":" hold any *fixed* bit pattern:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # #![allow(invalid_value)]"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let x: i32 = unsafe { mem::uninitialized() }; // undefined behavior! ⚠️"},{"DocComment":" // The equivalent code with `MaybeUninit<i32>`:"},{"DocComment":" let x: i32 = unsafe { MaybeUninit::uninit().assume_init() }; // undefined behavior! ⚠️"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Conversely, sometimes it is okay to not initialize *all* bytes of a `MaybeUninit`"},{"DocComment":" before calling `assume_init`. For instance, padding bytes do not have to be initialized."},{"DocComment":" See the field-by-field struct initialization example below for a case of that."},{"DocComment":""},{"DocComment":" On top of that, remember that most types have additional invariants beyond merely"},{"DocComment":" being considered initialized at the type level. For example, a `1`-initialized [`Vec<T>`]"},{"DocComment":" is considered initialized (under the current implementation; this does not constitute"},{"DocComment":" a stable guarantee) because the only requirement the compiler knows about it"},{"DocComment":" is that the data pointer must be non-null. Creating such a `Vec<T>` does not cause"},{"DocComment":" *immediate* undefined behavior, but will cause undefined behavior with most"},{"DocComment":" safe operations (including dropping it)."},{"DocComment":""},{"DocComment":" [`Vec<T>`]: ../../std/vec/struct.Vec.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` serves to enable unsafe code to deal with uninitialized data."},{"DocComment":" It is a signal to the compiler indicating that the data here might *not*"},{"DocComment":" be initialized:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" // Create an explicitly uninitialized reference. The compiler knows that data inside"},{"DocComment":" // a `MaybeUninit<T>` may be invalid, and hence this is not UB:"},{"DocComment":" let mut x = MaybeUninit::<&i32>::uninit();"},{"DocComment":" // Set it to a valid value."},{"DocComment":" x.write(&0);"},{"DocComment":" // Extract the initialized data -- this is only allowed *after* properly"},{"DocComment":" // initializing `x`!"},{"DocComment":" let x = unsafe { x.assume_init() };"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The compiler then knows to not make any incorrect assumptions or optimizations on this code."},{"DocComment":""},{"DocComment":" You can think of `MaybeUninit<T>` as being a bit like `Option<T>` but without"},{"DocComment":" any of the run-time tracking and without any of the safety checks."},{"DocComment":""},{"DocComment":" ## out-pointers"},{"DocComment":""},{"DocComment":" You can use `MaybeUninit<T>` to implement \"out-pointers\": instead of returning data"},{"DocComment":" from a function, pass it a pointer to some (uninitialized) memory to put the"},{"DocComment":" result into. This can be useful when it is important for the caller to control"},{"DocComment":" how the memory the result is stored in gets allocated, and you want to avoid"},{"DocComment":" unnecessary moves."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" unsafe fn make_vec(out: *mut Vec<i32>) {"},{"DocComment":"     // `write` does not drop the old contents, which is important."},{"DocComment":"     unsafe { out.write(vec![1, 2, 3]); }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut v = MaybeUninit::uninit();"},{"DocComment":" unsafe { make_vec(v.as_mut_ptr()); }"},{"DocComment":" // Now we know `v` is initialized! This also makes sure the vector gets"},{"DocComment":" // properly dropped."},{"DocComment":" let v = unsafe { v.assume_init() };"},{"DocComment":" assert_eq!(&v, &[1, 2, 3]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Initializing an array element-by-element"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` can be used to initialize a large array element-by-element:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::{self, MaybeUninit};"},{"DocComment":""},{"DocComment":" let data = {"},{"DocComment":"     // Create an uninitialized array of `MaybeUninit`."},{"DocComment":"     let mut data: [MaybeUninit<Vec<u32>>; 1000] = [const { MaybeUninit::uninit() }; 1000];"},{"DocComment":""},{"DocComment":"     // Dropping a `MaybeUninit` does nothing, so if there is a panic during this loop,"},{"DocComment":"     // we have a memory leak, but there is no memory safety issue."},{"DocComment":"     for elem in &mut data[..] {"},{"DocComment":"         elem.write(vec![42]);"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     // Everything is initialized. Transmute the array to the"},{"DocComment":"     // initialized type."},{"DocComment":"     unsafe { mem::transmute::<_, [Vec<u32>; 1000]>(data) }"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" assert_eq!(&data[0], &[42]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also work with partially initialized arrays, which could"},{"DocComment":" be found in low-level datastructures."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" // Create an uninitialized array of `MaybeUninit`."},{"DocComment":" let mut data: [MaybeUninit<String>; 1000] = [const { MaybeUninit::uninit() }; 1000];"},{"DocComment":" // Count the number of elements we have assigned."},{"DocComment":" let mut data_len: usize = 0;"},{"DocComment":""},{"DocComment":" for elem in &mut data[0..500] {"},{"DocComment":"     elem.write(String::from(\"hello\"));"},{"DocComment":"     data_len += 1;"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // For each item in the array, drop if we allocated it."},{"DocComment":" for elem in &mut data[0..data_len] {"},{"DocComment":"     unsafe { elem.assume_init_drop(); }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Initializing a struct field-by-field"},{"DocComment":""},{"DocComment":" You can use `MaybeUninit<T>` and the [`&raw mut`] syntax to initialize structs field by field:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" pub struct Foo {"},{"DocComment":"     name: String,"},{"DocComment":"     list: Vec<u8>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let foo = {"},{"DocComment":"     let mut uninit: MaybeUninit<Foo> = MaybeUninit::uninit();"},{"DocComment":"     let ptr = uninit.as_mut_ptr();"},{"DocComment":""},{"DocComment":"     // Initializing the `name` field"},{"DocComment":"     // Using `write` instead of assignment via `=` to not call `drop` on the"},{"DocComment":"     // old, uninitialized value."},{"DocComment":"     unsafe { (&raw mut (*ptr).name).write(\"Bob\".to_string()); }"},{"DocComment":""},{"DocComment":"     // Initializing the `list` field"},{"DocComment":"     // If there is a panic here, then the `String` in the `name` field leaks."},{"DocComment":"     unsafe { (&raw mut (*ptr).list).write(vec![0, 1, 2]); }"},{"DocComment":""},{"DocComment":"     // All the fields are initialized, so we call `assume_init` to get an initialized Foo."},{"DocComment":"     unsafe { uninit.assume_init() }"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     foo,"},{"DocComment":"     Foo {"},{"DocComment":"         name: \"Bob\".to_string(),"},{"DocComment":"         list: vec![0, 1, 2]"},{"DocComment":"     }"},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":" [`&raw mut`]: https://doc.rust-lang.org/reference/types/pointer.html#r-type.pointer.raw.constructor"},{"DocComment":" [validity]: ../../reference/behavior-considered-undefined.html#r-undefined.validity"},{"DocComment":""},{"DocComment":" Note that we have not initialized the padding, but that's fine -- it does not have to be"},{"DocComment":" initialized. In fact, even if we had initialized the padding in `uninit`, those bytes would be"},{"DocComment":" lost when copying the result: no matter the contents of the padding bytes in `uninit`, they will"},{"DocComment":" always be uninitialized in `foo`."},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` is guaranteed to have the same size, alignment, and ABI as `T`:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":" assert_eq!(size_of::<MaybeUninit<u64>>(), size_of::<u64>());"},{"DocComment":" assert_eq!(align_of::<MaybeUninit<u64>>(), align_of::<u64>());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" However remember that a type *containing* a `MaybeUninit<T>` is not necessarily the same"},{"DocComment":" layout; Rust does not in general guarantee that the fields of a `Foo<T>` have the same order as"},{"DocComment":" a `Foo<U>` even if `T` and `U` have the same size and alignment. Furthermore because any bit"},{"DocComment":" value is valid for a `MaybeUninit<T>` the compiler can't apply non-zero/niche-filling"},{"DocComment":" optimizations, potentially resulting in a larger size:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" # use std::mem::MaybeUninit;"},{"DocComment":" assert_eq!(size_of::<Option<bool>>(), 1);"},{"DocComment":" assert_eq!(size_of::<Option<MaybeUninit<bool>>>(), 2);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If `T` is FFI-safe, then so is `MaybeUninit<T>`."},{"DocComment":""},{"DocComment":" While `MaybeUninit` is `#[repr(transparent)]` (indicating it guarantees the same size,"},{"DocComment":" alignment, and ABI as `T`), this does *not* change any of the previous caveats. `Option<T>` and"},{"DocComment":" `Option<MaybeUninit<T>>` may still have different sizes, and types containing a field of type"},{"DocComment":" `T` may be laid out (and sized) differently than if that field were `MaybeUninit<T>`."},{"DocComment":" `MaybeUninit` is a union type, and `#[repr(transparent)]` on unions is unstable (see [the"},{"DocComment":" tracking issue](https://github.com/rust-lang/rust/issues/60405)). Over time, the exact"},{"DocComment":" guarantees of `#[repr(transparent)]` on unions may evolve, and `MaybeUninit` may or may not"},{"DocComment":" remain `#[repr(transparent)]`. That said, `MaybeUninit<T>` will *always* guarantee that it has"},{"DocComment":" the same size, alignment, and ABI as `T`; it's just that the way `MaybeUninit` implements that"},{"DocComment":" guarantee may evolve."},{"DocComment":""},{"DocComment":" Note that even though `T` and `MaybeUninit<T>` are ABI compatible it is still unsound to"},{"DocComment":" transmute `&mut T` to `&mut MaybeUninit<T>` and expose that to safe code because it would allow"},{"DocComment":" safe code to access uninitialized memory:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use core::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" fn unsound_transmute<T>(val: &mut T) -> &mut MaybeUninit<T> {"},{"DocComment":"     unsafe { core::mem::transmute(val) }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let mut code = 0;"},{"DocComment":"     let code = &mut code;"},{"DocComment":"     let code2 = unsound_transmute(code);"},{"DocComment":"     *code2 = MaybeUninit::uninit();"},{"DocComment":"     std::process::exit(*code); // UB! Accessing uninitialized memory."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Validity"},{"DocComment":""},{"DocComment":" `MaybeUninit<T>` has no validity requirements – any sequence of [bytes] of"},{"DocComment":" the appropriate length, initialized or uninitialized, are a valid"},{"DocComment":" representation."},{"DocComment":""},{"DocComment":" Moving or copying a value of type `MaybeUninit<T>` (i.e., performing a"},{"DocComment":" \"typed copy\") will exactly preserve the contents, including the"},{"DocComment":" [provenance], of all non-padding bytes of type `T` in the value's"},{"DocComment":" representation."},{"DocComment":""},{"DocComment":" Therefore `MaybeUninit` can be used to perform a round trip of a value from"},{"DocComment":" type `T` to type `MaybeUninit<U>` then back to type `T`, while preserving"},{"DocComment":" the original value, if two conditions are met. One, type `U` must have the"},{"DocComment":" same size as type `T`. Two, for all byte offsets where type `U` has padding,"},{"DocComment":" the corresponding bytes in the representation of the value must be"},{"DocComment":" uninitialized."},{"DocComment":""},{"DocComment":" For example, due to the fact that the type `[u8; size_of::<T>]` has no"},{"DocComment":" padding, the following is sound for any type `T` and will return the"},{"DocComment":" original value:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" # struct T;"},{"DocComment":" fn identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         let u: MaybeUninit<[u8; size_of::<T>()]> = transmute(t);"},{"DocComment":"         transmute(u) // OK."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note: Copying a value that contains references may implicitly reborrow them"},{"DocComment":" causing the provenance of the returned value to differ from that of the"},{"DocComment":" original. This applies equally to the trivial identity function:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" fn trivial_identity<T>(t: T) -> T { t }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note: Moving or copying a value whose representation has initialized bytes"},{"DocComment":" at byte offsets where the type has padding may lose the value of those"},{"DocComment":" bytes, so while the original value will be preserved, the original"},{"DocComment":" *representation* of that value as bytes may not be. Again, this applies"},{"DocComment":" equally to `trivial_identity`."},{"DocComment":""},{"DocComment":" Note: Performing this round trip when type `U` has padding at byte offsets"},{"DocComment":" where the representation of the original value has initialized bytes may"},{"DocComment":" produce undefined behavior or a different value. For example, the following"},{"DocComment":" is unsound since `T` requires all bytes to be initialized:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" #[repr(C)] struct T([u8; 4]);"},{"DocComment":" #[repr(C)] struct U(u8, u16);"},{"DocComment":" fn unsound_identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         let u: MaybeUninit<U> = transmute(t);"},{"DocComment":"         transmute(u) // UB."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Conversely, the following is sound since `T` allows uninitialized bytes in"},{"DocComment":" the representation of a value, but the round trip may alter the value:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" # use core::mem::{MaybeUninit, transmute};"},{"DocComment":" #[repr(C)] struct T(MaybeUninit<[u8; 4]>);"},{"DocComment":" #[repr(C)] struct U(u8, u16);"},{"DocComment":" fn non_identity(t: T) -> T {"},{"DocComment":"     unsafe {"},{"DocComment":"         // May lose an initialized byte."},{"DocComment":"         let u: MaybeUninit<U> = transmute(t);"},{"DocComment":"         transmute(u)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [bytes]: ../../reference/memory-model.html#bytes"},{"DocComment":" [provenance]: crate::ptr#provenance"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"maybe_uninit"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Union":[{"span":{"data":{"file_id":10,"beg":{"line":356,"col":4},"end":{"line":356,"col":14}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"uninit","ty":{"HashConsedValue":[322,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}},{"span":{"data":{"file_id":10,"beg":{"line":357,"col":4},"end":{"line":357,"col":26}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"value","ty":{"HashConsedValue":[3728,{"Adt":{"id":{"Adt":9},"generics":{"regions":[],"types":[{"Deduplicated":3720}],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[],"ptr_metadata":"None"},{"def_id":8,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["control_flow",0]},{"Ident":["ControlFlow",0]}],"span":{"data":{"file_id":12,"beg":{"line":89,"col":0},"end":{"line":89,"col":31}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to tell an operation whether it should exit early or go on as usual."},{"DocComment":""},{"DocComment":" This is used when exposing things (like graph traversals or visitors) where"},{"DocComment":" you want the user to be able to choose whether to exit early."},{"DocComment":" Having the enum makes it clearer -- no more wondering \"wait, what did `false`"},{"DocComment":" mean again?\" -- and allows including a value."},{"DocComment":""},{"DocComment":" Similar to [`Option`] and [`Result`], this enum can be used with the `?` operator"},{"DocComment":" to return immediately if the [`Break`] variant is present or otherwise continue normally"},{"DocComment":" with the value inside the [`Continue`] variant."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Early-exiting from [`Iterator::try_for_each`]:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let r = (2..100).try_for_each(|x| {"},{"DocComment":"     if 403 % x == 0 {"},{"DocComment":"         return ControlFlow::Break(x)"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     ControlFlow::Continue(())"},{"DocComment":" });"},{"DocComment":" assert_eq!(r, ControlFlow::Break(13));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A basic tree traversal:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" pub struct TreeNode<T> {"},{"DocComment":"     value: T,"},{"DocComment":"     left: Option<Box<TreeNode<T>>>,"},{"DocComment":"     right: Option<Box<TreeNode<T>>>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> TreeNode<T> {"},{"DocComment":"     pub fn traverse_inorder<B>(&self, f: &mut impl FnMut(&T) -> ControlFlow<B>) -> ControlFlow<B> {"},{"DocComment":"         if let Some(left) = &self.left {"},{"DocComment":"             left.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         f(&self.value)?;"},{"DocComment":"         if let Some(right) = &self.right {"},{"DocComment":"             right.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         ControlFlow::Continue(())"},{"DocComment":"     }"},{"DocComment":"     fn leaf(value: T) -> Option<Box<TreeNode<T>>> {"},{"DocComment":"         Some(Box::new(Self { value, left: None, right: None }))"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let node = TreeNode {"},{"DocComment":"     value: 0,"},{"DocComment":"     left: TreeNode::leaf(1),"},{"DocComment":"     right: Some(Box::new(TreeNode {"},{"DocComment":"         value: -1,"},{"DocComment":"         left: TreeNode::leaf(5),"},{"DocComment":"         right: TreeNode::leaf(2),"},{"DocComment":"     }))"},{"DocComment":" };"},{"DocComment":" let mut sum = 0;"},{"DocComment":""},{"DocComment":" let res = node.traverse_inorder(&mut |val| {"},{"DocComment":"     if *val < 0 {"},{"DocComment":"         ControlFlow::Break(*val)"},{"DocComment":"     } else {"},{"DocComment":"         sum += *val;"},{"DocComment":"         ControlFlow::Continue(())"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(res, ControlFlow::Break(-1));"},{"DocComment":" assert_eq!(sum, 6);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Break`]: ControlFlow::Break"},{"DocComment":" [`Continue`]: ControlFlow::Continue"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"ControlFlow"},"generics":{"regions":[],"types":[{"index":0,"name":"B"},{"index":1,"name":"C"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":12,"beg":{"line":93,"col":4},"end":{"line":93,"col":12}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Move on to the next phase of the operation as normal."}],"inline":null,"rename":null,"public":true},"name":"Continue","fields":[{"span":{"data":{"file_id":12,"beg":{"line":93,"col":13},"end":{"line":93,"col":14}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":3721}}],"discriminant":{"Scalar":{"Signed":["Isize","0"]}}},{"id":1,"span":{"data":{"file_id":12,"beg":{"line":97,"col":4},"end":{"line":97,"col":9}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Exit the operation without running subsequent phases."}],"inline":null,"rename":null,"public":true},"name":"Break","fields":[{"span":{"data":{"file_id":12,"beg":{"line":97,"col":10},"end":{"line":97,"col":11}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":3720}}],"discriminant":{"Scalar":{"Signed":["Isize","1"]}}}]},"layout":[],"ptr_metadata":"None"},{"def_id":9,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["manually_drop",0]},{"Ident":["ManuallyDrop",0]}],"span":{"data":{"file_id":14,"beg":{"line":161,"col":0},"end":{"line":161,"col":34}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper to inhibit the compiler from automatically calling `T`’s"},{"DocComment":" destructor. This wrapper is 0-cost."},{"DocComment":""},{"DocComment":" `ManuallyDrop<T>` is guaranteed to have the same layout and bit validity as"},{"DocComment":" `T`, and is subject to the same layout optimizations as `T`. As a"},{"DocComment":" consequence, it has *no effect* on the assumptions that the compiler makes"},{"DocComment":" about its contents. For example, initializing a `ManuallyDrop<&mut T>` with"},{"DocComment":" [`mem::zeroed`] is undefined behavior. If you need to handle uninitialized"},{"DocComment":" data, use [`MaybeUninit<T>`] instead."},{"DocComment":""},{"DocComment":" Note that accessing the value inside a `ManuallyDrop<T>` is safe. This means"},{"DocComment":" that a `ManuallyDrop<T>` whose content has been dropped must not be exposed"},{"DocComment":" through a public safe API. Correspondingly, `ManuallyDrop::drop` is unsafe."},{"DocComment":""},{"DocComment":" # `ManuallyDrop` and drop order"},{"DocComment":""},{"DocComment":" Rust has a well-defined [drop order] of values. To make sure that fields or"},{"DocComment":" locals are dropped in a specific order, reorder the declarations such that"},{"DocComment":" the implicit drop order is the correct one."},{"DocComment":""},{"DocComment":" It is possible to use `ManuallyDrop` to control the drop order, but this"},{"DocComment":" requires unsafe code and is hard to do correctly in the presence of"},{"DocComment":" unwinding."},{"DocComment":""},{"DocComment":" For example, if you want to make sure that a specific field is dropped after"},{"DocComment":" the others, make it the last field of a struct:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct Context;"},{"DocComment":""},{"DocComment":" struct Widget {"},{"DocComment":"     children: Vec<Widget>,"},{"DocComment":"     // `context` will be dropped after `children`."},{"DocComment":"     // Rust guarantees that fields are dropped in the order of declaration."},{"DocComment":"     context: Context,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Interaction with `Box`"},{"DocComment":""},{"DocComment":" Currently, if you have a `ManuallyDrop<T>`, where the type `T` is a `Box` or"},{"DocComment":" contains a `Box` inside, then dropping the `T` followed by moving the"},{"DocComment":" `ManuallyDrop<T>` is [considered to be undefined"},{"DocComment":" behavior](https://github.com/rust-lang/unsafe-code-guidelines/issues/245)."},{"DocComment":" That is, the following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" let mut x = ManuallyDrop::new(Box::new(42));"},{"DocComment":" unsafe {"},{"DocComment":"     ManuallyDrop::drop(&mut x);"},{"DocComment":" }"},{"DocComment":" let y = x; // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This is [likely to change in the"},{"DocComment":" future](https://rust-lang.github.io/rfcs/3336-maybe-dangling.html). In the"},{"DocComment":" meantime, consider using [`MaybeUninit`] instead."},{"DocComment":""},{"DocComment":" # Safety hazards when storing `ManuallyDrop` in a struct or an enum."},{"DocComment":""},{"DocComment":" Special care is needed when all of the conditions below are met:"},{"DocComment":" * A struct or enum contains a `ManuallyDrop`."},{"DocComment":" * The `ManuallyDrop` is not inside a `union`."},{"DocComment":" * The struct or enum is part of public API, or is stored in a struct or an"},{"DocComment":"   enum that is part of public API."},{"DocComment":" * There is code that drops the contents of the `ManuallyDrop` field, and"},{"DocComment":"   this code is outside the struct or enum's `Drop` implementation."},{"DocComment":""},{"DocComment":" In particular, the following hazards may occur:"},{"DocComment":""},{"DocComment":" #### Storing generic types"},{"DocComment":""},{"DocComment":" If the `ManuallyDrop` contains a client-supplied generic type, the client"},{"DocComment":" might provide a `Box` as that type. This would cause undefined behavior when"},{"DocComment":" the struct or enum is later moved, as mentioned in the previous section. For"},{"DocComment":" example, the following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" pub struct BadOption<T> {"},{"DocComment":"     // Invariant: Has been dropped if `is_some` is false."},{"DocComment":"     value: ManuallyDrop<T>,"},{"DocComment":"     is_some: bool,"},{"DocComment":" }"},{"DocComment":" impl<T> BadOption<T> {"},{"DocComment":"     pub fn new(value: T) -> Self {"},{"DocComment":"         Self { value: ManuallyDrop::new(value), is_some: true }"},{"DocComment":"     }"},{"DocComment":"     pub fn change_to_none(&mut self) {"},{"DocComment":"         if self.is_some {"},{"DocComment":"             self.is_some = false;"},{"DocComment":"             unsafe {"},{"DocComment":"                 // SAFETY: `value` hasn't been dropped yet, as per the invariant"},{"DocComment":"                 // (This is actually unsound!)"},{"DocComment":"                 ManuallyDrop::drop(&mut self.value);"},{"DocComment":"             }"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let mut option = BadOption::new(Box::new(42));"},{"DocComment":" option.change_to_none();"},{"DocComment":" let option2 = option; // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" #### Deriving traits"},{"DocComment":""},{"DocComment":" Deriving `Debug`, `Clone`, `PartialEq`, `PartialOrd`, `Ord`, or `Hash` on"},{"DocComment":" the struct or enum could be unsound, since the derived implementations of"},{"DocComment":" these traits would access the `ManuallyDrop` field. For example, the"},{"DocComment":" following code causes undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" // This derive is unsound in combination with the `ManuallyDrop::drop` call."},{"DocComment":" #[derive(Debug)]"},{"DocComment":" pub struct Foo {"},{"DocComment":"     value: ManuallyDrop<String>,"},{"DocComment":" }"},{"DocComment":" impl Foo {"},{"DocComment":"     pub fn new() -> Self {"},{"DocComment":"         let mut temp = Self {"},{"DocComment":"             value: ManuallyDrop::new(String::from(\"Unsafe rust is hard.\"))"},{"DocComment":"         };"},{"DocComment":"         unsafe {"},{"DocComment":"             // SAFETY: `value` hasn't been dropped yet."},{"DocComment":"             ManuallyDrop::drop(&mut temp.value);"},{"DocComment":"         }"},{"DocComment":"         temp"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let foo = Foo::new();"},{"DocComment":" println!(\"{:?}\", foo); // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [drop order]: https://doc.rust-lang.org/reference/destructors.html"},{"DocComment":" [`mem::zeroed`]: crate::mem::zeroed"},{"DocComment":" [`MaybeUninit<T>`]: crate::mem::MaybeUninit"},{"DocComment":" [`MaybeUninit`]: crate::mem::MaybeUninit"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"manually_drop"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":10,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["Guard",0]}],"span":{"data":{"file_id":1,"beg":{"line":934,"col":0},"end":{"line":934,"col":19}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Mutable"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":3720},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":1,"beg":{"line":936,"col":4},"end":{"line":936,"col":43}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"array_mut","ty":{"HashConsedValue":[3731,{"Ref":[{"Var":{"Free":0}},{"HashConsedValue":[3730,{"Slice":{"HashConsedValue":[3729,{"Adt":{"id":{"Adt":7},"generics":{"regions":[],"types":[{"Deduplicated":3720}],"const_generics":[],"trait_refs":[]}}}]}}]},"Mut"]}]}},{"span":{"data":{"file_id":1,"beg":{"line":938,"col":4},"end":{"line":938,"col":26}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"initialized","ty":{"Deduplicated":286}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,16],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":11,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["Infallible",0]}],"span":{"data":{"file_id":15,"beg":{"line":930,"col":0},"end":{"line":930,"col":19}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The error type for errors that can never happen."},{"DocComment":""},{"DocComment":" Since this enum has no variant, a value of this type can never actually exist."},{"DocComment":" This can be useful for generic APIs that use [`Result`] and parameterize the error type,"},{"DocComment":" to indicate that the result is always [`Ok`]."},{"DocComment":""},{"DocComment":" For example, the [`TryFrom`] trait (conversion that returns a [`Result`])"},{"DocComment":" has a blanket implementation for all types where a reverse [`Into`] implementation exists."},{"DocComment":""},{"DocComment":" ```ignore (illustrates std code, duplicating the impl in a doctest would be an error)"},{"DocComment":" impl<T, U> TryFrom<U> for T where U: Into<T> {"},{"DocComment":"     type Error = Infallible;"},{"DocComment":""},{"DocComment":"     fn try_from(value: U) -> Result<Self, Infallible> {"},{"DocComment":"         Ok(U::into(value))  // Never returns `Err`"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Future compatibility"},{"DocComment":""},{"DocComment":" This enum has the same role as [the `!` “never” type][never],"},{"DocComment":" which is unstable in this version of Rust."},{"DocComment":" When `!` is stabilized, we plan to make `Infallible` a type alias to it:"},{"DocComment":""},{"DocComment":" ```ignore (illustrates future std change)"},{"DocComment":" pub type Infallible = !;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" … and eventually deprecate `Infallible`."},{"DocComment":""},{"DocComment":" However there is one case where `!` syntax can be used"},{"DocComment":" before `!` is stabilized as a full-fledged type: in the position of a function’s return type."},{"DocComment":" Specifically, it is possible to have implementations for two different function pointer types:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" trait MyTrait {}"},{"DocComment":" impl MyTrait for fn() -> ! {}"},{"DocComment":" impl MyTrait for fn() -> std::convert::Infallible {}"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" With `Infallible` being an enum, this code is valid."},{"DocComment":" However when `Infallible` becomes an alias for the never type,"},{"DocComment":" the two `impl`s will start to overlap"},{"DocComment":" and therefore will be disallowed by the language’s trait coherence rules."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":null,"uninhabited":true,"variant_layouts":[],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},null,null,{"def_id":14,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["pin",0]},{"Ident":["Pin",0]}],"span":{"data":{"file_id":24,"beg":{"line":1092,"col":0},"end":{"line":1092,"col":19}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A pointer which pins its pointee in place."},{"DocComment":""},{"DocComment":" [`Pin`] is a wrapper around some kind of pointer `Ptr` which makes that pointer \"pin\" its"},{"DocComment":" pointee value in place, thus preventing the value referenced by that pointer from being moved"},{"DocComment":" or otherwise invalidated at that place in memory unless it implements [`Unpin`]."},{"DocComment":""},{"DocComment":" *See the [`pin` module] documentation for a more thorough exploration of pinning.*"},{"DocComment":""},{"DocComment":" ## Pinning values with [`Pin<Ptr>`]"},{"DocComment":""},{"DocComment":" In order to pin a value, we wrap a *pointer to that value* (of some type `Ptr`) in a"},{"DocComment":" [`Pin<Ptr>`]. [`Pin<Ptr>`] can wrap any pointer type, forming a promise that the **pointee**"},{"DocComment":" will not be *moved* or [otherwise invalidated][subtle-details]. If the pointee value's type"},{"DocComment":" implements [`Unpin`], we are free to disregard these requirements entirely and can wrap any"},{"DocComment":" pointer to that value in [`Pin`] directly via [`Pin::new`]. If the pointee value's type does"},{"DocComment":" not implement [`Unpin`], then Rust will not let us use the [`Pin::new`] function directly and"},{"DocComment":" we'll need to construct a [`Pin`]-wrapped pointer in one of the more specialized manners"},{"DocComment":" discussed below."},{"DocComment":""},{"DocComment":" We call such a [`Pin`]-wrapped pointer a **pinning pointer** (or pinning ref, or pinning"},{"DocComment":" [`Box`], etc.) because its existence is the thing that is pinning the underlying pointee in"},{"DocComment":" place: it is the metaphorical \"pin\" securing the data in place on the pinboard (in memory)."},{"DocComment":""},{"DocComment":" It is important to stress that the thing in the [`Pin`] is not the value which we want to pin"},{"DocComment":" itself, but rather a pointer to that value! A [`Pin<Ptr>`] does not pin the `Ptr` but rather"},{"DocComment":" the pointer's ***pointee** value*."},{"DocComment":""},{"DocComment":" The most common set of types which require pinning related guarantees for soundness are the"},{"DocComment":" compiler-generated state machines that implement [`Future`] for the return value of"},{"DocComment":" `async fn`s. These compiler-generated [`Future`]s may contain self-referential pointers, one"},{"DocComment":" of the most common use cases for [`Pin`]. More details on this point are provided in the"},{"DocComment":" [`pin` module] docs, but suffice it to say they require the guarantees provided by pinning to"},{"DocComment":" be implemented soundly."},{"DocComment":""},{"DocComment":" This requirement for the implementation of `async fn`s means that the [`Future`] trait"},{"DocComment":" requires all calls to [`poll`] to use a <code>self: [Pin]\\<&mut Self></code> parameter instead"},{"DocComment":" of the usual `&mut self`. Therefore, when manually polling a future, you will need to pin it"},{"DocComment":" first."},{"DocComment":""},{"DocComment":" You may notice that `async fn`-sourced [`Future`]s are only a small percentage of all"},{"DocComment":" [`Future`]s that exist, yet we had to modify the signature of [`poll`] for all [`Future`]s"},{"DocComment":" to accommodate them. This is unfortunate, but there is a way that the language attempts to"},{"DocComment":" alleviate the extra friction that this API choice incurs: the [`Unpin`] trait."},{"DocComment":""},{"DocComment":" The vast majority of Rust types have no reason to ever care about being pinned. These"},{"DocComment":" types implement the [`Unpin`] trait, which entirely opts all values of that type out of"},{"DocComment":" pinning-related guarantees. For values of these types, pinning a value by pointing to it with a"},{"DocComment":" [`Pin<Ptr>`] will have no actual effect."},{"DocComment":""},{"DocComment":" The reason this distinction exists is exactly to allow APIs like [`Future::poll`] to take a"},{"DocComment":" [`Pin<Ptr>`] as an argument for all types while only forcing [`Future`] types that actually"},{"DocComment":" care about pinning guarantees pay the ergonomics cost. For the majority of [`Future`] types"},{"DocComment":" that don't have a reason to care about being pinned and therefore implement [`Unpin`], the"},{"DocComment":" <code>[Pin]\\<&mut Self></code> will act exactly like a regular `&mut Self`, allowing direct"},{"DocComment":" access to the underlying value. Only types that *don't* implement [`Unpin`] will be restricted."},{"DocComment":""},{"DocComment":" ### Pinning a value of a type that implements [`Unpin`]"},{"DocComment":""},{"DocComment":" If the type of the value you need to \"pin\" implements [`Unpin`], you can trivially wrap any"},{"DocComment":" pointer to that value in a [`Pin`] by calling [`Pin::new`]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::pin::Pin;"},{"DocComment":""},{"DocComment":" // Create a value of a type that implements `Unpin`"},{"DocComment":" let mut unpin_future = std::future::ready(5);"},{"DocComment":""},{"DocComment":" // Pin it by creating a pinning mutable reference to it (ready to be `poll`ed!)"},{"DocComment":" let my_pinned_unpin_future: Pin<&mut _> = Pin::new(&mut unpin_future);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ### Pinning a value inside a [`Box`]"},{"DocComment":""},{"DocComment":" The simplest and most flexible way to pin a value that does not implement [`Unpin`] is to put"},{"DocComment":" that value inside a [`Box`] and then turn that [`Box`] into a \"pinning [`Box`]\" by wrapping it"},{"DocComment":" in a [`Pin`]. You can do both of these in a single step using [`Box::pin`]. Let's see an"},{"DocComment":" example of using this flow to pin a [`Future`] returned from calling an `async fn`, a common"},{"DocComment":" use case as described above."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::pin::Pin;"},{"DocComment":""},{"DocComment":" async fn add_one(x: u32) -> u32 {"},{"DocComment":"     x + 1"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Call the async function to get a future back"},{"DocComment":" let fut = add_one(42);"},{"DocComment":""},{"DocComment":" // Pin the future inside a pinning box"},{"DocComment":" let pinned_fut: Pin<Box<_>> = Box::pin(fut);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you have a value which is already boxed, for example a [`Box<dyn Future>`][Box], you can pin"},{"DocComment":" that value in-place at its current memory address using [`Box::into_pin`]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::pin::Pin;"},{"DocComment":" use std::future::Future;"},{"DocComment":""},{"DocComment":" async fn add_one(x: u32) -> u32 {"},{"DocComment":"     x + 1"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn boxed_add_one(x: u32) -> Box<dyn Future<Output = u32>> {"},{"DocComment":"     Box::new(add_one(x))"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let boxed_fut = boxed_add_one(42);"},{"DocComment":""},{"DocComment":" // Pin the future inside the existing box"},{"DocComment":" let pinned_fut: Pin<Box<_>> = Box::into_pin(boxed_fut);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There are similar pinning methods offered on the other standard library smart pointer types"},{"DocComment":" as well, like [`Rc`] and [`Arc`]."},{"DocComment":""},{"DocComment":" ### Pinning a value on the stack using [`pin!`]"},{"DocComment":""},{"DocComment":" There are some situations where it is desirable or even required (for example, in a `#[no_std]`"},{"DocComment":" context where you don't have access to the standard library or allocation in general) to"},{"DocComment":" pin a value which does not implement [`Unpin`] to its location on the stack. Doing so is"},{"DocComment":" possible using the [`pin!`] macro. See its documentation for more."},{"DocComment":""},{"DocComment":" ## Layout and ABI"},{"DocComment":""},{"DocComment":" [`Pin<Ptr>`] is guaranteed to have the same memory layout and ABI[^noalias] as `Ptr`."},{"DocComment":""},{"DocComment":" [^noalias]: There is a bit of nuance here that is still being decided about whether the"},{"DocComment":" aliasing semantics of `Pin<&mut T>` should be different than `&mut T`, but this is true as of"},{"DocComment":" today."},{"DocComment":""},{"DocComment":" [`pin!`]: crate::pin::pin \"pin!\""},{"DocComment":" [`Future`]: crate::future::Future \"Future\""},{"DocComment":" [`poll`]: crate::future::Future::poll \"Future::poll\""},{"DocComment":" [`Future::poll`]: crate::future::Future::poll \"Future::poll\""},{"DocComment":" [`pin` module]: self \"pin module\""},{"DocComment":" [`Rc`]: ../../std/rc/struct.Rc.html \"Rc\""},{"DocComment":" [`Arc`]: ../../std/sync/struct.Arc.html \"Arc\""},{"DocComment":" [Box]: ../../std/boxed/struct.Box.html \"Box\""},{"DocComment":" [`Box`]: ../../std/boxed/struct.Box.html \"Box\""},{"DocComment":" [`Box::pin`]: ../../std/boxed/struct.Box.html#method.pin \"Box::pin\""},{"DocComment":" [`Box::into_pin`]: ../../std/boxed/struct.Box.html#method.into_pin \"Box::into_pin\""},{"DocComment":" [subtle-details]: self#subtle-details-and-the-drop-guarantee \"pin subtle details\""},{"DocComment":" [`unsafe`]: ../../std/keyword.unsafe.html \"keyword unsafe\""}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"pin"},"generics":{"regions":[],"types":[{"index":0,"name":"Ptr"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},null,null,{"def_id":17,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Formatter",0]}],"span":{"data":{"file_id":20,"beg":{"line":561,"col":0},"end":{"line":561,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Configuration for formatting."},{"DocComment":""},{"DocComment":" A `Formatter` represents various options related to formatting. Users do not"},{"DocComment":" construct `Formatter`s directly; a mutable reference to one is passed to"},{"DocComment":" the `fmt` method of all formatting traits, like [`Debug`] and [`Display`]."},{"DocComment":""},{"DocComment":" To interact with a `Formatter`, you'll call various methods to change the"},{"DocComment":" various options related to formatting. For examples, please see the"},{"DocComment":" documentation of the methods defined on `Formatter` below."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Formatter"},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Mutable"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[{"regions":[],"skip_binder":[{"Var":{"Free":0}},{"Var":{"Free":0}}]}],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[16,0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":18,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}],"span":{"data":{"file_id":25,"beg":{"line":557,"col":0},"end":{"line":557,"col":21}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Result` is a type that represents either success ([`Ok`]) or failure ([`Err`])."},{"DocComment":""},{"DocComment":" See the [module documentation](self) for details."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":"Result"},"generics":{"regions":[],"types":[{"index":0,"name":"T"},{"index":1,"name":"E"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":25,"beg":{"line":561,"col":4},"end":{"line":561,"col":6}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Contains the success value"}],"inline":null,"rename":null,"public":true},"name":"Ok","fields":[{"span":{"data":{"file_id":25,"beg":{"line":561,"col":53},"end":{"line":561,"col":54}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":3720}}],"discriminant":{"Scalar":{"Signed":["Isize","0"]}}},{"id":1,"span":{"data":{"file_id":25,"beg":{"line":566,"col":4},"end":{"line":566,"col":7}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" Contains the error value"}],"inline":null,"rename":null,"public":true},"name":"Err","fields":[{"span":{"data":{"file_id":25,"beg":{"line":566,"col":54},"end":{"line":566,"col":55}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"Deduplicated":3721}}],"discriminant":{"Scalar":{"Signed":["Isize","1"]}}}]},"layout":[],"ptr_metadata":"None"},{"def_id":19,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Error",0]}],"span":{"data":{"file_id":20,"beg":{"line":109,"col":0},"end":{"line":109,"col":16}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The error type which is returned from formatting a message into a stream."},{"DocComment":""},{"DocComment":" This type does not support transmission of an error other than that an error"},{"DocComment":" occurred. This is because, despite the existence of this error,"},{"DocComment":" string formatting is considered an infallible operation."},{"DocComment":" `fmt()` implementors should not return this `Error` unless they received it from their"},{"DocComment":" [`Formatter`]. The only time your code should create a new instance of this"},{"DocComment":" error is when implementing `fmt::Write`, in order to cancel the formatting operation when"},{"DocComment":" writing to the underlying stream fails."},{"DocComment":""},{"DocComment":" Any extra information must be arranged to be transmitted through some other means,"},{"DocComment":" such as storing it in a field to be consulted after the formatting operation has been"},{"DocComment":" cancelled. (For example, this is how [`std::io::Write::write_fmt()`] propagates IO errors"},{"DocComment":" during writing.)"},{"DocComment":""},{"DocComment":" This type, `fmt::Error`, should not be"},{"DocComment":" confused with [`std::io::Error`] or [`std::error::Error`], which you may also"},{"DocComment":" have in scope."},{"DocComment":""},{"DocComment":" [`std::io::Error`]: ../../std/io/struct.Error.html"},{"DocComment":" [`std::io::Write::write_fmt()`]: ../../std/io/trait.Write.html#method.write_fmt"},{"DocComment":" [`std::error::Error`]: ../../std/error/trait.Error.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::fmt::{self, write};"},{"DocComment":""},{"DocComment":" let mut output = String::new();"},{"DocComment":" if let Err(fmt::Error) = write(&mut output, format_args!(\"Hello {}!\", \"world\")) {"},{"DocComment":"     panic!(\"An error occurred\");"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},null,null,{"def_id":22,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["cmp",0]},{"Ident":["Ordering",0]}],"span":{"data":{"file_id":21,"beg":{"line":405,"col":0},"end":{"line":405,"col":17}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An `Ordering` is the result of a comparison between two values."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::cmp::Ordering;"},{"DocComment":""},{"DocComment":" assert_eq!(1.cmp(&2), Ordering::Less);"},{"DocComment":""},{"DocComment":" assert_eq!(1.cmp(&1), Ordering::Equal);"},{"DocComment":""},{"DocComment":" assert_eq!(2.cmp(&1), Ordering::Greater);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Ordering"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints"