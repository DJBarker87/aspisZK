AspisR1.R13MultiproofReadSet.accepted_family {H : List AspisR1.BinMerkle32Path.Byte → AspisR1.BinMerkle32Path.Digest}
  {root : AspisR1.BinMerkle32Path.Digest} {depth : ℕ} {active : AspisR1.BinMultiproof.Active}
  {v : AspisR1.BinMultiproof.Values} {nodes : List AspisR1.BinMerkle32Path.Digest}
  {trace : List (List AspisR1.BinMerkle32Path.Byte)}
  (h : AspisR1.BinMultiproof.Accept H root depth active v nodes trace) :
  ∃ paths,
    (∀ (i : ℕ) (hi : i ∈ active),
        AspisR1.BinMerkle32Path.foldPath H (paths i hi) (v i) = root ∧
          AspisR1.BinMerkle32Path.inputTrace H (paths i hi) (v i) ⊆ trace) ∧
      ∀ (input : List AspisR1.BinMerkle32Path.Byte),
        input ∈ trace ↔ ∃ i, ∃ (hi : i ∈ active), input ∈ AspisR1.BinMerkle32Path.inputTrace H (paths i hi) (v i)
