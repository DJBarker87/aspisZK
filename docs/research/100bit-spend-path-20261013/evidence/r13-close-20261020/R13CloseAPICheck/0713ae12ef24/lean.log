def Aeneas.Std.Array.set.{u} : {α : Type u} → {n : Usize} → Std.Array α n → Usize → α → Std.Array α n :=
fun {α} {n} v i x => ⟨(↑v).set (↑i) x, ⋯⟩
def Aeneas.Std.Array.from_slice.{u} : {α : Type u} → {n : Usize} → Std.Array α n → Slice α → Std.Array α n :=
fun {α} {n} a s => if h : (↑s).length = ↑n then ⟨↑s, ⋯⟩ else a
def Aeneas.Std.Array.to_slice.{u} : {α : Type u} → {n : Usize} → Std.Array α n → Slice α :=
fun {α} {n} v => ⟨↑v, ⋯⟩
def Aeneas.Std.Slice.update.{u} : {α : Type u} → Slice α → Usize → α → Result (Slice α) :=
fun {α} v i x =>
  match (↑v)[↑i]? with
  | none => fail Error.arrayOutOfBounds
  | some val => ok ⟨(↑v).set (↑i) x, ⋯⟩
