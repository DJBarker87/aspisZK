def Aeneas.Std.Array.update.{u} : {α : Type u} → {n : Usize} → Std.Array α n → Usize → α → Result (Std.Array α n) :=
fun {α} {n} v i x =>
  match v[i]? with
  | none => fail Error.arrayOutOfBounds
  | some val => ok ⟨(↑v).set (↑i) x, ⋯⟩
def Aeneas.Std.Array.index_usize.{u} : {α : Type u} → {n : Usize} → Std.Array α n → Usize → Result α :=
fun {α} {n} v i =>
  match v[i]? with
  | none => fail Error.arrayOutOfBounds
  | some x => ok x
