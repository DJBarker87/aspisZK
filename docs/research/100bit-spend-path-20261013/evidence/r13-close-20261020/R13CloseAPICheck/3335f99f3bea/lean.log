def Aeneas.Std.core.slice.Slice.swap : {T : Type} → Slice T → Usize → Usize → Result (Slice T) :=
fun {T} s a b => do
  let av ← s.index_usize a
  let bv ← s.index_usize b
  let s1 ← s.update a bv
  s1.update b av
