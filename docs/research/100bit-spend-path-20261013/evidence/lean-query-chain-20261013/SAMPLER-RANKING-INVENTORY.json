    "lean_rank_and_digit_links": [
      {
        "symbol": "R0C.ModuloCounting.reduce",
        "path": "docs/research/v8-r0-close-20261007/lean/R0C/ModuloCounting.lean:15-16",
        "statement": "x \u21a6 \u27e8x.val % n, ...\u27e9 for x : Fin B."
