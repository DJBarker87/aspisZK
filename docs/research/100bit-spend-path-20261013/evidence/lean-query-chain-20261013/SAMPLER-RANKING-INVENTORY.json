  "findings": {
    "r1_functions": [
      {
        "symbol": "qm31_sample",
        "path": "crates/aspis-r1-cost-probe/src/sampler.rs:8-24",
        "description": "Splits [u8;32] into eight low-to-high u32 words using from_le_bytes at 4*i. Performs four repeated long divisions by P over the eight words from high word to low, collecting remainders d0..d3. Returns QM31 with c0=(d0,d1), c1=(d2,d3). There is no explicit 256-bit binary-reduction loop in this R1 function."
      },
      {
        "symbol": "ordinary_sample",
        "path": "crates/aspis-r1-cost-probe/src/sampler.rs:26-46,73-78",
        "description": "low_base_p_digits performs eight repeated long divisions by P from B itself, yielding eight low base-P remainders and quotient c<=256. ordinary_sample discards c and decodes those eight digits."
      },
      {
        "symbol": "gamma_sample",
        "path": "crates/aspis-r1-cost-probe/src/sampler.rs:61-71,80-92",
        "description": "Adds c+1 to low eight base-P digits with carry. If a final carry remains, adds one more to account for P^8 congruent to 1 modulo P^8-1. Decodes as WideExact."
      }
    ],
    "legacy_core_functions": [
      {
        "symbol": "block_rank",
        "path": "crates/aspis-core/src/r0_transcript.rs:89-94",
        "description": "Parses the 32-byte block into eight little-endian u32 limbs."
      },
      {
        "symbol": "reduce_rank",
        "path": "crates/aspis-core/src/r0_transcript.rs:96-122",
        "description": "256-iteration binary long-division reduction for supplied 256-bit modulus array."
      },
      {
        "symbol": "base_p_digits",
        "path": "crates/aspis-core/src/r0_transcript.rs:124-136",
        "description": "Eight successive divisions by P after reduction."
      },
      {
        "symbol": "qm31_sample",
