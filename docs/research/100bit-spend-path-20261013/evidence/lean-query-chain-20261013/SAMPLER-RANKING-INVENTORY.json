      {
        "symbol": "R0C.ModuloCounting.fiber_card_le",
        "path": "docs/research/v8-r0-close-20261007/lean/R0C/ModuloCounting.lean:18-35",
        "statement": "Any residue fiber has card \u2264 B/n+1, by injectively mapping each element to its quotient."
      },
      {
        "symbol": "R0C.ModuloCounting.encoded_mass_le",
        "path": "docs/research/v8-r0-close-20261007/lean/R0C/ModuloCounting.lean:38-51",
        "statement": "For arbitrary input : A \u2243 Fin B and output : Fin n \u2243 E, bounds atom mass of output(reduce(input a)); equivalence assumptions are explicit."
      },
      {
        "symbol": "R0C.ModuloField.blockRank / blockRank_value",
        "path": "docs/research/v8-r0-close-20261007/lean/R0C/ModuloField.lean:18-23",
        "statement": "State \u2243 Fin(256^32); value is \u2211 i : Fin 32, (s i).val * 256^i.val, i.e. byte zero is least significant."
      },
      {
        "symbol": "Mathlib.finFunctionFinEquiv / finFunctionFinEquiv_apply",
        "path": "docs/research/v8-full-view-zk-20260912/evidence/r406-sampler-word-distribution/mathlib-sources/Algebra-BigOperators-Fin.lean:578-612",
        "statement": "Fin n \u2192 Fin m \u2194 Fin(m^n); forward rank is \u2211 i, f(i)*m^i; inverse coordinate is rank / m^i % m. Used as base-P positional digits in fieldRank and as base-256 bytes in byteWordEquiv."
      },
      {
        "symbol": "R0C.ModuloField.splitDigits / digitsField / digitsField_apply",
        "path": "docs/research/v8-r0-close-20261007/lean/R0C/ModuloField.lean:25-40; docs/research/v8-full-view-zk-20260912/lean/AspisV8R19/R599CanonicalFieldTuple.lean:21-40",
        "statement": "Splits eight base-P digits into first four and last four, maps each Fin4\u2192FinP vector through tupleFieldEquiv, then identifies WideExact as a pair of QM31Exact coordinates. digitsField_apply states the pair explicitly."
      },
