+    init: T,
+    mut f: impl FnMut(usize) -> T,
+) -> [T; N] {
+    let mut out = [init; N];
+    let mut i = 0usize;
+    while i < N {
+        out[i] = f(i);
+        i += 1;
+    }
+    out
+}
