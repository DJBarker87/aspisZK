theorem NJE_Residue.canonical : ∀ (n : ℕ), ↑(word n) < 2147483647 :=
fun n =>
  Eq.mpr (id (congrArg (fun _a => _a < 2147483647) (value n))) (Nat.mod_lt n (of_decide_eq_true (id (Eq.refl true))))
