theorem NJE_Residue.multiply : ∀ (x y : U32),
  AspisR1SemanticCallExtraction.aspis_core.field.M31.mul x y = ok (word (↑x * ↑y)) :=
fun x y =>
  let ⟨z, h✝⟩ := NJA_FieldLaws.generated_mul x y
  let ⟨hz, right✝⟩ := h✝
  let ⟨vz, cz⟩ := right✝
  have eq := UScalar.eq_of_val_eq (Eq.trans vz (Eq.symm (value (↑x * ↑y))));
  Eq.mp (congrArg (Eq (AspisR1SemanticCallExtraction.aspis_core.field.M31.mul x y)) (congrArg ok eq)) hz
