theorem AspisR1.NKG_PreparedMap.result : ∀ (w : Std.Array NQ 3#usize),
  canonical w → ∃ p, FIq_Native.core.array.Array.map (BuiltinFnMut NQ NP) w field.PreparedQm31Multiplier.new = ok p :=
fun w cw =>
  let ⟨p, h✝⟩ :=
    JGa_Map.source (BuiltinFnMut NQ NP) (fun x => True) w field.PreparedQm31Multiplier.new fun x hx =>
      let ⟨p, h✝¹⟩ := FIv_PreparedNewTotal.value x (cw x hx)
      let ⟨run, right✝⟩ := h✝¹
      Exists.intro p
        ⟨id
            (Eq.mpr
              (id
                (congrArg
                  (fun _a =>
                    (do
                        let y ← _a
                        ok (y, field.PreparedQm31Multiplier.new)) =
                      ok (p, field.PreparedQm31Multiplier.new))
                  run))
              (Eq.mpr
                (id
                  (congrArg (fun _a => _a = ok (p, field.PreparedQm31Multiplier.new))
                    (bind_tc_ok p fun y => ok (y, field.PreparedQm31Multiplier.new))))
                (Eq.refl (ok (p, field.PreparedQm31Multiplier.new))))),
          True.intro⟩
  let ⟨rp, right✝¹⟩ := h✝
  Exists.intro p rp
