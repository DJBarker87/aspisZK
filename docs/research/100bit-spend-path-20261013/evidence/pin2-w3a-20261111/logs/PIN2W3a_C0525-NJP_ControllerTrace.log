theorem NJP_ControllerTrace.chronology : ∀ (input : State) (states : Fin 23 → State),
  (NJE_RoundTrace.observed input states 0).input = input ∧
    ∀ (r : Fin 21),
      (NJE_RoundTrace.observed input states ⟨↑r + 1, ⋯⟩).input =
        (NJE_RoundTrace.observed input states ⟨↑r, ⋯⟩).output :=
fun input states =>
  ⟨Eq.refl (NJE_RoundTrace.observed input states 0).input, fun r =>
    id
      (Eq.mpr
        (id
          (congrFun'
            (congrArg Eq
              (Eq.trans
                (ite_congr
                  (eq_false
                    (have this := fun a => chronology._proof_3 r a;
                    this))
                  (fun a => Eq.refl input) fun a =>
                  Eq.refl (states ⟨↑r + 1, Decidable.byContradiction fun a => chronology._proof_1 r a⟩.castSucc))
                (if_false input
                  (states ⟨↑r + 1, Decidable.byContradiction fun a => chronology._proof_1 r a⟩.castSucc))))
            (states ⟨↑r, Decidable.byContradiction fun a => chronology._proof_2 r a⟩.succ)))
        ((fun a a_1 e_a => e_a ▸ Eq.refl (states a))
          ⟨↑r + 1, Decidable.byContradiction fun a => chronology._proof_1 r a⟩.castSucc
          ⟨↑r, Decidable.byContradiction fun a => chronology._proof_2 r a⟩.succ
          (Eq.refl ⟨↑r + 1, Decidable.byContradiction fun a => chronology._proof_1 r a⟩.castSucc)))⟩
