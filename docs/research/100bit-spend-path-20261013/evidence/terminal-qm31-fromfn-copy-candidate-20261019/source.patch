+/// Extraction candidate: construct a fixed array in increasing index order
+/// using a Copy initializer and a stateful callback. This replaces the
+/// `core::array::from_fn` use at the 84-cell terminal claims selector only.
+#[inline(always)]
+pub(crate) fn array_from_fn_copy<T: Copy, const N: usize>(
+    init: T,
+    mut f: impl FnMut(usize) -> T,
+) -> [T; N] {
+    let mut out = [init; N];
+    let mut i = 0usize;
+    while i < N {
+        out[i] = f(i);
+        i += 1;
+    }
+    out
+}
 
