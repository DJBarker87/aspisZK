            (congrArg Eq
              (congrArg (List.cons ↑s.2.2.2.2)
                (Eq.trans ih (congrFun' (congrFun' (congrArg (@List.range') prog.right) states.length) 1))))
            (↑s.2.2.2.2 :: List.range' (↑s.2.2.2.2 + 1) states.length))
          (eq_self (↑s.2.2.2.2 :: List.range' (↑s.2.2.2.2 + 1) states.length))))
    path
