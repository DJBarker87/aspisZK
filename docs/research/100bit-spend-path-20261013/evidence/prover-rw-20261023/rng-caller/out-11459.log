  R1Z.ProverRwRngCallerReplay.Replay.rec
    (fun {s} {out} h =>
      of_eq_true
        (Eq.trans (congrArg (Eq [↑s.2.2.2.2]) (congrFun' (congrArg (@List.range' ↑s.2.2.2.2) (zero_add 1)) 1))
          (eq_self [↑s.2.2.2.2])))
