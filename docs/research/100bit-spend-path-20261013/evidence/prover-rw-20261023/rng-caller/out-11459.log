fun [ProverRwRngCaller.NativeTypes] [ProverRwRngCaller.ErasureFns] {N L B} policy body p0 p1 p2 p3 n0 n1 n2 l0 l1 l2 b0
    b1 b2 nonce0 nonce1 policy0 policy1 admit0 admit1 draw0 draw1 draw2 body0 body1 =>
  have entropy0 := R1Z.ProverRwRngCallerEntropy.zero_then_one_owner p0 p1 p2 nonce0 admit0 draw0 draw1;
  have entropy1 := R1Z.ProverRwRngCallerComposition.one_owner p2 p3 nonce1 admit1 draw2;
  have callback0 :=
    R1Z.ProverRwRngCallerControl.callback_step policy p0 p2 n0 n1 0#usize nonce0
      (Aeneas.Std.core.result.Result.Ok
        { mask_nonce := nonce0, field_mask_entropy := Aeneas.Std.Array.repeat 32#usize 1#u8,
          leaf_salt_seed := Aeneas.Std.Array.repeat 32#usize 1#u8 })
      policy0 entropy0;
  have callback1 :=
    R1Z.ProverRwRngCallerControl.callback_step policy p2 p3 n1 n2 1#usize nonce1
      (Aeneas.Std.core.result.Result.Ok
        { mask_nonce := nonce1, field_mask_entropy := Aeneas.Std.Array.repeat 32#usize 1#u8,
          leaf_salt_seed := Aeneas.Std.Array.repeat 32#usize 1#u8 })
      policy1 entropy1;
  have increment :=
    let ⟨next, h✝⟩ := R1Z.ProverRwRngCallerControl.increment_safe 0#usize (of_decide_eq_true (id (Eq.refl true)))
    let ⟨h, hval⟩ := h✝
    have same := Aeneas.Std.UScalar.eq_of_val_eq hval;
    Eq.mp (congrArg (Eq (0#usize + 1#usize)) (congrArg Aeneas.Std.Result.ok same)) h;
  id
    (Eq.mpr
      (id
        (congrArg
          (fun _a =>
            _a =
              Aeneas.Std.Result.ok (p3, n2, l2, b2, Aeneas.Std.core.result.Result.Err ProverRwRngCaller.Error.Semantic))
          (R1Z.ProverRwRngCallerControl.body_rejected policy body p0 p2 n0 n1 l0 l1 b0 b1 0#usize 1#usize
            (of_decide_eq_true (id (Eq.refl true)))
            { mask_nonce := nonce0, field_mask_entropy := Aeneas.Std.Array.repeat 32#usize 1#u8,
              leaf_salt_seed := Aeneas.Std.Array.repeat 32#usize 1#u8 }
            callback0 body0 increment)))
      (R1Z.ProverRwRngCallerControl.body_fatal policy body p2 p3 n1 n2 l1 l2 b1 b2 1#usize
