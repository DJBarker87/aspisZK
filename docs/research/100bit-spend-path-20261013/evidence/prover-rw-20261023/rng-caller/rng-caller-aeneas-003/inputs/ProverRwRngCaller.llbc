{"charon_version":"0.1.223","translated":{"crate_name":"prover_rw_rng_caller","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::prove_masked_retrying_with"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["zeroize::Zeroizing","getrandom::error::Error","core::num::nonzero::NonZero","core::num::niche_types::NonZeroI32Inner"],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-prover-rw-20261023/src/tools/prover-rw-20261023/rng-caller/ProverRwRngCaller.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"lib.rs"},"crate_name":"prover_rw_rng_caller","contents":"// Source-derived extraction prototype; not a native provider installation.\nuse zeroize::Zeroizing;\nconst ENTROPY_RETRY_LIMIT: usize = 16;\n#[derive(Debug, PartialEq, Eq)]\npub enum StateOnlyAttemptEntropyError { Os(getrandom::Error), RepeatedZeroBlock }\npub struct StateOnlyAttemptSecrets {\n    pub mask_nonce: [u8;32],\n    pub field_mask_entropy: Zeroizing<[u8;32]>,\n    pub leaf_salt_seed: Zeroizing<[u8;32]>,\n}\npub trait Draw64: Sized {\n    fn fill(self, bytes: &mut [u8;64]) -> (Self, Result<(),getrandom::Error>);\n}\n// Finite tape consumption is explicit, also on OS error with partial writes.\npub struct Tape { pub replies: Vec<([u8;64], Result<(),getrandom::Error>)>, pub used: usize }\nimpl Draw64 for Tape {\n    fn fill(mut self, bytes: &mut [u8;64]) -> (Self, Result<(),getrandom::Error>) {\n        assert!(self.used < self.replies.len()); // tape exhaustion is outside admitted executions\n        let (block, result) = self.replies[self.used];\n        self.used += 1;\n        *bytes = block;\n        (self, result)\n    }\n}\npub fn owner(nonce: [u8;32], tape: Tape) -> (Tape, Result<StateOnlyAttemptSecrets,StateOnlyAttemptEntropyError>) {\n    StateOnlyAttemptSecrets::generate_with(nonce, tape)\n}\n#[inline(always)]\nfn entropy_nonzero32(bytes:&[u8;32])->bool {\n    let mut combined=0u8;let mut i=0;\n    while i<32 {combined|=bytes[i];i+=1;}\n    combined!=0\n}\n\nimpl StateOnlyAttemptSecrets {\n    pub fn generate_with<P: Draw64>(\n        mask_nonce: [u8; 32],\n        mut provider: P,\n    ) -> (P, Result<Self, StateOnlyAttemptEntropyError>) {\n        let limit=ENTROPY_RETRY_LIMIT;\n\n        if !entropy_nonzero32(&mask_nonce) {\n            return (provider, Err(StateOnlyAttemptEntropyError::RepeatedZeroBlock));\n        }\n        let mut retry=0;\n        while retry<limit {\n            let mut bytes = Zeroizing::new([0u8; 64]);\n            let (after, result) = provider.fill(&mut bytes);\n            provider = after;\n            if let Err(e) = result { return (provider, Err(StateOnlyAttemptEntropyError::Os(e))); }\n\n            let mut field_mask_entropy = Zeroizing::new([0u8; 32]);\n            let mut leaf_salt_seed = Zeroizing::new([0u8; 32]);\n            field_mask_entropy.copy_from_slice(&bytes[..32]);\n            leaf_salt_seed.copy_from_slice(&bytes[32..]);\n            if entropy_nonzero32(&field_mask_entropy) && entropy_nonzero32(&leaf_salt_seed) {\n                return (provider, Ok(Self {\n                    mask_nonce,\n                    field_mask_entropy,\n                    leaf_salt_seed,\n                }));\n            }\n            retry+=1;\n        }\n        (provider, Err(StateOnlyAttemptEntropyError::RepeatedZeroBlock))\n    }\n\n}\n\nimpl From<getrandom::Error> for StateOnlyAttemptEntropyError {\n    fn from(value: getrandom::Error) -> Self { Self::Os(value) }\n}\n#[derive(Debug,Clone,Copy,PartialEq,Eq)]\npub enum Error { Parse,Semantic,Transcript,Relation,Merkle,Query,Checkpoint,Allocation,\n    Rejected,AttemptsExhausted,Entropy }\npub struct RetriedProof { pub proof:Vec<u8>, pub audit:u64, pub attempts:usize }\npub const ATTEMPT_CAP:usize=8;\n// The actual body and durable store remain a local interface, not a refinement premise.\npub fn selected_callback<N: FnMut(usize)->[u8;32]>(\n    tape:Tape, mut proof_account:N, k:usize,\n)->(Tape,N,Result<StateOnlyAttemptSecrets,Error>) {\n    let nonce=proof_account(k);\n    let (tape,status)=StateOnlyAttemptSecrets::generate_with(nonce,tape);\n    (tape,proof_account,status.map_err(|_|Error::Entropy))\n}\npub fn retry_attempt<N,L,B>(tape:Tape, proof_account:N, mut nonce_store:L, mut body:B,k:usize)\n ->(Tape,N,L,B,Result<RetriedProof,Error>)\n where N:FnMut(usize)->[u8;32],\n B:FnMut(StateOnlyAttemptSecrets,&mut L)->Result<(Vec<u8>,u64),Error> {\n    if k>=ATTEMPT_CAP { return (tape,proof_account,nonce_store,body,Err(Error::AttemptsExhausted)); }\n    let (tape,proof_account,status)=selected_callback(tape,proof_account,k);\n    let attempt=match status {Ok(a)=>a,Err(e)=>return (tape,proof_account,nonce_store,body,Err(e))};\n    match body(attempt,&mut nonce_store) {\n        Ok((proof,audit))=>(tape,proof_account,nonce_store,body,Ok(RetriedProof{proof,audit,attempts:k+1})),\n        Err(Error::Rejected)=>retry_attempt(tape,proof_account,nonce_store,body,k+1),\n        Err(e)=>(tape,proof_account,nonce_store,body,Err(e)),\n    }\n}\npub fn prove_masked_retrying_with<N,L,B>(is_s2:bool,tape:Tape,proof_account:N,nonce_store:L,body:B)\n ->(Tape,N,L,B,Result<RetriedProof,Error>)\n where N:FnMut(usize)->[u8;32],\n B:FnMut(StateOnlyAttemptSecrets,&mut L)->Result<(Vec<u8>,u64),Error> {\n    if !is_s2 { return (tape,proof_account,nonce_store,body,Err(Error::Semantic)); }\n    retry_attempt(tape,proof_account,nonce_store,body,0)\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/ops/function.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":6,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":7,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/zeroize-1.9.1/src/lib.rs"},"crate_name":"zeroize","contents":null},{"id":10,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/getrandom-0.3.4/src/error.rs"},"crate_name":"getrandom","contents":null},{"id":11,"name":{"Local":"/cargo/registry/src/index.crates.io-1949cf8c6b5b557f/getrandom-0.3.4/src/lib.rs"},"crate_name":"getrandom","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/default.rs"},"crate_name":"core","contents":null},{"id":13,"name":{"Local":"/rustc/library/core/src/num/nonzero.rs"},"crate_name":"core","contents":null},{"id":14,"name":{"Loc