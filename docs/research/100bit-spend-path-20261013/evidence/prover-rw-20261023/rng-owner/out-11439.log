            Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.cont (after, retry1))
      else do
        let retry1 ← retry + 1#usize
        Aeneas.Std.Result.ok (Aeneas.Std.ControlFlow.cont (after, retry1))
  | Aeneas.Std.core.result.Result.Err e =>
    Aeneas.Std.Result.ok
      (Aeneas.Std.ControlFlow.done
        (after, Aeneas.Std.core.result.Result.Err (ProverRwRng.StateOnlyAttemptEntropyError.Os e)))
theorem R1Z.ProverRwRngOwnerCertificate.universal_cap16 : ∀ [inst : ProverRwRng.ErasureFns]
  (nonce : Aeneas.Std.Array Aeneas.Std.U8 32#usize) (p : ProverRwRng.Tape),
  ProverRwRng.old_owner nonce p = ProverRwRng.owner nonce p ∧
    ∀ (after : ProverRwRng.Tape)
      (status :
        Aeneas.Std.core.result.Result ProverRwRng.StateOnlyAttemptSecrets ProverRwRng.StateOnlyAttemptEntropyError),
      ProverRwRng.owner nonce p = Aeneas.Std.Result.ok (after, status) →
        ∃ states,
          R1Z.ProverRwRngOwnerEvents.OwnerReplay (R1Z.ProverRwRngOwnerEvents.oldBody nonce) Prod.swap nonce p states
              (after, status) ∧
            R1Z.ProverRwRngOwnerEvents.OwnerReplay (R1Z.ProverRwRngOwnerEvents.newBody nonce) id nonce p states
                (after, status) ∧
              after.replies = p.replies ∧
                ↑after.used = ↑p.used + R1Z.ProverRwRngOwnerInventory.drawCount states ∧
                  R1Z.ProverRwRngOwnerInventory.drawCount states ≤ 16 ∧
                    R1Z.ProverRwRngOwnerInventory.events states =
                        List.map (fun index => (Aeneas.Std.Array.repeat 64#usize 0#u8, index, (↑p.replies)[index]?))
                          (List.range' (↑p.used) (R1Z.ProverRwRngOwnerInventory.drawCount states)) ∧
                      (∀ event ∈ R1Z.ProverRwRngOwnerInventory.events states, event.2.2.isSome = true) ∧
                        List.drop ↑after.used ↑after.replies =
                          List.drop (↑p.used + R1Z.ProverRwRngOwnerInventory.drawCount states) ↑p.replies :=
fun [ProverRwRng.ErasureFns] nonce p =>
  let ⟨same, paths⟩ := R1Z.ProverRwRngOwnerEvents.cap16_same_event nonce p
  ⟨same, fun after status run =>
    let ⟨states, h✝⟩ := paths after status run
    let ⟨oldPath, newPath⟩ := h✝
    Exists.intro states
      ⟨oldPath,
        ⟨newPath,
          Or.casesOn newPath
            (fun rejected =>
              let ⟨scan, right✝⟩ := rejected
              let ⟨empty, final⟩ := right✝
              let ⟨⟩ :=
                (p, Aeneas.Std.core.result.Result.Err ProverRwRng.StateOnlyAttemptEntropyError.RepeatedZeroBlock)
              final)
            fun entered =>
            let ⟨scan, right✝¹⟩ := entered
            let ⟨raw, h✝¹⟩ := right✝¹
            let ⟨replay, final⟩ := h✝¹
            id
              (fun final =>
                Eq.ndrec (motive := fun raw =>
                  R1Z.ProverRwRngOwnerEvents.Replay (R1Z.ProverRwRngOwnerEvents.newBody nonce) (p, 0#usize) states raw →
                    after.replies = p.replies ∧
                      ↑after.used = ↑p.used + R1Z.ProverRwRngOwnerInventory.drawCount states ∧
                        R1Z.ProverRwRngOwnerInventory.drawCount states ≤ 16 ∧
                          R1Z.ProverRwRngOwnerInventory.events states =
                              List.map
                                (fun index => (Aeneas.Std.Array.repeat 64#usize 0#u8, index, (↑p.replies)[index]?))
                                (List.range' (↑p.used) (R1Z.ProverRwRngOwnerInventory.drawCount states)) ∧
                            (∀ event ∈ R1Z.ProverRwRngOwnerInventory.events states, event.2.2.isSome = true) ∧
                              List.drop ↑after.used ↑after.replies =
                                List.drop (↑p.used + R1Z.ProverRwRngOwnerInventory.drawCount states) ↑p.replies)
                  (fun replay =>
                    let ⟨replies, right✝²⟩ := R1Z.ProverRwRngOwnerInventory.replay_inventory nonce replay
                    let ⟨cursor, bounded⟩ := right✝²
                    have cap := LE.le.trans bounded (Nat.sub_le 16 ↑(p, 0#usize).2);
                    ⟨replies,
                      ⟨cursor,
                        ⟨cap,
                          ⟨R1Z.ProverRwRngOwnerInventory.replay_events nonce replay,
                            ⟨R1Z.ProverRwRngOwnerInventory.replay_available nonce replay,
                              Eq.mpr
                                (id
                                  (congrArg
                                    (fun _a =>
                                      List.drop ↑after.used ↑_a =
                                        List.drop (↑p.used + R1Z.ProverRwRngOwnerInventory.drawCount states) ↑p.replies)
                                    replies))
                                (Eq.mpr
                                  (id
                                    (congrArg
                                      (fun _a =>
                                        List.drop _a ↑(p, 0#usize).1.replies =
                                          List.drop (↑p.used + R1Z.ProverRwRngOwnerInventory.drawCount states)
                                            ↑p.replies)
                                      cursor))
                                  (Eq.refl
                                    (List.drop (↑(p, 0#usize).1.used + R1Z.ProverRwRngOwnerInventory.drawCount states)
                                      ↑(p, 0#usize).1.replies)))⟩⟩⟩⟩⟩)
                  (Eq.symm final) replay)
              final⟩⟩⟩
