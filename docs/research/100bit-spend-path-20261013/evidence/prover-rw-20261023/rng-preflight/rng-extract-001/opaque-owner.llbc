{"charon_version":"0.1.223","translated":{"crate_name":"prover_rw_rng_preflight","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::owner"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":["crate","zeroize::Zeroizing"],"opaque":["crate"],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-prover-rw-20261023/src/tools/prover-rw-20261023/rng-preflight/ProverRwRng.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"lib.rs"},"crate_name":"prover_rw_rng_preflight","contents":"// Source-derived extraction prototype; not a native provider installation.\nuse zeroize::Zeroizing;\nconst ENTROPY_RETRY_LIMIT: usize = 16;\n#[derive(Debug, PartialEq, Eq)]\npub enum StateOnlyAttemptEntropyError { Os(u8), RepeatedZeroBlock }\npub struct StateOnlyAttemptSecrets {\n    pub mask_nonce: [u8;32],\n    pub field_mask_entropy: Zeroizing<[u8;32]>,\n    pub leaf_salt_seed: Zeroizing<[u8;32]>,\n}\npub trait Draw64: Sized {\n    fn fill(self, bytes: &mut [u8;64]) -> (Self, Result<(),u8>);\n}\n// Finite tape consumption is explicit, also on OS error with partial writes.\npub struct Tape { pub replies: Vec<([u8;64], Result<(),u8>)>, pub used: usize }\nimpl Draw64 for Tape {\n    fn fill(mut self, bytes: &mut [u8;64]) -> (Self, Result<(),u8>) {\n        assert!(self.used < self.replies.len()); // tape exhaustion is outside admitted executions\n        let (block, result) = self.replies[self.used];\n        self.used += 1;\n        *bytes = block;\n        (self, result)\n    }\n}\npub fn owner(nonce: [u8;32], tape: Tape) -> (Tape, Result<StateOnlyAttemptSecrets,StateOnlyAttemptEntropyError>) {\n    StateOnlyAttemptSecrets::generate_with(nonce, tape)\n}\n#[inline(always)]\nfn entropy_nonzero32(bytes:&[u8;32])->bool {\n    let mut combined=0u8;let mut i=0;\n    while i<32 {combined|=bytes[i];i+=1;}\n    combined!=0\n}\n\nimpl StateOnlyAttemptSecrets {\n    pub fn generate_with<P: Draw64>(\n        mask_nonce: [u8; 32],\n        mut provider: P,\n    ) -> (P, Result<Self, StateOnlyAttemptEntropyError>) {\n        let limit=ENTROPY_RETRY_LIMIT;\n\n        if !entropy_nonzero32(&mask_nonce) {\n            return (provider, Err(StateOnlyAttemptEntropyError::RepeatedZeroBlock));\n        }\n        let mut retry=0;\n        while retry<limit {\n            let mut bytes = Zeroizing::new([0u8; 64]);\n            let (after, result) = provider.fill(&mut bytes);\n            provider = after;\n            if let Err(e) = result { return (provider, Err(StateOnlyAttemptEntropyError::Os(e))); }\n\n            let mut field_mask_entropy = Zeroizing::new([0u8; 32]);\n            let mut leaf_salt_seed = Zeroizing::new([0u8; 32]);\n            field_mask_entropy.copy_from_slice(&bytes[..32]);\n            leaf_salt_seed.copy_from_slice(&bytes[32..]);\n            if entropy_nonzero32(&field_mask_entropy) && entropy_nonzero32(&leaf_salt_seed) {\n                return (provider, Ok(Self {\n                    mask_nonce,\n                    field_mask_entropy,\n                    leaf_salt_seed,\n                }));\n            }\n            retry+=1;\n        }\n        (provider, Err(StateOnlyAttemptEntropyError::RepeatedZeroBlock))\n    }\n\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["prover_rw_rng_preflight",0]},{"Ident":["owner",0]}]},{"key":{"Type":0},"value":[{"Ident":["prover_rw_rng_preflight",0]},{"Ident":["Tape",0]}]},{"key":{"Type":1},"value":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}]},{"key":{"Type":2},"value":[{"Ident":["prover_rw_rng_preflight",0]},{"Ident":["StateOnlyAttemptSecrets",0]}]},{"key":{"Type":3},"value":[{"Ident":["prover_rw_rng_preflight",0]},{"Ident":["StateOnlyAttemptEntropyError",0]}]}],"assoc_item_names":[],"short_names":[{"key":{"Fun":0},"value":[{"Ident":["owner",0]}]},{"key":{"Type":1},"value":[{"Ident":["Result",0]}]},{"key":{"Type":3},"value":[{"Ident":["StateOnlyAttemptEntropyError",0]}]},{"key":{"Type":2},"value":[{"Ident":["StateOnlyAttemptSecrets",0]}]},{"key":{"Type":0},"value":[{"Ident":["Tape",0]}]}],"type_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["prover_rw_rng_preflight",0]},{"Ident":["Tape",0]}],"span":{"data":{"file_id":0,"beg":{"line":15,"col":0},"end":{"line":15,"col":79}},"generated_from_span":null},"source_text":"pub struct Tape { pub replies: Vec<([u8;64], Result<(),u8>)>, pub used: usize }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Opaque","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux