; }\npub fn real_drop(counter: &mut u32) {\n    let _guard = Guard { counter: Some(counter) };\n}\npub fn counter_probe() -> u32 {\n    let mut counter = 0;\n    real_drop(&mut counter);\n    counter\n}\n#[cfg(test)]\nmod tests {\n    #[test]\n    fn native_counter_zero_becomes_one() {\n        assert_eq!(super::counter_probe(), 1);\n    }\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["prover_rw_native_entropy_drop",0]},{"Ident":["increment",0]}]},{"key":{"Fun":1},"value":[{"Ident":["core",0]},{"Ident":["num",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"HashConsedValue":[284,{"Literal":{"UInt":"U32"}}]},"kind":"InherentImplBlock"}}},{"Ident":["wrapping_add",0]}]}],"assoc_item_names":[],"short_names":[{"key":{"Fun":0},"value":[{"Ident":["increment",0]}]},{"key":{"Fun":1},"value":[{"Ident":["wrapping_add",0]}]}],"type_decls":[],"fun_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["prover_rw_native_entropy_drop",0]},{"Ident":["increment",0]}],"span":{"data":{"file_id":0,"beg":{"line":10,"col":0},"end":{"line":10,"col":78}},"generated_from_span":null},"source_text":"pub fn increment(counter: &mut u32) { *counter = (*counter).wrapping_add(1); }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":