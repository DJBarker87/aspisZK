ocComment":""},{"DocComment":" let borrow = x.borrow();"},{"DocComment":" println!(\"{}\", *borrow);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Integers and other types implementing [`Copy`] are unaffected by `drop`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dropping_copy_types)]"},{"DocComment":" #[derive(Copy, Clone)]"},{"DocComment":" struct Foo(u8);"},{"DocComment":""},{"DocComment":" let x = 1;"},{"DocComment":" let y = Foo(2);"},{"DocComment":" drop(x); // a copy of `x` is moved and dropped"},{"DocComment":" drop(y); // a copy of `y` is moved and dropped"},{"DocComment":""},{"DocComment":" println!(\"x: {}, y: {}\", x, y.0); // still available"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`RefCell`]: crate::cell::RefCell"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"mem_drop"},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":1,"beg":{"line":1002,"col":7},"end":{"line":1002,"col":23}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"HashConsedValue":[1138,{"TypeVar":{"Free":0}}]}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":1138}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":1138}],"output":{"Deduplicated":293}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":3,"item_meta":{"name":[{"Ident":["prover_rw_native_drop_fixtures",0]},{"Ident":["captured",0]},{"Impl":{"Trait":0}},