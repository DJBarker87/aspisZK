{"charon_version":"0.1.223","translated":{"crate_name":"prover_rw_native_drop_fixtures","options":{"ullbc":false,"precise_drops":true,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::escape","crate::captured"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/home/dombarker/project-offloads/codex-cx-prover-rw-20261023/native-drop/ProverRwNativeDropescape.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"lib.rs"},"crate_name":"prover_rw_native_drop_fixtures","contents":"//! Native reference cases. Backend support is not inferred from these tests.\npub fn escape(counter: &mut u32) -> &mut u32 { counter }\npub struct Event<'a> { pub log: &'a mut u32, pub digit: u32 }\nimpl Drop for Event<'_> {\n    fn drop(&mut self) { *self.log = (*self.log).wrapping_mul(10).wrapping_add(self.digit); }\n}\npub fn captured(log: &mut u32) {\n    let event = Event { log, digit: 7 };\n    let capture = move || { let _keep = &event; };\n    drop(capture);\n}\n#[cfg(test)]\nmod tests {\n    use super::*;\n    #[test]\n    fn capture_releases_owned_event() {\n        let mut log=0; captured(&mut log); assert_eq!(log,7);\n    }\n    struct Pair<'a> { first: Event<'a>, second: Event<'a> }\n    #[test]\n    fn recursive_fields_and_move_state() {\n        let (mut a,mut b)=(0,0);\n        { let pair=Pair { first: Event {log:&mut a,digit:1}, second: Event {log:&mut b,digit:2} };\n        let Pair { first, second }=pair;\n        drop(second); drop(first); } assert_eq!((a,b),(1,2));\n    }\n    #[test]\n    fn conditional_initialized_only() {\n        for enter in [false,true] {\n            let mut n=0;\n            if enter { let _event=Event {log:&mut n,digit:3}; }\n            assert_eq!(n,if enter {3} else {0});\n        }\n    }\n    #[test]\n    fn unwind_writes_back_before_catch() {\n        let mut n=0;\n        let r=std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {\n            let _event=Event {log:&mut n,digit:9}; panic!(\"fixture panic\");\n        }));\n        assert!(r.is_err()); assert_eq!(n,9);\n    }\n    #[test]\n    fn field_order_is_observable() {\n        use std::cell::Cell;\n        struct Ordered<'a>(&'a Cell<u32>,u32);\n        impl Drop for Ordered<'_> { fn drop(&mut self) {self.0.set(self.0.get()*10+self.1);} }\n        struct Outer<'a> { first: Ordered<'a>, second: Ordered<'a> }\n        let log=Cell::new(0);\n        { let _outer=Outer {first:Ordered(&log,1),second:Ordered(&log,2)}; }\n        assert_eq!(log.get(),12);\n    }\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/mem/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/ops/function.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ptr/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/drop.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/pin.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["prover_rw_native_drop_fixtures",0]},{"Ident":["escape",0]}]},{"key":{"Fun":1},"value":[{"Ident":["prover_rw_native_drop_fixtures",0]},{"Ident":["captured",0]}]},{"key":{"Type":0},"value":[{"Ident":["prover_rw_native_drop_fixtures",0]},{"Ident":["Event",0]}]},{"key":{"Type":1},"value":[{"Ident":["prover_rw_native_drop_fixtures",0]},{"Ident":["captured",0]},{"Ident":["closure",0]}]},{"key":{"TraitImpl":0},"value":[{"Ident":["prover_rw_native_drop_fixtures",0]},{"Ident":["captured",0]},{"Impl":{"Trait":0}}]},{"key":{"TraitImpl":1},"value":[{"Ident":["prover_rw_native_drop_fixtures",0]},{"Ident":["captured",0]},{"Impl":{"Trait":1}}]},{"key":{"TraitImpl":2},"value":[{"Ident":["prover_rw_native_drop_fixtures",0]},{"Ident":["captured",0]},{"Impl":{"Trait":2}}]},{"key":{"Fun":2},"value":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["drop",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Destruct",0]}]},{"key":{"TraitImpl":3},"value":[{"Ident":["prover_rw_native_drop_fixtures",0]},{"Ident":["captured",0]},{"Ident":["closure",0]},{"Impl":{"Trait":3}}]},{"key":{"TraitDecl":1},"value":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["function",0]},{"Ident":["FnOnce",0]}]},{"key":{"Fun":3},"value":[{"Ident":["prover_rw_native_drop_fixtures",0]},{"Ident":["captured",0]},{"Impl":{"Trait":0