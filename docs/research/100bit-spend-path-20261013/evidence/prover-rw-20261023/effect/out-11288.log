R1Z.ProverRwEffectOwner.pure_owner_eq [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns]
  (nonce : Aeneas.Std.Array Aeneas.Std.U8 32#usize) :
  R1Z.ProverRwEffectOwner.pureOwner nonce =
    ProverRwFull.aspis_prover.state_only_entropy.StateOnlyAttemptSecrets.generate_for_mask_nonce nonce
R1Z.ProverRwEffectOwner.owner_zero_then_one [ProverRwFull.ExternalTypes] [ProverRwFull.ExternalFuns]
  (ops : ProverRwFull.ExternalFuns) (rest : List (Aeneas.Std.Result R1Z.ProverRwEffectSource.Reply))
  (reads : List (Aeneas.Std.Slice Aeneas.Std.U8 × Aeneas.Std.Result R1Z.ProverRwEffectSource.Reply)) :
  have nonce := Aeneas.Std.Array.repeat 32#usize 1#u8;
  have zero := R1Z.ProverRwEntropyObstruction.zeroInput;
  have one := R1Z.ProverRwEntropyObstruction.oneOutput;
  have r0 := Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (), zero);
  have r1 := Aeneas.Std.Result.ok (Aeneas.Std.core.result.Result.Ok (), one);
  R1Z.ProverRwEffectOwner.worldOwner nonce { tape := r0 :: r1 :: rest, reads := reads } =
    {
      boundary :=
        R1Z.ProverRwEffectTape.Boundary.returned
          (Aeneas.Std.Result.ok
            (Aeneas.Std.core.result.Result.Ok
              { mask_nonce := nonce, field_mask_entropy := Aeneas.Std.Array.repeat 32#usize 1#u8,
                leaf_salt_seed := Aeneas.Std.Array.repeat 32#usize 1#u8 })),
      world := { tape := rest, reads := reads ++ [(zero, r0), (zero, r1)] } }
R1Z.ProverRwEffectRetry.client_retry [ProverRwFull.ExternalTypes] (ops : ProverRwFull.ExternalFuns) {C : Type}
  (account : R1Z.ProverRwEffectCallback.Account C) (pub : R1Z.ProverRwRetryModel.Pub)
  (compiled : R1Z.ProverRwRetryModel.Compiled) (hash : R1Z.ProverRwRetryModel.Hash)
  (store : R1Z.ProverRwRetryModel.Store) (state : C) :
  R1Z.ProverCommitSemanticTransport26.mapR R1Z.ProverRwRetryModel.sourceOutput
      (ProverRwFull.RealR1_client.prove_for_proof_accounts account pub compiled hash store state) =
    R1Z.ProverCommitSemanticTransport26.mapR R1Z.ProverRwRetryModel.drop
      (R1Z.ProverCommitRetry34.eight
        (R1Z.ProverRwRetryModel.attempt (R1Z.ProverRwEffectRetry.entropy account) pub compiled
          ProverRwFull.transport.Variant.S2 hash)
        (state, store))
