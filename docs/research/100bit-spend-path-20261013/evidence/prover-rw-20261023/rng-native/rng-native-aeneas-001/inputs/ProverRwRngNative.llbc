t":["get_unchecked",0]}]},{"key":{"Fun":51},"value":[{"Impl":{"Trait":33}},{"Ident":["get_unchecked_mut",0]}]},{"key":{"Fun":52},"value":[{"Impl":{"Trait":33}},{"Ident":["index",0]}]},{"key":{"Fun":53},"value":[{"Impl":{"Trait":33}},{"Ident":["index_mut",0]}]},{"key":{"Global":15},"value":[{"Impl":{"Trait":34}},{"Ident":["{vtable}",0]}]},{"key":{"Global":16},"value":[{"Impl":{"Trait":35}},{"Ident":["{vtable}",0]}]},{"key":{"Type":26},"value":[{"Ident":["Pin",0]}]},{"key":{"TraitDecl":5},"value":[{"Ident":["Copy",0]}]},{"key":{"Type":14},"value":[{"Ident":["closure",0]}]},{"key":{"TraitDecl":14},"value":[{"Ident":["Deref",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["FnMut",0]}]},{"key":{"Fun":55},"value":[{"Ident":["pin_drop",0]}]},{"key":{"Type":1},"value":[{"Ident":["Result",0]}]},{"key":{"Type":5},"value":[{"Ident":["Tape",0]}]},{"key":{"TraitDecl":3},"value":[{"Ident":["Zeroize",0]}]},{"key":{"Fun":9},"value":[{"Ident":["map_err",0]}]},{"key":{"Fun":23},"value":[{"Ident":["copy_from_slice",0]}]},{"key":{"TraitDecl":17},"value":[{"Ident":["Drop",0]}]},{"key":{"TraitDecl":9},"value":[{"Ident":["Clone",0]}]},{"key":{"TraitDecl":13},"value":[{"Ident":["DerefMut",0]}]},{"key":{"TraitDecl":2},"value":[{"Ident":["Destruct",0]}]},{"key":{"Type":2},"value":[{"Ident":["Vec",0]}]},{"key":{"TraitDecl":6},"value":[{"Ident":["Default",0]}]},{"key":{"Fun":1},"value":[{"Ident":["retry_attempt",0]}]},{"key":{"TraitDecl":8},"value":[{"Ident":["Draw64",0]}]},{"key":{"Type":16},"value":[{"Ident":["RangeTo",0]}]},{"key":{"Type":15},"value":[{"Ident":["NonZeroI32Inner",0]}]},{"key":{"Fun":8},"value":[{"Ident":["generate_with",0]}]},{"key":{"TraitDecl":1},"value":[{"Ident":["FnOnce",0]}]},{"key":{"Type":13},"value":[{"Ident":["StateOnlyAttemptEntropyError",0]}]},{"key":{"Fun":0},"value":[{"Ident":["prove_masked_retrying_with",0]}]},{"key":{"Fun":2},"value":[{"Ident":["selected_callback",0]}]},{"key":{"Fun":18},"value":[{"Ident":["new",0]}]},{"key":{"TraitDecl":7},"value":[{"Ident":["ZeroablePrimitive",0]}]},{"key":{"Type":6},"value":[{"Ident":["RetriedProof",0]}]},{"key":{"TraitDecl":12},"value":[{"Ident":["SliceIndex",0]}]},{"key":{"Global":0},"value":[{"Ident":["ATTEMPT_CAP",0]}]},{"key":{"Fun":7},"value":[{"Ident":["ATTEMPT_CAP",0]}]},{"key":{"Fun":26},"value":[{"Ident":["clone_from",0]}]},{"key":{"Type":17},"value":[{"Ident":["RangeFrom",0]}]},{"key":{"Global":3},"value":[{"Ident":["ENTROPY_RETRY_LIMIT",0]}]},{"key":{"Fun":28},"value":[{"Ident":["ENTROPY_RETRY_LIMIT",0]}]},{"key":{"TraitDecl":11},"value":[{"Ident":["Index",0]}]},{"key":{"Fun":43},"value":[{"Ident":["len",0]}]},{"key":{"Type":9},"value":[{"Ident":["Zeroizing",0]}]},{"key":{"Type":12},"value":[{"Ident":["NonZero",0]}]},{"key":{"Type":0},"value":[{"Ident":["StateOnlyAttemptSecrets",0]}]},{"key":{"TraitDecl":15},"value":[{"Ident":["From",0]}]},{"key":{"TraitDecl":4},"value":[{"Ident":["DefaultIsZeroes",0]}]},{"key":{"Type":21},"value":[{"Ident":["Option",0]}]},{"key":{"Type":3},"value":[{"Ident":["Global",0]}]},{"key":{"Fun":17},"value":[{"Ident":["entropy_nonzero32",0]}]}],"type_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["prover_rw_rng_caller",0]},{"Ident":["StateOnlyAttemptSecrets",0]}],"span":{"data":{"file_id":0,"beg":{"line":6,"col":0},"end":{"line":10,"col":1}},"generated_from_span":null},"source_text":"pub struct StateOnlyAttemptSecrets {\n    pub mask_nonce: [u8;32],\n    pub field_mask_entropy: Zeroizing<[u8;32]>,\n    pub leaf_salt_seed: Zeroizing<[u8;32]>,\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":0,"beg":{"line":7,"col":4},"end":{"line":7,"col":27}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"mask_non