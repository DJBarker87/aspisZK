adata":"None"},{"def_id":10,"item_meta":{"name":[{"Ident":["getrandom",0]},{"Ident":["error",0]},{"Ident":["Error",0]}],"span":{"data":{"file_id":10,"beg":{"line":36,"col":0},"end":{"line":36,"col":16}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A small and `no_std` compatible error type"},{"DocComment":""},{"DocComment":" The [`Error::raw_os_error()`] will indicate if the error is from the OS, and"},{"DocComment":" if so, which error code the OS gave the application. If such an error is"},{"DocComment":" encountered, please consult with your system documentation."},{"DocComment":""},{"DocComment":" *If this crate's `\"std\"` Cargo feature is enabled*, then:"},{"DocComment":" - [`getrandom::Error`][Error] implements"},{"DocComment":"   [`std::error::Error`](https://doc.rust-lang.org/std/error/trait.Error.html)"},{"DocComment":" - [`std::io::Error`](https://doc.rust-lang.org/std/io/struct.Error.html) implements"},{"DocComment":"   [`From<getrandom::Error>`](https://doc.rust-lang.org/std/convert/trait.From.html)."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":10,"beg":{"line":36,"col":17},"end":{"line":36,"col":34}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":null,"ty":{"HashConsedValue":[3135,{"Adt":{"id":{"Adt":12},"generics":{"regions":[],"types":[{"HashConsedValue":[946,{"Literal":{"Int":"I32"}}]},{"HashConsedValue":[1185,{"Adt":{"id":{"Adt":15},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}],"const_generics":[],"trait_refs":[]}}}]}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":4,"align":4,"discriminator":{"Known":0},"uninhabited":false,"variant_layo