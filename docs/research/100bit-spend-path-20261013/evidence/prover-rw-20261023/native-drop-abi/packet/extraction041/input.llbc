unter) };\n    update(&mut owner);\n}\npub fn counter_probe() -> u32 { let mut n = 0; writeback(&mut n); n }\n#[cfg(test)] mod tests {\n    use super::*;\n    #[test] fn reference_writeback() {\n        assert_eq!(counter_probe(), 1);\n        let mut n = u32::MAX; writeback(&mut n); assert_eq!(n, 0);\n        update(&mut Owner {slot: None});\n    }\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Fun":0},"value":[{"Ident":["prover_rw_native_drop_abi_printer",0]},{"Ident":["counter_probe",0]}]},{"key":{"Fun":1},"value":[{"Ident":["prover_rw_native_drop_abi_printer",0]},{"Ident":["writeback",0]}]},{"key":{"Type":0},"value":[{"Ident":["prover_rw_native_drop_abi_printer",0]},{"Ident":["Owner",0]}]},{"key":{"Type":1},"value":[{"Ident":["core",0]},{"Ident":["option",0]},{"Ident":["Option",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Destruct",0]}]},{"key":{"Fun":2},"value":[{"Ident":["prover_rw_native_drop_abi_printer",0]},{"Ident":["update",0]}]},{"key":{"Fun":3},"value":[{"Ident":["prover_rw_native_drop_abi_printer",0]},{"Ident":["increment",0]}]},{"key":{"Fun":4},"value":[{"Ident":["core",0]},{"Ident":["num",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"HashConsedValue":[237,{"Literal":{"UInt":"U32"}}]},"kind":"InherentImplBlock"}}},{"Ident":["wrapping_add",0]}]}],"assoc_item_names":[{"types":[],"methods":["drop_glue"],"co