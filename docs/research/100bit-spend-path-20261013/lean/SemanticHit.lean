import R0P.MaskD2Glue
import R0P.MaskNoHit

/-! Finite-list characterization of the masked semantic hit predicate.
This is a deterministic list/prefix bridge; it assigns no event probability. -/
-- Reuse the congruence declarations generated by MaskD2Glue, so this bridge
-- can be imported together with the literal semantic classifier.
set_option autoImplicit false

namespace AspisR1.SemanticHit

open R0P R0P.SemSource R0P.Mask R0C.SemStatement
open AspisPool.AlgorithmicCircleDecoderV7

variable {E : Type} [Field E] [Fintype E] [DecidableEq E]
  [Algebra (ZMod AspisCircleGroupOrder.P) E]

/-- `hitFrom` is exactly the disjunction of `roundBad` over the literal list,
with each bad event evaluated at its preceding prefix. -/
theorem hitFrom_iff_indexed_roundBad
    {X W : Type} {Sfield : Fin 29 → Subfield E}
    (s : SourceData (K := E) (E := E) X (SemMsgZ E) W Sfield)
    (x : X) (prev : List (MsgZ E × ChalZ E))
    (rs : List (MsgZ E × ChalZ E)) :
    hitFrom s x prev rs ↔
      ∃ i : Fin rs.length,
        roundBad s ⟨x, prev ++ rs.take i.val⟩
          (rs[i.val]'i.isLt).1 (rs[i.val]'i.isLt).2 := by
  induction rs generalizing prev with
  | nil => simp [hitFrom]
  | cons q rs ih =>
      rcases q with ⟨m,c⟩
      simp only [hitFrom]
      constructor
      · rintro (hhead | htail)
        · refine ⟨⟨0, by simp⟩, ?_⟩
          simpa using hhead
        · obtain ⟨i, hi⟩ := (ih (prev ++ [(m,c)])).mp htail
          refine ⟨i.succ, ?_⟩
          simpa only [Fin.val_succ, List.take_succ_cons, List.append_assoc, List.singleton_append,
            List.getElem_cons_succ] using hi
      · rintro ⟨i, hi⟩
        exact roundBadZ_hitFrom s x ((m,c) :: rs) prev i.val i.isLt hi

/-- On a parsed semantic prefix shorter than the 25 semantic rows,
`roundBad` at the current semantic slot is exactly `semanticBadZ`. -/
private theorem roundBad_iff_semanticBadZ
    {Sfield : Fin 29 → Subfield E} {F : Subfield E}
    (x : TypedContext E Sfield) (fallback1 : AspisR0.ChordGeometry.Point E)
    (maskClaims : (Fin 29 → E) → (Fin 29 → E) → (Fin 10 → E) → E)
    (B : PackBasis F) (rs : List (MsgZ E × ChalZ E)) (cs : List E)
    (i : Fin rs.length) (sm : SemMsgZ E)
    (hslot : rs[i.val]'i.isLt =
      (.semantic sm, .semantic (cs.getD i.val 0)))
    (hlen : rs.length ≤ 25) :
    roundBad (sourceDataWithFallbackZ fallback1 maskClaims B)
        ⟨x, rs.take i.val⟩ (rs[i.val]'i.isLt).1 (rs[i.val]'i.isLt).2 ↔
      semanticBadZ maskClaims B ⟨x, rs.take i.val⟩ sm (cs.getD i.val 0) := by
  have htake : (rs.take i.val).length = i.val := by
    simp only [List.length_take, Nat.min_eq_left i.isLt.le]
  have hlt : i.val < 25 := by omega
  rw [hslot]
  simp [roundBad, sourceDataWithFallbackZ, FS.Prefix.round, hlt]

/-- For parsed semantic lists of at most 25 rounds, excluding every current
`semanticBadZ` event is equivalent to absence of a `hitFrom` event. -/
theorem no_hitFrom_iff_all_semanticBadZ_excluded
    {Sfield : Fin 29 → Subfield E} {F : Subfield E}
    (x : TypedContext E Sfield) (fallback1 : AspisR0.ChordGeometry.Point E)
    (maskClaims : (Fin 29 → E) → (Fin 29 → E) → (Fin 10 → E) → E)
    (B : PackBasis F) (rs : List (MsgZ E × ChalZ E)) (cs : List E)
    (hparse : semChalsZ rs = some cs) (hlen : rs.length ≤ 25) :
    ¬ hitFrom (sourceDataWithFallbackZ fallback1 maskClaims B) x [] rs ↔
      ∀ i : Fin rs.length, ∀ sm,
        (rs[i.val]'i.isLt).1 = .semantic sm →
          ¬ semanticBadZ maskClaims B ⟨x, rs.take i.val⟩ sm (cs.getD i.val 0) := by
  constructor
  · intro hno i sm hmsg hbad
    obtain ⟨actual, hslot⟩ := semSlotZ rs cs hparse i
    have hactual : actual = sm := by
      rw [hslot] at hmsg
      exact R0C.SemStatement.Msg.semantic.inj hmsg
    subst sm
    have hround := (roundBad_iff_semanticBadZ x fallback1 maskClaims B rs cs i
      actual hslot hlen).2 hbad
    have hhit := (hitFrom_iff_indexed_roundBad
      (sourceDataWithFallbackZ fallback1 maskClaims B) x [] rs).2 ⟨i, hround⟩
    exact hno hhit
  · intro hgood hhit
    obtain ⟨i, hround⟩ := (hitFrom_iff_indexed_roundBad
      (sourceDataWithFallbackZ fallback1 maskClaims B) x [] rs).mp hhit
    obtain ⟨sm, hslot⟩ := semSlotZ rs cs hparse i
    have hbad := (roundBad_iff_semanticBadZ x fallback1 maskClaims B rs cs i
      sm hslot hlen).mp hround
    have hmsg : (rs[i.val]'i.isLt).1 = .semantic sm := by rw [hslot]
    exact hgood i sm hmsg hbad

#print axioms hitFrom_iff_indexed_roundBad
#print axioms no_hitFrom_iff_all_semanticBadZ_excluded

end AspisR1.SemanticHit
