import FSV8V7OracleMachineBridge

/-! S3 restricted inverse for projected forward verifier history. -/

set_option autoImplicit false
set_option Elab.async false
set_option maxHeartbeats 250000

namespace AspisV8Completion.FSV8S3VerifierHistorySection
open FSOracleExecution
open AspisK1.V7FsAokExperiment
open FSV8V7OracleMachineBridge

/-- The suffix generated by a forward verifier, not arbitrary prehistory. -/
def VerifierFC (r : QueryRecord) : Prop :=
  r.actor = .verifier ∧ (r.origin = .fresh ∨ r.origin = .cached)

def liftVerifier (e : Event Bytes Block) : QueryRecord :=
  { input := e.input, output := e.answer, actor := .verifier,
    origin := if e.fresh then .fresh else .cached }

@[simp] theorem project_liftVerifier (e : Event Bytes Block) :
    projectRecord (liftVerifier e) = e := by
  cases e with
  | mk input answer fresh =>
    cases fresh <;> rfl

theorem lift_project_of_verifierFC (r : QueryRecord) (h : VerifierFC r) :
    liftVerifier (projectRecord r) = r := by
  rcases r with ⟨input, output, actor, origin⟩
  change actor = .verifier ∧ (origin = .fresh ∨ origin = .cached) at h
  rcases h with ⟨ha, ho⟩
  subst actor
  rcases ho with hf | hc
  · subst origin; rfl
  · subst origin; rfl

theorem lift_map_project : ∀ (records : List QueryRecord),
    (∀ r ∈ records, VerifierFC r) →
    (records.map projectRecord).map liftVerifier = records := by
  intro records
  induction records with
  | nil => intro _; rfl
  | cons r rest ih =>
    intro good
    simp only [List.map_cons]
    rw [lift_project_of_verifierFC r (good r (by simp))]
    rw [ih (by intro x hx; exact good x (by simp [hx]))]

theorem project_injective_on_verifier_suffixes
    (left right : List QueryRecord)
    (leftGood : ∀ r ∈ left, VerifierFC r)
    (rightGood : ∀ r ∈ right, VerifierFC r)
    (same : left.map projectRecord = right.map projectRecord) : left = right := by
  have h := congrArg (List.map liftVerifier) same
  rw [lift_map_project left leftGood, lift_map_project right rightGood] at h
  exact h

/-- A retained mixed prehistory is never inverted. -/
theorem exact_suffixes_of_common_projected_history
    (prehistory left right : List QueryRecord)
    (leftGood : ∀ r ∈ left, VerifierFC r)
    (rightGood : ∀ r ∈ right, VerifierFC r)
    (same : (prehistory ++ left).map projectRecord =
      (prehistory ++ right).map projectRecord) : left = right := by
  simp only [List.map_append] at same
  exact project_injective_on_verifier_suffixes left right leftGood rightGood
    (List.append_cancel_left same)

theorem recover_actual_suffix
    (prehistory suffix : List QueryRecord)
    (good : ∀ r ∈ suffix, VerifierFC r) :
    prehistory ++ (((prehistory ++ suffix).map projectRecord).drop prehistory.length).map
        liftVerifier = prehistory ++ suffix := by
  rw [List.map_append,
    ← (@List.length_map _ _ prehistory projectRecord), List.drop_left]
  rw [lift_map_project suffix good]

#print axioms lift_project_of_verifierFC
#print axioms project_injective_on_verifier_suffixes
#print axioms exact_suffixes_of_common_projected_history
#print axioms recover_actual_suffix
end AspisV8Completion.FSV8S3VerifierHistorySection
