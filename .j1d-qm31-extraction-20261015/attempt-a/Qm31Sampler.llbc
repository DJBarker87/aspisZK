{"charon_version":"0.1.223","translated":{"crate_name":"aspis_r1_qm31_sampler_extract","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":"Built","rustc_args":[],"targets":[],"sysroot":"default","monomorphize":false,"monomorphize_mut":null,"start_from":["crate::sampler::qm31_sample"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"/Users/dominic/ZK/.worktrees/r1-j1-r12-auth-20261015/.j1d-qm31-extraction-20261015/attempt-a/Qm31Sampler.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"aarch64-apple-darwin","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"lib.rs"},"crate_name":"aspis_r1_qm31_sampler_extract","contents":"// Exact declaration-cut kit; no source-refinement theorem.\npub mod field {\n/// The Mersenne prime 2^31 - 1.\npub const P: u32 = 0x7fff_ffff;\n/// M31 base field element, canonical representation in [0, P).\n#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]\npub struct M31(pub u32);\n/// CM31 = M31[i] / (i^2 + 1). Element a + b*i.\n#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]\npub struct CM31 {\n    pub a: M31,\n    pub b: M31,\n}\nimpl CM31 {\n    #[inline(always)]\n    pub fn new(a: M31, b: M31) -> CM31 {\n        CM31 { a, b }\n    }\n}\n/// QM31 = CM31[u] / (u^2 - (2 + i)). Element c0 + c1*u. (stwo parameterization)\n#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]\npub struct QM31 {\n    pub c0: CM31,\n    pub c1: CM31,\n}\n}\npub mod sampler {\nuse crate::field::{CM31, M31, P, QM31};\n/// The low four base-P digits already represent rank modulo P^4.\n/// Dividends are below P * 2^32, so every division fits in u64.\npub fn qm31_sample(block: &[u8; 32]) -> QM31 {\n    let mut rank: [u32; 8] =\n        core::array::from_fn(|i| u32::from_le_bytes(block[4 * i..4 * i + 4].try_into().unwrap()));\n    let digits: [u32; 4] = core::array::from_fn(|_| {\n        let mut remainder = 0u64;\n        for limb in rank.iter_mut().rev() {\n            let dividend = (remainder << 32) | u64::from(*limb);\n            *limb = (dividend / u64::from(P)) as u32;\n            remainder = dividend % u64::from(P);\n        }\n        remainder as u32\n    });\n    QM31 {\n        c0: CM31::new(M31(digits[0]), M31(digits[1])),\n        c1: CM31::new(M31(digits[2]), M31(digits[3])),\n    }\n}\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/ops/function.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","cont