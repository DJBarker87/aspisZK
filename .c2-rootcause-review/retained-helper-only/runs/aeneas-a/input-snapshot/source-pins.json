  "boundaries": {
    "c1": "Unused trait c1 implementation is a typechecking stub and excluded from C2 claim.",
    "constructor": "Commitment::build actual entire body retained. Exact loops/errors/constructors, no source specialization.",
    "destruction": "PrivateSalts::Drop volatile erasure and implicit drops not modeled by this cut. No memory-erasure/custody theorem follows.",
    "encoder_signature": "Opaque encode<T:CodeField> boundary is represented by encode<T:Copy>; no CodeField instances/laws/results inferred. Only M31 and QM31 instantiations occur in build. Bind each actual encoder execution result explicitly.",
    "filled": "Allocation helper opaque; exact length/content requires primitive filled specification, separate from desired owned-word conclusion.",
    "packing_hash_tree": "Word::value, E::to_le_bytes, leaf hash and Tree::new are opaque. No packing/salt-path/collision or root claim.",
    "root": "Tree::root is a typechecking stub, explicit universal parameter; Commitment::root actual delegate retained.",
    "scope": "Caller functional state mutation/ownership first; coefficients/encode/word contents require actual build extraction, not this boundary."
  },
  "classification": "UNADOPTED_DIAGNOSTIC_RETAINED_LANES_HELPER: exact encoder/reserve/retention prefix relocated; no production helper/build/caller acceptance",
