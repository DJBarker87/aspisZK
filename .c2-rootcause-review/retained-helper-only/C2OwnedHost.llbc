l, *not* equivalent to"},{"DocComment":" `array.map(|x| g(f(x)))`, as the former calls `f` 4 times then `g` 4 times,"},{"DocComment":" whereas the latter interleaves the calls (`fgfgfgfg`)."},{"DocComment":""},{"DocComment":" A consequence of this is that it can have fairly-high stack usage, especially"},{"DocComment":" in debug mode or for long arrays.  The backend may be able to optimize it"},{"DocComment":" away, but especially for complicated mappings it might not be able to."},{"DocComment":""},{"DocComment":" If you're doing a one-step `map` and really want an array as the result,"},{"DocComment":" then absolutely use this method.  Its implementation uses a bunch of tricks"},{"DocComment":" to help the optimizer handle it well.  Particularly for simple arrays,"},{"DocComment":" like `[u8; 3]` or `[f32; 4]`, there's nothing to be concerned about."},{"DocComment":""},{"DocComment":" However, if you don't actually need an *array* of the results specifically,"},{"DocComment":" just to process them, then you likely want [`Iterator::map`] instead."},{"DocComment":""},{"DocComment":" For example, rather than doing an array-to-array map of all the elements"},{"DocComment":" in the array up-front and only iterating after that completes,"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # let my_array = [1, 2, 3];"},{"DocComment":" # let f = |x: i32| x + 1;"},{"DocComment":" for x in my_array.map(f) {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It's often better to use an iterator along the lines of"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # let my_array = [1, 2, 3];"},{"DocComment":" # let f = |x: i32| x + 1;"},{"DocComment":" for x in my_array.into_iter().map(f) {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" as that's more likely to avoid large temporaries."},{"DocComment":""},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = [1, 2, 3];"},{"DocComment":" let y = x.map(|v| v + 1);"},{"DocComment":" assert_eq!(y, [2, 3, 4]);"},{"DocComment":""},{"DocComment":" let x = [1, 2, 3];"},{"DocComment":" let mut temp = 0;"},{"DocComment":" let y = x.map(|v| { temp += 1; v * temp });"},{"DocComment":" assert_eq!(y, [1, 4, 9]);"},{"DocComment":""},{"DocComment":" let x = [\"Ferris\", \"Bueller's\", \"Day\", \"Off\"];"},{"DocComment":" let y = x.map(|v| v.len());"},{"DocComment":" assert_eq!(y, [6, 9, 3, 3]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T"},{"index":1,"name":"F"},{"index":2,"name":"U"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":433}}],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":16,"beg":{"line":594,"col":11},"end":{"line":594,"col":32}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":8087},{"HashConsedValue":[8136,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":8086}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":8104}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":16,"beg":{"line":594,"col":35},"end":{"line":594,"col":51}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":8087}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":16,"beg":{"line":595,"col":11},"end":{"line":595,"col":27}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":8104}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"data":{"file_id":16,"beg":{"line":596,"col":11},"end":{"l