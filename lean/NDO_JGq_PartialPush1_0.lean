theorem push1_0 : FIo_Native.fast_pairing.EbyKDot.push d1_0
    (FIo_Install.toE JGo_TX2_Message16.value16) JGq_Common.c0=ok (.Ok (),d1_1) := by
  have inc : Usize.wrapping_add d1_0.count 1#usize=1#usize :=
    UScalar.eq_of_val_eq (Port3_Wrapping.wrap_add_value d1_0.count 1#usize (by decide))
  simp only [FIo_Native.fast_pairing.EbyKDot.push,
    FIo_Native.fast_pairing.canonical.Dot.push,JGq_DotLoop.source,inc]
  with_unfolding_all rfl
#print axioms push1_0
