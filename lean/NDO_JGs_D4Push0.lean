theorem push0 : FIo_Native.fast_pairing.EbyKDot.push d0 (FIo_Install.toE JGo_TX2_Message00.value00) q0=ok (.Ok (),d1) := by
  have inc : Usize.wrapping_add d0.count 1#usize=1#usize :=
    UScalar.eq_of_val_eq (Port3_Wrapping.wrap_add_value d0.count 1#usize (by decide))
  simp only [FIo_Native.fast_pairing.EbyKDot.push,
    FIo_Native.fast_pairing.canonical.Dot.push,JGq_DotLoop.source,inc]
  with_unfolding_all rfl
