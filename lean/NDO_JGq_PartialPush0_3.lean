theorem push0_12 : FIo_Native.fast_pairing.EbyKDot.push d0_12
    (FIo_Install.toE JGo_TX2_Message08.value12) JGq_Common.c12=ok (.Ok (),d0_13) := by
  have inc : Usize.wrapping_add d0_12.count 1#usize=13#usize :=
    UScalar.eq_of_val_eq (Port3_Wrapping.wrap_add_value d0_12.count 1#usize (by decide))
  simp only [FIo_Native.fast_pairing.EbyKDot.push,
    FIo_Native.fast_pairing.canonical.Dot.push,JGq_DotLoop.source,inc]
  with_unfolding_all rfl
#print axioms push0_12
