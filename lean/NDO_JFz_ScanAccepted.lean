theorem scan_accepted : scan (bytesOf JFx_NativeBytes.proof.val) := by
  refine ⟨JFz_Scan00.canonical_selected,JFz_Scan01.canonical_selected,JFz_Scan02.canonical_selected,?_⟩
  intro j hj
  have bound : j < 22 := List.mem_range.mp hj
  interval_cases j
  · exact opening00
  · exact opening01
  · exact opening02
  · exact opening03
  · exact opening04
  · exact opening05
  · exact opening06
  · exact opening07
  · exact opening08
  · exact opening09
  · exact opening10
  · exact opening11
  · exact opening12
  · exact opening13
  · exact opening14
  · exact opening15
  · exact opening16
  · exact opening17
  · exact opening18
  · exact opening19
  · exact opening20
  · exact opening21
theorem source_accepted : Op4P_Install.sourceBody JFx_NativeBytes.proof = ok (.Ok ()) := by
  simp only [Op4P_Install.sourceBody,Op4P_Refinement.reference_total JFx_NativeBytes.proof JFx_NativeBytes.proofBytes_length,
    scan_accepted,if_true,bind_tc_ok]
theorem shape_and_scan :
    Op3I_Install.sourceBody JFx_NativeBytes.proof = ok (.Ok .S2) ∧
    Op4P_Install.sourceBody JFx_NativeBytes.proof = ok (.Ok ()) :=
  ⟨JFx_HeaderFields.shape_accepted,source_accepted⟩
