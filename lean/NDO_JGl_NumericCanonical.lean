theorem fromCells {N : Usize} (a : Array field.QM31 N)
    (hc : ∀ i : Fin N.val,Canon (cells a i)) : canonical a := by
  intro q hq
  obtain ⟨j,hj,rfl⟩ := List.getElem_of_mem hq
  exact hc ⟨j,by simpa [a.property] using hj⟩
