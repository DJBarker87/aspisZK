theorem push32 : FIo_Native.fast_pairing.EbyKDot.push d32 (FIo_Install.toE JGo_TX2_Message32.value32) q32=ok (.Ok (),d33) := by
  have inc : Usize.wrapping_add d32.count 1#usize=33#usize :=
    UScalar.eq_of_val_eq (Port3_Wrapping.wrap_add_value d32.count 1#usize (by decide))
  simp only [FIo_Native.fast_pairing.EbyKDot.push,
    FIo_Native.fast_pairing.canonical.Dot.push,JGq_DotLoop.source,inc]
  with_unfolding_all rfl
#print axioms push32
