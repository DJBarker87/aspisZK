theorem push16 : FIo_Native.fast_pairing.EbyKDot.push d16 (FIo_Install.toE JGo_TX2_Message16.value16) q16=ok (.Ok (),d17) := by
  have inc : Usize.wrapping_add d16.count 1#usize=17#usize :=
    UScalar.eq_of_val_eq (Port3_Wrapping.wrap_add_value d16.count 1#usize (by decide))
  simp only [FIo_Native.fast_pairing.EbyKDot.push,
    FIo_Native.fast_pairing.canonical.Dot.push,JGq_DotLoop.source,inc]
  with_unfolding_all rfl
