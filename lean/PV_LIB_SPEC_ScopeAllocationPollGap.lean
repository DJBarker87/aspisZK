import PV_LIB_SPEC_ScopeAllocationGap
set_option autoImplicit false
noncomputable section
namespace PV_LIB_SPEC_ScopeAllocationPollGap
open PV_STX_Machine PV_STX2_Syntax PV_STX2_Store
open PV_EVHB_OwnerMachine PV_EVHB_OwnerHeap
open PV_LIB_SPEC_ScopeAllocationGap
/-- Exact native request generated by the shared Arc::new body, now carrying
ScopeData rather than Packet. No external store or desired-write law. -/
def request (s : Store Data) (thread panicked : Data) : PV_STX2_Native.Request Data :=
  .child PV_THR2_Packet124BoxIssue17.fn s.nextActivation
    [PV_THR2_KeyValues.pack PV_THR2_Packet124Aggregate13.source.2.2.1
      [atomic 1,atomic 1,PV_THR2_ScopeData.value (atomic 0) thread panicked]]

/-- The actual installed sparse handler rejects this source operand EVEN
WITH a successful non-null48-byte resource reply. The result is explicit
None, which the runtime makes undefined; no later callback can repair it. -/
theorem rejects (resources : Resources) (encode : Encode) (s : Store Data)
    (H : PV_STX2_Native.Request Data → OWNER → Reply OWNER PV_RJ4IDB.NativeEvent Data)
    (w : OWNER) (thread panicked : Data) (p : Nat)
    (allocated : (resources (.malloc 48) (world w)).answer = .returned (.ok p))
    (nonnull : p ≠ 0) :
    PV_LIB_SPEC_SparsePacketHandler.handler C K resources encode s H
      (request s thread panicked) w = none := by
  have resource := (PV_THR2_PacketBoxResource.answer resources encode s w
    PV_LIB_SPEC_SparseArc.shape 8).trans allocated
  simp only [request,PV_LIB_SPEC_SparsePacketHandler.handler,PV_THR2_KeyValues.pack,
    List.map_cons,List.map_nil,and_self,ite_true,resource,if_neg nonnull,scope_decode]
  rfl

/-- Source-correct40-byte success data. It does not answer an incorrectly
requested48-byte allocation. This is a local diagnostic, not a row restriction. -/
def scopeResources : Resources := fun op w =>
  match op with
  | .malloc size => ⟨if size=40 then .returned (.ok 16384) else .pending,w.allocator,w.errno⟩
  | _ => ⟨.pending,w.allocator,w.errno⟩

theorem correct40 (w : PV_STX_World.World) :
    (scopeResources (.malloc 40) w).answer = .returned (.ok 16384) := rfl

theorem unbound48 (w : PV_STX_World.World) :
    (scopeResources (.malloc 48) w).answer = .pending := rfl

#print axioms request
#print axioms rejects
#print axioms scopeResources
#print axioms correct40
#print axioms unbound48
end PV_LIB_SPEC_ScopeAllocationPollGap
